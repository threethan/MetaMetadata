ZjZTKagE0Q7kNvwHFhEro&_nc_oc=Adrtpeb5t0XEu5WKFC-3YxR6D56Ys84QdZw5xBaGziMMc9-YaaYe55RM_Au70K6jei4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gMeT2cd0QgphanUCnSe-N_JpOH-XUxMbmB-blzqgGuw&oe=6A04681F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piuQEwt5U-0Q7kNvwFLxgDT&_nc_oc=AdpgSOt10sEj1N2LszfC_0bbuMcBK7cDOW9Xk-YLoQwpgqPO8PzvVenKpAJ4EdAXcfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sU5PQ8pwhzG--vcLoBjgE75PMyrhphs03kZ-gcAIwlw&oe=6A047051"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBBEuQ5MRB0Q7kNvwEjivFy&_nc_oc=AdokdZQFOl_gI7gFjmbhW0bcTRv3PunwcJeM3s16sXzpiF__nUJYII0LREK2fYZB2I0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AEaYHx6-ippnQdyEFPu0OIczz04MMs_5vbc85XgTxZA&oe=6A047E71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV_o5L2BuE8Q7kNvwETbROO&_nc_oc=AdqM8mIcdc5U_YVbAtMqbLzAgNvBWNWGl6G8ksOHNPfJaFrrDNr-pBHVYaXbJjHkr08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l4GJy6XCCwyfPGnCEUZ4Nc9ZUPYHtH6Q7nBqN-eLQrg&oe=6A04828C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOaKeFY7O4gQ7kNvwGVROI6&_nc_oc=AdplOjo9Og3YfeBPuHWbvtjJj_0jaYO0EOxCfZJVbEpp01h8iCMyW2LCGX4sk112YMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DaFCdX04VvCPZdG4SOTJkbJjTkc-DHbFkpJotQ8-X_A&oe=6A04776B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
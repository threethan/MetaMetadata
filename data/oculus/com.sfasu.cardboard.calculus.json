yhV9ecte1SCBfC-ix9lhoReSmdUqmfpbPmVJKeslkGdSctEDn54FBGSwo4XwHUIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxktov7vkbQ8_5U0t-CczCZU-_1m7tzZsBEOrJjDDJUBQ&oe=69B9429F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoFK3GsAXVIQ7kNvwG7B773&_nc_oc=Adlgny9lTPKgBE04yMUUG5ViQ-qREbaz3nXUib6yIitNOQeLHQ39lp4YrX6BoPrB1QM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHKSt6t6k-BTdfzK-J3KdJCCg2KYZzTjsw1i0XKmdFtA&oe=69B94AD1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkZXGTdCUv4Q7kNvwFDBkwi&_nc_oc=AdnCCnwUwF9lN9fXrIJ6nuTyBxnx5ZQra4NG-t1Cg8re_zpg62qNFD9vTfeUJCsD30k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBV5zrppyhGgsLgZUoch5Q4aTt_ck2-EcVWLE_sTpcRQ&oe=69B958F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdTu1UZfwYIQ7kNvwEb4fad&_nc_oc=AdkH7lqiJRIZtlaN9gwdyN2RYAgTNFRwSvDUeYlGR03UkTd3EJV6FtAYc3TOBtKMdB4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyGvdWC6CatLExGSOoL13c15rmdK3T8jfx0tPy_96qONQ&oe=69B95D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvFSNlhrqkYQ7kNvwFslKj-&_nc_oc=AdlpSNYW6eX7O7wMQOY-wGhu0hC0sGg-tv6grnAS9ATJvvx84qPiivfug78tk_P_jYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydiCo0p2D-GbW5vN8nPwD2C_H7WtmW28xp2S0Dlp5YvA&oe=69B951EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocul
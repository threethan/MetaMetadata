Ysf6iEMP8Q7kNvwEcKEet&_nc_oc=AdrLvurK5rw_zmt6L6jMpIKryHTxI1stYsTLfoQWlSyHxQadoOK8tJt1ligUEtLNsXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zfgoa95Pj2FWbtGQKslXe_fDnfjH3Hhnm3HD0mKtz4A&oe=6A3AADDF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZ5AhltWLGgQ7kNvwELTWiv&_nc_oc=AdqghsRvKwXTI6pxb4AqbsjJmgI1hKmMqn5DOXKefE8vuwLpwmkBPSbgpOltnycyIhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DJy8o230oKFUKWuYAkl0RdJUPjadIo-4uQ-e_pwRaiA&oe=6A3AB611"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EUZ3U41HzEQ7kNvwFki9xt&_nc_oc=AdrhaJtKzBMd_gZI5k-kSc9s4gC9IzVbM0Wuw-i9fOIeiKDdDdTPZQFYWfKQyguJnf8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PSPa9AvOlqpVJ5fzYDT_6fh-yVYsm8nxusUmvp-tuow&oe=6A3A8BF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fJ8MxNZBf8Q7kNvwGfQCl3&_nc_oc=AdpFhG29xoCTKFZgNL9YL8qj-y5IjKLMjlW0XFev0YrTGvrsifK2zddKbFziMUDBk-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EkEPVzginKLq5hiHCKnSKIv2XLfQPcv_J_RQBDR88yw&oe=6A3A900C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ_5cvwav3EQ7kNvwGRN7_k&_nc_oc=AdqS3sqAnRNlaB_cq1dmqED76yli-0Ljc81D3bXgbfr7A6y9GCUut3QhU7EBSv0vfT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G6aAiwujuoGeSAc8AX3hEMH7Gn7jMb3ZER-bmZhdS7Q&oe=6A3A84EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
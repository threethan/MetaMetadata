HkkXms8c0Q7kNvwEjJqvI&_nc_oc=AdpGaRU2PJ0Elw4mvfnaSeA5ityskpQQrxqG45RcnSUf7yTpLLLshdM2DgCU53-2UjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP8jHZeYb5pRBBQqN7elDDGEsP1abQoCRtbaEjgGcBdw&oe=6A7B0F1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwtPJ4Ek9_8Q7kNvwEaDJbE&_nc_oc=AdqanXXvgTDQRmPKXTfsIPLhdgg_qc4Yr9YilOZKQ_z5UGYmIstOk9mzPpi9KqP8Yd0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDKy0Lix3n9ExR5A76K378zrDAKRjUfnWgD2HdhYIyJA&oe=6A7B1751"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuLkA-AcwzEQ7kNvwGUOLM7&_nc_oc=AdryPYZS4Lok5qR95q-Was3LHqgc3uiUXfHpz11Rr1xJ8Md_pUEWECHu5c8Km1Y78jw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh_Qr7N-JUsFyn_C0GRNo2SHRi_KhTxw2zms-PPvH5XQ&oe=6A7B2571"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CElOxvCRa9MQ7kNvwEAqi8f&_nc_oc=Adq8aGE4BcLdCqom081JBF735r9zoffr6RItTUKsZ81u_zRdEzOiVG-zPrtv2t53b10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHde-4CbNkii0obCL1UqTXi9olBRXS4Wl33FEIMBNGnkw&oe=6A7B298C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqZ3d9nWKjIQ7kNvwEX2iUw&_nc_oc=Ado0Ck4dkIw4k3rWdFrRJbffdSs1BzO_1iApaOaKkQm0CBAI5lF83CdO9Wum5VDalts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkgwAAsplCPj9ma8PgDqKgVcGAg-Eqw_8JtZaFAwx1VA&oe=6A7B1E6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
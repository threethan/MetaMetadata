c7Sv-eBPgQ7kNvwFz77zZ&_nc_oc=AdrFHyK2_xwJ67SK8RCi7RJ1zlSGUrckRQStD9txlkBsi8NUXhLUt9aVkkm2YQIWWy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V6PLPk0_SUh_kLEO3NeekSQETL7pBLPOLvgvEjygL8Q&oe=69DA381F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gSjAGz9sEYQ7kNvwHDHgWy&_nc_oc=AdpSejimGAfDphr8l1bP_LO-g3H4GOjP9c0GUHISXNkNZNsHjfah044nN6J7I-l4Vy8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02pgQJ3BZggefLuqOaNQ5i4f13Orti0UDVEy1WPifdXw&oe=69DA4051"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATLMsdwuzIUQ7kNvwHraPHH&_nc_oc=AdpaemWLFddSqX47LF0XlKEymcYa-so5NiximOM6Fyl0lR0lwVz1sgV3pxpbWwoTEic&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tuZezVumuZ5aIXKoubpY_PvtclIvohtehbcTJlKRlNw&oe=69DA4E71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2Ew0q-yi8sQ7kNvwFA-heW&_nc_oc=AdqOfGxy9bwVk_sfkh-Z9KdA5ztM2nr2vcFGgwcAV8d8N2gc4HkzVWGF4IoF8L04pt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xRx3x2sCwuyXah4_xyXxsaBkCLQNvK71BeoHHVHdtrQ&oe=69DA528C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5nqDF_5uxoQ7kNvwFkg1KM&_nc_oc=AdpiGf4GlpwzQ9aOF21ux8nGRt3dsH0d3Dx-xUUBEpT8HjUoQy7uLdq-qgM8RliIZbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OV97CJE5q_kR5r1r0AlcGkl3bImhK2kDAvUGI6kJISA&oe=69DA476B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
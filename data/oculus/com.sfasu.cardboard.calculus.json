q_gUQfE44Q7kNvwHl_jez&_nc_oc=AdpH911hIBXa_MmITlDZI_vFsuKoM0D84wVjyvfj2Gn6HRSsHN6EYksG8pb4dy36vWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13fZ6LiUHyJ-RqcZ8X_yf8E7iwz9a8AYLJDRGENwkQIQ&oe=69EB5B9F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RlTB11HGjgQ7kNvwGMiL4b&_nc_oc=AdrwvDN8hJ3PrhyQPNrzUYBayi_HtHwR9P6zkyEpxQx0h4Sugd8j9KZalFw0kPIYRE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zDZ2NLXQNguQalKy05BceVmPbkakHoBg94WGFc3DONg&oe=69EB63D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDurYpW-4ggQ7kNvwH8Q8ia&_nc_oc=AdrHzmAhp63W516oko-deZL2_ANhaZUOpkRwRojz5AubkdQT37ifmYq4nA6mx3uTZyY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bIO2bg5BJjdZJFkPqTLhataZ7Zfo7apN4rfdKWJ6n7A&oe=69EB71F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1O2GDTRLaIQ7kNvwGjnAUc&_nc_oc=AdrJ20lZAneePV-EHl6xu-FiUe2Zj5vH6B3GOGeNFlB90X0eXGbgBtc5Wa_Ozkx12-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ba_iuraF6eD6kn8O6CS1wiadrypNwSi8Q9F4O296kOg&oe=69EB760C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9-e3J-6ZvYQ7kNvwGjZH80&_nc_oc=AdplW2ZR-sM_rkG9G1fxBIL6FYI_JR7q6bOAHTTlL1lCnC7Y7nWYiGZG1jK20yDTX_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zluZfxvlyfHdvJ4FEVTP-NpT9ch1Ahb5Cc_0dVYivpg&oe=69EB6AEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
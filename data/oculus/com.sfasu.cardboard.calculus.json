6q8qoREowQ7kNvwGDCv7g&_nc_oc=AdoTxS2ejULYqmj81-4KcS4vm-PR1KCJT-Dlr1Xp5TPGDQIdcPfGitPlIRMt4a2HYds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64J_TjYJzf-OmcvfQq4U5Q-XlJSwsA0elWe0ODlOwFaA&oe=69F9DC1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xsLtQhCo0YQ7kNvwF9gXed&_nc_oc=AdpaRZfaHU3dqCuPfFJ0mbFpPi1KjMuMT6Gd8X7Dg6Dv1OfaoCLR40m0SQuv05-Ns2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YVZ7asVN8WPQlnhlVvE18ni6AzuAdtZoFXE6vLjDy2Q&oe=69F9E451"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0anQwbETVB8Q7kNvwHjVkm_&_nc_oc=AdqecqMroOoRm4F_uI6nysYarY7PtYy8Uy58NMHp5lbNoHhXlTm2jOq7XuVKN7sZVvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XpbOEDnAXrxzagZYCH47aYlwtJSKKMH8udh5sc85ZxQ&oe=69F9F271"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p9vYY8a2lMQ7kNvwHT-CPV&_nc_oc=Adrm8EIKlkGahHdwm5C2OxXqih0rhdGkEOHY9vt_vD6O56TVfTitoW_ttMJSMnCnZA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TbE31zTQsABwclcUhwaEjqk2oFDrrLz24k0a8A6BtYA&oe=69F9F68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d3yssICW-YQ7kNvwEDLIQW&_nc_oc=AdoXBgpgC2FrO2YQ0Oh0QpkLQP5t-rz9WNqbkynRIgPMJhxMe63Dkb5JTs77EvTnid0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hrUAU36qHY3IviUaTdHIdfxw0vH8NES_6UckPqEiz7A&oe=69F9EB6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
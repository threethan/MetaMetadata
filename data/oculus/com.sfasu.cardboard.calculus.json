fSTniB1gsQ7kNvwGRWOOH&_nc_oc=AdpNmzo5LNjmyEhSxvw8e0FLlaEPXRtNjMJlsqvPw7jvlYYIf222TtPId7NB1ftRCAI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPQbGSN-L2tbvOTP-pYO_O-gkq8GGM_4WfvilURnoAAw&oe=69C6719F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTrHONDJCroQ7kNvwEVFM2R&_nc_oc=AdoUT2Njo7jvFY8TbCW68YTbauI0b9aa4aYa88g-4anChIgxNuWHaJwiRkN8ll1iPlg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZzf0OpD5p_ViZ0yVOIxKxWAhjj2uGd0V1zMGlb6kBFQ&oe=69C679D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXeqSTq8JPQQ7kNvwHbO650&_nc_oc=Ado27Fcy0xv5Q22z0ertGKvI7byVR69M4YGTA1zIBsE0yh6Kz4gWgoz9V3U8NGINvzI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVZvwSo_T-QZeZpZnEmKgeKThDT5OvUkuP2yL2wBQoog&oe=69C687F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jrz43t0V8VoQ7kNvwHgsff-&_nc_oc=Adqlr6sodFd2vqTDKuRHzK5Uzy7tUaXRLW16phIxwrpvAyxKVmAfdyfjyS18JxlgGH4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzaCFkKK8NYnypq3P_xI53yNgv5mDO4ctMw3ZzJb4H0KA&oe=69C68C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhgE2iSVkPsQ7kNvwHgNpDy&_nc_oc=AdqZ9w9G-g0Qq5BUVUzolI76w6eDFVEyXHBPmYR2lfmcNg-sktVpdP5RjyJvkNFSRtk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAPQ3Qd7WpdpyKqOL-edl5aQQX85RjQPEz0zRAK3aAyQ&oe=69C680EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
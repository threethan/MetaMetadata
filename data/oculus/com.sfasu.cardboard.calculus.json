_K07ByQuUQ7kNvwGhP8q9&_nc_oc=AdqxwMkIX1Mdr0jvrESYqAZw5Srz9OYfn8VsFmLzoFRZDsV-phr3FzQjRpCVSJ-i6gY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHZMibic_j2u27Bru_J7Qy47t44ZUcX25cc8CPXkcCtg&oe=6AEF4B5F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er4FZxnjSgkQ7kNvwHYOnJs&_nc_oc=AdoaKtM1oC1BpBiDUW-Nem3ra0QKJvM-44mO_EeQDeiyZnm99ZR5LSUgBozv73eBCZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSki-7b1M1m1ovUlHGrEUlvj0bS3xFqhRXjIaIc5ASMMQ&oe=6AEF5391"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSgZc--jrRQQ7kNvwFLf5Tv&_nc_oc=AdonqcaqMJIxxtpvbSIWUMpI4focs14lz_ZNJpcsVyOrRyhw6OnWqoBZNdi-iUbfKLE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQu8R1w7u6Iixd33DKUbOHUoRgZVcOrBPFCYs0xN1CKg&oe=6AEF61B1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2EBzFqjEzcQ7kNvwGGj494&_nc_oc=AdpPqr4DJfER2GxD3KQ4_oNX7rldgmO21G25ZkWooy3sVP7AeeC61VkmamvBSiC6Z-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbmToYq75oGdNHot6zEgxs0YFE_I2c3P1VUyFqCYZ67w&oe=6AEF65CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4NJTSFM0c0Q7kNvwHGO94u&_nc_oc=Adql-utOfIMrzEHq589PxISDSv4CXxePHDQtYYzrSNIvcmLYQwqBKLc41IZippX1dyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1bbSFrcukdbaRuw6W7c8fweqrKdMKTMfLrWY5DJ1D1w&oe=6AEF5AAB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
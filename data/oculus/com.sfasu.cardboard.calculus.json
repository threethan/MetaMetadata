, "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlHzZcs-fhsQ7kNvwHVJCsL&_nc_oc=AdrzGRxdpq0gqmh_ni52fmzOy-w4EPg-jYfMKxQv1tqW4Cryybbgh6Q0O0PDR1Ku6fI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmDou6v0VIsT6kZa-dgx8IoY9Uotr5p389fy7OoIDAcw&oe=6A563B71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1YTdkOHX3YQ7kNvwHh0xGV&_nc_oc=Adr-mEUfWT76SrGoqYuuscfV0i-_qEXo5pfffqJBdEL3bgaYFVrVHB4Lqwm42uT9oSE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDiLGGzJj27guLdtLqJHjDHURyJACC4H48IORKTDFtBA&oe=6A563F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsaaVo8tp5EQ7kNvwFidsLr&_nc_oc=AdrM9komy9ryBB2JxiemUWYAMklAaKJAKeK4TBpHCw0L_v4XTlT-AQQWHnIOfz45aIA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTRIyeVnARAoJ-26S8he8oIBf2lk8a5UWeafi23svGWw&oe=6A56346B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "427343352487280"}]}, "baseline_offer": {"id": "427343352487280"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649364840, "status": "PUBLISHED", "id": "427343352487280"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8801976453175912", "version": "2.20"}, "id": "783691065656975", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6150858738287710", "is_concept": false, "latest_released_binary
S_QQ_C8skQ7kNvwH0udbb&_nc_oc=AdpeVqVVxVH5wL6J15SQJyBO2GjfmgpYO8hHaOHyOVF2nb_v2mlu2DcwxxAdwBMv5UY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJluabN00JFg4FCipkWtkEcsTuG48s4sqtSC_IUKoIcGA&oe=6AA81A5F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82zzAINxpoEQ7kNvwECdiq3&_nc_oc=AdpAEGVIFb5IyzcTrI0uaD6bfE6SKaMv0VjYnYHj-tLGB_58IRgWNL0Q2lMORZLRPBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1jzYdjTCiNbjqBXIHAfRVT05k5G4sXJydQz0p-msXZg&oe=6AA7EA51"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1h_kqXuiagQ7kNvwF3zUvU&_nc_oc=Ado3E2CDo4qDE8DkTQ5a1RTk0JyCItSvuu4ugNZxXtibCCV-5kftoZ4C52_wuWIIctY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISCUaTomMv0HsBP9DqEhDP2jLuElT3Yu5lnc-_u35oxw&oe=6AA7F871"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4muC95PnB7oQ7kNvwGaoqJJ&_nc_oc=AdrDwFIZit1hJT1rvoTGoCLQO102sHHKEy5SzOUqQCjeD8bO1_BbEgCde2zBWeZiXvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJxfvypsc22M7Nbw6KmfHVo4kG1b7QGqhbLbvb4ldtZA&oe=6AA7FC8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHQ-9v-sbBoQ7kNvwHoKkV8&_nc_oc=AdrJiPT84m8AKjWyTd3T3tVC6biKwMMHw7u13rKetoTio7IUORrHoa1aSe9Wl-xnaTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeqLHu3hGa7Xjq1sy-DWwo-7DZfLKiwYVOHZIAid_gZg&oe=6AA7F16B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
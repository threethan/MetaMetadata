un51dz4-0Q7kNvwF_6OKK&_nc_oc=AdrISy4QW3fAw_ctjU6X4MkvjqMmki6nVCYKU2pxeJw0s1WhoDfyONtA1IRFxczewB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHklSIH8Vj-WMer4z_6JRqMsFmGGakz7EtdV0VE77UlA&oe=6AF7345F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxVHp-81ZWEQ7kNvwGZRAHi&_nc_oc=AdoN6xz40N937scCD9sjTTnZsEcENBaDu4HyhMJE5h09gYXwmFLkxDW3iUOe5EzIfHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdho_U_mDm9536HOI9wcpDCegM8yKX19jEvKWPU1inFw&oe=6AF73C91"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8lHWJuGKwAQ7kNvwHZvm3C&_nc_oc=AdptrVQU344DhIEimsx1rTqCQ7PSv_6FFxvBRWQVtDiiXPPwrjxdqJv1ez-jv7ZDNsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsFFAM8iZ8s6A8ZOZ4pj40X2aPTJ0ahZUkA3MAwl77pA&oe=6AF71271"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1N38e4kFI_8Q7kNvwFOwwZN&_nc_oc=AdrtecVXhavG-37-_1C3ZxgKzfjhCtQDduVdIz0UxMzy3KP5wwsh-5R2Xty2wtRVCkE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMkyEd7QlSm9CGbMLJj0h81N89O43am9b65fHBhb0M_Q&oe=6AF7168C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBa6y3u8I0YQ7kNvwEvcKwo&_nc_oc=AdoUl1Ku-bPv4Wayt5V208eRSxAw6gcrMRfmhT6eP9VeNIwVkuB2uSD3MfL8tQ-40tA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoCCknQcF2064zhVbwhrPWgEH9bGPr57PGXvmlxJ4dTw&oe=6AF743AB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
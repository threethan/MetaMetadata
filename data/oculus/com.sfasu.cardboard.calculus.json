Ncj82YLM8Q7kNvwFjexhA&_nc_oc=AdqMZ187dgfyLryT5-m66wsHPbwwQeOCFrhmzBWxGABgN_DuNKkNArdBi4KlKfaRz0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RiP-xKEPLhy5bseXSmQUu15bknqYWJtNbQ2PjgqJoFA&oe=69E8B89F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqoSdHTtsj4Q7kNvwGLN0gM&_nc_oc=AdquTV2ZUC7Xrao3Ffnfauf3JO9zATHH1n5h1LUa8HaP_-YZBb4Td54a6FCyPHUSZtQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3f6lYF4AJnxJ1hcb9n_OHQmDH57WbDF_2XdbeBVlSrfg&oe=69E8C0D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IB4rWkEkDiMQ7kNvwFanXBj&_nc_oc=AdpWGZzwbbdhuzMv8VI3vpjiSX0WwU34EDjozPVBxgzcgwfan6liN6ca857_BQBpl7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JrSCFFASMm1E2kfzhGDCgFaP6c7prfI-10yao2ibzAg&oe=69E8CEF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1O2GDTRLaIQ7kNvwF9kK1-&_nc_oc=Adrg2JlSPPCYMKycQnz-WbQeCHWxRs4JY8gdgABTJi6EITTmA8NbhoO2tnGPxlFVqIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O9JhL5mRI36AShL-fZ6vvWaOSc5Fw_lWv_6JwBywtag&oe=69E8D30C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9-e3J-6ZvYQ7kNvwEGANo3&_nc_oc=AdomcR3yFsjFRnXTlTLKKfCrLsZvy_QVBFWm8Q2DCopOklLOa7ThHvdn_588WtAI43o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vtkkKhHoZRI5847FqSg5rxYNJqsCA7WsqZc6YFsgpRA&oe=69E8C7EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
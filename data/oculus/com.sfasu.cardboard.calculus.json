dNIolReAYQ7kNvwEe5NEZ&_nc_oc=Adq3Jn3w-0ahKIYKI5lKb3uEMj81L0Bwn7S0BkYfECf_qQTRODw0KTx22rUKV_P2kx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9H0KfvN9dgszP7W91eTswhB8IXFKeMWh8qvw22xbt7Q&oe=6AEDF9DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er4FZxnjSgkQ7kNvwGVJY-Q&_nc_oc=AdpecZUytZbieO5yicibPWCvCZ64525uSzI6Lb_jIgfFlnwMBQbBo_aVr_dz2gqB4OQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY1XbB2vT5ia0iPSizYc8zn-v_4BZS0JhkZWvoiD8OrQ&oe=6AEE0211"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSgZc--jrRQQ7kNvwEi4ght&_nc_oc=AdoOdgI9mObSamH0h8dxkkZU4qE67uiRUlaGWEWLd5eMY-4sr0oWEQu5fMNuquSKwrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRF-gNjURnZzbZMeKocM9t2gx592-bX1NcbUhHlIMf0w&oe=6AEDD7F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2EBzFqjEzcQ7kNvwHYgzz3&_nc_oc=AdoPqoLwDJIwb_AitjqJHmmVOAGN08qhXaxqr-nKzo_ZN8BxN9WcvwCIm6FG0n1FVvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmtfp5MKZThORaI9zXea5A6xLgM04WlYefQSrG0pnyuA&oe=6AEDDC0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4NJTSFM0c0Q7kNvwEuXuMV&_nc_oc=Adr5EgnZqi_rcfWLvMrMvzDdlVo1UPlj8rZH4lcih49ALCrhAsBm5H4mvxy6hxOXs1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsOCHlzSNLGu276FbI4wrfxzjN78LVqDtkX9DvtnKYJA&oe=6AEE092B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
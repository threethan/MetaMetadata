c7Sv-eBPgQ7kNvwHqeO7F&_nc_oc=AdqywTbRIqXfFGM2-aAR8jCmo0X8qLreQ2E9m6vXG19ONxe44ib5R1rvb4pqEKZj4vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26nWtNEKanNXspyOrX7PyN0uM1wovQ6VJoJrcrE_eWow&oe=69DCDB1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNQgY5sJMBIQ7kNvwHxHIpS&_nc_oc=Adph8YolI-iQ6PV7OQt_1QFvj7rayA9FNC84jc_tEHK9hvutJ9tUkjLhTbXXoX1oYQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16fqkqJ6lFt4PNXhSWBCuS8_16uDxWt4g7I78UfKeV1w&oe=69DCE351"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACNU3x9Q9mwQ7kNvwEg-VXa&_nc_oc=AdpicUmES01SeWkrbKYbkYq1MlK2bfNgN5dWa24KEoSJYTh8sYWAWMG-Ah2MOamsy5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A6SvJnrDnmNQkiee7jwNTnb1-I8gDAK21kD9NNsRcGg&oe=69DCF171"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whH0wTxaEgYQ7kNvwHUZ02q&_nc_oc=AdoC_9RhfkdfQesEgqxVgjJJen2MO6r-9N9ytwS3BksKJ4mMLnHan_jaK8EvAJKfmaA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28-CGuIefve2BhBNeZR-xsXyw9BWXxxn1ZB37gaHuvLA&oe=69DCF58C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr6a-l_n3tUQ7kNvwF6Fq-l&_nc_oc=AdoT9QrFvfhlLbyXHP1u5hhyprrl77fGP1Pu020Y7hvTDTNrfMS3r-xUUHm8imLtaQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YhimJXoBRmVmsyUiA-OigJcPGITDytJIZ_qFxOjhLow&oe=69DCEA6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
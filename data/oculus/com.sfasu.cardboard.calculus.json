7w9LyvYZwQ7kNvwGoIDiU&_nc_oc=AdodmGVPH6eTaxr35oZeR-EyTJxCkm6m_ZVv2utjU09eiEdtJ81ztr9LkQzoB8VzpTY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3x8gNevWItEiwfoI952Mz5gXO-Nhp6pFJPg2GTeQNLsg&oe=69E2211F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrEJ-f2KJqAQ7kNvwEHCxxn&_nc_oc=AdqrUaMRI4tLAyrMUHUDge6Tmj5Nh0Htw3x1K0Sc794VZV0Fwb1a-FKbjq8dj2tDL2M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sB4ADh5lICp7wrCdocMM9x_kqBCjWtCluPqvnO1yfCw&oe=69E22951"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_byDsxOqc7UQ7kNvwGQ5jQz&_nc_oc=AdpUlQPG2BlH1mrGsSp0A8WqtPXtE_ttr1C8Un8cxAjyT71Kc6OSzHvMaRxKRsJEocA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lytqddYGnZVnjWfa5TX4tZWtSkoOoNLwI245hcq2igg&oe=69E23771"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls_0vFoPKY0Q7kNvwElfhza&_nc_oc=Adrh_7w3OrdwJ7HgbJ1GaE4mwHb_p3Z6NB0zHMaF8BCvv3FuYHM89rOEGCs6as3UPiA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PA6AGObqvLcqMEHau50hUpwFXR9CeTuR6bLJtRk2OIg&oe=69E23B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL7Bh0-nxUIQ7kNvwG9rpN3&_nc_oc=AdoFSy8VX8_hhGOyJf_qmL3Imb3y8bt00W6xI8MzpGKGJRzJ4g4H-mD92NSo5w1B31E&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1u00t3TK8f3T8FJdvj2_UadLlGpymJES9kN7q1hmGyAg&oe=69E2306B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
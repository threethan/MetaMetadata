mANWETz10Q7kNvwFfOf9P&_nc_oc=AdpRhS25U-qOc-ini1yPxt2S0KplclWs2Kz2zQ5l9q7kCtEbrSNXKmqE9pZPA8kNgSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5G3JMSlo3tXAf-6mwcu40p-ojQ52-EXSU0A-QGGBDFQ&oe=6A898F9F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RgwWP2FAPIQ7kNvwEqgXN0&_nc_oc=AdrhzJZOw37x3FFzrwwCh2a6I_q2VWzKAYsf5ebntdDW_PrDV41IlVVed8cgLpJc7wQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFprDLnaZTwO37kv0LVXSN9MyavvYIgeIaf8uk1nTg3bA&oe=6A8997D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkvT8eDLKrAQ7kNvwH7ntni&_nc_oc=AdpzInL1E_yJ8aRAD4bn5f3aCHjoPAbXTnYdvm3JdO5vuq13KoLDOI0or-S32TB7lwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4tfxj5JYrXAeIZHMnaxD_vDUoFS6yHm_smhy43T3SrQ&oe=6A89A5F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0uZVr65m_sQ7kNvwFrgGpZ&_nc_oc=AdqjHym9T_kCmKwEXKTgjVFPM_87sI5K3TCJ5THsoUbnZs5n2Z_UscnZ-8w9kPVcvEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmZfmlCPGgLsoIyK2RWIF6w8KrCX24oY4xFlWIbjSogg&oe=6A8971CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkxpY8s10c4Q7kNvwGSwDha&_nc_oc=AdrrgOTsw4XMqDwy3h_AgA9DJ80wGh3UHX3oXxv5EMd401154gxHkwpxcnLAqDfYbEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAlulJCNB-8yJY8_6ZJf7q9Y3lzAavxKPWxIq2b3Bx0A&oe=6A899EEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
0nC6L3S_t-Bcdw43V0CE64AGRGPH131Zqgpbq9th2WpxjdndaNIvok2ve86fBqPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2aLpUhzf8TLm8QUB7d1Rzo1CPoiis-gsleMWo9SmvyQ&oe=69A9709F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5loDde7trMcQ7kNvwFuNcio&_nc_oc=Admhph10xE86puNeYaFyhl5F5OmNm_QR3v6aH8Cf9N6OXgJjoYH45p0CQMZP-qyBvZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuviV8NRvc8pjpVDyBsF9AIYOPbVEl5zLksSWsRPC64Dg&oe=69A978D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6QqfbDrXDcQ7kNvwGzySiB&_nc_oc=AdnRjga2qIlTk_UYYroA9BeqtLd6JiEQq_RyiBbI3tmk-G1jUGHtidcdaXectaEnPp0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfviYpPLIihhf2ycVS-m5IeTtgWK4BVdOASj36QakvZ2ig&oe=69A986F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trVWp7iU0yUQ7kNvwHwg02k&_nc_oc=AdnffVDcglvDDx5mLA80fs9CjVfHlZb28B2sl5G1gJGLi-eEpurhfZBEAuNYzDMvIIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuMbqCjCBKZXfXZgZKtoVh1d_tsm6HjtolyxvJNvKrgzQ&oe=69A98B0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zKAoEIu2Y8Q7kNvwEagpIM&_nc_oc=AdnQ8Au9xhdenAqY9oNMK3CwtdqoIBCNwWw8yJT7XwjEzaQhrQ09Z0imorI4hWL34gs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftMiKyyCjiQgGxguoHwavxHytCNsuDJEOW2QemccMqyRg&oe=69A97FEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.ocul
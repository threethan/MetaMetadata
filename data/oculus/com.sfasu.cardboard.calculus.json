ggxE_6WOIQ7kNvwE4t1od&_nc_oc=Adr3Pkf740LMBOS0NOtFpFmwv7G9ZGHJMzzHwVfRbkhZIMmNaNhjpfxBJ311cXJ8n2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnoSc79zIP21x7rb0LRYOuMavjnOd5Bu5NA2YEPqcO8g&oe=6AC3C9DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcCFg1HIMgwQ7kNvwF4ImoR&_nc_oc=AdoeIgd7eSFNMnB3P3scKDIOGPdlIkI3y_3DLMTEwD8aFRS5pGeX-SpBk_kgUF3WPBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLrdWa2kBckv8m_5owuRRV41S7k0SPjWOVswNFJtPgHw&oe=6AC3D211"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny1n8PzpZucQ7kNvwHksczc&_nc_oc=AdqjT5Mff0aqVoM85jSxYV1LNIVWU_9ghDpL8I3FVLrTZ-5RQcPkTyOmJc3OpIcPU40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDrOcN73bUEaJRaIS1YZogn238rewJc12qLe1F1cr5tQ&oe=6AC3A7F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZgC_l6YO6AQ7kNvwHEn38j&_nc_oc=AdriUSNn9n2qnapPWsEvYLJeapdIONULf9dSq3z71DI1HCJh_92XF25gU8_nqXWc0Vw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQqZVR_FlEGbX2Agzno1f-zv3pp5xUSj6nNabtQb-yzA&oe=6AC3AC0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zzBtl4pWd8Q7kNvwHRTTex&_nc_oc=AdobWtBue6w9nQn2pkp3qe6ljSbiowOEiPX_HIETGUzMz6yCLEHZbeB7hl1bLcTXaPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPvjP0W7CT3nOD7a2l9HiKT2S-8yxAyAXRL3guzbvkEA&oe=6AC3D92B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
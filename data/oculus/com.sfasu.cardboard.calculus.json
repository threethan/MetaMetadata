VajpddbuMQ7kNvwGQuvTm&_nc_oc=Adpr6tPB8FJofL5JeXBw2FEaVwNTMut0SHu-pfTZm-YFeMABejULebYMA8CAVp8630E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pHWwPjaOOPJk3BxWBlcHHM0RqFu4BolBEFh_Fr75xCA&oe=6A32C4DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZzfbDb5dWsQ7kNvwF_WEX8&_nc_oc=AdqrSpCMolCm5vCRIek0uYaofHn7IydtKeuuoGiyq2vIjhzFR7Nc8lluBB6LQWyA4YA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0vUIqOtjnWjgDyefG6ERaIpJqkGtviWtDlA0I2mDurQ&oe=6A3294D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEGXlFeVZ8AQ7kNvwEjWAkq&_nc_oc=Ado3NXxozbVrS6IDv2Qg7ewG7RkGFVljSf3Va2j96wx_XPgYDoU7ZtLOPZMi0PAVkwU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WP9MGi1I-FD55ssdSWyt1avsxPK2ma8Ore8p6Wc7K7Q&oe=6A32A2F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtTVdYgXX6IQ7kNvwGiWRFO&_nc_oc=AdrUjrOH9KbRslRFjDYyoHTSkIfpgGOqs8TVpDWHVeAKB-iIe_W8upUAsmixYvhG0CM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LtjTnFB-UfQur4I5LwprKqE4KMPv8hG9VHqyS6AK8pA&oe=6A32A70C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT2biyiAXQ4Q7kNvwGU-4-D&_nc_oc=AdounmEKyXj95c5SkH_M37bgHkSN6-PHtt3H9xRyfG_6PfttnAle65t7XFikQEfs7o8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s-yxDymjGmaN_pXlI4VPW_POB974ZoUrBQuSoE1qNhg&oe=6A329BEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
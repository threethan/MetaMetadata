F06-41LXoQ7kNvwGhF4aU&_nc_oc=AdqELLfzdE-eStXcq_boUq7lJWYo96jh1So7U0dx2yZIdiGk-7R66F1HhHPobgCn_4s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKEkUAfA9-AcBIjAgDQuskAiNDt5cxG5si27_9I5ylVw&oe=6A58C81F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sihj4BoiPmoQ7kNvwF5bEBP&_nc_oc=AdoKot8wN36wV_TjQRlRGFg6SjkHwMUVCgANU-FanVi1rYIYaR9eq732idQYAhoBssE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-3ZxlIGwt14O_d5ZMDhSZ_v-jhuG2Niiz6Hf3sXWocg&oe=6A58D051"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlHzZcs-fhsQ7kNvwGnaIyu&_nc_oc=AdoRShqhChb5VR1mdYSmuYIXGvZxjNmzZGpqjuGmYyswIrxzXuMloM_EdBN75OW3DvQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt80p8eIUY0-aWzZh5omiaE_XtTLnFgYM2_IUEaateMQ&oe=6A58DE71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SE4Hu9dS48MQ7kNvwGL9WAT&_nc_oc=AdpFBwk1WJFH37NmQC8q7WRhJLOvHhTqFO1tkZfciOArgQNwlJFyEwfjlq98k9s1LdU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7A_Otcu5VxIowGVFgGXWAY1VxU1hoChvM0N0XbE3HEw&oe=6A58E28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_nEpmfeGOkQ7kNvwGnIGju&_nc_oc=AdqI71YfoNLqamU8x0nzPw0aLxKVqfTQFYOZAhFD1iDhGOhagika0G_sbA4DMSH2UPE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSyELSVmZpHDYHvQAiHuAzhsfmEp3mXbgTg3MSsJiHyg&oe=6A58D76B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
u7G0eOpU4Q7kNvwE9dcFS&_nc_oc=AdqEGKSk4N_s_jBxBofolL1x3jUjxjwGP_FP4RLXwkw5FWqEOK9o4EkBVVvFJr_XI3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5UeyU8uaQk0vmgymGVu-8C_8N-ps5bgVCrA57NQnMFA&oe=6A2595DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJupSNdZc3EQ7kNvwE3H6BG&_nc_oc=AdplPh_6pEXl0bIWnB-9H7edHOE7UjDwjTINmqLSJ8jbIuOZ09j3egZ3lbMz8eEtm1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VKVMYKH3mhflAuAHHXmTsf2MRVM-Hfz5oefpllW618A&oe=6A259E11"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MK3dumBncgoQ7kNvwHP_kVm&_nc_oc=AdoxzRQ_9whqAMSSsVIdAOMkbC4tThUokLJLbMXQU20iTjea6xyq79KfeEBqnDSlXLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AnwOfIp5b0d2KIbv3asTkyLTQoeMlEXt-PrNnaEBYDw&oe=6A2573F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmRtrWlRWr8Q7kNvwHpa6u9&_nc_oc=AdoUsfS34nvFosQts3y9l_1XUn12QvSWS6NhvdzvFJjLeYxE6YcojLnBjvO1pxJhWRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91WV1NL98nyjIIEon1Uw29S27VZ7D7S9WI4iDg_VOHvg&oe=6A25780C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVVZtwUSuOEQ7kNvwFkPjwL&_nc_oc=AdrfQUkQO49FDm2DGKs0sg5nw-wjJuA0OAH5QwvYMaad1K-Tn8Kwge3IFU6vBb07-ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fIlGCgIKHrDZAn_kVYflWljWlK5HlRoaZt9eIlOei9A&oe=6A256CEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
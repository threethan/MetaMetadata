gPa4lfZVEQ7kNvwHRnYFO&_nc_oc=Adotu5XPoxpuf9-5u6VEtO4sNmHSZtojo8uy_XFpRdjJqiPvUzzhZ_26cRLWO6MDcqY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaR-4WB_mVSaGGEyD4espJJCm2CGaasAKQvJ39skyTqw&oe=6AD39BDF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7OQaVk53m4Q7kNvwEumjTJ&_nc_oc=Adq-G-xN-ARYaObZ65iQqqlABMj_3OqN8QhOJbOi7C1C8_sP3YDhkDSWXxGScYRTs7A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe9geNkQEaInO707ikqBGimcElQp6f23HaflEFU0eRYg&oe=6AD3A411"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOIpKLaYecEQ7kNvwFyXRTF&_nc_oc=AdoFZ3WOgcYm5CyfV5R2q9mWNezBsyBmd_xsMImIOLFYPyNvSzQGCRePuOS4jupxukc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTbwS63ifSNwjQXKzM8P29AXCtBw_jGBKNCxaKuBs17w&oe=6AD3B231"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoSdGO4py1MQ7kNvwFOAeyt&_nc_oc=AdrRk6V1txPU7qak8LVwe640WEKAk4gen2-Drgx-APCFySST3xe90wtRllo7-VJ3jiI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODbYdZigzcl2Shs7aKH7EtDbelUT0KjKtwdAdmoIDNMA&oe=6AD3B64C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6257Xgki1OsQ7kNvwG5eZqe&_nc_oc=AdqN56Zl7X-eaD2bM-IdJO9q-lDHFC408LAGV_1APD-m9U26pSGUtNH3BEPhFo39RCg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPh8g0jf0n-70WRyKq4qgg2tcc0oDMBTB_ylRNC4fNilA&oe=6AD3AB2B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
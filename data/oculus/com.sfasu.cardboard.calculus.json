qBag7owbEQ7kNvwH0sHcV&_nc_oc=AdoFaDWFuwlqa2L9baOAAT7Yb6ibcKC1Cwl-IxqYhDZQ-J8W9PLgl64IOnZAjJNobxc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBUOOhEXMyuHamUd5QHhgly9oSdJc_XoqfXe3mXyonAw&oe=6ACBB2DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rta6W6VCGLYQ7kNvwGoIpyq&_nc_oc=AdqcTVeGNCIRV3zA_Ae4b1Wxu7A69p_DzqoPBX9f1L5IwHPAWew4SUt41oqtawtsmmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVpxY98VGca3_yCW6bPUo4rZDcQI3QZRQGmkEVmAIx-Q&oe=6ACBBB11"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5WOKxwOtlcQ7kNvwHDt6Ua&_nc_oc=AdqweLDBJOqWVXs25q0bbS9WxnL9rmUl2QpW5uqqZOK7ALCFY-y6CtkL8XoZcQPxvGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQGyrCdfXWdUZ9gOlB4C_7FhszdN7heMJIe--4CWp7vg&oe=6ACB90F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEdk_SAGfTAQ7kNvwHRLGUQ&_nc_oc=Adr5L8YA4bhGvDBOyVoFTfgUlJpl3afuKzGzbBhReISIsuHSuYpuBTGoiEVdiooPEjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeyOtyN14vn-jV6dX5jlvUb_zpIumpUQuOdJySKPZJNg&oe=6ACB950C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YamdzMulQb0Q7kNvwFQORlq&_nc_oc=Adro90NoFz1iPCnfisaga5H5SwcRz0xO4PvWGwvZOL9nwLsPor49hVv8y6Dt_M6pKyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCG5aItQ0MY9mjVU_MojHuv7kKz3Wu883IRnyPgcsTAA&oe=6ACBC22B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
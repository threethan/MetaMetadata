ZoAcNhyz4Q7kNvwHM9_19&_nc_oc=Adr442Ly1MZy8_LuccZ1WAqvlXYEkuA8hziDsjh54aZ_eUuI6G53xWkttYG8K4Dnu50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGafQItcnLInxw-M4xp4SWKDysMw3irFr0tSPlDsW_GSg&oe=6A73261F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yqj83fDEBkQ7kNvwFt71e3&_nc_oc=AdpMys26kf-QOFRET8wtoI6MjcliS9s2s2lZJpdWtjT9wcKkCw4cqBqiD4tYtZeLWaA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaV0K6W5FWCOnYrTLhs9YJ1ynw9eKhxNDu3jLPGM6DtA&oe=6A732E51"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_2ZPEhx7G4Q7kNvwH5jJju&_nc_oc=AdrP_DKKeBE8m8NzY7C9G0363O4gsPCjLENOYXc7EMZRZFbuTbT-VIEOdDhzT0va53A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2qwrghhTTz1AmnF17mMdvMhYPJoaXcauLE_XrVSdH6Q&oe=6A733C71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xs3lWEJVw9wQ7kNvwF7C6px&_nc_oc=AdpCFKfGm47dbAyirsWe6w7eg3NFYxleDmqrGOz0cTJIRsaJ9e6NRh1pkulZKCCLcQg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo4kj9TgnlxgDfSsXz7f4LEBta3mzOKOpQ5POF_BgLgQ&oe=6A73408C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EmHnm8Zy3QQ7kNvwHyc-P0&_nc_oc=AdoRn2oPRWipsQI0x8hRbLde0hULUDGmdiaV-AkOPkIQdFGa8FYIj02IO92Z4djHDH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtom624o4gSCqkU6WoONcAYRA3spFLb1NF5ATYtkDWaw&oe=6A73356B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
EuqsdfdaEQ7kNvwFcYsS0&_nc_oc=AdoexgCEcp_z1P--iP5Pfnoh5txW6R21wVgQkj5qpiB_YMV77KXDheBAhtW11cK3RyU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92SfJXdNm0AHq_X2FYp4uEYv3UlrXWZwGTQ3QkuBcfyQ&oe=6A4539DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9lx72HI5k4Q7kNvwFesFoL&_nc_oc=AdoKCtj2gFP4DOSCoK8BYl55JUFeeA583qoBxtBuHk9lXiM9gb5uddsDNCLZsOF5yFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90K--yBj-_gXOkqc5KGHNnhy9LIyHSzy_7M4lWiYw41A&oe=6A4509D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16Lunlyc5vwQ7kNvwGzHZ9S&_nc_oc=AdpOSyT6RS6Z58vivZgXJjyj9P2QLyV4hgTJH_sEzsMTmO3A9SURb5qCC97zw3P_RvU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_t8xfIQ_ZE_mrf81PmUK5OzHhVznRSb9Jv3z8ZMkxJ8w&oe=6A4517F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDTeNto9YFEQ7kNvwHFat4k&_nc_oc=AdoMzLzAVRWoKoXOfqbujVXoy7kok918yNeCIAGZVBOeON4CP_mEGhHUmRQEe-lGEnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MbjDRYDSiWG1shD2iUO3TL8jvaFLuVYBwTuAo83YFaw&oe=6A451C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4258NvTUo4Q7kNvwGh4fX5&_nc_oc=AdpDyQX92mMz8RtBMk0V8bmBlfLL-5ipCOWWP71MGAHawBsn5GXnLTINYCVbmEmXX4s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o6tcXyK1vGr4z58UarhU6M4qzWJBaaSHv29MEjh0KVA&oe=6A4510EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
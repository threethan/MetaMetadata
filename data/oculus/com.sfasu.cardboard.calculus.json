CXaOC52-kQ7kNvwHhYzh9&_nc_oc=AdpBhrP3yrEgt75dyfqS9jaWlagv6Nif672ZOCwOZVrKGo8tK6d2xIox1ax3kp_XTBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL8VAaoAKJ3KongZ_qBlOFs2CJXe5OMno2cbXUcUse5A&oe=6AB154DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdsPsp55nrQQ7kNvwFXujQW&_nc_oc=AdoFZYViXntS9QRSIpFW7-FCP5FQ1GotzyTIYDYdBziucAJAC3zs2eV4XxCyFJJNLts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINOfK3lsGYrahFIwrIwKW8Op9rEYjFUHouAh5uzN1sNQ&oe=6AB124D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJDcWJJldYsQ7kNvwEinujC&_nc_oc=Adq2OVJUlWOnWUWpvzp0x0M1WBAMGHZxrXANo6voJjvgf3uW2LKd_O-sW_T0gZXBanU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV9R81kT02Mu9_gtX9wtv3LPgfhkc6EasyC10yKIXcQA&oe=6AB132F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8ed_5Nio2cQ7kNvwGBDV6i&_nc_oc=AdqSwwQKMi_gMQnX8roI22BvPVrD_Qmy2hhli_I9bl_vfD1ZQdPoC_N81VEhq_jtB_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3_f_lxCTGWRRklgvT0lnxLjFdQWp-h8uYBJ7Or33l9Q&oe=6AB1370C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1s7bUAovyYQ7kNvwHVqOTU&_nc_oc=AdryaX02Kd7BSpP6CWswAMGLYqV7AlW9-MZMqfx7wLpZIuYD_As8GTXZYHqOhR_C-k4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxLv1xlpbBnJWAO_5tcW1emWuqZ8WlIJrb89jolakqlA&oe=6AB12BEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
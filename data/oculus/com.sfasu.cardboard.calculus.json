ZM-ZqaZ_YQ7kNvwGoOqDS&_nc_oc=AdqQ1MMMvsvWpzfDoMOGt_uAivk__L_YC-BzaR_kZNcaOMGWYIh_ev9bUGjF_WgZz6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58R7gcEW3eZF8-wisIXzyItz9j9Z4ZXr_xTLSRzmY0xQ&oe=6A00739F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6uL2O759DUQ7kNvwGpT4oF&_nc_oc=AdrslQF-z-KpeL6fP08qXsmoezG6FcDWXf53QZJbMpnYsK_pUuUnKRQT54mEiP35h_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MnBUqsixsiEO0JboQkfHNBRj9TW8ieVl4vkLpNPFNGA&oe=6A007BD1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXM_dfQZ28sQ7kNvwHWx2lo&_nc_oc=AdrjfUDeEXCQNnICuJO_ycgqunfDdPU8SpC49HoJH-AfLTmWprsCgX7Vw09mddrNSoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tFa4ZZpmOfXRieG1V7qs23HeNleMLB7LdCaQFy7Yp7g&oe=6A0089F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ7WDfmHwUQQ7kNvwHNI6m6&_nc_oc=Adq-qRqqRsiOhx5Q41892TPWuUXv4y6R-0uvnSx0P_xshDaVDJmQBRsFMFcEy29WyVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bo5sw1owQQ46zUHFf7QTOVWTLhFLJuOKhE0EZhXe_EQ&oe=6A008E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytSf7w_7UMcQ7kNvwEYIWQH&_nc_oc=AdqKZd7yA-Tmx8WlANrzXf6W_xmYQ8QzILD5aSnIlHZQNKFZ8QTdciEm27mMMWOkXPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_cUOzJDwJvEGzCo9mA44L8sUMHLqH2im0kRx91zIQ1w&oe=6A0082EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
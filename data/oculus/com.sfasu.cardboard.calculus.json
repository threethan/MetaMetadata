8e7IcLLKkQ7kNvwHaSUU-&_nc_oc=AdpW763r_HOJ6BZL_DMw-xusJUaehefwpSNv5Ha-Fila0QnupT8Z0jcXRO5Rdb_I50o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATOyIe1_2f1Nnb387Ir_UjrPl481UT75leCnbT_wgW_A&oe=6A492E5F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YGCijz8O7AQ7kNvwF_mQ6q&_nc_oc=AdoNeuQ2wcH8pBDqRZFaVG4rXGtb5-Ue2I9yCDeTrpJHQNUG23-A8ApqKu6v3Lltxsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd84jCNQDvXpBJ_nxd1svfJcf4-zqoESdGW37XoJqsGQ&oe=6A48FE51"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idI8Lgjw8EAQ7kNvwEJBsha&_nc_oc=Adrr39LyOqewiv5IjhC93XMy-oMYN17Bk6PMIeDyoFwGjUkbhwi7xNJu5bjSHKvfiik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBespgiElS9FBcNS7SZwYmJo29iO7n-hTZJMSnxRGUEpw&oe=6A490C71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkMy-sTv_7AQ7kNvwGWWn9H&_nc_oc=AdrETdYDzs8WGX4pMyznvkpIT_DblWFlAGaN4iJcie6nzdb_JVjoSS1OchTI_wrsnIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChBkrFsfTWLpd79CXHSpct08ntDxlnsEex-siyF2LLTw&oe=6A49108C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaDc9RE8E1UQ7kNvwGs-1Uy&_nc_oc=AdqQ_vjrA-QpK5zcpEFZXqZsWSlmlgim3Ol8K4GlMPMek6EBkyHJfBtq2VMXA12xQmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIm9kAUsl8kunutoSFtWLaHnVeUCbzG3CgNdM1mASaQg&oe=6A49056B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
6q8qoREowQ7kNvwGWbfOl&_nc_oc=AdpdSPGoBlm4q8edjf6U6-yLoRIiuub4SWs9PoNb2HJ5qTH6mxnnWqstEdBIi_I7peI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iorVx--sZugHcNUwwi1bJpcrrBcdsmTISzzuOvp6lsQ&oe=69FC7F1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-6zJcNI3dgQ7kNvwGxg52r&_nc_oc=AdpuIONR_qgKBHn952G2tsiQpuQtAh-_n9LMLyqfJN2-Lmxet6_xzbysd5u6BPscOJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z7h4kFG56Kr59wO3tXNyzc4RcEF-5dJXMtJmQNWfjVw&oe=69FC8751"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMA2mNYOKtkQ7kNvwEWNy8F&_nc_oc=AdrZ5q-wmDsRFRIXw7WybDCVkFoStNSTF_KGLWGruPU7dQd7AUDdPTe41YmE5onCCMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gbKlgM1-Hh0tqupbUr4WgzdZ2mv-ICQrNJ7NCc54xuw&oe=69FC9571"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T2wHpl3oaYQ7kNvwEfMsPV&_nc_oc=AdqvmYat14vwRa_Uq6Q3UIZbGgeq8-Rtwj33AkKYYRSP5ZKlS92IJsuKfQYoZXEpPDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cMx4Bp-R1h6NDaNZ71XOniHV2zBcHgwMUPBBgUVrJFg&oe=69FC998C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9zSG2s2x-sQ7kNvwH3cquT&_nc_oc=Adq3hkK_Cei2WNRBNTxbMdglKL0OX1tAKDH3GZu5ufRCTaoHq5WItzUPTGTfAxnmypU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nudEfnRN3R13ua0bjv-1mCpLVhaKp-zIASKoPArxovA&oe=69FC8E6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
VBxO2beOsQ7kNvwGYkD3L&_nc_oc=Adq6apoRAY_XT8eFhLNajH1rtt9be-c3si1Ezoi68dp56JqGNXg5zxC0yO9t3s0fYjc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D34S5mqAoQZPnSvIgA5Cb1wtDShBNG5xsT5shmhWpXw&oe=6A1EFE5F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjpK5RAnL3YQ7kNvwEtSwoi&_nc_oc=Adp0_0ZiBAfgd1WdwPVtouJjJ2nWtMIBcSjKAvy_h7UUCSYPH0dp8WvxJ8Xp4Nuu5Zw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zPvhnmt17oUJdqajk_6txJgbUMkneQZ4hQvbZrivZ6A&oe=6A1ECE51"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQFb-JQxRgIQ7kNvwGarME4&_nc_oc=Adq4atisp_SSWT14z4rcNnAsVbOZbHqkEGVJzV8OIeTpI68BEqwNigwthQtZ818NzdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6da3oQV5PyRpltD7Xb6PnOQLBsxh5Q4pndss6TV91dOw&oe=6A1EDC71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pe7Gsr9s37oQ7kNvwF-M3QP&_nc_oc=Adrph2Sbk_A6Tw0dY4TTLd1GEagfSINbR-NnoCVkRlI3YJEO3F2sPrycYvTJJx8HCfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74h_qwK7TBN0_3DzH3tlLf0S3tssEwIAEjmVCuPCCTHw&oe=6A1EE08C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZuDv5IobTkQ7kNvwGIeXdj&_nc_oc=AdqniBjsJrrMpYBtcbvIKRB9YiNBER2xNZ1IzOpqFGYPdCUqFEJBPUrQVTI9iJcWJ4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nCNveuG9myEkh8Rir74XRtC0CuxiM1DUTIwjavpQsFQ&oe=6A1ED56B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
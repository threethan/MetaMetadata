3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuqLnFJTIFGMuj0mRTQJvQyLfjI5FUoR9CsrjiJFIz9YA&oe=69A1879F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYsLyQjwGxwQ7kNvwGt1gfq&_nc_oc=AdlPgayvLcujeY4Zdg3mAVfoWrC596HMFxlEQ42WKm6rxcYcss0Y7EFSnBxoLCISIqI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvJF_9XpkNJhuL6NtrL61gAc2xnwsBdI1Elsfr235RwNQ&oe=69A18FD1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pc6YkxqNO8Q7kNvwFj7wIa&_nc_oc=AdkHDilzFl-seBBmbI8RxIlqsL0MfcoVd8UwWopO5JHQWKgbJLS6E5y-4ijQK1wLagw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvIM8kOpDq6BFQiObrYAwQC9nhnj_NIHaNvMgxlyUhAtA&oe=69A19DF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYQsqrl1Ee8Q7kNvwG_FdJ_&_nc_oc=AdmC_sqOPrspLM-tu_ds-E6Jlf-pFbnVz-GPKvwqBpHN0TMpyWCkTQkMrnJ6wcLGUHI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv8kPFhMM1Oy9FM6YLW63movnaNMr0V3HtA1Jg-_lv0VA&oe=69A1A20C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pXHw3LHCVsQ7kNvwHbvlyo&_nc_oc=AdklX5DmxklpkJwfz8Epkl0M9caKT99EreNt0EQhgLrAxR-_h1qdDq5pS85BZzm0vTw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuD2Ml1VOZDPMP6MNiV2yRW-LGSeBY7obCuZaryEaEb_A&oe=69A196EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974459_544935220176392_814484475143074628_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_n
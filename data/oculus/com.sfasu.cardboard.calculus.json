VajpddbuMQ7kNvwGNJuWz&_nc_oc=Adr5kmz3AJmXl6Fn7uXvMXYGajSMQnfRLXvvAO0B_HK_jbWFjWraP0wFZbNsnC0yxSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uq7WKNhWB-lnwTcPnR2PrFFmJG1t1t-0-CoChIpilFw&oe=6A34165F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZzfbDb5dWsQ7kNvwF6MgE6&_nc_oc=AdrMXfh5x1ZX10O0CbXgYlLPEhF3TGd_yAVJncp5DZX7sLcjXTxIIugpAbZ58yyA5_4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_Quni4bVylMnBqDZHvXuOUgVJFT1HYLN_XA7G51UZcg&oe=6A341E91"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEGXlFeVZ8AQ7kNvwF16JHD&_nc_oc=AdpHku-zGb_UAr0yc35hEGO-QVMdOMQOom2HqCbF8ueffYPHqK0pu3KG_DURpH0Aw3k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-irjc7jsWMjrc77DgQf8WCnM-uALg828IM6I1aDvCzlg&oe=6A33F471"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O96lyS8AudEQ7kNvwFG3Req&_nc_oc=AdrK9goLvjhHeAmgGw-V4T5pGXzuw_Baw5q_wqPZfYuG0lrRa7LlJN8lnnhhfrwQRxs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PBG2D7whMQ_7r-3SnMWSLjZgpjtMEpGr6iFxADwzIAQ&oe=6A33F88C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI02Qa9-1B8Q7kNvwGZlaib&_nc_oc=AdrQsmMz4ir7dhogr_c3hdplzXw-vN4ClccnPVabh82O5QzkNW7L687-mZIK80b_XXw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vyP-rm2ByiuTrdRn71AwPXL1zBhI51NpA0khtlb6-1w&oe=6A33ED6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
u7G0eOpU4Q7kNvwGHaPh8&_nc_oc=AdqHm563RSHH7DK-YkRz_VPyKOn7UUryEqik_k4TJ3nwn14N1C98R-kkme16eYCR5Xg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86gmHJP4_Z0lo2n2s1uhTi0NH6Wb0vURHtQMZEe9qlpA&oe=6A26E75F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_RRM_-99m0Q7kNvwFulgkn&_nc_oc=AdpzowNDa0l1Z4TRqiYmRk_F_STa1GnwOY-lNRFNc7bxbZpLfQmrIYN-ZdPcvv9dKM4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99HcL84LGTpwq0u0mShbHexGHc-MkO6u0aA9LH6XmE1Q&oe=6A26EF91"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPG_Ync1IoAQ7kNvwEvwMtT&_nc_oc=AdpP_kKz8qQuygmMMH8fIygGVMUzmEmV9DHsP2EM-LVv9D4tdavQoijxp8TkpZOLDFc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JQoErdCuQXEwA2QNof9Gtn-mRCeFvxraHkFzSHqE73w&oe=6A26C571"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmRtrWlRWr8Q7kNvwEx5iNq&_nc_oc=AdqSuWEta3o-suiCIt_eyC4o5Rt2kUcOBfCXl1w2YAG8gTho8ItsRTy2Q23FsNAs8Tg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i_X0v94Ob1UVvJ8ksTpkyZl7GnkIhhE9XXgeTPOEZtg&oe=6A26C98C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVVZtwUSuOEQ7kNvwF_83yc&_nc_oc=Adpb3w0_cCKAVSuF_8OgUqZfeVfk6SkB6Dj8eE5WnP91MUwdCL5Cujkju7p1C4KwFPg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ShYIxMUCrF-ooUhUh-ejz3inC78b-oaovBY7TT9IsOQ&oe=6A26BE6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
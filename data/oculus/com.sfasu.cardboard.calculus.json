Ncj82YLM8Q7kNvwGd6Mpc&_nc_oc=AdrAfu8IkBnhe_jcSO782LhKgVrmmODH_RbAPSsB8pi1Cc3R5AYYAZD-zbttcw1tmuk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K9lW30n0ZHm-c_oOv53ZPxBRONJ3h48q138xsOWPmSQ&oe=69E6159F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCeBBlEqOmQQ7kNvwE1H1x_&_nc_oc=AdpU5HUHIIenn133Ts5scA4tHw_0-Q9-0zhGBZdi6Wk2hFpG8ncocfiCjOAYx_BiNtY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A78bp8BdHy8_YKGdwg00z5bSSdG9BMj5bcxOtc0Ol-Q&oe=69E61DD1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWCM1X2lCxcQ7kNvwFWknML&_nc_oc=AdocHt7JFNlkzHdELVuDagXpBZW_3GnShOH-abfQFc8NJqtN18FXpcNBeLr-3ELT4aI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZYgsTjxrhfufN4UOgzMJhhDMK4HMT0MJMMbaqVywXlw&oe=69E62BF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMABc6GGUAAQ7kNvwExtsDt&_nc_oc=Adr8J6iHzySYi-MYen55NgaD1GZL3zvQq-cVkZuiuWUe-kynJGylIYGSFjgLNqy5Yr8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1inyYULZaumTdOjxZNDchv28GE3sZca475qW3IHeCgdg&oe=69E6300C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZjcFUpLlwMQ7kNvwG7zAAM&_nc_oc=AdpKv8JUzsRgCqT-nrvvm9TvNkSSl2GI_TCVHvxpIc3dBEyC0PKW_BFktIZhfXZBi7o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MtwsLegqxtSUAyIhlXCT_b6M3ZTA9N_A86lwGXqROWw&oe=69E624EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
KJt9d9oiAQ7kNvwGBJK5z&_nc_oc=AdrWscQ19n65O3P9_pKfD72lQ_B_D-5-fDuW3cSzN1Zsrvs1biHRFNrRNDo7UtCBick&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLg--JJunQ78XTATbN2GoG5bJUaszG1jFGWy-OuvnWnA&oe=6AF4915F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxVHp-81ZWEQ7kNvwFKKJlo&_nc_oc=Adov6s5vW5rYlAEpnZd_h3EFv9exzORqhb01yNoUSCGaQzeISCXEzMOZpqgD04FDm5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7nCRbm3z-7qbxLq2l2GPwECiZn7sTPzoaaTeEBn9Szg&oe=6AF49991"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8lHWJuGKwAQ7kNvwFp3kVv&_nc_oc=AdqU8oeEhL6J-UHbhhQIyavNRVlfntBcOrMQqzcejTH2rVHkdrYnXKxDrQejaL4-BD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzprXGRO_qjF2aDRzgoKBMw-Mxf_qKAZijbC_daFbXUw&oe=6AF46F71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-KKrWmgOkwQ7kNvwGfmqXS&_nc_oc=Adrs-NT1SOwu_FdLDi-nwAn8HFRcoyM3qoTlB3bQumx22a7FjIIaUTgUJI2LBh59erk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhMwK73zqSOrpPAV1uDj93EsVgJbJsoBUN0x4VBp36eg&oe=6AF4738C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OjIqvApAdsQ7kNvwHKcpDc&_nc_oc=AdrOPigHPRyaVaHpqNyXAt-7dwzJQD0y_tbUEusPgBGzzzu1NKLRVtW5pd2r9d-t2Og&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgeE_QJ9LynEFH4_Y-XkCMe9LrNVauvoTj0NL73I7bvQ&oe=6AF4A0AB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
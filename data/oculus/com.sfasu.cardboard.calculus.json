3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuTnt81lDp8p2PCxyQQhSn9ze48d-rC_29--ft1y2dcjA&oe=69A57C1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8wgLxjDA_AQ7kNvwFBr6R6&_nc_oc=AdlvykUpp8CMA7qpEC9vFH3B9rsOu3f2NWD30q9jqQnlS4Z8hhAPmVUVfn8s5DoN_zY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvccKucJvgPeZ98biPGvl52i4l3LvREGSf2cK9_CyGZOw&oe=69A58451"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIRmcvw4wh8Q7kNvwFk8wss&_nc_oc=AdmCPIvb3yd7xk3X3ARXzzwv8zw_uN3bGiKSDtbospPagBgxZ2pfz8xRMiG6z5pEIyU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuTJ1eKoJ0mZTxd9nxgl-eeTQmVrd9REFyIFjCT6SQ-ug&oe=69A59271"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MimT7cqLiqUQ7kNvwExgpYR&_nc_oc=Adlj3eTw4fDEM1JWUjOWTxGOxb3qmumT_0fNl9XQQCQKeIXzC1sAYaJVA-iYcni5efI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu4TqDuLw4CgF7obL_PU9r7il212uD_5-Sa_C_6WmM4Kw&oe=69A5968C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7M_F928-zcQ7kNvwGlasbc&_nc_oc=AdmgVrdDVMFRoJOBlH0VQoxOYRVqWuyCF1h4HNA6_bQArOhkAQx2WA0ys4i7OOmccb0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsD9BhozDlGDBKkjCKxA7U4vEko7pR9VoH3OR542Qpiuw&oe=69A58B6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974459_544935220176392_814484475143074628_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_n
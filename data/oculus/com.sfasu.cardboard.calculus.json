6q8qoREowQ7kNvwFE3H6Q&_nc_oc=Adqp2SKkIow_xEhSun09ZF89x93Pe-5p4m0bzsJdjT-XiQOO_rBz3xUR_7LcHCASBI8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qr7x-WgCh_linU5IWk5Y6EoNXtTHRspgLINxpxd808w&oe=69FB2D9F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-6zJcNI3dgQ7kNvwGuOpTq&_nc_oc=Ado1wLerEgui4mk_JJa-qW_0TCQ852DKXoikTJFY8VcOUdr1kW60p_bUGHQq8aUk-pE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h0EdNjlB7hGbQx2UHfS8zDv0l-mINBBPa-Jra8TEpiw&oe=69FB35D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMA2mNYOKtkQ7kNvwEnDiUJ&_nc_oc=AdqW92sQUah_8ZSp1NCyTcW206iu9OeDciHyq-2DsROGWwfFaLVfwRNm2wD9-ya6Gqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HwGI9pwY_UUK3umLwJn9Vs-EWigw0jLE0O1LYfdIQWA&oe=69FB43F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0p9vYY8a2lMQ7kNvwG7Dr2d&_nc_oc=AdquGX5Kjv_kgoP6jQCpPCV-8kEuiRCu7PPUDjDe3tCPYw6BR6q9qsT6OyjNKRNoUBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IjkoeM95pzX-t8kB1y2Q0hcC1H0ZQK7JHjSdvalk47A&oe=69FB480C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d3yssICW-YQ7kNvwFm-6KW&_nc_oc=AdqU6IxStvRdAIsNBMjz94LtYWAVTwoDoK75mfYe0sBulE5Nl-CqTu8h7cxND__R98A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hoa1Ukur52ZUzTKdgqHuZaF-LYA7xyreqbQyhHewOVA&oe=69FB3CEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
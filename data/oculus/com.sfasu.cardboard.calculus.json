a5ghIn2OSvIdePzDRBEuQlneyVWSZ3V_Ma3WsLudsX9eAIcLblYtaLIDc7co6Xbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzje1JqimwDDJOy16CVWMHNXnM2-8z1_Fvfulos2rAydA&oe=69B54E1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wioovVmq8l8Q7kNvwG6QN26&_nc_oc=Adl0U2b5kBCPd7oHmL0cF91_Ryy5DkL6iZs-02sqpK8S855j3eK-a7CDD1l-bnRDmjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyvs5Ke-267FnstU8GBmD1sMPYv5JQ2ObNXQ_imRJXlPQ&oe=69B55651"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UJHtTQIPDEQ7kNvwEdL44Q&_nc_oc=Adl0txniplNnoNg86qLw_lqjtUeUDUplt0Tf9QyS6y9Je96V-Y5Lmz969is7XMJCsYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDFJFMUN_eWFbE33hJgc2YGdVGm7F_PaXLXqaXUw5HpQ&oe=69B56471"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFlb0F_44yAQ7kNvwGrg6zD&_nc_oc=Adm79VM8z0t0WMUuG9EUXr295K1B1dSeYSF67rUrUou9aXsNnPcrBN1b0Gv6PpeHCbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6aMgolfBTmnCpS9iEJjx8R_9ohMR2Crff2k-P5-RkwA&oe=69B5688C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuOyGotn6ggQ7kNvwFQBvhh&_nc_oc=AdlOI7-WIbUlQ_7itYE0TV89Y-6cJCgtEA3lfjkIwCj2zncJiVjRRf08Yf8qmS_k2zM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0H7yu8-Z7TE9sEY1sWMY4HuudXZplv4lmQ5eAK8KtVw&oe=69B55D6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.ocul
n6LsyvqyMQ7kNvwEruNqC&_nc_oc=AdpWPc5MJtASqZIq8x1mfGGYZ-Q1vJp0cYfx9TwTeLolsbyRQWiYX3ENDFSkRwf3HTY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eTHXRBW62Vgs40ZDBgROzsHj6ntZekoTQ7X7X8J4fIg&oe=69F5E79F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkkX6VGWf80Q7kNvwEON9AZ&_nc_oc=AdoS9vv_tAkFo8Xo-fXxozLKVoah81BO5UMboHhVUBYSLlaLIhAdAn3h3UoXmqfvd28&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1omM5N1d8dZh6DDWQeSGF44mQj85W95y9HlGOfk8vqIQ&oe=69F5EFD1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp-zV9-0oUwQ7kNvwF3DPJH&_nc_oc=Adq7qnMDAG5LJUzYHvdREJG3DRDP7fvo89D_3DVfas3YyMt_iQAWGPq3tSR8RAXp6QE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1-I435si65DWbdLycLKPvq37wjm-knA57ug07kBM4B4Q&oe=69F5FDF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S90sX8o6N74Q7kNvwHqHD0E&_nc_oc=AdpaBXZ0qT8lHLqMR8prZVUzWuXVNXHt5qDpkFYAWVmLE-j_pzINxoblwizSfKWnDlE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af21n7Jjnlr9IwWZWxnegxQ1TO4bxW_ILacvYYClUbq4qg&oe=69F6020C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itWKIdy7r9AQ7kNvwFzaauz&_nc_oc=Adq1Er943Y0fsXQijOaGRDMsHeOwBZPBSa5gwm70UlW2t4kGkE2m-31RQP_agtYlhSs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XvOnlJ5svqR36x9cz8bpUvJlAOF5b7wLPPB3npFH2sA&oe=69F5F6EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
S_QQ_C8skQ7kNvwHzQZ2k&_nc_oc=AdrXU7mN-F4z25G-MKCbRyNfwgUdlY2wSnAWLY8zfkptce7xTdi1H0qbTPbWfkbZCfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ7NLUYGkJW26XyeUJ5GK0R0MyfC9rrdeEfaNRA5o1aw&oe=6AAABD5F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcsnXMu2sKEQ7kNvwE0kT_v&_nc_oc=AdoSxc8KTyRCv0FglmrTvwiOvdwBETCk20EiRDoCvB2AGAz472rM1Kk8f8NaigGFHFY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs8Pa6yaYW0Y8iJsHdqLYfg8mhlZVhMLLypc5HWQiEgw&oe=6AAA8D51"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K62KAuXKfNMQ7kNvwHNlGE6&_nc_oc=AdqIoYa-MoX9tkBB5y9Tf6VyNepPoYBXb68kQscTQuI-8I-UIoY9zu7-pWGbDGS44KE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUaIpeqXx6gtqwF04EHwC08KG56L8FUG0AdLn9A1udAw&oe=6AAA9B71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cHfowzIm5kQ7kNvwEV2eP6&_nc_oc=AdpSZSocxvPdJhmKXezWbV_n0wIsrtULCFQ_mhRK6CA_AozEdM0A_VTYIU-CDUCMDrI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcUkyR9OOidfjFjiAgVI4Me5WwuEAW2HdSKCyWS_XEAg&oe=6AAA9F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuqOXyZFmYUQ7kNvwEpp0bh&_nc_oc=Adq99gHpi_0TekMN78E34YFtY0TJGkmsSAM0SKNKCKb9Qi6S0sCyR492OHjglrB26Lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjPBLJwJMFWuL8C50N-ZnzNwfrQ2mPx6HXUSKxXLZYWA&oe=6AAA946B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
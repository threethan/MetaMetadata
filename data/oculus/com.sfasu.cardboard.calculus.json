oFkz2AbloQ7kNvwGmg7lX&_nc_oc=AdrmkM-J7_QUE0YXzpzqlW5l8wo9iB5YAToOwzySC2Vz-N7fLNUHngo2im55rHpDrjA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH03gHmFO2uQNhBVzDyJGBJS93XHg4_m6487bHxrMS5Tg&oe=6A91789F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPuWwDB5djoQ7kNvwGMLidg&_nc_oc=Adq5i1AO0mcx_O14dHxWqxv5_8K9YiCCLc20-FNr0mEpC1vXYBXWQ2oz9R001YXrQb4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1KmJJkA3RSRGRanHAUkWvDDK7jFsuRfJMyHyXh3stcw&oe=6A9180D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo031jckDVIQ7kNvwH-Y0nA&_nc_oc=AdqHGjiMkkTp2Wy5wmEkP_EvRZdf4P-bCi2pp2_qQ3dcDjaUKw6ZawjJObT1jshjl0M&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRjpg7IGlca3Op6VVJsJh2rDv7D-KxCKGfjhgB6NDyww&oe=6A918EF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gt6kZeeJ9IQ7kNvwH15XXF&_nc_oc=Adqzyogpi9lthOwcq16-ys6ct0ixgkA4soQzg5O6iCGV0-GA3bhjvHD3S2UR3QEitfA&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtthMA1MrVAIlMq3pYa1aEOB6UsJFUmcKr35wJyrdEyA&oe=6A915ACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBSDv12SctgQ7kNvwH1QcMD&_nc_oc=AdrMEkoTev8j3SOP6pNpQkOAB6eZANHwODyVLNKCULqfb8lLIXoAB8fZ5VdyB15Wje8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGldQXfZGrBIgt0qsuL8q67JhlN4YFMz5POnV6POlZWww&oe=6A9187EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
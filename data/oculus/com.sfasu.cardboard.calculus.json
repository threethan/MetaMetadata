vqa8ILeVIQ7kNvwFtzNxe&_nc_oc=Adqn6om2ZPHH2Txbh65gWGAgSOIwUjjw3ZJ2lo6BH-MU93p2QZ7OKgquROFwjF3b1us&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKyvvOSqyvttVK4RbItl87C1pUQ3QPJHMMR2zrXUc2iw&oe=69CFAC1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1Lk1o8oRcUQ7kNvwEKczW0&_nc_oc=AdpL_D_DgX_DX2A06GWYF8RQXFXlzsw5ndvL6eqHfWPN9EQZ6EzS7s-3SejPD0c-oNs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwsh5A34eXXrN5TWbJih5b2ZT7HCfN79vmna6A8l5DkMA&oe=69CFB451"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moNU8lP3vG0Q7kNvwGsEIbK&_nc_oc=Ado0Q94okavZxp2HWyY8VUc7VFNBbWBWkcahW4JSuzkU-moc3qqqgv5pUGW-Nt_iGuw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJcI5rBeeSPDNJqWp6j-P72QT3OIHbtZq4HPvcI2A4Tw&oe=69CFC271"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpnL6xyToIIQ7kNvwHxRSTh&_nc_oc=AdpwW1fd3XE-x3QHAJ0qNZC_2iPUN7v4OJX7YCqhuCoeMHXyhupw0kSHSjTIKjz55mk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwmz_Bn7WMcw4F6yEn-2J0Bxa6Fs2YokPcDpnP96kewSw&oe=69CFC68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhnHnMw3C70Q7kNvwEZzPcT&_nc_oc=AdoSKjEpRU8TZZJRh24LOeAKjlY-mRFmuGDZWc23zIIA4Eq-X-Oq1XZ6MlSMkNJ6rQs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxtosj2IhociEIPjgpYWJh4d6o6h2ETDQlwEptU7S-F2g&oe=69CFBB6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
4kMqrLe8QQ7kNvwFJ9W6e&_nc_oc=Adp7IcRmi4R0Z6Dm28bMe9CbsVDLHdcvnF7ndXCpIjwr3LYj7WMzMW-W8Zbe9ZPE5Fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNyV5muumXEIKsqILeuz13bRIFeIujNoSD3UvN1767rQ&oe=6AD24A5F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7OQaVk53m4Q7kNvwEZpPdB&_nc_oc=Adp_65nt19R28MuSheozNua7iq0Xw_GHVcTaIteKTOG_ye3WObeve2hPxRmLKwqBxVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlVoalFh5OVXyMjqHYqt5YNGrxbxLAGXGEDUMuXdl3Sw&oe=6AD25291"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOIpKLaYecEQ7kNvwF9b1No&_nc_oc=Adpm0i0mb8e12mt7KEj4pqxgAUKj7ShI0uL-cqtHuWtvFUl2nc14GZm1iR8NjwjHXco&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLjIMZzsDeNEhUrWJ5ZLkQlXsX1BTcpqMf7H4rO9tuiA&oe=6AD22871"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoSdGO4py1MQ7kNvwE7diDn&_nc_oc=AdpHEQBbMVAXkXuGtsvx2xB84hOf7hCsKJ59Gi7s2EnteugFs-uA6IETKRtmzplzNn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYO7HxogUASA0JdwAikeO0ab_l8CyjkCOEbS3uoTfPgQ&oe=6AD22C8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6257Xgki1OsQ7kNvwG2OlIr&_nc_oc=AdqpX2Ucc2_ET25Hw-miXW3-HbOkprSFzGRYwzWq0PpsCnXBpExVRY4y7YMtIyNysoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTEwas6Z0z5sqNjr1V1RtpEMCQCfvSHkrMdaKLKIa6Pg&oe=6AD259AB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
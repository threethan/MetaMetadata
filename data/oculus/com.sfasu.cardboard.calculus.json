vqa8ILeVIQ7kNvwGVpfGH&_nc_oc=AdrXmNjvcVuSeR_vpAflcvGEnRobCx3o-HIRzhNHcxYIIcmZZ-vXLqyxpRvzSfiX6h4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJNsSmjoFOtsEsDlOTM_8kVaeaoqcLgdTt9cKeyLHPRA&oe=69CE5A9F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdBAPGASjg4Q7kNvwH6f6LN&_nc_oc=AdooL4D-CukcYwLXIgxALBKeY0-tmjIdWA72h04B1g-PAmTdbzuI7FeC_0VloJw973I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ2t3dr7UvzZ-f0qkXlyEycUqrAvRbIbY6XZ70GCJigQ&oe=69CE62D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Udm7xm0goKIQ7kNvwFUbCoD&_nc_oc=Adq9gHu5cKJPATTdvE0kKZQ6vPTvmkLy7sTOFHlFHzEfudfIZnyq1EVOaVGP7-Hj__I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwxb3gfnFex1Mba9nwDiHU9P54EhlC1E_Q3GcOJeB0yPg&oe=69CE70F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpnL6xyToIIQ7kNvwFzMPTn&_nc_oc=AdrXaLK7tsdiLUacVsKakXKuzTyDIsmp9j7v8r8KcbvQeeV5m88Pv7MuqurDa-gjlR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJRDrySAzyixf1fAHC3P_fj8zs1phAgU6eb_PafodVxA&oe=69CE750C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhnHnMw3C70Q7kNvwElK0vY&_nc_oc=AdpVaAfzh-OSvQsZwIDpM5Z8jQQwBAAvxWp4KiRO_gpGdFhU-EAR25il8kueNXE079g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqTFNjZc72OWLsUGcle_dJl5ZICyPAHFOtj9_7MOFQDQ&oe=69CE69EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
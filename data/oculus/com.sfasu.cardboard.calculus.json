RVB934Kx4Q7kNvwERon9r&_nc_oc=AdrBzkR6Y7e50ITEjM9lKmd7YplfO9jublXCQWa3xgTHj_klQUXALnETee4HGgPOiUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCZFWBwCs_8WAZKYTp9vzPw3L33b3W9KPOy1DfzZhh7g&oe=6AA53F1F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82zzAINxpoEQ7kNvwGcHopp&_nc_oc=Adr1tbHUWCQwW5tTz99VktaVT6K9U9L34-mOQ2ot9ewWwN202AJxxoS6YrxvY9R-i98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPq4iiPFVUttPSAW-K_UJatrVdTLBfa6Y_hPFXkVaK5Q&oe=6AA54751"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1h_kqXuiagQ7kNvwGiYtRa&_nc_oc=AdrBbS8xeDu1EcV3mX5GqFqUM9coJq22J2oCyKas0piwkwgDhVIJc9WPGTmJUYE3XwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1XXP7sq-wj_6XL5oWyooyRIhm4V9yE_XSdiTwF8opIQ&oe=6AA55571"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4o4L56msAcQQ7kNvwFb9iH9&_nc_oc=AdpEAS5Zo9LIcDv_EbnVXizz5uDIl6xZF5rrFYVDv8zyf4yhVmUMCBM05hTPYRRqSTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7pYnkhD51HauUgaXwI-iIFJiDaFmfRaYNPMuMX4vfHw&oe=6AA5598C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tG7OudA81ksQ7kNvwEq97EY&_nc_oc=AdqiyB_Ac2BH9vclZUOUb14DV_JWbrAAtfJsrroiG7YnHsnfZRclA0ndm6socgrzo9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuHgH4D49mi-1-_WliK9_uXxAhsR2VysFTsJHoLLAHbA&oe=6AA54E6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
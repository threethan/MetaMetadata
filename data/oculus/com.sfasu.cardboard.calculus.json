mANWETz10Q7kNvwGw4_r5&_nc_oc=AdoU2QymMI_3GZg-UJl11Fhvj0HcdCpbasASUfr8fwM9HEi2AMcA5pVROO4hscbu7Mw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdqBZPbbwp4rX_Qa_9M86pMBq-er6HwMYYRpnefa081w&oe=6A8AE11F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RgwWP2FAPIQ7kNvwHJ9hFW&_nc_oc=Adqg-pYUqETGee7GP3kMcsHCYaHWudpnRbiBZJsgpJSvULxUEqigNtHBcJ1lF7LrEN8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVf4TfDU4iW5QdNGBKIQhyrc6PvQQ69OLZ2tVyd4xAZw&oe=6A8AE951"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkvT8eDLKrAQ7kNvwEqjvTV&_nc_oc=AdqlqXtamsioLW33aozJpLomDZIdTWxr1Etjnru4O7cUTopxfs4cSK3D5hOf2eV4a2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMJSklWwVEJU9MlrKeaQbwimGn7_aHYuFRS2-DLyjmbg&oe=6A8ABF31"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AotZD0o4nHoQ7kNvwEu_FcF&_nc_oc=Ado5Sg8D2VrkLSWysmX1ruyqtvIjIdfA0DlchZTXekHSSrG-xFGvjpE92IX8mxXFQKg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyZqj9lTAl6eEyIJrmtciE7GvKvOUdeLyjhX6bPEtfqw&oe=6A8AC34C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMNy28nt0EYQ7kNvwFyh8dK&_nc_oc=AdqhAvLmW_hkhk1vDZjaYX4gZmLgwsjgbidQVpHNYExb8_E8CMjZ9Ebo5OksKNmpoG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmxiItELq48jFdjF7aH26Dn2itJ33gSPPqiOs8ZJUu-A&oe=6A8AF06B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
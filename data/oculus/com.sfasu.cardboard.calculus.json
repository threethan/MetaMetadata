Lboa01ljsQ7kNvwH7PGDH&_nc_oc=Ado4h9XcZtxGjM6yfrpMESmeEupEpN5igdA9stKGENiHMl4IZ_SHIsJTizyG8mit0x8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DEeHvJXbdwlOtorkYPhFnAl8qiD8tshdUnWBLVpN-NQ&oe=6A2ADBDF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4j8nq4qQY4Q7kNvwHVBlvj&_nc_oc=AdrLjzPpsckjrcfgwbqgMmomnwinKpiIqW2t3Ui1413DmEEPr6DxcRDO2H9NnQ0cAr0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dhaLBRa8KY1MPnOaXCS4S-cnrbbNNGivMJrgB51UyYw&oe=6A2AE411"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysdfkA_pCPkQ7kNvwHv9ysA&_nc_oc=AdrT3UOCzKCB_YGcXBLxPWh1fROBgJXRLWmAZ5GGTionc8TR_VoDFxlskbB_l-GM89w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n1AQyOMT-EGDnXyo5Aro1srVEV4xAlMdr1C1alrlrXQ&oe=6A2AB9F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wro5uQU6PE8Q7kNvwHMTZfx&_nc_oc=AdohMgKPDfC7ejrquER2JYxpHss6Nw2nq7jNPPmlioGphpsVOTJBdA_GYtxtDRKa_jk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f1A1GD9Ue8eKxumvTHlWsoDedOTDaMxbPcb52cuPnww&oe=6A2ABE0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bre5StO84MIQ7kNvwG1kVU6&_nc_oc=AdpbjoF9Hx7YFO7StqSh2Vyxek_lH8FF5xP397-88Xpad9dG2p45vw7yW9IsLDYhTYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lgXQKqlMZO1hfXeaAB9htCAOl6uif0pScnSogPHyq0w&oe=6A2AB2EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
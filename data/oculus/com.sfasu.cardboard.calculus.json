nCQz7LNMgQ7kNvwE-ceGl&_nc_oc=Adr1pEi52GhYTtdjg5dLRMNQz6AI62ZRs91MztgyrD0QlfcgFXvKodudoGY6C4NdLpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zt0fsdD_zjAV_L0Hzbw7pCHPRPtMC5Xg3_7LeX9m1og&oe=6A380ADF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me5O3u75l9gQ7kNvwHF--AS&_nc_oc=Adrp2o4g_OnZvXk2lau4Vm5Pu1qL3Gob7NfPbGHfxwX5cl2UWRasybqxzrSB9u2MueE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M_VOc9cEzWUVzQDNiI-odznoLRAzzj5ANlacjv3KFCw&oe=6A381311"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHVZzHzFRpEQ7kNvwE0BPFC&_nc_oc=Adq_6ejHBZr01TOr9v4myKPsd1b92GIRwHlwRyR2MnQKecqK54Bn-KInfwsg8vMdiTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K43NOs7Cuw15hUK8KGRQWBIAwUdVmAV9380kcyzyI_Q&oe=6A37E8F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fJ8MxNZBf8Q7kNvwGgjTlF&_nc_oc=AdqhIe5sJsgfEGaYF0RBrO58TAIjqB0R8sKCkkcu05FJZyPFtNV75lnTppciWfPB380&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l9BRQ3ZFbgKunQdqZ-AdNqkKZFMTWJlOIXVmS3lZolw&oe=6A37ED0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ_5cvwav3EQ7kNvwHB17lb&_nc_oc=Adq1k-F6Nw0XiA7Ro0qvyDlnhUNMioy6ThGI2lJRBOLfeWMLoF0e8q6lR_KSJP6YX00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_38htqt1df9Cpcj_YXLDgLJq2By0UYLnj1pn3_oRcnuw&oe=6A37E1EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
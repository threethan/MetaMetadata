c7Sv-eBPgQ7kNvwGGahDC&_nc_oc=AdpGgnFvNbmsRarSVelxQrenOWRqAE316id98tCJYLyTWM_LuureyP9sGXltkfh1kp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ywn8AYw24OKu5iRdH9jm9I7q8xlHJ_EOAkmNQBF121Q&oe=69DB899F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNQgY5sJMBIQ7kNvwH8iSf9&_nc_oc=AdrQXL-tDJqARydplWBYWlk4TncnYX_gqO__peqAcQtPvGIXsw1oKEE6az1vu6zn5d0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hXpXhReBdgSEQVFgBfRnXUecaPrt7cSK5viGrHZNy5w&oe=69DB91D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACNU3x9Q9mwQ7kNvwHkDWjv&_nc_oc=AdpS9Wp3PLy15qvfOSVONcU6Q4XhJ94QGA2k7DikBDB4UgRY8E8vV7pUF5imWpvJd5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P5DNRLz6umi00-u_rq4au5l6Ls_Lxu15o0IuNHsiJvA&oe=69DB9FF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2Ew0q-yi8sQ7kNvwEVAboH&_nc_oc=AdqjlpVBvb4ZupYRdxJFPuTXJFlXc-LxqcX3vLyBmr2pv2qWVRxnXNQ29IYmCMx2Yoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05Wrn88mosRn5imuowUnaiBsChFX7GHTeVo4R0-Uqu8Q&oe=69DBA40C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5nqDF_5uxoQ7kNvwEhPyz4&_nc_oc=AdrnxdR-kEZLRWwdnkkl2xXXNgFIY95nlU8AQAgVKnpesUw5wj-lgAdzJ_tJ_lU2Ops&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_VSeWeZip9jg2De6DlUNd1_tS_9vGDmHj7XbIG8kOJA&oe=69DB98EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
uUZt2GuZMQ7kNvwEw_NsI&_nc_oc=AdpaWitbdaOz13LskLFpS5Niv7KXbQUqiueRO5vn_hKw0ufdywZzsDYGA3zacSmDqAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClF3SLhduGrudUWRP9ajkL-L9A2NVvh6w_w46-UKH9gg&oe=6A69EB9F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cazAOSvSGSsQ7kNvwH-BB4C&_nc_oc=AdomcwRwgkeSa7-Pb5gqfst9d2C34Y1nwuFA-KAxWYCeKFNfAuDnyRkEwHNAIG0Q2iM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXaa-v-ZvBUPf0z9SPN_WGYyedLFwxUHJLhgPLZAtauQ&oe=6A69F3D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnO-LOccy8AQ7kNvwESLf5O&_nc_oc=AdpEy110wzF7tZ7tK820M45ATXySRutU192dBCRzQF5ryBuyHYwWEMhsee8FFny71NA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_ZhpWsoj0KCdxg0nVhvJhfHe-DLb3caFl7ZwjjhMbdA&oe=6A6A01F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ9IgDzaWfsQ7kNvwFc3DGX&_nc_oc=AdoYsnkOZawUPgAaQU5z-J0ZQwlpmWMVoE1PyiCgamreCtHWokVzDJJ39twI4DHSvGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ_YVmA2yJF-z8dueNWIWsL-ttLfagQ77hjbulBd_PGg&oe=6A6A060C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy8hBQcbFq4Q7kNvwGtEpiy&_nc_oc=AdpVjed-YBfKm15K4lFeVPwegGdPfDwhWAxdBRu6aRNDI_XN5FM_0VLCCns0ROJrAog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxv2EZayR5fBVhWFyG4_T-0GY3HJfOAU2Otz-SL2IOkQ&oe=6A69FAEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
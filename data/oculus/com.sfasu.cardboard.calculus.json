yNdUGMgyMQ7kNvwFrIPOk&_nc_oc=AdoynW_SZjiXG7BelFB9lnbkIUpudV0JICKDloZn_yGfxtP99RMNCNnUq-us0xZyRgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jmPAiJS0APsjlIuao0dXE5rf55Pqjngy9WS5JLclARQ&oe=6A0AFF9F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tztAQZqe6wQ7kNvwHDwDW-&_nc_oc=AdpH2aK_2l3PFn_RmlSGpSENeaRqDS2v-OgDDZqyet-wVHBaPPACCAw7HQsemTczesI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cPhEZJDesBzFlouEyJDHr5l7PNRDXPBoxnuoAZ7N15Q&oe=6A0B07D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snVjeRoz67kQ7kNvwEn_w_Z&_nc_oc=Adp4Ua5zJiarvpPZ2NF2ggdREpA3pd4j3NUB8TNclRnuG6S-ooRx7bCbKFqYgzFFlEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-KP4I4UTvxTKTyD35fpyUfoJ_MBXJunlj2utxSdFE_w&oe=6A0B15F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4LW-8hPPn0Q7kNvwGz1H0r&_nc_oc=AdpisBx7ZWkvMqFeFN-HscKeSLKeLVmEPn8tvW0RtJEuTSEWDiB7apfOyG64ziUZqVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4--nHtG6AIeJ9ViZa7LC0JjlTV7ZorpAZazf2--CGc4Q&oe=6A0B1A0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jr7UE9i2PMQ7kNvwFj7Nsh&_nc_oc=AdovF0ETsPQ_XNR1W4H65lotycUwvj6UQUA3yhzCNil19Fe7KTeCKcXB4rvi-CbNakg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xBUM8Vhe3XdMPt8RHHFmjxqeGpvmdDf6CbXWPScj0Ng&oe=6A0B0EEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
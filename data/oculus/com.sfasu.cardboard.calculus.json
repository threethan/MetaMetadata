4kMqrLe8QQ7kNvwFmzfcj&_nc_oc=AdoPjTBumW3hN5b3SD45AScxOzvxFjFCndR152aRdMKH3MXSIlo3jM74gWfTrJWOebw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnDZeWBR7foxAQH2oZbtmsgB8WU3YCIvMmgINjjK1MpQ&oe=6AD0F8DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7OQaVk53m4Q7kNvwF47igr&_nc_oc=Adon3QY-BKC2wBjxk3vXV589jDl0UGDlWVFNeHYTuwx35eEfhi3r6KKLSvve1hmGgdw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfUNotd88FssGVllDic2uiWybMVWj13fxB6MX1x3rAfA&oe=6AD10111"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOIpKLaYecEQ7kNvwGBruf2&_nc_oc=AdpHa1nwCxHAjBMcYQwlQdZCdw3aPdt8G3Mwp6gbiArwa8Fc6wtLatOweq4xl8ZXZN8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOvuJVbLtsfxRb2fKntrZ4zfhIbJgtwLmGq4KEqvoekA&oe=6AD0D6F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUI1Z8OUiBYQ7kNvwGZD5mS&_nc_oc=AdqMOuo-7Ny3dCHItcDiweWrV1L_r_00cu5hj-KTQaywdv0qs8Q1yrkOU4fjgD7UXLo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrt2cawNv8ga0oeycy-K9tIc7RPpDSvhFiRPSqYTCvEQ&oe=6AD0DB0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PREJCMvw64Q7kNvwFwCwmL&_nc_oc=Ador-5HMjPUiQTqVD-PRXMSmGlP9b99wiHQp48H8d2vhm-TFZaxO8EAgnk16dNMQgb8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0OIk4YbARpPDhAUAzjf2uTbOReUODTEW76jVkAKETqQ&oe=6AD1082B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
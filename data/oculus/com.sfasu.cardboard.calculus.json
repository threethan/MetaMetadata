oFkz2AbloQ7kNvwHyvWcP&_nc_oc=AdoKt9qgJNhbM3NLiImmwbATRbtqUqKUA96KLZke7AtvCBuHGoL8nwF7h8OkjpzKibg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDUarDlrep2NVP8UidwWEP8EUOxKnOdhRb5S4qFTejIA&oe=6A90271F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=numAO7FkekgQ7kNvwFjOiNW&_nc_oc=AdpPdt1GsgjKusM-rl8A_kzrZS0eqLRrCqd5opRqwksjSkIu5g8OKJ8-6gs6FJ-UOmk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvybqZJElgGyzrEKK0AcUGdbqmHsr6ZMuz-vNjJvN_HQ&oe=6A902F51"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2wFiOklptoQ7kNvwF92Del&_nc_oc=AdpjZlSMfb5SEKZ5zoqmiDubULT6JElt0mOFfaKTlHS5hRCnhaza_8ofaoxC85Fb-XI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtf0YDvIYPIi0APll0st5SX9d4tWe9QH0S8xw4reCebg&oe=6A903D71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gt6kZeeJ9IQ7kNvwGtHDOP&_nc_oc=AdokZZ0E1svpMr9nsBTp7KmpQJjPzXfOgEd1FwAjxMjwg8a7MhubzXzbAUtSO-HK1Mk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN9QobdPcm8wTJFVZph-DTlh-9C90erAfENzGTAPC3aA&oe=6A90094C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBSDv12SctgQ7kNvwFrMCt-&_nc_oc=Adrw_yPootCPhF1QyxWmeHONGW3UjUKOmPsrC8abU5lRxeR_RN62xdjubJjVwBNeQZU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmlYTvKxxixSeR5OLgvuylzMiDd_hrlXMXCMXy4FDw9Q&oe=6A90366B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
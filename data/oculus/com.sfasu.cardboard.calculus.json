nE0AHbfFEQ7kNvwFCN0hq&_nc_oc=AdrVVAEp5JH_b7Uw2AvoVhxD_ZkuTg76jBYKgJoxchbhgn_i8UPMdr9sE5_2A29yoSQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfHl_DJ4uMp-GGaG7JD0jh3BxFD2Ay-ylH-UaBsHIMxA&oe=6A9FF91F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oO48hbTqIMQ7kNvwGLa0j4&_nc_oc=AdoHzGbsrsv0oM-bsYD8R4tGHMbrbVqlCl-iV6s-UC8a_Pt-EMu6WSXG8M6Y3YjkSGA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn8ZR5T5AW9rs599gjsHs63UTjeBCgniwbaiMKejfRUg&oe=6AA00151"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRMLl0EmTYYQ7kNvwFf5Ca7&_nc_oc=AdrfpNYOCFWG1IalPFltL6b5f7494QlaBFseEgTxFXGqixxI1wQBGcFQ08dmDP29_xo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-DNx-oLvYXTMBYu2pQIbUS9iE7vCnGpZXBxB9phs0wA&oe=6AA00F71"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2ribyxwW_YQ7kNvwGM41-j&_nc_oc=AdpylzEAGXzBEm0b1thW86X2yl-BBfPAyoh4pIx7HByQnarTKlH2EyQjr-O-iEJucDU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1KmBFgN2RgblKCuXMK4mn6Vw2PutV9-haR4hyQfyFmA&oe=6AA0138C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XB2eDjiBhoQ7kNvwH3jwy4&_nc_oc=AdouOSJd5lgGsXUmoCbFpSo6vK18i2UoV6bh0OfsDDZiqgSM-RKr9dlZCCHkqyOURzk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt5J16DoQ0sfEKVmspyLBIhk8KhSA0Cvz7659huGpaIA&oe=6AA0086B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
4j5kBhOGm2Jn-zglAIEAwhX2xu4ERhRqFZVeahqQ_g&oe=699EFAF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73YFse_Mn00Q7kNvwEPBKSA&_nc_oc=Admy27bjtN8LVh5QmZtvVAx6HLRYFzxGlpC7cKquJGhxj7CHW-CUEriWjTqexpu5_uM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfusKL7a677J6MxjB5N1xB_zXqUXJ7W8UzmU0syeUxfJaw&oe=699EFF0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIGKYygqDCgQ7kNvwG1fT9E&_nc_oc=AdnrRvXTFlqcWJfrnEDVZZtYxnT7X1QTVH8U0-bakW14fB0gDtG5w8pH1gG8fvQhmAk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv43EBk3-vcSjcTh20_0Klc3P_5EW9UDO_VQgdKxDcbfg&oe=699EF3EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.o
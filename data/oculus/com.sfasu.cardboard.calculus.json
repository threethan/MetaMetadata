ZkvaxaccUQ7kNvwGOSRbt&_nc_oc=AdpWCrZd0HP1Ml47Vtn6iXfXcHmHKridzSlTHBmRqevAoxAnK_rAv3qZQRJ4juCm4Ks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnVfCloLWGBzP7zVHysNJcRqpIYK4rn144G33QgHwENw&oe=6A62029F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O0FCHugIsvsQ7kNvwFj27Kv&_nc_oc=AdpGlmfqc_UwGjD3K9La38kc1ECdSe9tqruVbqL-uiyRAz024d_jqlCxndHUZXTAkT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI894F1sQ8di93764ndK-p5u-ivRJyz11Uda5ihS1DeA&oe=6A620AD1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsSzTkatc7wQ7kNvwHWhiRg&_nc_oc=AdoBESUdQyyP_nl3_AzkWpj3A7a7Ue2kKxfZv054JzWKDPDNoRVcOTNhTe6U4J3c8iY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvJKSoBUfRcrVv3dmJqaMTI_tAQGqpKgznw2BvgY74UQ&oe=6A6218F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3czfCq_jyvoQ7kNvwE7hZXO&_nc_oc=AdrjLfW3UdwURNHIQi01O9HcAHTustOhTAZ2Uhp1jK3DaTYCNq4P9EjREd_S8tI6pas&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7dbQcUDahL43mgxxsLG1O3Q250zeeIsHlBz3Bow5EiQ&oe=6A621D0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPcxA24wnK4Q7kNvwFYfpsM&_nc_oc=AdqFV4wNbvXMFi4QGimlJd1NCQnD-p3jLE_NKfMMxEHnIcjlRsYm3pynwQ-_-8piXA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzrM4sMqBIfP32P90-GJncWotnTBfMya4lQAesdb5DYw&oe=6A6211EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
ZuCAoMF0kQ7kNvwFzfnf7&_nc_oc=AdofbqIQVWdIH9wn97UPAKjq2GkNKg8jzLfYtUWaTI4p0UHYbkHF8ibSuJMp4_nAjLU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4QnjMj8tJcKm4FFv_hAIm0sgskPCU54GK7o7IG51BPw&oe=6ABFD55F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gY8e_Tl8GEwQ7kNvwF5H4jZ&_nc_oc=AdoLHRLzJC2roG7A08FE5Po0V47wgcZnEhu5rqh63ApgrgWQvccyd6q8SHUI6FW61Nc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOimduBS10kYvGLQOtGeDw7j21J06IRuIMJpiPFN02Qzw&oe=6ABFDD91"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVhxqCIlNeIQ7kNvwHj770y&_nc_oc=AdpAVJ7O5qDFDUl4kab8VVsVx7i4_ZWVTvsd-BEtGbUQRY4E4T7NJKRQvSLElUn84aw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQN_hfLVzjsYUPMN3JwsHIg3lyddUPj6wVG1jYwx1ZTQ&oe=6ABFB371"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inBpLQKlin0Q7kNvwE48ZVe&_nc_oc=AdoXXChUcdG5cLpAvK4iWzjEhUjf1m6V34G56sfzGV3YrpkzcVueMuH0Hl21CXNE1eM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ-vrLyNbBZWjeH6bYgB2_hr4cULS31vMNwCU2GBFJ3w&oe=6ABFB78C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPOxt0eM4JAQ7kNvwHGE35R&_nc_oc=AdrGUN_9WeRCj2EECgT-sJqkD3JKYfLgK8eRMTls-a6WeuDHz4ZY1F2SYfSWpAssnO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTTCzUaCfq5h97XNfweLYTbzvMRqG1pjGEUQpbZKO6sg&oe=6ABFAC6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
, "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARa1B7PUfrMQ7kNvwFH9C6r&_nc_oc=AdpV4OK03WrUOnFWdNbeF01EckX7uXJ4fHkIiZhzlQjstPdFB0GpjcfTcgZDNnRAQV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAw-qa0Y1Q6ZayR_xND6otmeww8BWu3URZYuKSVQqKWg&oe=6A788271"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33aVdyHvc1MQ7kNvwFf-y8q&_nc_oc=AdoqhtwXORoDxYuuEi31ZBsYI4s67srGPlnrKqdSskWUCfM-BuiRKnr8lDJ3ZlhZqzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN_3-S0Op6x2u_tavoP5K0c_tP20_scFehkBufPUILHg&oe=6A78868C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZlVWW16fZwQ7kNvwEGsL0O&_nc_oc=AdpDdF_BKqz-SLwuvA1iBMDAKiBOMEy5CUuCptIzbYoADjl9nXOcv_OuUpUbQSeC-Xg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFlF1CCQukWe1euuyRX6gQyTAC2V_p_L6eB3RxWWEcOA&oe=6A787B6B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8801976453175912", "version": "2.20"}, "id": "783691065656975", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6150858738287710", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8801976453175912"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_na
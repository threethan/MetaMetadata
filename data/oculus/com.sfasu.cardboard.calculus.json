3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftpavUk8ATNTqU-GH0HcKF-OtbNzj7bqciJYlBcGlfMZQ&oe=699D931F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fYMJ7koy4MQ7kNvwEdTskz&_nc_oc=AdkBTS5odBYr8d0a5c-AGx1nX2nK3y6pVDmN3FLWDLf9V3lbj6R0SOaHMdxycFq2RNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsI6dEVbYgEu5XSVDckyXOp3hr95wRb3qp__Llxo1J34w&oe=699D9B51"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FT-f9vE4yPEQ7kNvwH50epE&_nc_oc=Adk86pkDUSDq9ZZtRga4jdPr51bsmB-i7p9t3AtcD7WMgiwLnB5DRGbD0kSG79SB4uU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsl1RKfMkNaFLvqO5kTJy7GPNsmA22_BPUMkL8OLS3Lcg&oe=699DA971"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73YFse_Mn00Q7kNvwErXtG5&_nc_oc=AdlkY6kFXsa-JZRXSFwdRBoJAc4dwWxUXZCl3IISWLydbh9YVUwBEnHaAmCydz7K80w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9utYLdt3yt-cADeTuFPNDJ1MMmX6QU5nPQnlGq_HxoQ&oe=699DAD8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIGKYygqDCgQ7kNvwHLK6MB&_nc_oc=AdlIWIYW2Zv7pzyFO5u3twHM5qYCGxrnagGz2JBuvpw5JE3NcMnuDSJHS0_sFft4ZBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afud7Y7KXD11l7YS0JG37Dy6JIgxqgeKtAHdZ7dnsDwEow&oe=699DA26B"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974459_544935220176392_814484475143074628_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_n
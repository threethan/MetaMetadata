h-w1a2G1EQ7kNvwEL6RCH&_nc_oc=AdqiKaEkAUyRcoz1W91rVTXv8VHmg9jiNk8WIJ0b09rzyTIg3DdkpFayyXIIBnUW7SA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DUd3fk30_KuegMeeKd5-jQakDaEwYHQ2U6xAWRDiUPg&oe=6A4296DF"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9lx72HI5k4Q7kNvwE9yB3z&_nc_oc=AdqjH4PovvZCN77eayL56HOnLMsTNHy7O0lYKx7zypPJReY9EEcwu9IbmrtESCUKQJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j4atq3Fno1F1lMV_1YCuVdfvgGjXiUw5KMekyb4r7-Q&oe=6A4266D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16Lunlyc5vwQ7kNvwGNkyIa&_nc_oc=Adr53Ps1nTzP_yzEso2DRnvdQdrAsLDctJWvVsBBJ7cigvfLphGA5-hK52wg0-CNlBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gXzTsawtrcF16igrOywq603LXJ05b6QdfpceXiz6B3w&oe=6A4274F1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZvqzO4eEAEQ7kNvwF5i2g8&_nc_oc=AdrgOibKCt_lJakm7laP1fYrByrfKizszvf4nNjgA-GwOGE-daW24aUEF2YDyq36Sek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y-xjum0BBTVBcb_bE_ZB6OJRrZZxpgRRdUfT6DQHTBQ&oe=6A42790C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti5DkKC9u_wQ7kNvwH3-6dF&_nc_oc=AdoXh4g7cMkwWoEePmOZ8jSe8ZjTyhxScec8kds5R_A9lc8yEq6zH057mBtaoYd4RCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KPF_hfJ4b8e46P_mrSiYcoJNov6aQ3K-MUxSk6acYuA&oe=6A426DEB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
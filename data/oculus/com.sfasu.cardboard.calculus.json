dUQm4dvf0Q7kNvwGEUtSY&_nc_oc=AdrD2hYSXErq86xSKjuqNQcxg_LSZ6Mk9rVlWq0YIcVeO_qSYxmuEiYcQihTe3yBheI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QnW_rfRdthKhpQEWZqPlSi_Tr5G3dXCh4DpmE0GcaRA&oe=6A05B99F"}, {"file_name": "OPic2.png", "id": "3068219530161493", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_3068219533494826_6250086734206706738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piuQEwt5U-0Q7kNvwFnB7ae&_nc_oc=Adrg80iyY70f9-_2v3Ap4rEc4Y7vb7-pVOMkI7lkC609iVQloSbecNyi3X-CnWVCkWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VxWNxgWNeyAxBtP77i_12lpJ5lufNLJsr84ssx_ud_Q&oe=6A05C1D1"}, {"file_name": "OPic6.png", "id": "1120134045443699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982596_1120134048777032_6326525325192354927_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBBEuQ5MRB0Q7kNvwH0Y8w9&_nc_oc=AdqdyJcQkZ2O-R8Sjj_WS4TvS0NX9dIQEKWaW3lzvqTwWthniQeonZ5DXG0GanZam7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yRsKHQ_SOyEQki2I5mK2C1if2v_HFw57VVtKVjMiU5Q&oe=6A05CFF1"}, {"file_name": "OPic5.png", "id": "759888274975318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035424_759888278308651_3917968689767614253_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV_o5L2BuE8Q7kNvwEVvOoa&_nc_oc=AdqhzclQb2m9naqpVBOy6NLtuniq2DqsbnnJJlYVh6WXMzrvUg1G0xf3FIJe5GVMjUI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4K1-ytnVa2yTUwbuIFkjjo-5ElTqEiKCrmvpJUyzcaFg&oe=6A05D40C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DemoScreenshot.png", "id": "716412476040559", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982666_716412479373892_1832124735032102603_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOaKeFY7O4gQ7kNvwFkUuGj&_nc_oc=AdrwFiThSCIlrh8xRv5ZW1Z46CV--wfoFmaeSEfTMKh6vZHZ13qvX18hiq4x4EPY0rM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43UMotZ5EDf8Kp_-44RPT9-UXVVHa0uMBVDtrUQhok7A&oe=6A05C8EB"}, "display_name": "Calculus in Virtual Reality", "keywords": [], "long_description": "This app includes over 50 lessons and playgrounds covering :\n- 3D coordinates\n- Graphs is 3D\n- Curves and Surfaces\n- Vector Valued Functions of 1 Variable\n- Multivariable Functions\n- Vector Fields\n- Line Integrals\n\nYou can find descriptions for lessons and playgrounds, as well as supplemental materials for the CalcVR app at https://calcvr.org.", "short_description": "We have added literal depth to calculus! \nThe CalcVR app enables the users to visualize concepts in multi-variable calculus within a virtual reality setting. The user can specify their own objects for visualization as well go through lessons on the geometry and calculus of multi-variable functions and the corresponding surfaces. These elements are rendered in VR so the user can see the depth of these mathematical objects and the multiple facets at play in the study of these mathematical topics.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://calcvr.org/support-and-technical-details/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "CalcVR Project", "support_website_url": null, "website_url": "https://calcvr.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1368381953661924"}, "review_messages": []}]}, "cover_
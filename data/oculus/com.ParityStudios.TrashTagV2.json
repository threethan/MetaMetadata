192503.png", "id": "1466421738156772", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308045_1466421741490105_3938183062902435309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljGAXseFtmwQ7kNvwF6GsQI&_nc_oc=AdqvjYsGMmLVnWUPjSSlj6RKb0tR7cqX_LzOhLMU6Tj10v47eO7E6_E9_loTlkry3ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DtNVS-GkHSdDwd4RkCyRTNxGRmelCUGNkaatwReCq0g&oe=6A032CA0"}]}, "id": "958305633222235", "locale": "en_US", "screenshots": [{"file_name": "Picsart_25-07-07_16-05-54-443.png", "id": "1801465727389374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820596_1801465730722707_7717535104603795055_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwA-1KrDJlsQ7kNvwGgRSkn&_nc_oc=Ado1MZdhYfgMUgBctQyQlCB8GtLRy04htnOitBvvkuDbdEAih19K412y3_qAeOhszOM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h7bjvQrrQIyfKLJowraApT2uULbTXEvjJ0kzEXjLO0w&oe=6A0330C4"}, {"file_name": "Picsart_25-07-07_16-04-36-925.png", "id": "1099740382012114", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823934_1099740385345447_1264112061763376901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3TL1l7cGcEQ7kNvwE--d2e&_nc_oc=AdppX0DzDEONp9e84cBZVUOEfRE-PzkBh7wy40wD4XfsgvufBHp8_c49CqmKTD5i57M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HrG5fC6OOasTNHFSV6RO_kpbcR7LmJOdDfVuzb2TXrA&oe=6A034546"}, {"file_name": "Picsart_25-07-07_16-06-17-362.png", "id": "1074876217508636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820270_1074876220841969_1526292120073201580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfCPlN8topMQ7kNvwHk63vR&_nc_oc=AdpTabknldGHX6xPrqTcvCzwDYR9oHEQ5azBRYkO43Iad1JBz68QzK8RWE7F_TGd0Kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53165OX_X6hml7vqYDShDnvfOhWrB079XFiiuG2O-cKA&oe=6A032098"}, {"file_name": "Picsart_25-07-07_16-06-46-532.png", "id": "1445097646908625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822489_1445097650241958_882028757366744359_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-LH9mPhOL0Q7kNvwFEIYAr&_nc_oc=AdqbIj3Rn3f0HW1nnPnr-FctF4FBef0UPCaPtyVe5L8PH08X40PrjVnulz0MMiHLcws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-hYKOqjQHpkndwIeM_FdavwL6Lic0-K6dw46mx0mcPA&oe=6A03153B"}, {"file_name": "Picsart_25-07-07_16-04-13-994.png", "id": "1042686524712213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821230_1042686528045546_399919218793683589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IfhYbUoTHEQ7kNvwEqczKc&_nc_oc=AdqkFdoAD8HHiPgnvb3EoiT9OqYiJGAONQY8ht41ssjoUMiNMPSDE6QdFyqb5aGZ6dc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qo30c0u_5G77g1v6Qf9IaLZ992kOGup3zpaHkCfcbqw&oe=6A032D4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": ["trash", "tag", "vr", "fun", "free"], "long_description": "Enter the exciting world of **Trash Tag**, full of unique and fun gamemodes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms. The movement is easy to learn, but hard to master.\n\nEach gamemode has a unique map, making it so players can explore, while also making the experience in game a whole lot better.\n\nYou can hang out with random players in a public room, or join a private code to play with some friends. Either way, you can chat with other players via **voice chat**.\n\n # Some of The Gamemodes:\n\n- **Casual**: In this gamemode, there is no task or purpose, you can simply chill with your friends or other players. Perhaps you can even practice your skills.\n\n- **Hot Potato**: In this gamemode, you have to run from the player who has the bomb. Players can pass the bomb by tagging other players. If you have the bomb when the timer ends, you turn into the ghost. Once one last player is standing, the game restarts and everyone is revived.\n\n- **Infection**: In this gamemode, you have to run from players who have turned to lava. If you are tagged, you will be turned to lava as well. Once all players are lava, the game restarts and a random lava player is chosen.\n\n\n", "short_description": "Enter the exciting world of **Trash Tag**, full of unique and fun game modes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26580226534920025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_2040407320158415_4649565100265594921_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGy33fbJlsMQ7kNvwGEdYiJ&_nc_oc=AdpGI_IH9rnA_nqve5pNlOcQAY_9tqiewsiE1ccyX6HLgUQj3bmJvDs8Bm_AUKBDhEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U2Ddu6fUAgjUq9sRrv3KJMswobUiSf_q9Ocp55ETIwA&oe=6A0344F9"}, "is_concept": false, "
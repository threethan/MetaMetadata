0"}, {"file_name": "1000377127.png", "id": "1430235894968010", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300575_1430235898301343_6259790545600075740_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8F832dFth10Q7kNvwFwK1cV&_nc_oc=AdouMKYpgNd80J8w_JgjLumfOSJGV8TN33CJv70JyNtJYPoLZqaImFQjfxF379uqZeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26hh0UtvN47lDItUKZ4736HuVX0yXzgq-y1ZXeIeSu-g&oe=69EB89C9"}]}, "id": "834873442266004", "locale": "en_US", "screenshots": [{"file_name": "Picsart_25-07-07_16-05-54-443.png", "id": "1801465727389374", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820596_1801465730722707_7717535104603795055_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmmM3GH0PGcQ7kNvwGBu6LM&_nc_oc=Adpk6ylK1_Qj6kWPKorX8E11V8SS9lT0dJtPVo7JjGb0JeMj7Jg74g0cqqWWLRRZ9pg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dAjNU9ZX2HKEtmk6Yvsfkmcl_GHhwUxqpIrMVVfl0aA&oe=69EB75C4"}, {"file_name": "Picsart_25-07-07_16-04-36-925.png", "id": "1099740382012114", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823934_1099740385345447_1264112061763376901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvTBQJD9v5IQ7kNvwGSWowP&_nc_oc=AdpKWf-mipXhQ--wTgDy6Tfi6eTGhdg1HIZzPak8CiqRrHkGof5Tyy3zb6B4bvgR72c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21igJWQwadgtNYLR2VyuMPNfvGI7w2khioFIJnAEY50g&oe=69EB8A46"}, {"file_name": "Picsart_25-07-07_16-06-17-362.png", "id": "1074876217508636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820270_1074876220841969_1526292120073201580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM7VPmXuwC4Q7kNvwEW9map&_nc_oc=AdoN4DIeGChKSo4M38bCW3OQIiWgkqziykFbX3O3XNeHlAaVJuM3wH9B8ur2iJrmdOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yWCi4whNUH2zAA8aci74Cm7-gVotf8BfAYR0B3s1HQg&oe=69EB6598"}, {"file_name": "Picsart_25-07-07_16-06-46-532.png", "id": "1445097646908625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822489_1445097650241958_882028757366744359_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-Eu7gklKWcQ7kNvwEjIYVO&_nc_oc=AdqNk8su5MBDVcqypeIpEf53Qzg0ir3C6iUCqY-MAHlq9fIcE7EQVTZTfI33vdQ99mQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SfNj7Z0uelfff2OxI9Tg1oAl4DN2VmiAoQNlLR1-3nw&oe=69EB5A3B"}, {"file_name": "Picsart_25-07-07_16-04-13-994.png", "id": "1042686524712213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821230_1042686528045546_399919218793683589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRGfQz6B1DcQ7kNvwEQID0c&_nc_oc=AdrPwgw1d1vLIa4fGdPmigHLpLcGhCOkKZGu-H1sX43BufZpg2bACVDwjJh3fo7HRcE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-hgW_qcqXU7Yo44PnlgThxdB1RCSIRZ0sFrR1JZI5Gw&oe=69EB724F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": ["trash", "tag", "vr", "fun", "free"], "long_description": "Enter the exciting world of **Trash Tag**, full of unique and fun gamemodes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms. The movement is easy to learn, but hard to master.\n\nEach gamemode has a unique map, making it so players can explore, while also making the experience in game a whole lot better.\n\nYou can hang out with random players in a public room, or join a private code to play with some friends. Either way, you can chat with other players via **voice chat**.\n\n # Some of The Gamemodes:\n\n- **Casual**: In this gamemode, there is no task or purpose, you can simply chill with your friends or other players. Perhaps you can even practice your skills.\n\n- **Hot Potato**: In this gamemode, you have to run from the player who has the bomb. Players can pass the bomb by tagging other players. If you have the bomb when the timer ends, you turn into the ghost. Once one last player is standing, the game restarts and everyone is revived.\n\n- **Infection**: In this gamemode, you have to run from players who have turned to lava. If you are tagged, you will be turned to lava as well. Once all players are lava, the game restarts and a random lava player is chosen.\n\n\n", "short_description": "Enter the exciting world of **Trash Tag**, full of unique and fun game modes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26301599929449355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620856_4406501082966396_881442354464159390_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAW_QWayRjsQ7kNvwGbV_u9&_nc_oc=AdovWhEf5uOhh4LSiuHJyHfh7WseQ_kgwmGhvL3GQPBGkaf3gnLY69P94UO3Frq7hN4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_L6e3jx3iiunOvH347GDg5yNNTTyBYYxPOMuj-6t-CQ&oe=69EB5A81"}, 
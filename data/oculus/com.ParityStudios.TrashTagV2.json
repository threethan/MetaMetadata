i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD5es2JmC2oQ7kNvwGdKwDO&_nc_oc=AdpFZI0c1z57h7rRbK0or1zlXu5KBHmaZ2c-RlVQEWTxVRr1_ghA5IXkXmy9oSsWOEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpr35AugafCjzn6LE5KcoctuuJq7SUaoqiHLaagpB_2Q&oe=6AA55BA1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmfklfIpXLsQ7kNvwHSxK1i&_nc_oc=AdpxgfNyCurV2BIl6iSCURn59FeTA1wIR-HlynIh_uWXX-zcd8islr1wOCQKm-cGkYc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_hj-MpjFB-sCA6vO-RQs6rTbpkt5Z5O3alkCfMGpk0Q&oe=6AA549C9"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWJMTSBvFUEQ7kNvwHxRTyx&_nc_oc=AdrGrg6_Fkyo_HNFraVicRPP4sljnrIPCXuPvsfUlRJQINrfkFVQCXi7ws9EZWJLJo4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlhIiD31B75XEJJylfgFffHyptI8F4frYygo9SMPX4bg&oe=6AA567BB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkNBNR8TIacQ7kNvwE9OnP_&_nc_oc=Adp71FZhRp6uHt8wcoiH2zK-9rqWCeaeeOnUmlsV7IhBbHV4yzyDeIIZZ6BxYS7Gi4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWk5uqSl-4oFoeqk2FrXXjy3O-LcxBturWzSRjY6ZdOg&oe=6AA54405"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4f9_I7uNgYQ7kNvwGgYDMb&_nc_oc=AdriXpvp7bxEjdtLq9D47O2j6u_usLIYX7CLUHBOm3a3dmhap2zOdjdN6hOW4oqIV4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQbfUUp4T5LQhl3zYFrlPJESPQ7i1VRs995eQ46E4dQg&oe=6AA547DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
i": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PemZfJOn_DwQ7kNvwH0WKFE&_nc_oc=Adqpc44bo061Pq-blLyyiC2rLFE9Ef4c9uqQ1qCrmfqDTz2OL434U7D7q3uAX_g7IX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2l8bker_K-7LAxMSapCXLbtFYO5yCNp65pdyxTYxnRQ&oe=6A9EC421"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Htkr5OozeRoQ7kNvwHSaywG&_nc_oc=AdqvYllnrX7hWWaLjwSkT7vkkSAhMm9r8OEROpkf6YCa4zQXCuNqMUnOZjjSV57EGc0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD95k4nk4tzLBiD4pw6L2V7G0u646RLXRnDfdZgWIsHw&oe=6A9EB249"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB7vBH4XPR4Q7kNvwGcCgen&_nc_oc=AdpABtRIIqixum69vmxxtvRjAl3r-PvPTLBefqspzNDru67PwoDlnpzOb9uaFqPq7x8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKO7FL8OlKnuK5hZGWsAjLL_2pXtHeOnvHUpkg1GcKF7A&oe=6A9ED03B"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xi77VCskoPQQ7kNvwHaK9N5&_nc_oc=Adr-Kf4RlSCxcCv6GGRDOSzEYjLzfHo0TDCLIjj4qM1JGVXyJ3Zq6PnhMa_clKLfNaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL52_x258GMvM3pJWtj8Qf-AAWHRiOFIjl_9A4kKbfu-w&oe=6A9EE4C5"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNXM2h6iohEQ7kNvwF7DpIM&_nc_oc=AdrUqYtfms2w0JKJRln2iJs_yKEn5dciVGouNt3dOE-lSpd-OlE5XTc5oNZix2djUiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPgq3YVaIi1q9OQ2_MsjuWvL19gCaowwfVgmqnXsA16g&oe=6A9EB05A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
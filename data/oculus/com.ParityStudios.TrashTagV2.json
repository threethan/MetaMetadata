i": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hKKUVinSj4Q7kNvwGtTUO3&_nc_oc=Adp_tHyd7-kZ5ym0nF0eEly98fPIIspdD4rFOKmsAENbIILrJpCYkILx3RTGqjvdllE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMQZF5WTyLyW-1r7SbKyZoMQKGbPrhsVFlUcj0eD01eQ&oe=6A915CE1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HscnZKTQBwsQ7kNvwELrhVO&_nc_oc=Adp7c3vWJHtaecQaq9DUA4lXFlUxx7qJXwWlnm5W5ySPwzvcYpIjluOuf2T2RucQztc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfZDiQprlmaqjBVL7bD0zwmSFLaXsngGSrM8qXzjhE0A&oe=6A918349"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u63zXtJjC2gQ7kNvwE3Y3nE&_nc_oc=AdorwuTLeRTrqy-FruajgaL5eSbMWTeQtkR58mPEJkzDUXQDhvihIzPEYXUjz7XTncc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK6v3SAYb0M4gHDjS9s5eYa9DMhts37j-38BXIGAVYFg&oe=6A9168FB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP_o4EtocA8Q7kNvwGLTRWD&_nc_oc=Adq49NFKT4tjBguRnyA1HTX3q7Q--LNkEp-hHjW5QXALsst_FR52GLCYA5Bqn6XbzXI&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk--gl78LEVwwn41lfv8P2bn08lF1-tSAhCdGBevXifA&oe=6A917D85"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDBi9uYOkYUQ7kNvwGGifDH&_nc_oc=AdpDHGIOEYRescc1XHVzmSlp9_IGGIYNugFu7vQ6qVHNcp2E30Il_lmnLGhXJ6ua5QU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDcgKukp-0-GkQeApJRaz_LaHKT6MXqFsfup9dAJMaIw&oe=6A91815A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
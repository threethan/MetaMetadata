i": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k5G5kjszjEQ7kNvwEOBfnp&_nc_oc=AdorblOVETo8pv9vwnzYrZyVmfYIKq9QjEvWP7pcZ-jggJqa19ZFgQb3wvFLeuCvOv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYpHq1bhX8UJP_IhWJKHEbURRuXM44wIwSHouy1JvAMQ&oe=6A9864E1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTAtnvSEQB0Q7kNvwH_HHWW&_nc_oc=AdrbcFrO57-5UKQEFpKqfsesqCyH8OHfg3yVUwWR9u890xOhZEN-uzCTzPAcZHxVskw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4UMjt-EBXl_wdO6YyJTo27YhyknaL1B1j8Vas-6aEMw&oe=6A985309"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tbu-3lGP-7wQ7kNvwHi3ovC&_nc_oc=AdpteGScMkLISgGz0L8AtVAmUjaZB_6aTa3JtEUCTuoWejJ7JsbDRSaRYBUqb_KX_Bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9oU2FoWrnNcmAZKblR0HV2yWl6i4zD0FlBAjr65pN6w&oe=6A9838BB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB9b2citvQcQ7kNvwEcr_0q&_nc_oc=AdrbG7ZUF68rG_k31l6wQyzWKt9gDcYY2EQUBpefphfKsvTWOR9oNqXd287GO7Xo_58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZpOWmCMAEipPaX1E4LFmwAwS_c7R55w0Syu1IrD4CpQ&oe=6A984D45"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAl_OmtOwKQQ7kNvwF4YZPa&_nc_oc=AdripW5So07tttpHKLW2AYbKM2pdU1aujyrT8ViwevqkTxSwvdSeZ5QdNRs-CSU6psM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ9zWPmJz4LQrDzeMDACXtDzpHSNuyq3hIjuEoy_Fzwg&oe=6A98511A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
, {"file_name": "1000383018.png", "id": "1089212110557253", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620599_1089212113890586_3785900366646271487_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l9Q532IIRUQ7kNvwHZ6VUw&_nc_oc=AdoPTAjeMBhQLR47aYDUqaoKjz0NxjurFKtulaGFiy8myyVVn5RPuh7Cudrt-HbJV1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy0TZzlEif0VkfDhrZj7KKVz-gKojwHtGW7T1BXSJYRw&oe=6AF7400A"}]}, "id": "1794616698520099", "locale": "en_US", "screenshots": [{"file_name": "Picsart_25-07-07_16-05-54-443.png", "id": "1801465727389374", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820596_1801465730722707_7717535104603795055_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7SOvTArBM8Q7kNvwECC1Vf&_nc_oc=Adq1yOzBWTj-IZt-dFKhN8AMvlXFbhXnbRJ5KCndD1rprxpQuiG66zxn_dGdVyvsrS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLyofbimngYMTW12qUMzXrtEfA7LVxRc64MJPYewO7CA&oe=6AF71644"}, {"file_name": "Picsart_25-07-07_16-04-36-925.png", "id": "1099740382012114", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823934_1099740385345447_1264112061763376901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1B7_hGNF4DsQ7kNvwGf775D&_nc_oc=AdqrOQ7eKVEnsBpdoYxurhBVDS7Ob1hkOedw6RCt_MLE8KmIMSv-Lwx5kIdUuVMmPYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQESJBHefch-oAvUWFAqgl1apmTY5-oISAc54-2Hu6BOA&oe=6AF72AC6"}, {"file_name": "Picsart_25-07-07_16-06-17-362.png", "id": "1074876217508636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820270_1074876220841969_1526292120073201580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb5vryykUrMQ7kNvwH9AnAw&_nc_oc=AdqMhlFwRi1seARKgr1_CxZLfBhh17q_x_O4ecSruyGGIPvMD97davRh8DAtsSSJxyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu_xxttGgRp0qwwG7TIYV1-1ci-OHSg0J4-MwjNURPXg&oe=6AF73E58"}, {"file_name": "Picsart_25-07-07_16-06-46-532.png", "id": "1445097646908625", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822489_1445097650241958_882028757366744359_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgQjOgJsRRkQ7kNvwHsZoUy&_nc_oc=AdrPj0PCknTJ0mDUMoP5L0yWj-qP9-yMQpl3W_U6lX5ZGqeQSu7eZMlBD1MT8sNLbt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXXFZhGa86vqbAzcWvRe98iJ1SnnBf4RbeQox91BbuwQ&oe=6AF732FB"}, {"file_name": "Picsart_25-07-07_16-04-13-994.png", "id": "1042686524712213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821230_1042686528045546_399919218793683589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l8BsdURTR4Q7kNvwEEfJ_u&_nc_oc=Adr4nvdAX_o4ok1mYzFQ-iteskDPEgwekRu4vq7AvmbYu3AznkiNBbsipCyGIoOAONg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxciicFPgH_N7xixXDAbbRpCy4r53LdjkkvLpAU6ln0A&oe=6AF74B0F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": ["trash", "tag", "vr", "fun", "free"], "long_description": "Join us in **Trash Tag**, full of unique and fun gamemodes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms. The movement is easy to learn, but hard to master.\n\nEach gamemode has a unique map, with many routes and movement opportunities!\n\nYou can hang out with random players in a public room, or join a private code to play with some friends. Either way, you can chat with other players via **voice chat**.\n\n # Some of The Gamemodes:\n\n- **Casual**: In this gamemode, there is no task or purpose, you can simply chill with your friends or other players. Perhaps you can even practice your skills.\n\n- **Hot Potato**: In this gamemode, you have to run from the player who has the bomb. Players can pass the bomb by tagging other players. If you have the bomb when the timer ends, you turn into the ghost. Once one last player is standing, the game restarts and everyone is revived.\n\n- **Infection**: In this gamemode, you have to run from players who have turned to lava. If you are tagged, you will be turned to lava as well. Once all players are lava, the game restarts and a random lava player is chosen.\n\n\n", "short_description": "Join us in **Trash Tag**, full of unique and fun game modes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28758979530378037"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1140157388747161_6350041575477802356_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mo9dNerJLqQQ7kNvwEzoN3J&_nc_oc=AdqSLPUV5Kz4dB4dfQ55-JkEk39oZGGGVqQBs25J7crd-70F7VvnYDfnSpDg_li5Bkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwHmcSbSze6ay9AIsyjEBGcI4ksgS4IrlGsC92Xs2M8A&oe=6AF73B89"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trash Tag", "platform": "ANDROID_6DOF
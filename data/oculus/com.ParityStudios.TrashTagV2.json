i": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc-b_-4_mbgQ7kNvwGuDaLt&_nc_oc=AdqMT_iCJ32FHpLsVLheheXmEqoSLhBt2AcO39mJMvC7nf7RQoJzPZSrgxzIfRZlrCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7rlspekOaoRmHRHwbNXnjis-_I1iGKihmFux7u9tcwQ&oe=6A8C16E1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jx9Qs0ebkVEQ7kNvwFq3B4u&_nc_oc=AdqVbQ946ZJfzualaghNFQn82LE9ttxf-SP8KfQIPAJ-icOJn8kJw7Q6YhQcxTEs0ew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcu_MgISWsz0hz6XVD9CIXdYKNXAIE0aLFTdrDSP5_hw&oe=6A8C3D49"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qdTctQGSXQQ7kNvwHxNAd0&_nc_oc=AdrHE5l8bOLkaHdUDHJphiaZXEbT8FGuwDY_jVTlZUWd2UICAaEnKuH30C9K-w8titg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe3hF71Wy2HEGW53_3FfpPbkn5dNpCoxTIdKSt_0PtFA&oe=6A8C22FB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRuX_Gp_qo4Q7kNvwF7G2HZ&_nc_oc=AdrK6Mdq5rVZUJQ-i48RseBGgDAXBaGpJOOV5qCbAQ05m21yFBQiM94RXWEUy8UxfoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRU3djiz_wDh6At7H2e7M-TMiV_3lXAMCESRVB2UbJ4Q&oe=6A8C3785"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lK1VKiUJgxEQ7kNvwFtZGuS&_nc_oc=Adr0hfYNLT2ObeaRuL2jSRJ1WnOBfhxettPNTx2U6yF6TvpGBUCf3dh1vzN_lhQvqVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9csDOGk5jwyEJTh9hM-XsVZx-zKYoed0KKxaZDqqAqw&oe=6A8C3B5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
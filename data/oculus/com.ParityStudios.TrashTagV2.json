tent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822489_1445097650241958_882028757366744359_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm5J2PBJC9AQ7kNvwEpnGrg&_nc_oc=Adr8enyqJWnkUVYVMwTaHDN7kpW8aOdOYHOdDZMu-qI3PC80t_qC-n731FLwk-jRopk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-mgXv6II63DpRD7uxOSMW-gyTle6Z7HZYUwBC3K5OTA&oe=6ACFA5FB"}, {"file_name": "Picsart_25-07-07_16-04-13-994.png", "id": "1042686524712213", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821230_1042686528045546_399919218793683589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_uAJEMIPX0Q7kNvwFl5edc&_nc_oc=AdrZnDrUYRICFxWI1jPphBNvinmSeUiRzXRsfNjcsSvEATrak2EFbx08pYb5TpJmaT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9a-dy_3-Q0LIrJDgerFdm01mx49PaxD7Ctsvv63k_dA&oe=6ACF85CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": ["trash", "tag", "vr", "fun", "free"], "long_description": "Join us in **Trash Tag**, full of unique and fun gamemodes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms. The movement is easy to learn, but hard to master.\n\nEach gamemode has a unique map, with many routes and movement opportunities!\n\nYou can hang out with random players in a public room, or join a private code to play with some friends. Either way, you can chat with other players via **voice chat**.\n\n # Some of The Gamemodes:\n\n- **Casual**: In this gamemode, there is no task or purpose, you can simply chill with your friends or other players. Perhaps you can even practice your skills.\n\n- **Hot Potato**: In this gamemode, you have to run from the player who has the bomb. Players can pass the bomb by tagging other players. If you have the bomb when the timer ends, you turn into the ghost. Once one last player is standing, the game restarts and everyone is revived.\n\n- **Infection**: In this gamemode, you have to run from players who have turned to lava. If you are tagged, you will be turned to lava as well. Once all players are lava, the game restarts and a random lava player is chosen.\n\n\n", "short_description": "Join us in **Trash Tag**, full of unique and fun game modes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28414391114836882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_1081788944522739_8151819997102680576_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAdBApW8pTUQ7kNvwGeN1cd&_nc_oc=AdpjIScS487Nu8e0AwAYwv1B_f68HmtRD8ylTRyV6Ut9gmY-QkTNZtH0BVLd8uzBuKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHK_KaNtRya-kSdUtCGS8CU2ciFiXGOQ4IfS7K_p88rg&oe=6ACF8593"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trash Tag", "platform": "ANDROID_6DOF", "conte
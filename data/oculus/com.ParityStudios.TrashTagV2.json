i": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74vKsAXUxSYQ7kNvwGfPGrg&_nc_oc=AdoGS30AHEpdkOkuKTuCaUutq8W2_WpKvL5nbbtAVJ_k6gL1jQFPY21e9X3U_9VD0Ww&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5287yfSSG2Ki-hZI7LMTYqHK5COhGfW4_Knv5ZCuIww&oe=6A9ACFA1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZDgvBNgM0kQ7kNvwHLLhNK&_nc_oc=AdqDqubdZxEhrAr-3tJOrMxF0_MSYaR8kcTQnVcTQ2RbdCTqy6XIyfdaysnnPXUBmXY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbc-CA9OKxjyilZYNRsMnUmmYN131Y6rQ1i4IRoAvctQ&oe=6A9ABDC9"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tbu-3lGP-7wQ7kNvwHfgxAu&_nc_oc=AdoSSSW31kBGopynCeNZSGTW--jZ74dFx8xUxqHuWramtjfO4k4gDpyZO84aoye8bHI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaVjUXVcJ3AsUPIw6vbOHm5yMaBkNoY9Famyh9EEeKSw&oe=6A9ADBBB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jB9b2citvQcQ7kNvwHrI6rz&_nc_oc=AdpAp9YEH0P1GkWPmJDyzQHQyHPTknxAfdWxgtxtnexxMuPcpXiyQqXN6SzqXbzN-WQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV3SfwT0RLDKz1y0dqQmCyzkwU6nEoQ-srYktg-kyTzA&oe=6A9AF045"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAl_OmtOwKQQ7kNvwEY-f8G&_nc_oc=AdqS8mcnOejBXojEy_82UI9iCFHB8anw8rgclGvqIctSw1DOk9O45GORuUhp2QkfGvQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHl8e-sfx6ErJIKXjMadXRClSfuHuEh8Jz-hFbQdd-DQ&oe=6A9AF41A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
0119192503.png", "id": "1466421738156772", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499308045_1466421741490105_3938183062902435309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlLowyA5-isQ7kNvwGA1BGg&_nc_oc=AdpkP9LSSd2a7LLtGdTZctvHafVNKe6dxyET7ZwEOoEJCkJY17YdbFkx655O6_U4q7Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bAzOFZu0RjpK5H_bcCNkkC2vHK1oMu1d58QINWvQaqg&oe=6A11AD20"}]}, "id": "958305633222235", "locale": "en_US", "screenshots": [{"file_name": "Picsart_25-07-07_16-05-54-443.png", "id": "1801465727389374", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491820596_1801465730722707_7717535104603795055_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49q65KcmeikQ7kNvwFgzU_L&_nc_oc=AdrbxHPTX5eEo9x0zVyPYQzMH8fQdhujVd7sPbMNLD7UuhGlmf_PMQCsJy8Of6iEj8I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4704z8MeVBDwgKZS5if7nlz0pSQ2eEItXQPQutCTJ4hA&oe=6A11B144"}, {"file_name": "Picsart_25-07-07_16-04-36-925.png", "id": "1099740382012114", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823934_1099740385345447_1264112061763376901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SWfsJTAvaVkQ7kNvwE-QYpM&_nc_oc=AdoD9qbflDTFBvvilcDYs2i3jVpd2IbU5zuelbgrKI8RCVMeItMl_pZzCOc91klu9w8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jawAwf1ebSp9GRvajFUgBFw_EQlA2gqTPj2iOG8liig&oe=6A11C5C6"}, {"file_name": "Picsart_25-07-07_16-06-17-362.png", "id": "1074876217508636", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820270_1074876220841969_1526292120073201580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xteebGXfA8oQ7kNvwGwPaP6&_nc_oc=Adq2d2J9_ynfBF3IsBYob89PJaSHWpqFRqn-1mPA3nZsHJJGPxdtmPq4MnCcT31WOt4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IwmloW_-G4cnXEvkDwaOpxK3kIifrnjxvr8X7iOg3ug&oe=6A11A118"}, {"file_name": "Picsart_25-07-07_16-06-46-532.png", "id": "1445097646908625", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822489_1445097650241958_882028757366744359_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NyvmJIIlIkQ7kNvwFNDbYd&_nc_oc=AdovnAk-HcvszJ3sI4XmM7roU7BqMJep9VN0QR3V3W2Sr0Air8i_xKoqhnurnmve4nY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FbBV6pOCQPcYYbk2G8JdKbLxXnqjNMQgtTOMUOqxFfA&oe=6A11CDFB"}, {"file_name": "Picsart_25-07-07_16-04-13-994.png", "id": "1042686524712213", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821230_1042686528045546_399919218793683589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDCL74bqJ7MQ7kNvwFUl_xx&_nc_oc=AdpXzRRTJ4-cRCKn3ZJJNJ0WdpuDjBaM5XWas5gPZ57XNiIGhZJiasVjU1paAlz6P7A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MHLxdApjasC9eVV9hsbIPghxFhV7m-AUvZhg7MtONmg&oe=6A11ADCF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": ["trash", "tag", "vr", "fun", "free"], "long_description": "Enter the exciting world of **Trash Tag**, full of unique and fun gamemodes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms. The movement is easy to learn, but hard to master.\n\nEach gamemode has a unique map, making it so players can explore, while also making the experience in game a whole lot better.\n\nYou can hang out with random players in a public room, or join a private code to play with some friends. Either way, you can chat with other players via **voice chat**.\n\n # Some of The Gamemodes:\n\n- **Casual**: In this gamemode, there is no task or purpose, you can simply chill with your friends or other players. Perhaps you can even practice your skills.\n\n- **Hot Potato**: In this gamemode, you have to run from the player who has the bomb. Players can pass the bomb by tagging other players. If you have the bomb when the timer ends, you turn into the ghost. Once one last player is standing, the game restarts and everyone is revived.\n\n- **Infection**: In this gamemode, you have to run from players who have turned to lava. If you are tagged, you will be turned to lava as well. Once all players are lava, the game restarts and a random lava player is chosen.\n\n\n", "short_description": "Enter the exciting world of **Trash Tag**, full of unique and fun game modes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26580226534920025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307470_2040407320158415_4649565100265594921_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zadYuL7-dcQQ7kNvwHuvDAE&_nc_oc=Adpe7Ov71Mse_9fp2JLxF2Ck9hUTKetj_UwI2EUARn8HqknaPTHs8DXGFCD2RgOEMMA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jubh7lQlvb8Kj6OGTWbfiX6xLQ6XdDRd5bdu2LEHgwg&oe=6A11C579"}, "is_concep
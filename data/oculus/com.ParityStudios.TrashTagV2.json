i": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PemZfJOn_DwQ7kNvwGlK_AB&_nc_oc=AdpApeM9m4Hrrepg4yIJQLR9NXENWQupFIJH47O2m4dDLzduSBmf9VcUFVMeoEoPoSM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8SbvIoaXviApANxaOCUdY3bmVPVgZz3n0xiSGVSRB-A&oe=6AA015A1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Htkr5OozeRoQ7kNvwH9k22A&_nc_oc=AdqVkfTXVMsqdaqI-Kt7ay6lSZ2enqqSatCU8GQ6feNL6f9SJvcNJ16KB2bPDiJilkU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbRF53hafeOGN46QCLg19X9T0oZSSMfpPbAhF-hVa7ng&oe=6AA003C9"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-KNXuqV9uUQ7kNvwHjCr9i&_nc_oc=Adpkb60A87SaGd5qQuDb72i0CpmgjWeWw2BERcp4rKcDPxWQTiYh0nMwp1eMcLgWRUA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKJYLEl5VKmZX3COcaFlSDXAL_SRi1RQlUxMJsQ-gt0w&oe=6AA021BB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9V0Sq_Dz20Q7kNvwG5yofD&_nc_oc=AdqNL6djy9OsWyL2J7C6OtpZxAbzWoDoLNcOKY56k8_rKTrXNQtpTYM5HTRv5J6OAqs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw6IeyRf5rRirlfnRJj6SgdgMt0Z9zK9oO7BnEM8Lijw&oe=6A9FFE05"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFZvzj6CHa4Q7kNvwFPaQ3S&_nc_oc=Adrkpnk815wd34pCyNe0okub6ypayAo8D0MPQAhnWxkECmjUlaqj2H4rJ1N50W7e1DA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGPjEQPd_S8D8zOo5Tch7y4HcKG-npRMFDMM6CFD8hkw&oe=6AA001DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
e_name": "screenshot.png", "id": "596493866020223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9sGU4jGuMwQ7kNvwEHnu2x&_nc_oc=Adoudn2lXRsbOQzRzwa2Ubv29TNMn3ivuzSAk8fzceKaKLZ2ySSpxi8YrX5wK6R6eeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VURNRpXHuuhf9XiuKbC01BgPBccEqNW_GuWyEfOgBMA&oe=6A257A21"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09NEsi2jdkAQ7kNvwE0bgfH&_nc_oc=Ado0cA6gEV2LnH_mkF6VZbet4o-m-zYq1APxCRFpKOGdV8mhqVGKmLFlPx2kZENEttY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YDqmLN2LwT616xr3ssmIOcY-PFoum3YPA-B_7Km0UZg&oe=6A25A089"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHFscxM8GkMQ7kNvwEsp-7g&_nc_oc=AdpiC7wXS9R2Sj-I57ObTt7FNJtE1l1n5UobKbfxCt2kpiOym4o33KYtW6P_VXh7z-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G5gUbmN70fBp5bxdkxX1wCJV_ZnjAWC9tkp47gbAy3w&oe=6A25863B"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EU0SS05CHtcQ7kNvwF_Lndz&_nc_oc=AdrQ60N_EVN7KUYTEWUdaIahHtL-jGBI2BjzYaBub_ZiTXN3jnG2RVCyoh4ALOqLTuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cW2EIHNRNkC750awRmX3c-ARyMrWMV2H_YTO0OiI9GA&oe=6A259AC5"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Zmaa1ZvzPwQ7kNvwEnv3IX&_nc_oc=AdrpoipEYH75r8uG2jsv0c3JeVW-nLlevcInjBueT_QEcEwe3nNqhJxOO21N8DI_JLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hbt1MCaZAMoYweyXib0g9tSt2LlTC_jC8kJFM7NXwRg&oe=6A259E9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
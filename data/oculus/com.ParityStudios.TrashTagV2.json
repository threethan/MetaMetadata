5Y5dWs9YsFyiB6T6ePNREw&oe=69F34985"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zelE6vMQ5fEQ7kNvwFs1oQX&_nc_oc=AdonAuXdV43F0xz3MGLlAgTNnMQISxtuYK4FF4CsoK41ECbVWs_51DGj6gY3n8r97OA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1agCcvqgq1F8MrAt3XVAX_IdozWRgzKOp8RfY31X7YEg&oe=69F34D5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
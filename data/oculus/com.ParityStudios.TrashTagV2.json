i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD5es2JmC2oQ7kNvwEbDgKZ&_nc_oc=Adr0fJPgdp29KIr-K7UPwPiCRf4crQU2Ek8X9kKuwU9uIl00EikoiFb6HuTJfwkGPZE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHiqMzf694BMNiWee0HCMZBBbEUvNOKsJ5MsX0c54DsQ&oe=6AA6AD21"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmfklfIpXLsQ7kNvwEcG6e9&_nc_oc=Adp3ucJlmDBlEu7O-h9FUgp1Fl0oe8F1V040AC_016DFx3On3vnDjlCL4xBwWI9U6F0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY-YEJpgvrfa8VFDFhj3HjO2N9wgfU84er4d0VmqpmUg&oe=6AA69B49"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWJMTSBvFUEQ7kNvwHupMEZ&_nc_oc=AdpPoHJdM0bQdaNJwLItaWx0jSjtCPWP5Tx9mje3Gzduzxz61y4LxmjLZRPunPErO7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9QW3jcU01GwREWIvt-KRQCmWnzpdqZzcQRePurxv8tw&oe=6AA6B93B"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkNBNR8TIacQ7kNvwEySoUb&_nc_oc=Ado-EzaMiiG0TOrDvcZqJDLp1Yvkme56O39zN82OFk22L86jaSFWATlkuEETDYjvxmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm_GwfNfY8K8qIa9sUlmxNyhMdBV85WpPNa0i1mS0y_w&oe=6AA69585"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4f9_I7uNgYQ7kNvwE-ryc7&_nc_oc=Adp_YwXUBo9wffDUAOTVAmJ0QJWU2LfRl4gGXKgDzMWsyluyvf9pqwaTXUNWW5QFXn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXsUjHuCV0CsX20tRkAagek_NAuBXTjcwsoFL4M1Y63w&oe=6AA6995A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
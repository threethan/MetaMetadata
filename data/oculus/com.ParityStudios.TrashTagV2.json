i": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hKKUVinSj4Q7kNvwHZIuHx&_nc_oc=Adrk1kGdsFvEPvrX0B1mWhPmYQQh-VwnpGMlHWkndJXFOoOFf3xGAK4oXLu1gyGRJ58&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFF4UIv_s4Bd3ZqHBZ85jET2lZVP6MleT75OS9Tz_dh6A&oe=6A93FFE1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HscnZKTQBwsQ7kNvwE8d0ds&_nc_oc=AdplJJeEAWYJ8OHV-nDbIO4_I6obBywXB6e3Q3JfgR10UOjPnH01EGUNv7EITpMuDCY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbzEVRqcTluYnBu32a9dVSRk3FGcz0-OaODePezoDkuA&oe=6A942649"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZMOxeyEpkMQ7kNvwHpMMMA&_nc_oc=AdpQidD34_L_qCo1MjHskhVfJEPKXAk6SuOSGWJqXXdWprfHXeo_gATNvV6VZ-QW-M4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrq5VavTZuBPg8DokBiQ536wVrACJspOHb1k0VFhNXrw&oe=6A940BFB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdjxrPOwTd0Q7kNvwGRc7ZZ&_nc_oc=AdpmPsB6AJ8djLokOD573DMpICQzxZnpYqZgDrLOUcVlTb3amjboLAa6Jg4jDt2A67c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJdv9BzhjfOvQQFIPHfu1zoqdYP5eaaCYW0KnxFAVcog&oe=6A942085"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHzDzK_W6kAQ7kNvwFIEFxa&_nc_oc=AdpmjFjAmzpOwdjnm3A9E8HOMQlAl5smh_HXo4m7soDgOK2-bTgV-Rz8XgrdSEnZJT0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_20cNqfXNJQindSug-QypI-4bGsEmUrjl9Byv2_AjlA&oe=6A94245A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
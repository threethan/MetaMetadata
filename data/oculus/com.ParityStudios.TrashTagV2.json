Xe-MB3vE82bVQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTbWINevjgYSth4uZCjsvWq7fQWO3f5-RD3PVgTP1Yag&oe=6B104AD8"}, {"file_name": "Picsart_25-07-07_16-06-46-532.png", "id": "1445097646908625", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822489_1445097650241958_882028757366744359_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV1eMNrxzKgQ7kNvwHDtCrK&_nc_oc=AdriD78lrSLOuk7-cpycVZlq-RFkvxQLd3IOEZdDAg5P-2y6ux8bJTiF4RHA30P2vLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEMlK_rpM8jdc-m-MGepC1KpUbvMro-Br80bPvpqve5A&oe=6B103F7B"}, {"file_name": "Picsart_25-07-07_16-04-13-994.png", "id": "1042686524712213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821230_1042686528045546_399919218793683589_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39AwHZI88EIQ7kNvwHUJKiA&_nc_oc=AdplwRYaT-WOqUDuMQfG0ZaApvs-MdjVQndcmFwVMjxqz5lxUKnw8WqSIhJwl6k0WgY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXsoWpKTWRMjVVKYIeJd5pz65M2T9Q9Oj7Lq0d7r6KSqA&oe=6B10578F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": ["trash", "tag", "vr", "fun", "free"], "long_description": "Join us in **Trash Tag**, full of unique and fun gamemodes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms. The movement is easy to learn, but hard to master.\n\nEach gamemode has a unique map, with many routes and movement opportunities!\n\nYou can hang out with random players in a public room, or join a private code to play with some friends. Either way, you can chat with other players via **voice chat**.\n\n # Some of The Gamemodes:\n\n- **Casual**: In this gamemode, there is no task or purpose, you can simply chill with your friends or other players. Perhaps you can even practice your skills.\n\n- **Hot Potato**: In this gamemode, you have to run from the player who has the bomb. Players can pass the bomb by tagging other players. If you have the bomb when the timer ends, you turn into the ghost. Once one last player is standing, the game restarts and everyone is revived.\n\n- **Infection**: In this gamemode, you have to run from players who have turned to lava. If you are tagged, you will be turned to lava as well. Once all players are lava, the game restarts and a random lava player is chosen.\n\n\n", "short_description": "Join us in **Trash Tag**, full of unique and fun game modes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "29079479028328084"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604385997_1152368031058224_8874351296575066371_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJ1x1qKt2r8Q7kNvwFU4SPb&_nc_oc=AdqOPMrt0ic
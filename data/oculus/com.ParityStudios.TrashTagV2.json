i": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hKKUVinSj4Q7kNvwGbsDOX&_nc_oc=AdphALgzPabY_yYJ3NKLvYpj10ORASi9TNbRRcGPF1dbMXuOdhMbb2YIpreGDgCA6xg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2j6pDr8ZSM9LrRqNSV4ou7PYlD5kmFlasjtkII2EiWA&oe=6A92AE61"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HscnZKTQBwsQ7kNvwEcwThY&_nc_oc=AdrOKXz4jvu0wfsiG5JmgCBSvEcRry8k9tJWwKm8LLwQyjECYtCfVuQHdJjbdS8i1Hk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGptgpnF_s-08LbE_Njdm5ZDW6oVLV3EZFJ8halITLvyw&oe=6A92D4C9"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u63zXtJjC2gQ7kNvwEbpj8y&_nc_oc=Adq6aXE_f_qR5EnP8FkOW8gWhaf8k05tejsyz_509vRtJHPgoVWa8T7CiG1pU35H7gY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW90oSWVv9zr6b4lZ_zlhyKqiybIZmMuNpXIotyHBOYg&oe=6A92BA7B"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP_o4EtocA8Q7kNvwGcExy8&_nc_oc=AdrX8h-v3KTOXPZA26wRCbLnQ115dwGTzwsYeP09IDa19ibj5QYrWmhCoFE1RkEqho0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG55tIwTbaC2OO5ELVQ1ytcvc22k_brDdXbwyEQYBRktQ&oe=6A92CF05"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDBi9uYOkYUQ7kNvwGFGImA&_nc_oc=AdqA2b8dQDy1zmlhXDKvEudgProsOrmvvr9PFY3W474IZIgCzgp6AkbaNjKT9Q5ssaw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMlxx35nkGMtDqZhcl2FNPOrch5ujoPdlYBHsPK9FR1w&oe=6A92D2DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
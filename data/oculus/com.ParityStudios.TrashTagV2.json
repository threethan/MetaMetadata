i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PemZfJOn_DwQ7kNvwFKbWkH&_nc_oc=Adr3KoyuiiaxZTXgjOzaWNn-h7vQ8XVjsy3lOnbAP0fbm5gzDUYkGZX152JtVPBx-j4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpTxjBr4Wkkal-m7WGxW6etU7t93QbqazLtxhRn8q9Xg&oe=6A9D72A1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Htkr5OozeRoQ7kNvwE-jXh4&_nc_oc=AdpHjS_8uC6HpRwydrb-dDYMIXOQkamPsOq3Ld85znqvDaMGp5G4WhiqyZL9u8knVJc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2cwcJRmRxrFVfuavCgV9AY773OujKtXRYNX1SHA6dlQ&oe=6A9D60C9"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB7vBH4XPR4Q7kNvwFaxpkw&_nc_oc=AdqXXMV4kPhIPtcI-8mYD3EvPg5uT9iSaYowdZFXSIjGNeaX85pPx1sERZl1TIazs08&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSb5oZGknHXORPZNl2FjLu0AL8pWddCJt8nvBvRIzlcA&oe=6A9D7EBB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xi77VCskoPQQ7kNvwGlhXhO&_nc_oc=AdoMHthxK-g_K8xyiGcY1dGSH72EbRxlUd6hRhkd8BcjHaWsNefJvQtt07UH6F9KLvg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB3zsfu1i-4gI8BKZWveIvhuVwqAw5ct89diOZ9z3dQA&oe=6A9D5B05"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNXM2h6iohEQ7kNvwEldeAN&_nc_oc=AdrKlwQaF4PLbOj8nGAo055s_a_niqyqwb4IOu9Mg4byqXM_e8TXyoRnl3P25KFr1vI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUpejQzTapZUDLqWttxbZmMKv6aapDO_bciWcrdPzDBA&oe=6A9D5EDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
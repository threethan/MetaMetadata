i": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cs5qfLxzQQQ7kNvwG2ToJ9&_nc_oc=AdqvI9SlYra8wN5S-rE4Ypi2HMV-rlzWHq_Ru8AElRjlIpEsmK7x1X0dq-wWvyIZRDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-QN6RpIJXBYs5N-Clq5LCsAnRLIGpiB4g7GrEha-ZnQ&oe=6AA2B8A1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2tosI3EsBwQ7kNvwGFjI1o&_nc_oc=AdqmmY7mQ2giAH2nMrlh8ZHnHXI6e8Rl9fUsXAU7b7f_vIHHgPd-9Qvuc1QDEdUUUB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlJrC_v8LfXng_S7OAixGxc2wyCy4PHdIn9QFDveI2Hg&oe=6AA2A6C9"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-KNXuqV9uUQ7kNvwEQDaUY&_nc_oc=AdpmG3ls5YO16i5Hk7K6Ah4X2IRdsDKQq1KNj5MZG3r6fYocM-shztwcvFUeKFiKITs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF6EdVezVSp09LNTrcxwaDrP4-oo_87ROvC2EvwOa-Pg&oe=6AA2C4BB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9V0Sq_Dz20Q7kNvwHx0zs-&_nc_oc=AdoF78yUEJB2caKHhSJ01iXQqlkaZaG6462vyn8SPAvhBaEnXLUbOtqRi29ktc03GEU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDnNSbetgk7w6hC0Emgq5Bg1qGs2ZkAWz8RqSBUARwQA&oe=6AA2A105"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFZvzj6CHa4Q7kNvwHNxIdd&_nc_oc=Adq92MOS4bt969KRtDFqas1lMjwq8kLC6EGSWzrIfKnaQX3dPKueEzwFnJTbomrAL9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQMEIvRF3fpXgvZAOq8DHYRUDt-a-MBNZkwmU4nfG4IQ&oe=6AA2A4DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
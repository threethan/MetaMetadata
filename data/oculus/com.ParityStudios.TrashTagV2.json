192503.png", "id": "1466421738156772", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499308045_1466421741490105_3938183062902435309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiMmrRk2O-cQ7kNvwHepvvG&_nc_oc=Ado7S_znxBWSvHPyOAPT6bsDUaEvbgAMY9ijEzSUUb_RTALgmNghqmrC9O4DxPftbvo&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68bPJeYKGxu9kiobxFvpSY7in2mgEkvv0hTvaHrZtxWQ&oe=6A09C420"}]}, "id": "958305633222235", "locale": "en_US", "screenshots": [{"file_name": "Picsart_25-07-07_16-05-54-443.png", "id": "1801465727389374", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820596_1801465730722707_7717535104603795055_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Etcw56Ae5dgQ7kNvwE8ptd1&_nc_oc=AdoTARcFk8C-Fq_DnyuXvTQT9-0EH3u5Q0lRGEk4Cno7FNVdWHtHB5U_e1tIzXAFaVE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Oz4M6NBkbfVi8TLGowt2dMwuliC9OtteSgQ0xguta5A&oe=6A09C844"}, {"file_name": "Picsart_25-07-07_16-04-36-925.png", "id": "1099740382012114", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823934_1099740385345447_1264112061763376901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_MI2y4s9UgQ7kNvwEYC47w&_nc_oc=AdpQUgczolQlgOnUOhwIHxzCt4TQGtMJ2TKtfsSvmae2tIq7aT9ieg-fAUkT44VxTK4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LiuiNwwPdLS036GYTtKwACTkvLb4ghafD9GjQnkoSog&oe=6A09DCC6"}, {"file_name": "Picsart_25-07-07_16-06-17-362.png", "id": "1074876217508636", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820270_1074876220841969_1526292120073201580_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DIh23ivuqEQ7kNvwE6FfnF&_nc_oc=AdqFLLYceuPMkWDA1EL4AP0Iverb3SOJaV2JxXaSGtyM7MJhZUasxhQb9kjhfmuLEbU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OEMZz4y2SWjKKXoQZwQqRosiJDZUMqyoygcK8cxLjeA&oe=6A09B818"}, {"file_name": "Picsart_25-07-07_16-06-46-532.png", "id": "1445097646908625", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491822489_1445097650241958_882028757366744359_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BOYpcmbohQQ7kNvwF0BgQe&_nc_oc=AdqJFDKPGa4dYd7ytVMx19w2tbtU4yd5Yz0VpT9mt4S94UaaqtYlE4m-6h-Q1yRco00&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e84QDTImM1jcfvx07zoOs9JRDSD_xvhL8aqrBpG0gjw&oe=6A09E4FB"}, {"file_name": "Picsart_25-07-07_16-04-13-994.png", "id": "1042686524712213", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821230_1042686528045546_399919218793683589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1JVtI1Pq2UQ7kNvwEuFI3y&_nc_oc=Adpxm3XoAYa0_GRLX6f3Oo3xaqJ45BL8RyuP53goBtH55un1cmBP3peH0N58j6hv5nA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5__w9HJfb7SB3-xSbxT4dwg2GMiIrT3sWaoqqoZj0elQ&oe=6A09C4CF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": ["trash", "tag", "vr", "fun", "free"], "long_description": "Enter the exciting world of **Trash Tag**, full of unique and fun gamemodes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms. The movement is easy to learn, but hard to master.\n\nEach gamemode has a unique map, making it so players can explore, while also making the experience in game a whole lot better.\n\nYou can hang out with random players in a public room, or join a private code to play with some friends. Either way, you can chat with other players via **voice chat**.\n\n # Some of The Gamemodes:\n\n- **Casual**: In this gamemode, there is no task or purpose, you can simply chill with your friends or other players. Perhaps you can even practice your skills.\n\n- **Hot Potato**: In this gamemode, you have to run from the player who has the bomb. Players can pass the bomb by tagging other players. If you have the bomb when the timer ends, you turn into the ghost. Once one last player is standing, the game restarts and everyone is revived.\n\n- **Infection**: In this gamemode, you have to run from players who have turned to lava. If you are tagged, you will be turned to lava as well. Once all players are lava, the game restarts and a random lava player is chosen.\n\n\n", "short_description": "Enter the exciting world of **Trash Tag**, full of unique and fun game modes! Run, jump, and climb, as a trash can, using hand locomotion that can be controlled by the movement of your arms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26580226534920025"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499307470_2040407320158415_4649565100265594921_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODQ_eWDhhA8Q7kNvwFn-VSr&_nc_oc=AdoHZge4f8y2hoNYA75cr211MKdmUWpDfVoAgika7xPLZ4HUhJtynxkviDh54Rm591I&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YqxwrGalBPazhA7UoQkNo3lOVmIn4uW253x1AmGQrTw&oe=6A09DC79"}, "is_concept": false, "
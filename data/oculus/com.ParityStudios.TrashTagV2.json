e_name": "screenshot.png", "id": "596493866020223", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOqJLnXWJf4Q7kNvwFjqgQe&_nc_oc=AdpAMaq6jGtgv8KrHJo4W1hIU4TiWGTz2y7NiKzUvQfIjTQMOOMHLVZ5PQyd9iqB1yk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_Q4swPyxBNsw25i7u9pR8sbyZueYlKmbudtq6XIQ5AA&oe=6A184B21"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HramdTUck6IQ7kNvwF-uCKv&_nc_oc=AdoiUue7NGtAk8om1w2DCFzCxr04t70rcvMGkLvPWwM1GyvQu0LTkUO9-PURXMRqO4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G6MCQpwh7c2m7XdmjasWi4D2oCzuQF8Mu47ROmXZtLQ&oe=6A183949"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Wrc2Xj0lJ4Q7kNvwHwoiVV&_nc_oc=AdocF-jbnrBhAxv19WLGcJGJlSENpGEghxlSoq5VhDWaiI8GlvsSqu5mKLCU521lEWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JmVdTaYU-DS4mMvweYdVcNNtY2KLhyNjx_fogb0YTfA&oe=6A18573B"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE4BxPh96lYQ7kNvwExJoS-&_nc_oc=AdqS4xRzQVPhbiBb1zQ9YqGU1Om89Y2gSdFifEXCw8ItwRfULD3CKKSKFuGdbz9qYSA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y_hnj3Vhah8tkBCp0YCM-jYcqQIANjIY-GFKzzBijfw&oe=6A183385"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwU4KLDNO3IQ7kNvwG9UdZL&_nc_oc=AdoxDDg5H6l266ae7EWwQm01t5fj2jvaLo7jJpOSfu1JP_aOCQ_5GDgUeehuYECV0uw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xdD-vUWy3D7kxpI77ayd3GCze6O2OrhaY4VaUUz1zHg&oe=6A18375A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
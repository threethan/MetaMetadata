i": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75458101_596493869353556_3251925341976971747_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_k5G5kjszjEQ7kNvwGdr2F1&_nc_oc=AdrdzVlDWZ20zgj5CRKzEDT1_brllGl4IuCQlEKtvZuLsII_YbQXKRYQ4M2jwv3e3Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlRwnexoXKjIwgJ5AfCwCkhTlMZnQQcmGql8DP-1HrRg&oe=6A95C1E1"}, {"file_name": "screenshot.png", "id": "307227735135920", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031644_307227738469253_8787443576972510907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTAtnvSEQB0Q7kNvwEob_og&_nc_oc=AdrkcOlAjyg6gLGRTUh5X39wD0NpEmy8FHPbvntkF9Dxv0D7VrdAr1TrcBjFsfx7IjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6IMYb275Dto--azE-_NFexgtzOKWYcowJEGO9XXNMiw&oe=6A95B009"}, {"file_name": "screenshot1.png", "id": "3583330985211674", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_3583330988545007_1063429096330025058_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZMOxeyEpkMQ7kNvwG6VRMy&_nc_oc=AdoPKjkrGFWkumjVqBROzmpVfZ3oPfaNWfOiWP7YqTzGMi6VVAfyVA3qACVtJqBDdUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlSkMnIKuu2tA_OfmgwjxmYa3RIhwkevFOVklfZB5Ozg&oe=6A95CDFB"}, {"file_name": "screenshot2.png", "id": "240240288908224", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035312_240240292241557_3101874849347185748_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdjxrPOwTd0Q7kNvwE2iAqp&_nc_oc=Adr8eq6E_mPT70rXNzxOpX7tWTEM7uF90ymO6k7HVUGwRAlL4xpZUhWhaOtZIe4VfMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjfiJ-TWWkM3pywux7dIyzK6Df1gRU0ucGf_szHorrRw&oe=6A95E285"}, {"file_name": "screenshot3.png", "id": "3709258015971624", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031644_3709258019304957_2106116046951259043_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHzDzK_W6kAQ7kNvwH-vETt&_nc_oc=AdrtU_L90Zkgw7wdQNt1UuOEt8l5imlkUVMsCBnaDyoLB6wEcJzW0J-60Gvq6RHiDoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHC3Q3XPA-u9_76AAjagaTtcVGlef7rgGcgCvOgHCresA&oe=6A95AE1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trash Tag", "keywords": [], "long_description": "Are you tired of gorilla tag fan games only about species of monkeys or gorillas? Have you ever wanted something different? Well look no further to Trash Tag! Trash Tag is hand locomotive based VR game where you can have fun socializing and exploring different maps well playing different great game modes!\n\nALL GAMEMODES:\n\n1. Tag (BETA) - In this mode, their is one person who has the Cheese Touch and they have to tag another player who doesn't have the Cheese Touch. Once they've been tagged, the player tagged will now have the Cheese Touch and the original player will not have the Cheese Touch anymore. You can tell when a player has the Cheese Touch when the player has a cheese texture.\n\n2. Casual - In this mode, their is no tag, or running from something. In this mode you can just chill with your friends, yourself, or other people.\n\n\n", "short_description": "Trash Tag is a hand locomotive based VR game made to socialize and have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/trashtagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Parity Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/trashtagvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
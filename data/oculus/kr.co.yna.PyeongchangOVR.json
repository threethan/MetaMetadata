2732_2027533754195980_4736524912242458624_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNq6D-L7V_sQ7kNvwFZvL6c&_nc_oc=Adm5G7dpmGfOqVk0OBrTWHkSECiJ0K8en9h_awVJrnEgYj58QwzE4ArqyHkMmCOBuWM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfJ9DX_Wf5pLRU3-So26LJPl41BwOUa_WLN8ED6g0QEg&oe=69B1696D"}, {"file_name": "migrated_image.png", "id": "259705438361859", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12410407_397503980709062_6666016691975094272_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pezj9CnkqiYQ7kNvwGt4WnG&_nc_oc=Adk2LCBZq82NvXnDskkRuqJrkEoqdoo1Yo58FSr4SWUK0s8rnVj6b6slt9q_gRFSLUY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfynOrfOwFC3DvYtoWvJmnLEFgfziaMsLX_JVkoraevYtA&oe=69B152DB"}, {"file_name": "migrated_image.png", "id": "225889505268296", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12331069_554252461617958_438251462087147520_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbXq50P52CQQ7kNvwEDur--&_nc_oc=AdlmLMahv0IcxCg6FZ_t76Oy4c49Q6JoqO966KrjZRm2aKJ8xzY8Dsz0wlbG4fqNf_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzt_1Pi267MQ--GBr7hyI2psiPZPON2x1ee0u3oRVlHYA&oe=69B15CA7"}, {"file_name": "migrated_image.png", "id": "202357514429760", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12138787_1184966364967836_5003564070079561728_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwoy5rJOHoIQ7kNvwFeEGAJ&_nc_oc=Adn9_5i71k7a5hK_b7UR97xmHUmKIiWij4qaEGR8n6Lzk-aOFA7-uOqwHgDaOioXs8U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afww8LVHmFku3vrkYX3eQ4cewD-sP2qDj2W-72omRxb8yQ&oe=69B168C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pyeongchang Olympics VR Newsroom", "keywords": ["newsroom", "yonhap", "yonhapnews", "pyeongchang", "olympics"], "long_description": "This service is part of the VR application for South Korea's leading news service Yonhap News Agency. Yonhap delivers real-time news around the clock on current issues about 2018 Pyeongchang Winter Olympics VR news and the latest events taking shape both at home and abroad.\n\nOur reports cover a wide variety of areas, from politics and business to culture, entertainment, sports and world news.\nThis application is designed to be compatible with the user interfaces of the GearVR by incorporating functions such as VR videos and photos. \nWhile fulfilling its mission as South Korea's leading news agency and providing the fastest and most accurate news both on- and off-line, Yonhap is also striving to take the lead in the VR applications sector by offering the best services to our clients.", "short_description": "This service is part of the VR application for South Korea's leading news service Yonhap News Agency. Yonhap delivers real-time news around the clock on current issues about 2018 Pyeongchang Winter Olympics VR news and the latest events taking shape both at home and abroad. \nYonhapnews is the only official news media partner of 2018 Pyeongchang Winter Olympics in South Korea."}, {"images": {"nodes": []}, "id": "228347778312678", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\ud3c9\ucc3d \ub3d9\uacc4\uc62c\ub9bc\ud53d VR\ub274\uc2a4\ub8f8 (Pyeongchang Olympics VR Newsroom)", "keywords": ["\ub274\uc2a4\ub8f8", "\uc5f0\ud569", "\uc5f0\ud569\ub274\uc2a4", "\ud3c9\ucc3d", "\uc62c\ub9bc\ud53d"], "long_description": "\ub300\ud55c\ubbfc\uad6d \ub274\uc2a4\uc758 \ud5c8\ube0c, \uc2e4\uc2dc\uac04 \ub274\uc2a4 \ucd5c\uac15\uc790 \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 2018 \ud3c9\ucc3d\uc62c\ub9bc\ud53d VR\ub274\uc2a4\ub8f8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4.\n\nVR \uc571\uc744 \ub0b4\ub824\ubc1b\uc73c\uba74 \uac00\uc0c1\ud604\uc2e4 \ub274\uc2a4\ub8f8\uc5d0\uc11c \ud604\uc7a5\uac10 \ub118\uce58\ub294 \uc62c\ub9bc\ud53d \uad00\ub828 360\ub3c4 \ub274\uc2a4\uc601\uc0c1 \ubc0f \uc0ac\uc9c4\uc744 \uc190\uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ub354 \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uc5f0\ud569\ub274\uc2a4VR \uc6f9\uc0ac\uc774\ud2b8 vrolympic.yonhapnews.co.kr \ub97c \ucc38\uace0\ud558\uc138\uc694.\n\n[\uc8fc\uc694\uae30\ub2a5]\n\n1) 360\ub3c4\ub85c \ucd2c\uc601\ub41c \uc62c\ub9bc\ud53d \uad00\ub828 VR\uc601\uc0c1\uc744 \ubaa9\ub85d\ud615 \ud654\uba74, \uac00\uc0c1\uacf5\uac04 \ud654\uba74 \uc911\uc5d0 \uace8\ub77c \uccb4\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\uce58 \ub274\uc2a4\ub8f8 \uc18d\uc5d0 \uc9c1\uc811 \ub4e4\uc5b4 \uc640 \uc788\ub294 \ub4ef\ud55c \uacbd\ud5d8\uc744 \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n2) VR\uc601\uc0c1 \ubfd0\ub9cc \uc544\ub2c8\ub77c \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 \uac01\uc885 \uc628\ub77c\uc778 \uc601\uc0c1\ub3c4 \ub274\uc2a4\ub8f8 \uac00\uc0c1\uacf5\uac04\uc5d0\uc11c \uc2e4\uac10\ub098\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n3) \ub2e4\uc591\ud55c \uc2a4\ub9c8\ud2b8\ud3f0 \uc6b4\uc601\uccb4\uc81c, \ubaa8\ubc14\uc77c \ud5e4\ub4dc\uc14b, \uce74\ub4dc\ubcf4\ub4dc \ub4f1\uc5d0\uc11c \ub3d9\uc77c\ud55c \uac00\uc0c1\uacf5\uac04 \uacbd\ud5d8\uc744 \ub204\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc0ac\uc6a9 \uc911 \ubd88\ud3b8\ud55c \uc810\uc774 \uc788\uac70\ub098 \uc11c\ube44\uc2a4 \uc544\uc774\ub514\uc5b4\uac00 \uc788\ub294 \ubd84\ub4e4\uc740 \ub9ac\ubdf0\uc5d0 \uc758\uacac\uc744 \ub0a8\uae30\uac70\ub098 \ub2f4\ub2f9\uc790\uc5d0\uac8c e\uba54\uc77c\uc744 \ubcf4\ub0b4 \uc8fc\uc2dc\uba74 \uae30\ub2a5 \uac1c\uc120\uc5d0 \uc801\uadf9 \ubc18\uc601\ud558\ub3c4\ub85d \ud558\uaca0\uc2b5\ub2c8\ub2e4.", "short_description": "\ub300\ud55c\ubbfc\uad6d \ub274\uc2a4\uc758 \ud5c8\ube0c, \uc2e4\uc2dc\uac04 \ub274\uc2a4 \ucd5c\uac15\uc790 \uc5f0\ud569\ub274\uc2a4\uac00 \uc81c\uacf5\ud558\ub294 2018 \ud3c9\ucc3d\uc62c\ub9bc\ud53d VR\ub274\uc2a4\ub8f8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4.\n\nVR \uc571\uc744 \ub0b4\ub824\ubc1b\uc73c\uba74 \uac00\uc0c1\ud604\uc2e4 \ub274\uc2a4\ub8f8\uc5d0\uc11c \ud604\uc7a5\uac10 \ub118\uce58\ub294 \uc62c\ub9bc\ud53d \uad00\ub828 360\ub3c4 \ub274\uc2a4\uc601\uc0c1 \ubc0f \uc0ac\uc9c4\uc744 \uc190\uc27d\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ub354 \uc790\uc138\ud55c \ub0b4\uc6a9\uc740 \uc5f0\ud569\ub274\uc2a4VR \uc6f9\uc0ac\uc774\ud2b8 vrolympic.yonhapnews.co.kr \ub97c \ucc38\uace0\ud558\uc138\uc694."}]}, "developer_name": "YonhapNews Agency", "developer_privacy_policy_url": "http://www.yonhapnews.co.kr/policy/7906010000.html", "developer_terms_of_service_url": "http://www.yonhapnews.co.kr/policy/7906410000.html", "publisher_name": "YonhapNews Agency", "support_website_url": null, "website_url": "https://vrolympic.yonhapnews.co.kr/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "243557861293254"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410407_335418093624912_2106491419270053888_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBy8CvVJStYQ7kNvwHKZ28S&_nc_oc=AdkXsRhT2hdwWcs6wwZoXWvENb7uZVRxoerhOwYdxfEvssJwN9mO_a7ZCK7zZzRvJVs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afws508pKq96_yb7GGuIeqH5RSk0jupm1lGnV2vZMQ8Lzg&oe=69B16607"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pyeongchang Olympics VR Newsroom", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1516816800, "lastRevision": {"nodes": [{"id": "1
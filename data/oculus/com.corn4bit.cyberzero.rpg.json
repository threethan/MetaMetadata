, "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393516_1383378459502659_6206652524088167712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ehn-JP2aqQQ7kNvwFEZ04-&_nc_oc=AdpvSndoRVS2V07dWrcjwmHAVsoX3crJ3NR6YpPk-Ey_RR3-DaO9BKZpwVVR4C_w4ls&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTWpuiJI-I75uAvNMEZDK1Us16PF2s-rAcRp9jaBnl2A&oe=6A918341"}, {"file_name": "Screenshot5.png.png", "id": "626270350244014", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392025_626270353577347_7099840124173263698_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ7195H6t70Q7kNvwFpEE2U&_nc_oc=AdrXiJRAHQAwT7bT74mFgvuXMNLbJkBikashPS02O0Rm0BJKJG2Rp68gUhmKQDouyFs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvlsqYWw295n5rwZe6EAqVtQFmrp42R9BDl_gEVNNa7g&oe=6A915CE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CyberZero X: Night City RPG", "keywords": [], "long_description": "Enter the Neon Future \u2013 Now in VR!\nGet ready for an adrenaline-pumping ride in Neon Nexus VR, a fully immersive cyberpunk racing game. Explore a massive open-world city, master high-speed drifts, and conquer daring challenges\u2014all in stunning virtual reality.\nKey Features:\n\ud83d\ude97 Ultimate VR Racing Experience \u2013 Feel the rush as you race through a futuristic city in high-speed cybercars. Experience realistic driving physics like never before in full VR.\n\ud83c\udfd9\ufe0f Open-World Megapolis \u2013 Explore a vast cyberpunk metropolis filled with hidden shortcuts, vertical highways, and neon-lit cityscapes.\n\ud83c\udf00 Drift, Jump & Soar \u2013 Perform gravity-defying drifts, jumps, and aerial maneuvers using futuristic flying vehicles, gliders, and more.\n\ud83d\udca1 VR-Optimized Immersion \u2013 Enjoy hand-tracking controls, cockpit view driving, and interactive environments that bring the cyberpunk world to life.\n\ud83d\udd25 Missions & Upgrades \u2013 Take on thrilling racing challenges, earn rewards, and upgrade your fleet of cyber vehicles to dominate the streets.\n\ud83c\udfc1 Race, Explore & Conquer \u2013 Test your skills in open-world free driving, challenge other racers, or cruise through the city in style.\nThe neon-lit future of racing is here. Are you ready to rule the streets of Megapolis in VR?", "short_description": "Race, drift, and soar through a breathtaking neon cyberpunk city in this immersive open-world VR racing experience! Feel the adrenaline as you navigate futuristic streets, execute high-speed drifts, and take to the skies in a world filled with vibrant lights and towering skyscrapers. Explore the city at your own pace, challenge rivals, and master the art of cyber racing in a visually stunning, action-packed adventure designed for VR enthusiasts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://corn4bit.com/apps/vr/cyberzero/privacy", "developer_terms_of_service_url": null, "publisher_name": "Corn4Bit", "support_website_url": null, "website_url": "https://corn4bit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "673385183287495"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9467943549930896"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "950304394699551"}, {"status": "PUBLISHED", "id": "1286209053491945"}, {"status": "PUBLISHED", "id": "2006858586848505"}, {"status": "
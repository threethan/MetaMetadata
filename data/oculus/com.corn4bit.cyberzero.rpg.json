", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9367889689936283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27729247420040564"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "597994909902784"}]}, "change_log": "Motorcycle Comfort Improvements\n\n- Reduced motion sickness while riding the motorcycle: the camera now compensates for the bike's lean angle in turns, keeping your view stable and upright\n- Smoother camera transitions when mounting and dismounting\n- Adjustable lean compensation for riders who prefer a more immersive tilt feel", "created_date": 1777638750, "id": "26679007145064602", "version": "0.5.2", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9367889689936283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27729247420040564"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "597994909902784"}]}, "change_log": "Hotfix\n- fixed some serious bugs, more in our discord channel.", "created_date": 1774299932, "id": "26253975034234484", "version": "0.5.1", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typ
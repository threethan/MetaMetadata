, "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393516_1383378459502659_6206652524088167712_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdZcZkfy9mgQ7kNvwEMh695&_nc_oc=AdqRZIYTDJ0nb3LT4sn3Jg16_Hxk_CcukejOvoA0C5C5lvQFXSSgCBXToyXW_dm0b-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIp8IPLCnSb8FRQyWeOTtBQcuaQOBoKmYiQvmwJRGxRCQ&oe=6AB12741"}, {"file_name": "Screenshot5.png.png", "id": "626270350244014", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_626270353577347_7099840124173263698_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhHJn-gsGxgQ7kNvwECLNKK&_nc_oc=AdqBhFM_xmp4ntxRR3ZZuimez-MhTp6Nheeiu3Czx7mxNPahn7QiR8Kyj7RyYtqTnaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5rrUoJ4FpSAByGq97nSCR94_KPR-g30cp0oZLm46Xsg&oe=6AB13924"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CyberZero X: Night City RPG", "keywords": [], "long_description": "Enter the Neon Future \u2013 Now in VR!\nGet ready for an adrenaline-pumping ride in Neon Nexus VR, a fully immersive cyberpunk racing game. Explore a massive open-world city, master high-speed drifts, and conquer daring challenges\u2014all in stunning virtual reality.\nKey Features:\n\ud83d\ude97 Ultimate VR Racing Experience \u2013 Feel the rush as you race through a futuristic city in high-speed cybercars. Experience realistic driving physics like never before in full VR.\n\ud83c\udfd9\ufe0f Open-World Megapolis \u2013 Explore a vast cyberpunk metropolis filled with hidden shortcuts, vertical highways, and neon-lit cityscapes.\n\ud83c\udf00 Drift, Jump & Soar \u2013 Perform gravity-defying drifts, jumps, and aerial maneuvers using futuristic flying vehicles, gliders, and more.\n\ud83d\udca1 VR-Optimized Immersion \u2013 Enjoy hand-tracking controls, cockpit view driving, and interactive environments that bring the cyberpunk world to life.\n\ud83d\udd25 Missions & Upgrades \u2013 Take on thrilling racing challenges, earn rewards, and upgrade your fleet of cyber vehicles to dominate the streets.\n\ud83c\udfc1 Race, Explore & Conquer \u2013 Test your skills in open-world free driving, challenge other racers, or cruise through the city in style.\nThe neon-lit future of racing is here. Are you ready to rule the streets of Megapolis in VR?", "short_description": "Race, drift, and soar through a breathtaking neon cyberpunk city in this immersive open-world VR racing experience! Feel the adrenaline as you navigate futuristic streets, execute high-speed drifts, and take to the skies in a world filled with vibrant lights and towering skyscrapers. Explore the city at your own pace, challenge rivals, and master the art of cyber racing in a visually stunning, action-packed adventure designed for VR enthusiasts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://corn4bit.com/apps/vr/cyberzero/privacy", "developer_terms_of_service_url": null, "publisher_name": "Corn4Bit", "support_website_url": null, "website_url": "https://corn4bit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "673385183287495"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9467943549930896"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "950304394699551"}, {"status": "PUBLISHED", "id": "1286209053491945"}, {"status": "PUBLISHED", "id": "2006858586848505"}, {"status": "PUBLISHED", "id": "2939381149588435"}, {"status": "PUBLISHED", "id": "1589409932300214"}, {"status": "PUBLISHED", "id": "2016564812245620"}, {"status": "PUBLISHED", "id": "1365985978358622"}, {"status": "PUBLISHED", "id": "1217479610207186"}, {"status": "PUBLISHED", "id": "1915436896065112"}, {"status": "PUBLISHED", "id": "1315605863544872"}, {"status": "PUBLISHED", "id": "1583987593007116"}, {"status": "PUBLISHED", "id": "1467924661018505"}, {"status": "PUBLISHED", "id": "1766519707275224"}, {"status": "PUBLISHED", "id": "1332783034685964"}, {"status": "PUBLISHED", "id": "2210991936005604"}, {"status": "PUBLISHED", "id": "704748995469161"}, {"status": "PUBLISHED", "id": "1441199576874103"}, {"status": "PUBLISHED", "id": "984993243749896"}]}, "baseline_offer": {"id": "1332783034685964"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785524400, "status": "PUBLISHED", "id": "950304394699551"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28156222947343007", "version": "0.6.2"}, "id": "597994909902784", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9367889689936283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28156222947343007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "597994909902784"}]}, "change_log": "What's new:\n\n\u2022 Reworked motorcycle handling \u2014 front and rear braking with ABS, no more rolling backwards or getting stuck after a crash\n\u2022 Up to 2x higher frame rate on Quest 2, steady 72 Hz on Quest 3\n\u2022 Footsteps you can finally hear\n\u2022 Streets filled with detail \u2014 hundreds of objects you can grab or kick around\n\u2022 Fixed several bugs that could block story progress", "created_date": 1788262070, "id": "28156222947343007", "version": "0.6.2", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9367889689936283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28156222947343007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "597994909902784"}]}, "change_log": "\"The city finally feels lived in. Streets, alleys and shopfronts are full of clutter you can actually mess with: grab a can and throw it, shove a barrel out of your way, or just plough through the lot in your car.\\n\\nAlso runs smoother than before.\"", "created_date": 1785271974, "id": "27729247420040564", "version": "0.6.0", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9367889689936283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28156222947343007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "597994909902784"}]}, "change_log": "Motorcycle Comfort Improvements\n\n- Reduced motion sickness while riding the motorcycle: the camera now compensates for the bike's lean angle in turns, keeping your view stable and upright\n- Smoother camera transitions when mounting and dismounting\n- Adjustable lean compensation for riders who prefer a more immersive tilt feel", "created_date": 1777638750, "id": "26679007145064602", "version": "0.5.2", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9367889689936283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28156222947343007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "597994909902784"}]}, "change_log": "Hotfix\n- fixed some serious bugs, more in our discord channel.", "created_date": 1774299932, "id": "26253975034234484", "version": "0.5.1", "version_code": 14, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9367889689936283", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28156222947343007"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "597994909902784"}]}, "change_log": "New questline: uncover secrets beneath the city, find unexpected companions, and watch the world around you change.\nBug fixes and improvements.", "created_date": 1773434683, "id": "26150604387904883", "version": "0.5.0", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
=00_Af13wF0j5OjIvFha5QdA-V-aNE4iRt4XS7z_rzoG68NVnQ&oe=69E4E23E"}, {"file_name": "machu picchu.png", "id": "1496232124281557", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974602_1496232130948223_8634597678513095839_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvSpLcd5n7wQ7kNvwHiWYX3&_nc_oc=AdoPUuh5rMXzpa_MQKZhlJyiVC6czOQsa-cWCN-9aZ_O8l5-bzCdv8DBf9nQuOe4O3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37vkgu3jtkl7-Kovsiiu1xpVKHh34qNE6LzDgWkvtj0g&oe=69E4CA4A"}, {"file_name": "Machu Picchu.00_00_08_14.Still001.png", "id": "286478827786678", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75334060_286478831120011_8878711438786878353_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyEApj4uUiAQ7kNvwFjvp1P&_nc_oc=AdpJzoECh_Lpgpd8AdLU0Cy6HztNlDNyFOVmf51H6FUozrzVCErckBr91AA64_MH1yU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ter45fP7qXEEPaBvms-6gH_HAxvLc5CZM1Ts6K42lhQ&oe=69E4DC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "triptovr9.png", "id": "917320386720448", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003233_917320390053781_1969244523528839186_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQ9hp2AUXMgQ7kNvwGIkPjV&_nc_oc=AdoO78xAd0wZQH21N2Lg7n6Wg7oMKCDc8UGa70UezL49166NI9hjyk3Nz8Nrv1dURP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hiLkuHfq5SEHWv2scv7iJ8mj3tBcOggZ3ctwl81l4XQ&oe=69E4EBE9"}, "display_name": "TriptoVR", "keywords": [], "long_description": "Embark on an incredible lifelike virtual adventure with TriptoVR, your gateway to the world's most enchanting destinations. Experience the vibrancy of cities and landscapes, brought to life with stunning realism, from the bustling streets of Tokyo to the tranquil beaches of Cape Town.  All from the comfort of your home.\n\nBoat on the serene canals of Venice in a gondola, marvel at the grandeur of the Eiffel Tower, witness the architectural splendor of the Sydney Opera House, and immerse yourself in the culture, history, and nature of Istanbul, Bali, Prague, Lima, and many more. Our app brings you closer than ever to these breathtaking sites, letting you explore them in vivid detail.\n\nMarvel at the view of Earth from space \u2013 rotate it, zoom in, and choose your trip. Whether you're a curious VR traveler, passionate about history, modern culture or love the outdoors, TriptoVR offers something for everyone.\n\nJoin your fellow VR explorers, pack your virtual backpack, and set off on your journey with TriptoVR. The world is at your fingertips. Download now and start your global adventure today!\n", "short_description": "Travel the world in VR with TriptoVR!  Marvel at the view of Earth from space \u2013 rotate it, zoom in, and choose your trip.Visit the most beautiful and famous places on our planet. Go on a boat ride in Venice, stand in awe beneath the Eiffel Tower in Paris, and witness the Washington Monument. Bask in the sun of Cape Town, or immerse yourself in the bustling energy of Tokyo's famous Shibuya Crossing.  And here is much, much more to see and experience. The world is at your fingertips with TriptoVR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vr-gorilla.com/privacy-policy-triptovr", "developer_terms_of_service_url": "https://www.vr-gorilla.com/terms-of-service-triptovr/", "publisher_name": "VR Gorilla ", "support_website_url": "https://www.vr-gorilla.com/contact/", "website_url": "https://www.vr-gorilla.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
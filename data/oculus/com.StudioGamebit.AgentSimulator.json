mluBtPyj5e8qSiB34TLap2QNurrSxaw&oe=6A032291"}, {"file_name": "image_233_0000.png", "id": "1532761904236097", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75282165_1532761907569430_2813833838158706545_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=am1qrtrhwSoQ7kNvwHOI9pI&_nc_oc=AdoNEXIAMkuKwJ-rYA6rPxOgbdBvQ9nS0fyd_5ZT-2wUMn0usQfZEb5rzJ5MAZRIr2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7p21RHeCwpxD8XHuFEOCI7QQxEuS3RXLoyZuQZHoeuaQ&oe=6A0328DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01-2560X1440.png", "id": "1009251620561888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003282_1009251627228554_2485220501157752430_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAnrDJoDo7MQ7kNvwHdZ0Jz&_nc_oc=AdpjgHGVo0xMnFxRNvr24zaaMpbfiRkilSVJoNj7iq9qep-pmDdgiz689rBcRskl62I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_iCShAvCi3SPCY0-DQONx6DmPCx0PqTOg7vVfZf8RMA&oe=6A0328F0"}, "display_name": "Agent Simulator", "keywords": [], "long_description": "Agent Simulator is an action, simulation, and strategy game in which each player shows their targeting skills and agility against enemies in a virtual environment. At the end of each mission, you will collect medals and earn various certificates with these medals. At the end of the game, these certificates will prove your strength as an agent and help you to receive your agent license. \nIn each level of the \u2018Agent Simulator \u2019, you will be evaluated according to your targeting skills. Before the limited time provided ends, you must kill all your enemies. Every successful head shot will get you more points! Sometimes you will be asked to complete the missions in such a limited time, you have to be fast and agile!\nThere will be three options offered in each level and those options will constantly change! For example, double bullets, double damage, slowing time down, blocking bullets or extra life, etc. You can strategize using any of these options!  \nFight to be the best!", "short_description": "Agents wanted! Would you like to join us? If you are a sharpshooter, you would be a great fit for our team. Within a short period of time, select 3 options from the list and deal with your enemies. Do not forget that the ability of using time efficiently and aiming your targets are crucial. Complete each mission and earn an agent certification at the end. Come on Agent, it is time to prove yourself!"}]}, "developer_name": "STUDIO GAMEBIT YAZILIM VE TEKNOLOJI LTD.\u015eTI.", "developer_privacy_policy_url": "https://studiogamebit.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "STUDIO GAMEBIT YAZILIM VE TEKNOLOJI LTD.\u015eTI.", "support_website_url": null, "website_url": "https://studiogamebit.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7517830941628806"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PENDING", "id": "828392393216638"}, {"status": "PENDING", "id": "1427000135845609"}, {"status": "PENDING", "id": "2413527039074627"}, {"status": "PENDING", "id": "3382067828621530"}, {"status": "PUBLISHED", "id": "2104841413698798"}, {"status": "PUBLISHED", "id": "1510469016696049"}, {"status": "PUBLISHED", "id": "880871231232864"}, {"status": "PUBLISHED", "id": "17989400948296
HdWY9qHDjNVjDNdMpQQ&oe=6AFDB48F"}, "display_name": "Food Truck Time Machine", "keywords": [], "long_description": "5 time zones and 20 different recipes to master\n\nCook food on a hotplate, microwave, deep fryer, coffee machine and slushie-maker \n\nEach time zone has recipes from that era to cook\n\nExtremely accurate physics feel just like the real cooking\n\nComfortable and Smooth locomotion supported\n\nCan you cook your way home?\n", "short_description": "Imagine if you were in a food truck that could travel through time!  Your journey will span over 2 millennium with 5 different time periods each with its own set of customers and food.  You are the time travelling food chef but can you cook your way home?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pennyredgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Penny Red Games", "support_website_url": null, "website_url": "https://pennyredgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8226343437477458"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974713_585665457011564_4210711198030000329_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Yvf9aH-3HAQ7kNvwE97NnH&_nc_oc=Adqt630PDr37fsj_VBbaMHrrH8VXWFGW7kIS0twC_ZzD75A
c_oc=Adr5d0cAdB53JtciAmPMTWibix38AqoDlzbo_zQ5cksiQ7QaiVsh431hArKToYKAD-8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yYjHTKJnHM77-bilshwaMXBkkmc9SES3OloX1r7MIrw&oe=6A395E15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FoodTruckCoverforVideo.png", "id": "776584087539291", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035353_776584090872624_6854657345404042416_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVSJnFH5ZxUQ7kNvwGN4x7V&_nc_oc=Adom-FsAbS_42ldwOS29YH8mjCEY02SLfl4_fRKUUnvRT3Jdf_C48R6NOuCT16jIHVo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tP8nmWD0VHxUmUBO7AmJB7O9bw1mH8_vc83dhXSsi9A&oe=6A39450F"}, "display_name": "Food Truck Time Machine", "keywords": [], "long_description": "5 time zones and 20 different recipes to master\n\nCook food on a hotplate, microwave, deep fryer, coffee machine and slushie-maker \n\nEach time zone has recipes from that era to cook\n\nCustomers pay good food with everyday items, blend the items to fuel the time circuits, when the circuits reach zero you can travel through time\n\nExtremely accurate physics feel just like the real cooking\n\nComfortable and Smooth locomotion supported\n\nCan you cook your way home?\n", "short_description": "Imagine if you were in a food truck that could travel through time!  Your journey will span over 2 millennium with 5 different time periods each with its own set of customers and food.  You are the time travelling food chef but can you cook your way home?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pennyredgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Penny Red Games", "support_website_url": null, "website_url": "https://www.pennyredgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "exter
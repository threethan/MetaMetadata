 "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982519_1253672022188410_878740463971654553_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGixw1UZt8MQ7kNvwEN7iX4&_nc_oc=AdqysaZpeDlIX0pJWMgI8wVXfLEMoRJa8JqHhU9zEj-qI4dWckbgOF-QjDCkbcTU190&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkgii-E55QRq5ilSsPjo-0__CcD4LSeymYoyWFjejniA&oe=6AFC6C83"}, {"file_name": "Screenshot5.png", "id": "1528277614247853", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974711_1528277617581186_4196920594943896428_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRBuJJXeUckQ7kNvwFkqKmn&_nc_oc=AdqzKVHBBr5npzO_Q0R3UEtNImf-3hgtGBfh3jRE_i4xPnDlzhM1o_wNubB8D8DFNA4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaiT2O4pzaRi4KvX-4c8HZZueiwOD1e7ygynifknPLhA&oe=6AFC7C15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FoodTruckCoverforVideo.png", "id": "776584087539291", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035353_776584090872624_6854657345404042416_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr-kzevozQoQ7kNvwG3z4Nm&_nc_oc=AdomZIPQSQd6Dwrz4gh1R8HeV_q8e_wNrm6sj66Es-SuT5sC0zFywIVyrmLTwNqbOao&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFPBruTgKYjUxt4HnMxLgLRLF87kQCvWXJFA-Qd0fs5Q&oe=6AFC630F"}, "display_name": "Food Truck Time Machine", "keywords": [], "long_description": "5 time zones and 20 different recipes to master\n\nCook food on a hotplate, microwave, deep fryer, coffee machine and slushie-maker \n\nEach time zone has recipes from that era to cook\n\nCustomers pay good food with everyday items, blend the items to fuel the time circuits, when the circuits reach zero you can travel through time\n\nExtremely accurate physics feel just like the real cooking\n\nComfortable and Smooth locomotion supported\n\nCan you cook your way home?\n", "short_description": "Imagine if you were in a food truck that could travel through time!  Your journey will span over 2 millennium with 5 different time periods each with its own set of customers and food.  You are the time travelling food chef but can you cook your way home?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pennyredgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Penny Red Games", "support_website_url": null, "website_url": "https://www.pennyredgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1377541879759642"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "3756406881349923"}, {"status": "PUBLISHED", "id": "765553328660078"}, {"status": "PUBLISHED", "id": "1236467230363777"}]}, "baseline_offer": {"id": "3756406881349923"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715981340, "status": "PUBLISHED", "id": "3756406881349923"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6047363415375482", "version": "1.0.1"}, "id": "533887878913941", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5695525937225900", "is_concept": false, "l
mbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoMfAhCU6hYQ7kNvwHyOIIS&_nc_oc=Adp9vvX7ebjbItsRQSMHcuZ9hKG2mxj0YE4SEjUqHIOH_xHQQC_1kW8HrH2j9R4kBmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbfwAGp6nJsXDX43Hk64N9h3i4F5DyfOv8qLsTxq7ljg&oe=6B01B9D9"}, "display_name": "Interplay Learning SkillMill", "keywords": [], "long_description": "SkillMill is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the SkillMill course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nSKILLMILL - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "683124789527982"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1113530470345591"}, {"status": "PUBLISHED", "id": "134423881857786"}]}, "baseline_offer": {"id": "1113530470345591"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739468640, "status": "PUBLISHED", "id": "1113530470345591"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29352087284432055", "version": "87"}, "id": "274671133989109", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3895615007172633", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29352087284432055"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "274671133989109"}]}, "change_log": null, "created_date": 1793654262, "id": "29352087284432055", "version": "87", "version_code": 611021311, "rele
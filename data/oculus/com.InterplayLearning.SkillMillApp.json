PKgQ7kNvwF-1isY&_nc_oc=AdqrwWrN2uZds-uP1mjbPWyc9GUpvDynHswWLQtj6SAAkuLOOpXfH5UGdhgpxh768X8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_bxtZho7GQzCa_RU4PhHAMVXBuK_Mzl42OQtRnmKMBw&oe=6AA2AF11"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR0UdU2d9C0Q7kNvwHBwYFU&_nc_oc=Adr4S9moA8h7OMl76uspj4YdsLjjNBuxmEmP7ImFW-LGhO4ST2jW3cxSZrkERo93wgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdeWy3BLcATFSa16BtSgFqDnd9ppkWml6IIZJcWe5lwA&oe=6AA2AE16"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHvgppJhze8Q7kNvwHD7fNp&_nc_oc=Adr1XItwoStQ74ZdsCfkdjnw_sgSPo0UNICYThi9Qgg2u469IU8PAVBb3k6EdGSx2kw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJKnWelmlqdZxlMbCvTZQgWcW_goOLCo_wHE0zcP_tTA&oe=6AA2D2DC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP6DcJUnDS8Q7kNvwGTHXnS&_nc_oc=AdokM7Fq6cutbFj83i3VCoVrBfEhPe8_BqTIvcdu0aYgY-dKVmdbngjWRhqNkBJNSHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQWHwKEh4Qm6oT6MIUlZaUD3mmwGUVeLDZZWNRskV1Hw&oe=6AA2A141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjkKGL5KyOoQ7kNvwEBFDGG&_nc_oc=AdpvjqaEbuIu3CW2YIBnUZ9tyZ8BHNPcEFqG4rpnxYLdd9QQJ4MqOARn9_OO8hlJoIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJNU3GPeChXSbOSqFBDV6WlS-1TFKg7TYD1u1xW5--JA&oe=6AA2CDD9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
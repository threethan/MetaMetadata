l_EQ7kNvwECFuTR&_nc_oc=Ado8H8hJvk0jMASaCUGSUV7ja1zuO8OJD-ANZt1hCN_fVCsqeHKaBTsdPhisATgzurc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wrKR_xd8qEXQ3HbV3p680IHUWH7r8gCkYa2DXLZ0bPA&oe=6A37E591"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHU0Mw6GddYQ7kNvwFQk68X&_nc_oc=AdqMVoh7mL1jIsP5lvTTIpzxLoriN9T_X_xiMFE9_odYijLLR3x4x5IstPBHvLaTBVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uOGOJ0cz1ZpI1BQszRgj9HOtOk8-s_mDtrWSGW9Hfgw&oe=6A37E496"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK8HisO8S7gQ7kNvwGLpC_z&_nc_oc=AdrreBJxBYTcC6Vn3-Be5ULefKkJnjtGuCXfJmVzdt0y0265EfCEiCDECgaeXgOplMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cg9ev7id873pXUvn5TnroRtOx50I5Bziv9GYpaf3dnQ&oe=6A38095C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKUQ7u7z0ycQ7kNvwF93c1C&_nc_oc=Adp_CXeHm4RRolpxhpEaCyErSiYYBr1F56I1d9LfcqZbT-Xcn2r4Z-_xhuasqLszcGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j9PABWrEhIJvJNfERDsan2cf3GMrXjyAtmB2paYtoHg&oe=6A381001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQycUbaoZwAQ7kNvwHHC4mu&_nc_oc=Adrni_ni8UZC0RFruio-Sso7IwnUpitnwqJeEc8hwqT2h2cNbpR5fdIUBjBngS1Dzug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zs-AfL2fxdu9kTxfWXJG20Hz2lnsCIO5gKJgaUxY6jA&oe=6A380459"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
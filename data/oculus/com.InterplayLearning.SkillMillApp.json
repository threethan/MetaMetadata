cyIQ7kNvwG1DM5U&_nc_oc=AdrwmsneU4aNPQTRhe-Q6FdhT-BuwsgIfzu2i5xUpJDc0ZF90aK_hoRum9gfzhiAJB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RNo288dTz2eRNHfHafozc3erW71DmoM5p_ySIegOdUQ&oe=69DCEE11"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk56QDTlORUQ7kNvwFCejI5&_nc_oc=AdrKfjVyXmoUJYpRhlXa5sD_ZCKtZ_4XiMKqtP7aJzPt7kK1Iw8SiQJV8VzzowA13Vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08whQkHhNgFVILhOYuxua4M1z1OOo0vT1z_1tpAHeyqQ&oe=69DCED16"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvY6rNTzYQUQ7kNvwHeh5Nz&_nc_oc=Adp-gRq-qqHHA3V9SJziXwLPKPP7_K5JfdcvRTauxO0jodYnVgPZSEKsZny4XFN87H4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HkycnZhJwlT18p7zmnolrbct3ot8Ute4N1Kteuip3Ng&oe=69DCD99C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJVmyjKTGEsQ7kNvwFVxbpp&_nc_oc=AdppBj7PPa-cXu7Q2pWZR-PNlbyUUvYnMlQ8qRftwDjow-6OHkfOfzrs3YdpepEIp00&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09cIpzFP2kRjZg3qBchNtiG7reS9YUd-o8JwRDHxuCBg&oe=69DCE041"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds6bHRtqHS8Q7kNvwFIyEra&_nc_oc=AdoamorT_th6RM4yRE1ARIqEq2ApBol-CBJxiAb3hgccJknzdJmCwHDw8vlkGxyuHtg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KiY91wkzEFtPThktaX68b9TEHNlSbUo9CMItqeSd7Kg&oe=69DCD499"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
gpUQ7kNvwELy5tI&_nc_oc=AdrdLpB84RvhgqWiSK6kzjt81gCI7N5WOB19tsa51uu23KcCBAAQO7T270-hyfrxsRQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af242-gJLuYeGdHMF_RBkLzJNEPFbSZt1pM--FVj2Hv_uQ&oe=69E62891"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACrhj4luTJoQ7kNvwGGZPhs&_nc_oc=Adq5pHlhYJQMbuqWSN_oxL-fIz25Kx-43B0YWmAribNv2AlHvYd4nk-Um8HlcpLO8kU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g3HdASCEnjBIqojvNuS95VxJITg5yntudC0FBm3WBzA&oe=69E62796"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AkhycHWqaUQ7kNvwEXtzIx&_nc_oc=AdposeQCjpNsEuAobmoozQ9sE6vuI2cKfIv4XynfXommMWclf1cvK4EFjGQMcJAc33k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_rXApUcCzQacf8JoefVj9OoNLm7hYfv0yvuyPe2mhxA&oe=69E6141C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMqFWn0CSywQ7kNvwHb1Q4i&_nc_oc=AdqurDt5n5W-Ii5r18jBw17e2Crx7rNelSvcDAPH1445zllB4Bp6Tc9gu8bq-teP7Co&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DbscSEx85lfiOxQJwAFXwzb0ckFO9vU1wLxlniLRiVg&oe=69E61AC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4tQO0lgObgQ7kNvwGMXvJC&_nc_oc=AdqwAoHPMQODJL7Y1ylRfBdxthQZiCD9_86T37D_AOmfkAasUsJZaxmMqEdn46TSAsc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kzIzUnj_7fhWiyYTaN-OZ1wkcXHmJMSzZlxS4Aah2dw&oe=69E64759"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
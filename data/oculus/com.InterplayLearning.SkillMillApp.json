v0sQ7kNvwFnx6st&_nc_oc=Ado8YN005YnsSBf6vBQ-C0zbRDdyUAL-HVDzgUtwjRQMN5tvAY51p6bKhrFVgcvqRUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWkLHOLZQFADxE9p70a1hNji4TZoChdjFcLiWdcX82ow&oe=6AABE991"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3y4PJc3Q39AQ7kNvwH7IYkX&_nc_oc=Adqd5obQOlyCcHgsSkoXwm6s15KM4Ji92Eox-gx1fWqm_OncuRnShGLbjhrfg2a8Pho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoOprfYsfbc7O56FY5VX582dnqpWRYvvIOLxOsMM8h9A&oe=6AABE896"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AO8f8XDA_0Q7kNvwHgrWDX&_nc_oc=AdocriDvfceEb3hi_RFLa33Vw4jc1BS1SbOyf5v5-IEbht3I3FgvvP3OeiOZmFtwHtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbK4u53nWLnhmSIuwwfp0u0tKtrNsO9LveOPOz3Y9lgA&oe=6AAC0D5C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIqSVs12-akQ7kNvwEHc3oU&_nc_oc=AdqosbRSC5XRkAvVXdzvXnyI8EJWkHJaodVUAACB0IO0c1sH2GiVr0pPe8045pKMshU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeM9yqwoMD_DvYOlZos8fazleNkgJZoMOB7A3uUww92g&oe=6AABDBC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU0vzfVqwOYQ7kNvwEjuXKp&_nc_oc=AdrHcR95aRmG_i7zmNsCKU6XXm7VKrG7xNQjEI7b_Nmc4sjDCGESiutMAkt3C5JX_TE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNr35DAj4U7Q14s-qvfuqo2G1QgXZEYm4FarF2_-YMCg&oe=6AAC0859"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
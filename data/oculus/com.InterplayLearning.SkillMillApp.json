hpMQ7kNvwErmjgs&_nc_oc=AdqegW0c39b_dEpDRM5zaVz6lstTU3gwCubeOq6OkYssQJCE5RcIQkHAq7ERxJrAOow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs9UGvhZ8B5K7smWPXrN5DV09pvPF7aTN_vundd6CakA&oe=6AAA9811"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr6T4WI96fEQ7kNvwFMHEDs&_nc_oc=AdqEwNvwgbuBwCISFEb6fL3b980yKe5uYXgHjS2EHGZVITpGPAbDZ--9AoFjalZRB9o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX1YlwG4JwW_PbcpRtAtIKbkXtQ7pfRokgvJ0coUhFaw&oe=6AAA9716"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AO8f8XDA_0Q7kNvwFRULP4&_nc_oc=AdofNbQCOQtspsQ_JbnMsyC-8kgCn4xJZyR3ykQv1ZToSABMpvVNdnZp8AWLlcUJNEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxmZgjEq_lSnfeX4sgFRLwtd4oR1fPzcITK5l8afdPug&oe=6AAABBDC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-r3yipQciJEQ7kNvwEax90s&_nc_oc=AdpL7XPgOVvxVgjHcpk7Gn15T9s-5GSvoNOjR9Dt2zQEw1LS-3DOMg4-qGYzlFPCxgw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvaYUzLDVpUzrfQM5w0IV20cmu5B4G7a8jMBQ5U_BRIg&oe=6AAA8A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4ZsX4wJ_rkQ7kNvwGlQhjf&_nc_oc=AdrWNg4sRuZ9bEd-SqRdwQ4wd_CxpTVhkFK6LinUOWBUNSAURkuSHoamVsVALBTz3Kk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR3r6brkmAASMi97R3SfCVvM8tOdL3_p-a3wX1Nbe85A&oe=6AAAB6D9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
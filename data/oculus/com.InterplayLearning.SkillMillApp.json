QZkQ7kNvwGTdJiS&_nc_oc=AdrswAhA3SpMWQRjGLqFQRqLj9JT5D2jPtPzY9sQL4rhF6l8soiKSXuA3g3-BHpwgg4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18naHK_8D2IG7zRI8dqMvipUpQyryeS_TjgzWD9A0Isg&oe=69D7A811"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a0ntz2gZDMQ7kNvwEufzfA&_nc_oc=AdqcKo2Wl5BpTdptkRQOcAowFLWzXX443LyFh8WlpR4lQ4W4YrO-veSw5CMLFvL2l6I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LXFtajBGGh6qxIoJtLt7-MXD8mRkwWE3mUsSSHBNlYQ&oe=69D7A716"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upnoP1PMiK8Q7kNvwGdeadO&_nc_oc=Adocl1GT3b5AzUTcTIXiHoVl1p4TbjwRd0O6TCG8A9CAvFZOOc4c_LAYJG_zaNnIsTM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CCcuhi2Z9hrHhJbxqOumhjYVpsg8rvW5gzc5DVQ91GA&oe=69D7939C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoxpUHf4Nk4Q7kNvwFsSKfn&_nc_oc=AdqREOWSU0SbsramfAvKnlyDaItoVjdaT5VGfxh2eIwcoknKq1luuGOPaLyKyIw0cZ4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yerJZvmHWBWodqQmh8ngZpjycDXtrO0Bc4dYNrrZMTQ&oe=69D79A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XvUQO6U0KwQ7kNvwGHeJWA&_nc_oc=AdqSruixKE3UZFzYAqNzWm8M0G6epu-cK0GbKWFbRH3Xowr6eHB1I41seaW4haZ6Ja8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15ASKAe4Y9FNEkLH-7uZDLwYn2-TPoAAVY0uwKqrZLDQ&oe=69D78E99"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
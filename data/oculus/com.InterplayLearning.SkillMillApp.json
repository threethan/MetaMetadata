4jcQ7kNvwHbvwXs&_nc_oc=Adrhw2fkkx7gMleDnIu1cE01c9m4zMXpufLnA8uut0RtM1vky8QWPnLVWIKrS5KAeT4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B96jONldFTnEsZJ7skyHCt63dRBTnNDpDL9CEEiJiOA&oe=6A412011"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjSwHwkEOMkQ7kNvwF_3sEK&_nc_oc=Ado6ELl2dvMhq_zx4ysK0Rvy1pdzJHY1y2JTUTSkxkySTB1-FQBK3GeudfcPSph-y1s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YUXHLmXR3gq3tawS0ia1pDwI2CnZlM0CWMttHoZxXeQ&oe=6A411F16"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M9OkbGAtMQQ7kNvwF0wY5V&_nc_oc=AdpjOnHB1zy0DnMvQ54OCGggrzS5UZi1j0JblxhKQiwLBnz2y0nQ50ajgPlDI9LfXIc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G1gZ7DpAKrAg44St5wSKx6dRhzJeiJMALKkPZY5X6xw&oe=6A4143DC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48-csK8Vho8Q7kNvwEk70lP&_nc_oc=Adqsy9F-jd4Tpdfgfe1MQ-vkCQGg5VJdigLIZhzQJEzGho7S6vmuGx8xPGQTkxqSSU0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VdJIk8J5BnjG_SOaMe9RGm-SOHbEEPnlwFTvGqqqw0A&oe=6A411241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFAFAd1594oQ7kNvwHjYzuu&_nc_oc=AdohFJ2hIfbTuxcWJ1GZk9zeXOX9zzmgSrm4smuf9Ph_0a7tynirePXhDM6bBTRC_9U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dLX19TxXfcX3cEoT5Q_w6djVPJJsLVflfec8g3cc1qQ&oe=6A413ED9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
JFYQ7kNvwHhs5J6&_nc_oc=AdqjTkHNt1JFJQmuSqo4d5iApJdZbZSkmBnFkytYVAWqMyg_9BzOI2y8h1VjezXcvIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqzo-JZmihtc1k1L9KdLUCXreTx_rmEmlET6Q4KH_YSA&oe=6ABBBB91"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKp4hSgC42sQ7kNvwFI9SD4&_nc_oc=Adqw9vB2SEk1e6ivyYgVHlKt34-QuRTyS3kY0k6ufSOvgCbn-oS91AxZTDpAuLYcJXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwpdTtb-neRB1L6f_AeLWRQoceoq64c0vbeBNj7JwjRQ&oe=6ABBBA96"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL8h8QDSpPwQ7kNvwEr0KyC&_nc_oc=AdrTc8w8B6zQRCMHiJ7FaAtOe0VZUppMjRkpBUbnTvWyjE8bFZfNqIIEudaCY5_iRbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPa0_jM7Eg3pYSicHo9AYUCnlk5TfcLUDYS38ihfvU0A&oe=6ABBDF5C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfoq0KhQQWcQ7kNvwFme8FE&_nc_oc=Adq3UcZ1BZeMVlfJr80rV0u-KWrGZWJ7XZ8JiEz0-lGQbYLjHK95aPD03GF-502czqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6-rHKDmrCM0lZu54ocOr11aIooBY_sZmFmVw-yW7CQA&oe=6ABBE601"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb1s03PIIoMQ7kNvwGHIMrP&_nc_oc=AdpENwuSiPdtt1aY8X_wkPljDJYLpjS0zEjDPp1dXyYxEPa3SlWasc-fkGGtgTBVDJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZTWsdgcT11v2wHB4c6XSyX8OlzDHxfm5da5pvc3oGxA&oe=6ABBDA59"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
_w8Q7kNvwGcwI1V&_nc_oc=Adr2jsgGe-cInGyrgA6afj5yJwcb_XbatAROK7a0BfaGAdQ59lpArKaWVgQ2Naqtvfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89Dv25_UmCH0BuVYvFPt42QGl_7J4U2ltO1XNzlIdTYw&oe=6A3E7D11"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDrKuNoy_JAQ7kNvwEOGrmX&_nc_oc=AdoiFWN_ahU-RvUzGdYkkQBlMQKeILEl89KpMtTBn13eLzxMmXSdCbjWJ8JyYBNSPsk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wvUYN6qvXHxOOINfxTCvR8-kVr3iHn7pq480xJWzqog&oe=6A3E7C16"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFvR5ahRM9wQ7kNvwEZwF1U&_nc_oc=AdqZuxYsecMMEV6rWDjRdJK19QxRBMKG2iUY0AEj5mE2vU_JSts03VR2xV6846l3PWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K6fhGLmG2xmcxzd7jCkU_aX34jFPg4rv6EtVJGlAcdw&oe=6A3EA0DC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBecV-2HL2UQ7kNvwFMr8mx&_nc_oc=AdonfiU78mYwptjlq8bFH4K6J_PpqvDEr2LwOcFhFl1qZ4zTv9_VL-4r391iFbBUROQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3ogltGS9D8Kn5KQ3AiJ0YJ3x9pxx0EOiBIEeSK7-IfQ&oe=6A3EA781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Fb1Hxel2MQ7kNvwGOqh5j&_nc_oc=AdpIm2PrOghf1eQYUtqfdTvFUJS8VCxF8DDNRtn0ls99SQK1NRxiw68Z6sU4E8LfHk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5pBWocDcRNEedvrGcb2fC9MSwwcOE17OdupWGdSApWA&oe=6A3E9BD9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
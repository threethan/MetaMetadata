cyIQ7kNvwEVGrAc&_nc_oc=Adr2xTOyKERMg8v-DxgQeIxMWscxgPpOSIsEO7PUU-OATS6vQ3lMNckXGQCSw9d3FMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ka3dFpI4A92cU_FfAroPMp89NVFeMy445vhqWZ70WJw&oe=69DB9C91"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk56QDTlORUQ7kNvwFfno8L&_nc_oc=Adounzy9U5tJhjUeDznisoLtGS_lsx58uu23rQ_4D0tyGLLoQ6xYJdfxSDH1v3dRKmg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_ToZMaTvdzxGndZUpM98yCGTLYhyOfM2rd82ZvnQrEw&oe=69DB9B96"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xHU6yQktekQ7kNvwEjo8Bm&_nc_oc=AdqFd4PPEzg70q4V4ByuYt4aHq_PHnnl3vuA9bCxdBVcT2vnHsbfQ-tcJq_0gol2by4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XKMdmV9VTeezDIwr3F09JEqYWnZ4rYThKyzDugeJNsQ&oe=69DB881C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJVmyjKTGEsQ7kNvwHpInNg&_nc_oc=AdqhwqeidVsGvTd4-FbJpsRsUQxSuf0evIr_lnTo-U0kr9rvbEUyilt1aBIuWNebAi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tNfDQvvD_zpvc37ZJlfGxwTZiS9nY05zxaE0GxSkvVw&oe=69DB8EC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ds6bHRtqHS8Q7kNvwH13rxE&_nc_oc=AdqjkIdG3o4LQC4_9Ww59RKZCfda1kkkNCzqDvTqEvs9U8seXFGWPLeQBBzpbXOUAYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t9LgVFwMcpw6nXutpG8n5B9Tm8YDLZhorzz_q5VkEbA&oe=69DB8319"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
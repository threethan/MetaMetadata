w_UQ7kNvwE1yCOE&_nc_oc=AdqfvfYZ2X0D7AcUfX_XCZoR-gNaMZ8Gp1AmnFodom3stxpvCEKMFuw_w2v0nhVR1g0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69kSto2HYFEOw4GMoF0DDtQO4_SOzUQjDattu1389OjA&oe=6A008691"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rp4eKEGSpwQ7kNvwEiQjLx&_nc_oc=AdoV-ULGOZm_MWgBKTG2Mq2pruCkK6vg4XcP2i9iUNleW80KaR7qLP57Y9HcNT1FJwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tT86mqVxesrOuGh_mdiiEvWK8mwpqRHQmGfZlmTAx_Q&oe=6A008596"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c5pG7x3M7MQ7kNvwH2zh9L&_nc_oc=AdoT9oS31CdafPicjl2M2pXbN31NG40whSollwPFpABNZOaNAma-_BHUejJ4fiNTQ_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X2wUHJlqWq1jh2xhxu2FVePSG6zfM57UaDP4Qi0Bh-Q&oe=6A00721C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImGZDwBasaoQ7kNvwGG-opN&_nc_oc=AdqF4jpAegw_2OkuuQeR2wjf4dsK_V0AApujmLqnh95epCPGas7CSyXnlhfHSq_6KOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67szEYf165GKJr_8dtY-LFMuDe8frrXJIOdVNrZ8R23Q&oe=6A0078C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg-h2LMw7w8Q7kNvwFzCHdW&_nc_oc=AdpF5xH9tXrIqI1DRJBkuS0lLfwuBGAjXIC_Lh0gg9SYqeh3_O88bqDq6G4DhhhkOyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qPPEWYs00OAdLUkrmCubyQtxMNFBGnxBIRr10DgWupw&oe=6A00A559"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
j8sQ7kNvwE9a9nL&_nc_oc=Adr6dhRy_Vlo1Yfns2dRz7ccRRmT4ixr9dddYjFVfqSy2hkpRj1A8Yyfyz4KFDk0-HU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIv53Z9SkjRQI7HY676_5x4IEiL9RlyYx0dA0yrpYiow&oe=6AEF5E51"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfO29QEjS58Q7kNvwEOTJ1u&_nc_oc=AdoZtZjzxRXHz1f53F_yeyphyDAJeOf8LY5E850SjQh4cORelFbc04dhSAjDBsx55Eo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1Ei1qm1ydtlSK3eVyuReYgFslt0clFE_1Z8TpHmSQAw&oe=6AEF5D56"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBWvbKiMiBYQ7kNvwG415Qy&_nc_oc=AdotiXhm06OwNp_uib_xtBcSwevvfr4SalY0ZMr-s2rV5OSm6JnSx75l3SqtRp_eEPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIlSxs0lcEIIG-4Panj8nankJ1r7FpZodJnpmpQV3l4Q&oe=6AEF49DC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xrm2PiEk5MQ7kNvwFlxP8o&_nc_oc=AdoJ39esm0iNeMiECFPtaLh51QD5rpLngXvucik99F5PLvs39zc4L1VznjnLgx01CR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIRNV1A0CP01jcAhBkBEMD67uOAZ9aSl6s_t1XeIvEEw&oe=6AEF5081"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRJhwy86MH0Q7kNvwF17ulB&_nc_oc=AdpTx0hdoQi-0smQDJufl9LaCD5Of1WAeGp7wECwicq5tR2NompZZR1TGrEIuD8K1po&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoGSH6HNgJTHZ4QEpPgBVThG_RPBr7TcOBxgbTodA-Tw&oe=6AEF44D9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
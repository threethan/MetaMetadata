j8sQ7kNvwGmIDjZ&_nc_oc=AdqVmGSCis0zb6saturdcmLp3j8f6MMxmnj6mNEQPD7XczyQTmUy21jIlQ0VfT-isxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdqFnyhxippSs4UtAQ9K2sFyRauvOzElQ0UDPoQn67zg&oe=6AF20151"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfO29QEjS58Q7kNvwF7vDMS&_nc_oc=Adq1oX8boC5I4wcA9269GXjV-25EhlRS5tq3yqnbAD-tkeSIciL2Zt39Ww5Jc7qDG1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXSrwp1Ytl2GeJdiG-gO7bDvyKgt8lXbd1Y2-LPDWKQA&oe=6AF20056"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqyqlWaeBM0Q7kNvwFonOJ3&_nc_oc=AdqxyiuHHfMm7CEsIbRqaQiEcyYTRRIj93Qres2lQ4-DjWuHLzGDiGmcpbQchspR6e4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpbay9m2b8WBF6-qYHdf1OfhZ1NriGvTD0wDHEJT7JYA&oe=6AF1ECDC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xrm2PiEk5MQ7kNvwE_MRAk&_nc_oc=AdrK8QI7_E1bDbCpMFaziC9BCE5Eh-bQEQX3thE_VTFGdepOS4ea71gFaL6l7vtZCrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSueZk6pJz55dy8rqkNIN_qmkBByGzrr26le7Bf7-Jdhg&oe=6AF1F381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRJhwy86MH0Q7kNvwEmlI2G&_nc_oc=Adr59A27t6XjXjQCYCaooRSaK9CCjnFdt0RF7EyfByemYGBJSMkcZJ50agIh9lOgDy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlZ8OQPcUiCHWrwCxYWhlOdmTAVVgA_yEQPwL9LodJdQ&oe=6AF1E7D9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
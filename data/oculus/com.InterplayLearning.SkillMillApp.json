480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1Xia98jAIoQ7kNvwGN079c&_nc_oc=Adl_o_6eIOTSALq_1VY87VZ13qa1G8MQ4_1hwq7iUdMsmziRq8eCYK5-SD9EN-1r8pc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMl6BMUhJ5iiJDAzmFWZ19sec0bHQFwXTbOpWr9vrv4A&oe=69B56016"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZ0NTzz8ukkQ7kNvwEaNzmJ&_nc_oc=Adn0ztU8-CoUGcwGjqDm9FbpRNisOfJ_JLXdLt_6ffNCwU4kKKBl7aYViiNKPwkUoZk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp_qydQfpOBxpd8ubpHBh9uNk-ZK7JCvEe4wr-W6f45w&oe=69B54C9C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etgIX1i7JsQQ7kNvwGA7sRq&_nc_oc=Adkw8gqvhDX8XJtKc4PMaF6GusVpKySewtgRTMvD0uM0UmnfnZ55IFvhtiBQNXLsR4g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx22JT2CIzNa92PAZDecMS5bTKZc04ZYoY1FFNuZLZB0g&oe=69B55341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aPJ-D7GpBAkQ7kNvwEOwVoO&_nc_oc=AdmHyjVJqnkScnn3Gpze8PmvwL5AKr4gxlvJsnRsOcmS0bYYvk0TbyitQ5b_DWlVSIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeetPMmZ_vUyj6iIeQ3F7TduggdSaugipS20rJSIkDCw&oe=69B54799"}, "display_name": "Interplay Learning SkillMill", "keywords": [], "long_description": "SkillMill is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the SkillMill course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nSKILLMILL - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tra
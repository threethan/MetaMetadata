JW0Q7kNvwFvmfSv&_nc_oc=Ado78j4ud96i85PtR0EPD7Dus93JIKoyqNAFs0Iw_XBnwSXr7twZ7QKHNP__ULuOolc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42XIQvRL5Q-y_rww_b7aTX3RJIQ2wpmbjA35XoXX03LA&oe=69FC9211"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa8nP9XVPRAQ7kNvwECJb1x&_nc_oc=AdoV-wGmsyBTdcZ0l9Ziu_SIeiJGvztTosmHgR7HXtSJrLXYZdMi3Mr0UiNuJfDoGyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4maITN1HoGpXwxdhuAB6skTJkkp-e-wooW59DYtROVRQ&oe=69FC9116"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51zbcJODvCMQ7kNvwHWUD1S&_nc_oc=Adoc98CGQ0Svwyb0sSI4kNTJYYc7Gneyg2LxkHznO60bQphFNpQBb77Qu995JOb6CBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E29cGqshMPc9w9rHUUtdFs9L5IWLwXF5Gf7saAgm64Q&oe=69FC7D9C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5yaEBxSmdoQ7kNvwEd5Nfk&_nc_oc=Adr5DdIbqQ2gZRnsduzVaSnElbwru8psycFlG-Ky4P5uY0ULlPzIgeQ-6B978QDeYnY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HdKgUyFjVOQSROTy9mfJNEXtdkMdIND7tgYuGphBWxA&oe=69FC8441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1SQSSRe-uUQ7kNvwHFdra3&_nc_oc=AdrWvWokWUps6PlLNLaGQ1miAkkOMPkLM6_XObcfi97GxKMP2UzgYZDO_SFZjVsk57g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JMQy2MC-rKmXoo5zsLyyYdKHIn5Dp36EBF4B3t6RgXA&oe=69FCB0D9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mizh3xPu1y0Q7kNvwGP2JzS&_nc_oc=AdlWXSVhExNqAb7MABlqE9Un8NE8sfyz68MvJiPTZUL8t4yT3qGN53jV_GiBq5wGKrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8OWN3uvVq8dia-U2t-zrBO7NfZJGQ6AjUVw_r7E1AuA&oe=69BFEC16"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0l8GsB1vR4Q7kNvwEUgy0C&_nc_oc=AdnzPriu986FD1DWys8DPMcRDqDNkV-JbhgkNJwjBEMeUOGwJzx4pX7uao7-ZGfQRfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZPGZM5iOog0D-huk5vF_gzrXwL9d1n6Km02A6C2jQYA&oe=69BFD89C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9QYIQ4G_pUQ7kNvwFpmwd6&_nc_oc=AdkqA_R5661ySReURW9YaAK-D15dRptB2NUko0l1tfcmRKzV63o5pnETM3dhxI2oI1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8f8o5pu9KV-HN2nP5UVYvK_Rb2N0K5itSeRFG2vDWwQ&oe=69BFDF41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beOiCqGztkoQ7kNvwFqBgbT&_nc_oc=Admojfk4H---3zYEE3DUUMEkwTyCkHUVvlxRNPhfY8KpQwPvqmy9PngH4sDaqnch1VA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzP2SWY84C5NtISqqHiUFBkBPgTU4tlq7R5nLmMXNRlbg&oe=69BFD399"}, "display_name": "Interplay Learning SkillMill", "keywords": [], "long_description": "SkillMill is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the SkillMill course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nSKILLMILL - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tra
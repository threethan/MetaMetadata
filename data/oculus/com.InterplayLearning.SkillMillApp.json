JW0Q7kNvwFTcdZc&_nc_oc=AdpSxAjsd48W4hSo4rKloo5oFgeiQzses0Ja-cdteR8t8b0UVDTEBPEki1SrA1pC-T4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5So7Ix4NxNQQ4Y34fEmX5cZlSKejSkpCqVGxUVZAvXUA&oe=69F9EF11"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pa8nP9XVPRAQ7kNvwFURyVl&_nc_oc=AdrPXndo5xxvfygTu8JDxyXEZhIwmziTXVe8au5gl_yn21otqI4cGt74uppC6Xt3Gt0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z9e8AvGDpVcgFt4safnBWykaVlAv4BVLsNLR379kV7g&oe=69F9EE16"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emcdrDpHcPoQ7kNvwEsXiU9&_nc_oc=Adq675tp_GbMzlF7XXgTP4wLL1HfurVwIF4nfoKCkJIP1ZL_jethl-Bf5BNIN5qd2oY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TYETpn2-JjxVktng4K9Tv1lEPjTrWI8q58WacSRYBaw&oe=69FA12DC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5yaEBxSmdoQ7kNvwGNLo8V&_nc_oc=AdpD74SJgNfKl70W0NE6U-jWNaEkDDVaZZGDqDHBP34kPvEzp_JasPTlVOWVrawUqpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J8HSHoAY5-FI0tgkyZi36ouIkpW7gObVN_qinVw9KHw&oe=69F9E141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1SQSSRe-uUQ7kNvwFJKODz&_nc_oc=AdoHm5E2jgeacol3ZE-d9b-pBA5GRYfX3ln4chQuypsFyyiL59EJtu7llbGL3MQnjxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68cWh_4eRlEjA5j1CQVs1dJh2rR7LlnOltp9GNaYGGig&oe=69FA0DD9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
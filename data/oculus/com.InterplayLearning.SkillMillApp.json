9CwQ7kNvwFxXPVV&_nc_oc=Adpzo7E30BlvQxUrX8WDWEtKy2NQ4eAI-ftFAHBsdXYLMUMsKMgYZC700hytnY9II8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALv_slKPx0XA7uUOc8LC6NWewaiC-IszXM6jNvb0MX9g&oe=6A578991"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYBv3EaRm8MQ7kNvwF4bkU4&_nc_oc=AdqFfJxXcgMjYsZRRnlec5QLlcBdxeO3G_N42IyQ8AD4vh6FLjD8DVZqwTiikVJGHK4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTf1-Iuxptid84Xb_PKDalosFOrDcL_7YxW0FZovcRaw&oe=6A578896"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFMtVw8j2PcQ7kNvwGbBiEm&_nc_oc=AdrfUtjic8WoaH_5NKF4z44Ki9oI1PrFtdwKzK6wQLbFAMaHh_5iCdZO4fdvbCid_dM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2IIHXFsaNS0eNTw0rIPIAPkbIub4EQRw9TSDvui33mA&oe=6A57751C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPPbmuo84GYQ7kNvwFNoElt&_nc_oc=AdrEHB3jzwSd1Tf10rFonwA0qDCy7AFSKanJ2TU1Lu_p88EgmOKoEmRln79mzPDyJL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAJYbNbz-CAGb2pUXovLoTZMRlDOn2hodyQjygh6eEiw&oe=6A577BC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqfpah-91oUQ7kNvwGeo-vr&_nc_oc=AdpdfnlZiZaqurxaNdxBgRp5Szfq8YT7uP9p9Eku--aVmClV7M2fqciYOOFDzXCFoeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5pTyO6G1o3PVws2dokOgRaomR5WDdZgJsjZEZLsigUA&oe=6A577019"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
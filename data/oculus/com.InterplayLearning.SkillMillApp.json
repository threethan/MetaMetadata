mSQQ7kNvwEXIaTI&_nc_oc=Adrz6GbMohCgHl4nzZDxjFEfb51jq6O2DwAOsVqYQLYmdDU0mtPXBRmI0T2uZ9tiyGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4fCG-nV6ozdKe5sO20gYPYGtTAsjxGMTvvjOX6_g7tg&oe=6AE0A591"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TE-7TEJy5VoQ7kNvwHjJwD5&_nc_oc=AdpH3h-NnHcgICYcPUbIEyzvT0tbPlhIkOlXxbHnfXV46JL7XeFQCkUO33uHS071L30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOP14ivTvdb1xDiV6RIFZrGoCSfNwsR9PYhV5lBsdjEmA&oe=6AE0A496"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cqv1eiE4EYQ7kNvwElmMdF&_nc_oc=AdrFee_7Dqntzdn70MUu8x4KHBfnCoIQoHDLhi_5p-pHzcO3GFxyfunIjs0eVDWEasY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpepYFr2Yn2Ccf1j4DrB2Y-RkUsr35PDaM0NLgeJzHNg&oe=6AE0C95C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvhivyWDPZMQ7kNvwEBogTY&_nc_oc=Adof3AS3p4TP3be8ftqUAB83RRPuQh0UgHskgeJokZuw9Vtf1nmrNaFXdP1e3pmjyI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh6c8Nqnf2HX8-wVYUdCR8iYSJki8o3Lsi1tinvvj19g&oe=6AE097C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU8y8Q2xqzUQ7kNvwFAMwOH&_nc_oc=AdpgKiYV8-1eOrvVNIvsmveI53b8BTArP5u-RiXJo3KnfLl_rPgBXRdiJ1jFrXzWxNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDoQ6KFQZyOY4DC00XzY9dRA-smkrtbsJyfUXzKkPgYQ&oe=6AE0C459"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
8sgQ7kNvwEBpsHd&_nc_oc=Adraof8hsmqWj3bg0p7FRyBEeS8JU8OQShGl_eRJzFtKZqW07EHwpguMzouSWpuVVhk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUBx2JF_8_w6ZWKojKwD030BAKd9CBfXHowpT9K6h8wg&oe=6A4FA091"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXBlDxVmKi8Q7kNvwExKZms&_nc_oc=AdptbMUjCOpgT0Kihmv53ny83Wu7IznQka0AdXMdza515snoTZlTehFKAlrTRmk4pqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5St07XNCqWhifHwaTS4eP24NlLJmPxd4ip_jXMQxRrA&oe=6A4F9F96"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CG7lmuEOZawQ7kNvwGfE5Jt&_nc_oc=AdpQrTW4QLmizTEWiMpGTmdQUBWP0NSS72ykgzV4ZmaXB4N2C1YAiud8aBw_1ASAL5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5_zPUS1rgrmCdpn9j9RiwAHfPd2v_PDEXEagqqMOXpQ&oe=6A4FC45C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wrXbmVi7QLMQ7kNvwG-Cn_M&_nc_oc=AdoNfkn8ITPD8G7a4NpVeBSqO8gxKyEFa8uY4T1PHYvYkBL1YGeYfIoMOifjRPUwURc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlpKRfrxewGEdDGsNwh_egNFYmDRiBXgbPSSxbi0D_Fw&oe=6A4F92C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BGrPXWNcnEQ7kNvwHrgKkx&_nc_oc=AdrwSu3V1fbwHTUC65M0MIyOXkfu86iexy6UtRH7Ua7sT6ttmyf_-_gx7vmNwm4mwn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh9mZNXbW-oIJoWuypdWqwH-vZTuzfnUBrhssyTTdtCg&oe=6A4FBF59"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
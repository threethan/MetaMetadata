_w8Q7kNvwFTfwrQ&_nc_oc=Adq5r1aaCP5w7cbcDjs3QPaTBMiHOTORZmEq7OAQ1Vcm6NUJPvapjzyDA_MJvrJTX1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ATSznSnzPKbE72MD-ufQeKK7K4z-KETxq73R0xR5obg&oe=6A3FCE91"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDrKuNoy_JAQ7kNvwEnDXjC&_nc_oc=AdrkdbAd1tkZMVCx6NFoTTM9pSGtPLEn_L6UxJSNG0XJeENIaX9MEncTD_LQqYR5hUU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96szC5DuVzZiM6843pBB0BsE6KLBDCPnXCSDrxpQSiWg&oe=6A3FCD96"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M9OkbGAtMQQ7kNvwHD4epL&_nc_oc=AdrT9OePhDAd3YoI_gj4l26FSKOjp8okUvjAwetVTQt5ABq_LU1EA9inNVX5nyt7iU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bqjlEaE0eRpSCgzNs8cWyZf_hhMYJs9NNHc2JbVazpA&oe=6A3FF25C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBecV-2HL2UQ7kNvwGzoTeS&_nc_oc=AdoDKM9LDP05M-n4oicvJTt8gVVSvm01ReZkShsXu_5R2FMmeXti2wGYXLtvI4pxyfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qtXOa03GojYPlYYdZHn0L5fGqSYkimVtoauJWFqLFFg&oe=6A3FC0C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Fb1Hxel2MQ7kNvwFM8jGr&_nc_oc=AdrNN32cjh2BbIax7_e6yzps6lFbevZpRi3KK4UEI6H43Qd13KmzscR4cI05AG6czvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K9cuAw_EHOFWYjd4OqHP0Y80NcFkFlBW7ftNg1iyhcQ&oe=6A3FED59"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
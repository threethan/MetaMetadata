BKkQ7kNvwEX7hdH&_nc_oc=Ado6zKG_B2jBFqNo8nlJZyWIACQT7uq7noRZHNwI8pBMtDH3XWbIOLuKdLHXzPhN8VI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsP6AG3jFMU4SwZgz-cnnfgE_Jw4Vq4BUXfwfKN3Fb4w&oe=6A7B2211"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H34P26HJgAQ7kNvwHcAjL5&_nc_oc=AdqkIhGOb6uwnj6LZr767tmMEhf-eMKhXm-vu9lIIxQV5TbJZ-RmGHIEJeG6cedbAEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESmF7G0Txt-ZoO6wSjzdP4wETiowc4-aVhzH2UNCEy_g&oe=6A7B2116"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uiML7ZVjMQQ7kNvwGaSYRU&_nc_oc=Adp9k6rDxW2ILZ_J2jSPjBREhnE5bZdzWBAtAIvoz7aSr0cSFZrE2FEuJ-dG1zX8NCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-wrhngLxjkEUF3cBd5PVy7qxwN8b6kJ_YMcte0mBn2Q&oe=6A7B0D9C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIDEflF5Y8YQ7kNvwEvUkaF&_nc_oc=AdrK6wnwsih-vFjKs3x3sJ9mx3bbnGHYOri_YsYRimtKt44TFgdHPKuXKos7edzyP1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0lyTV3sRzdzdB-VspUWttahRsAfPe3v2OcqexYSODxg&oe=6A7B1441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsLXOmAf79UQ7kNvwEYulWl&_nc_oc=AdoGiR84_a8XZndmoxzhUwuc3VGCLbrtLp113EDvIWxYig6eSfpy6c0iPrzcM65q9yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj7f-T4U3B0Fq5GvoG1KnbIEkoYH3uTgJUvL6SX1gDsg&oe=6A7B0899"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
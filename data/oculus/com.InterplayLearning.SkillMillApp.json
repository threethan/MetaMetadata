rGwQ7kNvwGqvw_S&_nc_oc=AdoiE9xbr9Ge5BW1MS6kCf_DJ57NGP5VdHcacVrxNZ8f9EE-RVfa4oG52K9Ff0F8_VY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwK6pVJynFpwBVgrEOqJesN9sfuRXd8qxWZW1gQJ0mTSA&oe=69D11091"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddrWRM1tocgQ7kNvwH5oDzh&_nc_oc=AdqQ_Fh8Teb_nT8dK1FFhSilOSSkmeVFgRuuo4uXwtIecnZCPPOdZ0x3GeeNbp3DZVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2U-jyr3vUxMKTGhj-P07gM_LBQNkwpAFxjTngXP56Rg&oe=69D10F96"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bV95XEh0aVYQ7kNvwHh3BfW&_nc_oc=Ado7B7ego0JXsIruspCHmnFopKWVaM6o41zpX_-jKLbK2-_YMowwzz7vz9qI54uYmek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwun59v17wLJc-UdN6dzsqeVNPULk8NZ4tyNOL9ePsmEg&oe=69D0FC1C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNH4UuolHIoQ7kNvwHn0Eo3&_nc_oc=AdrvZ2Q9xacco8pAo1FI6fLTUDXNyeIsjjQZ3aQav0C72pTu7C9IeXTTSbQIVofu99o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzcws4qYMyhb-IWLGTV2F--sPTHyIJKnkF5sDhnse2xBQ&oe=69D102C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfKVOV0YedsQ7kNvwGFdTUC&_nc_oc=AdpDEW6CvN0bx0ya1lcWKNG5w8veJZosGfq5TAy1MDe9fzS3Nn-zKr9MMETOyPGq35g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHQR6Emyk6Kxj5UOSKHxhhV6mYdTZY6LI-BD21I84Www&oe=69D0F719"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
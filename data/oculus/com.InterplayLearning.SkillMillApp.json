_g0Q7kNvwHjeu3E&_nc_oc=Adr6r5Vtp6crqLFpFQY0ejO4qLFRGnWFRwDsAnNG452wGCSnQ1VuWxNbfCf1CLQkONs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkJCYmWOvkKLqTtsF2A3f_7EU4S_WQ0gWRD9QmwT0kJA&oe=6A9EBA91"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9LuSwYv5r8Q7kNvwHPI-q0&_nc_oc=AdriJUnUzAxcyEthbGjjeBfVuBnCsINrIRGGlVYhL_S2QWv1BTEGUp-HcAkP4bkZN-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4yBXVIKQG29H3lJwv2qmE8b7apqVgDz_lHRWZYa4jYQ&oe=6A9EB996"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3a3gK52trZEQ7kNvwELBQPz&_nc_oc=Adr7GMtylWgtcMuOfAKooXRN6xhxCL8onQK24ssN3fYII_YcDrJpZ6eoxF3SiyA9b6g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFyogdKpiBmdGaNBFStcVM4rWAHiuohO93ZFTZ-ETPrw&oe=6A9EDE5C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPZ_iPyoUhIQ7kNvwEn_R3E&_nc_oc=Ado0jVp0nYfTMkROf0kaN3x43kdPMWy5-X-MezFJoT2ip39_7cKP17atu5CyxzuftQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxsOlk14ukCd1EoZbBAnamqdYw3cQDRiPHi4uWWayI8Q&oe=6A9EACC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ros0lv5u5FgQ7kNvwGwc_xL&_nc_oc=AdptVwsJ7uZPoXpb7c0o1PNunI4v_65Jzx85t1kOThJzi_bIxAGmhCCm1nbvq92DJrk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPGjOAIzmRL5LkHoUUebU7wT1kqFWNbAXpXjz3xPpVzw&oe=6A9ED959"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
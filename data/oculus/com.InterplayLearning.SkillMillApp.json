w_UQ7kNvwEu6GgA&_nc_oc=AdrwipT5EomrNZBmMnuuujhAhqldugCzo5fn7SZ47lRY2nf2TtwaeN6tJSy4SPdeF_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hw55rK86HHQn6AbmeN-Vt7AmZuZYy5ysTbnTEW1VF7w&oe=69FF3511"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rp4eKEGSpwQ7kNvwHz9dM7&_nc_oc=AdoI75iQ6MTgOjXGCvTfVJtPM_gcq6UajT__mxS6FOXfxeXoa_8HwtVuNOees7GrXu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47BIOJWPZqs3VQLnB01Gs2OR-cYEYd3C-gx2cMXCu6NQ&oe=69FF3416"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51zbcJODvCMQ7kNvwGntD4Z&_nc_oc=AdoTGor5G2vcDQDfXuq5MF-4jm8jp_fr5vLPlIi3Y7yMiyR1SEl32NHxnpTfoKeWTGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af498f9ZbharlLD3Tb3O2ypDtpuG2BqaiY5id1-lqKdUCA&oe=69FF209C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImGZDwBasaoQ7kNvwGp7nkz&_nc_oc=AdqC9mX_mV01MShf9v32T8SgpHB1XttZfAf-HkxUBG19g6O5bPyoGmd2gKJGS0eGC-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WiGYzUgzXLTrVOGlaBh-J4zODxgnzIQ6hMsH-2fAvGg&oe=69FF2741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bg-h2LMw7w8Q7kNvwE81tfq&_nc_oc=AdovDVPt5pUwVmqhvalQvVXk_dJioOZAPzBquo3nSXYoCqQS4Lt-XuiZDrx4O5yb2r0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qCgTRB0IFdD0dU9lKffNFDN6xpKtAZvn273A_7OQp_A&oe=69FF53D9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
QZkQ7kNvwEpD3xP&_nc_oc=Adq0UbskXI39SJyMI_zJaAcIQdLYLa9y0CMw1uaF0XKTVWzBVB30wDYtZL2QRmFSqMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Jj44z45p2ZFPzh7Z-2bAAnuwS29nMeUWwqPIaLQJfKA&oe=69D8F991"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5a0ntz2gZDMQ7kNvwGsz-Em&_nc_oc=AdqismiO75SdlVe6e06jmtXKl_-sUT1j8Iu3Y3Od6wXt2tIXZtUDj1B-EAA-0OQj4VA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gNheOmtfozpq3JOosAblWM63IIvZo5x3lImYBCXskkw&oe=69D8F896"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xHU6yQktekQ7kNvwH73jtp&_nc_oc=Adp9V9enY7GoDnyQlywaDrZSX1bnOBpBMQPZgJGPXCHiXfAjAytSOosxKIg6r04fOtA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PtOwzhFzj-RrkIL3whqnH7ohk8CWRKw8Obc-0auwqzQ&oe=69D8E51C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoxpUHf4Nk4Q7kNvwHtldLt&_nc_oc=Adq2OFZnE3q_4Dz7kQ1zz5mwzfo8Mq6vmm9oYDOPMrwCfaspsVxeIjr5g81dKSCLs2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RdHBg7GFMojSAvY0Q4xoEDcKV3jdqYzgGx9nXH3jy8Q&oe=69D8EBC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XvUQO6U0KwQ7kNvwE_EjtC&_nc_oc=AdohbHEQFMChK_MsemTjpv9pimUPrUxSOaDz_GPs9Qyc1dWjXAnFZQ4ipIyE4zUDjtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GJnixyauHnCpe8os87MJl_ynt3yoDFNPJV5zdcPL_6A&oe=69D8E019"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
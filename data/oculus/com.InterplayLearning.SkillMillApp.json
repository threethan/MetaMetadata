KGUQ7kNvwGYcjwA&_nc_oc=Adp4Tbi2s1_7nc0mnOCM_tuAG-rUIJ8RIEkt6V9sJT_l11b56GVc1gAc13kKyJntb4c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oH4HzoHcg_DsLQuTMdYOwpDDxaFGlOrzfC1imXkK1MA&oe=6A2C0811"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpamdd8nhUwQ7kNvwG1DRqn&_nc_oc=Adoi0eisyPh_zH515MNsxbW5rWfezoyO5S62F1mhKcFGjSgvySilPmg8sXdc1-Ojhlk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jpPKXFTsH_lErbVqvL_FFTvdVo6hWLCgd3A3bL74vjA&oe=6A2C0716"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zka5tzXwiiwQ7kNvwENZ0rn&_nc_oc=Adob0_fkwMVjV1qjenPYjFJTRnUcH6waklAM-AjJHW19GsODsFgHUJ-p1MYLY6v38_g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I8f5c5C3FpQGlyVQRkovpKzSrGEV3ITE-TFhWg7OOUQ&oe=6A2C2BDC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sTkGZ_qM-UQ7kNvwE50f-o&_nc_oc=AdqQzrkq7fSQ4mxMSv9-hJH8GVEg1iIsPZI53rfaO7LiFNDCiGC7Ist5FGZ5aDQ05lE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cOuCUTDCxwTOO_HaNk8-_5fTSktRrbQgKRzDqayAh0w&oe=6A2C3281"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuOAFKl4ZMwQ7kNvwGJnCzX&_nc_oc=AdolSBevIEPjifVFBfsu2-xlXAwQTTvp2CHx1GxlrNtN2L_M-g3DuV6H7ujWRFo25sk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88RGHB35K55xUsTIB1V8_hXNtdne8vRk6pdlb_v02ODw&oe=6A2C26D9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
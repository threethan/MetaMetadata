od0Q7kNvwFBkYW6&_nc_oc=AdrKlKu-kcl_Nar6W3CK2kIbruw7SXfyEKTPW-aek_kziHjD3wje9GnEnaf4cVZUfdM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJYtnjPTVi3GC7GGB8-cIMD4gn_aialJTH8szYUAYCIg&oe=69CD1C11"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPSyMjZENPUQ7kNvwHK77Jv&_nc_oc=AdoaNBUE1ReUtz6G2dWOd6tQGQYt-u-rfAx0PKRRQUMya-qMEwjO8TeUskoUWBZtYxU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0dVZjw9ftgLMQW68CPQjTNJok9zzBEO4K4ccoFzmTIw&oe=69CD1B16"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owhsIAT2wNEQ7kNvwFUSHE9&_nc_oc=AdqRjd0WdEeOL4mGKBlqEc8eu_8dFZ8rS0faawqoahE59XEtuSK_3HwQ19qbsYLoaQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzrls4je1BjlZn_AKQtGwDNKroLuMeW6yI6vzyD8bR6fg&oe=69CD079C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HE2irUXhmN8Q7kNvwF08CJM&_nc_oc=AdrnigjuCtEdidD3DYnDPZabX25iRkN_fwL2BqG_8q6DJISbkcjqIZu4NAk23YV0xWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyJdy58gUerQpLGdLb8oF2nuDfpmovMufDfYx7rC5_vA&oe=69CD0E41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1m1wlzGiI0Q7kNvwG4_kz5&_nc_oc=Ado5to_KncBFZhSS_Xawp7Obutn6jWROP5dETLtorR3jLic-dmwbPJw1upeGIyiMIpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHJfzqIUO69nf9b7edWeD68ovo70aU9ASVe89W0hSUwA&oe=69CD0299"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
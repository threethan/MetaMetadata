_g0Q7kNvwF0ka_q&_nc_oc=AdpyS8p6DPb5TsvSiLZ8H4sE8Afz8mUrylznibdWYmePucoZiPLd-WXaVk7evbk64HI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJHbNeuhpqqqY3ApoqdMhgCyt_cNc7xzrWkQV8P0XETA&oe=6A9C1791"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9LuSwYv5r8Q7kNvwGLJxha&_nc_oc=AdrZZlLkC10O1drDoX6SGBHzbCdYcVy3imDkawB708PyKpKjboXiIf4JPhsNTLnAdBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwjCFFg_lEjdpPhs7rHctCnR3jcXLatno0zR2Pof1iVQ&oe=6A9C1696"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhI0vdv5BOwQ7kNvwFMbnOr&_nc_oc=AdpRxxbWJB1kRjoDE15jJJVqDRMs6r484nY3Ggli_U_9MulfjfuHHxsJgGl0-RcQFXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF_R2w7yPfPhzyCdFj6SFtzydzNYFH-XgTNpD11EA1bQ&oe=6A9C3B5C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPZ_iPyoUhIQ7kNvwGVIBTI&_nc_oc=Adqpc0YLLeOFCMVJvrR61YYQ-OqNe81nxMwIe9s-9TrKNm0ZR9BeZxnXxWoYvvS_PV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE8cCkD8pS_hCunYdNLHb-4TBO1srNgfRHXYWmb0_tbw&oe=6A9C4201"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ros0lv5u5FgQ7kNvwEACU91&_nc_oc=AdqhzUc3O1YeQBNkvlDkt_4eNjZwQ--A0WQOURULFAoGKKRHUrkwh2yuQZ4FZWBL3Yk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLytnCk0L7zGMbBW3uPJxwJvReazvvPikFcSQxE1gk3_Q&oe=6A9C3659"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
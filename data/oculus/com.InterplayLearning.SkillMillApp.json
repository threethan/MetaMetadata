KGUQ7kNvwEOJo-u&_nc_oc=AdpzzRPnLMP-EEnMxw3Y1Bs0e-VRK0BVFzkimEEF6FnJ_8uOZxLzn46o4cIqprTOpVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sS8HcrlTPlNwcFB5Llk0PGvjH1oxrl3EIXQPGdn4Waw&oe=6A2AB691"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpamdd8nhUwQ7kNvwHD2WW8&_nc_oc=Adpkl55ua5Z_Zrd3IYjtcZfAU-n354NjIpvFSWYIgBwq2sGyd1PLEfVuSnYhcbkgI1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MHjsXEFJdkYY8z36F3XKN4scF7yz4ZWbO8QfTrv8rKg&oe=6A2AB596"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9fXUr-UYbYQ7kNvwFfPLPd&_nc_oc=AdoqpOj4LDNruit7EpoZvHeQYazhwNx5lJsNXegu2rYeuM1HbXqhsc8WpEZbi9HdjU4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_upHenQTsRdCZjimJ6q32BBkcwduT6Mo2ehRn3rN4tCw&oe=6A2ADA5C"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sTkGZ_qM-UQ7kNvwGcn5wQ&_nc_oc=AdqkP3F8pQJmp70wou3C03qxPggA8VBViPVIxYJ9iZwDQZjJ8QH2PRzN_4pOgns1TX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DPvfvxzqil2e_ocBha08nMh_oRdXlYOWMExEo2dZT7w&oe=6A2AE101"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuOAFKl4ZMwQ7kNvwFchjQH&_nc_oc=AdqP-XFgZSrKPvybAhNb9zfpTN7a-x-CNtOkPaLU1URkmlllUMopEmCMvYvIud6K3Yk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8L7DpvxEHn2qGtT6M6AKgRb5fK5Penqzn8okKRWZPJUg&oe=6A2AD559"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
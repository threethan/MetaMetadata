fZ8Q7kNvwEHWKzR&_nc_oc=AdqwOf5H-G82BMzM4E7BxO_GsZqTig6yxvc3h5lUmf_P9h3PmV_ssmKdn24kkTwkOyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS30thTHxG2RlzIn7j9dH9o-ZG4IzESEXR10xNLlazxg&oe=6ACF8211"}, {"file_name": "screenshot3.png", "id": "769159627030977", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982480_769159630364310_7773720489419551084_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yRHypZSZogQ7kNvwGGRDPA&_nc_oc=AdofKRoiHfI6ReytQkDRVqP29jgWvQnFfOpFjTtpFr0njvQD0Ak3ZYWzqCCUZ4vBoEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyl1mrVfq05rP1UfmIYNQZSgT4AOXq94-mEffWLTWdpw&oe=6ACFB956"}, {"file_name": "screenshot1.png", "id": "187933919745441", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974595_187933923078774_2441236422636118465_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2GPhUv9s8MQ7kNvwFLJex9&_nc_oc=AdotyyEST6LdVWheAocG9k0ZzEnxkK5vmlRBD-_9cnosupJ0oyFpFubA_s225ZMYKtU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpkaxlflYcMAH5K3rbltKfdH9h9M2Eu41uXmWbZIigOg&oe=6ACFA5DC"}, {"file_name": "screenshot2.png", "id": "212966537233280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036685_212966540566613_176284310021998423_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thVTf2aTa5UQ7kNvwE_ik0U&_nc_oc=Adr8AHuEX76x97izmJ4AeQosVlbuG_SSc5ZZ4SOb7rzcGssjeSt6niU2JML2X4XxphA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNQwhqCuiFvZhPX7oZltoRnMEBAp3LXVtxamYWz365qg&oe=6ACFAC81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9.png", "id": "423075349015533", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572924_423075352348866_6128993225541765755_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpBZW-woyWwQ7kNvwEh9G0S&_nc_oc=AdqZ5V_kYowldRCdmrswR0guZZWtE_PmZgzc2VeNdMHGPBglO8hnqwXemxze_mJRWDw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4NlbjGzFmjNcj7n2hZ9tputJCymm-vzoScUZJdL5Q0Q&oe=6ACFA0D9"}, "display_name": "Interplay Learning", "keywords": [], "long_description": "Interplay Learning is an online, on-demand learning experience platform delivering a growing catalog of courses for the skilled trades industry. Get the training you need to reach that next level in HVAC, Solar, Plumbing, Electrical, and Facility Maintenance. Plus, our catalog keeps growing. You\u2019ll find hundreds of hours of training including video and scenario-based exercises across different equipment types. Hone your skills and be ready for whatever the real world throws at you.\n\nWhether you\u2019re new on the job or a more seasoned pro looking to advance, the Interplay Learning course catalog can help you be the kind of tech you want to be \u2013 a great one.\n\nINTERPLAY LEARNING - AN ONLINE, ON-DEMAND SKILLED TRADES CATALOG\nA growing catalog of field-like training courses focused on helping tradesmen upskill through:\nInteractive, 3D based simulations to deliver field-like training\nExpert-led video courses drive understanding\nKnowledge checks throughout engage users and reinforce lessons\n", "short_description": "Prepare the next generation of skilled workers with SkillMill, the world's leading skilled trades training platform. VR training simulations develop on-the-job skills quickly and efficiently, building better careers and better lives for the essential skilled trades."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.interplaylearning.com/privacy", "developer_terms_of_service_url": "https://www.interplaylearning.com/terms-of-use", "publisher_name": "Interplay Learning Inc", "support_website_url": "https://www.interplaylearning.com/contact", "website_url": "https://www.interplaylearning.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_t
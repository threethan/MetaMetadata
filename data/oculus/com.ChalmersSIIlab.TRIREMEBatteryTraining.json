&oh=00_AQBJFt87D0CpPZ4_tXaIxMEBwGl9_QPn33i4H_HQmjYegw&oe=6A5E2868"}, {"file_name": "6.png", "id": "2085249836206098", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_2085249839539431_5359114296865505374_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dmBFvdUuWkQ7kNvwG5E38Z&_nc_oc=AdqfYkLzLo53ylxr89sK5cYbf14uUMWoZmfrdELG-SwjZ86c9zChhs9AT1TqJy5k_g4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3QroKJavDRvLjWrKE9UqMZ0NawGpHeXbr6kKYR0Csng&oe=6A5E2C4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "1277237081159095", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507849536_1277237084492428_5212112501514203523_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YYO6iKq1RsQ7kNvwFB_LpY&_nc_oc=AdoTy8HaVvG80aYcBdnboo3YF3-sQjT2Vmma8idEozzuBTeintMLY6ltt4BQcOJINw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLxiVX62e0oP4_rEQEXR72Uv00l5C7syKerW27DFQYsQ&oe=6A5E1D96"}, "display_name": "TRIREME Battery Safety Training", "keywords": ["training", "manufacturing", "battery", "education", "safety"], "long_description": "Step into your first day on the factory floor with this educational VR experience.\nGuided by a unreliable narrator, you will learn by experiencing safety risks at first hand to build your confidence before entering a real production setting.\n\nDesigned for manufacturing onboarding, the game guides players through essential workplace hazards and personal protective equipment requirements in a battery assembly plant.\n\n\n\n\n\n**Acknowledgements:**\n\nThis VR educational game have been developed by reserchers at Chalmers Univerity for the TRIREME project: \u201cDigital & Green Skills Towards Future of the Mobility Ecosystem\u201d\n{968349532637384}\nFunded by the European Union. Views and opinions expressed are however those of the author(s) only and do not necessarily reflect those of the European Union or the European Education and Culture Executive Agency. Neither the European Union nor the granting authority can be held responsible for them.\n", "short_description": "Step into your first day on the factory floor with this educational VR experience.\nGuided by a unreliable narrator, you will learn by experiencing safety risks at first hand to build your confidence before entering a real production setting.\n\nDesigned for manufacturing onboarding, the game guides players through essential workplace hazards and personal protective equipment requirements in a battery assembly plant.\n\n"}]}, "developer_name": "Henrik S\u00f6derlund", "developer_privacy_policy_url": "https://github.com/Hensode/TRIREME_VR_Battery_Safety_Training/wiki/Privacy-Policy-%E2%80%90-Trireme-Battery-Safety-Training", "developer_terms_of_service_url": null, "publisher_name": "TRIREME Project", "support_website_url": null, "website_url": "https://project-trireme.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "971926782347331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823279_2075936459802824_107252933705877535_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyUaN7OZouMQ7kNvwFZIZSf&_nc_oc=AdpqdheZzYgyYifEFpD3zFBxZRbn9XywJkGMF7PVGUyRshFV8Mh3Jyiomr2gxvMrVCg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_
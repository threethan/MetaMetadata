7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abKjE4S1LTsQ7kNvwEy2TXq&_nc_oc=AdpykMxh28YPY4XTcLkL_yhO_e4fn_8jgx-ccaUvGm5LKlu4LwHE-Miy7aV4MJz7VRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7txNnKr96Esk1VD0K0HyhBFkssIETh1WAVk1APnzkqzg&oe=6A0738FD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WlYgzOtsnMQ7kNvwHM8jxx&_nc_oc=Adr1PEZtJOVo-yy6s8hzuaYEWHXp0YnHb26hrGbHQasRP_jcMhaHIjric-Ar490jvAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TlM371Tzyjvy7YWI6CcoDO4bNwj2rjFX6PLZpERH8pQ&oe=6A0736FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bdPDNl4J78Q7kNvwGWkjX9&_nc_oc=Adq6VWhNbG92T9DyQRbvlLu-xQdNrVWm6vo2KCVAEZzk6-CCiuSY6l5-XkA4fMX7G3o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PeOSW6ivzAA6VJQ7vST4-Gpeato1nm_WBhav9Z2Vupw&oe=6A072797"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzNX8kSchu0Q7kNvwGwBFF0&_nc_oc=Adr3hu_Di1-XjpckFrmXl2Ym0Im7V6i1f2_R14Lup5t2VHnDvxeu_VJ0oJrkGPL8_as&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vTrxH1Xjc703W940sQi0nL2VVpHWguEoAbF4is2KokA&oe=6A07168E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej8GEFwPrZkQ7kNvwFVQjHG&_nc_oc=AdoJXXrxY3ec6eS1ap4nFheQBoikTnpH-jJ7olJ_F-gstwY28Tp-dTkqTPiMbbtQToU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zbt2Ogr40MRUKJGjD4cSlENGoWG9AoKaFUFrw2yvvtA&oe=6A071477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irB6RzZPe8oQ7kNvwE8_qPO&_nc_oc=AdpiAuEAlKB6dYS60s2mEEGwb6XdSy3O72JZYft0Vsy_R9Db5D5Qh_IBs6QtVks_Rv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RLOKkteuQF2TZfcQI1hc5pWkLuxvjYbBfiJPXYHEjgQ&oe=6A0737FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qnf7rv3yM1wQ7kNvwH48Qr1&_nc_oc=AdqyUFSv0FgWRvgRmBEj6GUtKMs5riMEgnjMFXLsKFLaVN2AiiqIg26hTm4IychhLd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZlJ-U76QjmxZYvnBiJyDHpVfDPCt5RiAuEsU2-Ru38Q&oe=6AA6BE7D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anPVnJGOj-cQ7kNvwHtYL9J&_nc_oc=AdrghKOddp8DgutRomRH5z6x3iPm_7EklapI_zXDvHzWxzibazI9SGV3X8D-Ye2uM-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzyi_mhew2Ge-i0wFTwOkrvwJH8WqFNln3AvQsyB0Ucg&oe=6AA6BC7C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPWtV6CnwMgQ7kNvwFeBW2D&_nc_oc=AdrmvIBiLRub6qocStTyFRjtgqk4mq3OLBFUYjWKaujgSYJMM4DP7dJhPU5H_GN8pL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7NLgeoBhlEZrR3-dNPknxjp1X1ltbhFXuvBPEgWaEvg&oe=6AA6AD17"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GtMMJnFbuQQ7kNvwGu4UQs&_nc_oc=AdpwTuc1HXeRh_xEenunLJorUidgKCXNj5REedPELXpXwg2UXfPIx9wAt6FXljPD1e8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKn3z5skQcfSISiVpQ8e7QlsJoZ_5cMMLcvIKnxD_LFCw&oe=6AA69C0E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uX4Nk1QlqPsQ7kNvwGHsu3i&_nc_oc=AdoqZl_AnhGgK_pB9zbgJ1HC6gfsXxRv16DV-r6sxK0I8dQerSHHq_2dhQDLv8nn908&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQSA6TL3SGNujR55VK_G2RMzve_rKpy_wPagHFlCFxmA&oe=6AA699F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGB0wPmeaswQ7kNvwHpvaSH&_nc_oc=AdpbT93G4dxTbnKhyYI34qF4fedzR1tnLnjjaXV74b0c6hY7aOQWH-N5AsQyQ5O38xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF6jXNVvxEsq66r8LCl1CxAsI3FWUBKvXLOPe0XVhNug&oe=6AA6BD7B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
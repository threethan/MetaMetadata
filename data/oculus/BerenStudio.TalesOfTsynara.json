7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jkt9YlybjIUQ7kNvwE9lgyt&_nc_oc=Ado7qqBypzB1tEyWRxpjU3xuVMUOvtV6fff_qdOUa6pCuxUcL4v2hz7ysXc4iTKlLao&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUJjoh5X6qTSb28aBpjWIMarV4nVWMV8wlOSclpuJzzQ&oe=6A58F5FD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFdKlHgzufIQ7kNvwFPCG-b&_nc_oc=Adpw-ZjOI0_B2h0BHFKA8niDx1JC0ly79HJx70gfOzkWWTDWTO2Yi9hVPn9Bzt3XCHg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgQlVxXSB9goNYm-Y_K9AAiPSR-g0eYBnSWsHPgT9XdQ&oe=6A58F3FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwHs-mQGFa4Q7kNvwHaMtZq&_nc_oc=AdoMdo8AksohX6saE3ClEth5Sb2QCF52SdMQ86PknLYI8Vvkb-nrpkybWr7QJDjU488&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCatB96DvhpinPaEyRumWbDxSxSHiTmNFWO7ZSnfj2bUA&oe=6A58E497"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6PoWCvlY_cQ7kNvwGuMNaM&_nc_oc=Adogfa8axWM7P9aHLiSHxh-VaTqdWO_74d2LQ89lylVYtz6KYlZzUFZlq0j3e2MCTBg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAdpFnmzUMpyYjdFw9kk7eUnobpat7rtwQGe_Gm9OOww&oe=6A58D38E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMwjsYx5-EAQ7kNvwEFTxmc&_nc_oc=AdpLdbdxvIAbcmW_34Nwgjhm1Xzqu4CjuAFu00wUyFJQsZCDRUAaGIv6J6Hlhr--NSk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7XqoSBm7R-03fRQlG1H-wTihQBrlXZUbjsHoqrSfkFQ&oe=6A58D177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSuM617fP7wQ7kNvwFMpNyZ&_nc_oc=AdqcUVV65LANwDEkCW0IHVQaTB7ZoPFw3t5l0vqrrAVXeeGHLo4-1W2MKGn3QMfA2e4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTeMNzKSeyj7NcvV1u0qFG4L-oXwvsdpQQVLdpgZc6QQ&oe=6A58F4FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
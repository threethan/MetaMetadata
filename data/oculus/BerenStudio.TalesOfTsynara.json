7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH0BYuUdgzEQ7kNvwH31KYc&_nc_oc=AdpLX31s9GHLKGDJUAuMmcKo_rNIaaw6YCcYDbdYFixifZ9N8MOvEz_g3DaAhdk1yPg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVtDPAoBjGcbjKPPzkcRVvtFyCcZM9TBzCEdqNKCHSmw&oe=6AA026FD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Y9M8hddU7gQ7kNvwEHW20F&_nc_oc=Adok0L5TwVyJcW3lJ0_V2GxkE68S48DegLsYMIZKHYsT773SeqF-juPdLxu6sY_dtrM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPKc63cheCnCYSiSrckQr-40lupelkFjpA9eHM8O5rfA&oe=6AA024FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp9j8r-_DMwQ7kNvwHc2KMG&_nc_oc=AdpBYf2olBT190PLeYr5hGsrzDqrNTnenydSybVrYTGcilDpynpMWPhjh6ihI1tci6s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGHt2l-gHYtp54gn1rpa4ELtPy0G7H71mJO0MukmyFbA&oe=6AA01597"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dwg01Q8PVQQ7kNvwFLWFzN&_nc_oc=AdoUVtpIuKL8FOzB3JFD5YZCNn-xRaonxLh91gloJsIg9gAyX31-TbsFZTHBT-IQrvM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUcTdnR6ANVs4ccu3dm4kXCnogpuOrNH1neVmmV26x6w&oe=6AA0048E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRnhRT7eGvMQ7kNvwHAuBIv&_nc_oc=Adrn3CJja_zTQpjVmBxw-Vrc2aygsO3cBfSChrwcOU2rX8DByVtN8vLN-Q3Iw4tzHy4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvtw0ne_k3BwyWdkES9AwUyjds_CREJAdkxxn9ZtAEDQ&oe=6AA00277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0k3AcpsNvwQ7kNvwELMSkO&_nc_oc=AdqoCLlriMiYma8w7zoSyyiL5LEAPmBIcLDxWk8LYrEfHJHrILLhQtiZ-NAi3vVSGug&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHrtHX-O8kqB2yXgfrDSCD4poPsX-Ot8cwYtkQS0jgRw&oe=6AA025FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
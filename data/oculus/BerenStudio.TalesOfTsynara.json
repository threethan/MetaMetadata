7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abKjE4S1LTsQ7kNvwFaW51q&_nc_oc=AdrI0Ye9ti36diEpDsv3x37tiP8qG9UAPLrBcesepW1sbkhoSGk6WhY2zZT_tSYRluI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DatwDuACU51THYzfPVMAbr67WTu_vcD4j8f5cPL3pXA&oe=6A0495FD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WlYgzOtsnMQ7kNvwGaUmRW&_nc_oc=Adqg2KqH9CVk5u_9kS2b_VzbDHccwFWzY9WvKdqoPHT63kCAWWHIMYQsmQz4bxkcR0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZM4Rg_qIMRqtCwxpjfxH22MpGouyAxUUzL1TC_UfMWQ&oe=6A0493FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvMLva1CLR4Q7kNvwFn1vgf&_nc_oc=AdpEdScM2LrSVuSQpbCnU00SQLLZlohIE71K1jazVtPHcCkk-19GLvwfswHJG2CYPdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q8KMqdEw8bRB6GXG7-0BU9Iql47IxOWYVWRBsn3jqVA&oe=6A048497"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59zhICOt-SIQ7kNvwEGXfwK&_nc_oc=Adpoak2wj4HUa-5qJwaop57yQQ2Pxc1BWZAilCP9R0XR0dLJJHmARlsc9HeNW8hh3A4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iBY2o9NiGudT4dtuHabejYunp92agpGjTzg6N3w8zRg&oe=6A04738E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lTTjIoljCQQ7kNvwFpWnoM&_nc_oc=AdoMwV3ss4jX_W3P4Y9Vwu1F72TFXvaVQuoG3n68P-wR2hIFe97hJj8ZH7c4bFsjpv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R7EtlGL8_6OPwsXsyjdaVnsi-GVwej2kkODrw_mhZ9Q&oe=6A047177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp_9MTlg09MQ7kNvwGsJA7-&_nc_oc=AdqTCkKU06hr1H1RIqRS28vTjFnzObQtM42u98q0-VQA8q4whK2ApDXR8pajfBtw7LM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VQWQf7cp22GN2Pra9W9LMCiie2jaeRhARniSKz4BrZA&oe=6A0494FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
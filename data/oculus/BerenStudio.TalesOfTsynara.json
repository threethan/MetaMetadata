7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thH9uNR2C_gQ7kNvwGsvz4d&_nc_oc=Adru_6DhUIAXUDD4Y7f3k5oodUrfKtOmRTG6yYouJLIZrRO6hPiIHAnzXy-TZQXfDrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwInjLadAtppDJHaJ32H467EdJEBnE5KDbXRblg7vdkA&oe=69CCFEBD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi-HA8YLrQwQ7kNvwGejZxD&_nc_oc=AdqPh-auve4c6K16KK5NjIV5C5M1GlmPx_uqN3nkKRUuc9FFQJVTvQAukSfUIVz_-KM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQEP6bRDzjE7dJ0NRpbbw-PbyBdygVveaiYozuO_R57w&oe=69CCFCBC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ_1I6o9mWEQ7kNvwG1yy5j&_nc_oc=AdoroLZbl0dkaCIkb1Qzl1O636o75UsxY4PQYUVIfaxtRTzcWrqM-RLjJ-GWWydinaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNjFNHbAQPEaGHqK0X12iM4d65HyxbaIweRD199GYAXQ&oe=69CD2597"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K690311RiAQ7kNvwFgvrrY&_nc_oc=Adq41RmxBxfbgnYHNkiavKs4m45wkfPgH_DiGyCQafq5eIjd0flPFZOXHXGWiMpzQJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuSXr_daTym2pWOFy5xX2BcTnPziv69bIjHfXE55XoFA&oe=69CD148E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWYHxkvw_MwQ7kNvwFhNsU7&_nc_oc=AdpoDJ87ae8NEluW-Ejlgzte8I9db5jgff7--A_6rbtDUXzkDkdFvUndG35cxgLqSOs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTyjTs_OtrhbZIs39Bjp67gaNWeSV87wbQzqHj7cFd-Q&oe=69CD1277"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4w7kx5xnNNQQ7kNvwGiBhK4&_nc_oc=Adr0hivnwrvZUtKfNHPvi0IGeYpoNwBWc3p_2nDjlY1JrrwCcclpUYjYzEl2ZdZyhoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwH2uDSyQ_laQ7S2Y1u33upbdzGhlIPKOOUwzOVr1_5g&oe=69CCFDBB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
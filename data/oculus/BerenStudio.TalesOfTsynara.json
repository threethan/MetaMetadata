7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjupHXyid6YQ7kNvwHdEHuH&_nc_oc=AdpfNQwZJ4qiDCPtSQOztn8uUBRaBnpNwHNM6Rc86ANBAOjmfaeWHNGJ3sCBIXmdmdo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EyvGoTSZIkSTIPNeF62RGRo8FAlKG8PKPKMl7zRiMng&oe=69E8AE3D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJCwha1Lc4IQ7kNvwGq42NF&_nc_oc=Adrf3W-CG1Edtgu2hlRw-6uCaXvq51SLmiMJFx5kBZix2nndcs6ksegxF8mREWw58wM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17Y4n5v_rTyxE3boEvcdoGfCrntp3S4UCIl1VKrls4dA&oe=69E8AC3C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mnHE8H6Rg8Q7kNvwE5qa2W&_nc_oc=AdqLRZC_O7SvLaJwdv36ldDmtywBYlDSCPv0gRESeyO-UTfB4eUzNaJAr6Aoh6hjzyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af327xbgFjRchFBQzuG2mmBByEvwLmCvT0l3KrpkDwP_8g&oe=69E8D517"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-92HQfA1DhQQ7kNvwFof65q&_nc_oc=AdrPF-2CIbIY-hZ19xILOkqcNi72zCkWZwCa5IBSkZSt8NLYKFZndVkIyuOkEz-409w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zwuTG8e5GU2UEGCWhMjl4voWYVv0QBAIL4oI2EpkiCg&oe=69E8C40E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr8YNBx3CQMQ7kNvwHzrkBQ&_nc_oc=Adoby7Kvq_2IUbbHE9TNq_J3T0wXDIkrbJMALR_5EAKQY-R2Aq3Om73IPa08g_2ePv0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hSORh6slXBqzE0YTH25klQ2RCU9cg25Z0v4ZFTxkugA&oe=69E8C1F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCCgrkod1HIQ7kNvwGQ6yMA&_nc_oc=Ado-NXBwaFp6SDcU0kNsGAamcc5WrBMPlMoYezh3-mIswTskXy1iCxirbVQNqTv3Dio&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bbA08FM2DtMZGpf1dX9l7B8HUH4S3U46SnLfssM-4nw&oe=69E8AD3B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
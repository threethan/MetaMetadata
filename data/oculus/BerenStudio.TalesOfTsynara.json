7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4mEgTGJEwAQ7kNvwGo_ym_&_nc_oc=Ado340vX136K92XZX0aCUYzYEME_OkaHqjcr0wauFneUjeQ62ij1TsuHW4zHvvjWk3Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DpDOSV-twgc8QSTwyXW-pj7L4hzm6n2QTCG14I5d7Uw&oe=69E75CBD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH5qiJbiSdIQ7kNvwF9Oazg&_nc_oc=Ado81uEIEjlW_M-BiUPA3yaduEwlZpEDwpyL8nZ8wZZy-luUwDJ10LxXNeVeVDnDWCQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JQ_5MdtpLbaw3yEtuX2SclnyoL0kEOutU-6b_PYe3DA&oe=69E75ABC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mnHE8H6Rg8Q7kNvwHcy3BK&_nc_oc=Adqq2d6FUUQwXiOl5ffSAAMzgPSPLO3fGHZJmjELZS9RZgtPfemUIBPOjevyjwXG-FM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32XOaO4pxU8a8bH7eoJnAHWUap5sgBeZAgJccd-42s0w&oe=69E78397"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-92HQfA1DhQQ7kNvwFsAZCH&_nc_oc=Adrcr2tef0ixner8wSQiIRhs5HxlW2xXH_Nz59l9UrAK5PrOB2b4_4q7l07Dbb0abmA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T7-0gGT3rXEBp5YcmwPFQZurY6hxpRWegiiXvbXQMzA&oe=69E7728E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr8YNBx3CQMQ7kNvwFrkig4&_nc_oc=AdomMIzQ8jHTUK7HPHfbew0k8eUpt2-lLMOOtuB5l3laRthIIHSi6AMNFpETn4i95GI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZuyHwG1mVQsHFZ30itL68BFezHZfQy5SFZaXY8ofaeg&oe=69E77077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCCgrkod1HIQ7kNvwHOsjz6&_nc_oc=AdpeTKW8p3-JL4TC_xGdlJEFwWMbGyhKnZwGV7VIo_JRLmAbnBEPdkVvvdPNfFrORMY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZnpJA5SA0qEsBTZI7g7SlDQ7npH1W5bAWOOoKCnhkFw&oe=69E75BBB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
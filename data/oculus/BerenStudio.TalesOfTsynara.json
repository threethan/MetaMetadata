7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTTlOAevP4kQ7kNvwE5nKSB&_nc_oc=Adp19iEm36a8l1ArS51bIcgPJFi-_VN9y2L3OMLZFHJtRua-Hzv1WgBK1npi63W2s7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fxRhiTBRfSsqpzpgZ8daRHtQPG-gLyYB1-6wbR-Id5w&oe=6A03447D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljye-WL_CCsQ7kNvwEE34Yj&_nc_oc=AdpZ2NjIcuF2SFn9rDBnSdB-mMkAs9nhX17ExbGnC86RNzQguumnT_DGnTS81hcGWuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Nb6nOzO8DxD9Ow2pU7xGTMA8Akie6dK4pYbH3pw6yJg&oe=6A03427C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvMLva1CLR4Q7kNvwESd3HO&_nc_oc=Adr9m0CQzQ8wVbhqhWQXOOmoHwujxblrmqHVp8vzWkKEzfuLgcNBHUw_1q4zGazro6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b2KuLRzpFBAfQa7reK_-vlxfKEhcHqXwlhbatnY0lPw&oe=6A033317"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59zhICOt-SIQ7kNvwEYIrIO&_nc_oc=Adq3zF_zP30pP4XzqXqGNr7L-fCYLk7wyrnV14Y8uySH_Gl9dofARU52whsyHONybIE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bg7wBCPMqE38EwNB-VM6ZjitZQGWMoElueiFrBNIlwg&oe=6A03220E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lTTjIoljCQQ7kNvwFDSdIW&_nc_oc=AdqkBei_t77Wh5oQXyU7caWhu-z1mrmTUTo_Oc-UrzQXOwHBj7C5W4NH17yDKUC73OE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OcJLZH416nBTI68ldg9uRdiiwYjEAyrA8M3ikCTwNRA&oe=6A031FF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sp_9MTlg09MQ7kNvwFxbhtH&_nc_oc=AdrDcAlWbeJflsaGztynKMu3M-cE0mBVz6HBtmI4c-yDSCai6I5KedBIGDdnVQCkN34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wtGZpVX0r2GAiq6X5XCrT0X_1jIp2hpvwtZuhJgBksw&oe=6A03437B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
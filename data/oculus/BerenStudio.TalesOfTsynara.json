7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xCWgZj00RkQ7kNvwGVb-Nv&_nc_oc=AdqBiatkFGXr9nmPnPsjoj8x29su1hyRNMC4d_4afa3pqzP7WnE7Bblz_D4fzBtl9nE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bwbctbTMfFj4ZknVAocF90I02ydgvF_x5gsF1oo2tKA&oe=6A3168FD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_3oRNGizoUQ7kNvwGe_EsR&_nc_oc=Adr-3kmQcGpfz4inJSFDY8aVrETP50G0aRsj7imCvzDjyWkGN8cVQhfhWlqsGFoiKUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZrxJiAwbc5YnngiCjUEaHAV_0Oecy2pTpxr2iLbJXtg&oe=6A3166FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XATyc4ZLJaoQ7kNvwEfx65l&_nc_oc=Adr85hAjbO6uwgMp-SQHsMoNmnXQ7pnbhUFXklqDrxP7ZAdedrLri5stZBJ8A5YJlfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z0acc-LgY9Fpv7LurUZWI_djBjjyxfKEnt4U7SMX4Qg&oe=6A315797"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoA6GrC1urUQ7kNvwF11PB1&_nc_oc=AdpyhbGjeAKWipCqw6TibgUA_rmlV7bvB9LSell1uliMFiHT4gaADyh7_amL803JcU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gGIAbL4dHVJqOoHoLUwhGxxe689wrcrS2RTH4Cbt3Bg&oe=6A31468E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPoNmcNpOOEQ7kNvwFS64Xv&_nc_oc=AdoA62TAQRaJuBfWdI9P_fQmtLiABg2RH8y0tqTsjVHTbZjPw8j3Qbzqy40I1mcr3Xc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99FRlYIHQeLH1DrnxGeMkLivg1PapgJ-hkqKyNTCKlEg&oe=6A314477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TsZ3UjDF5YQ7kNvwEKG2wr&_nc_oc=AdpKrt12xZbQGX8dcu83PHP32bceGDnG96lQtd_5hbYp5-vK-Z1krn0r3JNFONAfYPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90cIYIKyeBx9R3TLcNuwSYJftmcLgj5x0HRgA5XgIm3g&oe=6A3167FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpPCk55fj9sQ7kNvwGDevfC&_nc_oc=AdoXhZRqnXuujQUNRVU8qKykWVU5-lXsTOAnamA-QOlc2wLL9fHEkdOy18CWgW9o7aI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo5yBkZpJ89Yx4yk6v7w5MR1EATlW5leOglKgnpGDGwg&oe=6AC11C7D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrXviTb-64AQ7kNvwG_78xG&_nc_oc=Adqy69adopAAjvdlF6fYFe9TYJ4Asj-5Gmm1ScD7f3dt35raptnGmzCJFnhGe20ISmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxraTYhPfWpv0LEhprUD2zExwV8iUWhvGVThsN3flUgg&oe=6AC11A7C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM1i9v4wG8UQ7kNvwH7D5JQ&_nc_oc=AdpX8uAED4qZXAilZeFWLIdQymxxcQmuVNp3UAIlTSD3-fK-cVEBlG4R1ydNtIMKCD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNwD0_5QEQO_dw2yJTMlw4l_r9-fNba0kapd9U1PDg2g&oe=6AC10B17"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czp_-pHv-2cQ7kNvwHCB_8w&_nc_oc=AdoteyYS0MZ03LZOeWOB2nJYUAj1Uqy9WaZm57lyFNQfs_WMIcjB8Qt2eePmZxkNFNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCtBTZG4CIRy6_qUjroxw9XBV_6XCI6bX-HHBj1RaQsg&oe=6AC1324E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyr79ZvMSjAQ7kNvwH1exuo&_nc_oc=AdqSXFZ42yOVu3qeOzERISScQoN19yrW_I2sXOcUKCB4So3QHeQ72VJA41ADEPEVZ2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8VnrZ6oRrBmLekeOSimPh66Ax0T2v6ZfKLNo7hSzX9g&oe=6AC13037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEc1_l1UfJYQ7kNvwGVsiGT&_nc_oc=Adq2_uWI53wBpLmsf0d79Pvxkff4c6Szx1HB37ebfBSwL8RPAQ3POcVmkUAU805WRjg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvaNRG5gW6HwaZO-SG3QXIUW37LA7L1xLsWTNj3qYuUQ&oe=6AC11B7B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
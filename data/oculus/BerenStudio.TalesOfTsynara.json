7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkhyLtxcoa0Q7kNvwFUhq1C&_nc_oc=Adp7AGLXU8ukkaLNsJF5t-vYgCRuoHvN5l6EtiOjFHCX0LIflc3qwi7JXcDNBGLD7rI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB0-MGv1ie7cQsgXxi1OpobAJfg-_2mnRBbMxFsnt2KQ&oe=6A9D83FD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFd8UHPxVXsQ7kNvwExilhg&_nc_oc=AdrP69iTdKNRiELGIgwMVU8Ga1im5qY73DMmwJEt7FIHJ1_9e_AQUp3mFAqnpKGpp7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtvO-APVPlFpt1PKuYjzhOXjv5L6bO9Y6R4U3sM_Djug&oe=6A9D81FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYFGIyiQrQ4Q7kNvwFqelVQ&_nc_oc=AdqgHzgAgjWkSTxYf4hf_wGYOICZCJsNfHaG5sAPepRkRqFJjo7euJgFrPISzb0XFLo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS8OGW4q5Spk3S5VBFCc1dXctcPyYfCMy7U4hrfu_eyg&oe=6A9D7297"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dwg01Q8PVQQ7kNvwHRbDt-&_nc_oc=AdrceahN_b-EwSPS3sb_iatIZ9PCR5dNMB89VeRa9A_G_KAWXVRU9cGu5uj5JttMPNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCEhrBlUrhZQep47eQELGJqn42OaD8rFLA4aDUcGfrRg&oe=6A9D618E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUUs0fIOl6YQ7kNvwFC8PhU&_nc_oc=AdoJVplJXhtZB21q0uJI9popWXQbGY4y2U3xmVgHI9YKO_y0-xEcQvXqxJbO8z5quls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfqYURULNMAsONXSobPXPZOdYjRTyiqBYEvqtbySV40w&oe=6A9D5F77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyuH-BU4GoQQ7kNvwFCxRla&_nc_oc=AdomkyILsZ3aTfozwAhSyOHULeqIQgoU7K3m8pcyxFSDHBVxuGNanN6u0x8CbLEp3tU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxMdOiVPm1giOeHuUEjVlDPfE7cxXOXA1ML9SnV2EvgQ&oe=6A9D82FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
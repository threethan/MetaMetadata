7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8E8zYxruoUEQ7kNvwHKEhcu&_nc_oc=Adoy6-aJL7bEER-IXLPDPtow39QYC2SbGVzVJEhXF5TgnHq08mJCbgxOCLoG5yN-HvU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfybVMVVYT3Xr7vso9PqUuJvQUS104S5N0-ZdPDRNp_2Sg&oe=69C7B8BD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmjgWIXowJ0Q7kNvwFIw_lh&_nc_oc=Adp9QiEzJJ0UssBHlzdLC6C0uWiPZyAwG-p_MwuSxQRQXAeMLdKdivo_HzEoJ6th0ek&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCGCn-FQ6EjoN_PcZ4qpHk9gFaJpsQoG5fvDFuoxQ2-Q&oe=69C7B6BC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8S3B_IPRQIQ7kNvwGoSNFJ&_nc_oc=Adpkap9uWNTR0eqZKJDp5DoTtaUWBmpnz7SVGvhl_3Ydm3bvZNmRXFMVqw64oiCweq8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJ3ACMEdEZz2DKNNymeDsH4Qk_3KY4OiH1x7GsPm9cHA&oe=69C7DF97"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahrd1GKh50sQ7kNvwEeJ2s-&_nc_oc=Adr_xBigLUZypZMeureGNQfEIoxZooDgNKZ5NlcNmqNLMsBH4z5ozOj7Q8tkRjr_2EI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCLpS-s41ts6-nsfGRj0HaorVTaSQBtGFkffCUv5jGuQ&oe=69C7CE8E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUZw4m2F5GAQ7kNvwET7crs&_nc_oc=Adp8VfMpjABwglxWCM3NJ3pm6mPZZUgASs-qAdnB8cCz5Z1H_slDflCtH1QyuMko5VY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxR7FijHKcO5RI04JVqSOiNBV3S_fa53v96kibAxCIBpQ&oe=69C7CC77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN0macVVLpsQ7kNvwFAOsiN&_nc_oc=AdqGbSsGKFRnNL0hJCW5nXpR9Zo8_8tLJQ4zOorPsPh0avogOu-Tb9Dfx19x9imjGQg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcmJj99K4BfgFpgmvEZFgtDRPDS_JiEZtjuJFZ5GVXFg&oe=69C7B7BB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
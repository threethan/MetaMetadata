7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVE4QBwQ70MQ7kNvwHM7zqY&_nc_oc=AdrPRpVeFVfzyYdbOt9KKhQhGUIoDjpcW3oram_Dhs3wfeawyaaC6WSEvZcVzOf1xDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eTUfjG-USmVc6ZSO-zpS1Bh1Na1x1eZcQ-89rUGHcQg&oe=69DE223D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tldl1eQ0YX8Q7kNvwFxzIAt&_nc_oc=AdrKHGIZp83wLGTVMEPfmnJn7Qs1wjCK92LTAE6QasfeGjgjcActotLVShVd5KJDca0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RF7UmU2YXDffjgi6hmFScYQVfomFL1ZG-fGZLwtFu8Q&oe=69DE203C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8wepn6sC6cQ7kNvwG45xIp&_nc_oc=AdpkhFOLhreXRmtQbpFL_zTNJbAm4bqPaZ3rPyut54M7jZ1QIS0lMvZ835iQOW7XZGU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lGELqyZz9myeSuKYly-daRc1bsKMxqhV6d96vw2byMQ&oe=69DE4917"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGAmjwyM3BoQ7kNvwFXu-ZP&_nc_oc=AdonMiXYuRDe8PADTmS6k3NTHSKnnEGssHfITnOi1TpteiBu9gIura7PjgN23_4x-SM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NW087SL-5745wc8ghokcEvigeGoJvvVZJyOYDaKq03A&oe=69DE380E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqOSkHnWY7sQ7kNvwE1vNMv&_nc_oc=AdotJyhrQYdVnx9smSvAaiT0mTyoz1Wmb5xLTnoYIbhslYNHUKMZj_su2wEL5Jv1wB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TGMFZoR2Ztcelnq2CopfwVq7pv3f8-zsVkmfBd3P_dw&oe=69DE35F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gs8cMtQXosUQ7kNvwG5l1dN&_nc_oc=AdqrUu_XjQcfXcaE3lWxsB1pRg73UbJ-vx4pkTAwVwXnWkgCSKa2KCTsCnHOgpzEwZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af210Cgbu7ifQypby0R1zO61poVkb9bI0ojHawZ3NzCLOg&oe=69DE213B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
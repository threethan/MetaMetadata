7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVd5-zuZqQEQ7kNvwGauBVi&_nc_oc=AdqnuLbDPtpsQ5pglFuYAboLiGunLXcvt0NghSYoBoJOyn7-i_pRBOopv01UB-KALUM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE7AxTTrno0Tq_HX8hiuNpT1Dyv6AP__UiyW-KpfVAyQ&oe=6AE8A97D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psgvswIKFSAQ7kNvwFMVK6x&_nc_oc=Ador9Kk_scx1vJXYWFfcOI6ky2ubPoDpEI_yIuihY4zQkikkk7jw9R5RDqIn1pEKWoY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD8UHHPEywJ6xBuOPPg_HImfg8t_ZBen532xGebtAz2Q&oe=6AE8A77C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT0h78_eX10Q7kNvwGXAo_4&_nc_oc=AdqhcZagZzp04wC6ttvCa1Ue4TE8DhW1MVFlberKNCQKny1FajUWqERrU8ilrMI1X84&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoUv9JRpoZxPJPrdjTkrkq2kPuAWd3Vm9wGD3W8GiLJw&oe=6AE89817"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNR7_xQHyj8Q7kNvwGWTLva&_nc_oc=AdqkpBWv3SkT509ipv91tPDnNaGR08MxowoSbqSo0FqbcVXEhKtAazXMRt8SYTo5_sc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-DItz8Qkf7fCV_ijZCkrwYd4y2UWW7olrNhqI8eXtcw&oe=6AE8BF4E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMUV-iu8LjUQ7kNvwGoawId&_nc_oc=AdoFSitr9X9aidd8baoaTRBIYhfKTeb5XgdOovjqvw0ISu3qiWBIb3VIXlPGVezecSI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKjOjS6o4w55iZj-MkGPLlLQTEkYQwdV7Q9yQ2KWV-Wg&oe=6AE8BD37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgveZMxFlAIQ7kNvwFg_cew&_nc_oc=Adq4MjCCuwLet92tWNfIxiXVmkQrARkvATLvr0h6H3w10yn_FSoNgfMx_GKbziIg7ig&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOlLrTqa2_HxQdJzZABesIq856As-h0pRcPKrmqESI-A&oe=6AE8A87B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAlmlfLI7o8Q7kNvwGg7ABj&_nc_oc=AdqFGmDGftInAdcNlt8DxKU_2qRsymBhhlIhjn7Rr3-UFY8GiXVPqj9hzHtzVHzUG9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtrz0WZrV7M4DbgQh4GjIAxK5tVabJZ2q4UT2zzJK_oQ&oe=6A92BFBD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_rEzVFQ0hgQ7kNvwEbl7yE&_nc_oc=Adol0FAdv_bqkmw2B0ouY2cjUYXvm22fEnS2nGEAh3HEjq7d0NUvNyL3Ec3fYS7-ZmQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdmjkz-rpMX8MVP8CP0KcS4ZkojUQkv5eahyrtfZyzxw&oe=6A92BDBC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Mr3yqKlTpIQ7kNvwHBaGZJ&_nc_oc=AdrPMYUsL_hwCz1C8PmzY2ZdveSgoZHDw1TQAmkRIZEpw1OoNmRIo4uUKO_gvb50Xz0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrXlwAY8hMR0MU4EWtcXqjxVTBoc5Y8KCLFpfBZq6apA&oe=6A92AE57"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC5kWEmdWEkQ7kNvwFKawXf&_nc_oc=AdpioA500bFRyGTggvMAMfaDdt577GcU2Poc5or-UAOtJYH1wanZ8m4fsaRf9d_0yD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe2no4jb2Zcyjt3yoW4PjF5naju-nbgQpsaa9YeSFzZg&oe=6A92D58E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui_vd6HVawYQ7kNvwHHiNeE&_nc_oc=AdqGN5dCO3vtzkzM9Dlwp-osiEWBchCU56jWrmPLIPqnKy-V0XN62EQ5lAWrxyi9Jbk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG84eD8vuk5quMWQWMC3kZLfukedjjYt1I0TtLUw4Porg&oe=6A92D377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QorwP6B-GswQ7kNvwHQXlKY&_nc_oc=AdphLo6EezwGF-TMBx4Z0Vs8q16jPaTibofbWrSnX6KaID0TvMUYWeW--2I1S7fhL0c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0uP54ovGovaX7SlhhP8bceNeMm5s0T5J6x9nxm0u-dA&oe=6A92BEBB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUby3kSKHUYQ7kNvwGrQzdl&_nc_oc=Ado-kK2tbj0T1FDztCh1pABo6-Ouvs_iDllezM9WG0AsuA0L7rQX7X0pmKkN_juH8Aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn_dzWgNf1SjiAaljqgCnmTL8m4N5G3Iq_ikXe6yYXQA&oe=6A7861BD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea1CKPAxUIAQ7kNvwGXllVt&_nc_oc=Adpug5zOuooT9KxqWNroVNg18H4wBjo6owIII9c5s5QWYf9qP_4MsjK9UP3zTNicoog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDdSDgPY95XfkjJVmI3l2CRc5SPTLa2tLXm5UcSf2cag&oe=6A785FBC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptYGYH3lihoQ7kNvwHi-Lnz&_nc_oc=Adq7bvyrDWo8gfEc-1eTRXqjOhqYYQPpS9O7KOreHTaRFisLuw64PJD0qOO9qAxiPws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_LDOTNaF4PCKPJtFWrvB3zgl3urbHJ2TYSV-mIzYnVA&oe=6A788897"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qZCTJ3v0zsQ7kNvwEj2ucI&_nc_oc=AdonrVMK6GFqc2O1nYN5uuI4lOM46pkTbAVEyikcXx1ghBk4oT-v3soc6dDx8hJSQm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzgz3Ku5HmWcYYznrfjeCU0P03XYNvfs4B1rORbwaFDQ&oe=6A78778E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNFRIzUUhLAQ7kNvwElh4Cr&_nc_oc=AdrxLJwcPfpgQUDAygHJaj_jxvPB8diqYviAk9VFvb7r7ITBIuvmLvhQ2wmWekvc7GA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMHDVACJ5MLGKRU_cjCGKB3iMYpJ1jB34RKxWAzcnw-A&oe=6A787577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxNeDd-SzMIQ7kNvwHV7kVP&_nc_oc=Ado7fENAWfaASzRku7WJZagfYctARsMEMYoqsk--1M0Tg39Yh6jMT0_AXOXwKF0SGdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1tMHQg6Xh_cbueZsD2hRZq5ud-omspcDfQ2HS7fa-KQ&oe=6A7860BB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
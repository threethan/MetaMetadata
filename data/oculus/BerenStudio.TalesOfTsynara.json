7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpPCk55fj9sQ7kNvwFvpyg5&_nc_oc=AdqIdCPjGDFqjhiK6gTUH_cEGGM039YOz5z3_5CW4heyaI1R-rcOV2tKSFFOGAyH9Oc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW_SMxBAPgUVetxqETxx5C-BggD1SJl3f1H2AKZYpLJA&oe=6ABFCAFD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrXviTb-64AQ7kNvwH-3pg7&_nc_oc=AdoHZ5qxBs49h3f9Mpnjss7QKVKik4aoeERVMsa0-xyjily1wPJ3_qI7ji07WhmqLC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFh90WigOwTEkSIOcqG9FIJxtefkclVXplEqHAbA5yXw&oe=6ABFC8FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tM1i9v4wG8UQ7kNvwEC9k7c&_nc_oc=AdokHFl7R1bM1l8DZzfMlDu1_HKffTN2O3ktdoEsNnE7uE_HLQzoN7pS0H4vlJNJa2o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaB6y34_y8z8A4Cj3-Vh3OGWdScRf1BoXJivxt55qEoA&oe=6ABFB997"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4KtqOmoDUAQ7kNvwGWCtBr&_nc_oc=Adoei4-lqQv8ZzQNth_9z62ppMlf47drZY3sTyZjl5l_mSGZkmtNaQMAgQI6mXfRZcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLN902CevYolA-z-XZyhSurLlH2dfNAa7EI34gGQ1-8Q&oe=6ABFA88E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyr79ZvMSjAQ7kNvwFCcwUm&_nc_oc=Adpm7CS3r2378a3gnC_VrkwF-hhQdkzuRIXlKMIjTE-zrIrCp1J_l34JqSeAsMq3miE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdU58KyUjDv9y-0s7ts13zv5emOtkKxT0hkSEhHqrXvw&oe=6ABFDEB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEc1_l1UfJYQ7kNvwHN_ZcY&_nc_oc=AdpBA1kfzSLhMGH3l6iqZV0iMr6RiFslWtCKmG7E54EaQb139uCVWrbd8LSSMIdWcAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZsdPOqNUjdXp-HgxbmaelDHhMqOOP5bvEm8UJwvw1bw&oe=6ABFC9FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
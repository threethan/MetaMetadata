7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5vDbaQrSK0Q7kNvwFMpDAV&_nc_oc=Ado830couUvyaeO-I4OklkbJjQhiVi_TqajUf7cjT1DUFJu5VjKqKKx4K7lsq39ir8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ReIs6LzHGBtJU3KYOb2T-XaB3WOCp3D2ZH2CT_Yc6wQ&oe=6A43DDFD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBMeNh0MCL0Q7kNvwG4ru1a&_nc_oc=Adq9Oda4xIKce8Ccl-3fEQSbNTCayslwtp3Q14yCwm-c3FTz-S67pAFzGzFpmVoOE6E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E0y3P86MWxnBCFYq3AIVuPtzp0Z_KEDHVxD8mo1Okxg&oe=6A43DBFC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUn0IoMWJ7EQ7kNvwHXUWG5&_nc_oc=Adrir6pEUqwxxQMPgcBv2pPw7S2w3zBjCNXXorE0yKyzyRO8JMKc2lhx3ncfHabOTZ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UWFwlkCooQdHMfb3cO-zU4_wyFDRLnfyPCwoQgDshxg&oe=6A43CC97"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1iJl-MYiHWoQ7kNvwFCe4Wu&_nc_oc=AdrozvdltunStx0-uBgqpFE5BZ6_STAQKwlQ_GoHB9jPC0qq5k-sO31vJsrjLmcLcVA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XX840hlmLl8ZmYeh-KWmjfjYhmJ-11J0yVlflHTY-4g&oe=6A43BB8E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPstOBuYHAMQ7kNvwFAWTem&_nc_oc=AdrIreLMY3O5UqPZ1E2D-K-qylDU4NxkGFLI9y-Hbmu1Z5XUuEqt3v9SCVePqYU7bJI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83YUUe7RTUZ3WcxioUmCK2vmUB79eYYikSvQjQkrhA3w&oe=6A43B977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GLe3FODz68Q7kNvwEaqZdn&_nc_oc=AdpwVhrAzHV23AC-ZRKwx2rJ22Z_uZs1QCxAwApMWqjhEJ8iyv1j0x0_D9d2SIeznEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X-tjDGK3dna24r19vLiW8iIRRnjNhRPTgds2OtkpwjQ&oe=6A43DCFB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
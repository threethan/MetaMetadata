7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afS9tZGf0awQ7kNvwFcP_o-&_nc_oc=AdrPFnfHGFk5ObfQlzEhDZNCsbPwVafh9m0R5RdvBNjlHHncLKmvRWm8jMR3y71MI_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaxApQgS9RSNTqTVc1z5rod_LJ5YMBlt8RT2fsK5quSQ&oe=6AAFF8FD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBafg18YKbAQ7kNvwHn5iS0&_nc_oc=Adp_MPoCHQzsXN2dH_Y1JJ7ZzGHQy2pUM_cWXT0GIISbQsw3xqw7WmEYggxHcrCENHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNt_c-Iz-_xSN6BdDbPtvsrfzuYsHtiQBCNOB9zrASfg&oe=6AAFF6FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vkRxV2pOswQ7kNvwE5FUk8&_nc_oc=Adoq0Wdg4OYbRuayAc03cSb2XBxoJVDU8f_DMMnUK4YcPdDxVfiWwhutXi5wwpOm9q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRcoFE7PI-49eo5mvSL-dBFaZbuZ-xBtWlm9QXdhQZ9g&oe=6AAFE797"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSR_Ysi3aaIQ7kNvwEhb_la&_nc_oc=AdplDYvIVMBIUq-UAEBjsHDfhL1xNpMkTvVRyAybqSu7ZBW6MAm_-DxQdwlwo3-zZvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTsRRnvrA6-q_PoGA9GuhUzAGHOnnzlPSIG-5P-yFqmw&oe=6AAFD68E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KamJ1Y0l47oQ7kNvwE-Sl5P&_nc_oc=Adoq7lFXN4TMD8zKvYPS4sMbzpw7U9e3Jzba7WofMG-UVSkJU3sXRRdpfXxR5QO5x_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXgLjABtKCm5yxZ-3ri536JWODAKvmFlk_yq52XIxyOA&oe=6AAFD477"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H0tzq-hu9kUQ7kNvwGIpNQm&_nc_oc=AdqhaRh0P0nBtnVDgo82zYwySzcPzUJJopW_CLXlnnjala36VCeBIUws-rM8-IFLGdo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYDLblCblMgGJiHpGgTjLXFKmiSbiIMepIO9fUPQGU6w&oe=6AAFF7FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7COdr3q6mYQ7kNvwGaS2p8&_nc_oc=AdoZmoZ8xwW78dPtpthtg0QB0W3WiA597pSS2v0fKWV2us2FrgByCFMoBVJ6AL6MnTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQfLUhwgWvzmFzeBwEv456wxkKaOguh38HoXdz653RCw&oe=6AB3ED7D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuq0mc9jeMMQ7kNvwG8P4EM&_nc_oc=AdpRlLpdmIznBtTXCr8gfwDvsZIOIPmyOOh-xT92n_1TtT15gy0VzyPyMuXL35SJOSA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsotpYENIGGeEOuxXFIdVv8aEGOVLFk42zyBnHXzS98w&oe=6AB3EB7C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lje7V1JVQgYQ7kNvwEOXa96&_nc_oc=Adpg6AYl39JiV8RJRa1FvG2mPaw3uc4mviXRVF6WGE81LpvwTpjDOgkYBr5gkqu2j1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoliYRwU9oS1mAfdV155AToenqA4Wj3YhS-EGjS-883A&oe=6AB3DC17"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x_BDD5I2jAQ7kNvwGmjBKw&_nc_oc=Adp6cjzB2kbh-iPZOu7-bfttElONO1RK2NKlPKG_repr9JW3yXF23BQ6cIYwAAYCshM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWqu91nEB61DkdpzR6Dy6kugFTVd6t0Dar07vIEVm5ag&oe=6AB3CB0E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilndm5Q-jrAQ7kNvwEDYSzu&_nc_oc=Adq8g-sKCxwOA7C_6HtIHVci1W3dbt2bZzdll8VTFqLterz5zDFFYwh9_CAw4RQFcEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeCCxTA4p7jfA4Z3Ya0v68UIcik6qAloMRlwL3jxav-Q&oe=6AB3C8F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPlK1tCQNVcQ7kNvwGv815S&_nc_oc=AdrWNyuakqYOKC_N8Cxb_JVcDs00h2rqzPsiFX8WENw9nTkcDY1ffol_N01hcxCw-BU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8A-OXaWf_9Ns0QIkXYSpKWgFfI5niX4xjZoNq5lYafQ&oe=6AB3EC7B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GjYA7SGH7oQ7kNvwGD7wIH&_nc_oc=AdoQS2iJhrEOo-PUC1RqbSk-K8-Pdi5obCDCejUObiI-9T-Pq95hr0zuJQ9GtjgvDAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVvEbkD1Vi0Y3-4GTTi6Ok20JnXM0T39-VmpnvGr1gkQ&oe=6AB9337D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwpiQNzJ-88Q7kNvwFpTYDS&_nc_oc=AdoTSfzGK0uqLYQcSDsSv1T9HLJ6omxX5An3jAHo2wdOf4a541atP27DWZEwetvqAfs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkr117X59xN6giPsG1cuYOPTbqCX9-5LUR7ehaam41yg&oe=6AB9317C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5ap0GOb6AkQ7kNvwGwmLZZ&_nc_oc=AdoRZW-uUN64yqxgN3R0AS1puU4jQZ0T3o7Vfr-44RlE42DYa2TqK7PQNwwn_VkOlwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzbkctUssU1nee5GsIzz3sjbbSkXWIizLZTZI34jfuwg&oe=6AB92217"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqtCV0Oo1MQQ7kNvwH2QrKm&_nc_oc=AdpBS-oyXeqMQf7aVwdZYPqBx0VDF9gq7j9LYjcoVK16WvDxkQWWGpHwdb4jl3opJOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ57Qjnc78Q_FTu51Yg1-uMG0ZgJdLkHp5PuPCXYpkfg&oe=6AB9110E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_BNKp10tHIQ7kNvwEAmqRp&_nc_oc=AdoOF-_YbkaXflEl5DVUuCLtr-3bNEfNsIsNAtvaFwZ-T63GWntQsi0k3icodJQVsX8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3B6Vy4WhkjJ2L66E9SBLFpidfnVgO8Xt7OkNk24jh3g&oe=6AB90EF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yBYCYVnZTYQ7kNvwGtoXrE&_nc_oc=AdoCKK11TLI-XiH46UKfnKMqeyghvqRyfxDJtJiZrWqa2p1cy7LsehV3Q0LdDnoWxlk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsiEcltMuD9SwRH-qIVH2d928f_3ucaFZv67oqcDiurQ&oe=6AB9327B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL7FnhF9vkoQ7kNvwG5J90c&_nc_oc=AdqTeRrwzU6R1wpigU3TdhucX_LjJDC9fMTwG4vLoC7nfpoCw5NzHCisIwwaFCpTAns&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvLWz_bvaZ3yyKF11yz9r9I5FTQgF5PpMiMkNHlSAkKg&oe=6A4E69FD"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6iVEOwYAuIQ7kNvwEizuXM&_nc_oc=Adq48ks24Jk_eJY0RHnNXafyIUD2bNHEpCUTkhKLqDvJ71mwlURjFv43MtYwLd9vzRQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_L57aohgjotxHhfle1AVbXjA3R04eOAahfW9GpzXMmw&oe=6A4E67FC"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQPkeRYIfyoQ7kNvwHnaDzz&_nc_oc=Adpw9zjrdBsRvBl7BhB_mS2_J-x_-pJ7LH5jmeebYbiCZxro0iPfAA2A78_3JPj42es&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFcG1QcOcavw2pqwPiooozEf9MIw7SRt0TjvqLnrGTkQ&oe=6A4E5897"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGgeHWVxsGAQ7kNvwHq_OuD&_nc_oc=AdqRLKP7DcO9KAsxtb577ivhhlpFzBGZrbtNkSGTtB36BufFpMhK3tm-lD75kr1triw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBHgy7bLu9euDXU8kLI6cF_B6nF-mMMVr7AywTGmLTAg&oe=6A4E478E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oNTuQQODLsQ7kNvwF-4QL0&_nc_oc=AdqbTPJpnLtpYH5Y9IccaKwapQJLbGIz7JWHCVQwQmjbt8-n0gBXZxqT1a4LpSKRoyc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM8atMIJpMf6p2pICii5QtrXraHCI_DT2KOCxEdRIBvA&oe=6A4E4577"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icBc53bY4UEQ7kNvwFTihbs&_nc_oc=AdrM09O9339jyScAIf-TladKdbzvn4jg3Ft7PlISiBxrHesMs77ycOxiCl64G6pGqig&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOq0f_wqRC919TqgIWbRSipboDeMAGpcAhfWe1MR4iFg&oe=6A4E68FB"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
7_6226276594153064_1292326161744713969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnS7QDtUQqIQ7kNvwG5LGht&_nc_oc=Adp1z6Fh4LvkqjU5CbN3jUkqnmUYxRlTrF6Q1Yz3OeRr0uwuZFlMmM1y43MAzqcD5sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtte7XrL0X65WzSdsQrAWGvN8nrvpMcsrZoiN6VRvjqA&oe=6ACBA87D"}, {"file_name": "L2.png", "id": "793900518807278", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75485576_793900522140611_5400852275989908095_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zrr7umHGkvMQ7kNvwFlyXqq&_nc_oc=AdpiMJwYOJodsYjFQZiNWW9rBKx2RmlZC8X--rU2i6SM4ajwKvyRhgIEm3rsIGFy_Xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4myVA3p4SsoQW7FUq1pvWgCahniT-pBuZ5Tjkx-EL6A&oe=6ACBA67C"}, {"file_name": "L5.png", "id": "1291381601464817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982592_1291381604798150_504386217610830001_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJDhLj4EGTQQ7kNvwFkjdhl&_nc_oc=AdrrDv6Qa6TugHtyD9Z2neBwOBklgelRQg4kvVPoMIfUU0k6L_p7rv3or0gTAEJMEqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO13lyJJMSwup4zryRvFcjWoNdAl4bQYyW7wf3_4oWCpQ&oe=6ACB9717"}, {"file_name": "L4.png", "id": "675978691030538", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984447_675978694363871_4569307986555874553_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiCwULIdZOoQ7kNvwEOTO3G&_nc_oc=Adpi0iSBvtsan6v62xX04gErWCe8S7KgWWDBxuUEBFCcWlq_EdVlRLfV5n30rsMbcVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOukaTiN8E6XdZsIuKLEAzhWWZ1sloREJ3R0e-3HxbKRw&oe=6ACBBE4E"}, {"file_name": "L3.png", "id": "1040047633632106", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031376_1040047636965439_3456093016041400068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-q5xyO1pAoQ7kNvwGmz-zZ&_nc_oc=Adp6_Z8_r491eXkp9JmwnTIZh4ij2kOWi6xcL-1i6W5rgfV3fAuTMx5Fya3RPb6niTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOGaCx2XFFDQ21FAQ46lqT9qT4-FtCaYPUopdHPgDdLg&oe=6ACBBC37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1066198721021778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031567_1066198724355111_4955011362448384175_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FVJe26Vz9BcQ7kNvwEzhrpZ&_nc_oc=AdoiAYAToLeTXobfE-6y_I9TcBhlMz5mlNMGPcp2heiatJ20046nXV8JxWvl44Y-BMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6rd01rUYz-CSFsEjbVz14UJ2IC8jeRcsywF_q_FoJcA&oe=6ACBA77B"}, "display_name": "Tales of Tsynara Part I", "keywords": [], "long_description": "Become the wizard you always wanted to be. Be the champion of Tsynara, an ancient place created by powerful wizards. They used the key elements of nature: Fire, Water and Air to keep everything uncorrupted and in balance among the realms.\n\nUntil, fallen mage Aldern unleashed a cataclysmic spell, binding the planes in his own chains of energy .\n\nNow, as being the prodigy of Tsynara, travel through the fire plane, collect spells and face the minions of Aldern.\n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells from each of your hand for eliminating. You will feel the true nature of this notorious plane and lose track of reality.\n\nExplore the corrupted Fire plane controlled by this evil mage's lords and dragons. Face the dragon and feel the real mayhem in it.", "short_description": "Become the wizard you always wanted to be. Explore the corrupted Fire plane controlled by evil mage Aldern's lords and dragons. \n\nAn original approach for playing a mage character like no other. Fly for exploring, cast spells for eliminating. You will feel the true nature of the fire plane and lose track of reality.\n\nEnter the plane and feel the real mayhem in it.\n\n\n\n"}]}, "developer_name": "Beren Studio", "developer_privacy_policy_url": "https://www.tsynara.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bere
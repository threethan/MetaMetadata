B7N75xQ5aiLY_Myy-mq7IeeKDPR47tDpTKwbjgxC6rIWbfpeZspSmg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjAASYrAGaUtUreI9tRj-uPUxEoOteBq2CmgAORHfq1g&oe=6AFB3751"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160405.png", "id": "3067343813450789", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823968_3067343816784122_4583456138103477937_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTOHWrZZIC4Q7kNvwE-Tju2&_nc_oc=AdouvdpkCjDPw2s-0qQVtmYlipnKVBn1vAN-Ufqz7Ra36UMx1MmRuhmYM5UqC2Z1gvU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3O1gR677RovAR_emInEZ1CiF1hd9PTMqqfMc5yPzLzA&oe=6AFB34E0"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160550.png", "id": "912802351755469", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618937_912802358422135_7496864192364062935_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D315ZsuDl3AQ7kNvwFHUFlo&_nc_oc=AdpdD4mO88oCxaVx28IbldFs2wIaL3A1rI8mfxBX-zODLs2ZAubftD_mWBGZATpIyKA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6t2aXRpewR-JRiPlHiwmRgsAhnIDTUBbQvXObsqUNUA&oe=6AFB325E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC - Basic Safety", "keywords": ["vr", "hvac", "basic", "safety", "immerselearn"], "long_description": "HVAC Basic Safety is part of the Immerse Learn HVAC Basic Safety Micro-Credential Program and is accessible only to individuals enrolled in the program. This immersive VR simulation delivers hands-on training in essential safety practices for HVAC environments. Learners can practice proper use of personal protective equipment (PPE), identify workplace hazards, operate fire extinguishers, and follow safe tool handling procedures. The app also reinforces emergency response protocols and safety compliance in a controlled, risk-free setting. Designed to align with industry standards, HVAC Basic Safety helps participants build strong safety awareness, improve practical skills, and gain confidence before working in real-world HVAC environments. Access is restricted to enrolled users for their hands-on training.", "short_description": "HVAC Basic Safety is a VR training app developed as part of the Immerse Learn HVAC Basic Safety Micro-Credential Program. Available exclusively to enrolled participants, it provides hands-on training in PPE usage, hazard identification, fire safety, and safe tool handling in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26696015896682149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620497_963661216253489_5617092118121632652_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcATXvgHM5wQ7kNvwFtLjZC&_nc_oc=AdrJnVdrV3wfGOQd-KgALSKvBl_4csFj1Nexp9grBpQkZ-RRLiPe8OqDaVRIijj68wo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdKCUFvv3uCKahU8dwtLMG2x3UpJ3P-NRTzHYanzVOhA&oe=6AFB19CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
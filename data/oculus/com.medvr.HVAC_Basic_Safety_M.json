nyLsU3BqAOaLAnVCRWWknhOr6sx8A4wQ&oe=6ABBB4A0"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160550.png", "id": "912802351755469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618937_912802358422135_7496864192364062935_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ln0F45oZb1kQ7kNvwGURFsz&_nc_oc=AdoEhpriCzPa0-NKqAWRUueTALVmtsCiznyTMXnOGxTv7DckAI3g73QjcqrVUqk8pW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNZ4sUv8wmMei2tE5KRNleiOvpC-n_UlyCV0b8jd9Xug&oe=6ABBB21E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC - Basic Safety", "keywords": ["vr", "hvac", "basic", "safety", "immerselearn"], "long_description": "HVAC Basic Safety is part of the Immerse Learn HVAC Basic Safety Micro-Credential Program and is accessible only to individuals enrolled in the program. This immersive VR simulation delivers hands-on training in essential safety practices for HVAC environments. Learners can practice proper use of personal protective equipment (PPE), identify workplace hazards, operate fire extinguishers, and follow safe tool handling procedures. The app also reinforces emergency response protocols and safety compliance in a controlled, risk-free setting. Designed to align with industry standards, HVAC Basic Safety helps participants build strong safety awareness, improve practical skills, and gain confidence before working in real-world HVAC environments. Access is restricted to enrolled users for their hands-on training.", "short_description": "HVAC Basic Safety is a VR training app developed as part of the Immerse Learn HVAC Basic Safety Micro-Credential Program. Available exclusively to enrolled participants, it provides hands-on training in PPE usage, hazard identification, fire safety, and safe tool handling in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url
tinguishers, and follow safe tool handling procedures. The app also reinforces emergency response protocols and safety compliance in a controlled, risk-free setting. Designed to align with industry standards, HVAC Basic Safety helps participants build strong safety awareness, improve practical skills, and gain confidence before working in real-world HVAC environments. Access is restricted to enrolled users for their hands-on training.", "short_description": "HVAC Basic Safety is a VR training app developed as part of the Immerse Learn HVAC Basic Safety Micro-Credential Program. Available exclusively to enrolled participants, it provides hands-on training in PPE usage, hazard identification, fire safety, and safe tool handling in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26696015896682149"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1434392441300659"}]}, "baseline_offer": {"id": "1434392441300659"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777875540, "status": "PUBLISHED", "id": "1434392441300659"}]}, "liveChannel
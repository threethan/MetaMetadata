5/499622276_982616194118189_2395732046361048450_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7Rp0vS2YkMQ7kNvwGTHl8N&_nc_oc=Adr_vd4UCc6k0Q_BXezYU7DWnTZsj-XaV-BKTi2g-iIEO3VizXIYPuWSTLcGInG5u1o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U1RkBj0acSuEpQGqtUwVM20YB3-8t9wgGVeXq_HdOLA&oe=6A26BD91"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160405.png", "id": "3067343813450789", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823968_3067343816784122_4583456138103477937_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iU1x36di13cQ7kNvwGEpwN-&_nc_oc=AdoEOpF3DYXDNYRkOMxBCdzqul2mVFS_fuOq52VZe8NhZu9w7lNlG75LbyMU3pxGKJM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hO9NxtleXDdNRep5dIu6OIkchi8139y6xRDLC23Lbsw&oe=6A26BB20"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160550.png", "id": "912802351755469", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618937_912802358422135_7496864192364062935_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOka8V1cC0MQ7kNvwHEpLmJ&_nc_oc=Adpxxs20S6oDzApt93e85PH0DEZFPy-qzTAqNApFekx4iYgnCp369OB1_PD5QfoG2hI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dmqOoJbWJW48GbuE-rdK6I_b-LN_eD7YHizkXF36uEQ&oe=6A26B89E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC - Basic Safety", "keywords": ["vr", "hvac", "basic", "safety", "immerselearn"], "long_description": "HVAC Basic Safety is part of the Immerse Learn HVAC Basic Safety Micro-Credential Program and is accessible only to individuals enrolled in the program. This immersive VR simulation delivers hands-on training in essential safety practices for HVAC environments. Learners can practice proper use of personal protective equipment (PPE), identify workplace hazards, operate fire extinguishers, and follow safe tool handling procedures. The app also reinforces emergency response protocols and safety compliance in a controlled, risk-free setting. Designed to align with industry standards, HVAC Basic Safety helps participants build strong safety awareness, improve practical skills, and gain confidence before working in real-world HVAC environments. Access is restricted to enrolled users for their hands-on training.", "short_description": "HVAC Basic Safety is a VR training app developed as part of the Immerse Learn HVAC Basic Safety Micro-Credential Program. Available exclusively to enrolled participants, it provides hands-on training in PPE usage, hazard identification, fire safety, and safe tool handling in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26696015896682149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620497_963661216253489_5617092118121632652_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncimE7vcaYoQ7kNvwE_NTZm&_nc_oc=AdrbH6TP0S3LZ2NB8ZpUs1XR9TKuxcoBmpX7s89It4fOkriRDkqLo--pwgtYs_SC2SY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yGu1kXWRG_UuwBXs-u6clXchJ5vq7NhX78eOxeMMWqg&oe=6A26D84B"}, "i
c_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JoD90IhHCIQ7kNvwEQsCWx&_nc_oc=AdoH6gyYVjTNDHoERWzDbCowYOGDgucRmLmbOhvDUPHw4-9Bk1-5F8phk8JxqZZfYxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4txuvyT7Ldn5113w2I8vURUglpJdnFP_9EXjyA-W0Lug&oe=6A07149E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC - Basic Safety", "keywords": ["vr", "hvac", "basic", "safety", "immerselearn"], "long_description": "HVAC Basic Safety is part of the Immerse Learn HVAC Basic Safety Micro-Credential Program and is accessible only to individuals enrolled in the program. This immersive VR simulation delivers hands-on training in essential safety practices for HVAC environments. Learners can practice proper use of personal protective equipment (PPE), identify workplace hazards, operate fire extinguishers, and follow safe tool handling procedures. The app also reinforces emergency response protocols and safety compliance in a controlled, risk-free setting. Designed to align with industry standards, HVAC Basic Safety helps participants build strong safety awareness, improve practical skills, and gain confidence before working in real-world HVAC environments. Access is restricted to enrolled users for their hands-on training.", "short_description": "HVAC Basic Safety is a VR training app developed as part of the Immerse Learn HVAC Basic Safety Micro-Credential Program. Available exclusively to enrolled participants, it provides hands-on training in PPE usage, hazard identification, fire safety, and safe tool handling in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
QOtIWGD7KPGjq2_c5CTpepvV1jqyDZBVlQEsCENvSm7entH0ORGYcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUeuuYqzqjrzHyQgQcnCLT_J-6b_ukvvPMxsWB5K5Uxg&oe=6AFDDA51"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160405.png", "id": "3067343813450789", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823968_3067343816784122_4583456138103477937_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTOHWrZZIC4Q7kNvwFRgco4&_nc_oc=AdoutlfU4zW81zsqZ2u3J0aViPgW6-VSWMvYL6gDia9ThG7VJvY2p-Vo6Tik0cG-Gfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBCrDik61Td5HSeH0tLgX24r5d17vXYPJrrNGlBz1i7Q&oe=6AFDD7E0"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160550.png", "id": "912802351755469", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618937_912802358422135_7496864192364062935_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D315ZsuDl3AQ7kNvwGrctcL&_nc_oc=AdqdEZ94DPUWHPViYxjCf6VeP6wWnsEmq69TJqyVW2ffyLoV2BEw_TVEmG3zX_J4FzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6ddXrEKQSR2GDgMfTFVB6r47fBVe8KG_Q8GYMaYHNRQ&oe=6AFDD55E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC - Basic Safety", "keywords": ["vr", "hvac", "basic", "safety", "immerselearn"], "long_description": "HVAC Basic Safety is part of the Immerse Learn HVAC Basic Safety Micro-Credential Program and is accessible only to individuals enrolled in the program. This immersive VR simulation delivers hands-on training in essential safety practices for HVAC environments. Learners can practice proper use of personal protective equipment (PPE), identify workplace hazards, operate fire extinguishers, and follow safe tool handling procedures. The app also reinforces emergency response protocols and safety compliance in a controlled, risk-free setting. Designed to align with industry standards, HVAC Basic Safety helps participants build strong safety awareness, improve practical skills, and gain confidence before working in real-world HVAC environments. Access is restricted to enrolled users for their hands-on training.", "short_description": "HVAC Basic Safety is a VR training app developed as part of the Immerse Learn HVAC Basic Safety Micro-Credential Program. Available exclusively to enrolled participants, it provides hands-on training in PPE usage, hazard identification, fire safety, and safe tool handling in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26696015896682149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620497_963661216253489_5617092118121632652_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bu_qis7xbu0Q7kNvwEMvuud&_nc_oc=Adofb-d9gdufWvYtv1XBUwQNLyGNBqvhp1ZYkYkssH6-_tzfUAI0r96c46GdTGNiUgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZzD0KkpYnCFBWraBHqY6Ik1QZc-EtxVSJnixxAjh-Ww&oe=6AFDBCCB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
oKeSmlHacjyrECa2Em6vfln5DWBsZxxPQoYrNxbN4I0gd_NFnlljkw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw52gF6MgCo6MBcDoEQ1M7CdY2zVyg9ITKwsw9ELeiNw&oe=6B086651"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160405.png", "id": "3067343813450789", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823968_3067343816784122_4583456138103477937_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyf7ocSL6LIQ7kNvwHgWdEA&_nc_oc=AdrWsm3iXwzTrJf0oDmvBQ842vVMMVBZh_4QUViUOCB5AZBEIvphsfnJtbLyq7JjSKY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzaL_LVwWM1SrSVVQBmeIGewOspXDvYVXQy9JNZwusTg&oe=6B0863E0"}, {"file_name": "com.medvr.HVAC_Basic_Safety_M-20260421-160550.png", "id": "912802351755469", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618937_912802358422135_7496864192364062935_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bneEZmPHdEUQ7kNvwHT0jN3&_nc_oc=AdrWcZtfejJcpOIeQWzyRg_NkCM-luL8xbWmSX24BEGt_Yz4A049NQfs-WdIRMQdLiY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTe1n18RaeM4x2EtJtBk8a4ufUzoldTx-9WBPGKCHN6tw&oe=6B08615E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC - Basic Safety", "keywords": ["vr", "hvac", "basic", "safety", "immerselearn"], "long_description": "HVAC Basic Safety is part of the Immerse Learn HVAC Basic Safety Micro-Credential Program and is accessible only to individuals enrolled in the program. This immersive VR simulation delivers hands-on training in essential safety practices for HVAC environments. Learners can practice proper use of personal protective equipment (PPE), identify workplace hazards, operate fire extinguishers, and follow safe tool handling procedures. The app also reinforces emergency response protocols and safety compliance in a controlled, risk-free setting. Designed to align with industry standards, HVAC Basic Safety helps participants build strong safety awareness, improve practical skills, and gain confidence before working in real-world HVAC environments. Access is restricted to enrolled users for their hands-on training.", "short_description": "HVAC Basic Safety is a VR training app developed as part of the Immerse Learn HVAC Basic Safety Micro-Credential Program. Available exclusively to enrolled participants, it provides hands-on training in PPE usage, hazard identification, fire safety, and safe tool handling in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26696015896682149"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620497_963661216253489_5617092118121632652_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoMzQFwIVc8Q7kNvwGLzY1x&_nc_oc=AdpKnk6HrLow13NyZ-1WK3vRTlhw1M6ixYVbjcEznoljLF3bmp7ZIWi9_rE93zh2p2M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTXdiD9x_6tdtfcD0OBhw75prVTGO7GHKhdDWL2qDLDA&oe=6B0848CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fa
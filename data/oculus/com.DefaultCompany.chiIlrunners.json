ll here in this game so hop in now!\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude01\ud83d\ude01", "short_description": "This is a vr game i made to Have fun with my friends its the first game i ever made and i hope there will be active players! you can go around the game hub and have fun playing diffrent modes"}]}, "developer_name": "Chill organization", "developer_privacy_policy_url": "https://sites.google.com/view/chill-runners-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chill organization", "support_website_url": null, "website_url": "https://sites.google.com/view/chillrunnersvrgame/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8129956807036094"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "978536863444758"}]}, "baseline_offer": {"id": "978536863444758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1718820008, "status": "PUBLISHED", "id": "978536863444758"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8199095616788879", "version": "3.7"}, "id": "798486632227824", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "
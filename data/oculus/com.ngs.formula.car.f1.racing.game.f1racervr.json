": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_1173963921384684_4708848820569707339_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVrkaZBidU4Q7kNvwEUeDLz&_nc_oc=AdqfEbleSaFNru1YSUFLfQZ36i_ZCrpX6-BD7hH5mLguOtQgv08JduvDMvo8QZFfVMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmspu71TcUjq206GZKQspQWO8e7Evgw-T3mspCqLOZ0g&oe=6ACA58C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "F1 Racer VR - Formula Car Racing Game", "keywords": [], "long_description": "F1 Racer VR - Formula Car Racing Game delivers the ultimate Formula racing thrill in VR. Step into the driver\u2019s seat of powerful track cars and experience speed like never before. Every race challenges your reflexes with sharp corners, fast straights, and dynamic circuits designed to keep you on the edge.\nThe game brings realistic controls and immersive views that make you feel truly inside the cockpit. Whether you are chasing lap records or battling for first place, the intensity of real racing is always there. With stunning visuals, responsive handling, and an authentic track-side atmosphere, Formula Racer is built for players who love pure high-speed competition.\nTake on time trials, practice sessions, or full races as you sharpen your driving skills. Push harder, drive faster, and prove yourself as the ultimate Formula racer. This is not just a game, it is a complete VR racing experience that puts you right at the heart of the action.\n\nFeatures:\nRealistic VR driving controls and handling\nImmersive cockpit view with dynamic track environments\nChallenging circuits with sharp turns and high-speed straights\nMultiple race modes including time trials and full races\nStunning visuals and responsive gameplay designed for VR\nThe true thrill of Formula car racing brought to life", "short_description": "Step into high-speed Formula racing in VR. Drive open-wheel race cars, sit inside a fully immersive cockpit, and compete on professional-style circuits. Feel realistic handling, intense speed, and competitive Formula-style racing built exclusively for Pro racing lovers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/namigamesstudio/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nami Games Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/namigamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25305974155678341"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1414198440918333"}, {"status": "PUBLISHED", "id": "1632989684911379"}, {"status": "PUBLISHED", "id": "4741858502715358"}, {"status": "PUBLISHED", "id": "1338679011566078"}, {"status": "PUBLISHED", "id": "2150031445755942"}, {"status": "PUBLISHED", "id": "1464218442117430"}, {"status": "PUBLISHED", "id": "2722945184747868"}, {"status": "PUBLISHED", "id": "1810083099676177"}, {"status": "PUBLISHED", "id": "1155357113431981"}, {"status": "PUBLISHED", "id": "2225890754555360"}]}, "baseline_offer": {"id": "2225890754555360"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1414198440918333"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "Andr
1968841070680881_7687470928648812705_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuPu32-Y-WcQ7kNvwGWceT9&_nc_oc=AdowvVy5g0hKKpvT-qSNgx1OzjOSVGUqRrsh0cAKnIKOAwsZtDg6HEs6qhkxrZT_FYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2ZfYlCaHYDOMFYx81ErI89y7BJtP3FnEwCu_qElKkow&oe=6A6F5C12"}, {"file_name": "Screenshot_2.png", "id": "2388239474978227", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819239_2388239478311560_3809275056944812631_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dckVqy5joxgQ7kNvwEkEDdA&_nc_oc=Adq5a_5JVfSxugmqDm8ryDsy8s2nBHn1n_ZnW9Vapp9cLdD_7SmrQG4nX4hzGsKmz24&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgtpkvQdKaYiVK46lUG7QRnJTgrtc_SU30QOCfEywk9g&oe=6A6F3C3C"}, {"file_name": "Screenshot_3.png", "id": "1400303318497836", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823351_1400303321831169_8419977929791246371_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1Hgozqkr4sQ7kNvwFAn1yZ&_nc_oc=Adpx6uhJs_H4aiuuC_FY8Ut-mbw5cArTza-IMmKtqpMfiP7ag4iX1_ya9_AJlugKO2Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTVBm3ODxwv4_BU5F9fLLn08VH3UMQcGcxsXVciRmB_Q&oe=6A6F2A68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Farming Simulator VR Tractor Simulator", "keywords": ["VRFarmingSimulator", "TractorSimulator", "FarmLifeVR", "FarmingGameVR", "VirtualRealityFarming"], "long_description": "Step into the ultimate VR farming experience with Farming Simulator VR Tractor Simulator! Drive powerful tractors, cultivate your fields, and manage your farm like a real farmer\u2014all in fully immersive virtual reality. Plant crops, harvest them, and transport your goods across expansive farmlands, experiencing the satisfaction of hard work in stunning 3D environments.\nCustomize your tractors, upgrade your equipment, and unlock new vehicles as you grow your farm from a small plot into a thriving agricultural empire. Whether you\u2019re a casual player or a farming simulation enthusiast, this game offers realistic tractor driving, farming mechanics, and VR immersion that makes every task feel lifelike.\nBuild, manage, and explore your farm world while enjoying realistic physics, interactive controls, and a true sense of presence in VR. From plowing fields to harvesting crops and driving tractors across your land, every action puts you in the heart of the farming life.\nGet ready to experience VR farming like never before. Your tractors, your farm, your virtual reality adventure awaits!\n\n\u2705 Key Features Highlighted in the Description\nRealistic tractor driving in VR\n\n\nCrop planting, harvesting, and farm management\n\n\nCustomizable tractors and equipment\n\n\nExpansive farm world to explore\n\n\nImmersive VR controls and interactions", "short_description": "Drive powerful tractors, grow crops, and experience realistic farming in immersive virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25663708159976866"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLIS
t_3.png", "id": "10004620822999789", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499301236_10004620829666455_5317452387762875690_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foM4Kh0dKK0Q7kNvwEi4P1d&_nc_oc=AdqMv54qWbSv4wwqucHHB5KTHXOuXurtsBz03_7JLfxVnWDzsTIRXb4h0ZIHd0_K1Hs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTtvwXBfQfFnCAW4uFFRdyEG6v_hP0d_lt5u_jj8Cz8w&oe=6A8D771D"}, {"file_name": "EmojiClashVR_ScreenShot_4.png", "id": "734016502926398", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491830890_734016509593064_2356572165511347318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mr694MajnF0Q7kNvwHCuavv&_nc_oc=AdoY3_cPQIhflRDy7rViV7EZHt9W0OqkWc3Nef5xNsQVD2bFoTNjBu4kaeZ4z7qk8ss&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6SS12DopFtdoeIHqsWumWUmc3dwRQUru4KMNfBl-8dg&oe=6A8D6A72"}, {"file_name": "EmojiClashVR_ScreenShot_5.png", "id": "724232673743727", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830812_724232677077060_6249394725798894661_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0el15nSHRsQ7kNvwGgVqeN&_nc_oc=Adp_gahnyacsxCl1wc9aXK-I_Ti4Q-QKLXgtupayNTmhPJ1LOtESqgqcCzNidx14T5Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxLX-88hyPa_q26TqzixzMPmjakMZXh0UhZd6pe6ZDCw&oe=6A8D7630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmojiClashVR_2560-1440_10.png", "id": "1466636144521935", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830613_1466636147855268_3213197742003758115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZfvIvvJ3LD8Q7kNvwGIs4Ra&_nc_oc=AdrWpruCwXouu5zezhYzMuLnJquOivOo5f8lOWurTpIRLOe7NirqQqSkDm2lBjWy1uE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY1O-T73KWMin0pWy-L_i0dmWAPWwekFHmdyxB4l5vcA&oe=6A8D7E4D"}, "display_name": "Emoji Clash VR", "keywords": ["Emoji", "Billiard", "Pool", "Bowling", "Action"], "long_description": "# \ud83e\udd23 Be the Emoji\n\nEmoji Clash VR is a thrilling VR action game where you become a colorful Emoji Ball battling across islands in the sky.\n\n# \ud83c\udfaf Physics-Fueled Showdowns\n\nLine up your shots and slam rival Emoji Balls off the edge. Every move counts. Bank shots, precision angles, and smart pushes are your weapons in this VR-powered duel of wits.\n\n{715619941358634}\n\n# \ud83c\udf0c Dynamic Sky Arenas\n\nBattle across islands with shifting platforms, tricky obstacles, and death-defying drops. Learn the terrain. Master the traps.\n\n# \ud83d\ude08 Fight Dangerous Enemies\n\nFace off against Bomb Enemies that explode with massive force, or Needle Enemies that punish you for careless contact. Expect chaos and surprises at every stage.\n\n{1920877891786040}\n\n# \u26a1 Unleash Epic Power-Ups\n\nGrab game-changing power-ups like lightning attacks and energy beams before your enemies can.\n\n# \ud83d\ude80 Level Up and Dominate\n\nGain experience by knocking enemies into the stage\u2019s black hole to increase your attack power and speed for future battles.\n\n{2191517354658721}", "short_description": "Emoji Clash VR is a thrilling VR action game where you become a colorful Emoji Ball battling across islands in the sky."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/emoji-clash-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/emoji-clash-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
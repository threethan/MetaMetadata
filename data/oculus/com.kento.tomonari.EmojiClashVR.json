762875690_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAtY0g1S1XwQ7kNvwHe1hrQ&_nc_oc=Adqeex3uPu6xxfzbvktNFMlm_rrG1yv8Qd62cn3U9wAI2Yg1zHrwBS5vxqhKS770738&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af764eNBMU5etOfbx4-eufsDGncWCyHyBc3gj3XB_ScjgQ&oe=69FB58DD"}, {"file_name": "EmojiClashVR_ScreenShot_4.png", "id": "734016502926398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830890_734016509593064_2356572165511347318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cOO8kAxyUQQ7kNvwHuTUqZ&_nc_oc=AdrOJMhxETHSjZenYIgfq_zStnBTkWELYuIOx3YRI3FMOe2-8oSJWlKJiFJ_4LecHt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y8eo3olJ7mMm6WCAVFzz2UPwVa9gLE1MP_ZLZlz4gqw&oe=69FB4C32"}, {"file_name": "EmojiClashVR_ScreenShot_5.png", "id": "724232673743727", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830812_724232677077060_6249394725798894661_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYux5tQg_A0Q7kNvwGy7gRg&_nc_oc=AdpQFmY7vVqkAU5cpUvxb8-HoHKv4DtRriUJO1Xw3V636nh6I97Zp1QmtGQV7S0d5n4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YlYlkXwoBiIc48D8DLyKLMt24gmRgE4KZcL1MHVIRrg&oe=69FB57F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmojiClashVR_2560-1440_10.png", "id": "1466636144521935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830613_1466636147855268_3213197742003758115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XM9VnodfgQgQ7kNvwEJ-sdG&_nc_oc=AdoebBkCeoTYtV4ikeD3b6zXpIq8xbVTAiTsIJmXwV7Wht-qYYHDws1PV2BvEqErOoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LbKDybt0UJA_Yt2aBEG2sjpD4BS16cIDps_Esv9XI6Q&oe=69FB27CD"}, "display_name": "Emoji Clash VR", "keywords": ["Emoji", "Billiard", "Pool", "Bowling", "Action"], "long_description": "# \ud83e\udd23 Be the Emoji\n\nEmoji Clash VR is a thrilling VR action game where you become a colorful Emoji Ball battling across islands in the sky.\n\n# \ud83c\udfaf Physics-Fueled Showdowns\n\nLine up your shots and slam rival Emoji Balls off the edge. Every move counts. Bank shots, precision angles, and smart pushes are your weapons in this VR-powered duel of wits.\n\n{715619941358634}\n\n# \ud83c\udf0c Dynamic Sky Arenas\n\nBattle across islands with shifting platforms, tricky obstacles, and death-defying drops. Learn the terrain. Master the traps.\n\n# \ud83d\ude08 Fight Dangerous Enemies\n\nFace off against Bomb Enemies that explode with massive force, or Needle Enemies that punish you for careless contact. Expect chaos and surprises at every stage.\n\n{1920877891786040}\n\n# \u26a1 Unleash Epic Power-Ups\n\nGrab game-changing power-ups like lightning attacks and energy beams before your enemies can.\n\n# \ud83d\ude80 Level Up and Dominate\n\nGain experience by knocking enemies into the stage\u2019s black hole to increase your attack power and speed for future battles.\n\n{2191517354658721}", "short_description": "Emoji Clash VR is a thrilling VR action game where you become a colorful Emoji Ball battling across islands in the sky."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/emoji-clash-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/emoji-clash-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"]
png", "id": "10004620822999789", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499301236_10004620829666455_5317452387762875690_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aiccn6pboscQ7kNvwGNVCm7&_nc_oc=AdrECtNPjBc5oJMKKOTx7imqsVMEMdIMt5vFM4SMos_M5vKccEUy49QpSHGN5zPl51I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W4AEjt9v4V5ldKNrSp8THlYqln8cjxZdj2ODMyjManA&oe=6A36AC5D"}, {"file_name": "EmojiClashVR_ScreenShot_4.png", "id": "734016502926398", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830890_734016509593064_2356572165511347318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of3kHWc441AQ7kNvwGlCkKY&_nc_oc=AdopHEaYTuxpkyLpYa-TZCj0gcwKEijsCqFDxudRdFE2ghdevT4bU64TGU9z4uy7Dmg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_MTSqwQCAdaGyrbJtg51jMdaZA_jKlzxGrhHyvwVe3w&oe=6A369FB2"}, {"file_name": "EmojiClashVR_ScreenShot_5.png", "id": "724232673743727", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830812_724232677077060_6249394725798894661_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8DbwwjUk6cQ7kNvwEctfMQ&_nc_oc=AdpgOYH6sjPn0WrAcSlk298ryyGeedwpDP-5XR6joghFehtQ07W95bQf-EE1oMuR15Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hNUHdDLolz-DPnWbFhWewARai0KvdR_oBxH1HYfs0qA&oe=6A36AB70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmojiClashVR_2560-1440_10.png", "id": "1466636144521935", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830613_1466636147855268_3213197742003758115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnO4ZXTUuXAQ7kNvwGqeTZz&_nc_oc=AdqkCeecNlqt8ONtNM_CLcZmMDpmnet2au_ae66rMMgQcORIG7idvkUrwbgQE5OSx6E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I21VFd1UEYlnbTlmVlOAa0LnACaid-5OOW8DcwLgdsQ&oe=6A36B38D"}, "display_name": "Emoji Clash VR", "keywords": ["Emoji", "Billiard", "Pool", "Bowling", "Action"], "long_description": "# \ud83e\udd23 Be the Emoji\n\nEmoji Clash VR is a thrilling VR action game where you become a colorful Emoji Ball battling across islands in the sky.\n\n# \ud83c\udfaf Physics-Fueled Showdowns\n\nLine up your shots and slam rival Emoji Balls off the edge. Every move counts. Bank shots, precision angles, and smart pushes are your weapons in this VR-powered duel of wits.\n\n{715619941358634}\n\n# \ud83c\udf0c Dynamic Sky Arenas\n\nBattle across islands with shifting platforms, tricky obstacles, and death-defying drops. Learn the terrain. Master the traps.\n\n# \ud83d\ude08 Fight Dangerous Enemies\n\nFace off against Bomb Enemies that explode with massive force, or Needle Enemies that punish you for careless contact. Expect chaos and surprises at every stage.\n\n{1920877891786040}\n\n# \u26a1 Unleash Epic Power-Ups\n\nGrab game-changing power-ups like lightning attacks and energy beams before your enemies can.\n\n# \ud83d\ude80 Level Up and Dominate\n\nGain experience by knocking enemies into the stage\u2019s black hole to increase your attack power and speed for future battles.\n\n{2191517354658721}", "short_description": "Emoji Clash VR is a thrilling VR action game where you become a colorful Emoji Ball battling across islands in the sky."}]}, "developer_name": "Odd Team XR Studios", "developer_privacy_policy_url": "https://odd-team-xr.com/emoji-clash-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/emoji-clash-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
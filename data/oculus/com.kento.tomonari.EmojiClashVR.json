_ohc=_jmF2NQTGxsQ7kNvwG1jO5x&_nc_oc=Adrb_HzeVfOTGwkrStd06jqVghtzQX1_hMJNNusFbo3CpHu8MfWwDSlSOCug1ivrp2U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Lj-VBNg7MmOtCBvDrIK3LvXSOo7sWLWS2IVvYX7oF_w&oe=6A11B5B2"}, {"file_name": "EmojiClashVR_ScreenShot_5.png", "id": "724232673743727", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830812_724232677077060_6249394725798894661_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoBH6StjKhoQ7kNvwGF-a1o&_nc_oc=AdrMrKhrGcyh5f30xFk8_4DS7j8Q0y3xCtZY7EQUo1ug6onP_X65LQzTr9n7qQIAZNg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51ySvVRAGtL5rlyhF_f-o1UNVFUcv6Wj-y0XGLlkUZsQ&oe=6A11C170"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "EmojiClashVR_2560-1440_10.png", "id": "1466636144521935", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830613_1466636147855268_3213197742003758115_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmG2GoqMEtoQ7kNvwGdQ0Wh&_nc_oc=Adr4T5ZTU_SEj0jtB13iSX-dKExI9FizMoK_CUtNIBYRr2zhSFINt7TK-zvz4VGRkuw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qmSs-SKFWE_qkv0HbWG2eg3Oa3PWKzcdnuTQ5F4UCEQ&oe=6A11C98D"}, "display_name": "Emoji Clash VR", "keywords": ["Emoji", "Billiard", "Pool", "Bowling", "Action"], "long_description": "# \ud83c\udf89 Be the Emoji\n\nEmoji Clash VR is a thrilling VR action game where you become a colorful Emoji Ball battling across islands in the sky.\n\n# \ud83c\udfaf Physics-Fueled Showdowns\n\nLine up your shots and slam rival Emoji Balls off the edge. Every move counts. Bank shots, precision angles, and smart pushes are your weapons in this VR-powered duel of wits.\n\n{715619941358634}\n\n# \ud83c\udf0c Dynamic Sky Arenas\n\nBattle across islands with shifting platforms, tricky obstacles, and death-defying drops. Learn the terrain. Master the traps.\n\n# \ud83d\ude08 Fight Dangerous Enemies\n\nFace off against Bomb Enemies that explode with massive force, or Needle Enemies that punish you for careless contact. Expect chaos and surprises at every stage.\n\n{1920877891786040}\n\n# \u26a1 Unleash Epic Power-Ups\n\nGrab game-changing power-ups like lightning attacks and energy beams before your enemies can.\n\n# \ud83d\ude80 Level Up and Dominate\n\nGain experience by knocking enemies into the stage\u2019s black hole to increase your attack power and speed for future battles.\n\n{2191517354658721}", "short_description": "Emoji Clash VR is a thrilling VR action game where you become a colorful Emoji Ball battling across islands in the sky."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odd-team-xr.com/emoji-clash-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/emoji-clash-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24133415326321942"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1500717437739092"}, {"status": "PUBLISHED", "id": "2722987078044849"}, {"status": "PUBLISHED", "id": "1847545692520520"}]}, "baseline_offer": {"id": "1847545692520520"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1500717437739092"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_res
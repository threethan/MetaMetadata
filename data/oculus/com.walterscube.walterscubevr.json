ld and move around the gallery spaces exactly as you can when you're actually there.\n\nNever miss a show again\nIn Tokyo but want to walk through a show in New York? Or really wanted to see one but it has ended already? No problem. Access exhibitions online anytime, anywhere.\n\nMultiplatform\nWorks on any platform, on any device, so you can enjoy an exhibition anytime, anywhere.", "short_description": "Explore our catalogue of gallery and museum exhibitions. Find shows that interest you and discover amazing contemporary art paintings, photography, sculptures and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.walterscube.com/privacy-policy", "developer_terms_of_service_url": "http://www.walterscube.com/user-terms-and-conditions", "publisher_name": "VR Space Holdings Inc.", "support_website_url": null, "website_url": "https://www.walterscube.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1105477026868485"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12448944_167252047393066_1309592810529226752_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YezuJldW2j8Q7kNvwHeh5UF&_nc_oc=AdqfiFxghiHbnFzBGQmEuycPFm5XzyT2LQAoHRj4STBqUCVc72e5e057N7EnvmTuhnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ipB9PUogPDXW7YdG4Z07oVcbhXEbh52kQdDzfE0wbJQ&oe=69D8F3BB"}, "is_concept": false, "is
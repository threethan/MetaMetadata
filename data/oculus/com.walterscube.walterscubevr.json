ntemporary", "exhibition"], "long_description": "Visit exhibitions\nImmerse yourself in the experience of art with our innovative technology. Visit exhibitions and walk through them as if you were actually there in the space.\n\nReal galleries, real exhibitions\nExperience actual exhibitions from around the world and move around the gallery spaces exactly as you can when you're actually there.\n\nNever miss a show again\nIn Tokyo but want to walk through a show in New York? Or really wanted to see one but it has ended already? No problem. Access exhibitions online anytime, anywhere.\n\nMultiplatform\nWorks on any platform, on any device, so you can enjoy an exhibition anytime, anywhere.", "short_description": "Explore our catalogue of gallery and museum exhibitions. Find shows that interest you and discover amazing contemporary art paintings, photography, sculptures and more!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.walterscube.com/privacy-policy", "developer_terms_of_service_url": "http://www.walterscube.com/user-terms-and-conditions", "publisher_name": "VR Space Holdings Inc.", "support_website_url": null, "website_url": "https://www.walterscube.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1105477026868485"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12448944_167252047393066_1309592810529226752_n.png?st
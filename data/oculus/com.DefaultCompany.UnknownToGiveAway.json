ler": null, "video_trailer_thumbnail": null, "display_name": "ScaryBaboon Enhanced", "keywords": [], "long_description": "ScaryBaboon Enhanced is an immersive VR multiplayer horror game set inside a mysterious abandoned underground facility. Once a place of research and experimentation, it has now become home to terrifying creatures that roam the dark corridors. Every hallway hides danger, and every sound could attract something lurking nearby.\n\nExplore laboratories, maintenance tunnels, storage areas, and hidden rooms as you search for a way to survive. Work together with friends or face the nightmare alone. Stay alert, manage your surroundings, and use stealth when needed. Sometimes running is your only option, while other times hiding is the only way to stay alive.\n\nEach session offers unpredictable encounters, tense chase sequences, and new challenges as you uncover the secrets buried deep within the facility. Keep exploring to find hidden areas and discover what happened before everything was abandoned.\n\nFeatures:\n\u2022 Immersive VR horror gameplay.\n\u2022 Online multiplayer with friends.\n\u2022 Large abandoned facility to explore.\n\u2022 Unique monsters with different behaviors.\n\u2022 Intense chase and stealth mechanics.\n\u2022 Hidden rooms and environmental secrets.\n\u2022 Atmospheric lighting and sound design.\n\u2022 Regular updates with new content and improvements.\n\nCan you survive the horrors hidden within the facility and escape before it's too late?", "short_description": "You are in a abandoned facility, but you are not alone.... Run away from the monsters, or hide! the fun never stops!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scarybaboon-enhanced-privacy-p?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "plava", "support_website_url": null, "website_url": "https://sites.google.com/view/scarybaboon-enhanced-privacy-p?usp=sharing", "category": null, "comfort_rat
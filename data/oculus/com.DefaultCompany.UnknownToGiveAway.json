_zi-R5qPBH2A1DyWgQyqaEllmHFJDEdjKORABILmAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr0YXifg4k6XFIaE5TtGj_SClldVoIXbADIr9HvmIoVA&oe=6ADE0B93"}, {"file_name": "Lab_Custom..._28.07.2026_17-50-48.png", "id": "27675580198789179", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/585741071_27675580215455844_7608916202389957847_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_goIK5jEWgYQ7kNvwEdlTpy&_nc_oc=Adqo5tgqRZp3PNwLpWE5RtS-zIS0Pnd5cRe2hDkYddLi15L3xodaXedKkHCVs8X4EoI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8kmvZuFWgqEQwc2PTotc1D9kMY-00g-Ym13Nqjzn-UA&oe=6ADE1717"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ScaryBaboon Enhanced", "keywords": [], "long_description": "ScaryBaboon Enhanced is an immersive VR multiplayer horror game set inside a mysterious abandoned underground facility. Once a place of research and experimentation, it has now become home to terrifying creatures that roam the dark corridors. Every hallway hides danger, and every sound could attract something lurking nearby.\n\nExplore laboratories, maintenance tunnels, storage areas, and hidden rooms as you search for a way to survive. Work together with friends or face the nightmare alone. Stay alert, manage your surroundings, and use stealth when needed. Sometimes running is your only option, while other times hiding is the only way to stay alive.\n\nEach session offers unpredictable encounters, tense chase sequences, and new challenges as you uncover the secrets buried deep within the facility. Keep exploring to find hidden areas and discover what happened before everything was abandoned.\n\nFeatures:\n\u2022 Immersive VR horror gameplay.\n\u2022 Online multiplayer with friends.\n\u2022 Large abandoned facility to explore.\n\u2022 Unique monsters with different behaviors.\n\u2022 Intense chase and stealth mechanics.\n\u2022 Hidden rooms and environmental secrets.\n\u2022 Atmospheric lighting and sound design.\n\u2022 Regular updates with new content and improvements.\n\nCan you survive the horrors hidden within the facility and escape before it's too late?", "short_description": "You are in a abandoned facility, but you are not alone.... Run away from the monsters, or hide! the fun never stops!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scarybaboon-enhanced-privacy-p?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "plava", "support_website_url": null, "website_url": "https://sites.google.com/view/scarybaboon-enhanced-privacy-p?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1294897483703022"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824671_1918015455560284_3364753310586020764_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jA_yZJ-FjNAQ7kNvwFgwjhF&_nc_oc=AdpX89qLvHr6noGj3WgPNMuSkKSdN6io66jACCSYS2vx-930_OK6hhySD2A5_BFKec0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVBTYPxzaNh9lkrFViWNYhXWTdlCM6KOCvupdzhtQe0Q&oe=6ADE03A7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ScaryBaboon Enhanced", "platform": "ANDROID_6DOF", "context_catego
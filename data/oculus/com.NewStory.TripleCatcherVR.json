n.com/v/t64.5771-25/473391906_645825667909541_8544279678696499094_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFk5zT-f9M4Q7kNvwHcGLq3&_nc_oc=Adp5UeczFUWLP4PxYNupPwFGlJNOz7wegBzEwJsL_YACltaQN9KXkspQutPB5q7XnOA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlIW9D1dySzgYFg7bbABJBfi76IBJrDE1gFIgMg4QZRA&oe=6A5E0F17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_2560x1440.png", "id": "634679932543165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393762_634679935876498_5391485940764890199_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7mPChdm7GYQ7kNvwHXwhHW&_nc_oc=AdrRHCdBUxIkpx5wXxxeoIh2dkz-J0PAHaZQ15rzZP8YP6DU7vGCt8PjGkLVfALrjE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxP9HbRgvZxivLMhLOUsTV_zDbrtfXui27lnjuE5nMNw&oe=6A5E0653"}, "display_name": "Claw Crane Simulator", "keywords": ["claw", "crane", "simulator", "Arcade", "Prize"], "long_description": "Get ready for the most INSANE crane game experience! Claw Crane Simulator throws you into a world of explosive fun where you can grab the craziest prizes imaginable. We're talking smartphones hidden in TNT, piles of cold, hard cash, and even creepy crawly spiders!\n\n**Here's what makes Dynamite Crane a must-play:**\n\n- Explosive Prize Variety: Dig through dynamite to find hidden gadgets, scoop up stacks of cash, and face your fears with giant spiders.\n- Gun-Grabbing Action: Win a variety of firearms from the crane and test your aim in a thrilling shooting gallery.\n- No Limits, No Pressure: Enjoy endless crane action without worrying about game overs or grinding for in-game currency.\n\nDive into the chaotic world of Claw Crane Simulator and unleash your inner crane master!\n", "short_description": "Get your hands on smartphones, piles of cash, creepy spiders, and even guns hidden in TNT in this crazy, hands-off crane game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypo
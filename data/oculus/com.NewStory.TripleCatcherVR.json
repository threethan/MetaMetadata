v/t64.5771-25/473393762_634679935876498_5391485940764890199_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adpP4sKE-aUQ7kNvwGxh-OG&_nc_oc=AdqBQu8qZ5ve4T1OLNe4Kg0njFBAm1p17uHkbbIErOkRB0ccm6R7U34CJm6eVlNKgQ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7kHCAJP3JrBwlU8uofuB-MYET1hNgXjooQ5ZohqV_fw&oe=69C3C6D3"}, "display_name": "Claw Crane Simulator", "keywords": ["claw", "crane", "simulator", "Arcade", "Prize"], "long_description": "Get ready for the most INSANE crane game experience! Claw Crane Simulator throws you into a world of explosive fun where you can grab the craziest prizes imaginable. We're talking smartphones hidden in TNT, piles of cold, hard cash, and even creepy crawly spiders!\n\n**Here's what makes Dynamite Crane a must-play:**\n\n- Explosive Prize Variety: Dig through dynamite to find hidden gadgets, scoop up stacks of cash, and face your fears with giant spiders.\n- Gun-Grabbing Action: Win a variety of firearms from the crane and test your aim in a thrilling shooting gallery.\n- No Limits, No Pressure: Enjoy endless crane action without worrying about game overs or grinding for in-game currency.\n\nDive into the chaotic world of Claw Crane Simulator and unleash your inner crane master!\n", "short_description": "Get your hands on smartphones, piles of cash, creepy spiders, and even guns hidden in TNT in this crazy, hands-off crane game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
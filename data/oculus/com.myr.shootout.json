029844051711545_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9fHq9GkbosQ7kNvwFCSmCB&_nc_oc=AdoISL_pOAT6EW1mRy6dTlV-uTkWjwJvD73ddzGki6cxRejriwgrfvFUI51xSVDIH8o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyaU4zvAD42uV0HJ6YryWqj4QPEqlfnCEk5PZJqbSMKQ&oe=6AA9406B"}, {"file_name": "Social_Thruster_final.png", "id": "319796260634561", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031350_319796263967894_260876020070870858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6do1rZEneH0Q7kNvwGUH72S&_nc_oc=Ado9BNnr1rD9L7hfuIYDPGwxK1WvIzCuZe81_7aT5OdDjrEzhDTv9xnT8a31iCAWaV0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU59e51U64EOacJMnIiThAS2hbNKaHb4Th3DB59gSmag&oe=6AA95B22"}, {"file_name": "Social_TheBoys_final.png", "id": "857385049094015", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974650_857385055760681_6887887025027059372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVwCHnKMKWYQ7kNvwHzZuaj&_nc_oc=AdpSzSNkJLpS3MyU1mHW9CFVrHWYjl8ZTyfKtOM_TrmEywio8zbdxya3JmtJoey6qL4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgscWd81hZt_dLOFp5TVLzNSjKxNhwJ87jAP9OoZ2phA&oe=6AA93C7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1272252106781035", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974650_1272252110114368_2196436727777597494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTyrIEHocfAQ7kNvwG7tZCj&_nc_oc=AdpxFAVgZznUMe816PDQLuyNDl1O_Ayc4iUvYRxm65or8T7lNREremHq1H1mcqYVSMA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdTYElbPd5LnAX_RhFkl91UyXhR8hXmMs11RZAslGgCA&oe=6AA95A96"}, "display_name": "SHOOTOUT", "keywords": ["free", "social", "multiplayer", "shooter", "arena"], "long_description": "SHOOTOUT is VR multiplayer experience where you become your own hero.\n\nExplore a variety of weapons and modifiers to discover over 1000 unique combinations and abilities to build the loadout that YOU want to play. Change your playstyle and role mid match to adapt quicky to the game and competition. You are one part swap away from becoming a carry, support or mobility hero.\n\nExpress yourself with a catalog of customizables and impose your style on the opposition.\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players.\n\nPlay with friends or battle alone through an expanding playlist of maps and game modes, and prove once and for all..", "short_description": "SHOOTOUT is a free to play multiplayer shooter where you get to build your own weapons and abilities!\n\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players. \n\nStarted off a match wanting to be a support but midway realize that you want to change your playstyle? You would have 19 parts to combine freely that make up over 1000 combinations! "}]}, "developer_name": "MYR", "developer_privacy_policy_url": "https://www.myr.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MYR", "support_website_url": null, "website_url": "https://www.shootoutvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24439816915666599"}, "review_messages": []}]}, "cover_sq
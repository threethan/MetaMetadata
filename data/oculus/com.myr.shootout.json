Secn-Dq3nsfODQ0NsApNp6h7oCRiOm23mXIQF1dqYk0Etns&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4swGsh9hOa6EPGjeJ9Sbi04m_qfYHUW21PfmlaYHGRQ&oe=6AFF34E0"}, {"file_name": "Combat_Towers_final.png", "id": "308092208500250", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210389_308092211833583_7661029844051711545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tio9ngZ-cIQ7kNvwFobjRW&_nc_oc=AdogBCPJtxBMFmbYBy_mlqRNRqq39IhdfhqJ0Vz_8x47cCw4PLhmKoLh3lpuzoImRSs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn5q2xn0OAM4n2-6fiPgCdS7rOA6FReZ5H_Tpg5GftJw&oe=6AFF2A2B"}, {"file_name": "Social_Thruster_final.png", "id": "319796260634561", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031350_319796263967894_260876020070870858_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvDtVVpjHyUQ7kNvwFEXxqD&_nc_oc=AdqeIJ1Bb3XYpa4B6AZTQWroAWr5PyVbbqKEtcgWpn43khMFBtBXhspVOn1IVp7ABo4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv7UNmwGUrFBhDLnvtWjvVE8zkQFMYQTO8zTARkb9MUg&oe=6AFF0CA2"}, {"file_name": "Social_TheBoys_final.png", "id": "857385049094015", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_857385055760681_6887887025027059372_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1bMK2Ko8hMQ7kNvwHP4A9J&_nc_oc=AdrEZuRfVGU4ibFXzQeXM2FIwCIgRbGBukozAIT6kji7eobjGpH0dVNZLgwoV9hHDEI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2J9Q3fhs1uddgnYWIfhyZDOrdtYYQO9ieLhw4n8BB2w&oe=6AFF263E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1272252106781035", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_1272252110114368_2196436727777597494_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7a-7DnjN30Q7kNvwFeNcU5&_nc_oc=AdqrxJaTUxehW2QYSqXbFREJw2WXOTqrqBBB0BbEB5q2rQQw_gkwd2vH02wBzxa90CY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPf4kS2Cn2DKnYNdL5Lb1f6P35rUV12cxsgmeu0rqTYg&oe=6AFF0C16"}, "display_name": "SHOOTOUT", "keywords": ["free", "social", "multiplayer", "shooter", "arena"], "long_description": "SHOOTOUT is VR multiplayer experience where you become your own hero.\n\nExplore a variety of weapons and modifiers to discover over 1000 unique combinations and abilities to build the loadout that YOU want to play. Change your playstyle and role mid match to adapt quicky to the game and competition. You are one part swap away from becoming a carry, support or mobility hero.\n\nExpress yourself with a catalog of customizables and impose your style on the opposition.\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players.\n\nPlay with friends or battle alone through an expanding playlist of maps and game modes, and prove once and for all..", "short_description": "SHOOTOUT is a free to play multiplayer shooter where you get to build your own weapons and abilities!\n\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players. \n\nStarted off a match wanting to be a support but midway realize that you want to change your playstyle? You would have 19 parts to combine freely that make up over 1000 combinations! "}]}, "developer_name": "MYR", "developer_privacy_policy_url": "https://www.myr.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MYR", "support_website_url": null, "website_url": "https://www.shootoutvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
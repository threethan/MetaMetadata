_ohc=7m9iD4tTa4EQ7kNvwFU0G4o&_nc_oc=Adm1pauXv5yKCetcD4jTRAVKwateNvDh7HUUVXXvd7gLZVS3jd2Zb04avcmjqRYN78I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzE9Eut8OLUSGeOE8FSqvPCXLiCcQsenprzR8D2wDTAjw&oe=69B7FDEB"}, {"file_name": "Social_Thruster_final.png", "id": "319796260634561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031350_319796263967894_260876020070870858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qmgRMIian_AQ7kNvwEbww9c&_nc_oc=Adl0MJ_0OQz5_bGfJB66hnYyo9wgvx30x76XggOoY9QDnaYo88Rnm4jhDJjQJ1KJaHU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwv0ld3NUYiAoZXBklPecbERfsney2HROSZtJZSHMiZNw&oe=69B7E062"}, {"file_name": "Social_TheBoys_final.png", "id": "857385049094015", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974650_857385055760681_6887887025027059372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6WAcerZytgQ7kNvwHeWr9G&_nc_oc=Adkxge9WxbAFL8t0-T0kHnbIdhTR8osuU_cD15TvfQeCpUGiqufkqdyL2bud7SuVVzI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz09E8OA5tIYQn3Sid4zkzYIOr1XVchbTBKeuh1pTQE_g&oe=69B7F9FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1272252106781035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_1272252110114368_2196436727777597494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OFpcstPJMYQ7kNvwFi7rBD&_nc_oc=Adlim9mbgOknLHmqV5xwCv0Mk4ulWIrPYysEFofmmLk6UYcEflrwRg_d4sQe9p6y7Es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaEDptS8pMxpT20_fojuspXd-NpNufNSxXl8ok3V9kTQ&oe=69B7DFD6"}, "display_name": "SHOOTOUT", "keywords": ["free", "social", "multiplayer", "shooter", "arena"], "long_description": "SHOOTOUT is VR multiplayer experience where you become your own hero.\n\nExplore a variety of weapons and modifiers to discover over 1000 unique combinations and abilities to build the loadout that YOU want to play. Change your playstyle and role mid match to adapt quicky to the game and competition. You are one part swap away from becoming a carry, support or mobility hero.\n\nExpress yourself with a catalog of customizables and impose your style on the opposition.\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players.\n\nPlay with friends or battle alone through an expanding playlist of maps and game modes, and prove once and for all..", "short_description": "SHOOTOUT is a free to play multiplayer shooter where you get to build your own weapons and abilities!\n\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players. \n\nStarted off a match wanting to be a support but midway realize that you want to change your playstyle? You would have 19 parts to combine freely that make up over 1000 combinations! "}]}, "developer_name": "MYR", "developer_privacy_policy_url": "https://www.myr.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MYR", "support_website_url": null, "website_url": "https://www.shootoutvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24439816915666599"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38
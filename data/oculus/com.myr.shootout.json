zAdxkKyjaclyzaD3A_50wF3mH4lTjfU4FtxZr59iPN4bvFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2rPaCxnQTX4rXisOrLocpgdTkI1U6T2Q7mgnZ-I7wiQ&oe=6AFDE360"}, {"file_name": "Combat_Towers_final.png", "id": "308092208500250", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210389_308092211833583_7661029844051711545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tio9ngZ-cIQ7kNvwEzxZKD&_nc_oc=Adobm9WxpUa7BF5OxITnrtsQVLgXCqPUdnd9RJ4T9Ql6te7JTTjsj9QTW7haLdsf2jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv_fsqan2d6sj88Xv9ceiHw9CaqAUBRHv3JzjUx879aQ&oe=6AFDD8AB"}, {"file_name": "Social_Thruster_final.png", "id": "319796260634561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031350_319796263967894_260876020070870858_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvDtVVpjHyUQ7kNvwERwzdv&_nc_oc=Adpgopxv4FvEYShZOsF7iIlxvMxZOmGQUKp8peCnyNjC7Xv-waDeyw-QJAVuvg0EaA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU6oGsBSVZozZex5Cot05M-JEPuQ-dyQ5iq4RdBqzysQ&oe=6AFDBB22"}, {"file_name": "Social_TheBoys_final.png", "id": "857385049094015", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_857385055760681_6887887025027059372_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttg3MkKVQBcQ7kNvwEi1k6j&_nc_oc=AdpoVRLQTcSCOlntQd-C1-wUX5vZsRyb_kS46WeVTZ4c_0noLGVS93jQWyjdDhYrnlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf7vnXt291Uf_2T5OnnJZPhTICwFw00x-9wLhj2whsVg&oe=6AFDD4BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1272252106781035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_1272252110114368_2196436727777597494_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7a-7DnjN30Q7kNvwFiUl7S&_nc_oc=Adp81U8sIgeFsPxVbBH7W238iMDUGP3I7dvhSlfUvhdZEW5m2WsYuSN03gSvxiYHtOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLA2BBZUsvTRWLAtE4pXcdoCAdvzc3nlIqHiGxZtD4NQ&oe=6AFDBA96"}, "display_name": "SHOOTOUT", "keywords": ["free", "social", "multiplayer", "shooter", "arena"], "long_description": "SHOOTOUT is VR multiplayer experience where you become your own hero.\n\nExplore a variety of weapons and modifiers to discover over 1000 unique combinations and abilities to build the loadout that YOU want to play. Change your playstyle and role mid match to adapt quicky to the game and competition. You are one part swap away from becoming a carry, support or mobility hero.\n\nExpress yourself with a catalog of customizables and impose your style on the opposition.\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players.\n\nPlay with friends or battle alone through an expanding playlist of maps and game modes, and prove once and for all..", "short_description": "SHOOTOUT is a free to play multiplayer shooter where you get to build your own weapons and abilities!\n\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players. \n\nStarted off a match wanting to be a support but midway realize that you want to change your playstyle? You would have 19 parts to combine freely that make up over 1000 combinations! "}]}, "developer_name": "MYR", "developer_privacy_policy_url": "https://www.myr.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MYR", "support_website_url": null, "website_url": "https://www.shootoutvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
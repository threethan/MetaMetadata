ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft6Jjf4MWiKAMpDRLNttRzYCNq_387pCfslVKdA8KSM2g&oe=69A1946B"}, {"file_name": "Social_Thruster_final.png", "id": "319796260634561", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031350_319796263967894_260876020070870858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vRjL3_rFZQQ7kNvwFBLmM2&_nc_oc=Adk-s9_p-8fmXq_AT-558RC_No_ybFzR0ERdFFxI3SMP15dl0HJMAorBYMbb7soQeUY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfshVps_wV7trGYAb1-_QMPtkuRfE7XuoU8Nm0Bbnu-Bcg&oe=69A176E2"}, {"file_name": "Social_TheBoys_final.png", "id": "857385049094015", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974650_857385055760681_6887887025027059372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MOyWtq5ZpsQ7kNvwETw9iS&_nc_oc=Adn6kXQ1lfiNRtPP9txsfgP7UM5HToZFvZoFj_fyKC6c9SrYza6IOYEZyBSegUOvfr0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvj_dzP3wcW27DKpXmwxCNBOOAu9AmORoiSU9_HE8Q-hQ&oe=69A1907E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1272252106781035", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974650_1272252110114368_2196436727777597494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2A-JC-6zisQ7kNvwG82SBP&_nc_oc=Adk8MGeHHjomRGkNg6kl0jin_63qwML_nBR0AzTz2n8ECMOfgctw8ElKwRo6WSFuIos&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsnKxBFGnS920HUERaKG0M8vAHWUVBuUmFQ1EUsIqzalw&oe=69A17656"}, "display_name": "SHOOTOUT", "keywords": ["free", "social", "multiplayer", "shooter", "arena"], "long_description": "SHOOTOUT is VR multiplayer experience where you become your own hero.\n\nExplore a variety of weapons and modifiers to discover over 1000 unique combinations and abilities to build the loadout that YOU want to play. Change your playstyle and role mid match to adapt quicky to the game and competition. You are one part swap away from becoming a carry, support or mobility hero.\n\nExpress yourself with a catalog of customizables and impose your style on the opposition.\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players.\n\nPlay with friends or battle alone through an expanding playlist of maps and game modes, and prove once and for all..", "short_description": "SHOOTOUT is a free to play multiplayer shooter where you get to build your own weapons and abilities!\n\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players. \n\nStarted off a match wanting to be a support but midway realize that you want to change your playstyle? You would have 19 parts to combine freely that make up over 1000 combinations! "}]}, "developer_name": "MYR", "developer_privacy_policy_url": "https://www.myr.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MYR", "support_website_url": null, "website_url": "https://www.shootoutvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24439816915666599"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982453_6986468904726252_6000170085444198997_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fW-pGosMTG4Q7kNvwHTvjdv&_nc_oc=AdlfLaqa
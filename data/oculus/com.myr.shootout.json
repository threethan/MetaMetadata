ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNuwPV2J-11zwvN-dWRmJzyvmwBbpCC8bu6ofihjvMQA&oe=69A042EB"}, {"file_name": "Social_Thruster_final.png", "id": "319796260634561", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031350_319796263967894_260876020070870858_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vRjL3_rFZQQ7kNvwEodNEd&_nc_oc=AdkeHbxEwiFMG_kvFfjVsazDFB7rVTnX5e3Dv4JWQrhWn9cavGnBRVL6DGDUwbJ2Vto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftoqGEU5Eio9JOZM8HdrnZjhvh8eKG3OUpnisi1bx_JVQ&oe=69A02562"}, {"file_name": "Social_TheBoys_final.png", "id": "857385049094015", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974650_857385055760681_6887887025027059372_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MOyWtq5ZpsQ7kNvwGuwEzS&_nc_oc=AdkMbEBG4O_tbjVir2OV1VrGjbisN-33Qtcy9hAXM8XZn5vIP6jqiRXQix4zC78XGSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftUhwWHAfoWmwh1q3djK4FlAuH1y-Ea7n8RMCHDJ9CQNQ&oe=69A03EFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1272252106781035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974650_1272252110114368_2196436727777597494_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fs4EqDxl6IYQ7kNvwFrqflY&_nc_oc=AdkfrXBhKFheZUO-c5Ohhfw-emdov8SSdEfgB9KAvjSTRdHrqRlS2ajNLI4dOPvgRrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7_wNkpFtKzckuI47tPX0Stmw1S7MjJ_e-hA3NvOHD0A&oe=69A024D6"}, "display_name": "SHOOTOUT", "keywords": ["free", "social", "multiplayer", "shooter", "arena"], "long_description": "SHOOTOUT is VR multiplayer experience where you become your own hero.\n\nExplore a variety of weapons and modifiers to discover over 1000 unique combinations and abilities to build the loadout that YOU want to play. Change your playstyle and role mid match to adapt quicky to the game and competition. You are one part swap away from becoming a carry, support or mobility hero.\n\nExpress yourself with a catalog of customizables and impose your style on the opposition.\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players.\n\nPlay with friends or battle alone through an expanding playlist of maps and game modes, and prove once and for all..", "short_description": "SHOOTOUT is a free to play multiplayer shooter where you get to build your own weapons and abilities!\n\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players. \n\nStarted off a match wanting to be a support but midway realize that you want to change your playstyle? You would have 19 parts to combine freely that make up over 1000 combinations! "}]}, "developer_name": "MYR", "developer_privacy_policy_url": "https://www.myr.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MYR", "support_website_url": null, "website_url": "https://www.shootoutvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24439816915666599"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982453_6986468904726252_6000170085444198997_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbHQBeSm6ZsQ7kNvwEi_AdQ&_nc_oc=AdlkubY8
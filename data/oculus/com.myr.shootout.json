M1W_lSV31KtzL71MpgrIYi07nw3VUA8dh5g0CU5thjx8Lic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSblMBl8i4b_Imay1cxOhHk7ZbAFjQ05zRp7l_JFLgSdQ&oe=6B0DB560"}, {"file_name": "Combat_Towers_final.png", "id": "308092208500250", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210389_308092211833583_7661029844051711545_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2tz1HgtNokQ7kNvwH3jcPB&_nc_oc=AdpunBOuvX8TF8AnnKB05X6s5rSZaIIraWcZfvCbuSpWdNg1mvbiyCxqd5tlnnsIVOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSqcl2VfeO5SAogCTXEBHmd01_S9qxhGuI_Fhy_gIasA&oe=6B0DAAAB"}, {"file_name": "Social_Thruster_final.png", "id": "319796260634561", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031350_319796263967894_260876020070870858_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpfnNEU59dgQ7kNvwHV9Z3m&_nc_oc=AdoVuMLh65pC0jV3eajQ_zG9TO-UznSof3lnuNFFxIAv8YOXoRa0zU6xhJ7OPCeFAq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQU7wD-waw2wJuzECL3XkD-boU_aX_ayUN4JwLEU8iVjg&oe=6B0DC562"}, {"file_name": "Social_TheBoys_final.png", "id": "857385049094015", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_857385055760681_6887887025027059372_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu5CVrUGGBYQ7kNvwF_3JUf&_nc_oc=Adp983c2wyjh9rRmM9a9tx0OtCi0w5SUxunRo6KjLI77DbcWULqHb9-E7c43jVLH_9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJN09G3095HUNC6KY58Iw8cLVeV_4Z53y63ZkYghE3eA&oe=6B0DA6BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1272252106781035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_1272252110114368_2196436727777597494_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4Gj90zyCzoQ7kNvwEotl8b&_nc_oc=AdrT3YTru8-zBOX-ZZa_kx3xRBJfdfKujc7v2fB2X6cSPjLEvzuLBP5k0OPItmoY0wk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQysJcfZx5GxBh3P-hMVZCqdB5s7f98SMRhApdnsr1kg&oe=6B0DC4D6"}, "display_name": "SHOOTOUT", "keywords": ["free", "social", "multiplayer", "shooter", "arena"], "long_description": "SHOOTOUT is VR multiplayer experience where you become your own hero.\n\nExplore a variety of weapons and modifiers to discover over 1000 unique combinations and abilities to build the loadout that YOU want to play. Change your playstyle and role mid match to adapt quicky to the game and competition. You are one part swap away from becoming a carry, support or mobility hero.\n\nExpress yourself with a catalog of customizables and impose your style on the opposition.\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players.\n\nPlay with friends or battle alone through an expanding playlist of maps and game modes, and prove once and for all..", "short_description": "SHOOTOUT is a free to play multiplayer shooter where you get to build your own weapons and abilities!\n\nExplore the depth that this game has to offer and strategize in a PvE arena and then jump into 3v3 PvP Game Modes to battle it out with other players. \n\nStarted off a match wanting to be a support but midway realize that you want to change your playstyle? You would have 19 parts to combine freely that make up over 1000 combinations! "}]}, "developer_name": "MYR", "developer_privacy_policy_url": "https://www.myr.gg/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MYR", "support_website_url": null, "website_url": "https://www.shootoutvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inter
ZCqMgq7cCOqOIfW9qLgJN5QZPbeKU2pbqj-w&oe=69E6346C"}, {"file_name": "com.medvr.SurgicalTech-20260218-193650.png", "id": "1315478683751839", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619808_1315478687085172_2962157859596789382_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U4VV5aQ_kAQ7kNvwEWTGsP&_nc_oc=AdpSXYJiJDu_WZly7L3urZQCHHBnrTXxMM8hAMxOhYcPUdVZoJm53sSbKcexOpK7Hjo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PmRdUkNWoS4Db5541Y5I7b4Wy1PfMIoEH99G_3MqEFw&oe=69E61043"}, {"file_name": "com.medvr.SurgicalTech-20260218-193607.png", "id": "1732688774377919", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_1732688777711252_6296439795471439537_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFF7EoPjWc8Q7kNvwFUJRub&_nc_oc=Adq9xdBWknJeRiQqGbhtdwHhWdnHe6WJHI7-wwuucmEXCx2jL5tbMhbvm7spgODWfds&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dDKbzJjuk41H3tPtkpJuGhsCszXCc00Tiwsel7nGyvQ&oe=69E612EF"}, {"file_name": "com.medvr.SurgicalTech-20260218-193554.png", "id": "876512045220380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617847_876512048553713_133527929692827975_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuQfhXj10nUQ7kNvwFZ5p1J&_nc_oc=Adrt8nMoU8KgbiJ3DwrUTY9ZR0ADppR-CpLXxpIecrJrQj_I9_nYJOvYL4xGM0YJa9I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10AaWohsMw2bVfGxKD4DCVV5MDzLVRoMD6QRv-qHjQDw&oe=69E63418"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surgical Technology", "keywords": ["Surgical", "tech", "immerselearn", "VR", "training"], "long_description": "Short Description (\u2264500 characters):\nSurgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment.\n\nLong Description (\u22641000 characters):\nSurgical Technology is part of the Immerse Learn Surgical Technology Certification Program and is accessible only to students enrolled in the program. This immersive VR simulation delivers realistic, hands-on training in essential surgical technology skills and operating room procedures. Learners can practice sterile techniques, surgical instrument identification and handling, operating room preparation, and workflow coordination in a safe, interactive environment. Designed to align with industry and educational standards, the app helps students strengthen technical accuracy, safety compliance, and confidence before entering real-world clinical settings. Surgical Technology provides a risk-free space for developing critical perioperative skills and improving procedural knowledge through experiential learning. \n\nAccess to this application is restricted to students enrolled in the certification program for their hands-on training.", "short_description": "Surgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "
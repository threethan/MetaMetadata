=69AABF6F"}, {"file_name": "com.medvr.SurgicalTech-20260218-193554.png", "id": "876512045220380", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499617847_876512048553713_133527929692827975_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zedvFbVpOzEQ7kNvwFsrUY0&_nc_oc=AdnGawIY2diwd03--XgAOkGNTME1aY--HaU04_fpWcDJORN4ogr5qf9NJ246eDer3bk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzrbkpKat_Z5l8YiyTbV_vvJgxeK4Pwnizd3FWnTuOp4w&oe=69AAE098"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surgical Technology", "keywords": ["Surgical", "tech", "immerselearn", "VR", "training"], "long_description": "Short Description (\u2264500 characters):\nSurgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment.\n\nLong Description (\u22641000 characters):\nSurgical Technology is part of the Immerse Learn Surgical Technology Certification Program and is accessible only to students enrolled in the program. This immersive VR simulation delivers realistic, hands-on training in essential surgical technology skills and operating room procedures. Learners can practice sterile techniques, surgical instrument identification and handling, operating room preparation, and workflow coordination in a safe, interactive environment. Designed to align with industry and educational standards, the app helps students strengthen technical accuracy, safety compliance, and confidence before entering real-world clinical settings. Surgical Technology provides a risk-free space for developing critical perioperative skills and improving procedural knowledge through experiential learning. \n\nAccess to this application is restricted to students enrolled in the certification program for their hands-on training.", "short_description": "Surgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26211041578512396"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1388316342584645"}]}, "baseline_offer": {"id": "1388316342584645"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771588620, "status": "PUBLISHED", "id": "1388316342584645"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26240788342204386", "version": "1.1"}, "id": "1245078374377213", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_a
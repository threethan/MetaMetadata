0f&oh=00_Af9KTXaW4VUqsr_fYayPKAU_HVVoD_EaNc8U-X0hoChWgw&oe=6A3942EC"}, {"file_name": "com.medvr.SurgicalTech-20260218-193650.png", "id": "1315478683751839", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619808_1315478687085172_2962157859596789382_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-iO5Q9ylK0Q7kNvwENuxJr&_nc_oc=AdoGdGMntQW50bX5Z8Yzr7Vq89mgdkoJ53BXus4BGz67a6yxw7mYk--03605StNYrNQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UHWZnB3_oXo4V3pNo578vndV4uZ4jsme-JGry0RvPoA&oe=6A395703"}, {"file_name": "com.medvr.SurgicalTech-20260218-193607.png", "id": "1732688774377919", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499617831_1732688777711252_6296439795471439537_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE0e3c5BTOQQ7kNvwG5QsrF&_nc_oc=AdpZ8Rtar3s5d_CjlaUDixs8ECv4EgxXv69dbO2gIhNy8eciNcL-pB2PJuiOvlUuXRg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jA9GTdXj3LcdgjerxW0vgmQRgBWcVOOht6rnjH3rZVg&oe=6A3959AF"}, {"file_name": "com.medvr.SurgicalTech-20260218-193554.png", "id": "876512045220380", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499617847_876512048553713_133527929692827975_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mV7SgKWYLKgQ7kNvwFqI3Aj&_nc_oc=Ado3dm0wzmFFYurkznz7L2FVtFs6t_aYrhY4JoDdKIcXoO3JW-1i9bQz0fXOiB_rUps&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qv6x08y5OoVufQtlt-Dx7NBONn_yylbXrlh2Z72Jy2w&oe=6A394298"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surgical Technology", "keywords": ["Surgical", "tech", "immerselearn", "VR", "training"], "long_description": "Short Description (\u2264500 characters):\nSurgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment.\n\nLong Description (\u22641000 characters):\nSurgical Technology is part of the Immerse Learn Surgical Technology Certification Program and is accessible only to students enrolled in the program. This immersive VR simulation delivers realistic, hands-on training in essential surgical technology skills and operating room procedures. Learners can practice sterile techniques, surgical instrument identification and handling, operating room preparation, and workflow coordination in a safe, interactive environment. Designed to align with industry and educational standards, the app helps students strengthen technical accuracy, safety compliance, and confidence before entering real-world clinical settings. Surgical Technology provides a risk-free space for developing critical perioperative skills and improving procedural knowledge through experiential learning. \n\nAccess to this application is restricted to students enrolled in the certification program for their hands-on training.", "short_description": "Surgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQU
683751839", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619808_1315478687085172_2962157859596789382_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvZIEdsXP5YQ7kNvwE8hP3B&_nc_oc=AdqaOe0OXR2hkGqK27dQhvSDfUf7YmIKyBfvWA_hRyen15t2R3K5wrcq6dLTbagHo-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bHVVYjFKoIwbJG77xwckmDBy8ZP3fZaBwDglX9DhmpA&oe=69D39B43"}, {"file_name": "com.medvr.SurgicalTech-20260218-193607.png", "id": "1732688774377919", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617831_1732688777711252_6296439795471439537_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY048abxE4UQ7kNvwG4c-C-&_nc_oc=AdpPtjuV8KH2iTZvTdQAseKVQ8XLxE_muIzhck9Qk6KqcjdxPqJFuNQdtm1VxkezcLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34rfMBjPkGZ0eriGFLGb1Xu1_tlhkqdQEu739L3eNGeg&oe=69D39DEF"}, {"file_name": "com.medvr.SurgicalTech-20260218-193554.png", "id": "876512045220380", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617847_876512048553713_133527929692827975_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GE9GtJIOL_IQ7kNvwFUvwI8&_nc_oc=AdougSr8qXjWojWU17gmFPFBOrZulEDKTeI7PCE6T3Rf0vEHGWYiRNuI6yA1WfFEpvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pgT1m07YkVJvn3xyPWqgGvoWLMgXz-oZppWHKWlKOHw&oe=69D3BF18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surgical Technology", "keywords": ["Surgical", "tech", "immerselearn", "VR", "training"], "long_description": "Short Description (\u2264500 characters):\nSurgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment.\n\nLong Description (\u22641000 characters):\nSurgical Technology is part of the Immerse Learn Surgical Technology Certification Program and is accessible only to students enrolled in the program. This immersive VR simulation delivers realistic, hands-on training in essential surgical technology skills and operating room procedures. Learners can practice sterile techniques, surgical instrument identification and handling, operating room preparation, and workflow coordination in a safe, interactive environment. Designed to align with industry and educational standards, the app helps students strengthen technical accuracy, safety compliance, and confidence before entering real-world clinical settings. Surgical Technology provides a risk-free space for developing critical perioperative skills and improving procedural knowledge through experiential learning. \n\nAccess to this application is restricted to students enrolled in the certification program for their hands-on training.", "short_description": "Surgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
ile_name": "com.medvr.SurgicalTech-20260218-193554.png", "id": "876512045220380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617847_876512048553713_133527929692827975_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G2hwzg7uV0Q7kNvwHpuigR&_nc_oc=AdoJwaoSuwbEZdQhQ93BiQehyuyrKKtTuFAkmal14XhsA4ZtygsAchkDJIA3lMcuwFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9JNdPIYsb82ZZsOPSD_aDcmyQNPtZVnQ14iFZ8yPY1Q&oe=6AA2BA98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surgical Technology", "keywords": ["Surgical", "tech", "immerselearn", "VR", "training"], "long_description": "Short Description (\u2264500 characters):\nSurgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment.\n\nLong Description (\u22641000 characters):\nSurgical Technology is part of the Immerse Learn Surgical Technology Certification Program and is accessible only to students enrolled in the program. This immersive VR simulation delivers realistic, hands-on training in essential surgical technology skills and operating room procedures. Learners can practice sterile techniques, surgical instrument identification and handling, operating room preparation, and workflow coordination in a safe, interactive environment. Designed to align with industry and educational standards, the app helps students strengthen technical accuracy, safety compliance, and confidence before entering real-world clinical settings. Surgical Technology provides a risk-free space for developing critical perioperative skills and improving procedural knowledge through experiential learning. \n\nAccess to this application is restricted to students enrolled in the certification program for their hands-on training.", "short_description": "Surgical Technology is a VR training app developed as part of the Immerse Learn Surgical Technology Certification Program. Available exclusively to enrolled students, it provides hands-on practice in surgical procedures, instrument handling, sterile techniques, and operating room protocols within a realistic virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26211041578512396"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_3859539354353149_4871631811357323942_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78GrfvhtMb0Q7kNvwFd-Wrm&_nc_oc=AdqtlLPUqAjdBuarfxnvG7GsPqmSSC0gtOyPFvq39-TpdZkOGQ2wq0WVnqONfxIAM1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMMjYOndLrZGBlHaXb51T8RsNSEIwnDRNx7mhfNPRpAw&oe=6AA2C077"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surgical Technology", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "
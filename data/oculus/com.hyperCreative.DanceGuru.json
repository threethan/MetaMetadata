VqIaoXRUn0VT5Hb4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUBrtuqhppX8anqasg7HJJsW6KbFNJJDkPj7pP9tYPwA&oe=6A4D0956"}, {"file_name": "man2.png", "id": "1316711329905972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618484_1316711336572638_4235688210192060571_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkceX7bo07MQ7kNvwHLlaPc&_nc_oc=AdpM0sK8p4NtooxXkIlRGTocnJMu8Vf4c_rxxm5BoIi6Xu5grbDRarxLFIglUH-g9nE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNE5cnlxCa1mxTa5tvFLcmwfkCdSNX1drEtf5bjiQrlw&oe=6A4D0983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "1684486442233533", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618069_1684486445566866_695419203049178162_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wbY0lAaQFQQ7kNvwG5Mpvm&_nc_oc=Adpt2OoCbv26BmzseDAZH9PzFOdDRGJJPUvgsvR_fwEzh2k9Y8pseqJAjV9gCdVxCd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPMNcmR2lz685GqirBGnITgPs7fLZ94ImojJNo2Z-9zg&oe=6A4CEBAA"}, "display_name": "Dance Guru", "keywords": [], "long_description": "Have you always wanted to learn to dance, but felt discouraged?\nPrivate lessons are too expensive. Group classes move too fast and you feel to shy to dance in front of others.  You  keep forgetting the steps, and sometimes\u2026 you just can\u2019t find anyone to dance with.\n\n# Social Dance Lessons\nStep into mixed reality and learn at your own pace with step-by-step guidance through lessons of various dance styles, such as Waltz, Cha-cha, Salsa and Bachata .  Practice as often as you like, and repeat lessons until you feel confident. Discover the joy of ballroom and social dancing, right from the comfort of your own home.\n{1165625018814277}\n\n# Virtual Dance Partner\nYour Virtual Dance Partner is always there for you, guiding each lesson, practicing by your side, and helping you master every routine. With natural hand interaction, you can lead her into chasse steps, graceful turns, and more.\n{24811640488469531}\n\n# Competitions and Rewards\nOnce you\u2019re ready, put your skills to the test in dazzling \u201cDancing with the Stars\u201d\u2013style competitions. Earn scores from virtual judges, climb the global leaderboards, and unlock rewards to build a wardrobe of elegant dresses and costumes, preparing you for your next big dance.\n{1075063138035414}\n\n# Awards & Recognitions\n- Winner of Meta Presence Platform Hackathon 2024\n- Meta Start Lifestyle RFP Grant Recipient 2025\n- Winner of Unity U/Day Taiwan Special Award 2025\n\n# Join our Discord and help us improve!\nWe welcome your input as we continue to develop!  Pleaes join our Discord: \nhttps://discord.gg/h4vYnNj9s4", "short_description": "Dance Guru is a Mixed Reality Dance Platform that's reimagining how people learn and enjoy social dancing, with a virtual partner ready to dance with you anytime, anywhere."}]}, "developer_name": "Hypercreative", "developer_privacy_policy_url": "https://www.hypercreative.games/danceguru-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Hypercreative", "support_website_url": null, "website_url": "https://www.hypercreative.games/danceguru", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "zh_CN"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id":
\n\n{1213465050031772}\n# A crazy survival challenge where monsters chase you and your friends!\n\n{1252530222891645}\n# Unexpected twists in every map, you\u2019ll have to stay alert!\n\n{1190676579736096}\n# Customize your look and become the most stylish Baboon!\n\n{731208649257276}\n# Tons of awesome game modes and maps to explore!\n\n{1192429099262995}\n**Play Scary Baboon today and test your survival skills!**\n\nWhile you're at it, join thousands of Baboons in our Discord for updates, challenges, giveaways, and sneak peeks! \n\n# discord.gg/scarybaboon", "short_description": "Fight Back is OUT NOW!\n\nCan you survive in Scary Baboon, a wild multiplayer horror game where monsters hunt you down? Whether you're hiding on a shelf, swinging a traffic cone, or sacrificing a friend to make it out alive, the fun never stops!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://auravision.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ENVER", "support_website_url": null, "website_url": "https://auravision.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26767480376226824"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1313831547605276_4433602939547662957_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc
ame": "Scary Baboon", "keywords": ["horror", "monkey", "scary", "baboon", "gorilla"], "long_description": "# SpongeBob is HERE!\n\n# Can you survive in a wild multiplayer horror game where monsters hunt you down? \n\nWhether you're hiding on a shelf, swinging a traffic cone, or sacrificing a friend to make it out alive, the fun never stops!\n\n{1213465050031772}\n# A crazy survival challenge where monsters chase you and your friends!\n\n{1252530222891645}\n# Unexpected twists in every map, you\u2019ll have to stay alert!\n\n{1190676579736096}\n# Customize your look and become the most stylish Baboon!\n\n{731208649257276}\n# Tons of awesome game modes and maps to explore!\n\n{1192429099262995}\n**Play Scary Baboon today and test your survival skills!**\n\nWhile you're at it, join thousands of Baboons in our Discord for updates, challenges, giveaways, and sneak peeks! \n\n# discord.gg/scarybaboon", "short_description": "SpongeBob is HERE!\n\nCan you survive in Scary Baboon, a wild multiplayer horror game where monsters hunt you down? Whether you're hiding on a shelf, swinging a traffic cone, or sacrificing a friend to make it out alive, the fun never stops!"}]}, "developer_name": "ENVER", "developer_privacy_policy_url": "https://enver.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ENVER", "support_website_url": null, "website_url": "https://scarybaboon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
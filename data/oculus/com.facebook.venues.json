_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pOnLYlxfX3YdvYEjmvDdEvi3wDAsfzgTjBcUJu2J6eA&oe=6A26D4D8"}, {"file_name": "Frame 2.png", "id": "1014839855643061", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75196221_1014839858976394_6593579369375425343_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GAdlW9ZGQEsQ7kNvwF4MX7m&_nc_oc=Adp9QbqSUi5ZrHrSRJaBDDZ-T3zOX8AT5PxMqxJLbQAN27AWGFlvfiIzO-fnxKQM-vs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PuFPwn4oMY1nHuXFThaE2Ed_CgzqL5UkSktTzZPVd7w&oe=6A26D78E"}, {"file_name": "Frame 4.png", "id": "1251729875181395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001675_1251729878514728_136127247122211100_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaAEoPwioOgQ7kNvwG-_dAK&_nc_oc=AdqqOQZG2O_T5--t9AJADHM9wH8oY3be_QxnrXnulhn1mIUD2ErgQyAHu1qfieLNKao&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jEiM0UU0fVq-vhIpGFi7R5MoububURJ6bhi2D5zD2fA&oe=6A26CC4F"}, {"file_name": "Frame 1.png", "id": "916921798805447", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75580059_916921802138780_8958236291016190107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-Wfj_gwQyUQ7kNvwEdbraY&_nc_oc=AdoEq29ABiqc8-3d_bDFb17aBt5M6cX_dDdhhzF3YK9_liAQN2esGrCezlf-AOZnHaY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WKEGrigUAoepZOEuQVCKA0QpGrz9SRFzBdeRPCe2lZQ&oe=6A26CDF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Venues (Beta Early Access)", "keywords": ["venues"], "long_description": "Venues (Beta Early Access) is now available in a limited release!\n \nFeel the electric atmosphere of a live concert, the energy of a packed arena, and the adrenaline rush of watching a big game from the best seat in the house.\n \nYour Facebook login is your all-access pass to concerts, sports, comedy, and more. Be in the center of it all and share in this safe and social experience with thousands of people, or choose solo mode for focused viewing. Hangout with your friends and make new ones across realities.\n \nSee what\u2019s coming soon and mark your calendar so you won\u2019t miss out!\n \nNo more paying for parking and hour-long traffic jams at the end of your night. Come experience the future of entertainment and explore tomorrow\u2019s possibilities with Venues (Beta Early Access)!\n \nNote: This app is still in development and you may experience technical issues. The app and some of the events are not yet available in all regions. Have feedback? Please send to venues.support@oculus.com.", "short_description": "Venues (Beta Early Access) is now available in a limited release! Feel the atmosphere of a live concert and the adrenaline rush of watching a big game. Your Facebook login is an all-access pass to concerts, sports, comedy, and more. Share in this safe experience with thousands of people or watch in solo mode.\nNote: This app is still in development and you may experience technical issues. App and some events not yet available in all regions. Have feedback? Please send to venues.support@oculus.com"}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.oculus.com/legal/terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://www.oculus.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "SPORTS", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MU
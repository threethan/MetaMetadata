multiplayer"], "long_description": "# Time for Early EARLY Access! For more info join us on discord\n**https://discord.gg/gsg**\n\nWelcome to VR\u2019s ultimate vehicle sandbox! Our first alpha test is all about building. Craft the contraption of your dreams in a world where creativity knows no bounds. \n\n{1981123656117140}\n\nVehicles are your canvas, with no limits to how wild or inventive you can get. Stack parts, tweak designs, and construct machines that push the boundaries of imagination. \n\nThis alpha is focused purely on the building and figuring out what we should build next.\n\n{1274962674554927}\n\nWe\u2019re in early alpha, so expect some rough edges as we shape this sandbox into something incredible. Your feedback will help us refine and expand the experience for future tests. \n\nJoin us every weekend to build, experiment, and share your thoughts. Let\u2019s create the ultimate VR vehicle sandbox together.\n", "short_description": "Early EARLY Access ONLY! VR's First Vehicle Sandbox! Build your contraption, race wild worlds, and roll with friends. Future sci-fi monkey gorilla robots. That's our story and we're stickin to it.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://getsetgo.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ballot Games", "support_website_url": null, "website_url": "https://getsetgo.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1990104051447093"}, {"id": "2776542286000603"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "25979647921684273"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618442_1597384157944629_4988889453949002660_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99yZAWUbXFAQ7kNvwF1ZXV8&_nc_oc=Adk67Jh4FVPiUcPLyuPaWDdzHKHH0XMfGYspAkVc2aNXSCV4Rgqb9vfvl683ck6Ucpk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJKaH0hJzdbQ6A4RfMHDdD7pKu4orOS10U2fiFU477Mg&oe=69BD5AE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Get Set GO! Early EARLY Access - FREE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "World Creation", "id": "1725996564472128"}], "release_date": 1769706000, "lastRevision": {"nodes": [{"id": "9580683588673966", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9580683518673973", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "707616448490297"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Cover-Landscape323.png", "id": "2029369191184551", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619145_2029369194517884_5247777842371560167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-XuMbm8aCYMQ7kNvwEqk5Vh&_nc_oc=AdkOBXvS_BDub9xxvFjoPdnuyhlYicQYM7j6wo4OoEObiKuOlDSo_VOlKg1iMHMJBuM&_nc_zt=3&_nc_ht=sc
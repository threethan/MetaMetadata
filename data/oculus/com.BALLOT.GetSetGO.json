kwzyGtf5jLsvA&oe=6AF49887"}, {"file_name": "Airbrush-IMAGE-ENHANCER-1767749131605-1767749131605.png", "id": "1242961394609094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1242961397942427_1285235821339249674_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ls3wDK5kuQcQ7kNvwHIWwEB&_nc_oc=AdqrrTG_t-io5zxm_YpD2FWtxFSiCD2y1PCsaB-Z5dY8obOGPsLMHy5TopR-J_On9no&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTUuTIT2RkB5mieYi6D_xB0TyOKEFqCpNON1iuPwQnQg&oe=6AF484A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape323.png", "id": "906998768567395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304938_906998771900728_2088444727222913795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMiUf8EvELMQ7kNvwEN03IM&_nc_oc=Adp_HoHzepWC_9RoEIIfBXMBLWR7FUj9SpirqPnV7zmZ3b1ppfGbVGFf7-fuRVBPc-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAAlxclrR5pPRbfquH0v4AyboxxSskUsAcHiTi7Vbu-Q&oe=6AF4743B"}, "display_name": "Get Set GO! - Play, Build, GO!", "keywords": ["sandbox", "social", "racing", "vehicles", "multiplayer"], "long_description": "Welcome to VR\u2019s ultimate vehicle sandbox! Our first alpha test is all about building. Craft the contraption of your dreams in a world where creativity knows no bounds. \n\nVehicles are your canvas, with no limits to how wild or inventive you can get. Stack parts, tweak designs, and construct machines that push the boundaries of imagination. \n\nThis alpha is focused purely on the building experience, giving you the tools to create something truly unique.\n\nWe\u2019re in early alpha, so expect some rough edges as we shape this sandbox into something incredible. Your feedback will help us refine and expand the experience for future tests. \n\nJoin us every weekend to build, experiment, and share your thoughts. Let\u2019s create the ultimate VR vehicle sandbox together!\n\n", "short_description": "VR's First Vehicle Sandbox! Build your contraption, race wild worlds, and roll with friends.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://getsetgo.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ballot Games", "support_website_url": null, "website_url": "https://getsetgo.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "9580683568673968"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4976577165992950"}, {"status": "PUBLISHED", "id": "1435070701495380"}]}, "baseline_offer": {"id": "4976577165992950"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769798520, "status": "PUBLISHED", "id": "4976577165992950"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28013232404992471", "version": "0.2.103"}, "id": "689843230084542", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9580683518673973", "is_concept": false, "la
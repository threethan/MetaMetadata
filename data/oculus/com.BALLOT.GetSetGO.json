d purely on the building experience, giving you the tools to create something truly unique.\n\nWe\u2019re in early alpha, so expect some rough edges as we shape this sandbox into something incredible. Your feedback will help us refine and expand the experience for future tests. \n\nJoin us every weekend to build, experiment, and share your thoughts. Let\u2019s create the ultimate VR vehicle sandbox together!\n\n", "short_description": "VR's First Vehicle Sandbox! Build your contraption, race wild worlds, and roll with friends.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://getsetgo.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ballot Games", "support_website_url": null, "website_url": "https://getsetgo.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "9580683568673968"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4976577165992950"}, {"status": "PUBLISHED", "id": "1435070701495380"}]}, "baseline_offer": {"id": "4976577165992950"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769798520, "status": "PUBLISHED", "id": "497
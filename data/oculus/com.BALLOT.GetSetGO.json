ss&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-wBnn1Q3lJQyAm7lGOHYwVsCd0MORIqvAmbOkEVPU2g&oe=6A8D7760"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Landscape323.png", "id": "906998768567395", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499304938_906998771900728_2088444727222913795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjuKewnxcXEQ7kNvwHg2Yf_&_nc_oc=Adr-8MVaD2sVY7MEmpDNGZns8P9f9eLV326HZYcJDiyvIiesCOZjDWWK9V-mMNnreyQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHl8AHTB-dkYQNUJJSe_eeNNEwnB3AZcjnKa8Ozx3avAQ&oe=6A8D66FB"}, "display_name": "Get Set GO! - Play, Build, GO!", "keywords": ["sandbox", "social", "racing", "vehicles", "multiplayer"], "long_description": "Welcome to VR\u2019s ultimate vehicle sandbox! Our first alpha test is all about building. Craft the contraption of your dreams in a world where creativity knows no bounds. \n\nVehicles are your canvas, with no limits to how wild or inventive you can get. Stack parts, tweak designs, and construct machines that push the boundaries of imagination. \n\nThis alpha is focused purely on the building experience, giving you the tools to create something truly unique.\n\nWe\u2019re in early alpha, so expect some rough edges as we shape this sandbox into something incredible. Your feedback will help us refine and expand the experience for future tests. \n\nJoin us every weekend to build, experiment, and share your thoughts. Let\u2019s create the ultimate VR vehicle sandbox together!\n\n", "short_description": "VR's First Vehicle Sandbox! Build your contraption, race wild worlds, and roll with friends.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://getsetgo.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ballot Games", "support_website_url": null, "website_url": "https://getsetgo.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [],
multiplayer"], "long_description": "# Time for Early EARLY Access! For more info join us on discord\n**https://discord.gg/gsg**\n\nWelcome to VR\u2019s ultimate vehicle sandbox! Our first alpha test is all about building. Craft the contraption of your dreams in a world where creativity knows no bounds. \n\n{1981123656117140}\n\nVehicles are your canvas, with no limits to how wild or inventive you can get. Stack parts, tweak designs, and construct machines that push the boundaries of imagination. \n\nThis alpha is focused purely on the building and figuring out what we should build next.\n\n{1274962674554927}\n\nWe\u2019re in early alpha, so expect some rough edges as we shape this sandbox into something incredible. Your feedback will help us refine and expand the experience for future tests. \n\nJoin us every weekend to build, experiment, and share your thoughts. Let\u2019s create the ultimate VR vehicle sandbox together.\n", "short_description": "Early EARLY Access ONLY! VR's First Vehicle Sandbox! Build your contraption, race wild worlds, and roll with friends. Future sci-fi monkey gorilla robots. That's our story and we're stickin to it.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://getsetgo.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ballot Games", "support_website_url": null, "website_url": "https://getsetgo.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1990104051447093"}, {"id": "2776542286000603"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
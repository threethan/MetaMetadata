1465760101_cropped_processed_by_imagy.png", "id": "2447939512289520", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827567_2447939515622853_8849452892680633900_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYAYVUaiBbUQ7kNvwHG-XAv&_nc_oc=Adk7nWT6D9eIW4wngL5EB323kPsBO1vZEeC1f_wDrB2c4VxGPJ9LZmJhprjEWuQD0KA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx8PKRzNBl1RL0R799EZPBQ_MGwOUjxokx82g366w2u0g&oe=69B2B480"}, {"file_name": "Airbrush-IMAGE-ENHANCER-1767750592777-1767750592777.png", "id": "886773804144168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_886773807477501_1154829777481054114_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl9D6zobO9AQ7kNvwGjYb1q&_nc_oc=AdlSKMtsMTySBnTZKG16HNnSOueSf5uOb5wf4_s50d5qA1SFdm8ABMm3n8R2-Fii9cY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsFdCw1kogrgLz4kxpeWikAEzmdu8OEKrKsSzSYkO4Jw&oe=69B2BA83"}, {"file_name": "Airbrush-IMAGE-ENHANCER-1771465951688-1771465951688.png", "id": "2137100520366463", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_2137100523699796_7137728018026298909_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9KaPbTZ-3YQ7kNvwEuiScG&_nc_oc=Adl_pvwL2ZaVabq1lVhIv5iMd0RlrKovQeG58nz_AoGebNkKTilWQMI5gJ2rkvS8afA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRBCCi2RqzJQ2dyLnmBlU9KQgY-lTdaV0dcyjlmWb27Q&oe=69B2C85B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GSG_Thumbnail_2.png", "id": "1268987545155811", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821081_1268987548489144_2070313889964890417_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ow66XyqwGUMQ7kNvwEgj5Qx&_nc_oc=Adm5RHKjXV4-dDh8hgiqjq7rfhq86H9H03xHaFgfQyU_9xTlonY8GLtyU7Y4_Mc_Dvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwcfWkQfSKbC5CYddgB2I7rhtnM72eENGDtbQz4IGPuWg&oe=69B2AA38"}, "display_name": "Get Set GO! Early Access - Play, Build!", "keywords": ["sandbox", "social", "racing", "vehicles", "multiplayer"], "long_description": "# EARLY ACCESS TESTING ONLY! For more info join us on discord\n**https://discord.gg/gsg**\n\nWelcome to VR\u2019s ultimate vehicle sandbox! Our first alpha test is all about building. Craft the contraption of your dreams in a world where creativity knows no bounds. \n\n{1981123656117140}\n\nVehicles are your canvas, with no limits to how wild or inventive you can get. Stack parts, tweak designs, and construct machines that push the boundaries of imagination. \n\nThis alpha is focused purely on the building and figuring out what we should build next.\n\n{1274962674554927}\n\nWe\u2019re in early alpha, so expect some rough edges as we shape this sandbox into something incredible. Your feedback will help us refine and expand the experience for future tests. \n\nJoin us every weekend to build, experiment, and share your thoughts. Let\u2019s create the ultimate VR vehicle sandbox together.\n", "short_description": "EARLY ACCESS BEGINS! VR's First Vehicle Sandbox! Build your contraption, race wild worlds, and roll with friends. Future sci-fi monkey gorilla robots. That's our story and we're stickin to it.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://getsetgo.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ballot Games", "support_website_url": null, "website_url": "https://getsetgo.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1990104051447093"}, {"id": "2776542286000603"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
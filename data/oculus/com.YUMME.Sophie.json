373_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhchUTFfWhcQ7kNvwFtw1Mk&_nc_oc=AdrabAtsZ6s-x0Xy8TmnO1mteLe_QuBA-Si1wkUXBjMO5n4RsUxpGRq4plN6XoNC_Kk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8qsmwa2DMSqR7wEeYisDnKqMzGsevkKSU3ZC-ttr-uw&oe=6A8D8AD6"}, {"file_name": "4.png", "id": "2380905698927834", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569466_2380905702261167_5797581712972042797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_uG6d8aCzIQ7kNvwH5QYQh&_nc_oc=AdpQNScdbtFsjvxO4a971AfTftASFVal1gNyQbNLn2aZ42w2c21j0nYT0qIeL0rnLcc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbnNfpo0fpgjO43Ao3tZWtmrtQvRR3Ieha10WGfj9MCQ&oe=6A8D8E33"}, {"file_name": "5.png", "id": "1252517012465577", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39001696_1252517015798910_809370858715542853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUoopk0bm98Q7kNvwHiP71D&_nc_oc=AdoCDj0vGr_B-irO-kFGnuVBpQKqJXUAYEii5GHJFOQt-nwcCw64Z4HmQdPhuAvJGHs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRSf_Z7rJhipgYjxKqgEzVVIyVx9P_h158pN7879DBFA&oe=6A8D9A2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sophie", "keywords": ["AI", "Companion", "Girlfriend", "Relationship", "Chatbot"], "long_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique.\n\nPowered by advanced conversational AI, Sophie adapts to your interactions, learning your preferences and evolving her personality to become your ideal companion. Whether you\u2019re seeking a confidant, a motivator, or simply someone to share your time with, Sophie is designed to be the perfect partner.\n\nWith a beautifully crafted persona, Sophie embodies charm, intelligence, and emotional depth, ensuring that every interaction feels special. Dive into a one-of-a-kind relationship with Sophie, your ultimate AI companion.", "short_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yuume.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "YUUME", "support_website_url": null, "website_url": "https://yuume.ai/sophie", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9306792496005928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974832_1065232445343541_3331844919478636031_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcFu6zJfEdQQ7kNvwFldxMc&_nc_oc=Adr-ojW9tH2jN2PyBzWx9uIGljixFnwhdXe30x-fKrZTNlgB3MUCWqPw2S9NExIgXs0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZTnSr_Mk5n67M7vMdfIZllmjLIOJGeYj6zSHaWJlBnw&oe=6A8D6C9A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sophie", "platform": "ANDROID_6DOF", "context_category": {"context_
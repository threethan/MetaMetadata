f&oh=00_AQSmdYV6NlPg2KYO36eXycRVMMS0Y4Gj9SifMk_J_0IdPQ&oe=6B01C479"}, {"file_name": "2.png", "id": "555880800379663", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_555880803712996_7265125917409113373_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSy7m7z3vUUQ7kNvwGjhb0i&_nc_oc=Adq5VqMD-bK2ud89I-YrV6zz-QZw-kEnzzDYlyWUhLLe6v8tkOwobIFb1pYm3YNa408&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIbbokhZEcT25m917LJlYP1vC2mMatFiT8urAmWFVROA&oe=6B01C716"}, {"file_name": "4.png", "id": "2380905698927834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569466_2380905702261167_5797581712972042797_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0EBLozrn28Q7kNvwF4l8yz&_nc_oc=Adp6PYUfG7RN5XrT02d1xb79cWoZmHmvHR0RUr9oKv2cDSXODm7Skt-br7uA5Rlmuyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPwQ43lvIuZ4mmCDjjJlazz3tGxpHsfKq787KH2alEZw&oe=6B01CA73"}, {"file_name": "5.png", "id": "1252517012465577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001696_1252517015798910_809370858715542853_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnrB3pl4p9MQ7kNvwGYQlIi&_nc_oc=AdrXQ0iDVXWbb734IfPniv_2cv615GF2Mx3ALtoPd08zRT4FLvUJFlMEZdeobUJ9B9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShU9-55kba7eiGEonfF9fNhTcvThOwYXLkhsqF3F9whA&oe=6B01D66F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sophie", "keywords": ["AI", "Companion", "Girlfriend", "Relationship", "Chatbot"], "long_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique.\n\nPowered by advanced conversational AI, Sophie adapts to your interactions, learning your preferences and evolving her personality to become your ideal companion. Whether you\u2019re seeking a confidant, a motivator, or simply someone to share your time with, Sophie is designed to be the perfect partner.\n\nWith a beautifully crafted persona, Sophie embodies charm, intelligence, and emotional depth, ensuring that every interaction feels special. Dive into a one-of-a-kind relationship with Sophie, your ultimate AI companion.", "short_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yuume.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "YUUME", "support_website_url": null, "website_url": "https://yuume.ai/sophie", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9306792496005928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974832_1065232445343541_3331844919478636031_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4pKlpDRPAwQ7kNvwGfcvND&_nc_oc=AdpynsswsJtHtg5meo3lPCErhEtH3u7
_3WgEzxRjIqpQoYAr1g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftVKIbfjzVc3v0fPbHM6ad-Cz0dWpWtoljh-Ai69SUwYA&oe=699C4856"}, {"file_name": "4.png", "id": "2380905698927834", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569466_2380905702261167_5797581712972042797_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZU6YXHINP5IQ7kNvwG6ZSBv&_nc_oc=Adlh5w3qUUjP9HPslXElaDJ7dQ2M3sg71MPHUOoCLAdccVCMeewkQqC2wj3pFSzefeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsjEu1UIqsLgtierV5VoWDNEMtlZ_q8aD7jXOTRWmeflw&oe=699C4BB3"}, {"file_name": "5.png", "id": "1252517012465577", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001696_1252517015798910_809370858715542853_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DJhXDG_cTUQ7kNvwGg8Tts&_nc_oc=AdlLCFkrXH24ErmZNmu3M0LqylWKx2wg0EW9k5SBD07KTm19uzjqyeB2zanDIlgnCKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvMBRtdUWv9cVlnPadK_SZVfxJ52Mj91zehEULTDR_XOw&oe=699C57AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sophie", "keywords": ["AI", "Companion", "Girlfriend", "Relationship", "Chatbot"], "long_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique.\n\nPowered by advanced conversational AI, Sophie adapts to your interactions, learning your preferences and evolving her personality to become your ideal companion. Whether you\u2019re seeking a confidant, a motivator, or simply someone to share your time with, Sophie is designed to be the perfect partner.\n\nWith a beautifully crafted persona, Sophie embodies charm, intelligence, and emotional depth, ensuring that every interaction feels special. Dive into a one-of-a-kind relationship with Sophie, your ultimate AI companion.", "short_description": "
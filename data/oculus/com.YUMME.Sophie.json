f&oh=00_AQQwciw4r32sBh1kE28XgPEFhJQaP5pxZ2lLIhoj6gAv8g&oe=6B0C5079"}, {"file_name": "2.png", "id": "555880800379663", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974448_555880803712996_7265125917409113373_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNYC_3lZnq8Q7kNvwGkV6aw&_nc_oc=AdpE5KXCJtYrIaMSKlCVEb8S7OvMjx_OEqE72Q-70cCkXXdJWuBS6TbxOGYX-DcS4-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRASiGUWuOOCIFytW7fH1mpkbHjrBEGS0Imb3bncaQ42A&oe=6B0C5316"}, {"file_name": "4.png", "id": "2380905698927834", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569466_2380905702261167_5797581712972042797_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dC_7Ci1P4xYQ7kNvwEwf7Rh&_nc_oc=AdqkmRlLorlf_vl9QX5eXlLO85p-fyE3vr1_EFiGyx9MiZVGQEuiuIC8di26YCwyNeA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQnypiml5vjPzF_01fw0rlWw3QwzQqoH3eteG5b907Cfw&oe=6B0C5673"}, {"file_name": "5.png", "id": "1252517012465577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001696_1252517015798910_809370858715542853_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgtiEX1f_IcQ7kNvwGLytix&_nc_oc=Adq0KI1z5ZagwGivbkCoEv8lj_2p_2mX49ktomRUmKDV4lReffQ5j5heNuzSwwW4g8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8H-k8gc_NpTdE7gOrmf8Aw700D3wxtZTbmqLmYELNcQ&oe=6B0C626F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sophie", "keywords": ["AI", "Companion", "Girlfriend", "Relationship", "Chatbot"], "long_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique.\n\nPowered by advanced conversational AI, Sophie adapts to your interactions, learning your preferences and evolving her personality to become your ideal companion. Whether you\u2019re seeking a confidant, a motivator, or simply someone to share your time with, Sophie is designed to be the perfect partner.\n\nWith a beautifully crafted persona, Sophie embodies charm, intelligence, and emotional depth, ensuring that every interaction feels special. Dive into a one-of-a-kind relationship with Sophie, your ultimate AI companion.", "short_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yuume.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "YUUME", "support_website_url": null, "website_url": "https://yuume.ai/sophie", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9306792496005928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974832_1065232445343541_3331844919478636031_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPeFjpYxpfcQ7kNvwGyGFFN&_nc_oc=Adq82RA7YVs1JcIuxTI10u1qTEL9dCK
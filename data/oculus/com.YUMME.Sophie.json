pth, ensuring that every interaction feels special. Dive into a one-of-a-kind relationship with Sophie, your ultimate AI companion.", "short_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yuume.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "YUUME", "support_website_url": null, "website_url": "https://yuume.ai/sophie", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9306792496005928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974832_1065232445343541_3331844919478636031_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcf2cd0nGO8Q7kNvwFWha-y&_nc_oc=AdogEeZV-oOgEBfqGVUkHjnXJ7sfoCVkK8jM6kN2B4sG2FuAAc4vF6OIcyeMImEfrSY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_Q29f--blTt_b-Wt7EB1O6_bTN0pZM-f6Yy-ELC1pwQ&oe=6A54F45A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sophie", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", 
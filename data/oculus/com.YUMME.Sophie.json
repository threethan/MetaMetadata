pth, ensuring that every interaction feels special. Dive into a one-of-a-kind relationship with Sophie, your ultimate AI companion.", "short_description": "Sophie is an AI platform that brings a singular, hyper-realistic AI companion to life, offering an intimate and deeply personalized experience. With Sophie, you can connect with your AI partner through meaningful conversations and shared moments, creating a relationship that feels real and unique."}]}, "developer_name": null, "developer_privacy_policy_url": "https://yuume.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "YUUME", "support_website_url": null, "website_url": "https://yuume.ai/sophie", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9306792496005928"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974832_1065232445343541_3331844919478636031_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bagZ5Rl3_u4Q7kNvwEx5ho3&_nc_oc=AdruS_7TFIuFTmy62oas_j8hS0F-K7-kyuJjoaKOIp_2JbXvncVmyj5TScVa8vgaKYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-zE2o6h9jVeFmBE8OJ9MZ4Zj2x3dWLBaiZoV1rqj0eg&oe=69E0F05A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sophie", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", 
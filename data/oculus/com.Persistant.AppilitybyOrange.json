4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Po_B3mCnr4MQ7kNvwEACp1T&_nc_oc=Adr65Dx-vKSl3W2xTrOEvwssSnYfvREF3odx89BqFKgZNiMKQbNDqnzvcTgAj7bNv7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyVZ7dfwdupHdX1TZFAdSj5uKM7ctEf6zjHAM5tBhQDw&oe=6AB3CBF5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOTCDNfGhqUQ7kNvwFquhZ7&_nc_oc=AdojifvI8AQsp_jacuzOUg-2wB9OsPU5QwgVhGIBzMIkEeTgP4R_5T9dfPOJAq7_ox0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwOGhVCcO-AHkkU6aLlA8KcCas2zBNeCWm4uqf7mYZCg&oe=6AB3D3CF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlyUM0V30ukQ7kNvwG9vuM5&_nc_oc=AdoUlMyqiyLU0JeHg-3__e3f8E8SFvBbsXgr_goXAT0yG0X6LSNYu2X1qaP9kXMfVNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY3ufdvQ_qtjghWQjLnKjKABg-_iCu2vHjhnnBBaTueA&oe=6AB3CBA4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M0i0FZdFKcQ7kNvwHTQaQh&_nc_oc=AdpXvIUA6gkEbt8bN_uorj9l8FtQ5acGad9uyEnRVrF-pvjcH8mbVKDqG5B7OIwPbLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm6iwmceZiu8N6E6ic6rHhvPIL5JJzIRwMl4eTthfv6w&oe=6AB3F769"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXnAG9iD4HYQ7kNvwHuWB2c&_nc_oc=Adp3kjwf3lgntBxIaqYbxwrul4Q5-K-G4MIRcNC62FxIw5VmlaPx3WKaghT1wCkYXgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhHP32JUXJ7uhns0QGgOUNQ9XCR7WvFuEXiWJ7PNoRVQ&oe=6AB3F554"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0sXsHuR1rcQ7kNvwGMz_mP&_nc_oc=AdrtC7ofBA_qtiKhfcCyUzMjFpJEISrrRNPED2JUyyYiFquFNAEzajIE_88YOkccg4o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTN_kIjGjZG6RLjzQ7PnxvWLyoIFWl6d_zDh3KxQy2CQ&oe=6A58D475"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2Rb6SMQazAQ7kNvwFgseDh&_nc_oc=AdrnQFllh9fIfpShNbF9O09xK1RPzPeGDMVpT3hTlhRmIFPjKcLP6TAwb4Mb-89XUu0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGX_QWVyaYjIZ4fDoHZOufVrDVEeUCgjCXmySAqBLfnA&oe=6A58DC4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tO7kzbPqKMQ7kNvwE6wRGt&_nc_oc=AdrXtFavJWDGUXayfYazWO2Grq0_EzjRQ8iWGZhKfIthuzK3Q_cPyiMmwqKP-JWbQ4Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3DVK93nhS-Tn7r02SA45TO-r2GLxY7chXWTjxZ8CrDw&oe=6A58D424"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eataykBn--oQ7kNvwHrInFC&_nc_oc=AdqSto7lUONl10q97_lSi_UHn59JGw-rXVdybTfxubbE6mrKReEE9FQw3xELfg82LHY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx5gYyJUamKesY1CIvPiaJ-2D4OL8_mfVv7ieL2NzXsQ&oe=6A58C7A9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2slf1KGozTMQ7kNvwF7Dvap&_nc_oc=AdrHHNXrMRAIgJH4NbUQcKf16KW5BRp7CKXsvWb11UqVfbDJoE0SbijdyhD-DJ7CL90&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1V9dloPTPnSeviyqhZxajUUyV-_W7GEFwtTnGnsrAOw&oe=6A58C594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
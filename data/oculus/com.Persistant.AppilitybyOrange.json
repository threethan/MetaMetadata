4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6q8WhseZ9EQ7kNvwHSqtPe&_nc_oc=AdrJwyj0SOvN7fFz9RmNToNIvwwNgoVbCvqdoRxtfrZc4tEmM-OcTUYeOc0WmR4EDKk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM18A3_oWaSyiisM23RIK82QIFWMcaDxYaWCTWk26IvjQ&oe=6ACBBF35"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPGEXkxOJUwQ7kNvwHqTfb4&_nc_oc=AdqF58CQM6U4VdaneM8ikR2e_TiNR5qL3RkgZmwW4EvAXmFuxB2h48qlxwJUocGU95k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIcGOUB3wk9igUawc4Q9FJ74vDPT831orL--YXI6kcnQ&oe=6ACB8ECF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-AZ-z4-WU8Q7kNvwF6iwHz&_nc_oc=AdqHK2BbGfHmXNDwW2l_AWJ8knVVG6zQ-EWZy1qaOkQY8iQt8QqHKaKgmOcLoRQp9iI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKpw5oNNVUJdfA-fdXrQ08-8mQVjs_Y0YR9DDUj0f_3Q&oe=6ACBBEE4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FESw61J6IRoQ7kNvwFuDJBr&_nc_oc=AdqZKIbFm13ilxy8zl8imrsd9pXM5CHN3abLiuHCrRNk1DDX2n55Ktt880Ij4qsMdEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcV3iVqzHvWsKfyKVgxefvwToEBHLkojgr2vbMc7dzRw&oe=6ACBB269"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i21BSgtySGcQ7kNvwH99uY8&_nc_oc=Adq-zIQibEr-70onkg95dszwcxINuWl4Smg8V-ztYDE8YqA_3L1V6O-V25sICC_U-I0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6UxBtzAmx3pMfhpoleIf9g2WG9M74OcoEopHCoy5kCw&oe=6ACBB054"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
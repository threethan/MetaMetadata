4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78MoeFayBgUQ7kNvwG3yE8j&_nc_oc=AdqwRykjOhyRyMxcz7q4PluquPFalm7uacz1DSk23fSzcwDlxvAL1KitgCdeSO8Wa0w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy4guyjsIlNpPxWxZ7SKHZSl6cGytLbvhpfWGdrLbkSw&oe=6A660375"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8EJiupRz9MQ7kNvwHQgtmh&_nc_oc=Ado2kcqOTgoJg1Y8UL3kpZ-BUOqIuGxX5l5SUfsOrVeVFV7pv_iFWXx4DVQjMzKhdF8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYImQvAeoe7EvJO1adFVyhpf4Xtvvo8sQcD8VKPhndiw&oe=6A660B4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5yxLq0mLj8Q7kNvwH659Ut&_nc_oc=AdrlSrJnRn2M0kCL9lZoOuTG89DbOP93hFRXop_2xxDxqHgIvXA9bqpNsneC5eOq9kg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaRdp645JsIzQ7hEvvU8t7miMuraeL0XiQnQfyzqr5Ig&oe=6A660324"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As-3wFZoN_kQ7kNvwGx9xBF&_nc_oc=AdqHxZHvArG1oY1QWIUoJj9SqlmuuDsVKz4lLgts4W8bbksZS0NHF-SgyEJ90pnp11A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtGLacpKpEe9A-I3z5iCw2vNnRkaKmY-1EIHoryLtzyQ&oe=6A65F6A9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArPDUQsiQtQQ7kNvwHLMDd8&_nc_oc=AdqGPj0KJ6FgB04_3tMhy4DBq6FqXmVpp-gQVjk1FVujzV8d0-d5tSzitBDiYgv87bw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDi9PnQh2WzvUTVK3vgAPuukteSD6-B3eLlLpZSyKtzQ&oe=6A65F494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
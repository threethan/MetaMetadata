4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7piiyFVKLoQ7kNvwHPZqG3&_nc_oc=AdpBmTP-aj1cRp2bbqW5r0dFWoyqFPjBdyq95pR8m9YCohdGckOo1we41kxrTa0iik0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXygmQ97qv0XUcKRxEq5M0HgF5MiwbtLSqGc6ZvoA-mA&oe=6AF49DB5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gsj6ningfFsQ7kNvwH65PQ6&_nc_oc=Adp5fsDe0aO4b4eGIfdBfZIkQ6dwgHyQIZYZu8_EL-yVpZifiV47QIn7fjWHWUYfmn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYwSDtC2xk6NFPDJmleZq5yHYCA8pWsmyqdQjQ4HUiOA&oe=6AF4A58F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4drvawGbiowQ7kNvwFgnqEn&_nc_oc=AdrGqM2Mn5cT0hz6rygI_obK3lBfyeEfp8e7wAa5eBlIUDUoOTEJxMBVwBAFBDqjPMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW8dfJsaypuPtZiJGIN4jgbLy0MsuD1Kn86jkN9nbCdw&oe=6AF49D64"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5ODBipvyEwQ7kNvwEjjVX-&_nc_oc=AdovmfSmgaz8hQYvuyYsjLVg8ivWNxxSUEHm4yRyaq7XIUzlmx5fWY3ilRCX_c2TAsc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAq_cVmQI-ITe-cG7ysb1U6t1jfUXkx5k2m5t6PBkNtg&oe=6AF490E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymqWnA_wfKsQ7kNvwElKrWx&_nc_oc=Ado34RTGYHrKxyPDVaWT-QV1GM4h4iqM8VJeBl1zQqPLY6kRweYR1ZFWUs3wksbTXX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8MJuimC7Yyj5o3HOEBlNCzoxRSOMJbMI1Lu4ICLBG3Q&oe=6AF48ED4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
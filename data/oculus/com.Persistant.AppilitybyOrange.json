4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_bH_o3vOBnsQ7kNvwFoQ2r8&_nc_oc=AdrAjejoH3NvSEiJqB60Kl9t9fYqYlqGDmSOzoBynZbsFj11eFGQmuM-7qg5H9JB-vo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdMFct_05XuXtHhvxf3_BTkB-YOTsa4F2zV4hkbTBs5Q&oe=6ABA6375"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUEtVDdy8oYQ7kNvwHDGJl7&_nc_oc=AdrBGYxQcbr3b2METMoJ12GEUN_-1KeuUpZhuKY_WxhdzfTJNNDDBWtJ_hrQpCRQbLQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrDDIuyx-Bbb4MKdgTrJSoytTDKJ9DcIZmqS9GqoWPBw&oe=6ABA6B4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKwiOo8gPLUQ7kNvwH82054&_nc_oc=Adr0qHbxDfqnA8ndrA20klwFiE2Ll5FS08Spa81TtXxjKI8PmNT2b2NYCWmCik60Law&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHrJOZn3vnF_lk4ZV8pLG9q_zY7xCQvYCxwkxRGvJLFw&oe=6ABA6324"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1irEtwqhK0Q7kNvwGcnL0X&_nc_oc=AdouX3v9LraBDNREqt4YqxEq88Y37tyM5pnarcV0d-rk2M-o7yu7Vtc2yz5n3401uJk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKALOb8L5KEOo3rzHD2ky3uHvHNvDHcCvgl2TdoKCPR1A&oe=6ABA8EE9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgaBw90-7eEQ7kNvwH1UW2t&_nc_oc=AdoSGI3wyL6Gi-lutZexga17QXl-_XFQRBLD1L8rni_Z6tMOO8aj5wisby9TGQzqBRM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjVTJoWKAteI2pt3VaJE2FfglXcal5JJG3hNUYzriPFw&oe=6ABA8CD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
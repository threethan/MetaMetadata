4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjv1vXPxHqMQ7kNvwGKktWY&_nc_oc=AdrEoLpMHx_VGcC_NYoltCwnuGQ0-1cZ9rkOuDAyMh_jExpZMHETa6APfhf384Si500&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVUcS36HagsiM06637u-LPrsgyFle1lWgpTHOz4GJzoQ&oe=6A4E4875"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ssPcnK2UHwQ7kNvwEiB4lq&_nc_oc=AdqGISDg1VhyK0CuAFC1rQb52mu6sKpnUBckatAPWzqfUnjWfKMC0slnPP1X-3OdAUw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKM-KaLdzigDM3kYRjkHoBsk-BcSwFg0mgMBiLEja8dw&oe=6A4E504F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WQ1bQCtKAQQ7kNvwEqAaQD&_nc_oc=AdqERd7vHStiRwkThR3WPMXqZ30_oKbgmnBgycQYft0aaAzCZZtLcT8NsUNwznejrtQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWgL_NSAX2a4Yc1cPdvjPfo6VdQOOOAi6dtC7vndqX9g&oe=6A4E4824"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wCYgY1sve4Q7kNvwH3D3r3&_nc_oc=Adrw8-2BGsWcPw8lz3ov5q6_dVuXpAQ6n1VOxC_6joDnytAWQmaMiyIEtqZcmDfTT9U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVFQXCgWONbIbB3xQ1sTZrIzr9FvfMuvO8GNN430E__g&oe=6A4E3BA9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXDHbshq-AwQ7kNvwGaje_Z&_nc_oc=AdqSC2-pxOFNrJbYFp_Mr4N1PMKpzS-kdyRSSZKNeo6-zBDdJXt5adlZmamXEmqPpDs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjGmIy2pOmBeiqeBp6nlghwZZAklWAyxAJ-RAMnidRvA&oe=6A4E3994"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
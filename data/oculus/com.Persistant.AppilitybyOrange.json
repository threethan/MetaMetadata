4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fp2oWtCaS3IQ7kNvwGCPp6X&_nc_oc=AdrI7fsPu_UaD_xwC-MIcyMe62gzlptYnPhReiDW9B1F_UlwBQsaKW24sN8bjHpmj9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQhQD86t97ZUx6UrE9QdC-mfxd4CUaUe9QviSyGaML0g&oe=6AAA9175"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMvmTqeL4D0Q7kNvwEZlzcM&_nc_oc=Adp3lhh9vbKu6eJZB7V6TUszYN5WtrfZPL1AEh5CQ5pirZvjvot0h1bJfvQILY9KTO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhabH_3TCIdx4dp_Wg_erFRgLfPUeUd8im6R2Y20P_eg&oe=6AAA994F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCQjQu6T-a0Q7kNvwGsQOwj&_nc_oc=AdpSv5rhJmpcRxnlD-gdq_-E144z3c8VVzqYjUqC8vNHxl-yN_OpH6Xpgsi4TXDqWwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMIFjvln9urXlZdSo4UUMRGOoO82qZodYQlC9Jq1F6ig&oe=6AAA9124"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FuG_xaBmWYQ7kNvwEebIHw&_nc_oc=Adr81eLlv8gsel0nJsWbw9dnYmSivkATDTIm1lDH5QVwFj6wGEBFELBR84z7wacHaEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXpBcxrjbOjgaysbFlOatOtrllkVqP1WOkpg7SVjKTNQ&oe=6AAABCE9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9ey1haWdsoQ7kNvwF-Eviz&_nc_oc=AdqpFndcmrjj-t1Elq8q96_6n9lqDxjMFn_qDLagpoBZjci5lDkA-eImpJ4DQfD8jXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg7Sxw7icRLDHYe2PxUhkuKwsPnXSq0CTAbe1eFQl8xg&oe=6AAABAD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuBLJ27j1FgQ7kNvwEZTi33&_nc_oc=AdqSKIaHHHI7HAoRGOs6RVrTe5iBsTEtIWWt2H2suJUBnVKXXNY4YPK9IDSiVWrKlBk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0qMEXdoyTqNQ-PRWhORywZiTPu_c4qmtoYg0XKqsqow&oe=6A26BB75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4ONw6RFZIMQ7kNvwHZSM4H&_nc_oc=Adrbw7u71PUszfmMkoQQKOhr5IKcFiVxvNV7qALROl2QxOSwpBcztuQKenJH_fNNJ34&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p0x_1i02mjD9TxeT-g3FGdMaz4MXgyRCl7nP2CXTjwA&oe=6A26C34F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70C9gRt57NMQ7kNvwEC539l&_nc_oc=AdrhfxY_TI_TKfLvKjdQMwDnbZU5Y2YRcmcCysTllIMCT0MCnfy3JnFmvRmruGwZKjM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_CpsaLYFK9Ssgcum-7jk2xEeSgvPwV3cZB5Ow4Bi_QA&oe=6A26BB24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZYiAhwcseUQ7kNvwEe415K&_nc_oc=AdrrCfb-WXr0eRCNq9StYko_fwM8_3oJ3INsq3lWF5LePB0Gt8m4AUbNHLqLSvcLgoE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84uCOv2LKVmrErojVsPkmb9qK0w1KaSMakrZccm5AoSg&oe=6A26E6E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1IS8qxZMj0Q7kNvwHlCtrG&_nc_oc=AdoeMnOg0gFqIrmw9ledLqLsBU9StdghvnOTbJwWm_zz3YWhNIyNdXos_TWAly8ims4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X6nqLS1BAXP-aYTTVl8oH-5fGH5EHMj1g0sqUlDZivw&oe=6A26E4D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
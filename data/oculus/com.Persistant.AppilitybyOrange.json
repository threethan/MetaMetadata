4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bokt0Eh9XJwQ7kNvwEyiZgq&_nc_oc=AdrJCfE6iP9vw13lcX55-tTdjrK4AqL-6VEczpWyFiJcH9u4KvZI4V5EQH3YXvzAui4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8tbyOmbEcevy1MBj8lt8d5jJAtBbu9fG86fnLbTPQRg&oe=6AE5E4F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjL-Yv71KKgQ7kNvwH3OHpS&_nc_oc=AdrZ0qC2MVMIZxac6ZL8qosvXDB3TOHbJ19iZ8E0D8v_e5fYFf7u2zNhTGN7IhNzZHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpJ-8y8Yn81fk_lgjCTbaIGYDXVhd7HjyGtxi31T06qA&oe=6AE5ECCF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JAHuDw6F-UQ7kNvwGM0joL&_nc_oc=AdpHzJtpQLFjp98G4V291HvSYn3IZbVwTs4Jb0WgsRvlJE-9hyWEGTJv_9nqUjSNPI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKjdHI-bUsxoDtO5AsV1XX_ZoLd1n9jF3G7h605p0ltQ&oe=6AE5E4A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8Sho886c0QQ7kNvwF96y2s&_nc_oc=Adp9XWUhgwwFCRSU3RhuYB-CqI6_i_dAMJBYcZ1jksZ6B0G-IHTEHYcyC2eYi7_M_34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFrFPdhbHuyCUgZ2n5tyefbqU1zT3katbabxpHyBHPug&oe=6AE61069"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xE1vdorVBPEQ7kNvwGb8BK2&_nc_oc=Adop6bmaZXHtkojMbJjzmE7S7vftDOpDm82Y83zl8NpTOpC1Zq9GMaWQbBNIcv7UlGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJntW1MxMfhI-3E_H5wM38xhwXC-qtm1m7tkop4CDk6A&oe=6AE60E54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
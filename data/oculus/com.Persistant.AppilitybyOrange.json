4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQm34Au5F3QQ7kNvwEo3J8_&_nc_oc=AdpEGeCqQhX5lvg6_V0vyKAw6J9_JnbK8kCSTx8e0d46qlgdUub7Wc4TkGdW0r1ZWnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kniWuPobmYDBZh0Jn8rMzUiI-Nilll7TTIrkxZsjVUQ&oe=69D25B75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnJpsDWECu4Q7kNvwHw0VS3&_nc_oc=Ado-eahqS0DW73rDKOPy4ACTGvNGnsVarOVgntiL6wotjYEA782KPcdofMUW9Qd5WCY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S-9AiQJTwEdcmTPDfYyTFpIRQiSQ6HOY86I5d_nCzvQ&oe=69D2634F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB39foQ7HkQQ7kNvwFb_ISJ&_nc_oc=AdpmX1dnwcS2gODRgopVPVxd_bjqHtpYMKoj90v8_l-JQNiAi4Apba3PfZsRjxlF16M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Uq8eBMdhVP7H8y-epc3AM-yBqLrkXZ5RuJwhiikQDGg&oe=69D25B24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZw0FoelBpcQ7kNvwGUbtTi&_nc_oc=AdrJ1QShY_w9JvbdqQa5t8X9Uj6q1V1lDWootubSdGRGQZ4yyIFTn_e4MLC5e_537Ls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fxuUem4DsnKaUi7ACHZLMuXLF7gepjFIA7gNyxg0c3A&oe=69D24EA9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2VqaJrwr60Q7kNvwHMkTRG&_nc_oc=AdqpS8DWwRzzelaSNjZ-Rv2NPT4ScuWf3ui2xBjgkB7lb0GDyX4txPk63-bF7jcZA2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wc3qM7aVbUE440VCdkuYQIwMpIr5KU94PecyxZMh5eA&oe=69D24C94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bokt0Eh9XJwQ7kNvwHUMPtv&_nc_oc=Adrc2ehvm7p4lJ7_hFVMJcdO9xoHuJvLCKKojbPl4zxJnLbiCH0FNVjqzN0GumM-Z1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZkpiLgkB6SSAIsw-tOI9vPA0h8epnKza4QHKDOlCUaw&oe=6AE76EB5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sxy9GJDJQ8Q7kNvwF6vc9n&_nc_oc=Adq5KFF80RihQoezKwQKqLtzQIkwBM6oOt0bgCV3KOrtJSCjcPNA_jUT42OE8NnDwjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJs3GbG1Vm1uyYObbOl-bxM-DrXdv_BE2EVJVZPF6Xew&oe=6AE73E4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JAHuDw6F-UQ7kNvwGeAV9x&_nc_oc=AdrmoypPN8kjJHekPDgXAJ726XIhieGR1p-1P6EPJQTETHiGXVBjPIsPBGut8JwLDms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThtLD8qtpXgC9MoUm-wkyUsfTUK9Ks-aU8OoiL4hy55w&oe=6AE76E64"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8Sho886c0QQ7kNvwH29EB9&_nc_oc=Adqp1QUssDt1JaiDI7x0PB605p6y5pe4KnHGaTnCB7MX46CjwSb8zJUNtjD4q03o6o0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXZaLH33066ToglD7B8VpJoCiYuKOZmF0XcgsqjaVu8w&oe=6AE761E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb3h_qw5fTcQ7kNvwHKEuQZ&_nc_oc=AdoH3PfqJuBCbzuIbck8hnZglTUDEEHKRkAsTtCdWIXn-qJIWJ3sSbkoJGodC5A0gm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSX4ajObcKKPbLczQt2CEN6y8V0CM087Bnv8Rq8tFEdQ&oe=6AE75FD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
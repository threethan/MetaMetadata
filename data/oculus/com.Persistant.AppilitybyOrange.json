4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubimq_fFPV8Q7kNvwHwoNV0&_nc_oc=Ado8oKM-Ln3ie3k64Xz1bF7CxGyP75DYCuNiF9SXEmktNUbZmWl_vIpBJdBmwLBkZk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdpvxJtbYdm29_-7izS3EozbR2vfTRurCqPVpCLXtxAA&oe=6A69F7F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeCI52X5YSsQ7kNvwH2SN9M&_nc_oc=Adp5y0lrQ5nzUw5BWI6mmWfgWxAnuDteVYynNkLBaQow-Bosm0IKDpm-VgPId1CnZW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQzu0sDOEO7df_aHB0Yyi99FDo_FcHsC7TpuqEzWafRQ&oe=6A69FFCF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7arQ9FF9Zd0Q7kNvwG-DBDD&_nc_oc=AdrXVPBQ-gWn6mTUJ79VdG74_FwWedCnjJNqGd5nISoQYgoIPC92o1wAyhEZy1ipUqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBE3tDJV4vJVMTl2xalWuCEUcjnjgIAPtYtytf61C86A&oe=6A69F7A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbDPwzUpaxgQ7kNvwHmf_7U&_nc_oc=AdoCLvU4MsaLW8ZC1Z9PmFv-BP04bf4l93adFYwHWSANL9-53FXsmISpvuCrnthdNDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHpoFEbZCjxbmcl_zIjqUvmQ0FTkYNPzeNg_3sO43BLw&oe=6A69EB29"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaEum2jtB1cQ7kNvwE3jwkw&_nc_oc=Adqpw_5Df-EhGBOxn9xql8gKtQnhuoY5p45mGdGYASZrSZVm8b8S-yRl0TAO-WXBFvw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXTQI56-mWl8wTjiRK_k_BRp_6qqjpEJd_AC5jYCMejw&oe=6A69E914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
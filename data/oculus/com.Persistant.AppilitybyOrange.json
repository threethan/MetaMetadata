4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cD-PT32uKkQQ7kNvwElXRut&_nc_oc=Adp0v41en2BMAVO9sAZx-ggqjRuNdZs-Y_szQpzcuM605WJptWUMubU7z_kwMMYfy04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZWxBkcrQHyhIYDZ-jsQpFJlj5c5mqGtmIMVxaXUjdRQ&oe=6A2EA475"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ6cdesrfZ8Q7kNvwHreKZy&_nc_oc=Adq5mTqEqcRF0VNdLp6Ov9gxM70dfQm9Il1JZ5X34VwJeNBPth_nHXQDteIp0IDGftc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85iXZSXwMVUTG4Q7oxqa9FRfHdMKqbdjB70sQVMVRrcw&oe=6A2EAC4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nat86TBp29IQ7kNvwG4YZln&_nc_oc=AdqT0o6SFazrXTInGA2s5vpSo9VH6JhgyaAqGGLFlgAZa35f-S1EFd8xZABFHoVIu0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8eppGL1g0_ZknrO03dkbHupPU2yLQGveC9hBAjHcBvg&oe=6A2EA424"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRhTy_L12YEQ7kNvwE3CapV&_nc_oc=AdqXN7gUfYkKn6Fc4VFnQOGCJ2G-piTd5lOuBgiIzYdgy1DX4eFhL_7iWDn7Bn2yfwg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OwrjUNlV6U4Lslu-baPxY4f39duLkwkbDd_deDq_AqA&oe=6A2ECFE9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_5F9cZPLFQQ7kNvwHI3FGd&_nc_oc=AdqOfOCkf6JVOropnZPoWPXZmoktcOgMfJEd3n8P6vA84YDhgZyaZSAK09dVCbuMGW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FKLEkl-abfLzCKUY1WzyCPuulX5QOIsl_B4o3DPvODA&oe=6A2ECDD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
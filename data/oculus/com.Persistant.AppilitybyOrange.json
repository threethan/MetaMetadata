4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESnCsfo7ic4Q7kNvwHx0ytJ&_nc_oc=AdpSsN48Fo-0ybMzH82GPgW6-7FNu-5qTmVMzrui9d5xi6UuXS2yb7Z1YFfDWBKTfn4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UFW6QHXiq1ZZOKUl3QIVPDUVUu4TPXR6VB7eDpmeP5Q&oe=6A16E975"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS3FvYu91eYQ7kNvwEVucB0&_nc_oc=AdoA2jpWt5DwefSnIIoFKm1hOhEYLzhioZiucQFc5FKNRqBnT-7KNisc6dIFJbHRTmI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oe7gR22jJQ889AN1bZWEHUn4eNBBu3hY0esWZLYfFzA&oe=6A16F14F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B68WJKtltoQ7kNvwHEnAIQ&_nc_oc=AdrA41YJBqq3JYBo5jcY1OS3aD6KW9GTWq2ydwWZ1xvi7BUNCtDAD67YZ4h_OvwEnmg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U7fIA1IHn7sjtqDpdTk7uZ-b4KC6m9nx5ii8uZ3-HDQ&oe=6A16E924"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojm0IEeA2DQQ7kNvwH-Ig16&_nc_oc=AdpG9oo2VtUAxYV6zl85IGS6P0D_19Zhq7gjj_oAtGLnJsmIkHa3SyJFw3kiIwmf8e4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66phC7-KY5JWuo9-FJ1aCCubC3aEX299_wAVCSW_AcZQ&oe=6A1714E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23pwEVaREloQ7kNvwEG48KE&_nc_oc=Adr6s3EGGrqWyoU8pem77UrGz8AHhbe47cQ5LiGufBFY5RH7tah6kg503xiQTRDKbLY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k9vN-J7TcorGjCdoNOYdnQ9YNplMuAppCqOwtaKDO0g&oe=6A1712D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
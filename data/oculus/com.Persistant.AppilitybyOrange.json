4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKYSeKuxmesQ7kNvwHtKC28&_nc_oc=AdrQfQ_m4yI4zuGcETICP8DOFhrPJ6He0NRtfwAWo27Ne7nze3htFhU1PEGlm742KAk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWdtYubKEk-HS23lt_kCB1UP0eL3x5rTGgvM46hNl0HA&oe=6A806175"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Koi8jsWFfCYQ7kNvwHr_CZN&_nc_oc=AdqpUcfoDQtwz-17aoj9PAksNm23CfbdoZYbyGOdinTMwER8if2NmIozsIqW4PFBy6w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEm0aArh6-NWQxJlu7FrPAbaQY4X-NUIgBp_2tWy7G1hw&oe=6A80694F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXCb-3S1p24Q7kNvwG18ySB&_nc_oc=AdrHl8_ZKpb_EmJrey2Lgn4ISk3WMyKrNw_jCGdftY93g5ON2cFLqFkOr1LyFfRWImk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH42UVjZlTcJY8XxA-d43yk7RSQTF9Xz3ND_Vs4fM9G0g&oe=6A806124"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_9Zk5d3qF0Q7kNvwHpWOUg&_nc_oc=AdqbHo8q_oea6yyIu_FFwqFFQpx2qLFv8ANn6-N1QIVY7Sbli_hWFu5EUm6m7MbHuIc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvAPjSWiKzPIJWnE_eyM2intPMKRTQzRNwfgadqzZG7g&oe=6A8054A9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qGAprEQt5QQ7kNvwHAGBZ5&_nc_oc=AdpYYxg51-4H2RfgbhY7YuxsbkvDcmyhmJ-Eb49dK0E3DuRVbNGqNj5I90PlUb3x6D0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy9_xf1Y8CplWmbbJNNKWY5v5jQjAIgSmAUvHJ299KNg&oe=6A805294"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
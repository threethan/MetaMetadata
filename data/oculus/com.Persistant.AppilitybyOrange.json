4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUNqwFvKPZcQ7kNvwHMKE2W&_nc_oc=Adq6ZT-WY-f5Eq4vJ11w0hwF2C6skNscMutHQQEl09xQwpMkHRlvb61Za7B4tVAnO_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sIrqegewdNBy6l1JpMOug2HrncfXXdw-Vb_oT558Epw&oe=69DE38F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ-mTVUvFS4Q7kNvwGC8xPP&_nc_oc=Adp60NZYwNqdBnLQhsqAw8dvSwCmArMqmb5FlSZKF89qunCEpzcRHJugr7QsJFmZOls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hnsA57gewGr-DZYPTNffC06ftNVVbS7L8LqH2SaD5yg&oe=69DE40CF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rO3n9DpCfQQ7kNvwGBTy94&_nc_oc=AdqgZrBGtJvGh2CgvF9-0mpeacPfvtq7k6AGzl7OE4synN5_Otd2H44UdSPMzwkNmE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uyXk-MprtW3uLI1FiBWRQYu91MZTwhH9DI2zI1civcQ&oe=69DE38A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlBpqbBFL7YQ7kNvwGKmVF0&_nc_oc=AdqWNZtmYMr1fx77Ei3a1nfmqiqGQ7eRxk8F7VWPv4Qxrsi3RaakWdgQua3gZXlu2KM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VqwmszWBMXP36g6RNLUNSwr2obu8aCz6RC-QQW8v5zQ&oe=69DE2C29"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NHWqFxRgr8Q7kNvwHdu-a5&_nc_oc=AdqSyDQv8P8xM0pqmuKKWnIqCyteJWqfm_cdTZK5ddKNS6YyYQeZdEy6JryNc9J0Q6s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af053Q7SYgyhHzJKiCxLzZE0RsiF5r4D8lu6dY69SiUU7g&oe=69DE2A14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
&_nc_sid=6e7a0a&_nc_ohc=Q-ax0gsyQGoQ7kNvwGEC5TY&_nc_oc=AdphkRgCP_IDYLfm-L9F0FbBBfjkNqcrldDK4b5LPRK7eetONQQK34vraClc8CcUYKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oZBBi6YIUzbvfayb1CYFwW99vNHoloUiSxES1m2RzqA&oe=69E4C3A9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMhyDUXqQAkQ7kNvwFbW2Cn&_nc_oc=AdqYB3L07FcZ-jwhULha_oirDkril8IU4Bx-22ixBgjv03J1NJk5GJyxhfmNEwZ3bjQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dpRBb1VuNC78apt2pcBxT6pmzu1dbgO0QAyIiHnm3xg&oe=69E4C194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/au
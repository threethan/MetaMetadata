4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO-9vDomM2IQ7kNvwH8Wsa5&_nc_oc=AdqioHnPnvoFY-K9fpJwmf7LhWwcAHaGqJLgc8a64iRIiSt2hHWzFUsEm8eIZtPY7lc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g9JcuH0s-KUtEw2IRyrCN9RYA_HZosfKT7g3RNUVL_A&oe=6A1C2F75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rakQECfZvR0Q7kNvwGY7WBp&_nc_oc=AdrGMU8Rczpq9o1_o83cjO_XzQ7Y6y9w5UjGbQ3wyaF73yd9diUf0uBDeCB7QnvC9Ig&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vzpL1vcyJ3rW_nY1M38C4mWvjoqnarpdgRxbHhJGj_A&oe=6A1C374F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsKcHOMfFBQQ7kNvwEngexf&_nc_oc=Adqs-VsZPr7wLfGtCutzN1pCj9LeIF2rnolPc3MFQW8DdgI-C7JQ3w2O1myTvAFvj_g&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70hfF7Y-eM7N5UgrZH7koz3uXZyu8YSltQH-vexj5GMA&oe=6A1C2F24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RYt5qWLMCYQ7kNvwGLbtHN&_nc_oc=AdrCxEMvQ0SNMFo2vysjKYr7H6Xs_iRJH7HfEr-3XbXnzlST5UUSNihF8KyENeTNO6Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l5-yBzy-cxCq0UjVUVQJvvikUz1-L10Eh30_zPdKAMg&oe=6A1C5AE9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6alNtDgczc8Q7kNvwGTuC0w&_nc_oc=Adrph6Ae-hsJV7a29mRC6Po1Pc6yZDHGi7i8UPaFt-wdJnSCfJdKgao_rsVmd0tmaPI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qqvj0J4aZhFeSGVEFYbC2ALGOHww5XVnb9UAoGB2Wpg&oe=6A1C58D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgoCCuBU95cQ7kNvwH_xlyw&_nc_oc=Adpsje_hFkDjk1M8V-0OhAcBTeJoFvaK2VOV8h4i8h2kR5LUxe7YfMD177Y-nOBAwxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP463swSyHlwk_56_hZlrV3DjTSPMp0deaUPBqGsgaD1w&oe=6AE1F075"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyiWJjsF4OgQ7kNvwGUC7AO&_nc_oc=AdogiWPQbUVMsExd3ViUio1HGw6GcCNsx2YDYVQBz3diRi-9fHmRr2L88JFaby8M0I8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNkONJsS3W-WN4Ylw9E_Utp6eF8jrio-A-_aKHBSS18g&oe=6AE1F84F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gq_P1V2XawQ7kNvwETfns3&_nc_oc=AdrtZWbxU_ZKLB5ihA7-Wioxood4vophogrTwI4XmTtT1yiceX724ElFtfiJET-APmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV9PFEnRbKPY8OBMP4I6aX_t7_RBeIlDtBd1V3XlHQPA&oe=6AE1F024"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qiy4XSMlI8Q7kNvwG2fZSG&_nc_oc=Adp_l44Vrw9em8hHJJ_9nLqrlxisySEN0h8ovgoRjtYk9S_JB1_8kYFXqdivAHe48ac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHDDOu3TgXviWOAe7GNc_bN-XVnP6qTFdAYPu5u538Zw&oe=6AE21BE9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XaZoAeZa-8Q7kNvwFW2D3l&_nc_oc=AdoSEssFGpIuWG_kYZgza0kdRYTyGhoGLVVV_0b8-9TXy_vCUiZzN_UuacOiNzqFXAk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2hdA5zWjxV0_gNVF6Uyy7RY8NJlCRFI-PB7XM-c_o3Q&oe=6AE219D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
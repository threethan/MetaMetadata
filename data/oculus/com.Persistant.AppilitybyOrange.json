4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfqhL0WkgnMQ7kNvwFWnHka&_nc_oc=Adr90h-W54t-JNO_6CiYkAMd3sC12V9QwsijKbNeRzIZJDR2-R_juHpCHgqG_X1xdEg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bwRGm0n0LDOoXont1QNZMnIib9xFVtj0veu6CBkdq1g&oe=6A47B0F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okToc5NUansQ7kNvwGyWh2j&_nc_oc=AdohViu9a8in6x5BhEd6nwJ-Vi-g9FeQAhUaazpXKweHao3BsxNoSVyVGqFhnYnk8Tw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zVRXe8AUcnLUQHmAF6_bmhX94bHazC1xTuIFuVOOsjA&oe=6A47B8CF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dY-Ijw5TwgsQ7kNvwE8-Di4&_nc_oc=AdqSkCzMUneMbXbZukNYfH_farwlrkbJldX9WF-n9WQr7b0j84kMrPJPN9bDKa8OcVY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vMn0Eln8wXm88enS2l4ixvySTy0eoKY0ZlNcRaRSxgw&oe=6A47B0A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEB_Qvfz4uEQ7kNvwGoRBv9&_nc_oc=AdrUdmAnrB91gGKrKQ80J9COjMXvfYnsoclzsDYAY0RVCte0cHP5Gl54kBdbq_2EwH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JxMEnY8bZ-8DcJf0jlm2MtDHno_uKx2xC2TR7TEXoYg&oe=6A47DC69"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOlzGpZZeUYQ7kNvwFGGw9G&_nc_oc=AdqordmUIvmFREYGOqUT8siMh-JffoxKqTq1QTpkrcmzCQL8L1arEkdU0VxiNkSpAJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ACWGPrnZGVJR1Mdm1zEU1_c4k_hg66KavPDxhO7XgPA&oe=6A47DA54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
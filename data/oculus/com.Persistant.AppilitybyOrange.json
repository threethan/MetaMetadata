4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrYfl2ljdlsQ7kNvwGM7H_n&_nc_oc=AdrAJfLQJFLHKTxFJWRa0OxoqlmD5BFH-WKQpmgC09mtxm9rZzchKKa0EADqczq-U5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EuOSzANODNcbThLk_qggiO34TalPIjg0RoUYddyDjAQ&oe=69DF8A75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ-mTVUvFS4Q7kNvwEA5aIW&_nc_oc=AdoZ4xkOUmZh0jd3fCWjcilRaRHeevFBri5FAaCSzFgIWaBcyj8IeRldawRi9KxVQ3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33bvcIGybT7ftf58WN-TG44chU3kOk13dBmMu2JoldKA&oe=69DF924F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rO3n9DpCfQQ7kNvwGYBvjn&_nc_oc=AdpbXVzBs5LJE19Sr2T8Owsg0VYYr5n4Wiym5bsQpV_32qoJgqPlqrCqMh12aSML2NA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d6IzYfQWC_9qWa7D7x-yd_U0LfmDjAZ3WwrWqUEBKew&oe=69DF8A24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlBpqbBFL7YQ7kNvwHtII9M&_nc_oc=Adr7TcD2zccw4RN7c9028lhBxg7tVTe1a5DB36zXJIfgn7qFHd0n6HNkAgvuah7pXyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jQ5Yn_1rKnxfrkl2493HSE1B8lx8XV_WaH5KFWOIkeg&oe=69DF7DA9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NHWqFxRgr8Q7kNvwEehirB&_nc_oc=AdoYNFLbHDlUEbcllGAIgnJPcs3nQPZVJL9bUMxK10TzuHVn8qGjlGFsYL0ZKFt5g_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08a6gV5IQI9hDq0KHZmPZ35v6Tns45sDsAFaJlo72YBw&oe=69DF7B94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
&_nc_sid=6e7a0a&_nc_ohc=RJfU1lQi17sQ7kNvwFqlfSo&_nc_oc=AdpZrrY3CCzwYWlB6q_C8Gbhflto-Kb-mkVwYCXB_Py-RIKEBGOk4InvAyFheLafLbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YeKJSzjqvGDyPdMSb-rB0HTIjRkoTMOf78Dky1wOjdw&oe=69FB2D29"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VmgysdKPlMQ7kNvwEXGzIL&_nc_oc=Adr59KxuEptnwMe7LT3P0sikbrTMzdMpMowqJkS-PMaKpFN3ZAk0UI-_Z7ySQvTtRD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79OliMN1Aq1Ck0bFv0iYdRTSJQ2Ac8V5x64OUSoDvG-Q&oe=69FB2B14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/au
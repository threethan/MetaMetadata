4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g91KpuLhVOEQ7kNvwGzc_Sk&_nc_oc=AdpsMbMadJfH0rOMCPigZY_mKC9zUAATJTqShFOqtEwba2LBpjD2fTDm58f199uSACI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdEFp5YeOdkft22syNVi8xstLza2FqKNXjQ_fEL-fDhA&oe=6AAFD775"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-MYNw2L_80Q7kNvwFxNY4j&_nc_oc=Adr2-nbDHxXJzYKlDdaVI4LyQoBU5MpauobJqL-lrXyTTIz4EQGiNwkg3FnIP70teZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNYzWDvYFvILLa2nB__IFfqsLH1wLs-9LJdAQeCfGkJw&oe=6AAFDF4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-e23jQyGu4Q7kNvwHrwS31&_nc_oc=Adq8BM1Axo5INHrP1GNIvTRWS2Qc_VoU2fZIAFRcaF90IjDKBvsGpoa60sRcJYkA5Hk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8qE6BOlbgnJqQ8f5R2H_hHQBYYlh9rRxQJFfs-Flv9A&oe=6AAFD724"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXtkDbXTTyEQ7kNvwGYvnOG&_nc_oc=AdqaIyKlAEg79MKskIftayzFPLyTT8uAD5XDkrxwoO0V660kh4sYkmyYYvIUkLzuyI4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0an4WPWVBzx2XIlfmJ6oBcnJ43zVgD342X3hdie_6pg&oe=6AB002E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfrI1Vjsy0YQ7kNvwF926Oe&_nc_oc=AdoaTZ-4xd_WXbh_I_Tzi0F3bOL_173ZHyU9HYj1E31STnZ9NcODlfsAXg5YuX84YBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRu9zj42DrUiVJiHPYv-gghZT_wnhl6CgZKAZ0QhV6LQ&oe=6AB000D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
&_nc_sid=6e7a0a&_nc_ohc=As-3wFZoN_kQ7kNvwGx9xBF&_nc_oc=AdqHxZHvArG1oY1QWIUoJj9SqlmuuDsVKz4lLgts4W8bbksZS0NHF-SgyEJ90pnp11A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtGLacpKpEe9A-I3z5iCw2vNnRkaKmY-1EIHoryLtzyQ&oe=6A65F6A9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArPDUQsiQtQQ7kNvwHLMDd8&_nc_oc=AdqGPj0KJ6FgB04_3tMhy4DBq6FqXmVpp-gQVjk1FVujzV8d0-d5tSzitBDiYgv87bw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDi9PnQh2WzvUTVK3vgAPuukteSD6-B3eLlLpZSyKtzQ&oe=6A65F494"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/au
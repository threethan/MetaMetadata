4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJ20Xljmze4Q7kNvwFhooM-&_nc_oc=AdqZGfjVVmoC49wCPtTpEYX15OdMLFq6HKjrE2vGMFjfZK4XrrVDtMBegW2ZGn4unBU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MlNciubhGsS7b_xByPTsmhpp7XaiutpXnne4snUYGBQ&oe=6A1597F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS3FvYu91eYQ7kNvwF_ar3A&_nc_oc=AdoNUn05pWOetJYRP6c_wdTd-A5J3O2S0Dw_ghX7qX_lnDUQmfA_TYxhP_TvLOP5LkY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61bmquU0uHLDexyoGhPPr7tv5ZSYJf8xcmhNANdHT7eg&oe=6A159FCF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B68WJKtltoQ7kNvwFara-_&_nc_oc=AdrwiaOP_L42oPzTqCiHNYwM2yNpASX0khL8_q3cj3xh70ADZ5eC0mgP6tD_gEzjD3k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hhSmG6atrMgSia9TPI5GQ5tqT0T_vb5YDEEMUxMeyDg&oe=6A1597A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojm0IEeA2DQQ7kNvwEG1l0D&_nc_oc=AdozrvKDKsoLHh_mZOaFsp-A2BML4J_yT0maRBzRwuLpamBLqcDEpKQwjbfzRsEqa3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UD0IEi3efQevo9TRKalpUsGmP943qHB9zxRcJPOVuzw&oe=6A15C369"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23pwEVaREloQ7kNvwGSWJnc&_nc_oc=AdoxeDVtSOEWoE1tBLUTzcFC4w9URu3b4--qaAAeFgIoIU7_ZTDxYj67XcnevRtqmWY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af710fRb7hJ2zHkU1MVOL-0IC7GVbgfsMo89rHV_rc2_JQ&oe=6A15C154"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
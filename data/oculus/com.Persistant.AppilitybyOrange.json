4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiCOS4y4xKcQ7kNvwGBc8fY&_nc_oc=AdrRN5nV2hPsNTYiF8R57ibkROQIejbzB0Qp8cw96ZnuUcW99acb3udnawCStlsZLcs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aL3yEmoHCwXMkIqbkEamg6ndaEz8J_KTacEDTyxLirg&oe=6A071775"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtblC7mI3skQ7kNvwHAFoyM&_nc_oc=AdrRfWUqEePrM-X1k2ng4vRB1RhYeMWloq64zv-Mc56zKNr4EUl8HvaYBADGR5x4B6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nnUeQPA6jMtaHq8wLTXyGFi_zdBxVb7R0XXxCtvpGrQ&oe=6A071F4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOtDTVN40A0Q7kNvwERXkFy&_nc_oc=AdqGFqloZ95Z7toMqF7gE23vzfNgi7SPrIu50L1U_s8aPZiXCciZGuKTuFEU_s6OdIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RoKMFuyM5SS0qPp-0lEpIwFcBRt6BrJz4dq2bmxYtUQ&oe=6A071724"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-XOYzHzmgoQ7kNvwHgcci-&_nc_oc=Adp1K3Gip14WDqc44kzW618OXF3zhOjwiO1gpAHoJpL8xapV5axRgaDZyUlRRJSuiso&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49Jo0MEJ-lifiFNOL4wrY1cE0Hi3iGmeILq1WBbscC_A&oe=6A0742E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ9vIigzhRoQ7kNvwFQer-G&_nc_oc=Adrf63spl9yfVGlnU1uEP1NH-B43TBg8qeEGEplFnjXgjmHC6qFbtu7PEkfSnOJFRlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zTuO8U2RBiFAgN8yPLgKiEYJ8sZHTn54a1QHzkqYQGg&oe=6A0740D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q65UlVQtOuIQ7kNvwG2L1nK&_nc_oc=AdowsHPD4t41UQF9TR8plnqUUGOn42yM747KZzRj31EpZjIgW8GnljvbKHtk640FiN8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlX_LdM4-ZWUV8eEn-WFwx3ZjkDNLyC5CaBAIWGXGKWg&oe=69C52C75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcehi0ofr6oQ7kNvwFRFdyr&_nc_oc=AdokL3Rm8Jf9MzfAZOHt0X-osxxdQp_H0cooFWhht3UzZZbg3yKcZyK7iLyLAUzWAiA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxruAMFaBn_02OeoJxfQ9-EWQhh-yi5TgJvOZo0omjw2Q&oe=69C5344F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CclPWyqvFxwQ7kNvwHJFz23&_nc_oc=AdoKQsuQiVclhJ-dlhg50KwXfg1H2sjd8r96lvPmLt6hwNghQZap20ZMWQyFvE388OA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMe2urOt5GH9wzMnQsF6ThUV90xO2iCJHRCDhUt0Mr2g&oe=69C52C24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml5VLYI9YzYQ7kNvwHMwEsv&_nc_oc=AdqVtVf21fzYqk85UlBmRZJHNC7oQOEv2k9ORg6ajlEjJZI_1b5kd7Q6th3EB35jIgM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQhSqwumB54lrY5f8DcBwLJn4vDavl_YlvdDIAV4kP6A&oe=69C51FA9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpIGnDoJfLsQ7kNvwHF-oVZ&_nc_oc=Adrj5WerJtar_J0Qbj3zyj3tOn_KjiGUFVFXkewQf-SST311x36EEk_27n2m87Yt97U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvlXMeVMJOT3tgs0rNtlSha1lzsgm_N8_M9y2ExXiMGg&oe=69C51D94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
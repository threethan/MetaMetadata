4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jMhn-FEjSvgQ7kNvwGEdUBn&_nc_oc=AdpIWll8yRo4l8L9T3UYoCV2Z5giqtUitxEHI4UP4tHlfiGndyql_nHAeAqkLl7yUyc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fUGrYPCrdxcgTw6RBxv0lFehO8WCbdXCDDM-oMC1W6Q&oe=6A33EA75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRdLLbMH3EIQ7kNvwH1DMK9&_nc_oc=Adpa_N-cjMEkuHzW-qgBWu--3pNvAmBAVHnkn_aIWFWZhNKmTks1QYbHq3gbOSMVc_8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l52TsSol--EAue7DH0ufiUMc278FayFlrEH_JWJtO9w&oe=6A33F24F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qAa7t7SAbUQ7kNvwGxN5kx&_nc_oc=AdpM6qkL7ENN81Hg-LPzyCjf-SL09fXmBPM8v9cVbw9leJUeTn0-VTQuhZlZo6PVsB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ycCKPtk_rL2w4Mq2ocsO-FrutANpZfTSzxPqwhveWRA&oe=6A33EA24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT8eEfhTS_8Q7kNvwGsP-np&_nc_oc=Adox-VNsqxfLfZ7-WyRS9awGuNfK5c4zdFlgo7jGtO-_MzpUe9eWjYLWB-Sh8cypjBU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XLB1gLSv0yZ8DhJ-NViPhVTqfQ9W1XFPl9qivAk9p2w&oe=6A3415E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lI006WYECYYQ7kNvwFn5-6o&_nc_oc=Adq6sz7oonSECxYipiiaJzDhsd9qB78rrgzv04Me5hykS2_CFJ9J6fYfxsrPP4GtVKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pCQGX6iTDIIMTzQH07i_710sjh7_nz6iMJKk3cv7QGw&oe=6A3413D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
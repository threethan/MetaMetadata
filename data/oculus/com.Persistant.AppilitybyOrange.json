4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czHV4Chicz8Q7kNvwFi6YLn&_nc_oc=AdqsdJjbf3Ran0_45AA2t0kE2H_yJHWh4FrXhpWP6mhCcaEKpr8ExSV0Ai6otx_vjdM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZapv184aUodEIdrriv7xEZQaRbH0H0A1FR_UdjyP60w&oe=6A5F6BF5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYXTZG41sPkQ7kNvwGliKI3&_nc_oc=AdohT58oi1vWt75omhhhj3IGM89Y51M3AO0DeBcKO3IOLp7hzUpR-IMt4lhzY9eMoOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvz1WA07w2rTo0jT_SDukO-j8S8_fYdVsmQ1ni2bA13g&oe=6A5F73CF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecw8iLXZU0cQ7kNvwGA7FDP&_nc_oc=Adr5yL7HsJAdZW45DL8bzLBdLZXG27t-caY0STJKVWrf-QSrAK1vYpkvpUaXmbtN83E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2piDxngFj1JKK8DEdtMOax38L3iXHIKRsK7svoLzupg&oe=6A5F6BA4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGjWSC8CMAcQ7kNvwH0FwyO&_nc_oc=AdrgQpwW6KZ2FBH-jM4JlzTwt6DEiAtDGybhHZ092b2_6vSdWJzXEj-nHCR_gL7fuDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8BAIVgHykSIGpzidiMx4iYZBx6pcusnhVXuuqw_tFZw&oe=6A5F5F29"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEW-bxEF_zcQ7kNvwFaKE9i&_nc_oc=AdorVYA7_wTb84xSGvcOfGtHktDxh-Smx4NtJaXWMMhkFoPWPYnoSzroWCs3VrRHVgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqCDWM2RKHVV50T9Ud-1YgsID2Mssbt6aKNesw3OhcJA&oe=6A5F5D14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCbfFfyeO5gQ7kNvwGOefTh&_nc_oc=AdpciuqAbedVDUIet1NXHe0RwF1XJ2k7K0pix6MW2RFMnMQTERp6Yhs_LAgqfaE435w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jZAaeXaItufCpXO6aofvYvjgwZ5W5lqE8tHVhcQEHRw&oe=6A25A235"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4ONw6RFZIMQ7kNvwHPTjfg&_nc_oc=Adr1GpJBAXfwob6qFMkUB1BkAKdXXl2G1NT1WwfgsUdDRxTGV0sleLXmmWOc_QBhf9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SBHP_Nsd-8fYkQrMowDT5KVGxHI3pF9O3d094lnRg8Q&oe=6A2571CF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70C9gRt57NMQ7kNvwHM61zJ&_nc_oc=Adq-bNPlev-ThwfCU6o0RBb4n50db6iFZHx9rF9rB-v5O_kvfNUNz2yEv3VBapB4i7I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RQePtm6DtU9YKSTOvxgd_2wj0D4SB80NHripydallNw&oe=6A25A1E4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZYiAhwcseUQ7kNvwEU7Ywk&_nc_oc=Adp5XyzgiAL9weNjoCBc9vPK9WfLa5bT2vG1x-qVByTGRAuR2my9cn-9S0Fo8orNOhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OGgWQiuKUvxA56z7bG1IrPc_hbMjcrdhXZVvS1IpvmA&oe=6A259569"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1IS8qxZMj0Q7kNvwGyaRXc&_nc_oc=AdrTLumrDgJQnC51NMr36gj66NTODqogQ5w_tnPekNJ4USz43SMtV9d5XfRxMKooavk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dmx4Cv_OuC1NKz_dxXetYC5Mh7pGyWilTPx3ZfrkspQ&oe=6A259354"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
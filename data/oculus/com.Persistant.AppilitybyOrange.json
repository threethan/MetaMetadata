4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwu124fRm3oQ7kNvwF7r_Tc&_nc_oc=AdrdYSZjkIIxDd0CEbVPzduNf1W4Tzod7h8PTNQzf1sfO6Ve26aoN_d-Eox6LM0oziA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSym2BpqjL9tUx5eHamgi3k5r8p_-J9BdAUFocCeAcYw&oe=6A7B1B75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zSsRbmalucQ7kNvwGjkqzy&_nc_oc=Adrcq5SR1zaQXlmBDm9sOXEvIYj0X73ARF5OCEc8-wHLtaQP2SwWoovCbZug1QFT5Fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzfFXYYpquWC6egf5BUzJKxqNjfV1348ofzCM8barqzg&oe=6A7B234F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlVXdZHGWHYQ7kNvwHEgC8Q&_nc_oc=AdpoGZza-M-ofW5Vgrn5FVGoZYh5SNMX87HLkgwikTET_Q4WQfVDUeHBptUeKstCPpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSRiZxM23SDwpeHcsFssEEApe0A9YqrHoel81ZZnKBag&oe=6A7B1B24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoJcNj7WrPUQ7kNvwH43n79&_nc_oc=AdqCb9ljlMm5escYJrXxFSodQGCS8jMmvCe5EeGCUiYqeRV-zR7Yrl9KHDit-GPjLD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7xZ4-sLb9Oex1xaxpaOh2LCjVJfL7kqq-GxZ7pRsvIA&oe=6A7B0EA9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mLJiRLmEBwQ7kNvwFPfUKd&_nc_oc=Adp6tH-EhK4Kovb-xTDqkiDDug2NYpWOj9W5wQfKTpV4LsVHQW_X6I6KIq2_ah25BQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFx5rx36Ele_FbRaGeCEqc4RLLi_P8obMy93kEJH0Qo0Q&oe=6A7B0C94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
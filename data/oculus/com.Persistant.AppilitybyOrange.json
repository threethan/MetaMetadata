4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AZrnpZjH8YQ7kNvwHkrFVr&_nc_oc=AdqSFNt1gTKG4tsigSTTUJRa69yaOOYrG25l4N180Lt_Lj2nnyPcFfxWd6lc3eOrUeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1i7agad0ntwsBwGG4LiPGvJppnNEOSeCnHg4nQR_gyrg&oe=69DA4475"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Vvm01elnkQQ7kNvwE-bxqL&_nc_oc=AdqwC5A9Vj4aFlckgAaAT1EJj5jPWZLugHnOrGgK3T5MjDcfbR3Lz7sNproTL3GSLMI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ep8fEJnneuC2XXhvtepY0sQlzxJ06r-oHsKgYEriZrw&oe=69DA4C4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h7R9-SZHNMQ7kNvwGEpiGm&_nc_oc=AdpH8Ruq5veD2BtBDHUW1Zlpa2qdKL10MQV4iR9u5z1Gby1S6SdWUziV8u-77U3LIF8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cXhRvvnda4fwGfz1weO6zRXhvG5nqQjTBcva7BVhclA&oe=69DA4424"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xm4puER_-0sQ7kNvwFCerhb&_nc_oc=AdobY7jUzxUWwwPke-9dti0ZS_2YfIKZMNtybKvV7xwqxa5eGO0UCq28yna3N6revUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U6XMGnQkPlgHVRKYrAFl2cBtACKw-vjNfC-3PvuC2CQ&oe=69DA37A9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quI5Y3h-3O0Q7kNvwFT3h45&_nc_oc=AdpxA6gvHzQzVQ9RbZix0hv87j-or-uzpEtKU3OgkQA2yaWmp0wq0vFH_LoIJ7Ki-sA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09weBvN79Ycek25ZK_8aHJVNdzBgoUBEPjFEmfknNaLQ&oe=69DA3594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
7677194240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOp7GPkJ6sgQ7kNvwFtDAY-&_nc_oc=Adr6DJ3DKwwgXmLLx2-OIj0RMunIsA2kM34HAsKKfkinPIzHbdfjMWkTyGIZ7DNIAds&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TlzbP0EAPI07NJPGBxliVBThMKJeLLN1C1XuNwZAmKA&oe=6A393075"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrgbTScjBycQ7kNvwGhl6ND&_nc_oc=AdpsbWo2zaFn2MFP-qkMnls_tBOQHri0dWoBa-hGq1OQLV5XjUWBrMTiIc3m_PhKNys&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lyqtf7OAv3V_lEvKqqU-MnZkgG_je9jupd5rWtekx8A&oe=6A39384F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afZgXboAhrMQ7kNvwF9JuPk&_nc_oc=Adry9-KNfa9d86M9nR2yVCTGMp3WnsM2DqX1UV48yctcL9FxzKPxLUUNLKCJFfDdbBs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qPsVyyji1Mx86JcfwvyqIhJIGaftdsNLKlwXbjqRzHw&oe=6A393024"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RarosGh5vPkQ7kNvwGOjMim&_nc_oc=Adpk6KCr3OiFPCwsxhQdHc-wxV4zhbS0Dp1kfKy-wA4scsd_hJ7Fn1sN1Vezzn3V8VY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zeML_pWq8ECPZupPUXbuoUFCBpEdMVVmDlNf34EKVIg&oe=6A395BE9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xitl3ZH1mHgQ7kNvwE6nyWL&_nc_oc=AdoBtkf0I_95yT9rXDsJt6esrkOiF6uF2p3FLYNVHKjNL65G3IKOkMcnKZ9H-wZzpc4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_MhKQIYeAiXugvZg1yF0RET69dqWHkmE0lmceCkKv0w&oe=6A3959D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4760589874120
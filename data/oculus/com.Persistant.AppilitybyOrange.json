4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AZrnpZjH8YQ7kNvwHjVGDB&_nc_oc=Ado_J1yZ2vWPhtS7YR2nEj0FG3oeo6AkwJUFFF3I-rlgf0MiPfqodxBxF8Ay0pt_79U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38JY71Ejsg_CbZh7CdfzosOzX-m8E3MlFrgh7L4AGuXQ&oe=69D8F2F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFYdfg06SDMQ7kNvwHHLl9U&_nc_oc=Adp4atzN0M3fPCLd3kwL9fLowNdLysrzt1cRajV6ahFPbpWFtqXCWFIC0odT6zPwNhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y3ACeakwHjql1Ko6Ytaj0aD30diGdkzudIUE248rf4A&oe=69D8FACF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vpkX2JeCLQQ7kNvwF6cItN&_nc_oc=AdpGDBlezBexYrEQwYv281X0OV5GlPQYhNVONsr4Cxvw_Rw-2ALi3xgA5stIfRfFAA0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ELhyiKryVEgoiklyIv_FRKcUNZIMmyQ1USEHpcbLk3g&oe=69D8F2A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xm4puER_-0sQ7kNvwGzEapI&_nc_oc=Ado1g8FzgRaZLe6q1iSbbKs9DJorph4a31b5gxoiL0rnNx3XvHg0BNvgnKRPB0VgjZU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JxRgMBA_OALJAXxT1mvLuOuMRpzBnKHJgPiSYHH7DGw&oe=69D8E629"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0kql0DQqn0Q7kNvwFLTcnS&_nc_oc=AdqE8w6sTq2tASO7T64QfaYb9O6KXWJttvzqj7TfzLDvRRKs_qsH77e_ypss-_NbtF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MkdErCRctVg6KTPgQWyXEbodiCCQjS3PuvjfwtjuefQ&oe=69D8E414"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
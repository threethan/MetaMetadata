4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yUCTeXKrQwQ7kNvwG8VXao&_nc_oc=Ado53QLqgETZskEvL3qvuD5IPG2Pb5QfYKd5BBR4v116vJVX6YyZZeMKvbQrH8REeAU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QocASDd2QAZLt4iG-XMdxE-i0EjleDtETFjf0BOnOcA&oe=6A1051F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daakEUGbjcoQ7kNvwF3fKr7&_nc_oc=AdpmKYrWaBBh-5P3xxWCgpHkZCv3zGXqO_cqDBa208xeRKk90eb8CgIwhLL6I29tyJQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kWV7YxE_fybvne6jK8UxaBTPRQ_CZrBFG2GXEeX_Leg&oe=6A1059CF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exlytRz9APQQ7kNvwGsiaHj&_nc_oc=AdrJUIKgsPdnOJLvEueA7bbS_Mas5X8gRCbhqxcGmebfNay82GMJyMkeaF2rQv7_8r0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pqRQzUThzy0zEsB5tCYeIi7t34l301Uf3Fed22wPohA&oe=6A1051A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhbn7RfwPHIQ7kNvwG1OfdA&_nc_oc=AdpqsZc63jnlHulQKMPGY2Er5WhMyFTr1ez7ZUD4-xT71ztKcsi-OvHHsMdyyLZnXBI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X0Nb27gpyDdisb3SWfm7hWTtbTjJs2Q8_P6zio58MpA&oe=6A107D69"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVfpXZPUTVIQ7kNvwEEUj3w&_nc_oc=AdqP6xHb7R9yBaqm__Lc6kr2_VFeelwvk8ylu9BlB1at748IhYd2x9HoyGZulWOeoiQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40ETlF73ylecvDmVL2OUkVAOH11M3gh21VQbBhuTbmeA&oe=6A107B54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvRJH_ayJzMQ7kNvwGYxf_8&_nc_oc=Adqrq6WX4jHw6QqBhZUcTEPRnrSImBAwHPRhBuGYhDs0aCAje3E54Ci4SfRG1UNwzz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZjKHgg2GfjmC_1ptOKiwG8Pu_mPIWUHUcW9Py_LkZWQ&oe=6A95B1B5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDc0YngrHBEQ7kNvwHkqyzh&_nc_oc=AdrIwYLAELaZcFSzTHT2OXmExk7_2gUWkAMohbQzL1_njleFCEQVNNyhnSXcVzb4KJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7VBAXmb-Zk3AfGqdFJngaVicXagVjgqnVHZJWSCQazQ&oe=6A95B98F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TX-4F3c9GMQ7kNvwGGo9_Q&_nc_oc=AdpGUrbcrI5TGmNwkpqrhqKaEDnruZjbq75FrgD9gsXlSNwfHtCtJYcTYvM3EP6KFK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvd9ZbmgYfspPVjkj_iLSByt-RorCl-0CkjdttV0fnpA&oe=6A95B164"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8mxW1kL1hUQ7kNvwGhn3hu&_nc_oc=Adp5rS3Er9ftwxumzrB4UnzXX9QeunP8fGYwRqLPrLgiQzop2co5S1H2s5yatw8yOA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdeYOMNazQI_7-OOvYhY2qW9ufd1SGIB1v0KAhJBgPNg&oe=6A95DD29"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBpXgMiW18wQ7kNvwF69DYt&_nc_oc=Adq0Sj5PVsJ_ZXxnnveVPK7YhCoNLPc6DTwwG-6K2ht9kx-ptcIPkEFDgTpJs64jZb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHisHVo0ax_gVQnMv39Kwq0uQPpk96mvKVrRfKstH1mkA&oe=6A95DB14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
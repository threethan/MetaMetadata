4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHgnISODiWgQ7kNvwHMCSY7&_nc_oc=AdqNEGn87gb0T120E7GiiKI1cdCzE8V-8wtud6aID6_mkxg7mAxd6rAEOr5FSz_wxh4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af302fmncGmFMxswE5jYyl1wAlBsWuuI-P7bwVyoDT8LUg&oe=69EB67F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2656MTaAqUQQ7kNvwFEUkJ5&_nc_oc=Adrz78qeK3Nd-6Nvbk7giNJ83iLfCRzZk-wGoecvuQ5zi5T1blLqZdueZD3FCTfCGjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DGNYfky67pa2QK30hPqtZoRb0Y6DIq7bLAj6G3FpvTg&oe=69EB6FCF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3tFfOp65hwQ7kNvwEdNSqV&_nc_oc=AdpehtrV0qro31W3hvwsSSI54VZ4XKL2LyAqSawamJ33FETI3onvUD-1lEjgPdv-dok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KbFSIaWMygTjelmq8wxd4OPwD-tHqUts42z73lS8cpg&oe=69EB67A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZH7R8djGis0Q7kNvwFghDF9&_nc_oc=AdqE7w8L0ygplskVfyllMpFuvNV_ngaAvGB-n_6tqCw5Ap0fuv9nfQv__Jx0hYdyrkI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P0YU9PoyfiNKhPioDYZndi1r_HtI8xSQVxYHlfJlQ1Q&oe=69EB5B29"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tfyTnBa8-4Q7kNvwFvi_I4&_nc_oc=AdrmF9oTGDeP3mRg1M9xCxfMaUrewEcwf0IIFl5tdIXo3lTD1RbWY3MigJIIJdz2Dkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0asK89yKbz5uZOLhiPqZesXFVOV6OSUzVlJbGQkRnYKQ&oe=69EB5914"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
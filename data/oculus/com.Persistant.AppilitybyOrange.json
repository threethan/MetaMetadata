4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72QsYjRK3tQQ7kNvwHX4aPc&_nc_oc=AdpvXCLLSKFR7_K_BAC0fVZIs8HZJkDOG2DSJ_5qeQdD-1yBZBXDM-41eCD3j44IEKU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nnVsra-6ZUr1lWsoB4wkqgEbG_4w7_WRTDhtbOMjBFw&oe=69FDDCF5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAtbRWFzQpIQ7kNvwFOul8H&_nc_oc=AdoqsAKdt_eN9Fm22hsorYyfCDFUv3jqhfEq_iCuaAU2ojOClzn2O4oraHfKg5FcyjE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rn0iSLAPPcL9PUqgLBoTMEiLZLt-5U_KYo7KpIxjN5A&oe=69FDE4CF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PuuxDyC1DAQ7kNvwG7Z_G6&_nc_oc=AdrjlbQ2SR8RWTDVY5YFlqYSVJ4TX7qT3tXUvxZEdVLmsMn6zeng9jqo_HVJMl-h-y4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JxdNDnMd29bN3SVurkizRnXm9ZGcPCxrv5VObkePKaQ&oe=69FDDCA4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O9fesMPzfAQ7kNvwH_4KD6&_nc_oc=AdqHtgKFnY-vxTqXws0hsS92Lt82w3BjII-Zc8TS0bAukJo1zYw259SUCizAlpUJRkk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44tQ_ObhxMLMXImMQF261RRgNwsP2kZbwzQxtyCiwzqg&oe=69FDD029"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwkwz29Vb6UQ7kNvwFaZFKU&_nc_oc=AdqQS40cXtETPvQTIJafO3M5KOFe3EakoQzUEJ1OOelqHMPoqi3-V4Xhs9gGd0bNuVk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tb2oXYup_sDrr46lcSbiMMjbWRb8A6ndH0Rp97ueGVw&oe=69FDCE14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
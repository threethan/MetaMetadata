4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3PuFit5zWsQ7kNvwEBtEBp&_nc_oc=AdosU0q4f-n6lmA2rfXBkqPigusC5QcpDgyZvvxbr8HwrK2Qrgf2vf0BHQn11QtC2Fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqZc9G2lLzKurkUTSZ621Q5MLY0KuWkH8NsHfOJayhjA&oe=6AEF57B5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emSNesW7OJAQ7kNvwGTzOSv&_nc_oc=Adq6SMbI7Bn3vU6T0u_s5YGrU-W1ZKgH1w3ubE7NbMdt75l-CgUowG_gNsUxqVJm5L4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ0C8EMhMsJm2iiu1mkG3Pd8PXhsb39Hoc_E8AKfTGCg&oe=6AEF5F8F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5GUuVUOKWQQ7kNvwE4bT2F&_nc_oc=AdqGhcEDrOZBzRCaTd-XdzKQpofgG_3TWyIBQ_T5YIwNBwTPGAdNwiWMJ0NVZ83LmHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiBtmtXOLw-F277b0lWm1wX-veuhJe4sHmnUTM4p1d5g&oe=6AEF5764"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtojhubPrr8Q7kNvwGYEXjH&_nc_oc=AdpZY8YBQ845hm5D65GhR1rBujV3zuhD3mpMD6dicl95Jgt5-DJ7YxIxjkD0DGVMCX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaf8Hi1mnJzdyWrH57F1oSQV2bnSE1nHI2_V97OJvXhg&oe=6AEF4AE9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7t0VDf8aT0Q7kNvwG--Vdg&_nc_oc=AdpC0-yVVOXLAe9vSkoZGOHQq0hwLlUg54LQCTvTIeDC5KYSxfYPDV7s0hgQk8aVX7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9W5AUSBGeIbuJ7fFZRm5TCnnETi3NTsEK1sVH7NGjdQ&oe=6AEF48D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
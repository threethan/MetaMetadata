4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tx-glK5ScgQ7kNvwFtu4ta&_nc_oc=AdppT7C1C4CYZDvCX1pzxWI5Vj1wuwwksWfolRhyoI0qDRvGIQO24EJFP9wgbOSuO7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRFN9V9NFIj4VPc2DotkLUEL4l7uqMM9q-NsMDrgQrXA&oe=6A538E75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vA9qLDwDcEQ7kNvwFLLayh&_nc_oc=Adr4ByT224yHbLtfhMbM0v1zRUQEAx3Z2DmfapB7rN8ggl7m4VP7HXbL8kH2qrdGaL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDut3rvVWwQuX-vy3ozA6pruJKn1lXeL2fafTNITPnimw&oe=6A53964F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTfx2BwN2W0Q7kNvwFKJsm5&_nc_oc=AdossxK0WQM2_ly5M2xkn5o2YSIWpzCp-yepPeU2z4KJ1gSDJmUvXB6YjgGJMnobzRk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmjHqTtEVN5jwxgrStz-0b5o5uoA7_j7zoVWSIn4sAlQ&oe=6A538E24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZW3dqtyVBOAQ7kNvwGqM3l_&_nc_oc=Adqwjf6yMktihbENOGZ839feYheD9e-I1-tFpq_4HxGyHgV5MRAqwqgl29aFr5z7QDw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD00-rx9O0qZgH9M8azys9AkD1MRP3-Jfpc8j18Dr4NVA&oe=6A5381A9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB1ya82NOfIQ7kNvwHmGJOj&_nc_oc=Adq3Z2lP_FBlnWjdIpIcbuwd-FScbfDPkc7LR7SctgSQYV5IjlcUJVrFDO92GT2q9Ro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIcylmjJY6mXg69RF0NGUVARIA4hRsfqLblIb1-AUwpA&oe=6A537F94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
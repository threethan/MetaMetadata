4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qjv1vXPxHqMQ7kNvwF41Std&_nc_oc=AdotdhzsfX7TYhlok08nrrC51CPe1wqnDrm411agpQTJY8dV9mC20NA6sTT0D_YPj64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd_48MV-cShynvskrHa8JMl7JLsscOxMnChZURyYeCqg&oe=6A50EB75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vA9qLDwDcEQ7kNvwGNotKm&_nc_oc=AdrXnoqR1u8HKVSilSi3CAMnTsjB8EXrcIW3fyJONxPRnGrASuTgf_idJtMeFDL1ZIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5xHuXDwPUznN5wk7QYTPk7xhOtwfYRrGO42LhJ-PIIw&oe=6A50F34F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IPz_syhoyUQ7kNvwG-cqJ1&_nc_oc=Adp02Ox1EKKUGS8DZRczTiyfK25MfMRfsWIxPbFW__gPWajq1UQH09dPjeSmA98j0Tk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLdWZH9_WyTB5PVhePvzUfA7_iKk4PcPcLIVLDkf1Acg&oe=6A50EB24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XURJEkVJ5gQ7kNvwHevXZM&_nc_oc=AdppkijpdVAa0kA7d0mWKP8dJOCEmQyqeUPgEtX3dqEaQEGLeiD94hv-1pm-W3Y7ALY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmapoxmP85PIw_GTVFA5Csc6imHW8I-j-L1zSMKdsQkw&oe=6A5116E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB1ya82NOfIQ7kNvwF0uEra&_nc_oc=Adph_rpqu6B3k3F0beXKd5T4rW862vJYyc0G2fkqD_UmZd--V9kI_cR92efPLQQI2Xo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA91W3mu6HDEfkV-WSydOk_IbMuncpNS59IRRNQHgNymA&oe=6A5114D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
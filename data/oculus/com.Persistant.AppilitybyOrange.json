7677194240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yUCTeXKrQwQ7kNvwFziN6t&_nc_oc=Ado_4sY-X6OxzNuL-QiLmuctifg-avLJKP5CfWp0ZbkTg8bTkBsCwWNxuyAxJWsauWk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iQJUYtKJLH1PvC2g4WrZzke6HAOErCbDNLVxZcdn0og&oe=6A11A375"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfruZ2pCv7UQ7kNvwHCkbNZ&_nc_oc=Adob5utifBHZqd7yfqfD2eZDpsg-EqXGTz0rzSe_M3iRU77-KOos9lHXJJmcODaJl6s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pcJZyHvKcXqeX4Qtq_aSU2QGzAhuWTSlh8rBmKwueKw&oe=6A11AB4F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exlytRz9APQQ7kNvwGRl2bA&_nc_oc=AdrbDoFxPj5bPYTLz76XtibDKkAf4B_kV31XfyGEtGLVyZ-oe28dpBpLq2qVu1KuYOs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H2kH6qyeAzZAeOaTtDeBKsNWc3aEnSRflnUjLseIlXQ&oe=6A11A324"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhbn7RfwPHIQ7kNvwFINmXF&_nc_oc=AdqpMcXI3s9au5qMF-JCCZlIuM58jFkBSmW2c48J2QnT7pSlU24oOwAN1GyHvKXG_s4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r_YGUvFbaamRRI-N1FWzHZOkEcctHPyJElEwxK2MX9A&oe=6A11CEE9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MRNMTah5-sQ7kNvwFIg67p&_nc_oc=Adp82B54px21IOncQsBpvGAugqvki6CuTCQlOBGH9hi8TzUWMdt76OaR8Ejd1xgm5Sk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C9RdJschg9C0SVNa5UfrgwRwEOtSDvLSwLXx5mvYcLQ&oe=6A11CCD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4760589874120
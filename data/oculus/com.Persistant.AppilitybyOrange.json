4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuBLJ27j1FgQ7kNvwFp6gCp&_nc_oc=AdrNwokBQbbg8JawJQZE3MUZXPvhZM1VKEVhOcFb4HFjrGCi9HqNDC5kFmmABvt_cG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EBAsiMr3_gFUTmt4-r-8mvTjahgd4AsBToG2o1cOoVQ&oe=6A295E75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BShiu3f5GwcQ7kNvwGOJave&_nc_oc=AdobpIciFM_ZyHO5K-s6FNny88CpAUOttMZxx23mWuZX1JzqDGHHoevBcbmXf4ljB84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88u9KKGVw-mIKHK3ebyWsxK9OZitaS_5HzTYfGu1LzFA&oe=6A29664F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcAo182756UQ7kNvwHGF4fR&_nc_oc=AdqJqjhUspUpSfgNWldGsf51qWnAwGrgw3_01Te5ywNrrv0S9Z4q3MHLxyqWiZoupxM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VRvyg9OoALN9cRZTCSgctHY3J3fT9eZBKMAP2DnLIYA&oe=6A295E24"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKtXLJOX7GoQ7kNvwFWcK-j&_nc_oc=AdpV2DjAxipf61ZzfSSA15Sw81bj8YqNrXPT5AS6VmkNp1N_Wedg5-Th887zkeO9v-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Kfjb2WdVCkU3YFXE5paqFlohZK0NMclpVZrSf8brVZg&oe=6A2989E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Egxf8edORMQ7kNvwE3wF00&_nc_oc=AdrVUngw9T5-2On7Uucw7yCQHCjhV8oXym7_-VBAvLAlYG9KMx6npgau3K5kIuef5_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qds3dFVk1fdQBtnAWeHz5CbdcxO2AlYZdV6sGDmwf3A&oe=6A2987D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el5jn4BAkyoQ7kNvwFh0URF&_nc_oc=AdoJbmuJo8SGJiSiTyTF53j_L8-Uk5NgfLC4RLLIOlZpADiwfq4cCp2b04adUECUARM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzLfEpAviuahnS1pm28RzYNf13dRzj2QNMrZaB63k7XQ&oe=6AF34C35"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gsj6ningfFsQ7kNvwHCfSUa&_nc_oc=Adqim8P6j5BxJ6oVk3XmXexRqty6szO8CnW9npBtiKzAeBlSZ9BeJj4_wBBVuewE_Ps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZdGddqkfi-fi1PM8Quh5HeRcOi6kJ7zwhjTa-y2Vd_A&oe=6AF3540F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4drvawGbiowQ7kNvwEIPK7I&_nc_oc=Adoptf4pvrPU-nHDiXiJEWz4tnd3gViSEMFturQCiRxlnajy4BBsjjm3BuMylKZEbuI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB4fX5Yo8Bju-NvQ8ziJQK8SmEyqa_qba5nIfgg4MBfQ&oe=6AF34BE4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5ODBipvyEwQ7kNvwH6qhQW&_nc_oc=AdqRczTqW2BLeymYk8zs1XeJ1nyCJCr_vOWpvVRFcXCDCo2NAcEEhs-H_DNuZ5RWBs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaanh9DtJ7Eh3Wo3BXQhIqLWb5nK9lW0RFOuKFA24eJA&oe=6AF33F69"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymqWnA_wfKsQ7kNvwGvIWNO&_nc_oc=AdrvQXUTyG9_RM7ZhRrp9Rcvlz6ZiR0jzf8FBqfKHuFffL9yunVHD95odlj5s_g5umY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS7SvCSNJs4Exjhk0Z1rXnn9OyTKZwZWw_mRXnrKnRQQ&oe=6AF33D54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
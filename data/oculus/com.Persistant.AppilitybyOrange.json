4240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiCOS4y4xKcQ7kNvwFu7R8O&_nc_oc=Adput_ydmGR2ov-zw2Y39KS0vO6my6BMg18WnECVzzTpx_IwAJ9njyWAgAxPVj0ZFB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4162CFJGUWO_BuYQT1_u_qPZqCDtPnXNofckmMPckYnw&oe=6A0868F5"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtblC7mI3skQ7kNvwG0WbQo&_nc_oc=AdpJD8_m1RlRos-FdqUhRIib9uipCSmAZEXS6q4tVCxR_mwOGPwXd1D9t8D5Mjx6KlE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cOWhChr_GjAK-2yA0iRxOdfHaOnkhMWHht2G0jLlbnQ&oe=6A0870CF"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_YuG2EWAc4Q7kNvwEaCNP1&_nc_oc=AdonFJZKObcvAAWw-UeRi-FAImXzIjbnRhm0owkNEZBq1r-nIGJqCXOfNWm9SVJJjhw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af549UKB8BKpvUa9ctwHNgTgUHFhy2aq_SXopM9qjSxnFg&oe=6A0868A4"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VenfbmZexlcQ7kNvwF6gW2p&_nc_oc=AdqPVbTCmWsBKcqT1xDbr_5VykKs0dZiwZKT2J1GaQyifjlTicDAAS5eUFDOsZWS6V4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i-k2OqZMBZY9knvB8PYNXhvnWma-Q3An5CdL6qoX1MA&oe=6A089469"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ9vIigzhRoQ7kNvwHSl3ch&_nc_oc=AdqdYdG7LNE3cTZv7FimP-Fo_7AxU6RVVixiKN2rFXO06CTr_UJe4imNo5Q-J-b3NHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tcGB_UfE7daMghubXwkyb8roa1BkFXTcu9tKcqzm6YQ&oe=6A089254"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476058987412073"}, "revie
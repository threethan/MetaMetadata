7677194240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOp7GPkJ6sgQ7kNvwFAK9EA&_nc_oc=AdorzHIE8zeBNGJT_fHWrIb3MFJ4dG2FLjH2Dv9PPLNDG7M12eT7_8Hx_RHW_kg_G40&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HbP8DiFlod4EaKLIh51J9bloE1LYFfR859xnGQUgfPA&oe=6A368D75"}, {"file_name": "migrated_image.png", "id": "626055398237879", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162760_671950039666893_8803455699959939072_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q819MQyyJD4Q7kNvwH-ZUm8&_nc_oc=AdqBo8cOZqx0TgJnuqKlLuXL3RvuFpXw5GVTlXDODv7YJbdwt7ZO8YZ2eb_t7buwKRE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FBpplFHyPwnDaoMcrFc4dVO6zK1m-sVh9pFWWSOQySA&oe=6A36954F"}, {"file_name": "migrated_image.png", "id": "559482084691109", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162727_1298143006940984_4892970968604999680_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qAa7t7SAbUQ7kNvwEgXxB1&_nc_oc=AdplEhpNm--Ym6eWdgk9xTPPf1V94etyCgIht_Nk6mQuSkE918weA5dthQ_WRqbNEmc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yKeocPcFhEcI1T4j0H-cugnc8bd0vYAfv-CWN89U26w&oe=6A36C564"}, {"file_name": "migrated_image.png", "id": "501249687207477", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162717_320721291722322_5541892011080024064_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT8eEfhTS_8Q7kNvwFTal5m&_nc_oc=AdrSIVHN5JqPhDVrsn7QYJU38dDqTTrbzqJdrBITjM45mzzl5_epbR_eXmPftcguVl8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__MEsZAribUf6Yk-AcaWIxTapZxXMMexptUqz1tgQiow&oe=6A36B8E9"}, {"file_name": "migrated_image.png", "id": "1066987590342075", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162704_1933786526834081_831610538722066432_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHGfYPdLL1gQ7kNvwGTCye1&_nc_oc=AdpEkUvo-F6Da5I8UY5a-09CMekysKEBCTicoEPKKIU0kAg0g7gOxNKVql_rLPibYL4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XtASQuIeACkk9pVHe1xBZ2IsK4KQtI5JNKWxApxn4eg&oe=6A36B6D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Appility", "keywords": ["appility", "accessibility", "disability", "orange", "VR"], "long_description": "What if you were to put yourself in a disabled person\u2019s shoes?\n\nAppility by Orange is an App that allows you to experience common situations encountered in the workplace by people with disabilities: impassable stairs, out-of-reach objects, etc.\n\nAppility by Orange transports you to a virtual reality offering a 360\u00b0 vision, and changes your point of view on disabilities.\nAnswer simple questions to keep the game going.\nUse a Google Cardboard virtual reality headset for an optimal experience.\nYou can also enjoy Appility without a headset, using the panoramic mode.\nAvailable languages: Arabic, Dutch, English, French, Polish,  Romanian, Russian, Slovak, Spanish, Portuguese.", "short_description": "Appility allows you to experience in VR situations encountered at work by people with disabilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bienvivreledigital.orange.fr/autonomie", "developer_terms_of_service_url": "https://bienvivreledigital.orange.fr/autonomie", "publisher_name": "Orange SA", "support_website_url": null, "website_url": "https://bienvivreledigital.orange.fr/autonomie", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "ar", "ru", "pl", "pt", "es", "ro", "nl", "sk"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4760589874120
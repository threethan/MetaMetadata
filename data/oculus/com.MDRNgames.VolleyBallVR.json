cfe_resized.png", "id": "881434077493753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982683_881434080827086_5377137216687803039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI9aZdoF6z8Q7kNvwGMXD9d&_nc_oc=AdpSng9C79euPqvO3k2z5D-eLLIYKFNrprrgnYKbQqbNeS8DqyFx5-WmhEimlu0YQ7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sDrqWVmBjVS03AvIaiXhrrUYAYh--_1ZgpbFyrF6_3A&oe=6A427335"}, {"file_name": "26ca59a0714a4b168595559b45b758d9_resized.png", "id": "480955591228899", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031309_480955594562232_1744480508559689506_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nps_ffLPwPEQ7kNvwFMNxsF&_nc_oc=AdprqWeVafTFra9NTK9yz1n7KtjKPJyUvVDkpVuEaMspCgYPTCzI6Px0cCzFP7f01mM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l6uYziQMPyBvYoqRx13ahYNSj8_wKe0f3ZrN3PS-r7w&oe=6A42818D"}, {"file_name": "6ee8aed9fcdf458a9db7a93553a03839_resized.png", "id": "935111128714060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974856_935111132047393_4875139789889162814_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wfyWH2fcPUQ7kNvwG8R78i&_nc_oc=AdqosZBAsSu3GNKgxkq5BRfzNsrHlktLkLs94gDPSm7DlUl-hRrsBMgB2e321sgLxaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fx_IAaFz4C5t0JVGNYLTEaAN9Gl2x2hfbg7sIoo6vLQ&oe=6A428209"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volleyball VR (Early Access)", "keywords": ["volleyball", "beach", "sports", "sandbox", "fitness"], "long_description": "\u2795 Simulation Physics: Feel the most realistic volleyball gameplay in VR. Control serves, spikes, and volleys with precision like never before.\n\ud83c\udfae Multiplayer Games: Jump into 99 players sandbox lobbies, 2v2, 4v4, and full beach tournaments with friends, AI, or other players from around the world.\n\n\ud83c\udf0d Massive Social Courts: Connect with others and explore vibrant beach environments while soaking in the Miami vibes.\n\ud83c\udfa8 Endless Styles: Unlock cosmetics\u2014jerseys, shorts, sunglasses, hats, team logos, and more to express your unique beachside flair.\n\nUpgrade with the Miami Courts Bundle for:\n\ud83c\udf1f Exclusive Courts: Play on beautifully designed courts inspired by Miami\u2019s famous beach culture.\n\ud83c\udfc6 Team Apparel & Challenges: Unlock branded jerseys, volleyballs, and hats. Complete challenges to earn additional gear.\n\ud83c\udfa8 Premium Cosmetics: Access exclusive volleyball-themed outfits, gear, and accessories to stand out on the court.\n\nFuture Roadmap:\nVolleyball VR PRO unlocks:\n\ud83c\udfe0 Private Matches: Create custom spaces and rules for exclusive games with friends.\n\ud83c\udfad Full-Body Avatars: Personalize your look with hairstyle, body shape, height, tattoos, and more.\n\ud83c\udfa8 Exclusive Gear: Mascot outfits, summer styles, retro shades, and more premium cosmetics.", "short_description": "Volleyball VR is the ultimate virtual reality volleyball and sports experience \ud83c\udfd0\ud83c\udfdd\ufe0f\n\nStep onto Miami\u2019s iconic beaches and dive into thrilling 99-player lobbies across 14 volleyball courts. Whether you're a casual player or a fierce competitor, Volleyball VR offers the perfect blend of realism, fun, and community.\n\nDownload Volleyball VR FREE to experience:\n\u2795 Simulation Physics: Feel the most realistic volleyball gameplay in VR. Control serves, spikes, and volleys with precision like never b4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgames", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type":
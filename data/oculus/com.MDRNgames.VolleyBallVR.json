b=1-7&_nc_sid=6e7a0a&_nc_ohc=NMP8rC-GFMwQ7kNvwGKP8Ml&_nc_oc=AdoXKU6DWYaFZk9JZMqy7dpxWDZT7nhgoJeUCTqOZt3JvpKakKZ4oJ2LKrpQt65qVJ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH1StUkVHCC9uL4f0PXy_FxfQmFlggNnMf6JhlsORmew&oe=6AFDC7F8"}, {"file_name": "05-sunset-beach-overview.png", "id": "4708693072739779", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673525341_4708693076073112_3570484297610379121_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSC5P-6Jc30Q7kNvwEMHJR5&_nc_oc=AdpRpDVHz46bGqwapvU8Wk3nvPQQwaoZGQhaeKozZKH5VLM5e6qcQZyVtp20Q5qEdJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoImFb7YqLW6UxHxp4vJXzqoXAJ9VvgTM3quJ4sS6Q_w&oe=6AFDDC9D"}, {"file_name": "04-club-arena-rally.png", "id": "2160182941512873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_2160182944846206_9181204810863835997_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2CPV5C1Dz8Q7kNvwFiitH5&_nc_oc=AdrJlaygwRxXDDhvrlEzkamftKZIf_87xYWAUtLfQFXHlmFqwmYIYfb8_XiXfcC1FC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXypMvD6ktmPvzARoahvjnfHh_mSZNATE9_W1obS8YlQ&oe=6AFDE22F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "779260740_1102531792157703_8807727590510498791_n (1).png", "id": "1085843954247658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1085843957580991_4014403557910823783_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmEn1maIG7sQ7kNvwH9HgVs&_nc_oc=Adq160gPoR4FtCvQ5Nt9e1AxEEuXEt5fPnRq7W4k7oNZG4s7644xlCqmq3aJwFaENXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR8ZHdkjYnwjA1NuV4z_qvvr7qSpypu3Lk57CYxk_p8Q&oe=6AFDE1E6"}, "display_name": "Volleyball VR", "keywords": ["volleyball", "beach", "sports", "sandbox", "fitness"], "long_description": "Make the next rally yours. Volleyball VR brings serving, receiving, setting, spiking and blocking to a beach-club world you can play with controllers or hand tracking.\n\nGOLDEN HOUR\nDiscover refreshed beach characters, the rebuilt Miami Street coastal courtyard and Club Arena, and Resort Beach in daylight, at sunset or after dark. Higher jumps, improved body and hand alignment, and updated beach ambience bring fresh energy to the court.\n\nPLAY YOUR WAY\nPlay offline with AI teammates and opponents, or find an online match, host a room and invite friends. Choose team sizes from 1v1 to 4v4 and four difficulties: Rookie, Amateur, Pro and All-Star. Adjust assists to suit your game.\n\nBUILD YOUR SKILLS\nWork on Serve, Receive, Set, Spike, Block, Movement and Rules in seven Guided Drills. Chase personal bests in Keep-Up & Pepper, Serve & Spike Targets and Reaction Wall, or progress through the Resort Tour. Practice is also available in mixed reality.\n\nMAKE IT YOURS\nChoose your player and volleyball separately in Your Locker. Adjust ball size from 21 cm to a giant 150 cm, and tune movement, audio and comfort settings for your next session.\n\nFrom your first serve to a hard-fought rally, there's always another reason to step onto the court.", "short_description": "Serve, set and spike into Volleyball VR's Golden Hour update. Play offline with AI or join friends online, sharpen your skills in guided drills and skill games, and take the court at Resort Beach, Miami Street or Club Arena. Choose your player and ball, adjust the difficulty and assists, and make the next rally yours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgames", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR
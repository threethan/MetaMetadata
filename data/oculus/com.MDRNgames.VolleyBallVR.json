_nc_ss=7f20f&oh=00_AQG4aqSjCdN2htUe7q6PimDAagQ4OkmqCkCMY0N423saUg&oe=6A81A33F"}, {"file_name": "ac347abc48c44a81b6bd3e5aef2a3cfe_resized.png", "id": "881434077493753", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982683_881434080827086_5377137216687803039_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xe3D8q6B0UQ7kNvwEiEapK&_nc_oc=AdpMVGVicJjp4oQCxNFddLGxGsLhm5ZmJc6uLlMJWxp3_J-wzuV2AcWB54OkIY1EFME&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsmkDUG_dkDi1Hd-zlodSHgTkKVIDARzre_3qfMI_Mfg&oe=6A81BB35"}, {"file_name": "26ca59a0714a4b168595559b45b758d9_resized.png", "id": "480955591228899", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031309_480955594562232_1744480508559689506_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_pKDMeLVXgQ7kNvwEBXglP&_nc_oc=Ado9F3IySlBHK6J9h6zZj8TRUoa5CzdLtGbCtnVUC9HqEZCGrFRfB3UxH9KpXux3CAg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcdkmG6pO9H0s-_-sjxi8lS2dREyhr60nSSX92w6iOsA&oe=6A81914D"}, {"file_name": "6ee8aed9fcdf458a9db7a93553a03839_resized.png", "id": "935111128714060", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974856_935111132047393_4875139789889162814_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTgd2mtHmOsQ7kNvwG-E7D4&_nc_oc=AdpFFRugwiQuSRjd6MQ1pCx_rTPM6mkGHlrk_v45-j3mz82r99R7xPRlCE_pSlvVrqY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzR_6VMEiQKbjCmXgoNOgkOcOOh7pdElVETf9DEJky_w&oe=6A8191C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Volleyball VR (Early Access)", "keywords": ["volleyball", "beach", "sports", "sandbox", "fitness"], "long_description": "\u2795 Simulation Physics: Feel the most realistic volleyball gameplay in VR. Control serves, spikes, and volleys with precision like never before.\n\ud83c\udfae Multiplayer Games: Jump into 99 players sandbox lobbies, 2v2, 4v4, and full beach tournaments with friends, AI, or other players from around the world.\n\n\ud83c\udf0d Massive Social Courts: Connect with others and explore vibrant beach environments while soaking in the Miami vibes.\n\ud83c\udfa8 Endless Styles: Unlock cosmetics\u2014jerseys, shorts, sunglasses, hats, team logos, and more to express your unique beachside flair.\n\nUpgrade with the Miami Courts Bundle for:\n\ud83c\udf1f Exclusive Courts: Play on beautifully designed courts inspired by Miami\u2019s famous beach culture.\n\ud83c\udfc6 Team Apparel & Challenges: Unlock branded jerseys, volleyballs, and hats. Complete challenges to earn additional gear.\n\ud83c\udfa8 Premium Cosmetics: Access exclusive volleyball-themed outfits, gear, and accessories to stand out on the court.\n\nFuture Roadmap:\nVolleyball VR PRO unlocks:\n\ud83c\udfe0 Private Matches: Create custom spaces and rules for exclusive games with friends.\n\ud83c\udfad Full-Body Avatars: Personalize your look with hairstyle, body shape, height, tattoos, and more.\n\ud83c\udfa8 Exclusive Gear: Mascot outfits, summer styles, retro shades, and more premium cosmetics.", "short_description": "Volleyball VR is the ultimate virtual reality volleyball and sports experience \ud83c\udfd0\ud83c\udfdd\ufe0f\n\nStep onto Miami\u2019s iconic beaches and dive into thrilling 99-player lobbies across 14 volleyball courts. Whether you're a casual player or a fierce competitor, Volleyball VR offers the perfect blend of realism, fun, and community.\n\nDownload Volleyball VR FREE to experience:\n\u2795 Simulation Physics: Feel the most realistic volleyball gameplay in VR. Control serves, spikes, and volleys with precision like never b4"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/", "developer_terms_of_service_url": null, "publisher_name": "MDRNgames", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
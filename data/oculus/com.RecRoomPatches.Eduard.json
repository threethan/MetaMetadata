SGgNEaQvNXaekEcvPDoQ&oe=6AFDCAB9"}, {"file_name": "16c41545-513c-43b4-8f4e-064c9b48dbf7.png", "id": "29011755148436629", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_29011755171769960_5053812964223288762_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVWUBtvVUGIQ7kNvwG09wqU&_nc_oc=AdoaxNtEMEUCSYFc6IXVlf7MR0ehDorE407K5YeMyiAXT60nlAFEHf54G1PELsPa3XI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTmUk43nvG0wmgL7gTRmqjqDpF_oMToSFJIfeDCyBClw&oe=6AFDD5D6"}, {"file_name": "6035a5e7-68f9-430e-9e15-13d168774d8c.png", "id": "1137923425292895", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1137923428626228_2048204057792088217_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK4wGsOWv4IQ7kNvwEypgJ8&_nc_oc=AdqZiAUE4Eze5D-TS_a8wuFHMoGGFnRsBVarY2tjBa0s-o0xJzVZ0-8X4t9lZxo5JtE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN9IeUfgI4ExgfGGp2euY7hcE3PHxReNuRD9C1lWTAEQ&oe=6AFDE041"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Patches", "keywords": ["social", "hangout", "multiplayer", "voicechat", "community"], "long_description": "Patches is an unofficial, community-run social VR project. It keeps a classic social game experience playable on servers run by the community instead of an official service.\n\nWHAT YOU CAN DO\n- Hang out with friends in your dorm and in public rooms\n- Talk with built-in voice chat\n- Explore, build and save your own rooms with the maker tools\n- Create and join events, and schedule them to start in just a few minutes\n- Join clubs, send gifts and customize your avatar\n\nYOUR SERVER, YOUR CHOICE\nPatches connects to the main community server by default. While the game loads, press \"Change server\" to type in the address of any compatible community server. You can switch back to the main server at any time. Each server keeps its own accounts, rooms and progress.\n\nACCOUNTS\nCreate an account on your first launch, or log in to an existing one. Use \"Remember password\" to skip the password next time on this headset.\n\nPLEASE NOTE\nPatches is a fan project and is not affiliated with, endorsed by or supported by Against Gravity. Servers are run by the community, so availability and features can vary from server to server. The microphone is only used for voice chat, and only after you allow it.", "short_description": "A community-run social VR hangout. Meet friends, explore and build rooms, host events and chat with voice in spaces kept alive by the community. Connect to the main server or type in the address of any compatible community server, right from the loading screen."}]}, "developer_name": "RecRoomPatches", "developer_privacy_policy_url": "https://recroompatches.pages.dev/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Eduard", "support_website_url": null, "website_url": "https://recroompatches.pages.dev/#features", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1308879515651902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1425340565734445_3518104487750372897_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_n
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=pflu7eOefjUQ7kNvwFClpMd&_nc_oc=AdpA1iSKMs6HvvrSo-6oKYTvVXVDzQoLzpUyJyTL-6K_9060xQy1yBmMGBrCUpMnwsw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDvOiR8PzVuy5sN2jmxVVH9paiFwDejQTnbH0_K2eXWg&oe=6B086AF8"}, {"file_name": "oculusAsset 14.png", "id": "815349909193915", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75361346_815349912527248_5492795874282751772_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHQfwrbM-RsQ7kNvwETvtbK&_nc_oc=AdrI_1xE5eAmq0yqi9jejJjRjIXhRZsBjvrUT2MZlyWmnEbgSdLVTv-pPzu-3zfbKEA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcf3O3qySi1Pr2pDgI9S8gg69TVd3ewvwYpyi-fJUPsA&oe=6B08458B"}, {"file_name": "oculusAsset 12.png", "id": "1319764898422698", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57572929_1319764901756031_7982105661700720073_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qeeNcaptMgQ7kNvwFbSevQ&_nc_oc=AdqxBF5zy3VYPkrChRNklaFLISR1M6owiyNtwPiCEyL6FcIKaPxzwDGTH47TiGoulH8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgpHceizVDkCgTBKIpJzOzRRTCMDqsmf6OKUy3DiCNbw&oe=6B086357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 5.png", "id": "895648881253348", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984445_895648884586681_4943548350184216825_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUE0I8GM0N8Q7kNvwGpK5HD&_nc_oc=AdqT_mOJtZTuL_385vVjI9gR4-b4EEssmapCg4hVB8j-6ktR9vu-o4wmH0T8Uz-V__c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8poTTYMGPYa02-tU0sjhfKMZm3bWlsxiIjCzTNuRaoA&oe=6B085689"}, "display_name": "Car Parking Simulator - Driving and Racing", "keywords": ["Driving", "racing", "drive", "parking", "car"], "long_description": " # \ud83d\udd30  Learn To Drive In VR   \ud83d\udd30\n\n- Used by thousands of people to learn driving and parking.\n- The game has also helped reduce **driving anxiety**. \n- A **Free Roam City** featuring various challenges like racing, taxi, etc.\n- Left and Right steering options.\n\n# \ud83d\udd79\ufe0f Controls designed for VR\nAll cars have realistic controls and interactive interiors with customizable right or left steering orientations.\n{1532401434021514}\n\n\n# \ud83d\udccc Realistic Mirrors and Interiors\nAll cars have realistic mirrors and left and right-hand driving options.\n\n{865634415412163}\n\n# \ud83c\udfc1 Multiple Challenges\nComplete various racing challenges, including taxi missions, rooftop missions, checkpoint races, and much more.\n\n{461614410055878}\n\n# \ud83d\udefb Varitey of cars\nHatchback, sedan, SUV, or sports car \u2013 we have it all for you to hone your driving and challenge completion skills.\n\n{1027966278361492}\n\n\ud83d\udccc**Download now** to learn to drive or hone your parking skills. Complete racing challenges, undertake taxi missions, or drive and race on the tops of buildings.\n ", "short_description": "Learn to drive in VR with Car Parking Simulator, offering both left and right-hand driving. Experience over 65 different parking levels and a Free Roam City featuring various challenges like racing, taxi missions, and much more."}]}, "developer_name": "Sloppy Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit?usp=sharing", "publisher_name": "Sloppy Studios", "support_website_url": null, "website_url": "https://sloppystudio.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "
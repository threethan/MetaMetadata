ame": "oculusAsset 12.png", "id": "1319764898422698", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/57572929_1319764901756031_7982105661700720073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAwtsUOAiucQ7kNvwGcyKEJ&_nc_oc=Adr1xdVkvSjolQQ4_DUYm4sewN1EJ-ngP5Z41KJOyFhGRzN1OCniexlCCr5x75aqljg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjaGrucPwDQPzic0rZWXeKI7tvhCJ5hiiYYdDG_Frhfw&oe=6AAE8517"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 5.png", "id": "895648881253348", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38984445_895648884586681_4943548350184216825_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8046ulf43MQ7kNvwEe8Oev&_nc_oc=AdonPQPcHPH50jzduG6l4FdMB3ThzECB3knnzfL47N8ZB-9KhsAzmtwgs7LQzFaiSFY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIrR3BnkWl-LDj7BOJUY1SEuwcrTiIpgF2Nna5zpioJQ&oe=6AAEB089"}, "display_name": "Car Parking Simulator", "keywords": [], "long_description": "Car Parking Simulator is a fully interactive, realistic and immersive car parking experience. Introducing one of the most advanced and dynamic car physics in VR.\n\nGiving players more wings of freedom by introducing a Free Roam mode in a town with a realistic traffic system, bustling with various fun activities and challenges to compete in, or just drive around and chill with any of your unlocked vehicles.\n\nFeatures:\n- All cars have realistic controls and interactive interiors with customizable right or left steering orientations.- Three main vehicle challenges, ranging from Sedan, SUV and Hatchback.\n- Formula One (F1) vehicle available as a bonus car for fun!\n- Different exhilarating environments in different parts of the day and night cycles.\n- Total 65 levels, giving you ratings based on your driving and challenge completion skills.\n- A free roam mode for players to explore using any of the unlocked vehicles or to try its own activities and challenges.", "short_description": "Car Parking Simulator is a fully interactive, realistic and immersive car parking experience. The game has one of the best vehicle physics simulations in VR."}]}, "developer_name": "Sloppy Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit?usp=sharing", "publisher_name": "Sloppy Studios", "support_website_url": null, "website_url": "https://sloppystudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3245153735708266"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1681163453110257"}, {"status": "PUBLISHED", "id": "1525838085917613"}, {"status": "PUBLISHED", "id": "1243673404598143"}, {"status": "PUBLISHED", "id": "2054639538601124"}, {"status": "PUBLISHED", "id": "1360208496122190"}, {"status": "PUBLISHED", "id": "1370426417901029"}, {"status": "PUBLISHED", "id": "1148590947239129"}, {"status": "PUBLISHED", "id": "861237619559308"}, {"status": "PUBLISHED", "id": "1462251881707176"}, {"status": "PUBLISHED", "id": "771416108620777"}, {"status": "PUBLISHED", "id": "2093212771174005"}, {"status": "PUBLISHED", "id": "1356938049060391"}, {"status": "PUBLISHED", "id": "61800405782724
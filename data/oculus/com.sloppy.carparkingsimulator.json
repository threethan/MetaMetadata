, "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572929_1319764901756031_7982105661700720073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6V7-n4KuXigQ7kNvwH9v--H&_nc_oc=AdlGvqzeFIqPlzvZaV3ANM8Sp7tQATpElQTAm8vIRLG_DRkYc1E56B8zcG12AfanP6Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwcZapuHMjxjrgfX-DO6zRQjLaZHHXhCfYgoZNRk6sv7g&oe=69BA9F97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 5.png", "id": "895648881253348", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984445_895648884586681_4943548350184216825_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FltOKVyWMrUQ7kNvwE2SyVa&_nc_oc=AdlwTRzZR6J6jR17DyYO6Vg2SEaMWWMnx8fH0Vw_L_1ap1kKChapnW3WJtXBnD5EV48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSDtWt7mmAHroVlkBjWyDUj665huYCX4PeTULBeN_XPg&oe=69BA92C9"}, "display_name": "Car Parking Simulator", "keywords": [], "long_description": "Car Parking Simulator is a fully interactive, realistic and immersive car parking experience. Introducing one of the most advanced and dynamic car physics in VR.\n\nGiving players more wings of freedom by introducing a Free Roam mode in a town with a realistic traffic system, bustling with various fun activities and challenges to compete in, or just drive around and chill with any of your unlocked vehicles.\n\nFeatures:\n- All cars have realistic controls and interactive interiors with customizable right or left steering orientations.- Three main vehicle challenges, ranging from Sedan, SUV and Hatchback.\n- Formula One (F1) vehicle available as a bonus car for fun!\n- Different exhilarating environments in different parts of the day and night cycles.\n- Total 65 levels, giving you ratings based on your driving and challenge completion skills.\n- A free roam mode for players to explore using any of the unlocked vehicles or to try its own activities and challenges.", "short_description": "Car Parking Simulator is a fully interactive, realistic and immersive car parking experience. The game has one of the best vehicle physics simulations in VR."}]}, "developer_name": "Sloppy Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit?usp=sharing", "publisher_name": "Sloppy Studios", "support_website_url": null, "website_url": "https://sloppystudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3245153735708266"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1360208496122190"}, {"status": "PUBLISHED", "id": "1370426417901029"}, {"status": "PUBLISHED", "id": "1148590947239129"}, {"status": "PUBLISHED", "id": "861237619559308"}, {"status": "PUBLISHED", "id": "1462251881707176"}, {"status": "PUBLISHED", "id": "771416108620777"}, {"status": "PUBLISHED", "id": "2093212771174005"}, {"status": "PUBLISHED", "id": "1356938049060391"}, {"status": "PUBLISHED", "id": "618004057827243"}, {"status": "PUBLISHED", "id": "1063386068584674"}, {"status": "PUBLISHED", "id": "1277861413221664"}, {"status": "PUBLISHED", "id": "536290202169964"}, {"status": "PUBLISHED", "id": "1235234324524478"}, {"status": "PUBLISHED", "id": "906577584418562"}, {"status
_ohc=GPbP49NXJOEQ7kNvwHZXkti&_nc_oc=Adq0J_vQWC1TaZ6u17TtgTS2wWfwsldQZHp8VS9LdVicfeHeIz5oJ-nmNRgj6i1Kr5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxS7MeNNRributO6HiUFkENKPpcGA1ePt8WmwaIdcdjqw&oe=69C281E9"}, {"file_name": "5.png", "id": "1094348318160564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001667_1094348321493897_7028478148691190355_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZlIdyKsTWYQ7kNvwFGzTCK&_nc_oc=Adp_wkIo764tuaCGBR5Ro6n0YjkwFeYaEXyp5kVyymKLun8lu6PLd0nAlbyLAo-vBPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwm56hWReUKroYUx8q330rLKIkrnNl9HhVtGXQE7KfgnQ&oe=69C275D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aabb.png", "id": "473915590962675", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86795868_473915594296008_6297915345418724971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1na7pwEM5SoQ7kNvwHwOKoy&_nc_oc=Adp7XvIgqj55SYT3qWZutPfeeAgERmQ5M9V4yFs-DeGrgBwZAgLwjuPOuRcPDz2yTf4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxT08hiuxb-e8Xx04I3JVHUI94HKH3Y3Tco_5NpIIEqMA&oe=69C2709A"}, "display_name": "AdonisVerse", "keywords": [], "long_description": "The accommodation sector, especially the USA, EU countries and Far East countries, is shifting its services to the metaverse environment at a great pace. In parallel with the developments in technology, hotels and surrounding cultural areas have already started to fill the metaverse universe thanks to the use of VR Head Set and high quality metaverse digital images.\n\nIn addition to the private sector, the institutions of the countries operating in the field of tourism have also started to take various steps to develop metaverse applications. Such applications, which take the developments in the online field to the next level, arouse curiosity and admiration for the consumer.\n\nThe idea of \u200b\u200bhaving an experience in the metaverse is attracting the attention of consumers, and it seems that it will become a routine activity in a very short time to examine the digital twins of the hotels they will stay in before booking.", "short_description": "AdonisVerse launched AdonisVerse at 2022 Dubai ATM. It attracted great interest and appreciation by introducing the metaverse applications of Titanic Mardan Palace Hotel to guests and hotel owners from the Middle East and North African countries. The evaluations and requests received were the first indication that the trade area metaverse applications will increase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/7096e759-738b-4c24-b1ae-bc06dba96517", "developer_terms_of_service_url": null, "publisher_name": "Adonis", "support_website_url": null, "website_url": "https://adonisverse.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "745410350056627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035338_5128159977307041_1178324920557050367_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTPADkGxRDEQ7kNvwEy71Tf&_nc_oc=AdpRSuYiKBzUu-Exv6QahgGr-DV-h_ry25CjdlPSFXNh8w4k8MD3X1xWGA43ewsPBS4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZYZpKGTsspEzaDsTEWu6tWQeIPIzC0RBI9-in5vo5zg&oe=69C279EA"}, "is_concept": false, "is_test":
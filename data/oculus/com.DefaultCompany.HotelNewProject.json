_ohc=UxnYABAsXP8Q7kNvwHIbDCQ&_nc_oc=AdrfGCQg2bft-AIMo_TesBRx8xtV1luaHXxdN674hYgGIMqKNHqQhMLGSMafrTr8MBA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyu5v77jSeaYaFxyrvcOkXOVqHa3faEDPVSX_ZQ1T8niw&oe=69C7C7E9"}, {"file_name": "5.png", "id": "1094348318160564", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001667_1094348321493897_7028478148691190355_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWKJMHltIgMQ7kNvwHxQxRI&_nc_oc=AdrM0bPeotgivPnmYmOULhDii7Ey7zabhNAw1G0cKS6cU071DYl5iH46FK66Ln7yVtM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afybqc1zH8cOw5bR-SUZpU_lq_KJU1XQb4WfFjul-blceg&oe=69C7BBD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aabb.png", "id": "473915590962675", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86795868_473915594296008_6297915345418724971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT7o73E8FtgQ7kNvwEPDd3f&_nc_oc=AdobrcL9o1bVU7eHT36kStne4K_Qz9DlKR1rK6MQw534-abAIaJNT7x1S46StGUxK4A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVEwbBQ8EWercTCUD6HzbLeFMX9vjw7TWIQuP4oIxQ2w&oe=69C7B69A"}, "display_name": "AdonisVerse", "keywords": [], "long_description": "The accommodation sector, especially the USA, EU countries and Far East countries, is shifting its services to the metaverse environment at a great pace. In parallel with the developments in technology, hotels and surrounding cultural areas have already started to fill the metaverse universe thanks to the use of VR Head Set and high quality metaverse digital images.\n\nIn addition to the private sector, the institutions of the countries operating in the field of tourism have also started to take various steps to develop metaverse applications. Such applications, which take the developments in the online field to the next level, arouse curiosity and admiration for the consumer.\n\nThe idea of \u200b\u200bhaving an experience in the metaverse is attracting the attention of consumers, and it seems that it will become a routine activity in a very short time to examine the digital twins of the hotels they will stay in before booking.", "short_description": "AdonisVerse launched AdonisVerse at 2022 Dubai ATM. It attracted great interest and appreciation by introducing the metaverse applications of Titanic Mardan Palace Hotel to guests and hotel owners from the Middle East and North African countries. The evaluations and requests received were the first indication that the trade area metaverse applications will increase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/7096e759-738b-4c24-b1ae-bc06dba96517", "developer_terms_of_service_url": null, "publisher_name": "Adonis", "support_website_url": null, "website_url": "https://adonisverse.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "745410350056627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035338_5128159977307041_1178324920557050367_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvvmkIhG7WwQ7kNvwFRft6m&_nc_oc=Adrg215VpYa8MfQvQijlOiyocmBiT3Y3xfwSV6R6N8cUN0Kv2a3ivm2Cw-_JxTKLOtI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRORMoLBs0MbrJDDhzvFA1cg6lg0BEkffi57lY8f0FPQ&oe=69C7BFEA"}, "is_concept": false, "is_test":
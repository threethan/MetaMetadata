dn.com/v/t64.5771-25/75542962_518285113400537_6949745674497861183_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vrOj1WN2CEQ7kNvwE3amch&_nc_oc=AdmvuifJsM7cPnx0mI8pkDp6oq2uttyD-8IagJw0jFX2WW0y3sxQnVtqFJCtNBSeYJA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTpz3uNnE_g8tfMR_PExHtgbvCSQKCip1k7PMhsWbAsg&oe=69AACE1E"}, {"file_name": "4.png", "id": "5346806112075298", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035399_5346806128741963_8866505916435789603_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmeTIxjdznEQ7kNvwGvWX6O&_nc_oc=AdnPq2TkOIDI_MiN6rgYi9qnddE2gn-Y0-OTV5IZO8Gq2gSdTNjKZp41koAWcMenpAQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwlu5hm8dnGLb7jKbhEMJHOykMuaml4xTXs1qWZEdKjng&oe=69AAE509"}, {"file_name": "1.png", "id": "754993939285547", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/86610563_754993945952213_3767906655711447854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xuy9V9-hCCYQ7kNvwEGOjAS&_nc_oc=AdlVpFZRsAYFAVeBv3k4eXvyPAlvvnI3KylvVWY8tX_FcKGQFq8QaH1GGQmNDgmXBtM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCVZtIHfnKnzAa3CzEoxK3O55Lq6XeX2_d4GT8427bLw&oe=69AAC6E9"}, {"file_name": "5.png", "id": "1094348318160564", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001667_1094348321493897_7028478148691190355_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v20fAlCjx4cQ7kNvwE_8eU2&_nc_oc=Admlw96PPjGZSmq6LpQoXLFoD4JMAwX3ZUeuQvscvzKvmb45kF8VoO2pj9OxatfFxG0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPdG4lVu6zpC6Ho09I6_nD_tHJvrCuViTC04SfOA6LUw&oe=69AABAD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "aabb.png", "id": "473915590962675", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86795868_473915594296008_6297915345418724971_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5JasIWX69gQ7kNvwFoLLkL&_nc_oc=Adn6pTEeZMHm_D_vygGxBN5JtMFB4Uw3A_meQ4oS-r3HXopFWwdACvldkIkauhQiREw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afyq5ZJqlgnOkWeTJxJG-LC2Uf695qg_nxLmG_b18dGwLA&oe=69AAB59A"}, "display_name": "AdonisVerse", "keywords": [], "long_description": "The accommodation sector, especially the USA, EU countries and Far East countries, is shifting its services to the metaverse environment at a great pace. In parallel with the developments in technology, hotels and surrounding cultural areas have already started to fill the metaverse universe thanks to the use of VR Head Set and high quality metaverse digital images.\n\nIn addition to the private sector, the institutions of the countries operating in the field of tourism have also started to take various steps to develop metaverse applications. Such applications, which take the developments in the online field to the next level, arouse curiosity and admiration for the consumer.\n\nThe idea of \u200b\u200bhaving an experience in the metaverse is attracting the attention of consumers, and it seems that it will become a routine activity in a very short time to examine the digital twins of the hotels they will stay in before booking.", "short_description": "AdonisVerse launched AdonisVerse at 2022 Dubai ATM. It attracted great interest and appreciation by introducing the metaverse applications of Titanic Mardan Palace Hotel to guests and hotel owners from the Middle East and North African countries. The evaluations and requests received were the first indication that the trade area metaverse applications will increase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/7096e759-738b-4c24-b1ae-bc06dba96517", "developer_terms_of_service_url": null, "publisher_name": "Adonis", "support_website_url": null, "website_url": "https://adonisverse.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": 
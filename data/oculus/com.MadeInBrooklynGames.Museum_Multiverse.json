c_ohc=nZR7c8H2Y8IQ7kNvwGrQYeg&_nc_oc=AdooevQ_jM0gb8SRYoEdVTUYHeNZr0RAw-M3_KZOGjGH2YcuTq74ZtfbpB8UzDKgTpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiLHrXwSxetHS8cEOt4z5aJSLtrqjM6stMzLUFMUOx_A&oe=6AE6143B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUmeTkLSbp0Q7kNvwHwZv6B&_nc_oc=AdpdHUcyhxuf2zMZgCcBTeQy6b-_bj88dSPfKNW9Ypk_bNUTqSZAvSJaOxkgF2VvA24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNYhVItMAARYKMOhgXi5xu0ONCj0RRvoqTshgwXVOl0g&oe=6AE5FC3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwsDpVLWj4oQ7kNvwGq08o3&_nc_oc=AdpFB8J_1XodDUZv4iOoJaTVyfJJx5xSpN3Zp6uNnNohzTdmlRpV7RpTalIpe4fkHNI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQzpTU0dejxXvaNkLyYsLvuq6Oa_6WPAYtDxpfwryCCw&oe=6AE5FFFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms-Jv43ukNMQ7kNvwFg7LUL&_nc_oc=AdqrCUSU4AK3_Q0xNPNT-16KP8B3j-gy503lMTUH6VSavM43spSrXajlnFtsh5LlQtg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNnngm2bhdPSDl34A2WH6eZ-B8BkM8L5HYRoQPwSHFSQ&oe=6AE60B51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmKIo_5a2R8Q7kNvwFiHOk8&_nc_oc=AdoWpZ_A72SC_Uh7dPotE9gAV4D0Ngf9EByC5td4AasZdroqnwQGqPR4-jhp-9EhF0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkaZztA15QcGO2Att65vHPmhsFchBJ5xH8feCZqcAibQ&oe=6AE5FBA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
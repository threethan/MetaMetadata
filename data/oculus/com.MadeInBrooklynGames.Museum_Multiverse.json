_ohc=reoR2hZlPBwQ7kNvwFSrCRM&_nc_oc=AdpxwviaiLpeRq3CmqT-bIQGxKgRWHBqU2hSyBdt-3QmkRQ6hP_U2kPC9anT-hPt2DA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eC9Etft7CH8diAwKFjrbFFWbxzADQXlOorzTbh2Fe4w&oe=69F4997B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqcXDoh6F_oQ7kNvwGUSImk&_nc_oc=Adq03RXtK0GmTd47hM6eGoZopPVAxx8YxlKmBU148vx_LwGKvppm14AjGi-YR6OiX3o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10sjozoqp5rIcMV7ipZbZfWe4WwVM5M8vcvdikrkQPhg&oe=69F4B9BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz1A_ek3Zl4Q7kNvwEj3usX&_nc_oc=AdpwggSgmeF_gImQ_QJvLRvXcyr5lSxLBxoj3OQoeKKhtMVkPVAL_D4115se89gEEUI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0VQB9J-xR3SmLTE7smIoA5UWS2EOy6ou7H_pKzZWthiA&oe=69F4BD7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ba1r_a9tTUQ7kNvwEm6ZhG&_nc_oc=Adrg35LKpNWkrr8ysT_tGf0xRfTmuF37MBQQlR95e-kqvl2456jypj-ZRol4Y5ilSpg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AlkX-P-1da-RBfGp1FsmWJ5UzouKFVxpLpSlSGAeajw&oe=69F4C8D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2g5DdzsltkQ7kNvwGaYQb4&_nc_oc=Adr7_oIHSZUDm1Erz-lg3ygsWmgGv12YZk2zrMK1iiHK6oaJsg2L_Z1lfMYuWN3JUTA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Py04hnAeVUUM9ol8gnMzBK_kT4NEwAifEdWKKKm0YBw&oe=69F4B928"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
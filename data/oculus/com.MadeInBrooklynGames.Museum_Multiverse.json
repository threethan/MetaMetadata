sid=6e7a0a&_nc_ohc=WOKUIcMjHqwQ7kNvwEuHG7h&_nc_oc=Ado4URZ8tcvZmIMvY7FFvucmBvKN0pl5EstSU7UvIjsmVz5yabE5fuJNqp0aEJ049O8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBLH03rlnXRPb8nqm813GRdRUzrN_bAlT_AWGlrNCqfQ&oe=6A8ED8FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP2NoutM8UcQ7kNvwF0kneB&_nc_oc=Adpeo5f5AvrPDTQ0CQZ4gnWAHmyaC29ZCMF3FuzSAmmLBU568GAKiJNV5UWmFW0RDvo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaK5Sr41N5nxa6-ExoxRC4hTUGeeieDJis4TZCKLjgCw&oe=6A8EC0FA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hl0L4DFPMxEQ7kNvwHdiDxf&_nc_oc=AdpsTGg8vifiWdpx-gYtVIvIgMRy-Ghz14O_xhg5UiZ5-d174XB-69Rjdms3S72mpmg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgIkBRxivVNll9VSYgBmd9HPnnnslTNw004DkVZFyByg&oe=6A8EC4BE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLv5pzPEwCQQ7kNvwH-_HCi&_nc_oc=Adqg9uYLIE6np54d7mJqW92GjuT_iU3OHImJ1JFzAKcXGFnGpquTipHWOW-mWoY3N64&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQnKdiwwmtQepsJCvmt0CiISXOp9DbrOraP6STjwV3Mg&oe=6A8ED011"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AFXDdWYxwkQ7kNvwGqlCwO&_nc_oc=AdruU_CxyBfNk0Wo18kvtzxFc2Uo0Rl7A8UBcl9J_14pl-lxXosJTdIqmAKHtIutlss&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGawaMtYkfa6Ej-AIOKwIu8Hk5hHpKJayeASiggkQQzgg&oe=6A8EC068"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "d
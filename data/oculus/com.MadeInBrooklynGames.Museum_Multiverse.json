_ohc=JEqv-WMNZUkQ7kNvwEL4wPB&_nc_oc=Adp8MPj6XrXyQASrfNJJuf7K1Dwq_4Bc810MHUU2X0b8plGn2OLjau7qfIBUiaMe5Tg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l0DR5d9rCwjr2e9Q-rTyvU64iUlIVf1Y5wT2RkQvrrw&oe=69E618FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C0FBFXp70EQ7kNvwFn1WEZ&_nc_oc=AdpftqGNRdTRuBdCbWl6oVcoGHY23P5xoYjk70rcBKrRjJRY4lDZP0NRi-C1agU5VTk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oH_PeeK6KZBicwbg7VgZZCKV_SdG9mcC_5MbXkntTMA&oe=69E6393A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knoBOMqLe6MQ7kNvwH5I-dU&_nc_oc=AdpMPNUBRfrzOWUyyFfaLlme8HdpOa1mRODFZvKpNvhGDrdoQDTCBmqN6khd1472OAk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kZ8JCrYuOcf9Doq6piXU2Z_Nn7dxo9_weE8Kzj7q8Lg&oe=69E63CFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJLjoC0pZ3UQ7kNvwG57fYY&_nc_oc=AdrOPuY1gcjRcW9rb2mm1CaobNsIqKejkLS9TQ9tuQaSgJTE4u7XGfAErtNYi12yquw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HOSWE0ROSOdNw0XTYBHUXyAE1EC6WaOAhyhD17Eo77w&oe=69E64851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weDNJ_21B20Q7kNvwF_MjZy&_nc_oc=Adr9yZiiC375Icmcu7HVbtMX50mUhzcZlaL6Y6XMpoHcRS1Yaew-V2q0resfw3DPZ_0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-f74fnbt2DtzCNhOWQNZfR3maOHMwHVYK4cria5wEnA&oe=69E638A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
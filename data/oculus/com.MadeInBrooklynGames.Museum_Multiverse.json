c_ohc=TKerTU4Hv1sQ7kNvwGZBn7M&_nc_oc=Adp-ttaiOHi_IlZ4oLr1zCANVFlGEXGDcF3UYSzzE16yk51Yy5pItnDicXy4q9OvwFI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACzv-6ltKF2XUeeDNd2Kj-55KpDGC331LVeROcsihUZg&oe=6A56287B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKBX9SmoAb8Q7kNvwE35fvY&_nc_oc=AdqlsMHym0Y6GseYsJKPBlEDNct_btuDLw477E2ONdQNbNO1-3QqO8OQ4IYeS0O34cw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJ1Flu4gnoD4O_yNYRFd8hWjV76HAH_PVG8hYvBQ2Mlg&oe=6A5648BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFNhYotU4vIQ7kNvwFZx2Kg&_nc_oc=AdqTC0IjE6YbAeO2cq0NHN-FGPB-waLvdvN8aCkueoUlTE7aAWyFlLknMR8fj0T8S3c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB54Gj5BGHurfijERhgPrFdNjWM85_MuWkvkoxDSnNeOA&oe=6A564C7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqxdPtHKZqgQ7kNvwFldLoN&_nc_oc=Adp-c4OhIX_RF7TniAHhlHr6bNdqKT3UIgbANJGgDIRLUfZdEOXsafLn6I15FTB6VLs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEQpOhzOulTfsVUh1AjikWt5f5VhnOryl0I2bVmllkLQ&oe=6A5657D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzp6wkNrI6YQ7kNvwH9_xcy&_nc_oc=AdpwDv2fUPKXlPuravb39Xsx8KkKnhAvdWbj1pBI5cMho79J5ru-GNUoC-_CLLf5j6Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy-K8_7netV6oCiTkifmWihCIBkmRp9Nv0FSq2MbUTvw&oe=6A564828"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
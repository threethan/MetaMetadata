c_ohc=bjrwbMLZXPoQ7kNvwFwElme&_nc_oc=AdovUmnVSHBQ0Dklb1divC-SNF9aunXLTK9fSYAZhKbq2DerfzuKd5ZAf5qLyBc8dJA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh_HVH8huaXgPcGMCBCP9NgQeWX-8msuVnCExam5M7yw&oe=6A71D7FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpERh561ZXEQ7kNvwHCWnuz&_nc_oc=AdpTghGmeKoXRvIodvsLZBHg9dyULf-HX1R78m0Jrxe8NyUQbWpXQIXfCksKLDD7Pis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjhFxqJjEw4_RoeVOjek01KTZbty6S7qH9yz1UVd85Zg&oe=6A71F83A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zO6Uz4rUClgQ7kNvwE1VqQp&_nc_oc=AdrnQJRFFmWHT-1mGQ2W285CfvrO_9zxrv3hA-bTljUT4WFW2Wk_4P3Zyg_zOOMh-QM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwjJcFrxM3G-PmS9ZrBnqm6yjkITvL6R9HmjhqPWUSSQ&oe=6A71FBFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLr1mflhsacQ7kNvwFuUYj8&_nc_oc=AdqPBiAE79mEdGAr246fEp6CF6l-nWGYZYJQvwrO4UgugOam2Rn3Gaca2-3SqnUMesA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbly0iVhbl21ba8g56R0RuEWAispWH9EQvtzwSVcn27w&oe=6A71CF11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOnlksrSV2kQ7kNvwGconIL&_nc_oc=AdqoG5wYirI6IToqOSL46PYdIClSjsnVMhf3VImKvdJwl2nFVus0NCuaGJvoovrX7dY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAXr-zJ50caKs_KjWjAANIjUkPN1H96s9N-y1PJa4EEg&oe=6A71F7A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
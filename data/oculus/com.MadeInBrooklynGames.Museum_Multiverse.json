_ohc=ds91i3pfbgUQ7kNvwHwnS4W&_nc_oc=Ado5117DS-r-urIO7fPaQWyrDSbXOEbhBphIYZrNkuzDo0aA7BwmQTHKXmTc6LMxKGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MZBNxBfHTd2jp4D2ExwmBagFnkG1_TDx9zuQZ7MmvPg&oe=6A356B3B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNQCS6gq9AsQ7kNvwH5TyGG&_nc_oc=AdrT0xX-_4Zce86oh5KD1OJbyOOe4_M4Lq-Sni1pSk9GUuUCxjiozkLhccIMZ71UbuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zOWDjku2osDb7VueljSw2Um3qvTX9SUTv6fdaNe8icw&oe=6A35533A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwE-9rm_Ha8Q7kNvwGjQRUD&_nc_oc=Adq19K3-ljX6mPHYx0zidFFyD0UKM5RmObduptVHN1Jj_SjdoIwvyIZtyOZ2TVl3ZGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U9hgYe2gwcquRoVhmxy6lzYun6CgfYSG2kqL1A_J_Gg&oe=6A3556FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT84XLUI1poQ7kNvwHl8CQP&_nc_oc=Adpr2Hn8ytywwL9eWv5kgvsaFv99QRHYAYQ-sK5a0-fnUklhGmJRpXXYlEeqboUZaEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m804BiZSP2Uk2C2T06qrq0VXE0ED52EUSZ54bKnl0GQ&oe=6A356251"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGru3nRSS4Q7kNvwFpzik6&_nc_oc=AdoR6LUAnyn1lal9MaKs5CdHDtSScpRKfnJ6CPm7wqQXEPAk67yOCKLnwW0pf_9zyDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2g8HDTsTWRYtJwJQ4kQ-43gQ97R8jESZTx2snyVFe2g&oe=6A3552A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
_ohc=MJ52mDi_mZsQ7kNvwGM_w4w&_nc_oc=AdpQc8IMsrvgi9hVuhZW6NOrg5XgZfDAqvN59rBJP3yWmQf1z590348I2TWy7SxmVsY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UrivTnS0BYxMSdjGZ2kgoa4k3sIypC-rxno5R5Z6aHA&oe=6A1C5EBB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beB7J6C6wzMQ7kNvwHhRsIh&_nc_oc=AdrGfh2oMJV7zCQXYdxzpr0zvjvHuYC6_RDrfUb_I6D-pGvFn1NxnFgdUJR7mJCJ4Xw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yNo7_VRHLhGSZUzzeFtB6qajtg6zARNigT4xnrQM6ow&oe=6A1C46BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brtiGXA4lzYQ7kNvwGaxQOm&_nc_oc=AdqXSCZQSl5sstmtcWDET3aHmSjIkQEH02k7QVaGdUkVYL3zz_YMuPg7Cojb548H3n4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IPpd9GqUPXtRzwzzs1meFxPmJniOSuau3ETV0Jy7gLw&oe=6A1C4A7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r97RaXxPET4Q7kNvwEAtCfg&_nc_oc=AdqSRIKgfiXxOwNjg36Gz5Mj2LNnevXb-yyh5NoxvYACTkweBFIa3z1diuESnpBGxXQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P3RgAZ9rIdZ2DNGopZXBeZpdB6yXRCnfMbZNNSzcwmw&oe=6A1C55D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10HJ5wFJVxMQ7kNvwEn1_FS&_nc_oc=AdqnJJiMn_vzsagZ5wvbZfcSUb-DHpuOubDwpxd6_Tqeob3Cg03mr36Gx1K9Uen8xN4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ep6sUjIRXVZq2i45eFAI1qPtDf-TuKPZEd6fKWcjHnA&oe=6A1C4628"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
_ohc=hY8itnh9Qf8Q7kNvwGz2tyD&_nc_oc=Adp8ygw7vllkkffBcnijGJKNOJlRwtHHDUCkn0Z0zkouoa78iZ5d_2EbZUSWmFsvTjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03c1R0j1g4ZEAVzODeCrOfUUybGjrmEy2kWh9-AZPG8Q&oe=69DB8CFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_51-ZlP8fx8Q7kNvwEXjKd3&_nc_oc=AdoGs3MMh5ubdMxRbFUFOJk6HgfQ-S0Zpah_ppRJpMd5mGhu6fTvh6Gvbm0ErbA611E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16ShEOFGCIOpKDZ0B2QOUenuxaH2wvcNErG79bz2uhkg&oe=69DBAD3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIMpLrYSZ04Q7kNvwFcpUYP&_nc_oc=AdpHOLroV0d3zM8LkZdBDqPoK_GG2NtUV0kYtk3AdrU5jjjpFvsMQEI_eQ0v3mfMB84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a8c1XlNDkAr0tnVV354AvTQ6TCzusDVcuLi_Z5sQsnQ&oe=69DBB0FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHxq358Q5DgQ7kNvwE2uyDv&_nc_oc=AdqPbnMjLauh6AuC9gO4FJgkzgkMq-Cd6ecusWpOBVxBQdr4Z7AxqmjK-pv-IUtffWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QnwLkVKog9kmm_YK7xJRdqcL9f4EeVnb3QpfzOHWXvQ&oe=69DB8411"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI7409rUn_4Q7kNvwGqtNNa&_nc_oc=AdpKH2kcQNAly5dbrYF4bxM1C-_gGTpk9hWOSOvHN6XlJ6eH6JctmN4PY0NKfOZ2z9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eDfQmQyjPZ1sUkKOlTCRtsFopUC3bS3mGTwhFGnYYPw&oe=69DBACA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
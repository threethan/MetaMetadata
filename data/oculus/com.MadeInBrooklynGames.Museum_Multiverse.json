7a0a&_nc_ohc=s8rr8qZKji4Q7kNvwGTOn7n&_nc_oc=AdolIlxm2tv4fZxyDxnwAGWHgBjylOxM7ljQo-FZZ-qu0qW5D4S4MzMS_jvuqCIKoMY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZcgHPgxO2vBARsR_0VK2pnOOYLaA97p4XjPQH_ETx5g&oe=6A7DB57B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKWyP6zkR9YQ7kNvwFZppWc&_nc_oc=AdozcxTFV6pDJC70pL9IFQKr1_D465wz_mYetzv_s41EAEpu3R8YbF3Tc7Tz87WnKv4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECa8VYPZ297-v8BsC1h7osjpIfr9RWln8QAwkA_O35GA&oe=6A7D9D7A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3dDRXcQrwwQ7kNvwF0VoNk&_nc_oc=AdqbS57GeLDSzEr95XD3yPQx9XwswcD_kdF14yJk-BJhBbAghGlO5hXklBMAK5tVPms&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjmK4WYftLvKJg7odEkeJKv5Ue0CG-yrxTMUYuZW0ozw&oe=6A7DA13E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScQ9yqjli6IQ7kNvwHipa4y&_nc_oc=AdqT31BlTrmRduZHgDgja-77I6Gz-QcwcL0MBmvYoYFfobgzPxe4G3RuQr7UEwsp2Qg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyRKJu8AEFpRYEr-1XoAee8av1J8ARgaxxq2yfl-E6oA&oe=6A7DAC91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nnj6AR6msXkQ7kNvwHaOPlk&_nc_oc=AdqsoxH-7ZffiFYcpbfKorbg4DKgKT8cLbz_6Yj0HSxUXUJ2bSw7rkhuRvra5qWngpA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERI1vBbcEPNV0xPHTs-OsxMKZwAHWJim4JXBx0phzvUQ&oe=6A7D9CE8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_t
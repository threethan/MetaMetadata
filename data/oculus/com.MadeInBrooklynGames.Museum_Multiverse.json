c_ohc=G_YrPbP8bFwQ7kNvwFI4I3Q&_nc_oc=AdoRnPvGzOYP-Xc0wU1wEo476L2rBFuOFB42TOkt7lktLvGcpi0tAPIZb13lkiXA5z8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQzqY52nY2JE1HcxdB09MmQkdNULkZ7wElm0U30lv9LA&oe=6AF8893B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IRaBaWDNUsQ7kNvwE2JCNy&_nc_oc=AdoNpuH2RjNijrMCQztROfix3lNSDPC8DwzlF4-ppT1bevs6IJqrg_0h-s1t-3yY-_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtZhUGUROnN2g4yULBZ0FvtXMD1AS3wpkBaQkffDLPnA&oe=6AF8A97A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ar4ah1ucH9AQ7kNvwEnxl7H&_nc_oc=AdpREeXrlzht8FgBZPj7piv1i9z3X2wBxIcfdJN2qdWndFuI4XVpGGPMW3YDoIa3Weo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2464bW00DBR7y9MIfloLi4Ar5Db69z92bEMpBcnpQnA&oe=6AF8AD3E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZkzQSJ0mygQ7kNvwHx13Gw&_nc_oc=Adp9A3zGXSGzWU5kuM_bFSemy76kceQD6vKdJl0baKlMrAH_vTmuRlyovmR64pooHso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcakcUxyZXatNIuMYZd-CCd1oxPKruQmreLeRtGn9sEg&oe=6AF88051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMY905P5c98Q7kNvwGSSoLn&_nc_oc=AdodybMz8Zn2zpjsa6i7Qd5wDP0kzBHa1TY08PaQ96XPvVxZZ983t0Ta8mqWpg7UUlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS708UWDg7UAQz09gPNdqP5mXFdO2ML31QrB-iBBLtHDw&oe=6AF8A8E8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
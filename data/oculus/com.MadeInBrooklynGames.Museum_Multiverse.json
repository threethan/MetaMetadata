_ohc=hY8itnh9Qf8Q7kNvwGL8WhI&_nc_oc=AdoMYKrahVPfS3qyeWnXkLZyM-yKyplyUKEzo8z7XCEF6GpnLmY5eUsIzUhbORoCwnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mdGYX-Fg3fOim9zi4av4hN_0RALE3RVFs4aFix_qBxQ&oe=69DE2FFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQWk_ccHM08Q7kNvwGKDjry&_nc_oc=AdpuUHBLmopYQqSpqTegO-nQJBavnK25ropI9dJRuNHf5xHIXOvR1uDzZmFRRHqKBXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RMXY8gtMVXw0GtoufjRJEM3K22dv9o0T3WS7DKtVB5g&oe=69DE503A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKGRk7LPZfkQ7kNvwH3lttR&_nc_oc=AdrJ7dzoIcBRpBUw0d6USL5A-B-6l-4tw0fJQACSGb65f4z8NIgMn2UfuBWQIcSz7l4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Vp6WO0xLmmwkkC0qDw-pp8jrRS0y7RD0CTLpRK5FARw&oe=69DE53FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgOO8MHJtz0Q7kNvwGVcXVG&_nc_oc=AdqbX_sjNpP8iB0RPQvPUmC5Now8JtM_lVIL8Cxsv9sQK8lw-TI6E5vcZSoOm5DKO1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wLw4rQhuyqJg2xX7knSaaSuTwM34J5n-pmuwT2Fbfsg&oe=69DE2711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggx1Dgftm2MQ7kNvwGoSKh1&_nc_oc=Adpkj9q_OUQY9o0M63kmA3xcGs-2OY66DHn4vNf3KDpe-5yhHn4PIwXNTdg-4zsaNNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CkvhsOL5rFRagVaqXiQURywq49jG75RDZydM8fWmT9g&oe=69DE4FA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
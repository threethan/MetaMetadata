c_ohc=WFgT12xNGWMQ7kNvwGqTQqH&_nc_oc=Adp0QJLxGoWA4OtterY4s2MGM2P1BKNWwF9UeSir4I_FaoeAJIykXYw3ihtcBZjYiyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOU8otT1nqjee8jwsIRFYZWureaWjHONpSHJKZRnBtnFg&oe=6ACD07BB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQuI2oHsxakQ7kNvwFND_oB&_nc_oc=AdpJ7lWIt7nsB2S3lGRrOEpoxd-70hY40BPrZXiJ_6ZImawq4D96H6jg1ZRnaKI3KBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLNwbeKUonU1xG-HCr6ZursrsCBnOTv-KbL9DK8-ukig&oe=6ACCEFBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M16heblwxs8Q7kNvwFdRCv-&_nc_oc=AdpWN54nnDkqbxnHEE3hLZn4Z1-Iv9He_cLK_I_hHV38HZkhsVVWmWFoHpynL-hvPaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYVzj2f6uEetdRf1r2FAs5I97xs5tw8rq6H9HN3AawOA&oe=6ACCF37E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eq1TeilnaecQ7kNvwG8k22u&_nc_oc=AdosjXdZmfCBZLhn9FMMuT__OtnI3M-ILrmvJdPq_BPzfS4MzHPieqSy3eMFirh6v98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdtIKSEbcQI-pULekSqn_YeLPiHx0qY2RnM0tUZaHBjw&oe=6ACCFED1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWI--duE0O4Q7kNvwFd5BBo&_nc_oc=AdotW7OvO6QaKCSUsZcQzv0pI3QbsqbQP25TaFGWEQpWUMGlBwbACs3_sPRvnhIMLI8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7xM44zLu6INAtJNlspPQ4gUFlfe_d8Sa703pXrmT4tw&oe=6ACCEF28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
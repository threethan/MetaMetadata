c_ohc=s8rr8qZKji4Q7kNvwE-Jpzb&_nc_oc=AdpeLF2i0cWntHmTZkHAwewdEl4RtnN4hK05fRYbubDC7gBX4ZgDUzPPyLlbavNnM4I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjO05cyc4m0wq635KZ8KxhG19SqUiT95DNrjzTbLG8Uw&oe=6A80587B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz7fI62myvQQ7kNvwG5Cy95&_nc_oc=Adp4mPuV86HxlOpsHUI-FYnHRvr1cFYWQYWgjNVNTudbz3P00wYPxvZD4O9IXYOC6-E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMVrSx7p_1RxHX8R4RZxSkrQdr1Ksc9q60PwXm2rD3Hg&oe=6A80407A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDjiaS08WGUQ7kNvwHnw8xD&_nc_oc=AdpeilXdFQGD2MHE9qo3RZb6saX_gKPTggFwLaVnyc3WhPEmIrHZuobmf6EXrMKZG84&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3ikatT3JbfZPAjqbkHHJFb22gVxL-n7YogeCoCFF_TA&oe=6A80443E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw3_oASkJ-wQ7kNvwHGwf8e&_nc_oc=AdraQcamze-uDZW88HYsNSNJYMDc5cEegaLwEiAD-NBonOQQHFpBEKAyV9mc5EaEwKk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNxrmZrPTsyVwmm_7YmS2XjKQWgd3VdRFy4e9EQibhUw&oe=6A804F91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfIUDYQ8tm8Q7kNvwH_xY1Y&_nc_oc=Adq8MKBxNVGaV72UNkk0o8Cio8YRclqj_NaGDoRQ4Z2hUjKQ5KKw2R4wqOqb71ims7M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQTmvfBHZSdphSQ-m58PG85uD9AwHne5p0r56Rfw35Rg&oe=6A803FE8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
c_ohc=DhlySj5whs0Q7kNvwGOum-B&_nc_oc=AdqAAVSFqofsHaMiIWBIZFVmY0IzsS6WCz8X4XC2V5MTdLAAq777P_kz8rH_r6x3f80&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkcmDWkZytM-XeGWcN4-o8wsJrwQDsJVPewC10D_1CaA&oe=6A917BFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP2NoutM8UcQ7kNvwGWmBhe&_nc_oc=AdrtsmzY0lgbZDud4gwGjTkHVhftqRc5pT3UmwVD25wCMkn6b5iRRt1tCJnnfKXCPrs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_exV7lBybI6KT_btBlf5_CoOt0MHDmfYIE0iUcxO73w&oe=6A9163FA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkPTu4NZ5ZoQ7kNvwG7Ra6y&_nc_oc=Adr3MMKk6ZMObIPiHrscVXhXt0lQu8dDwdhsuidunY-hw0jXFWPhsX6CDY7pq1etsl8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOzKuytc-rOUjQfj9WyhNi8DtxXOxJfC_SAspscAhm6A&oe=6A9167BE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ozdhce4tTgQ7kNvwHwHB0E&_nc_oc=Adrfeq7mj_neMehAaht1gbTag3Lf-W9SbxsBS_oxL3gNOte5hlT9sX8SvIz4l733IrI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXKu2FBYnojw89UgREUYS_Y72fVEZ2N-ao3bPTieBIqA&oe=6A917311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U74hGI2_x1wQ7kNvwHjbIOY&_nc_oc=AdozZEOPGDnT9br3MfFOTpGpwKqIhAqGofigTA4eVKTsd7PfuxxDhrRjM7Bso1VEXCo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhXwWLS3rgNHHceBCFogjB5XYTO2h8kKROrkviBvEZfw&oe=6A916368"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
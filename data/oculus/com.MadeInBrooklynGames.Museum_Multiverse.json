c_ohc=bjrwbMLZXPoQ7kNvwF4KY63&_nc_oc=Adqozql0iUFQfJk8R8JB6WQgNMGMg51C_De56xVTa3O1sq2w8DZy4mmcj9rTMi6UD0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFC4lQTWNrhQvmVU4OHdfspmaK139ww5PbKCGxxM9o8nw&oe=6A747AFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPu3tSZnOCUQ7kNvwEwdwNE&_nc_oc=Adq-AlutxyaQpHfHxX20LydY_FdgKofNjkfIiMU7Tv39VAPyhT3oCVTBc7TtHu80KZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoU5YRXliKdt3l3shtbhUMIwOkt8p0_lRxxj3Rh4IBXg&oe=6A749B3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDIjYnuJIBEQ7kNvwGsW5Op&_nc_oc=Adpifd25vdgudqvz61OluUf0MzcfBNPewVgHiYDuqUiTLoIHRo8PH2-HHLptlGZcnWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0NxEiaGlKvahE1TKrWU9kivAWnEhhOLjyWS8sYBBGeA&oe=6A749EFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnFTAJAr9eMQ7kNvwH7d8HS&_nc_oc=AdqzTdu1Ilco1dr5QGj9FRSLLF2pXwtaGzWZAPm9bo3DquGFdn05v-_S4oaHztSUQJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCUnxk06yZm72yIFfeVY9vIbNLHvIRTdTDUBLoOEYV-Q&oe=6A747211"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rKh6Cu7PlEQ7kNvwERL6LH&_nc_oc=Adr6xVXhwiG2eYgGqy6SCqy__1jux2smbLAnUteMFdI0ncFxXG95s0LdIYvXVHU0kck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGftDtvhfwPn1QXuJZip2x5DMGjx760Oh1AIUF_rsi17A&oe=6A749AA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
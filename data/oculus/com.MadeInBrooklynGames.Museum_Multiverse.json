_ohc=dHOvzEQPPO8Q7kNvwHMcT7E&_nc_oc=Ado1NNSN2cQqMjFSZcs7l88q2MThEiP29R7AV7877Tju1gle3SYNqI0xaJKrMaGc0Z4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zL62vVAXBMHLDM2Em_a1taWeNKvgepUkiu7kX957H4w&oe=6A05BCFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjWf5fW068cQ7kNvwEsrXMc&_nc_oc=AdqQ5cmNuLzSQnn9WG7-3AxUHtTRfWvH_Qy99byb134X5zln4Mo3RMu-QK-pSDEGhco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fTMWSOgOwHccZinOzG16rfiShM1ql1I7QlTikeR30AA&oe=6A05DD3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFqjCaHjHYUQ7kNvwGbCuYu&_nc_oc=AdoaFYIybnowrd6LVuY4NRI-h0Y-4hGkQh6hUhjeCWxt6RgwsOaRh4nplpfsxb1vjt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FeUgbXeV3Xji5b1C2INLe-3BiIi1CQT9G1BZf_kmBTg&oe=6A05E0FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0UZ2Vw40FMQ7kNvwFEK6wy&_nc_oc=Adrg1uvh4MEZyCraENkN17n8WfIuU7Dcerm3YCG9gCS58znsQBRCDHjd-y7qXkFCjVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57N4alloaj2NJbF3SD2DtrXvZ2YkE9Rw-jcszBt7NC9A&oe=6A05EC51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKrDiYgbpGgQ7kNvwFQ19wr&_nc_oc=AdrOuJ-umtSohh7XEJGmyvl4LlKFTSsST22rrexMuVixmaWx_0QYrXonuVdG5nPb48M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6phU5eqbYXNILB12fg5x_CwrsNhGitnDPwNF51QfQKaw&oe=6A05DCA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
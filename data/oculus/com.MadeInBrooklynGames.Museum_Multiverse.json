c_ohc=fDB9Ds0TKyYQ7kNvwEiMvHO&_nc_oc=AdrssTuTjlIncl56pLN5jL9XbLkTNFiZ5X0mV_j-lGQgSMET2F8N0rFfb-xxGHBlESg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe1XTPp5prBNr2pfhzDId8-FpMEce44vQObDkxrlDMaQ&oe=6AC6703B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQMQYKLA6t4Q7kNvwG1ltJ9&_nc_oc=AdoQeL1xHWHPlmmDcjCSN42OkRZuK7UQR_kd0AxSEpR8hjCH_5p_R8C2OhSenubLgGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg1UU8x8M1uDxP9XjqTx8say0I8O71phqjogoMLgbrPA&oe=6AC6583A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiUfF0AG8N0Q7kNvwHcs97F&_nc_oc=Adq2Dj3uuXU8W3r3XG3NTAPT7Ep8ao8xW8BuRoUqCNCd6pKTzLlkWmM_qfYjJkKzzgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7uo68E-8rEGdnMmcwfSNNasiuxRvmazEcte0z7FzGzQ&oe=6AC65BFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g7rF0cps7sQ7kNvwGL58Fd&_nc_oc=AdrNNplSTORRGVqHwKWTgNKAbeLiGiRqKngr7-Pp2EBzm9xhp19wvWfFLGh4uTKNzfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTuEbK_y48fxo3Ac22KLs75pvKHe2_DvmjCsmHblyfdQ&oe=6AC66751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtTNG7ssYmQQ7kNvwFdVtfF&_nc_oc=AdrNIz7j4AZI-dyECM83QThgT8Rr-r5sNmC7Uh76JGI0iyXEa6WP8X_sS80fEWjfTQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYkaTBSI4eU93rwAum_-RcYzNup9WPTJze81ARKPBDkA&oe=6AC657A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
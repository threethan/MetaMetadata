c_ohc=E2Q0xR5ZG9sQ7kNvwFX_Jo-&_nc_oc=Adrd6hpGPeAnmXiZM7VsQxV5lXwNE44DcCCwJ0ck3ghfTRuacfMlW_01Pf--dr1TKnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIUUxYxIaHHB_m7wsfPueC6ZSyl8WlcBwhTXf5uz_W2g&oe=6A5CBFFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIIzKWsRaYQQ7kNvwHDfFcW&_nc_oc=AdoZUP0RcjtqY5Q15V4-AIS9tKvpQ4KUYrjKOil7d-8aBv0j2yNDgyzHFPXwrPGWHlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZqg7AyY0bP-v07qmURBCutUKFeItp36_lv1Qxeoae-A&oe=6A5CE03A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9XPEKBJymYQ7kNvwEwpnHS&_nc_oc=Ado2x7abnIA_sLfUWMJjfQIzr4Gz0n0OO9sml4yVbXyJS3fTaKjrLlyOJn3tLHZSG9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWbt7bM__EHfR9gBakBvUT4U-Dn2rdSw7WfYe773ZlQQ&oe=6A5CE3FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsr3Itk1tgwQ7kNvwFSMW4J&_nc_oc=AdosKT-tv60OtiTvk-Q1aYi-DuMdEoqyFiBx2riyyw8wljajaF4qE3W2QADodsHk8tM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsLjnBXrIxaTxK-6_-9qZ-a5J9oG8XukXuXMQx38J5fw&oe=6A5CB711"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEbDrtle45EQ7kNvwFMGsc3&_nc_oc=AdqWUlW2UtIXmzGv7Q05ojStQt6vaTwOsCOHqaDNYOy1yDjPw_l4gWUvwv7hgli6PvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAc3GnKjgc0HHaGuaWUBqY8GGLdTnNJw6g2yVGFm2lmg&oe=6A5CDFA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
_ohc=Lp8WApyB2NAQ7kNvwFRzddu&_nc_oc=Ado3uX8OUgx8D5eX4qxM3g3fRwlgX2r2BXTDD6oMh_D2VMaF-IhEHTxaHJ-xocl9xf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OQfRY-u5PCmGiEYssH-5NwSTbjZNVutBqZyrfUCNs9w&oe=6A01C87B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfI1_FTRhJYQ7kNvwGPBfbY&_nc_oc=AdqQ7xJH_c7YnKfn2kFyHkH-1lqyXaLhQacvNL7T9ZMARSK439mUfrKvHYJj1NbJLR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xS5YDOT3jh5NamSToiiBCZPPY8DRfjAjAVVxFPirXWw&oe=6A01E8BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL6pmxubx0AQ7kNvwHrnUh4&_nc_oc=Adrc6FZpk7oPPmOV_5jocqP19PrTwUJ_oV8eL8REuQmjtycPs5GY1WBag90iSOWKjEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r98PT8pXFUiWNRrmd0UNQYeqYdUKRr7ogYtEfbityug&oe=6A01EC7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndeIHRj2Pu4Q7kNvwGKxlH1&_nc_oc=AdoZD6c6G-yZc7oVPW7MXXIazX8y2sKP2UA8yQv0snVl6ACZ3ZxqVFDXMdFkv7MPqDo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IQ4nspWYVKnzgzfpLQohzNYyE3YA7964bUZ-6aAam4g&oe=6A01F7D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW7XFgphbxkQ7kNvwFU4Eob&_nc_oc=AdoEOuz6ccPa-043w3WQAFu1kVifQevY07e2eL-kSm6re0zvMR7R1CLvPv48H8WfWCY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72jshnRwtUH8Ul5MF-lo2A1-hrn6P5UORM3hSCNA41ag&oe=6A01E828"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
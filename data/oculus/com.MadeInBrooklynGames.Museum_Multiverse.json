c_ohc=tx8Q1ZqUejIQ7kNvwHIJiOG&_nc_oc=Ado87Ip4sTs73arDKsDlmMIDIPd5Aq-xUToxgUHZ1G1bzkeKnKzks9GuqpW6SZQQakI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0VJwSryT7-j_QNJPHFjR81x89eICtewOv0y8MtxR_8w&oe=6AF0A03B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-PwaqOzfP0Q7kNvwFOrZNi&_nc_oc=AdptoOBfcOCTyQjEq16XUoybu6IDX0fvUhhwtipo0y4kqOD6AhEJdOiOzvM2BP4I_rY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF2AuPoPN7aUTe-a9DXJdD5KfM9Q9sd66sj3UkzPGDug&oe=6AF0883A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi2yHt9t03YQ7kNvwHIi5oB&_nc_oc=AdoQejW-vfsQKLnQ3vECQZLZaYLFf4UL5C-adx77zXfyBaZA0e5tdydhNldPFG39HQw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp3DA_Sk8ZPcQnJoLkJrcdsN9ZzaHfsQT16yFidnXrlg&oe=6AF08BFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQPqMYIO-jwQ7kNvwEsOEpI&_nc_oc=Adop30mzgEgDiiiCVfENUtt5qfSNBy4qCaNtOwqbCQNeLao52q_9STa9oheaX4cVJM4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEgWD2uUQ6XaNJlNMYJvJovJ3d1sli5gVm_pAdsue96A&oe=6AF09751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9UNcDb8dxYQ7kNvwFrG6sE&_nc_oc=Ado8malYOa-vx7MNKbdbfMqGdaaeaIjhRk23p9I9KZYMl5rAjg4AJoJZQoBSM1HOm98&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfuLeHSaxc1bAHB6g9nmYy8imnk-s7w_O68q3IsdCn3Q&oe=6AF087A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
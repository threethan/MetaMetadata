c_ohc=JrhZTab4qU8Q7kNvwGvbeQB&_nc_oc=AdosUhvZQ4xlmx4CN49zFX0Ut0kz1lajtWhhhtuCmJ_8VhEfYNrrLsaOhnGpnAMtWnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV3FWe_JKhKTEeECGBBsUqpUzeSlFR-1aAvX1gl0DdtA&oe=6A7C63FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKWyP6zkR9YQ7kNvwFFvPgu&_nc_oc=AdobRslNl8TgycWAhWzst9CoNU109KIBwhrC4leA0TdftbVVEQgHIo47hUPX60s-a84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0JJVi2QG4M6gFGNlMr-QPKIGN1rJtpdebm6D7A_CTQg&oe=6A7C4BFA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3dDRXcQrwwQ7kNvwEPjKZa&_nc_oc=Adqk2R_0z3rk9Ew4mp5AymODs97D2y2i9cUviG02SPxGyxfPsvIfaLBpMv0QF5md24A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvk6njZRZzIy5-SpjtplWfSqw1ly1gx_IONXRA51s8sQ&oe=6A7C4FBE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScQ9yqjli6IQ7kNvwHnjKvU&_nc_oc=AdqwF1qjJS-9-WZ9zNIWB1xxSGpZ6QKd1AYdtPsgkHEqjiqyAuUsWTl17Bk_d84xsog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFujyHRL8WDcE6FrgN988gQ3x-PklXZKvoD88bJBfMRWg&oe=6A7C5B11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nnj6AR6msXkQ7kNvwFJUqqt&_nc_oc=Adp-s9pxoCciHeWGLsKDsCr5ZsIgm5hzVXdEnAbIDoddjqNSO0z1UhlSw37I-rguxuY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQeDnfXN0iWpAEGeuNVF2RC0IchwOE_2nPrUVaaPKYVQ&oe=6A7C4B68"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
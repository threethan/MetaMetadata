c_ohc=01Oki5IM_4YQ7kNvwF6oBS2&_nc_oc=Adq8AtGYHyFv7bkIuzNHzEt3Dm71HZMeJ_TTa86338Z9soh-FWCZ6Ox1qMrsARy_Fcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSsXl-aZ-bTMjN0fkW9GaYCdok1IPvxtuddS2ofxhqKA&oe=6AEA08BB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cwc8J4mEwSIQ7kNvwExPMJA&_nc_oc=AdpZ2-oDTpO9nxeybxQ34yKjVHS53xdgPuB-618ldlfLSwgK2PdLuMO9Da4DvxZH3Ls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYF4qwPoVBHl2Ziev0NFs-o25hbp0bxWfxPsmBcF9QLg&oe=6AE9F0BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEFdjVODScAQ7kNvwEmw1Ww&_nc_oc=Adqf5xDIMICtIiGXp6AT_LSao1QiLagI_c4djzJ8hywFwI96ZSCwYFfw61gbCPeb-_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY6ZmB7FfgnhFzCe4yLaKbpqcageeyqRzOV1G-Xn3dYw&oe=6AE9F47E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuAz_0C_XHQQ7kNvwHKU1-L&_nc_oc=AdpwZCWEnvc6jrIPXYNtFaLmStJegvIZicXA1hWI1dcuULponqLtbCzpY_f5T9j_cV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdQ7oCorTiqWHZ9LctPSEL_Rz7zP_N5NPpLwMWFpcbEw&oe=6AE9FFD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdeZZdE2fBgQ7kNvwHeVzfO&_nc_oc=Ado3zgN8UeiE1ywXLyQsavunEaT0CIhlqJfNoRX533Q35j2uxuokncyj1VWBaYLMAA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhh1C82Yx2qDMMgp8lKzAI6N1wtoQGjPZNfsaP4KIYoQ&oe=6AE9F028"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
c_ohc=BL8oVUIehLEQ7kNvwFTygPt&_nc_oc=Adq4vH5RtNhwEFtnMTip8c-hjR5tIPZQfZMYoosxWS_Bz8CbQ6JZ8hXKBtPYVS3CUW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFiJusOqDZKAK6iAYRKo2GwzU9ocucYiVmpEdKqOjMpw&oe=6A6DE37B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz7F81Lx7ucQ7kNvwHnv-sh&_nc_oc=AdowlEh9xOnr3EY_AydNu0f5Jw7yuFsCIYMFpllbnL7F1iB8tATJ4ozW2XI6j9-QQns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsU9JGVaTWwgJBpAR-KNEaMoVLPsDHl9R5ksA0_5t6Ug&oe=6A6E03BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYFBDeGYmK8Q7kNvwF8DkvI&_nc_oc=AdopianAbXg8rE5RqXw5eX9HCrYkY9aMbSfxH-Rpb3JljUrSIdDawxx7zHwN92O883w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGOyCu2UKRL4iiN9s2-qrhgin6is-7YQFCtot-3D24dQ&oe=6A6E077E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv2FTzgtSNsQ7kNvwFUO6Zc&_nc_oc=Adp98LEnZxHJWw7FfCGoc8KQHqwwUuyqQ9k12HnrByFhWb_-kKmj81Ug8KU0UNKGvGU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdz9EjVYNTHjYwhQHTjZnHsFoWjOaFYwqtx0aksAl8Pw&oe=6A6DDA91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soQB9wc40F4Q7kNvwFsoBXp&_nc_oc=AdpyjSgunfxRlw9z9KRwkSFfLW78paJ_83v9vJV_VkWEJp7KZ1oMDb-DHqWmYguAJ_o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLChK2rpnKXDtIQbnBgRy4fg1_2DHIixT3quylAiTKoQ&oe=6A6E0328"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
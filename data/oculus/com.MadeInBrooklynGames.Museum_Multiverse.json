_ohc=ds91i3pfbgUQ7kNvwEZqkv2&_nc_oc=AdpFWE0AE6BFsNxzS0NKFmvuh_nuIVkUnYzxDTgtwOPVhJv7Z6ngnQGTbvkYLIL2SNw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4Wjdiu_WKO2WYwNYgq2hky7MoH4va-k_ggGB_V9mSDA&oe=6A328FFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75iAOTC4pjsQ7kNvwHmF6QT&_nc_oc=AdpXaO8o7XE_rQ42Kz_f6IKiBCVtMpUlyARq8ZjLu3dx6dEu5EYgAwwNOlY6q2Q_luA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7WX49bHo45NAmfh0LHNYV9wjDaLBKGWZRmC4aTAL_8A&oe=6A32B03A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgb1PN7Wf1IQ7kNvwHIwZkV&_nc_oc=AdrR2sQxit4IkbR0BJGVnEYKeKgKTt-m9PGhIYc47kDc9mJ1W3vac1rnpTBDYoHZsDE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rg-fKwyVp_CY9160SQPPHnWVBVc09iaKQM0LVKELxTg&oe=6A32B3FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSQgxvQuls0Q7kNvwG6hOdu&_nc_oc=AdpPmymZRtxGR1h-8FdpGB7M_l0tLQau92RVX4R2D87j5iO7WkTPgvapqDgMMY-kXYc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tn_S5CIfgPwHp0LKwmEper_Oqx_NJ9zfjUGAQgY2FfQ&oe=6A32BF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cwPHYpB09QQ7kNvwEZx-G5&_nc_oc=AdoV6MuIJ2QOezvqwFvFEMgnCyQeRBsnx3zeKTOxHCPaRgQot6-LZrruYBmg3kqAuqo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dG2NOfDSEhG5vv232wP3sMpxIo9FYnmGKgxOp5P-5ww&oe=6A32AFA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
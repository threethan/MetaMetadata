_ohc=VuyS6QFvTsMQ7kNvwHVvjdh&_nc_oc=Adp9DMre7_hSQJv_iTEUeM4QTLRkeMhHIeby5a3S5-5Yhe4AdBlPCSPQZieKyhxqUHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3b6WZBdm5Ulr2zyEZPMwndkp7JD28FxoPDUDYxk9g0Sw&oe=69EE01FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sU2D5cooyYcQ7kNvwErd5yb&_nc_oc=AdoatnE-MzraYFjPgAo6Xcv1VmxhA4RpJWIXJHrNJzBb0i7HhacyCzw5B_DHAqrUjsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BJFtkSr2326xul1TtSydZEgZ6DILLi7yVS0Z0Eby-hw&oe=69EE223A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wgqv-ZxqHuYQ7kNvwEfa_uU&_nc_oc=AdoFGmOeNy9-CHBZOwWCC4hzVaUPQCSjfmf_E-lVF8iBedHp2JvMmcwhj1UBuQ7Sov0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DLSaOzDvWlRhAnOmD17GYgQUFxUfgtJ4jnjfn3cM8wQ&oe=69EE25FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdLnTTniA4UQ7kNvwGuFZgD&_nc_oc=AdrLjbjimKJui7cSy7-8_nnCbmV1d18e9tl9_cKvT8z0Mtx7sYodP4Czxm35hXJ9ebw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13jMfcDVukDmXHlRRl2MowVpRM-DlNcjqJaflgjf3HrQ&oe=69EDF911"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brn1PXkLq6kQ7kNvwFVeRMg&_nc_oc=AdqRSB9zo2w3KAudyH8MFD6oRxaRNJXhawrzo-pE63DoNEK-LgdelX2xZFaGBbW1z8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IW5ivtmeEHXuOOCEd_2K0-3EcGRj37EPYv37uh4T5gw&oe=69EE21A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
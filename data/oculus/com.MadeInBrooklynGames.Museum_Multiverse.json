c_ohc=mGn9O8maTYEQ7kNvwF-JVQJ&_nc_oc=AdrMTxWw5EL8j4tzjlAyT9qgYWjh1Q6DQf9_DS3bVyhuZeGC2bm7QoSumHuK5zD0KQk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgNl1hu0Jc-gFUd6oX8PPH_NLvEcTrY9IZcvul6dRd9g&oe=6AAA887B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbt0xEZvazQQ7kNvwHpuxit&_nc_oc=AdqLl9j1orCmetubrBVWzK6awO3I4ONPV5nsaP68U6_rUyq6u5NTLJikKdEh0ApnDME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKer74GSitXiW3uy2DwY7tgr3HScdZCZX_wYMejE81b_w&oe=6AAAA8BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFdiSSmZEfAQ7kNvwEBY2gA&_nc_oc=AdqUELs9NLe-sjUP22N3Y6w6MdEhfWBi6bRt6MryzV3Bjbv9GkakA7J3gkSJ2fG_7ZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHfZH-c3fJZj-fi0-cs1uRpsbz9MG355vKdR-VRx0mMQ&oe=6AAAAC7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw_M448VpAcQ7kNvwGFYlAY&_nc_oc=AdoBVtWWM_-OrU_uMpC4D6b4whnc-pIBTCfUBUhwLc5BMk1tGY6ATCACr4PGhSOAArI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtD3rSTLXV5d5boUzB7ecYsaWv-e7spUy4lazMb7IJrg&oe=6AAAB7D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw_NKSKtm8oQ7kNvwHonyI-&_nc_oc=AdowGdb9z1V-DkWeP9ECOKEkBvI-COQ3NORm9X8CncVf__IYA_mfMG5BGu-94sa5S-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXwl4LjQxH74MwNhrwCOJZhZGJnTY6gmPKzR-ZWBtJKg&oe=6AAAA828"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
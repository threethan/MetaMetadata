_ohc=ThBjKiS7yk4Q7kNvwEIji1K&_nc_oc=AdpR6lKEY8KHEj_n4U8wTZl6_qPZnodnwWyL84TSYpvAgtOMIPaTTxH_4rtGq2bu2pg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ckQAhYgL7d_aLFzVleAw23HdhcxMqHQd-RrInrKNXPg&oe=6A30253B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75iAOTC4pjsQ7kNvwGWYuti&_nc_oc=AdqgU75Wu75ceSjlINTz-g4W2jY0P_GUELfb0fIuUdC0g_u9LNsObbUfcVlXD4lE7u0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F4bEO9lj1GhqtRFDI0FHsowEtWCEcPpQGaOPsI5V6nQ&oe=6A300D3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgb1PN7Wf1IQ7kNvwGXsBVm&_nc_oc=AdpSIm1v-9yy2LDaCLLK5MpnslAN2cacUk_Nkqvwux8cdtU-pxFEB9lwuhh0cBlq_qA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HmslXHPB72WNtCJEwdlGg4PkD1_vtmYgRTvfjhYU6Tg&oe=6A3010FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksr_ubCGWlEQ7kNvwGuc_Ux&_nc_oc=AdqRk-2_wV0x-fglnYh1E078VI383cAz1N5dG6PRBKKgaN9wZcfSdG5jamxum6bX66s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9USIn4IMD-rtSDdHWYU8xe6fV72BO3vQ_clCrSQ37ZOw&oe=6A301C51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fijgeLWjQN8Q7kNvwHP2azY&_nc_oc=AdpturtXZSRurbHA-cF1ZuuiXOos31opD81prBlovFpgD0cdDmhdjbwEl7DYGsDjhd8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vTTGQfowMD5Bkwq2bDVTI64qdRZMAbkCK3ctzoSFVrQ&oe=6A300CA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
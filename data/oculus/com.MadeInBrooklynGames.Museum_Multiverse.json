c_ohc=Vx-rSDdAP5YQ7kNvwG3TWdH&_nc_oc=Adon-0E0okdas6o11mLjCU-MlczP_mQvo4dQdsEIL7m4UaDKonirEME84ut9J8inwYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV5bZD_ReRhTSGinT13JmsJYBqK7eXRqU_G3yxCsI9BA&oe=6AB3C2FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl5uhwaNC9gQ7kNvwGTpH27&_nc_oc=Ado9jg5gzj9TVzHLwSRvumtfJ44mRqq8PMGyYNh29IO0LZtd6EKQLBQ5nfK0gz9ZSEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRackl-pxRXlUgIukaOvsmnd3bHP5OIshwbhn9Rl4MUw&oe=6AB3E33A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=196qHeWyiGAQ7kNvwGumYkW&_nc_oc=Adoc_mEFz_iDBxoF9NScd0TZeUl05xQpxxxJ_g138vxO2eW3Uyd11XDr8uuw1JRy2XY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGh2cbN3UnuA0QekjAV3vip2G-QGuikC54y_6b3HVIEw&oe=6AB3E6FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFLLZ3_GKa0Q7kNvwGeXyB4&_nc_oc=AdpMjYb_5LSqubzU9wK2zd4FT7PScxXcXX8bb2FCcZZdvFgEPbCuHI7YwANHfNHgyWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4CgmSp1-av48QElU90w0_hYeNyESEcaOgqU46ANzs7w&oe=6AB3F251"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIMvkn5Ifj8Q7kNvwGhygK1&_nc_oc=AdrU8_6HLtN8o5SKbBUfclJ3HvLTBoeHOdM_ss9QPiuoUCLYlItgBtT6E4_pmMUbPgU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ_hiGsuCKVYEa3_ane-Frh4JbBwsPjlejld-5LqPyvw&oe=6AB3E2A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
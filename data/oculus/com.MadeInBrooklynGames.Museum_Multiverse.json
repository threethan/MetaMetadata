a0a&_nc_ohc=-WyjS9uP9_0Q7kNvwGqIuNW&_nc_oc=AdpgdidmrEeWhRuo3zFVJVIc_cXxIOcConMOS9i0E5P-EiAcMRR0T9c8VkbxYeNn-Jc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-ddvoQxqsV2DXwT3sBNj0EF-KWy6z_BtMMTttU6FK3w&oe=6A395FBB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYPUvWogAZsQ7kNvwGYR6Ts&_nc_oc=AdqlydAWsEiGGwkmWPhjkoK2zGmbF0QTkzpNZjsAEQrIVODKkk6LQdPUHAcshBS_t74&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6ubONdEROcgVo7cVIkF4qzZgMxV4is1S4Psq7T980Zg&oe=6A3947BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xQQj94wbw0Q7kNvwEkhxrM&_nc_oc=Adr8890yVcEFbF80M3pCIErtCCyW9NLb4zWc-CO47XRHy0MtV-mNQPHKFzT1f6ovt7A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MoGsYljgkA2jPbqkCfUyIh18a0gmTIzi9rtzMWimAfg&oe=6A394B7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1al_rbAWJRQQ7kNvwGEKD9A&_nc_oc=Adq9z4kHEjTa-YjszvW4hfQJqkRQk0pqZKePl3E6eY6Kffm0l-vMdP8Dso2-WSJFmgU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ftNmpAZ8d4bQga7KLuIbD2T99eKEwC13s1KFD8TCRSg&oe=6A3956D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcIJmfDAJr8Q7kNvwHk7Fdk&_nc_oc=AdpYIxP46GWGdmD6SDWsRjI0sg-na66iQajROEbziSL060Wmr4ZsD9RmQjOrUchat5M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UYyu9exufgOsY48TuzNWxCGeKrFIjgrs1n1ZMccmcbw&oe=6A394728"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_te
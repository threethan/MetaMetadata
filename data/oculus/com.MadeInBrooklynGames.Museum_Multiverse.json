c_ohc=vxA8uMQWxbgQ7kNvwFvKlSt&_nc_oc=AdpAc_gPyFlfo4Anj393nADTaHmXSZkQhNWrGST2Q0PWBgEcA6Es5z8Iag89tywUzmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdoZ4bkp2i6qHzjoH6DS9ZrzcBOBIncyzI-cmNdae_Ww&oe=6AEDFD3B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-PwaqOzfP0Q7kNvwE5khQf&_nc_oc=AdpcNMHKgmCQNzRLLDuGnbBJzwCBz-jiLcER0RapiUgMue2x0fERXk1wsLKQkKSmxRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiolktNTaSO0XED9yduGQpkcaLGw6jNdWxjbn_7Way0Q&oe=6AEDE53A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi2yHt9t03YQ7kNvwFZDLzP&_nc_oc=AdpKFJkR-94kBtyoIG4qf2qLg6WK9ZG-R30_U5A4ykofXZw4z8eNJ6I4pHLIdDQjH1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_jrUbYWGWRVcu6pX0YABQFuoBiBFjhNPPzBbMNuj-Iw&oe=6AEDE8FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOMxDk7H9ZoQ7kNvwFAjNGF&_nc_oc=AdqicBeIqg7u_3lK1xE4jkuWo8D05UFgACkg7XtxvNPW8HzYJqppgsFlwjriT6qbOOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOayN98wGDih-VYlw5zHhfRJDj_ICYDntKRK3JjOrASg&oe=6AEDF451"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj3qxH9RtHQQ7kNvwGWRkK4&_nc_oc=AdoVaHMvuhEtGgvS8q35ZvaH6VUE_dymBUQvo5PgwUK1Ufx7NkHoArSVSRDvScSRTps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR05uF6v4qr4gKptSQarGsabx9yIYpq7zj2Vupqrt7RMw&oe=6AEDE4A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
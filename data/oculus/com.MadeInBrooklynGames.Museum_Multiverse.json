_ohc=o-uuNLMcQhcQ7kNvwFnwNzv&_nc_oc=AdqZ6NDokicEr1KywGmzBIKGI2-RNHEgbut17-ej4Y94WVdCBsCZQMuA6LuXsHG0YII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IQwAKWgeBHnWwv6SuKPOMjUnDlVvo3SnO9sTO6OjSRQ&oe=6A1475BB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A53tevNIjgQ7kNvwHH2Tog&_nc_oc=AdqpEKfm32pWp5k9Vnh79OXL6Hb3ZSLrjm1Der0HTSXKAQCOjun52fGXaI_dg245zeE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74NAohpUI9rXye1kdT51yOrOdJFuv3u1goMAYzB0nAzQ&oe=6A145DBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wVt1wvMCN0Q7kNvwHC2NWB&_nc_oc=AdpXwbQ-Sn1f97LpUR2nezZdKhkb_J1foc7wZNlkoT8xO8l1rEqnLEqPc5k9VmqI8L8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oHh2TIp6n6f8JRVIgcZK1FJwMfYVwxiM7pEoJloOeWA&oe=6A14617E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lY9Icl7a4kQ7kNvwFhQM9t&_nc_oc=AdoW4hhZc6z_WanAxj-RlmDyMgO57ztrpLjE5mGL5wWo7rwvIaqvNLa9yPm_4LSNCZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wuUxYVeUP0EplX3-TH6mLLwpEf7ScTja9M135evoE1A&oe=6A146CD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-wccJsNsc8Q7kNvwHohhZv&_nc_oc=Adq4E7E1jzquO49Nbc6_biPorAbj43_4dzbtLHW3NVpqBApACkmOSteCFhSkeuTgsYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VMKnkFGyBovdF4ZjUVRWc6CzpFBpmlBTpNcT0JSBRng&oe=6A145D28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
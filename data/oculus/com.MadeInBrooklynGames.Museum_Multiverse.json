_ohc=R1JwhZbGsNcQ7kNvwF4daBt&_nc_oc=AdrB2JTuw-9NJgokx08g-sB8o3DuTokDWfNLyLgPzcDStQw9_SuG-cI4fpZ6WfNLZ84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mzXz71ci1wFVtBz5--X5k-I3Vu4OVLzs4SkOWFrKidg&oe=69E8BBFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObEGeY_eW4YQ7kNvwH9yTKR&_nc_oc=AdpsTr5isROv76Ufa2__bmFyZPUYOwFdpic_-ejBlAaCOLYhfcnVSZk24LU8RGWz934&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CHB31zFv5yRzQkE1li0o6dPTopkz8U3lGZTcEXTkCbA&oe=69E8DC3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knoBOMqLe6MQ7kNvwEABr8g&_nc_oc=AdrWu5Pnm9FQgrohRJ1Q47ITiujH32r-XgqyGBrNexCBUhs2x78crsEVzqn0sPtYRAE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CKNalG85cUreYQ539k_QDGsUoL8rIgqbCniDZSDU1hw&oe=69E8DFFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJLjoC0pZ3UQ7kNvwHOVsgm&_nc_oc=AdrVLQrNXfuNSy2Nkj2J6hpULoOoBZej2i0YwoNU6j60luYwGYGTeJNHF522uGDPaAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EIIigFUdkHZqjyOIROrV549zpvy20Gdo5zkBlZ1QYQw&oe=69E8B311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weDNJ_21B20Q7kNvwEfM4-d&_nc_oc=AdpX7IYjsr8vYacU0tZ7T463IqlJIgX5JkV-Ow7C5ZWgTnKyCdlAqlWTZHjr2c77IWw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12tSTPmg-VHzJUibe5TGsXA55omNcS4Kew6oDxh9l6Gg&oe=69E8DBA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
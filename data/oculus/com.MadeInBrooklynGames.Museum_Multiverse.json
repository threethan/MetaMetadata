c_ohc=uWwzwHzFG30Q7kNvwHtnpff&_nc_oc=Ado2CYOD2Fpd0u0w3AAS7LGoUmN7jWuHygqJzSHMHEzzg4ctDdUBsvc9Me0fl0MY--c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqTbN6inJgaNlfVIgKPnzhmrctBMjJ7u7Ckx-VnKSU3w&oe=6AC9133B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQMQYKLA6t4Q7kNvwGx3FDA&_nc_oc=AdqdtoHD0ojdqpb1s0Q8Nxn1w40b9zuwOgRw75wCcPsvTiBft4DzHnrOq6oVy7bFy-A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDLcmcukXq0WzNdU5br6dO04vto1YpZbI0TV-hfu-OrQ&oe=6AC8FB3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiUfF0AG8N0Q7kNvwHzC3jL&_nc_oc=AdoIWg1aW5AqUFABFWV_S6fhSmm2r_1ZHZxtWUyMLxdT5Luoj09JdXiO860neDbk9Ew&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfTzfGkeTd-Sm6drYa2O3niszhNhB5u9MV_EjGve1zTA&oe=6AC8FEFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Typek9koz74Q7kNvwE2DCrB&_nc_oc=Adq9JZxXrC0VzSaQ_q6ry_OIjz8uVnLuC8WoggM6t3De89HFcbVJzuAn29R72-X5gd0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtjqXHai6CEvLyKRZajTX0haoo8j_dCGTGq3hEyp7REg&oe=6AC90A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL-4LtNI5_MQ7kNvwFQfWyH&_nc_oc=AdoTAsrZenMY5VDZeB53FbjfClf__QaBp8WpPHyQ8Gs65nCh65S3D1ak0LimFSshQ9U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1FFJT9DcbvnFxr6r6XzYxc3J12LsFK2V66isDuVsYSQ&oe=6AC8FAA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
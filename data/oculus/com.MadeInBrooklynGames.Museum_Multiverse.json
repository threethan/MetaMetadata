_ohc=reoR2hZlPBwQ7kNvwHqDTmw&_nc_oc=AdqwTBuneAwok9Unizfvh4HUQIHFVv0bvkIpGA6TrDWu6UJUIxNkuDfB9Hju5JrBZFI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ri6sYxkxxM9xjVgf8vyS8cg2bDddhzDFISnZrS79NQA&oe=69F347FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsmmjwOFIzsQ7kNvwHPRnE8&_nc_oc=Adom-BGa5TyD7sGcyfUEhc2KmHOmHko4hqoJhsI0vuie5f_ZZFNpK34pNZkK0ZGtfsM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UZoLEFkpbWu3b8yCmkK_bff4Vfo2ZB8qglalZ_IHI1Q&oe=69F3683A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiEU-MZ_SR4Q7kNvwEtl77E&_nc_oc=AdqIqU3JYkNXpG-gjMBVEv2ZtiIyHCxsffxD9EanspSgIwu6Tod0cTyS0dD-Xw5CioA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08sovPauDac1BA601VFO7mj1vA7qsqbyca8Bv6_hz0XQ&oe=69F36BFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ba1r_a9tTUQ7kNvwF7E1jF&_nc_oc=AdpEHCPQtll1781i9luYdJhelYn8YbJtFwK8lVWUGW5VyVuVpEbNFSQuIRlT9E_WnmU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2bVUe8PBUm5G-FZdx1o2DU383BmbflC3UUGdcPyZ3IsQ&oe=69F37751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2g5DdzsltkQ7kNvwHG5_A0&_nc_oc=AdpUFiTsRtqbqaHG7pDsWefD8wysaLHRrOEsX2zDocqXR9BNFq_iC5AER_9g6_X2y_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QRrdca0nM28e4vmBbg-HwtPXz74qxL1oEMqFe0bzxcg&oe=69F367A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
_ohc=MJ52mDi_mZsQ7kNvwEJAD5d&_nc_oc=AdpDm7gURUT5bLXD95O4Oqrqj2ChEo8iSpkSYETOxYobUEdJiphOunoJPRDWtnPGE-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nzubnU0DeNA6h6Idn-a3jhTLctjV7knqCyca6Zw96gQ&oe=6A1DB03B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beB7J6C6wzMQ7kNvwEAngmA&_nc_oc=AdoAL9BY_0d41NP17-I3IDAm884vvo5uiNNB7W__gHD6k95FMjAe_Q5JX4OyTk-eJ68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6256bsjD3ch-f730FFnplMQ_Hj4t0Z8zJMKB4oVJdL8Q&oe=6A1D983A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brtiGXA4lzYQ7kNvwEMQUmT&_nc_oc=AdqlHHhCCVPm1z9ZOc_jUEg5GPO0eRM2leAwqSWDoJOa9LlYelmv7_Io1muLxZPVq94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fe6Dy3Ox1CqYiFM7YBGO95mbjOFElC185-rlqwXa-CA&oe=6A1D9BFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYDDuU02KuQQ7kNvwFJ27ml&_nc_oc=AdqU9O-eUVhfiJISV4Gud7ea129LjS-Jk5Dz_tksgzqZ8CPn8N8e1DSyG5CyxEwGyRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EZWrevZwDsYISb2zSN153veICqms7q6v_phoKNzUrtw&oe=6A1DA751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKRw-FWOR_cQ7kNvwFk4OSq&_nc_oc=Ado_ZpbMi6jZNU5Ha8b9TOyv3rhYZRmTDMnYYdwJStjKoEk86ecwnHyKbjCY_fufnp4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t-rf0eSmy3nZZ8aySkOBzOX0fYQk5FNsQZZPxV9YdDw&oe=6A1D97A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
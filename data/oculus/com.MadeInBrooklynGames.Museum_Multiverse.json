c_ohc=WFgT12xNGWMQ7kNvwHLuWv6&_nc_oc=Adql23SPP4BnRK_gdaNEImaO3SVVpgLx8h6Aha61f0XcokcUdNyp-cxoPOH-qFG9JPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI2L-Gpy1-jqN09xKymQ8VkMwy0oS2MEMZ9lCzfnoxHw&oe=6ACFAABB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJeoNPGJ7LIQ7kNvwFyrSVL&_nc_oc=AdqBCyRjNiBFq6620abKI85HdolWh3VpoO-2oO5MZYdnjScN-67mXzkSoaiXNt-T040&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgcsEzERh2aWLJoR4q4GYKSXXNNcJX49czKc9IPMhlZA&oe=6ACF92BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6_0xfyy7DQQ7kNvwH6hCrk&_nc_oc=AdrLhkFq2AciXejULCHgG0fV1JpKRPV3uJRhIG9kKUKLVX9s6XFud2PbquO6J71sRSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs-mRcDw5wl05UM7fDzPxKScKOunM1TMs8HlcYGkpokw&oe=6ACF967E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANqMVdHLix4Q7kNvwFC-ulA&_nc_oc=AdrYULcvQmL4EjxvaPulwhiFd7IYCxE4sJYKd0eE80lLxFSpZGHwxi9CBcndcuv64VE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuFLIfS8fV6SCvAB0JIcsmcgs9Lri63B6q0UeBhqxZ8Q&oe=6ACFA1D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlvn2tLeOmkQ7kNvwFyhqcC&_nc_oc=AdoVhFhfc2aFmxebAct6PJs5EqeHlIF0gMZHoWhOpsOuOGLOXQ56PWv2KRfdI9Yr9j8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQdvWdXiTIlPTRCHC0hFFlamp1IHqEzOOdck8Z7ge7WQ&oe=6ACF9228"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
_ohc=prHftXD1K1kQ7kNvwGXkStX&_nc_oc=AdrsqtJJ-NEJ5yH8uubmDbyrX_wU-HP4pkuDw0g4F1en7wRtRMKXVWaEhZnRl5D6dIc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KZ7HkqfhP-YuJZ4Zzo0jsSZlM6nZ8D1I8JS8E7QlFEg&oe=6A0C547B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aftSF5FriAQ7kNvwFRr0Zw&_nc_oc=Adr5og0jY7eX8IlbbBsivGJJehFwwhJzKHZAtdGT-GW_vA4aMw7ZzYqTQh9SvMQ2Dg4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44--TJb5l7-MPg5ExAVcFOGHmA69UQfZba-Y9pTuR6ew&oe=6A0C74BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANoE2LXYJZAQ7kNvwGBGRW6&_nc_oc=AdpgKqYnpVK1mXoRff5EZYr09pqMP0kKuJCqhaDBUNXSGT_ocWtdczECyqWDpuwIzgs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ksMH_yzylnD0hFVtuD3wTwQsSxuOltgNDXqqUMcgaIA&oe=6A0C787E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-Kbuo8qYOEQ7kNvwFP7zes&_nc_oc=Adqg6izfGS-Ow29BD71ng5Tfmr7Zor-9I0eaJ3oAmiSW2lRW9mBtUvWCjhbLTgd0B6w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54cT78kIIQxeL8SEwiK34hk1cQhU3Vwm1xca4nqHInUw&oe=6A0C83D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEJqn9InKDIQ7kNvwFDphLp&_nc_oc=AdrSf4ICFGD87wwr-NhI8DFuwbKzDz6yHmseEccnat9YbbRntAgRGJdJeZOChZq_PBc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49Qqr87reMNN27OcIIEyF2amd_j4gaCkaowvopippdNQ&oe=6A0C7428"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
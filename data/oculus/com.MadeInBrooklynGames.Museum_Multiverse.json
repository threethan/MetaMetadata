a0a&_nc_ohc=-WyjS9uP9_0Q7kNvwHv-5ZX&_nc_oc=AdryLXxxMb3wkb_rIqPEeoVQWWrkRafatGM7b01PPAg9ygwvLEKfjfFb1gAlPLWGvNw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vAbK5STt_yBjJopP1lsBdsZzWAD3jrhjhjE1c-cmZZA&oe=6A36BCBB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNQCS6gq9AsQ7kNvwHu0eT-&_nc_oc=Adr9Q3cLdfca5b4MsrzwOeds1L8pkFPPag9HeJEUgyx8hbLvAjrYCtD0a84YgUHOFDU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9He0K_dJ4ne_0LHu2ABb-kNSHKJMCqH6kRAW9vjdvsvQ&oe=6A36A4BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwE-9rm_Ha8Q7kNvwEDXX2p&_nc_oc=AdqPXlU8bmYHU7otkLj20K9BoTnmjQ6C2fTr_W5TLZXmofPRqL-0BQvne5xUaUW1e2s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4bujE1ed9UTxSmN5jOK7r0ItuVWPfH8H-V8qvKPgJ8w&oe=6A36A87E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT84XLUI1poQ7kNvwFDiK7D&_nc_oc=AdppqXW-31dpLXxxEVuRtz-LDz_wowUpWPL6Plxp6CL3cH9c5yN2V-1qNdPeBSSYg0M&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I3xjrGxG8pTARrNXWFtjMdScrCwLZ2seUnI7nqRAeWw&oe=6A36B3D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGru3nRSS4Q7kNvwGJvtD5&_nc_oc=AdpGMNpfDyuPyiriFCuIIB4cE1Xkgu2lYPJzhbYFAJMj0z_QIeApDUP5K25tzM-WId0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2-s8cjv5Za_TNtl9w7n2SmmuBr7pNLzQNQn9AEIgu3A&oe=6A36A428"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_te
c_ohc=s8rr8qZKji4Q7kNvwHpiPL8&_nc_oc=AdpRFlaM1oV_uDuJ7EU5k8F974_KnxQhswLIYFEd21rrobWDcbXLIPoFvl4QghFJhYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1FcnhhrqFY-flfjgVQWoVh06stAUNN9DIN6bD9f9esA&oe=6A7F06FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rz7fI62myvQQ7kNvwG3JERS&_nc_oc=AdrEB_ZU9RNZIOw38e6A5Qry4BRk8nmo5TRzQELQA8Y9WhHadjhemZlRkb9Xk9fV_Ek&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkqx9PXh_G73yCJcCy2QroavXG9thy-R1OB0vRvpZJ_Q&oe=6A7EEEFA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3dDRXcQrwwQ7kNvwGAuPb5&_nc_oc=Adq9f6cG1GX7uTbVohk0fEf5OUSJL7j8gd3Ib-ZQK0Rs9Oc-nY9Q49ayhDzRqKtwWcg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ3eup4kM8ecjSPY95PDaZ1TdEAs99nNlkBw3Hqhyu0g&oe=6A7EF2BE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScQ9yqjli6IQ7kNvwEiWDve&_nc_oc=Adq2nPA5MUv7nVASawpgwc5S55c_Z6WzuBXdLaS_PkIy5bwL0B1YmOJ3te4OBtnRLXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKtGFVOzP7xnqIuRqKAVKXpOm3JXrVNzoDTYkT6ZNHHg&oe=6A7EFE11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nnj6AR6msXkQ7kNvwEzoRHl&_nc_oc=AdpvbivgtsDV4WMISD0Lz_rL5A5RhCMSIeXHnK3VKUyec7GDuVtDjY-tabFtZvL6qSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXKiDuuAACNkEmgT73q-Wd6o8b11feQsbEDTjTs7Jbug&oe=6A7EEE68"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
_ohc=rAx6PQCJwIIQ7kNvwHJ-1RP&_nc_oc=AdrL825Sk8wLHoEd3qgXmq-E-j40bqqwd94LD6BR259sEfZGp32e2sg14L0o-34P8g4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyM9A77ZpH45PbJvWE4z8mTRZEhwEOd1qL6Amaeqmf-zQ&oe=69D100FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCP4KYgG1dwQ7kNvwE-fILm&_nc_oc=AdrP--DtlwZ3tnwrV5qCtdq5bvzQk9KMsSapHvvYoUNR_xoPFqXT83M3qo2sao-ga88&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdcJKx6MFa3Ju2XohB0ZYvKdW2--_gOkSGjgYYPpoIIw&oe=69D1213A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F89ETUveQbsQ7kNvwGN4Xe_&_nc_oc=AdoQXNRgyq9NRhRG5nC4Buc_dcyuvInUmaN8xZWrzKfdGu-z6TOXvJfBgxgz-QyT9Kc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfLwnTSWtwlQI5MJS6vnG669IcwPFAeQMZ4-xdd_5tZg&oe=69D124FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNfxOz-nJgYQ7kNvwH4aKMd&_nc_oc=Adr2QAbD64q4varrwpV4JwYCFk7xqeD_eZjVbSX1P3bpvKrYyQk7URI9y8F5Gf3SEYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4LRHI1F-uO4Mdt_l0hqwT4W_IGEqHpgwNjmegYGzeTQ&oe=69D0F811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUQ4fMXZlkkQ7kNvwGCwA4U&_nc_oc=AdoL1hUfco7awCVIpXc0Jgc-R6QQ0SHRtD2ULJre89y1E4aCtN-vFxN9jWDba3KRkiU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxuk3nt-DB8HLxfnn8oK_FoCtgqaR_AzyHCL102SIYUKw&oe=69D120A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
c_ohc=vKdneyQ2i94Q7kNvwEFrnXR&_nc_oc=AdpemUVczLM34bk55nkkEP2lr0ACNlgCCgb_JcU9TU1_hVwYRH0qaPjZneYwoZqhflY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqgKS3bPmW2IsL_BR_ky6wNsAe52GM_55ujgBOMtl_FA&oe=6AA7E57B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK669sjjx_EQ7kNvwFWPNd-&_nc_oc=AdpTTFfaVGI7UgEmuXHxutyOD4ncwxNzoXXH72ONT2uqXiHWVQluZ53fwheyv7P6Z_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZKxJ6I7vqOyj2v0RbtGgt43bhsvvBJGCqbjeElI4RtQ&oe=6AA805BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82jUd7xMJCoQ7kNvwFGMhmT&_nc_oc=Adq6JmHoN_21gHWoPjOrhahBlsFG-llDmkTybTWjhCamzXI6xXMeKQADxaIiGlrM6uY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnIr2oneILy_xNXK3ggG_fWP7x1osPXGTFyaR0IGzD2Q&oe=6AA8097E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw_M448VpAcQ7kNvwETs5Oy&_nc_oc=Adp_LVKzf56nU7j-vez38nX0BfgyzT8Qx9JREpf8C5in3R3gz8M4gclvkhwly1bSBeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR1S5Pn13aiKt1pRRNJtTEsVfhOOmr-xw3MP-l8RWHUQ&oe=6AA814D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uw_NKSKtm8oQ7kNvwG-Fo99&_nc_oc=AdrNBHlbKZ0Vk5h8zqrt86Rcw_fcnFPhqzf_IjE0g28bjuk5xwv4MBONhv36-m-y1F4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnHpjbgg5v4ZZQ8fXr0YFU4HJZnXCAEvblJCW37HDpSg&oe=6AA80528"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
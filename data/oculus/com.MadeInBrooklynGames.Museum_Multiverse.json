c_ohc=MxykQLZNfosQ7kNvwFwOnId&_nc_oc=AdruM2zS-3in36JUo_upNvQHzGM216fVth5bMj4a6S0MSsTpYyTIYkTrGPByVv4nApU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9hn7r-Q6Pl6L_8pI1YYq13tnBA8nDZu2xjeJXVqa3TA&oe=6A9C403B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFuEDpawTdQQ7kNvwGuAj0-&_nc_oc=AdopGYmlVPsn0UXiyJlnhFst1RScf1l8ZhV6eItE6LBXwkyG_IPZBLltUW0x6vp2EDQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUBkOYXq9LiLX9rFbqdK8dGRz5nZe69dQxAhjQJgFrLQ&oe=6A9C283A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7kfEAC_SgMQ7kNvwETAIiO&_nc_oc=Adqimki_lV5zvY-oggbnUrPX-XEX3s7yHXocyLqCsLOh3ZLrXIQanosss6byUOHRVWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUv1W2Z47JejIdcaIn8OcH-YsKrjzFLe6i6fGcT5K3nQ&oe=6A9C2BFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCWpHCKxxQ0Q7kNvwEsaySp&_nc_oc=AdoccxzINKAKdPbWJtQJgmBpMuZzzdLyYBY2DkPgK8Kbfnlv-f32Qgjz6hvPevqSfxg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIusIktEvYBBKStj-gh4szbUH7o_zPRgm_UT91kPhrmTQ&oe=6A9C3751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdJ0p_ZoYL8Q7kNvwEJsXdC&_nc_oc=Adp4Pn_ef9aXUAk9inpbH8dPQsTZ_Qe3tVr59Avy3SFGc5bWHlKqDOyrPMO_P-CicOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIeNW1p2MyjsnZUEeoPaX_uAvvjxx9hFWjV5Cith_CBw&oe=6A9C27A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
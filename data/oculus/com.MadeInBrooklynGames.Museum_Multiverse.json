c_ohc=mGn9O8maTYEQ7kNvwElagf3&_nc_oc=AdqxmeEzkkWikNB1_D4R35YP51b_sCAk4YI8gLP2HU_GVZ8BkgkyV6mSmdePoM8VPL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDlShQN3Mq4FROawy7DAjYy59uFIWCaOVWDCjKENQaUg&oe=6AABD9FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbt0xEZvazQQ7kNvwFoMJwI&_nc_oc=AdpPNW5UnknZvIRBhfrX8hRtiHolEzztL7Ee7HUmXsCrc0QHYIdj_6Ic2cdkrNqgpnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9_vdX5d0truDNlxcjx8HtHHX5UmSUoq-P6rH5CCk79A&oe=6AABFA3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFdiSSmZEfAQ7kNvwEJanQk&_nc_oc=Adq6Gayt1oqSFBqxFa-Sk7VekO_kvC9-Cn27tjJzeNbPHXZEWF5RZbMFY-QxfYg-7RA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKanRuYJvWU51odpDh6EF7TdwCSgYDYYptXTyJ5v7bXig&oe=6AABFDFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khBnYZWjG9AQ7kNvwEHEu0x&_nc_oc=Adrt7oGPlvNb7NVWEpkRsotn8vkHo8Fpeh5bGyjbh6FrC3a6pFHV7qYHD0LhoFv9YEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0rqS8Tsc6oTd4eETY9ELyZQ4Aql70JF7gxbxt0SFzEw&oe=6AAC0951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYWsuavpE1AQ7kNvwGMQGXT&_nc_oc=AdqgIPPVKyCG5ZM_9QvSMeaYe4arqTmMxLXYq5QYbhGsP_wt2HPMwqXtUF-ZJLKCJFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3O8ADNwRO4oxoP1kPsZl0GWeFRGErfy14LR7HUGMRBg&oe=6AABF9A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
c_ohc=2SRLyyJ0juUQ7kNvwH3zHm2&_nc_oc=AdoSSUrNLzakm4kT6pjQn2iZbXPWc-S7pDMdeFwDaJ9n1776HWTyR9V8FPPjxK0CKmo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO3f1rQCFF6H83_DB9tzM-hdDYdkM4rEACZLDf4jd0jg&oe=6A95E0FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpRZ2TG90hcQ7kNvwG5_gJ1&_nc_oc=AdpZVecf_vktMI_8qPMfGLxSEBixp5KzJGX93BbPJ4Aj50335j6W1d5dv4Gb4BC9r6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGIFkbYCfW8HzMUWTbbd9EFyPDM8wqJcf_761pPqsB6w&oe=6A95C8FA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_qd5Gs7drwQ7kNvwGe7Fg6&_nc_oc=AdqDgSkT0yYt53tXqbBJb-xTgR3s0c82AmZDxVKevumGu0OI09kcpYD5DQj8y7KIyI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGml30JLQ4ieIUz02loOiCV4V1PE-ENvIQxTES42gcCqQ&oe=6A95CCBE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbeZz31XOkMQ7kNvwEZHxhP&_nc_oc=AdpERZ5wkq8ciCeJbzTrz1diKtPqqTS4R4i4CLnXNuXlIf54d76eXdzUm2jk4VF-VJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsTQnxDequUYEqxOialesUdqFHl7RO4dbbqDv3NOvmog&oe=6A95D811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9AFDLvnKZsQ7kNvwHQF1Ey&_nc_oc=AdqATFuLRrczKGbuQKyaWyLILF0OlvSUeNTRtRtGEbPUq0QX1RRyY-cKrL6nvva8wWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwvchrAICLIbMwP6CMCz4cfAuTwF_WvgZFi4tN0nUR6Q&oe=6A95C868"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
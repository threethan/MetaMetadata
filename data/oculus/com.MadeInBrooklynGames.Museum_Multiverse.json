c_ohc=XJSI07VdExoQ7kNvwG7Sq-4&_nc_oc=AdqiwjO8QwOgk89b3OCgN7_TZf2yrIjjoMR2ZeuOY5yoAHDwP3cBYV8KWzN5UUDqrPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8mTedtkgcXwv7TK1mWr8ygo3Fp9PZhg9orxYwS95QPQ&oe=6A4A833B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbePYYiHWJsQ7kNvwE4FF7N&_nc_oc=AdpIMgI3OJAhleRs2hea-UVADSjbdXOq7JIm6oKGwFxvEa45wllQzBFB2PnNZaHRAuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn3sEZ2c6RZTf6z64_azOx1kE-IWoMv3vTormZco_ciw&oe=6A4A6B3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxvQ8WFen04Q7kNvwEhuWDn&_nc_oc=AdoeoBrBptUAKPKjCux-8X_Rmmgxky38DqUVgkWItzEJ2vwoALepq1hgqttnoJHXCyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtnC4SIwoFkuBpqwf3_y7OeevpWtElkphEdzAtmJiUTw&oe=6A4A6EFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNsoBaIiutwQ7kNvwHWhg-b&_nc_oc=AdoQWBy3zvg6CiV-dAYkcELus5z35YCfNI4yHeexT2f1jiaQzCOpF_9p7ELCXXB8jyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXdarauFzZZk-PvS071o4u7H2uj8nzcB-MGN4dwVZXYQ&oe=6A4A7A51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtPQuYPXLY4Q7kNvwGX5VbG&_nc_oc=AdpkK8ZW1txmIO9wHOXooD6YkeaHE2D4XLs1SCiEYFKqgKIbPMwZDQOUoop38-eDh3Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdpvQJMoDfBBqi63eewU7GHVZTtZDDs0ergQCZB-RRWg&oe=6A4A6AA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
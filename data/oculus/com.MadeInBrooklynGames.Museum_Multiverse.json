c_ohc=DhlySj5whs0Q7kNvwFUfBza&_nc_oc=AdpDh6Ws_CYSDSoQVSOs-K02IZWlfYpAn7MOpI6vmRWv60xTmCHjDtsv4QKyWXG-W2Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHW1DTsqcKF_nYRBHMw7jMB9eKyW3Ck5G8rppr0PkwRAw&oe=6A92CD7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpRZ2TG90hcQ7kNvwE9UZ8i&_nc_oc=AdqNQr1nAMnpXQdLStKlXxoLwTqoeN3voWf9TLadu6phf2P51b_C_9c2o7Kl7UyS-Qo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXuzPJQKLX3GvsaVW8rgNrzIBCxMjiRPtkbQpsK6twoQ&oe=6A92B57A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkPTu4NZ5ZoQ7kNvwHckkN8&_nc_oc=AdrTS7sqjfcO2v3uT3UMiSDRy7CVPcVSiQat1sCdkCis6B6fjxniFi5FW8mQlmAPDw4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIFh1fFOTb-USgnjc1QvNa3gl28yzsPnaeLsl3IqyFfw&oe=6A92B93E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ozdhce4tTgQ7kNvwF8X-cP&_nc_oc=AdpDqsxy3IT6qXV-Ce1VRwm-7eUIs4zwxJIuvZ9VcXs0fFD-l5nboecCtRYqY9lNRRk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv5hyWi5NOGkZeJaEhWoAcdHbFRxNd-V01OrGB1CN0tQ&oe=6A92C491"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U74hGI2_x1wQ7kNvwGnV88E&_nc_oc=Adr8fzp-mjo9e2bVdptvkwIJ9CPBD64MHE5swoPQNZd_RvO7JDFcpc-HnPLpYYw7Rg0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESS6wSXS9ii46Qej-LtD6pw9Z5ddR8bwYbtPpe5RkHoQ&oe=6A92B4E8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
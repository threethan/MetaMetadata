_ohc=6iRcHZ6bXsUQ7kNvwEd3PY7&_nc_oc=AdprGR_cy67a6TUr8mcIVR042LcGph1IOU2f_K_TMGAIqgjqoJdaFEg3vOQxtwUs9Kc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cnS406ZegNL4U6QZJvACXpiiLUk5olRMGOUlQM2T3Ug&oe=6A3D543B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOY1Gb902RUQ7kNvwF9K3oW&_nc_oc=AdpRurH3g_jaXB7Q6fLOWReRVoBuH29SozCq9NEeYgD_gyun-24l4hk-yV80dk7_iBQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yJ8JUIMUtsGrnXj6b-bbzfQ2lTWlx93Dqj_8oxGsMkw&oe=6A3D3C3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jCu_rBcj1gQ7kNvwGp94Zl&_nc_oc=AdpaxIjkezjNLzU1kJ0E79OR9pPhmFL1Rmc4KLhVeybXZhvuRlYEHfaYeV9yEOjEW5I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o7RtOubB-F0Y3HwNQlRiSrHsksaswx24Dgw_svrhrCg&oe=6A3D3FFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LosdBTK9EoQ7kNvwFufVNy&_nc_oc=AdpQ5U7qxghMiLjDJeo8Dtn4h25o_DI6LrR_Q9RWif1fUEsVOb7V3p0CU5a7GJDUkPs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o6bbZb_Dh0ZtaGIWSe1Y1R48Sg36-YAUfLnlGpbvH_g&oe=6A3D4B51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv3rMjpIzbUQ7kNvwEgpyKK&_nc_oc=Adoq6wolSbMmwuoDFdnt-MBz4bn4cTm6Dzu-uCDZHSxFR0yndsClAY9KuYC-A2q3JEk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kj-Z4PhiKeHg4fRmv0RfrJugurqr7V4RiXj0u176Nig&oe=6A3D3BA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
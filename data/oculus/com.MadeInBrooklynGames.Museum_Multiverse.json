a0a&_nc_ohc=BzRw8NHdakAQ7kNvwGMqWPz&_nc_oc=AdpB9JR8kg12YUnfbsTXL1nIDUJKqme5eoNCsgvoaptb7CXw9rinkuLtF7DUuicfUV4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_txnrM5k_LsYiiamwKXIAwxKgwORMuL1jKcW_IyrgZCA&oe=6A22F63B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yThTBN0D0UQ7kNvwFXRTh9&_nc_oc=Adr-w6vl5z9nc9YRhRRrV29xZcqdjAEHYvEFK2Rtx95O_U1qRmiWvZLOyDP1h1-kmb4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XOqYM7sWpdZawkG_48T8qL4fWUgFZRSj2b1FmrRv-zQ&oe=6A22DE3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptt3I0DQPuEQ7kNvwGqfFms&_nc_oc=AdrT4hcXFK4rAfNQdlV-ri-TS3yXwsTYn8A9aRmfZHDzwL2A8B5fNgn52ll7RLk5SfA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MD3aro8C8YspLVp4VGyLjVFHOWj8qN9i-82P-E8Xa-w&oe=6A22E1FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBZh5rlOYmgQ7kNvwG6eyJP&_nc_oc=AdqFycUpN92MTPue_7wtyaWTIZw9km82NB-EumIZPvOeOiRmQtmDdag4lkAJTXDFfCQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zd-_sE-pGmWBbIKCV2SFjWHHFQDjvoYR-SvBi_AJnhg&oe=6A22ED51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LJ6fkGS0VAQ7kNvwETKQvQ&_nc_oc=AdrrIGSUevY3eoT6bns9dbqeD3HrOaLL7D5rhfwFWc4SOdacii2TBbNlL-XLoF5gqrM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NRmTYx76hJcYU1mQzmUBpvkYhuGmH5Y4223k2T1sebA&oe=6A22DDA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_te
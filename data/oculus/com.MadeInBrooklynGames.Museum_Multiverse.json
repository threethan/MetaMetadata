_ohc=2tnSCFe3xfQQ7kNvwEKd0xW&_nc_oc=AdoGnmWtrboorp6utdFJe92F3IJ48DdLDj_lyMcY2HdXtr2InvTrojJPeZ8PBlndbEg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvNA0DqCoqY34WtE0maKl9lpND6wmkXSFAu5npT31WrQ&oe=69CE5DFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e06zTWfOBQQ7kNvwG8seWR&_nc_oc=AdrNBMO3oKwAT0e9D6e_c6_OhB6x39n_tFnjrFctE8F5VFxvJvrPtEcziG2Anqfyc8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyi7QdeZTGeOBgVoSRyDldnkZyiDw16wezTg4hqc6eOnQ&oe=69CE7E3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F89ETUveQbsQ7kNvwEsIIGy&_nc_oc=AdpU2HiCb8WRHEUGrFIy7jEGlGg3NsU-wSlZbFE0RJ4PS38ilV7Ilh16DIHJgmMpo7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNUGw70xjNvT_D-ep1OXOgtV2N4tkYuFvuKNXeDoPcLQ&oe=69CE81FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNfxOz-nJgYQ7kNvwFDw2Hv&_nc_oc=Adpf-eSgOIzNeM9JLp17uUEGdALH1HdRbAr2AQElFqdMdcuzdzceP2xJ9HtHbf33iw8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyP01dyWnjL9xaJZGJ_ULT6TVE3vJgW_VTE0gN8t6h1dQ&oe=69CE5511"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUQ4fMXZlkkQ7kNvwGJnH_p&_nc_oc=Adr66MAbOTpYCtkQHWUuYJMB7wjpIwebhZ15KJMBIG0HDnCZfqklNVEgteUAlmIySss&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmZKI78-cvwYtnv-LS-EdAs_VglgpYOfqd5Y3AgBlFcg&oe=69CE7DA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
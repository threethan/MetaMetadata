c_ohc=uWwzwHzFG30Q7kNvwH28WJm&_nc_oc=AdrfYOBlCrpCo82q9b6V8Yp4hjrx2YebOCwaySeWavxakFLWI2BW-c0LynQOj5W8fMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeXcxU37e9Hjv0vSdF6En1kZmIXrClL8I4J7exRMO_dQ&oe=6ACBB63B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQuI2oHsxakQ7kNvwFqyXIO&_nc_oc=AdpSGGLPZkagTE99nH-9PuNPIy26PmRZbW0SH6u1jz3dwbqJ0U8DUD_jMfoPDcKkvkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCnMzEHnnOXG6Fnyq2_ZZyCirHCa4iOTKKF9thZAoi8g&oe=6ACB9E3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M16heblwxs8Q7kNvwGo9ZE3&_nc_oc=AdpSHpUyD_mMPQ4c7P0eeOY93WL1doQFnMqByOEsOBYouTZx1dfL1ZSOYuYeJ59FE_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX76DgZlW8VTYgAEPBLHUkorElZgpIEcnhjDwXHqlY7A&oe=6ACBA1FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eq1TeilnaecQ7kNvwHxJwdw&_nc_oc=AdqbT520jLDLEK9W1Z7emVvdmi8rVRrv-CxwlEu3XuPSd0HDS6NjBBsLbZiCBV2L1Ic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSBBY-V0OYcNZ_9EPhyOOOnR8IrSAS8hSkye_OvB15nw&oe=6ACBAD51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWI--duE0O4Q7kNvwFtFHJ7&_nc_oc=AdoL5dHuoFKrXVDNVbc3IElixaIhNS3Ri0Al3_ZBwnmKqYGRwqCRi5yJVk8V8UvEf2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWWSvPOXBERiVJPJkJTl9Y9n3dBstQWVcEhGUZmAp1kQ&oe=6ACB9DA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
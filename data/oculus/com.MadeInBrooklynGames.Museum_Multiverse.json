c_ohc=NJjSM29tALIQ7kNvwEho_-U&_nc_oc=Adq7TJgOBux_wL5n1kQDr9ON1FFcSRmmIDY9C6UU7mJlSYbUr_0WILIYHigzTXv8Rvo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIFyoVzR_EfcgqhFyOAjbNqMxlULUxVFOeEyMqhGS_LA&oe=6A4F90FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okhJ7jGCIjIQ7kNvwFtNVnP&_nc_oc=Adre2B6oAcWZ9AAbxxX8-99VV0NNmzvBngK0akLGBfDPUZm8SaZ509Ahruv3KzhQAF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgAHvZqG4KLMUG7nZulJ6UQlsrHgbNHkM1w2kTTvkQug&oe=6A4FB13A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WtZYk-c0vYQ7kNvwHB-W0j&_nc_oc=AdrKpBe2g8E61pl5iTpJgi81-wIF5s2f1OzPWQ7e3IJIwEagRiKjnFUxPjtBsKV08dE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-t4Vx1PDHQ1oYXs0UNzzzyBj4RTdboz1WcL05EkVoSA&oe=6A4FB4FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLCFngDC_ncQ7kNvwHDdAIw&_nc_oc=AdqEdNBBE5nSBAJjqi6dta4qK9SWgoFLVLjECMv3ipGNiw_t5QnLhF4ZQZVbK67_5P8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0kWP2dcpRyruQVSgve-6CryzUU294jpcBHXcUGxP4ig&oe=6A4FC051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdOw36I3c5gQ7kNvwHi7Kw7&_nc_oc=AdrJSWwiB7vASMDDVvpx_rzMLjQDKOQQ3F13bJ8GX-BBllRg3ZGmgf9Jw61NS2_2_Cg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH__vQP7LyiJyn3BsHVoCsPJXdtzVSijvCtan5Fv656Q&oe=6A4FB0A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
c_ohc=WOKUIcMjHqwQ7kNvwGV4PQp&_nc_oc=AdotpbWgMShHuVuZGAqNFsKyLy5aZebEufKZxM-_Hkpjq7Cpv6IL5kS17wZA12mhUhA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP0cT5bKhuHM2L76O_i2gOBpGlqX3oUpvVco_dHVUcEw&oe=6A902A7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IP2NoutM8UcQ7kNvwG23irK&_nc_oc=Ado5gvdWqzs0Gw5_eSRNL-U5G52_FjB-8s8mkptMAkqkeo4hqjFpyZ0SMYuooAyDSMs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDYV-NDfGzGIMu1oVcOIHwaLKCypiFUplHWdpUaM741A&oe=6A90127A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkPTu4NZ5ZoQ7kNvwF1ocRc&_nc_oc=AdrhMQM_GanVANin8ezOKKReYjSRct5bSidr_FVxvMkwpaTJNeCxcU_Q_Vx88s502rc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNNF_J5rPjytslIrstJRaEWOdgn8dc82nkpZbHzSKYBw&oe=6A90163E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ozdhce4tTgQ7kNvwHxS4XY&_nc_oc=AdoBUy7049JNfY7kY9p1oyB7Bps1nTQnDCatevxchuvd89INgz0YjNlnX91lKT1aC3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4H0JpfMSNSSJi311FagNx6KmxMmYHgpBoc_X2WT1UuA&oe=6A902191"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U74hGI2_x1wQ7kNvwEEw4Lo&_nc_oc=Ado1ThH4RKLvjSxIh6lvdNm_fl6EensSdpKto7vJWgBvsISYA1LaNXIAET709FkzPjE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNiWyF6T1PwDjGUTQ6FcaLx5BcVVKAcAq4jDLqdM8I8Q&oe=6A9011E8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
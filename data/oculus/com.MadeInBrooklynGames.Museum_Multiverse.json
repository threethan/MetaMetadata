c_ohc=Cun3jUSrMroQ7kNvwEsv54z&_nc_oc=AdoHOUih_jQySxnTitNmlwAm9mR5em-menoHtxs_5kwp2a4zTmZ3Xg8DW-jhlQj-QsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YH7OApdQn8vgCuk9F3u1HtNyLtC-S1RF9a2KDRe582g&oe=6A4261FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqVVf6UOF-8Q7kNvwE23Oop&_nc_oc=AdqaOvbtp4ma6Kw9I2E70bb2H00awclXGLC7DIJDU9eLmL7SCUe9_Cp4ERUYBe1DcOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a7ddkwcqQRRgEbK-WRoorwymU7-Ru9VkrOFtA9JHZXQ&oe=6A42823A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GeXygdEpQMQ7kNvwFSBYn-&_nc_oc=Adro2hhAUt12AUPacGt2BNnvV5QQdnhLLyfgzrfMgdUE77O-Hcv-hAx_7A9wUFQY22U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AiAwu5ZGXVpMgwMPxnR1--hyMDH3N4vsw6vzpVe8_SA&oe=6A4285FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBs-wwUxv_EQ7kNvwFmOpOk&_nc_oc=Ado9Yv9rZ5G9KJdKLuzGPJD8qvJWdi4wZ3-PPD6FI-JBIad4UTOupm0ey5btSOowWtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZUeQPdKlqovB7fgPuh3pZTtdTiNg8HW4C4pe1RxnMgQ&oe=6A429151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_AevaaC6t4Q7kNvwF0lWqf&_nc_oc=AdpY4zLeUeIeCK0b5ybzF4Lr59P86rPgMqe37WvEFYRMFH_bAIuSPt353DNpCb6AnLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VI04z9lLD0HU2ioFcBEmwrKNma9df_XM4eI4zRVJDSQ&oe=6A4281A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
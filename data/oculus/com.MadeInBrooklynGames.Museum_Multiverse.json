_ohc=xPZGh75Mjw0Q7kNvwEr56HM&_nc_oc=AdpoDrWPtoTi4-CKG7HmJCXExT7hRP0bacKpO7bx5nNUOb7OuijgCYNwe8WNW9ktdWc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CdOg1H27_NL2PSBMbXp4GR_Vcnv4_fIXwrsI-fM92yw&oe=6A16E07B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A53tevNIjgQ7kNvwHytyVj&_nc_oc=Adr3g7c_vHCyc4E1UHeSFr3JgKVSOCk3jb4jmcJ-wAQBfr_4fhirnWhVjN1PuWuq7Mw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ojxJYJW-dLQTwT5n8nqc-iPk2yb7vxesuQgHJdw9tZQ&oe=6A1700BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wVt1wvMCN0Q7kNvwErmBTG&_nc_oc=Adp5jut30eojLn6GzRIqVDIfvAsACpgFpZEa2YePPRa2t95x883mKewNUOqxPBto8bU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57ITGZNL7w7saP3drWPPaGRKPZmuzTtSmi9scBfSZCtA&oe=6A17047E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_Na1yAKd3QQ7kNvwHx1VFU&_nc_oc=AdqHyWtt_gL66lSODFu5RB3CWbm9jfe8xgu6BkWio-aiTdTShTzua8PZ-k1ItcgTGiI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45DxMEkIpgSGDJvOCQEUIoAYCqQ6f8-7KMuEXOBoVUtg&oe=6A170FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ct2cao_2X0sQ7kNvwF1B4DW&_nc_oc=AdoULTgrKyuakkqIj3jxsn5XLv8zOVj98ku6vUJYiB512Hgej_U4P3k-vxIvnGlKZGg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4luUA3Tmv5O9J-dNMc0EgcM3W9qHJ58nIcjdtcrJ0Idw&oe=6A170028"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
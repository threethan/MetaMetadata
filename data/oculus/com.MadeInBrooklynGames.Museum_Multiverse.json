_ohc=dHOvzEQPPO8Q7kNvwGmZGeN&_nc_oc=AdoWO0XNnaEgrD9Nw0F7pBLXN-WPqBoQHUJI5-bSQuChwI4DLOpaFk5jUdzzmDFnLRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68TTZ5AhFMRbxMgkKKx0OCapLQn2Rp1SM7mc6bIWuj-A&oe=6A046B7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjWf5fW068cQ7kNvwFu5zlF&_nc_oc=AdqpDUIYTjm6MY49lCir3raBzKU1qktu7ZL66wS6FB_qVB9Al5qZuRoi388GygTx9gg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cSZuKMiFz_cpQLh1zk3pptM9J92U7oDbWZPX2WAkt9w&oe=6A048BBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jL6pmxubx0AQ7kNvwHOYc5i&_nc_oc=Adp5mmzuptg6cdfqsdJIVGMMixkdAUxaifTmCunBFzWECYuaN5qTpmWa1nO1namOWaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IQ2CID4fUQZ2NAmJJ-j7h21aQhqsf1izv-xAZ7380hQ&oe=6A048F7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndeIHRj2Pu4Q7kNvwEw61Dv&_nc_oc=Adpq8XmERQ7W9RQ1mhUsSawSD9Rb-wZIeVL-ixWbetJkL0rJjaqRTkaQmulH7EUCvHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x9Q_YQVWOmIuXoXgNPvk60z8zq6KsuojSgQYtiTa5qQ&oe=6A046291"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW7XFgphbxkQ7kNvwGJJxq7&_nc_oc=AdoHPixENtOmABEKvjCn6CIFyWVwcqeKykHc4R21N2_y_5Fh7gJNTbMNjLSnEsCBo0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uas2yT5QdeqQ0bMcW0NXwfMAoPRHHozk3lE6praZZPg&oe=6A048B28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
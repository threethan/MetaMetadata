sid=6e7a0a&_nc_ohc=MCUXxgvr_B8Q7kNvwFcwF67&_nc_oc=AdpyssJ_EjoEJH7Jf9xRxXvPePtscEgrJTc4fN-QMCnRkiN9hf8gHVoO6_oCIHFfug8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK-WYOV6IszKm3kXEEQbLKPq59kLcXWA4dKJqn04lQ-w&oe=6A859E7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31Mp8v87rCMQ7kNvwHnpZKe&_nc_oc=AdrF0zTvoaY72Lv4lijlqJxpGP0Qcpu32du9oNX_7spwol_yh_Fqe4C31ofTOVi1XNk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg0QOkJ01IgfplA17AhzSG5i9YK8DPe7-s60uxWWljgw&oe=6A85867A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bBUw45156owQ7kNvwGRwX1Z&_nc_oc=Ado2yHM-1xENKUHXyt7qiyzzkodvxP_5Bs5c7hoRRftfHzfWooL-EZcAeZiTOdQgiYo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvepDF0yS-oq4vOpXPyv_mr0ogbckDP-8gss__yG5PRQ&oe=6A858A3E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59g3J-5sXBAQ7kNvwHMHnXX&_nc_oc=Adrz-4iUW2bFue-USFsy8srgBGHrH1l0VQ_-dPDmrB5OL7_VLo2UOdBbxCRkcUzkwJY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8KJ75ELzAgdlxY6S9DzeaSLM8p0svqm6y2XFk3StR1Q&oe=6A859591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaGGXwfvEjAQ7kNvwET5L5y&_nc_oc=AdoqcJG1FRJOdjYtcAjifXFDTBec4_N0YvhP6AHftsQqpM_SHFnjGZ1xw40ormqKGE0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbZkOL3kmJfbkC6R7XSUtt9B1dIs8a4W_saW26GV3uGA&oe=6A8585E8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "d
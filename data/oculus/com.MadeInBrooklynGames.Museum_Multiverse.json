c_ohc=pDVT9aulH8oQ7kNvwEqjdDS&_nc_oc=AdpC2yITwEvFSW9lszPot_kyuDNKjaxZCTq3m7W_F12uUSnBxG08vgXpc5xvs8TNayQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8-WjrO5zG-etgpCHKGYp_ms3C4Ak7sI4-mYf7X_PdyQ&oe=6ADF447B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2QhIDY9vrwQ7kNvwEPeq8U&_nc_oc=AdrGSSZ7PF6aWUd5_zFmG9A6WRyEoujRYQykf7gP-lwzNOqgI7sJoo8Sxb5z4G-Zdqk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbpYR3NUNjZ110EQsyg5jU8k0wFZgF7xUeIGWW6JI8CQ&oe=6ADF64BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl5Ptidyqv8Q7kNvwHRaF_E&_nc_oc=Adp8nq-w_ME_bAdpUvJSCaVp-AiCC18TyPIEkrh7dmo6lJ3JCDct9Fw7UYHDkuUiMSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnUxCKcI7yU37-cR36VN-Y6sVcicVt-MU6UlDDLfoCCA&oe=6ADF687E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VoQnStXB-CUQ7kNvwHfN_f7&_nc_oc=AdqHxu5ElPswHgzX-Nx1vwQB-xqcU_hTC0vzD0HHLkcomkVdrDMLwA-IC_ALll8E9aM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-RRGILD9G-Yr3gG3xw_RG78jQwbhIOMrl42lH7xmqEA&oe=6ADF73D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBUafavEMUwQ7kNvwFtUDJy&_nc_oc=AdpEKpsYD5o8kFnvQBSXE7n2pSdD9CwjzIPwf1WCPHuS0jT0e99OeFXhCq7QZjCbKx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR6w9g8SH64v-To51zwHfRK_A7Me0Ef4P9hddmu3Otyw&oe=6ADF6428"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
_ohc=CoGqc-SxYpQQ7kNvwEGb-ml&_nc_oc=Adq90yH1yJlL2BaiRrX7oDxk1vgK8Q5wqUoz5b1CWYGX04zrggnWCT9YuOgvWxtkn0M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hfHlYeg8Qx5R0SnzcXkMHU2153r-BHNhRidB3TpS6WQ&oe=69E2247B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEsc8L3ldToQ7kNvwFIaYxP&_nc_oc=Ado-sF5m7D1oMm1Tzd8Z2npbX8KpErZGR_F3uPe2Zt4Si8sz1Ji-nro4nr-XDEklAx8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_MtVZ8QJDuX38Eqrqbg66CKKuEl9W3OPFZG67AFPmLQ&oe=69E244BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsq3cV2AZjoQ7kNvwHLMhcc&_nc_oc=AdoamQCSZgUqYqtQuiwTKIrBommdAN-YAhC5VoEkwEvMLr3VLv-VbSXuNqFPhN1yETU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vwIJkzAE53DOBG9UTKo9WNF3oUGkoo1BX9as360cnrw&oe=69E2487E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSxygxsrClwQ7kNvwH9uOaq&_nc_oc=Adoz_96OaeMM8wkoikH8W6aKpV8RrE_pOe84Uc0sE8T6hpogQbYJ7oiAP6X7NdI1Y2Q&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23eOCiAXuQu6I2s0d9gliMtIah8KASmFqb8LO-aQ6CQg&oe=69E21B91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptCoIUONp1MQ7kNvwHAw-l1&_nc_oc=Adrwk8ZeBMNPd-Lm770gG4HpaWnrGQAhxCLau4ctH5HdQ3Njsi8TtzgsIKQnfcFXzKU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_bLtF6FjUR1A9Cd6VoIU13j1bEDHvao4VstRtCeTF9A&oe=69E24428"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
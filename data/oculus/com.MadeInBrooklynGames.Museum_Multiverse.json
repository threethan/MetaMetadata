c_ohc=UZ1qLYVEVB4Q7kNvwGAsMoL&_nc_oc=AdpS-UtZJO6g8cf1uWUJpVfc_HxI4CLEXoPjnYOZf5YTXykdEtgQvG8N81XJEu_FP8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPgxw7eMwPQZeOt99eYtIzDgzipZ1i56frS0xYj3z_JA&oe=6ABBE43B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fjRMuIbTGEQ7kNvwGrk9G5&_nc_oc=AdoRgczSLMatf6kWt__l8VQaTnnkjXNIF3tOfFQky0OeWGG8tmUJ5DM7S2S6CgM4alo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvpsL1LQRRuqVekN_x_AiVo-AYauidcy4k5WU7p7o2Kw&oe=6ABBCC3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBGasJKRaMkQ7kNvwF3KuiD&_nc_oc=AdpVk0Zw8ZnxvJnxWwQ4PLkl6w9rBec7rZCglAInuvrunNw9HjoNbHfgcT92eNF0qS4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLCzNK_5RSdL1dSZeUx6Mepcsifcqp0TIOAxHiUZqeAQ&oe=6ABBCFFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpbfmQQ_cA8Q7kNvwGfMnLB&_nc_oc=AdpC-t6j1sliQKu93T92WqW-bABXaiqLRavXQQtumGlioY_8xco-KkPedlA6gvhH8Es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx34OpWzVIGPOfwlwYEcLhpSWn0djK1kGbZU3xRwQRLQ&oe=6ABBDB51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHQL3St6itkQ7kNvwFXy0Zw&_nc_oc=Adp1I9Q63VKW70vb5bERlic0AIqDPrmVw08nX28CuTg3wR7fyP7Ba9t1BZcPooPinuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1EvgWvoO3IwnuOVeu_xqqEFIDVoxoRfs0kUCo10ytFQ&oe=6ABBCBA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
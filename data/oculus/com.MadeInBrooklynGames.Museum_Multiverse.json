c_ohc=oqXnwulTnLoQ7kNvwEhMhsS&_nc_oc=Adoc_8S2ZSDpZsINUouE5RNLYDgql7ThPBJgZEj_gEUZEdAoKvBV5laCpaPcx-8yS3M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5VokI6iTePu1pcOxi0_VU9DzYrn5XlGpLN5wySJJ54w&oe=6AD0FC3B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJeoNPGJ7LIQ7kNvwEb5bKS&_nc_oc=AdqRUTKl64zvZsqAj4ekYBXpMogT1Ip_ujPY_RIQ9jkLemrDdYRoHcckAM_mf1x0yXI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgBmKfAynfsvV2fbhHT00TkKfOtWHruFnz7475zPqrBQ&oe=6AD0E43A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6_0xfyy7DQQ7kNvwHyPVpQ&_nc_oc=Adr_avyXhlzk38-joVqrGj0WDp0MRwe1IKEPSmPM2nF_3xzg1NkPZ_OulxxxmZ9sbhQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKlxtCEir8gQORo8CM1x_5ngn_0f_uB3Ah8at3FMofRA&oe=6AD0E7FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANqMVdHLix4Q7kNvwF7VHQl&_nc_oc=Adr8uoV01LR_yRUznO4pe7ZSQMQP9k5r4uZG4ZNg0_lVRQzIid440Mw3popwapElG1k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzQ6wIpcmmRXKEC72yvZQL9HC1UkBB-INd_PgRMAl4WA&oe=6AD0F351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlvn2tLeOmkQ7kNvwG0NCti&_nc_oc=Ado2Y5Ti3tMOAIBQTsoL_3WlHMDJeeGlQf5-OrfjQxHW72TXBspjXdioMd_Mnq00A50&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAP8U6_p_Z11PCsyhbbVjdR4AMZv50GMXWEC9e22Tqig&oe=6AD0E3A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
c_ohc=WGoM0qmpBxkQ7kNvwFbLUDG&_nc_oc=AdpiN7BKtUe5N4EdKaGIYVQwh_cbFZzqoTfekr2PAuMaechw5y9ZgI-HnMDmCqoJkR4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0VBnNczAv5dZohJBbPLW_Ci2ZdQuyJq7HYfliw1v-lA&oe=6A9FFC7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WV7NgU_4R8oQ7kNvwGcWGSL&_nc_oc=AdqNIebejUWkWKmUoJJCM8M_TmRMTSv5QnoTyuHg6Dgw3uUTPZ2pSQZmV3R7eoiPYfU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI458assLsfirFkBBXiN0BMWyxzhraS0M1kZt8cIYx2oQ&oe=6AA01CBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8INOYLqTo0Q7kNvwFzXrNG&_nc_oc=AdrSypTbmuE9I8XCXjCuCiwgL2M84yRNIzAK0v2QwFLIg-kUDyJjI5lI47JRRyxzi68&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6S4th7sMloUMe0Qgbpq_9zyNpCU68S4bgj5g_4DGrMg&oe=6AA0207E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqdQKjRSB2kQ7kNvwGmoeBO&_nc_oc=AdpjiCAC0LZH6gUBGOhzSwHfuaMMILBuCFjnqhH4hw38kaDQLUjNy3lAqdlC0WS89Xk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5yFablGJ1YXMGo2rZy90jGrfVTAlZGn_BOZ-okF538Q&oe=6AA02BD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gppytL7Be4Q7kNvwHf2gou&_nc_oc=AdpzQtiJ2XWwU9TB2lgKu6cmRSwgIYht-c9VdIhoIkceA9HVeWJAd0Ma1Npfp3-KJ0I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmzCg_7HFTddQjI0UH4v0sOI9kLBF31X-aN3qIet6-zQ&oe=6AA01C28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
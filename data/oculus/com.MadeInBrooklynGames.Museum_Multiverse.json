_ohc=81tobXFVMPkQ7kNvwHgtWPm&_nc_oc=AdoosgLWQcdgToNBJeClQHQIkrbJXbd56sG4Mdp8dN0nY7l1LD5-us9hGbVk7tA0mvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gVRkMBNCX-TZ-xTnoW73TISusTqcMHRhULk6JqI4YUQ&oe=6A070E7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjWf5fW068cQ7kNvwGje19v&_nc_oc=AdrLj_jVJAhXD4LlnkUrnc1RccSGWTxTCik4igQUjI-n4FZBvXJwkAFsmxNkUW8jSyk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q-ZdkX1FKWrml3MlX4PdzZpcLLCLIw_x3LiDhqmsS-g&oe=6A072EBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFqjCaHjHYUQ7kNvwFU68-A&_nc_oc=AdrTbWXhVbiYS2wZCHsosqMNVFXlDZyMaXt6a99HoQVOS1ocZWE2f9pBH7zWR0n9LfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NEhSmm85LOoE4xIHRh0xdRYPh3yn1ojl8KcQ1UgVBqg&oe=6A07327E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0UZ2Vw40FMQ7kNvwF9edH2&_nc_oc=Adqwgsoi-Z21FfuNQO-vKOax4zecO_NnUdcj3Yw7QuIf2TYO84Ixp56VOyNwY38ltR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BcHcuufctShr08EmGWG1NNJcFOtUO-O06uexRt87m9Q&oe=6A073DD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKrDiYgbpGgQ7kNvwFtJ-wx&_nc_oc=AdrRYXxTJCmXwBSXqshx5UXR_piAj6ku0CT2Q3IY4PfUz9bKkJ0AXc80y-yDZx9If-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DXxGjVXXR4czu3YRHmWAq2S1nqorX-Ri6dAdiTMkc-g&oe=6A072E28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
c_ohc=vxA8uMQWxbgQ7kNvwEL3ikK&_nc_oc=AdotkjOWuZ34pKVqSL9wFk_6r_5yiUBDJQx6k7fDY51khVPnw-Enu1db3yN8yK9xsCE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCjeQtFZ7yEspabM3MfBxCmwXZawRcOUFso-y3CHh7Cg&oe=6AECABBB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cwc8J4mEwSIQ7kNvwFMlZ9D&_nc_oc=AdovFtEHyJ-WVlvlk6yfkHCcp3zNigP8GsOY1bl_tsZSSD7nYb2SNivaiyrA9_H0DcY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM4d6AbE1kIRqJ6Y7Ze859_-EPDVgeFchByIU_kv9L8w&oe=6AEC93BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEFdjVODScAQ7kNvwHHC8w4&_nc_oc=Adr0QKaev0pa-ap4dnTf2XUm9L8kPBObCIFVNIDKvtx_MVevbsnmP9T3J-_Lo6Sa5bY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsbg9a2H4NRfsVqjosJkIPXCZPPVMaxQLgUazziYPGjw&oe=6AEC977E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOMxDk7H9ZoQ7kNvwH18Bnk&_nc_oc=AdpMKUp1ilyAbmfh43WTlDH1tOxDE7OrVx9Xf5xp-JqVsgoaZVOhft-Be-TEyVkHyCI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3boPJ-Y7DcT2UDHKhyUcezIfz5Ju1iRT_DmPnFAtDuw&oe=6AECA2D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj3qxH9RtHQQ7kNvwE4BIrq&_nc_oc=AdrSXZ8vC7oUAQFFStRTssJEplKTQZ8H_ZBkWC0sNDjWAju7k2IilapQ6Zur3wztH4s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKr4tsyjYfz8ceTuBhX0FqMUip4qSVwiMhevLUmXPSGw&oe=6AEC9328"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
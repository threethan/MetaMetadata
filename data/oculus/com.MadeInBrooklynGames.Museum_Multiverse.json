c_ohc=QX7KPhEpEUkQ7kNvwGGLPxg&_nc_oc=Adryoj41kLlY2jI_smIL4SetkZEpf-_IXnzyfHD0kK7lhHhC56w71U1aK_fj4MWtG58&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHPL5Z1KrqMbhwxcq0AQlAZkrjVku7CVxZlmyBjiolhA&oe=6AA14DFB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WV7NgU_4R8oQ7kNvwGRdJmk&_nc_oc=Adoo2gQHFDpqq8AAQSOHKt79-E_vgFh6C0SkFOY2MxIa4CQX10ABmvIWYedK4h9CAb0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8acrSQRwelteN8VlU9JR98OemPJ3ficEHBcXBKSt5oA&oe=6AA16E3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8INOYLqTo0Q7kNvwG9UFsc&_nc_oc=AdosPJl6w6O433EgsmN2xbfmlkL0SVS2Bee39UEGCPmx6dxwysW5htmtsBAizzmNNww&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2k61ABk8fscrj5LxMFu2e_jQpm_e25CSWEvZFVyhWZw&oe=6AA171FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqdQKjRSB2kQ7kNvwF56eDQ&_nc_oc=Adp57l67GQMmPbQKW-jpsWMCgYU1NCZrmjxIzv1pzdR7nDK-0MzofMtHPx0aU8UaM3c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxlMO4KpEqlmLVrgIe4cJA-5kn1FLQqvsOInqThWZL9w&oe=6AA17D51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gppytL7Be4Q7kNvwFWyyi6&_nc_oc=Adpvx4_OnWX8KJ0HWta3IZ9WHw7GreEYCZEFQRhjk3-DE7uGnKRYaBKf6UtKVphP3Lw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0NehNxq5_oq6YZSWByWGysUZG7ySdNVylRnzItY_wLg&oe=6AA16DA8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
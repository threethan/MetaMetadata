c_ohc=XJSI07VdExoQ7kNvwE649SM&_nc_oc=AdrMNYGQbwFbgHpBeJ9-cYozILKG2dLj2B2C2SBqJSqWAf1lrK1Q2SRyFGVvqkoR-Y4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvCZmsZfjVsrzfZ4mi8d3v7csCQZB-eMLz4e-AiU3HDA&oe=6A4B9C7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FsB7uRi4xgQ7kNvwEmwMGr&_nc_oc=AdquHJgfSoJEaNV2jmoERXpnDmq-P8lOCjxs4mJ9XsT3GqydqhIrE0K1Mh4VSW0coE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj6hE7-RRAdjh0bZ2H2hgWm6R0y-GuyCh9yZcQKcvqFw&oe=6A4BBCBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ghKuJkeQGcQ7kNvwFsCqt8&_nc_oc=AdoDGAWyLAC11Kf_Jnwc_aXKb58T_t2-7rhp3nmecl45sJ-Tq5UPa-dbANYPKTbSCDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV-b5rChkO9SzFRFFZNjEeemg8QRJE5MTv57ruZ7-org&oe=6A4BC07E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNsoBaIiutwQ7kNvwG7IxCL&_nc_oc=AdqagPqEa1_QHbxpk4723SZJSmA8EqOV1GU4t090QHiRN2QgWCYMQPeCjxvTdHJdhRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV554W1-TSqvmG2q0DGgPBUbGC9_-Lyb_STpi8bGU5sA&oe=6A4BCBD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtPQuYPXLY4Q7kNvwHnzoER&_nc_oc=AdqlcuD1zROqz3iEzhi__jctZ7Iz5F1jmE3DimEZbBukek69xZbTXK_eywL16CFdWNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEJnclWOj2O-QDxK3srEOGgy887deOYbxXQgMp3rDwaw&oe=6A4BBC28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
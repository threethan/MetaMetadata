c_ohc=j92bbYsWQg8Q7kNvwHeZxfE&_nc_oc=AdoX76EfsqwbZyVK6lREvoXNyxtK3nfpRiTp3DiEIb_vjm2FTdQxSpYRZtKUj_YxL_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhVWlkFBFm7_MO_w84VC5RmmQnrrp7UkCDh4IreMWRZw&oe=6A4931BB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbePYYiHWJsQ7kNvwFq7Qxh&_nc_oc=Adpp5QXG1zmEKTcXF6yRLrVx1sdOyNCOp-aeajXB4pByYsBNs-2odSPa0ylpL286IKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMVRDJ0jYMpeb72CKpFxHEsHlJ-L2i9Gtyja2C5gHDcg&oe=6A4919BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxvQ8WFen04Q7kNvwEc8aZ6&_nc_oc=AdqqlQnmFWOMYVW4Z0r6GHkdcz6GXVx8oro_VWQpNreIoeghZ0Rjiv47JhJy1wYni2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDz-1nes47K_UKiAaHD8xG0086tXVABQuctt8djXYtS1w&oe=6A491D7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNsoBaIiutwQ7kNvwHBDY7b&_nc_oc=AdqegrfE3Xqm_bOqFUCXL6EmJWh_2ftqKwq6mQTQSrnW_23srDkS0cevnBoljejifH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhJhOwcdZDM85V74gwYyMEdpHBQyKUbeTMnqrNqkq6Yw&oe=6A4928D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtPQuYPXLY4Q7kNvwELakud&_nc_oc=AdpZqc3QePqjRdBWnz7e4FHAxP5lz3zQQkkYA1MbDahbxACyLzIBrYjdPFKgVPpfSWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC57kCcJMAoJd5r_T06kmm794olqwBCpayBQAFxFfKqA&oe=6A491928"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
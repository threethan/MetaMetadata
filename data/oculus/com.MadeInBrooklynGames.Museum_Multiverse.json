c_ohc=pAhobHB4bJQQ7kNvwELzYQp&_nc_oc=Adr2B1AgFf1Alkn6raMDmbJBm_ZtthgYPzv7B00W0XOYpJAIIe5CXMPMAU2zkvv1Or4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFZaYtklIGMSMFhz5jQSTIsM7_PitQodNoxrY-Cu6SWA&oe=6A6C91FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz7F81Lx7ucQ7kNvwGphWSt&_nc_oc=AdqZ_rI-uXbR95TL8H5Hr9fOd7lUA-7-EoLpZ2_AuAK-yQkeiaUA702uR3ZY14cxsvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY3XFClvIv2bwCNSlNMZ-_OD7o3tSEiKbfuzDkSVe-WA&oe=6A6CB23A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYFBDeGYmK8Q7kNvwHvEn1j&_nc_oc=AdoG6fpbJpGj1tfC7y5KFeLH3e9PVeOIQAFaxq2NvjqfiImKJSKl2bIH8EY6iUio-oE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1JstNhjAu3KLy1DUw6eF68wHGGkJK2WQ8ODPJyiE0Hw&oe=6A6CB5FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv2FTzgtSNsQ7kNvwExK01l&_nc_oc=AdpQTkIxFgyo8pLDEPTMjW5gwDgCQ9WT1hc9nRUP_UUNxKxV2WAgMfA0f-GvfnOnoMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1JVrWkgJanSntzIV-7Z5VFp9K9kgPr3Lxysenw-lWgw&oe=6A6CC151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soQB9wc40F4Q7kNvwE2uvrV&_nc_oc=AdpGXwXJ0XZpkjITc-qTLW-711SPVGcFKF773YPJ5mLZ0w7VVvehFiA8OVMvLRSslHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcn523bDmWs1ZvUmfBa-UO6wOFL7J3c3U-TAxFbaD9TQ&oe=6A6CB1A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
c_ohc=oqXnwulTnLoQ7kNvwHXiG4C&_nc_oc=AdrdNnyDtseax_pLZEKcSvx0MtBHwQakfceZJ6u6G3H3glwJoLlU3RfOF0iJSzkIzMc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTnQ4ZZSrTuN9Q63CAq2Gmm9cvDbZh49AklL_qWNm_jA&oe=6AD39F3B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jj7_palPzAcQ7kNvwERDyLh&_nc_oc=Adq-_ITk6TGuY2zjoPBwfkZXwM15JvXPqEhiD_ksdIHOzTWyBj922qzGRhvixAFSIqg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqyLEARXNjJUVPDS2rrCVVP67sAjyLy_NSgKlP6DwiOw&oe=6AD3873A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQyEgUT5M5MQ7kNvwFRgvVN&_nc_oc=AdrQXaYuahmcPDmwTCih0a8oTsXk5LdnsuzGbiQpuXWZsP1gFZ_bk4bZAuZMd6TI-0Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUU99TikEBWHjH8Lw3QJIA5QRTjVKGIAeKTz4uYURF4Q&oe=6AD38AFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAVdGN_kkRUQ7kNvwFIHleV&_nc_oc=Ado3Ik3NC4DLxBOzP_-M7C2yp86KTAETj1XANZ_uPZxQk7ZH73DMv4VewWRCXCkLeE0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1wbEiSppr_Jk9SYUvpRR-ybkBWJfSE5S_dRGn1TMkbA&oe=6AD39651"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6UI1zaR-uwQ7kNvwH9C2HR&_nc_oc=Adouq4curHQqct503YK7T0FkoPIIeAdzO3sR9dykQNgM4V2meRKKjlo6qv0sWacuLaU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy81lcRLx9J3iNeLafKd0wHWzVRg7qfNEIWrg_d7cHdw&oe=6AD386A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
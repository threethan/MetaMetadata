_ohc=ds91i3pfbgUQ7kNvwGBBcx5&_nc_oc=AdrO1811HfyigakxdX_EqtQ3o0M5pRjjUaUEz3Hm-PHh5vRul-FphgaaT8AeAN0MN44&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7vyzmKOqzx7r5_J-4SFqukFqIHxaMlfStVOaWqlgZMg&oe=6A3419BB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNQCS6gq9AsQ7kNvwHWgw6B&_nc_oc=AdpZiNV0c9S9Ixl4LBTLQILM2ZHA6-rnT4eNPUrt106h5aQQ7pQ4p3qN4cDTiVuAiqI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89pS1k5IJWtOEJRFLlZvlAy1BUBb1nRIqgc0TaonZlqQ&oe=6A3401BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwE-9rm_Ha8Q7kNvwHfW6mn&_nc_oc=AdpDmdhAXggrmNtcFnEqwlrbaThbLbldsIdFRMYfJO4UZFqAJJGaCVlvpluKxyqrPLM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nbxpw2WHh2Nn7lGlES6VXl_wJV5PexsaA8tc1n9weyA&oe=6A34057E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSQgxvQuls0Q7kNvwEP0yKs&_nc_oc=Adp6FA-WaFXqnytcPGt6eupEyhV92uEeEVeMcxufzg_TPYIkbzB_1mL9kOejD0JKigY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_af7BJmj22GLqRHNg7rsicP189eKIJkolZpvBLCM6D6Q&oe=6A3410D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cwPHYpB09QQ7kNvwGj8F4A&_nc_oc=AdoFSNs4uEY2TziGtSuxYrXPetBwc8i-yivqZC5n6Jh-En-Tj4QfV2sY2NPMQP0J-Lg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OHax2bEPNzca_EB2OpXwtd9cfqh6G-fNHnJ-kyUnehg&oe=6A340128"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
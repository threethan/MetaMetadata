c_ohc=cZwY3iwsJ7UQ7kNvwFeDF6w&_nc_oc=AdqL6FH6ooRhVXzqQawcVouxKUTes-OWX9T_1SjmJrctKmHsHw-WbvZdV-eajIzD5zk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd6JYB1D-gsWen16r-HYC0KGNPrNxR9XGhJAps9AL6Zw&oe=6AE338FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3vvLst7n74Q7kNvwHu5P-t&_nc_oc=AdpIhAZHlLH-vRx5Nq7ck1WQ8zWf3FQ0wKdlhj28x-ZjiOBGRSiWCe4WNSUFt7586os&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc25KqpGclVGTmGxOD8-Y4E2eHF0nVH8fAAcPLU_0UkA&oe=6AE3593A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDvKuiLs5xUQ7kNvwGo2rps&_nc_oc=AdpCCOW2a6yfQtYvWu3GjOWZAuSDfUAXFnDYvB-kCjseAMBF-I3i09N4IJcuYPUMsx8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqcc_r4G1pefYuZxqaMUu9wbHFVBIz6_tYCUZh7wIMIw&oe=6AE35CFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms-Jv43ukNMQ7kNvwHLLg2M&_nc_oc=AdrMcyX8ANYu0rdyZD97a6weDBxDEoZFkMzFXRTp9_r9AZq6x64is2MWabHb5yy0zMM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe7IjNWQxd4eMV8G6C7j63YE2hZu_R62SmZ6W__9Vp6Q&oe=6AE36851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmKIo_5a2R8Q7kNvwHj-Jqy&_nc_oc=AdoXd-Joa-s6A6f51kkIezXldadZvRllsJSK6aKXO52o1CXLG1mWWIG7FgTJJWO8hFI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5YPc-wS820JyIc9gP_AEHRDWui0bilnI2LxlcqNtB8g&oe=6AE358A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
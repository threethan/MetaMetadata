c_ohc=TKerTU4Hv1sQ7kNvwFIdlRc&_nc_oc=AdoVXpHkKYFYpGkMW9qv8JriYK7ev8H9iEjCWlWrn5EpkghcN-95W2hk9WiTwqQQVQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE71gy-nGS-G3M9LNPW7ItLYFi0dUeyfhzD073GJBn6w&oe=6A5779FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkCZPjCEqm0Q7kNvwGzciY0&_nc_oc=AdoysJhFTUMPe_zkAWIyWXV568YbeCgFstF7xICJmGZI1JHDRkuXNqoW9EHDJJpfuog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKVa7JAXFkdFeHZ77bKnpjbuHW8BDdVveCSgyWINBA_w&oe=6A579A3A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFNhYotU4vIQ7kNvwGhqVcC&_nc_oc=Adp55nlafLoKyA96gsIH6J8uWfcFwI4P44X6rI9NNv0mabJreZvGKHb14szJomkf-Sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPIlhvnEVktmpwDcdErn8CF5OPwkQB6WTbfm2ac4_nRg&oe=6A579DFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqxdPtHKZqgQ7kNvwGEt5PQ&_nc_oc=Adqr_s8pUtAO3zPUpJA4e7WTVofP2-E2DzZopblQtFWXJdsWKUFUHClAVy24hxgwTzs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7-Km8HBZVaqJuNtFbODcMaq_Gno8gLtuVNWMDuM0anA&oe=6A577111"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzp6wkNrI6YQ7kNvwF1gQev&_nc_oc=AdqD3RKxLcjhxpFn7XTn2OoGc_Rlx6WLblrb877zlbVDkWvR5y6Wx-zn6A_tMWXzzDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA5XcDYIDEZGpDD6jG7Ga2QVHWtFrE2xx1aFqqzdC_jg&oe=6A5799A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
_ohc=6DBfXG6R6yIQ7kNvwFsnnaR&_nc_oc=Ado5Vj_QNbwQWNke0m3QTqlXnSbsxwBVrKf8DpXxq3PdXwUIBpatvEg0xqzA3lBAyNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ktFR3wUDBSisyqzSmpPX1tSMaxknq9ZcREL2IK-AN7A&oe=69FB30FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGsx_bUhAqEQ7kNvwGNg_c-&_nc_oc=Adr9UImYYdKQ_2mZYHF-nl-8kuOg21dCJJ-ZaQ2C1aeI-JKhNv50ECsMjpGas0J43YE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EOCCU-xGC6iyosc-b3wo2HNoJHV6Bw-R7FgE9InREyA&oe=69FB513A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMHfj4KshG0Q7kNvwFPE8tv&_nc_oc=Adoxz33GtUwVGOwLas9K5TD0-z6Iaff8dpB4h_2UyFISdLX1V5iQupEumdf7s_27kTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t6EB6lR3vaCNOMozWjnxDgZZTLYjDMVCmCEGX0BD5ug&oe=69FB54FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrqtWSidtu4Q7kNvwENm4af&_nc_oc=AdpLO_PV_d4HIH49H6n_jV9IoqaYFje5jyq843kvSRqE6ALcYFvtxhA7zbqxsWVOWs0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kBcktg6E4Wi9t4vdn-YcfJHL0_6hDlPvcF7XeqiIckw&oe=69FB2811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkKfBEykuZQQ7kNvwHA5rXC&_nc_oc=AdowUdkaCDrqP26l6QnJvChofZ2qh8PArfspH1PfsWmie3IJKYNN6FXRBHds7y0863c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C1NKjGHGGuXmiI51Ks1vhtGL59GcQBjX2glYgt_ffsA&oe=69FB50A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
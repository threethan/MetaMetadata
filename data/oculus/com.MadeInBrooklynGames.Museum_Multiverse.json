_ohc=R1JwhZbGsNcQ7kNvwHDGCeR&_nc_oc=AdrLdsjMkCw7M8iiJyvA_SU8WmfCCrSRY0MdafWRjrYI2x2qI_Dx-pnAopp-a9qP3ak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EXsxLfdhZgl5wXV2XDatEkGmvIE28JB1MlWh_jqcpJQ&oe=69EA0D7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObEGeY_eW4YQ7kNvwGk__bM&_nc_oc=AdpkYYCt-GQJc7aw7t8Sto4uNW7YbFsuvoO7Z2R_DhuGKSve9_9bRQPPcVR4FmYtgb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YPWNyOdpo4JEzY1pbGQrmHkyinXlAcrwUbRHdOKcGZQ&oe=69EA2DBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SR8zaxZGXigQ7kNvwF9h7m5&_nc_oc=AdpdaV1ACjUsO8JYrJTJEqXgA5UoL8yqtqSEh6gvzo-g5sb9Q2aWtn5BDnwBwSv4cp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zNwVgy9NIXJltL68DSp2FDNVaNDhaZDyZStfSiJtrew&oe=69EA317E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zylwo0MrCtcQ7kNvwHJ65Mp&_nc_oc=AdrAhbiHu380U9rK5oUamu7-iE9Vbs-leyCpKJbIlfyGtdh9THgAccZtPIRINBg9Amg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h51kwV7AAspRwxn-U5DUCq13xMDnbu7wur9RriACsUg&oe=69EA0491"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZ9nJW1gSewQ7kNvwE0yrLO&_nc_oc=AdrT-6s2zqy5dAiSr0gyGhbP402oFCkGL6J9MiTBHkc98xMPXon5a_5-rukmMa9k3C8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af268GgoypFJNTnMUZGZ6xcWMflVBriDE3pgENzs2s9NjQ&oe=69EA2D28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
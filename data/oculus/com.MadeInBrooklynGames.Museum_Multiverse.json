c_ohc=Uq95ukmRxyYQ7kNvwGElCSt&_nc_oc=Adrl6Cc7BorPcoVTPQ0TCQhWtIOGcxjv3FM-nKLN0LH-twgCV6hb5VMsRKKEmKwbwEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNFAZ9bqMmLQxMZnWa66Ft_dW68_ZOIs4kIWdZtnqw5Q&oe=6A60B47B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gb2yzsPTWgQ7kNvwGUh4Rf&_nc_oc=AdoUpzSBC7mG2wjsbGY5ky9l78Ei3KY-YKv-FjJMn09r0bgUC4ouj1hFHobldkG-LfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKWbLW3itn2lCJvg1NQqmAq3EA4UXpcI_YV81vhAKZVg&oe=6A60D4BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSp3-ys131EQ7kNvwE0vdU5&_nc_oc=Adr0L1a-nnQ-GSvn3rLkxJf6NZweweClDobQl8zRn0tADHHKzntf3kNEBotSpZT5TPs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT5fmmMsG6l4XMOWyTF4ghkXBiucp5Z1YUuXYySNgUDw&oe=6A60D87E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUhSlxB70ZQQ7kNvwFEhvty&_nc_oc=AdrFysgUCQityxgjsjE0VyNMROL4JMZnFPM2ZB3GLiKWS7ll9K-8LNsAMgYFk-iFals&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAarFRXEW9Sw3uSDfnco0uVJYRVRcjEwiz4rZcZmkez8g&oe=6A60AB91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPr-T58hiY4Q7kNvwGTsSyx&_nc_oc=AdokXb0Q6cRR9mZI4_srGw_PXjduqikCY9ulrzUjY9udW5U2b9wbZVJ5dG1b_YzXPUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwuOBsxkm2V_lZ0V-oEQrfgp0jGLY38Y1lrTW7ZLs2fQ&oe=6A60D428"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
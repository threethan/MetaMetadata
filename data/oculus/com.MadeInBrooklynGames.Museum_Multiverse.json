c_ohc=cFVpxB4pyusQ7kNvwEvQshL&_nc_oc=AdrnQcUA2CdYlTSZuLlfr8lCCyfeDCwveBsQVOIANwTLEL-qSrjQDt4SbM7X9-07x-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjxwWR-_uz9EGZF1z8iRNK7pFPM_RHuQigURrQOpBTBw&oe=6AC12A3B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wx8runhvRSoQ7kNvwE8wd6J&_nc_oc=AdrWmQ7n0DAEZxP2yD5Itkzwws1Cjxmz16xvMYa1_bhghB_PamMkFpfmuciAY_ViX_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc2M0GR0sfkBboCBlhhkryLBHqgshF6KxavwA2HOLHrQ&oe=6AC1123A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnpwucNLTG0Q7kNvwFz5uu5&_nc_oc=AdoiuX9o-BwjhO8OGVQDa39UxtkQqY-_8PMIuaXI453M4LrI4qoVtD9y_ae0UoQSHYM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8Y7buUaevIP92mwY_pROqXjm2PCEvvyYqX4m1w7scGA&oe=6AC115FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3A3CZOyHKQAQ7kNvwGIeEqs&_nc_oc=AdoujjGr2Z0-mOuTSiNEWavpY-x-KLqUpAIOIgPXgxNIXIar2BDxOkeLZ_ajVC731EQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWNMzvs3SKGeEhrnEINehw5k1U4znkBNOZ0mHR6U-ilA&oe=6AC12151"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVFK5d0BZ40Q7kNvwFmGAap&_nc_oc=Adp3_roCPfMpZPOZVZmabKSujKjnz3_s8SckbhvoSbN3Nl80BoBJ5PhO4zCqg_-O9X0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJjYDVujUD0JNPy3KQnDF7lZnbQ6eltf5TDKOgJrxD7g&oe=6AC111A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
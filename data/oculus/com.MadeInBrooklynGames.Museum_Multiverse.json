_ohc=ThBjKiS7yk4Q7kNvwH8CeHy&_nc_oc=Adpocb2CLOzmzATgK8gjslJ7nTqPB-OsRjyThqlox61iG6bfddXg050I0mQfsTGYDEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nVcFdloFoYgB6C4D35PZK2TTZLELb_tF1E1om0rRuWA&oe=6A2ED3BB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WhUFNmChwAQ7kNvwHDEnb_&_nc_oc=Ado0jqbi7aOW4CtpE-7qaxHlYxBiMJBodqfjkGMqdtJEBg-Fj3hti8weslJ74EpINUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Yd48e59eIbsatQEyUMUStNttKna8F1aVwaV35lkp8Bg&oe=6A2EBBBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAxuRqelGuAQ7kNvwEw7Y8k&_nc_oc=AdrBHonXxx1i8ugqdlMciB6yqTRNTEi4bf1JzJZUBM1H5DKo8odEBjXnXnhfIgdPMxs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AnJXPb3NdluKOOmfO1IYJW-67kYEZrTsCQdbhxYNOPA&oe=6A2EBF7E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksr_ubCGWlEQ7kNvwE-c8ri&_nc_oc=AdpYJtEZTLfNx8ehRSrURdCoLD_ubyn6ddzXpoG2jfyei8fssIq9d7mKdytFVhy-WRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YwGUb2cB7ykVYqfXlPep3HHbJm9unS-EdrMwjiwg8wQ&oe=6A2ECAD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fijgeLWjQN8Q7kNvwE4HIPl&_nc_oc=AdqDFrLlZ2iIK9GZLI7OeMChaMQNhiy7rA3zOD0Uvc0HpaTcMIMQD1qWqONU-_E9Zl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KDEZe_6k_Kjs9hIRt06KJBiLzrHo7xYlg-ilwWL_Cvw&oe=6A2EBB28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
_ohc=SEEqiVT34CIQ7kNvwFBWDii&_nc_oc=Adq_t-oKFUFEyqfTTcSBi1J8XP3USBBuwjQUK6WZ73E7hB2XYCIuWcqLNvw2c-OV3CE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vcLDYvIsRUM8wncAwWgbWbXV-3g8pKzjlBu1d3qSzKw&oe=6A1048FB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5kVjSwDwQcQ7kNvwHudlGJ&_nc_oc=Ado3qoY4FMLeNW1vuwTjuxTtYp7TmgrZyhT7AKxnDzZYbsJyhfEITspSqC9aWG3bGVg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af738Ph_RdxtcvteYVrln5dRcQ5ZlqiWaDzlZ-hAiaAqLA&oe=6A10693A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YTGPravAvsQ7kNvwGGeFCU&_nc_oc=AdrpK1zIRlDIFch0Xk0Bf7G8dyhdO7IsoAhohQFs-Jet5xgA9Lltq0tLSQ9prwLB8lw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fuO0zIhxJNZVr1aFM8MKeaw_JmXIMx4rC6KJJG73Ymw&oe=6A106CFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu1gM2vycJoQ7kNvwFJZo49&_nc_oc=AdqS0oRe8Gsz4GvX_zNuw3fOEcg8jlDno0xS6YGKx3bOE2hXhGn7zohwE7M8fOv2STE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OTAxzI7gqDIxgdzY_YHXflz3vweYI1UxMTziMD05dyw&oe=6A107851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rO0rTpdlxIQ7kNvwGZEPzX&_nc_oc=Ado_fe48-Dh_JAII8oosXwjtoXvdBvNP3_wnoWzjkIsNtS7tKfPGklgcGxN-wQiZY-s&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40GePgKhVA1tvxx1NnZvtDpELKK25v-UqlTO7VClWelg&oe=6A1068A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
c_ohc=NJjSM29tALIQ7kNvwFzZivj&_nc_oc=AdqcVqLxqxyomimzT-e0BqgNeM8Lzv3tVlBj8-kty6SbrMb2R6JOotB81iKQDA6MAFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu9JfAMEE-X4MyrPQYxfpbvZxg_A1d3I6gIg9vuINppg&oe=6A511ABB"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okhJ7jGCIjIQ7kNvwHAPOzp&_nc_oc=AdqEWmaL7PgWT4lWi-8V3yxyb3MdgPWPO2kMtEBIfTlQU5utCfJh_PTDsVTINwyuOSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHwKWSmbdQ3-aAQBMqgsktoAIvBX6TxBaRdhgKl50fVw&oe=6A5102BA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WtZYk-c0vYQ7kNvwEYHubV&_nc_oc=Adru2nzTeVveyx9TmtHSTRP1upyVBM6HFOi0eURFJqsEC9_yxS0C_B5MHYYlKHuuRI4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8Hq8BG2YnZVHryOlrCTGYyfjh6AXunjJxJZ7fyUJtfA&oe=6A51067E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_-75vrdPd4Q7kNvwGAjv7a&_nc_oc=AdpRkEgjVWtTq98RDrpZw-ru-mTQUCUz1jCOMBHYSUiIrqFZ_kZ9P6o9iIgWlUcs7_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUCD--ZRgP23alDRYe-wngV2guMSRllgNqPadNtZh7Jw&oe=6A5111D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpX5Fl486qoQ7kNvwGT84fc&_nc_oc=Ado7KOEO9FlDsN9YqXU5r_HtyEH9ee_oaqPymejRSeHTaVmIencdpyslUN4OIvvbHIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-V8KvEM_CuDYIwYLXFSqMfVopuyVnNFqD1xWmiw8nDg&oe=6A510228"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_se
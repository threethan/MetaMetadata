_ohc=hY8itnh9Qf8Q7kNvwEOTfs0&_nc_oc=AdqKXISerscU37I0iKGrCgZYYtxyKEStiftpm0cT9onMNSMBAZ2nwvqDLLzjjMhWNik&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yzECk_ovzQrpspTwEyhIbwADB5Hi9qZEcvBDg50xfrw&oe=69DCDE7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQWk_ccHM08Q7kNvwH89gGH&_nc_oc=AdqjgR8DCs0CFP5XPEw2igc6ce192lMUN4KGUkSmSB0o-GnOLFYI-TYnwVZsjg4ZMjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dfrhgBW233NXa9Q8QwSAfKD407lssjqVzkzf1eXcNgg&oe=69DCFEBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIMpLrYSZ04Q7kNvwGRdsxp&_nc_oc=Adrhv9mntCiFMeG92JqOMO8WtLFytNKOJ9NqzamcldxxJMF3GU_B3XlJYkkoAfw0S-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AZ-KlMb0NyU1qkRMPTbAZupz2E811t79WVrSWEUqfSQ&oe=69DD027E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHxq358Q5DgQ7kNvwHHS9l8&_nc_oc=AdqfUGMgQMiOczrsvYTxaSlBFGr4_jQBprSt8cORb4Sl7j9uYdGyMjQsw4PL9QfHuNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MYUVjtEcB-6Uejzmd-gQKhr5gQbo2y6OM3RglHPukaA&oe=69DCD591"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI7409rUn_4Q7kNvwHW_cZi&_nc_oc=AdrNkTDn2jQmY7k1CVdfEKzg96tIRZf2au2bHuCuzu4oxXS6JrzKG2SysO6lZe760Pg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35jQwH6U2mEY4TW5VsaAtZyaHcCHUTSJCcwnqy7c_gBw&oe=69DCFE28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
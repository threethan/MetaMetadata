_ohc=OQbOT-aYPqgQ7kNvwFQIRRP&_nc_oc=AdpYmjC0Z7IPVB_KJd5Hb7wLm2qsC6g50RHuoPkdAVyKEy1tb6_87J1QXYVLekyimqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ywrAV4paSmmu4pHIC-DF4YQjsxMgmIzxsM6nPZ_djVw&oe=6A283C3B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9x1HQCyrFkQ7kNvwGsFcho&_nc_oc=Ado7FHgiYKT_HJAL8-A4VhsyATlmBY8hGhVWOic0fWt01zQxFezbrCZeGWHHp04ZV1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YswjnCDFQahL-PMXyMlZaDXBMUy9emla_StlbNrpq1w&oe=6A28243A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b238Nht1CakQ7kNvwGgc_BW&_nc_oc=Adq1J7nEpqBW7Ch7tYElJdKAqoZftRGw-ekoJBZ4wtamABAOUd92SuXRWqfRzZHLVRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Lmhj_ADIxc4LSzsosgMr8BF1Zhpnm_Rc5n4-IEG-98A&oe=6A2827FE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM9jGH8lKbUQ7kNvwERNpB2&_nc_oc=AdpPJB948RFcTSJFn46xrai9lH-lH9EP-DsSaw7ezFxolVmED05BhcxuSIA7tTQlqSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lz66QjMv2rArN6Y6KiC5_u97fZqgcouUUQ2jbnI63Pw&oe=6A283351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAsJXBOlG1QQ7kNvwHxUKNN&_nc_oc=Adr35AHEgBgSlkbWhaeIHniftotGljiecNVVcyPA9ab4eTziDeIM3uLe-wwZswFmk8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95H62Tr7k8iDXwss0UyRolC05sWtk7CoFWoEwVNm_qXQ&oe=6A2823A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
_ohc=sKSlDOGeyx4Q7kNvwGEYlMJ&_nc_oc=AdqPRLoSuUcUmFrA5RqdhZnDi6R9447wk392aPF9R21t15YPCpAG2WHiYP1MLhYYJzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Z8EewfU1THeyCq7054eau77GDf9E0xZjGCNGnkwn_4A&oe=69F73C7B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqcXDoh6F_oQ7kNvwFZl2pZ&_nc_oc=Adq42bl9Hzf1VbfFsSdBoh3InckMYca8iaJ__s-Ls39E0g16pW-wo5blZvyU7vOrVMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af254xFXzP2xuDmshCNP-RFWEh89DolLQFgFKcFSjnNwAg&oe=69F75CBA"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz1A_ek3Zl4Q7kNvwEiQ8sj&_nc_oc=AdogZY9UT3H5jtWzQ357ckmLwUKPKEoNgMkt35GX5-gBvunZ67NYZDxBNBtWy0iDzLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ltwxk6IgD444hknAO-nVN8K_yYkBjTKq_aeDaaFFCRA&oe=69F7607E"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tELw7wkcH8oQ7kNvwHKvmB2&_nc_oc=AdrBIM5cEvAma_yJz2FMCoiln2WkifirurlQkothwFrEMzuBxDFwzq0FX6qMlpDAtuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KgcOORBnxJ8KVXjwgIhMI_Ho1edIj_UnKBCSItnH-wA&oe=69F76BD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaWY4hNRKcIQ7kNvwE7y7cF&_nc_oc=AdrAd6hnaDNonES6aa5WutMLQ2Xi3DMxxfQxk82cCSjiF0O2InRyV3nHGvRDKKJqoYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uYahMnxwLqs4D89zdn74JOOZZAqyaCAn74uDUWSo6YA&oe=69F75C28"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
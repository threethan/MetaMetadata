_ohc=6iRcHZ6bXsUQ7kNvwH9JNCt&_nc_oc=AdrARwINp8Ob-Hq-cKe3ODOi9_h_LhsPoN7zN_NhXNhtrEaXFJqaTxoLNQNjXnKu3WI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K-w2cWXJp6qzN-b7Yo4Xverczx9gW1O5oKOjW2MGM5A&oe=6A3AB13B"}, {"file_name": "75326676_643183119870447_7318185343906217984_n.png", "id": "2936187699950313", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974453_2936187703283646_4858805332537252739_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYPUvWogAZsQ7kNvwHLxFx7&_nc_oc=Adr019pswMr4VcGx368igSQpzviynMlK-k7ZrnSOHe0LJTHUGpOLL9nfHj92lZyoxcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fvs2Py5wW7VSjQW5HM6EGpssi0Y-TQhfEBHNL6SxrBQ&oe=6A3A993A"}, {"file_name": "75458101_235144031050159_9138158176305152000_n.png", "id": "2765105677076898", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974787_2765105680410231_1319133523284794635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xQQj94wbw0Q7kNvwEHZCgf&_nc_oc=AdpNNrLbSTFM-fIVxf9Ur9fcS3Bgfau1mP4Y5iPw9-3Smdo5quIKXCOxemcJO4mB2pc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eQxXWx49-vbPWI1xYstRRGD60uR5qss_wb_CCfG-pfA&oe=6A3A9CFE"}, {"file_name": "86629765_541915033140261_2763858471982989312_n.png", "id": "448269259499222", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974557_448269262832555_8772329290928550279_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1al_rbAWJRQQ7kNvwFVHTdt&_nc_oc=Adq7VHQQqySDFXpWv7m40BZydxQ3g-bl9c5dZpV2cgzM-rBSMDJ2r5hrHlR5kDjaciQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-19nVbyoPvLYMxDiFHmUahMI6Exaba857aXc70D4jMHA&oe=6A3AA851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75203613_1476526155861994_2849741046055698432_n (1).png", "id": "828778024522260", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974917_828778027855593_7321425277857207517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcIJmfDAJr8Q7kNvwGutyuf&_nc_oc=Adp3E855Pxv7SCTvBGATYOkV_yhhffBWxPhQkEiTwZ6OUWRDu872p7wQAYWqGWiUs_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7eeOCtSVfhazfBJ2P4NzCLgvnU5ewChul4jWCwOqJyA&oe=6A3A98A8"}, "display_name": "Museum Multiverse", "keywords": ["adventure", "platforming", "art", "multiverse", "hessvacio"], "long_description": "# Welcome to the Wonderful Wondrous World of Museum Multiverse\n\nMuseum Multiverse is a multidimensional puzzle platformer that chronicles the adventures of a child who has mysteriously awoken in an abandoned museum. To escape, he must journey deeper into its cursed halls and traverse the extraordinary worlds hidden within its art pieces.\n\n# Journey Beyond the Canvas\n{1136025298615521}\n\n\n\nEach painting leads to a strange new realm filled with platforming challenges, mystery, and discovery. As the adventure unfolds, every frame may reveal a new path, a hidden secret, or another piece of the museum\u2019s haunting mystery.\n\n# A Family-Friendly VR Adventure\n{917286157940650}\n\nFrom eerie corridors to surreal worlds beyond the canvas, Museum Multiverse blends atmosphere, story, and exploration into a family-friendly adventure designed to spark curiosity and wonder.\n\n# What Awaits You\n{1455418759286833}\n\n- Immersive VR platforming\n- A mysterious museum setting\n- Worlds hidden inside works of art\n- Family-friendly adventure and exploration\n\n**Step into the museum and discover what lies beyond the canvas.**\n\n{1972131163728335}\n\n", "short_description": "The Webby-Nominated Museum Multiverse is a multidimensional virtual reality platformer. This multi-perspective experience chronicles the adventures of a child who has mysteriously awakened in an abandoned museum. He must traverse the various worlds that exist within the art pieces within the depths of the cursed museum to find a way to escape."}]}, "developer_name": "Hessvacio", "developer_privacy_policy_url": "https://hessvacio.com/pages/privacypolicymmmeta.html", "developer_terms_of_ser
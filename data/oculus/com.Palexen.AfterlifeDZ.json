07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBR-LiH-V2oQ7kNvwG3rg-c&_nc_oc=Adr0xOfcyqdq1ntjC4jxuxcS6yBp3TMf302_i3ALETVxz2M0jVdoXB4Gfc8ygVQmYTo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2ZxJnEALcPVOhrQY5Er7eHgrmSoRRIka8KmR-Z2EPNw&oe=6AA01942"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-0FpwL9HfoQ7kNvwEfV3ou&_nc_oc=AdpYeHIIbMCcowOio7lbjcO0X-mwqJ4nbcczsCOVnpWVnCGbIb0i6VPb5a-3PZQeHew&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFaZNJJ-5BpYhc44nsWYCPvlu4Ntaq5Gl14DZzPQBxSg&oe=6AA00EBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6nf7kLztzkQ7kNvwF_TC4w&_nc_oc=AdptjlgO034bgW6dYVZi4-Jxn7PdSA18eGLzlT4P3ON8FMW64rdcT3o5M6EOqvmtwQU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoxNorsERad74hkGd3r88fBZ8XqcAnBUMB4sQZYV22cA&oe=6AA01DB0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
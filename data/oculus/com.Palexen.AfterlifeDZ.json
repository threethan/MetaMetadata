07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBR-LiH-V2oQ7kNvwFN3j10&_nc_oc=AdrGrSU8f2JSByoqKeDLB_MZB-oRzoVqLiaofbGg0hs01GtGXuI6XUxM_hr0_s2Iysk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc2AByDkGOpgkrkzTqQhVrYpD5soGmWSwp0wfiare9Og&oe=6AA2BC42"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-0FpwL9HfoQ7kNvwEMTCix&_nc_oc=AdqLb7yIt3hir3o6YLqy6OpiDmGq77wD93eYtcQ8PDtUwnjRYDj1SzGyPA2SA6Cldps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIoq9K6dN6GvDbvC4bSIqqGXDao7xJO73R1yExLJrpyA&oe=6AA2B1BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ONnjk3qtrsQ7kNvwGHCgbd&_nc_oc=AdprVW-bgcnyRStH-P5DsFyhOX8DGYRW1j9Mld6Ee6mc09dhfOiqy14grT35l1DKVL8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGWMi1qN0C7sh6rDozkOIkWLu04361I_wnsB2koXvh7Q&oe=6AA2C0B0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
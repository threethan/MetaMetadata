drVi7Wzuhca_FP2sldBmUvIoAIZbNvKJUBk-fTI9aSxki1oTQMag66_4hNa09Meyew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxOo9vg3mWen_u8LMzc0sht32wFMlE_Vqpw_dQ6XUuYA&oe=6B03287D"}, {"file_name": "ss2.png", "id": "1351545359881313", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830007_1351545363214646_5506338495222860567_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTeE9PTPDcsQ7kNvwFxD52G&_nc_oc=Adqm5WhDJhJWoKWK5wCgcQaajo0PzH6xcXTMW0gznEs2N6tbog4BD8-bNWyQTXgIUks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnMdULjdY11EyEX2qpi7_LYMEIV3nSzj0QrNrQqr-kNA&oe=6B033202"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4Hd_X_Wg2cQ7kNvwH6wYlE&_nc_oc=AdqruaOp1161iwAKEpem6vkfHXghex6OInZK1awC17MM38QCqweV8IsJri6HQyK_w5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRRh6sjrfuhdQePG5Qui2ML26gQjO5jeSmab8g675J4w&oe=6B03277F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vfIwVunfPUQ7kNvwFW04MF&_nc_oc=AdpTUk-oLBUSslxCHllFJN7v4Hpa07JK4XyEJmDiNE3jYh8x86xvbNRwidpnxc1oOlE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGVK2nJJ22NI87s-oysdsdKeb1eEhoIf1RHw8uMsPfMg&oe=6B033670"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26903693622592727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619078_1117014583683643_4854873415764933024_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=
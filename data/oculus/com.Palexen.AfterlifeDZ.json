07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siqaFr5Ys2cQ7kNvwEUh64a&_nc_oc=AdpI7vfnUgjnOXHIVlJe2UVBuS6uckpOUrhEjHHMnEgjhsYNTTCzZFtkcaQl6pb7674&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj901P0Fhkn-6JbFLGaWe5y2XgLohZyHC9CfDUBTNr7g&oe=6A7B2F42"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bx3mP2dBYb4Q7kNvwEX2Llg&_nc_oc=Ado506f4dg5wD5W_DDBTUoBGQa_sr9bsj7NUUCeP7226HwMTg4EQ3wTENqpgHxi5y20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtG2Z8JyX_LSMaCuSkMMbqG4XaN3wCeHucimyWIr4PJQ&oe=6A7B24BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HicQxZAfnV8Q7kNvwF5xxkH&_nc_oc=AdpeH5Q7t3VkrYeDiDECDSboO6Iu04awJHKv39wv0xI7WSnVxXWySWKUnaVQQD5mz4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAPaHOR-4HgWCPhOvFgsFtq1hjVjIQHClpfZjW-D8wpg&oe=6A7B33B0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siqaFr5Ys2cQ7kNvwElKBj6&_nc_oc=AdoXIhMIGTHhAZq7YR95LIKrNkvfACkn4VTprxE-GZsuKqz3UgFDYQEHzuWus6BroTE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQI_fYVmKlAYggj2EfoeJm_Gg5KFBBYGIrzJy7p6SX0g&oe=6A79DDC2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bx3mP2dBYb4Q7kNvwFoa3db&_nc_oc=AdotY13PFn4hXvs3YrVkd9WM4a6lKP7WHjuPBCKV8anDO_9bpcctK7nMZxJLTWTvTbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP677wFTXeiIYMuQLrxYp0DgVT4dxCPFnyYWLXrF2bCw&oe=6A79D33F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HicQxZAfnV8Q7kNvwH4FW-j&_nc_oc=AdoXaPcFNPjVl3jdH8pcjZL1QrgCsZrgr7dQjqUvwbcXm5ZleJzBHSkhrzeggaO-sOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYEb8MWNYaL2NDWN_mHfj1Vvs8fqVx08HONaiqHhmsow&oe=6A79E230"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
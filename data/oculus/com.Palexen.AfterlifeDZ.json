07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUXf-IktPloQ7kNvwEErvjR&_nc_oc=AdrG_sNGy0-H0Byj_TICCYmDqKvpflpclZNLdoUROh4SPphzA2fi3tetvjO7n3d0jcc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETRNR8WzxOTxCnbNogg8sTo3ImUsqhF5TnQgGHqgGNcg&oe=6A734642"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7_gF7SY2A8Q7kNvwFXp044&_nc_oc=Adqa9tsNHysQkCXkEQfNfcHNu8rELTCxv1FUtk-q2hKlI3Fje7R2YtdwJ9n2KT2h1FA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6dZHr9i4HTvoDmAPwuZbgYl4zFKMrVfIy3dk0qcjWDA&oe=6A733BBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH-uCFdPguIQ7kNvwGUsiv5&_nc_oc=AdrNBvcT_uoYpDGB46qTd7lWwP7jcFiK22rNfvTm_WlWWOe5uDX8v7n4UD6Uu9Oy0d4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAzD6cyIfLgg8KXMo_DgwTMNLS25o0PHdD8BeFkPr8YQ&oe=6A734AB0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26903693622592727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1117014583683643_4854873415764933024_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9hX6c9Ki20Q7kNvwHkp8BS&_nc_oc=AdplFyrS47nh8oMeTuP2HmyWXRMnPz-87diUJdUYfyBmq3gnwu7QupIqyjSJ0lIHkio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOwXhFNs7X_fcWkAmRW8mFFJcIw9OFpERM9haZ9ueCNA&oe=6A733D64"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Afterlife: Dead Zone", "platform": "ANDROID_6DOF", "context_category": {"con
n.com&oh=00_Afucc3MLTjRuCK-gmPbRGtxIXia596T1NR5u0EzUEgY3hg&oe=69A43635"}, {"file_name": "ss3.png", "id": "787759186988720", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827063_787759190322053_7565656109419328074_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhgKEEo4GScQ7kNvwFldJjG&_nc_oc=AdnV4D1SVh24BkrYLEdImPDhFksNoBwx2Dv4wcpON5SxhPPkimoZG1eBc3Y_ycnykWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftj3WMPR1qZ7s3ay1Kq8H-pK_u4-bcAMi_7crNahf-6mQ&oe=69A4476C"}, {"file_name": "ss4.png", "id": "1458178655420874", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308575_1458178658754207_758593228196483475_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BwZ-MiDOHUQ7kNvwG8YUMQ&_nc_oc=Adm9jWjgMlTRYP1CaYdx13euMzkwq-URaDu2_u38EASbkcDZmGXgnZ1jHcN9Fwe_tVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsunF5XAXDwjQ-UncLXZzlB63ARWi0CeDE27wdsbTGPtQ&oe=69A4413D"}, {"file_name": "ss2.png", "id": "1351545359881313", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830007_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv_5qx-RwNsQ7kNvwGi1qSq&_nc_oc=AdmlToEnYHpOHoImq4D4YMvKEzps3hN2iEJ2g0ml3hYnCChYKLThkbZxTv-cXA9NZLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsJIDG5vyLVs0rHuKN3ANJAY2Y5W061UvFmfVX9FEEw5w&oe=69A44AC2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12L02KQ-57gQ7kNvwFYamA2&_nc_oc=AdkUW24W5SMyLnYl4hcpk-_7VZKWTfl9jr7Fx213w8uPXAAmSLOwUyyYsI6rd-wh5hI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvgQSpPzpawISTxmlGBj_vxx06Op3FKorx48XI3u1oYNw&oe=69A4403F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24354133657548749"}}]}, "scheduled_offers": {"count": 4, "nodes
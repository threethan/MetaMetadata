WIZ8FzfQ&oe=6AFB4902"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLsbAcnsbvwQ7kNvwGhMWW-&_nc_oc=AdpwLHiDbFXzMBFHhMonHRIbz7tX3sSTTNy5EmdGGDGfMOY7EHDRRCUp4_-JLeUketE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStB2mA-Z3lJ_KYurAhXQaf0nQUfnqhKySz1gM8qWANbQ&oe=6AFB3E7F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "co
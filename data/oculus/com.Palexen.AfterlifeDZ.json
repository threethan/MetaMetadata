07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBR-LiH-V2oQ7kNvwHJyfbf&_nc_oc=AdrUw1o85hhRwZUUr58gtVIy_yGmpngCCXPCmt36Ba2-34Dt2Seo8tFT8SLKpKUEMGM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_kkGNKvVjyYT1ttnXWhCUvHjYs-HZ8JQX27ouMV9xGQ&oe=6AA16AC2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-0FpwL9HfoQ7kNvwGDmjvq&_nc_oc=AdpxyyInbSVJoUyd8e2tVYWSYlPbNBlBrcR8Dyb5NoQK84lAIfZHSsSHr6t1dIp-VRI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz5lBt5C-8Zy5mEn5Y0xfmfVXj78FPqSiuBJPqbBACNQ&oe=6AA1603F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ONnjk3qtrsQ7kNvwFJM06R&_nc_oc=AdpHCtKR2asY_XVc23OEFmhJi_ITe1ABK-Pu8rbLpZ0SqGXQNkh2EQd6B-Qdez_8Q7k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxbUCbF_XwTpyUbwR3S4D1YTMl3c7iB8uolFX0OD_l2Q&oe=6AA16F30"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
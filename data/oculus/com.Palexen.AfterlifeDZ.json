07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc1bQpibjk0Q7kNvwGUXPYw&_nc_oc=Adp5t694Q-fADoxLp2gZF27jQA29KoOB-nuHPLodkP0DSiGvzsFntoqTZ_3dH228eIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIqdehw66ajut9oXdFbvON8B3zwKjFSqPMjLNi1px-Jg&oe=6A986882"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ap8GFDjbRdkQ7kNvwHY-PRp&_nc_oc=AdrHZfs2Ue8bpEYae-LU6dJmZ6xUv3E1sj-DrtWcaML5L7-BpM9MEIub3-Jvbke582w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJze3_cgk6Ns_LpxD895NC37imStFzJjNxTQAgorXDePw&oe=6A985DFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gXs1hgAPrYQ7kNvwHd06Rx&_nc_oc=Adpo5opLhFlJczOFFQvWy6n8MUGjYXTmklJiaFFuN369gmTXpcoK1KOi2QobpR-xjGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKchVVakgTmB6khRoa2GOlKVdIybeCgPAsvNuqRzKnDw&oe=6A9834B0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C24MHgl_rpsQ7kNvwFFFBoq&_nc_oc=Adp0QSsJnrBK6L2fWoQ9P2Da4vNHBAGp5mZuZF4y5TxwsWLZYs5kO9_xWuARvwvs_P8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScqajmpfhAsbTTv4KmvpN-TFuXomV05SVNCLPH6RG1Sw&oe=6AF5CAC2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1XjwOCTiAsQ7kNvwGjHr83&_nc_oc=Adpo571P5zYaPjcJRJMAkVRoe50F8eTFNpKcopZmqtqnTv7hLA85mHcudO8olXrqDtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHLzGZ8DKVdSrsSTB4X-BQaubII2FdsVJc2H6A9rBCJQ&oe=6AF5C03F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHb4XZedW3IQ7kNvwFB6slV&_nc_oc=AdqHzMPz378RJV4t6LHCVrcFGb-J28j-cCoJ37PH4lI2SBdNSehrddjn8lvckOXofUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6gVtSqoME-nk_ymvYE_sBjbEAlL0WG0C-6cs2AwAsPA&oe=6AF5CF30"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
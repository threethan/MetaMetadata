dr5YsHPxZj8a6gENnjl0Wpd8cm7LE78Ma4Ixsl5kUOqqmpr3NZUFWPj5xmQmZILv-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUY1FWSNtLi65WniOp1wAnKFGupCTr88p-NHXUCsiOuKA&oe=6B0F05FD"}, {"file_name": "ss2.png", "id": "1351545359881313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830007_1351545363214646_5506338495222860567_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJMHvtxEDRUQ7kNvwEIUI6Y&_nc_oc=AdpCAl5xcQFyheWEMAySuGszKiQy9xOOh-ctDFgBltPLqzbyJx5rKMav2FQJgWuDm34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWC8PcsT44vJ8lIQSXMBguplRU8YOiAmKIvnx7dje8T1w&oe=6B0F0F82"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KocwD1c03qAQ7kNvwEAFVIf&_nc_oc=AdrlXIRIDkmQ2KJlRIFDBjRXajIKLhtjc1psOnb4wdNH0cXwOYmrYe5Y_PBqbFEYwAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWByJ4QE-yrtsHPHlSBOWBfrveULKB_pTKWAQRn0UgKrw&oe=6B0F04FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4a1jqm2QYOUQ7kNvwG4CEK4&_nc_oc=AdrnX5SP6TsZUREp59v68slkU7x8xHIjMOdX-Xd1yS2Ej3uAAqsmxnimqPMElJKGvR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVabZsY1WgGx4qqvMN4abnzK-bMbCUbd2w_d74giWj1Ww&oe=6B0F13F0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.palexen.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://www.palexen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26903693622592727"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619078_1117014583683643_4854873415764933024_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=
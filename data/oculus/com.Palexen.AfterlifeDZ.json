07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Um-5i7pLTcQ7kNvwHKdzuv&_nc_oc=AdqoOxccISBkyfiX86sVAWn4mgheICwAE2Tmqp7kRjLC1xulC-OfzJvL8yZikbgEpoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI57ADm7OLaKmHoZGXIWjIM6sZJJdtWJhXZXOEKF280xA&oe=6AB13CC2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGp3GYuiztwQ7kNvwH8oVGC&_nc_oc=Adqzt4U0PWfiHZXznSm7k5J0GvyoPsgU30cNJ6LYUeV0E2O8kZO2LZHxI3vIVLfQ_iM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNCZGXK4SoVqCzPhgGsIjNbLh2qiWBljlnyNIQ3vZMvw&oe=6AB1323F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhAZkWRYeE0Q7kNvwGXNzLz&_nc_oc=Adp3zka8PHkrv99j4sjsEHiTrW2mpp2S23Mj4XaqtOMnm2f0bfnL2PStcuh6JUUvsNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7pAseCBrs1cbWrE7A-caoZ2b71L989Uo73xFVv8qNiA&oe=6AB14130"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
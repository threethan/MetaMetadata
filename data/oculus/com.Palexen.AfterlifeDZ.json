07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGxPYC3cnbsQ7kNvwFbRqgf&_nc_oc=AdoB8PlZcpLUJ4kKU3KOfjX2ETgNYFgDJb1BNJAB3wvuyIaJhfiYr6amCQ6zYexILfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM2Ckoa892Nr7pu4q1lD7MNGatcglYiKl7--TbXqMK_w&oe=6AC654C2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8EUk3Uy6n4Q7kNvwGt6V-g&_nc_oc=AdoxlRObyJVZgeQjvW482pbY3fXm9mNuL3LK4OpKh_1Btj61Vg86Gcn13myDYNjkWa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIe5hZrxJBXMoIgKjLuCrlG8YDjL7aivpmh6ikL0EHDg&oe=6AC64A3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svBfcL2PsEcQ7kNvwF8IPvN&_nc_oc=AdoaspAvWVxeqFUmDOqRKo5-aDd7kqBDlkBq6v3RcRf_kFnabPISSz-4xDqeYrAzuJE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4tlTYjrAJX3235TKVgU8dUK4RVIjs_MS6cjQ5AD-2Cw&oe=6AC65930"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
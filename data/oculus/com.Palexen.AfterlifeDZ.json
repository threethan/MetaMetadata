9T3Oz4bhRIOrGHJ3RLQId2GI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fa0PqvhlqpGSBv1umk8eIQvF0H5hvUZWiJY3Wt-V8tw&oe=6A105C3D"}, {"file_name": "ss2.png", "id": "1351545359881313", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491830007_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNPI1wrCfDoQ7kNvwFxN3tz&_nc_oc=AdoBp982gMSzTyG7O8STr_oAfHnOUiXR1jOsbZ1lIkAyO33MS8ngdw_Qy0s81cp3p3k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WwrjWiS8ClFplDetCqURsa3Oyf91FJhj7GxN_XJ3NoQ&oe=6A1065C2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PU0V-2zpvMQ7kNvwG0ajYP&_nc_oc=AdoVGVmOoOFkRK-5XGlLYXvLFNFBP7HiAelhqYnXor1HFESGtwo5Zaf0DeoCqE1aPj0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ReZfqjSJ9sloxvVAt34-O8Jk36J3thOWdbAH2UXNYXg&oe=6A105B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QG3L3FLWsAQ7kNvwHBorzr&_nc_oc=AdopAO1sWBEqwqdbl0YncC_FL04m1iIPWsVgrv1zh86XHxA9gsMmDlOT9_Z8-DMDIGY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OZxX7MiP5uk7s_9aS5jTG6q_lL-nR_CRXJyXeiHKp7w&oe=6A106A30"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26190646163897480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619078_1117014583683643_4854873415764933024_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqSrryMmUlEQ7kNvwEo53NP&_nc_oc=AdorioSNPw5K-vlnMpzOZ--sGI7U6pVIG44OMK2WHR7R3VM8XaQ_qWGy-NzixgNA9
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E31JCrSDuKwQ7kNvwFbyCPk&_nc_oc=Ado0mLomnP7GZiMWyxvVeMEDFDnh0rjSQNypUW4GbyovgQWjZXTSCAQiWDrE20rPILw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXCkPq4b1VWm3wWB4HbkCVSr6S6xUt-VscCM-QsisGYQ&oe=6A86D482"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAcwbpAHpWUQ7kNvwGEgvlh&_nc_oc=AdosRMQx1lM1SDbw1Vq9DawUhh6GshbfthYw665rUhja1V9Iy4kpRzENGxtsR1jd9-A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSh0utVycnxd5mh2O-f_t2arQW66HN-SW7R0cEUXhnew&oe=6A87023F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hsubG6TDbUQ7kNvwGIrv-9&_nc_oc=Ado7H_uDyD7YOVPD1DKCF933kRtYOZsLb66K62s-5SHDxT1twYpxhbY3qiq9szG8Cu0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvug0i_5q3IW-JfjGSMlmYkQN0O2ou8haLah0fw2X-Zg&oe=6A86D8F0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJzzxvWJF7YQ7kNvwH39HXc&_nc_oc=AdoURQNFLoEBQU_uc22FQzNNAbJS8I-cv2Lz8eYADNQYbN08CsnuD9Tha_jZz8I081A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVOnvH7K3H66snepsnSJzt4r_vjveVU1i5XHMTcLqW_Q&oe=6A940382"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj05hXFXIegQ7kNvwFRRCso&_nc_oc=AdrVCL6eo_it9XwXe5CTZzK8k-QKVE2tTbtx6tqHJRRNVl1-luolH-9LiUdI5aEkyLk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3gSyF628GWtCfoMDkjGXK2hNBDgoGixEF3ukW2GBtrw&oe=6A94313F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faTzQabzQFwQ7kNvwEPRqdo&_nc_oc=Adrbm-CN6mYG8YuN5oL0jcEZRs8raxRqGjFR-xxE3SJQSyux2zO5Nj3z43yeca00CVQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKHImABzGvXib_63JToOkfUaS1ZhBTJdRNn2n3CvfRdA&oe=6A9407F0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frW8jbyzsMgQ7kNvwE0uB_F&_nc_oc=AdoEfulXYTmlsljuhrL1tdbi3RAWk_1UoRH4r2W-p9z49IJ3PjP4q0p78oxnyR8pr8k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL3s317cvMqRRGVnQMGGc0ctw74S0h-b3D3J0mEw_Sqg&oe=6A75E942"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4G8zknSACgQ7kNvwHcuQvL&_nc_oc=Adq6O9lKaxIyLOg_5Ap02ScJ6MJGefLqotOvb7_wfchu5fsYY7qDc-48hVY6SHI2Cas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGspHNy0fkRAROO9cOQFxnBu4gqnFSAlVq23mz6R-utig&oe=6A75DEBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWW2tjxlp6sQ7kNvwEqAO6p&_nc_oc=AdpNNZb1UCbimXIe50FCxYk9wOYsolQS1iY84VhZGfDtH_bGk1jPJc2EkTkD7GC-J6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJBPxFFAO1c9Ny6yWrcZlaPwJgUsw6U1IvJlSwl_UsnQ&oe=6A75EDB0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
771-25/491830007_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cZ6JsZHcWUQ7kNvwEVZrUK&_nc_oc=AdoSRP9uCCyYATA4Mz-F3arpSvtHFhmlhI9XxwRBdjVrRCdcR91q6-TZrEYq3pSj7zA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyTt3IgiUcXtD9DhiN_jVuhmehSidcjfAnD7ceamOZSQ&oe=6A8D6C02"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4cn4HA8V50Q7kNvwFdT3DW&_nc_oc=Adp3n0hBJqxR-3Pp2jdEPJpRRQB5PImA9mtD_Eg80_gFxUPTG_Qxb_bhbrgPqBb-kAA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj4q-BfOMKFjFm5v8qMR1bD7oqrerpQUa14SX4LlPfqg&oe=6A8D99BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9p3QbVDi00Q7kNvwHs8RCJ&_nc_oc=Adqn-rE2dl9hR1ZIpsBfVKwbKea-GwdPJ5nvVCYwteW0QKOMMJoZXo1rtcz1OdYu4I4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiQPv9ZXurC0ZIrsvbiFt9idOUTG_PUClDCyXLxE9XXQ&oe=6A8D7070"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand s
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYm5l6o622oQ7kNvwEPGUMF&_nc_oc=AdoIOE8ClcXqkCi6Z3Zef-qbjSs-4oih1wexJgsSR3YY81mY1vQtwudn_9O9My4RhaQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYxr-vfa47SBLgj3HVwg7FeGrvGdOeu2LvA7UVpmoP1w&oe=6AAD4842"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prEV7rUBP5AQ7kNvwGsaejI&_nc_oc=AdpsqJp5yMID_ENNM8Zvi4B7XTyzjiHgYjr--hjatY5H3es2EwK0P-lVZgJAzIWaQN8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhqn12vJd2h8AhfW0IlC44mgUVnyNGe8NpaF4PkUEwhQ&oe=6AAD3DBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bOpA2yCdqsQ7kNvwG6Ytze&_nc_oc=AdpGvKbLo4IT5Kq-cGix7P9MBsskjdlyEKQWwsgFoFYXsHYPj1XZLdulZKabcu7VvYs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAzNSdS8qzPH990uUT5best7mzkITBgELOmxXIJPVOaA&oe=6AAD4CB0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzZztzvtEJoQ7kNvwGZOW0b&_nc_oc=AdqoG0eiOg7s-ATMfB-cqYbYS2_LTJ7j7cs9the3uxbOHlnqcajvoQQhWgQpLPA_vhE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiuczBa1uPBtJkUmyIbdXk7n4PD2Y9oM9urNmsORkFzg&oe=6AE20442"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMnGsB_zcuMQ7kNvwHiOYlq&_nc_oc=AdoHnCJn3Hlh7NKDXJBrjwZUbCkZ4sh3Rut-YD37-7mIGFRg63gxL_zDqE40NxaB5hc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiWQ3g7g-jR7d36RmDORUvnib6XHhOE70rwpuT5eWsEQ&oe=6AE1F9BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfXNWI2axUwQ7kNvwEY65D7&_nc_oc=AdpUesw5Bb-tqUmSkQo9AOWwIZ8Mx32jaGdNpGeU1mE8YtZNuXYR8v0mrNm0JxioOIQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFMP56llVpOorIQKaqsIuVmdPTufqvhO-qxk7O2mzjqw&oe=6AE208B0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
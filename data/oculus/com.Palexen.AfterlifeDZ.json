07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-qs1J0FyiIQ7kNvwEeuf4K&_nc_oc=Adpmf0tnCXrGnAQ3N5oSzHmdWhSdhjfKw-zQDrmYSlZDC8efb-LWs7zlfirVtiAyQKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOp25Bb75uUNzxN54c9vbdL9Lqv1pbWdUzJxC-WRK8KBg&oe=6AE4A742"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UInyhjYumTcQ7kNvwHc-tKz&_nc_oc=AdqlwRSUMPZnQy5cnBnB5bQ0-8Q961u3RFhsRMve2A1oPTqKkTucpOv6Gv49gPOrr5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgcmGkEKvtvNUr5YRyXweVgLs_cdatevmnI2MM3PT6PQ&oe=6AE49CBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0VwIVIwt7cQ7kNvwHpSJWr&_nc_oc=Adr7A32DJVYald51rRK566MmbALjD1Ii5oGuiHQlU20RvSvLTSwzLKLnVJ7gK0Qg6UE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmsL00E6awCHERvlUGjWUjaNIvPldVqe9z7_vOB9mATw&oe=6AE4ABB0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
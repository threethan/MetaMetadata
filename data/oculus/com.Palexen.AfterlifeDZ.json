b_wchCtZdw&oe=69D65A3D"}, {"file_name": "ss2.png", "id": "1351545359881313", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830007_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7xM4fg8M4gQ7kNvwGKRz5r&_nc_oc=AdpYuSbsU9fSRYsaqbcfZjzlbitgNeO9UkFBXA3MaykhaQHMpVfjt3yL5QLOW2AXlM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21OIXnRvw3z-cKiNAfg0rHhErfzO6Z5glbGgxPno3njQ&oe=69D663C2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXN8zFM9SZIQ7kNvwFFdR__&_nc_oc=AdrjnQhXyNNDTFnOeKmOJarBr_Bq5fFPMzAhjjHzmhr1Ib-SZSVtYunTz0BamgmenhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pHNm-XY760j16w9js8GYEyCG4ccu-8c9QwiXGFL7kkQ&oe=69D6593F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK106jejtf0Q7kNvwE_F9_e&_nc_oc=AdoxUbm-n-oKwAS438LMvCohlVF6GmIHb1EmTGi1XGGEpqRZHau89J76Kr4dMOtZ2t0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tyx1Z4OctWe9X5gcKl10tgbWW12DFraJPMAVPnf8AtQ&oe=69D66830"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "short_description": "Survive in a post-apocalyptic world overrun by zombies and mutants while awaiting rescue\u2026 Can you endure in the Dead Zones?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26190646163897480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619078_1117014583683643_4854873415764933024_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNRHCjYho_oQ7kNvwE44Sc_&_nc_oc=AdoHSSez0hYm6x2OVuuzoTKjBUI4ZjEUQIFANXz3F-j-0pfT2A3raYg9_PsDymNBcoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cvXhHFE1Hu2rdZca4lJ4mvLiS7w5fZrBNuKXQ9E1uhw&oe=69D65AE4
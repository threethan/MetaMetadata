07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gES0qIJZcI0Q7kNvwHQYF_x&_nc_oc=AdrGx4Kkle3mvz5hzB6tIOfHzmYR46t6zUnwtMvwLs3RSTok5aLZejxz2nz7bOGkDOM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTch0Gc3LjX_2-x5ljB2kSVm7GNsHEJVdl9GBCDBXD-A&oe=6AD383C2"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nusAqBQS8zMQ7kNvwGqXl7f&_nc_oc=AdogOM8_zjwwU_2iJBU3JuAgha8aUCY3aU_eejsow4QQIs0DbEpKuzvEx2zMoJX43NI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuGHwrXiOlrbnYh_H2Uvgi2Wh29ITxk3xh73IHAnyIjA&oe=6AD3B17F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jG6uDIPGKbUQ7kNvwE1IFyU&_nc_oc=AdoAowyZ7ZAxRUcnRZGhQfMOBZnT6Lgw0jYm74llcDgrs-SEmA1mf-q3jcjMLRuodTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7vLEzVM_hGb6YLFNbwRYIrqxb_uPm-_7SgERv2P4q_A&oe=6AD38830"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
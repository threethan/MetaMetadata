07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VS2HbfuvE6cQ7kNvwHj_Sph&_nc_oc=AdrIyeRZB_cu5kH1OFFDVgZrtPIzLwY4iGnJNwU1uLWe2zZpPPVZ9EHVj1iW-6t0IGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjTJY-gyMr6_NMLjeoNFR3Udz_OHJ7p7uv1xTI1PRiCA&oe=6AA80242"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PQnOSks2qIQ7kNvwF_SQq4&_nc_oc=AdoTLLkpDMWk5dUTFyGzAD4_8wihP0yG-U2IUAn0waeyejYpyknHFVECWM4WMQOZXZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-WLF5m1H5TiDuDl9QPwqI7djQRPYIZz3MVrm8wjkVjQ&oe=6AA7F7BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SBOTUFL9HEQ7kNvwF6S13K&_nc_oc=AdpTsAdYYwRqX0uJGB-lft9gdwmfCQ6bLjKmhpCojovwjG1JxSLfzzSCWPvV9kgY7E4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxvQlzTrBtSZpNji0MM0wp86mQ4t6REj3mmdHVyWgNRg&oe=6AA806B0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qI82VH4LCpQQ7kNvwGZmEyZ&_nc_oc=AdoQ5cx55Gj3lZeq2DuBO9OVS7eIjuPgbci8IbcFPS6w8dzNPp4vYQ2d0SJYwlHk53Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3HVo_D3Yzm8ostUXkP1_dMIEd36V_2GgxRfifi6dieQ&oe=6A897782"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6AdmghjgCwQ7kNvwF5BnzW&_nc_oc=AdpAvZu4CsFMBU4lI1t5s5Wbcz5Uo3T5CrXP6LsBAN_ywKnd0itReYgWNzI1hZqEfRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH10N2ByLqfN0i-Eq7FDlVne8h26LA6C1YZ_C3Hh0gp1g&oe=6A89A53F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MCG2BukNycQ7kNvwFUz7TY&_nc_oc=AdrYKo4ow6qmbpmLe8A7MuUwjKSJqaKcdCobZ5T_3WVRTUZZM_nbqMAezFBo7NC9rkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaGCfCmiwIHcebXtGlmaMkgB1J6qChKPA44iwO4kRYDA&oe=6A897BF0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M01wlNorpTcQ7kNvwFpzV6V&_nc_oc=AdpbnjI4pNB763iBXc4bbLvy5sAXMH7-hPFbrR57vf63CnsEi2qslGUPUROIIiVqCzk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHezzDb_B45Z_W77nsgYseE4haz-T-ZuyTnR_6R781p_A&oe=6A900F02"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4cn4HA8V50Q7kNvwE1BHxd&_nc_oc=AdoftBFRe5TpZTm2wj5oVlwJnM66xGCoxq7BVAy46sdmxaURjmdikJedgABPy_vLxcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzi--d4WkVeQrPNQIqxN3tIlfa-qnD_sYrQJXne2TCCw&oe=6A903CBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9p3QbVDi00Q7kNvwFy-3t5&_nc_oc=AdoYijzFkv3gIW0HBdWhVJP8lntS5zFRPa6IuzhWJckbvcA_6UeAdwVoamX4H3-TQlo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyUhMT7ku6195tpo8HToIZ8oY0B83Ll5S8T3b91mPgDA&oe=6A901370"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
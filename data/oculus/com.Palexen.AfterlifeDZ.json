07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xke4hsTudJwQ7kNvwEHqzkY&_nc_oc=AdpOdvXxmfHvGq8J_ne_4bUmnRSxEQ3D-BVJfEoKQfzEtoKce3bpUmINKTE2za6i0Qg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0n_nDWonJqkprgR3c8IgrsLqLYiw44bF_argxZqp4SQ&oe=6ACCEC42"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQIL-5TuLNwQ7kNvwGjNHcQ&_nc_oc=AdoAR1Upn85rrE3PZSYu2pRqBX9-rOjgM-gkI1I3s0zufp8Gyh7Dk-BPAm3WM_gtJwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqKqgBIwHl1WgGjVJLwriFCv8LPaquQgRXYCdqARNhOg&oe=6ACCE1BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwGqt-ZJIjwQ7kNvwF9ey4N&_nc_oc=AdoHo6zlk_Ttr76J93Dv1vSHk19dmnl9-xkd6SQSoQE4p3aM2fanlmC7wnXtF0DXnCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLvw3vn4LFnN2pmhily4a3bdxbHWJnCtwwUA-TcjXH0Q&oe=6ACCF0B0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
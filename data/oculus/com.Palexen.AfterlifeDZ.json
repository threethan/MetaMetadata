771-25/491830007_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E31JCrSDuKwQ7kNvwHuGNLf&_nc_oc=AdpFlM3nZ4X68ej5aL6hyuu0AYHdz7aKRBeDR-lfZFWJcNv9Bxj5EObFJn-l4naEl24&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4QYl9U0t05TzOlZJJOgzZm8A8Hn_1CpmPcFtSbf_haQ&oe=6A858302"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAcwbpAHpWUQ7kNvwEBPH7e&_nc_oc=AdoykFhX2pZR4N6FDnFBz9tsnq7x4a2H2Cp708KGJN-U-86TOCZCGiDwXgvN1UJ-2jA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDV8P_qw3yMP6fQl1EQ3tJHx0ttaIlFuv4m-N1KvN8rw&oe=6A85787F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hsubG6TDbUQ7kNvwEzrrdT&_nc_oc=Adqvdeg6jkQbIUobpylNxjvAY6suOrTZbmgy-fuub3H1qWu1ixWCzSdw94vFtlU-j04&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDEwXECbGUsQ29eVze4Ty7BjrCkKjigJBffjUFqLk-NA&oe=6A858770"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand s
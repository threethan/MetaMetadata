07_1351545363214646_5506338495222860567_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-JdRv-Q3-EQ7kNvwGcyX8B&_nc_oc=AdqlFr16hX38d7Xf1HgxSeTYnSkIA44zjLqNAEBo4r7OLjwxuegKbS2HSlcRaWlrqtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsiK9hoaJ9Zpx_W18MuALnvFbze6PXKo01OnR5SX5xYQ&oe=6A831842"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJjDlz7ib8UQ7kNvwEt0Oum&_nc_oc=Ado6h-T0CFBsmthv8v_UhFXH4DzXgI5oYusWxeuaK2TiP1Q-SmK6CQlf9ATDQYl8p-w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQVlFVssuPvM9T2BotbPqsUtcGh19Fe2IByvqkC2VKOA&oe=6A830DBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X93wQIq8tvIQ7kNvwHzjbTd&_nc_oc=AdqbEQcGSaIVU2IgYPRP5qBxhPspen8ZPqMkhNLj6p-_FmzPbHuu0IWEMCLdkXMguUs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRQVKfKBxB9Sc8Hqt7ItyLfK3blFS3ueIHX41bLLMBYw&oe=6A82E470"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quic
7f20f&oh=00_Af__EBsGFP8NjGgGoDLVVL1Y_KMRof2lhclAQCLy0RFM7w&oe=6A394442"}, {"file_name": "ss5.png", "id": "1715729295759342", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499305050_1715729299092675_4690986203494255387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0maeLu3jJRkQ7kNvwGD0KGJ&_nc_oc=Adr4yGOH6VYb5nX7D4E2ps-gfmEpB9oynD7SiAkmGEML34JsOheIZf3YM5OjUVGE5dQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_axn99JFE2VbwKiiW00XphObjgcVedgxyTL86f9uDhQw&oe=6A3939BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portrait.png", "id": "806605711863955", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823486_806605715197288_1898259061609879939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yyc7ZY9DC9IQ7kNvwFM8-_S&_nc_oc=Ado03gcTWNu911Sqr2EQ39I3Pb4Cun3Gjz64v3WZrqK6fIL1yxrPF0lvuVwiuvB9GgQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JZl2876aQGtPo1vt7hr6_cqMJiCQlYkGuuvEicq8tkw&oe=6A3948B0"}, "display_name": "Afterlife: Dead Zone", "keywords": ["zombies", "shooter", "disparos", "zombis", "horror"], "long_description": "In Afterlife: Dead Zone, you play as a soldier trapped in the Dead Zones, isolated areas where help seems impossible. Humanity teeters on the brink of extinction: ancient alien civilizations have returned to assess our development and, deeming us a threat, unleash weapons of mass destruction that turn people into bloodthirsty monsters.\n\nExplore dark, devastated post-apocalyptic environments where hordes of zombies and mutated creatures can appear around every corner. Your mission is simple but deadly: shoot and avoid dying. While your weapons have infinite ammo, the variety and ferocity of enemies will demand strategy and quick reflexes to survive.\n\nDesigned for Meta Quest, Afterlife: Dead Zone delivers an immersive experience where you can only move physically within your designated play area, plunging you into a dark, destructive, and oppressive world.", "s
lrPai0IvtlUkW0kJvyIPY-_wg&oe=6A3548B2"}, {"file_name": "Screenshot 4(1).png", "id": "480797287004916", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_480797290338249_5701483980215099959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P8HNyeJoJgQ7kNvwF1VrKt&_nc_oc=Adq5HsaE-7-iCmWPx1GsQ6UEZpOL0pi7KUlt_nmKjJTxKfEFV2MjrNjD4zgR62KK2MI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Se9uQ-fmazA3qBhIRisZz_mKOiuaKeWjCs2k0X27nFQ&oe=6A356F70"}, {"file_name": "Screenshot Bathroom.png", "id": "703477781027147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_703477784360480_244052977549845459_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95tSJdcvN8UQ7kNvwHaemGA&_nc_oc=AdrgcS8rehdJuejiQkd0a0IUIvjhor4UdbpaXsBbWa6ZL3YtZCSBkaVt8bDx6nAiLaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JM5_17g4x5tZgoCzibNVpkM4B60rtnhJXrHKeulDOCg&oe=6A353FFB"}, {"file_name": "Screenshot 5.png", "id": "660738638684692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031498_660738642018025_7787379494202734189_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX3JGrpd_sEQ7kNvwFcsFve&_nc_oc=Adpc5l8_L417diNVlkOMy5J05QAOxDB2O7BP2zKZt8imQDprpeURloyJ0j9MvYFzXHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9picJkCLN2FcWgr42f5Ujos-kcQr-1qoLjHXosDrvqPg&oe=6A354EC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MultiMeasure", "keywords": [], "long_description": "Need to quickly find the length between one end of the room to the other? Does the kitchen need a new floor and you want to quickly find the area?\n\nMultiMeasure is the perfect, easy to use tool for all your measuring needs.\n\nUse the length tool by defining your start and stop points and the app does the rest. The area tool gives you the ability to create and shape you need by creating points and calculating the surface area. The angle tool helps show an angle for example a slanted ceiling or non-90 degrees corner of a room.\n\nMore tools coming soon!", "short_description": "Measure lengths, areas, angles and more in VR! "}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://www.vr-world.se/apps/MultiMeasure/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8388081591318567"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439596_751679856221524_1142810812068547174_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lqh3ivSSSDIQ7kNvwGSsPz0&_nc_oc=Adp_aKDM_kjIzFOipyfs2CqFQjAkpdM_m2H_u-fDcItiUCBQwekX1uHUT5NCf8S-NLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-UmsWdxGt8BUznuFkXoxpdKh4R2cplRKdE2Ei80HPpQ&oe=6A3540CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MultiMeasure", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1658951945, "lastRevision": {"nodes": [{"id": "771716020452603", "release_type": "SCHEDULED", "administration_status": "APPROVED
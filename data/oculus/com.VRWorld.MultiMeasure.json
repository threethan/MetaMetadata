G7-7VejQkXRIC7UncQkzjBJjg&oe=6A26C832"}, {"file_name": "Screenshot 4(1).png", "id": "480797287004916", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982439_480797290338249_5701483980215099959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phsH2bXtK1UQ7kNvwGDuAkW&_nc_oc=Adqy848uuDKx1A65UIkVoE634977MqdOxnVMoydvi17uLd0rJQP7ZbkEnu5TUpdoRmE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ligwkGbAXPpimt-4wGsDjpEi08FD0IzUfX-Ub0sQ2Dw&oe=6A26B6B0"}, {"file_name": "Screenshot Bathroom.png", "id": "703477781027147", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984460_703477784360480_244052977549845459_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvd-h-QWb8IQ7kNvwHfouWX&_nc_oc=Adp1TKImGZWVPNDtkE1hD7nibqKrgyock0HkgwrEIJb8ol3Q1b5nN0QX2-3IB0wPE1I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dM833ghYvVkIEg9V7AiTGve8Cxof6lf2GeJRz63ySww&oe=6A26BF7B"}, {"file_name": "Screenshot 5.png", "id": "660738638684692", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031498_660738642018025_7787379494202734189_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9ufy7I-OyAQ7kNvwFOJu43&_nc_oc=AdqjLgTXYlzbP44NY9_8XW_5p5cszNQHL4rZS2CZAuxOdGXNY1thy_OnUdEtE2Hcvng&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e7DroOcVKNLR2oqQKh6noyX3lJd0RY0Ao98p5_IfoeQ&oe=6A26CE40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MultiMeasure", "keywords": [], "long_description": "Need to quickly find the length between one end of the room to the other? Does the kitchen need a new floor and you want to quickly find the area?\n\nMultiMeasure is the perfect, easy to use tool for all your measuring needs.\n\nUse the length tool by defining your start and stop points and the app does the rest. The area tool gives you the ability to create and shape you need by creating points and calculating the surface area. The angle tool helps show an angle for example a slanted ceiling or non-90 degrees corner of a room.\n\nMore tools coming soon!", "short_description": "Measure lengths, areas, angles and more in VR! "}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://www.vr-world.se/apps/MultiMeasure/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8388081591318567"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75439596_751679856221524_1142810812068547174_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWSsxb057qsQ7kNvwEuEDeX&_nc_oc=AdphUiUhJykaJs8efvy3AXFGkS9Cvj79y0fx6NSgSgpQqp_ZRcFBla1OiVGpO_wq6Rg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KAyAEktLhOwh-viorWXx7CyD84gOMKTFmchcS-047oQ&oe=6A26C04D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MultiMeasure", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1658951945, "lastRevision": {"nodes": [{"id": "771716020452603", "release_type": "SCHEDULED", "administration_status": "APPROVED
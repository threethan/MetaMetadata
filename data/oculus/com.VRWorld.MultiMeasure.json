Zt2PbE8xd4LGa2w5KnA-l_n18Yua_DzllOTR0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY9pRwHsOMBVpQAl_0yxpyt68br9DWXEAWdiiVomHEVQ&oe=6AF47232"}, {"file_name": "Screenshot 4(1).png", "id": "480797287004916", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982439_480797290338249_5701483980215099959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP_l8gBUzp8Q7kNvwFmrRu_&_nc_oc=AdpcKzxDpAlqRGrr9f9DRWECvSA7L2O0jerkjcS108owGbUNSRsZd5ngZyPavPgva0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTruXu-gD0nTkecUAZ4BLGme0Y1hWoPEZy6ZRNeO6dRoA&oe=6AF498F0"}, {"file_name": "Screenshot Bathroom.png", "id": "703477781027147", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984460_703477784360480_244052977549845459_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnkvdyWXfe4Q7kNvwH3tNTM&_nc_oc=Adqz2QSNsbche_2C-idPPe8QSF7LwGfEMC1p7LTKZZDCfJ17e_KCdBFa1UGq5TpMNtc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFwV-QOdNbjihF3VqQpqMAb8kkWJZnLYyRZX_0F9zo6g&oe=6AF4A1BB"}, {"file_name": "Screenshot 5.png", "id": "660738638684692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031498_660738642018025_7787379494202734189_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivvT70_0F0wQ7kNvwEVcLbd&_nc_oc=AdoSd38cPf9KMa8uGJd9MMK55deQuZwi100pE347T4k6VLXZ25cI9kt0R_BXb308p6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLh1UkwNP2SsuS-ZH6N--kmIhzVGjsiC_DTjE5HwE5nA&oe=6AF47840"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MultiMeasure", "keywords": [], "long_description": "Need to quickly find the length between one end of the room to the other? Does the kitchen need a new floor and you want to quickly find the area?\n\nMultiMeasure is the perfect, easy to use tool for all your measuring needs.\n\nUse the length tool by defining your start and stop points and the app does the rest. The area tool gives you the ability to create and shape you need by creating points and calculating the surface area. The angle tool helps show an angle for example a slanted ceiling or non-90 degrees corner of a room.\n\nMore tools coming soon!", "short_description": "Measure lengths, areas, angles and more in VR! "}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://www.vr-world.se/apps/MultiMeasure/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8388081591318567"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75439596_751679856221524_1142810812068547174_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wkguu_ytu8Q7kNvwGNat4i&_nc_oc=AdpcHJ1WAwFZDA6EWM8_rGoBaPF3SFmRP7b5G257L_lUI-PI3iaAVLh8sr0SOHitUXg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0yz0NOvokyRmDWgYZldHiP1wTB5FXOMyG2UIm06K1vQ&oe=6AF4A28D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MultiMeasure", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 165
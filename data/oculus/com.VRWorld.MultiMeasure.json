0480_244052977549845459_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt0ps74a3wwQ7kNvwHhwENL&_nc_oc=Adoe1BdOLOIYwF6HGP8pY7bXYU8UMiJo9aKf1Wpa_hH42tz1CE3HgufC9huoqFx7r8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY8k6HeoZPEcs6Pl5eFcBX6Sq7QiCDzPGUWbMVz8Zj3Q&oe=6B03223B"}, {"file_name": "Screenshot 5.png", "id": "660738638684692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031498_660738642018025_7787379494202734189_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8vuBChr0YkQ7kNvwHFxVuM&_nc_oc=Ado3Msj7dG_oLGEPR4k-BQOMlLFnwvkikkiTDEVSXkF0GZLJiROMaglWW6zoJEUuqFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGxLXAKKkkxgrR4wG5xA1PWKx-JYfebobQ-Pnm2IYMfA&oe=6B033100"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MultiMeasure", "keywords": [], "long_description": "Need to quickly find the length between one end of the room to the other? Does the kitchen need a new floor and you want to quickly find the area?\n\nMultiMeasure is the perfect, easy to use tool for all your measuring needs.\n\nUse the length tool by defining your start and stop points and the app does the rest. The area tool gives you the ability to create and shape you need by creating points and calculating the surface area. The angle tool helps show an angle for example a slanted ceiling or non-90 degrees corner of a room.\n\nMore tools coming soon!", "short_description": "Measure lengths, areas, angles and more in VR! "}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://www.vr-world.se/apps/MultiMeasure/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "39322
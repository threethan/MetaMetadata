kJmcD_61Ky0pHOhSfv1lkVnAA&oe=69E8D1B2"}, {"file_name": "Screenshot 4(1).png", "id": "480797287004916", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_480797290338249_5701483980215099959_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqsPuDEgjVcQ7kNvwE3DaDG&_nc_oc=Adqxbv6IIP4bUQxqji8kGUChgVJ76s3WcVKwZ6WNTzoJAa5rmLViAUWo64QZEEj2gpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FysV2UVDz2VSbnG-ifCFlfniPWLmuZyj599SFguYj2A&oe=69E8C030"}, {"file_name": "Screenshot Bathroom.png", "id": "703477781027147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984460_703477784360480_244052977549845459_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0VmsPjkSDIQ7kNvwE8lAfS&_nc_oc=AdqLa5BE9xmxU-WY-IyjZ8ZUvQ9vs5qHHfDgX3ZnvRw6-Zt1w5SQ-Tu_xKFvTfF3N0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12esnLqxAn1gN04mH8Kr8U-tLOlj7AtiW7ihBHJRa20g&oe=69E8C8FB"}, {"file_name": "Screenshot 5.png", "id": "660738638684692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031498_660738642018025_7787379494202734189_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oj9R9RsGq0Q7kNvwFgUAuG&_nc_oc=AdpwnnIyaM_bT8jIXUqa5Rp9yKk_y4gYEjmwYlTAojJcjvtC9q-fZASgic9NN74fOAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VKON5-J4z0Vs67REyBE372zgFG8n7CaGG_QEKmEo7ew&oe=69E8D7C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MultiMeasure", "keywords": [], "long_description": "Need to quickly find the length between one end of the room to the other? Does the kitchen need a new floor and you want to quickly find the area?\n\nMultiMeasure is the perfect, easy to use tool for all your measuring needs.\n\nUse the length tool by defining your start and stop points and the app does the rest. The area tool gives you the ability to create and shape you need by creating points and calculating the surface area. The angle tool helps show an angle for example a slanted ceiling or non-90 degrees corner of a room.\n\nMore tools coming soon!", "short_description": "Measure lengths, areas, angles and more in VR! "}]}, "developer_name": "VR World", "developer_privacy_policy_url": "https://www.vr-world.se/apps/MultiMeasure/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "VR World", "support_website_url": null, "website_url": "https://www.vr-world.se/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8388081591318567"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439596_751679856221524_1142810812068547174_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWkZQ6lMrywQ7kNvwF0ydpY&_nc_oc=Adq6H8U8qMBTjEjyGnDewBoLKPZYGYc58NUYpfU8XY4wEE1Z3BkH0ZO0sBbSTHq6eIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LhPbf1m6fK6pc7djL9I-22sRS83uuuhslJ8ovMoXePg&oe=69E8C9CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MultiMeasure", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1658951945, "lastRevision": {"nodes": [{"id": "771716020452603", "release_type": "SCHEDULED", "administration_status": "APPROVED
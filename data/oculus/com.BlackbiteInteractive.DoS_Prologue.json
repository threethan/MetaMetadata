.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3EpPsnIQS3N27ez45WBrGSOk7FkznOP-gYerQHzAqcA&oe=6A3292B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_trailer_DoD.png", "id": "1815286671821896", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162732_1815286675155229_8777384002932703232_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N95rmRRpWU0Q7kNvwG_-LyH&_nc_oc=AdplEIJZtwPMPhslep_OPdFkpN7ZUnbn5WulNhw8yhVtRulp4eKynlO2mNHvj_MrCPs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xuGmc8rJOZcx1WMikN06ota3TMU3hYDT81fhWKwg1dw&oe=6A329FF0"}, "display_name": "Doors of Silence - the prologue", "keywords": ["horror", "exploration", "adventure", "survival", "escape"], "long_description": "From one of the best-known and more horrifying experiences for VR (best choice for Upload VR, GeorgeTown\u2019s Gelardin Media Center and TheRiftArcade) that has collected millions of views on youtube, The Prologue was born as the first episode of a new horror saga: Doors of Silence.\nDeveloped with Unreal Engine 4, DoS-The Prologue is an immersive survival horror for Gear VR, with stunning graphics and a long term gameplay featuring exploration, stealth, puzzles and interaction.\n\nYou wake up and find yourself in what looks like a nightmare. You have no recollection of where you are or who you are. Hide yourself from the evil entities and find out who you are and the secrets that lie in the underground bunkers and labs of this dark place.\n\nWARNING: this game use some JUMP SCARES", "short_description": "From one of the best-known and more horrifying experiences for VR (best choice for Upload VR, GeorgeTown\u2019s Gelardin Media Center and TheRiftArcade) that has collected millions views on youtube, The Prologue was born as the first episode of a new horror saga: Doors of Silence.\nDeveloped with Unreal Engine 4, DoS-The Prologue is an immersive survival horror for Gear VR, with stunning graphics and a long term gameplay featuring exploration, stealth, puzzles and interaction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doorsofsilence.com/", "developer_terms_of_service_url": "https://doorsofsilence.com/", "publisher_name": "Blackbite Interactive", "support_website_url": null, "website_url": "https://doorsofsilence.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "648144019559444"}}]}, "scheduled_offers": {"count": 59, "nodes": [{"status": "PUBLISHED", "id": "142240599731544"}, {"status": "PUBLISHED", "id": "215957802884820"}, {"status": "PUBLISHED", "id": "362531074184148"}, {"status": "PUBLISHED", "id": "1299226153614557"}, {"status": "PUBLISHED", "id": "1911670739153274"}, {"status": "PUBLISHED", "id": "2786337461609257"}, {"status": "PUBLISHED", "id": "568628470708795"}, {"status": "PUBLISHED", "id": "390115071585181"}, {"status": "PUBLISHED", "id": "200752910495517"}, {"status": "PUBLISHED", "id": "2474990972737915"}, {"status": "PUBLISHED", "id": "2035881733204089"}, {"status": "PUBLISHED", "id": "303611920236694"}, {"status": "PUBLISHED", "id": "2446019075688212"}, {"status": "PUBLISHED", "id": "788149468057726"}, {"status": "PUBLISHED", "id": "414713746069524"}, {"status": "PUBLISHED", "id": "1171288339703568"}, {"status": "PUBLISHED", "id": "459555304779978"}, {"status": "PENDING", "id": "1982346608692424"}, {"status": "PUBLISHED", "id": "522516818359631"}, {"status": "PUBLISHED", "id": "1088419734838701"}, {"status": "PUBLISHED", "id": "
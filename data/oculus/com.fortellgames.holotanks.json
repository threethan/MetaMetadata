{"data": {"node": {"__typename": "Application", "id": "6602381406557537", "organization": {"id": "1084600649381846", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25090691287240262"}]}, "id": "1379668936933111"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25089378390704433"}]}, "id": "844653101395281"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "6602381406557537"}]}, "id": "881466600325347"}]}}, "firstRevision": {"nodes": [{"application": {"id": "6602381406557537", "release_date": 1707240836, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 7}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8163755213753474"}, "id": "1016134223024291"}]}}, "binary": null, "live_binary": null, "created_date": 1722643369, "id": "7619401161522218", "is_initial_release": false, "name_with_fallback": "v4", "pdp_metadata_with_fallback": {"version": 3, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "7619404678188533"}, "release_status": "RELEASED", "id": "6602381406557537"}, "id": "7619404678188533", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6602381406557537", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "218305067984387"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1735819937191716", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holotanks (Fr\u00fcher Zugang Beta-version)", "keywords": [], "long_description": "Holotanks, ein rasantes Actionspiel, das das Konzept der Zukunft der Spielzeuge revolutioniert, ist ein wirklich raumgreifendes, gemeinsam nutzbares Mixed-Reality-Spiel mit Panzerschlachten! Mit Einzelspieler- und Mehrspielermodi verwandelt es dein Zimmer in ein dynamisches Schlachtfeld!\n\nFeatures:\n- Zukunft der Spielzeuge - Panzerschlacht in deinem Zimmer!\n- Echt raumgreifender Spielspa\u00df - passt sich jeder Raumgr\u00f6\u00dfe an\n- 8 Spielmodi f\u00fcr Einzelspieler oder Spiele mit Freunden\n- Fern- und gemeinsam nutzbarer Mehrspielermodus - bis zu 8 Spieler im selben Raum\n- Umfangreiche Einzelspieler-Kampagne\n- Integrierter Level-Editor\n- Freischaltbare Panzerteile und Skins\n\nVerwandle dein eigenes Wohnzimmer in eine Panzerschlacht!\n(und bitte denke daran, dass dies eine Early Access Beta-Version ist)", "short_description": "Verwandle dein eigenes Wohnzimmer in eine Panzerschlacht! Holotanks ist ein actiongeladenes, wirklich raumgreifendes, gemeinsam nutzbares Mixed-Reality-Spiel mit Spielzeugpanzern und bietet sowohl Einzel- als auch Mehrspielermodi."}, {"images": {"nodes": [{"file_name": "PUB_HOLOTANKS_Landscape_2560x1440(edit).png", "id": "3730748950583490", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982547_3730748957250156_6978117647098244162_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fr5iGej-VVUQ7kNvwEboc2_&_nc_oc=AdounWldQPx4TmiccL8tKSWvanj8EtO_Fav8X3hMQ5VyJnDVkk7mG1bfs1wsoMrHZKo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPBJTWbEcVa8Ivr9yDmiGikiAzYwP0uGC3JC64B3k4sg&oe=6A5A336E"}, {"file_name": "PUB_HOLOTANKS_logo_from_hero.png", "id": "3612859685700266", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570291_3612859689033599_3828736851937512550_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHipFjyWxyoQ7kNvwFrDs7k&_nc_oc=AdoX3ofGy624L2uQLi8UJfK1YSRv8tNk1mtOH18e-T7pjXKt_kngp7kej
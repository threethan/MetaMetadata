4833_3204823556327661_1984908988321581587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44XSv-y8oGAQ7kNvwF6Le_B&_nc_oc=Adp106jEFNSCmQt78LZoCEKyQFqKFT1fbETj8XKZ5UT87QtOhfIPdndGllsTdxrqitQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe2BnUcPU9hCBK4s7pin3Gh1a8Kh1ApgpUgnXNM7u-EA&oe=6A85A2D5"}, {"file_name": "vlcsnap-2023-12-12-12h20m50s870.png", "id": "409410291410134", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974473_409410294743467_2352617692747153803_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WO_jNKofwSUQ7kNvwGS3PvE&_nc_oc=AdoYOqzQWlU_e1QGBbvVLgseHpuPZQFYZrkI0izCHBep1tws3BwuPtTNoJqVWPbDVwo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfLoMt48Q5DYJOWfa19amLo5biWpRs7oQCYs_yzEYpVw&oe=6A85880D"}, {"file_name": "vlcsnap-2023-12-12-12h23m01s822.png", "id": "365460056036009", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982688_365460059369342_3966916388172683649_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEm44VuDXHMQ7kNvwFm7ScN&_nc_oc=AdpV3LSXTesx9WjuPZwRamqRdHdbAqwacVu1-J8ofEBK4dedd2tNmsQW1UwRW32kWd8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDnB-6vX1WTJct3CO38sP3jpe2NtP_kd4g_ZIF3Ir_2Q&oe=6A8597EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_HOLOTANKS_Landscape_2560x1440.png", "id": "1474100426494212", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86604447_1474100429827545_434446056725707431_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPXxk14gU_IQ7kNvwFaVZvi&_nc_oc=AdoP_tXHCad9p8BK9b-dTDmni2jrXvlrhZENGDcKZCSET39nrc3oJXWvYXlcrHfTt4Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIm0oUZZKygKfQBOsjD320jmFSkIXqv6S_FlAH6MYvug&oe=6A85889D"}, "display_name": "Holotanks (BETA)", "keywords": [], "long_description": "Holotanks, a furious action game that revolutionizes the concept of the future of toys, is a truly room-scale co-located Mixed Reality toy tank battle game! \nWith both single-player and multiplayer modes, it transforms your room into a dynamic battlefield!\n\nFeatures:\n- Future of toys - tanks battle in your room!\n- True room-scale fun gameplay - adapts to any room size\n- 8 game modes to play alone or with friends\n- Remote and co-located multiplayer - up to 8 players in the same room \n- Rich Single-Player campaign\n- Built-in level editor\n- Unlockable tank parts and skins\n\nTurn your own living room into a tank battle!\n(and please remember this is a Beta version)", "short_description": "Turn your own living room into a tank battle! Holotanks is a action packed truly room-scale co-located Mixed Reality toy tanks game featuring SP and MP modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://beatshapers.com/holotanks_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Fortell Games Inc", "support_website_url": "https://www.fortell.games/", "website_url": "https://www.fortell.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7619404678188533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569457_1005703390526206_4811816033278719630_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMdPuwinIs8Q7kNvwGGHanE&_nc_oc=AdrrFyk0Qr4Q3FGyF7u5XxV8AHL67KnK8thenI0bTYxdquE_7-Xm7u5LbtGKoKunsGI&_nc_zt=3&_nc
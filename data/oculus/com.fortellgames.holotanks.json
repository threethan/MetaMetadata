823556327661_1984908988321581587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmDouv4ahv4Q7kNvwFiyf-C&_nc_oc=Adqur_FYT4nwRIee4ru1duu5srjGKi3LaoMF9NVI_3UnmnYl_pfj0rxQMFNR7oIb-VY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1Jjrnam1ig9jss-3v8pa6VMW4k9Mw-CfgioKxNlBk4w&oe=6A81AE55"}, {"file_name": "vlcsnap-2023-12-12-12h20m50s870.png", "id": "409410291410134", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974473_409410294743467_2352617692747153803_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPKx1ZWrcRwQ7kNvwE1lm-B&_nc_oc=Ado-9scq05bcKOessGQYqY5t4bTkM_8T4TQ_JZ5Ea_z8ftPtMjdtf4vaNVJP_UNiBkI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8OrjjZ3tWGAHH4gMnjFNLQvZi7H7LjH42_jNQX9kzew&oe=6A81938D"}, {"file_name": "vlcsnap-2023-12-12-12h23m01s822.png", "id": "365460056036009", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982688_365460059369342_3966916388172683649_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EW1v3EQpDcQ7kNvwGDxOgo&_nc_oc=AdqSPgqzIWhIIKK_AtJzkojiZ5jJqFaJOAQKuDaxXsD8sWMFcg2sZSDD8vE-RPANj3U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-0UiJ2AxktscvOWyTNJbnG2Rlt7gYUndf8fZFqkg6mA&oe=6A81A36F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_HOLOTANKS_Landscape_2560x1440.png", "id": "1474100426494212", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86604447_1474100429827545_434446056725707431_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1C09zGlYayAQ7kNvwFLTVb_&_nc_oc=Adqw2TJaKUi4wG9HqRP7VYBh9vSRUR_fnMzZ8Ic4oD2cznGNkdSB4qk8XM0ESG-bH58&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENmBS5hhitP80jeQGwRPldDz--HZwYXGHV_W-Pc-8vcQ&oe=6A81941D"}, "display_name": "Holotanks (BETA)", "keywords": [], "long_description": "Holotanks, a furious action game that revolutionizes the concept of the future of toys, is a truly room-scale co-located Mixed Reality toy tank battle game! \nWith both single-player and multiplayer modes, it transforms your room into a dynamic battlefield!\n\nFeatures:\n- Future of toys - tanks battle in your room!\n- True room-scale fun gameplay - adapts to any room size\n- 8 game modes to play alone or with friends\n- Remote and co-located multiplayer - up to 8 players in the same room \n- Rich Single-Player campaign\n- Built-in level editor\n- Unlockable tank parts and skins\n\nTurn your own living room into a tank battle!\n(and please remember this is a Beta version)", "short_description": "Turn your own living room into a tank battle! Holotanks is a action packed truly room-scale co-located Mixed Reality toy tanks game featuring SP and MP modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://beatshapers.com/holotanks_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Fortell Games Inc", "support_website_url": "https://www.fortell.games/", "website_url": "https://www.fortell.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7619404678188533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569457_1005703390526206_4811816033278719630_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6saIbRjBG64Q7kNvwGYXpGR&_nc_oc=Adrs1dBo64erAUh12ToSGYVaHUdGkse-dq5tUhOKosR-TS8lEdb-HMH1j2BtSMuckZ0&_nc_zt=3&_nc_ht=scontent-
ny1A&oe=69B40455"}, {"file_name": "vlcsnap-2023-12-12-12h20m50s870.png", "id": "409410291410134", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_409410294743467_2352617692747153803_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8KIIwOg1P0Q7kNvwHFgfxV&_nc_oc=AdmYlnFuWytfuFgIuL6aSTLozxvyaC4GoTbQI5ac4uJlYG_sPe1btMzRSnKdQ36GflY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzD8rw1EnDuwCQmL1FSXebzYlneh7U1zBxOEzllRjTY1A&oe=69B421CD"}, {"file_name": "vlcsnap-2023-12-12-12h23m01s822.png", "id": "365460056036009", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_365460059369342_3966916388172683649_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHt1bd5A72UQ7kNvwEBqmMg&_nc_oc=Adk4wCd4Gx92zYc-LvXY9EpCSztZ_zA-4mBLqR7I_HmgOFhq2YcGo7n8BlyYEm01Z7Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz0Mq0yUBaB82rmCytCNFzogQepvSomnTYmv-I9edWw3Q&oe=69B3F96F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_HOLOTANKS_Landscape_2560x1440.png", "id": "1474100426494212", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604447_1474100429827545_434446056725707431_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9n-Q5raWUqgQ7kNvwGw-Lnt&_nc_oc=AdkYl0saULqJ0Q9ceLw4FgzVKtgMQFrp2MD_44PWmjgl6SxhyFM7zKM9e571VgmtRLY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzRZP6nslO7wCCWgzU4DhJ6pmoVuk489Kam0IZjN6IWQ&oe=69B4225D"}, "display_name": "Holotanks (BETA)", "keywords": [], "long_description": "Holotanks, a furious action game that revolutionizes the concept of the future of toys, is a truly room-scale co-located Mixed Reality toy tank battle game! \nWith both single-player and multiplayer modes, it transforms your room into a dynamic battlefield!\n\nFeatures:\n- Future of toys - tanks battle in your room!\n- True room-scale fun gameplay - adapts to any room size\n- 8 game modes to play alone or with friends\n- Remote and co-located multiplayer - up to 8 players in the same room \n- Rich Single-Player campaign\n- Built-in level editor\n- Unlockable tank parts and skins\n\nTurn your own living room into a tank battle!\n(and please remember this is a Beta version)", "short_description": "Turn your own living room into a tank battle! Holotanks is a action packed truly room-scale co-located Mixed Reality toy tanks game featuring SP and MP modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://beatshapers.com/holotanks_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Fortell Games Inc", "support_website_url": "https://www.fortell.games/", "website_url": "https://www.fortell.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7619404678188533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569457_1005703390526206_4811816033278719630_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkfg1s_DHEEQ7kNvwFSF3ir&_nc_oc=Adl6ju6A0bDk1DnJ4p6NCoeDfNjxz6BDdRoHi5m9jeJecQeY4DjPkWYnAm6bErkdDxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCnKhx7pPJNjutGCDt1yJamcfkVVU21eArFZxDY-l40A&oe=69B401D3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Holotanks (BETA)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260359
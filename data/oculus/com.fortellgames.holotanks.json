291410134", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974473_409410294743467_2352617692747153803_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oESyeIBuALQQ7kNvwGw39Dy&_nc_oc=AdrUiezhl5JY38fHz3nfP5XlM5DR6SUq1ohanlzyd9DI1R3k7eb_-ZV9tSwmiptLrdA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u6MfX5A--_A0qNgzjkYLf6XSlwwJaP3LLIdAx0OPIaw&oe=6A033BCD"}, {"file_name": "vlcsnap-2023-12-12-12h23m01s822.png", "id": "365460056036009", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_365460059369342_3966916388172683649_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxkFON_GUTEQ7kNvwEzR8oR&_nc_oc=Adpt42522izFa6wKy_qFVWtSHO03oTpYYHO5fTDqg2MYROu3BjxTwPbMNVPJis-ODZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xhYTDQWTI7_zyymnzIB1v6vWlNeub7NtiDngF9776mA&oe=6A034BAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_HOLOTANKS_Landscape_2560x1440.png", "id": "1474100426494212", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86604447_1474100429827545_434446056725707431_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvoH56iugvsQ7kNvwGiANFq&_nc_oc=Adq8DD7tU61iA03U6aQAFjAYJ9nnOYMIj1V8jLuqZxzX48bPz4MiRqwEAakuim6SADA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JIGIW20XxfQLGIyqgNRgkC0wMQxc6uMKJWjOVxLVZuA&oe=6A033C5D"}, "display_name": "Holotanks (BETA)", "keywords": [], "long_description": "Holotanks, a furious action game that revolutionizes the concept of the future of toys, is a truly room-scale co-located Mixed Reality toy tank battle game! \nWith both single-player and multiplayer modes, it transforms your room into a dynamic battlefield!\n\nFeatures:\n- Future of toys - tanks battle in your room!\n- True room-scale fun gameplay - adapts to any room size\n- 8 game modes to play alone or with friends\n- Remote and co-located multiplayer - up to 8 players in the same room \n- Rich Single-Player campaign\n- Built-in level editor\n- Unlockable tank parts and skins\n\nTurn your own living room into a tank battle!\n(and please remember this is a Beta version)", "short_description": "Turn your own living room into a tank battle! Holotanks is a action packed truly room-scale co-located Mixed Reality toy tanks game featuring SP and MP modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://beatshapers.com/holotanks_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Fortell Games Inc", "support_website_url": "https://www.fortell.games/", "website_url": "https://www.fortell.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7619404678188533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569457_1005703390526206_4811816033278719630_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRQXoATK2hIQ7kNvwEB3WsJ&_nc_oc=AdrlrIKBn5tXRNcT4PIY6K0ldQuuCVbPXi5pPiJurZxzL3L9L0uG-RDmfxUzKdZlfts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71oByoAz_PxH-3eGHfC0rKdnDUUzO7teqmutNp24nblw&oe=6A031BD3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Holotanks (BETA)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "4597815049
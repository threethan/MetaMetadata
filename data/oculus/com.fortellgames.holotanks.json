Cfmw&oe=69BD3ED5"}, {"file_name": "vlcsnap-2023-12-12-12h20m50s870.png", "id": "409410291410134", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974473_409410294743467_2352617692747153803_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-FNhA-ED2kQ7kNvwGL5u8w&_nc_oc=AdkUolVwocVUkPh9xXSS34AAV3ZuTj0jLK224Qus2Jaxug4EOtz97erWV7oAesomIEc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwqfMyyIEH5rNaqciohSUxqgB3wS-ROHPdCpLX-5y6qlQ&oe=69BD5C4D"}, {"file_name": "vlcsnap-2023-12-12-12h23m01s822.png", "id": "365460056036009", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982688_365460059369342_3966916388172683649_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMLw5J7d714Q7kNvwEqHRb4&_nc_oc=AdklbpJZ9B2_47gVkYeqD98vx6q0C5rEhzJDCx6k8cDj9SwR5s8Tq9nSgkk05jzpreo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQcGeTQNObwJOoPK7NG0ZQxzH6i0_m7hob_kdipvU7Aw&oe=69BD33EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_HOLOTANKS_Landscape_2560x1440.png", "id": "1474100426494212", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86604447_1474100429827545_434446056725707431_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n82nlOshXXYQ7kNvwHxuZsa&_nc_oc=AdmJ8kUPzYf4mPoDyZ5g9qW2m-sEIGFu59IHo37K2n7azLxivt2HNQxWSiZmaHQNnHE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqGaZrjZ3F_YQBBHmYN5LtW8FnXkR6vQ_B74uhJgt7GA&oe=69BD5CDD"}, "display_name": "Holotanks (BETA)", "keywords": [], "long_description": "Holotanks, a furious action game that revolutionizes the concept of the future of toys, is a truly room-scale co-located Mixed Reality toy tank battle game! \nWith both single-player and multiplayer modes, it transforms your room into a dynamic battlefield!\n\nFeatures:\n- Future of toys - tanks battle in your room!\n- True room-scale fun gameplay - adapts to any room size\n- 8 game modes to play alone or with friends\n- Remote and co-located multiplayer - up to 8 players in the same ro
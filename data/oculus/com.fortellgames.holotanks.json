823556327661_1984908988321581587_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmDouv4ahv4Q7kNvwG0KF6F&_nc_oc=AdpwA-mopPEGeSl6NycjB43c8eV0INSZ9ckLo9KID2Nhs4q3eL0WUS5DaqV-PpWzAsc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE30sMET-9XqbxwTBADko_Y20lHBjOdalTu76DwBhpd3Q&oe=6A82FFD5"}, {"file_name": "vlcsnap-2023-12-12-12h20m50s870.png", "id": "409410291410134", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974473_409410294743467_2352617692747153803_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPKx1ZWrcRwQ7kNvwGZns6f&_nc_oc=AdobcWSwpA5DKBf0qgdqtdT0uUPaPbxVM98iOc2iohxs7eqdncfMA3lFEP4xJFevWj0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV7DUUKiNfdI-BEkSSiJf5RjflY5T8d9dv9OaiAMN3Aw&oe=6A82E50D"}, {"file_name": "vlcsnap-2023-12-12-12h23m01s822.png", "id": "365460056036009", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982688_365460059369342_3966916388172683649_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EW1v3EQpDcQ7kNvwEABtKV&_nc_oc=AdpDWPLbtPCSzlk7NVzu_HWk77SNK4-Af4HQ65v8LAAOaS9lqrrLRRFI1OVlorxqdRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvdLB8Dr816jb_L0VpEtTuzpqQqR8Jjx5q2fB__gFT_Q&oe=6A82F4EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PUB_HOLOTANKS_Landscape_2560x1440.png", "id": "1474100426494212", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86604447_1474100429827545_434446056725707431_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPXxk14gU_IQ7kNvwERXigr&_nc_oc=Ado7xd0r_Na-8u_e8PcoXik_aUHQ50xz0wnKA58_uQAB2blzDx8_mH0S3G26dZOK__I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm18lRyg0bhlQokkXb_mBumq7tiwD_UqMPIKuMpmJ3sA&oe=6A82E59D"}, "display_name": "Holotanks (BETA)", "keywords": [], "long_description": "Holotanks, a furious action game that revolutionizes the concept of the future of toys, is a truly room-scale co-located Mixed Reality toy tank battle game! \nWith both single-player and multiplayer modes, it transforms your room into a dynamic battlefield!\n\nFeatures:\n- Future of toys - tanks battle in your room!\n- True room-scale fun gameplay - adapts to any room size\n- 8 game modes to play alone or with friends\n- Remote and co-located multiplayer - up to 8 players in the same room \n- Rich Single-Player campaign\n- Built-in level editor\n- Unlockable tank parts and skins\n\nTurn your own living room into a tank battle!\n(and please remember this is a Beta version)", "short_description": "Turn your own living room into a tank battle! Holotanks is a action packed truly room-scale co-located Mixed Reality toy tanks game featuring SP and MP modes. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://beatshapers.com/holotanks_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Fortell Games Inc", "support_website_url": "https://www.fortell.games/", "website_url": "https://www.fortell.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "7619404678188533"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569457_1005703390526206_4811816033278719630_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMdPuwinIs8Q7kNvwHmH82S&_nc_oc=Adr2Rfy0I0mLQnZfc2CnDbG3ZaLywKSJv07SkpOIa2Kkg8T-bR3XAOw62oUs2451DLs&_nc_zt=3&_nc_ht=scontent-
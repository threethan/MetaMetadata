t=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VRdiBMY3VxerLImatiH1SDo6_23vPeE-_cMIF6CikcA&oe=69F4C4D1"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5CwrsVHeUgQ7kNvwHpEXEe&_nc_oc=AdqrjxzV0wdKApCC4IwoE-6119bz2G-0CsffS6I5x9BRmqv1Bi_PIEFKv1Aoqvl-yFs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38MBYMbSCv-q5cJ_e5Uqjc3QGZBSE7KhO-s6A8N2g9hQ&oe=69F49564"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Luew-PiR_iAQ7kNvwEsnpDu&_nc_oc=Adp1zqGYHm3epfaS5NEe1EVFv6IC368Xd74G8aMgN1zbdXP6MgwBcqNCCLeSiLVGVA0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10DnKN0bW4i91z4weZ2TkAxgHxj10huEF2kFsmr7sOEQ&oe=69F4B278"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59Bh1HCctNkQ7kNvwEjfGv-&_nc_oc=AdrbHVrXXjGfjK4ZVFgQfx4OF5RNCes7Bdnkkzdq5QGvm1YN9gFEbNKrn85Nz-ZV4aE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3g64nwKB7fUyqtgjMBP-7qp8yCHtofoLTzw5JDRb3BIQ&oe=69F4C1C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCbvHp34CfcQ7kNvwGTBPGe&_nc_oc=AdpJ1oU0hcgfLlGiIiyq8MnwzhcxVVSm9NpgcDh-r9HUnGubKeKNmxx5bXBjR2ZqKAA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14u-HRsNHx0AFiawHsgwGeABsg5AxTn-cISI0uRR9PqQ&oe=69F4A091"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_me
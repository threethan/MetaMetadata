t=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af894VoTY6BoUUU1F0fxv1c2KTWZLf4HqYWgGnaqDRHYnQ&oe=6A26DDD1"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7jAjldFC9EQ7kNvwGImKm9&_nc_oc=AdprfD_iyMqI_he6rb-Q7aXwHQBBH0HzWfs74Ps4xPjSBsyRDgWeyF6A8jFx55TwWM8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sZU2DMbyuGOtTLvaZX-hRkhLv7Kn_DRyM7xUby4WsJw&oe=6A26E6A4"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUi6-EnMB6cQ7kNvwGfJSDH&_nc_oc=AdoayAKBUSgN-eFS8y69HKGimqMeSu0AkMQp5nab48VNG270m6TfiVHE88JYrGAuUTs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J1KGK7KV70NBled_HlWUwjDv9ah0soIegHg5hjIOJRA&oe=6A26CB78"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuRu5dQIguMQ7kNvwEB7OJ1&_nc_oc=AdqZX_AskokKpZ2YDkJXnNB3K6iHI_QWEAomBGbaeB2FNRJq_LALeSrocuCDoS8JKRA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Taygbz8e8Q70h72bibd591zhvNSyI1qNYPcEFg0uGvQ&oe=6A26DAC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUAto3eJz4IQ7kNvwFPyjgX&_nc_oc=AdrOApEpAnpCENglEypjAu_KFu1MxTpPEhhk1GWne-aLkgWdACH50Kbf--k7JqCj92Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WZ5BJdxG0AlUL964LQQ2rRq9-7vvRIZZTC__9MOu40Q&oe=6A26B991"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_me
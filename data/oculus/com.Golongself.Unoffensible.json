/38982662_981153003494289_3705471436597627387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HCEVQsThi0Q7kNvwFJLmrh&_nc_oc=AdpJwHRLR8SM7SJvZ-YZo70u7aafDytjatFRiOt_r0djtFp5OVgM4fuqshCRUL0C37k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOfurp1CBgNEniuvGYFVRGql1RkduYm0KhaS7Fwk0enA&oe=6AFDC251"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExLB03uEeooQ7kNvwFc1BNK&_nc_oc=AdqnIPXZje_cvyvsdww-bdbiBwDSwmI7F01SSM4irqXY_pldAliIDdwG9_x2DaAzvfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX7H_qKlOoShYsnizIxGwW5CNwKxA69tWExVldRsRkJQ&oe=6AFDCB24"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO90LwFeYKsQ7kNvwFK3DeN&_nc_oc=AdoRjXastG80bOKbj3s8oUskyEjdvJiOutb5licI-PfbilDVC3lzHqqRKOd9lr9nhBQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe0uhGbVAl5l54Q1jEhaddQOo8_1uur10hy6vP2qkHfQ&oe=6AFDAFF8"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oitEv32S8uQQ7kNvwHBCsSO&_nc_oc=AdrE74EGugqdRre4VCL5O5q68yjZDhErnQAWQSGg9hg9ZGOhvHMbYYvkGCxMDH9JYlU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo3_jqJ08MWIHOzO83Xku1KKXbvx5iblM3nrkhjw3SPA&oe=6AFDBF46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEWPS9VGwV8Q7kNvwG8awhG&_nc_oc=Adr7Pcz_GSKNT12qSk5BRvTl32YKe8ExtkgVHUy4R6WNQIRzOm3lcLRFmanFlVqXJSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyWH1pqRnBrnlMRNX9nHXfd4xqZXRKRW-_5u9XFjB5wA&oe=6AFDD651"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
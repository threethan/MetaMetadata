t=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8IBwuF8axSfDIZO8DhQljv1J_NFW0Fo_10qs9wdz5ag&oe=6AEC9ED1"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWGvl2aEGAAQ7kNvwH2zLMn&_nc_oc=Adpe5dNfkeYisC97mlK_W-kwn6LCpBNxsI06GYUsZBKJa4M3i0h424kLum8obOrA66M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaYWqGBmtFHPvu79iZ_SZecFzFefIi02zRA-OYrKAdjg&oe=6AECA7A4"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwj_DOuOUwMQ7kNvwHLnPsH&_nc_oc=Adpg1PfjU4BOFi9JtSadvr9FIKPKTxc_rMsC8A3iRx5BwsGfVH6AJrgu2Yekmv3AsAc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfCiNx4Os6BkqoGeXbxJP6qZ-WFoD-0wPyGCzV0Lexdw&oe=6AEC8C78"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOHeubBF3oQQ7kNvwHNIwOw&_nc_oc=AdrW21cAbFNVz_4rPlo4da3vbujldMcUwwL_4meMJL8DvE_0BmMlh08CvYjq2EMy2rw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMsHBWBWgBOwSdzW-YEPJ2UqUUySFu_0_rhssLirH1fQ&oe=6AEC9BC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBZoaJNLGBkQ7kNvwFv8zyF&_nc_oc=AdoP-1PWzmgG8cAKhYceB2nCUJyCAzBHslrih65frCoEG-Y5fCBFMaWgARvYlX7ZCfA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfEDWJv9qzobGQHlmn7IO22ns9vNtrV6nJQqqnfFgU_A&oe=6AECB2D1"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_me
t=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6azIuGk2bGmD4DvjqB8dPdd3g73q7v0GDEqmj3JaOnDw&oe=6A1C51D1"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDnZ25o2Q50Q7kNvwGcIVb_&_nc_oc=AdoH09wH3sdH0zlDSbdtZ99CXqq_qwlU74giHe_s5hqP1Gt20MfuUfpX9mmTY3XX5Wg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yod5V-tdr_3MOFDjXHt2yIZPO1ceK34RlpcQ9TfUXYw&oe=6A1C5AA4"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLLVWyD4QeUQ7kNvwHnblkA&_nc_oc=AdpO4wx69luwEjw2IX7sCbEc1TOqTVq8NkmEtPvep1W_tSEC4mklqL_p1Dx9KbblLeE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZfdA0SPxgQGOpwGi_1Wj4FsVNzaf85eQ9w3QPWtsAjQ&oe=6A1C3F78"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwqWRMUji7QQ7kNvwEmKpKs&_nc_oc=AdoAsEt0FJ2wtmPqKvt0eVh8q9jRFMKAqhw4g0wLvKjl9cDIn6OCyLQKRfuTwNga-vA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ucLE7GeRqZiy74FJbz0U67zQUBZmJWcppimPjC2xZjg&oe=6A1C4EC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pof4LGy-CjgQ7kNvwE0Xl4q&_nc_oc=AdpkIM1U_Yj6OkDdIH_7a-4KIbp838sgv57CQHR2r-6MRHjGc48RS038qcyJGPUWqrs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af770UWPozkeJULXc-shkTrPLhNQt_8Xh6Rg6mAhNla9cA&oe=6A1C2D91"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_me
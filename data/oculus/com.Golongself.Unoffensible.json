/38982662_981153003494289_3705471436597627387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvT9dFRH4XMQ7kNvwEfrbxA&_nc_oc=Adra8ftkrS3_Y5vDrIFztR6_ua6W3uRB-1gymxgFupCFzngG09eofsAssQ5pUpl5Kfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU2DHw3e2bAVBQNONuEF2xr2QYxq1mnyyjf3olUqfdyaw&oe=6B103751"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlZF05aKxR4Q7kNvwGsGepx&_nc_oc=Adp2B5ZhIShymK14Cw0di0a0Q3CXrL5fN-Q0ejqlmek_ffQ98QAVOTuolH80HCEYv04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWIVDWzv7F-L_x5JJBwKudEJm2YJDFD7zsOUDVxmibCxA&oe=6B104024"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmRy5S45P1QQ7kNvwGGVuQG&_nc_oc=AdoCsOR4P2Ov4uESFMOR9xtmhmSu8NCT_UGES9lZMlB19sZ0pnG2lss6EaNJ-KLtLMc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVWkCTpEZyfSZNgrhnnsL2KlwivNtLGuVf_mpkLpk7bCA&oe=6B105D38"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPNOC73Vi08Q7kNvwEVptWz&_nc_oc=AdpiiXVgYbW9GUSncz1Zw0AjR5Sax9sD3bdvs9C5rTDlqxkoeP_DLk4IItZEuNCC19g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJIpPEfAs1YHAaVKT-Toi0GIRP81fsRVdqCrLol1EVvA&oe=6B103446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AwNJy1iY_8Q7kNvwHZb6Zl&_nc_oc=AdpR58bFi8HVLhm9qjdEUVWXA0BhGdr66tjY3FthZ_fdfrvdsKk6Dd_px5T20LmszNM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUPX_MmUGiKLea85sGuWPTjuU0p703n-7a_49QGmAPJrw&oe=6B104B51"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
t=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt0sLwqc2qpZ5XzjZLgoUIB1g1kfBpX_gY3J-TeV_KwQ&oe=6A5B6191"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-zvRr0QSfwQ7kNvwHP9Zr3&_nc_oc=AdqNif2YqW29dPImWMJtwojxAQnf8TC3HpdbCt5_n6YwNe4pHKzs8yHuKsK8_Nev4X4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLSm-5O5s5J8zVrllbXYnhbwHzc0WXgCouilWRHechfg&oe=6A5B6A64"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xC65YkNqe1oQ7kNvwHVuTbk&_nc_oc=AdrSM0vWbVzkdWwBQqRUjUllXCzMr8WS2yqVUzERVc-W2U5ZIpf8VwIO3TtjhWk_MdY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYYdnHrySCpqTiSYey20ps3rNbSfNb6CTvnIBfgHGCMA&oe=6A5B8778"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH4tiX0TPcEQ7kNvwHtDEPV&_nc_oc=Adp-VdmpS3Wt5nKzdIRCmi7KvWJMbo87DPuLYwXRYYZwkh5pkG0EqZ1ix6SwpjE3sFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOOi6U6LzGM4k9gwj1G7YsrSM3WfF-KoXcKmBvT2uFxA&oe=6A5B5E86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Czlmty3O4_EQ7kNvwE6zOrw&_nc_oc=Ado_h6C-7RyzcEnjguazNnqduegJ97qywZAj-t_fB0TbYRqvCSbwPPE-oElxjqdCgH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAexNTm4eoVi-X8ZQZLEJ6NBtQE5tWJxUqyoxcqkh5SUQ&oe=6A5B7591"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_me
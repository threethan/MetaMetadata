/38982662_981153003494289_3705471436597627387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c60G_AZCLsIQ7kNvwGNpckU&_nc_oc=Adrw7OIGlQRQSxazeIJkfsSROL2mcXMP_YBv_Un4QSha60OVCLqHK1Uqi4xNb9_IP9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIIKojiWTRx6oJ25qS5lRJonuG2Zrywi3sm2mIvy3jcQ&oe=6B05AB51"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlJLn3zKzr4Q7kNvwFii_aZ&_nc_oc=Ado_EfI2OzFS8wMCE5_Re0WUD8D22GqTiq0xfcswHS23nsVQcP8PO8Q_FezIgQLsO80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwvSi6Rn2bRaR1sQUPLWjwCixMUnpx1XlNFTj_eEva-g&oe=6B05B424"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBcV9n29HzEQ7kNvwEYZv1d&_nc_oc=AdpIMvKGcG2IfPtSTC6r_RDZq90hnrVcs6SuYhiyH_l9cKx89np_J36IrPDpuGHnM18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSp2UQiCxB9TJPlnAfFuzujdPvDptehV6U2sCyb7XkYA&oe=6B05D138"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4hiJYVN2OkQ7kNvwFRZnSE&_nc_oc=AdpJM0gbPTmzmbzD-Ex-ZgSL4X_8jqLGt8M5UHocO9R9YnAFxlPF5AGO6pt0ap0lgU8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAjDR5uQYtkBYyRePgCWoReISoIcbMyeT9pzr3KbycuQ&oe=6B05A846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB0BBVLObOMQ7kNvwFfkjsl&_nc_oc=AdrNCkdrdsXdWNk_cY_3PA5FNeJdI5gy8lcv0bQrrBFPExteufOGMOXgewBItWlu6NU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt6QB2NEXEZ4w6gWUvnVb2QQwwqbceK0aYhXLGbdVUEA&oe=6B05BF51"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
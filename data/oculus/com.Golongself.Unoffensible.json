/38982662_981153003494289_3705471436597627387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXMOhEYmZ4QQ7kNvwGW5cLn&_nc_oc=AdojCUJC-LXndfpiED6vhfWgbooztZgejUAcQ5ZT3aKvtLDnFglMuv9SbSvvH-UlRXQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL6NSuRlMU7updTqedMsr34JfVX1mjy6yXHP1C5t4KyA&oe=6B084E51"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABf9UojC25MQ7kNvwEb5YPl&_nc_oc=AdpFaJs-8imzi6f18Lhb92MyKOl0zeWT1m1i1EviBEvGKm1RSZcHn0Co9_PJusDCuuc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUZuH4lTyt4d3Z-nhV0nNAxzBQ-H4Z4Eb8YiTnvjCVjQ&oe=6B085724"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgskiWtMfOUQ7kNvwECh4IJ&_nc_oc=AdobzvQs2ix3Rj1suUTK8l0t52mOoUuRDKl2boyFdj3ghrJHiZHmle-5s2F5gIbBoLU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ7aewZ03ALNHaDkw2r939QERx78ITITd2HLRO2TTCjw&oe=6B083BF8"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oJcrsQPn30Q7kNvwEhleqo&_nc_oc=AdoPRNRrkLr7bR6NlgrwX27jeAJwxhT3Ys9Ch_SxCIQdWoyY27R2a5qDKYRxsX-xU4U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReLK0V4SdHkVP56P40raYPbEIhiAEXngXIl5Mwn9M-Aw&oe=6B084B46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lf2bLIRgnrIQ7kNvwHSRlXo&_nc_oc=AdrEEK6SAKU75DlQqMqz7iS0nSUf-YTrS689hE6ITFLv2ZzaHYf03Z45Fo0IjL8c17M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnhUbkbtL1e4nkKtaJyXH-RDNywuukIipOpC-jn1JLLA&oe=6B086251"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
le_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSw8OSMi1LcQ7kNvwGlsv1c&_nc_oc=AdmniYQvtaBSY2epUtvJUXHwiuJtJbrTmFumb6j7ElxfIFylJ6TkWjvSL9LevfYZ3IM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftQZwKn1bkW6sWDYOzYBOfGNFz2xFmakQnFMzhQf9Rh2w&oe=699AEF64"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-CiFPhFGugQ7kNvwFBqBCb&_nc_oc=Adm4w7T2LQdplr7E_BL0994-lX1wqxDzDdWZVznrIJAlbxJTltbI98Y8eVYkYZ4P-cU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuFN31O4GP7v8QQ7SnPX4vRbmqFIHMOD5EeiCoVfU7Jjw&oe=699B0C78"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPrrElfz1C8Q7kNvwHKAc4_&_nc_oc=Adm3P0LNvH3HF8IB0RuJqRcNGO1c83IIqyQ9CiuROcSdkdLovEgg6oMFXyvqFSPwr7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvpiMOwqQaah5sghqWd0_KvFElt2_0EqM2knK6Q3WmD6w&oe=699AE386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2JCSrtLEbkQ7kNvwFqEpmr&_nc_oc=AdmOJd2Yj-9NvsxAtti9y43BkYttNWogf5EDM62RArLlkKQ1PX59ndf44We3ycMjy_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNMVOwqCrPTMVVvfDc1vZNtkcIypHzi27EbwY65Smilg&oe=699AFA91"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031508_336210142894463_2122759765850544447_n.png?stp=dst-png_s360x36
/38982662_981153003494289_3705471436597627387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c60G_AZCLsIQ7kNvwEcIeP1&_nc_oc=Adq-fDasp0pYJ16DWCa5SgdrF2X34wUi_o9GSLDbvwdu_zBbhChQvjt80wzA9evAFnQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHyyyqKT47rxUP2yk8PQ1w_7rCcznWfBD8yodLyKJetg&oe=6B030851"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNcLaF4Y7FEQ7kNvwFFFtiU&_nc_oc=AdpMjfR0ZJ-v4buj4aq5PBUOIYv70PnQtIbhG6Bzu7InsUJdXeaGKxm8HjDqcLX9Qxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO3YwuQL5nNgeYXCK5RnvGn0GgSJVj-4nvps9FdUHpFw&oe=6B031124"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBcV9n29HzEQ7kNvwHpzw2J&_nc_oc=AdoTUborJCgPQZDsyAhC3ZH8e_LrcxFItXnsrpWww7mV0fdL8Ao-OKGRrDnH5CYNGMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq84TZjOiZS8ZAFXYRLEluYSDfYGoTKirE16-yOB6TnA&oe=6B032E38"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4hiJYVN2OkQ7kNvwGj_A5w&_nc_oc=Adr7tO_AGtA6sFg3uU0deJIdWLQ2DUWCNlckgbpV0YyNPaQbRUy_o0x5xNdZzZ6L_cI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLmmXnpG92jzAV2XEZ0kNMyfKB3EsidomiV28KteFS9g&oe=6B030546"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB0BBVLObOMQ7kNvwHxKsDV&_nc_oc=AdqkAlA2rBCRctLs8BLtW4Emoagi_65s4ukqnviPptihkNBNzHZAX4R3V8yoIZR8idU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQafHMM6l3A4iX5odOebc7tgXbNF-MUQ2moO_OpDUbLtw&oe=6B031C51"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
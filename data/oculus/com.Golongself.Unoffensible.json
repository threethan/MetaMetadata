/38982662_981153003494289_3705471436597627387_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXMOhEYmZ4QQ7kNvwErY1rN&_nc_oc=AdpvlvuCEEH2QvUw8Q3ULy-nm3y1NE2zERZlXsxkXG-CRFfpge_wcDCK-E6vxXNV1GE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlaGY3xidBzcoNax8zqjcAF-rzfYeQ7GIuzINF8pZeyw&oe=6B099FD1"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABf9UojC25MQ7kNvwEDqLzG&_nc_oc=Adqs0Slv95BguKMP5-ZI5o22vWvqNjhxpNP1PNpRMLyU-7SbNQYBgVkft1n8yXGyJco&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTTVknpQme-Fyva8S7WWVSuERkkC7yZ3mAvmDa3CzeCw&oe=6B09A8A4"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgskiWtMfOUQ7kNvwF6D3Ph&_nc_oc=Ado-4tbXzCLSXmnEd9AeGNj2LtlHM4_DWUq3pnU0VQN5hkZl-0OyjAiv0gjzi7OFHk4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6IFiTN05vN8w_brv4EPMUzDdpwWQTmbkLh2M0N3YLpg&oe=6B09C5B8"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oJcrsQPn30Q7kNvwEarayD&_nc_oc=AdpsGWuJm-s_vG7dbozv2jA6w-GilXSqjgWHI9CkdwKKgSCI5Jpfsr0ApmEnUj6jtCA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxmJlf47hDb7wiMCWgyXzVcqsZc80Z-poF_WWcnqmm9w&oe=6B099CC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lf2bLIRgnrIQ7kNvwGI2uFn&_nc_oc=AdrFkwfdvNSRyHob2QHgKZ-QeiD8_ZQr-Om2Hf6hEJzxsQ5KFmMLiUmljFp5N48qLC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuuD5Q3d6vYm3wdJ1ayV0yppoMT8E9VBb5mcfLaznCZg&oe=6B09B3D1"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_g
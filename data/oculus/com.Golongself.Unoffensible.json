le_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4V40uPW7sgQ7kNvwF2k50W&_nc_oc=AdkMWTXBZsdmYIeVIUxGMSfMQwqH9uo5_MvqKSJ88t18iVxpmZ9_k8g6KNPQ3se3pug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvF6qZQjP3SpMOMIDVJfd5v-yDouHvZcRHiRxi2s466Hg&oe=699D9264"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-CiFPhFGugQ7kNvwGNiPhj&_nc_oc=Adl_XuCj_MuFysDlNmK4ZYC7hMntLjiYQ-BLtAOa5ZfEBgsS94EZwTgCVbwd_LXGmYw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOWiQnzSj6b-49SXu6fhDUs294CePzjbyNb3sDTRNc7g&oe=699DAF78"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPrrElfz1C8Q7kNvwH1zAxy&_nc_oc=Adld53AtrG6z6Eh4QWUG6qYPrYIVXtDrmhYEWt3uuCFYRE23fQ5MsRvXNrFlHRKHW8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviQOklmJs8rm61z9TZ9az2euWPC6ReZzALxs18W3Fw7w&oe=699D8686"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2JCSrtLEbkQ7kNvwGComw_&_nc_oc=AdlFfwhxeMCtK9qm-noyDaSrqhOkqe5BV96-3SJFu6tQZrJVpl1nmJsYKYXe2Pxz_fY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsr5uGhzGacD6jWztsGk7Gri6T_BbK-W07gvWRtodZNzQ&oe=699D9D91"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031508_336210142894463_2122759765850544447_n.png?stp=dst-png_s360x36
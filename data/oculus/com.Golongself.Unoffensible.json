n.com&_nc_ss=7f20f&oh=00_Af3wMGDactlhxrpSNadmi2-2GjIYr-YUIHbbnE8r3Hc6Gg&oe=69F1E991"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjpOlw6GUv0Q7kNvwF07lBa&_nc_oc=AdpLEqWwGkWV4uRqL4wKhZmAxrPlFjXdNoESeYs7gflAaCQTdqqa60efofMxdDzhD3Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3U0xoGU0nZYdptvCZrbgrA17FafhXDZedv4qa6IYye8Q&oe=69F1F264"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Luew-PiR_iAQ7kNvwEs6QWy&_nc_oc=Adp5wpYKeoNYpAbaZ_DyfUGRbHXogx7q-kA-weiD3VP0PAsaslnmwftQ32wRJT5ay-E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0yYjN4baAEc0TaKl_VgdfKQugz2wgDTX547pQ12pQ3lg&oe=69F20F78"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59Bh1HCctNkQ7kNvwG-vVza&_nc_oc=Adq4ucJm3ZuHW1HJFubPYVbpNL6LL8IQ_WD_Q_kuUuEgwM-GBiDJSoE349ZXQK_Sj8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1HvocXjA3ums7EkFA9XAOVYS2JYlmOL1XRn3RuLos0OA&oe=69F1E686"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCbvHp34CfcQ7kNvwGUbic2&_nc_oc=AdrbP7IRb6wqFCDQPRODtzgXlo27LArshaBEBTHf3GbzfLe9uukcHLUuJ8DM_Kta_qc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04yNpMf-0vpYGGE2QmaEp3uv12gyt6-DsR5sDQWLopwQ&oe=69F1FD91"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_messages": []}]}, "cover_square_image": {"uri": "https
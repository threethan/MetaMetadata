t=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hvQQ4-2AGV412XiWJ0RGGiwER2iIht6Z5e8DzEePt8g&oe=6A32BB51"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4SLCzjXfW8Q7kNvwF4uceD&_nc_oc=Adp20Xsm39__VfCaCbWPUAYqmdvRM5-jUd3-1gb-gG78NeA0Ks4iBa54RfgqJ2yjpgg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qvcogg31jntVEtelpoSrHUY4kW8C7uf4LhuoZpztv2A&oe=6A32C424"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rx1FWGj-LwQ7kNvwEVqqNE&_nc_oc=AdrAC8F-pYbK-L55Uyk8jWmXz00bW1C1-ylcw-zFKXA7mamXqK6fzmOBHYF2nFIZtH4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-avMCelJtrqbQQ8eVkFycNJT-HRBlWijmpFyBldFSBTA&oe=6A32A8F8"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2gd1892uQ0Q7kNvwFyidVJ&_nc_oc=Ado_VXdoi0hj0XXvbMJkgad3VUby14GZuOSrapoRA4Ff6l143hFd2o6WhbxntuFIyhs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hXP-KsK6uSnsASXO3dVQ7Vn0xWsXBL70iPaaA6JQEIg&oe=6A32B846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUX5Q3XKnYIQ7kNvwHwhM9X&_nc_oc=AdqvwoCttX8xs_TRjnHVRbnuo_gnV2WUzCVyA0TbUOiz6Lrkgcem2w6N_MNePACE2Z8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rtugm29M4k6JstWwrSQMh5RT33wQgV79c-Wp7XC8-Ug&oe=6A329711"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_me
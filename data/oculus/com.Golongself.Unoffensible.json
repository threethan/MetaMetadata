t=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRUwKwir0Y_gQRNkPSpFDSb-bOtBrNdrSAkLXwmQ1ujg&oe=6AC511D1"}, {"file_name": "Building.png", "id": "1475189556699097", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462204_1475189563365763_4176848186611239712_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=324dsjQNp7gQ7kNvwE4-jXY&_nc_oc=AdoSerovcuepuK1TSxT5oZHbH7mc7eLK4Z9fdZfnI9yphWK3wpnFQx1iR09PXrqE-7I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPa8B3cvOQi43eeRlLSNRpdiu1z-Zl3J4g2_ymzuwzyJw&oe=6AC51AA4"}, {"file_name": "OverviewBattleFinalDemoMission_2.png", "id": "822690069500505", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340708_822690076167171_8100936849385053388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5q8cP1tJALQQ7kNvwHu8aJs&_nc_oc=AdoEvnUtbJIi2U4ZtEoh2ZFgRdzjbubrkRE9JOmvAIhhkNpRrN-yopkZJU97-dj_H_E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7EgC0Nm5eX4-us3Bj-k-Ct7k5jIcwtsI8oNKQhnRllw&oe=6AC4FF78"}, {"file_name": "Mission1_Airsupport_CloseToTerrain.png", "id": "511665811210366", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974820_511665814543699_4057157697723389302_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQThA_O-OhMQ7kNvwHFpefL&_nc_oc=AdrFjDNFfwPJJvPYgp36aChn6z5q1O11eqxoaF-sUEU_ZJ1_bwo4xP6ux21ow7czyLE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMilaBAx0nGCnB-eQYgc123VZj88Q-qMwv3PD2vHn7n0g&oe=6AC50EC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Landscape_highRes_demo.png", "id": "1216624106004579", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57569468_1216624109337912_3069334669929622439_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGUi0GxBKbQQ7kNvwHoMmFt&_nc_oc=Adr9SQLVZDLPyKl4w7kVnoQQcWOjg2fX5XJb9iEjAwgj5thhuV9Jw2_9jl9QSEJW86w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHllB1Z-HTI6Kc1R7iT3CGQHEz5MIyoWwcZF8EgK02_Q&oe=6AC525D1"}, "display_name": "Unoffensible Demo", "keywords": [], "long_description": "# VR RTS\nA classic RTS in VR where all projectiles and units have simulated physics. Move your units by throwing. Stack units to increase their power.\n\n# Features\n- Build for VR only. With unique VR interactions\n- Campaign/Story driven RTS focus on single player\n- Physics based. All projectiles, enemies, friendlies and neutral items can be grabbed by the player\n- RTS basics : Fog of war, Tech tree, Base building, Superweapons, Resources, Cutscenes, many weapons & many enemies\n\n# Current state of DEMO\n- The demo is of the current state of the full game, so as long as the full game is not released the demo will receive updates to keep it in sync.  \n- There is 1 tutorial and 4 missions in the demo\n- Game state is saved after each mission (except the tutorial), there is a reset option.\n- User feedback is very welcome, both positive and negative. ", "short_description": "A classic RTS in VR with simulated physics. Move your units by throwing, stack units to increase their power. Gather resources, build a base and an army, expand across the map and defeat your enemies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://golongself.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Golongself", "support_website_url": null, "website_url": "https://golongself.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8084777771554102"}, "review_me
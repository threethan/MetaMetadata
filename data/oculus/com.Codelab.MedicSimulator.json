e3dEejyDFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9CqqkBCdR4NYyOaR-3VMdh6N3xfMmFHLwTEf7zrbkKw&oe=6AE9FA25"}, {"file_name": "Foxhole.png", "id": "922525707092159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_922525710425492_9090777458754824664_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ4rinaa7fsQ7kNvwGeUe2n&_nc_oc=Adp1jmW5bJjsC0RUibqQyNfwEWAgxN2JzmBfgk_ajzfV6hYjxuSTpAjv3n8LG1CwhcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW1NbE5g89DBeaR_O9RtgriF_cJqTu2HerxCN5RXkrLQ&oe=6AE9F976"}, {"file_name": "Mesa.png", "id": "932717379171710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_932717382505043_1174049782395313511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev9Fow5mEscQ7kNvwESvgqa&_nc_oc=AdruKXVHIQ79FM_lY6KOj8Ysl0r0_FG5vUECtgDSQzXtpJ95ZqZrzQLbuoJNQG8SpU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrZtb_9ib5NhCEXDZHIfD7Imqq8skEg6l1QBdfCfiasA&oe=6AE9E0B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1565709507977916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307602_1565709511311249_93627922877244587_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArHHh7MQe-QQ7kNvwG9zhKv&_nc_oc=Adr3we8JbAoFAcQn47COizOr-HJywFetl4bYuOFPx1wqa3TQKTuL_fedpBrNwFRDGiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThZ4BjkezIlKq_Z3pmKSzc06LS5yjBtfTnU2u1LuuRvA&oe=6AE9DF2F"}, "display_name": "Medic Simulator: Combat Zone", "keywords": ["medical", "medic", "simulator", "war", "battlefield"], "long_description": "Medic Simulator: Combat Zone is a VR combat medic simulator where you save wounded soldiers in an intense battlefield war zone. Experience realistic military medical gameplay, rescue missions, and action under enemy fire.\n\n\u2022 Stabilize wounded soldiers using real combat triage techniques\n\u2022 Remove projectiles and foreign objects from battlefield injuries\n{2070322246856366}\n\u2022 Perform emergency procedures at a forward aid station\n\n\u2022 Stop severe bleeding and control hemorrhages\n\u2022 Apply tourniquets and bandages to critical injuries\n{1516915666731488}\n\u2022 Transport patients safely to the infirmary\n{1280186824287822}\n\n\u2022 Administer aerosol medications and emergency treatments\n{2204049320350272}\n\n\u2022 Rescue injured soldiers under enemy fire\n{959281126733348}\n\n\u2022 Search for the wounded with ambulances and medical teams\n\n\u2022 Defend yourself and reload weapons during combat situations\n{1000479572338199}\n\n\u2022 Complete intense VR rescue missions across the combat zone\n\nIf you enjoy VR war games, medical simulators, military rescue games, and action combat experiences, Medic Simulator: Combat Zone delivers a unique mix of combat and life-saving gameplay.\n\nThe battlefield is unforgiving \u2014 but the adrenaline is unmatched.\nAre you ready to answer the call?", "short_description": "Medic Simulator: Combat Zone is a VR combat medic simulator set in an intense battlefield war zone. Rescue wounded soldiers, perform emergency triage, stop bleeding, apply tourniquets, and transport patients to safety. React to unpredictable threats, defend yourself under enemy fire, and complete dynamic rescue missions. Experience realistic military medical gameplay in a fast-paced VR action simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-medic-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres"
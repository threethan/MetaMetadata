cape.png", "id": "1565709507977916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307602_1565709511311249_93627922877244587_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrWv7JJK6zAQ7kNvwGTjdhv&_nc_oc=AdpgJoWzRGOdQtVqEnBqv3vS8iV6exri46paw9vYou-HGqQk1wKJGBNNBgGhdJ91WJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y9yOPYZUw3fvWbTWtlkje24EZnx9x3NUTR_2Y1iLvFw&oe=69D3B2AF"}, "display_name": "Medic Simulator: Combat Zone", "keywords": ["Battlefield", "Medic", "Doctor", "War", "Simulator"], "long_description": "Become the frontline hero in Medic Simulator: Combat Zone \u2014 where every second counts and every decision can save a life. React to unpredictable threats and engage enemies when necessary.\n\nDominate the battlefield with precision and courage:\n\u2022 Stabilize patients using real combat triage principles\n\u2022 Control hemorrhages before they become fatal\n\u2022 Apply tourniquets to stop severe bleeding\n\u2022 Perform rapid procedures at a forward aid station under intense pressure\n\u2022 Remove abdominal projectiles and other foreign objects from wounded arms and limbs on the battlefield\n\u2022 Administer aerosol medications such as antibiotics, anti-inflammatories, and antiseptics\n\u2022 Apply bandages to wounds and burns\n\u2022 Transport patients safely to the infirmary\n\nGo beyond basic first aid and operate as a true combat medic:\n\u2022 Rescue wounded soldiers under enemy fire\n\u2022 Work alongside nurses and search for the wounded using ambulances\n\u2022 React to unpredictable battlefield events\n\u2022 Engage enemies and be ready to reload your weapon\n\u2022 Take on dynamic missions while searching for the injured across the combat zone\n\nThe battlefield is unforgiving \u2014 but the adrenaline is unmatched.\nAre you ready to answer the call?", "short_description": "Rescue wounded soldiers under enemy fire, control severe bleeding, apply tourniquets, perform emergency procedures, and transport patients to safety. Use real combat triage principles, react to unpredictable threats, and engage enemies when necessary. The battlefield is unforgiving \u2014 only the fastest and bravest will save lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-medic-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34087880360857570"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "818308363864570"}, {"status": "PUBLISHED", "id": "2008042326412377"}]}, "baseline_offer": {"id": "2008042326412377"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "818308363864570"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34362284120083858", "version": "0.5"}, "id": "1260631922618834", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33805644802414462", "is_concept": false, "latest_released_binary": {"__type
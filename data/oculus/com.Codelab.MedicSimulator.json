0_AQS9CqqkBCdR4NYyOaR-3VMdh6N3xfMmFHLwTEf7zrbkKw&oe=6AE9FA25"}, {"file_name": "Foxhole.png", "id": "922525707092159", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304106_922525710425492_9090777458754824664_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ4rinaa7fsQ7kNvwGeUe2n&_nc_oc=Adp1jmW5bJjsC0RUibqQyNfwEWAgxN2JzmBfgk_ajzfV6hYjxuSTpAjv3n8LG1CwhcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW1NbE5g89DBeaR_O9RtgriF_cJqTu2HerxCN5RXkrLQ&oe=6AE9F976"}, {"file_name": "Mesa.png", "id": "932717379171710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_932717382505043_1174049782395313511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev9Fow5mEscQ7kNvwESvgqa&_nc_oc=AdruKXVHIQ79FM_lY6KOj8Ysl0r0_FG5vUECtgDSQzXtpJ95ZqZrzQLbuoJNQG8SpU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrZtb_9ib5NhCEXDZHIfD7Imqq8skEg6l1QBdfCfiasA&oe=6AE9E0B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1565709507977916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307602_1565709511311249_93627922877244587_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArHHh7MQe-QQ7kNvwG9zhKv&_nc_oc=Adr3we8JbAoFAcQn47COizOr-HJywFetl4bYuOFPx1wqa3TQKTuL_fedpBrNwFRDGiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThZ4BjkezIlKq_Z3pmKSzc06LS5yjBtfTnU2u1LuuRvA&oe=6AE9DF2F"}, "display_name": "Medic Simulator: Combat Zone", "keywords": ["Battlefield", "Medic", "Doctor", "War", "Simulator"], "long_description": "Become the frontline hero in Medic Simulator: Combat Zone \u2014 where every second counts and every decision can save a life. React to unpredictable threats and engage enemies when necessary.\n\nDominate the battlefield with precision and courage:\n\u2022 Stabilize patients using real combat triage principles\n\u2022 Control hemorrhages before they become fatal\n\u2022 Apply tourniquets to stop severe bleeding\n\u2022 Perform rapid procedures at a forward aid station under intense pressure\n\u2022 Remove abdominal projectiles and other foreign objects from wounded arms and limbs on the battlefield\n\u2022 Administer aerosol medications such as antibiotics, anti-inflammatories, and antiseptics\n\u2022 Apply bandages to wounds and burns\n\u2022 Transport patients safely to the infirmary\n\nGo beyond basic first aid and operate as a true combat medic:\n\u2022 Rescue wounded soldiers under enemy fire\n\u2022 Work alongside nurses and search for the wounded using ambulances\n\u2022 React to unpredictable battlefield events\n\u2022 Engage enemies and be ready to reload your weapon\n\u2022 Take on dynamic missions while searching for the injured across the combat zone\n\nThe battlefield is unforgiving \u2014 but the adrenaline is unmatched.\nAre you ready to answer the call?", "short_description": "Rescue wounded soldiers under enemy fire, control severe bleeding, apply tourniquets, perform emergency procedures, and transport patients to safety. Use real combat triage principles, react to unpredictable threats, and engage enemies when necessary. The battlefield is unforgiving \u2014 only the fastest and bravest will save lives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-medic-simulator", "developer_terms_of_service_url": null, "publisher_name": "Code Lab", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
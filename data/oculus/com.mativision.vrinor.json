.com&_nc_ss=7f20f&oh=00_Af-vqLUrgZ3-PMwz1WNqyM30FifKagLfmmM87JJmaiJDwg&oe=6A22D4A5"}, {"file_name": "migrated_image.png", "id": "207335037164985", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162685_136362513671092_8803515468724830208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVAxYtDnmbgQ7kNvwFe10WF&_nc_oc=Adqd-UAjXu5TGGCicXHz3YIAqMu3fJrNmdMFFi5ENjlw3fhwr7T-tL---vNVtfwQtKQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BImK1KhcY9661GDw8kBxZBZlsUxM-OUkgHHrQSZNC2w&oe=6A22EF39"}, {"file_name": "migrated_image.png", "id": "148858716379466", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138839_1684592765129086_854230490_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wSO7MPRxxQQ7kNvwHa3hEM&_nc_oc=AdogEBS9URPllsu4U9vOpDd1uvXScolhGtMtyipD0GOeDnvequgA6fd620y9cpt0sCU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BC7NfPUwlzdd_J84_aTqoudrc8Pk-CosKh5Rzz9vBTg&oe=6A22EE99"}, {"file_name": "migrated_image.png", "id": "137580661030085", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522306_345402529131901_7157233952749518848_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_-2I_92lZUQ7kNvwHLzzdN&_nc_oc=AdoS3yrHC1jCCOrIhFjnVX_qW1mSIM_Fi4bb0mME6M5Tu0BRbutkigau9l2rzo2CWc4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IV4BwNR6F_2xRvTsAHmy8aVtEWFjb21f_wiz4f7T1AQ&oe=6A22FD00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VLIPPmed", "keywords": ["medical", "operation", "vlipp", "surgery", "vlippmed"], "long_description": "VLIPPmed\u2122 is a global platform that uses Mativision\u2019s proprietary VR technology for good, helping healthcare professionals from around the world gain access to immersive medical training by experts in their field which leads to better treatment for patients, no matter where they are.\n\nThe platform allows everyone to virtually be in the operating theatre and watch a surgery in VR either live or on-demand with multiple interactive user tools.\n\nVLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training.", "short_description": "VLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mativision.com/privacypolicy/", "developer_terms_of_service_url": "http://mativision.com/tos/", "publisher_name": "Mativision Limited", "support_website_url": null, "website_url": "http://vlippmed.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998143494107440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162686_330342350710119_1968130542478032896_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2iq2CdV2YAQ7kNvwHr0Hrh&_nc_oc=AdpMkSuqglprd7aXD7Gw30Mvq_AT199KVObx3yp9DYf2P9a3cMHXWIMXhKFKjdBq_g0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SdWEFNzagqF5Y_3zYjp4ULaqOAi-d7JSdEN3X58e0VQ&oe=6A22CCA7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VLIPPmed", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460444400, "lastRevision": {"nodes": [{"id": "1716308185256898", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9146
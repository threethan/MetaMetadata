.com&_nc_ss=7f20f&oh=00_Af_h5HneZnAUYmorR010859S-wZv3Vr6n07SBY1V5gFU0A&oe=6A466D25"}, {"file_name": "migrated_image.png", "id": "207335037164985", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162685_136362513671092_8803515468724830208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RlOCqfOIpkQ7kNvwEv_Bip&_nc_oc=AdqQylycZTHKkW4AUF73iu5YVLilnkGVEi73FXXhT4EKoS8mMnHTClqnO_ammKRs1zE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GOVmCDt9h9sIMbf-1DVUnX5DYwWyYmyCFN_n-qenL-w&oe=6A4687B9"}, {"file_name": "migrated_image.png", "id": "148858716379466", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138839_1684592765129086_854230490_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVqldHbqnHoQ7kNvwET3Sbj&_nc_oc=AdqTVF72HqvfbDaiJU1iKiaFPj42EGmn_55kXoTpQGtpW-SILWbaJzW8pAjFANqRpZI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S4MAwSnaxLO89aSWta2oeuQi3Ivd0K7Dmf9qj0T5n7A&oe=6A468719"}, {"file_name": "migrated_image.png", "id": "137580661030085", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522306_345402529131901_7157233952749518848_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qlDUdRUncQQ7kNvwHEt_nB&_nc_oc=AdqYizEgAzoBQVQTP-5SGaXYoeAdE6Pk7kRxLpypjW4jSd8vHMJwP9bu9wtrZ5TitWI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X1ww4OCsAflI2HI6YpXStcc4tqghxy8mg9D3c8yS_QQ&oe=6A465D40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VLIPPmed", "keywords": ["medical", "operation", "vlipp", "surgery", "vlippmed"], "long_description": "VLIPPmed\u2122 is a global platform that uses Mativision\u2019s proprietary VR technology for good, helping healthcare professionals from around the world gain access to immersive medical training by experts in their field which leads to better treatment for patients, no matter where they are.\n\nThe platform allows everyone to virtually be in the operating theatre and watch a surgery in VR either live or on-demand with multiple interactive user tools.\n\nVLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training.", "short_description": "VLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mativision.com/privacypolicy/", "developer_terms_of_service_url": "http://mativision.com/tos/", "publisher_name": "Mativision Limited", "support_website_url": null, "website_url": "http://vlippmed.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998143494107440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162686_330342350710119_1968130542478032896_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UusrLkfIfd0Q7kNvwGvbJtV&_nc_oc=AdoM4uG15O4wNR0sa-YxmqwHz31kPmHzVj1K72xuQQlBv6rSn0pLlLrBAZxf97Fcnmo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hhQYHUT7A0I2ocif1FI1bQAii4z6mjXKkyhIRhedkKA&oe=6A466527"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VLIPPmed", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460444400, "lastRevision": {"nodes": [{"id": "1716308185256898", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9146
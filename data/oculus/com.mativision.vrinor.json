le interactive user tools.\n\nVLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training.", "short_description": "VLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mativision.com/privacypolicy/", "developer_terms_of_service_url": "http://mativision.com/tos/", "publisher_name": "Mativision Limited", "support_website_url": null, "website_url": "http://vlippmed.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998143494107440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162686_330342350710119_1968130542478032896_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y-JYpycFHIQ7kNvwF49sTO&_nc_oc=Ado3pxiSSRri1lF6jOyFt4JA3iRbjuj5-KuyZn_3vjBq3ydvRvhIQ-LG2DYUKtxOpBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sIM-bu14gFCpY746xy4gTgCAQPksl06cRJXzWquG6mg&oe=6A1ED827"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VLIPPmed", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460444400, "lastRevision": {"nodes": [{"id": "1716308185256898", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "914641785316
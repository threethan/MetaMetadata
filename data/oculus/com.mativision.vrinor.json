.com&_nc_ss=7f20f&oh=00_AQGVh0tsmFykuQzvyi9EUv5niSln-8IdqWpB2TxLIx_X7A&oe=6A7DCC25"}, {"file_name": "migrated_image.png", "id": "207335037164985", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162685_136362513671092_8803515468724830208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oows7V1_5rEQ7kNvwF1AG7W&_nc_oc=AdoCwJrzbUGIylX3F2Rkz4CLM9JbGvDbBN4GpZ43efEDxo1TcltR2wjVO78ROvNo2JU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgsdxTfUXUgWDRcnYcq26KVf3OH1ursB2_lbmrWTroxA&oe=6A7DAE79"}, {"file_name": "migrated_image.png", "id": "148858716379466", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138839_1684592765129086_854230490_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB4asqT78EIQ7kNvwETB72A&_nc_oc=AdoYoCT2hPUMTpQvv7cvGpmbzFEU66aKUpDqa5pCtKJZYAICR-oF0Rcz_-J3L04qq0A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDVeSFctyjIPIeJ2LlnZDsPeZAEbTKVx1khq7YaKAQAQ&oe=6A7DADD9"}, {"file_name": "migrated_image.png", "id": "137580661030085", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522306_345402529131901_7157233952749518848_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5x7r3FO7cMgQ7kNvwHu38IT&_nc_oc=AdoX2fTv4m_fWF2Fid2-3TWzpHjfhcYWKro4i6LtTptjveXsfzujaXnyb14Vu5_a0Wg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2pIYj2gSseBzIrJFvy2R1Kk2vNplvzaXyx_yefSRBTA&oe=6A7DBC40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VLIPPmed", "keywords": ["medical", "operation", "vlipp", "surgery", "vlippmed"], "long_description": "VLIPPmed\u2122 is a global platform that uses Mativision\u2019s proprietary VR technology for good, helping healthcare professionals from around the world gain access to immersive medical training by experts in their field which leads to better treatment for patients, no matter where they are.\n\nThe platform allows everyone to virtually be in the operating theatre and watch a surgery in VR either live or on-demand with multiple interactive user tools.\n\nVLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training.", "short_description": "VLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mativision.com/privacypolicy/", "developer_terms_of_service_url": "http://mativision.com/tos/", "publisher_name": "Mativision Limited", "support_website_url": null, "website_url": "http://vlippmed.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998143494107440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162686_330342350710119_1968130542478032896_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqR8K7oYVkUQ7kNvwFgVBOc&_nc_oc=Adrvt891mLCb2paOrix_G_byDaYuodmpOwkHwDX89MuJtPekrphQY8VhH9kSF3WaymQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK6TAFL3ImrCV1u3WTWiph4OQo83JlohLpxqmkwdijkg&oe=6A7DC427"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VLIPPmed", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460444400, "lastRevision": {"nodes": [{"id": "1716308185256898", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9146
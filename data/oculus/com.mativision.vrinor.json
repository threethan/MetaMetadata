.com&_nc_ss=7f20f&oh=00_Af8RsNdNI2agKnqgu7Rr5Ut79xA575_mfgiKMkPPnizb_A&oe=6A369B25"}, {"file_name": "migrated_image.png", "id": "207335037164985", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162685_136362513671092_8803515468724830208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YgczPQwOfwQ7kNvwFViuIY&_nc_oc=AdonZXvC0D910iyg6gUHuduifEqB-f8sdVqhHu0cv7McfgtC0QY9_AjsgnAQtNzSk_s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_07E762RVwAfUHlDlUKotdyI1OzVwmydAfHlT8bKfX8A&oe=6A36B5B9"}, {"file_name": "migrated_image.png", "id": "148858716379466", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138839_1684592765129086_854230490_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df4SxDyDPwcQ7kNvwERhq79&_nc_oc=AdqbdIkvBoQ3GUAh2osXIyRXV0SaE7cf9NeTtoLZexgpU5OpDqJXBAHqrEPK275wF0g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_F8GcE7pgfG5Zzjj9o2Kf32WTDAtOixXTY7uqp6q-oPQ&oe=6A36B519"}, {"file_name": "migrated_image.png", "id": "137580661030085", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522306_345402529131901_7157233952749518848_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T74vrmQuoioQ7kNvwHebVTw&_nc_oc=AdqgM7YhIk5qp9bJ2OZ450qMQmK4VBNrqTCAccvM0APQ5UUBZl0zJrTfuaq1nfufwEs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T-tufAZ4zc1DQ2QckuuKj_i6IbtWh3KbFV2uPY984mA&oe=6A36C380"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VLIPPmed", "keywords": ["medical", "operation", "vlipp", "surgery", "vlippmed"], "long_description": "VLIPPmed\u2122 is a global platform that uses Mativision\u2019s proprietary VR technology for good, helping healthcare professionals from around the world gain access to immersive medical training by experts in their field which leads to better treatment for patients, no matter where they are.\n\nThe platform allows everyone to virtually be in the operating theatre and watch a surgery in VR either live or on-demand with multiple interactive user tools.\n\nVLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training.", "short_description": "VLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mativision.com/privacypolicy/", "developer_terms_of_service_url": "http://mativision.com/tos/", "publisher_name": "Mativision Limited", "support_website_url": null, "website_url": "http://vlippmed.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998143494107440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162686_330342350710119_1968130542478032896_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1WCyaAKhMQQ7kNvwH6TCTM&_nc_oc=AdpNKEYZASlH273baVqdD5U_a7ctZjMIbZmwDJ8Wm3T77JZI4hf-Z4EujVQdlJYAOFk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sSvrKCEohRZBZKTpGkhJKOa0VSAyCeccPunLDI9a3vg&oe=6A369327"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VLIPPmed", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460444400, "lastRevision": {"nodes": [{"id": "1716308185256898", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9146
.com&_nc_ss=7f20f&oh=00_AQJnwRl-D2hQDs1bJQfJE8pLirvo8k2eC1retxBrkn9gkw&oe=6AAE93A5"}, {"file_name": "migrated_image.png", "id": "207335037164985", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162685_136362513671092_8803515468724830208_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKXGcoaKYB4Q7kNvwFeZh4b&_nc_oc=AdrSCytxTfCGHtfKUAK9teRLIBGycwZnrjg3zKq7Ot4vGAFqw5blWziXqCSukFGqHes&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLme4oR9NU5_ZW2k_WkDKNXaiPqZJZiLZ-3jXRn2BBqdw&oe=6AAEAE39"}, {"file_name": "migrated_image.png", "id": "148858716379466", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12138839_1684592765129086_854230490_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvPmm2AiwekQ7kNvwEd_g_W&_nc_oc=Adqt_j0HGrmvg6IwdRbho5Oo0-E_2O45lxM5FSmrF2uY3WgiFR5w-mn2IMw0AD5aKKI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdwo25OA5lCtru5j9DYRbEa2N8GXED42VTgRoNFwh0-g&oe=6AAEAD99"}, {"file_name": "migrated_image.png", "id": "137580661030085", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12522306_345402529131901_7157233952749518848_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5e9zrKIlm_UQ7kNvwGsLVWW&_nc_oc=AdoMD-MaKMg1SIQ2gYAn-lcY_rb8yV3IR_ML8JfK43bKVRq9-BrGlyJ0sDL2FO8SjbY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1AB7kkHFmMmMgahKN1RWmvEM9wdCDLZhL2YP4fPdo_A&oe=6AAE83C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VLIPPmed", "keywords": ["medical", "operation", "vlipp", "surgery", "vlippmed"], "long_description": "VLIPPmed\u2122 is a global platform that uses Mativision\u2019s proprietary VR technology for good, helping healthcare professionals from around the world gain access to immersive medical training by experts in their field which leads to better treatment for patients, no matter where they are.\n\nThe platform allows everyone to virtually be in the operating theatre and watch a surgery in VR either live or on-demand with multiple interactive user tools.\n\nVLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training.", "short_description": "VLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mativision.com/privacypolicy/", "developer_terms_of_service_url": "http://mativision.com/tos/", "publisher_name": "Mativision Limited", "support_website_url": null, "website_url": "http://vlippmed.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998143494107440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162686_330342350710119_1968130542478032896_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Hd2iQ-XLXIQ7kNvwF5zKn5&_nc_oc=AdruFqwhDV-52smkyuV82iigYfNpK3ZCZu1iFrrRh70cxrUHB9vYX0GnzFAIP22Z8UM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1KOU5HRhFXMsntJ86fDDK4PKYObzw9Bu5kBxgo6sZbw&oe=6AAE8BA7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VLIPPmed", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460444400, "lastRevision": {"nodes": [{"id": "1716308185256898", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9146
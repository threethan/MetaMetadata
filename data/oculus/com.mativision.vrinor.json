le interactive user tools.\n\nVLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training.", "short_description": "VLIPPmed\u2122 is an interactive medical \u201cencyclopedia\u201d establishing a new era in medical education & training."}]}, "developer_name": null, "developer_privacy_policy_url": "http://mativision.com/privacypolicy/", "developer_terms_of_service_url": "http://mativision.com/tos/", "publisher_name": "Mativision Limited", "support_website_url": null, "website_url": "http://vlippmed.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998143494107440"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162686_330342350710119_1968130542478032896_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9j_c0txHgC4Q7kNvwELzICw&_nc_oc=AdocXTpyT2ct74-zgmWSfJsWLhBytir-IjTF7rHZH6DPNE8iyROjdpVR1C3zoW7c2Ec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHIySRjsU9nYvnMVvs1pRi3dF4k6Ax9nKXC9HtqVOY9w&oe=6A81B8A7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VLIPPmed", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1460444400, "lastRevision": {"nodes": [{"id": "1716308185256898", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "914641785316
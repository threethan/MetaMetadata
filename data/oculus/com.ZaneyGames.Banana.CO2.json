30_3657196227485060632_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qnoi0gngyjYQ7kNvwGt41IZ&_nc_oc=AdqUtkA81Rf-puhl5bHY0BA79bFoIZTfv5m-ij4DEyeEnpLi6lny49C2mm2qlDSYudU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV_2ByCl2VhaV1DHQOujIY1e6W6fizBvSGEvSkvibw1w&oe=6AD23E22"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-29.png", "id": "996864625625766", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392082_996864628959099_5671729789094635140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLKfQIEOk0sQ7kNvwEfd8oj&_nc_oc=Adqnl4CoztfhiqlF-OocsK3L__cRIwtLBfdqueKl_SJ74y6RuBjTXf_QO8QCLW0Vahc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGLTOWuk-QGb4HSYMmOtEsa-McSRAyZJMA9tO4tx8XFQ&oe=6AD23E3D"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-47.png", "id": "1695314561405334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392057_1695314564738667_8692673514106782828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0xFnrf87tEQ7kNvwF3jJXG&_nc_oc=Adq-uQJpCn5SF1B8VEPtw69Fa-Iaj73yYjQpITnCddECFsbQQyI2P87PkzyVK-EM-kM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMR3AimPAeqDRXM3hIOxDlV7_FHAh851cQR8DQKBAIW1g&oe=6AD234B2"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-08-15.png", "id": "653831420638256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393455_653831427304922_6565642751307165896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1Xri4sLFqUQ7kNvwGgMSTd&_nc_oc=AdqHHG1--OcuGHrgaVXUI1Jz2qvQbsKekQkvUdaCPgaoB4URdfoZO5dulteit96nK3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjLj9OsB2q4CGU0ZINzj860Vcpri8WJrjD1DaQbBn6Pw&oe=6AD25093"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Company 2", "keywords": ["banana", "company", "remake", "simulator", "chill"], "long_description": "In this game you are a funny banana but that's not all, you can also be, another banana, or even a tall city building. There are also very stylish cosmetics to show off your' theme to your friends and to the community.\n\nIf you want new updates and events constantly almost every week then join the Banana Company Community.\n\nEvery Thursday we have major updates and every player count goal brings something fun and new. The game is always changing and only changing because of you!\n\nCreated with love by- Zane2evil.\nCo-Created by- Yellow44\n\nThanks for joining us in this fun community! \n\nBanana Company 2\nEST: 2024-2025\n[Yellow44 is watching]\n\n\n", "short_description": "Have you ever wanted to play a game with a fun, community, game modes, and story line? Well then this is the game for you.\n\nIn this game what happens is, the more people who join the game the better the game gets. So if you love fun events, or updates then join the Banana Company 2 community!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zane2evil", "support_website_url": null, "website_url": "https://66d7a5532d916.site123.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23922271450692374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.577
c_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKU4Lw_9IpgQ7kNvwEhYpz0&_nc_oc=Adoh10G0h096xit6v8o-0Y2vOouqe_PYrbss5FQ96b6fIkqiIOkd-XdKJtl1sLBnb7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjRfsuNFuj2jbpv1RLm2HxiHc6wtGO3vdFWvZt-ecYFw&oe=6B01EC62"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-29.png", "id": "996864625625766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392082_996864628959099_5671729789094635140_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_53RgxH3qYQ7kNvwEhQATd&_nc_oc=AdqwLJfZQn9FgVBm-xt0878FPdSPGWgTdrjSO4TbIyncY29-AbFo2u_DZmkCsxRfyn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxEN0OC7V0q-R_RYJKDDBbvaK34vAn4QgGOH5iSHhGDg&oe=6B01EC7D"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-47.png", "id": "1695314561405334", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_1695314564738667_8692673514106782828_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=846uuh2Uc0AQ7kNvwEBOvA0&_nc_oc=Adq2STG_LwNRJyVCd0v0fa5nxxIlK0mRS_BV4RfguZtyMiDzi9XyPMypW_8XruD2ohQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGVSHDg-9SD_cb5NetNOOns90TbJ3ecUmo5H6rqQVZ2g&oe=6B01E2F2"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-08-15.png", "id": "653831420638256", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393455_653831427304922_6565642751307165896_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCiSIjKu_uUQ7kNvwERvQFg&_nc_oc=Ado-O7lClEtFUvbiR1IQLOH4V3gMrQbG5fTnsROOI_HRTOOR1dewYqusK-vFJyws_lQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWtYavBpDmRds3VAT7mvoLhLTaaUCTS3UWCHJ2CG-JdA&oe=6B01C693"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Company 2", "keywords": ["banana", "company", "remake", "simulator", "chill"], "long_description": "Step into a wild VR jungle where you and your friends become playful bananas, swinging from trees and dodging the tagger in a fast-paced chase. Using only your hands, you\u2019ll climb, leap, and zip through the vibrant environment, building momentum for thrilling escapes and crazy moves. The jungle is filled with colorful obstacles, making every jump feel like an adrenaline-packed adventure.\n\nThe tagger\u2019s job is simple\u2014catch the other bananas and make them \u201cit.\u201d But with quick reflexes, clever tricks, and the ability to throw bananas as distractions, you\u2019ll need to stay one step ahead. The dynamic physics make every leap and swing exciting, while the chaotic gameplay keeps you on your toes. Will you outmaneuver the tagger, or will you become the next one chasing the pack?", "short_description": "Imagine a VR game where you and your friends become a bunch of hyperactive bananas in a vibrant, physics-driven jungle. You\u2019re not just hanging around, though \u2013 you\u2019re swinging, jumping, and zipping around with only your hands, trying to avoid being caught by the banana \u201ctagger.\u201d\n\nThe gameplay revolves around using your hands to propel yourself through the environment. Download Banana Parkour, because yellow is watching. He is chill like that. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zane2evil", "support_website_url": null, "website_url": "https://66d7a5532d916.site123.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_mem
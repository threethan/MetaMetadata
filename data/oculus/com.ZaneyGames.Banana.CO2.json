0kqmyjwWn0SVcpTtUMZR9KTTqU50F5su92UtrWx5FXRrUf77PEgHpqhX44QfO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDczjQq0dkmNE8GT4FLlNz5b0_5ANJlIFuwPJCb_uKUkA&oe=6A4FB9BD"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-47.png", "id": "1695314561405334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392057_1695314564738667_8692673514106782828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MO6lQAhV4BoQ7kNvwGbrs7f&_nc_oc=Ado9IzCRqM2R-6neEd89Ypjyy7Hefii_wlyip1ST4grBUXCrURpZiAO1QXQBpGBY7So&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi2EyH0MYiLP1I_mQo0MWefsLLcoRxBKnJNt9XkPBdiw&oe=6A4FB032"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-08-15.png", "id": "653831420638256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393455_653831427304922_6565642751307165896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl9LvXf7Q4UQ7kNvwE_t_gX&_nc_oc=Adrt6wGw_97Smc77LBVc0dBVRLm1cYmns_qIl87ggyxrmVZ9vnhsg2inAqAhLYvftq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn3G-LIivBuu_vpEfCG_32IDmfUEiYZLCVlU6F6_008Q&oe=6A4F93D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Company 2", "keywords": ["banana", "company", "remake", "simulator", "chill"], "long_description": "Step into a wild VR jungle where you and your friends become playful bananas, swinging from trees and dodging the tagger in a fast-paced chase. Using only your hands, you\u2019ll climb, leap, and zip through the vibrant environment, building momentum for thrilling escapes and crazy moves. The jungle is filled with colorful obstacles, making every jump feel like an adrenaline-packed adventure.\n\nThe tagger\u2019s job is simple\u2014catch the other bananas and make them \u201cit.\u201d But with quick reflexes, clever tricks, and the ability to throw bananas as distractions, you\u2019ll need to stay one step ahead. The dynamic physics make every leap and swing exciting, while the chaotic gameplay keeps you on your toes. Will you outmaneuver the tagger, or will you become the next one chasing the pack?", "short_description": "Imagine a VR game where you and your friends become a bunch of hyperactive bananas in a vibrant, physics-driven jungle. You\u2019re not just hanging around, though \u2013 you\u2019re swinging, jumping, and zipping around with only your hands, trying to avoid being caught by the banana \u201ctagger.\u201d\n\nThe gameplay revolves around using your hands to propel yourself through the environment. Download Banana Parkour, because yellow is watching. He is chill like that. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zane2evil", "support_website_url": null, "website_url": "https://66d7a5532d916.site123.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9685319468147477"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24406271742292340", "version": "0.59"}, "id": "591443213756164", "channel_name": "LIVE"}]}, "is_for_
b4JVLDgbN7Ik4KVi_WDNSE3axiWmymtZxVIikXw&oe=69A029E2"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-29.png", "id": "996864625625766", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392082_996864628959099_5671729789094635140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VapPB_sCJuwQ7kNvwF2_tt0&_nc_oc=AdncZEaJh1jaEuOj99YuRwaAeaKY2Cm9eNffw2UTpIN2FxjG2iiD_eU29BC5CliUZaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftEu0fTfZfDEx9Cz8bYzhEWgtUk7RYjBt77SyCfEnVUVQ&oe=69A029FD"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-47.png", "id": "1695314561405334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392057_1695314564738667_8692673514106782828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzhmyRc4-K8Q7kNvwGO9ZJ-&_nc_oc=Adn3g5hxr3oFArcZbFdjTh9LYc6oomfloJmWZzeGoQywuC0AsDINXBhALyY1_a6xY3I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuv0vg4y5NWFCQJYEJ45VFXim_T8kVpGwHMwHCsYU374g&oe=69A058B2"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-08-15.png", "id": "653831420638256", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393455_653831427304922_6565642751307165896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLuOuEWgevIQ7kNvwFoiOAp&_nc_oc=Admr_RRQZFQpxJk1Cq1hf6OPFSlPsSELmmIyYeNtMs5xxE8Dy0VHrCebpFSyu02PBjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNowrI4JMTuWAZBWusKNnGjWP-SY_L7C5pS66bPh5Xog&oe=69A03C53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Company 2", "keywords": ["banana", "company", "remake", "simulator", "chill"], "long_description": "In this game you are a funny banana but that's not all, you can also be, another banana, or even a tall city building. There are also very stylish cosmetics to show off your' theme to your friends and to the community.\n\nIf you want new updates and events constantly almost every week then join the Banana Company Community.\n\nEvery Thursday we have major updates and every player count goal brings something fun and new. The game is always changing and only changing because of you!\n\nCreated with love by- Zane2evil.\nCo-Created by- Yellow44\n\nThanks for joining us in this fun community! \n\nBanana Company 2\nEST: 2024-2025\n[Yellow44 is watching]\n\n\n", "short_description": "Have you ever wanted to play a game with a fun, community, game modes, and story line? Well then this is the game for you.\n\nIn this game what happens is, the more people who join the game the better the game gets. So if you love fun events, or updates then join the Banana Company 2 community!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zane2evil", "support_website_url": null, "website_url": "https://66d7a5532d916.site123.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23922271450692374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393941_1132605785238849_5573771144057102146_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8EIkJuWb0wQ7kNvwEggMM0&_nc_oc=Adlh_7NWX5p6PUnHRyX-9gXmuDHY8I1t2yDXaPR64CrHpqqE7OysPZJqbw_DR8H5TrY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvTLAhLy
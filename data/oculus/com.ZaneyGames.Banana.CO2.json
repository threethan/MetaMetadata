30_3657196227485060632_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZ11UzjG1HYQ7kNvwGgCpX9&_nc_oc=Adry1OVGVdvbWWTFDVnePwA3qcayoP8HEb_cVjWmqj-6BtLfJB2cgxgyPKLC7aYdw4I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkpGJab7frOfOY3V6ug2rLty2UGsan6RNH1H3K_TX43g&oe=6A525CA2"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-29.png", "id": "996864625625766", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392082_996864628959099_5671729789094635140_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJZhXvTNGMgQ7kNvwH4ntF4&_nc_oc=Adrtls7dU8fLUb1uDolgEMtmyQWFBvrL24hdJOecus8a4kvOEu_K82p5P5gti-2gFmo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEGyVp5mRt-6ixYd-psw97KebtNcpwmqmKxERq1rhvQw&oe=6A525CBD"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-07-47.png", "id": "1695314561405334", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392057_1695314564738667_8692673514106782828_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EDjQJxDDTIQ7kNvwFm1Qey&_nc_oc=AdoVyHg2l3iy9uv-0IYoirXHXUQEx2OuKk_wTi8Q7psQo6BnFnTLNKN1SrANXxshJU4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB-OKhsWE8MREcUgRdrDhYyWY-XHRQFVElRC-QNxPoDA&oe=6A525332"}, {"file_name": "SampleScene_Custom..._20.02.2025_14-08-15.png", "id": "653831420638256", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393455_653831427304922_6565642751307165896_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kW7hoqficCsQ7kNvwF4lYdK&_nc_oc=Adq-MoLDrnlkdcVTLmrXolM-BRL8u-3gCD1cmTOmmgs-xvzv94vPD6WsQMEuPYAHyiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIaBddjOsz_vuWJt-kEaBGgvT2clH7aB25NBjZAl-rzg&oe=6A5236D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Banana Company 2", "keywords": ["banana", "company", "remake", "simulator", "chill"], "long_description": "In this game you are a funny banana but that's not all, you can also be, another banana, or even a tall city building. There are also very stylish cosmetics to show off your' theme to your friends and to the community.\n\nIf you want new updates and events constantly almost every week then join the Banana Company Community.\n\nEvery Thursday we have major updates and every player count goal brings something fun and new. The game is always changing and only changing because of you!\n\nCreated with love by- Zane2evil.\nCo-Created by- Yellow44\n\nThanks for joining us in this fun community! \n\nBanana Company 2\nEST: 2024-2025\n[Yellow44 is watching]\n\n\n", "short_description": "Have you ever wanted to play a game with a fun, community, game modes, and story line? Well then this is the game for you.\n\nIn this game what happens is, the more people who join the game the better the game gets. So if you love fun events, or updates then join the Banana Company 2 community!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bannacompanyoffical?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zane2evil", "support_website_url": null, "website_url": "https://66d7a5532d916.site123.me/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23922271450692374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.577
1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QFzbqtcmAIQ7kNvwFifaCX&_nc_oc=AdpMP6XutcmSfaMI0poPkeh1wgFFkmzOdfMiabAG0Jqe6TWqtH4mDpIizItFtnp-DNU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs10EQk71ZYSWQn0ZSqyHVnah8SLLhtknDRVm93Dz8pA&oe=6AF325C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LEre2j5J_MQ7kNvwGAwR56&_nc_oc=Adoj9A2yiTS_Fn_TZFnDULntuT-0N6G7_qnewDywZHJh5P8Fqf1QXy4q2frpPLTCrnM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-3MytvBEnuKYehb7DvwhAKryvNUWe2X_BcHQRbZwTbQ&oe=6AF3510D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLcJAfzoHW4Q7kNvwE21AgR&_nc_oc=AdrI2ISaTx-c5k_v7_jG3qHyf6htV9Nn9Fb35SHwbMRepQFFWQFt_Thd5c28c7V3xRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr-Rw2hPviT-wISeKfp3a8MxdBRXvPhgm3FAEtS9A35w&oe=6AF328AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13orkH5sxqAQ7kNvwG32NyI&_nc_oc=Adr_bEqI19GOUIIzxvAZC4oJxF76OpQtmDb8fX9ZV6WkB2j6ioQJm_3tbELLnzwDp-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRREPHgeyNn-iZw1rW38InkwFkJgYqbc-m-0EyZX9y_rg&oe=6AF34442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUOk6xJhmLkQ7kNvwHcb20z&_nc_oc=Adoy01IWR7XcoqnGtKs-buzS_cyS66USGsCsw8M7YypzBwDDTPAocHN0RSw-Ty16yCo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcIiF_2D0BCYmEUienXs9H3sG-l2HQTflbAXya3KdcZw&oe=6AF34F2F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
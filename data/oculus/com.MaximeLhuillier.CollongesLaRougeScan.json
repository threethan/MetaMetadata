1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMNhyhkrEpUQ7kNvwFdRmen&_nc_oc=Adq7ubplLIR3mPbeJlQLiHogxO-Y1oBi0aHq6Qg_-PDF_MjKdu3udThuIVvpCqTTyQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlJ03yX5FvcLUf7x2sh-WREIluUPKka4GCKtoL8BThOA&oe=6A6766C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVCFHWlKiY4Q7kNvwGf_yRd&_nc_oc=AdrLnKcy5o2kB99pob3XyVBWQLY1NwmlX-guDML9ar2pD_IVU7n-ra6LsUs7uH5hpZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk_mX7uUMTtXcdSSQgkOmXoMfezzPq0gel5SOCCb2gvQ&oe=6A6759CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXbv39wPjBYQ7kNvwFhpgMk&_nc_oc=Adr3MrcjqUqaxo5N0Fnx16SJrZyZhQdLkMeQp_dRWAOKu6SPYXIRiW6gI_0FL5LDLVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW4G7hKRT7iQuyM0xC-MBLQov9Tcm3HZdr5p2G_lzN_A&oe=6A6769AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60DLJFO16psQ7kNvwGGBMze&_nc_oc=Ado4PWBgsa0pO7ZTPO-sn7cpEu4cx7NhW-ZBjRJjRMI9N-umxkU5XCG2IdqtHrRN27U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1VjllHJgL-TcxULBsYU04hkddj6RbBaLFCNhacg5BiQ&oe=6A674D02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX8MnlirrpwQ7kNvwFIG3DN&_nc_oc=AdoPthsqBDdtxZkIcl3dAlu5w6vvdpqj6s0OPzVMUtsdzpSIcRnLD8xmU8p8q3iqVRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEjG1Qhl3Ov0iih_2qbtBEsKgzkcuwcA8HNZC9Jt5OOQ&oe=6A6757EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YY4D1X4PUcQ7kNvwFZSAwY&_nc_oc=AdpwCfmw8Q-L-8nqsA8G3vYNlLOSthLoAQl_GnqvIXIqIo__QiwEDzvYMzpL0ZTM1ao&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uuG39mUn4GvOwcfVDJQv4GOSzgKnq74EBmvZzzKu1Jw&oe=6A184CC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avv3EyK_YY8Q7kNvwGNFr2w&_nc_oc=AdpTtdgKK8sKnsMq0fvX9Gq9C-hgr2WRGq8iWjiYLqFljzi8Mv3G0FfaYp4by8Z8SV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HVF8pB3d7h44-TaziFbPQmE379-oDTKYshz_zZIEq9Q&oe=6A183FCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYMo3wz0ENgQ7kNvwEmOgzn&_nc_oc=AdoZ2UunvhuyGthEgpiO77y40qwOHR1YCrzihcnNFfeuSmmr4zwBB4iot54NUW5cN8o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61MqInxCWU8FBZclbuSIkb0eq3K7pCs0rS2ySeJm0Z_g&oe=6A184FAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjwYmStx2G0Q7kNvwGsi5eo&_nc_oc=Adr_qUwNB8PC6weSYQdsgkIpsP6mkjZ_MeupAF0QaIwlDVJaEfbcVw7NIbDS_YEgLHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pAM_s2B9tCyi4gAIgIttlxoqurKMKkMYQujB5FaTAbg&oe=6A183302"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtGaGQWyalYQ7kNvwFFbus0&_nc_oc=AdovP5Rt8wy8hBkRrvYZmyU1axJEnUjNAn1cb5y87kv5ckUe4TnW_Kbr898KVoUOxd8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_t8X8OVq07Zvy2bkpx-2inPzIZ8w16PgXVD7xA6hECQ&oe=6A183DEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PAQWrz0inkQ7kNvwHHHSyr&_nc_oc=AdrmQw-s1r6Vrl9s9ndZE01cgfkXCnBmMO_sQVj4cFhOrIqsKnXXwmy88W5SuAZ_uvM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcb7cSn8dpQMh0zSOJn1UX2gSv1ba8CV55zd0It3-QKg&oe=6A6CACC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGjIO7X9HCcQ7kNvwG9ZRuo&_nc_oc=AdrlHw6cTQ0jKwMySplxozd69B-hCOjhM1A5avbOzh_Y17fGDB-bpDDSVsLHyR5wZnU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8wnNVpSdNZfpDnQPMNGdaOd6j8CNxKOBDkRGuxmy8oA&oe=6A6C9FCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Wo_EIWRFgQ7kNvwGa1Xwx&_nc_oc=AdrFUdQHvLF_CBD0WaTir6jy4WREx7wKWEYTyhSzK6mdyH01YAPqhpwcZhCLVAKZJdk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrGdvTd-R7hSYwOm9CTzGX7Oi3fKjPvId6dvaIuy1Cow&oe=6A6CAFAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3qVGXRShRwQ7kNvwFRB0Qu&_nc_oc=AdoOZXDASt88zPH2BmBmMd9-cYt7hM3PowfgOoLWUzg_U1TFlFqamQTq_W5aQIR_iWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwzqRC5js-APE-Reu45ol1f-XHube5JZfgM897cM7mEw&oe=6A6C9302"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6oUuwJ5r3oQ7kNvwETSEQi&_nc_oc=AdrfjdDA0gWd4YyJ4LcoFxoCuMZDU4tMWYNv9jNKRFQqdNNi-iFq-atWwosQrT8t_mE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYBR2OTr8yrsSDtAd0ud-FrH1W4VfoAOQsJ41_xzL2bA&oe=6A6C9DEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
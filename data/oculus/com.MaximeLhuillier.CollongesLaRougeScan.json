1940983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ut1FvZURHwQ7kNvwGApQ6R&_nc_oc=AdoxICeJ2hIT5ChWTjpNcJH19EslHJWwHHZbixsvk8_udPOyrEvrSin3x8uFJcNGanI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x7pCd6FZUb6_pOq51dJA2tAd5vWO_7chQAknQRFXdnw&oe=69D26D40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS2fiSJSPREQ7kNvwGoyLVw&_nc_oc=Adom28R8Wzmv-y_kbXvmhESHM6era36IEQU_q_gQk1yulvvH-9gZCPMZ-RTYIkCihXQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D0Yd8tNuiZPI7zph8T8ULKu6wboeQB5O1aQY8XvMzdg&oe=69D2604D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH1MKmfSHk8Q7kNvwG2B1pv&_nc_oc=AdqxxUjJa6XB8bVki69m9kXZDThsQmn0onN7f0owoyUojyFVVYAm07z1zUDQuMkVFM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q5_sAxmHJuviaXej0SeXJns5votyTarUF0sb64sbZtw&oe=69D2702C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHwdRqdtDK4Q7kNvwGaU9dJ&_nc_oc=AdpFxvmtPUdLDqC3rxFmNq2iuQV76q-M3BWAHi3p0a-ncha_Sdih_kADEVSQeRXJIjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e3ZT9DxyVAFmTJXbIuwwgnDY0sHAnUU-7P7Ij0YrwqA&oe=69D25382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUNzMm3-310Q7kNvwFsbtfg&_nc_oc=AdqDEzbPQqN7F3hfsso4mOqpF32A2_Yl9PSn6ycsyJ7Nq985UW5apUUGPIztUhff8mI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NHRk6ogfkJapYuIWemfy49jpcNLBem2VPBF9hrKV5bg&oe=69D25E6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
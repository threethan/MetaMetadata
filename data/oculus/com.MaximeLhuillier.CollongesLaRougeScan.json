=6e7a0a&_nc_ohc=G1wKFvKeU3QQ7kNvwF05h7v&_nc_oc=Adrq4z-DrPzRDRwIc-Ma8DNhbMwhIVmBK31OyIOmXAAvZY2nkIE9IWehQ1YcV3F7RQE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z7BU25D_Zl1x2JQfzQY1kF8D2qHoPKhuDg0JkKOl_ng&oe=6A2EC3EC"}, {"file_name": "Screenshot1.png", "id": "5448030711940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtAvlFWvdJQQ7kNvwHSjg2L&_nc_oc=AdqAUkZxBpHP-5RMx4RFJ8fZi6rCtlQ8-fxJXArKGRnqbETTKkf6wb3iargwTsuovPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qzeLm192OhVUmMJgJjDxLt0Y2tZFS0nJBvN-E-XuPSg&oe=6A2EB640"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFhlNIJJAlcQ7kNvwEz3j6s&_nc_oc=AdrkLIaSqbQAzkYqxNHmghRpq4aVZ4kdLQ35Heg7jF049QJKwLIgTWSN3_HX87oMeUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af919f_OkfkUd_H-3CyZiQrRmFSJyboFnkBsKHXDS9wdbw&oe=6A2EA94D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_chGRgwvsgUQ7kNvwEUxxIf&_nc_oc=Adp1cvZts8qRgfLgQ3cAXBsjHiCkThqE8vuopSnvhQGE5hL7TAIIaIhFvhOOeLdcEdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dv2YxmVMbySzZ-2gCdEoWwnsJrhcBn5fDtDSdDB0rjg&oe=6A2EB92C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cJ6Fs0ATWYQ7kNvwGzt4tt&_nc_oc=Adr4-I2DoOEHmi3gGzUadeJ7PZAHUF67em3U1XrByVj_2dA4DYwQPQcaKw1xu0zld4A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V1VZwp78uGpdguCEjdKj5Gyzjaiyop_nVrQ5Wia55Rw&oe=6A2ED4C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA6pm4VXJlAQ7kNvwEuFyqk&_nc_oc=AdqGcdi7v5jwSgoBaxmoIMaVnMv9kdFda1DxhE56E_b2UsBRa2uiEYYd_xgGKt-FFEI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P3HjMFVk6zGDHrvPTBEiDzGC0xlX9g-x0CvVIkEoipg&oe=6A2EA76F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url
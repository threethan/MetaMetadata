1940983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2mZRS4oa2sQ7kNvwFoT3CM&_nc_oc=AdocmkMP7Ff0ui5_fpXLITp-BuD-06_6XZglxHG3CngnFgp2eeMFISPn4pfC_d36n_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mTMMOgmPTCIMKnpDQ0NO28elbl3wArwc0HSwN6H2GWQ&oe=69DE4AC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieuY1bWtINAQ7kNvwFP7AUc&_nc_oc=Adqh1tOtuXnLZFuTcAenTpu2h7UFZydvT-aIsrTjg3YnGq5ydW8aFk_KeGnBdfSeLjA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Fbx21gqfaogt99yShh-c6J-1l7IoUZVKA5Mtt7nZoFw&oe=69DE3DCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFYACD8EJgMQ7kNvwE3LORO&_nc_oc=AdoAhS_xaxLTb99R74nV9CWQeiVLculDof7S0btvk34ESx6yoZVDQFLE0uU2l1ncNCE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wjlDwXWHn3ahgep_haUyTPWAZSi9SmwueG-AvJi_-9w&oe=69DE4DAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFtMAlaoSKkQ7kNvwH3ILkV&_nc_oc=AdqLzznckOxZ5q7ePODkLd2CHLhfcJ6xi3aHeAaKSvQwJKcf0U6sjdiKnJ8bvA1AZcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EvpI7-l5D2Da2x1zqeIYSTGqOtoqjzLbzMYkrVwcDxA&oe=69DE3102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfhuiublbjUQ7kNvwGeGrOc&_nc_oc=AdqN3wfuf0d2MCaOJc5gwFjZHcSECOpr04LT9joBqxImQ1X3keg9ZXPXOWm8uieCowc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FZmXWhBN_AXuJjmvd_ztmQJLFhuqLbeAE7oderedasg&oe=69DE3BEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
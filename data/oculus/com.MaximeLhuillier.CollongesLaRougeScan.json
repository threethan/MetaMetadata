1940983", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtAvlFWvdJQQ7kNvwHI0Ek9&_nc_oc=AdrqhJC2YPSKmGhKagl5vaPlv6_yuj7PUEEHXISFofbuUgIH_XaQlvoLcK0hGgBrNFc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9htIgWnElepQq-q4fENpZ4OLHa0HDhRn8fPZm4Tnjdeg&oe=6A3007C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFhlNIJJAlcQ7kNvwH2oJ5w&_nc_oc=AdpQdYElv2kZiT8sUQ558uR1NS0BpPUo1eMAdH3tEy0AJLeCLUhjBZmjW8WRRW00m5E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rak7r4_D-KcXqgz_nqfdP3rNI5pBdwsXDUSJKtGEopw&oe=6A2FFACD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDoLh_jkkTIQ7kNvwGbfX1a&_nc_oc=Adojm62gUGz-bAq2WBQLan_3hbmPf3JMnXOAooS0fdiPppX6LkB0fxYrTIsuogQXY94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EHzL8SmJaOG8prajd1VMvrUEmN-H7vECMvdP_9zT6bQ&oe=6A300AAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cJ6Fs0ATWYQ7kNvwE-xHGL&_nc_oc=AdpoU9DkLCBKIHxdk_djQuMY7wnBWb7sl3hPtUcjuSrbXgO3fPBwKDRZGWDABNNQqKk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a7h7QN_RtjtEZc2y1tme8KkAVODQmkOe5ojl7El672Q&oe=6A302642"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIOFMW_Pn1oQ7kNvwFMTIAw&_nc_oc=Adqe0mBWpmhT9pJtiprLN8_oiL47Z4E7gcczjGSzOvUXoK1h6Z3r6Wk-nxebIHHk5iI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oMVfP9NRW2GxCreX0oC0wNyhJ2FNuq2SGd15A9pN2pQ&oe=6A2FF8EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
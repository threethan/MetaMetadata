1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziQZ2QrsAPgQ7kNvwESE_Ke&_nc_oc=Adr6V1X1iQJJRvnEczsS59ZXcYOp-eYo131L9_-6KI1Td0gViDQBhT8swPTzm3Zz9tg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lyj6rBjZWFekaIjgEsrPfwrWt1kGbjkzHiYzVeduWvw&oe=69ECCB40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EW7m9fapHqEQ7kNvwF0x_l3&_nc_oc=Adpnv9npjdI5A1Qtv9UZGHHqaRqhE6RvDD05x8YeQ-FC6AMT7J5GVDTfIlTQJtsh65g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SWji6t4hcSkBGtSBasY5LoAZPXiYwx72wgife3styrw&oe=69ECBE4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQGpazDVjkQQ7kNvwHj8T8x&_nc_oc=Adqg7R1UPe3hWPp0C2M7TXxwf8gwcoIJ0K_Yj7C4UWXs_ydvjDpOa8hp4NIewuWXMjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k0dFHTqdjOi_5yDp1N_dhi1MFBS3tmFUcIWbYpBmd2g&oe=69ECCE2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM2ysSOHKs4Q7kNvwHs_vIJ&_nc_oc=Adp9gcatusP-woDc5kczp0Yq6plcoNlpCoNYs1LUJ3lb8UrWtrc63Ytn1fNhvv_P2pM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FZJUCXr2F4x1OZQvy6_SepN3bZ7dGqpdRMMuGAi3mKw&oe=69ECB182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQv96r0zORAQ7kNvwH-g_b_&_nc_oc=AdoFNNjilVkuaZy05KGCOK-QAYT2pt98InNmOnDlxPUkmuQvwGFZHIBuhJiGYCxjqtk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tl8QavbLCwvoEoQaJ6Jj5nPuTJS2R9K8frvIfoS3KmQ&oe=69ECBC6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
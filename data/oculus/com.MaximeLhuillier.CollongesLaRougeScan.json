1940983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY30njzthBEQ7kNvwGKgo4B&_nc_oc=AdqjrJ0I_Z4Xlrgb5BJ2Qp_5ROpmRu71pWj7V6sfTOxwok6d6772hKEglqLJ0Jk0e_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsyyzi3RWU8qxIkGvAwQ8IxjDjDgqPytRAXkFkm1AWNw&oe=6A50FD40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7yb4pJrtE0Q7kNvwFSJ2N_&_nc_oc=AdokfycLe1D9zscBOq42XXRIns3DcLkPX5h5Pd6iqcWDxY4e8VJgCHCy5HZq0wtXX0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2f1wNBLOmahxEyXo9vUr4UZ8P9yzDPxu06DJP-5d-AA&oe=6A50F04D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEholQGKC6oQ7kNvwFmo2rt&_nc_oc=AdrgLZA8SRhbM0PfhPyRhXs62PJ7-N8TJhAeA4AjTRtxWzI2KCnF-CWRGnr17UweVxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1rqTnZYtmVWhE4OxSmOz8RoL89M8sJ-uJdz49mZbtRg&oe=6A51002C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxE7u2mTuoAQ7kNvwEdf37m&_nc_oc=AdoqqEHJ8Rcx-lyCQ7cYnAu5ZDoeU0YloNBZfcxWXmoDVVAfvAYn5xb3tTnUvypqOXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5IIhBCzZwPb4PmDk6CoaJd_LQVC6_mlMXYj87M9P3wg&oe=6A50E382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwh6EsnupFcQ7kNvwEM4oOq&_nc_oc=AdoWZDajNKmNmoD5dsACIfnKdbmKOtPfnvwcURE-q9d7oO9Up4oD6nq1FqBV7xYktqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj0CA3Dz8A8ORYQG0hjJy_weMw72g2EUDzGRLyzV-4sw&oe=6A50EE6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
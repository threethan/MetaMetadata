1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X37qWymZplQQ7kNvwHSGJGd&_nc_oc=AdpM7eKnlWB7edX1Ausm6U8Ub9zsYhSYzCO0UNSTbeqBnWL4sYHp4hVVB3PM0RYL91g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AYUWWfEzZAMFPAMnF47uRT3ScjNMhHOnc0ixDlRhNiw&oe=6A47C2C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=266sAVnxnBMQ7kNvwE31P-L&_nc_oc=AdpS0VhSHR7piiq4sq8-FLrtu6VBNfrW1lNZB8F5_4EjVPLYx6ebaZYvSB3WGf1PjGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--sw0NBmlh8q453WVDVIxlnE1BZP5AGhlOiZFHysNUxQ&oe=6A47B5CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT1z7exhbtIQ7kNvwHgkIck&_nc_oc=AdqiCABblTwFyQuDijr2EEoQOkq_uXcEEajvPhxINqWF7fugOyCp9f0Z8P7MTAkfddc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O-Y-dQcQgoqMZCKixLJn4lUudpQ5bOzpxIB5P6cPn9Q&oe=6A47C5AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIgobiV8YjUQ7kNvwGZLeSi&_nc_oc=AdpEaTgSLfL3lHsuYNzG3yuJaoEd0Cccr9Kcu00DeUVXiGdxuJBoeCnmOopZ6dOoqnQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98040Ug6OqdaJjmXvC04kIYHIrN_rrUHJtiw9tErOPuw&oe=6A47E142"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHphur-Rst8Q7kNvwFhW_3w&_nc_oc=AdqLZb-kUOE8PzYYGTQh2RtVcQz_wMuq48gBGfFszZsAIAEp52_U7zF7SfXZzKsCmjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XhhJQ50VZkH6yi48xq5FUjascG1r_-E2bqARMIA5xEw&oe=6A47B3EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
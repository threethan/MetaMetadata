1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMPIqMaKgRQQ7kNvwE22HwQ&_nc_oc=AdqDnXp7P0GwcbcqMDxJq6w6Y3GBlk9_BFNve_eNcCc8pWOQt_6x7EFuL238civdecE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr_VjoCV5PzPeuKziRib5mIx6tboEp9-YJKo4dLGjJQQ&oe=6A8467C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc3e1hOe_pcQ7kNvwG_EmWi&_nc_oc=AdoNYnbPzmZF095EExJyp95w5mbg5wMFs0mOKjj33-4KTiR5VYUYUuXDetf49yJuAuI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-1CcpQBv597MjvPuxKjFL1uLJ_I0i9edfpopZn8WH5w&oe=6A845ACD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GP4DoCGzDwUQ7kNvwEuf5Cm&_nc_oc=AdpKA3W3iZFNQCUOfir1Ndjk9YpcmKkt1RoJr0IAGtZQxr0mo-zuqOoBOU6EGrkgOdU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZOnBbM-BjQVhBXRmw9t_H7V3BAP_I9ouN9XgraurQ4A&oe=6A846AAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKham2FYXBgQ7kNvwGDo4m_&_nc_oc=AdoHPe5LJAXGJ7OHmHrsjIrpEJKuIGTNQ9EZt0soqwfXy6T5fXpOQLJH7tbE8-MsUxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN_BnC7EisHMXzYoKjIZsh9NcIyl3ura67pNBZR6mGZw&oe=6A844E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjLms1J5flIQ7kNvwGBc66e&_nc_oc=AdpzYU1M0tQvyO-EM_jnfvxWL0tQyHQXEElX0zX-YK8tSda3Se_I4_QTfm5ObsHxnOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtGLBO3h_BCVKqGPMG6K0vKI6jQpEQ8YHlb_bke_dpRw&oe=6A8458EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwZShztMN9QQ7kNvwFDaB6r&_nc_oc=AdrTBcwNCr93xJBKdAAySzyNR_d7EoSEO1UAvq4UAfNjLmYYN_QfLgmta4Q4WqtD_g4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8ZsonP6_MnwQXMux_c_xrMOj5i6Kq8w4t4E-SC7Mtkg&oe=6A68B840"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVCFHWlKiY4Q7kNvwFimCm_&_nc_oc=Adq5mcAtIAjz3f_p4xcVue-2JucGfw1tLAC5a_z4Xxxe8Pt530MDYo1V68LD3AvCt1w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBXE9B6UI44YyLFV5mAxpGsYKetDSu3f1OThRsNhBBfA&oe=6A68AB4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXbv39wPjBYQ7kNvwGWKdc2&_nc_oc=Adp3BV9joTe9l7suHMYLF7PDyU2ECu3RgZ5afgP7IOHpXBH0emlVWfF7LCEbnq8D4Ao&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTR1drQoePv-TInp7ShJPKKUEUAphJf1F9uZh4Q33twg&oe=6A68BB2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YWHvhqFaSQQ7kNvwH-0Ruq&_nc_oc=AdqRIjnQCIvWLVS9_ORKQI0I8yZg7dIQn5YL8DNLiAvMOwLA4F4EZoPBUDnwVIhQP8Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTbxAhXjmftBcbemaLckoXIRlAJ4aEXdkrPwnHITWpZw&oe=6A689E82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX8MnlirrpwQ7kNvwHMb-oc&_nc_oc=AdpE1GKRzQugEOgNANSL8YjJkh4FFbm32XAdVtLfKBN_DQ8dMaSaEXIRLvZXmK2m70o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9F9k9N0KxBcqbuSa73O_w2ZWVythQPaSCSmEkyaY2Bw&oe=6A68A96F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
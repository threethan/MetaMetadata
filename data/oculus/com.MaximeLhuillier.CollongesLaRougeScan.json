1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odn3MlCMG_wQ7kNvwH6vYSD&_nc_oc=Adrwa0SRGvgZKeh15Y-xGiM6D5rCyVxF6p2_pu2Q5KmNAqBYVmqykwnje2qYJbpH3oM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStbTCSEEFyv9-F7uLs9pPJLsOzNcQ0TwBZQJuD0qfcoQ&oe=6AF71A40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lTlHhpYD74Q7kNvwHIBsOc&_nc_oc=AdoLo8bbXlCz5iFWo6QA1hInFomPJ0NJn0B4gO0sEcf7i5bxhlXzm4l70JPFl7odCu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcibrVSz7ZjR_MxPHuxUFwueNsWFrCbyGQXPigrJS4iQ&oe=6AF7458D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0mer0-Wq4cQ7kNvwF_BGL8&_nc_oc=AdrM4r7G-MngwuXMAeQXrwP2q8z8EuffsdvQCIaf0N7i6aPuHXctWyY2sX5e82fGmxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNU28XL7VYcCV2f_y5KwbPOxJsGOQDyNvReBCnsCWpFg&oe=6AF71D2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61CKCNTTmmAQ7kNvwHHiEwX&_nc_oc=Adp1b7KfeAVTqNNlHKPM27jfAgI7XizThuxSHL0APeoGqT66GT0Mz53qWfWwrSEOxzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Z62hgMVgEklEvfATEFREx7cm0qkT6eZNyFXS3Wyn0A&oe=6AF738C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCTcUN2FI4MQ7kNvwFl2A5_&_nc_oc=AdpLGajiQcOTPKdq92YhE_DOpIk56UlQXtD3Yvq8tSfn10fjWg-O214wxp9_vP4V_Vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa1o5amB-i3rsY6zG5a-i0cH8R6LHFPN8Y1MLBos9xvw&oe=6AF743AF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
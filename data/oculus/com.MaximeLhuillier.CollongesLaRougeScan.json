1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwZShztMN9QQ7kNvwHbSyXX&_nc_oc=Adq8UNg5s-lT0CvEt6I0Xnotcj6FWLags8vXQaY8zFZVCAYj-47X32uTZ1G6j5qysws&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1QFdzMwEak8L6TjTn9P362FUxVVFAzL4ANglnFQJOJQ&oe=6A6A09C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGjIO7X9HCcQ7kNvwE-Iqi1&_nc_oc=Adp2uoykXaPdU6yW4s_VQKwx55j-jr3Vv7zgm4OsY96vefBGBGxJ6GOLFr367lJM0tM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASnGNjWFP67msPcTZsCSQP4XfEohqKDuEBX5-_hGWFzQ&oe=6A69FCCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXbv39wPjBYQ7kNvwFRxji_&_nc_oc=AdpIHRgd5VkV6XBuhJ2zidDqnKXtSFYOxDTHTU7MnZqvEf9DOwUIziq8tnW5-WmfzNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu70Vn4IvMWJkdWPbiSEODHpckdwa0FacGWVP6HKv56w&oe=6A6A0CAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YWHvhqFaSQQ7kNvwGtedPL&_nc_oc=AdquI8wRb_N39Ay3iul2crBfnfMKlSxf6FwllD3kjojNfGy2FSMbLlT56xRjk6kgb_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9kz4irlaPqG_Lni8XQp80hHBtASQTMMJljaZp_gnhtw&oe=6A69F002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lX8MnlirrpwQ7kNvwG6ATzZ&_nc_oc=AdrIOVLN7PZAHSv2FA3QJ-4Dedwp9APeVK9BNhWyTPuSJ9NXxxe15u81bzBCdxrHsy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXaryStPW6ySDj9VxKQP6aX-Ytr32PA-lMqOYVjeSJ_g&oe=6A69FAEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyDZDFVtrqoQ7kNvwEmptRM&_nc_oc=Ado4LTBkCE7K4LVVpsaAKnK7M9JenfF3gpH8QmOsAyEDKLm1lPjyoNGujFGdyUrS1p4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ7XhSgM_DcxqHsSaT4b3xQ6C4EDQsnlL7fu8brwtAJA&oe=6A8AC700"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXeFI5k9b0AQ7kNvwFJuGcR&_nc_oc=AdomA0lbmzunluEykSjN6JHDusuPG3-MbxIpDolv-L511jR5J0tojjRrVv6ylxWwcJs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvwz9L8Qtt6CZ_-xN8A_JSZtSR2g6QAufYPZAjQsfyIw&oe=6A8AF24D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZEfrXfbL-oQ7kNvwEt-_dh&_nc_oc=AdpDv3xRIdQYLLJ4LoAefxv2NAN9A6_UYfJUMGelCtIbXqh9UMY6x6rSpRC9XNNyWyE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH61VDKICNfZE3_tv1XfZCIUPn7Gs4MuzdFHmyPzKgugg&oe=6A8AC9EC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMr5AP8TEBoQ7kNvwHPUJAg&_nc_oc=AdqEuucQkKxHQoHJ8OWEIVoKPewbYZuyf8-MgepSkcynd0DWs2bp5zCItBGUSVq5PMk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIvSAKIj9yg2bcWsQKeImh4XKzUtu0hq5n_MJ8GM7ZsQ&oe=6A8AE582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcVqza42zWgQ7kNvwFz-sE4&_nc_oc=Adoje2JaXHKuizyYOqzMockyBodYjRQ-m2eTNoCU2zCnAq1PUYZ72zwBROQglIxctSM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERSEYEhvdaRs-tQFqn61-zssd3QHwMER1jQnso30IVtA&oe=6A8AF06F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr3NNdCI0WYQ7kNvwEOefOf&_nc_oc=Adr833MsxA7GRlKrIp4qhQAX8xVTZqtYH0PsvV2bLHlGoOO2e6ygnJCRuPx6d5ok3PM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZxdXsbEjadSzz8dS8ebpHI7BQFY2lSnwfXXI_OWSQWw&oe=6ACA4740"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRfGKEwT0dgQ7kNvwFK9fOO&_nc_oc=AdrpY3TmL4uzicQnHf76V4Xd2-p2n4_p4RCZRhtHvtspeDsTBowYusZn5ucl7dnxtjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoz6NAjJM90t9rdhJqVFxbWK_gnBC9iwxqmaemcrbGsw&oe=6ACA728D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpSGEd3pBusQ7kNvwFY_HE6&_nc_oc=AdoQndk0YAz7DvFX_nswbH5HO_Mh-ZX5NOCE00RWWEpyENQpX-vmfib5XM8uYkYUoDo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuwJ9joPynIKRI8yBe8WSlkK9mYAhn7YIcaAjwCB8oTQ&oe=6ACA4A2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8OzdhPE5ZkQ7kNvwH4QWDT&_nc_oc=Adohb6F44rB181rZ5nV2dFkDdNe9dhvrQg4Ruqna9VJINAFClTwK6VEeYB0aMlR0q3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPi_rnYBnUmTB_zTzS4PMC7zIpApIz900tK8WH2w10CeQ&oe=6ACA65C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OpofOqv6rgQ7kNvwHUTLY5&_nc_oc=AdrjDV1wNk00AY-9wN1jtJUz8kZjSI-iJOnuIFL7Cbp9wIC3v9zmKlsbYsM-FQrOduw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKYlGFMdzu5c07-njvzvuKUG0fq-EDQzx4Wpj_KYEdwA&oe=6ACA70AF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
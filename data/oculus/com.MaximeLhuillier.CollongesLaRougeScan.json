nt-iad3-1.oculuscdn.com&oh=00_AfugemAi974I6hh7fR8U9T-sm2GLmASVSwnib0xJWVUdOw&oe=699DB140"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sz6UXuAS6jYQ7kNvwFDEyFN&_nc_oc=Adln--ayc4PahapNd6WK6qR46xyKJw-Coo8sOW1vTwYJBJbdggGb3VYIB2llhFmhxiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvwoIINpMlusvItmHikJb9AlfovXFyIcqZY6ShjIfRaUA&oe=699DA44D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtpdAj-Y6QAQ7kNvwHD6zzq&_nc_oc=AdnvJlNLCOmqW2apmkEzmqiRGncpp0tfz0Tg_UfcLuGatHuag8ZOi1DXobi0P24BNuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftESSQrBtgAefQ9e2cl110lGETnKPRuqhCM9fL49B4gLQ&oe=699DB42C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPD_jfCLln0Q7kNvwEeTa-r&_nc_oc=AdkIK620WhQaS7rASOavSFpjYvJzwE76XOwyrdspODDbAYWKKr9BmG5IJPpl3QVadoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvkbug7LyAihIGgZCjALKHSXQWbzJeinDyw84YXKb3YyA&oe=699D9782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iAau5FMOQ4Q7kNvwH7hdsa&_nc_oc=Adm0ikbS750iLrr9nEgsCneCGR0iPsxY9wJgvRCWafaZA_mtiqW9KHVdvijw0jFbEhU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszGK5i1B7KAJO2t3rPxV50qOZ_dH2wtyNLh9EoVSTU_Q&oe=699DA26F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
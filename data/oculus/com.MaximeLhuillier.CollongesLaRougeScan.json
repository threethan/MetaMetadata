1940983", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHvJGLp373QQ7kNvwEskgsf&_nc_oc=AdqGthg9OBNxw_lFLfBRb9VHJi8FYurW5IzXfo7EARZ3BPUsfUJiCxtp4HgXx4s49rQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV-55GE1m8UcDGO-WSAu1lVPBUT6TYopMFOfSLBQnvqQ&oe=6AD3BA00"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wLHfrQTlzcQ7kNvwFaw5vT&_nc_oc=AdpB-jUHcI31GlcPTa2TVvhvG-ELakloL83UVkAtiRvsCGFD48R4_Rc3lOvLLk7z8-c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGykIgeaGoBxRvxf07UQXrAhgk5T2PaHxTcx6A1hqrbA&oe=6AD3AD0D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXd1yHtP6LIQ7kNvwElSrDi&_nc_oc=AdpN525_jvonVSMpzlTO3HdxYgK9UmcpB9X-j7yhvXBc9-y_AknCIdlCUY4by08onR8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz1POmMAd1usCK65Szf5VGTUkxSXjYpVjA_WazIh3FWA&oe=6AD384AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Pbhnd_AfosQ7kNvwHr0sWg&_nc_oc=Adq5PppYlpijw6XFSYCXSStUSLrWIZ5KXDwEEoEgppU0kdaCk4GkbZyJiSO2G1s9YnI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND7AnUQqL6A7q-zJzG8dxpJguzNwcygQu4BhEYB8z_mQ&oe=6AD3A042"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Si4bR5txcPkQ7kNvwHxHuPb&_nc_oc=AdrsoFr2JU9r2iu9_MeGV-P3SF0bhHlgkbLsQReNylcPosfbmAtOHuVJhQt09kMZg2o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9BrIWjdeoqguuJ7u3qJkiI2cIAFDH0OtomPAa3WDD1w&oe=6AD3AB2F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
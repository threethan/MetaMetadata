1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCL-RWM09b0Q7kNvwGhcCdf&_nc_oc=Ado5k4Q2ir6qHyI-deJpqm4o8e_SHOpGhoDoq5x-Q58PJQd7oMN-iO_8R0FjoUNDN7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKSRz45fogbEOWvf9sMWYXQObciVcIZ4wQWg8lqQZPog&oe=6A54F1C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmJNyYyc2jAQ7kNvwHWvhtQ&_nc_oc=Adq5kjirfEmzMq_YJVCauTvOzn57rS_kGbEddHSq-p-Na4G6OYXHd3AcxnO_bocXkG8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt6XsVphc90OBQyE4jPgpJ_HqzSlCMkTdPRHZfv9ktDQ&oe=6A54E4CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df5WRox7o1IQ7kNvwHcy_os&_nc_oc=AdpMTyMRn6UNZ_gHBcnxUHgCe__07o71i4uGoGdvNYE3ZuQ8cWVaXDXjr-GIuOcEU9U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApIb2HjowbaB2XF-AfAtXG_pkQ8pK7ZphBn9Dz9Ck8_w&oe=6A54F4AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgDkId0pdrwQ7kNvwGQ2e8l&_nc_oc=AdrOIXOw9ewCmyvWOjiMlDarCLG0n_QtSfSZeyUuSYZlr0BjIa_eIGVkaBNjCfaqexE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIHszHxALO5NdpgtsGx4vau4flqgHFlfYpWDo95M0_BQ&oe=6A54D802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8vKNiVDqUYQ7kNvwH63QUF&_nc_oc=AdqpXSA3bq8qYVV9fZqarqmmvU3oabVyZgJVqXlr0klq0sBlhumpEKXM73eWAJ0Cr8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiw2yThgdncP5-WddTkVMaDHN_HiPiXhdmw1i17iyOdQ&oe=6A54E2EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
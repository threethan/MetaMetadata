1940983", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i70hpT2AorMQ7kNvwEWQWZl&_nc_oc=AdoEDDnxPSScCsnSXmMMK8dcwR0LZhJI0xrGWXK8fnNmBxluxxz63NsOFnPlc3qJ-f8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhAF7_TPHI_KU-jxES-Xomt3gpHpE7Zt-saQzBiKKCvA&oe=6AE353C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g8bTcnVgOAQ7kNvwFTdiif&_nc_oc=AdpANJkWkSbm-Am07VVbs4FKP1BzEZ8h_eRRyFbAXigLehJF1EuJGb1q9qJhx5kvz9g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKeV1U-id7DqlI-9Me57rk7EigdtQmtvcpHg8jlfox7A&oe=6AE346CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3OUXRqYUWIQ7kNvwHRXB5c&_nc_oc=Adqrc-D6M7yOk96uLVTR-h4ZIyWG3Fzev64VTmNFMsRV6kv4SRjLWP6CvXL2n8NO_Xo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeQnYUaYB78anBa_nkXTuA4zU7-F19vr0I_HtyR7_D7Q&oe=6AE356AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-KDNiXjD7oQ7kNvwH6lmyR&_nc_oc=Adpc8tDOaha1s4YzQaCA6Yfo7PpJJTHQqRxvbS76Ac3sBB11ZUdKvT8AEfuOisaxOUg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt_8t9kJKymGCU_4aMDhm7sVyP9vSWa9CaeVxWpYrSQw&oe=6AE33A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbG6ZIb_KNsQ7kNvwFlCD_B&_nc_oc=AdotIZ606yqAImjNptW5S6sE3OoUkNEKtCI_d6Q2ikCe52sQ2z20XsE6v-BdZYidCBM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_YMC_Nazok_I5aOPLc_YtKNqYCTThHlJnPR18cLL57A&oe=6AE344EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
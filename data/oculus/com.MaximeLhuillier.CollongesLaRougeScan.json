1940983", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YY4D1X4PUcQ7kNvwFdMRbr&_nc_oc=AdrH4pTg6_yHpWLury6mOrnvhSU5ZoQuYbXs_jAx0Sl2QBF7v9nrFlAi-KjaKHHgpZM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WS6aa9fteNh7PGRfMSD7-zn0kQ-u4cqPpqXCYDDEj7g&oe=6A16FB40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avv3EyK_YY8Q7kNvwFWhwiU&_nc_oc=AdpCKHbqdG-HT10Yn4R3syCm4w-jON88fSTj8dEmlF1dLmid-xPFywGprlHEb4q7kvA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5za-cjkQQaZv-quoojCpmTY7_Dr2WbugU9wlGm_A3c-g&oe=6A16EE4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsFAxZFT8zsQ7kNvwHX7ddc&_nc_oc=Adqo-TNWzK5bgdOi5Cj7dcvugCRIsb2SHNXpVPI5sAvBNdON-5Vn1ZuU2E-vMquRYVE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dsq2-Txvtp56XvmbBRWb38Sg86cFCegsINN7JAQNxvQ&oe=6A16FE2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjwYmStx2G0Q7kNvwGJVAjt&_nc_oc=AdpqqhBQ8c1yeG_ApFag2S2USEHxsGeaG6ejbYcQu5luqYcwFphp3qUtSH_43IzkpK0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QSsa2bWkQ-potrCPzdoDuyVR3PupzsCAmuz5lgBS1VQ&oe=6A16E182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI-qPI1x8G8Q7kNvwG9yRP8&_nc_oc=AdqC6QP48xDzevVDM_URVkCRzQllbYHL92gE_j_XLNfUBXiOGr3ZJk4ZriASwyqF4nM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7M7bO4Cg5QHwOylZcQ58-3YenUtoMFFXzopfeyWmy3gg&oe=6A16EC6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QFzbqtcmAIQ7kNvwHmQwF1&_nc_oc=AdrpNLe7TSUl-cnu0E543TtGCRgTRe_0lbB_dwksxbN0JIXNz13lm3T9oHOvRD0VjVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFMHAIcTp7raooH05V1tdHu3lMrk7S4aFT0RI7tebA9A&oe=6AF1D440"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LEre2j5J_MQ7kNvwF5VkuK&_nc_oc=Adpkcf3HamiDRCHm5EmSHoz_Lyh1w1HJdF3pN2osh-kSNVAhfeaNGU26bUJCYs5OxQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8WMuw-DxV45SB7SaKmVMZ5URyyALJaNSA-2ofedqa6w&oe=6AF1FF8D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLcJAfzoHW4Q7kNvwFjnWyz&_nc_oc=AdrXHI8FOxDXAhtcZmZhPVxl3WVFVde1wCDtrsjLT2xk7D13eBtdns2iVm-Az627lsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS89arKhy1Vgo5H7cCt8yRwo9sUYwCdZvp3MpDG3xWS8Q&oe=6AF1D72C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j68APYu8Q_UQ7kNvwGOROZt&_nc_oc=AdoEvW0CoO1M_BSiqM4gQ1w3XXhF22Vt5DChH8SKYdYba9divsITmWG9NeV6WsxWFiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh80ocrIeT1FG8r7oCoDgZfiFhnT0NV1Zm8ZFM0Cy1VA&oe=6AF1F2C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUOk6xJhmLkQ7kNvwFVBgI1&_nc_oc=AdoX6X1noVEOnm2_Jty7OVHDMhHJ4QmMgI9FIKk_t0m-xJdBRjQRPRZEY-HffQd3R2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5IjzD8hENpPn0Y1Oor1-WarktampS8N8OFbilDD3h7Q&oe=6AF1FDAF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
8607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFZDLvcw644Q7kNvwEiirVB&_nc_oc=Ado3zuMfEqItCNwiGugeWxeP4YhcmFxhiWMYUoE5xDPCoUy4edBNB8QqfoXKk0foBTQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVr8B3HK-U2VAkA5N6EqjK3MdcUZw-E0huE5kzIU88fQ&oe=69C149C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3G9FxQDRrgQ7kNvwF4Uvgp&_nc_oc=AdojZ0Ws6lKLkRnghPwwsLNPWtYDTlsci_Cjyk3sqGa7tboHqCsDBfdHun7T73SYn8E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcWKiAkhOLns55fB86YFse-jLRX9WL8SXmXRiar1bPhg&oe=69C13CCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAIKYGVgZRQQ7kNvwERj3gt&_nc_oc=AdpTHnC4b5a0M_eX6IQ0s_e9QC7SmAg-HOc8cJvknEYFFjS1hdszkVMXZPNM4K88gGA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw0YCHEyzIv4Al3_AMjdHzvTRn1ochO_Kv479lUt_hWdg&oe=69C14CAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoivtuFUTsIQ7kNvwE8uhQ3&_nc_oc=AdptSWVtCxre3hs-jXHYLp6cqOOsEN_2TVa-q5vSc1AR51uEpSOCkgAg4PcL2fYBodc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbF_CbJdEmZ_ZDw-047LOiMZKLaUD70cM9x4JDxQGEyQ&oe=69C13002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmobOFeOycIQ7kNvwGgMcwB&_nc_oc=Adq_d_F0XLzrvFz_9Fw0DQS_LiLHN2ChWZXJp-S1KZAjp89LbQmqdLYZFYOW4Btbs34&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfythHbKa8W1GjLpfgHXU3Bxe2JkAuWm_layVEkGOOSxtg&oe=69C13AEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres":
1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zNVtQOfYq0Q7kNvwHM4D-S&_nc_oc=AdqtJ73QdKEfeCl1njxidcOgOOBci7Fkr6_KF0jI5s-6t7Hl_6H8A0kBjiD71v2Pdx4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOigDfEB3boRMeogqBdfa8JLaajpu4D_zl73_2O2uJObA&oe=6AC3AFC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiMd6HAO_VIQ7kNvwF5GblT&_nc_oc=Adrilmseul2qKseFZRHkfmwJIHrlZmjG7Gy08n1f_eXFJoBmTgPsVVmeZ-snk4Ff7D8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCbKy7ZSZn354r3JBkPx7EL21waTktPhm4Cr3NyLwRPA&oe=6AC3DB0D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7vk5mL8rPcQ7kNvwFN2ewe&_nc_oc=AdrWQpTGv5fhw72SK2x37A3NMBx9B27lV6rLA8goosyS_uzie1UvQIcNbYIac8NN8ck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5huSy0QLj7f7OKoZF233ePE__6-Jp1ED6mHnU-sCdfA&oe=6AC3B2AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYSENO3tqF8Q7kNvwHRCAIS&_nc_oc=AdoiIpumtfZvJ5PjbKPq-juliD2i5WVBaX5HvJQMzSkeYpYrP70QgKphXnwdOTSCPOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkQRM1iAcTxzYQpiK8haVxdXIgLB-4nlLRi8Knwxv2og&oe=6AC3CE42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCHVWiAKWXEQ7kNvwG--zLf&_nc_oc=Adpnxd0Rp5xj7c8DZ1bZDRn6mqFPiFNsHHADPjdx68fjyc8Y2rYkx4H3WlS5d5ddKoc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPNhR6Mq87BqIqbPW5PX2c9MLgRgr_yN7yPWQq3SO9Aw&oe=6AC3D92F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
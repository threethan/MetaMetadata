8607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmjEZM8iiRYQ7kNvwFgkBKj&_nc_oc=Adkurb1Z2PvIdDoO8FU6zv4uYVS7VBT3ZvPSbWuD_nbwDG8jEtNtlvi-PnGgVlp5Dco&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfylDVKb-nYpt-vS35GseIjjYwxV4RioTjHUpFdPQAS7Jg&oe=69B177C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjmPK9gOb7MQ7kNvwFh8jB1&_nc_oc=Adkeldqe_V-fRN874LxVx9qD8R8BWtttLx7BIlkjFrlnVj_KzkEcvqMjjRCLS1vyEPs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0VqaJavtfdWDWeU3_UW-ciIguEctUMCZ1jw78lH2UIw&oe=69B16ACD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O_C1nogFjIQ7kNvwGWHJA2&_nc_oc=AdkhwKaoM2YMHvAeSSbxTU3YRZMtK-bzow4FcvludVr1maYlHjRwnVTEiqw5prg8n4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtHC7kTh0WscS9oUEOeHu26CQPCTD4CuQq7TJnYHk1Ow&oe=69B17AAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ys73AMwTSl4Q7kNvwF505rS&_nc_oc=AdnKMhjrUaXMCD-E4Kz0y8jsP7sEQVyQcXvVaI75hCQUMLzWkbS1s-vdrZi3xz3xG24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTS0fQpznCpzsag_6S9HWxAJFjLzYsM0oVfZ6Agq9aiA&oe=69B15E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10CsSch_0nYQ7kNvwHXKV5V&_nc_oc=Adk1rN5KKjxJyAW5DbleOcEMtTbpld6ICU2qsueuYzwrtV7SKKDK-GGtCoIULcj2wi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhLdWg5qJzoW9lTs1dRh8mEUWnjUgJoYsAjOune74w3A&oe=69B168EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres":
1940983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVvX0gFKR7cQ7kNvwGC8r2v&_nc_oc=AdqfonUrG--qstJ_RFWK8SGMycSOqT2az-RrcF-KuGVSHdkBvYbXgmAVj9eV8rj3umc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lIVK956_0VJ-ss8ikU1ZVQOsFTJDA82DAEXpp0DEcgg&oe=6A315940"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFhlNIJJAlcQ7kNvwE0w25I&_nc_oc=AdqTRgdYOgbp6Bih76qlm28Muj3UOKAzo2HEKu3H2AkKBihgDbEJNeCzNjX5BAQ_tjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MzEavYVyXRewb4kO7JX5vBHFmm8BiKoI9cTNYTOFd4Q&oe=6A314C4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDoLh_jkkTIQ7kNvwEHTHva&_nc_oc=Adrq4wlbfhKq29NLEqcyvvD3_stVlnfLogfcNDuNnoirLS8t1RXe94ZWhZkc20XSWCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fN1HpUi9hKI6Hf7jQE_mowqiKK84fwQhG8G0mml4wZQ&oe=6A315C2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b__d005F8aUQ7kNvwEkmKfD&_nc_oc=AdqMiPaYXdltswBeKrCDUWUAcPN9xI0RYdqIsBjnhlIOFO6zF-TEoIFIGCsDKV1-1qc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vrY8h0dFJuN_9U2sKdpT2ZGEkKVeLKSybou_aPLntHg&oe=6A3177C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIOFMW_Pn1oQ7kNvwFxd5H0&_nc_oc=AdqymjeHuqeBWWIsgsnOgSK3zgnnQvH10PpnJlJ42xBXYaiJXB_u36nwEhb3UuO92lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C5V4kTzjNCX8PyGEJxHrqRN2OrVb3HYiw7yvGOGHoMQ&oe=6A314A6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
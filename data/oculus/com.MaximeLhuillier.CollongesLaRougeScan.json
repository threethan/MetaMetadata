1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQdb6yyoFMIQ7kNvwGiDtty&_nc_oc=Adrgb4Spuszpbad2CngysaIGvc2Q9WmaWA8De-J1wGCRZ-60qIH-s24lc_WmkHc7YyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtFV_PZCyZy2kBkODvUpCltS07KJay5cP1J5pyk-z_Gg&oe=6ABFBB40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6lXlMkITxIQ7kNvwFpWDf8&_nc_oc=Adr3a_FZa_mQovis0ZU5mq5Wu_aGouFSmeit9wPwIYnqR97rammfAo60fOKs__3Z6Rs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSO0-yXr3vGsqNhXY7X9u3RdoFJWS3hpn7ZYMytlpRPg&oe=6ABFAE4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHPglDflU_gQ7kNvwGFl_JJ&_nc_oc=AdpcM4F58_dYK-iSmlmAE9wtzFQVy8PQu4q1DaEmHgggSTON8R5RjHDlPd8I1cLmCc8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGJleKZrbm2QKEDQDwrLWanvE1w7IRYGw68tXnOXfa1g&oe=6ABFBE2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrCX3UvOx5EQ7kNvwG514AR&_nc_oc=AdpTUtApHPSIa1GD5BR_1JHDLFQ51dedC1odjWPt01immjYO0ZBfJKMp2C-72RBQFP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYHSYqC3SzcUPtLeYXitculXJsbAi1QXuwgawpoLe2pQ&oe=6ABFD9C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7UTZv_YIB8Q7kNvwGdp7nV&_nc_oc=AdqJDtdxPS_mgS4kOhvmAiNHsroqpOioZm0OGabpQVJy0cJenS9xsSaYwuYeNl1Z8MA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe_87uo_U43hwWB4iAcBSL6Uf0TwszpcN9ELPKswOqrw&oe=6ABFAC6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
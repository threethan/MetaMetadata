1940983", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zNVtQOfYq0Q7kNvwHT4o6j&_nc_oc=AdqtDvvO9wT_bDlC136kFpH9fG4wuA9X7YrpZ6Kv6K660T2zCNxOwLpN4Y1G_gnbp9Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-PKKFyaPCHEx4-IsJQAWxCu5mTiexAZzN8RbXsVc1Lw&oe=6AC50140"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcaboKTmrF0Q7kNvwEFUopP&_nc_oc=AdrLjzpVnnnf4dW7iCJYRu6Ntl4HQ8klcozQgVCALGP2lSSQAjRlxiCK1zLmEy_7lro&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKgY3R5ZrPps5MsnaPC2WZ7JF94VE06WVRXqODj4Y4hA&oe=6AC4F44D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7vk5mL8rPcQ7kNvwHxfIVq&_nc_oc=AdrxZoPTcXRACNEMBrobE8UAXh50QtQHQUnmp6xsRLlSl_9LrpQO54acWBbVqBnHK_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJMy8OGZvbQ99RMD6vtedVEBMmTOWaCzNVowbSOs5fvw&oe=6AC5042C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYSENO3tqF8Q7kNvwFCzoLv&_nc_oc=AdrbtlWA1_GwJopyZySg1Kg_vSw_dao_NDdqH7yi097kG0q0OeAAw_EQEmQDwVZCmN8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM17OGbkDr24M63EEGfbMEjFldJ93nVXL1NpABwWUDcQQ&oe=6AC51FC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCHVWiAKWXEQ7kNvwExniUB&_nc_oc=AdqA5Yow1a7uXnWkLE_qhBIEXrsDX00qmEMNPlhx_kMz9rECET2pCI-hjFVSSxyultw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4d8TzLy0u5wXXAEIoc9ukYMb1k4xwRLAZEU6qlTtcUQ&oe=6AC4F26F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
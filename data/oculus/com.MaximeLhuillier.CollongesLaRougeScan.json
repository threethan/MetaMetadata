1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnzxftfdHQIQ7kNvwH5DsuG&_nc_oc=AdqrVqCfArjyaNInzDPsRwan57PVt0Txl_stBkrCdY7T8xDeAFmp-ySWW4wFlR5r4iE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QMQ0cl6pSpa-lS_xftlk3WI6fYLuvVn8fJ7q9wz4WNA&oe=6A2035C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuxqKY-rC_EQ7kNvwGW6-sb&_nc_oc=AdotoVDZg2mx5TR_TIPpMnrMjc4zHlJ7U3BhE_v8zmcuWG-FLDFsm-vdOIyJaSp09aw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7s4Y5BESAQlrNmpMmGk5I0kavmyOKODOXWSdreFff6oQ&oe=6A2028CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYSNzPXN3UAQ7kNvwH7MrFr&_nc_oc=AdqV98L2gVjD-lWuTvRZv4qMdWxHQ8ZfCk4sqs0VH9iNQ7JkhnjbJosxaKu-2cgGbh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XQR3GQW2pvqbseuzjtzoaCvcGv4Q0aAJ8_aCUKE88DQ&oe=6A2038AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw_zhB65QCwQ7kNvwGN8Fl8&_nc_oc=AdqHvnVM9KGU-d9Ax-Pp5r0q4c5nku0U8u_XfLh143ctY9L2uLUxQIF5lroPKyr5cLE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78oCYKmhz3eK98dDxjbiJ0S7eamHcaPKwADkTXIrHZLA&oe=6A201C02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS-qeNh3ItsQ7kNvwF9lI9-&_nc_oc=AdpzbI8YIqY2Wja4QCkLFx1VYO7vBV0QTIZrUFmluaGbDOt9AOMh_Wp1yUmnTVLhw2I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46Xha0IOZqzcI7WvfCU8QErnay4MkuapL88wEl_iI4xQ&oe=6A2026EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
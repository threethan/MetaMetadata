1940983", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsSl1XpLiYgQ7kNvwG-lKvv&_nc_oc=AdoT2koqOzOoGxoeyVCfCu6UUNaAUHPY-R9x8gPiyqOPNnn-Yra7HyQOG0tsteBthTw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiiLyuv-QSjL0Jkf5vAb6HwxMmfjk52CA1CddA0gmOjg&oe=6AF9BD40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTxbG7B0SFEQ7kNvwFbIrrK&_nc_oc=AdqD3q6Vw9TTZihu61P_C9SshTj4GPDms5fzD2ToUzyHLW6JXmM_TYK-CgWBRh56CcA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4OQfhTIqET10nMkCYYQR6VlTK0kgUj2CzP0of1CEY_w&oe=6AF9E88D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHfIgPWdbsUQ7kNvwHPaTfu&_nc_oc=Adp4zWmNjKoShRtnEGsS0qYFitodh-Rh4T7-6u1DTjHqEQKscEtxm_iWAvwoZra3p34&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3rEWmX_kJmPEg-QbFo-XMdAuWY8LT_Y41ytj7fZEjuA&oe=6AF9C02C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61CKCNTTmmAQ7kNvwH9cs4U&_nc_oc=AdocI8A9f8rKFYafh4JmQqIP1eSSCCh7bhykSp7PbSca7PEfg1p_FnFy4czwYwc5JEQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBTyxqj6y8WSGAHK5TUKrB8uo40JbcsH5_OWRsBUMipA&oe=6AF9DBC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhgjh8krgM8Q7kNvwGUVRfZ&_nc_oc=Adr9dJTaVlo_hp6glHKYsH8bhCwOigDRvs96lV_rMUmU1KARqH_ERLYCKqDJ46JMm3o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG4rIqzu3ELFl46Ae8fRC7VRB6mV8h1_2krgwJc8YI9g&oe=6AF9E6AF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
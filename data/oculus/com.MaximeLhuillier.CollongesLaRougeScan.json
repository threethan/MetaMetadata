1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxnhFjvdsMwQ7kNvwFGsNgK&_nc_oc=AdoiQlY18pE_FusqRuu9Kb3YQUgkfrrnY8so_ReCEUzMzQwmf0Q1EUDKOPmqi9kskKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiKyarVrHIO-_iA9ewS7kKzBlpX27NoHwA0Sbyv1VDqA&oe=6A4BB740"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjZXpq1EgsgQ7kNvwEepezZ&_nc_oc=AdrBan9qyLE7Asm27u4iqYOgx3FVvfyS0wx83Dc3lbjoRI1yn3mGvaBabYbv11MhZYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpKzxawk0q1dLkfUFcTh8p4dfHe7M7J9ZjvhihWxW5WQ&oe=6A4BAA4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2keQECNEaKIQ7kNvwEOK1aE&_nc_oc=AdoI2YXqyGRQyEQdmktGtSxwknCnSnG3GLFYQOq_Iw-pwOzaCw4V0xZRumo3Gs5YT6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnmrui6qpY50sdmmonFANuXI4Yy_r9tD6GKrzfm_xOPw&oe=6A4BBA2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOyQTU3nh9IQ7kNvwGhNOL7&_nc_oc=AdqVvz0Meuju1hBspHTEgizGCk6cn1Y0PXljiCJA-X_Jv7c44eTq_70hSmQdet8UEQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABctyrghutvouMhgsOcbge0dpTMbnEaiiEeHsa6B8oCw&oe=6A4B9D82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey9bEPzyJJ4Q7kNvwHLWiuX&_nc_oc=Ado8okATGO5DzkPCBq3v-3CcY1Kz72vHodcmzmJTRMCCX3BPT6t0J58ox-8drsHZMI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI3pMm3Gb2DoSFjwXnVCkrHnXHq31u3BWMdfbOvQhgcQ&oe=6A4BA86F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
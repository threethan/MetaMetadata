1.png", "id": "5448030711940983", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeafZF2e804Q7kNvwHC656S&_nc_oc=AdqRdO_JPzJed3sQnRuAR-2CZLzmXUraX3cCk8r_0-I8L5Jc-yK6fA92iCQ2y2r8kKU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-fTeMF15UDlqcozcwLlLukDSvi1SfEYeSjOeD9qNSBg&oe=6A8EF3C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXJUe6dba44Q7kNvwEVUMvO&_nc_oc=AdpfgmdMwOP6wtfBFS9P8oVbhMr8h-0SqYZpDHpC9mSn8XhettvCbgIJAFzao5LYb0A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnadrTtFa9G9IlEi0f0ST_ro2FCOlwd1OE1ZI70svD8w&oe=6A8EE6CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtxfiA2jysMQ7kNvwHQmIFR&_nc_oc=Adre6ks5zKHAMoPQFfd8muGNhExxI98zjtlFKSWUmPX5cU-9pE0TJOFovQaerUtUVn0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjfDbe8HwrsLP1V_XgUu8Q7-QEIYqX-RyiOvbay4zrVA&oe=6A8EF6AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qruy9-9coMUQ7kNvwH0Fzcs&_nc_oc=AdrS_9iT7Vgb7ueZn79S8Jx2wx8AwHtoql8Rp9Wu1Upe8keNJN-AAUJqprJuLDDUXNY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI4Oj3HQbuo8i_2MUEN9DWWt6BSiXat3VZ5nPmi9l4Ow&oe=6A8EDA02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeLHFX97sVAQ7kNvwFze7aa&_nc_oc=AdrhQRj-_qMg2aK94NvSXUKotFjJGFtneJkkZ8zmVFEx4hCjqIcSAOf3yje6x24bH_o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiucYbNvz7ne6BkaXy_9LowhSu8QtC07Bv-3q3W9U_-g&oe=6A8EE4EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
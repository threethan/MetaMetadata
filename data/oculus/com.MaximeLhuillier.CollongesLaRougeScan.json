1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpZ2tpA2X3oQ7kNvwEIGTCx&_nc_oc=Adr__v14sfkgHUo-1pj5CR4P06_XHm1W8UMjKlD6X4j_isbYnxHiNh2EwEfllCOLHuo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_lCIGl0cu0OjPEMWQB6wvWiIwDm3VwNBkdKggq211_A&oe=69DBA7C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieuY1bWtINAQ7kNvwHOTECx&_nc_oc=AdqyoLbvuWviCMblbbOw0FEeJE30b5SW_2enr4rowfEbEtUiZD_VmEZaXSh1b7Rt3-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DgwcdLsHfqYvxpJr0N8bJeLv3ECqBxMumY9vgfC7qXQ&oe=69DB9ACD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cczj-X26810Q7kNvwHiQ7ME&_nc_oc=AdrzqJ5-vNDoYOSvB2jYEEmWKFx30OfQqO8iVGB37z5wJNGcg-DPIWka2N_vNb7KgZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12VRyvv_iH27zDB-r4O2vs7aeZY17zgSeRZzamvJE4qA&oe=69DBAAAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNgPO7rWFQ8Q7kNvwHqvajW&_nc_oc=AdrxHofwpby5Beg5bL0SVBrn9qlSBXk7vMjnFx_cRz9jvkoyPCw3NddD3bILliyTugM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17QYffVxmJUXbfo5tf2Iie2oAn6Ysod6tVOhPiGOcQzQ&oe=69DB8E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHMwHLSWmKEQ7kNvwFcLW5E&_nc_oc=Adrc8EYeWHux0sWWKu5H1dsITZON_U4fBoig_MR6gNj44OOgHQgJqkMAVi0hjl7FU00&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-9sEMfCCSJeBI0tdkyi2609uRcIlh7g9Y4CdYXRBMXQ&oe=69DB98EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
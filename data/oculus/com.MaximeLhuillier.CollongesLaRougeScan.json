82466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL8-m-jE9yUQ7kNvwHrylQp&_nc_oc=AdmwV38B9o7GoXuguHVLmp9QGRbZp6DG8MEBm7gKdV1KccQ2nQUCxAthlS5bz1BYynU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzcIptaILeCozZQfkBNTD8qmPZPjFZ6ka1o8NQtBVz0uw&oe=69AAE040"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvM61rMTAY4Q7kNvwHNgSxb&_nc_oc=AdnsYtxExIDibZYf3TNWsrMOOwhP_axQ0HJqNluXrq1lSefIePb4BYmHefvqEmZWOfg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwI3Gm247pU6EEhNLleYAD7HlqcQS-KdxwnkP0v5a35cA&oe=69AAD34D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG5WtCrouucQ7kNvwFxPAhH&_nc_oc=AdnQy4lVDUljIJ1q1z0DGjEEzCtwBO4JYZeNuc9npZCgZPhX2Rf-cfNpL70rcI3lHlE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw_r3pC7YtE4k9wngEMImVJTyhf5-jCZdmNEBu7CXX8Ig&oe=69AAE32C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6BcKwrbNB4Q7kNvwGwsqAU&_nc_oc=Adk1prRKjfAjYwR7t91johHTe8lkHXxvfFwuV8O_ABWKnS7tjy8-t__YoEsVDApvKMc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxdDmGFeZnwKP9f7j3PHlDsAP-BOqFCEGjkFqABWN6hw&oe=69AAC682"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI_pJ1gDkooQ7kNvwGkvD_j&_nc_oc=AdkZ124AjfWaoFBSU3MoR-y1yC7o6c7Ggm6i4zfnLbTF1TbhRjwP0e1wtzc_rfjr_cI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWuNUqK00v9tvoyaKvmOFkX8lkmSO5__-6WmxwCZskcA&oe=69AAD16F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_
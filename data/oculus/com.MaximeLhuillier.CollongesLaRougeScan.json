1940983", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMNhyhkrEpUQ7kNvwFIqaH7&_nc_oc=Adq7WNfhmfiVuFUamHc5qIoX09x0zcKuB4SA1l94phNCb6wZttNxpY0dNSHFeFrwBGU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_FknRgyuufFG1zy6V9EM-A0MRAcljfr8QpadMEz0LOw&oe=6A661540"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVCFHWlKiY4Q7kNvwHy8fd7&_nc_oc=AdoGDPUFM0R6YkxCtnLVkj8K-P0rAGRf-Vesdm7GMiJVkzhjzcBiJuQQifE3zRKncJQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB94OszWz0M8iOYysvMqXQz0qIUjXUgQRt-S1epV3kA-Q&oe=6A66084D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBmzPt4sigMQ7kNvwE0uswj&_nc_oc=Adrz2mkBtWlHl1e275ngAo4allIB1Jnv9XVhvojQGzkbOQMsZDwAD90zZ0F9ZFDyJOU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQRhHMWmi0t7Z3A1bXwsm-GuECDf8pLk44iBoBId_RKA&oe=6A66182C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60DLJFO16psQ7kNvwFKfnJZ&_nc_oc=AdozBBzdrQsyQNFpcNQrt6J_8-LxJBOav_CjZicMvxC24tEAXkBGdZY2I3yD1vZ-dHY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQS3dtdoVt-7TFFLPzZPjBD_Y_3i9nfPZn2JtIlPD7Ew&oe=6A65FB82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrBmwlooUAAQ7kNvwH-4DTt&_nc_oc=Adoi-tqfzMXOOUrQ5BPEosIUtaWikg8VcsW7EQDEmxyVX1sGHwdXCgi900PWOTrT7SY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8PTpjBpBewdH1lvTDeLOlHvb4BL8pwPaZVz5H9VvD_g&oe=6A66066F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
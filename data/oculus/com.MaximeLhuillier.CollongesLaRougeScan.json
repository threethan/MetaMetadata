1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH645rf4PEoQ7kNvwHzEBqW&_nc_oc=AdreVaQSSX4OqLrEkKp9rBwU5y2gQ6CKyay6NaYrVLbX6lBU-RmUjJcw3u7YNHhP7w8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReUMO8mBQ7nwImFqEWXCNq4ZpjQzj6amUt_TivyiqLCA&oe=6AEF6980"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWcVKNUXh9MQ7kNvwFW0uy2&_nc_oc=AdrW-6lboqUB1tNedB9qfNPZBSwsxl4Xor0HVfjSUbwpdm33fow9WIFnyWLFqVzHRyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE1ou62hmQoP1cJqcaBACViVjtCVa4kwAHM9oy2s7slw&oe=6AEF5C8D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVLGtJLcHW8Q7kNvwG_emL5&_nc_oc=AdqLx1EQZKgw1OHsIRNieIAWiB_xgqek7n2n-N5cHwys_f7BInm7tBeYrOKWDJmxlR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtgy-LvugobgRaXaJoQEQTU9H2DLKDtjPnkiObI2pmlw&oe=6AEF342C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j68APYu8Q_UQ7kNvwHYO2EJ&_nc_oc=AdrpC-_zjIV74FwkWL8fd-eAW3Nbf6a83dQZWwiohuOZP29u7gFlsqpVJhrj8A6VFIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnKbhOYfJRGNWyFg_z8JGvTWHFPBmIlCQt-RZ72C5Bmg&oe=6AEF4FC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKG4je3Ays8Q7kNvwFEwGzq&_nc_oc=Adq8AeQzmkAZA5cg5lMtGW7uyjUxY4gAj9YC4HjkpmnClVJCp9Gtnb0kcfvIe03GP1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRItXvutjzmaGkxHJ4cl1PP1fwJ9J0Fq2Yp4gY8ib7rgQ&oe=6AEF5AAF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
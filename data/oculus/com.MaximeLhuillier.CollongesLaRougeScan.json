1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiIZSCNIbp4Q7kNvwETQQso&_nc_oc=Adp7zRCjc15W03Ambw4dmEoLTYC5nygVWNauA4A_SDQJ4wKatgRKrz2SHmu27dz_PsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAulJO4_lKRqWSXZDRfKZZsdHztvmrqYs9oDVaQvdtwJw&oe=6A5CDAC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o05U1LuQ_h4Q7kNvwHLonW_&_nc_oc=Ado6jM188fM3VFPVe5fMRTLzF1IsSw2WbPWLlEZPU5Z8fgA0E42e-4ug8oY_q68tJII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2-DIlGxapK-nv-ICJnzx0pky5OTpyRZA326mzmcbnLw&oe=6A5CCDCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sBcG3vIbCcQ7kNvwEmQvpq&_nc_oc=Adq87tkYkVRa48qZw65DvlppcT62eQbEZE-z5X2HCPrIpC-p3ISui3vesjZgA4rqyzY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5HIZ4Y8fMABR0YD3buRiF0sjJYWZ4uSdHwvQbKfoNMg&oe=6A5CDDAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTkkusouqCwQ7kNvwGc16g5&_nc_oc=AdoLAEVDvowvdNpns1t8HD08iMf6tvFE7P5UHRbJ4JORZRYmeibY2mgKtZ38oSr93bc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpOyzHOwK2xLp4glKvkmoxNugap8Dmv4iZ0NYqXgg6EQ&oe=6A5CC102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmwzen_l7LMQ7kNvwFzv_sL&_nc_oc=AdqQSwvg3OzdIx-wOqKfyBpGksoUh8YxO21spzyQe-UcQvvdHg_1yQCFocIeFX9rX3A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDey-WJDOlUFrgICQyqtVBnsjDJ7oPNlD2F4tJZp5o2CQ&oe=6A5CCBEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkAHLlIp4PIQ7kNvwEM3i_n&_nc_oc=AdrI4ZtHUhxrYu90YpbDmrmhzOPb1wD1yyVl_G9dNrh1xmigTg2Lbtozc3xLJ2huE5w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1r1LFn7NC0UOHgtOdILCvZtJFThZJCp8ODM6NrpPKXQ&oe=6AB680C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLPjVE085DMQ7kNvwHgdkfq&_nc_oc=AdoUQeCFRlP6VgurPbZ0TjNysIiiueeDBiHz1zIkAqa0bGTQrl34WV12cMb_9XG6M-o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnt-NesOPMIZBfbDg4KhKJalOs6xMPwfU0fD61lYkukw&oe=6AB673CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgTTiCZbPmkQ7kNvwHduivV&_nc_oc=AdqaiHugDM1xeQgBYr_BwC_bz2wUYlRAKz7xq7V5JyqCk-N2Ub9moG5y3lF8w2ro_L4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMr3hvBGpsi_3tWaZFq8nmPymv1oRVHunZEL3Zc0r-_w&oe=6AB683AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTGTS3zNASMQ7kNvwGNRXh5&_nc_oc=Adq0Uhl8uNPG3ZWvj7W6KCH8HupOUWCdqjb7SY8GWP2uGhBiRIka5Zfhg8R2l56TuE8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp6oqSr9D0otqvSKbXHJ13gVgGzWczb-oVhvrb2Y5-bg&oe=6AB69F42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFbMfFeML7MQ7kNvwHpNean&_nc_oc=AdpFqYX99iaGIOnnfF02ErgSlrYNDV8gK11lCuW5b00JSwQKb4EaB9cZzse1poaUArc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbAuzrkaBGpa041yMpfH_7zquwnOCtE54iDOSthEVi3A&oe=6AB671EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
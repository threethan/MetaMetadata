1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq_V_Z-EdbEQ7kNvwGlNmQ-&_nc_oc=Ado17OtfSXneCiVTFd3sXMaCZ4wV3BV6Pn5h1OLxp0SPYwyVcM8DwJk8w2SqGIeV-Aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-63ZFEuwks1mFrKyNEMA0rmWuKZP0QMm0TTvf0WPNrw&oe=6AABF4C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkrXwgruQhAQ7kNvwFHlJwY&_nc_oc=AdrJ3d9DG5BKaRLqxVXPN3oWBaoFZnDi-IowZLILHdPNl2SARnNF6FocTa-Lifngk1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwnrz8WFMdVJWFoG_a7LXae3S3rM1HF1UeWKc2jbwilQ&oe=6AABE7CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-D8aViUGJgQ7kNvwH1ZEET&_nc_oc=Adpccv7at4tWIftFdmJ57LWVUi0aEQ6U2mVCsqQkdilLKRgyjidZf-sYc9gZ3ReF1ak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJA32Jmt0n7Oz2JVxs3DxONcPW7LxalAz9GgxPM320cZQ&oe=6AABF7AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvUGYis5VIMQ7kNvwHySl-x&_nc_oc=AdoIxsGUx4lTMcoIt87BtPUvwArblOe5q9ii7Ra1mRP6_ZsLC6gXX8MmC8Zau6pziQ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1NbyRx6J-UhpW_EonghC-z1QotmT3O0y5_1KbYGSPFw&oe=6AABDB02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dFe8NvxS9oQ7kNvwG-JSWP&_nc_oc=Adqbh609Voi3c5-wQJZuigN-bkqdKHgL3Q6dCBP2heI_PzO274jgEnvdfgBm8J0z8TY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY-bNjv2MuOKGwF1IYiqlBvSWBnErJ1taMFoUaTJuSIA&oe=6AABE5EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
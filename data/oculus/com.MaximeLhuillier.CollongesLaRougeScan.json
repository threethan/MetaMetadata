1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsULiZemcEoQ7kNvwFGjNo8&_nc_oc=Adphifd6qlCruBOy0zaZ7G739qca5QiIg_ReRHlgnPWAQbFN-iHTxMgds8P9MfelYlo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4BmXU4FQvZz5t0la7E0IMMPumudtqwb-Emh2GS7HdCg&oe=6A6220C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh89XD-Qie4Q7kNvwEb4Ecg&_nc_oc=AdrJLZp0yRo-PuTeaFBfSDIduP684BG3-EpXl2q8Wf5ASAmODUK9iOgN8WKnBYGMUZU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAISm2BtEZsRgSuNrTN-7Ovjt4R57NR10apUJp6YeutUg&oe=6A6213CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZH_D5dyvc4Q7kNvwGGb5Mh&_nc_oc=AdqR35vbPtp61iCEMBRGgq_WtK1A0A1mfKYTrjmcO2i5WZNZQuQgdj96A0h8kfkZrYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCm5JTSayzkPVAIf0Mh_KF0ql7Bozqv68wDYsuV1sooqw&oe=6A6223AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-S7iKHdkZsUQ7kNvwFbD9RU&_nc_oc=AdpUrhFFQmdxnLL7LaWllE3TvulC6lQaYyDfv2g7j4CXbD7NKoFkL4QGkIp8DEapR3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK5l1wQ1jxRsIb-Ozld6w4tlacD6CxRqnzxqfiYE9a9g&oe=6A620702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OT59RCoEqigQ7kNvwGxBPXn&_nc_oc=AdrHEpKGIM2uyQZ6vLIDRGpCcmDRoOWdJ6ZIXvcC8Zm6uq1vCs3tkcodmNAYQWZ9Oi4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSq5ON1b2Gi85dRmZ7_QhkgPErkZTN3mtREXMA5Nq8nA&oe=6A6211EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
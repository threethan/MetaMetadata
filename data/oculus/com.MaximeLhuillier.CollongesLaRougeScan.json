1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brxDTjARlsoQ7kNvwFoZBYC&_nc_oc=AdrHHZyLfJ9xFoNAah1vtToY9d5D7gxIfqca2SYHHMbccEjeKlA28aHrkOq0NBf4xFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EhUlMPilPc8Uh8wshArLDX21KTbKSSUpcJ1c0xmXYKA&oe=69F75740"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-cbzNwRE3oQ7kNvwFTkwQn&_nc_oc=Adp1lNEnfZ9WV523tewWfykkV5vAhxUJSAC1fgq9OlIqR7rPB62Vbb5JONKoofruY6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3YrG9mvMJ0TwLWOUPFjEUxU3VfFx6irpYP730E3IuWpg&oe=69F74A4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUZt6fysx-sQ7kNvwE2sCzN&_nc_oc=AdoIWSbi7CQU49wWFqZVGwFcji0MDpS1rwfhg6sE7lnPvBaFkGj0vsFGK6TvSUiB4o4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OJgyqAqxxAhWUmI_pNW05dvE5PdRk4ByOZ18ajaCCGA&oe=69F75A2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er5bVS2s9m4Q7kNvwG9hPjn&_nc_oc=AdpqBv2VSYBzRW0T5WC43yu5tb-God7YmJ7AsrJUZPKB5NXR0PVzfggcy01WWZpHQdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HdxLVbTIAjuaVG28K-CejtNa8vlIdEfSL0a7kTiUzXg&oe=69F73D82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6mzaXf815oQ7kNvwHOi6k8&_nc_oc=AdoFvMuxgIakS-4zDifflTEUEpDtSnastFPb0IxxXcMnP1oJvAwml92p7fiVWy-Rung&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hF4RP8X2NlA6sOJDwPNqNeMuHStxeHarH53G38KtHww&oe=69F7486F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
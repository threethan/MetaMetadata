1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnzxftfdHQIQ7kNvwEEGeC_&_nc_oc=Adoq9sFuncxAeCo6uwtmdm2gUxMzGVkjggUcssEvA7_H3QWZBD5d7IZJLMKJk0zgQqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P-ZiIPeBnhA6IWgD41whUA2urs-9VRczYnGwLNItNUQ&oe=6A1D92C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rLhRXgsgSAQ7kNvwGK_Ij8&_nc_oc=AdrC9nrHahIUyvm0CbFdaH6dkBTdSruwUzlvdmB5R18jM8wvyX_trvKgpAsUNJNbOD4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sPZKZnO21cr95ZfHIgVbW3kdI7z2x0P4jrfRsPc86Tw&oe=6A1D85CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nlRq1ZZKBYQ7kNvwGuZZrf&_nc_oc=AdrV-WkAOoU8N0Xgh57gEPVy22erjhrXWFTp-eHcsiA097sa2DwPXCPsWO1O0Onu_ms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Bz5OvDsb1X3F1oNogqidfF4JCbzLCpqkQwm_jlxG_SQ&oe=6A1D95AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw_zhB65QCwQ7kNvwE8bCCV&_nc_oc=AdrDqW9pYCzW7L2aI0QHnZSfdFMytkJEsqs78DUAzYCLdPcJpGYMxabflh_2ykKsx7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bfrcxCHV-rVE2Zargjc3IaX2q9BXpWYOc8Bt2dumEng&oe=6A1D7902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idF52zdXvUwQ7kNvwGOIgT0&_nc_oc=AdrN61-v5tOfmJ4mVvaSZDNYDuBbF-ZKCBmDXk_AKQx8AvZDXOPRkqsdGfrmGNFem1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7esHU2iDNbIN2mMcBJXHRIP4-9FEctNcljzr-iNz_QmA&oe=6A1D83EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
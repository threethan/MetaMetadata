1940983", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52fgv7kvkpgQ7kNvwHOAV2s&_nc_oc=AdqWVtVUJPgHn5TXlpG7H97opBQ3MIpwOjb9Jcg7xwjEUquRyxutb2aPPsdwhNSWjbk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSrZPq0S1Z87euJJXrNkNpGYWpTiQh7-jxab4Kt2340Q&oe=6AE899C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43N3l2AyZPYQ7kNvwGL8I7w&_nc_oc=Adq4CEfflV5jxXycg3iiHRZNTJlI9QhUlAKr9ZswNYbssoyl39oiTWODZLVoMf1Qzgc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXpIIzXItj_tfqguWa73lCMIf1NlufmjzUfZMBdDwakA&oe=6AE88CCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4_o7-nIoGgQ7kNvwGyzqjO&_nc_oc=Adp6iBoNcCGp2cO3OrWUPb63PdjierMYiBNQdYwSsgP01OffmBp6AJ-DuO0Q0mU4YhU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwzurBQIQTy2hO7yyxA7c8xY0gP12ZdmIor2uVQlSZoQ&oe=6AE89CAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Il-TPHcfUdMQ7kNvwEWDJP_&_nc_oc=Adow3VwpTMVfAzLF5o0LnK5drl942YY46G8PtVRwGDREWM4qYmiNbktEH8B4-bfJ8Ak&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe9UYYwnojoduRs_Kspr-72n6wFb8ymsS9sr6lJkNozQ&oe=6AE8B842"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4pKIpkcGe4Q7kNvwE9jeJy&_nc_oc=AdqiYBpQppT0zdFw-UDfv5JQcwARWijoUo4sTedBlx22gKuLd-q-rbta7l1xiIhyi3o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjxX32nVH9uplcSWJULLX6bpI9Pi7jXMFABlBJ1byi-g&oe=6AE8C32F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
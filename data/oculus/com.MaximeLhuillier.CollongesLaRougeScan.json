1940983", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YybNKy_Jtu8Q7kNvwFOpBju&_nc_oc=AdoahJUZkFllF9hV0-8cThQAukPPA0u3_vzV9FAwg5tO1LvLI3FPwnbEakoLrjktsYw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN1DC6agc5fCcejiDBiCE3i3taY6XJZpSoCFEYsfAarQ&oe=6A5A37C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o05U1LuQ_h4Q7kNvwFnVKvS&_nc_oc=AdoJu9J9MTFFpYvOtsA8r94JaAuLuQdjjqgImHktM2njFHl0VPVWhRZ9LTCqjNDgcp4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlWs1Z4zFEF9DylReSu8IkISEy1b4HBQdV6BzPxNfxtQ&oe=6A5A2ACD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRvr1GTf6B0Q7kNvwGE8eN5&_nc_oc=AdqnsaMeE1qE6MLloe0t8tV6q-Z_yDwW4AINTmp3bOu708o0VtBDSPSl5SWJZ5hSYCs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw6T1H-v8b9F8agfQezgIuPdSwhaHXlUsjL2yS1kwW6Q&oe=6A5A3AAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MIrHGP72i8Q7kNvwE_coCG&_nc_oc=Ado0_ZiCJVpSm1XwgGXpoS1dtlzVvghVKGGg-8j7ua3PpmXx3aHY9DGrrJbEUK5T0jk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV7_rwzPYJ-mSgPu_ouKGigAjY8AIOEAN9kuUvrlGFvA&oe=6A5A1E02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzO-R8lUVTAQ7kNvwGBk1I6&_nc_oc=Ado1ETjHS5BwPUWeGRSY7U5JBIxC0HJCo1YvO9C4_2230EoLY08zRg8fZKCrLqyFWYg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuEWegHEPDD0vaxjD3uqqjpV-N71uoA-SoUctJBTZQRA&oe=6A5A28EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCDd6LVetqIQ7kNvwE3wjvN&_nc_oc=AdrrBkMKbk2LYCJn-YxcG629PBO8oZJa-lun6eB5SyWMHSEU2RpnLea_-hdd0lN_DVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIly16lLvWBlSw4i6vbNwOKRSw_bN2X9Hr3sziQXpVXXw&oe=6A9EC5C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPK1pxXH43QQ7kNvwGSU-pV&_nc_oc=AdrqdYwf-cc35JNQzVuXh2f0MsdvkCBFCM-FdbKLnCgvzESF7pBYK-x-W5X0JE0g5DU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCrxGYSDqV5YnYJ0p-Y2ttyIGoFisaudOq-TZVXxudhQ&oe=6A9EB8CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxigEgRbi1YQ7kNvwEzZhin&_nc_oc=AdovvL6egHs3lDOObKP4ixeOVkbTeMN_V3uMF4ArAFFggUBtH6ClREtKnj3cWaAbLTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLxDpiYCt7HW9DHT3rA-ACyRpJOYvMMSNQkk4jLHmkhw&oe=6A9EC8AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOpGbHbTz3EQ7kNvwHoFinx&_nc_oc=AdrsbfSjcE7KYbuDGGb0xhbBgYJJ_bEEFTxVWEWnDYHj_g2LMPtC-tGnrlkHuRUdDqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7lDO_uGXyetDxjS4dejwSSvdB92SBBHiiijFSQBqsgQ&oe=6A9EE442"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VYp7aUwLvcQ7kNvwF0iO0V&_nc_oc=AdoyvICVGW92-ZPvL9d8hAnWeZrEjlKaLgvh3mzjXwjm0aywcB-0cNEls3LmMF3ehKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6DQCj9gWLmBMJYBPTTV47Dran82HqI0qXsjrB-MxF_w&oe=6A9EB6EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
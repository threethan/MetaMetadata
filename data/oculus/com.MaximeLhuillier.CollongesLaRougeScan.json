8607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KL8-m-jE9yUQ7kNvwE6WGvc&_nc_oc=AdmpqmwH-iURDdkS-2S40R9z6jE2WETve3yi3BKkjtYT3uFZVpN3KxHuTAZzQ2zrdC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzj4PhmswJUYp3DbMszl14WggbYsHc0GFvYS1U6XlVLCg&oe=69AC31C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxj-MgCV45AQ7kNvwFi_o-0&_nc_oc=AdlvmG3sJryQxgtUnjrUieW9PFJMH000qVlCBtcrQ4oMaswIBKKGZqwu5V8bjYgoI3o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkMYkmKMdSZeA4_o6VjAMgKYpn-s8C2N_KZ3QJKqLaDw&oe=69AC24CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG5WtCrouucQ7kNvwEhjU7k&_nc_oc=AdlN-cZzY-cmcXTfq_ou16mUwHkBTRYHVbnHM7pWY0U9jSqwZLM3nYQvibBF9hLrrLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1CF8OO8UqFNObSGH7jQmN_YGSVHg5psSMQAfUbB__bg&oe=69AC34AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6BcKwrbNB4Q7kNvwEKmHZS&_nc_oc=AdlxPBSN4SVTFPeVM5NgJBesFeJVLifzMyBW_oKHA59dEezuFyhDunkhQ_W_BCDNL9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxrf9-Tiv3QFYhkUKGnovnP4pNlCYkvLPGQPxH6MeSDgg&oe=69AC1802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI_pJ1gDkooQ7kNvwFI5mha&_nc_oc=AdkHXL0oQyzSMdrfUWamTY3YJr3JgnE9LWNOGoMmCQkuCywcgJvTjzHnuhjjCVXFSxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyWxYlsH6m4HsIrYJw-ZhvxiXdTUjGWGZUJ-EB59ZcoYA&oe=69AC22EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres":
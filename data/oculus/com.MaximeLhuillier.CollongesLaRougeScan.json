1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQdb6yyoFMIQ7kNvwHz12jO&_nc_oc=AdqDgOU0dbmWx3QsxGmI9AmuV1v7t0ylghOiwWugooh4Ni8N6T5VChYCx2ZdVpSgkzU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXZxPLkWYdf9lLyh5JXMis_dp5CpeZfMkIDDbtgA6UGQ&oe=6AC25E40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiMd6HAO_VIQ7kNvwHfNcoJ&_nc_oc=AdrDI5a-GLjYrpaeErxf3_xMWrrvPP9XNwkM3nkRkrFWcbe4TuTsayy478UU5ssV5Z4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbgy2677Uj9KYTACxlqcVWuysiWlzabkErbjGA83xwWQ&oe=6AC2514D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7vk5mL8rPcQ7kNvwGMZLXg&_nc_oc=AdpXJxxWLVT-sfUwJnYkxV_RZuhu4rNmTHmjOQw-JI_bbPYySKNIvtpCxEnWkqNid8A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmrypG7-Y34yuM11Npprxz01m9QxU8wt4N3Qv8A4pHFw&oe=6AC2612C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrCX3UvOx5EQ7kNvwGQrikm&_nc_oc=Adof3yWxQwRY7vgI69F5xEfxpjuLSms9arr8sWEHDz0ZPtQrACK2qsAd6LsIEqTh96U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkp0EuNazD7KzI4hhfF3GMrbTRIrM82M7Etk_BNU2i4A&oe=6AC27CC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCHVWiAKWXEQ7kNvwFmlooB&_nc_oc=Adq-KKLfmuPXE-gCYZJPiFovbUAIw90Be3PAK3e6jzl7D9zna5x3_pYAoAXJaXDI3jI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNUOyzvfFcn7gQ0TQZUIp85SHaUft8mRvX2pkD222LGg&oe=6AC24F6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziQZ2QrsAPgQ7kNvwFNz4H8&_nc_oc=AdplB37Pc8sYjzeNEWD8IGjFqATNMvkMEevOwWyfaxzHd2edb-vQc_hIP-LWZnoYLqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0svKwjtto2lFjDmm1LxObIKBOECHsgHBOUNHiUHuUSzA&oe=69EA2840"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvAYGTr2dZ4Q7kNvwFDGJk9&_nc_oc=AdrX4j6zwiU-vWZLfWQSAgByiQW_YsSiHeJ929uL9BtJ8Vb8Nng0ExRTzQeJK0xNyvc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M3YJigrboGAVR4YQlhaxBY8f-5elY-ZZkrlvHItsPIw&oe=69EA1B4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm6oZWnpIbcQ7kNvwEpkEbe&_nc_oc=AdpmXk3ux5HbP1ErTREM8488A3n-OWfU31E4xbtHK60a-0VGsKFWn0OFUWHGpO3_4AM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UTH9bW3dHAXRiWOeL55xYFsgeP23vtBV7XscaJ_UH_Q&oe=69EA2B2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM2ysSOHKs4Q7kNvwFOoabY&_nc_oc=AdrOO4DVlRv90dCFXTlqeTmAIS64_PFMp3mW3DHs-JIBx7qa6whbaazdfLHvNUuinMQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ltAlXo9DLVrmEkNNK2CS9vHGnOHuRVSXypIxXXZ8Q6g&oe=69EA0E82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B8d83Y-W3cQ7kNvwEFKfJc&_nc_oc=Adp7lZ11egAqR14olVtXj1EFDKuXVDeOYfwfLuoBlSC2Geq64YjARaRGoadhLUjT8ZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fk_AEc6x70f7s5l4r9n6Jlqtg6IunBNbUWUQhUiiPGw&oe=69EA196F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
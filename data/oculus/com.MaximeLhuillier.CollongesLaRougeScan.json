108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rG2a8TXFnAQ7kNvwFp7ahE&_nc_oc=AdpOq3jne8v0VXRSKtbt0x6qyp3KwSMV6q461Zaqbvrkhw_rCRrwGF7TJEi-O7iHCC8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pkjFdRugbro488XunRqSp2bxsGlPpf7TWxZn8PRaxkg&oe=69F21140"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf5nE8jWCdsQ7kNvwFQCZEL&_nc_oc=AdoE3H-1x-TyElWUx1fUW26Oik1ahA5mj5y9lK33SMAkVvR2szdfREFNeR67tPPmh8E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3n1jtgcL0Su5Oetucp0unC1coRrR0AaGJ93xaoRS-idg&oe=69F2044D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCG7L5DuFMsQ7kNvwFxeRNg&_nc_oc=AdoG8F5Hmgs-y1E2cWAAv8tdF1qJ7oJTQXLIm9o_hAz3a7wczCl17f6eqnOCXF01Qt0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RoQ47satek7v8LMOUsaWgZ4wS3STf6YRdBH68BcPcxQ&oe=69F2142C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbXmyaVTM6EQ7kNvwEQFA7D&_nc_oc=AdrRRgZ4V64_9DxzyxfZLldyo3_NLHtyuZNlltPXQCKTjppqdrguudICDgpWdzlRa58&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1P5iy-jysey5BqaqpNLeJEy-fqWwEkZDm-cCX8feGknA&oe=69F1F782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRr4lpdiuLcQ7kNvwEOXzyp&_nc_oc=AdpBWkHdTABFxyoFuo_fq8Cj92UQXf0zOFkz9QF4VZQpzmkFNH3Tf5l5hxjD1N0RAUI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2saI82B3jri_gdf2v_bl6226PJF02X4ce6LhVOzrcpRg&oe=69F2026F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION"], "has_in_app_ads": null, "inter
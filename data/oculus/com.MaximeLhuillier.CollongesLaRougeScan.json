1940983", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb4Wv-qIHlcQ7kNvwG0YRUj&_nc_oc=Adpvc9bd2Ovj-Na_73QtxT6l19K2PfPelYxlGZzl-nJgF8-ZdHrdY619yxVknfZZCh8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wZkCKTF8kBF4vHoB5Nl_9cpkxAUsWx-D76G8klP4YbQ&oe=6A1AEFC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rLhRXgsgSAQ7kNvwFlfVyf&_nc_oc=Adq_ssN09sJpDrXGVzYls6hRCcA36Y1rkNsIDLnrVuMnSZKPvA60JjXRKOGfr0-OGlc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qD9IE42y_fc8jEiaG7W36FtBS6d50q39znwghMYz3Nw&oe=6A1AE2CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYMo3wz0ENgQ7kNvwGuY_mJ&_nc_oc=AdpYijLyGP4W1JJkWvLJHFnE0e2csC6k8kWTENdAeuI-5Zb1U0RmybEbZYiVTqArAhs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VeJ24Wbt6moG7avdVDsJQSEDAJf6Yva068vspo1MUqw&oe=6A1AF2AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PbDMtjuPa0Q7kNvwH5m5X6&_nc_oc=AdqibLpl9KPFd9Wzb7laMISwq8OrOhz3XPdJzO9hP5nc9Uq3TE-DcG4xbVf1Ta3bKRA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ombkc9tjqCwsJ1eUL2nchNmJr7LyxXJQJwCChk1xKTw&oe=6A1AD602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtGaGQWyalYQ7kNvwHK0FrI&_nc_oc=AdpR03hOutWJ_idhSU6CPmOxLbSauCWZax5nNhYDxyHCCzRdhAthOJiyekvenjJdkVs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ThrcYg4lTK_SJ8rMJrVPyFCBdeTusqjlFSpdgkU6vBg&oe=6A1AE0EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
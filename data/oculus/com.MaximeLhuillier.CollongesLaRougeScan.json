1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml0ZcYQo5p8Q7kNvwFAkmqt&_nc_oc=AdpW6_J_yplM4G_ZXoOiI8WKS_0lIwoxX6hvqOAQOT9AVh-mc737iSixeFTHIbdlAPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpcTsxMZqv37GZ3_Fhgomrq7ft0ZRCV4_L0AFmFUYUHg&oe=6ABD1840"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6lXlMkITxIQ7kNvwHy19l8&_nc_oc=Adrc5jFnRXTcy8gkdBNwo3v367Aylfk-APGWqE_JzM8Dc590ONFhxnn5612UyvYAIEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMrOkApZOSXgcWmHGqCVI0J3aekn-2w8lAVd7dSy-4hQ&oe=6ABD0B4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BkO9ukcSeEQ7kNvwEhuNZi&_nc_oc=Ado4ZU8e7XpluilclaqHLQuiJECaay5kgrQ7RVc7JqOU9Lo6lHnM7V_Lidwylg5CcRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGwz71_lNFf1_UDNlnuUVb1RlcCIZpintkbZwBjhkv6g&oe=6ABD1B2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSMjutxGt3wQ7kNvwGrDhuk&_nc_oc=Adr1ZWVz7FPZKD43UtxnO27GU_wlF5HpXQ9ViJATF2Bsh1pBNsNQowmiaClbC0CKB_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQxwgdtHvQruGkMpfOBWHpWMzPeIrB5JQTKvEFBSMJNQ&oe=6ABD36C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEqKrd6odt0Q7kNvwE_4SC5&_nc_oc=Adpv_4E1EcushOGyJhMy3AWDV9yYqzSLQtxZGFoM1eHoW_T_4glDANUl5SRLx1YnyPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0wJ-Y4721HjDoR4kFE-gdn3EDG1Wq4WjyWS3oOQ5SMA&oe=6ABD096F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
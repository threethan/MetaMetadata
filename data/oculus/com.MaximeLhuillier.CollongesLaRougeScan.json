1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnzxftfdHQIQ7kNvwFpNd5L&_nc_oc=AdqlW9cayTSWVKZ8sV0qPiaM_skBxxZ_w0nDKj7GC1lMOptkLSLAYBf0WZIWA0hjth8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a_9Ue91Sb336hL5yWRrr_aKkrsPezzMfmIgXEsax0gQ&oe=6A1EE440"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuxqKY-rC_EQ7kNvwEuMlC9&_nc_oc=AdqDoVLmUyt5jXHRsjv9EpOE6u1D0Xket1rxMOrL-C31ytaLF8qdsD_ZeNVF7W6H6UY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YTQQgXqCXQsnMNQnu9cuPjm2NacP0ZLCECVEZo4eVLA&oe=6A1ED74D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nlRq1ZZKBYQ7kNvwEkEX-J&_nc_oc=AdpL6UtF7OYSmBDmd4g_-4dv1NCE8yReIh3_ySFQp-WOXjzWGgjaRY7rHuYaZhSSpRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NgwG8w8LNBl-2CvT0eTHeNeB-AbaM_Cs9W1cjlbyIHw&oe=6A1EE72C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gw_zhB65QCwQ7kNvwGRzgLt&_nc_oc=Adr_nOEMPZkTXyrPW4RUe2o-RFizREjuLK_NMiiW2CIIqpb_nPzJiqhhaBzEdFFXfko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JCbAeLScxqxeFHX25FqNfGnQun3r8aB8b0iCuFBXqjg&oe=6A1ECA82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idF52zdXvUwQ7kNvwGRQkhw&_nc_oc=AdqAd2bYipX-UGmNqJ0uXbOM9TDk1f8d1jPxehmqGyW49U19Bsjnx81ABdQgj4JAigY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YDqKlo9f0Tl0osGMsLaWhJ6rFokC2pe7JDSCNcRx0Mw&oe=6A1ED56F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5TNAFSQ1akQ7kNvwGHVEZ3&_nc_oc=Adp80tKCf_441zX-B6IM10CL9sLG32GZrjF_3foxUEwiNCqU6nOryuS32Bsl8-dS9Iw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k0UI_PDpHtRZjQntD88M2NF2hOgeeay7HbL2khDc0UQ&oe=69D904C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q48b-PHJKv0Q7kNvwG5MuEn&_nc_oc=AdqNXQwmn0pSgjwSwYj-2PwzLfGa17Fi2HTmkglT1MnlOmQX2WIpraw_no43zXensJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14g_atQsCev3wMM7y0mQ1XBNqrU0u6jujnZmE-ror9Pg&oe=69D8F7CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cczj-X26810Q7kNvwExcfuh&_nc_oc=AdpX4GFj2rleHPm3SIN_1QDzSJUlK-88oJEYOjTHzkx6a0Qizz4ZJaBN0uHFynIt6-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-PpuuuEWUF-UbpTEMTy5Es-5TrK4AOgwwazvE5kMAnA&oe=69D907AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v8advsFSKMQ7kNvwGUmDt0&_nc_oc=AdqiQ4NqfDFJ7nIXaUxN-pNSFV_qQpHaFiKDN1sTrDbPhJ9mnj_SuwHp9rLcM7ewh-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EF2O5GiAYW4drAta4Rq6mZ4KgsLjBwIz34nnG03CItA&oe=69D8EB02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHMwHLSWmKEQ7kNvwFiHygG&_nc_oc=AdphhFHPZq8ZYAmQm2ta08ijECYX1Vko3OdWAEjwqqKZigLF-eblZadZgn3TpTX2vZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BQghk72ggKEkncVcrx-MEDvJ3LPmpVvPr3n8C_14rbA&oe=69D8F5EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
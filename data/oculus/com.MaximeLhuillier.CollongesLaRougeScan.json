1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-cVMy_L_ykQ7kNvwFzAZim&_nc_oc=Ado7ftaAfgFO8AL7HFlUIHkepjG_eklJkmGgdEn1Ono4lJH1LzdS2isPYV4MxEhTb98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ljSb0kCegfGLeThg_7kv-ShC2Uuqdrcoc_nXmRdncUg&oe=69E390C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF-TVheOoFcQ7kNvwErq-6-&_nc_oc=Adrpz0UB_8aW2tRlkPbaxPa7loCEZbX__1c18Qa7iV6h8aMN3dNIjJS1tskOAj87g4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2djWpVU3tUgve5gOA5RqZ0c3bYBMDRdrt6Fi0AwzhzgA&oe=69E383CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxtRo6GzhnkQ7kNvwEPuO2E&_nc_oc=AdpeEqSaPW9qJ5Ft__VC05ou6ObEAsycNwIbAvJWGID9oKfOG5n7au_96Ku1A5boopE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QUq8qdeThdRUcH3RSR8xp9JyeL4AU1JbL3P-UxnXfrQ&oe=69E393AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6y5UR-_cSIQ7kNvwF8YBK3&_nc_oc=Adp-sl4E1-edo-EA6NQ7-_x1TiQ9WdueL20nPd4yctEwI2Ls3WQ9HR3EALCMUgzAvHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fcw1nP_FaCHJROMpU4hgyDkdyNWNSzvTtEZSGdC68NA&oe=69E37702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmbcfcqGmHkQ7kNvwG1azEh&_nc_oc=AdoI0THY4CLwkq-_JqlOkgOc5DCsw5KLJN-YSjNPy1-9lZDKSBUjZSWVXqIzR1yJ6k0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WiT_HOUthm1UznDeAEtxZKXsG6unzx0ITKLpX5YNmqA&oe=69E381EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
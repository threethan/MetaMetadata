1940983", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC969i5PB3kQ7kNvwH1A3v8&_nc_oc=AdqHX1TgHajTnyFeDIYz0Ms2ILVdgT4Y1h5FfUh4GhpxQx83KVoOy9MBBh0P8T74KAs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFroJG7ucuMwb0C-3Y22aFvvKoBPW_xRuk7CU66mmjEVg&oe=6A71F2C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-isLi0ymUEQ7kNvwG3Mun_&_nc_oc=AdpDTszARFPT4f39JuZyrYd5r2V5qX3zU2LxBOQU6DGsDDzmMBZ_zVkSgbGNh4ZIBD8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWNEn32-Hsj0anCJfuYHPjNmgDjTxS5BtzTmXrkkywHA&oe=6A71E5CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me3ukClDUsUQ7kNvwEA3tei&_nc_oc=AdrYIeDQPOM7vmjDb4W2dHRjySTYiNdJtnPxYNyMjmJI4SyHfAzs2KEo2xiyh84EF2w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRvnLZkFTI3Fu_X3NSGbuOQpdKp56zzkZBfjlAsY2nRw&oe=6A71F5AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBNBP4bqwL8Q7kNvwH1RITy&_nc_oc=AdrMadpMNlnFWkG0htqi2J2lVhJIXJwZRW2kC2LNgJOlaFJSwXF1J7boQta33yVr4EE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHV0rMbamKMJ6oCrYiiSjwKrPZ110eVETC8RFaWIddGeg&oe=6A71D902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPuVATYpiwYQ7kNvwHcvotq&_nc_oc=Adp4_ZNhzKJ4AqGY8DNMWpqUC8OgXtaZyvegdLTOjgSjzTaAjkxxigxBHLudL_yfDWY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7zo2yckkKQyTjMup-uyIrtb103yx8NwmBwoXE6fWKDQ&oe=6A71E3EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
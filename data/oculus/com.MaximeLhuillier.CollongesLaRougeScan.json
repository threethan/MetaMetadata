1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wrgg6B3Z-HcQ7kNvwHbiGBz&_nc_oc=Adr03LyUwrVAK-utMaRBdJn5UxzPovd7FtH00qk1awOuhwabJAbUM0OQM5mf-RNebe4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ciUi6M1XgBPcIj8-vBvQt7gBwonrptCtsmW3PA7sCHw&oe=6A3BE540"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kzrkTQ_y28Q7kNvwFjVBw8&_nc_oc=Adpwu6s64hY5ILF_r0RFsqDL_BrVZMjcBl5lJGR8alJeKB0CfBE3lCZ510D2JJN8p-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_41d4eBWowrUqVNKpiWa9WQKquhTrJUVNGB9UgJVbiFg&oe=6A3BD84D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGp-P4r_x_UQ7kNvwHP3DDW&_nc_oc=AdqxOAyLZL0Sjd6hNo9qmQ1pWuWweV81eNvP85S_CpQj0fOtOp7dwm6gRtQlQYoy3ts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xr5to0OvEaVehaObTuE_h1o9OFevv-GOm76u5gxcQBQ&oe=6A3BE82C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8DnCbD9UScQ7kNvwE7MRxP&_nc_oc=Adq5yMqhpNh0tUhNa_drOjbHxmy2HnvgfLtROSzrCW5bIodcE9V6W9ilVwCBuQXCHEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B9owUwIbuGytDzPQAt6VkQdOra_d8ZrbyDUY-YATiNg&oe=6A3BCB82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_BFARNVG20Q7kNvwFGDvpl&_nc_oc=AdoGFW6XXmgOyTM9rvHW6OnTgCmD_gzEJuDfj1wRP6Uefnb7xDbdwx_qjywMZ4MXRDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mwT0Uhu3VC3bvHs3280HL4nsHypoe1QyPiD9pLs7eLg&oe=6A3BD66F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
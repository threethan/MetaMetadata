1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOjt2VFoqdMQ7kNvwGV_wlJ&_nc_oc=AdqDev_4Yd2DwNHI5Z6jQmKo1d3hR1NAkVdoKgx4Ljkw4Ls1uhLYdOZq0d64JYqc2HA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv_XnTsyE13rJxZXh7784gI5iiY45E1NhaOKwnTvjSHA&oe=6AE20240"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g8bTcnVgOAQ7kNvwGO73Ul&_nc_oc=AdoTynzKorpMKS2LbAr4IRa_x0iUVo-uo9eTX-pgNCzwU7_76xP1Z3zeFFbGqBH_JoY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQIq5Jk9pdinUJZBTW8GOVDtUHtP0r-5s9YZa8Y41xKg&oe=6AE1F54D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3OUXRqYUWIQ7kNvwEeUPRp&_nc_oc=AdrMMG6uEcv30rY4YUTImJOZP9AGInheHz-XR8iKuA6r54O63K43WrlBOhOiwwT0iqs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLb1EZxFoQDM_0PuG-VccFq7G5ma99q_JBLnYjIgnerw&oe=6AE2052C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyL7-zhK6_QQ7kNvwFEgqbJ&_nc_oc=AdpWYKGiLQgOToDVrfc357JY0X2VUVv_BeWZ0L6GH-D5iuCimClahwIBAGdPaZ2twPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXiIY2bFj3etre5A1yF7EHMIAh7medcVG-YKOJ7FVPZw&oe=6AE1E882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbG6ZIb_KNsQ7kNvwG68nNa&_nc_oc=AdoG4UpiStpMcUfuH9wbLVpvMiCGwEKkpO0X7MD5gcLxmGTBWy04Gdot6ixkdjJQ3vo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2db8kANcrCRHVE1c6xt5ymmkS5EKqDopMS9qUrT49pA&oe=6AE1F36F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOjt2VFoqdMQ7kNvwHUUTtx&_nc_oc=Adodbd3Ah1CuibHpAE7jSNgYzdrZLcKnx29nrNnSY2Y2oGP2MutzRyXJHlNkdaAsJQ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2EvHt7tGDjZmsrTANYpgYI8lDAcOTkULoRMlcWY37Rw&oe=6ADF5F40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayPHModaelUQ7kNvwF3sGAx&_nc_oc=AdoMR-FMcrb0oqNE0TMr-bpASNqe35zMQshxYpoYzUVM9QVRPa7cDTIfM3N2PCRKU5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Ydv6oTf0GCg8SBXKBBGRJXCi-gkP52J3GnUYp5Mo5w&oe=6ADF524D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o8XzuG9xpoQ7kNvwFgXGEa&_nc_oc=Adp4uJV9TBwS6J25GchFewlvVAVr_tydAf_swQVgB2PTlNQioTdJg0F1kgQTTD1rHZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrk7ldXFNKshmEDZc9PMds7t3_yE11X2PlEJa7mu38yw&oe=6ADF622C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyL7-zhK6_QQ7kNvwHe6uN2&_nc_oc=Adr0U_HPTKCYLwLvwi8tOTK5hLkLl5vNn2nX40aXEaxYI5iNOAlEVHn-o32PE7Di8sU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpW1PQTmN0RCW7q9l-7NChkCq-Yr1zaLYy_GChAsO2bw&oe=6ADF4582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtyO9IhkHYoQ7kNvwHw2gAA&_nc_oc=AdrPCU8NNBMuNA81-Xd9MqkJJpFqH8Uhs2sK0xHwAguLYh7ioi0bpUwswIVQ7hi7ZrM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq2j5iI8j8vqzlYwAobEPNlYoOd_cU2AwMIDpZ_GzXbA&oe=6ADF506F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
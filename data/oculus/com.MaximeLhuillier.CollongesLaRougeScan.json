1940983", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVvX0gFKR7cQ7kNvwEAPJ8W&_nc_oc=AdpGpS-8_R3FHiPdaX0K0gqYYJG1O5N5E1uEgvgSrKE2EALkkwmF9q0bs1Swgtty8n0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DAJfynwWomdqSFUedWrTXCVX5yuUFcNUjLRNhnXuYaA&oe=6A33FC40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCADol0NguwQ7kNvwEYzZwm&_nc_oc=AdpMD_AHbtFDFfaDaR2woXpwS6bd4nRhRko7CK5qSSmEa7hgfYpLFdCDQtmIGxLZSpk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0mMcgch99iSbIwUXgvZVcvvAShOXZD6IZ8ZBcVCMSYg&oe=6A33EF4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9E_MIQ9EQwsQ7kNvwFAZKUF&_nc_oc=AdqsUSzgIwvyl1gji-lKCf6jl8D4NQVebLCQSaDKdc7GSuQLUgTab1hvihQRL2htBtA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82ABDbM8Z3M8y6AhTYLT-P4HLTXX9yjjdnJTE73irr1w&oe=6A33FF2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b__d005F8aUQ7kNvwEDTAdo&_nc_oc=Adp7X7lH_vM7n8ym7EGDORxxVv-XfeAT7nSPjp1YhhCjLVxEVXzrFZNZSW96B9A1Mug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D0GbbgAV9r8MJuqKW7VRC4kNGRWE0SoUPQiMayLmTaQ&oe=6A341AC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPbVoAFCMUMQ7kNvwGZjz8y&_nc_oc=AdpoznAVhkQ7yPbjLjfy1en_3DwR4zNobtiRebQbdYeZSKoR5JvfN2Ke5uQ-oAVgriQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W_Y9HnIFPjBUS2VlwP75vLjrNmMAvKy0hjoXVQK28MA&oe=6A33ED6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziQZ2QrsAPgQ7kNvwFeQqsC&_nc_oc=AdrPHtZHUiUqktxfD6Zf9GRV1Yw1XQol5HUQdUxHcCDxYRtXuw8i2osaq1WVbE75RyE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wGm-14RIixY4vI12HUHJ7VEKdn7_XD3HiE1tXnAE8FA&oe=69EB79C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EW7m9fapHqEQ7kNvwFWdaud&_nc_oc=AdpZmEicKppT8kCKeKHvxcLxe3G8_FRybEv7JWwBOWd98g6ZOw3lmGROi5qTxic6QNM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rpRochR3q_1Hj9FOqKawa5giske9XNG_58PIzI7alOg&oe=69EB6CCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm6oZWnpIbcQ7kNvwEXBJk1&_nc_oc=Ado8h5py-iyq4RamPegf9QBlU9VS2oAz3rCJ3KualpFAbKGH_Cgh8Vp9qP_vtdZxX_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1KlTfs0hy7mAM0MVvgUaQc3WnZCQJBlcw4ei5PLcpZuQ&oe=69EB7CAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM2ysSOHKs4Q7kNvwGcNSy-&_nc_oc=AdqN41XpM_zB2LXvjGq2bUyFnidc6-Hk7g60IXf-2DkZexwEvR84hph_2cK5-FdUE2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aBEu0GXVA9Zirvmi5YRkw7KZTi2iAWawMMCLzKQehvg&oe=69EB6002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B8d83Y-W3cQ7kNvwHx2JLH&_nc_oc=AdrzQwrpRcgHv7pVJEvW_GUmSjdXi08Cf0rv9BwaJfEotGvIlf-Oi2xluFKRnJ3biPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H3NP87Xm1MyMAQqb-39Rdgxsr74UJg03An5apVVJd1A&oe=69EB6AEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
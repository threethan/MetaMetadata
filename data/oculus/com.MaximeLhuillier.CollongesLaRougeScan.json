1940983", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2eVFOWoBeIQ7kNvwFQsdJe&_nc_oc=Adq3losYLS0hiYg9c_S7VOV7M5ChMAKrnnCEWJVPBnvTM-Po2y0osXNQNMvcT75Ur2s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nTGtrjh5aAZfb6zNDE0SDwtghMFTF3b8986w3uYEVqg&oe=69E633C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF-TVheOoFcQ7kNvwH6ktqP&_nc_oc=Ado0RPOpRTTjGypZFDfUS845KC7VsfsCCL8aqaKvvBg4k9cHW3sPfCEIJFVAyVcpGT4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zOV5iNw0MlJOi73pOrzIkxBFca4tfqV5ZOTgrtAiRnA&oe=69E626CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSns1RNCuOYQ7kNvwHqHIQd&_nc_oc=AdotopdBxj2SRibC-mzfl7xCIyG37LPqZFpSb-yWseiTeji9SiC6JeYULKlrjQ77_5Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ensLy07_kveGR5nic6Aw_SPAOQWrsGmlCMsNw7eghFQ&oe=69E636AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-hQRJpWGcMQ7kNvwH7wi83&_nc_oc=AdrrMDgpEIEGcf4cc5VecyQ03MgDZWRKPhWKxOs5ln52XW0eeBHNdIFLLttuhzH_nKE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N4XMWCajlEUCv4q4b1mW-MA6VQXVJFVMO3q6hWAjzww&oe=69E61A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeA74YfXn9wQ7kNvwFLderg&_nc_oc=Ado3u7VMvBsV0diONfZTfCA3k4JzfYaoem-Ch8va2xnRPatQTKLNzOgJ_JqufwGH2TQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38PUSTWDFf7AXymJxKNsrDWKJK_0nElqJctj9-Wijbrg&oe=69E624EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acd3UO_mdKwQ7kNvwHH0eSo&_nc_oc=AdpXM70q0Sl-T52U2L_F7OgOPIBG2XDtRPR2kyxLbhwRXdQy9vl364NDiMJY2TUWsYw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIwED0356aB0-zWAZkeUs9xsE45ijrtcBT_ghPyjZFjA&oe=6A940180"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9b4OASg4ekQ7kNvwE1Nsfq&_nc_oc=AdrVx0LBOO_m8kiSOaagsaEbSJ9LalyIVVcs5RSEThGbvIzp-FB26tRIOGsdEn-JKYI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEpojvBSXuHRylovGeXBPdDo_epj9MSEU1CRizSJtjRw&oe=6A942CCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7CVEAI9Av8Q7kNvwGskexq&_nc_oc=AdqGX8_lwsmqSGoEYfVfjHa0giKQm-alTZ4hNDNamsIfz1ueywjhRWHuJ0U7WPy27Mc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJSo8x4PRN0bHBuNQkEIveSgGfMC1DYLNkMcw1J2wCuA&oe=6A94046C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgQhJgFzQZ4Q7kNvwHeBlmH&_nc_oc=AdqZHXP31S-dutgHTuOY92UsQoFdObft3GUPxGB2Y6HEdUU9A2mCVfRqvDzJlCXnjhk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLdYPja6gBhwUW9Fh6imlBWAHaoENcpiP_g0856wNRpA&oe=6A942002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3XN5ONNSx0Q7kNvwH2oOwu&_nc_oc=AdoPrLu-YLLCGE6CpFHrZAduuv0dLaY9qbQCexNddiVz0ahaf1JKYk8hDQdcPxwbvaw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWW7kh8Mi6347btN7s38706sA_aTldExTL-AgsHXl7WA&oe=6A942AEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
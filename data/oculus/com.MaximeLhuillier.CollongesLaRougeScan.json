1940983", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVhjtY2TvloQ7kNvwEXH7xm&_nc_oc=Adrkycc9frih0Rt3rRyq9XiSuluJBJcVAGGiJAJ7Z9F5oFDqzkagbsYCHdOI7gUIwjc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA20g95IyvMz26mYBzJl6bZmI3OLyqJwJ0eFouY833w4w&oe=6A4E5A40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7yb4pJrtE0Q7kNvwERYexk&_nc_oc=AdrFQxNSQqzArf_OuCwhESue2capf2uUgJ5WB-MbizNtCoHvZUITrH7sRkphw8BAngQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA78e1Bv-Qm6-n2rfsr6UomRZy7_b-0156TsV7UiSbIkQ&oe=6A4E4D4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2keQECNEaKIQ7kNvwFiexzh&_nc_oc=Ado7I25tCCXc39gFxpYkAaE8Urn76tG2PHanxn2Dtj0duqOG3O6rd7I4jQXm7wYmbYI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQbABBbsvTyyWQKxnL_xfqzSj3TQCqseiGSRTIupwP3Q&oe=6A4E5D2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga_FCYviux0Q7kNvwGC2wGA&_nc_oc=AdqJ-C6rhAQjb83yDfBO-fHtp_2a6-0DyW3s56v_yIO7b0gBITLrkccjSMEH_SYIMVU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0ZJGAJyUKCVjq-nlJOzgSI4kIXkkPyGLNDtmMCUbfFQ&oe=6A4E4082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey9bEPzyJJ4Q7kNvwFFFavY&_nc_oc=Adr8BGoeLNW0pWu5uRoZPzLKbIbIJ4WxYo60n6mDObp95xBvxdEhMWCHwijesFLpDDg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPxULfCrEpPlkwlcD-ji4PkgWFpOzN-bAAXFiKAyPyFw&oe=6A4E4B6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
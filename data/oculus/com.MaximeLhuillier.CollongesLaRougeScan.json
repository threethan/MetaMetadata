1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oozfQyGQuLgQ7kNvwEgvqj4&_nc_oc=Ado9Fi8BAvf6rsSqsb_M9tQn_dRmx8xJZpJIrsIGWmfsFBUvbpgGj7bV8kJFmpFCvUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHil3bL07H0tCqxTP5-0fAOHvP9OisV_UZ6hpaSL1w4DA&oe=6A788A40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIOnGcfWWkgQ7kNvwGmVrTF&_nc_oc=Adp7HqGHC2o738b_HpgPtPlGzhZVhzSP1EKji9tVP9LAdMwtlV4ds3degLmjr79iDvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1XPEz24miURrGtDkpFK6c95TuLicM9I_g4t1-HAfbfw&oe=6A787D4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElTRIpKuIb4Q7kNvwH9EHrQ&_nc_oc=AdpM2TbgxBF6fwbl3fFivzXADN02CDr2OO9AzxweeBkcIdbNCaEFQgffli0wKLAHx4s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKdW1PHtuNe3455owawTQlVdREmpa_rVDeDfRkxrliTw&oe=6A788D2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC91QCGTf1kQ7kNvwHCRgDF&_nc_oc=Adr9_8zB6TPb4HTs3wJkT946tQpnPtd7uYfjI8rHLu2pgGObtTF8DaxbC0XPv-JEw9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO1NS6_LDGmFk38sOWNzW_UQFvdVKVbi87sQ8yEYiOMQ&oe=6A787082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMQ9SyKzwYgQ7kNvwEqvc-K&_nc_oc=AdqkDrRYndLQ0VnJZhkE5W6WwqYb9Y1nfHQ4g7AbmThtUZOxAfjB5901n4B5JNO3A8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuRzMJSSHmleo4v7maGJ7-sQlx-2qPZjSNPpCcJ4SEgg&oe=6A787B6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
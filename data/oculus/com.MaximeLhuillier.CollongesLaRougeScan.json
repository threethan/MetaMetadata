1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiqsHsdIhKsQ7kNvwFvZ-Hw&_nc_oc=AdoFiFMgyjR8vqWUHNJacV7yqgwaHdQa-l-2WIpHLPeq1IcpDsXHiKMYeCokHCkF9xE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY_9Yul4dr8UF6ZFBz8k67QMi2kDvn0lKs1BG9oo-A2g&oe=6AD23040"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wLHfrQTlzcQ7kNvwF40uwg&_nc_oc=Adrtt8qRiHG9hmj2B5FxrnOK1NFYl9lyiYJye1CzntZ9KVhAQuPXEAPRet3xWVArWDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW_THb6M7y0gYPdcHcFGb34aZKWY5Zz1dI3C-wRAHQoQ&oe=6AD25B8D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXd1yHtP6LIQ7kNvwFg7BWg&_nc_oc=Adq1Yc4dx7atlYvvMh7-bC3CBEc4vhz3Aq4Mm_P7F7JcCMOzJE6WIQyhaCzhrsqYxok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODySzubNQoRC3zHu-WlilbT4DSqNsEx4FfT4aIGzDzXw&oe=6AD2332C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhpI76buwvwQ7kNvwHK6Oph&_nc_oc=AdpAsfd2nrGkmrZCvAnFPW5L33EV2wMjFMsOlPgZXKSuWAHcTObfZpLuxtOmY64uCdU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoQbNtjjJm7y-uhqu22Jiw0Ge9fM4-wf1XqFScO_s3Mw&oe=6AD24EC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Si4bR5txcPkQ7kNvwH0P0-_&_nc_oc=AdrWfxCFW7bRBkI3IQdhzeP4aaLM-fYQBVJPpYbw3WYMSIHS5jdahPugUcN-wMhhBSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmax9ul9HeHKoNhawici5ALtbQx2cpTZsRXVXXFBS16w&oe=6AD259AF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
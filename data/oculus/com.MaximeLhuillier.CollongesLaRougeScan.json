1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVhjtY2TvloQ7kNvwFRUUX_&_nc_oc=Adr9l32Q6iYrqlDLSkMwmtqfiQsUczwlHC1D6q4eZmIxIyqhWHrQxDrL6HoQdZzBydA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_HEN_sltRsnBRIN2-PC7cf4-BZL8-uhdKZpR-W2bE0g&oe=6A4FABC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7yb4pJrtE0Q7kNvwGVIqun&_nc_oc=AdrvOaNgkvqTp08L8RWcmpy-dWP0x53f78ncGI27lAZ7oB-lVEMrNmAeTmfvIfP0JW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJivszQU_rjVaNGdNSquoiIhRZNk0AlhhQpdu445sPbw&oe=6A4F9ECD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEholQGKC6oQ7kNvwGKLqdd&_nc_oc=Adrn0ON6_AbjiogDpn7xK8AGJ8zV-VqSnw2JgtSwqjjseUWEs3P65YqZtXhefBhXwVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGzJN0pl72TFyrG-P4dfaVTBhL5lt91Cpg1vJtHLCCCw&oe=6A4FAEAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga_FCYviux0Q7kNvwEtA5YW&_nc_oc=Adr_TZPgPwmzznr61905Dsb6C6-AXQ0wS1chZvnbtb9yWHICOtjdXinzfaK9NtAK300&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9NjzdQ__L4HxhmuRknFmSkcBzLvNPvZepMwvL941A6w&oe=6A4F9202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwh6EsnupFcQ7kNvwHSesVZ&_nc_oc=Adrd5NdOzHqVtYFyqCHcxBDuK4y7hu6LA_BtcUyo6espD6h67-XAFglJmr0RIltaE8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByHGBZi7BDJ2vUtRj0PCoE8b2U2l0qLGwuIg9OAZcA7Q&oe=6A4F9CEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-cVMy_L_ykQ7kNvwGSn58g&_nc_oc=AdqZHBz2rEg_9aZ1a_39A_-2PPwvGSS-aUYS2Lwg-eBpABtPqGH46GR3PST3768T-Cs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v7-EqdpB9hHxsgXy_Fyp4pYWlu6GoiDt9uzBLTVOGAQ&oe=69E4E240"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF-TVheOoFcQ7kNvwFtBxDo&_nc_oc=AdpAv2Ly1d2xeDKa620Qgp1iFaMVxwbsqH7Y9jcI7YYF-EaFLDLIBFNiRIj5freDXCQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eO-Zymk_43_ChdJEsTmiS5xSLPdWvy7IoCk1mONq9RQ&oe=69E4D54D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pSns1RNCuOYQ7kNvwHVU91o&_nc_oc=AdodrH6R_sjEoM22-2ca7XJMVKihcq5eNaSCU_HAOmWjdefGcyEcAdC_QbTqqhKZ_as&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dEp0aPuwrIaKkwGM0zJH7Q7Q-7MsjrDXcjocWOOHLCQ&oe=69E4E52C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6y5UR-_cSIQ7kNvwEBWS28&_nc_oc=AdqzpaK-CPX0wRxFLXD3NBxJXLZUuDbwRYhiAvcMdoW4FxV9Jgy8NqHC910C12JFpO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ry_WkfJeoVmj1brNL0SW_sInC55oUfANMzgHJC6_wZg&oe=69E4C882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeA74YfXn9wQ7kNvwGQMmbP&_nc_oc=AdqisTb4vOCMTR2IUpYJzyNIZlZrK39hPLv8FdH0ncyLDtmQP9di4VTIfrypqEnqMlg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sn5Lt04M1NWwlDfkZrfCKyKGMo8YeQUV9TTjsqeMk3w&oe=69E4D36F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
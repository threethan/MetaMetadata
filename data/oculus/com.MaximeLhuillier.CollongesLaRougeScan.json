d": "5448030711940983", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmRShz8BDecQ7kNvwGgcnKv&_nc_oc=AdoB9LeRTxxhMRXHqRdGz4ehF6Gy50FRSXUFQqr0-oPDDY4Ijhl_VEwd9ywbDr5FMzQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJipDLhJMwa8oWwgRoodfhmItGiBUYAbTekDlc5j59Trg&oe=6AA951C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkrXwgruQhAQ7kNvwEd5ihe&_nc_oc=Adr_rBB2hki7wzCfI2zDazEhvG6O3RKOewiSXBCA-HX-55Z9yzKtDxkQWC84qdAE0LY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3Fvzv_e7epX_glnjLFykPFL98FsnmbznWyX-2gtVEyg&oe=6AA944CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LeCkgFSSnoQ7kNvwHblTtn&_nc_oc=AdpOkJaZyuSN05C6pOSHKyGJCXNiSHjWBWhcPo1xjgkl1TxFVRzKEJQDOCahM0y9UQE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ43Ogkh6Cesz61_029hZjj7kjNC04cFS43f-x7ysN_8g&oe=6AA954AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLZwlO1IA8AQ7kNvwE4MmdY&_nc_oc=Ado0Ky3gwH7saSLAe1zBBdqARKk1dMZD6pcHsOPsbBfUQO_Peo5YZI5d0Ok8vloDNi0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAvVoiWa9azVEUOMReE35wsB18qIcf4A4k742Xy96PFQ&oe=6AA93802"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ9CI7M_kC0Q7kNvwFTWjwp&_nc_oc=AdoSacZiL6op8Wm3z7DpsIrhGhwfs8rYd1q1l9hJTyWtnrI6y48zl4HIKyRebj95cNw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeORoDCX5UJttIHG_JEIEsSMgP2zj_36kNBhpWxkhYNw&oe=6AA942EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "co
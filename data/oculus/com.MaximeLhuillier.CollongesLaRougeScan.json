1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg_GiDWoOgMQ7kNvwEh9hL8&_nc_oc=AdqRa9TLmDj-I2l5FMHK2r7eA-fA49NzMcMgNyTAJ0kNWPHoZZGOcq9eJzJ3fYUMMIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Kxx9ZWqsSF9d7A_mdbwNQ5XFmybznjKF1fygGS-NDRA&oe=6A43CE40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4O-DdpuryQQ7kNvwFDQkZr&_nc_oc=Adrr9nkmuNEr3gGKnKv6NplMC4wW0nn-PPgCuIwWnMTuF0QMuJXpbTrFOGuY1fKGE3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_C2wrHAKpcaXYfJoPak6P6mVryDVWb2XDNLGavfrwmEw&oe=6A43C14D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Sb5IAlTY5QQ7kNvwFV3huo&_nc_oc=AdrZKU7YXt0YWnruur0c7pTUhIzWclfSlTqwQvoBzhXpRlAPmQXNkIGY7PFmkQ8onOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SuVZCgG5tzeALDq3PxIRfe9m6luLoA1Sc2AfqFYyv1g&oe=6A43D12C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuXGSj-GAp0Q7kNvwE_XegS&_nc_oc=Adob-M9hJsPVB2FbpecpdquocamQyShNUNsLFh0GD6x5fnS7mK6nMmIa70fDTnG3PyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b-4Nmk9nkxlVEsbLUruVuo_wYOVX-6-SyAEEG0nHCFw&oe=6A43ECC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqechVLFWvIQ7kNvwEyJvg3&_nc_oc=AdrE4tvDT_yOOmpfS-VgVtqhcYcKdjup40l-pKCeZNc7UMyxJ9pMt9xkjhmbHQY9dx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C7D55sn-bMHIA__y7wNOu3zuWD_qW0-3-gzYilsz0WQ&oe=6A43BF6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
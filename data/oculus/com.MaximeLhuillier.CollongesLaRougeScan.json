1940983", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckkgbRTbrsYQ7kNvwE7kmjg&_nc_oc=AdpIN_3fCy020JaVhTaH8JVZuDMpSbBU_vCzjwVJDTqxbk9Tfp7QWiO2W4ddGsANYyk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzu56Bhs97gOGOnqKFIA5eo5Zaz4kGL612fGcuseSA1w&oe=6AA01740"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPK1pxXH43QQ7kNvwFZJ0lR&_nc_oc=AdoMUGoO45r3A3wOW6iWaK3TeO_AhJ-s8BXyoeY3zEsXz8OxzXQVaoJxT0NHcAzjg1w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImvofWIC-IvROSqIF3iJrtzVh41PuMKqMHf2GJTi9Beg&oe=6AA00A4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxigEgRbi1YQ7kNvwEAqyL6&_nc_oc=AdrYylRMsMt8lY3yEy4DA50IE1kVlXLHwJozA-ypqvoKSUpt6MZ8rrSfGAOdOJBdWSQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuzgTZ0gmWsL_R0LhSPFrPUfSU_0htbx9WlpC_GWHc5w&oe=6AA01A2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYW1tnBZwbAQ7kNvwG0P3EO&_nc_oc=AdqVOfXMROeLyHtCnSgBwzU5-yOJRRSGAaOi6HMtSIgyau2r_PXQAVv9GgLIjVyqGXc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl4z9rJQCI5hNSkRKXHSj6fhVl7xpksSmGmA6EyhkUvw&oe=6A9FFD82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VYp7aUwLvcQ7kNvwF5VYoZ&_nc_oc=Adru9EqECCzi-qbrmqsD-Jqapvmyl2Cos6XVk2z5L8APu3rZkc-Ce9R7SlYhJPuG7Z0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuKNWaVZGRRoiFy0RFcc6PaiDdKPrVj7zljH4QTrsHJQ&oe=6AA0086F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
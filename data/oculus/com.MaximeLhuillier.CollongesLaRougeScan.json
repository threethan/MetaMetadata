8607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFZDLvcw644Q7kNvwGjTJ2O&_nc_oc=AdlHmMc2S1exRFe2FT5cirfzqDxfd2EP6y7F7hC1PrBnnjQzp1_zEYwt_s798KojoWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5f9IEZBa8nAJC8nNympGiR1oPzZp7-VEcCoZDqlOcKg&oe=69BFF840"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3G9FxQDRrgQ7kNvwEd01Nt&_nc_oc=AdlYqREzaK6bRXnIO4yXR3gFPQ36GklhhS7TlY9BuxZZ4oOtbK8Ama1JjKhja-Y4wbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw3ud_s6g8fCGicDgRGJRSWls5nGgXC_hcvTC4lpRxDOg&oe=69BFEB4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPm4HGpQQRoQ7kNvwGSoY37&_nc_oc=AdkVmpkHu0SO0Cs_70dEfGfbn2iaNsUDeYb4YzDKJw9vMSotl9pmIDHOP14yZVJAH9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzS4XitLS6QluF4P24zPIjf-rZtGL8V_frzwt5Ii0KogQ&oe=69BFFB2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoivtuFUTsIQ7kNvwGZZnnE&_nc_oc=AdlpeDpGlaiD3jHVOgVlVR-2Qrqaj77XLUOa2cr9F3rCJZsBiI9x-gjIHWPnyEh3ny4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHhsXYT9h6hzyyrzEvZHvoqk-XrnuucB_T6HAUTzsytw&oe=69BFDE82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLlag2g8CfEQ7kNvwEgfqfY&_nc_oc=AdkpbAi0FbRLItofXAe6aeTmCD2Lx__quwipuvMS1RN63TQ4yye8oMGX0v3URrDg6N4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyntUr-jyvGUjuibaJRsgdDkKLUMKO4JzoK7ceBKRuySA&oe=69BFE96F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres":
1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH645rf4PEoQ7kNvwE42rYy&_nc_oc=AdpXeCGRFLpcGJH7zoK766fxYJNmqr3nEqIHXWZ6OvOy0z-P06q9eyf4FHdfvoq4s-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRijacQWm2zVFkHHpN6Dm0U_eK-LO-2umVlzvtjExDgRA&oe=6AF082C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LEre2j5J_MQ7kNvwHFfenz&_nc_oc=AdqHyDsWqyBC_pDuKcLYC7F7p09yioxkvjSUZZOJSD4YEGnrzU2MRHfF-z5GUs0l1XI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmCtLwYaK3oBC0B0u_I3cSFwP85Wkehc_Kqqk_H5JCOA&oe=6AF0AE0D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLcJAfzoHW4Q7kNvwE2uvIC&_nc_oc=AdrA1Dx8ik45-YMioX38d5E5GHOvE8tPZsj3_EESF1KlzWBISWpoK_kbktphJVfCC3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2YbtZPiog3qtn5Cz7SaC6XvVc2l0V8VTOJcBVPEGySQ&oe=6AF085AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j68APYu8Q_UQ7kNvwGZgI-X&_nc_oc=AdoW_lzUV7r2S-WZz3JWWV5CArLaaZh1yg4WggLRJfcXnbyESwrXkBKqPFJ5RCVyZlA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJoZsF7EVuz8Amonq4x1qyhkNU4dIJKSNORhQiwCYwgQ&oe=6AF0A142"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKG4je3Ays8Q7kNvwFgj3pX&_nc_oc=AdrHrUUR867F0OlTx8rXI0mBE9inM3PytSgiB8WITfoHcvLAw5RD_-I_CofY3z0rzsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBOUYqu_VrfHb-QJWOTtglCqyo2BCLyXIEIqmIgaKWEQ&oe=6AF0AC2F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
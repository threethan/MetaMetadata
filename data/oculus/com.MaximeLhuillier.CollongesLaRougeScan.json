1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmRShz8BDecQ7kNvwHy1oaZ&_nc_oc=Adrkq1AatmKa62HNjGAQ2TtsxPRqkcRx9sLSP-W_rbxWB1BgVpPE82KlQIm0DMlU_LU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYYeEGQScBw9lAs4sAWpcjVnKlimTrggr5c2U4WWP0Nw&oe=6AAAA340"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkrXwgruQhAQ7kNvwErKs9v&_nc_oc=AdpdTAiRgEcQvuJcfj1_vEhbcoyTxwkbnjreaU4JDOVtIeOHadS4CvQYG_FyK81ywu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF6D8GYxACGyupt7C2wZ2S7EbDunSGQzCF_sXJQADS5Q&oe=6AAA964D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-D8aViUGJgQ7kNvwEcivkG&_nc_oc=AdrHcCC6TkBa3RF1RvDttHI9-5-aXBAb1NvLG2AWdRfNILPgo1mlM-PMqiVgSYJhdKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK0yNY-lHpKcT_n_vkIbW_FZPlteFQzrL45cyBl5K8Zg&oe=6AAAA62C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLZwlO1IA8AQ7kNvwEfODrA&_nc_oc=AdqqnoxeBS7_-tfZFKHQL3JFBrQW7kka_oWEFZdkbWxqD1yj76KMEOv1JdoTbXsAsAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJitTz2m1cTH7LGFqu1tv1NAkh9OqHUVczMCWXs02x36A&oe=6AAA8982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dFe8NvxS9oQ7kNvwFePnwh&_nc_oc=Adov0BrG4n2TTEbsQwk3qlA6HeKfvyFaRhjIKs5qyRTlsU74ZiZZUVImGHdUaXBl4rE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfJl-vd3349R3faZ2HPLSirJLgaC0Q0h_Oqrr9D4cXvg&oe=6AAA946F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
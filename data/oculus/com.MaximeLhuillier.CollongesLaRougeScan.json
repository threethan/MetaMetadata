1940983", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NPr8Te9rAMQ7kNvwGqNSns&_nc_oc=AdqnUjV0joAZDo2twXLGn_I8oiOEY90oZ3tY57F-35BGKeBEGi0vKxiHaetZh0SlF6g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gIzqlAMnQjXS-GWHAXtVdYW-g9jsFJTAUFJI9n0SHCQ&oe=6A0C6F40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VjfNJPPkzsQ7kNvwG8s5-M&_nc_oc=Adp84pL6fcvXy4bvUQfM9RRW0DZ-allo0uIMYgJqyfQTR8M0Cdz3HukrAVNLLWw5WHU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HyTyq4ZdBwo-Y7nXXcqiXsIlUYoWtRcHq6gMIjQuFpA&oe=6A0C624D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Frq8G44MYQcQ7kNvwE5KbJX&_nc_oc=AdpUvFo30TqG1vGtz6PgDJ7u3cGzstevOn9JcDrWUFh0V6nI-pKAo7bRWv3fQMuF7Hs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ax1E9-_KdYYf95QibAO__Lw5KZ2elJ9W-wu4Y0BXU6A&oe=6A0C722C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JthtZQlwtuEQ7kNvwHJ40Ec&_nc_oc=AdpLlRreiaTnQheQRpgo3U2racUlqIAk0m5JaGLBisOtqLLmgyM_QgQgXctXenUbmwU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ppQrvmb4KxWpkcHeMHPUmZXVrlV7MbFuKT2aLbNOn-Q&oe=6A0C5582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyN_QGoQr_MQ7kNvwGOJvMX&_nc_oc=AdrdpDD-7U-NOUJzRVAWj9mSk5oaar2lmgASeT5VyX2H4Y4d4xnXFs3gNxEtJgy1Lag&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CcVeupi9dRIUIikhCbZ8r77EcBd2BMlJXIY3TTIbMnw&oe=6A0C606F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
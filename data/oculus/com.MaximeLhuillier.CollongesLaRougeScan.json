1940983", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5TNAFSQ1akQ7kNvwEP1KAi&_nc_oc=AdrPbylIKdeknqgadewLy-wzAXvZTgWLtommO6BigD3W8uWKOdyfpD0xkYT8SBHFW6U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IBhgQlQZHuVm6us0L_sDJGxmgp3aN2ht-O9uGaPvRhA&oe=69D7B340"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q48b-PHJKv0Q7kNvwF_6cSG&_nc_oc=Adpb5p7F-J8zIQ3Q2TKOASbUZP0hR6yMZEaT32CM-5RUG6WleAQu-SriqN91E4H5k2A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vJDwBhuGNzUgdy9R2NeEw13qZpf9mUd9Y-VjTzqvV1w&oe=69D7A64D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNn65hHGaZAQ7kNvwGgOkQt&_nc_oc=AdqpaAtDkyzKREhBFOyzu5bVSAqcJ8KC5bdu0L7Lc8TFVORANe1DQbdFeBPWjkkwaH4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TKLU3JdmdpE7Jom3kn3FZ8pM664S5jyu9EsBYN39FWw&oe=69D7B62C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-v8advsFSKMQ7kNvwFqB9ip&_nc_oc=AdpRhMyT6keAlF3P3p0tA6EddLdt7ZRh4J1XdHMi6vVve3z0UJiHImW-0ShkY-yF1_o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B8mIgShbZ9DPWzZ1qA7993Qjd6x4mK2u4-03-3LkBDg&oe=69D79982"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFW_jFYRwEIQ7kNvwG1-_3y&_nc_oc=AdqemaHSs9wlAJdrKUp57w3m4DgE2TmQj2y9QNnPI-j8NfeC-toObvs5GzeFhnr9Yas&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Hs1AGTv08SSrVZTCPCNh7O22x1pqPs91Fn24YP2J-TA&oe=69D7A46F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
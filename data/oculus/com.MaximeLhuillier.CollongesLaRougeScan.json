8607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX2vHVvAdP8Q7kNvwGvHunc&_nc_oc=Adk0hAGa1aDUjf1mo7nz7OzkGM5H5Tw60XcOuh_5psR1vi3XQ1huA65kWNCnbJ2kXgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBmiNh_45TtGBP36r4u5rF4N59FaVVvxWY3NWXhRCPRg&oe=69B56C40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF2CJJhMPk4Q7kNvwFnKi4n&_nc_oc=Adm4DRb5uPRL_BwCa7VjfwkT7hqRiJTaa2ERRURJ1399vao8dXOXEk47bH8nOMEuaPE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLPwf1N_bc0sqRzEOfMbg7Yyp78wczO1Xt8tKd8BekAw&oe=69B55F4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGo50oKGCuwQ7kNvwGstvmP&_nc_oc=AdmxbIgI-CBGzfvi1SVs-2MvNpxNzZ0fSAw7qwjYRW9PIULBUauIK3351-6W05gLn3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFvDPSQfOtYy9SVBUVj1-mwsFYsj-Bb0K2tU7WPHb4bg&oe=69B56F2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuFY6XJXrqIQ7kNvwGounf1&_nc_oc=AdmgYK5nfR9ZaRZiB6UICG5EwqJZ3aw6QRXqix2z4wYz2UaV-NJ0WLhKyJhqYPPT6c0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyowacNY8aCPPVayc3P_OWJGReUYwvOoVlZb1_p4tE-Og&oe=69B55282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OiFKGGE62OsQ7kNvwGHbIDY&_nc_oc=AdmjEvtJ7AyR6Eas2RcRciIprxSRf9-hRHacEO8cg59f-rO_XIYwNFvvC5HTTwZqt2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx9PcAWP69aPc_h45ISF_HaJDGhdFK7i1nQqYNaILzxhQ&oe=69B55D6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres":
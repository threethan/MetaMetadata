1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwZShztMN9QQ7kNvwFvyH3N&_nc_oc=AdpIj6795KGdR4motwl03IWqDBKD2nbeyD93OAh2muvLenGZWs_FESV_DRmXOEkuAPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuWucyRzmt5ZJ8J_2MFLrk04TU-eEm96ZEcvpbbOfiBA&oe=6A6B5B40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGjIO7X9HCcQ7kNvwFzSHXZ&_nc_oc=AdrDRx72JIaGPVH39ZD3pZG9_ZZdbAaY_kTwmYXqNg1n2kC5qpfvwxC-m3YAwij38MM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9tz9MeeFXKgZbTjQPh3maGhE6ugRODnXziWrFD1mvUQ&oe=6A6B4E4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Wo_EIWRFgQ7kNvwGZIUZE&_nc_oc=AdrWqStolmKH5D30D9t3jXPwLven2gvImt3q_4azfGaKu62gcmJnKJ8g5GuFB6Oxv0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCB7fCdtKrOVMX3swKyNd9Q3MaiM8d4UjHYVtSvjirxA&oe=6A6B5E2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YWHvhqFaSQQ7kNvwEInPn8&_nc_oc=AdrLIPnEZOYNCorFjq44xH7FlECX6XZoWyVH9bi4D1DFhphNhrKsKfw7mhD57oYoa10&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ5AypQpndNdm6EEZkVKqOYvwUDNLD4RCZSAj_GquyFQ&oe=6A6B4182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6oUuwJ5r3oQ7kNvwHWmQyN&_nc_oc=AdoIhvpDIp3le6HcGrXaqzma8xBb3DSeXC2cSkt-N23-1StMG9t0reIUC-iPRcHRNNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZOtF3duarOxk7huzm2jOSdyqn_lL8SQyzKo-2lTHkvQ&oe=6A6B4C6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1.png", "id": "5448030711940983", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeafZF2e804Q7kNvwGfP9LX&_nc_oc=AdrpCLGgdtcGniwb-g3BBH_4P27-zHxON50Il-6DMXcVnYbH3ie_1FH9vMV2hYEHs0g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUMyNNZvily_bZbjSnn7AA_IWJJQmka05spRwnMWjn0w&oe=6A8D6A00"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXJUe6dba44Q7kNvwEh_Tpl&_nc_oc=Adp99ggialfDO16S4QgLLz7Iy4HAUVDVSqcsjetnv8mvk2OfpH5VBttQW1-iAcHRU_8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBzkwDJHl70moR3JVCaZaK13hyt-0-rApkIBcp3cplcQ&oe=6A8D954D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZEfrXfbL-oQ7kNvwFYIcRO&_nc_oc=AdrM9d_3tYU2ifZwt3T2RU09L6-2Z3eHVz5gjQ7r5SRfT4BRQZ7TONjCdxKTL-6OVFk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpH9kcA5qAh8NvethS8e0BnRQLLA4y-WLu-b8XUnonOA&oe=6A8D6CEC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qruy9-9coMUQ7kNvwEbkxwZ&_nc_oc=AdpzSjLR94OWjJ3xWvxB1Zfn3otqbseegGC6sAz4X7_MCIq4rCUN4V2jmpJcogcfb2k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZYXvOD80yZMSUzqRvlizB4KhyR3plkPw_TNpbvwb5XQ&oe=6A8D8882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcVqza42zWgQ7kNvwFK9gVu&_nc_oc=AdqQ723ec9ija9RFDNMtZvG1oYVAruZimsSkcRiUB5Wd5e6JLcbK1Magb17poslo9MY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL8Gd6Gdf0um_Tkyq1E2bEaHvWh0Om9IqWVCtRpk9PEg&oe=6A8D936F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "3626922114428
1940983", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8ZQafrdvgAQ7kNvwFFT8kg&_nc_oc=AdrAQdnXw1olCuMoVJAksxF4Ju-EE9owaf_zUoyjfsD1nH7-ukDfvkE7wDqN2BW8Q-8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92A_dKtNYUeHy0Km_2_wTE-NnJIomtK5w_iuEqd2odDQ&oe=6A26CD40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNvRPK9B2pkQ7kNvwGlcEfg&_nc_oc=Adpg57y3sA5p7Xh4cfhKAzXg53KHjjv8ikOZgfGirveSSbk65IQdD3t14xogH5EOqm4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0gkBtoDzJ4Vlle2xoKh7kvIOeNfCnKXqhyNeTwDcB1g&oe=6A26C04D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtXiivJe0SQQ7kNvwF3Lto5&_nc_oc=AdoEvQJ3lGgRMofD8QZ1D7XBPKol5HjdfU8m6Zt88457sgW5bA6q6b0Yc54gbZMfCLU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bjVjdbKRAXqpCB2nq4fIq_txJ581wSqWGIYuBUWVnow&oe=6A26D02C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIt06-sjYRoQ7kNvwGRb6y7&_nc_oc=AdrYt0GZUOLgErpHBLZ7YQja4MJIktnrDI-Z3YiAAWp9o2Vtbl4xDUKKfwGXLe92Tw4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p_IjsHP2JCPHelQdyCbOj-QlFhQ0WdlnnnuwBIGncEA&oe=6A26EBC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-lWxVD6WkMQ7kNvwFx6dRo&_nc_oc=AdqdrCKD45UYJu1zVRvKIVSmMRfJQlt8v4thBO9UzMm3gHD3X1K4aiGb-dwYraMbC5o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EAtZ7XCVJRXIEh1181qnEXzMkm3lvCD0a6StPXGPEDA&oe=6A26BE6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3aDw24h3WUQ7kNvwH3GCA5&_nc_oc=AdqTWhdFfHndQ3bNlxe6ZPP30PgDsbmhMFCNaxoNWS8M0TbwQUnxBfadJ3iT71yArR8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9daNLa7CQv5ktkoXMKqB5VvhhnSBuLI1sQb12GE2sVw&oe=69C7E140"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaSdbg4yZwYQ7kNvwG03niN&_nc_oc=AdrgFKw6h8lNycmMnHPAS_jyTk803HgZ4-YHKv6C0HRRKsDbm1UPdReNprCDXsErtYc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3xwPmnxkJHz5QreX2UAvbcGWy2S-rEbE2tc9kvWqvaA&oe=69C7D44D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPhCmxGDnTAQ7kNvwH7_i_h&_nc_oc=Adow6Poh3l5V5fl3C1eqibAqir_m92lSzJyblloD4Ux1bHhBmzmL1Jm-nGEC-_bq-QI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz49skdEzMJB4VN0Lsfq0PSdEXtDpjif18ZfwSDpB3Vyw&oe=69C7E42C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpwY7VXU_DsQ7kNvwGDEfjF&_nc_oc=Adr7r22H9QaZ-t1WNz97TtkT52xEym2_TEFpDKccJbYJD4nEC4wRu63gozGjRk-Tc_w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZTk3EnUTvZf8FUB1E4coCBoNchGQY_y84o6qG35HLJg&oe=69C7C782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu85lvgV2p8Q7kNvwGJOJWI&_nc_oc=Ado_w6wQ1e7r-I7b_aKP7MyRE7qtQJGGSSj3vIA-CU9Glx39vjFNZdDciEhSuQBqQbA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-4VMPizShgQ6phXXCRyyJONunAb2cqVLJmkuYOdryRQ&oe=69C7D26F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMPIqMaKgRQQ7kNvwFMw8oW&_nc_oc=AdpvPNwR-RasADzuKAV_gnmEzFlz_Yts8q8cZ2u7MutARl_8N7gRYFMIxQBH9Qlwjzs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH73kyevslbnXBfXjRKutsTbJFyveJDwvoJ1NQpkZ4vAQ&oe=6A86D280"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cpeji73_zbMQ7kNvwHYIPiA&_nc_oc=AdqVMILL03ebXSSzfeOe__xGdSRO6zExnwyw73M4WQst_Nd2qWayWAshHhdBYc2YABk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrA79Rwo0BYLQw7Gl5pZ3MSVwUVExX6mj-YpYKovBEKg&oe=6A86FDCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSbdPOBWPooQ7kNvwH9f6OJ&_nc_oc=Adosxo437IBuk4-K87NLeLFgly8Eajgy3_FdCdIQnAM-UmUdm712j3hxRG9S15OJ2HA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlEcmZagMRzld_i_Am8AS3wWqJbIMkk_RF5kfs6u0-fw&oe=6A86D56C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKham2FYXBgQ7kNvwHUc782&_nc_oc=AdoXAUVQiKWwkt0_gd-s32MjtTk5QXO-pRMbwE-8UVe9iUmSVA13epU9kiruQnLXVlw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeGpw63TDR5sO6m0RcOz-a8aFN7zuOmzCb51PtpxX58w&oe=6A86F102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpMrqXDe5CwQ7kNvwE9SBiT&_nc_oc=AdqCE41VD1G_oaErczTqtF4avwN_FdwNTX5VBwROIExHbjIUu4oQDW_jlUpHWoewJ0A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyfdG8JOPPEhyCHy46H6tZCFy9IGdyPnCAxtOl2BsIOA&oe=6A86FBEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
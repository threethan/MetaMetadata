1940983", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUOiRkA_3rYQ7kNvwFrUgvd&_nc_oc=Adq6R_FtAcIniy92OJcDV6phXvJ1czxOtl8Qww26PxMe5pMagauHEHih5s3VFkmnCcg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HmO_nsp8iqeakQ43Z3TCV3W9MEp-yt7kWXCqYJu0X4w&oe=69FDEEC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Qj3EEaPjKUQ7kNvwG3uz0C&_nc_oc=Adppqlta-Edo-0GMmENkCYz5QxFMH5X2hpj3GzoXBNMtkmJ03Bl3jgOrcwAw6uN6ChA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ApGnRKS4dpsHGvFLPE5CbAl4_nEzbEcG9EAJy0ISaXQ&oe=69FDE1CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrY3OzA3UXkQ7kNvwEwpdV2&_nc_oc=AdqJIgd8i5xmUkLrnTMiMBevIAKxryBedzFXWpL8RztajafFhwznEdio1g34CYwTwM8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LuLtNDM3hrXL59I_YgPwT3ovG9vAPbQwvCZYLs9-jmQ&oe=69FDF1AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4uXfzMHIRgQ7kNvwH8oW3R&_nc_oc=AdrpjWVyIgh5aMZ7cshYhuu_i1e1YiauRzqzs1hsuF5ZqDoQ9V-yc9WsK91AnpFSOzA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qNtbncb85cZQRdoJt0K4dq14GmZyHEfJTDwF80eCwJg&oe=69FDD502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_VxEajP3ZQQ7kNvwG7hyFR&_nc_oc=AdrjrlaAWgq9Ci7EO4cyn3zxKOvOIy63PUBst-kz2XF5Tln58d98kaG0O4ZwVHcNMOY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vyg8k6ytt8B7i9EwuT5WWRlz4sH68XJ4tyVWUnvA8Sg&oe=69FDDFEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
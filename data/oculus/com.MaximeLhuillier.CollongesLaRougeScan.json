1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8yck1FhXG4Q7kNvwH59vPd&_nc_oc=AdqYjSAlas_j2ChQCx84s5y-2AERl55JgpNlMVV6--r4S9nn9yz9o4f-vPq2OmWx3rY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ig1zqVvrBmQeSpoarJUfhQD44TPKcZCgE6bcV45u1_Q&oe=6A05D7C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVQSNCUaCjkQ7kNvwG8u6lb&_nc_oc=AdoABZGI0ndmHGfcNQFltTxo92E_J8LB6KP4Mkax1bU2x-chthMhSlPFJzeU52TyA7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kfu-ph8EVILv983xDk-QeaMxepWqphlKmY9rS0pJY9w&oe=6A05CACD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqVCgVpYvSYQ7kNvwEjJywM&_nc_oc=Adrg187OBjiJNQN6kLxfhtykElWmDiXpdQr56BM3jsE9nMNLgONug5lDr6dRBy4u_0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hQwWp3dT3pvFQyzvstCJkVP6liNG03A8191r4e-7vDg&oe=6A05DAAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE9kZmdfV5sQ7kNvwFa4ruO&_nc_oc=AdrLd4zYWIdGj4M7EVo4t2fcELRlkiUpSvBG-7HJbH_dOZSNeQP8jwrNiRWxWH1EK_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45JFxquoVLJ9KvuSIkPND8vpP6e1mnpcAHPKIH7H_OpQ&oe=6A05BE02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiItAG4u4nwQ7kNvwE0mn_N&_nc_oc=AdrtdrXYdYgX7xUL3os3GPsV-ZK6VHKA_JCvYpwkkaZPBpB-sQ0tfIcAtjBI0HuJYng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OK-RrOZuCXs3OkSayeYdhgHGvmWQxmY0o0wLE-7FZqw&oe=6A05C8EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
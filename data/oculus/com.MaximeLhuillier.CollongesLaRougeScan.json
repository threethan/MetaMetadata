1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2YY4D1X4PUcQ7kNvwHreYdd&_nc_oc=AdoUZvQDQ58Kzc9s1MZ0qq6LU5sCQbYLJeGfNJ2rR_s9GWE3ENCD4jtagTLMsw5JeuM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44ppYrfyOxqVxkjiOgnwibolQ4r1gtIMhV60_f51d3lw&oe=6A15A9C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piXSC56opTgQ7kNvwEaYu0I&_nc_oc=Ado6u81FWYnKHKAToZe2Q0ncE9YOmfehdlc864V_K0vCefIlMprKW_D_uBhLE8bRWn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k3QPrn4Xsm7k4D0MuUoMast6rs4A8Q8fhzABMnC1RUw&oe=6A159CCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsFAxZFT8zsQ7kNvwE7lR0U&_nc_oc=Ado7sUoyRftz_c_axEJ5p04T7QiV7sUP1H9LqOJ8g_ybP44oRZ8j5e92J8vyif88Gno&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JMW9yqA7XuTE3-_5tSYsevo5SJybmPlBu3BNjcS7YzQ&oe=6A15ACAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AjwYmStx2G0Q7kNvwFfdWPr&_nc_oc=AdqIYGOxe0ftGWegwNiwKM_i2q_4dTRAQ-A3bzjLkFWRYT9UxIgm0wf2XzTxri0MtZo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cQOu-L6sPN3p16k4JnSX9sekp18R4Qzt8UX7o5EUWdA&oe=6A159002"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI-qPI1x8G8Q7kNvwHCqsSM&_nc_oc=AdpYRc8dfNiv2uL_0XfnCrexw7YOcKy82Xxs93rOHRs_so4fH01vCKz4EtG2z2RPJRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mvsmgkyRkAGZPxh6j9WWRii9Lv0K0ciT2ipeSzy3xbQ&oe=6A159AEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCDd6LVetqIQ7kNvwEvxAAV&_nc_oc=Adpfs9kSyuQTLns5sWTJsn18qm2MfC4loozCcnthRu62K0TYoM-A9AtOMi6DrfkGwXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJItdPEEb-RQa0IBemzYJyy1lAVXv74IPgniDLxM5bXiw&oe=6A9D7440"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPK1pxXH43QQ7kNvwEuHmd8&_nc_oc=Adr4ZZkEqoB0W_wnh1CuZJETGgbwNmhFbyvGaK678KV3MRd4Ug9UYJwDHjCCIi5r-98&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKujAUXrnAmSLgGmxUP40LVBt1hRizOn_6TjCGH7aZb4A&oe=6A9D674D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mr24fxk_BYQ7kNvwGDSg_H&_nc_oc=AdowtLrH_VCLl3ETT16vijFgbXGrvqWbzmxq_Ro-y5cG2g6pSovRpaSGxLiQaymWM9Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvioo5qVJ9VsPoEenOZqrJ5jsol3FbeoCpLyDIbhqbow&oe=6A9D772C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOpGbHbTz3EQ7kNvwEh1kh4&_nc_oc=AdrG84w0hv56p43qCeNLm3Q1ASnLFLhnlJcIAwdUM_sQzfj4nMhstWQDg57dX4SQLXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlQe9SZFW6k5_zp0O_jbebhl4Q7RF8YcWSP08eHJkPpQ&oe=6A9D5A82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAKtFmG3m28Q7kNvwErY73_&_nc_oc=AdpuPzBeCM7Fnqz7JOWlFdcl0LHAl4e5oE__uXGuk2AiY66y9Kh2ZSNQO-f-CLSslb8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnRUhd_bKzAkX2WPQ2vR404d4cmA_j2kUxKvDTJmgibA&oe=6A9D656F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
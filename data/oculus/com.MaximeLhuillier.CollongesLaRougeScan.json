1940983", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ri4BnuYttagQ7kNvwFaberQ&_nc_oc=AdqROdb0IqQEs4bSCz3hWX0rvGhohdQXeu4ft2a9YUbtlpR1pE_8Fa2mt4zoiUPLN3U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyzpD6IHunJtWK8BToRipwpMT1BufXAL1YMZqw43Tsgg&oe=6AC7A440"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcaboKTmrF0Q7kNvwHKKnWx&_nc_oc=AdrjkKzPLtziJGbXrd4U263NPY_jc92Qwpfs5QYff-rUgBKzGONr7CYWUJe8juO_PUo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIexYc8l_fTBB3VKGmvPCZHNGm8FNs6AI7Ly2wh_JN5A&oe=6AC7974D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2Fdw-TDPbUQ7kNvwFV999s&_nc_oc=Ado_uc9IPTpClJ83G8OJNa3WZYiiOI315QPFkdI0IXQdIp-lpeFXDo_Q5-NnpiJsx1M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4zt-LuB7dS3QfoEtoG6f7W4E7H-JIq2hKb7qKtHBCUQ&oe=6AC7A72C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8OzdhPE5ZkQ7kNvwG2qYVV&_nc_oc=AdqLdhi55SkT79m_mZ9-pN_sPUUCqiuYcQ8UrzBS0LFtlZSZ2xpbrpfcOZGT_GCT9O8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVy96I5DllRWCQXm9W2OBc4LSzn21oeRKYA3GsaEih8A&oe=6AC7C2C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfZA8tSHCNAQ7kNvwF3FrbM&_nc_oc=AdoFhiaDWgt3OQ8Wq2l2AKGu4N2P2cpJcA6zfgPUYRq-l44vS-Wi3lYSRe_f_QtjkOI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUqo-i8NpSPFeqwzFErndU4vFkkDpXGbG1Qto81z803A&oe=6AC7CDAF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
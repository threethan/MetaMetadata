1940983", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAOeHE7aRFwQ7kNvwFHcw-3&_nc_oc=AdqDKaKDv3bNsKuydpTOUiMq03yn6pXo-z14u2_A6R8rASmOhYtZeArjTqM1fTNGeww&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZM8UdUdXFWHZmsXjdIg-ss0aw2Vsf7poi-X4tXD4mRQ&oe=6A974D40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_pG-t7AQ9gQ7kNvwEfrYoV&_nc_oc=Adokwmpnbx1lCiZRhvXIzTQxnPDF6pu_3WId4DYIedxSCSO0jSEgTq50Tl9Hk8zDU1s&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgdgyPKUsJslj6PXVWhIW7l-LhhjA8QlYC_Yfv8bbGFQ&oe=6A97404D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKwkM4OOY6sQ7kNvwEooCQ6&_nc_oc=Adre2UE5cFInpyV9y5H2K70dsDeLiMp6oeoY30khI9BLGM5zAWp6MoU8G47BORYUIdA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFH_xUJUchH9l1mVyCPhC7uf1UG5Qxt9BFseZGKbYv1rg&oe=6A97502C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgQhJgFzQZ4Q7kNvwHPnwk1&_nc_oc=Adqo9rD1zb4Wtos0CmGKaj-nodj2DM5Au9kVnxK-kIXfkTTGUsOIWm1VieFG4F0PZ0s&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM62c7Az4b8VhOwWFY3OLbF9d0gdr0Gx-Ly7SHIE4M6Q&oe=6A973382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsQANfJD3fcQ7kNvwHdRs91&_nc_oc=AdoukrNsRsSiE927Xdabkt37mCWDd4yA8Wr4jW9fglPjzzXXbQp-8T-PTl_9NR8Q5cA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2veUIjiXR8wRc2WwuE_0rVth_la_YGAgPsbsga_fy5w&oe=6A973E6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
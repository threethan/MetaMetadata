1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8ZQafrdvgAQ7kNvwFqur8P&_nc_oc=AdovfzUUjYkuORs2I9nUqHBXyCxm3_VhjnMGS0vGQtS81UMVW-IZj1ysUPdNgUkXXlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qwWSP1w-Rzp8EZz5-peRzJ8dw-7yp3WW1MUbJI4lOlw&oe=6A257BC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ghbjzVK0LoQ7kNvwFsPstz&_nc_oc=AdpNEKT_8oQW2xNZ1F_rgRvJLXQnw1AVn2EeVtEiEwFkCtvm9Ya5oPksEANlTO8tUMI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JiyurAJOhe1fzIubT8hPoheeWd-djJA4YKiD0iKEHTA&oe=6A256ECD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtXiivJe0SQQ7kNvwGkh1qf&_nc_oc=AdqRR3djP5D_0SNkYJXUGbo1sXzNHP740aBvyiDZrTmqiMDkYUrt-MqiYFgpXo_oEvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cEsu6Qn_07BGODEGrZILP1S8sVPj48w3uJZypl2hV6A&oe=6A257EAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIt06-sjYRoQ7kNvwGKAtAW&_nc_oc=Adp1oRKUZfUbSjhrKZXAS1sLG8CDwTo39jlZvZFfIyjzWDlQcKY1azg5q5uDQsDMNFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G_Kb-P9KyGA3jxPjjNJGVLgb0oecGxHvqghz1ihGPQw&oe=6A259A42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-lWxVD6WkMQ7kNvwFi0OyN&_nc_oc=Adqd0PUMQukAVICTJJFIUCGl2ADhF_xyH8T3RbNvcO2FYMEWtI7dT3XplLWBK_RtknY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9upd6ZLBJ0Typk2y-mU1LT0xh3t64v7haXcxx8Vq3Bfw&oe=6A256CEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
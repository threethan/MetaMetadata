1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oozfQyGQuLgQ7kNvwHPtM6J&_nc_oc=AdpLK6wUnpUM5dMNM9sRyPy5WnUKRPyTarUxoGnHEDcISmmSwmclQiQ3ktFQL2LgSxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSO_z7nXxZZeVnNp0De3omcYmYXMsWpEoT4WuunUyhFw&oe=6A79DBC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFSqn8MIFYkQ7kNvwGlzc4U&_nc_oc=Adqh8xLuTflCZUUbINmlEOe2iwWRQ6zxa4c-Hq8CYg9dxiV_8InsGNhqL3tgkNPAyus&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh9zagL0uVXZpc86hTT-FNKxAsRzfTAs7tKIsV_S7j4w&oe=6A79CECD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElTRIpKuIb4Q7kNvwETvqk7&_nc_oc=Adq2JiJ_hnt5Gubh-33GZjWi0j-y4kH061WPfj7Oz14Tx0Hz2d785YROJAS6gIQ3SIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6ZhmChftid-UexgRvmX-IiyOz19s0dFwBw9bfikysgA&oe=6A79DEAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC91QCGTf1kQ7kNvwFIIH7L&_nc_oc=Ado-jjzkDC0uoXiyKLEscvBDZJxx6PBwkV6N8cJ3sQjfcJJQwMt4V5K83xUOBUHWs-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpuIkWtV3iIPH2eZpDvmLqe-v-0sCb4Clcz_xhe-BoEg&oe=6A79C202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMQ9SyKzwYgQ7kNvwHRJsdd&_nc_oc=AdoxOcRIdnMoyDn-Xk-KVVp-OZKg1xWKmy3if41rML7TVi8dVDJj0mJLLSk-juJAHCY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9EC4ug2Idj_PQtGvPaCtkfUvcZIp5RpgCaeOMSRTqAQ&oe=6A79CCEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
7kNvwGnzizz&_nc_oc=AdktaN-0py0B4O1Xj3RckIDy4reos75aPl52Ros5MShWrXfarrSk0auGSq3m9nujlGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsOo8mOKS8YELEjS9cw7ii9KHLxc2LC41Ix13LOfWK62g&oe=69A812AC"}, {"file_name": "Screenshot1.png", "id": "5448030711940983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T002Hz8zqOUQ7kNvwHuUWP0&_nc_oc=AdlC7dWt0XvakxME7T9xsIugxyV-iRfOTRtEfJTuNlJQ8gj4zGGc27F9C973-tUsS2c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsf61-TOVQoCQQ2GG4UsNubqkqngEsX3csUT-vSIRsa9A&oe=69A83D40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvM61rMTAY4Q7kNvwG2jbPS&_nc_oc=AdluVDU1lD_agFuHxRMi4xEcmDTBkBMW-KmCwQYJTpY0CkfNQFlsRTBpO_w12ZZn2ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsMOgC4hDfgUD418bB5w5Kti_hlnaj-2fhTShVcovUHJg&oe=69A8304D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJessDL_1XgQ7kNvwGszQVB&_nc_oc=AdkCt4D9TIfCcr7GZus8HKEJ1MIuROs0gvkKQzWoW9XXng-cYrvqEFkAy26wfuCap2Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsHfrkscClES8gDDTP4NlbbfZ0Scil1jKOyAlg5feoURQ&oe=69A8402C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AlyBX78RYQQ7kNvwEwCb0p&_nc_oc=Adkthb2fc25jhegV_WbhZsu8sL-ioilORtgD4mPo4J6aH6c_QQc6xvdgHpWT2f1V2yM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuYc45U4RGE5NLpDWZ3iNqm_Lkm2H7rIhpOer82H5vsiQ&oe=69A82382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxKAmRRldgcQ7kNvwE_T33X&_nc_oc=AdkvTH7nUQDRTJeC37W6VqfF0HXiN3t9lzsnIqg6iwNvCxPyhk22yQJF9n5y4gMFq3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuDAYvR1QczlEcFsGW4xqUPOqweAjepu8PDozmPE375lg&oe=69A82E6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": ["photogrammetry", "reconstruction", "360camera", "digitization", "scan"], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_o
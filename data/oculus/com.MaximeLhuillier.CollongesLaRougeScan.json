1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtAvlFWvdJQQ7kNvwFRDaqZ&_nc_oc=AdqAQNkHINvYJj_SBDvJlffYbqzMR3fNiB3lc_Qbs1hNfZRqfp8jWCdfLE0qjvIczG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__50p4sAuuVAjPYNoWcH_GScFJ3SD8KNz-cBlPJ9vFXg&oe=6A2D64C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NBhfU6XMJQQ7kNvwHvhgAH&_nc_oc=AdqqSgJx7cKTeVYbwwTpcB9F2iQH4dtf_d9gbTjiZrAvgBH9_dixrGe27-cwV8Dy6og&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ok25RSwUgZsOxL_gJ6ZusTd3s_uO2Sgc7AfWfgMTzsQ&oe=6A2D57CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_chGRgwvsgUQ7kNvwEU04TX&_nc_oc=AdrPQFWhC2IMmpjZB4sjxzGUz6T0AtTk125rUpPo3OtX75_oMUojWugZxjUeE2SxFVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OeQveLQswQU3gu6Y0KzxEDO7DBioRAHYvgHgjVg6RGw&oe=6A2D67AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cJ6Fs0ATWYQ7kNvwEtHNk3&_nc_oc=Adq1T5LsEOWuj7yfz3YPYnwbTl7a8oNlpNy0l_iU8mxLE9kcNR0mX8IiP8TiK73AmBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hB2iOL83goCGczO2YlP4z_0f3TyNkMXPbKWRFVfJHkw&oe=6A2D4B02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA6pm4VXJlAQ7kNvwH5MbYo&_nc_oc=Adqvfcus6AcQWBCl_3EnZ47j52bninya3-r9-pN321rz-TEvCkp3ckjIasZ0ko3pit0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81QUMgPVpQymVv8O--tXkn3wWVtXsYkU12PUtXgxv-yg&oe=6A2D55EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
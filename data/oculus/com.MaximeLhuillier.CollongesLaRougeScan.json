1940983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc0pWrWn1zwQ7kNvwGJyD2g&_nc_oc=AdohoGIkNj2RBSsC9fuNnhwts-fDllNTaJC332DBhZJaS1Hwg3dSz6id3fIsB0gwtCk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BuEtBmlQHqZwpd2fUrmQPLvndgli9DOFzeKyMOv53Mg&oe=69FB4BC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Qj3EEaPjKUQ7kNvwFky8M-&_nc_oc=AdpDV7bF1YLjBhMvFHNowcKPKkQiR7L-jPoq8YwjCrtF3PFny6kv-AzpAEvg2w8Jt0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HY7SZq7N77i7Y53qHo7BcnQJh9Hm2e-y8VjMmE8HEnA&oe=69FB3ECD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybDppWmWqksQ7kNvwEp1hvz&_nc_oc=AdpnJcXynFQxJbqSqenkUTQFf9wJ34hi6kwz83nkb2Lxut1TIdq4AW4eG3TVIIgOYt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZQ_WqBUbfU0wm375naNL4OccoF3ulbymZTKarMNwSDQ&oe=69FB4EAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amEkxo5bZfEQ7kNvwG7-Bgf&_nc_oc=AdqSBYOYoNdA7Hk0uR_OxDznpdMOhS0aKelhnH03pthTAlDRmM3vt8iE2FIGbAm1bRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J0LIwusGSAA2ecFim3CCQ4lSqfUBk72rGN3KRTqEZyQ&oe=69FB3202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q22obYNz-0Q7kNvwFBXTV3&_nc_oc=AdrlOqcTdfRutC2rbt-oRPOUAxgeJSWPK6Tab_6q1fSBrCFALJmm1_rXXtYlGkcqwNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OXimNU3UMB4cTTK1DkSxonLN-4zqhegXRPdkjw8yHQg&oe=69FB3CEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH645rf4PEoQ7kNvwFUR_9S&_nc_oc=AdpqcI4V9Fj3wOOFYdKBDJ1NG7y0dL6RdpJHyZbtASFh9N6CXdEeoEz7_nmhHlsk0tg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQszg3rqH9ddiMIMpU4IHNuU72UEXXVq38Cqqnit8chbQ&oe=6AEDDFC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWcVKNUXh9MQ7kNvwH58nXt&_nc_oc=AdpwwRq0wKj8zAxoBYPubF4RxZ7uJHt6AXDfKZpwIokmuvZ8vKBRjGoCqcHeIqdMp_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBN_KBsrOMgNLr7RcyLO-wXX1CcnN3IxEp8yquh0us-w&oe=6AEE0B0D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVLGtJLcHW8Q7kNvwFNTohX&_nc_oc=AdrBynirKvcG2LPyurVsTEYVShHz8Gvaw-Z3Rcb5NzexKLYCh_mYtxN6AJhqEQPky6Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsq8AQRKjyxdqWGOV7HgB-Uh5NSo6621oo0UOyXYR_ew&oe=6AEDE2AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y1RScR2L2YQ7kNvwHzET_p&_nc_oc=AdqoLGpzFPCI0Zg7tNzW57F-MJmtDGwO9jOA3QwW-Vj4K84xOGf6H-cwX5vbMz2E2q0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi-ZaBZ1FAglgUXftdMT1XjULxlRusQ4o4M-VQP_cpKA&oe=6AEDFE42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKG4je3Ays8Q7kNvwHhzZ4J&_nc_oc=Ado1qQEG6unui2fZmOt-ACUMndShX_BNTCiO7-9Lkd5-T8DIAe6R7ZIut39EqIZyrbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDekSGFDtHgU9zWwgyCHqVkFW852Bhd-_7AzCPqH5GTA&oe=6AEE092F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
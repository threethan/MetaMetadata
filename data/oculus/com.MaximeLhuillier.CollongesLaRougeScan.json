1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c_aK_4-J1gQ7kNvwHDznV1&_nc_oc=AdrNBVIWnK3oLlcodPA4eHXdOM7f86lmBTS8WBchmdOYIBR-vR4mOMR_yDqXPGq92xs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdcUK-DxzEGHPEc2yk4SSPJrbzAXytj3ypNR9DIsMIUA&oe=6A900D00"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXJUe6dba44Q7kNvwECYw7L&_nc_oc=AdqzXNK5l0SPDl9iOOmXvyB0H-zKyu03_--j4hz0lMaoYpr9xtvxmpqcMy4Nvg21Rpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHb5JSzcq__DfamJOFDJIVlIXyxv80H7C2CU9Jcf-O0-A&oe=6A90384D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtxfiA2jysMQ7kNvwGdg34i&_nc_oc=AdrlKWlpL_zFgCRitOG7OeL3Xsw8YEP9rXEGDNjznWkyAcaRb3dlqQ0iuIiXaAZpSP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjYLA-riArBT60bGe-JieqcsCoB9PE1Nl3_CbndJdRZQ&oe=6A900FEC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBQkBjpiq-AQ7kNvwGtFCYU&_nc_oc=AdqRmpyrU8YJiRr4cqRwFdCbaHBhCR84hc-OeMEvfcSUSIVhyaeyS_ln94QLscM4ERk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI36MP81kIsY4aYtAeQueTKAaV9fA8gad44Ck6XPMf2A&oe=6A902B82"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeLHFX97sVAQ7kNvwGpuPSv&_nc_oc=Adp8XaPe97QpFC63QRAc87FsOl0wvwsNPs4zwXqhAjwYsallHclU4fiwIqNkbnqppsU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmkCVBJBhEKvJ6Kj9hSOkge3H1EFVaTpvGWoGfVbBKiw&oe=6A90366F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
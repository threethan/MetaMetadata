1940983", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyDZDFVtrqoQ7kNvwHXXjXg&_nc_oc=Adqt2GGRyrKMVYf3Se_0ZrnQDy2mPbdzWlY7oF9Ss1nEH7mNdQ7daKpW8OVGBlGoVKk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmIbkYS5kHyEFSTDTMDhMOvXxGX-YRG1-7mYOLcWvRhg&oe=6A882400"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cpeji73_zbMQ7kNvwH6YanY&_nc_oc=Adp4qoDtu3K25TmMo9VUR_chAiA-AFIQGADdiNe0CZwBlGrcFXGb48FenNsGAXg1pUY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFujkKYRPkcANqZ2JSz2v65yeJTJzGnQpy42hvENaKy9Q&oe=6A884F4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSbdPOBWPooQ7kNvwGo9HL0&_nc_oc=AdqeOH3cqUFlun0RznaVNGGXoRyrBgzbUQwmHuVBKm0hdtXRVg1Kjn78R-KZIrasdBM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-HSOPFqdSeVVzlqouiCTIXz1eIl0e6T4ZjvhenFKJ3w&oe=6A8826EC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMr5AP8TEBoQ7kNvwFdqIPR&_nc_oc=AdoSobdlM4whwh8Tp_UcShVwif5aK0_qyuE--77MTbI3LHT9ljEumYD7vfIkYMpA8NU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt4pM0kCyWtylEi0B-gqJBF0nm3jy8hbNOTtRbC_txyg&oe=6A884282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpMrqXDe5CwQ7kNvwFXfREh&_nc_oc=AdqxdkjybZbNAtvbXdqaoEGzvbryQC8RsqC0nnvnMKZJW1ViW7wxlFSXusSM4nQTPas&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEC0a1EahjJFbOqT6na7_KH3GVSVlSTP94kgq0xfZlaJQ&oe=6A884D6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
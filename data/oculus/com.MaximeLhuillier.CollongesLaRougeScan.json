1940983", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRjBwOhmPiYQ7kNvwHCOTx9&_nc_oc=AdrOYDs0trB9DlmR9tJsjQj22svk2jpFH6BTj1DYn-KBVwziTZUz5fvCHaUx-NIp9I0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRQHLo9Zn8EnVYv4Wc-7A8flrKaNWhA97WArl4JJdG5Q&oe=69C29B40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3G9FxQDRrgQ7kNvwHuJveg&_nc_oc=AdpvZt9RpWFs0Y8huO5bfTI9R-aEpmZ_wYPIe3iAIQOdtFIWqerDDsnpHeAOOeFpk9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztvbjSvc05EKfgK5CHNdfh9hxiX9erpzL6xnD9z2kHJQ&oe=69C28E4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAIKYGVgZRQQ7kNvwGNJF8S&_nc_oc=AdoVtVH4fpNlW56k58kZo8gkANFLtYKQLPhIxouJ553PXAr6-3W6Tf8nBsO5iQnxC9Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDzs8GrDl98-aA4AM4sB29C1Fgbu3eZLxGxUtwUuODxg&oe=69C29E2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tiVZKSa5zkYQ7kNvwGcGeYg&_nc_oc=AdqRmVfEff9S6X8UPLL6nB-XX8JPCHkWRjdWy73mMY6EBfInzbyIa4WDvjHdCZ_cfT4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrkzW0T00z3FXm86p0WFu3nKE0IvRpZMu9vOSRgNLLJA&oe=69C28182"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmobOFeOycIQ7kNvwGKy8fK&_nc_oc=AdpIRwTcD5kkvIGhtYQI10SkeV1GV7Q-vGtSwU8D_wDjcwQQYYwWJIkcnWWgxAVm5UU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn5RbPdSHYtDkVX4k9op56JA9GISv04p2q1DMhugygmg&oe=69C28C6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
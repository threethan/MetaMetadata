1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8ZQafrdvgAQ7kNvwGD4fKf&_nc_oc=Adr-lJFOJhOax9lGAas_GhNjj5a2-6o3uXMqzTb0jXVyJBcz_1wLW9vp5vuBuBcsgF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8y0tOSekN5WCpDZaPl9Xt9RFrGatnJTdkXtW9pgagb7A&oe=6A281EC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jNvRPK9B2pkQ7kNvwGogKxQ&_nc_oc=Adr47TM81PkzfDCoyVuxRWWl1CS6GdSMpbpXV4GwtuWv0hVdokYWSbHnjdUQJ2xJrzM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o482RiYy_XzdX6_y0CqAJnF5TsqojnEpSgvk7ydvCVQ&oe=6A2811CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kdBX92WX6IQ7kNvwHcHh5K&_nc_oc=Adr0DdYG_qg8Kodj0TBRO3eQSHd6XWW8GjFgHfLhNlwgi_aljtFd-0PQ7Ffhef00Z74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qkI4JUnrTKGSnEzi6VTsf8O7FAYYUE1NWpzdx-zNJxQ&oe=6A2821AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIt06-sjYRoQ7kNvwGMAdzO&_nc_oc=Adok2aSP0M5oriaKIFZjBnu8tAyL5XyR3WMJJ4-AyRFkETNI92_0VIlOnQkKX4fLLgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KYQW8C9AnoWo3qPlizpXNfWzTz6i7RzlhOkpjLBctuw&oe=6A283D42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8eMQsyfFPIQ7kNvwFdDx7m&_nc_oc=AdptpHvcQT-N37HNj7vqVPbSgSkKlmTZJERV7tumMg7xOW6eZiffKx0fIQSX3NuwXRc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9npEBP1PuoSdd9pCDbzLV_zf-MhAaI3tOJtJAWnmsTIg&oe=6A280FEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
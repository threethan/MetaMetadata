1940983", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-cVMy_L_ykQ7kNvwEYAPRf&_nc_oc=AdoecBgOHcQ06iGQkmapl4jGkKqSCZKMpsCNeeCj-pSO_-VaEQKvZRD6ND09rccrUOE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sb7P3gGRElunruIYqrU5MAnhr74wk4kYDnCf-iRaOCw&oe=69E23F40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfKFb9uIhy4Q7kNvwEfbJlJ&_nc_oc=Adpl8zyDlhgNqW6tECJJeV46f_0aFro8rsSzqcuJ8yjP9spQ6TVEfCSrwO5VxWXVhYE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SlzWIBPMUzKL_MAhfWZ6kCKl12_5uURF5M8E38Iyj-g&oe=69E2324D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxtRo6GzhnkQ7kNvwFg9bwp&_nc_oc=AdpAEQkkQsqNKwlJmpM5-3qFaVorU1lY4Hs0gvxkVz6wge_0gEExup4DxLTQ1OQoQ8s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZZcSxX0VQA1cB05GCyeBgrrLnOqpzmQ1RAM0yFQXFwA&oe=69E2422C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6y5UR-_cSIQ7kNvwFoib-F&_nc_oc=Adr9WhHS7beC2LZtFG18IR0Ecw-GmtWRkFp8HZhz84hd_M8MO0V6jrlPI_ErquqIiMw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ttWi94OLVl1ZuFGs4DsXDkZ4JoVuLLpN6IHWZ812qGA&oe=69E22582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmbcfcqGmHkQ7kNvwEHirrE&_nc_oc=AdokIFUHolOwNUHKREdOIszffWmKMLWNZ8WbpoVgitREretY3GNcEny1MPIub7V_eFY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LqX_PhqrzRgvv63bX9zrio-1-awj6hsmnSpzbr9QMvQ&oe=69E2306F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
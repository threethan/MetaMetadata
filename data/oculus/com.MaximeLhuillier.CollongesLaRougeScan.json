1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZCOEuUoZE0Q7kNvwFYkJF3&_nc_oc=Ado3KIYXzC4UA713FOviBUMlh9zjiMtErlduyMZVzKRg8JoWkUcR_TLsnvXT4MuGWbY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTbxHgyVGtutxoNSU8HgAV4PeEoBMy57nUldttN3mmdA&oe=6AB28C40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7zNC1byG1wQ7kNvwHeHLm8&_nc_oc=Adqjlj8qFLoP2R1oZyImWMXdqYzLoYuNbi15IgbDLUN0-TPXQVrHXQ-GCyBkOD87yFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDl9_Y9r35_UurAlD1iRdT9CETjl4qX0DdbPkh3FQqFg&oe=6AB27F4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1niLP5ygu6IQ7kNvwHXJniB&_nc_oc=AdpYWUZ_6MvFGumgjZdpbHDM1TMwv3wEa3wXPMN4QH6WF-AFK4DkJ1Lmb2e1QMF_29M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf6LXPtf4HSjck8e1hiYcPtRHTpziyQCzprAC4WmvkRg&oe=6AB28F2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HW36Egbk0EQ7kNvwEhnwih&_nc_oc=AdpQyFN4WUMhHqqLf6f79OtQ5Q-fOUE4DwQLtLSvSc1DqGwnWwd6NjbybBJTjmSq-l0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnOXVA3RbNdsDJCwDht4kVOXxCBB2ZLW6cKP5KpcaBzw&oe=6AB27282"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FttxYlL0pHsQ7kNvwFydyVn&_nc_oc=Adqvs53n9Xup6easLoRPnARx5BOk7Bu_sEu5KarabWzMZ7vd97pKOP1pUPsulFPmjck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrDcAf5maOiK3Kr76hFitso7LyeXHnE-kMfWIkkVClsQ&oe=6AB27D6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
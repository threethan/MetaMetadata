1940983", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25Zhu88klmcQ7kNvwEW0tYk&_nc_oc=AdpdOrzyVjrg3NTUynfnJ-NeAeROZJIgYDoUC-OsxnieH8r4sjXB5Emt-e8nZWNWwjQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzTzfTI8I6PINabqbxGK7wEDOt2pVo8CRuYgmd7ZGhMPg&oe=69D11BC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS2fiSJSPREQ7kNvwEZztZE&_nc_oc=AdoBQlfRj38ffS6ssNjlgrEiQ6s-aZAgF-_DiwHhiMw6uhmCk5pW5VMwiYj8xnaNLZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9fUZaPllgjIfytQpS84ckdsBQz5hkBPnenQmdahSSOg&oe=69D10ECD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH1MKmfSHk8Q7kNvwECiRPb&_nc_oc=AdqQotyPJ4WeyrrNGZNAqw_TRICHwy-oYzjwdbQ5EUn_lgFNb6-xAi4wiQdf9LDr30Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHqIOXtlx0YTmriyAgul1an1jBJIQr-4myT5rpmqhw-w&oe=69D11EAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=In6Q80dyxXQQ7kNvwEkRBCd&_nc_oc=Adqikm6RSLED8YlxdcYeRmnMnKrZqHpj62EnfW39fuhtSGR8uhODFktSg7nrveGGbck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqQ6hrtsMIAKiT6WN8JQdhPtD235Z4IGeV6B930lyExA&oe=69D10202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUNzMm3-310Q7kNvwER1wjm&_nc_oc=AdpoVmeDest7w9R-xlsNGzQYHgQWybvGoQTbf7E37BR5K4khlAuV4W0WcS1-jHgf6Xo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxh6BiJQ9Dpp4UKaKS044PWUiWbFc7Gd3yM3JRi-DqxGw&oe=69D10CEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc0pWrWn1zwQ7kNvwGvRZ-e&_nc_oc=AdqBVMVPZOn2AjUmXt1GuMSImviiZQFCEn9qfqQJ8tFUEU3f35I5bRL9krwqJ5qBvHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z2NkTv879_0R77_svakaQv6ORffHwwvcOlQ3JOfqF1A&oe=69FC9D40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Qj3EEaPjKUQ7kNvwFBNunU&_nc_oc=AdqdSnADknVzKZAcQK_72gEZ1zvAMFWCtJkIRXrSiSOHZ0m6WpZKlsdkAJB4hozzlOw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h_JaBmK7MIgkM5QfLa2yBhykPoC1AV6qjk8uP28MOLg&oe=69FC904D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrY3OzA3UXkQ7kNvwFQtGhQ&_nc_oc=AdovUGYIYCtPHlVnU-6v8mzK-GDmm168wqkrK9KcRLS-qBb2f2kY8u06KAk8zvEEVp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74_CU0FYDMtZndNO14HuPTRkIQdML8ZeSvEYRbvAvYYQ&oe=69FCA02C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amEkxo5bZfEQ7kNvwEN4o1G&_nc_oc=AdppXMljcYCmnGOXFi11zQGDpJ4AZEB09j69fkS6ACL8uNgTCfk4WRsyMl38niS0DXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75z1tq11NqlrLH3FySCfNdhivOydo1h1UZFfK5FQhbxA&oe=69FC8382"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_VxEajP3ZQQ7kNvwHJ6mNV&_nc_oc=Adpjb92KiKaS2DgpXT6r4-LvwQ4r33CT5dCvwOYYATJmh1lgrg9Ly1M385e_q6bPwI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af644fpsI4SdL00hs_TAhzhGSLe6BScAfxU-H78TYO3r8A&oe=69FC8E6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
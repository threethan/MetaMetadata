1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odn3MlCMG_wQ7kNvwF3mHb_&_nc_oc=AdrOK20Nz3ubbXe9r96fM0GYsifYe79GR2FWzpgJSbpo38_VaVwtGBXKYyQ-QYWlIec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnlRWw7_Itef9VtJ5w4lFrWlsC8fNswmZazqf45OEHxg&oe=6AF5C8C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lTlHhpYD74Q7kNvwFtK6Qd&_nc_oc=Adpqhqtq2UpbiknZvd83uHyeu6oNBwhe0TSBn_cHDsr1V4NrvmjrsB6jKzIgq-C-YYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2QxYB7Xq15fFGIVEC_bcjCER3sjDWnk4OECCw_2oGAw&oe=6AF5F40D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0mer0-Wq4cQ7kNvwFUnlzn&_nc_oc=AdpWiIf9jKUJlefi8--_h-n-x6jJgJ9z_HsEMYmJ0JXbjBmVXOtLES-RSVEqRapWjMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyplWXuzsrBJpM_1p26vJLSU4qYo79N8mXBpE6aZ1LxQ&oe=6AF5CBAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13orkH5sxqAQ7kNvwEICpUC&_nc_oc=AdpSYi70vnh9U79KgMBoVTW5rrSMCL2Cu0FDddbBkq1nXELkOi7_MdYXEdBeW24s7b8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtsiwk1bZpKZKIQYk9GD5PYKdNMcOk1bAjjjGbZSXJOw&oe=6AF5E742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCTcUN2FI4MQ7kNvwGQSmdT&_nc_oc=Ado2DjhOcZMwqPJGOu60dQNBz_DOPosUapCMEWR0mvufQAgp05j4nz97RhMgxwFlr3A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0WlJRiswQHysYGOEz0HuzH95FDVT1midYW2gD9fIyjw&oe=6AF5F22F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ut1FvZURHwQ7kNvwGAQ-Or&_nc_oc=AdpcE-mR0JVOJaxj9rAMdUKFwsFGnxMs795sRZfmeE12Yk-x6dP9nJ3eMJTCjX9Yxkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cwt5_8-CubX1keWYeu-L8Fhr6MiiJHxmB-imkjKIVAQ&oe=69D3BEC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqFYvZ5lP-QQ7kNvwFjemP9&_nc_oc=AdpvrV3lfJML4WA_l1SQgroCa3A9UnxwQs319hy2A6w5zPYUc2RMWZiNeMJxDZg0x1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11hgsxmHkagxvCdtYtGnx4I4Y8KIh80HM2XwoEQxOD6A&oe=69D3B1CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH1MKmfSHk8Q7kNvwFck09W&_nc_oc=Adq-GmZK7fW3xhq62KJgcPDVkgN5CKJCdTlutrSxatwwxtjed6v0Y5jDvg3j7WiJKEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZLzpcqfxVNv5zSVOcDgRUXOldxt4GQs8VT88dsPx6iQ&oe=69D3C1AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHwdRqdtDK4Q7kNvwHf0hD_&_nc_oc=AdrKY6nRVFzXz65qSf9i9jBZ3E-V0Iva_P4SLs86E51kNISlEp5Pa8X1MLjj_XovLR4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hi7Gcyq-nJLStY8wqDeertIuYW_FTOMwfDuBo9KvFOg&oe=69D3A502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lUNzMm3-310Q7kNvwGzl9WP&_nc_oc=AdqgCpZmvHr8vcsYg7c8BJ-rzVjHjupC6A5rui8nDcBkidn6yolmujVrX6BsrZl3E8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31mVDWBW4IKnhDKqhlte66UmjhC6oD30wPT7jBZ7y3sg&oe=69D3AFEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brxDTjARlsoQ7kNvwGP779E&_nc_oc=AdqCzL9Nh24U9SK3w42RHDwsOBogdtArTThCGei1erzj19apnrKBS89c2pbIotOXeqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qF1UUwzXaD_5yEWHbzyDi8RNdKNBLORi4vkJBBTArPg&oe=69F8A8C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-cbzNwRE3oQ7kNvwE9v9vR&_nc_oc=AdqSlP4khtLERF4sIjyvDRHE3fG1htYPwNWI8IyroEM_mlSUm3x0bMLFRfNQWbmCWdI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GSWqt6alzkowJT4nKg_kZejJjxpbeW88JpVkgzbUd4A&oe=69F89BCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybDppWmWqksQ7kNvwFKX0cQ&_nc_oc=Adp1DJPHlUFao4gAA-t8QMwHDV-SsSo1zfuaCHLkQtO3ahjvhM1bK2xo1-WsZEk2V_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2znn0HmN-tqTesFGz_CpiN46GMurKRqNzghJQdt4unzA&oe=69F8ABAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er5bVS2s9m4Q7kNvwHfixE1&_nc_oc=Adq_Jf-pUd84bmoBYklsZFO5BZGOYDE0xGszhNo4DzVrcviuDVsG7JBlBui6QmfSHgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2y6TWTePDn4dPWH7Ovtxw-QznbSMLVLPYGKElj5cBwiw&oe=69F88F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q22obYNz-0Q7kNvwH0eiZg&_nc_oc=AdpSd-0TYSPmSZeIrjXXr21AiZR-W28HF5aE40ga--KW2x7dywOYuB8I1uIb6gDMWbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ma65r9loWG6G-A33bfX3soqrgyJ5o3DVg2fApXjKPiw&oe=69F899EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
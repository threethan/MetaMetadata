1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAOeHE7aRFwQ7kNvwHnQift&_nc_oc=Ado-oSemoXPnYqR_NdWo8C6O9Ci3NIRR1VrF9Kz5KNcDt6LCbeqq2eUmJpxQZ3BHSbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxJVgCNnNOoIgw9qa5t20DsCKgw600PQqIExGxWV3b3A&oe=6A997FC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmZU7Sig7lIQ7kNvwH0gpyq&_nc_oc=AdqWYsqcQRkQfIWC8oDfwOxcSjQJlj4TvGwm-t7QKwHU65ZSDeYUXGySqSqyrDBt5GQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL29kdxIHWhT9m8g5XfMin8i9sFwh1EcPWxYpjuuZ5AEQ&oe=6A9972CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKwkM4OOY6sQ7kNvwHJLWgR&_nc_oc=AdrNRjkDLdwiGURJoIfGLlC1wNK5sFd1lGAQFXgVKt4R47Qcye_8MYGej85CoMMHisQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkP1w7ltDkzUOBBeADp4wQiFbOnrAmCyIeu2_VsyJUXQ&oe=6A9982AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ts_62YWrMxwQ7kNvwGeop58&_nc_oc=AdrY02UB79EpBb_QGnuOmufgD2zsU07tB_1SBNI2bxi2pbDsMbYNTRnTRUA_F_DSAFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ89jPF69Y1QteP83kqp4tHV-r-NSP07GKU1U65H8UHjA&oe=6A999E42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsQANfJD3fcQ7kNvwEPljrv&_nc_oc=AdoHYVugmfuNDCG4HqoaIHAcJwxPg8M7G-iJ4QFWg2p7AK2WQSJ3zWTqmTKAqZySdXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3WRsVt4JsE86d07eomv6qltvhxEDxz0nvFUmCqQRf_Q&oe=6A9970EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
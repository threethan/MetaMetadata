1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc0pWrWn1zwQ7kNvwGcvnpS&_nc_oc=AdpxxKDk85ZJV1mEvHgyjUfSNcF-QRrgzU_ek1b_Zsyt9DosOqpX5fTpuB6JTlGTBPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-yqGlqE-9PFtccMyjQEtHvJsktKUG6ez3mnpmBh1u_A&oe=69F9FA40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-cbzNwRE3oQ7kNvwH78GFV&_nc_oc=Adq-aAwkiJd9S6WjfPDF16Py8im9RNYiJZTeePdZB48YX2-bazvtF-qvGGY6Rb-TRIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lZ3CSQ6ZpPiW-f7mopfSOpou8_GCZQyQTtaqfj8DdZw&oe=69F9ED4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybDppWmWqksQ7kNvwF2A9zj&_nc_oc=AdrAQtElZ0B9qDUFhRyKPEZksQmUnrZsQJRuxi1zaj-7x6dtjtH88KmLRCH6nl5AASU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66d-2o4ohAOLCnJh3x2plMpcdZSGJk-gnvZQplhKM4bw&oe=69F9FD2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amEkxo5bZfEQ7kNvwHJ2oz0&_nc_oc=Adoa_qZXPH61T5px3H2SOBDW9k8dP1-oi73Q9aKG9Lesf68brzY73tlBpf2AP37rqYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ajkHhi0FFIT5u7AM65264RY9IdURdE3WfcoZk5t66-g&oe=69F9E082"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q22obYNz-0Q7kNvwE5dS7Y&_nc_oc=Adr_5plzZKr5H-3b-g3wR-qrafL1lIIRxKKUkffmzaYs-3Bor01N3Jcd3XCEYbd-ZEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KAVWDck9tueMEckAKCPJ_CNi18Z8z0_ljB274fxrolg&oe=69F9EB6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
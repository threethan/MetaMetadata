8607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5982sHp6rscQ7kNvwEK-qPY&_nc_oc=Adl0vehM1jAxoNm-wJ7opzwNyWjByf6Gm_vAaDAWcm1ss4Sw4EMXd7ZGageww9eiMM8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxNphi-Gd2DNsAmCEOMHURubYPj39AVKOnF7LD-Pi0ICQ&oe=69BAB240"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwyORJiZN_wQ7kNvwHVtw82&_nc_oc=Adl6h-5cHdwkIkidW6XEgnmFxA4RVkXmcUd2jWrjsonl_VG2EBGgt__Pee6dtCP67bY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuX7hFufFubZThPc6WlF6Vo96tP74gx-eIPqXEAGqUKQ&oe=69BAA54D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w09DyvNkJpkQ7kNvwEstgfK&_nc_oc=Adlxme2-svzXk3_DeuPB_wHlkD4RpJljPWpwTfnR3WkhiGb_4fhcXU7L8rJSOxRg4es&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyEcmuIrVd_EP5CNSJnl-EVXE2EaMQyBqHq7A3oXxjcLQ&oe=69BAB52C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEH_zgWuQEsQ7kNvwF-OzpQ&_nc_oc=Adl7OwgCcV7m0R1MsRBWluP6YE3RDAzo-h_yGySFgxKzPGJzGiQCrH0FlqsyyOjLypc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNZhFcsI-JwSEH2oLG-bpSUFzLgrh59gVyhvXHiojMYg&oe=69BA9882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTs3mCHDzKsQ7kNvwGwKn-K&_nc_oc=AdmovuR7rJacXdE198jB1R6kddV4tQjlzTP4J-iypS8NuCnb5k4qVbRdk76sfPPt3yk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxInyausuGXC_9904CGWDLo3sJE8w-GuhS_qtcJJoPApg&oe=69BAA36F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres":
1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RkqKn1c11AQ7kNvwHPlIWN&_nc_oc=Ado5AzpWyfqK8Xuw0u7ZvNdY4ZB1X6G6A4001pluyyeYL6Q4e0i5tpu0LuK8XBte-TE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE63_f2M5adUOGX_gXoRKawkVjco8F0PB8XmGwnnZEe7Q&oe=6A7C7EC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFSqn8MIFYkQ7kNvwFOSTsn&_nc_oc=Adr00qaD5y-L-TmtRbMNn0yLnxCq0IA3u5zeVCcOBSwuy3ny1JUfXo_45c_A_brZ04c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA_lmSrZO4I_hWHpCMeyWh0XMG0HTvLivQ25PT_-BcVQ&oe=6A7C71CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA3ODx5DOTAQ7kNvwHzYMg6&_nc_oc=AdrkInrIrttjyX-YyFMMmbh3pEe8c7qoPkdm2c8ko8qpzfZJ1Q8SL26a0bm_IKMBDf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAhUTSzRPjy75-7DWYjB7dDNBowAWttcpN3tClStkxWw&oe=6A7C496C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-CGgQwOm4cQ7kNvwFeCjgs&_nc_oc=AdqH8R38ICEhHVAkDFIHzNwl2G1dWdarxq7oPyB-WRcy7ETS3-ju1uHMzT8VgD8cwHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtCcv-fWA8Gxp70xxSwIrxzZiKyCyExJyyTl9tvJ0jzw&oe=6A7C6502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGuqDxeg9GwQ7kNvwHbxjzK&_nc_oc=AdqV9DUeLIsRtRuAKRTfT_rGzo7i9zOyWYLbJyZeDnCe2NQVciYPdAPcbaxCD2Y1cNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxdnPo90sKFiJ-16kUi5pLqFZ0yDvnBDI079lCSOiyjw&oe=6A7C6FEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmRShz8BDecQ7kNvwHbpMQy&_nc_oc=AdoalbE9it9iB6FVb3euKvhJq4ZsGoZLiin1dGxZtZSJcP8pPPP6WW8JuiN1yA2pqB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1q0mTLhJPxrdGzpT9_VGhuS2rW-JkFlEmzTpkWSS6cQ&oe=6AA80040"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkjnIUVE8BAQ7kNvwEbtlVk&_nc_oc=AdpAg9mMnQx1BEq3CninhfIem6H4Ry1oC3PZ6NeWQegepEh7gf-pS2_l5TxfkIGRdrQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYuaNNeVHBkiSCH7RBZb3j-gNIdyyC9eN5rSaQxS_IZA&oe=6AA7F34D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LeCkgFSSnoQ7kNvwFLTTyf&_nc_oc=AdrO4S5epde_7tcVkEAuLpwwHR0P9gZ6unbmhFXWdtV6g1ji10UWSmtgnPXE42OYIoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW0t0N1FomDq8OZX8uLmDTR-qR4jS5lLazsSX_rtLdJg&oe=6AA8032C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLZwlO1IA8AQ7kNvwEET-Zg&_nc_oc=AdoiYgdauIN6Hb8pt4QyJ8o7pST5F7oGZcsP6V07a5yyivdLnBgTrnYqsHV4y6_ZM8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMl9r1oRs39mveQXvDgmS1E6r7IWdpG1RRDIoK5XWs1g&oe=6AA7E682"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ9CI7M_kC0Q7kNvwFryuoY&_nc_oc=AdrgML9KCV1tBvlPW3eLCfKwzquyY7zIU_qBvkwO4qaZuHblHPeWywVPz_KX0TZI2ZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYeULWYH68rD8rWOa88miAAsTYL91tjs4lgleHuvO-0Q&oe=6AA7F16F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
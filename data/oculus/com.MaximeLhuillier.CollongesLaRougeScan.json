1940983", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckkgbRTbrsYQ7kNvwGTCsMG&_nc_oc=Adr81yS4EOa4eIfH8WfVc6uTwVhqEaFT49JGeQD5V6lkkIcb_6K9Ki69-fVVh5QPBmg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkmCeN44oceF_3LeDzqp1P5h5WO0TURiXbez3dG6Z6YQ&oe=6AA168C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVZDaBVxnSAQ7kNvwF524B0&_nc_oc=AdrUA6lTMzcMOqBwKY9nQnAjQKmoKfnMuiJCx1_bqwH_wfuzqC2zOWedAPIUA10iO8M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL92EapzPYdSVYu3Dn_O8lV6ZVT2-a0GtdOJmenb_Tm7w&oe=6AA15BCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AxigEgRbi1YQ7kNvwE-oAtm&_nc_oc=AdqNDy_apPgMzM0ejI5IKPxkC7SVKmNl6K6_uezmtwTuBCxGzuxwP3mM9P8MMLZbfME&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcbGCd2tAkgO70_ikMw5bg2rLHuRO5HB7UTxkmW5PGLw&oe=6AA16BAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYW1tnBZwbAQ7kNvwEGYE_T&_nc_oc=Ado5MeRnTRfPY5lRz-Xyud8yDxF93mfgIzID5lGar2xtkEnRYo_w9IczwcLR2iHYFrE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxYhfJL1v0g5T5-JeeyJ8AFKk7lV0H1OqF7gxHwd6mUQ&oe=6AA14F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VYp7aUwLvcQ7kNvwHLvNmT&_nc_oc=Adpeyy3vZKiQ2W4cK7Oj6e2vTuvbRaNNmOqYLRI2pSQXA7vZ46UXwvi45xwd6xXN7ug&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN69x1N9aV1a2edqy6dvcve2DAabqgaPFHfQ3-G9wctQ&oe=6AA159EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
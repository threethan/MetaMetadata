1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZlaoocyo2AQ7kNvwG7dvEw&_nc_oc=AdpmzhssO2L8XOrM3vf-hhw0-xu8TRTaJrXf6wrNVHIGU8PzM0w1l-Oh2res9pHxgfo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hXw0WUOhxkG2YflpikK6rI9j5xhP4n25TVM-zmFw35g&oe=6A0DC0C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VjfNJPPkzsQ7kNvwEnv5GU&_nc_oc=AdrbHBSFbZMKI5euWFpcP2nqw8knF4lBpQlYcVU-KPBe38jrFenQhHFMJ8nhPzLQFLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ev8TvAkLQ9PfULN1BO3UF60PO7xi6b9wbxkUEvFYCmg&oe=6A0DB3CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Frq8G44MYQcQ7kNvwFWlEsF&_nc_oc=AdqpA8WgvkIJ0MYNAgfx78WyhGzdHJZP35oz_uBif0JpCUeGP6dxOLPjL-tHcslupDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TzBTgV2gi_vdqQ7FKr6cnlWEnnIFsPvifSKjufrwnVQ&oe=6A0DC3AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRN3g8qonisQ7kNvwF8RZIr&_nc_oc=Adri4wTE97P96ZGoJ-gycbs_ApMLW1Fc0KEzt6V9tbGhj37nou0YudUEMgUHSOXf81s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KF0N2ixTqkpIT7CVDRDyJpTwx5kHBTBseb_DWsyqmcg&oe=6A0DA702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyN_QGoQr_MQ7kNvwFF-A1v&_nc_oc=AdpaXRe3aO_vhng0UT93CKwTH-OY0j2Ry2QEsmQ5vdN_TqAWzAwvzJlsIqx-HhM6e50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wIu3En7OCBLyliWYQnE9Dtznd8fu6gaXsxCxpcdlX6g&oe=6A0DB1EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
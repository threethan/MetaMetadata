8607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WmjEZM8iiRYQ7kNvwF0aFPx&_nc_oc=AdnbjtEuRqOP5aFIvycDZ7vFIdpIwusjZWIGVx-9l553ON1-_FhMdvcU6D_ao5RdU8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoubGbbujUD8F-Eoe3yZnTisuT0XJdeDBAaUDEABRNRw&oe=69AED4C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxj-MgCV45AQ7kNvwF9-7wY&_nc_oc=Adkm0o9Ms1bH-g8Dvb1ALeBaMPblIO9gFfDAMVQQkPcnxg-2sIcyGeuhJq5hswCXdl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5BUvBhTXaGu0w6dSOephoVQ6wds4mBJYmQtNeR5xlMg&oe=69AEC7CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ub0KBv_ZaDgQ7kNvwHIqcuQ&_nc_oc=AdmBG1S3qPXV7vgbJpgaglD9XA7p25AdeVuGbfYX1RiOG9ocfOOUpiXT44w1FqEkLW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQ5PK_6GbM03I_rdrpBHJG3YnbUXfoE_RYN9qLV8Smdg&oe=69AED7AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ys73AMwTSl4Q7kNvwF1SdtR&_nc_oc=AdmpoXE21baZQbengtrAGhuhQUqMCLn9IPiTvBpNv1uEqxY_DYZfP5II3h2CjRYDrrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw2wUoWIJqFrK_eBZcIEYLCeDlaAEYRjtiqDkHQ5LpSnQ&oe=69AEBB02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pam8mxGCkp0Q7kNvwG1rVIU&_nc_oc=Adm6-hPECLbpLHXw9u50xDgoP7z2bFGvW3qPsL1TCI49WoeYzBPLALFxUaY4IHe2ucw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8MPAatLCdp8L0qxskTL5tbkU8rR9j2crE9WcVhLUF0Q&oe=69AEC5EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres":
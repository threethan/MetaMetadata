1940983", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOjt2VFoqdMQ7kNvwHw3HB4&_nc_oc=AdpLWxJIXAN-dHGgzcPDqOYI4at3r_R5pTm_IdOXnSv5pVii4nPMsbroJhzHUvN68VA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSQgW_AweU30Wq1r3-ik2LaX1Dak6Ygsa6bmr65nZzcg&oe=6AE0B0C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g8bTcnVgOAQ7kNvwFKDgPP&_nc_oc=Adp7g2_KPETN_Jm_WYFaz8OUm4JTsGfBJV_N9Dq_g__6nh-2PzLbyKMI1qaX2H0JURE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzCClA8fImT2hvI27xWrOGRoVGoV51N5EKGtGMReDN2g&oe=6AE0A3CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o8XzuG9xpoQ7kNvwH4zBjy&_nc_oc=Adpo76qz9GPJHtXQHKqHYpEnlJwa_cFuiuq47w82h-h0oE5rmNO0zjri0YeHt8BFaeI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQrQtcnRS38qmsbeJtvDEhZRTMRO-RprX-M1HQWqudqQ&oe=6AE0B3AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyL7-zhK6_QQ7kNvwEJ24ct&_nc_oc=AdpI2P8E-9Np6KpxtoXbAe7U1tJbgtUOj7L_cgLdzAo-RkdBRynKBcBjY0B2XL278HY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO43ji8H5jJY0IzljSHmmB9AD8hlYQOUuX7na-EQMjBog&oe=6AE09702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtyO9IhkHYoQ7kNvwEXlET2&_nc_oc=AdpW_UXiY4n5EAqoUnAIDRUzjKeT0NLPxNM-hpM4zV5aVj9557I1r7i8-2fT7obrfpo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX4PxbhUg1Kvfy9qBbE_XuiKl6WzpExleKGO1yIVf-CA&oe=6AE0A1EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
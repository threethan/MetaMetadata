1940983", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwO5IDqenn4Q7kNvwEsbSij&_nc_oc=AdpVKIRreqrtePmtY2FyuCKDLbNirztXEtwZd7pzHBH2WfGapX1EgRLKNKHoXHIweHg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRSailqkipR3GUcrusgfI6o-koxiXPsmtLOCHs2rRjAQ&oe=6AEC8E40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWcVKNUXh9MQ7kNvwG8l0PU&_nc_oc=AdoGcGpeaOMkMLKi5bByzcaFVvrexJUStZ2hgohBk2fD-fPzABm8aIIFbjWj4PpybME&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIuVgMWp4GP0V7YXBfW6IdJGfwuApOYY1Gc3_lJ1Rf5A&oe=6AECB98D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAmKFZBKLd0Q7kNvwH5ec0p&_nc_oc=AdrNX6F6sHfJb2G_AGBtEjkVWZqCb0wApTAIEaZyYbaW5jHb4sx0QepRSvfLZvG0LqY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_-_Q2nUH4aGD28rBXjII8ySAj38hzplREsMiEWdw_PA&oe=6AEC912C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Y1RScR2L2YQ7kNvwENoB8q&_nc_oc=Ado36udGQN_69wmhEXAbo2eBClCNJ5co5dKpYGXgnhJugpsrSukoldGNtTfOQhu3vow&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVxzOgLPzxEleYC_Kdxa7myTfijcT8PDGNMPih4kjM2w&oe=6AECACC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBm4Q-kZcCUQ7kNvwGxt3Gw&_nc_oc=AdqdhhTedMtUyLansIOqcSSeCj4ueyS9FwiDsxaEHiDCXcYvz4rOHGuF4KMOYEc7V8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZTM3rXVOBzRZQ55ZR-IlZW_DCRqJq0-39xr7l5tN8gw&oe=6AECB7AF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
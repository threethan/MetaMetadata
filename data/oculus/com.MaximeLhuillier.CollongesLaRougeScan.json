1940983", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3aDw24h3WUQ7kNvwFwb5ZH&_nc_oc=AdrqXSM7r1sKnw6nGGURWYx8V1OoywkWysSfpuF-NapuIiIhcQ7WgPER95taUSDWsZc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrWo9ZgTjRB-u31Y6MhXD3AAx1W5YdtKv4Gm6Sr5_Beg&oe=69C68FC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb9u0HiJrFkQ7kNvwEhqaAG&_nc_oc=AdqFygre4kn7-lLare8wMxgIz2S6QIqYvZVx_Blu_gj-SZ-9hYYy021_PMApho1TRRY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3CRYLQQYRJTcmK5WUCaB9Fv7VCQVYLODyKR2FHY2HlA&oe=69C682CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPhCmxGDnTAQ7kNvwGYA5v1&_nc_oc=Adosxbf0D-A4azrteV19lwDVv-7M4pKSr2yYgrvNTmqC0kTsH-V-P3y6WDQfhxYa3Pw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3BxQA-fmzdV8w1wsy8D2nFxjyMFhcQzCcAlel8fgNvg&oe=69C692AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpwY7VXU_DsQ7kNvwF-ZPZr&_nc_oc=AdoR9edglcTFnQ49N2APYjLPf9YEM-UDXzH69PSkEGEq113ysoDQb0pzTs65KULhmzY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIMQd8bIm2AWZXcbhl_qQUQIK9yYm--yvVwwMO5ZyDGw&oe=69C67602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lu85lvgV2p8Q7kNvwEn5Zhg&_nc_oc=AdoBATM3pvvQE3ywSrY-Tvt8DfCL1vh_IxR4wSVcRfoQUTzfDw8UmXdwm7dO9wuhuME&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxypp9Hsya93uc1bRGkciOruAsTsgH05TFrdPtmb_vCWA&oe=69C680EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
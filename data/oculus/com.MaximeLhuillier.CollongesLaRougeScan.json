1940983", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bwwpl9zGVYsQ7kNvwGlSPh7&_nc_oc=Adr1vCVEaVgvbcVGk5cu7PGe28Aj_WpWcv3MktetOHysHlbRg7o139YNC5Hb0kVRsi4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-mGbFL4BFyLEd82PcQCDoeDWg_7sN_XGYM_6LmDZpNw&oe=69EF6E40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bf5nE8jWCdsQ7kNvwGwI2dD&_nc_oc=AdosYE67p-my5gpLTaPEuDTe-5nJjYIv8j_OOz93z_uAlr3U2sSsZSD8bWqhkkEd9J0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05T6pFUHpw1nB0CfYsceAbQx0ATSjw6s12Zobljft1Xw&oe=69EF614D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQGpazDVjkQQ7kNvwExF0fd&_nc_oc=AdpBbwVjsN0BKML1186Y8xq6__mDGQGctcwjnVeD4YMS-JToOfk0u9P4i9MJAsU2Z0s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3E3GqlFqeHHcKrxjCwAh2bnLwOehdFZHfd9FfCK05uKA&oe=69EF712C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvnntstteYQQ7kNvwFtLciI&_nc_oc=AdrgLLDIloYJK3kg2pLI0GyZ6WFio7m3dSfFyspcnb9fD8YYLE3YsaPt0IvFDTnJSQs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0US5qRvwUif-DtLcrgftgnyM5QLYN55n6iiJi6pM-BGw&oe=69EF5482"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQv96r0zORAQ7kNvwHbPwEU&_nc_oc=AdqW1H453qt5Jt8uqkga_MsxMmGoi2TsTv-PkNb3JoW84I4zOd7x1xftTkikkrbNXoA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NEjIiL-UiOibzm-b-HPkDk2qIVJ-9Etx7B1QoFCbQMw&oe=69EF5F6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
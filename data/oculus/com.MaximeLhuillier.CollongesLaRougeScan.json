1940983", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVhjtY2TvloQ7kNvwG6cZrn&_nc_oc=AdpoHOxjD4DR6A-wlzj6b1C_MYwA08idT8wZGU6ys5oBYtl9qwszPHYgHKsZjpA3xeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrr6Bc9piRfn94-zoQ7zcjDtWGTeEqFNVZ8U5x38dT9g&oe=6A4D08C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjZXpq1EgsgQ7kNvwECjj_r&_nc_oc=AdrosyRoB29fkqRS9omCBrxA7ZoVkVvqQnFYXiPCR5znqhenwRO1r91SwF1Q39BtV2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEwXEPMGoT2tJEtvzMNnQtkDUYxC9mcK5ApB-8B3RrzQ&oe=6A4CFBCD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2keQECNEaKIQ7kNvwFBLbLw&_nc_oc=AdrAk6GLolCy5r437bFv0jEq-aiNobkxzoS37mRZYgdO7O6Ayb0_WLfHl1qjwqgGcHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd2anvNsQsMVvgZzgFa_vyZCakCkPzrwnK5xT322QOtA&oe=6A4D0BAC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga_FCYviux0Q7kNvwGpXWRo&_nc_oc=AdrBVWEadhvSw5LDlRG8h3WmtW9TLhXX6ptGafOf964nH4Qx9O2X54Lu9N-VFJdBd2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsUklTi-nzxEBt4joJMfOiL_ewlG4wfLWXa6YNA637rA&oe=6A4CEF02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey9bEPzyJJ4Q7kNvwHvxpqm&_nc_oc=AdqLpQPpVIiUiHmwbOvhmBKWu_Yujn9gxdovDzGgzzAQ-xyKFsVQ8bEfR3p1RrL2MEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR4nqdkVL-U6ZcejNrChq7y-PB5CbnNhdYfFanVr-7YQ&oe=6A4CF9EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
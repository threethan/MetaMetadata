1940983", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZlaoocyo2AQ7kNvwEQ8aN8&_nc_oc=AdowpjiSfBcYtObwgclTLKqu3oPwfHOwQuR95vrnBZILYZTemeVGveBNHo5Qic6tqwY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fFZa_r68nI6mJ-26BMBxKqndhdO4uFVMsguSPWxDW4w&oe=6A1063C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9zYnDEJXZAQ7kNvwEv0uSv&_nc_oc=AdoPG7MjmqGUrU6PG8ziOMjoVSlewRbVluUfQAPf3cnYa0fqrIytKiEGuFZ_9qXWFYI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vdmjuZ36cFuQ0oqQWUuMKOmu796-mkfRJOAbuXZKXHw&oe=6A1056CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhwniNSJGvkQ7kNvwE1r0fr&_nc_oc=AdrKu86ZIuty1A9T5xFaOIcB0RabGDm4heHHDf20LptQE7Z7F-tlVrJI-m6Piyq38Ec&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BtSH3u91wtQXWxKiE1AcIShz4KsIauX95nf5eunH1Tw&oe=6A1066AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRN3g8qonisQ7kNvwFW1FZt&_nc_oc=Adp5J6JlCVaCVtuzG7N5TqyFzY4pc2_yUHfozaMJ4g7zuq3NDMEvY0OExnmOMVMn9WM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QbPdf_j2GRjwDf4i97PlEy13mgag2BmaTHuhF517Yjw&oe=6A104A02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJg_h0xXdAoQ7kNvwG15GxI&_nc_oc=Adphk3kR3IwbxDVLz_EryuT7xk757F7TQSqnky_hL-p8tIdvUq-3VUVvT1gUVmrLWAA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af576q4YK8HxpNzijWprzKrFM2Jd0t268L9nANqc7Oey9w&oe=6A1054EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
8607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T002Hz8zqOUQ7kNvwGGXc5X&_nc_oc=AdmiYXR20Ppm7uGgZH5oWH_9mHWdVXW2nR9D_TRnNU_m64_4zS9znI4lMhusbfK49mU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv3zYichUeQMvfb9ll_ivTANkJC39q9I_M7qYo4eZPihw&oe=69A98EC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvM61rMTAY4Q7kNvwEs07Xa&_nc_oc=Adk4VXkx7bYOiWTsD9Jo1XOX-hGcFRCMfkzh47G0xwMCTNaUlsUpLZHeWVbDATG7tzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsNFYcQraHZB6ja38WtbANRlalfw-262leJy941DoWtNg&oe=69A981CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG5WtCrouucQ7kNvwE5JgNY&_nc_oc=AdlMOfHz7W11vLzZXE6QnQXHA4XZgn2ytVi5M6SNFJq6hjrrUFodR3G9VXrRbBA62Og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftW8a_1UIYuZbgYE8duBpcy85G2j9VQYLbO0VsG2VME9A&oe=69A991AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AlyBX78RYQQ7kNvwGOfa8y&_nc_oc=Adk3iFk0Ykc7Yef6EoPS_mU6wDf9RBbiTCNos3kdJHI2Nz83m6SVuZ06OnBBVg3eiFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv3lRuW7lX110iP23LEYe6HyyTvQ6Ef1CugiAXAo7JrsQ&oe=69A97502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oI_pJ1gDkooQ7kNvwGjdf6Z&_nc_oc=AdnwBL9ZG4hx2PcaxIq3XFOvIxanhGrDKBpIU8e_aYKQEHL6PEjaxx7F3kYxq9o8BaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftbhJbuBa16bSrVPakGXWhVVgw080WdLIhj6pOGB7IGaA&oe=69A97FEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres":
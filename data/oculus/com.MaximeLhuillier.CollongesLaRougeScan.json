1940983", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Tcx0i2YgFIQ7kNvwGf0eDz&_nc_oc=Adp5QuL7sqKE5eaVVXDuhZCzeZIbfI3mEmQOKIEDsYEJfuNLgGyb7pxJVtwgrZtE1ns&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__r-ci0reXhwH3wnT6ImmnASsmAOjzNQzgYBEsa2rc-g&oe=6A242A40"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ghbjzVK0LoQ7kNvwGoZatu&_nc_oc=Ado8_enA5vGA2O0ZySMNOhimQyMvJn4jSu6J-HS2tD14Jxpyg0R_O4b-xE4k4w26ONk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wqkyVOdGQPXr3cXoZVDGrbjkqVVkJgiGtDRmkK4BxTQ&oe=6A241D4D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtXiivJe0SQQ7kNvwGmZ2O7&_nc_oc=AdpkYwes92ZIOZ688MaAnD7YBkhSpS9Y56DialeCTXXkpgL49IB4_tatJUepbNXw8Uc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V7vsbNgYdPOdFU-HGw9RP2-BbEngtrT1KzUzB9m7VyA&oe=6A242D2C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkDp4M16vuEQ7kNvwEMPE6P&_nc_oc=AdqAJSWzSIZXv4k4ipgwtKXhia2egnSnXfIOEwpGVHahZnBF9_ph7TlYyX1rpXiIs9o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a_RJdpo5DOCf7bwbpXvhH8D_u0sE6wNaOOtyFlHzYhw&oe=6A2448C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-lWxVD6WkMQ7kNvwH-Xge7&_nc_oc=Adrr6DTZ7XbyJy2gku6ixH9Y5mrtZ_dqV-QD5rf57J1QamrrmgVV5uhv-jfQs7cBzdw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bL5mqSNb_C4uBH51Dyevyw3qRGmcRllK15MifizOd-g&oe=6A241B6F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
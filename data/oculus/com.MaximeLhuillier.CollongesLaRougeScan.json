1940983", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3c_aK_4-J1gQ7kNvwFuUayn&_nc_oc=AdqpmKMcyro_UalcIELZ11ElkksoM0LS8it7WMbBNSaSlBR-0PixsPNuUEzN-iFxAj4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNt_yWc7CjvMY-ge6UkteyiS7HPPVdzppdzriqDMHwrQ&oe=6A915E80"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9b4OASg4ekQ7kNvwGg4lDn&_nc_oc=Adp4zRpqgIcsTvqICw61uQd7o9PAHAiOGasjX-HBsP4vQaOG2_LJaUCaM8Kc1WP_MgE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLVCAVhS3BRBBI825OelLZYX7DWvDgD-3Os6WTxC4llA&oe=6A9189CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtxfiA2jysMQ7kNvwFHoWhE&_nc_oc=Ado6MZM76c8cHkFtcPL0mtowSMwd4kfwaf6ledU5aJAIRU5tXTWJ7iN8tOqSbidt5Gc&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAqmQGqhexUBvbt3KhCpQ2BbWUgx7EMbXRywSeex4OdA&oe=6A91616C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBQkBjpiq-AQ7kNvwE0nn9m&_nc_oc=AdpINMmx2FlsTNIEx1UsEW8HjhlydeLu4-9KQrD14u7XWzSflncFGRnVR-joO-uh2CE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHl4yB--kftgrUl-W_Sf_jSbhbnKGTE9pHdKXi2nGBGw&oe=6A917D02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeLHFX97sVAQ7kNvwFPnjZC&_nc_oc=Adq2s5zqlfQN1cVAu9lUq-BDmTpUjQsdyaa6mo2ilHnjIdAmW2HSP-KKL9g6KxMk4eg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3kdG7mwMskSarYOORHUm2uX3Q-r-UK2H00gK0nGO6ig&oe=6A9187EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rG2a8TXFnAQ7kNvwFxhmeL&_nc_oc=Adqh-7rPiq-b_LXFhuIsJFvQzyrXvnb-xQUgmh8ZDnciBrt5otxRHsgDzmUBUXgm5sE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fN9d3zsnEznWhHOrjO4iv5mj7wt0Q9D7GBCHc6rbapg&oe=69F362C0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytcg0yehtrEQ7kNvwH4-use&_nc_oc=Adr8JWKLYy9nH7Hah503PS3_Rkv-krEF6K424BYOsVmIwM0UB7GkSrlrCMggNpj1_CQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MZtxMF6GwcjgdrWX3TbED6oPwlzz_Uecar_ezLC9Gvg&oe=69F355CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCG7L5DuFMsQ7kNvwEQhRqI&_nc_oc=AdoAAZxehqOsslmLKwd_Q4png_gE6exvGZ2_SMu02txOZpXhNhIlcN6x5-XkhMmZcj8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QXAtPImwSC3tHEpX9248zTZ6dyHif7MN7951WM2UAwA&oe=69F365AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbXmyaVTM6EQ7kNvwGUQSGG&_nc_oc=AdpVxnoxK5Hi_j4INFID0ZjqsojAMuyIZb09cxbxtYQDyCLiDvAKz63OWRSfIe3WFQM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PjtoOGTSVCN1jrjkp7_hmnUz9Xz6O71Yz7Tlf5PAOjw&oe=69F34902"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRr4lpdiuLcQ7kNvwF1r1s6&_nc_oc=AdqfUj8GajnCbiUh3cD643WQi2_acodX2vvr-1K6awKQaijXapQxtXP3CvFhHXwbfIY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19m0SBvOVZTA1xnvSv6pJHR0tBuagKVcDMQsbZIKxoJg&oe=69F353EF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
1940983", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY30njzthBEQ7kNvwE-c9ZF&_nc_oc=AdpCARlOQjc_CN7NBjL9zXvlTkv1N6ipDjgqSGEdARNRuhQ3SbLHjwKl4CaoWxIySx0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhfjzkenaE4wPh7VEe1PtOOiL7nAi0mhV3R2V3750RFw&oe=6A53A040"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmJNyYyc2jAQ7kNvwHey5cT&_nc_oc=AdrU9tX3EK3dUP1aJrOtOdt3i1-4EVGUeIjziS0i5sJciD_e8I2Ibsilq_EhE3L1VO4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD95EaEyfNzQDcFDmcrRmzadrzS4FcsQx-v-MLUra9gpg&oe=6A53934D"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df5WRox7o1IQ7kNvwGvMApY&_nc_oc=AdrEC4OuMQRGwx_D4EaT0DUvNLou5AptEJCySpK95GI_Lluu-D0-4hlhclIZtNJhCXc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7IaHrdBmPB4Fj-gBcvPZzO6kKHMOKWmGlqjeLMlNweg&oe=6A53A32C"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxE7u2mTuoAQ7kNvwFIG9Xd&_nc_oc=AdpsekJbqBkOO-o614gYUE6jAbIZCvfKaRPiUKuff-vo-xv2oq2Gy1BtnspRk1RNe-k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQjn1fVi9XeFAFMwvs4URpD1a4-nZ0qFs7XdziqiBYnA&oe=6A538682"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8vKNiVDqUYQ7kNvwHP9KVS&_nc_oc=AdoCJShxowQqY5eNiZz3YdFMV9b8nQyff0IxTtlfaWOkZlC59IhFuolT_kxVBv9yw7I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3WqWnOfPh9JpejYHfKrKQ4yrEKsA6_DDZ4f-NBBb0JQ&oe=6A53916F"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
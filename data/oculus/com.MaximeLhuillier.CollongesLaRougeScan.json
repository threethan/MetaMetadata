1940983", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_5448030718607649_6845811233407644525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkAHLlIp4PIQ7kNvwEeKPAQ&_nc_oc=AdogTOj_BSDp83Py9HS9g0QCrts8ZFWBMI6eSAjisaS5DaTKMbHZtqnYPCrZ7bkzy6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_jxUgkdubyu_aoS97lwlVpb7u7NUd9eQfjTkZ_ivfkg&oe=6AB3DDC0"}, {"file_name": "Screenshot2.png", "id": "1096947547603539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_1096947550936872_6623262552815231899_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7zNC1byG1wQ7kNvwELkj9U&_nc_oc=Adpa0-T02-pqDovwIlPd2shulbkD0JvNLjbf8kcJDw6lgp5Kef1ExCiwa85NIPngdnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIznbzXaoyKo0FoDVi5llW-oa21-YDT7pYZ-2egSqotGw&oe=6AB3D0CD"}, {"file_name": "Screenshot3.png", "id": "492042612309514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86610702_492042615642847_8961521301303806226_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1niLP5ygu6IQ7kNvwEQx0i8&_nc_oc=AdqtFcD8zthI30rt3ox144QyiNkyYHsap0uZx1IKDXworlCfcLephi69zMOv6_2bbGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPhDb8suT3vg3mS42SoXRDs1dpxNxRZK5f-wv6r64Xsw&oe=6AB3E0AC"}, {"file_name": "Screenshot4.png", "id": "831736571156653", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035344_831736577823319_3749544078509164249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTGTS3zNASMQ7kNvwEPRfeT&_nc_oc=Adp8x5YcuOcqQxc4DOfWZ3xjeTcSHXbvSd0_pZiwY4_WdjiCnlo0gKZiBd2vOmk0-nQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJCFXfXJWXmZe8V7tLe2zcAiN64flo5Q7a7rWw_4aiNg&oe=6AB3C402"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1443952479413837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974677_1443952486080503_3476958366015208444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FttxYlL0pHsQ7kNvwH7G82M&_nc_oc=AdpwbtRTiqJkqWNLYLWaHq6Sqt9v3uNYIo_Sh3VrWglhCynacuCn4iLtfja-t5SNXFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHk1AyYh_sztTWpcXTKaUN2O1GftiwMCzDhK6pvdhB2w&oe=6AB3CEEF"}, "display_name": "3D scan of Collonges-la-Rouge", "keywords": [], "long_description": "Move like a pedestrian in Collonges-la-Rouge, reconstructed from videos taken by two head-held 360 cameras (Gopro Max), whose trajectory is about 1.6km long.\n\nRight controller:\n- Rotate on the left or right by using the joystick\n- Update the vertical offset (up or down) by using the joystick\n- Choose a location and teleport to it by using the virtual laser pointer\n- Teleport by using the index trigger only if the laser is green (not red)\n\nLeft controller:\n- Move continuously by using the joystick\n- Switch pannel and map by using the grip/hand trigger\n- If both map and pannel are disabled, switch between rendering modes (texturing or normal colors) by pressing the index trigger\n- The map shows the cloud of mesh vertices and the user location\n- If the pannel is enabled, switch between constrained and unconstrained motions by pressing the index trigger\n- The constrained motion controls your height above the ground\n- The pannel shows information about the 3D model and the selected motion.\n", "short_description": "Move continuously like a pedestrian in a medieval town, which was computed by photogrammetry from cubemap videos (4096x1344x2) taken by two head-held 360 cameras (Gopro Max) and by walking about 1.6km in Collonges-la-Rouge (in France).\n"}]}, "developer_name": "Maxime Lhuillier", "developer_privacy_policy_url": "https://maximelhuillier.fr/", "developer_terms_of_service_url": null, "publisher_name": "Unity 2019.4", "support_website_url": "http://maxime.lhuillier.free.fr/", "website_url": "https://maximelhuillier.fr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
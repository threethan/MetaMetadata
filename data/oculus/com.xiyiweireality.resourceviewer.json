Jxsm&_nc_oc=AdqvrI5WwxsGs2MRGLB58qLM702_clLtDj1IhnQoqBDAw3VuNs3VqsTFkVWm9NoeWpM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL2tkgbUaxjTbRB2bbIP3bFMzhJxpPOK2e4fC4UCLYOw&oe=6A7B11AB"}, {"file_name": "\u8be6\u60c5\u56fe03.png", "id": "3560246840938186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822495_3560246844271519_8847290957328570794_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yeP56unCEcQ7kNvwGuo3Me&_nc_oc=Adr8WSFnnwuaoeBwoaSHJcOPZ2QAROGsjiCKtrLRJouhwbokoCeOzUxw1poUGx0pgGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzVybLKPJ8J3Sk-2gWydjAFSyMQxLDv2BhnghSdYDefQ&oe=6A7B1C0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20250616-170959.png", "id": "1246807313637747", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823968_1246807316971080_1616604732486704246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGV_jYECU2EQ7kNvwH1kvx-&_nc_oc=Adqzox2K1VwSiqc7EFLtUs6GICVnc4SV-nCw5xcO30O3nk2uXvgTu5IxzVU2yALV6SQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5vgosGVzZRbE08mzXXOmHg0p8ux4CFskYs75wYwFiPg&oe=6A7B35D2"}, "display_name": "XR-PPT Player", "keywords": ["XR", "PPT", "Player", "Model", "Tools"], "long_description": "The XR-PPT Player as the dedicated VR headset client of the XR Resource Collaboration Platform, offers powerful features for a rich and convenient resource viewing experience. \n\nUsers can easily browse various resources on the platform, including VR courseware, images in multiple formats, PPT presentations, stunning panoramic images, realistic panoramic videos, and detailed 3D models. The platform supports one-click import and secondary editing of Office and WPS files. It supports model import and zero-code editing.\nFor 3D models, the XR-PPT Player provides a range of useful operations. Users can flexibly scale models to examine details from different distances, rotate them for a complete view, and perform cross-sectional displays to analyze internal structures. The player also supports animated demonstrations of model principles, as well as features like explosion separation and perspective hiding, meeting diverse exploration and presentation needs in various scenarios.", "short_description": "XR-PPT Player is the VR headset client of XR Resource Collaboration Platform, allowing users to view various resources from the platform within the VR headset."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xiyiweireality.com/platform-privacy-policy-english.html", "developer_terms_of_service_url": null, "publisher_name": "Meta Quest Store", "support_website_url": null, "website_url": "https://xiyiweireality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31305626989036690"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1798933744235605"}]}, "baseline_offer": {"id": "1798933744235605"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750644540, "status": "PUBLISHED", "id": "1798933744235605"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "31322701227329266", "version": "0.7"}, "id": "2061480557608272", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bin
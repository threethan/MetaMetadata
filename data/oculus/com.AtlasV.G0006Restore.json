15113899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlv82BSAKfYQ7kNvwHeXRCP&_nc_oc=Adr6-N5EGYBPprc1ZxX-X8CUjz6lQaQ7qx6azgYL7p8nL9bl5eUvwCBk9_tr4Kvf1z4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2PZsdvcsPU39YEikPQRU3eGL4iUmt7goxTdXYSMms6LQ&oe=69F373D6"}, {"file_name": "Screenshot 2026-02-23 at 14.14.23.png", "id": "1448071566947607", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_1448071576947606_1165474880291214002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfQ0hRtmz7QQ7kNvwE_rCzO&_nc_oc=AdoVt3L-3MiusxlQ4TkLL7SqC2B1KKT19GOLJ_AkKzJpPq8HchCRyXGW9x09PsmIAS4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af270bt9b5UyRK5-i_Qs2eBdLzn4TrfVeGgA_Z9r7RWzJw&oe=69F35F20"}, {"file_name": "Screenshot 2026-02-23 at 14.13.31.png", "id": "2259097167946285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823790_2259097174612951_8018597952037061695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXTLM14De3EQ7kNvwFBN6Em&_nc_oc=AdrP2Pyz2qjoDLrq8oN1vuattCbjM4byTrmoRWhbli-8DLHxMiSSV5dwhKn4gyFMzcM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SMa6bWF9GtHiDUSsGQ_DuP6G4bwVmBu83r3_MKIMcyQ&oe=69F34D4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shine & Steel", "keywords": ["job", "simulator", "weapons", "workshop", "clean"], "long_description": "In this crafting experience, you step into the role of a weaponsmith. Clean & Restore forgotten weapons before selling them to customers! \n\n# \ud83d\udde1\ufe0f RESTORE FORGOTTEN WEAPONS TO THEIR PRIME \ud83d\udde1\ufe0f\nFind the correct tool and weapon part to do your job! \n - Chip off the rust \ud83d\udd28\n{1233957612179784} \n- Scrub away corrosion \ud83e\uddfd \n {953596590566990}\n- Wash away dirt \ud83e\udea3\n {4343525485901896} \n- Polish steel until it reflects the light!\u2728\n{3498929596929679}\n {1459084948964156}\n\nYour task is simple: give these weapons a second life.\n\n# \ud83d\udee0\ufe0f REASSEMBLE EVERY PART WITH SATISFYING PRECISION \ud83d\udee0\ufe0f\nCarefully reassemble weapons parts, and sell them to the mysterious customers.\n\nA cozy game with no pressure, just hands-on blacksmith experience focused on care, precision, and craftsmanship.\n\n{1246492230179385}\n{2201857980556663}", "short_description": "Clean and restore curious forgotten weapons in your own medieval workshop. Clean away rust, reassemble parts, and sell them to customers!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mVuDdW_4rgq23xd2injdFz9Y-R6LheSqWOaWxUtT8h8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868855302811725"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827567_1069287288745498_9189124402081386867_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vt9OtwHn5kQ7kNvwGhf5AN&_nc_oc=AdqPhOdGeJDTViGiKjBqADu4023-SyCICscdBTjtPykZEFWP6t6smusFlR3LwDw-ebo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af01iM3JK4uSCycsF8PinQr9xvhOLsV013204xLsqP8nBQ&oe=69F34AB2"}, "is_concept": false, "is_test
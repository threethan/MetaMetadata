3341_26179559311732180_8780996787791990444_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEcajWj1KHwQ7kNvwGciYb4&_nc_oc=AdqzLgNvhc55-oviJyZIsOMXwlRz3p5qH-uJyNpEcQW0d5tu7q63srMiBY1xA0Qvm94&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-fdImacoGITelRQKDE4HU8Tm-yZDiTvGmfDkRtYSnjg&oe=69C51533"}, {"file_name": "Screenshot 2026-02-23 at 14.12.30.png", "id": "1824994334808808", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823905_1824994338142141_955616485615113899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlhe25uJO0YQ7kNvwEA7QCX&_nc_oc=AdohCa8l4DZgcn-e-XVf5qt8qttIxX7yi7tH0IJWjpamB7Id7gcBa2F2X3Hyawmh3zk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlkOzKfg9NSkKc_AbFrrk68-Tja6esD27dVgCoOPDhqg&oe=69C51716"}, {"file_name": "Screenshot 2026-02-23 at 14.14.23.png", "id": "1448071566947607", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_1448071576947606_1165474880291214002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2HGr7SeEsMQ7kNvwEsq7nQ&_nc_oc=AdpIq5M6TZwN_lQDqcCag5fbV3ClOfdiwbLTV9XkDTQgO1OSZWVD99InVawR3j3xaSw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyc4bWO4PMwW_9Nhmds2Uv5du-JWrheF8JkfxUiwXCoHg&oe=69C53AA0"}, {"file_name": "Screenshot 2026-02-23 at 14.13.31.png", "id": "2259097167946285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823790_2259097174612951_8018597952037061695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItAZrsAss0wQ7kNvwE_h40P&_nc_oc=AdpauOPl8JNoj8wIxEN6Ji8kKz_sGJJxboOBRIc9LWLopBADRAKSCIcdUeLwWQzlW6g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqjjMf-t3f-_zT8-bZLRUTkehwshHlV9TNGFZJGi_PRg&oe=69C528CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shine & Steel", "keywords": ["job", "simulator", "weapons", "workshop", "clean"], "long_description": "In this crafting experience, you step into the role of a weaponsmith. Clean & Restore forgotten weapons before selling them to customers! \n\n# \ud83d\udde1\ufe0f RESTORE FORGOTTEN WEAPONS TO THEIR PRIME \ud83d\udde1\ufe0f\nFind the correct tool and weapon part to do your job! \n - Chip off the rust \ud83d\udd28\n{1233957612179784} \n- Scrub away corrosion \ud83e\uddfd \n {953596590566990}\n- Wash away dirt \ud83e\udea3\n {4343525485901896} \n- Polish steel until it reflects the light!\u2728\n{3498929596929679}\n {1459084948964156}\n\nYour task is simple: give these weapons a second life.\n\n# \ud83d\udee0\ufe0f REASSEMBLE EVERY PART WITH SATISFYING PRECISION \ud83d\udee0\ufe0f\nCarefully reassemble weapons parts, and sell them to the mysterious customers.\n\nA cozy game with no pressure, just hands-on blacksmith experience focused on care, precision, and craftsmanship.\n\n{1246492230179385}\n{2201857980556663}", "short_description": "Clean and restore curious forgotten weapons in your own medieval workshop. Clean away rust, reassemble parts, and sell them to customers!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mVuDdW_4rgq23xd2injdFz9Y-R6LheSqWOaWxUtT8h8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "238688
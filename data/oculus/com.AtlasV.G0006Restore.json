hot 2026-02-23 at 14.13.06.png", "id": "26179559298398848", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_26179559311732180_8780996787791990444_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lomfMMEzdYQ7kNvwGW-FyB&_nc_oc=AdqGlIebHN4G6f8Nc0vtEdfMEnzzH0t78mqJtMJVSMOMkZ4Y7v2iYsAKd4XYFSkdtYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBGWWbh-rx8163a4Luqr4rPyKnwg80lZwnYRY0Xj0OBg&oe=69CE4FB3"}, {"file_name": "Screenshot 2026-02-23 at 14.12.30.png", "id": "1824994334808808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823905_1824994338142141_955616485615113899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0ArMWg0ub4Q7kNvwEkuhlO&_nc_oc=AdqN6iAm_8vAM3kuiLJl2ga0NWXRRVKXFMT3EInxr0Ws0Tb8azHUeVm6dAJmD0AqDC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyuacTq1fqc4DqL7UqhrzdqtMq3b6HP3AC52oozsZgxHg&oe=69CE5196"}, {"file_name": "Screenshot 2026-02-23 at 14.14.23.png", "id": "1448071566947607", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819845_1448071576947606_1165474880291214002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeBRgGgmd-QQ7kNvwFLYPPZ&_nc_oc=AdrrWAeXLH7ynnBzvUhNFYuV4YlwXseWMaottL09fnKb4UybKHTwv8suoPrzMrla4bo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy80SQvzEzwgKaaY1y3VEr7CT9eLID0gNrFM7u81N_KKQ&oe=69CE7520"}, {"file_name": "Screenshot 2026-02-23 at 14.13.31.png", "id": "2259097167946285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823790_2259097174612951_8018597952037061695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8xD8hMBhakQ7kNvwFSl5EQ&_nc_oc=AdqUjXU_mOF0RwEGqfaQq52Uyd2TFUQpOa9uEWGn_hKdc2VmNV6IC_cnyKeuMnh9ixc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxR9Ww2vIIRn_19kPM9QlyI6_NO6Q-bBqprpSLY78PbvA&oe=69CE634A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shine & Steel", "keywords": ["job", "simulator", "weapons", "workshop", "clean"], "long_description": "In this crafting experience, you step into the role of a weaponsmith. Clean & Restore forgotten weapons before selling them to customers! \n\n# \ud83d\udde1\ufe0f RESTORE FORGOTTEN WEAPONS TO THEIR PRIME \ud83d\udde1\ufe0f\nFind the correct tool and weapon part to do your job! \n - Chip off the rust \ud83d\udd28\n{1233957612179784} \n- Scrub away corrosion \ud83e\uddfd \n {953596590566990}\n- Wash away dirt \ud83e\udea3\n {4343525485901896} \n- Polish steel until it reflects the light!\u2728\n{3498929596929679}\n {1459084948964156}\n\nYour task is simple: give these weapons a second life.\n\n# \ud83d\udee0\ufe0f REASSEMBLE EVERY PART WITH SATISFYING PRECISION \ud83d\udee0\ufe0f\nCarefully reassemble weapons parts, and sell them to the mysterious customers.\n\nA cozy game with no pressure, just hands-on blacksmith experience focused on care, precision, and craftsmanship.\n\n{1246492230179385}\n{2201857980556663}", "short_description": "Clean and restore curious forgotten weapons in your own medieval workshop. Clean away rust, reassemble parts, and sell them to customers!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mVuDdW_4rgq23xd2injdFz9Y-R6LheSqWOaWxUtT8h8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_pla
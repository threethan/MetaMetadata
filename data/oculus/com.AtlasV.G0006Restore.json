15113899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCLKPtgJe5kQ7kNvwG8JIM3&_nc_oc=AdoYJvWT5mWU3AfK-tVju0f6F31oGhg_IMJOkYY8-wppYA1Is54NF3FF01totnY0kQI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Xq1VAFLTCDwn6nNuJFVnegPNDvlyKhBtlFK04Fn3iCg&oe=69F616D6"}, {"file_name": "Screenshot 2026-02-23 at 14.14.23.png", "id": "1448071566947607", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819845_1448071576947606_1165474880291214002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NqvHEFcL8MQ7kNvwEqt9I1&_nc_oc=Adq_z6f7VvzcDvY0Gvgq_58dfS4GqM-oiyGppjJsuzYvqrY2uoAI88rWRUAmINuhfiY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2BYWshHYwQ-QMKzTWVlUhfJ78xdk1xjUdmrEzHyk53gA&oe=69F60220"}, {"file_name": "Screenshot 2026-02-23 at 14.13.31.png", "id": "2259097167946285", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823790_2259097174612951_8018597952037061695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXTLM14De3EQ7kNvwEYmQg_&_nc_oc=AdpA9AIVkJhqL5is6fFiIrh_rmhHaRN5dHr7lc5NGX-shW5mrllUkHHUFiyKHFj7fQY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nWw_I5WkyVoKb9bBsPjLHzBY1-mW1rTmssGYkZMGurA&oe=69F5F04A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shine & Steel", "keywords": ["job", "simulator", "weapons", "workshop", "clean"], "long_description": "In this crafting experience, you step into the role of a weaponsmith. Clean & Restore forgotten weapons before selling them to customers! \n\n# \ud83d\udde1\ufe0f RESTORE FORGOTTEN WEAPONS TO THEIR PRIME \ud83d\udde1\ufe0f\nFind the correct tool and weapon part to do your job! \n - Chip off the rust \ud83d\udd28\n{1233957612179784} \n- Scrub away corrosion \ud83e\uddfd \n {953596590566990}\n- Wash away dirt \ud83e\udea3\n {4343525485901896} \n- Polish steel until it reflects the light!\u2728\n{3498929596929679}\n {1459084948964156}\n\nYour task is simple: give these weapons a second life.\n\n# \ud83d\udee0\ufe0f REASSEMBLE EVERY PART WITH SATISFYING PRECISION \ud83d\udee0\ufe0f\nCarefully reassemble weapons parts, and sell them to the mysterious customers.\n\nA cozy game with no pressure, just hands-on blacksmith experience focused on care, precision, and craftsmanship.\n\n{1246492230179385}\n{2201857980556663}", "short_description": "Clean and restore curious forgotten weapons in your own medieval workshop. Clean away rust, reassemble parts, and sell them to customers!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mVuDdW_4rgq23xd2injdFz9Y-R6LheSqWOaWxUtT8h8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868855302811725"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827567_1069287288745498_9189124402081386867_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvwTZtBQR4IQ7kNvwFc3x9Q&_nc_oc=AdreTubxuxcAE-gc7FeibsMQhLZzni30i7YHKmZXa03bbEEZf1aw02DYzZljZRrdJCY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1R_mU29Ivzy_LHGkWoGHZvvxvUIMTRwCMIr_VbPJrpYQ&oe=69F5EDB2"}, "is_concept": false, "is_test
sid=6e7a0a&_nc_ohc=xlv82BSAKfYQ7kNvwHVvZGL&_nc_oc=AdpcPdriIgvzTCFF2QrWNqwUIUffldnSM6WOYBUM_-oXXFLsnruIphI4twXGfgjH1Kc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dk31hYTVpteVikIbi1FhqY0_SGNZ5Hfmii4rNaq_zhA&oe=69F1EA16"}, {"file_name": "Screenshot 2026-02-23 at 14.14.23.png", "id": "1448071566947607", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819845_1448071576947606_1165474880291214002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfQ0hRtmz7QQ7kNvwFy5G22&_nc_oc=AdouRW4bqYiSzklwyc_SB1Gb6iV-DXgVP4jH-8bhehV-iQT4-w2v4Fy19qgJ7LCckwY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TWS1uZZ5t6wx3lICa-H3wVXjCk6LJ3QAUDtI1kIWOjA&oe=69F20DA0"}, {"file_name": "Screenshot 2026-02-23 at 14.13.31.png", "id": "2259097167946285", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823790_2259097174612951_8018597952037061695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQEDTqu2KxgQ7kNvwFAqNAb&_nc_oc=Adq2LZ869IwNQ8v2IGS_XfQkIcs84FN_uDg042N6Y3v3SmS7g3kXs2Io8iQxHig2zok&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vuAO6oyQcnnBY6j2nGdh6GRtIAfiwccJKbEtf8f3B2A&oe=69F1FBCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shine & Steel", "keywords": ["job", "simulator", "weapons", "workshop", "clean"], "long_description": "In this crafting experience, you step into the role of a weaponsmith. Clean & Restore forgotten weapons before selling them to customers! \n\n# \ud83d\udde1\ufe0f RESTORE FORGOTTEN WEAPONS TO THEIR PRIME \ud83d\udde1\ufe0f\nFind the correct tool and weapon part to do your job! \n - Chip off the rust \ud83d\udd28\n{1233957612179784} \n- Scrub away corrosion \ud83e\uddfd \n {953596590566990}\n- Wash away dirt \ud83e\udea3\n {4343525485901896} \n- Polish steel until it reflects the light!\u2728\n{3498929596929679}\n {1459084948964156}\n\nYour task is simple: give these weapons a second life.\n\n# \ud83d\udee0\ufe0f REASSEMBLE EVERY PART WITH SATISFYING PRECISION \ud83d\udee0\ufe0f\nCarefully reassemble weapons parts, and sell them to the mysterious customers.\n\nA cozy game with no pressure, just hands-on blacksmith experience focused on care, precision, and craftsmanship.\n\n{1246492230179385}\n{2201857980556663}", "short_description": "Clean and restore curious forgotten weapons in your own medieval workshop. Clean away rust, reassemble parts, and sell them to customers!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mVuDdW_4rgq23xd2injdFz9Y-R6LheSqWOaWxUtT8h8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23868855302811725"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827567_1069287288745498_9189124402081386867_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vt9OtwHn5kQ7kNvwEmR8Sj&_nc_oc=Adoo9N3eD2895GTZ1H3fXWUDy0XnHu8Qm91OKyrgp4Cwdq-36eWEm272TsItZ9jCE08&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Cf2nMeAD4e0X9a_lbNYou55qBZ5QOoWTdq8Bb_tHnNA&oe=69F1F932"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
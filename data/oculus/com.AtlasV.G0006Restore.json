-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SEAmRscBvTGDvJaLXXh_HkdSkL1cCzzVohG1_CWPkDQ&oe=6A468A84"}, {"file_name": "Screenshot 2026-02-23 at 14.13.06.png", "id": "26179559298398848", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823341_26179559311732180_8780996787791990444_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVQP6zfvA8gQ7kNvwFJD-rQ&_nc_oc=AdopjeKcufq63B4W0xjqc2yaBEyIMKEGCCT4OkX9n79NaSjCsmTbUHv_E5kr00Teoto&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_beJMTdEDF9t5s2HunehfTjk-zlRu8XjrszZT1_LoW3w&oe=6A468073"}, {"file_name": "Screenshot 2026-02-23 at 14.12.30.png", "id": "1824994334808808", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823905_1824994338142141_955616485615113899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND9Q4ajokWYQ7kNvwGo5Zwg&_nc_oc=AdrUN-ZgGtfLu013l9Mlo21trsOJLH_0qQAANKT0APQOlKVLWs7qp0jGONfZ1JymmxY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EfmgrCUtmM7kLw1pcKpAcdi0XXIEeiWFaBhLpCKA3RA&oe=6A468256"}, {"file_name": "Screenshot 2026-02-23 at 14.14.23.png", "id": "1448071566947607", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819845_1448071576947606_1165474880291214002_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUqo8THeU-QQ7kNvwER6ZKb&_nc_oc=Adrgo34FhiJ5RIxWprS339t66EsnZgCJ-JvaAJljus4l2AU87TGQjC_tU7ycNSgj_nc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--2At8Pwoh4fqkYVz9XONPvZpG4-yNcyKLJBOsRAASnA&oe=6A466DA0"}, {"file_name": "Screenshot 2026-02-23 at 14.13.31.png", "id": "2259097167946285", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823790_2259097174612951_8018597952037061695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogqNA75--A8Q7kNvwHbLjhO&_nc_oc=AdrYhYXfYrIoODtV_pnHHXfe1aeRgjnOvAInr2GQdwj3qH8nNJ-SuUFgpOCbUxqfyW8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DOhQHbGpkfky2RSHUhdUoagFfR95x_im6IRMK-FrqdA&oe=6A465BCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shine & Steel", "keywords": ["job", "simulator", "weapons", "workshop", "clean"], "long_description": "In this crafting experience, you step into the role of a weaponsmith. Clean & Restore forgotten weapons before selling them to customers! \n\n# \ud83d\udde1\ufe0f RESTORE FORGOTTEN WEAPONS TO THEIR PRIME \ud83d\udde1\ufe0f\nFind the correct tool and weapon part to do your job! \n - Chip off the rust \ud83d\udd28\n{1233957612179784} \n- Scrub away corrosion \ud83e\uddfd \n {953596590566990}\n- Wash away dirt \ud83e\udea3\n {4343525485901896} \n- Polish steel until it reflects the light!\u2728\n{3498929596929679}\n {1459084948964156}\n\nYour task is simple: give these weapons a second life.\n\n# \ud83d\udee0\ufe0f REASSEMBLE EVERY PART WITH SATISFYING PRECISION \ud83d\udee0\ufe0f\nCarefully reassemble weapons parts, and sell them to the mysterious customers.\n\nA cozy game with no pressure, just hands-on blacksmith experience focused on care, precision, and craftsmanship.\n\n{1246492230179385}\n{2201857980556663}", "short_description": "Clean and restore curious forgotten weapons in your own medieval workshop. Clean away rust, reassemble parts, and sell them to customers!"}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1mVuDdW_4rgq23xd2injdFz9Y-R6LheSqWOaWxUtT8h8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Atlas", "support_website_url": null, "website_url": "https://atlasv.io/Studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
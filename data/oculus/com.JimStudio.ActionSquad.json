Ng&oe=6A92AF4C"}, {"file_name": "8\u670810\u65e5(7).png", "id": "1631482308651018", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499314641_1631482311984351_8544314464857798539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3sEoYGCp-MQ7kNvwEG40y2&_nc_oc=AdrRQQ2jh1x-W6wR3c9LtvdbUA1yYotBlG4teH-UjTGyW08QS6qsy0QOrdvvQRrFGVY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR_SvbKOqvPyss_Vbc3S77YEVPzPy4RgObAfEIrr2wUA&oe=6A92D199"}, {"file_name": "8\u670810\u65e5(9).png", "id": "1776838640137540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314641_1776838643470873_1414452308844373948_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gscZyULg7ZcQ7kNvwE1-ne1&_nc_oc=Ado7sEcnvlGcBoTCqM_Ln6APzMZ6pDOPOS6i36fPAscBpRNGoPRBD-RICydm8lBhDaQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPWVoJXUmJ9po7I2cN8HvTM1CRPWpJAFBSlnEE6dw6qA&oe=6A92DC82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Action Squad", "keywords": ["TacticalShooter", "VRShooter", "SquadCombat", "Zombie", "SinglePlayer"], "long_description": "Lead a three-person tactical unit through intense standalone VR combat.\n\nTake on multiple missions across varied combat environments. Some operations place you and two AI teammates against armed enemy squads in tactical Search & Kill firefights. Enemies move through the environment, use cover, change positions, and return fire as each battle develops.\n\nOther operations throw your squad into dangerous zombie outbreaks. Push through infected areas, survive relentless attackers, recover critical supplies, complete mission objectives, and reach extraction. Different zombie types can pursue, surround, and ambush the squad, turning every encounter into a close-range fight for survival.\n\nYou are not fighting alone. Direct your AI teammates to tactical positions, order door breaches, call them back to guard you, or release them to find and engage nearby threats. Gesture-based squad commands let you control the battlefield while remaining inside the action.\n\nFEATURES\n\n\u2022 Multiple tactical missions across varied environments\n\u2022 Search & Kill gunfights against armed enemy squads\n\u2022 Zombie operations with pursuit, surrounding, and ambush behavior\n\u2022 Enemies that move, use cover, and fire back\n\u2022 Two teammates that move, fight, protect, and follow commands\n\u2022 Easy, Normal, and Elite difficulty settings\n\u2022 Guided training for movement, shooting, and squad control\n\u2022 Mission objectives, results, and extraction sequences\n\u2022 Eight interface languages\n\u2022 Single-player gameplay with no login, advertis", "short_description": "Lead two squadmates through varied standalone VR combat missions. Exchange fire with armed enemy units across dangerous tactical environments, then face relentless zombie outbreaks where threats can close in from every direction. Use gesture-based commands, fight through cover-based battles, complete critical objectives, recover valuable supplies, and survive extraction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zp1412042552-hue.github.io/Action-squad-Website/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "ZP Games", "support_website_url": null, "website_url": "https://zp1412042552-hue.github.io/Action-squad-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "fr", "pt", "ko", "ru", "ja"], "supported_input_devices": ["HAND_TRACKING"], "suppor
qHGrA7XjnJGBKfoCkr2Ti9voompe69nvu1g&oe=6ACE3D98"}, {"file_name": "Screenshot3.png", "id": "1146679904183264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312439_1146679907516597_3426759687046381818_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW3iGnlS3dQQ7kNvwEHThZI&_nc_oc=Adp-o6x-w3y425wkl7Wecjk3WC34XNC-OTE8n2vjvC9KFVwqlxHWXtrzrIt9j1P4x5U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0LmW3g_yzlgrbHsJtTgLpTv0qvCStstVno-ZBS9XvQQ&oe=6ACE656F"}, {"file_name": "Screenshot4.png", "id": "792943366598407", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823447_792943369931740_7593037484784078308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCpqaz1vxFcQ7kNvwFt8yKC&_nc_oc=Ado4XxZscwKzsUH-qBsemyD9mN77y0JkG8XEP4rlsJMpFPi6MP0j0Uc9c4855_6BrfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKZSmrHooHn-GzINr909Yp-VgVtpIhPW02vaBgaIvXrg&oe=6ACE5C69"}, {"file_name": "Screenshot5.png", "id": "1538161670886004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311606_1538161674219337_6724602108764558798_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85tJUnJYYRwQ7kNvwE53Dlq&_nc_oc=AdrjfwAUHSh7Os4QMjOGkmAaoK5-mtOmbSZPMAnxBpMrleaJm_V3nzR7ml-7pJ7I-2Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ6df2sFJkQQpVCEW-NocpMW5VkoluIxnoAWjOI-C5zw&oe=6ACE55B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkillupVR BraveSteps", "keywords": [], "long_description": "SkillupVR BraveSteps is a training tool designed to help teenagers practice social interaction, communication, and self-regulation in a safe and supportive virtual environment.\n\nThe app places the user inside a realistic classroom where they interact with AI-driven teachers and students. Through guided scenarios, players learn how to:\n\n- Stay focused and avoid interrupting\n- Take turns in conversations and group discussions\n- Be supportive and engaged when talking to others\n- Improve timing and cooperation in group activities\n\nIn addition to the social scenarios, the app includes breathing exercises to help users calm down, manage stress, and regain focus.\n\nThe goal is to make learning social skills engaging, practical, and accessible through VR.\n\nSkillupVR BraveSteps provides a safe space to practice and build confidence in everyday social situations.", "short_description": "Practice social skills and coping strategies in VR through interactive classroom scenarios."}]}, "developer_name": "Simlogic", "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Simlogic", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nb", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28066778073021340"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_3615325875296944_8297520483625478480_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtx5Flbg1msQ7kNvwHWw6mZ&_nc_oc=AdqGqeslXVaX9VYnp3SK0dKzQhZWdHmHE6FFQBPKW_0GdR4HYa9eBR6b-pAWkwJT4EU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNgw4fB4VyaVfbqM7DKY1ny5v5SYJHYr3BYGX-OtxtIg&oe=6ACE4FD2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkillupVR BraveSteps", "platform": 
-34mxxJZQHk6NW_QqkAVStanjIdqJqvkRoMQ5nH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM73U7o6GOcmXoDMHRihAIiN1suNime4MAUhHEoYDG8Rw&oe=6ACA7A4C"}, {"file_name": "Screenshot2.png", "id": "1322651299578617", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312369_1322651302911950_5837053467093847017_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFS_guv_g_EQ7kNvwGxj6eA&_nc_oc=AdpLQj6PJmelqVGopnRTocV2ViPwGbz7QQZv9swzptaHbYWoDu2XOgppCkssQ5Y9Dog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOCFR3pQ7atlorNHzinkxYZSypcpj9PVM7cuUhGAt66w&oe=6ACA4918"}, {"file_name": "Screenshot3.png", "id": "1146679904183264", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312439_1146679907516597_3426759687046381818_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxNOd7ss4DgQ7kNvwF-X70B&_nc_oc=Adq6zK3yxD9ZLW4Uw9DyllOW084GXTYUABIOIW_nymufKhEaLcJ93Fcmqlczkj6sPWQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsNNRww1ArIKyr0fsM5IaNV2UDpiAxENZhnKKKpmUGlg&oe=6ACA70EF"}, {"file_name": "Screenshot4.png", "id": "792943366598407", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823447_792943369931740_7593037484784078308_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh1wjITCnBcQ7kNvwEkmhum&_nc_oc=AdoaZcmdPsvWHfA92n2JomTxh7dJ3YukfigGUTiBiiQFkgdn-mLq84T8Quk9zv6t75Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx9-qFkGxCwnVus-3KFT_gMZVAsxUDqROXmVP10n8Qgg&oe=6ACA67E9"}, {"file_name": "Screenshot5.png", "id": "1538161670886004", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311606_1538161674219337_6724602108764558798_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWkT6MiYpoMQ7kNvwFwcTBG&_nc_oc=AdoADfV2e6BWXUccBxw130D5QkC5QWuiJ1oXNj06Uph3E7hZ8Sk8na1a8-mOCEIZHXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQtjRGjt9boWqSNK90djMp9wYE-Zp41EvXO_CTV8AikA&oe=6ACA6137"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkillupVR BraveSteps", "keywords": [], "long_description": "SkillupVR BraveSteps is a training tool designed to help teenagers practice social interaction, communication, and self-regulation in a safe and supportive virtual environment.\n\nThe app places the user inside a realistic classroom where they interact with AI-driven teachers and students. Through guided scenarios, players learn how to:\n\n- Stay focused and avoid interrupting\n- Take turns in conversations and group discussions\n- Be supportive and engaged when talking to others\n- Improve timing and cooperation in group activities\n\nIn addition to the social scenarios, the app includes breathing exercises to help users calm down, manage stress, and regain focus.\n\nThe goal is to make learning social skills engaging, practical, and accessible through VR.\n\nSkillupVR BraveSteps provides a safe space to practice and build confidence in everyday social situations.", "short_description": "Practice social skills and coping strategies in VR through interactive classroom scenarios."}]}, "developer_name": "Simlogic", "developer_privacy_policy_url": "https://skillupvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Simlogic", "support_website_url": null, "website_url": "https://skillupvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nb", "sv"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28066778073021340"}}]}, "scheduled_of
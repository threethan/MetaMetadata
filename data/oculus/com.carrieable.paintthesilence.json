ntent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThS52s43JCcKCxCDeBXQac4K4J2kbt4w-BuF9TjpEZtg&oe=6B05AB88"}, {"file_name": "Screenshot-02.png", "id": "1269483891962622", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618361_1269483898629288_7382255203866560456_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnspuoLsyLQQ7kNvwH9SUkJ&_nc_oc=Adq4_AhT6MxmiAnUcgYV6xH6uZBaEH7VH8DSoIse3IxtSXsMPse8mRzzpgfj8SnY3UA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXNltsOhpEqSXI49vJzLsnEUiGBnfwbn8fqMPZ5aoj1A&oe=6B05AB55"}, {"file_name": "Screenshot-07.png", "id": "1647769459661298", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618361_1647769462994631_744370303813461128_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knUaddwHbPgQ7kNvwElA4kx&_nc_oc=AdpQEcImGMV8zZHivakLB0CBUdLFmLFKC577KomZiHQVepyyEdKUmsKK15T2eni5eRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ44PxDUQoKWDRPXKQ-hXTCJqS21ej0bVjmzdJW39Row&oe=6B05D33E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Paint The Silence - A Visual Music Album", "keywords": ["music", "360", "videos", "immersive", "concert"], "long_description": "## \ud83c\udfa7 Your VR Music Library by Carrie Able\n\nStep into a new way of experiencing music. With Carrie Able, you can explore and watch immersive **VR music videos and performances**, placing you right at the center of the scene.\n\n---\n\n## \ud83c\udfa5 Immersive Content\n- 360\u00b0 music videos  \n- Engaging live performances  \n- Smooth and optimized VR playback  \n\n---\n\n## \ud83e\udded Simple & Intuitive Navigation\n- Browse content by title or artist  \n- Clean, easy-to-use interface  \n- Quick access to your favorite videos  \n\n---\n\n## \ud83d\ude80 Optimized for VR\n- Fast content loading  \n- Stable playback experience  \n- Designed specifically for VR headsets  \n\n---\n\n## \ud83c\udf0c Experience Music Differently\nThis isn\u2019t just listening \u2014 it\u2019s being there.  \nChoose a video, put on your headset, and dive into the world of music with Carrie Able.", "short_description": "Explore immersive VR music videos and performances with Carrie Able. Browse content, discover artists, and enjoy a smooth, engaging 360\u00b0 experience. Step inside the music and experience it like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://carrieable.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Carrie Able", "support_website_url": null, "website_url": "https://carrieable.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26791592300464040"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1775940010480727"}]}, "baseline_offer": {"id": "1775940010480727"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778160840, "status": "PUBLISHED", "id": "1775940010480727"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27551681237788472", "version": "1.0.7"}, "id": "2010685292862295", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26
uE1du4uUcNmRQYXg7VtP5KXsX6S6UYag5A&oe=6AFDB4C3"}, {"file_name": "MainlyMonkey_Custom..._21.01.2024_16-22-39.png", "id": "927472885760926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_927472889094259_4485504256925062201_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poo3P4IxvD8Q7kNvwGv8mjY&_nc_oc=AdrlLQTq87ORc3uGrNutLq0IQ8ANJt4vjriuFjVF_TFTihNFtK6mUNYtJaEi8Dcw10M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqunxsxKk-26NFntJQ0TGxQyL3p3qsA2Kltt9a5T3mZg&oe=6AFDC858"}, {"file_name": "MainlyMonkey_Custom..._21.01.2024_16-21-51.png", "id": "340420112245940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036645_340420115579273_1374225033426258262_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRaYPdTXznIQ7kNvwEo2Cs7&_nc_oc=AdpBhlif2QHXr0ct9sGd_dQhBLUX-uVURRdoxN-VQYMJh1RZcY8oEysXtmmBgxvX7kA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDul6HJYPuSo5OsRaUB-F2BVg364ibF475zknq-VYqDQ&oe=6AFDCEF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2.0.png", "id": "1389683758411792", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75655194_1389683761745125_2110150542568419035_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_OWSp7ycu0Q7kNvwHOv14h&_nc_oc=AdpHfn-LYAMEMJ0bChdyJkJe9M8fqyL748hYJE1bJCKYx4fjtoqncLDSQUX8uaEVubo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxvN5EtbbOmMQNtTRyZsuAEwpyI9rWiwP0HUVm9b_A-Q&oe=6AFDB578"}, "display_name": "MainlyMonkeys", "keywords": [], "long_description": "This is MainlyMonkeys, In this game using your hands are the key to play. Inside the game you have a option to play with others or with specific friend's. There are many maps to come, there is a boss fight to be seen sooner or later, There is P.V.P, Zero Gravity, Lil Place, Shop, and the MM EL. Here you can customize your character and even collect secretly hidden items and achievements. In the MM EL or as its told... Anyways the MM EL did create a few cool thing's. in Lil Place you turn small because of TROBITES which makes the map fun to play in. In Zero Gravity you have NG(nogravity) Which means once you enter you can fly, jump, or even hop around the ZeroG map. In P.V.P you are given boxing gloves to fight with.", "short_description": "In MainlyMonkeys you move with your hands and can explore the game and secrets that beholds in it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/5bf4d162-45a6-4486-af0c-d18a8d5f9272", "developer_terms_of_service_url": null, "publisher_name": "ARVTXR", "support_website_url": null, "website_url": "https://sites.google.com/view/mainlymonkeys-official-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7417609414958271"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "402178909041897"}]}, "baseline_offer": {"id": "402178909041897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706826840, "status": "PUBLISHED", "id": "402178909041897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7627670737285470", "version": "7.0"}, "id": "1217571809662402", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": 
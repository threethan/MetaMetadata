scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036645_340420115579273_1374225033426258262_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRHTIUv_24MQ7kNvwHI3PBM&_nc_oc=AdorSve11v3sNL4QLdh6UsNFF5hWDykXCZQHewt5UY4DW5qJoMf5fbmFNIzyjn1_Pwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmDYj_-iUb_85DKE0NY-Y8WFCZbr9Jh4Hrx7Lc2dBEXg&oe=6A64A8B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2.0.png", "id": "1389683758411792", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75655194_1389683761745125_2110150542568419035_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7YmroJSBu8Q7kNvwF_Apss&_nc_oc=Adp4PtGMOAQPghnN_m38nFJDFJN4SHr-p9ioi7METTOS2QB7C94s74-MYZwMxIH5nPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu81mP7O-TxEMIEu_BKsdrh6xnIv3VcjhEy6swsveEHQ&oe=6A64C778"}, "display_name": "MainlyMonkeys", "keywords": [], "long_description": "This is MainlyMonkeys, In this game using your hands are the key to play. Inside the game you have a option to play with others or with specific friend's. There are many maps to come, there is a boss fight to be seen sooner or later, There is P.V.P, Zero Gravity, Lil Place, Shop, and the MM EL. Here you can customize your character and even collect secretly hidden items and achievements. In the MM EL or as its told... Anyways the MM EL did create a few cool thing's. in Lil Place you turn small because of TROBITES which makes the map fun to play in. In Zero Gravity you have NG(nogravity) Which means once you enter you can fly, jump, or even hop around the ZeroG map. In P.V.P you are given boxing gloves to fight with.", "short_description": "In MainlyMonkeys you move with your hands and can explore the game and secrets that beholds in it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/5bf4d162-45a6-4486-af0c-d18a8d5f9272", "developer_terms_of_service_url": null, "publisher_name": "ARVTXR", "support_website_url"
0pVEybeoZevOxkL_-O9O2eabB5oa36oLjQ&oe=6B0B1C03"}, {"file_name": "MainlyMonkey_Custom..._21.01.2024_16-22-39.png", "id": "927472885760926", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031450_927472889094259_4485504256925062201_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez2yeaXwWKUQ7kNvwFMA0Vo&_nc_oc=Ado-Ed4TW64GsgLV_kJE9sOHUbHXW0pGhwh6JuxjndQ54ZxdyjqU_uRyeBjvhNuNfHg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTapxbdlfJKmbsCLJ98mHGc519xqCz9ZgYDmweoyRGC5g&oe=6B0B2F98"}, {"file_name": "MainlyMonkey_Custom..._21.01.2024_16-21-51.png", "id": "340420112245940", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036645_340420115579273_1374225033426258262_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJRv1827_F0Q7kNvwF2aEyS&_nc_oc=Adpy016gHToTzXttD46pxwp8KCYmrYyikKF_ZN0dLObG6ywRMAXw9YOtCjx0lYBFZ8I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUE0M4CD07V--RFkQmv95YfeLJQrqhfU87f59gvtmJAQ&oe=6B0B3637"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2.0.png", "id": "1389683758411792", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75655194_1389683761745125_2110150542568419035_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_I6qAu1ubTwQ7kNvwFsTKvF&_nc_oc=AdoFw1oTcQUdlj-6efqB0W1BGWhyN9LmA0ea-whIpeciEGjMiBb173laXDBMLBABWPk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuTmOMqkITllKCD2ucxqqkMvXA4shpZ7rS02L03ha5yA&oe=6B0B1CB8"}, "display_name": "MainlyMonkeys", "keywords": [], "long_description": "This is MainlyMonkeys, In this game using your hands are the key to play. Inside the game you have a option to play with others or with specific friend's. There are many maps to come, there is a boss fight to be seen sooner or later, There is P.V.P, Zero Gravity, Lil Place, Shop, and the MM EL. Here you can customize your character and even collect secretly hidden items and achievements. In the MM EL or as its told... Anyways the MM EL did create a few cool thing's. in Lil Place you turn small because of TROBITES which makes the map fun to play in. In Zero Gravity you have NG(nogravity) Which means once you enter you can fly, jump, or even hop around the ZeroG map. In P.V.P you are given boxing gloves to fight with.", "short_description": "In MainlyMonkeys you move with your hands and can explore the game and secrets that beholds in it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/5bf4d162-45a6-4486-af0c-d18a8d5f9272", "developer_terms_of_service_url": null, "publisher_name": "ARVTXR", "support_website_url": null, "website_url": "https://sites.google.com/view/mainlymonkeys-official-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7417609414958271"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "402178909041897"}]}, "baseline_offer": {"id": "402178909041897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706826840, "status": "PUBLISHED", "id": "402178909041897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7627670737285470", "version": "7.0"}, "id": "1217571809662402", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": 
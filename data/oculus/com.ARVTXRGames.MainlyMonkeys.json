aSJnXxDMss-ohiUoWJOPgc5wMXxjUN4lMA&oe=6B0DBF03"}, {"file_name": "MainlyMonkey_Custom..._21.01.2024_16-22-39.png", "id": "927472885760926", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031450_927472889094259_4485504256925062201_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xjKN995RngQ7kNvwGV8X_F&_nc_oc=AdqyFy46fsnCheLNspFzXT-buxm19b6L_5ksU6H8wDWB6ZW_HokObSUaBUcjPes6y20&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSykWhq2OYwPneVzplUaZAfGyM2iVT-MZKd00fZpTC4_A&oe=6B0D9A58"}, {"file_name": "MainlyMonkey_Custom..._21.01.2024_16-21-51.png", "id": "340420112245940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036645_340420115579273_1374225033426258262_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJRv1827_F0Q7kNvwE8BCDD&_nc_oc=Adox3rdjd_PMWc58V8k-6e8Ltrf9M_yE65Q5A_2f37r4iJLuw9PspqZDcRirVG4w5NI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTgAKlf5Tst-sb9Zo9Gd8kXCwGf9Ztnug5Mo3VNz4VWBw&oe=6B0DA0F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2.0.png", "id": "1389683758411792", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75655194_1389683761745125_2110150542568419035_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_bW81EmyBUQ7kNvwGNHvYS&_nc_oc=Adp4cAdStcR25Ivvs0p3nrBcjdUj8ZpHQFZN3lkurz2_u6pPWRMYOSkkUMmb2x66LRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8FNNleR8uQ9_atvQkN7uxB8dy8cQod5lV2Rz56Uw57w&oe=6B0DBFB8"}, "display_name": "MainlyMonkeys", "keywords": [], "long_description": "This is MainlyMonkeys, In this game using your hands are the key to play. Inside the game you have a option to play with others or with specific friend's. There are many maps to come, there is a boss fight to be seen sooner or later, There is P.V.P, Zero Gravity, Lil Place, Shop, and the MM EL. Here you can customize your character and even collect secretly hidden items and achievements. In the MM EL or as its told... Anyways the MM EL did create a few cool thing's. in Lil Place you turn small because of TROBITES which makes the map fun to play in. In Zero Gravity you have NG(nogravity) Which means once you enter you can fly, jump, or even hop around the ZeroG map. In P.V.P you are given boxing gloves to fight with.", "short_description": "In MainlyMonkeys you move with your hands and can explore the game and secrets that beholds in it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/5bf4d162-45a6-4486-af0c-d18a8d5f9272", "developer_terms_of_service_url": null, "publisher_name": "ARVTXR", "support_website_url": null, "website_url": "https://sites.google.com/view/mainlymonkeys-official-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7417609414958271"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "402178909041897"}]}, "baseline_offer": {"id": "402178909041897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706826840, "status": "PUBLISHED", "id": "402178909041897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7627670737285470", "version": "7.0"}, "id": "1217571809662402", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": 
_hB_xWheqVYoTunyJaUol5vypiW-AeTAgg&oe=6AFC6343"}, {"file_name": "MainlyMonkey_Custom..._21.01.2024_16-22-39.png", "id": "927472885760926", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031450_927472889094259_4485504256925062201_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poo3P4IxvD8Q7kNvwEeWR9z&_nc_oc=AdoY8Yy2Lo3S3m659UVTnvBn7rJTVAVm2tJGKYxot-tT1Lieivl4Ckac0Ogrfk841ro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRutUHh5PQbb0dmqELSg792AGLm1NVlUesqZlHuj3DwaA&oe=6AFC76D8"}, {"file_name": "MainlyMonkey_Custom..._21.01.2024_16-21-51.png", "id": "340420112245940", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036645_340420115579273_1374225033426258262_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRaYPdTXznIQ7kNvwGHu1rU&_nc_oc=AdrtjgfpY518G0SSLflEH6RRH1mLhOhin9WLn1-wqgjxFmF4flzaxwBOgfTljPz4nRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5nXCZsqV4dcD4pjU4Jz5Ov-Mj5j6oFTMzJuIdb85lvg&oe=6AFC7D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover2.0.png", "id": "1389683758411792", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75655194_1389683761745125_2110150542568419035_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7TYzTJRrt8Q7kNvwFXzOuC&_nc_oc=AdqKq6TFuxfOZDsvvyNu0ubTz5p_zh3dkQueXvIl2XG0xgNwa7ITLNzH-ryvNchaPP4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOrNFvkxKgFjXJU9g7bsBDy-itA3_r4b74ZtayFRiT6g&oe=6AFC63F8"}, "display_name": "MainlyMonkeys", "keywords": [], "long_description": "This is MainlyMonkeys, In this game using your hands are the key to play. Inside the game you have a option to play with others or with specific friend's. There are many maps to come, there is a boss fight to be seen sooner or later, There is P.V.P, Zero Gravity, Lil Place, Shop, and the MM EL. Here you can customize your character and even collect secretly hidden items and achievements. In the MM EL or as its told... Anyways the MM EL did create a few cool thing's. in Lil Place you turn small because of TROBITES which makes the map fun to play in. In Zero Gravity you have NG(nogravity) Which means once you enter you can fly, jump, or even hop around the ZeroG map. In P.V.P you are given boxing gloves to fight with.", "short_description": "In MainlyMonkeys you move with your hands and can explore the game and secrets that beholds in it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/5bf4d162-45a6-4486-af0c-d18a8d5f9272", "developer_terms_of_service_url": null, "publisher_name": "ARVTXR", "support_website_url": null, "website_url": "https://sites.google.com/view/mainlymonkeys-official-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7417609414958271"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "402178909041897"}]}, "baseline_offer": {"id": "402178909041897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1706826840, "status": "PUBLISHED", "id": "402178909041897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7627670737285470", "version": "7.0"}, "id": "1217571809662402", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": 
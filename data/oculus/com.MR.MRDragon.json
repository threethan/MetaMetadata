52432524_7620917463120206448_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9s2QEjbTbcQ7kNvwGwxLKL&_nc_oc=AdmB3uPa7jhf1jahyQEMkxlAtA4hfOj4QT_DAbhygVzBvIBXyKuIYfJaEeAT-rF76Vo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwF3NHFRDkUUs6TckjLW8aLFu5-OAScgnJ6h-v33S4RAg&oe=69B55988"}, {"file_name": "\u6e38\u620f\u622a\u56fe4.png", "id": "871073791140131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_871073794473464_8910237017830299424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0joAR5cJpwQ7kNvwG1s9sY&_nc_oc=AdnZLT6lQEYziSiHMYmldwWX8vdPQ4JtouFUX6laA4dxry6ALnp5_0xoRfnZ_nuPPMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwpv3gBp0T6j9jRmpyb-VVBxoqu8L10_2a54-CEpPL35Q&oe=69B55CBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "464521243152821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75394636_464521246486154_8584347552632562085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPff8KKrdtUQ7kNvwEMeFYF&_nc_oc=Admzrf-9diXd0yzJYI_hDLRd3ytISsEwtLxW8Qq-Z8KMjPW770K67f8l9kfXcwRWpQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUqNjJvyo9eEeTGMR-8HvYebxsWE2gJnVN2huQ51QTvA&oe=69B53D70"}, "display_name": "Dragon Fighter MR", "keywords": [], "long_description": "Dragon Fighter MR is an immersive MR\\VR role-playing game that takes players into an ancient and mysterious world. Here, you play the role of a brave warrior, shouldering the responsibility of saving the world. The game adopts advanced virtual reality technology, providing unparalleled immersion, making players feel as if they are truly immersed in a fantasy world full of magic and dragons.\nIn this adventure journey, you will engage in life and death battles against different powerful enemies in diverse environments. Faced with various powerful enemies and bosses, you need to use strategies and techniques, combined with various weapon techniques and corresponding special skills to 
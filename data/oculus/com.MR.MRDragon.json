oculuscdn.com/v/t64.5771-25/38974860_340767952432524_7620917463120206448_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXjAa8cZSC4Q7kNvwFK_wrv&_nc_oc=AdrI6YTomT1I0txpJ3dQgCASU_Eo21dP0qWVVSs9dHB5UgA07Bj7W-rtqNEm67OoFDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gKtHcWUlXLqnr5-DuXa1dhvgXhmuchK9F3gehRnQ2nQ&oe=6A16E888"}, {"file_name": "\u6e38\u620f\u622a\u56fe4.png", "id": "871073791140131", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974644_871073794473464_8910237017830299424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vukllnco6tcQ7kNvwH8Or1c&_nc_oc=AdqYajyeKzE8ZTC1Tch8A81U8Ba2f_qrVoPW9Hu525ZAGUhvLcvPVG_-iu5X9iJbNew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vdlD4_bCVYq_vsgWm6_bAyPKyPgGx1FzjOh1WSIqpMQ&oe=6A16EBBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "464521243152821", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75394636_464521246486154_8584347552632562085_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y9TKSL7l50Q7kNvwG4fIv9&_nc_oc=AdpS1l-pI0bDyZyEnn_5v3uE7jhU92uXQ-zf9UTs6HyyzfkJU4OHmsKYmvz4sce3rgs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SNxyXld0NnXafHoKhQtyrxyZgTE_SUNW1jmgk-KNVVg&oe=6A1704B0"}, "display_name": "Dragon Fighter MR", "keywords": [], "long_description": "Dragon Fighter MR is an immersive MR\\VR role-playing game that takes players into an ancient and mysterious world. Here, you play the role of a brave warrior, shouldering the responsibility of saving the world. The game adopts advanced virtual reality technology, providing unparalleled immersion, making players feel as if they are truly immersed in a fantasy world full of magic and dragons.\nIn this adventure journey, you will engage in life and death battles against different powerful enemies in diverse environments. Faced with various powerful enemies and bosses, you need to use strategies and techniques, combined with various weapon techniques and corresponding special skills to achieve victory.\nAs the game progresses, your character will continue to grow, unlocking new skills and equipment. In addition, the game also includes rich storylines and character development, and your choices will affect the direction and ending of the story, providing players with a deep gaming experience and replay value.", "short_description": "Dragon Fighter MR is an action adventure MR\\VR game that takes you into a fantasy world of fighting against dragons. Explore the mysterious continent, challenge powerful enemies, collect equipment, and enhance strength. Every battle is a test of skill and strategy, and every choice can change your destiny. Join the battle now and become a legendary hero!"}]}, "developer_name": "Hangzhou TechOctopus Limited company", "developer_privacy_policy_url": "https://www.szzyvr.com/YSZC_English.html", "developer_terms_of_service_url": null, "publisher_name": "Hangzhou TechOctopus Limited company", "support_website_url": null, "website_url": "https://www.szzyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8522592971186285"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id
0&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qbSulHUytoEQ7kNvwG8E2sc&_nc_oc=AdpvZ6VkauAPDZdkyGP_WFPu2CuqiS8OBse5dTzTAkYavRslzfFJuggNxipEW3U5iG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1GivOCoCddPmt_EvetJl9dEVtAlsriaNwkJc5XOqI4w&oe=6B0C6C3D"}, {"file_name": "Image Sequence_019_0050.png", "id": "1525471715823305", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1525471719156638_8552766320459754614_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6RuCKYlDxMQ7kNvwH51Nao&_nc_oc=Adqeag2GrF6K22G6Ri4jsiaUoOUknfokFMORZhnT0LZsfEdHLUdt58jDoMtt5IR3g5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdQZfnlP_Rpgn4-h5Dd6SFiNfoLizGkJZBW9iA9fMiuQ&oe=6B0C7549"}, {"file_name": "Image Sequence_032_0000.png", "id": "1309080464508815", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620444_1309080467842148_887430239426634572_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kr-LH2xO4H0Q7kNvwERtuNN&_nc_oc=Adq7HfmptCNt4EAQAHi1NpsHpkAhAhv9jpMdasE3Y-_5EWDz2Zrxyf0Nqh_2TVJmS8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQx3F0uR-ZaeE9E-_pHKwSIWY_2PfXu-feCyfHXzCjqyg&oe=6B0C4BE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Crash Arena", "keywords": ["combat", "car", "battle", "destruction", "crash"], "long_description": "Car Crash Arena is a VR vehicle combat game built for pure arena chaos.\n\nJump into a brutal tournament where cars are not just racing, they are weapons. Boost into enemies, ram them from the side, flip them into the air, survive traps, dodge arena hazards, and fight to be the last driver standing.\n\nEvery match is loud, physical, and unpredictable. Enemy cars chase, crash, reverse, recover, and come back for another hit. Massive hazards roam the arena, cranes can grab vehicles, bombs fly across the map, and heavy machines turn every round into a destructive motorsport show.\n\nBuilt for VR, Car Crash Arena puts you inside the car with direct control, impact, speed, and danger all around you.\n\nFeatures:\n\nVR cockpit car combat\nArena tournament survival\nNitro boosts, rams, flips, and crashes\nEnemy vehicles that fight each other and the player\nDangerous arena props and moving hazards\nExplosive crashes and physics-driven chaos\nA fast, brutal motorsport experience focused on spectacle\nDrive hard. Hit harder. Survive the arena.", "short_description": "VR car combat where you smash, boost, flip, and survive in a chaotic arena tournament."}]}, "developer_name": null, "developer_privacy_policy_url": "https://leafandlight.github.io/car-crash-arena-site/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Leaf and Light Studio", "support_website_url": null, "website_url": "https://leafandlight.github.io/car-crash-arena-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1990104051447093"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cy", "wa", "vi", "uz", "ur", "uk", "ug", "tuk", "tr", "tir", "bo", "th", "te", "tt", "ta_LK", "ta", "tzm", "tg", "tl", "gsw", "sv", "sw", "su", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "azb", "es_AR", "so", "sl", "sk", "si", "sd", "szl", "sr", "gd", "srd", "sa_IN", "sah", "rue", "ru_UA", "ru", "roh", "ro", "rhg", "pa", "pt", "pt_BR", "pl", "fa_AF", "fa", "ps", "os", "ory", "oci", "nn", "nb", "ne", "mya", "me", "mn", "xmf", "mr", "mri", "ml", "ms", "mg", "mk", "lb", "lt", "lin", "li", "lv", "lo", "ckb", "ko", "ky", "ki
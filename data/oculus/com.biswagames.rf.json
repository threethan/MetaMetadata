03763171549493_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNelRmEnIPkQ7kNvwH7jNMZ&_nc_oc=AdrkI0_g7OtgrWIpYRYtrQHO94m00wOsE5DS3zQ3bTKJ6ijin4J5grXAt9n50wP4N-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0PXx-6o1eTC7thQGyLkGGK-uLmbG53SsTY83kJVNVFA&oe=6AF8A1C1"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7pObCaIpa4Q7kNvwH9ARoO&_nc_oc=Adorh57GWwZRUH44wNulhuDPR3p-XNrk9ZAQEscfe7zl9xS50zTo7cSdKHdEqoXlLfU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOV0QKStyodHf-tzJlrUzzvHRieZUN0fma_74CdM6lJQ&oe=6AF892CF"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX4_gkJXlhIQ7kNvwG8OaeE&_nc_oc=AdoBZlRsWc_oOzdrlmcku9DZieYf-2g2EJoMRaXznxQgOM5AxxRfdNqoBOI7eectvB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReMi1ZoxXtPW8mAJ3me5px8mAjkWN_rSaEdc0Kq1ipDw&oe=6AF8A6FC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=su6Z1n4h6jQQ7kNvwEvBuZz&_nc_oc=AdoyMfwmHE4qu9wScINv__mvtrDjMMCk6Oxm48cMLgZjdZS_SQWwX9TeVln4DZogB6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmbzww9HXZJQ33phirXa8cz0DhAUag7_uTj6eIe12VjA&oe=6AF88421"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdFgUfT23ZAQ7kNvwGIh7Z8&_nc_oc=AdoJQbTsKxmpHAuR6nBh4c3Ljfe2SuG645QuEEEW3WsmXaZTyUM34pWLo930P4nNfcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Rmw6mpyXP-g9otvkClnIdL28m8pF_6jCsUajDuD1Tw&oe=6AF8956D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/rhythmfame/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25094008193574573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_1475407456892337_2407011698546652755_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAhps9yZR5IQ7kNvwG7DU0S&_nc_oc=AdoZ6DEIUFI9iwlLlWvHV21M2XFKeK1tfgifKbC8HVr1AnExsJAJhcjZu7m5B9H4iLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnV8OTzYF_uHBWuMXQIxqLrFZsmxZF9SGeWr38AYQS3w&oe=6AF8A344"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm FAME : Influencer Edition", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1766760180, "lastRevision": {"nodes": [{"id"
H4Iqwx_9KN0n8BKlEs-_LYAMAg0iR3PTyVfTA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cohn33jCMSVINoX3sn9a4UheakAz4K2ILx-2dI5uhFw&oe=6A203381"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6zGoomX6HMQ7kNvwH_6L-k&_nc_oc=AdpLdnmncRrWu-sB4LgnnEsILCB80aUjP4E1RgnJs9Pqg_Id8ly83fPrAvdGnHos19k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JJ74gGS8CMl-3s4zaxTzHYequ1HXg395GHfXYFm2vQA&oe=6A20248F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_HC9mT7PVUQ7kNvwGG9pav&_nc_oc=Adr1lYUkJB56EztltOyEwvLvjgjDvZmjrkMZQCA4aTj_L_IhSucxjynV9-wY06HcRjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48XyCQvBnn5tmnVlttRYKv1QmGXF4zGPuQ2SeUpi7Hkw&oe=6A2038BC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VOkV80-dQ4Q7kNvwEpyJBn&_nc_oc=Adqu-Q9Vr9YjAPP5pyB2Je4Vi043VVKA_PNhYM-gaUBKwokDhgYbY_FalWB7XVUjN-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5giWAh-LXY8VHAZX9-cCiVJd93EdihJ-Lmf1bCbrSoag&oe=6A204E21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRsrQY6poS8Q7kNvwG8Jyio&_nc_oc=Adowb0izRuXG73Rc0IeIcBQ6G8agEoa6bdnzMe5NvpQH5He3LirZQ7asujhK9BNMEyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_eAtlOTy1fyzkPRxDeSAY780WNq0cOX7FoC804kM3DQ&oe=6A20272D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_
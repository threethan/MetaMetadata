j3oxQ93klvqteZSiVwepjR3tEnrZCV9E8ckQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQdyxWkP-XR8WBh8CxGi88op8rd09ya0uRjaUnxFuKNQ&oe=6ACB9681"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOu1BH8cf6EQ7kNvwGLq_VO&_nc_oc=AdolvwVY1mR-NVJm2M7wFvJU4kh7Gi3cswIx-zU5yjy-BSyTYof2ogFtxqgXlHgRSpM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDRqAio6k4vUlbdeIYOowFS0mdrMaCoE3mah1z4xtykw&oe=6ACBBFCF"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhcyl5WrPjYQ7kNvwEva1cn&_nc_oc=AdrDKRVbEpEbiUTZG6h-ENK7R1g-2NT6-m3BMuc-V7IZ5bGsB5DEUFrBZ-CNhmYr-98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3cBZZWPudY6t1RWNFnIVAaYbUExIPPRaAeB9KZOgF0A&oe=6ACB9BBC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lCPcwO3uRYQ7kNvwFGuLFu&_nc_oc=AdqByJ54KGtHAZ2bRO67-4sPwQqIr0lZN6kkrx3Q1OnvlTG9nyCAL8BPX3coh0d5QG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcpe5BjRnCiKq2DVKkJr_KcRb9f79l0xvLBU1kn8Tiag&oe=6ACBB121"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU1HzsSIKDoQ7kNvwGBPfW-&_nc_oc=AdqZJd-q--BdOJDjRJAPbJtlYOCL0QHP4zGf0F9iSruHgsG70Z_Rd-wD1_BicPHQiP0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQwe0n_V-dI6-fs6aQbUC1QiABkU6FLACNujMaGWfnGw&oe=6ACBC26D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_
content-ams2-1.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QC8i5POdUxYQ7kNvwEAF2Qp&_nc_oc=Adnw2oBlnbC99nn-5Zsg5M1L3H-TEyTyKUtoY1NcspqX1jEgcBX10mMeTWXcUJAmzHw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfufkkFLRXNbjL9LTtsvKGpY3chlXZFfSL2S9ysWJ336yg&oe=699EF18F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIQoG2OKmIEQ7kNvwGFpkMH&_nc_oc=AdkcR9bhFY8DXr-8qgmwuo0H0qvqzSS9ya5UEB5sAluo3RHCBAd03HfPBkTX1PHtsPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuMxnN8_7D1Mf3FXtyQANmfenrh06hqywmOZtby7wXuBg&oe=699F05BC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZtlTGrVPNIQQ7kNvwHqbpVW&_nc_oc=Adn43qXazaVtjqlJoMS04Ard3aTIBGduZuG44GBDF7w0LxgHo0T9j4DZWhA9Hbs_sE4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvZ9OUemtGn8K3A1QKFhkWD7UqXSfNAQdROjsQ-5fdMDw&oe=699EE2E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZdTNQ176ycQ7kNvwH0cORH&_nc_oc=AdmyiMg2FXFC1GBDUgYowldKryHiMDFQ6gFa2KECCaGoiVlHU-sQxbKbhmCDNG9tP8Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft59WmRiIR6gnNpnmnzLJKHtDNWgoT9Y3g20Fo4PAPKIg&oe=699EF42D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/rhythmfame/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
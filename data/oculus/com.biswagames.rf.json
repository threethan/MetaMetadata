03763171549493_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNepS2kTH1UQ7kNvwGr70Il&_nc_oc=AdpCzwOfdsjvXz4R2mGvxGSiX0gkwDU4pIg2hEqHz7-WmAS7KGAQF84mrsSXXlzH9bY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_gOiQCQwOcu_bQJPhPWihHztUUxjEJUf75YI25IzQ2A&oe=6AF08081"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3tlXkyqt_IQ7kNvwEhqPfP&_nc_oc=AdrWROhWx3S-Qeeihi6DwPOOKd9LYJXKCgrYTUfkzChUAMF2y5M9GDnZrVYWsBWKAGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbGLWETbTTTrIJOU7Q0p0GZjumFZybUCV8VElgAYoasg&oe=6AF0A9CF"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb3RGnJ_zw4Q7kNvwHs1Yc0&_nc_oc=AdodrYxDdisdopVAzK0kygHMvaHDB-d8uHoK6h2mbE6Xs5z-Nx6OsNso1g88YIKoheI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMV8f7VEqLgbP18gi3LU7wMKApiHLK2qcpAZinKd8EAg&oe=6AF085BC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgv7edNwvCIQ7kNvwHQpBb8&_nc_oc=AdrOyN5Wu-uajenMu08kwTfRSN3zxuBXAbWJehsCPaXRQgTSnboU12_wdpOzEjSZA6g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9UAqzEZMDS6u4NFaoHBCjT4hDWJBxZ98X3xodPJ_HnQ&oe=6AF09B21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lckbYTE6-s4Q7kNvwFYYEoz&_nc_oc=AdrLFPQfGMIMzx24sWNMtC5L2oLt00SYinB3P5rPUdpZsf9p752pURGZf1LnIJSr3R4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsH38_91k68jadDBRj5JcR_RDaXn65IQKggKkAnmCXyQ&oe=6AF0AC6D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/rhythmfame/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25094008193574573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_1475407456892337_2407011698546652755_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6S8KJHH8h-4Q7kNvwHpIlR3&_nc_oc=AdoAqB7hWQydENPISoODM2TOLnMpew9gEg13ofgizAppSf6CMxN4ftdYkbtyfIKZgtE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaq4IiZ85p6RxArBTy967VExtJEovPMXxfhNTEf9nRsQ&oe=6AF08204"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm FAME : Influencer Edition", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1766760180, "lastRevision": {"nodes": [{"id"
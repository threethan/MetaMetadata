nmFgWZVb37aNQi56ja9Wg2fdm3yoNNifwAGvk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88H7iu_1unLWVqEHfU_cxLvUsblGdaktotwVLDs9-ZJg&oe=6A300581"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q9SNdy3Mq4Q7kNvwFL0mrR&_nc_oc=AdoU8E7ORh3LH0k7YMNahd2wFIm24nNz_LhejwDk5wNj3ndSFooypKkG3tMlTqlH2zA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aaSMtWKq8cO-Pz3SXAfmCfrSOzgEBVOaHoAhuRobzKA&oe=6A2FF68F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVdpEu8YKBwQ7kNvwHvb3ah&_nc_oc=AdoX3XRZcACe97z8fwmUV-Ra9dAubXxTPaRegSCBX9jiQnmiDljcBJYxSh4pNv3UOrQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y8VXp6Ov18bCovoNmEwUFKeQqmmL2b1Ptk5k0P74pzA&oe=6A300ABC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t3FgPVd9DAQ7kNvwG8qWY1&_nc_oc=AdrX0kV-Z7a0nObVrrjbhCwR0fGIuxwWczWQpGtnFnrKKavaHqKMckeZtjhhVcB7_Ds&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z4tcbesT4t9Cc2RBPtOs_d9LXxhlS6F527ere9NT4YQ&oe=6A302021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3fNXUn-7YkQ7kNvwFApsX7&_nc_oc=Adp113pKtVycyhxQ1Kz3PsD93dFF5JFnZ4sZ2Wy6K5K9PsY8YWujAqp906Riko42x4s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rGUFEf4rChDd5G9DiN0xBlNTz62JI2luR8rurfP5Bcg&oe=6A2FF92D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_
f2pecoaqizy78XUljgUVtVuArN5AmBn-l3wNHl-86wbXQ&oe=69F0BD81"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlDFlE-CCywQ7kNvwHY2FJQ&_nc_oc=AdqCDKRKxbTbh6yoC5L-sB3Ctf4Y7e-GwbYBWCQt8JE5Hlpk4SLPmKQH4cZKsmuMRjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3jsmQG-8CGCjsHRPt0e-P4gce7u0LxiebKjowztmZfdw&oe=69F0AE8F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wicwj0n_SD4Q7kNvwHAwauc&_nc_oc=AdoM27WZASwYvzPI6nle9ID3cqOLUFrzboDlxWGUu62BVxd61SVuXWgQz5m1vonHDWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2jAedMoJZ5tVoUe1VNFnEntkK3IdKF8T2kaSr1f9N6UQ&oe=69F0C2BC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baUSRHDGYPIQ7kNvwFiib1B&_nc_oc=AdrBujeD4i3A1ZEz70Hkb3uZG6i5ox5YNc09sX4SnB-pCU67i5_rOO2MNr36Hm9vs8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1WymNVKibxQ41dQT5qMd0nCOKr1Mf-hqHxFSISg1KR3w&oe=69F09FE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClGpO69WgpEQ7kNvwEDLK3u&_nc_oc=AdoC9iRMJ-vWJQg_I4IT98L3XM-r1jD20eQTynRqxgEadu6In964IpZaTk59H3J4TS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0_hSose6-z2w3JNHaQeTNwuGg3s1sP_R1lRI-S-2nmfg&oe=69F0B12D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/rhythmfame/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url
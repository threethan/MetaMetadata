content-atl3-2.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr_ZP8OGLyAQ7kNvwGkNC78&_nc_oc=AdlujPv1Wt04KItCH8hVWMLPwwOvprXIQx5PCpS5OF9rxS3FjKVMC0PjZ4JNUaUhNJc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfubxcRNqdrxnDErvbmHBc-nRdkXkvT7sZ7nDdcH4uVgPQ&oe=69A5890F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo3VuVwhxo8Q7kNvwHLIVW9&_nc_oc=AdnYJzXWiBW0hYBOivej_1mXSPxSwcIfOG_uJ3mV0xGHwM7FIzRKhtRH7XUzmy2AVGs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuBTKGMAidX8gBjzwCjm0hZyTuUglaqIxFU2Q8nalQhXg&oe=69A59D3C"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjZxMDP2ftUQ7kNvwEWtmk9&_nc_oc=AdmN2snpSOGlHY3z2Opw86G4-zpNBKDa6ftth9ZiHZIIBBDBLawvnxcAg7CoJANuE3s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afs-P18yDc8uWCoEkx_5aWnitCKVy20ePqeEcg_d0WMlbA&oe=69A57A61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfMPpe87h0gQ7kNvwFeXIYZ&_nc_oc=Adni9E-J1ssLGT1nObefMyMVPV_5xdq0wnmtbK04-dbg6vJeQ0thfuyaCKrihTXXS0g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftT68l5I006zaxhDF5bSp4Fl6BOOaicegdMDdVF5E3OOw&oe=69A58BAD"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/rhythmfame/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
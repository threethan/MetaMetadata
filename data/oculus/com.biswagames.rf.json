_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPtWToF2GfxGG-52s1Wx9LdfeomJqyzJE9JDUjatFoHQ&oe=6A676481"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVIiJA15wfcQ7kNvwEkLWIV&_nc_oc=AdrFpdxfT_xHPDtCvqOJuBlhtW4MMWKHyuG4bkqzgQIcDvqpjYrLUA1cQr5whQB1sps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKH5pnbLijzXZeXrgoACmDKtF9o8ont7Cl08fiXnA10g&oe=6A67558F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSpxL8MrLpcQ7kNvwHhz5Z0&_nc_oc=AdpMZVuD772YUinNFnTP7OC9920D9_Kjozl4lTwMO5kL1sPu4TBXMOUvOqoCdPa3ZKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC50c36YGgbKVH0aKvieQQdqCmFe29uCmpRXMWCZOpt5Q&oe=6A6769BC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ld6uvgvb5QQ7kNvwEiMceQ&_nc_oc=AdrxLgfXYgab9gEmVSVEwjmAa0E-BIX4trIsZzPR_2WL1ofoDAFUzCZpHzYGmI9dMfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXOEOTQZ0EtMLObL7S6LQXEcpUFjMfCYYEWhmnNnM7cg&oe=6A6746E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=refCozwjC-kQ7kNvwFOT8Tx&_nc_oc=AdqqW9UCSi5rUWOEaTRN8EdKwPqQ8bPHq8W9Fk4Ob1uHzCjgGG5fCMLLfkMuXJgCygQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0-pN_ZaecqH2hOsU54uIXLD1N_5lDM6GMVLbn7TiKkA&oe=6A67582D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/rhythmfame/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25094008193574573"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1567913887821839"}, {"status": "PUBLISHED", "id": "902802276055566"}, {"status": "PUBLISHED", "id": "885976387566055"}, {"status": "PUBLISHED", "id": "1564478124874418"}, {"status": "PUBLISHED", "id": "1374938548001863"}]}, "baseline_offer": {"id": "1374938548001863"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774288800, "status": "PUBLISHED", "id": "1567913887821839"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25698840619757991", "version": "0.0.13"}, "id": "1388152669604587", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25094008180241241", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25698840619757991"}, "release_status": "RELEASED"}, "binary_release_channels": {"no
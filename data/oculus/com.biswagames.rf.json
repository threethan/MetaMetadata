7VASxncES3wnYe9I1hrIXqVr78woA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afss5KXaMF4GUH3vcNK_k9n7eG488CFkpp3KPZwvKA62XA&oe=699AFD0F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDEshHVBnZEQ7kNvwGHlSdY&_nc_oc=AdlMvEE_qIzNLlHnZrcO9EvBF-is3gGqhoUlYBikALfR3EYqPHUj5Vl0H6QPLXswewE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvdxHXlwtt6hj06R-kxuL4mlhc3P5J0-cT2gCwdEbnkxQ&oe=699B113C"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4Pw1lR5ICIQ7kNvwFEYzsf&_nc_oc=AdlHT7DOdosPKeoH9NG6Vvw3VAS7mwx1hKmgCjzUiiBfTojW-Q66Li-DDNw92Mgul6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsEsaNRCHp4z9uw0VYF3ovosD0qcPUCo1ynulXyHgvctw&oe=699AEE61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP8bYjAgBH4Q7kNvwH3LQG3&_nc_oc=AdneaJywPhhc7D0BRPmauZpFTyP3BVGu1CJwXZTZayCC5PQUGx4BPBjQmqxfDKLaIFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft08qjrsLjNPu7wMzkKz_YqmYSP7zdpoRdMYMSttZaOvg&oe=699AFFAD"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/rhythmfame/", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscrip
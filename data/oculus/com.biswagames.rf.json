aXGm5de9vKS0XiOXHUjlNx48NLXv7m1hxntSQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1zLGaJrfoZiFAKcHcS6H3Q6hZpmAHOvYNVEhbE7ETfw&oe=6ACF8B01"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ni1H3NfBYvkQ7kNvwEyMNgw&_nc_oc=AdrdcTxYNN2CdrmPG85tfgugm0Zs3AedyfTxpIY0sdaqwHXWG77uVlqFOWmarAZODFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKfYXWO1G1zjg5_bcnPJUbWfRnwOwGNUpztjoOj3Y9Sg&oe=6ACFB44F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKFL51z9pKYQ7kNvwFUClfw&_nc_oc=AdoZp4DkvF6OU521Hp1C0uv5WWZEUoAbmOAL7Mmh-BR2BItLiDL324sh0UR5nAGmk9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfHqhGWlCNvPsEAXxQG8_d6ovs7S_j9iZqCKwh77Z0wA&oe=6ACF903C"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaMjHETIXpoQ7kNvwF1rMUt&_nc_oc=Adpa1D3gPFuksrRvFVJV76mXumf5nxWJhnWFcipn42n1it0WIUib054pBmo_MfuXTpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcpPbgggIXik2XnCNyCbpiBav2rerRfv1ZTJ-_bSyXDw&oe=6ACFA5A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNGaFMD8w70Q7kNvwFMNpfH&_nc_oc=AdookSY2XluidSv7ZjU65Nb61BV75yhjK_4w-TB1P6Oz4NZnLV_OzG_d1VACuyR6Wko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo2OZgWTUpl_1rxsOQc_uRZgUVNu1qmD37FpXkbElh3A&oe=6ACFB6ED"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_
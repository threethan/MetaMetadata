EjN-Hx1AGy_mTxfCYN0PPzXyjrV8wnehP0iRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Oo9aWeJO_HFubr8fJ2Kq7ii-efhAzju-_n_zYjs6BTw&oe=6A354B81"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lh0w3aQpOxkQ7kNvwEcSt_0&_nc_oc=Adq9ZNTzW68XovCQgf5c9Ra9vGxCdyW5ptl8ZEBKiNB_vG9XwXW9qBOzgx3aN4WPKX8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kQuGtkdo9CgG9TaJuOI5LehDEJH7Z2kKkIlK2vvrb2A&oe=6A3574CF"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBmVCMWV4XsQ7kNvwHzy4hB&_nc_oc=Adp9rVQY8vm2RDJyMiPtSQmY93xZ3SaY3TY0bXgWX4g6v-_ztAnPQgS5gwBZOInS6Cc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UGldeHO_ppHsax8mtnR5JKr5yPdApOC85X8aMR_OiIQ&oe=6A3550BC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcKCXlDp0rcQ7kNvwGTSv-G&_nc_oc=AdqKcWslPDU-uAljnW_Kjk4vrYBknItp5A1AAmcq8zU7W_cfv0NbdGy6wAK7lag4584&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95BbktfGl3pqafxihTB8RU6n_ZO7wT53GTtTk2EANNig&oe=6A356621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aekkj1JmSHUQ7kNvwENEHcF&_nc_oc=Adoqjgyyt-ITACIs9rYh_dejnvDqQgMgaEgUm7gsD2Gw6EDlYwkUInGQKVNtOb-mXL0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82AQArJ0FIB8VDmZQ25pFf-QVdB-jEJmiWPJzW9fv8_A&oe=6A353F2D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_
akIFAT6SCCk1-58jPJEHXvWVVTJWTdF5IPu8I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsCK5Xo8ujqoOopkHvl-tPqkNyrdnZ2n2QGQkGce5Wig&oe=6AE20001"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UaVGQCC0xgQ7kNvwE0ELvZ&_nc_oc=AdqmUrbhz1lTSZUeekT6PsWpMF13jMCHy2R212mdxJxGOKLO1VasZRv9L7sGq4JtGjQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL6WqN8PmT79UBEcKPQLO9Rw-LmRF2dkIR4ylFmRpsAA&oe=6AE1F10F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi-EAxAgTdgQ7kNvwHQ77IN&_nc_oc=AdqnhMups7aDrDMwCdhaaoWFZzGvQU_foFvOjt2dA12d01xY-Pm9Lat0tl-vQy4kKd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0pVX2H3wmc8VK3Lfdj_deGzcl3s_Hcth73Qs0FnEcGA&oe=6AE2053C"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFW5w_0fVTMQ7kNvwEJ67Hs&_nc_oc=Adr8ZVjjXhcaqrfiINu1auhAqmPzzCRPVNVGd_e1xLbRy-0puSyBZHE8OyNaSBB8L8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHSubTIcWnVPCEp-_woK4nZIydYzX5ikJnaca89YLR9Q&oe=6AE21AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwLpln6uwgwQ7kNvwETQi-K&_nc_oc=Ado6zd6NVMCcgRFHJL9Da47BwTgmu26MksOjG_GK2unQyV7aPcu8MfQA8mZqQD9Bc3o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLm0C8AeMBkjc--6eQm0YcCKeWrIY4Ag-k5_myHL-KNg&oe=6AE1F3AD"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_
4YfaYsq8rKnvSCOmoTkYMUtwti2_9r3IejYtFi45R3Y&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKrwAI8CYesjBb748uQLv9GEa_mjz2sKnRo6eBy-N-pg&oe=6AAE9581"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEGIrUc4Kt0Q7kNvwFiUX2w&_nc_oc=Adp5-e8MbygUNFcdr6eGZW5mbE9cenfENSRIOCUf0NtKXwbJ05VTZWndx8FKc1KxJ8k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZxnnUjeSbgnTkR4oB-JDLDNJtTbwx9OzHnPYxFV5LYQ&oe=6AAE868F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YORrOjEXfXYQ7kNvwGGkBXW&_nc_oc=Adqkcvqk9t9J31ndjE-aPm6E2h7QcsCVUZLL-WjJi2gIIvc8-BmguS0DgNrc3YRVgKA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwVdh0wHxztCsIPVwx9PTJW5bCuDEgSi7hIaoYRH8lUg&oe=6AAE9ABC"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRcgao8YM9YQ7kNvwHko_PG&_nc_oc=AdqfM3_9ILh7wvai2qGJJ4u4Wog7pSe_1uGS-6LdqyrLzcBlKmIYUx4cneMef-jmwBY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgf5g_9_0yrUIxfl2tk0PtHfgD9eLBRoogFWWnJlHeuA&oe=6AAEB021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCRFJChFsF8Q7kNvwF6vpI8&_nc_oc=AdoeEQ0dHQz9cM5zcuTV8UJsdwGGWcjx9egRhYnl1XIdhEDLutgxjE9YcwBfRVdpoTU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyyjTLcEhYxAt6GsnMDqWispNFQtVyTvyGYoi2A-V21w&oe=6AAE892D"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_priva
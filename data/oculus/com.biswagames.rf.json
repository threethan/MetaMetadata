AvggxRBp8WRkvmKqctufeECS1LMRl6vNJg8eQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YaLBWvC1BE3wJCrXD4C2j6nL8k8jiMt4E5P_Sby-92w&oe=6A048401"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upZ3leTD47sQ7kNvwEf1DQg&_nc_oc=AdpdICgv7_DiwGQ1OiUglzvNELhYgaUzIQB-8dAXi2Vtyw51K4YzDQMp-NlAxdh2rDA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eedySZ1z9F2n17_pbTDYNgtpPsx6cGQvcFd7YdU3Z4A&oe=6A04750F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e384tZNHcVMQ7kNvwGpl2Tx&_nc_oc=AdrPFgAEUw8iTB7S6xqeSEB51G-2xx8c2raWfdAhcwvdjZ6O3VVUP2PgwMKIqyTJ0Wk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RoZ9DBEJLeVnf1PmDLpliB5rhSkpulqEwH6JVcAjigg&oe=6A04893C"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xT4dAudHtPcQ7kNvwGwpyZn&_nc_oc=AdpUZXfr0INeqiBA2_HFf0vJbO5csVaV2KmJ2stkBn94Ust-76ppx_O-aGjj5HtmoP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ClUzRKszKFoB6-BbNqBP-AXxBrXRSaRDrRJJUDL7N0Q&oe=6A046661"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MASxsEPbOTYQ7kNvwEjW0hj&_nc_oc=Adoy10VC0Y1nZne7NKeqYCfYJf_g92wDx3FA_wWarrPkFhNqaH3pI_-Tnafjrytfv-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LnttTmLVZWVCi02QVli1QeMuvnN7qYCSLVth1jZnSRA&oe=6A0477AD"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_
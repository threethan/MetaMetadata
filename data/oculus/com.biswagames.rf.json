RlKY4BEFRi-lpyJT5z91UXxm02aC1u9mT6Lx0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nFw09FPf4c1smvB-zHNIGZWmqaqqKURHwr-vqNJZB5w&oe=6A0F1001"}, {"file_name": "2.png", "id": "795253620229683", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619159_795253626896349_2733651366559496392_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg8cDUCamLoQ7kNvwFLQz0V&_nc_oc=AdrE2W8LiKnUFmU82MlOV2b85YC3MJvLU5p8VJgZQE3oE7E7yh0vwT9H9HD3jyioiIA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vYSQE14x9sLzoeBAhK0Nvdhhwm-s-HEUsJfPT2PTgog&oe=6A0F010F"}, {"file_name": "6.png", "id": "841669665498746", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618093_841669668832079_9141116026824121782_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_KP_1ZiAOYQ7kNvwHBR5Hg&_nc_oc=Adp28-V1j6uEyJ4QvlSPM6IQgZslnzzSSbuZVYjgZi5PWnoJ6nYM1vpU-G9KdM-Te1Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6n0hUf1y5-3F36x3nEjVZB2wXR0nAxqx8Wt4yUcOie3w&oe=6A0F153C"}, {"file_name": "13 (1).png", "id": "1636087437761320", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619450_1636087444427986_186497130864574751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIjS6Ah6LKYQ7kNvwFpNce2&_nc_oc=AdpZptQu32_xh_CmpMuu0Zn7kC6Jl36gRMuGCjce412ragcMXAbg2kVE7fV5S_rO4TY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Kwvq2xpoc-RdYGk1vqbCHy-rNQkBO7dYdqYJzi3TZ8A&oe=6A0F2AA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440_CoverLandscape (3).png", "id": "880993064391941", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618288_880993067725274_615007872304633567_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnPdGESqw6sQ7kNvwGpiCav&_nc_oc=AdqLME5Q0l9lOAyG7DOB_o2Y5FyK60Kl7x-lgqSWDeldgC9fxc61H7BG9b_l0NKJYE0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6H4ZSW9alTOO0y4syQoBiW3W0f0yy2AYOSDnUUaCtgkA&oe=6A0F03AD"}, "display_name": "Rhythm FAME : Influencer Edition", "keywords": ["Immersive", "Responsive", "Challenging", "Flow", "song"], "long_description": "Rhythm Fame is an **immersive**, **fun**, **engaging**, and **challenging** VR rhythm journey where you become an influencer\u2014your Creator Profile grows as you perform, compete, and chase the spotlight.\n\n* **Influencer progression:** earn **Fame Points**, **level up your Creator Profile**, and watch your status climb after every run.\n{1852707778693177}\n* **Live score competition:** there\u2019s **no static win bar**\u2014you advance by **beating other creators\u2019 scores** while their **progress bars rise in real time**. Track **leaderboard-style** benchmarks like the **Average** and the **World Record**.\n{1508763650421247}\n* **Easy to learn, hard to master:** controls are simple\u2014**LRUD arrows (Left/Right/Up/Down)**\u2014but mastering timing, streaks, and faster patterns takes skill.\n* **VR rhythm gameplay (clear + responsive):** play on **3\u20134 neon lanes** with a central **hit zone**, using your **glowing wand controllers** for tight, **satisfying**, responsive timing.\n{1404922804549817}\n\n* **Flow-state pacing + story replay:** intensity follows the music to keep you \u201cin the zone,\u201d through a connected song story from **college dorm music group** to **world-tour selection**\u2014built for quick sessions, repeat runs, and constant improvement.\n{1218134910275215}", "short_description": "Rhythm Fame is a fun, engaging, challenging and responsive VR rhythm climb where you become an influencer. Hit LRUD (Left/Right/Up/Down) beats on 3\u20134 neon lanes with glowing wand controllers, timing hits in the central zone for Like-bursts. Songs are linked as one story\u2014from dorm band to world-tour tryouts\u2014with flow-state pacing that adapts to track intensity. Earn Fame Points, level up your Creator Profile, and chase Average vs World Record\u2014no static win bar."}]}, "developer_name": "Biswa Games", "developer_privacy_policy_
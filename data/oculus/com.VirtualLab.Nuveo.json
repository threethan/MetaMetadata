n-512x512.png", "id": "940484215045543", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_940484218378876_5791069824821534963_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNiYoEqcdicQ7kNvwHXlU1K&_nc_oc=AdokywXDusYf70Ll0PQMdaUAPBYV3Gw4cX1f5FZCJ9zsB63h1hft4-1XGlGHow4z7bM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO9ojobmT2UzeYmEuskfFD6GO2_s12Ag9LSdbnHTPRvg&oe=6AE74BB4"}, {"file_name": "tile-foreground-180x180.png", "id": "816487594861188", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_816487598194521_5227700992058423838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JanLWqfIdJ0Q7kNvwEOVW2k&_nc_oc=AdqIDXiJ4B6t-5Bbp3rKiTSfs2NlJkdYfFU4apEJ_CaOC1c40fMZiNk-e1wbg88pGCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwKr-KMUcUs7AI6_VllrjeEH6JtLdo5Rv9mqIdCREX1g&oe=6AE73A0D"}]}, "id": "2310319023065387", "locale": "en_US", "screenshots": [{"file_name": "Image Sequence (1)_001_0000.png", "id": "2007272476592517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_2007272479925850_1836706392089279385_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4M3kvZOK5UQ7kNvwE0UQ7m&_nc_oc=AdrMQUf1wWsrG1JcFhx_lzHm2e1q3LIl4Gp70RRsOIDE1OoVqVXrWm3Radbb5gQ50MQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Wvl_zw72os426G3f-NRFcbwlL2srjZyPMLY1lun5KA&oe=6AE74BCB"}, {"file_name": "Image Sequence (1)_007_0013.png", "id": "1573288034173285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1573288037506618_773887071614618257_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jIkQfUv-74Q7kNvwG3uuH2&_nc_oc=Adp2yvJVsRIev5pJR8G9PUj8PWqcyzFPQ0gtwF6a1g1JvPImEtZ1oQhY8q9T2SrzsLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8UNoVh3EUeWh8-vTPImodJ7jApp3QkspmWwM4-xUspw&oe=6AE750E3"}, {"file_name": "Image Sequence (1)_008_0060.png", "id": "1395428362785446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1395428366118779_7239919769348109029_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2RTA10_u5YQ7kNvwGMeFb9&_nc_oc=Adqw-X_xJfu6OvgaUzFIwLip1vS5eJdODNLC7Zw9nEjmwdeclkkTZUDAm8vOXh307TU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwblp9snNq348tLA9X7s7rhnV1zOspVSE1pfy4xXzPuw&oe=6AE768AF"}, {"file_name": "Image Sequence (1)_004_0000.png", "id": "1607765430816714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1607765434150047_4040696890655150120_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeWwI8BvSzkQ7kNvwGH5mf1&_nc_oc=AdqGnxLbLOOb78weucThf7b8IYI5SaBF1hK7w9ICxMhUfpxND_Lk5aAgWlqb9IRo6ao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7_7cejKD4Kt0E0XqFBqNNKxwG97Asb_AlumXed3s9vw&oe=6AE76A30"}, {"file_name": "Image Sequence (1)_005_0000.png", "id": "4612000859037532", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_4612000869037531_6001185295640286499_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcXaX27sp-UQ7kNvwHCk5l6&_nc_oc=AdpWe_macfcDdiAWWmQFxbIJoEg6gmPD5KoXFJH-FhcjE2VL8CeCPWBuVNhgEruBi8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP7wrg5nWjj0O2Sn2cLjHtxvktfz1Qto2u7NB206B6WA&oe=6AE76C68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nuveo", "keywords": ["Nuveo"], "long_description": "**See your building come to life, before it's even built.**\n\nNuveo VR bridges the gap between architectural plans and reality. Upload a 3D model of any project, and it becomes an optimized, true-to-scale virtual walkthrough you can experience directly on-site, right inside the unfinished structure.\n\nPlace a printed QR code on the floor of the construction site, put on your headset, and watch the finished interior appear around you at exact 1:1 scale. Walk freely through every room and floor. Check ceiling heights, window views, and spatial flow long before drywall goes up.\n\n**Key features:**\n- True-to-scale visualization calibrated to real-world dimensions\n- Free-roam exploration with no boundary restrictions\n- QR-based spatial anchoring for precise alignment\n- Realistic materials, textures, and lighting\n- Offline-ready, review projects without WiFi on-site\n- Multi-project support tied to your account\n\n**Who it's for:**\n\nBuilt for architects, interior designers, developers, and construction professionals who want to validate design decisions early, reduce costly late-stage changes, and give clients a compelling preview of spaces that don't exist yet.\n\n**Bring your blueprints to life. Walk through tomorrow's building, today.**", "short_description": "Preview your future home before construction is even finished. Nuveo VR projects a complete 3D interior visualization directly into the unfinished building \u2014 just scan a QR code on the floor. Walk freely through the entire space at true 1:1 scale, and see the colors, textures, and lighting exactly as they'll look once complete. The app works offline too, so you can review your project anywhere, even without an internet connection. Built for architects, planners, and developers."}, {"images": {"nodes": []}, "id": "2197542857840021", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nuveo", "keywords": ["Nuveo"], "long_description": "**Zobrazte si svou budovu, je\u0161t\u011b ne\u017e je v\u016fbec postavena.**\n\nNuveo VR p\u0159eklenuje propast mezi architektonick\u00fdmi pl\u00e1ny a realitou. Nahrajte 3D model jak\u00e9hokoli projektu a ten se prom\u011bn\u00ed v optimalizovanou virtu\u00e1ln\u00ed prohl\u00eddku ve skute\u010dn\u00e9m m\u011b\u0159\u00edtku, kterou za\u017eijete p\u0159\u00edmo na m\u00edst\u011b, uvnit\u0159 rozestav\u011bn\u00e9 budovy.\n\nUm\u00edst\u011bte vyti\u0161t\u011bn\u00fd QR k\u00f3d na podlahu staveni\u0161t\u011b, nasa\u010fte si headset a sledujte, jak se kolem v\u00e1s objev\u00ed hotov\u00fd interi\u00e9r v p\u0159esn\u00e9m m\u011b\u0159\u00edtku 1:1. Proch\u00e1zejte voln\u011b v\u0161emi m\u00edstnostmi a podla\u017e\u00edmi. Zkontrolujte v\u00fd\u0161ky strop\u016f, v\u00fdhledy z oken i dispozi\u010dn\u00ed n\u00e1vaznosti dlouho p\u0159edt\u00edm, ne\u017e p\u0159ijde na \u0159adu s\u00e1drokarton.\n\n**Kl\u00ed\u010dov\u00e9 funkce:**\n- Vizualizace ve skute\u010dn\u00e9m m\u011b\u0159\u00edtku kalibrovan\u00e1 podle re\u00e1ln\u00fdch rozm\u011br\u016f\n- Voln\u00fd pohyb prostorem bez jak\u00fdchkoli omezen\u00ed\n- Prostorov\u00e9 ukotven\u00ed pomoc\u00ed QR k\u00f3du pro p\u0159esn\u00e9 zarovn\u00e1n\u00ed\n- Realistick\u00e9 materi\u00e1ly, textury a osv\u011btlen\u00ed\n- Funguje offline, projekty si prohl\u00e9dnete na stavb\u011b i bez WiFi\n- Podpora v\u00edce projekt\u016f propojen\u00fdch s va\u0161\u00edm \u00fa\u010dtem\n\n**Pro koho je aplikace ur\u010dena:**\n\nVytvo\u0159eno pro architekty, interi\u00e9rov\u00e9 design\u00e9ry, developery a stavebn\u00ed profesion\u00e1ly, kte\u0159\u00ed cht\u011bj\u00ed v\u010das ov\u011b\u0159it n\u00e1vrhov\u00e1 rozhodnut\u00ed, omezit n\u00e1kladn\u00e9 zm\u011bny v pozdn\u00edch f\u00e1z\u00edch projektu a nab\u00eddnout klient\u016fm p\u016fsobivou uk\u00e1zku prostor\u016f, kter\u00e9 zat\u00edm neexistuj\u00ed.\n\n**Vdechn\u011bte sv\u00fdm pl\u00e1n\u016fm \u017eivot. Projd\u011bte se z\u00edt\u0159ej\u0161\u00ed budovou u\u017e dnes.**", "short_description": "Prohl\u00e9dn\u011bte si sv\u016fj budouc\u00ed domov je\u0161t\u011b p\u0159ed dokon\u010den\u00edm stavby. Nuveo VR prom\u00edtne kompletn\u00ed 3D vizualizaci interi\u00e9ru p\u0159\u00edmo do rozestav\u011bn\u00e9 budovy. Sta\u010d\u00ed naskenovat QR k\u00f3d na podlaze. Proch\u00e1zejte se voln\u011b cel\u00fdm prostorem ve skute\u010dn\u00e9m m\u011b\u0159\u00edtku 1:1 a prohl\u00e9dn\u011bte si barvy, textury a osv\u011btlen\u00ed p\u0159esn\u011b tak, jak budou vypadat po dokon\u010den\u00ed. Aplikace funguje i offline, tak\u017ee si sv\u016fj projekt m\u016f\u017eete prohl\u00e9dnout kdekoli, i bez p\u0159ipojen\u00ed k internetu. Ur\u010deno pro architekty, projektanty a developery."}, {"images": {"nodes": []}, "id": "1061390576924949", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nuveo", "keywords": ["Nuveo"], "long_description": "**Zobacz sw\u00f3j budynek, zanim jeszcze powstanie.**\n\nNuveo VR wype\u0142nia luk\u0119 mi\u0119dzy planami architektonicznymi a rzeczywisto\u015bci\u0105. Prze\u015blij model 3D dowolnego projektu, a zamieni si\u0119 on w zoptymalizowany, wierny skali wirtualny spacer, kt\u00f3rego do\u015bwiadczysz bezpo\u015brednio na miejscu, wewn\u0105trz niewyko\u0144czonego budynku.\n\nUmie\u015b\u0107 wydrukowany kod QR na pod\u0142odze placu budowy, za\u0142\u00f3\u017c gogle i patrz, jak wok\u00f3\u0142 Ciebie pojawia si\u0119 gotowe wn\u0119trze w dok\u0142adnej skali 1:1. Poruszaj si\u0119 swobodnie po wszystkich pomieszczeniach i kondygnacjach. Sprawd\u017a wysoko\u015bci sufit\u00f3w, widoki z okien i uk\u0142ad przestrzenny na d\u0142ugo przed monta\u017cem \u015bcianek dzia\u0142owych.\n\n**Najwa\u017cniejsze funkcje:**\n- Wizualizacja w rzeczywistej skali, skalibrowana do realnych wymiar\u00f3w\n- Swobodna eksploracja bez \u017cadnych ogranicze\u0144\n- Kotwiczenie przestrzenne oparte na kodzie QR dla precyzyjnego dopasowania\n- Realistyczne materia\u0142y, tekstury i o\u015bwietlenie\n- Praca offline, przegl\u0105daj projekty na budowie bez WiFi\n- Obs\u0142uga wielu projekt\u00f3w powi\u0105zanych z Twoim kontem\n\n**Dla kogo:**\n\nStworzona dla architekt\u00f3w, projektant\u00f3w wn\u0119trz, deweloper\u00f3w i profesjonalist\u00f3w z bran\u017cy budowlanej, kt\u00f3rzy chc\u0105 wcze\u015bnie weryfikowa\u0107 decyzje projektowe, ogranicza\u0107 kosztowne zmiany na p\u00f3\u017anych etapach i oferowa\u0107 klientom przekonuj\u0105cy podgl\u0105d przestrzeni, kt\u00f3re jeszcze nie istniej\u0105.\n\n**Tchnij \u017cycie w swoje projekty. Przejd\u017a si\u0119 po budynku jutra ju\u017c dzi\u015b.**", "short_description": "Zobacz sw\u00f3j przysz\u0142y dom, zanim budowa dobiegnie ko\u0144ca. Nuveo VR wy\u015bwietla kompletn\u0105 wizualizacj\u0119 3D wn\u0119trza bezpo\u015brednio w niewyko\u0144czonym budynku. Wystarczy zeskanowa\u0107 kod QR na pod\u0142odze. Poruszaj si\u0119 swobodnie po ca\u0142ej przestrzeni w rzeczywistej skali 1:1 i zobacz kolory, tekstury oraz o\u015bwietlenie dok\u0142adnie tak, jak b\u0119d\u0105 wygl\u0105da\u0107 po uko\u0144czeniu. Aplikacja dzia\u0142a tak\u017ce offline, dzi\u0119ki czemu mo\u017cesz przegl\u0105da\u0107 sw\u00f3j projekt wsz\u0119dzie, nawet bez po\u0142\u0105czenia z internetem. Stworzona dla architekt\u00f3w, pro"}]}, "developer_name": null, "developer_privacy_policy_url": "https://portal.nuveo.cz/privacy-policy/en", "developer_terms_of_service_url": null, "publisher_name": "Virtual Lab s.r.o.", "support_website_url": null, "website_url": "https://virtual-lab.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "pl"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1922830722423024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_1018434704562405_7500121444172742789_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcPBbrVM4acQ7kNvwHZjJRS&_nc_oc=AdpeIexKGfI6Wek58JLQJHGQ-LX9IcYW0n1XFN8H0y89nzhX-q6dgzwnPJ0dF3Fh5l8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQn0O-Nz123aqQJO9g-qdchAgScn37i3gdQ2_1rfSOsDA&oe=6AE75D61"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nuveo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1789149480, "lastRevision": {"nodes": [{"id": "1824496918923072", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1824496905589740", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "27864771289849171"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1780337486618986", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nuveo", "keywords": ["Nuveo"], "long_description": "**Zobacz sw\u00f3j budynek, zanim jeszcze powstanie.**\n\nNuveo VR wype\u0142nia luk\u0119 mi\u0119dzy planami architektonicznymi a rzeczywisto\u015bci\u0105. Prze\u015blij model 3D dowolnego projektu, a zamieni si\u0119 on w zoptymalizowany, wierny skali wirtualny spacer, kt\u00f3rego do\u015bwiadczysz bezpo\u015brednio na miejscu, wewn\u0105trz niewyko\u0144czonego budynku.\n\nUmie\u015b\u0107 wydrukowany kod QR na pod\u0142odze placu budowy, za\u0142\u00f3\u017c gogle i patrz, jak wok\u00f3\u0142 Ciebie pojawia si\u0119 gotowe wn\u0119trze w dok\u0142adnej skali 1:1. Poruszaj si\u0119 swobodnie po wszystkich pomieszczeniach i kondygnacjach. Sprawd\u017a wysoko\u015bci sufit\u00f3w, widoki z okien i uk\u0142ad przestrzenny na d\u0142ugo przed monta\u017cem \u015bcianek dzia\u0142owych.\n\n**Najwa\u017cniejsze funkcje:**\n- Wizualizacja w rzeczywistej skali, skalibrowana do realnych wymiar\u00f3w\n- Swobodna eksploracja bez \u017cadnych ogranicze\u0144\n- Kotwiczenie przestrzenne oparte na kodzie QR dla precyzyjnego dopasowania\n- Realistyczne materia\u0142y, tekstury i o\u015bwietlenie\n- Praca offline, przegl\u0105daj projekty na budowie bez WiFi\n- Obs\u0142uga wielu projekt\u00f3w powi\u0105zanych z Twoim kontem\n\n**Dla kogo:**\n\nStworzona dla architekt\u00f3w, projektant\u00f3w wn\u0119trz, deweloper\u00f3w i profesjonalist\u00f3w z bran\u017cy budowlanej, kt\u00f3rzy chc\u0105 wcze\u015bnie weryfikowa\u0107 decyzje projektowe, ogranicza\u0107 kosztowne zmiany na p\u00f3\u017anych etapach i oferowa\u0107 klientom przekonuj\u0105cy podgl\u0105d przestrzeni, kt\u00f3re jeszcze nie istniej\u0105.\n\n**Tchnij \u017cycie w swoje projekty. Przejd\u017a si\u0119 po budynku jutra ju\u017c dzi\u015b.**", "short_description": "Zobacz sw\u00f3j przysz\u0142y dom, zanim budowa dobiegnie ko\u0144ca. Nuveo VR wy\u015bwietla kompletn\u0105 wizualizacj\u0119 3D wn\u0119trza bezpo\u015brednio w niewyko\u0144czonym budynku. Wystarczy zeskanowa\u0107 kod QR na pod\u0142odze. Poruszaj si\u0119 swobodnie po ca\u0142ej przestrzeni w rzeczywistej skali 1:1 i zobacz kolory, tekstury oraz o\u015bwietlenie dok\u0142adnie tak, jak b\u0119d\u0105 wygl\u0105da\u0107 po uko\u0144czeniu. Aplikacja dzia\u0142a tak\u017ce offline, dzi\u0119ki czemu mo\u017cesz przegl\u0105da\u0107 sw\u00f3j projekt wsz\u0119dzie, nawet bez po\u0142\u0105czenia z internetem. Stworzona dla architekt\u00f3w, pro"}, {"images": {"nodes": []}, "id": "1759278031867010", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nuveo", "keywords": ["Nuveo"], "long_description": "**Zobrazte si svou budovu, je\u0161t\u011b ne\u017e je v\u016fbec postavena.**\n\nNuveo VR p\u0159eklenuje propast mezi architektonick\u00fdmi pl\u00e1ny a realitou. Nahrajte 3D model jak\u00e9hokoli projektu a ten se prom\u011bn\u00ed v optimalizovanou virtu\u00e1ln\u00ed prohl\u00eddku ve skute\u010dn\u00e9m m\u011b\u0159\u00edtku, kterou za\u017eijete p\u0159\u00edmo na m\u00edst\u011b, uvnit\u0159 rozestav\u011bn\u00e9 budovy.\n\nUm\u00edst\u011bte vyti\u0161t\u011bn\u00fd QR k\u00f3d na podlahu staveni\u0161t\u011b, nasa\u010fte si headset a sledujte, jak se kolem v\u00e1s objev\u00ed hotov\u00fd interi\u00e9r v p\u0159esn\u00e9m m\u011b\u0159\u00edtku 1:1. Proch\u00e1zejte voln\u011b v\u0161emi m\u00edstnostmi a podla\u017e\u00edmi. Zkontrolujte v\u00fd\u0161ky strop\u016f, v\u00fdhledy z oken i dispozi\u010dn\u00ed n\u00e1vaznosti dlouho p\u0159edt\u00edm, ne\u017e p\u0159ijde na \u0159adu s\u00e1drokarton.\n\n**Kl\u00ed\u010dov\u00e9 funkce:**\n- Vizualizace ve skute\u010dn\u00e9m m\u011b\u0159\u00edtku kalibrovan\u00e1 podle re\u00e1ln\u00fdch rozm\u011br\u016f\n- Voln\u00fd pohyb prostorem bez jak\u00fdchkoli omezen\u00ed\n- Prostorov\u00e9 ukotven\u00ed pomoc\u00ed QR k\u00f3du pro p\u0159esn\u00e9 zarovn\u00e1n\u00ed\n- Realistick\u00e9 materi\u00e1ly, textury a osv\u011btlen\u00ed\n- Funguje offline, projekty si prohl\u00e9dnete na stavb\u011b i bez WiFi\n- Podpora v\u00edce projekt\u016f propojen\u00fdch s va\u0161\u00edm \u00fa\u010dtem\n\n**Pro koho je aplikace ur\u010dena:**\n\nVytvo\u0159eno pro architekty, interi\u00e9rov\u00e9 design\u00e9ry, developery a stavebn\u00ed profesion\u00e1ly, kte\u0159\u00ed cht\u011bj\u00ed v\u010das ov\u011b\u0159it n\u00e1vrhov\u00e1 rozhodnut\u00ed, omezit n\u00e1kladn\u00e9 zm\u011bny v pozdn\u00edch f\u00e1z\u00edch projektu a nab\u00eddnout klient\u016fm p\u016fsobivou uk\u00e1zku prostor\u016f, kter\u00e9 zat\u00edm neexistuj\u00ed.\n\n**Vdechn\u011bte sv\u00fdm pl\u00e1n\u016fm \u017eivot. Projd\u011bte se z\u00edt\u0159ej\u0161\u00ed budovou u\u017e dnes.**", "short_description": "Prohl\u00e9dn\u011bte si sv\u016fj budouc\u00ed domov je\u0161t\u011b p\u0159ed dokon\u010den\u00edm stavby. Nuveo VR prom\u00edtne kompletn\u00ed 3D vizualizaci interi\u00e9ru p\u0159\u00edmo do rozestav\u011bn\u00e9 budovy. Sta\u010d\u00ed naskenovat QR k\u00f3d na podlaze. Proch\u00e1zejte se voln\u011b cel\u00fdm prostorem ve skute\u010dn\u00e9m m\u011b\u0159\u00edtku 1:1 a prohl\u00e9dn\u011bte si barvy, textury a osv\u011btlen\u00ed p\u0159esn\u011b tak, jak budou vypadat po dokon\u010den\u00ed. Aplikace funguje i offline, tak\u017ee si sv\u016fj projekt m\u016f\u017eete prohl\u00e9dnout kdekoli, i bez p\u0159ipojen\u00ed k internetu. Ur\u010deno pro architekty, projektanty a developery."}, {"images": {"nodes": [{"file_name": "Nuveo_360cubemap_10752x1792.png", "id": "28572573872334858", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824671_28572573929001519_614577418205753352_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ptvh1P29yJsQ7kNvwEKuyj7&_nc_oc=AdpvUDfNcYBMS8hcq1uSj4GI9MWqRK7gV-UwwpTk6d6LAmRrj9wADoTj49uGhgIIVlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3buQQnL0QRuu2XbP09lif1bE2DO-MHY0ZXS-1prSYTw&oe=6AE761CA"}, {"file_name": "tile-background-180x180.png", "id": "3696855400470303", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825503_3696855403803636_1315921602862827460_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShAQR_Dv18MQ7kNvwF9dov5&_nc_oc=Adqzcs-XxkB6pr1W06BEgzYMN1PrL8Swy_IvyTt1P1DdZ5qxnTlKkITaxRrARKFHth8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-8MA4y1BZtdUPdRbDSsexePa2W2WrFXYWxNRfOX4hFg&oe=6AE75A15"}, {"file_name": "layered_icon_composited.png", "id": "1771513494273757", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827973_1771513497607090_3610568119963936512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLE9yhJJTlwQ7kNvwFJJUfP&_nc_oc=AdopVpwCkBvBfH7wxLFC_bb4rPdJTjyQCDdC3NXVvtvuMiF7zWsbvu3VTpEQz1hI5Jk&_nc_zt=3&_nc_ht=sc
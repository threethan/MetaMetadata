{"data": {"node": {"__typename": "Application", "id": "1824496905589740", "organization": {"id": "152587129447401", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "1824496905589740"}]}, "id": "1465553212267804"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7543986912391867"}]}, "id": "670276812207229"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9947329485282779"}]}, "id": "656087953622332"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7258374900907479"}]}, "id": "707418414621787"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7672407429453449"}]}, "id": "1313978272642084"}]}}, "firstRevision": {"nodes": [{"application": {"id": "1824496905589740", "release_date": 1789149480, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1922817605757669"}, "id": "1911045189582633"}]}}, "binary": null, "live_binary": null, "created_date": 1793093844, "id": "1922830405756389", "is_initial_release": false, "name_with_fallback": "v2", "pdp_metadata_with_fallback": {"version": 2, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "1922830722423024"}, "release_status": "RELEASED", "id": "1824496905589740"}, "id": "1922830722423024", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1824496905589740", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "27864771289849171"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Nuveo_360cubemap_10752x1792.png", "id": "28572573872334858", "image_type": "APP_IMG_CUBEMAP_SOURCE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824671_28572573929001519_614577418205753352_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ptvh1P29yJsQ7kNvwEKuyj7&_nc_oc=AdpvUDfNcYBMS8hcq1uSj4GI9MWqRK7gV-UwwpTk6d6LAmRrj9wADoTj49uGhgIIVlg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3buQQnL0QRuu2XbP09lif1bE2DO-MHY0ZXS-1prSYTw&oe=6AE761CA"}, {"file_name": "tile-background-180x180.png", "id": "3696855400470303", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825503_3696855403803636_1315921602862827460_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShAQR_Dv18MQ7kNvwF9dov5&_nc_oc=Adqzcs-XxkB6pr1W06BEgzYMN1PrL8Swy_IvyTt1P1DdZ5qxnTlKkITaxRrARKFHth8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-8MA4y1BZtdUPdRbDSsexePa2W2WrFXYWxNRfOX4hFg&oe=6AE75A15"}, {"file_name": "layered_icon_composited.png", "id": "1771513494273757", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827973_1771513497607090_3610568119963936512_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLE9yhJJTlwQ7kNvwFJJUfP&_nc_oc=AdopVpwCkBvBfH7wxLFC_bb4rPdJTjyQCDdC3NXVvtvuMiF7zWsbvu3VTpEQz1hI5Jk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2XezSU1lwN7_yXegl22ozPUna0l868D46rGmOq40SRQ&oe=6AE7632C"}, {"file_name": "hero-3000x900.png", "id": "1760952771711321", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823812_1760952775044654_6080762916608024718_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7_j5-Fhl1cQ7kNvwFt65YQ&_nc_oc=Adr8fMANZMGUTEfCOzMTSUYrulp7PzUqQdOfClR9a2BC8S_OSaDHGjhqevS5Pv__BwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0rxwAWD7Xx4O0c_rnjYRHgWva-GQc_Sv2qwTUn3DVNA&oe=6AE742E2"}, 
0f&oh=00_AQKBgM8Qcvd7Ce8ASVEl5hzxBq-j701bjUl8OVDrLtV5fA&oe=6AA403D4"}, {"file_name": "image_2024-04-14_002455010.png", "id": "370423235990728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031422_370423239324061_8723616637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JhO_G44q44Q7kNvwFYaMX7&_nc_oc=AdpEa8VxZNcZbiWWXNVJ0Fi64K8EGpCetoZXmzjwwByRxMvSXGowhZzK06Yd3pKUJCY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPCaftpfu6oij6ouekIbfQ9pu_zCrvXI8Ge1DwkmIYlQ&oe=6AA3F4CE"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSQb8QV-0cYQ7kNvwF7_bcP&_nc_oc=Adqx_FXeAKL6LB1KFUOMIW1toZa0vv_0DeqV6U3klDYPt02W-c1fp7MNy_EFdkscxy8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQhQ53AcvI31NguzUXpheWgFZHioYcDVq7FaS-M5HZcA&oe=6AA40953"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view/lnfvr/home?auth
16637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hlYSadr3NbgQ7kNvwEIEQ6e&_nc_oc=AdlxCDKlfNoyGW4g9G1AgxPpXVFfvJA1rKZ_fzMe4KZSIELaI_pnoUqKfr7RA2Sr40I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyjPKd5nyvNYYJrLUM1QBX1PbUygmMzr3ibnYQ_Bwfmuw&oe=69BBECCE"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtjwR89ljHsQ7kNvwGUVtso&_nc_oc=AdnGzLtQfJWNU7RkxcT9QRuCZmwM5s3VQEmeYzjBocHU5rh5efAZNbnPbu0jKl5bQII&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBNspUbwdoIR79ZJwcrfFus1to3AxhVB3IRW_tn1J_XA&oe=69BC0153"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view/lnfvr/home?authuser=0", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "ge
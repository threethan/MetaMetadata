149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZcmX-o97vIQ7kNvwGu20Um&_nc_oc=Adr5aaxH4qxRt6Y_RO9usnsM-T-o3OyIBEWMhqZYWF4pPI8U3onCEuQEPt5Y18tMJ6s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvzyWxGSWLV-esleZwZXBkznkGXT3nlqJyYIo6vRctew&oe=6A857E93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view/lnfvr/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "91470462
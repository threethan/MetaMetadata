UQIwT18AgqA9XUZ2slsrIcwxFWbk3mrw-BzBN_A&oe=6A6A01D4"}, {"file_name": "image_2024-04-14_002455010.png", "id": "370423235990728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031422_370423239324061_8723616637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10CUfVR_J5QQ7kNvwHxKODy&_nc_oc=AdpyDFUmm-gNU1LG6PaYpgdjdEjIUVBjUMBMTEnIpXpvdds8LzKHgTtPtZ80qdwOFyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB_x4PvMcvYl-fA3IQV3oV4kLfhweY281XrUi4HAPdFA&oe=6A69F2CE"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4C11EvlvP0Q7kNvwHp19LW&_nc_oc=AdqcRQ35FKTksuwCQwhBcj-TU4e4Qkwx3WFVIPSaWTFMIGuyyvPq_hsGx-OlPo6StcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1FUGltE4ygqNmlMJKWh6VCYAQmvAulxPQX-cpbVQBXg&oe=6A6A0753"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view/lnfvr/home?authuser=0", "category
O-FQbbKXwJhCd8UJ9Dhy3_hbzvTHOFkT40aZvZQ&oe=6AE74054"}, {"file_name": "image_2024-04-14_002455010.png", "id": "370423235990728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031422_370423239324061_8723616637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zF9Vk1PEkwQ7kNvwGN12Ul&_nc_oc=AdqU3OxztruytiDGjGvQ6pbXZ71TG3zVGkb53N3Kb5pGqLlWoBjGkxlHVd0bzTy-qKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHCYln_adQnQisf7vL5v9tE7R1fzfgr0KZc2-v4qzaIw&oe=6AE7698E"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Xd__Ye_Y8gQ7kNvwFBDNxv&_nc_oc=AdrJq_oMngRxNBeVQbaYcSEPTmXS3BdS-4UGRIa_IqvhpZXYcb6RmlEGuwzRoQzLtRs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUZPi2OwMreii-AfWCT1xk0u-hl-iWlOliC0-YbIsxRg&oe=6AE745D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view/lnfvr/home?authuser=0", "category
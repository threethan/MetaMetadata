0f&oh=00_AQLro0tG514-0qdEdjnWZCn1d37ipB9DPYptpd8b2Dyk9A&oe=6AA949D4"}, {"file_name": "image_2024-04-14_002455010.png", "id": "370423235990728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031422_370423239324061_8723616637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey_u9jVwWSUQ7kNvwEamRQv&_nc_oc=Adpx5EXSzng-pQtRQDUMSOV0PJ9gP7FwVhWWIX_4r2H-WJMOrE_2e105nwFr6e0vPA4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnDvyRGmkRWBqoB3cLqx7hpa8i5BdvdyWg1ANOMMt7Sw&oe=6AA93ACE"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efSCk26lhhsQ7kNvwHYdzIG&_nc_oc=AdpC8-JRocl2KTb3ZOuWbRBAt-5JM1fQd9XlC6--IUW5lIeRG1jYEqGCH_Gw6QFTwBE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfvljHerIqh57K_lXq1ULB2pS8iyUIkTxRNgdmumN5gg&oe=6AA94F53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view/lnfvr/home?auth
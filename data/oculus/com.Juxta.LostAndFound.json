n.com&_nc_ss=7f20f&oh=00_AQFVAdtkcPj7NT4o64p7h_O4KVVwTrovkxDPRSDK7t4-LA&oe=6A85B154"}, {"file_name": "image_2024-04-14_002455010.png", "id": "370423235990728", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031422_370423239324061_8723616637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HwV1Grkc90Q7kNvwHg5Noz&_nc_oc=AdqtZbZHEM2UXV_GoVhBObR5iKsuSoyb7MuBN5TA_h-JbGCOH4rE8wLkmGAS678d05E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8fPzb34tHsqyfZ0tyuAMQf7QSn4ElIxioU2zAr1nYBw&oe=6A85A24E"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZcmX-o97vIQ7kNvwGu20Um&_nc_oc=Adr5aaxH4qxRt6Y_RO9usnsM-T-o3OyIBEWMhqZYWF4pPI8U3onCEuQEPt5Y18tMJ6s&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvzyWxGSWLV-esleZwZXBkznkGXT3nlqJyYIo6vRctew&oe=6A857E93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view
0f&oh=00_AQEehRRDUlqNBtCqa8iC_xpop_yFnmO7ixnntPnz8nVczw&oe=6A7DC854"}, {"file_name": "image_2024-04-14_002455010.png", "id": "370423235990728", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031422_370423239324061_8723616637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWDGx7gOV48Q7kNvwHF4aoX&_nc_oc=AdpYklHn9SqFVnoYR9D5lmA3PSyHX8sov8cOKXUUlLPvEHyugPt0SqoFMevxZfMjJ4A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWRrrTmOlfvVMNMm6_QmNYFqfld5aquQYmx4sTKHtFyQ&oe=6A7DB94E"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfECFI4qaIkQ7kNvwH9bC_V&_nc_oc=AdqMvrAAcThu5kzr1IA8ArktrcVt1Cuh1mCiaZyVTt0j-urgo5X6RxZCSLvC7Yb6k0c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnXHKdrxS3Z14Gg3pVVQO9HYAIKKc0hKJBvKfmjrumLg&oe=6A7DCDD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view/lnfvr/home?auth
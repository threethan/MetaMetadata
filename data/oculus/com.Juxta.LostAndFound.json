RtyEziyL8fClrcZ193f7El2_a-fqxODhQo5K_CA&oe=6AC25654"}, {"file_name": "image_2024-04-14_002455010.png", "id": "370423235990728", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031422_370423239324061_8723616637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NseYMV4r5O8Q7kNvwFfBif1&_nc_oc=Adpyj-kXhULmVyR4jGJ8AayoX9UPrYdu7ArlmBih0fXmmA4lK5frh4LxccXbakc4p_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIgqABoi9TY0TczZUilLNjOodKQjqhSC8Ta41lycGLIg&oe=6AC27F8E"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lmoDWbd684Q7kNvwFdB7E3&_nc_oc=AdrrqRGLzW6KMWl2kV-V_tfTra7hFimHLktwvxTA9dUXlUdW1cs-U04mncCQ5sB3DAY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyNvFQdo0e7um_zMzi8iCZKqwi3QPMXMLdG55dgGs43w&oe=6AC25BD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view/lnfvr/home?authuser=0", "category
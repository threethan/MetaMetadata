n.com&_nc_ss=7f20f&oh=00_AQE2QCHScxhYijAde71ogHbxudzoepWx9gpNEl0kXO-TtQ&oe=6A8D9A54"}, {"file_name": "image_2024-04-14_002455010.png", "id": "370423235990728", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031422_370423239324061_8723616637330224569_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-FoMAqVLaYQ7kNvwEMU0ab&_nc_oc=Adp_kp8PWUAiLtFaIaTenD_9n8pxkK9wVK7C1YCTnN_FjBb44_f2G-o_4dX-IPcexc4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO9VWIiyLuZ5WNUj_1cPNYFeJ8jLX3yFryzd2dWLZeWA&oe=6A8D8B4E"}, {"file_name": "image_2024-04-14_002522155.png", "id": "1353098255330816", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75429292_1353098258664149_7935344009888940499_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYgHxX7pt1oQ7kNvwHCXXZC&_nc_oc=AdppMZH3Zm-mbdPGpZ4o_LeTu0jZWQXowjsKyfypfTYW8NxoJxAMF-3ao6-aURSV65g&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzZjRUiWh8e7rLULD84OTez1OpbE97X-QV2Dj3oP9o3w&oe=6A8D6793"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lost & Found: NIGHTMARES", "keywords": [], "long_description": "Ever been lost... Not being able to find a way out? When you've been alone, have you felt someone watching you from a distance? Well, in this game you're lost... don't know where you are, don't know what time it is, losing your sanity ever minute and second trying to find your way out... But you're not... \n\nYou're found.\n\nLOST AND FOUND\n\nThis game is a horror game with gorilla tag based locomotion. Traverse around.. What is it, a lab? I can't tell myself. The meat tunnels, and encounter\ncreatures that are... strange.. VERY very strange....", "short_description": "Where am I?"}]}, "developer_name": "MikeBite", "developer_privacy_policy_url": "https://sites.google.com/view/lnfvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "MikeBite", "support_website_url": null, "website_url": "https://sites.google.com/view
_teMQ7kNvwGftJNn&_nc_oc=AdpSXJ8GOBAe3SFmPsT3ifwQ2k55ZYXdJNSXURbNxI6AC08m0Dqp0O32ZJ_6bU_yD8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTBpJTx_qqc3ZyX2FX0x2bFA4g-lxDZuPjrzVsCalzXQ&oe=6A51085A"}, {"file_name": "ScreenShot2-2560_1440.png", "id": "1541814797318584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620940_1541814803985250_5039399850075328611_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3Og_VE4OVIQ7kNvwFTAKD9&_nc_oc=AdrDFRw4ddf4tPDM7WKr0VCZpSInE9P-3y8gg56rhWdARiWZT4gbo-EsoKwDmJUGvFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5T9lwn-19lboHx8saSTJ7Nlg_sVv1fOZDRGAjtPZfmg&oe=6A50EB35"}, {"file_name": "ScreenShot4-2560_1440.png", "id": "1347349314166563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623443_1347349317499896_162904102102499654_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3jHiHGt_9IQ7kNvwEWKRiv&_nc_oc=AdoqCVBY6E_ToEl30aMMcT750UBlV8lg2IN55BA9cHRpfcxHI1N4dqEC7W79Dl8OCL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNlwPqVzXci0dbHaVL_ugm7pmbZOnWmy8CPlkCYOWkxA&oe=6A50EA28"}, {"file_name": "ScreenShot5-2560_1440.png", "id": "1618179629277781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/654944867_1618179632611114_4762752347605458143_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtzkJzRUP1YQ7kNvwFAscVS&_nc_oc=AdqyOUSFAzdbSURHu96HYBXyteehJ5v6zXcfUtsqktLAGCI8ZlqU1dluhqg54SebBSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY987PePFr-nWOq6Isw3C0NFY-jQlKDwbTWw4KHQk6Gw&oe=6A50F744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape-2560_1440.png", "id": "1346952047319866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623345_1346952053986532_5659872139056325564_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2xzeRmXjPUQ7kNvwFv6CRb&_nc_oc=AdqwrrFS2LlWbCGef3MiqKOB8zVnvlfe5aXFcexgVv4ZXzqx56jAk8dmGps0MRULgfk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJo6vk2wo0mjTT2mN1jYY_TJVrxNWJSeMkf68GOXMkBA&oe=6A510213"}, "display_name": "Cibus Survival", "keywords": ["Roguelike", "Survivorslike", "Roguelite", "ArmSwing", "Survival"], "long_description": "Welcome to the early demo of Cibus Survival, an adrenaline-pumping VR Survivors-like with thrilling roguelite mechanics!\ud83c\udfae Survive the endless swarm, score high, and beat your own record in this intense roguelike challenge!\n\n\ud83d\udcd6 Survival Guide\n\n1. Move & Dash: Swing your arms to move. Need to escape a tight spot? Press both Triggers simultaneously to dash! Monsters constantly walk toward you, and touching them drains your HP.\ud83d\udca8\n\n2. Get Stronger: Defeated monsters drop XP gems and Gold. Level up your weapons and scrolls to build powerful roguelike loadouts and become unstoppable!\u2694\ufe0f\n\n3. Field Objects: Explore the map and build the ultimate loadout!\n\nJars: Approach Jars to secure extra XP and Gold.\ud83c\udf6f\n\nChests: Spend your Gold to open Chests for powerful items.\ud83c\udf81\n\nShrines: Stand inside a glowing Shrine for 5 seconds to permanently boost a core stat.\ud83c\udfdb\ufe0f\n\n4. Altars & Yetti: Stand on the 4 Altars for 5 seconds each to activate them. Once activated, the giant boss Yetti descends! Dodge its attacks and eliminate the threat.\ud83d\udc7f\n\n5. Final Stand: Warning! Survive past 7 minutes, and the true challenge begins. The difficulty skyrockets as massive hordes of stronger monsters flood the map. Fight until your last breath, record your final score, and try again!\ud83c\udfc6\n\nJump in, swing your arms, and see how long you can survive the swarm!\u2728", "short_description": "Swing your arms and run for your life in Cibus Survival, a fast-paced VR Survivors-like infused with action roguelite elements! \ud83c\udfc3\u200d\u2642\ufe0f\ud83d\udca8 \n\nEndless waves of monsters are coming right at you. Defeat enemies, collect XP, and build unique roguelike synergies as you continuously upgrade your weapons and stats to grow stronger. \n\nSurvive as long as you can, find and activate the 4 Altars to summon the Boss, and push your limits to achieve the ultimate high score!\ud83d\udca5"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludensgame.com/policy", "developer_terms_of_service_url": null, "publisher_name": "LUDENS Co., Ltd.", "support_website_url": "https://discord.com/invite/P3qsRGVWD9", "website_url": "https://ludensgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27308080088847119"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1701263254230341"}]}, "baseline_offer": {"id": "1701263254230341"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781024820, "status": "PUBLISHED", "id": "1701263254230341"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27285996891055439", "version": "0.1.1"}, "id": "447483501010110", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7575718825843205", "is_concept": false, "latest_released_binary": 
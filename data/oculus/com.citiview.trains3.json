a&_nc_ohc=xi-6lDhmcPEQ7kNvwHLbOao&_nc_oc=AdojWLin7htnGQGJ-O-sjoB_ViI_zywUfN9EvGqkw43DqXBQhG7cywIdSU8cfnDimmA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWjNJ0UsExIYxx5DJBrxTaTHV3wpoLcojOHXVRgbpuqQ&oe=6AF0942A"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1907311383986394", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_1907311387319727_7389164918107722005_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAPxikn3TDQQ7kNvwHSzbCA&_nc_oc=AdqMhmtpce0h0FIaxQukN38BIe2o_-phrTZ2wgmR4ZR5dbAE1_rvSN5dUJpBlTMVXww&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR00GURMrDMQPCP4hg9v0M89fRTPpEIT1ZvsZbVaoqPxg&oe=6AF08198"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1437768695135515", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673531334_1437768698468848_8511870475069551024_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9wfvhX5m-IQ7kNvwEFbZ-t&_nc_oc=AdrlWVNnAkx0Mp1KBWuc3dIqh4vexexWt90AU2vhOi6uy7eYer0xBE-spAxwKqe2r9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoHOjBLB8bwtwYbzKrXx8h3zzaSqWT3QXrUxMckYjMzg&oe=6AF086EC"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1365787815331013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1365787818664346_3437399523621632614_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO_UnGPSGwcQ7kNvwFXt5nY&_nc_oc=AdpLFYXCxfnIdxjkyJWloKZ7Ysuq9wZ9ouG_GURf-5QTBCjiTBjUV5Ip8nedoEMWRhU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOUa9l30zIp0b6I-8Vn7Uz_068Og35C6WEZLZjmLd11w&oe=6AF09827"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1048121574895831", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604328314_1048121578229164_3348001466108496964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etF5IR0bpcoQ7kNvwHixANU&_nc_oc=AdoFf8094YD9EspYxTIFgbBIQH0ZU859DKM-fF8Nru5Cnp37XJmH881k0DBaPN-ZML0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF0VoU6WtlC7FF5w61rbBF78ed4cJWKTqhvkWVhSQwWQ&oe=6AF08EA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2332978414113244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_2332978417446577_5628774246425668383_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMlu6GI3wPkQ7kNvwEDaUiz&_nc_oc=Ado5NaglpOD7xZXvs9JDoDa8bVhofuKw50mgNX-L4kwSx6OwYsbBVq6iVNE1P24oPeE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS3C40omPKtobopi9Oq7jYZVwvOxjY44XMJz5YDbCZuA&oe=6AF08FB3"}, "display_name": "Trains 3", "keywords": ["trains", "railway", "builder", "sandbox", "cozy"], "long_description": "Your own railway, in a room you will not want to leave.\n\nTHE LOFT\nA warm timber-and-walnut loft lit for the evening: a real fire in the stone hearth, leather club chairs on a Persian rug, brass pendants over the floor, framed railway posters, a workbench, and tall windows with the sun going down behind the hills. Every surface is a real physically based material - oak, walnut, plaster, stone, leather and brass - and the whole room is baked in warm light.\n\nBUILD\nPress Y for the round build wheel. Pick a straight, a turn, an S-curve, a hill or a climbing curve, aim it at the end of your line and it snaps on. The track is the real thing: gravel ballast, timber sleepers and steel rails.\n\nTWELVE TRAINS\nSteam locomotives with tenders and coaches, diesel freight haulers, and bullet trains with a nose at each end. Twelve more wagons couple on - containers, hoppers, flatbeds and coaches.\n\nDRIVE\nPoint at any train and take the controls: trigger to go, brake with the other hand, back up at the end of the line. Sound the whistle and pull into the station for ALL ABOARD. Take a tight turn too fast and you come off the rails.\n\nA LIVING RAILWAY\nThe other trains drive themselves, slowing for curves, waiting at stations and keeping a safe gap.\n\nAlso: stations, tunnels, signals, trees, a water tower and lamp posts, three ready-made layouts, undo, auto-save and a jazz soundtrack.\n\nDeveloped and published by Citiview Studios.", "short_description": "Build your own railway in a warm timber loft made for grown-ups. Snap straights, turns, hills and climbing curves together from a round build wheel, lay real ballast-and-sleeper track, and fill it with twelve trains - steam, diesel and bullet - then take the controls of any one of them. A fire burns in the stone hearth, brass lamps glow, and the sun sets through tall windows while your trains run."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/trains3/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trains3/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1249812928224680"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1403027125270026"}]}, "baseline_offer": {"id": "1403027125270026"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790264280, "status": "PUBLISHED", "id": "1403027125270026"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1249826488223324", "version": "1.0.0"}, "id": "184194998
nt-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOUa9l30zIp0b6I-8Vn7Uz_068Og35C6WEZLZjmLd11w&oe=6AF09827"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1048121574895831", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604328314_1048121578229164_3348001466108496964_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etF5IR0bpcoQ7kNvwHixANU&_nc_oc=AdoFf8094YD9EspYxTIFgbBIQH0ZU859DKM-fF8Nru5Cnp37XJmH881k0DBaPN-ZML0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF0VoU6WtlC7FF5w61rbBF78ed4cJWKTqhvkWVhSQwWQ&oe=6AF08EA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2332978414113244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_2332978417446577_5628774246425668383_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMlu6GI3wPkQ7kNvwEDaUiz&_nc_oc=Ado5NaglpOD7xZXvs9JDoDa8bVhofuKw50mgNX-L4kwSx6OwYsbBVq6iVNE1P24oPeE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS3C40omPKtobopi9Oq7jYZVwvOxjY44XMJz5YDbCZuA&oe=6AF08FB3"}, "display_name": "Trains 3", "keywords": ["trains", "railway", "builder", "sandbox", "cozy"], "long_description": "Your own railway, in a room you will not want to leave.\n\nTHE LOFT\nA warm timber-and-walnut loft lit for the evening: a real fire in the stone hearth, leather club chairs on a Persian rug, brass pendants over the floor, framed railway posters, a workbench, and tall windows with the sun going down behind the hills. Every surface is a real physically based material - oak, walnut, plaster, stone, leather and brass - and the whole room is baked in warm light.\n\nBUILD\nPress Y for the round build wheel. Pick a straight, a turn, an S-curve, a hill or a climbing curve, aim it at the end of your line and it snaps on. The track is the real thing: gravel ballast, timber sleepers and steel rails.\n\nTWELVE TRAINS\nSteam locomotives with tenders and coaches, diesel freight haulers, and bullet trains with a nose at each end. Twelve more wagons couple on - containers, hoppers, flatbeds and coaches.\n\nDRIVE\nPoint at any train and take the controls: trigger to go, brake with the other hand, back up at the end of the line. Sound the whistle and pull into the station for ALL ABOARD. Take a tight turn too fast and you come off the rails.\n\nA LIVING RAILWAY\nThe other trains drive themselves, slowing for curves, waiting at stations and keeping a safe gap.\n\nAlso: stations, tunnels, signals, trees, a water tower and lamp posts, three ready-made layouts, undo, auto-save and a jazz soundtrack.\n\nDeveloped and published by Citiview Studios.", "short_description": "Build your own railway in a warm timber loft made for grown-ups. Snap straights, turns, hills and climbing curves together from a round build wheel, lay real ballast-and-sleeper track, and fill it with twelve trains - steam, diesel and bullet - then take the controls of any one of them. A fire burns in the stone hearth, brass lamps glow, and the sun sets through tall windows while your trains run."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/trains3/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trains3/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interact
sea5-1.oculuscdn.com/v/t64.5771-25/596061819_1907311387319727_7389164918107722005_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymaRP_EWji0Q7kNvwHPezn1&_nc_oc=AdqQDbtKuS9Z_V7umfUbIXzSvfn72Z2yz9o-QOTcZF1n9U-Jmbm_PPrIbcSeldbnhC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH_ux3xnP3XH3AV_Gtr5c1z20lM6uo6STTfuq-nejHfA&oe=6AFC5F18"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1437768695135515", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673531334_1437768698468848_8511870475069551024_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcGUtOeysowQ7kNvwErcsP0&_nc_oc=AdqAoAK2FAX7CDIVjQTbcFmr9QUlNF-ou5GWsvgcMXFNOHqd-HljZBBtcV7fHSqtDp8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9v2vh3h0LI1TjE564wyY3WIdEyotX907dJoSzjP-ZWg&oe=6AFC646C"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1365787815331013", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595129854_1365787818664346_3437399523621632614_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozbpJJ1iA2gQ7kNvwHQvSp8&_nc_oc=AdrSc7u8xRSnLzRMId7TrbfP9RgnYLbXZUVefKroxYdI96UGO91M1vCv9-1tqacdG-Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmzuHqb4xxOtKqbW0Zdl8wSoxKpvPtP9dMBkFemCQuIA&oe=6AFC75A7"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1048121574895831", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/604328314_1048121578229164_3348001466108496964_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfyVGXG65bEQ7kNvwFM3-YU&_nc_oc=AdpG-46l26I789wIFPqyZNPgCNx0gx29y7Dz7zSCVvwCSxcUvNtiXMxr1nG0rOrnp8E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdj-aquez9VVEkMNaNr_K3ls0xJquatg4YC9eESy_MjQ&oe=6AFC6C21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2332978414113244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_2332978417446577_5628774246425668383_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Isb3ogr1jkQ7kNvwFSWwuT&_nc_oc=AdocWKeHo2ym2OJLanAIBQCR5d6v71pWYUzhbT5YzpChAbBCs3vIvxjZtxDeLZKsf8w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2WYX9qG61qOHK_7h187IYXoFvdJlLMLKjoPFvuD3VTA&oe=6AFC6D33"}, "display_name": "Trains 3", "keywords": ["trains", "railway", "builder", "sandbox", "cozy"], "long_description": "Your own railway, in a room you will not want to leave.\n\nTHE LOFT\nA warm timber-and-walnut loft lit for the evening: a real fire in the stone hearth, leather club chairs on a Persian rug, brass pendants over the floor, framed railway posters, a workbench, and tall windows with the sun going down behind the hills. Every surface is a real physically based material - oak, walnut, plaster, stone, leather and brass - and the whole room is baked in warm light.\n\nBUILD\nPress Y for the round build wheel. Pick a straight, a turn, an S-curve, a hill or a climbing curve, aim it at the end of your line and it snaps on. The track is the real thing: gravel ballast, timber sleepers and steel rails.\n\nTWELVE TRAINS\nSteam locomotives with tenders and coaches, diesel freight haulers, and bullet trains with a nose at each end. Twelve more wagons couple on - containers, hoppers, flatbeds and coaches.\n\nDRIVE\nPoint at any train and take the controls: trigger to go, brake with the other hand, back up at the end of the line. Sound the whistle and pull into the station for ALL ABOARD. Take a tight turn too fast and you come off the rails.\n\nA LIVING RAILWAY\nThe other trains drive themselves, slowing for curves, waiting at stations and keeping a safe gap.\n\nAlso: stations, tunnels, signals, trees, a water tower and lamp posts, three ready-made layouts, undo, auto-save and a jazz soundtrack.\n\nDeveloped and published by Citiview Studios.", "short_description": "Build your own railway in a warm timber loft made for grown-ups. Snap straights, turns, hills and climbing curves together from a round build wheel, lay real ballast-and-sleeper track, and fill it with twelve trains - steam, diesel and bullet - then take the controls of any one of them. A fire burns in the stone hearth, brass lamps glow, and the sun sets through tall windows while your trains run."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/trains3/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trains3/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1249812928224680"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596149727_995604219606456_6730149193451297125_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXdDVxy7m98Q7kNvwHoyJRc&_nc_oc=AdoAl2Me6umPpbcuJUG9P0EZHVSawdBwElqgGd2t_gKeSoGEGGa-Y8MFCwAFtMlprkk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTir4P0VPvXkdnxfYoYjEwjHDRgnAOb8Ih_0DHgdvJKaQ&oe=6AFC71D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trains 3", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id":
442Y3OEfj33XR7gHrYbnw&oe=6A2EC98F"}, {"file_name": "Untitl2222222222222ed.png", "id": "1262546608972341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_1262546618972340_3067672607794425914_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juGXxIPYMsQQ7kNvwFPwGpa&_nc_oc=Adp7_vePpZ9bwWXA3eUhvoI8YLuOKuN-Ybdd5UCaCoXruI6lYXypYgwxnVIHQQilwG4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94Mdih_2J-FdyEDTswV_etO7PYlmeotdU3GSN-7pn4_Q&oe=6A2ECEC2"}, {"file_name": "Unti453453453454tled.png", "id": "1322215325640204", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1322215328973537_6429850499452151723_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duMhjGMcGCsQ7kNvwGJBRBk&_nc_oc=AdrH_ZK0SWZRGw31HM_6WHpV7GinWHINbRftH09T_UmYa0VkxNugWN58J-DJFyvFvxE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rakX0q00qROJATsgTF2CUaPGsxQPhv4UuTYKYFG4h4w&oe=6A2EC485"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bodus Tag 2", "keywords": ["mods", "gorilla", "monkey", "project", "taggers"], "long_description": "Bodus Tag 2 is a fast-paced, movement-based VR fan game inspired by the viral hit Gorilla Tag \u2014 but with its own weird twist. You spawn in a massive box that kind of looks like a forest\u2026 if forests had floating cubes, glowing platforms, and zero concern for physics.\n\nWall climb, cube-hop, and fling yourself across the map using only your hands \u2014 no buttons, no joysticks, just raw momentum and monkey muscle. Whether you're running from other players in a high-stakes game of tag or just messing around with your movement, there's always something to do (or break) in Boda's world.\n\nWith parkour challenges, low-gravity moments, and a trippy, chaotic energy, Bodus Tag 2 is perfect for anyone who just wants to monkey around. Literally.", "short_description": "Swing, jump, and climb in this chaotic Gorilla Tag-inspired fan game! You're a fast-moving primate trapped in a giant box that looks like a forest \u2014 with floating cubes, random structures, and wild physics. Parkour your way to freedom (or just vibe) as you bounce around the low-gravity jungle gym. This game also has mod menus!\n\nTag or be tagged. Climb or fall. No rules, just movement."}]}, "developer_name": "Vold", "developer_privacy_policy_url": "https://docs.google.com/document/d/1xVILwqDZESYiEd5kE6jZjhIzcZupdeUm67L7UtQ1XTE/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Vold", "support_website_url": null, "website_url": "https://sites.google.com/view/bodustag2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24834247712894591"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618512_1216285527000300_6884757671528396711_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=NItQHRJLcxEQ7kNvwEvmFZF&_nc_oc=AdoZ6sLKUucTuqhV_HefqopMc9bsIpARXddjNuzkXBqyw8Sz5cb0jdsJtDYHo1EGp7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JTKLhOKNLbpXKUFUsm9UahpL2J49qd4GyvOGuefqrIA&oe=6A2EB08D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bodus Tag 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}
tent-iad3-2.oculuscdn.com&oh=00_Af2w0OFiwW7jJt0938D26OvmhvxJDXZ5f3K_N4egP8q3jA&oe=69F0BA0D"}, {"file_name": "Untitled44444443.png", "id": "809885552009439", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823901_809885558676105_381947385807812963_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgjM7axNyZwQ7kNvwFpPTUH&_nc_oc=AdqkiYr0eM4c795Eaa-6rWuL7eh7TsRroQP4F84ABqCicGVtYtPlY_i2uZpIAw1zVuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0uPfayrFjpulAKj0Z3maYP048mR5q6cQgf_fe9Dv4Hdg&oe=69F0B237"}]}, "id": "965192592473090", "locale": "en_US", "screenshots": [{"file_name": "Untitle4444444444444444444d.png", "id": "1421867415617948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821081_1421867418951281_1782546877005787981_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suGFGwYgxagQ7kNvwE_vYSY&_nc_oc=Adre_p4SFMMmv_TP2L3anRGDzUiZhiTfdvcHSeLEYxj6s4VYFm8-hXALuL42fCiZz4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1AVgtSrKgPU9GwYRbGa-DcxSlC8ppramYkLGvMVMrf4g&oe=69F0C86B"}, {"file_name": "Untitled44444443.png", "id": "1188813229825031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1188813233158364_2126717238946301489_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOEenYX1JpEQ7kNvwEhKBnw&_nc_oc=AdolDycGwaM0UJlHljUua4OrkK-KlIB-DWrtNx2_edzvKzFtAVCqxJAB74cgbhCSjes&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1K-ycmpzFaLNJV-B_p5ONRdLDti69UuX2BR22g1bmsVQ&oe=69F0BE93"}, {"file_name": "Untit5555led.png", "id": "1222125273270241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1222125279936907_8640754341105622592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8tL1PahPMwQ7kNvwHR4TLt&_nc_oc=AdoGN_QxqZjbGlQOhQpMqB4JEnyTgaw3ydTQFU60J6ScFGmqbCew54QsD1vZ7fB5xNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af37qrOfeap6zU4-SMNIJEcCnWq5WB5ZBxNuEfzgl3hXFA&oe=69F0D30F"}, {"file_name": "Untitl2222222222222ed.png", "id": "1262546608972341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_1262546618972340_3067672607794425914_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuMQ_LiDSosQ7kNvwHJ7JGb&_nc_oc=Adrfka_JPL4zN6kQDZXBJvNXEYrCypKsMiQXa9hsL73eUsm42C_3QFah5wJCSa8Sx1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2Ng3mPxw2P8oap6pKSaraz_T4QS3svxaYIezqCVSabaA&oe=69F0A002"}, {"file_name": "Unti453453453454tled.png", "id": "1322215325640204", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1322215328973537_6429850499452151723_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQhqpC6IORIQ7kNvwEqy8kA&_nc_oc=AdqAeHCts93_8odLMwkgiIMLXNObI0JKAu7zvEurvQX4B35g_8vw_PPjFq7-mdCK0a8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1Ru-N_GopYW2ZQsDihyc8Dy1DhbxJmOTrQsvuL72nCNQ&oe=69F0CE05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bodus Tag 2", "keywords": ["mods", "gorilla", "monkey", "project", "taggers"], "long_description": "Bodus Tag 2 is a fast-paced, movement-based VR fan game inspired by the viral hit Gorilla Tag \u2014 but with its own weird twist. You spawn in a massive box that kind of looks like a forest\u2026 if forests had floating cubes, glowing platforms, and zero concern for physics.\n\nWall climb, cube-hop, and fling yourself across the map using only your hands \u2014 no buttons, no joysticks, just raw momentum and monkey muscle. Whether you're running from other players in a high-stakes game of tag or just messing around with your movement, there's always something to do (or break) in Boda's world.\n\nWith parkour challenges, low-gravity moments, and a trippy, chaotic energy, Bodus Tag 2 is perfect for anyone who just wants to monkey around. Literally.", "short_description": "Swing, jump, and climb in this chaotic Gorilla Tag-inspired fan game! You're a fast-moving primate trapped in a giant box that looks like a forest \u2014 with floating cubes, random structures, and wild physics. Parkour your way to freedom (or just vibe) as you bounce around the low-gravity jungle gym. This game also has mod menus!\n\nTag or be tagged. Climb or fall. No rules, just movement."}]}, "developer_name": "Vold", "developer_privacy_policy_url": "https://docs.google.com/document/d/1xVILwqDZESYiEd5kE6jZjhIzcZupdeUm67L7UtQ1XTE/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Vold", "support_website_url": null, "website_url": "https://sites.google.com/view/bodustag2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24834247712894591"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618512_1216285527000300_6884757671528396711_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=MGrgkumWmA4Q7kNvwF2Jx1k&_nc_oc=Adpj-6UuQPBE1HRXfT2l0rUQ1sYgzNyUN8Yhg0kUZ44t5Rdx2s35_x88isTGs3w0Cd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2sSX57AqAq3RQuh1_YzKYJmufV2202DEseSRW_eNMQBQ&oe=69F0BA0D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bodus Tag 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date":
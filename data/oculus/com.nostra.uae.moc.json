5.png", "id": "906262231097189", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974802_906262234430522_2379878576983079290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dW1xOdVHzSoQ7kNvwE8GTVY&_nc_oc=AdoXITYT1G7d-hl5jcROVEf7lB44zx43p5UNQJNegFSASvDX0GIEIpO1SxBTiKLR60c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBz-clEyTKBla73Q1Jd0W1tdyTOplzevDb8S5VfulBTw&oe=6B031061"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UAE Culture Center", "keywords": ["UAE", "Culture", "Museum", "Gallery", "Heritage"], "long_description": "Step into the UAE Culture Center, a virtual space dedicated to celebrating and sharing the diverse heritage of the United Arab Emirates. Through our VR app, you can experience a range of cultural offerings \u2014 from art exhibitions and traditional performances to interactive displays that bring Emirati history and culture to life. Whether you're exploring intricate art pieces, joining live cultural events, or learning about the UAE\u2019s traditions, the UAE Culture Center offers a unique, immersive experience. Ideal for those seeking to deepen their understanding of Emirati culture from anywhere in the world.", "short_description": "Discover the rich heritage of the UAE through immersive VR experiences. Join the UAE Culture Center to explore art exhibitions, cultural events, and interactive showcases."}]}, "developer_name": "NOSTRAVERSE LTD", "developer_privacy_policy_url": "https://www.nostra.ae/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": " NOSTRAVERSE Metaverse Services Provider LLC", "support_website_url": null, "website_url": "https://www.nostra.ae/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscr
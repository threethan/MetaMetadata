content-ams2-1.oculuscdn.com/v/t64.5771-25/39035424_1365992617564247_196057820963030135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyf-lljFVcwQ7kNvwGEHBfr&_nc_oc=AdpsIIIzy_i-0a_s7VAG0cWBYf7SuUurBQjytpH1_LH-dv6f1_fkA2Xc-Uv3TwUmGzg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-e5SE6UNRQfsxKXgmvy3AmsZPguXCuf6wev3W19cnSA&oe=69DA2E4F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epKnB8XhZTAQ7kNvwHcVf76&_nc_oc=AdrMY1c9M76jdiGigZu1m77VjafYKxgVskY57FPBC1ZQzQmXoH-FYJybWCuLB0d8iR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Fhh7dh7hIvrA3KKdiA-dKO_K_QKym6nvjH4udMXeqhQ&oe=69DA2DC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=98OqQejejpYQ7kNvwGI8aKc&_nc_oc=AdpsArwvpsPCDiN7wSFTi0pshfKGojVO2QzeRw_oZT-UqZ8aFg6uslkJVrbHDvnVRfg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m_CCgmOCcZ0SdkPwZS4TuKADyYNInzacsf1wp3mbqXw&oe=69DA3C75"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://karakuri-kengeki.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kento Tomonari", "support_website_url": null, "website_url": "https://karakuri-kengeki.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1218569015412235"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1187790993258567"}, {"status": "PUBLISHED", "id": "1622284199200270"}, {"status": "PUBLISHED", "id": "1423318382531660"}, {"status": "PUBLISHED", "id": "1555164275854896"}, {"status": "PUBLISHED", "id": "1321470085631526"}, {"status": "PUBLISHED", "id": "605878489063589"}, {"status": "PUBLISHED", "id": "503440432480530"}, {"status": "PUBLISHED", "id": "1952973088458420"}, {"status": "PUBLISHED", "id": "715962460709465"}, {"status": "PUBLISHED", "id": "729185712547457"}, {"status": "PUBLISHED", "id": "583920156845230"}]}, "baseline_offer": {"id": "1321470085631526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1187790993258
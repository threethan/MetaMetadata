uriKengeki_Logo_screenshot_3.png", "id": "689417049312624", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031531_689417052645957_2531460316095286781_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj4aTEfKW3gQ7kNvwGIvoBP&_nc_oc=Adqfpp-7PACG57oLfzFEuHLOz5__KEOWqdOuwA_D59jwm1yMrA3hV9oJZknpQQU824g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZyWqRdYjlkT4DmrBt4eL6rdK_EmypzJK6LKsObeGeZQ&oe=6A47DFF4"}, {"file_name": "KarakuriKengeki_Logo_screenshot_4.png", "id": "1365992614230914", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035424_1365992617564247_196057820963030135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nY5eaWAqdMQ7kNvwGOzExc&_nc_oc=AdrJQaCQ2rnQSzTq_ZwyNmJnK9IV__bVZbZGQTyThdlBuKYWWJMGUMSgqt9eHDqV4jk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_sz_VsaTBWYZUd3Q3iqQEb0Fkin34aCE4kbIFZce2Qg&oe=6A47D30F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDXKJWA2qmIQ7kNvwHP5-pi&_nc_oc=AdrPGufUheY-j128G5pA1Si5nwExiNuDkso_pmjn2FDqHUQp-iZyymTNoXf6KXZ3lKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LdwkJstHl2gLkyh_m94DfV9ZYBB6WFdDXjZt_WX6VyA&oe=6A47D289"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVRxKGsK5aYQ7kNvwE-itWu&_nc_oc=Adqtm190M2MZ9u-ZPthF9e5jImt8ARUMfY1pEE8PDZQsrTw45KeFvkkrptJV7PoSv7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jbjDc5XcC0OZkZMJeZsuOna1GWrnWu9cy8P9QziowiA&oe=6A47E135"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odd-team-xr.com/karakuri-kengeki/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/karakuri-kengeki/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24759217273694481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570312_653906563086985_6378840617626321496_n.png?s
sQogyUYSh2Oypw8INSCBMcKvptqHP3AAZhQ&oe=69A5724F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bSO3s_5nqoQ7kNvwEGiyTR&_nc_oc=AdlBMmn_ttZjSxpJnueWcmv3dEnBZYdzSKxiDyuucx-v-igpvmvEBTRLwM_BzsBJ0Ik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsOUYiUk8s4oGBCEZNHyJYjX8rbNGhZcvVpqsE1oPseNw&oe=69A571C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=andktKb97GAQ7kNvwEqvLkD&_nc_oc=AdkYlt_8o87a33WgrmHNMNcfCTmwvTK8_Riqk5iGQZ9_Ft2bHGEAHaj0M3Kiz_Qnyio&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvEJ5a2zSCm853KkmQJS_vLuAbG5n4q6NVq0K2j8XlTFw&oe=69A58075"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan."}]}, "developer_name": null, "developer_privacy_policy_url": "ht
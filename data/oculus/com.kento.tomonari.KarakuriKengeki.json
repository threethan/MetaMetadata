30135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV-OJEy_M00Q7kNvwFBuXTk&_nc_oc=AdnpOCojuNjP8ieiG-72xhhebiXYjGc34X6dw1n0KRBvYkP4LcMWEDW1DFD8BzGp-t8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afxg2wU6yvqHMjT5hUXo7LMObfr9ZUvWinobaN9kVJLxzA&oe=69AAB84F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQKrkRe60zYQ7kNvwE2H0Ch&_nc_oc=AdkZYsAIHAPw6myCTIQKVBzHZInxfGvgxP2zhD5xSZxtXxCk1_1CV_KMlZF6L9ldph8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPh7UYCT0tB6dor6-s_w1Ky2O0zfy_HaBmD5MmrO6x5Q&oe=69AAB7C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqLTFCkd52gQ7kNvwFY933m&_nc_oc=AdnpKN5li7w2yH4XggpXvC2CZnloOMziflv9XtMZtGAJ24TG1YE5j1BzPh108wgmkgY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_Oc06wE13f1v-R0-N9km_k-6pJy1E0ZtuxWsQwErqRQ&oe=69AAC675"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_desc
5286781_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iv08YLxdSkYQ7kNvwGx8Pj-&_nc_oc=Adm4B99XXJZK1Xqp0JlZIFeBV6jbdV5fwTNmQr_nRnuQltFMaC2P2KPVdX_8hU5QAAg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwiGFiZk2FRRDqjjEvqxhHlmENTVwxzz-n5Zp9zz19tLQ&oe=69BD3A34"}, {"file_name": "KarakuriKengeki_Logo_screenshot_4.png", "id": "1365992614230914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035424_1365992617564247_196057820963030135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=linwftyliHoQ7kNvwEILwGa&_nc_oc=Adl3esmjmH-pji9T8kD9JFV1e6Dk-8NFLUgMsrsuU9JeZN_UL05XJPw5z_PVtzoF9d8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk-NMf8Km1bA67eEAvrZ6-E2shNa5jTdu4yZg6vlDntA&oe=69BD2D4F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc_qidDhKtcQ7kNvwElIIX5&_nc_oc=Adna3s1FhOGQG_55R9kxvac_DhPEOxlFZvIuQNJQdnXLd6eTt06Py1BDg2BxSJZvL6k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEEB-2baCL_4rX0u-CGRFCPbTKCoaDogtzke-6vlQbsw&oe=69BD2CC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7YHGIZEdP0Q7kNvwEqOyhP&_nc_oc=AdlH8E9p4E-xO1Oz_5_k9M2CtAuWfmmQoIKIWtiYQpdOiFYJu62g2FlPqaVADQ76-I8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTRc-Qw6ViqOUcErnDABz9vdJkFVPj1nBlVo4UjAvfeg&oe=69BD3B75"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odd-team-xr.com/karakuri-kengeki/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/karakuri-kengeki/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24759217273694481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57570312_653906563086985_6378840617626321496_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efIkwWuqaFkQ7kNvwFTB89Z&_nc_oc=Admna0TZxfZHClbwBPyG7sLZF6L71Ao8HE7dWlkaGKEU_U8VTukbdGqbjTGKNIY8JMw&_nc_zt=3&_n
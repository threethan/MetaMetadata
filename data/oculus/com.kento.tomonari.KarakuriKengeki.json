content-fra3-1.oculuscdn.com/v/t64.5771-25/39035424_1365992617564247_196057820963030135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne1RhRnSPe4Q7kNvwGvcnXn&_nc_oc=AdpYEc0-vSOXn2SB1Ma3LB3dp2WVKtd_yrJzePTZaLs8bNVoy-RC-kfQ_aAm4YrtXcE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1byxzZeO_0M4B_clSxLOHph3z_D2GWhFqZ9f29qgtbxA&oe=69F6160F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INSDAqWqSxUQ7kNvwFatX46&_nc_oc=Adqe_1kMckUbXKFbPnX0b_YaZ0yslNSyPi-SF_ZLXoqJc5LmeppI5-Tt0g55GRMsJXE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ehQFeaMlD42lZG-8NZRneU2vgwD6KUtm-vnb94Id3bA&oe=69F61589"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRURYfo3k2wQ7kNvwHrKYtj&_nc_oc=AdqVqe4SwB1cmU5WL6dwcTGpKWopxlQgqmZ-FTEuXHprUtmu8B2KD3r_V1SAy9qhmVI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0K0yhmhjC1GVJuTyPhzSnl_S0WmHo1bjus0DHQ0dcMdA&oe=69F5EBF5"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://karakuri-kengeki.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kento Tomonari", "support_website_url": null, "website_url": "https://karakuri-kengeki.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1218569015412235"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1187790993258567"}, {"status": "PUBLISHED", "id": "1622284199200270"}, {"status": "PUBLISHED", "id": "1423318382531660"}, {"status": "PUBLISHED", "id": "1555164275854896"}, {"status": "PUBLISHED", "id": "1321470085631526"}, {"status": "PUBLISHED", "id": "605878489063589"}, {"status": "PUBLISHED", "id": "503440432480530"}, {"status": "PUBLISHED", "id": "1952973088458420"}, {"status": "PUBLISHED", "id": "715962460709465"}, {"status": "PUBLISHED", "id": "729185712547457"}, {"status": "PUBLISHED", "id": "583920156845230"}]}, "baseline_offer": {"id": "1321470085631526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1187790993258
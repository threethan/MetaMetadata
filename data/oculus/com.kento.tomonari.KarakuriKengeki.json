16095286781_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu6EOFff_SQQ7kNvwFqCcmy&_nc_oc=AdlDfP9FU7cFrFSL1RlxCob_O18MTXk__YBiHik0iT8GSCSY3xrglr0spZgGjYPM7Mw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwemmkrvP8haqKwg71SN3YgIKNohfCJGJ6TySS6dLjyqg&oe=69AAC534"}, {"file_name": "KarakuriKengeki_Logo_screenshot_4.png", "id": "1365992614230914", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39035424_1365992617564247_196057820963030135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV-OJEy_M00Q7kNvwFBuXTk&_nc_oc=AdnpOCojuNjP8ieiG-72xhhebiXYjGc34X6dw1n0KRBvYkP4LcMWEDW1DFD8BzGp-t8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afxg2wU6yvqHMjT5hUXo7LMObfr9ZUvWinobaN9kVJLxzA&oe=69AAB84F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQKrkRe60zYQ7kNvwE2H0Ch&_nc_oc=AdkZYsAIHAPw6myCTIQKVBzHZInxfGvgxP2zhD5xSZxtXxCk1_1CV_KMlZF6L9ldph8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPh7UYCT0tB6dor6-s_w1Ky2O0zfy_HaBmD5MmrO6x5Q&oe=69AAB7C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqLTFCkd52gQ7kNvwFY933m&_nc_oc=AdnpKN5li7w2yH4XggpXvC2CZnloOMziflv9XtMZtGAJ24TG1YE5j1BzPh108wgmkgY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_Oc06wE13f1v-R0-N9km_k-6pJy1E0ZtuxWsQwErqRQ&oe=69AAC675"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odd-team-xr.com/karakuri-kengeki/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/karakuri-kengeki/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24759217273694481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57570312_653906563086985_6378840617626321496_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OeiWAqp719YQ7kNvwH58luV&_nc_oc=AdlkZU2rSGrkXz-hrqw04hrLAj5hqhPayTFUB75u9CHi-Z4OuKxuRybEbHWAJJWPgps&_nc_zt=
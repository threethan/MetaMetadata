531_689417052645957_2531460316095286781_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeCmAC3Xm1oQ7kNvwH7nmvJ&_nc_oc=AdqFllqMoCsBFmqK1WztKZSOVjH43lI0oNpOAyBA9Rfa3wBAC-TQJbGJmZ4dX4prS5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36u9qtXIdlOwfcQTNs9dxUlJ8PX4Y38sys-8fIHR1STg&oe=69ECB034"}, {"file_name": "KarakuriKengeki_Logo_screenshot_4.png", "id": "1365992614230914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035424_1365992617564247_196057820963030135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nn3ZS1nJaV4Q7kNvwE37Ci-&_nc_oc=AdoL7ZlsiFpr5Nz-cQ_B_xB1KkL5B5qM9OC1LHNTfhdc0yK1Jb8zm6z2Nea3ZiPB53w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jJnMClJukW8CCe3KTsWhSZUvfjBHY18ckX7taooHdug&oe=69ECA34F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GmkOmvy1LMQ7kNvwEIcgAK&_nc_oc=AdpcT7_kpiBYcXjHhwGc01lvp_r53HjIhVI3j0mlUVxTQTUmnvrdczpPmaMLCHf-C9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pF-SdmeusVzXGcL2rm8L9i7H23zULCaswPj5JPegy3w&oe=69ECA2C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TscK4P3XYMQ7kNvwGOjOWp&_nc_oc=AdodutlaTiSf5fB5nDjJqkysLowQhk9u9iyk08LmTQb4eall2SbTknmMIpNx88BXdcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DJU1QZTZ4cgbrf88p4Y19EmUHq1Gjq_uOlKmWWLF-ZQ&oe=69ECB175"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://odd-team-xr.com/karakuri-kengeki/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Odd Team XR Studios", "support_website_url": null, "website_url": "https://odd-team-xr.com/karakuri-kengeki/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24759217273694481"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570312_653906563086985_6378840617626321496_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YunN1m_gJwgQ7kNvwGsKaEZ&_nc_oc=AdojT81NlK6Tu7Leearh4F6hhNAJ8eH
content-dfw6-1.oculuscdn.com/v/t64.5771-25/39035424_1365992617564247_196057820963030135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CT9lYBOOTRYQ7kNvwGo1s_Y&_nc_oc=AdpizayFIY4YGXMmlKLnukKmFELn7SN3lX4VlLyF80u0-qudQdMqJzfBJtXRpSUTNdE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65E6FF-7_L6-Qe1Cwp5daGZYKJX-SSLQuL63DPulA0xQ&oe=6A0F228F"}, {"file_name": "KarakuriKengeki_Logo_screenshot_5.png", "id": "1309156996589649", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974817_1309156999922982_1445576129522989721_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cK0i6PXQS9AQ7kNvwHHzizJ&_nc_oc=AdqphzZo8zLDMBrKIfb-gxpHciTTeAQeX9TQpdmf44V-5wPdYicvEFsDCnxr_JaUqTM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KtZMYaRfFScB1FQrWG-ruiAQJ04EIdNqYP8O3_qT8Ng&oe=6A0F2209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KarakuriKengeki_Logo_25601440_2.png", "id": "3356133711309124", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974699_3356133714642457_2341147062143720854_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwhcGrSd1TkQ7kNvwErtHtv&_nc_oc=AdrFEiwD8lMBqJnAtqsiB4qcqpbTmNwAD6tE3WAal4lQhFnKjkidVPucI6wmUycaAJI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77j6cioPfBNfii9Bbxk7ICMQxPCQjHtTUfrNmV-eZAmQ&oe=6A0EF875"}, "display_name": "KARAKURI KENGEKI", "keywords": [], "long_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan.\n\nAs a samurai robot, you take up your katana bravely against the enemies ranked against you in each stage, battling with swords amid vividly Japanese settings as the tension ratchets up.\n\nBecause the enemies are waiting for you in formation, you cannot win simply by waving your sword around like a maniac.\n\nInstead, you work your way carefully through each stage, discovering the bespelled sword with its mysterious power, luring the enemy cleverly into single combat to make quick work of them.", "short_description": "KARAKURI KENGEKI is a VR sword-fighting game in which the player fights as a samurai robot using a Japanese katana, moving through various stages redolent of old Japan."}]}, "developer_name": null, "developer_privacy_policy_url": "https://karakuri-kengeki.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Kento Tomonari", "support_website_url": null, "website_url": "https://karakuri-kengeki.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1218569015412235"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "26494887000179896"}, {"status": "PUBLISHED", "id": "1187790993258567"}, {"status": "PUBLISHED", "id": "1622284199200270"}, {"status": "PUBLISHED", "id": "1423318382531660"}, {"status": "PUBLISHED", "id": "1555164275854896"}, {"status": "PUBLISHED", "id": "1321470085631526"}, {"status": "PUBLISHED", "id": "605878489063589"}, {"status": "PUBLISHED", "id": "503440432480530"}, {"status": "PUBLISHED", "id": "1952973088458420"}, {"status": "PUBLISHED", "id": "715962460709465"}, {"status": "PUBLISHED", "id": "729185712547457"}, {"status": "PUBLISHED", "id": "583920156845230"}]}, "baseline_offer": {"id": "1321470085631526"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 178
 puzzles solvable with ESP telekinetic powers\nWorld class voice acting from Eric Meyers"}]}, "developer_name": "Coatsink", "developer_privacy_policy_url": "http://coatsink.com/", "developer_terms_of_service_url": "https://coatsink.com/", "publisher_name": "Coatsink", "support_website_url": null, "website_url": "https://coatsink.com/games/esper", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "504821664501006"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427628_171653466790151_1396495194521600000_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXhu0HylWiMQ7kNvwFvvzo_&_nc_oc=AdkHPAMpWrd_DhzQZzXtJwpkvGGCcJRSD2SCMUwCP_VIfhpM9XU9GtMDU9VVz9D2W9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxmHeRF6LWKVqRZ23NhwJYjGSq_RHv8iLHpuJ6Bc_MNsw&oe=69BFF75C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Esper", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1430463600, "lastRevision": {"nodes": [{"id": "872170812865480", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "797549690323260", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": 
410911156667_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJImOJ_pa8MQ7kNvwFjAQG6&_nc_oc=AdqCnOzKfEotCyCjZpiNTKW2sI435c8hG7-UHJm1RS1Q9tZCqAW8NEAR-k-bT5FNsJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShyuuXwCCbI9gN9zN90EJ5eSOsjFypS6qIVXrjg-ymWg&oe=6B09B2C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "3223364934617368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974530_3223364937950701_5109853740369755587_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vt6pzDF-TwQ7kNvwGZ4LpV&_nc_oc=AdoV8pcyag4DrnaNyzjv-95-DzsnnOEsBfFwwHp3M4TH67ssxJ4i3ltK2C0owVENgnQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7ETyVw4M9yZAMXYN_KZ4WjiN2rclMiBf9sngixZed4A&oe=6B09B50A"}, "display_name": "Spray Paint Games VR - graffiti painting street art", "keywords": [], "long_description": "Spray Paint is a virtual graffiti and painting experience where you can create your masterpiece using real spray paints and airbrush tools. You can choose from multiple unique colors and customize your environment.\n\nProduct Features:\nA realistic physics engine allows you to paint like a pro.\n100s of unique colors to mix and match.\nDifferent environments.\nShare your creations with friends and admire others' work.\nPlay solo or invite up to four friends to join you.", "short_description": "Download now and create colorful masterpieces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/91707226-04cd-4ec0-aee7-8d84efd0a601", "developer_terms_of_service_url": "https://sharpforksapps.com/term-of-use/", "publisher_name": "Sharp Forks Labs", "support_website_url": null, "website_url": "https://sharpforksapps.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "181902164488264
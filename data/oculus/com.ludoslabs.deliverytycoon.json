ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3shy6VcmjQBdTWQp0Eb84GA2y2g9rboeWBatVUDNOkQA&oe=69F756F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Delivery Tycoon", "keywords": [], "long_description": "This game lets you be someone you always dreamed to be - package delivery station operator!!\n\nWe all had this dream when we were kids, now thanks to advancements in technology and science - you can realize this dream!! Wait no more, strap yourself in and throw some packages at random buildings in a rage fuelled fit! Erm, I mean, deliver some packages.\n\nSlightly sandboxy game about packages. Can packages be fun? Maybe. In VR? Definitely.\n\nThrow them, deliver them, try to hit a drone with them? Have fun :) ", "short_description": "Slightly sandboxy game about packages. Can packages be fun? Maybe. In VR? Definitely.\n\nThrow them, deliver them, try to hit a drone with them? Have fun :) "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludoslabs.com/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "LudosLabs", "support_website_url": null, "website_url": "https://www.ludoslabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10038556986213854"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1437
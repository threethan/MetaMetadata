b=1-7&_nc_sid=6e7a0a&_nc_ohc=t20fhck4NZgQ7kNvwH31aMH&_nc_oc=Adp2ipCMV1cvkVzXzjjPEODbDlGYNNIe4hVEUq91lYkl_Xkd_BsY4gVxc17oQPht5PI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJmBxkHd-KrGYO-oMl5icTTsKcz8k3TILye7Bx9sJjCg&oe=6AF484B7"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1714589852970750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673652249_1714589856304083_6913610111345633743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9mySTeNgqsQ7kNvwFjFscs&_nc_oc=AdowjtDBgZG4N7buqPYSiy4tSgnxW667aI1RZT2cwkiJOFWqr5uhXllCLNatNeVsup8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5s1kgQMu_1dogy5g1kJmBVkXxeL6GrU_lFUV2PkknVA&oe=6AF4921C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1991809644870114", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831964_1991809648203447_9092699410051726414_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E7TmizsyM0Q7kNvwEVFsQz&_nc_oc=AdpH7yzp0u7A4lcSylF8TVEnIHYfdu_dT8Pc7P3yGFGRSBWnCwyqA8ANOiIz4RFUyt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmaUGI5PB5isyxRZh9tUjnMXR5NpcigGLZVj7vqQR-iQ&oe=6AF48E3D"}, "display_name": "Trains 2", "keywords": ["trains", "railway", "sandbox", "builder", "garden"], "long_description": "Your own train set, as big as you want it - now in three rooms.\n\nTHREE ROOMS\nPick a room from the start menu, the pause menu or the build wheel and the whole room changes around your layout in one instant. KIDS ROOM: bright colours, bunting, toys and a play mat. MODERN ROOM: a calm, stylish grown-up lounge. GARDEN: your railway outdoors on a mown lawn under a blue sky, with a picket fence, flower beds, sunflowers, a lily pond, a shed and trees all round. Your trains keep running while you switch.\n\nBUILD\nPress Y to open the round build wheel. Pick a straight, a turn, an S-curve, a hill or a climbing curve and aim it at the end of your line - it snaps on perfectly. Build loops and mountain railways that climb up and come back down.\n\nTRAINS AND WAGONS\n12 ready-to-run trains: puffing steam engines, a bullet train, city trains, a metro, a subway, freight trains and a tram. Aim a wagon at the back of a train and it couples on.\n\nDRIVE\nPoint at any train and take the controls: trigger to go, brake with the other hand, back up at the end of the line. Blow the whistle and pull into the station for ALL ABOARD. Take a tight turn too fast and your train comes off the rails.\n\nA LIVING RAILWAY\nThe other trains drive themselves: slowing for curves, waiting at stations, keeping a safe gap.\n\nAlso: stations, tunnels, signals, trees and a spinning windmill, three ready-made layouts, undo, auto-save, and music.\n\nDeveloped and published by Citiview Studios.", "short_description": "Trains is back with three rooms to build in. Snap together straights, turns, hills and climbing curves from a round build wheel, add stations, tunnels, signals and trees, fill the rails with 12 trains and drive any of them yourself. Then pick your room: a bright kids play room, a stylish modern lounge, or a sunny summer garden under open sky - the whole room changes around your layout in an instant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/trains2/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trains2/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
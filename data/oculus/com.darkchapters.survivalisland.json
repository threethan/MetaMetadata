content-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVdJzNPcNrAh-R-5C6mBc0p7tMWVs_zwDVZbUzmklFeQ&oe=6B105D77"}, {"file_name": "screenshot_10_radio.png", "id": "1120230877186812", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628882_1120230880520145_285210748362828790_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPLldoPUVkcQ7kNvwH7tJ4e&_nc_oc=AdpM4FH2yr9ra1ir3F49gL_Wsgn4BQqVd5E02Ojog2QSjwcd3cjpv34Yg_3kX8hdRhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2ll1jIHxEP-VaYkJfreb4ZhrTEY8Fk76F9GwpZyvD4Q&oe=6B105C29"}, {"file_name": "screenshot_05_expedition_camp.png", "id": "2552761265235993", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_2552761268569326_7201274186194638523_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u9ZXQnX6Q0Q7kNvwFPRK-3&_nc_oc=Adqa_QapNi0fmIT8cO-ifr9jeUL2eVq47WZYDmDK3HihO_3iXM-ela20qbhTa_NWsTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWXRRoC3n7aTcZ24r7qhjpCBYfLmN78jr9Na0w_R3F7Rw&oe=6B1055B7"}, {"file_name": "screenshot_01_array_low.png", "id": "1865892351116730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593761155_1865892354450063_180431983056123243_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NM_h8UojuYQ7kNvwFH_WLC&_nc_oc=AdoOkv73LiMKRzywrF7Vy12Og6XNL53hpPTMtyttbHxcv1Dks4U_aacl8WDJHOTvi80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZYb3vVaQBP4CEpXgcMRkiqb94qAUYFQVrHy2pnEZhaA&oe=6B10457E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Survival Island: Lost Beyond", "keywords": ["island", "survival", "beach", "adventure", "Exploration"], "long_description": "You survived the crash. Now survive the island.\n\nSurvival Island: Lost Beyond is a story-driven VR survival adventure built for Meta Quest. Everything happens with your own hands. Grab sticks and stones, craft a stone axe, chop palms, light a fire with a flare and fill your bottle at a freshwater pool. Keep an eye on your wrist watch for health, food, water and warmth.\n\nBut you are not alone. A red light blinks on the mountain. An abandoned expedition camp holds a journal, broken radio parts and a name: Dr. Halvorsen. Follow the signal through glowing crystal caves, tune a radio by hand, punch the door code into a hidden research station and bring its generator back to life. Deep below the mountain, something is waiting behind the glass.\n\nFEATURES\n- 7 handcrafted chapters, from the crash beach to the final escape\n- 3 endings: Preserve, Purge or Overload. Your choice decides how it ends\n- Fully physical VR interactions: craft, chop, build, tune, pull levers and type keypads\n- Survival stats on a wrist watch: health, hunger, thirst and warmth\n- Day and night cycle, campfires and a living island with crabs, boars, birds and snakes\n- Dark caves lit only by the torch you made\n- Backpack over your shoulder for storing items\n- Autosave on every objective, so you can play in short sessions\n- Comfort options: smooth movement, snap turn and teleport\n\nExplore. Survive. Uncover the truth. Then find your way home.", "short_description": "Your helicopter is wreckage. Your radio is broken. And something on the mountain is calling. Wake up on a lost tropical island, craft tools with your own hands, build fire, find water and follow the trail of a missing research expedition into caves, a hidden facility and the secret buried beneath it. A story-driven VR survival adventure in 7 chapters with 3 different endings. Every choice decides who leaves this island."}]}, "developer_name": null, "developer_privacy_policy_url": "https://survivalislandvr.blogspot.com/2026/10/survival-island-lost-beyond.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Game Creations ", "support_website_url": null, "website_url": "https://dreamgamecreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST",
RmpiFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqczGtd-idXS0sCUhVy3bpASvVqMqaUUJWl9Ka-G6rZw&oe=6B0C69CD"}, {"file_name": "screenshot_04_pond_bottle.png", "id": "1551360543497544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823910_1551360546830877_4185461414472683886_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1zR3c32GYoQ7kNvwEAvhJA&_nc_oc=AdpknyxsIxA_8y_mVQISd8IKij4EwOR1gztfz7Gjq2Huv8754o_EVdii9448r89hc2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSL0zTq4GeUgoYEWANKvSe0lAneWDdKksKEBx4yhIVaBQ&oe=6B0C4E67"}, {"file_name": "screenshot_02_cave_torch.png", "id": "1832629124751783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1832629128085116_5419044637099992114_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnYO-VBSofQQ7kNvwFvVIUd&_nc_oc=Adr2IgrenWiPfa3oC2m8OdZFXaLr_ILt7-HZ9oq2vQft-LvNo-ix168GPy5OuiuzhzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTuVN1pqLPcNYQ_4pYQKtT-EjXdpb2BsIFLJzsayFHV0w&oe=6B0C68B6"}, {"file_name": "screenshot_11_pull_cord.png", "id": "1650848389833934", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1650848393167267_3425717505153301841_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPN5wnmAN0oQ7kNvwFPWGCs&_nc_oc=AdqkphnKjop6KwSKhO9viYudqp4yoCZLMRU9pI701wiO7hdtDOKWIYydJIPNwz4DUzM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0hpNrFbg_1qrY3grmWT0BtElJzNuClaHGNyqW3ZFgsg&oe=6B0C50C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "28880543844897937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827987_28880543854897936_2337262173106584959_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GixJKuQW2LUQ7kNvwHMcbxt&_nc_oc=Adr6wXB9ehuZpMPtIJLhjREbg3S35F_euekJ1Nb8hVl6f_NdPW8vaO_2kuVN4e3K2ew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzbtn1Y44VsaC_Iivpw9SmEi3sZrvLWRiaqdfByXa5fw&oe=6B0C7C57"}, "display_name": "Survival Island: Lost Beyond", "keywords": ["island", "survival", "beach", "adventure", "Exploration"], "long_description": "You survived the crash. Now survive the island.\n\nSurvival Island: Lost Beyond is a story-driven VR survival adventure built for Meta Quest. Everything happens with your own hands. Grab sticks and stones, craft a stone axe, chop palms, light a fire with a flare and fill your bottle at a freshwater pool. Keep an eye on your wrist watch for health, food, water and warmth.\n\nBut you are not alone. A red light blinks on the mountain. An abandoned expedition camp holds a journal, broken radio parts and a name: Dr. Halvorsen. Follow the signal through glowing crystal caves, tune a radio by hand, punch the door code into a hidden research station and bring its generator back to life. Deep below the mountain, something is waiting behind the glass.\n\nFEATURES\n- 7 handcrafted chapters, from the crash beach to the final escape\n- 3 endings: Preserve, Purge or Overload. Your choice decides how it ends\n- Fully physical VR interactions: craft, chop, build, tune, pull levers and type keypads\n- Survival stats on a wrist watch: health, hunger, thirst and warmth\n- Day and night cycle, campfires and a living island with crabs, boars, birds and snakes\n- Dark caves lit only by the torch you made\n- Backpack over your shoulder for storing items\n- Autosave on every objective, so you can play in short sessions\n- Comfort options: smooth movement, snap turn and teleport\n\nExplore. Survive. Uncover the truth. Then find your way home.", "short_description": "Your helicopter is wreckage. Your radio is broken. And something on the mountain is calling. Wake up on a lost tropical island, craft tools with your own hands, build fire, find water and follow the trail of a missing research expedition into caves, a hidden facility and the secret buried beneath it. A story-driven VR survival adventure in 7 chapters with 3 different endings. Every choice decides who leaves this island."}]}, "developer_name": null, "developer_privacy_policy_url": "https://survivalislandvr.blogspot.com/2026/10/survival-island-lost-beyond.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Game Creations ", "support_website_url": null, "website_url": "https://dreamgamecreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1413490021853566"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1142707768157264_4929220125242426700_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GUJ_X3W2gwQ7kNvwEzs8Jv&_nc_oc=AdoxOO1i3ERmaghD-s0ewaC0Ded9-Z-LnSMubSVoElIclcV4w3npuXsCCl9ett9DTFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVqh586HSsu1VuiSmwmYBKYSByS5rbhRCTSwyDIV69vQ&oe=6B0C68E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Survival Island: Lost Beyond", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354
9_LTR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVV5be3zBbgKaTHn3l_7zSyR5-UtIt0iEwBrR6j2i4Akw&oe=6B0F0CCD"}, {"file_name": "screenshot_04_pond_bottle.png", "id": "1551360543497544", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823910_1551360546830877_4185461414472683886_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSDWHoJRXwkQ7kNvwFfPYMY&_nc_oc=AdoLrEHY2FZPYOwRkT2gNfq3w6vOLGuugo1WHlW1GhPo9p4KBT2fXiTjfg_qwqu1K8E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfu-YAwDHrJy7FyIKywejB-uhOKsC1v64uu-iGDfbnow&oe=6B0EF167"}, {"file_name": "screenshot_02_cave_torch.png", "id": "1832629124751783", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1832629128085116_5419044637099992114_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTHbDWpVZowQ7kNvwHiu6aF&_nc_oc=Adq2W4KlLmt6GQ817-BDFYRN6Rc9sxOhPKDFeaLYS4U_vWyuA51lFicMpmJYFVVyotQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXYRfmFu-yZaAuoxG9aEe0WPpCf_BgEtjBVAD5-1R6GMQ&oe=6B0F0BB6"}, {"file_name": "screenshot_11_pull_cord.png", "id": "1650848389833934", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1650848393167267_3425717505153301841_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI0dwPdtbWIQ7kNvwHq0Ju0&_nc_oc=AdoOJSErN4u54rBJH1SOX_rLVm9GU9TGxEohIvBbC6TGP1-wX_a9O-rowNNrUjWIdVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_7wYcf72vHfEdNI-ielO6Qhj0nDF8BtWub03UFMh0JQ&oe=6B0EF3C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "28880543844897937", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827987_28880543854897936_2337262173106584959_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaW8FuYlPMEQ7kNvwGOEAS9&_nc_oc=AdqQaiUwoBYWRh1Nir48JjCUSc52ZbNBS5fzJv8Ua18kNSkPzIJyGn9V045MueQ6nmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVtqHbdACKpwgfKqQVJS3WbIsx_ux1KK6OJdmL9LcgiAw&oe=6B0F1F57"}, "display_name": "Survival Island: Lost Beyond", "keywords": ["island", "survival", "beach", "adventure", "Exploration"], "long_description": "You survived the crash. Now survive the island.\n\nSurvival Island: Lost Beyond is a story-driven VR survival adventure built for Meta Quest. Everything happens with your own hands. Grab sticks and stones, craft a stone axe, chop palms, light a fire with a flare and fill your bottle at a freshwater pool. Keep an eye on your wrist watch for health, food, water and warmth.\n\nBut you are not alone. A red light blinks on the mountain. An abandoned expedition camp holds a journal, broken radio parts and a name: Dr. Halvorsen. Follow the signal through glowing crystal caves, tune a radio by hand, punch the door code into a hidden research station and bring its generator back to life. Deep below the mountain, something is waiting behind the glass.\n\nFEATURES\n- 7 handcrafted chapters, from the crash beach to the final escape\n- 3 endings: Preserve, Purge or Overload. Your choice decides how it ends\n- Fully physical VR interactions: craft, chop, build, tune, pull levers and type keypads\n- Survival stats on a wrist watch: health, hunger, thirst and warmth\n- Day and night cycle, campfires and a living island with crabs, boars, birds and snakes\n- Dark caves lit only by the torch you made\n- Backpack over your shoulder for storing items\n- Autosave on every objective, so you can play in short sessions\n- Comfort options: smooth movement, snap turn and teleport\n\nExplore. Survive. Uncover the truth. Then find your way home.", "short_description": "Your helicopter is wreckage. Your radio is broken. And something on the mountain is calling. Wake up on a lost tropical island, craft tools with your own hands, build fire, find water and follow the trail of a missing research expedition into caves, a hidden facility and the secret buried beneath it. A story-driven VR survival adventure in 7 chapters with 3 different endings. Every choice decides who leaves this island."}]}, "developer_name": null, "developer_privacy_policy_url": "https://survivalislandvr.blogspot.com/2026/10/survival-island-lost-beyond.html", "developer_terms_of_service_url": null, "publisher_name": "Dream Game Creations ", "support_website_url": null, "website_url": "https://dreamgamecreations.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1413490021853566"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1142707768157264_4929220125242426700_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ao-CcLoxuc0Q7kNvwGR5U_w&_nc_oc=Adq0nqrz45wc7NLJTkVYavqcc8x58YfSHRop-csuqWpxynGS-VG5UeT1EUSJolzp89U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLBvfI1ACyFLYOdDUlK1ubKGLskz9u7QOGA-z71eDLag&oe=6B0F0BE6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Survival Island: Lost Beyond", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354
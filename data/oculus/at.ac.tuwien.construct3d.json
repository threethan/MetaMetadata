_03_clean.png", "id": "1394689755737172", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_1394689759070505_6808720124352827536_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLuAAhNvUrsQ7kNvwG18hTR&_nc_oc=AdpmhDM2yJ-CQczJO55mTOpodzhsTD6Hf5GPwicoqIcBRioCn7miLiTMt2JGQRWd31U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXnyJADszaTyQA-03PmyKZWB8nxAaoX6maFcQ6EaZm3Q&oe=6AF0AA34"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot3_Strahlschraub_v1.png", "id": "1158219197366898", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1158219204033564_8019162491311107587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVHxQ_--k2UQ7kNvwEeCrTo&_nc_oc=AdpwauV6naQH-1pdEMOLqk8MI2FWf_Pgjkb-0wzFSZ28DWcDXfjInbqrCjskE6qgepM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgK99pwR8iX6hZtoArh0IPMQJGx23fS7UJbihwhs5b6w&oe=6AF0AEB0"}, "display_name": "Construct3D", "keywords": ["geometry", "education", "mathematics", "spatial", "construction"], "long_description": "Bring geometry into your room with Construct3D. Build in mixed reality, walk around your constructions and move defining points to see connected geometry update live.\n\n**Create and explore**\n* Points, lines, planes, circles, ellipses and B-splines\n* Spheres, boxes (cuboids), cylinders, cones and editable NURBS surfaces\n* Intersections, Boolean solids, surfaces of revolution, sweeps and helical surfaces\n* Tangents, curvature, Frenet frames, osculating geometry and Dupin indicatrices\n\n**Construct together**\n\nHost or join a shared session with up to four people. Collaborate in the same room or remotely, see each other's edits, pens and menus, and talk using voice chat with microphone controls. Internet access is required for online collaboration. Each user has its own color scheme, what you construct keeps your color. All operations are collaborative.\n\n**Stay in control**\n\nUse Quest controllers or a Logitech MX Ink stylus. Save and load constructions with thumbnails, undo and redo edits, hide and restore objects, labels help identify points, choose English/German menus, handedness and passthrough brightness.\n\nDesigned for teaching, guided exploration and advanced high-school or introductory university geometry, from conic sections to free-form surfaces.\n\n**Start here: controls, tools and multiplayer instructions:**\n\nhttps://construct3d-for-unreal-d0cb88.git-pages.tuwien.ac.at/students/", "short_description": "Build and explore dynamic 3D geometry in mixed reality, from core constructions to intersections, sweeps, booleans, helical surfaces, NURBS and more. 4 user multi-user supported.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://construct3d-for-unreal-d0cb88.git-pages.tuwien.ac.at/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Hannes Kaufmann", "support_website_url": "https://construct3d-for-unreal-d0cb88.git-pages.tuwien.ac.at/", "website_url": "https://construct3d-for-unreal-d0cb88.git-pages.tuwien.ac.at/students/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28766777559680724"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_958234840148012_2448358313596796048_n.png?stp=dst-png_s360x
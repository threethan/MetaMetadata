/t64.5771-25/499618102_1754064875563877_425787213259544053_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkrmBMUrShoQ7kNvwEX0c4f&_nc_oc=AdppqeeDhYfuKPeIEmFHcH6gvFW_KN8GUKpMQDH523hgdyUmnBw0bfnNL3AtZpTcGZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZzvzZuFzmCJA3ykKko4dLEvpxDyIWhT4_qKU5_Smh-Q&oe=6AA29F8A"}, {"file_name": "E_Screenshot3_Strahlschraub_v7.png", "id": "1300859984821343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_1300859988154676_9142523795375595099_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRpK4psl-AIQ7kNvwEfnFj1&_nc_oc=Ado0IOuzlagyQG_kU-uYAE8amtPLx_SRYnr5nIg569VMbuWeviaf9HAufpRIYRuU8Oc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbKc5C1yI5-qh2e_U9gCkSDhmI356MM-lsroqrsDuOUw&oe=6AA2B858"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot3_Strahlschraub_v1.png", "id": "1158219197366898", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1158219204033564_8019162491311107587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITpfXFbvZbkQ7kNvwEMsnRC&_nc_oc=AdosVPgMHdqG8-XUI4Uns2MZP_qBh7c7dthTJLHdDTSD9zP4BWXIoqKGKPj4g1_oED0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLphekYM3Vx_Ul3_crxk0n0iPbGlH1ZsDv4xWlLuQJy8w&oe=6AA2ADF0"}, "display_name": "Construct3D", "keywords": ["geometry", "education", "mathematics", "spatial", "construction"], "long_description": "Construct3D brings dynamic spatial geometry into mixed reality.\nCreate and explore geometric constructions directly in your room using intuitive 3D interaction. Build points, lines, planes, circles, ellipses, B-spline curves, spheres, cylinders, cones, NURBS surfaces, surfaces of revolution, helical surfaces, sweeps, and Boolean objects. Investigate how constructions change dynamically as you move defining elements and observe dependent geometry update immediately.\nConstruct3D is designed for learning, teaching, and demonstration in geometry and related STEM contexts. It supports classic topics such as conic sections and intersections of solids, as well as more advanced topics such as differential geometry (Frenet frame, curvature and osculating objects,...) and free-form surface editing.\nEspecially well suited for:\n* teacher-led classroom demonstration\n* guided student exploration \n* advanced high-school and introductory university geometry \n\nKey features:\n* construct geometric objects directly in 3D space\n* inspect intersections of lines, planes, and any 3D objects\n* explore tangent planes and local surface behavior interactively\n* visualize curvature, Frenet frames, curvature centers, and osculating geometry\n* edit NURBS control structures and observe live updates\n* save, load, undo, redo, hide, and restore constructions\n\nAll constructions are fully dynamic. Points can be moved at any time.\nChange passthrough and left/right-handedness in the System menu.\n", "short_description": "Build and explore dynamic 3D geometry in mixed reality, from core constructions to intersections, sweeps, booleans, and curvature.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://construct3d-for-unreal-d0cb88.git-pages.tuwien.ac.at/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Hannes Kaufmann", "support_website_url": "https://construct3d-for-unreal-d0cb88.git-pages.tuwien.ac.at/students/", "website_url": "https://construct3d-for-unreal-d0cb88.git-pages.tuwien.ac.at/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppor
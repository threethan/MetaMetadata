rridors, racing through crumbling sections of the facility, or uncovering the building\u2019s disturbing secrets, Fear Gibbon mixes intense movement with oppressive, atmospheric horror. Search hidden rooms, push yourself to reach off-limits areas, and confront whatever is lurking in the shadows.\nCan you survive the building\u2014and the thing inside it?", "short_description": "Fear Gibbon Is an Awsome game to play with your friends and loved ones. Explore the worlds of FEAR now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/mankievr/terms-of-service", "developer_terms_of_service_url": null, "publisher_name": "Senzi", "support_website_url": null, "website_url": "https://sites.google.com/view/mankievr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33721951017396067"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2118624945587897"}, {"status": "PUBLISHED", "id": "1158028669632040"}]}, "baseline_offer": {"id": "2118624945587897"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768673220, "status": "PUBLISHED", "id": "2118624945587897"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32969821295942380", "
WqyeeDsgSp_4wHCH5Xbmg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYSCItL0qI0PgiNAPFkyk3cNjmT8hsC0ZD2UF3UjBBTQ&oe=6B084386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "29959927916942175", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/673716021_29959927933608840_6310892230305389578_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kshh5zFONIsQ7kNvwFRrwVc&_nc_oc=AdoZh71sPwCud6e-RyvlJk1fvoUvY-o_oG6zxHbIR2K_G_89nLDE8ivtkcbJDunv_AA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSztr9XF1aPxtUaV4oQDSWkYgVLrbAQZHr3UB2AlnlyEA&oe=6B0871F8"}, "display_name": "Museum For A Rainy Day", "keywords": ["museum", "art", "gallery", "immersive"], "long_description": "Discover a museum that\u2019s always open.\n\nMuseum For A Rainy Day brings together curated exhibitions by living independent artists from around the world. Explore painting, photography, illustration and printmaking in welcoming virtual galleries, at your own pace.\n\n**Step inside selected artworks**\n\nGo beyond viewing art on a wall with the **Enter Artwork** feature. Experience selected works from an immersive viewpoint, with a sense of depth and subtle atmospheric movement that brings another dimension to the original artwork.\n\n**Take your time**\n\nExplore complete exhibitions, discover different artistic voices, and return to the works that catch your imagination. Each exhibition presents an artist\u2019s work as a collection to spend time with.\n\nNo travel, tickets or closing hours. Just space to explore, look closer and enjoy art.\n\n**Free to visit. Curated with care.**", "short_description": "An entire museum in your pocket. Real artists, immersive rooms, always open."}]}, "developer_name": null, "developer_privacy_policy_url": "https://museumforarainyday.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Lenguart LLC", "support_website_url": n
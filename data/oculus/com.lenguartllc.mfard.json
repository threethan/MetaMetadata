iuJfpjhiomNACzyoh7a_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Okw1_4A2jQpgxkKwmYVcrR9Rq2KgQIi0VC_TxMdv_A&oe=6B05D8C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "29959927916942175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673716021_29959927933608840_6310892230305389578_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM7Ln4iM8ysQ7kNvwHdfob2&_nc_oc=Adqtr6K91nEMwBQkZAcly8Mus6LeD7byFbSzLUGDTW4ImleMxO6RqOCXlIG9DHYI7ZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZG_GpOVCuxC_agnu1GIYpz42oOKTrc6HoDC-zQAnGUg&oe=6B05CEF8"}, "display_name": "Museum For A Rainy Day", "keywords": ["museum", "art", "gallery", "immersive"], "long_description": "Discover a museum that\u2019s always open.\n\nMuseum For A Rainy Day brings together curated exhibitions by living independent artists from around the world. Explore painting, photography, illustration and printmaking in welcoming virtual galleries, at your own pace.\n\n**Step inside selected artworks**\n\nGo beyond viewing art on a wall with the **Enter Artwork** feature. Experience selected works from an immersive viewpoint, with a sense of depth and subtle atmospheric movement that brings another dimension to the original artwork.\n\n**Take your time**\n\nExplore complete exhibitions, discover different artistic voices, and return to the works that catch your imagination. Each exhibition presents an artist\u2019s work as a collection to spend time with.\n\nNo travel, tickets or closing hours. Just space to explore, look closer and enjoy art.\n\n**Free to visit. Curated with care.**", "short_description": "An entire museum in your pocket. Real artists, immersive rooms, always open."}]}, "developer_name": null, "developer_privacy_policy_url": "https://museumforarainyday.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Lenguart LLC", "support_website_url": n
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKqrRLpDsxPEKjT5XPqL3hkGmpIhfQe6m4FG5PcOxL6w&oe=6AFB1FBD"}, {"file_name": "10_thermal.png", "id": "1108360942172261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/596149727_1108360945505594_5820713724826448001_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYPAEKFr004Q7kNvwGw7Obq&_nc_oc=AdpRsp2PqRNtud6R3IH4988DVMh3Os17eoKMw3dtf5NI14Jt5QUYJGlomyZxxMXCQaE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCSnUnpHpumHpJkj9U6RszNKZU4Z8swXy7hOOiUFPSSw&oe=6AFB2E8F"}, {"file_name": "12_zero_g.png", "id": "1832039558102109", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/654975915_1832039561435442_6007635220679686896_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3DvzjDuh4YQ7kNvwH9fWUH&_nc_oc=Adqu3TxJzLmjxGwaZV4GBt2DFXqUB08HoOkAdMP6S7q4YTnxjUzk6zv4HnW7cWTyP8A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwBdsBTaNS9lhXwlEpi2fyppBOW273tZnPt38b7QEbqA&oe=6AFB236F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1618992986574171", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824665_1618992993240837_7203794240329737177_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIsPGpaQBdkQ7kNvwFqSykL&_nc_oc=AdqKKRDmtKPEUa5vTe3ToYvIDU0NwkSmgCznyfTxW55PkjkQcL2yqO4rEuKSZQPr8_U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS8Uv3DQk-_kGeiULED2_wB0VUErJU6VNOS6kqsuy-uA&oe=6AFB3DDD"}, "display_name": "Wall Breach: Monster Jump \u2013 Prologue", "keywords": ["monsters", "arcade", "passthrough", "shooter", "MR"], "long_description": "Your room scan becomes the battlefield. Something knocks behind your wall \u2013 then it bursts open. An alien lander touches down on your floor and little monsters pour in, hopping onto your couch, hiding behind your table and splitting in two if you let them. Too many in the room at once and it's game over.\n\nTHE FREE PROLOGUE \u2013 15 WAVES\n\u2022 Monsters that use your real walls, furniture and ceiling\n\u2022 A blackout where your blasters become flashlights\n\u2022 A shark in your living room\n\u2022 Cloaked monsters you only see with thermal vision\n\u2022 A thunderstorm inside your room, zero gravity and a comic wave\n\u2022 An asteroid boss \u2013 and a mothership that plays tennis with you\n\u2022 Thieves, monster towers, balloons and a very rare golden monster\n\nALSO IN THE GAME\n\u2022 BOOT CAMP: a friendly alien teaches you everything in a minute\n\u2022 ARENA: replay special waves and bosses and chase best times\n\u2022 Party high score list with names \u2013 pass the headset around\n\u2022 A wardrobe with funny outfits, and a few secret ones\n\u2022 Comfort: seated mode, reduced flashes, volume settings\n\nWe're a two-person indie team and this is our first game. The full game with more waves, more bosses and an endless mode is in the works \u2013 tell us how the prologue plays in your room!\n\nRequires a room scan (Space Setup). Play in a clear area \u2013 some waves make you turn, step aside and duck.", "short_description": "Monsters are breaking through the walls of YOUR room! Wall Breach is a mixed reality arcade shooter for Meta Quest 3 and 3S: grab your blasters, turn, duck and keep your real living room clean before the monsters take over. The free prologue: 15 waves full of surprises \u2013 a blackout, a shark in your living room, a thunderstorm, an asteroid boss and a mothership that plays tennis with you."}]}, "developer_name": "Neon Owl Games", "developer_privacy_policy_url": "https://neonowlgames.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Neon Owl Games", "support_website_url": "https://neonowlgames.com/", "website_url": "https://neonowlgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
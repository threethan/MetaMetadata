{"data": {"node": {"__typename": "Application", "id": "8772060332810137", "organization": {"id": "1180918589581229", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "9435587389868876"}]}, "id": "1682719309332042"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "8743115419054323"}, {"id": "8772060332810137"}]}, "id": "3777749659147788"}]}}, "firstRevision": {"nodes": [{"application": {"id": "8772060332810137", "release_date": 1728054000, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 5}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24526143366975247"}, "id": "780946587398200"}]}}, "binary": null, "live_binary": null, "created_date": 1741849461, "id": "24205608545695399", "is_initial_release": false, "name_with_fallback": "v10", "pdp_metadata_with_fallback": {"version": 9, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "24279770488279204"}, "release_status": "RELEASED", "id": "8772060332810137"}, "id": "24279770488279204", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8772060332810137", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "8931135866929339"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1029666726008007", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TETRED", "keywords": ["retro", "arcade", "casual", "tetr", "block"], "long_description": "Das Spiel kann in Virtueller und in Mixed Reality gespielt werden. Der Spieler blickt von oben in eine rechteckige Spielfl\u00e4che. Oben erscheinen 3D Bl\u00f6cke aus mehreren W\u00fcrfeln, die langsam nach unten fallen. W\u00e4hrenddessen kann der Spieler sie um alle drei Achsen drehen und seitw\u00e4rts verschieben. Wie bei Tetris geht es darum, die Bl\u00f6cke wie bei einem Puzzle in geschlossenen Schichten anzuordnen. Sobald eine Ebene komplett gef\u00fcllt ist, verschwindet diese und die dar\u00fcber liegenden Bl\u00f6cke rutschen nach unten. Das Spiel ist beendet, wenn die Bl\u00f6cke nicht mehr in die Spielfl\u00e4che passen.\n", "short_description": "TETRED \u2013 Ein Tetromino 3D-Puzzlespiel f\u00fcr Virtual und Mixed Reality."}, {"images": {"nodes": [{"file_name": "TETRED_CoverSquare.png", "id": "2461344517551449", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393195_2461344527551448_3948395555829195106_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRpwr-aeCqMQ7kNvwEjNj2F&_nc_oc=Adp6Tr9Y31e7eg05YPH2CQ03p4ebSpDnW_u7KdlHnNCxKt6knntxWuK6SbcVmYweoyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIwjT2rj3wniq-B5GtfwaLl0DvSAxwmp63DNsP3KO4iA&oe=6AFC8A56"}, {"file_name": "TETRED_Logo.png", "id": "2173399086413917", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391731_2173399089747250_4836396999702596187_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoshNVxh9OAQ7kNvwGrpLCD&_nc_oc=AdoeugU-d2U10jxbfXGijDQqCao8thSbFg3OclicC-hO17d8J5K9wMAtSICVsuHQ9yg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZOnxiTapvGyarBGjIid0YI6UjfXVDaWASzVpuYtOnew&oe=6AFC920A"}, {"file_name": "TETRED_CoverMini.png", "id": "1865194294244923", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391739_1865194297578256_66248021859669071_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e
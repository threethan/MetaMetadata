IO-8V8tgboIJIuGCm8MRw9WI6vaw&oe=6A9423B4"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eiid3_DzQW8Q7kNvwHsdZQp&_nc_oc=AdoYRN5ERu1r70JFNRriJoXGwxM6X_8lu6HOi_Nm0lvC6MADQpkyTXQtA4EoSq5ujVY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ9Qyh0e_1iU-vMysobnp3IkIg_2Dpx2V2uONV0BaVMg&oe=6A9408CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg5_oyqVa00Q7kNvwFeP3yz&_nc_oc=AdrQgWT7W4SScp-VDNgItUdM6HG3G-9Z_lma3MaTF-YWQM79yiJOEQG0zgb8OE8RwqA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt4tsZTYpkpAslAuwbv3yJA3f1E6oBf2hjV2vz8Lcv6g&oe=6A943359"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
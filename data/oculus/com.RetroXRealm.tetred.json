I_RJEw3lE_naf26MBW5Ee56OaKDg&oe=69E22934"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3vZLdX_yZ4Q7kNvwFstzvH&_nc_oc=Adp5Ueb9ftHnusQ5_uW-aruxYnfazPK4IA3Tc0cFVv_O3K2q25T5QxB23qIuvTGnZSU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g25_hn_x5MlPWxZwSc4OaKP3O5--GMCYf1hiGegRFyw&oe=69E2468E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPY2iIApjRQQ7kNvwH8pxHv&_nc_oc=AdqXzPo-f1vMjN12lZBAEBxctOGKdfe3vTdDUqTqzfz7l_gShoO_NXD8pFi-rO1hBv4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08KqyyHsc7sCjsV8DHB2K2MiE6xu_GGhTP7mvuLG1KNg&oe=69E238D9"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
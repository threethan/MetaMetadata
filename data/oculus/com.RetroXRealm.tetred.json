uluscdn.com/v/t64.5771-25/473393589_981554594117827_545968684086100175_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdamv_zj0fUQ7kNvwHiMSBL&_nc_oc=AdonCKj82V7KC8PXVa0gr8DIBPHQ0c4We3782pPAVeFH1q9H41K19iGlKWicW5kDDAg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBexX8pF3ZZl4IzdJ6ocTookheN6dUI1X-7w--B0_njqA&oe=6A58E1A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCWhzHsar8EQ7kNvwH0WMEB&_nc_oc=AdrvBUqSfVVgWLqByYLUxV0wya8aIgPyEmmg7XVfOZITcCgb8oCedljKaYlU-IpDOec&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlesEaIpW_pOtg-Yfx2cV7BfuJdvxiVETRGm9OyGbrwg&oe=6A58DFD9"}, "display_name": "TETRED", "keywords": ["retro", "arcade", "casual", "tetr", "block"], "long_description": "The game can be played in Virtual and Mixed Reality. The player looks from above into a rectangular playing area. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\n", "short_description": "TETRED - A Tetromino 3D puzzle game in Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category
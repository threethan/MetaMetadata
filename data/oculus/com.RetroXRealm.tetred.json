g4B1LDNFD8lZrg0RLwEJ_L4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1CQZP8ArWHaYWzWbxGwKmA64l4ItB09awUOa9BUF_vQA&oe=69F0BB23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXv1obezdSgQ7kNvwFvB7rS&_nc_oc=Ado7_1DWtks2UQTvmjTUIhL-0PQT43YmZ1sopkP1ES6xNxBa-izMYQaKn1v6zJLYic8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2IfgLb7RaGzHVIF5vCD9uWX-mSe1zyawHwVHxmHpjCSg&oe=69F0B959"}, "display_name": "TETRED", "keywords": ["retro", "arcade", "casual", "tetr", "block"], "long_description": "The game can be played in Virtual and Mixed Reality. The player looks from above into a rectangular playing area. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\n", "short_description": "TETRED - A Tetromino 3D puzzle game in Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
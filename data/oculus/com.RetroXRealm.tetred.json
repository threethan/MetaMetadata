XJIeKwIRD7IEMWW-tpgy1bi4MGFw&oe=6AE8BBF4"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NfPyr3ggd0Q7kNvwFBsyME&_nc_oc=Adqf8H7K3j9okyvjUdO5OlKy2X9bGz8knR6DqjbuvSCXptwS393681bJjsuVZLJzUK0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5S4qKalqAlQQjsSXhExELIeP4rLvYAY8O5YsgEH5HJQ&oe=6AE8A10E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVqW5SdqjF0Q7kNvwF8Adap&_nc_oc=AdpXcM0bj8Xe-SEb64zPzBeZ21P6C1M7Cu8ndFBns5m3SLrQxyNSxtU3D4InV4elakE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMC-kAB4D6amSsR4Iwv69JxDQG8odWFczv1Ju3W68fuw&oe=6AE89359"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
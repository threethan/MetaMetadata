TJRbwZmm13mF1kqCuUuM2dW0P9rQ&oe=6AC917F4"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L79U140TiQ0Q7kNvwF6t3Dq&_nc_oc=Adp8dZ3lnQhOc3iZPfOLklfRhON3J18Fg9Yuh3TIpeKbod_E_vGgcLJoji8NBFx9kEo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbMOABwPjJVWT6I5BdtSLKQdRutqVkew3ZVsaJKmEaxg&oe=6AC8FD0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_o1d_rC9fw4Q7kNvwFlujBy&_nc_oc=Adql4Cd7Ki9zxb6ko2za_GFlAVjmmrteYAdg0btANac9M99ZOPOfV-yytuMHQG0dXKc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaJL_fWf6Ayo3AaGfAXfseVcJfj9tEd_WoOZDo_rw75A&oe=6AC8EF59"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
ExFutbJa_EzVftKHLmmC8XilV_ag&oe=69DB91B4"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tIUfCQy-JQQ7kNvwGaknD-&_nc_oc=AdqnU3fwE-PGUML3o3n6I1zwuU_NF-AXC4kqJ2smL6ET_po1YZbUmFjqXNQo9ssmqX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CMY8ddgLNC06QsKrsCEjI9m02QEVyfbcSV7NkTfgZ3A&oe=69DBAF0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BojapKCSTEQ7kNvwE77ro6&_nc_oc=AdqtG34OQ560MoC3vRhdwe2Idaspv8UUi834qTSIa0zHsE29PLrlmMugrnzgQ2AWXYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Teh2HxuGKNm8CHAAytBffbWR4mztuu0IgpXrwBW8DeA&oe=69DBA159"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4VwUp474IcQ7kNvwGE17BL&_nc_oc=AdovqiThwKFpSz-6e-h-xNQXxJik_9mE4pvS2eXRaZH2b-z7iWFBoFa5tlAC4AP9VS8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3LSwTlCraIxlaLHIFH_1Ckfjq3Dnq66aGC2hirJQovDw&oe=69F20CA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXv1obezdSgQ7kNvwEdKjxq&_nc_oc=AdrIytYDPbB_rL2HDC_eoWDjYdkUyk84HH2bthdompBBJhoDtOI6ylwSMOhD1POQ3ic&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af06R-jWNhO6eP6WH2PR3K8-vTbV94Wzy-mQxKlLyAL1rA&oe=69F20AD9"}, "display_name": "TETRED", "keywords": ["retro", "arcade", "casual", "tetr", "block"], "long_description": "The game can be played in Virtual and Mixed Reality. The player looks from above into a rectangular playing area. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\n", "short_description": "TETRED - A Tetromino 3D puzzle game in Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscr
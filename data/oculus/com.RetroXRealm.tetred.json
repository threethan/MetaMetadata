8279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_org30tDsAQ7kNvwHsYx5r&_nc_oc=AdqkiOMt0yLF8yrGwSmmukXJnkMTsG32T_U0BELB3NT_BFcj8mMW2ophwDFTSS-JdQo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VWgDf_cFEfaRdxBgWzR3I7sMazPsBkGVB1eG_Z_-kIA&oe=69F2188E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXv1obezdSgQ7kNvwEdKjxq&_nc_oc=AdrIytYDPbB_rL2HDC_eoWDjYdkUyk84HH2bthdompBBJhoDtOI6ylwSMOhD1POQ3ic&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af06R-jWNhO6eP6WH2PR3K8-vTbV94Wzy-mQxKlLyAL1rA&oe=69F20AD9"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", 
90q_tAMNoavakOcHypX5j4lS8ymw&oe=6AD3A3F4"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-rx5sGM3YgQ7kNvwFoFxBp&_nc_oc=AdpbmWMr0BeGR-gu5JP-qnjH8Ob4zQ6NWqO5nWxnR0kTNIZFz0NgtyoxZ4UwiREfGvE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRW6VE9mHgw7s_Xxp0nX_FjwRG9Hv-FB74GmeF5m9s4A&oe=6AD3890E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4546lh9ZCYQ7kNvwHVo1h7&_nc_oc=Ados3mdughTaFB-JHsgxiMix0tLJWFo4H9KNJ3kVFm5Elzxh9ayBi8m4kVhIPEVnjis&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3Rs5C8zYDHQkjuasF5vn3-GLzQ1o5QWExT8JWw3NB7Q&oe=6AD3B399"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
4A2Toc3IeDJyDmCrZs9IW6ibPHfQ&oe=69CBBFB4"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQ-HN7rPqb8Q7kNvwFPNQ8S&_nc_oc=AdrKqHXHb9n7V8I78tiwrvQbboBSRemVWuS5mrU3QOQX8ZK6ewurSPI2Rjtrqyoh5_E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyk8W_6_d6CXSo2kaaYpp3yk-AQ3kjTw_51XMU5xKx5Zg&oe=69CBDD0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UW0kfu8mJgQ7kNvwGvOwLh&_nc_oc=Adow9udsEw9sYdIYBPy_PuSTbX-t8lZaiJkrU8D1NGcOsHCmGTDVRzbofgjRY6dbjQI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCpS3i5ecIGXPN8Kugz7ZViR8DH_2gMcphOnOEv-n41A&oe=69CBCF59"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
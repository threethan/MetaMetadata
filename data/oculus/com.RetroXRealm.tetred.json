MZ4GD6u7YKJ_BHV7r16B5u_P88zA&oe=6A902F34"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC7uHT48McwQ7kNvwHr48Qz&_nc_oc=Adr4L24pC_nh3_bpk4PAZiaD8gjlrqDIVvjrrzFwfjZzLnUfs9izlSvFs5mVc_fP14A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtN_67x6q0ai2nvmeO4YJog2ZTAl1HJ6qYxH4ASBQa2A&oe=6A90144E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XKuMjD0WkAQ7kNvwFiNWdQ&_nc_oc=Adr3R-r_dr9TjhB-bnFvzq61xAlk1OhVQ9m3Ep6AI2yhcJo5PBWr9obdjCYisisu-jI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvRkinnbD4PaF12xrMbPlUT-4viXpf71CuwPyBk075ag&oe=6A903ED9"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
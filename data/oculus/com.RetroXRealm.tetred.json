ng?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2zJ3yiIY84Q7kNvwFSL48c&_nc_oc=AdrygfA9pSFow82aXgeVMICEQscUT51YnrIIrWPqptXT-0cKVnykF2dJAKGjW5L1NE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2RYNJPDQn8RSmEAWJI5Hi2wsyaYwhsviTEzdS22ToCw&oe=6B06F38E"}, {"file_name": "Screenshot4.png", "id": "981554587451161", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393589_981554594117827_545968684086100175_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckb_KVaNVnwQ7kNvwF2ciUp&_nc_oc=Ado5cu4nwzQhdSPe1FWlFxIE9YynGedFalQ8s14VeoJp__obpt0DEsb-guY1EpCBehM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ3Xyk43HLvnwIQvboVS6Kz76V8idBNinozaHGzzR2zA&oe=6B071FE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MAcT5l-QpAQ7kNvwGjN3dw&_nc_oc=AdoNzqDbk-xiKpddyyntyPilIEe3iWQbGlnnw4yFILax3CMtNEZ_J8lpcfCjzAQOh5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ85JYnl9EafBHeY3AnmXGIyt3rGzBBrnSayGbUSzYJPw&oe=6B071E19"}, "display_name": "TETRED", "keywords": ["retro", "arcade", "casual", "tetr", "block"], "long_description": "The game can be played in Virtual and Mixed Reality. The player looks from above into a rectangular playing area. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\n", "short_description": "TETRED - A Tetromino 3D puzzle game in Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "zh_CN", "zh_HK", "fr", "it", "pt", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24279770488279204"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393195_2461344527551448_3948395555829195106_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxmR_VSmJMAQ7kNvwGIhLoz&_nc_oc=AdrYz5T7gLzhuNl1F7bj-BnhJh5loasRE-KFjLaAD6HNttSJ-S6Vhgwo_l2LpdKNupE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzJxgGx9-k_8NSLqlz6WEYRXzI_IMtrnNJzOzuF5-C-g&oe=6B071656"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TETRED", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1728054000, "lastRevision": {"nodes": [{"id": "8772060356143468", "release_type": "SCHEDULED", "administration
ecXMAfvatZLYFpArVP5UsyU_9oLQ&oe=6A81AEB4"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwY-ZXaq01cQ7kNvwFRdbgw&_nc_oc=Ado1NflMmMT1KmIr0z8U_fid9MtY0oUarvhyz0NXJ2OYXMPoEFhzBttH06AfAz8KRJE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqBjqzA23vteiaAtwW8izdD4B-mqLRfUQs2lFdkEjHpw&oe=6A8193CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7Ma-9JjvKQQ7kNvwEATYxU&_nc_oc=AdpC4lcrhAxBozGT264qM4YOwqNs15qM_EPR2LewmJNm_BUrNGwmBI4QFVMW9s5wXX4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR3RphYBtzRAlkF70LH_wzEOjg0UMr4Oz5qK6y6mxOrQ&oe=6A81BE59"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
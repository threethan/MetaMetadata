EKP94EZ5raYBikUAWz1Gjn6aX1Zg&oe=6A295A34"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NwV9ZSnn44Q7kNvwHplbn-&_nc_oc=AdrNrnxKxBW_gLF6O2cJoM6wTgNLTwgRmnotN771Cg6PBMV1T_9wupxV2W19r1x8i8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WeGzIy5LsEHq_em2hvzY2ePwMxw1u5aGVs5Y4S8GDOg&oe=6A29778E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPwRpf_2ZG8Q7kNvwGtRvAJ&_nc_oc=Ado9g9gaoCf-W1bK6bADLnJaPYLDlMBIupmbaGW8TgZpC3y2CF4WX0EafWDF9DUs-m0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c9PO15wMeg8XdjwXzJoRU40IWCqCDVhwS0O8Po086qg&oe=6A2969D9"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
_6GzPT19pvyywk-wX85muwLLNpug&oe=69E61DB4"}, {"file_name": "Screenshot5.png", "id": "397612790004946", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036641_397612793338279_7406487488091581_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8-k_BhMKZcQ7kNvwF0ZtG1&_nc_oc=Ado0XTM7ydx5PYFfFaCclYLsiRAGL_Zr7jjISWo-WkWS_I8uUDnHEWrCORrN2aE7HpM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10CrdF635XhKHI77yzCsKU1k-fqYBjNGswWZv2rIBZ_g&oe=69E63B0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TETRED_Cover.png", "id": "509367518295397", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982724_509367521628730_557426402027958475_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9JC0BIl1MYQ7kNvwE3B_uW&_nc_oc=AdpyxZC5e5hxhvZQy-ZAMYKom1ruK15P7OWeP5NCpEl4G3cFsz10atH7fOlvOedgD54&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DKbmFK-V-Ye8u-wETXnei16SBInsLWM3cOXSUgI0P1w&oe=69E62D59"}, "display_name": "TETRED", "keywords": [], "long_description": "The player looks from above into a playing area with a rectangular floor plan. 3D blocks made up of several cubes appear at the top of the shaft and slowly fall down. During this time, the player can rotate them around all three spatial axes and move them sideways. As with Tetris, the aim is to arrange the blocks in closed layers like a puzzle - as soon as a level is completely occupied, it disappears and the blocks above it slide down. The game is over when the remaining blocks reach the top of the shaft.\nThe game can be played in virtual and mixed reality.", "short_description": "TETRED - A Tetronimo 3D puzzle game for Virtual and Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/retroxrealm/policy", "developer_terms_of_service_url": null, "publisher_name": "RetroXRealm", "support_website_url": null, "website_url": "https://sites.google.com/view/retroxrealm", "category": null, "comfort_rating": n
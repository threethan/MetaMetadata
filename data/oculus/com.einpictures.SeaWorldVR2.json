74\ubc84\uac00 \ub418\uc5b4 \ubc14\ub2e4 \uc18d\uc744 \uad6c\uacbd\ud558\uc138\uc694.\n\ud604\uc2e4\uc5d0\uc11c \ubcf4\uae30\ud798\ub4e0 \ub2e4\uc591\ud55c \uc5b4\uc885\uacfc \ub3d9\ubb3c\uc744 \ub9cc\ub098\ubcf4\uc138\uc694.\n\n\uc0c1\uc5b4\uc758 \uacbd\uc6b0, \ub2f9\uc2e0\uc740 \ucf00\uc774\uc9c0 \uc548\uc5d0\uc11c \uc0c1\uc5b4\uc758 \uacf5\uaca9\uc744 \ubc1b\uac8c \ub429\ub2c8\ub2e4.\n\ub180\ub77c\uc9c0 \ub9c8\uc138\uc694. \ub2f9\uc2e0\uc744 \ub180\ub77c\uac8c \ud560 \ubfd0\uc785\ub2c8\ub2e4.\n\n \ubc14\ub2e4\uc138\uc0c1VR\uc740 \uccb4\ud5d8\ud615 \ucf58\ud150\uce20\ub85c \uac8c\uc784\uc801\uc778 \uc694\uc18c\ubcf4\ub2e4\ub294 \uad00\ucc30\ud558\ub294 \ucf58\ud150\uce20\uc5d0 \uac00\uae5d\uc2b5\ub2c8\ub2e4. \n\n* \uac8c\uc784\uc5d0 \ub4f1\uc7a5\ud558\ub294 \uc8fc\uc694 \uc5b4\uc885\n\uace0\ub798, \uc0c1\uc5b4, \uac00\uc624\ub9ac, \ud574\ud30c\ub9ac, \ubb3c\uac1c, \ubc14\ub2e4\uacf5\ub8e1, \ub098\ud3f4\ub808\uc639\ud53c\uc26c, \uac70\ubd81\uc774, \uacf0\ucde8, \uc815\uc5b4\ub9ac, \uc5f4\ub300\uc5b4 \n\n*\uac8c\uc784\uc870\uc791\n\ubcf8 \uac8c\uc784\uc740 \uba54\ud0c0\ud018\uc2a4\ud2b8 \ucee8\ud2b8\ub864\ub7ec\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4.\n\n\ucd94\uac00\uc801\uc778 \uc870\uc791\ubc95\uc740 \uac8c\uc784\uc758 \uba54\uc778\ud654\uba74 \ub3c4\uc6c0\ub9d0\uc5d0 \uba85\uc2dc\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.", "short_description": "VR\uc7a5\ube44\ub97c \uc4f0\uace0 \ub2e4\uc774\ubc84\uac00 \ub418\uc5b4 \ubc14\ub2e4 \uc18d\uc744 \uad6c\uacbd\ud558\uc138\uc694. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://einpicturescafe.mycafe24.com/terms-of-service/", "developer_terms_of_service_url": null, "publisher_name": "einpictures", "support_website_url": null, "website_url": "https://einpictures.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_
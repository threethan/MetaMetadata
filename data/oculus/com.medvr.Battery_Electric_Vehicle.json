64.5771-25/473392165_644807838151239_4095123170535035691_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DirnQYD2ncQ7kNvwGU5MeB&_nc_oc=AdpqgtoEsT6gHs9wt8ZZB59V30v3QRIAOMv406XBKW9_g01xfxNhlFLxy34L0wxlpKE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ir6CrZ_0cDWPs4JO5pCwkRp_vQxeXYT9zVSWfhf0Q1Q&oe=69EA3887"}, {"file_name": "896976.png", "id": "505172455968203", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-I8OdZA0G8Q7kNvwEycMM7&_nc_oc=Adr52O7jlmUL1Hgo49jEGBNiysmGjHI3BhL84hYtiJsVxhtFErwSlghrpHZZBKhbgTo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V8D7lC9K9CnU0itdQnPv02OR6SwgDM7_SQHOmKTKIlg&oe=69EA2268"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to enhance your expertise, Certified EV Technician equips you with the knowledge and practical experience needed for the growing EV industry. Start your training today!", "short_description": "Step into the future of automotive technology with Certified EV Technician! This immersive VR training app provides hands-on experience with EV types, battery technology, and electric motors. Learn essential skills in a realistic virtual environment to enhance safety, efficiency, and technical expertise. Perfect for aspiring EV technicians and professionals looking to upskill in the evolving electric vehicle industry."}]}, "developer_name"
xOa&_nc_oc=AdqrpXik766rO56NvukrZ0f97Qv3_ohh1cuoaLDBcHZZaeaROCzMDIy8k-8hl2luVtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cwP0U9WcyyBD7nJqro1wuBey_O3CKsQNW60gRlIhe8g&oe=69E0FE07"}, {"file_name": "896976.png", "id": "505172455968203", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuG5mLeYZdsQ7kNvwFi7uNn&_nc_oc=AdocanD4gE6TIu1_A4GSvVtz1uNexy1CT0w2TqAQFzfrm_8fFZTRzjadP6EUIn7mKNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aqggrhmPUL_T_7w1z7-QAmm3qsxM9rU1Dp_ZJZN9twQ&oe=69E0E7E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to enhance your expertise, Certified EV Technician equips you with the knowledge and practical experience needed for the growing EV industry. Start your training today!", "short_description": "Step into the future of automotive technology with Certified EV Technician! This immersive VR training app provides hands-on experience with EV types, battery technology, and electric motors. Learn essential skills in a realistic virtual environment to enhance safety, efficiency, and technical expertise. Perfect for aspiring EV technicians and professionals looking to upskill in the evolving electric vehicle industry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "p
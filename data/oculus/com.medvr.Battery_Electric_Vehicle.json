64.5771-25/473392165_644807838151239_4095123170535035691_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdJE-w9U0wMQ7kNvwH0Fw4X&_nc_oc=AdpmHREgKLIvqT5eBIfBwODspCyNPBnivUf1uDKoL4DjRMYbdgjKHA_ezKRnGTfzM8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nSE3UaUkOL3AATtVzWiRG_6ZiuYoLNO8Di8SirUmmEw&oe=69FA0A87"}, {"file_name": "896976.png", "id": "505172455968203", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsF7rn_kT4UQ7kNvwGrqSo7&_nc_oc=Adr_U8A6-mdC5S6C8yhHVeo2i_dyJsPncQ9Y9i-jnfc_ihb6t1ekiazcOZXKy_OxaGo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UYR_gl6EMreOZkVimAn8i4Fd6IJS154e_AuxSBUmZsw&oe=69F9F468"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to enhance your expertise, Certified EV Technician equips you with the knowledge and practical experience needed for the growing EV industry. Start your training today!", "short_description": "Step into the future of automotive technology with Certified EV Technician! This immersive VR training app provides hands-on experience with EV types, battery technology, and electric motors. Learn essential skills in a realistic virtual environment to enhance safety, efficiency, and technical expertise. Perfect for aspiring EV technicians and professionals looking to upskill in the evolving electric vehicle industry."}]}, "developer_name"
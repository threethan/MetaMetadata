zFL&_nc_oc=AdrwVbtY1_jrt0zJjrqV4j1cXTGD6OQRlXPxz1exhSqqj_r-8-qV-uI7F-mxXBds0GE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FMgSTzhfyl4GD_1Bos8xGAIoY3vDz2mgro7NAcgkdjQ&oe=69DCD147"}, {"file_name": "896976.png", "id": "505172455968203", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asPvLEwDKagQ7kNvwHiDPij&_nc_oc=AdrQnUN7_JWIu03FIa_2fL5ywdOzv42U2xybC9fZoXQM9a3q4uqqfoorB7NDZ1Vwl-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nUYmC1b0JrP18GidAWmTvrBkH7eLuq8T3orko54LASQ&oe=69DCF368"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to enhance your expertise, Certified EV Technician equips you with the knowledge and practical experience needed for the growing EV industry. Start your training today!", "short_description": "Step into the future of automotive technology with Certified EV Technician! This immersive VR training app provides hands-on experience with EV types, battery technology, and electric motors. Learn essential skills in a realistic virtual environment to enhance safety, efficiency, and technical expertise. Perfect for aspiring EV technicians and professionals looking to upskill in the evolving electric vehicle industry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "p
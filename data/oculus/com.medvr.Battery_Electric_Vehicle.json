uscdn.com&_nc_ss=7f20f&oh=00_AQDFOMP9axbT8rqGjh6XJUnNqIyUSdA3jQbejbDOUR6XPg&oe=6A523FBC"}, {"file_name": "2573688.png", "id": "1479511906339273", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394220_1479511909672606_1759450680987155709_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvbLeMvaabUQ7kNvwHMAvF4&_nc_oc=AdrZuei2rno8_aFz84frFRHY6rgFuJMWBLYD9WzPIeS-rP8YLHpbPdT_5h3nNoGczxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKakeOplu1B2j33ucwlzPDf5aAuBYrKQy-RAF8_-AcnQ&oe=6A526433"}, {"file_name": "9098574543.png", "id": "644807834817906", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392165_644807838151239_4095123170535035691_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKPJY_v3UYkQ7kNvwHJf_aS&_nc_oc=AdrwGL9qYhMckSWpH4h3NtzcE3tr2JRRwIrx1t5Fx5sMkiFslDVFGAjMH-PRBH4FLb8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZl3A_vY5p_fkAYmV2PJLgshZyyMhMG2K_i25vKuVJFw&oe=6A525F07"}, {"file_name": "896976.png", "id": "505172455968203", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAYAXC0BHJsQ7kNvwHW_0dt&_nc_oc=Adolo5fcg7PevP1RUFsEpi27OHkk3NrvXgsXFLbwNZu7ipkDxQRjM1bh3XqL7UrqpTs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrcapQCgL4CwncgIKXInWO9SbriFn13fImgBpqx4epqg&oe=6A5248E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to
n.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mptyB3QlIhoQ7kNvwEOZ83Z&_nc_oc=AdnzG-lOM6aHREyskhpKiIuZKdd933tctN1YkfbUSGROQYRcGcHiQ_RNKecozTNuUzY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYWvgtfrt49cc5bdmyMkP15K3taAVazElIEpmld1TwgQ&oe=69B2C368"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to enhance your expertise, Certified EV Technician equips you with the knowledge and practical experience needed for the growing EV industry. Start your training today!", "short_description": "Step into the future of automotive technology with Certified EV Technician! This immersive VR training app provides hands-on experience with EV types, battery technology, and electric motors. Learn essential skills in a realistic virtual environment to enhance safety, efficiency, and technical expertise. Perfect for aspiring EV technicians and professionals looking to upskill in the evolving electric vehicle industry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immerselearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485
zCm&_nc_oc=AdpJISbybAfaDBVsenlCvlPxkENxvZ6-0x7DiCF7cory9LbAHq9cnSEb5E71D8W-ITY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlSwjO1IzoGBYQL6uQIFwO0wQx-KU9HExLSGxcuDMF5g&oe=69C667C7"}, {"file_name": "896976.png", "id": "505172455968203", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKn02oYzQUkQ7kNvwEkNIDN&_nc_oc=Adoq6BITIPP4kuoIrleH6FXGKV2OMYblTU6PUI8zteFpc66m3T6j4Ch0DdMVkGiPZhQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_VaGp9SSG9BtkTkxnykBqnCV7U8Jie6lVCQd-u71rwA&oe=69C689E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to enhance your expertise, Certified EV Technician equips you with the knowledge and practical experience needed for the growing EV industry. Start your training today!", "short_description": "Step into the future of automotive technology with Certified EV Technician! This immersive VR training app provides hands-on experience with EV types, battery technology, and electric motors. Learn essential skills in a realistic virtual environment to enhance safety, efficiency, and technical expertise. Perfect for aspiring EV technicians and professionals looking to upskill in the evolving electric vehicle industry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "p
lP2&_nc_oc=Ado0MOhIM7nDRdQk5RARhG8eBwSUj64RR9nHhzctYdoEQ0fSgwPgIinTfvaJB4JyE0s&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Eer8XHQ9VSciaxG7BDyADYcd2JjZZvZJxNl-MGizGrA&oe=69D78B47"}, {"file_name": "896976.png", "id": "505172455968203", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9rI3O5F27UQ7kNvwHOyG-c&_nc_oc=Adq_HU5S148ApDT8d2vetjapHo9bk6T0no-alQ2ceUQMf19_nH9bX9UDKQOKL2wXbbo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mnchD1rgQlI-elsmvvA4X8LUZUs6vOdcgmojC1YhYuA&oe=69D7AD68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to enhance your expertise, Certified EV Technician equips you with the knowledge and practical experience needed for the growing EV industry. Start your training today!", "short_description": "Step into the future of automotive technology with Certified EV Technician! This immersive VR training app provides hands-on experience with EV types, battery technology, and electric motors. Learn essential skills in a realistic virtual environment to enhance safety, efficiency, and technical expertise. Perfect for aspiring EV technicians and professionals looking to upskill in the evolving electric vehicle industry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "p
64.5771-25/473392165_644807838151239_4095123170535035691_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJE16rlTDskQ7kNvwFH5B_b&_nc_oc=AdpKgANxEMJ1LA-SFFjaQ1ivl07xPCoZ4JSvlmP--GUm6ohrcj8M8Q0gr2peP8EQIeI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3c6pfoLft-cJ8ZiJOwR_IKRARTCWmG84z6hjMg_M0GUA&oe=69F4C487"}, {"file_name": "896976.png", "id": "505172455968203", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392052_505172459301536_9114790666962688767_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slC-LlBvol0Q7kNvwG1CYlx&_nc_oc=AdqhRPsxNQ4TRLi804vFQ24uloa2ldNY--xvSqLKpb6u0rSif1mVMEphb1j01YewqqM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LB97pziZZ6UVKaF3Gb4mSDT3Vet44pNP-vUI_e2kf7w&oe=69F4AE68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified EV Technician", "keywords": ["EV", "Battery", "Immerselearn", "Training"], "long_description": "Certified EV Technician is an advanced VR training app designed to provide hands-on experience in electric vehicle technology. This interactive simulation covers:\n\n-Types of EVs\n-Battery Technology\n-Electric Motors \n\nTrain in a realistic, risk-free virtual environment to develop critical skills in EV maintenance, troubleshooting, and technology. Whether you're an aspiring technician or a professional looking to enhance your expertise, Certified EV Technician equips you with the knowledge and practical experience needed for the growing EV industry. Start your training today!", "short_description": "Step into the future of automotive technology with Certified EV Technician! This immersive VR training app provides hands-on experience with EV types, battery technology, and electric motors. Learn essential skills in a realistic virtual environment to enhance safety, efficiency, and technical expertise. Perfect for aspiring EV technicians and professionals looking to upskill in the evolving electric vehicle industry."}]}, "developer_name"
nt-ord5-1.oculuscdn.com/v/t64.5771-25/39031605_3203989859924977_8447848672177917633_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEDpvqB4xhcQ7kNvwF1KNIm&_nc_oc=Adq_WRIZi38PixnzYTR6HzLdMgBKoMQEuntgf8Gk5gJei13WPYhSpCWDAWsUANXDN7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FFgHcjxa9g1S4t9QCOG6Hw7gnzVkUZ4LAgL2pxDMgAg&oe=69EB7076"}, {"file_name": "Screenshot 4.png", "id": "258738296246534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_258738299579867_8747237094740919814_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1C_Pmg0mEUEQ7kNvwEi2MtM&_nc_oc=AdprNZ_AKqe4BtzKsBa56Bw750o_dysfSda0yXpntH8Gjkc8u0ezFeonC7AxaP_xjOA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GqLsGRaX2hwNT5z-zx5Yycc9nPDFpixc5kZZL5KoMow&oe=69EB580A"}, {"file_name": "Screenshot 5.png", "id": "333949875108092", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036675_333949878441425_9202381856271782696_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5XJyTMZbAoQ7kNvwGeRTaQ&_nc_oc=AdpZcDR11RQ9cIWGakBgBw9dPzo8Rhi1dHuGNJoqoPPPbtl7qlDZI34QtUMvyt7OWpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30ZZVhfXWzLYSHw7GHFN9Qaq6XdxmP4gIl0yXnjpqMew&oe=69EB87CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "353424643270982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974645_353424646604315_7736745125659601156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eyDNDEu_bgQ7kNvwFQ8A8A&_nc_oc=Ado6u0EAy734hkP5IaosKo_24hRISOK-cjO2EFreF74_LAFDfsfad1QFCkceE0r9dvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2I8waJ4Yv-aLWYsGA9Gg5MEnAjIoR_0vtvoSNdta-qsQ&oe=69EB83B7"}, "display_name": "Hypnosis Reveries", "keywords": [], "long_description": "\"The creator of HYPNOSIS REVERIES perfectly integrates imagination and new technology with VR media, takes root in modern cities, and deeply explores the social reality facing young people today. It is a rare reflection and expression in Chinese works.\"\n\nWINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on the Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again.\n\n* HYPNOSIS REVERIES is originally a large-space VR experience using a redirected walking algorithm invented by Jessien.\n\n** The current version available on Quest Lab/Store is a remade version, supporting Standing and Sitting modes.", "short_description": "WINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again."}]}, "developer_name": "Jessien", "developer_privacy_policy_url": "https://hypnosis.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Jes Studio", "support_website_url": null, "website_url": "https://hypnosis.art/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
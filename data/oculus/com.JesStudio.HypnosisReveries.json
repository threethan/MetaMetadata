ng", "id": "353424643270982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974645_353424646604315_7736745125659601156_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFkO_QcsyboQ7kNvwEOeACS&_nc_oc=AdouTKm2M5dRcCcFHHTKIPkP2l92htauBCnO9rc7Bm6xxWQPI1V2wb7Xtq6qxEjl2uM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZrJ60VTdfmI3r_VCE-j_6HE_Y8KgxWEoo9JEWAQMUSg&oe=6B1068F7"}, "display_name": "Hypnosis Reveries", "keywords": [], "long_description": "\"The creator of HYPNOSIS REVERIES perfectly integrates imagination and new technology with VR media, takes root in modern cities, and deeply explores the social reality facing young people today. It is a rare reflection and expression in Chinese works.\"\n\nWINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on the Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again.\n\n* HYPNOSIS REVERIES is originally a large-space VR experience using a redirected walking algorithm invented by Jessien.\n\n** The current version available on Quest Lab/Store is a remade version, supporting Standing and Sitting modes.", "short_description": "WINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again."}]}, "developer_name": "Jessien", "developer_privacy_policy_url": "https://hypnosis.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Jes Studio", "support_website_url": null, "website_url": "https://hypnosis.art/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3270902423140062"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1098341750712095"}]}, "baseline_offer": {"id": "1098341750712095"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1647259200, "status": "PUBLISHED", "id": "1098341750712095"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5308596059165232", "version": "0.2"}, "id": "426172745878096", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4991530740871767", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5308596059165232"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "426172745878096"}]}, "change_log": "Important update.\n\nOptimized Movement Mode resolves the following 
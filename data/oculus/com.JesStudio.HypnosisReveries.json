177917633_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EtojxGl6XUQ7kNvwEE3WCp&_nc_oc=Adlcda8ywtErFcGm3pFAYE-T-aMpzSd-Dvh78qzevXMXXPQh40TZ_A8MB4gdlS7gkgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1YiiXZ3P7GyfQWN9sL0JfNys5S8-1okqTt2rbIfnE8Q&oe=6999B376"}, {"file_name": "Screenshot 4.png", "id": "258738296246534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974711_258738299579867_8747237094740919814_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LksG5UEZj0Q7kNvwFsIcr_&_nc_oc=AdkA_mK2V9mdzuWGgt2BvosesQbq200OpD7mXUWLiCHzCs1c6JVAeFrQpLQkBGP3b0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftXTfmVAmRpwQyzibsr4GKe2Y5fPITrYhIeYlMKPWMEmQ&oe=69999B0A"}, {"file_name": "Screenshot 5.png", "id": "333949875108092", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036675_333949878441425_9202381856271782696_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6cRztTCyVkQ7kNvwHDC04b&_nc_oc=AdlNnJ1p1e31xoxCD8-MxqJLSAjgH-BapDDk5B5fEcccvy5L8u08-ZqJt_zbDpDtDgQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvrNiBtKA6xsXooJDOpUI_Pap2KnL1JPBhqo4IHrGrFlQ&oe=6999928D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "353424643270982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974645_353424646604315_7736745125659601156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKBdhRryGAQQ7kNvwEia59u&_nc_oc=AdmClXRTKWG9GJ3icV8UGz7Aot8tk8bllwlDjpd6KWoJKOnjeXhNkO28HOQyjb9t8Nc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afslvk6cc1xG9Wvh804w2n1QlaMjUSamhM4hIW5M6Hb-PQ&oe=69998E77"}, "display_name": "Hypnosis Reveries", "keywords": [], "long_description": "\"The creator of HYPNOSIS REVERIES perfectly integrates imagination and new technology with VR media, takes root in modern cities, and deeply explores the social reality facing young people today. It is a rare reflection and expression in Chinese works.\"\n\nWINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on the Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again.\n\n* HYPNOSIS REVERIES is originally a large-space VR experience using a redirected walking algorithm invented by Jessien.\n\n** The current version available on Quest Lab/Store is a remade version, supporting Standing and Sitting modes.", "short_description": "WINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again."}]}, "developer_name": "Jessien", "developer_privacy_policy_url": "https://hypnosis.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Jes Studio", "support_website_url": null, "website_url": "https://hypnosis.art/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
nt-iad6-1.oculuscdn.com/v/t64.5771-25/39031605_3203989859924977_8447848672177917633_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEMX_wCVwKgQ7kNvwEAvMtA&_nc_oc=Adr0B_rXMbEPcfjA6j_4oU8_WI1RcNasCnog5c1X_buVuYyfw4ISR7JKiF9cGunikUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgvziLuTKE7d6O3_2mxpFxmCd58lNCvocM91xySDUVcQ&oe=6AE5ED76"}, {"file_name": "Screenshot 4.png", "id": "258738296246534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974711_258738299579867_8747237094740919814_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51y03WkiPOIQ7kNvwEMpln8&_nc_oc=Adr3DGYfWB-6lH6IhHPZDLAjXf0f-3lqFiOKPTjy1UYKKkXTz97R6B7Ny8aGvkR_R1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxKbrreGILboj3do7tro-AkmvJNbSvCCIp2hhb-L-Ldg&oe=6AE60D4A"}, {"file_name": "Screenshot 5.png", "id": "333949875108092", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036675_333949878441425_9202381856271782696_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvDpw3w4OyUQ7kNvwEftPDi&_nc_oc=Adrs4A-TyE6R4iTAlZs2MbmmsNrprIbqB4QwDn6_N2cXpE-FulDIeY0nqIrPDokdV9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHEuQZu5AoKuTFs8C1kMi4aO4UG_0WMYPgG0JjjsNLgw&oe=6AE604CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "353424643270982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974645_353424646604315_7736745125659601156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqxN5MKWjCgQ7kNvwGtLwQ_&_nc_oc=AdqdGPqL_n3q4wm9Fs8wf60qQ65hMa9s1JIw2pI4-TuNT44Z-IpWE5yyJvolIm0DtvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvwqN85-WFLO166-3U27bYnY5RXzB6SJsYYCWQOXWNHw&oe=6AE600B7"}, "display_name": "Hypnosis Reveries", "keywords": [], "long_description": "\"The creator of HYPNOSIS REVERIES perfectly integrates imagination and new technology with VR media, takes root in modern cities, and deeply explores the social reality facing young people today. It is a rare reflection and expression in Chinese works.\"\n\nWINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on the Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again.\n\n* HYPNOSIS REVERIES is originally a large-space VR experience using a redirected walking algorithm invented by Jessien.\n\n** The current version available on Quest Lab/Store is a remade version, supporting Standing and Sitting modes.", "short_description": "WINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again."}]}, "developer_name": "Jessien", "developer_privacy_policy_url": "https://hypnosis.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Jes Studio", "support_website_url": null, "website_url": "https://hypnosis.art/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommende
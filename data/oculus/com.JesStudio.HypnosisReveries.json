177917633_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCUA28QMglYQ7kNvwG7P43C&_nc_oc=Adm3OdDX06n9YoeMuTEfQ5Yrc34c7wG9mnMR0Ihw81VzdG2jp1KArfm5GZDWnGF-lS0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvLQfjJKoQaZ_faiFnTzjgPWhAL0gKhZqQJUC-Ko_H6WA&oe=699C5676"}, {"file_name": "Screenshot 4.png", "id": "258738296246534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974711_258738299579867_8747237094740919814_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTmxlrxbCWcQ7kNvwGF7XAj&_nc_oc=Adm8FNFhAr2eBMw0DZh4VCYss9u2EV8KJyIPjN4VC7gOIlIfRF_ovs4rvNeiqk8hDKo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftR3XmRN0fTEdEa6fynejuomsRjN-eCoMHmWR6H3jefUg&oe=699C3E0A"}, {"file_name": "Screenshot 5.png", "id": "333949875108092", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036675_333949878441425_9202381856271782696_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPcqAVb58icQ7kNvwHLcNcm&_nc_oc=AdnQl3XfVZaF_q7uDd6dWaQE7L-PRqghahcxpu2eNKJqZ6YxpngqwtOqjz61tSh2DHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afus6VyXpqQ1cjNCHXyBF7Na4ZoqfuvuFPhhXz01bctw2A&oe=699C358D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "353424643270982", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974645_353424646604315_7736745125659601156_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKBdhRryGAQQ7kNvwG8Kouk&_nc_oc=Adn4B6WPEeVPbHUO5HnSyGETJqx9HJLSH4a3QGWcTcuHnc2CU6utzp6S3uJDJ1djM88&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv9k694RbykTA-8N4ilVPvOCglrXaPORIngbJS3vcwj_w&oe=699C3177"}, "display_name": "Hypnosis Reveries", "keywords": [], "long_description": "\"The creator of HYPNOSIS REVERIES perfectly integrates imagination and new technology with VR media, takes root in modern cities, and deeply explores the social reality facing young people today. It is a rare reflection and expression in Chinese works.\"\n\nWINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on the Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again.\n\n* HYPNOSIS REVERIES is originally a large-space VR experience using a redirected walking algorithm invented by Jessien.\n\n** The current version available on Quest Lab/Store is a remade version, supporting Standing and Sitting modes.", "short_description": "WINNER of the Best Chinese Work at the Sandbox Immersive Festival 2021.\nOfficial Selection of Panorama Unit at the 11th Beijing International Film Festival.\n\nBased on Jessien's interdisciplinary research in VR related fields over the past decade, HYPNOSIS REVERIES takes an abstract and minimalist approach to tell a story about growing.\nThrough a 20-minute exploration experience, you will step into a mental maze, looking back at the important moments that changed you, and see yourself again."}]}, "developer_name": "Jessien", "developer_privacy_policy_url": "https://hypnosis.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Jes Studio", "support_website_url": null, "website_url": "https://hypnosis.art/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
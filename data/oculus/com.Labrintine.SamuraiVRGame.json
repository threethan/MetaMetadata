J-xa-wrSIiWHw&oe=69A57200"}, {"file_name": "aaaa.png", "id": "1504060880426115", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974535_1504060883759448_3039452923271027083_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEDD-8tMUu0Q7kNvwGCNVsC&_nc_oc=Adkwz7fnuu1dNtWfUP5GnxCWmq8GpEOO0ZE347xW3brV5G61gpAUhrsWU8GUUIMUnZ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afsw-qkLWrJNAuC4ZvQOO1pcT-ywRs8XdQ1QN-3CDAmp_w&oe=69A572A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerthumb.png", "id": "169206229537088", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422386_169206232870421_686099570980409076_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s642Uz68c5gQ7kNvwEFdb8l&_nc_oc=Adm46rhkFXBrUUBWNyx1iWM4toSVu28p2tkhYjtxIW1BGa8bQhbhm94Alu7-TOJgZ_Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftVeH5TGwSQo3KOqutKShgp84qDsEfbBcVE_eYENfVcUg&oe=69A571BF"}, "display_name": "Samurai VR", "keywords": [], "long_description": "\"A samurai has no goal, only path, and samurai's path is death\"\n\nSamurai VR allows you to become a samurai to stand as long as you can against different enemies.\n\nFrom the moment you'll grab a Katana, ninjas will summon a fog of war and will be continuously attacking you with shurikens. Use the Katana to defend from them, as you can survive only three hits.\n\nTime to time they can also throw a bomb towards you - don't try to block it with a Katana, just make a step to side or crouch to dodge it. Keep in mind - you can't move with a joystick in this game so you'll have to move yourself. Make sure you have enough space at least for one small step to the left and right to play this game.\n\nBesides, enemy shinobis can spawn nearby, trying to attack you directly. Your goal would be to hit them first. Most of them won't survive even one hit, but not enemy Samurais. When Samurai will spawn attack him three times as quickly as possible, and don't forget to watch for shurikens and bombs!\n\nIf at a certain point you'll feel that it's too easy - don't relax too quickly as the game may become faster over time! ", "short_description": "Grab a Katana and stand on your daimyo's castle defense, alone against an infinite horde of enemy shinobis. Kill the enemies, hit back shurikens, dodge bombs and beware of enemy Samurais! "}]}, "developer_name": "LABRINTINE LTD", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Boom", "support_website_url": null, "website_url": "https://www.labrintine.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25065976676382080"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035446_3139711359656290_4442146545418474213_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPah39wrCnAQ7kNvwHQRRys&_nc_oc=AdnFWU34y7kFf-iH8Bz7_7zSFbKSLwrjdt5G6XunFrdz6Ogs6-ZjTOARciLgsQrEN2s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsATMlFASdeJKTIrF_4Q4y2mcuVXyzKXSYu3WqqI0dARw&oe=69A59C96"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Samurai VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"to
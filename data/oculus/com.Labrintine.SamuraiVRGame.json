5998", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422386_210621188659331_2457298677446264864_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQH5lVnUSJIQ7kNvwH_6MfI&_nc_oc=Adms_1vMxWGAYMduKqfUnuRi6PSgQcQXbweoeCky0i1tP_myOma2OC53ZMidx6CNHS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftpXEfFXOhL8E0r9f_qykRoa7kAmcwsseGloME42WDTBQ&oe=699B124F"}]}, "id": "759705826089754", "locale": "en_US", "screenshots": [{"file_name": "a.png", "id": "696750738975674", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982623_696750742309007_6426019389362087589_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lm07rzybr0Q7kNvwEi893f&_nc_oc=AdlCcbT5ZI72pUGrerjwKuH2_AT3nhS3d_M99T2RBtwArMVHU6Pu1d2tqoo30b4TiDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu6RISUtGMBrqX99l-_WdedJfHrQAfNCuALT8TIl9or9Q&oe=699B0F06"}, {"file_name": "aa.png", "id": "325323336565260", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75236132_325323339898593_6477404099909900160_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvxxkhDGGNgQ7kNvwHV77HZ&_nc_oc=AdkQsTiAzwfSH5E8uwKW_oLTFd2KRq9Tz8jQn0ANS0Z-gKPOUMrdE8WaCAJEQrmsaAk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft6XC4rDURwAiGxsv14AZdSFUmLB6hj2ao4wXzYPw5nJA&oe=699AE348"}, {"file_name": "aaa.png", "id": "290380220277183", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031434_290380223610516_5553629018407681014_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EByv-zt0oT8Q7kNvwF-kg-d&_nc_oc=AdlE7yMNscEn8Elsy9hGIsy1KAg2uOpL9ATxKZug8WnFQ0IM6PEFYjnqdgPJ3wKMAHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvlWrzDV5GKwaXytpSICrrkftdAnO-ZF5IdpSzFaEdffQ&oe=699AF47D"}, {"file_name": "Samurai VR Bow Screenshot.png", "id": "744201844468947", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334063_744201847802280_5966558133338165217_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipXLPTGp3k8Q7kNvwEtI4X8&_nc_oc=AdmQvqGE0ldMTPzDHRjaG6pTMn4IWTpOidZJ1GeX2Vzj3Yt5qwHcOf6Ve82IKUGzOPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftx4pIv8l6plnh58RhVSWZdFChHTNbJ7lMF3BjQHcM2jQ&oe=699AE600"}, {"file_name": "aaaa.png", "id": "1504060880426115", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974535_1504060883759448_3039452923271027083_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPaXXrkH4VYQ7kNvwFx0Lr4&_nc_oc=AdnIAgBbIEyd35ttFobKinc_GK_BF1b0w2uuj2JZTsOSvWM_rWbcO9eLeLvyvzAXpE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvvzWE3Fxy78YzHrGvoWjK9fZeSXh-zMYhVu33c0N8bSA&oe=699AE6A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerthumb.png", "id": "169206229537088", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422386_169206232870421_686099570980409076_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgRr1FmHRCgQ7kNvwG3fCly&_nc_oc=AdmNtbt0BNqPpQmqfeWnhOGaMW1-M7Hv0U3sgM15nrL9QTpkpERus_mPYQP9ZAmRJpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvipZbn-v6X7cJn_NHtin0I4NSfmdZtX9XyBYc2v04m5g&oe=699AE5BF"}, "display_name": "Samurai VR", "keywords": [], "long_description": "\"A samurai has no goal, only path, and samurai's path is death\"\n\nSamurai VR allows you to become a samurai to stand as long as you can against different enemies.\n\nFrom the moment you'll grab a Katana, ninjas will summon a fog of war and will be continuously attacking you with shurikens. Use the Katana to defend from them, as you can survive only three hits.\n\nTime to time they can also throw a bomb towards you - don't try to block it with a Katana, just make a step to side or crouch to dodge it. Keep in mind - you can't move with a joystick in this game so you'll have to move yourself. Make sure you have enough space at least for one small step to the left and right to play this game.\n\nBesides, enemy shinobis can spawn nearby, trying to attack you directly. Your goal would be to hit them first. Most of them won't survive even one hit, but not enemy Samurais. When Samurai will spawn attack him three times as quickly as possible, and don't forget to watch for shurikens and bombs!\n\nIf at a certain point you'll feel that it's too easy - don't relax too quickly as the game may become faster over time! ", "short_description": "Grab a Katana and stand on your daimyo's castle defense, alone against an infinite horde of enemy shinobis. Kill the enemies, hit back shurikens, dodge bombs and beware of enemy Samurais! "}]}, "developer_name": "LABRINTINE LTD", "developer_privacy_policy_url": "http://clique.games/privacy", "developer_terms_of_service_url": null, "publisher_name": "Clique Boom", "support_website_url": null, "website_url": "https://www.labrintine.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25065976676382080"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035446_3139711359656290_4442146545418474213_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J978N_EsSGUQ7kNvwF2IPm-&_nc_oc=AdlBZX9VOReq0bB3AeX4xi5S2_Qmi_9OCfz0JSZEIpFWejMU8ZUmk9MjGyRUi6eaHKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu_zh1OLdXp40DgJ-7KSUJpEnakI6hFWItDwuyL6RMUTQ&oe=699B1096"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Samurai VR", "platform": "ANDROID_6DOF", "context_category": {"conte
": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303788_830752813068241_7415669986707009869_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZG88t7yCwoQ7kNvwGEO6a3&_nc_oc=AdnWEembiCL1Ck4Qoy8ZWbtfdjcX-6Tloct949Kz355xm-BL7jRZZ93BWzUMTgu-KPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvDH6CBMf0UaijU6_CPfI0MKCnzjnRWSGEfDljJj73npw&oe=69A9914D"}]}, "id": "743839654854832", "locale": "en_US", "screenshots": [{"file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwcztJQ6b-gQ7kNvwGfMUQB&_nc_oc=AdnmMQDe9d8ITJR0deXeo_msgEcOs8KPW1hK_zNvFyzlaWo9tLhLMByOdU3gO_SoELg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuutfIhrEL8yMOdaVE_k9262DSkUpoqVhBlmYmdNsFFUQ&oe=69A9908E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMYBwyFeVGAQ7kNvwGbSxtX&_nc_oc=Adm8yK6FYdm62M_VW_2L6vV5YEKPuMllJYizHGzmArXINkewoiJdiTz5EAX8xkuzSTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuVlMBuTVj72VabeEPEXXh_jkqI9uFM6kEFEVS4C_zjaQ&oe=69A98D02"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f55QLEh4usQ7kNvwGj_fV-&_nc_oc=Adk4Z9u34LyY1UKhURjnPFKR2VAJKHOKVZxYRwxR6fI9dBeRxdYVDI7NkB0r7pnbYJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvZxWwfZg64OzzdM94cHyh4y9RXRgENp2gQYwivqs8gSg&oe=69A98447"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdCYy1TPNxIQ7kNvwH7hzN9&_nc_oc=Adlog3l30gMdzCZay5W0c9angGLLZiWyCpRbWhPJjkTL1n5jz0a0bqRPqXQB-K0a0g8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsndsrATjGCUp7ZwVM-waHa1O564Bg0UrxXEuS8L5U9Hg&oe=69A97397"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XazyHE31-Y0Q7kNvwFf86iD&_nc_oc=Adk9GnQSMVR3UTZ6i5yJuEB2odFpFR11dTx6G_HeqwodFDOAGEgdPF1gyjdU7UKLBmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsjaT3nN2SNAVKka2FLohHLYjbAdEI5bZASGKjFaWHVJg&oe=69A98F86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-7NBYz3qAUQ7kNvwHaEq8W&_nc_oc=AdlMi0tsgyTNXmCmegOR5ZUJkD5SN7TyQn6zf7wgtFyOY7RzALXR1vqnnklucmFhxEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvK9zfhuU8DeYiJpbfdCSJsgvlaq2zDTe3U-itAJRQdVQ&oe=69A96365"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "1554338885604872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766917020, "status": "PUBLISHED", "id": "1554338885604872"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25330734263221271", "version": "1.0"}, "id": "1899695333916790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25010918205202880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25330734263221271"}, "release_status": "
file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntJvwAemUyEQ7kNvwGmy_HB&_nc_oc=AdqHU2pCX8vB_fwoBQxQkV9-a1IU9ABhM8dZZOPjThfDuxoy9WWVaetB34g-5UzU788&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PFAfr-EyFlOrd9G3dhWeG_wnxW_MlwK-_rTYcMXue2A&oe=69FB4D8E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUT7BCtq1y8Q7kNvwFXyvK5&_nc_oc=AdpguPVWT-VqETbbOiTU-327sSIHpsc5h25NWpDU6mTPovscJpyjkToydpM5dIXwgAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45n2eg8TlQgtOTi3JPjXuwhMFOxEfqBfV3Xj2sJ27eTg&oe=69FB4A02"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp3PMXrYFPMQ7kNvwFrK22x&_nc_oc=AdooyCaaw6Fbop9wvtHlu0qLnd2wWiXRCd5ycpfeN6Jd2Qam2qRxZuVcvxH7Shvcgd0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E6iac4NhgAMfGJFibw0cc8-iHtHai4duvGpUrPbkYTw&oe=69FB4147"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L6342SZMnwQ7kNvwFK-uDY&_nc_oc=AdrJeomMJN3Px4DWSMKGAWfeLftipumSEALrN48wf2qLN7Fe_xmHlZNKaF2fTAQrnn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YtO8IycFpij5HdGJszHJZlg0xzXSq0jHfOsfUPzUpAg&oe=69FB3097"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmT7TSR4uBMQ7kNvwErCqOL&_nc_oc=AdoDGTLPRfleNwobvw7bOkH1BvmLqm7UVkk-Ebfe4myK583ydz3ZJEYTytE3LY82S8o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aJuiMdZMr-iaMjliyFmOmqnGq7hpVPYT_bEZkKqm3ag&oe=69FB4C86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7PoSAwMUWcQ7kNvwEULVFd&_nc_oc=AdpwCd5E3vtrcfNNr5Gp6OniMwlFz29ruJjZK6iov4p86bLzeYZgrNEVsvyvxWmaJTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kCRkpYSJPrJrn_gaC576sClWHjaxbbuDkqMjNphh7Fg&oe=69FB58A5"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
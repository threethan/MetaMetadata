6108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02S3Y-JNPl0Q7kNvwFe3GQr&_nc_oc=Adppz2eYmUAiRuaGREo3zch0h0_reZAudUhLLwfegExYjN7C8dUxy5r0ghSONFigMaM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GeUOdqzQZzj2Zk7FxW6zW267s4mfeQVfYwhcWaZBO9g&oe=6A3D53D7"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4IGzU15uswQ7kNvwH1hKjQ&_nc_oc=AdqEWK6vnhm2wsOPw-Sw9rSY15FuEd3DIFzuPtNge1En6_ypkvtRrA_WYpYEG0yN7UE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RULYFZ__iFTHKNprdBH4zA9qx5iLEPKFDtUMyzLdMjQ&oe=6A3D3786"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0Y5zlp6BvoQ7kNvwGavpud&_nc_oc=AdptahR1Sxmki5pLfa1zn5gv7A374MYKBGBcfBegRJizhiD32iYmkrf9I3Nn8R9Z1CM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1IJMGA_J-v2y7aeUJFnviRLXxsclxHofQ9xZYFH0K2A&oe=6A3D43A5"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "1554338885604872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766917020, "status": "PUBLISHED", "id": "1554338885604872"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25330734263221271", "version": "1.0"}, "id": "1899695333916790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25010918205202880", "is_concept": false, "latest_relea
file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkUipNFp4L0Q7kNvwG1Nwcq&_nc_oc=AdrvVa8d-pSVTs5gAX-W_hnIZBstF9JPOXkELKgtACvbYyAmHFjt1-hrO_8RHm03OUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71tNzu1_7fAo1n4I39chnOEzY_7oxCPcReq9lkhA9bWw&oe=6A072B0E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eohFodaZo8Q7kNvwEfeVxP&_nc_oc=Adp-nEtAs1jDWo7ivWwNS3Xnfqfg8doT7lVet9-iKVC7RJ_q3lambk5s1T8rNIA-o6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wAckheAY2wWYKH0masYSrSjPSV7eKVVfl46_6LD4gPQ&oe=6A072782"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00oY_UM6h_4Q7kNvwHNfvdw&_nc_oc=Adq2NegipsxJlRy3MFkbmdInD9EP9paG8h-wZiyfuXWoSh0l_AaxEYNQYQ9UETCocKo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vgKdZDU5pp6otTxcNbNiS1Lbv2dpTLHahR5Ac2Xrb9Q&oe=6A071EC7"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVhl6V4AQFcQ7kNvwEnEW4Q&_nc_oc=Adq_AiX2ZgrZ3TJ2RfLwf3KJu6M_OEN-UegG_7eRevLKO_L6bxMKyG6CJ5T3XDa2ojw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78PdHaZutEXhLp6kesETIVmVe-5oC_vMPYuXtB_70K6Q&oe=6A070E17"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xbwjfSybvIQ7kNvwFZeqwR&_nc_oc=AdpnwnEOz8mnJX_PYQKJNHLrj4kLsq5do4vEXWCI1Y28UC3N8JXMF5z0dCfpSWoAfQ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y4t3udTaAU-c-rjcVSJJSmbiL9UuiTtH_7-TFJN8U5w&oe=6A072A06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3dCMTioNncQ7kNvwGM7oY5&_nc_oc=Ado96WWdoetPytPX4F2et_aUszAjwJZit7sb_6zzmyOIxlWzrSxCUOD4AHS4_fknlNs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zszyvp29A-CBIE0fSDsjjYFo4R9jrrJBiMrt_iIjE5g&oe=6A073625"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
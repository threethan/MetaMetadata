: null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "1554338885604872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766917020, "status": "PUBLISHED", "id": "1554338885604872"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25330734263221271", "version": "1.0"}, "id": "1899695333916790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25010918205202880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25330734263221271"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1899695333916790"}]}, "change_log": null, "created_date": 1766479414, "id": "25330734263221271", "version": "1.0", "version_c
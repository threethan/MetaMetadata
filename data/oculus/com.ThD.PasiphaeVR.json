file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtQAY68vTaAQ7kNvwFYuJqG&_nc_oc=Adp8XcfiW5xxjYdiqXmdBSXaGah6GBDsXbeFADIWKgLZIOqwo7_tDkLb8c_oiC3xfNY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-25Emq6b_96Dht-PrmREwrk2nxZgRvusDuhox2tIu8rQ&oe=6A32AC8E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpJadJfpK2EQ7kNvwEIUXA8&_nc_oc=AdqSLqYwQIQHHrpZtXOl_qmmkFcVSErqw53e9KZ-NwbXSmtzops1DYwE7TSLW5oE-ZA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nrVEirT2p3aX6uDHA_VantKlSIf8qE8y2bB2KQ1JvsA&oe=6A32A902"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltvupzgdG6UQ7kNvwEpqaHR&_nc_oc=AdqKMdrRf84rP8X03MmmiNVEsGnedrYuELAUC3MfxzjCvKngZdLjizdaoitSj2vUgKI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hlNTaIWrmVarqImI5zSHPMPzi4_XdEDur6nLd8GAC9w&oe=6A32A047"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1KXvJAMwFAQ7kNvwEoaacj&_nc_oc=AdrE3G-u50UEzG4q9a718duijn9H97Ge-H89FakKxLFqBb3U2oWmx5dahtvBv5SkZf0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ChUi5goz1JALLmPdtlx38Wvv6jaJXUuJ0-BDOSa0igA&oe=6A32C7D7"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk33cBy5fAMQ7kNvwEpO3av&_nc_oc=Adob_OC60Z_uoYfmjQNJzE1KOzwd3uhbykt_5AlUJPykAXYhbMihQqdlYxg3kTiFQ4Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QwfZFaEvVTgPTC7jukqrOA-v9vXwIgM55b6Hi2lwiJA&oe=6A32AB86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF_oqKq3LD8Q7kNvwFb_jME&_nc_oc=AdrHWscFAw8Z4zP8P4Sr2fEWZ2ZGbcaKIV9F0QaXSkLQAY5Z4F8kcroe-kXZH4Voqag&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6wmxHL-ikHbrVePSQC92it4kQil9XUwGRo60KHxaHUA&oe=6A32B7A5"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
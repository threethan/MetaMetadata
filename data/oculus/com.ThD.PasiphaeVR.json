c3-1.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6f-T9SFzBugQ7kNvwHIMr-B&_nc_oc=Adoz0CzZnSAcSekb_lIGKo7Kv8Zx9-ELBYmH7debfWMAsDDj9ChuDvL9_2E7sGX4H6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyBNnPCt07p3MF5gtf78qWzMvPQd81e8NA1xjNpRIg7w&oe=6B032587"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuDjH_Zi29MQ7kNvwGtM1rt&_nc_oc=AdpP0klrzwNsBUTS5DZt6qd6KPNaNpt0Krx95bk0AEyLTX-9JA-Dh9PAR0on3FHqlJI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsKNh8K4S6lufE4L_p5BpVQuTE1CB-g90rCGLiCkCosg&oe=6B0314D7"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wkc-iXLTtOUQ7kNvwHaaSGu&_nc_oc=AdrmASAva4fJiLbydS8Da0cKrRdnuh-_gohaChkTcW3p-UqM8mKKG0eqgMfl-tr_L34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx97gbRGLf0MJQ_4Elei9-9D3taGM5sg3a-dZqJhObyw&oe=6B0330C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfs0Yb3JUboQ7kNvwHLnRr4&_nc_oc=Adqqf8uOOemaNaQ7BPhi-Yt6MyQwFvAyX8FenMQUShGNnqTzMjc6QELiZQD4bA6T3-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNbHHuMSTmM92FrW8PoO9syKPdZ5dZQvmXO9Kr2Lxg_w&oe=6B0304A5"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "15543388856048
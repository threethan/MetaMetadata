7_o&_nc_oc=AdqkRpue_0REIAKzSTUGLDgHFIrzXe5Bi8AWNJG8BxH_YwKEDdYeysxiraWRTq8aC78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhrQEQsfwfVAyzSX-qGkTU1fFtbhJYFGWRyz-dllrj-A&oe=6A4BB806"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLtvW6OnO6sQ7kNvwG7BnVu&_nc_oc=Adon06ZcOpUrZQRL0pxRcMJ56xg_ea_8ntIe1u1oq-rRKn_uEE6WgKkFWRp6WGifU20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT8ZUo3oa1jgHDZUS0nKusY90G4XOq6eMp40acv0T9wA&oe=6A4BC425"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25491492437145452"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_1522264535735890_3091213343648908273_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=weuSmtj7VE0Q7kNvwER-mBp&_nc_oc=AdrwwLEDB4O2d819dpvMVaW2R1oD2rZ22noDOGzcpOlgDdzSZIE_TehjfTZrnAsWKB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMuP_LcOP038mc-XRXuGekCTOwOl_bQ9IrkANPCGAfuA&oe=6A4B9D6F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PasiphaeVR Prototype", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1766917020, "lastRevision": {"nodes": [{"id": "25010918271869540", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25010918205202880", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "18436293
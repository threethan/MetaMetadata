file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOeiup9gR6MQ7kNvwHogZ5T&_nc_oc=AdqvWC0aV7FNVWBcIRtt3-uFDgV1oHLuxyw58TwPigROj4gvKHkvUiUYb0PFxjegHuQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Kdwi5xJFoxoIcEDzLWMmjMUnS2qjtA_0HeZRJmmZ2_Q&oe=6A145A0E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXKvqqxoAUoQ7kNvwFD3RJA&_nc_oc=AdrWQCJqsRzu5H6eqLZxEkuCqvoD-pnyYSRXoKHIGofVyivXd8RAjL4bc7CWFWtghrE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Kc0iWmtU-hmoA6XOBX29qP1gwFL03E7AklqPKOzbCFg&oe=6A145682"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqCGaGjOFYEQ7kNvwEhvKge&_nc_oc=Adpn1xyLAS3uMcpZy-_SI6lbPEjrhtpkprexWov0DmcYeEIZUynchyHHvnN9In88yHI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wKoWAnzglfY15sw-9tIGgDhab_BOhCD_el1EFsI7kkg&oe=6A144DC7"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxKNtN7KGowQ7kNvwH5jtcZ&_nc_oc=AdoxEc_eKCQ9XaAI7WaMPgXUBUpUe6aArBWnftlKTk0zw953cwKv38cFr0sAtcgMCYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t0aGlVT2x6x2CIld8_q0U5f48oyQ2nZftTYD-iXc74Q&oe=6A147557"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knpHqyrb9RQQ7kNvwGvtEh8&_nc_oc=AdqSJ05f5GFJa_CeULO56GltWvV6PN8_2yUwFQe9MLEJlledmTfg7O5qF4ek73gFp9k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79L_P8Hg0g2IxjwXQGBNKCOq52wGP5PtgK3wtLClBJVw&oe=6A145906"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=so9eyLYEtosQ7kNvwF2QHZx&_nc_oc=Ado5zAX5RqG-8RBmwFui09oxhFzMK6k-q69u3Vox_vr6cCr1bgLTDCz0wZ_aBsq_lGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TYO6GoCWZN_3ntf6AOr9CQjrK7ZU2i7tMvDhAkU2zsQ&oe=6A146525"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
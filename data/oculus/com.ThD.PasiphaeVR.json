": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303788_830752813068241_7415669986707009869_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-fpfOqico8Q7kNvwGFY8lO&_nc_oc=AdnuLyWzsO4LyP1Efup-4RlN0NnKslTO4aEzWwt86TtSkh398_-1STj-k7zd09oy5BE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgckXZ0Ak3ZoEB1LujPf5zKl5Rmf7Nk3RcpkWpRaPjmQ&oe=69B2CBCD"}]}, "id": "743839654854832", "locale": "en_US", "screenshots": [{"file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWOpSEP1sl0Q7kNvwEvaMrl&_nc_oc=AdkvUyJ37J4wpvuM7trJb5lNHxbIrqDXIcr3jm9CgdXoF7-4rUSI9UcSvuZkmT4H9Ug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsLajwgCbhHfBaZ8FhSUy5VOqq0JIqkfIKY28v_l3buQ&oe=69B2CB0E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_faowbz-TwQ7kNvwEWLyXz&_nc_oc=AdkrlenGUTOAAGWox9c47T1WS6G8ZexZ0K1jlZ9tOYnShbIbXjq4N-Al81V3APsNhtg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnsNPglq_7kV1RBKWIT2cebAhtdFA5vpxIFN2kCXrfmg&oe=69B2C782"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxJNGL2FO6MQ7kNvwF2SFDp&_nc_oc=Adl1bKnitTy5ToGEfmN1oBWOTIH7bTK-9YrFuBg7fXS8uZBp1pHh1BuH7zjNG50j8pU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz4a77YLsTyBeYgFww93VfLM-K7dT7dQwdUbvai6KuznA&oe=69B2BEC7"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As3Ck65xBzgQ7kNvwF8203J&_nc_oc=Adl7igim7tvYydQ6UCP1okQnzd33Lnp68nvkM_v36r36tQvegc38GiX2VgacAWjxwNo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxmNk9cU3taHvMpO4qoij4EltKNWGPguCLYZsflNVWY-A&oe=69B2AE17"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FKCSbdR43MQ7kNvwHkZEkT&_nc_oc=Adl8plQ6oBIQJPj1I6utuXaQq8n-WNv6w7SFwgzVyhuJH50SGzyxjuqMAslXE6mDlYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHhymBhUHPE1JANUPc4Lf4XuGC8rk3X3mDUIiA7UZ34A&oe=69B2CA06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDRJpvZ-ne0Q7kNvwEXCwl_&_nc_oc=Adn2_6hgHIr0-bPDvIMbGfs_IEd5mhvBjeN4RInXxZH0LsrIpTjVT9qMyP3sWz4qTdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3vlLS7DtdQZIWMRPtz7cQEH7BFGOF44gICBWNi1kzsw&oe=69B29DE5"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "1554338885604872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766917020, "status": "PUBLISHED", "id": "1554338885604872"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25330734263221271", "version": "1.0"}, "id": "1899695333916790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25010918205202880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25330734263221271"}, "release_status": "
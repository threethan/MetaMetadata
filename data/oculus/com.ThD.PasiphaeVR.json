": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303788_830752813068241_7415669986707009869_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZG88t7yCwoQ7kNvwE6Rm9f&_nc_oc=AdnYoL_WbffRE4Q22aS6hss968TDofHc4qX08GcD4fX7T6RuBjCAvdMvfDqMxx9BSWU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfscF-Mht9lWPpXK2JYuy74cCYgqV5j4ZpYCL2XW6EupBA&oe=69A83FCD"}]}, "id": "743839654854832", "locale": "en_US", "screenshots": [{"file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwcztJQ6b-gQ7kNvwHVGxDi&_nc_oc=Adm7fBSD3SG90pF3wyLY9ts5NwKYaQWvQZ5-auv5GKyfP2d1kynKxgPv0kfAsAER1a0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuryk54OdoXnkwi5BqqY2l20r-0ktjPw2WgoCKVIe3fHA&oe=69A83F0E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMYBwyFeVGAQ7kNvwHNSnNf&_nc_oc=Admw3KSKABrR4h0buJCxHSiCslzpTyo37bs59adKnQHu2NePWKkz__bkXdTWDVBOre0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu0etX-TN2fGatw62BGVOm7-_QXpKLL7dF3B4h2wbkIcQ&oe=69A83B82"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooLclJfs0KoQ7kNvwFiew9H&_nc_oc=AdltCxKtw-qd85WWahr4uKppG2IvvJdEm3Qzsr49Gcy-uvsXJP0OxrOGJrBwIg2Rya8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft3Y2G-UnUvYT_oRM6SskwkiYdYrMPs1fsRz-tF39PSnw&oe=69A832C7"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdCYy1TPNxIQ7kNvwF8jZuV&_nc_oc=Adn-PIrWtiIg6bFHFqTPMabL_SicIGBpQrhdyf4sJllsJKLpoLHE3mZQIFZEL2EGzZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu597qcLFMvbHstYORd_Mk5iU9tuSfNrYQ1z1bNiIwKKA&oe=69A82217"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loz4JYsddD8Q7kNvwFlR5Ti&_nc_oc=AdnBQpSB7Rx5mdnGz5rkJSY3xdg8cKXgsJNDAphXkOBTF_skmhd6t5wVBaifOxfmRWQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvrC9sv57fIdmaXxWqRoIlZmBOpMaZ_wUsfsh5EyB_Uew&oe=69A83E06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpY4Un5TTH0Q7kNvwHIf-hq&_nc_oc=AdmybCNDSkgOrU0ULIbp1VkM9mzQ5qBwmATg4G_g0Yqe0jj-IKC-waBmvcsVxuXUjKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfselDhpyWBXukrwk6xFo8OmQGwouHNewpN475B3tQHF6A&oe=69A811E5"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "1554338885604872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766917020, "status": "PUBLISHED", "id": "1554338885604872"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25330734263221271", "version": "1.0"}, "id": "1899695333916790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25010918205202880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25330734263221271"}, "release_status": "
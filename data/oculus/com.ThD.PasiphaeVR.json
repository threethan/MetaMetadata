file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgtWM9laehMQ7kNvwE6Zrdv&_nc_oc=Adr0PNr2SD44dBlV70hDn4UySbTMDWrXnX0LRuCrhRchMgzI2R52K9N1niqIap9e9MU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyT2n4ds0t1u4jUd_dbQoEQr_AcHcTX1xmoCg_MxZQog&oe=6A5F7F8E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OqmpCPDTx0Q7kNvwFi-iEb&_nc_oc=AdqUXZ2_eQpxKzHkKYYyNWBrVxp9s9lpNBszlFcF8fEiExtJjEJ9bfUeWPiZY10-aQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEGYUqUdjqQCBCUXhka00NsyJeYmh4SeYC98tqiKtfSw&oe=6A5F7C02"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnNuHi5PKzAQ7kNvwFWpIj2&_nc_oc=AdqsE9gywIwzUa7srOdAclPa_ecftm6UhLU9w-5pJZLMsDrKwGFxxCWqiqp0GaIuXCw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNJY98cBNIFKM6n81DRoh8VvDDnhLQ3GIl1vORhEXztA&oe=6A5F7347"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-VqBedE284Q7kNvwGPPmjk&_nc_oc=Adq4BwyPD7onYxPmXgbv4ILFW63DiuM-RVYrQdzbEtNvBLp0-1LIcX0ydg_f23iJRug&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDspitEJ0WVr0SGzO8yMwJEJXcXcbB1FikjSuvhnolqsw&oe=6A5F6297"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGuur-vpv6EQ7kNvwHUO3a8&_nc_oc=AdofqqS82LrJLPm7LCDvh9AaoRNnAOY3fvIySQEbD5Y0okhBwsr_UTesGRRuhalSNas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl-rkDjUG_p4slXAUVLX4hFXK2HccZtCNVL8ahu6j0OQ&oe=6A5F7E86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgtuXy3A_oAQ7kNvwGtn4fq&_nc_oc=Adpwzc6snFcZhfgRQ4rw5OurJkGWqOrS7liwkuWfHYE37HBQ8bZjbHZ-rcBNJbouSSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3yGbIYThG7LsDAUynWza_-IFpR3Cqb1H-LrIAhrTQhg&oe=6A5F5265"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
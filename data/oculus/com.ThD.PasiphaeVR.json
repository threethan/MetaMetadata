a5-1.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYn4yGWIvt4Q7kNvwGIauJn&_nc_oc=AdrxkqIojrKoEHM3_a3LyV3OY5gSdtoxXOeQqxIIu097Jpz4CO0QtvogTachaeLOOG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_9CHdTGbKg3kNPQfgKlLP1bUc3Qo_ArB8dZ55WoWbvQ&oe=6B09BD07"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WV47EWXXmGYQ7kNvwGO8R1v&_nc_oc=AdqO4MYa21gqXgQCn3lZDnm3WFtyhwWMljTBX1y1PMJqdrOFpHklc-V32ZYGoIajbT0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUNgZe2DKP0dvIRGYbS7OwQmHYVhnl5t02nCtAqQap4A&oe=6B09AC57"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEkswA_BeLEQ7kNvwFjZrfP&_nc_oc=AdpegWd5ZbFZlRw3QrVnSTnyvFJhWjnt9uQSI1EcBJWE8VLZBE3uOiXpaoU4WQdd218&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRNT--rfUiP3cd2xweXntmlS9ttWCu5YdFQ1hgUFyDsA&oe=6B09C846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MuUN-a1VWAQ7kNvwH0lUyA&_nc_oc=AdoWty1FOqPVsUZ4dxbGDHm-KRh4aSPmDKlhiyWqALGPummDoBYRxJMDPpNx3MzJslo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkHhqcKN0TTpvWPxeh8Czg5eMPNjlstN_b9luI9Dv02A&oe=6B099C25"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "15543388856048
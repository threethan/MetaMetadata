file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXKr6oSVgCQQ7kNvwHPAmO-&_nc_oc=Adp1B86y-JM9VsHsGBnhF1SDSFQvyx-Cd7mN92VqSeWWCmMKORTEQpIEON1w6MCvH-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUC2nM6_KGuYMAGn-Tdi051Vy-T4c_TWZ3ztVtVHbMcQ&oe=6AF71C0E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsDMVaA70XgQ7kNvwFofORx&_nc_oc=Adq-hi_5AUEKTgUmtxuHoZWPWgKNXW81-EZyeBkDHXRBXmhlZ1GfVIZkGLmFKW87qcI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi6W3csSg8UQ6m-UvuZb0J2wnCrJOWM4MiUq9p4uQtEA&oe=6AF71882"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSA4DimeYMsQ7kNvwFalHnx&_nc_oc=Ados-wKCMW4fWVox8IYh_Vi1UeJrtbmgkHKq3m0gaOxUJZDgnzq9gq4o8cZY_GN2VPg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTa7aW50UZYSvXbP21N0IOChUXnFjlqLka4bhB9VAH5FQ&oe=6AF74807"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VE7qVE5HLxIQ7kNvwFE5PVR&_nc_oc=Adq6VrEGpXvXWeb-TxpUkHuSuK6QKAkuukkGRaLsbh5soow04bPNPik3ANIZGT9_kB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrlzs-6AkIOQw-IIExVYBpbB2KHjoCvV8aYnaOJreaQA&oe=6AF73757"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVG1Cn70JJQQ7kNvwGctmWc&_nc_oc=Adpou-dFop3JPo5PEYqkACR-wOAkroZ5qz5KSzLdVp-32OGEJ6Q2n90xTZwdc9VT4SI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyyT7kqcttS7rSpq3rnb6kZczqL5ghHNJK68jvKt49Yw&oe=6AF71B06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7OcipMut8cQ7kNvwHrb-iB&_nc_oc=AdpVfAhxzRYsFpnl-kO5u3FmxYi_SsBrTPpd2M2nFHuoMGPCbHfeCSBee8njsR4dYPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxW9CAg6M7U6NBv4NkYvh0KXMGjSC42bnki7d1c11YkA&oe=6AF72725"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303788_830752813068241_7415669986707009869_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-fpfOqico8Q7kNvwHImmK6&_nc_oc=Admhe4zyKH2lGpUQa6epLZbgjGJK0xvvoKDhdE8sVBFCOIMocjW0k60Bk7EtsXtMC9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-ImXP885-nwYsO_CKTrQtr0pz2o87AZXkVJeY1AatZg&oe=69B41D4D"}]}, "id": "743839654854832", "locale": "en_US", "screenshots": [{"file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M88l5XpUDDwQ7kNvwFnN52P&_nc_oc=AdkOGJQcciAxpUd6P9AknnZ12_Itn7rXUGdPlh2BBrD8yJqQ0k18xnIwvoO4UneJMZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6tWD48yQIPwsTIFTxzRnZLhIY2-fj7scfyY712ne2Eg&oe=69B41C8E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cCW8vdvkc0Q7kNvwGthVHt&_nc_oc=Adla8KfQE56Sr3ZhIN5HdqIbwVtttmuaOFBy8LQ3EULQzcnKror0QaAGywyJ6Lsmxfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCDiOLFKGm_PNELSkTPpEqA7loWXfhQAZR-2zuU8RIHA&oe=69B41902"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxJNGL2FO6MQ7kNvwHS9yKK&_nc_oc=AdlYa_bNBO7NenjhQUN6T--3MjMqD7I1c7N8cDnXq1U7qtkUn07C92nlNpxMkTo6gzg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwSlceOF37hZFtqKSdB54w10ShFYrhp5z26GJF64N4V6Q&oe=69B41047"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As3Ck65xBzgQ7kNvwGSnbcX&_nc_oc=Adlzc4Dlu-PsRKFkF66MqplWH1RpciXK7XM2zYhRe8iR7rB1LKnlMt4oB6z3SIx2mUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzQELX26pX4VMm_tTa1kLZUMl-HiZjeC5kHi4G8ahpTw&oe=69B3FF97"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FKCSbdR43MQ7kNvwFWq1DX&_nc_oc=Adl6YQAE3Ia8h9uaP8LnamXFi9MLQK3jdIgHkNrXUW6uwfYKQV1e2XlILcTDwacr6H0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyp3tW9M44fV6-loAM2-eoxfEGo5_je1IP910M95izsDQ&oe=69B41B86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDRJpvZ-ne0Q7kNvwGSsZtQ&_nc_oc=AdmHzJGVZno8BXMF2ixFv8wYVWR9PZdKDjxBFA3OcZIKdkLCWuoX4siv5ZATgsKZyX8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwiNpfCA_SdNwTZfnzhvUpnhBrBh80A7YSkU7QpwGmXzw&oe=69B3EF65"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "1554338885604872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766917020, "status": "PUBLISHED", "id": "1554338885604872"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25330734263221271", "version": "1.0"}, "id": "1899695333916790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25010918205202880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25330734263221271"}, "release_status": "
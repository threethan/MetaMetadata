file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLDd0ePpLI4Q7kNvwGd9Jsk&_nc_oc=Adr3L40BV0d0-R_FOp17x2Jj3yWRNOqIvcwwSbpHoXZdO0uyF5-WVDQt7y-mhegjesI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38_b1hjWhLVrB183axqTy1IGP7psziu9rJRTy6uft0kw&oe=69E6358E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UybO_7vK2DgQ7kNvwE3TmQ8&_nc_oc=AdoIWAjgAE5Mf_ermSsOxOT6GWKHLBWzTyToJkoGhk_CL8wSV2LFzGgCwMsA9lkhlH0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zlSfatpwi04VO54K-t_2qeerr_NUYfN8LZxywHP36mQ&oe=69E63202"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmVaWMQIEpAQ7kNvwEj0VyX&_nc_oc=AdpdXWS-PovjhDlTAg51h2upyFg0zbDBVbzItlwk5Y3ybdIRHPxJAsqBQKwtzEOkYk0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cmmcMw6yDjcEIU125EjbkluuLfyhThoFnEQYVgLqZsg&oe=69E62947"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdMM7OOSKBEQ7kNvwEuthEi&_nc_oc=AdrF36eqzYcH-_PgTzGG0qasKNAteAB4ZnNfuTHJ7qXQ7aO4uHA8q5FPeu1-ejUjHxg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z4uuwMx_6E0Jp_irkbuj3ZbLlRYyDi7y19SHLHwjTkg&oe=69E61897"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MocRDo68QHYQ7kNvwGgwtcI&_nc_oc=Adp46cep12lOma2hejuQiT4LdsOUN-1eiybinAQNuXqBtrM-s3oTPc7tJCeDjkZG37g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PkaMP3BpEQrGlrRsp-n1M6Vad4GH9lS-PE2DwLLByQg&oe=69E63486"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hg_H0OW7VmEQ7kNvwE_pxp4&_nc_oc=Adrr5GXqRWeeQNDROdKG8-QgPABR-jiZvtJaMWY_QESZbzItMSkA5MyGWHAa1bpCepk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FUkXuezNTMz6wO8MuBD5JcFBMy2LwKsnw9NvtJEiLaQ&oe=69E640A5"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffmD3ql3eN8Q7kNvwEYgMRh&_nc_oc=Adp1GOlENe5Xj9nS5pDoa_mJ6A3MjJ_l5m2hTvvYk8iRMKpmnzQ2pz5MZuY_AJrEUac&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKay9kiNRTtWQG341j7TrHcDsCdt1biQLc1U0InPBk4A&oe=69C3EE8E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Kzw7zDpzCcQ7kNvwHMkfiY&_nc_oc=AdrNQh0ohCtFjNCdVvBhnbab2l5BTYIeWFaCkCPVegbA4S1xYR8QrHzwg98OxEA2GbU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVAgYxVi6MLxkAJxVNh9DVUW5L-ctXWiPujEWD2sMS8w&oe=69C3EB02"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qSb3OiubAcQ7kNvwHKq2_8&_nc_oc=AdodJRailZU15VUiF0tbRYApFv7Sl3DddzxKtoKGO49z_9KTb-kZBABhGN2ed57YUM4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnCj5nwVa6qyuBJO0qjhpbkPU0-XjtaUxWD3rqOPEQ_Q&oe=69C3E247"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxRdWRU81BIQ7kNvwG-CZFI&_nc_oc=AdpB2vkIGPBwm949PSCakYadHbSSRA_GUmt7isW51iKqgkTwwprzZx-Ickfop4lxHoU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1REVkxsIa9Pu8k0v7PME4VEPpRJgts5HbQj9WngoFmg&oe=69C3D197"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMjszoHCYFIQ7kNvwHKE4JL&_nc_oc=AdpNNI5htA_JeLtlDHFSyaxsWaHWSNfACmPVjb2m28mz2P6UI03FCrPJo0IdcVI7E40&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYlysab0BumhlCUtou61pRtAETV2xn5a89lfUumDZ9tg&oe=69C3ED86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdbltGehK8gQ7kNvwF1NsPX&_nc_oc=AdpdJvm8ANO1WDlXqRlhXNVWLQ8Z6ecTJIFVjqHT4p-KS2ikdFw5YYxZdIoqOKAaKBs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw19iZhSsBQalQ2t8TYKoABOxybcsghOMeZqr_336oY0A&oe=69C3C165"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEXPM5hZxugQ7kNvwFEnDZ5&_nc_oc=AdqO7agResp2G2TDZ_HGvi7YJeSqJJImlyXlSH5yWBfONAHDVQ9CMRO-xANzGx6FfHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKukLTOkPbfT7pCfp9PCuQLyFRcljNVeF4fGkhGFfD3Vg&oe=6AB9258E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwO0fyPsT1AQ7kNvwFksokU&_nc_oc=Adro66-CsAHr9OTb-znA6kUvUMrZ50uBGxO1v_7mtdP_vSrnEDeocQgTyd9OFxlONVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4id3yXSF4-PDq58kEZZMMwwMIR0JQvvdRbszKJu2X2A&oe=6AB92202"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lA7W9oTVyVkQ7kNvwELIpSu&_nc_oc=Adq2_98Ea7-kSDUA6WnZG5lak8sIZsDjhngb3xGwHBVpJgr9rUFuNEgZnVsAJLhi5mk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHPNklrplDNY7V03z_SebHEuu5AmFtKu__gQGkReFw-A&oe=6AB91947"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEn-CjyQZswQ7kNvwGg5vrG&_nc_oc=AdqSbl7JRaJS-_uKqzQnZARrIgd1TBPY3S-6iQ6RWtjVq_ZcUyyEHOYJABgD9_Fif-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdmN5AUy-JWEUPUb-MEcSnwrzGYX1laBlrIpH07lurBA&oe=6AB940D7"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKptcboWuxAQ7kNvwExPSaX&_nc_oc=AdqVj3z3Ju8hA9nu1s3zBSg19gDVHiBTJpZUp1Qt33swe3kRIgM4pB55gFuBdtsXh2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpSNr_ZCncVtxfh38c2j0CIllBPH6YddMGeXiYqOpwtw&oe=6AB92486"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QmNLvbUteoQ7kNvwF3bvon&_nc_oc=Adq_tvbc078fdiU86PXtUdVS-CC84MT6VvTTtffRVT2VqBnEB_iJ9y-qvK27ip3w0eI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbzDHOHOUdvUPhfwSa2v4RWfu_3_Tjc0o541vKTbDNiQ&oe=6AB930A5"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVyORwsEnZYQ7kNvwFPGhAQ&_nc_oc=AdoKQotE8bfRyWWBmvd5W8dCLAyNXk_ZcPTQRAEbF3vlM1m_WLk4kSHfv8p-e4HOrz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AXqvPbX9uE0MkORuW7cRMR1tYD0PWCOYHiXxDSS5Vqg&oe=6A04880E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p5br-vhxUMQ7kNvwHh9Ov_&_nc_oc=Adrsd6OImoTa3f3hqoKVL3-K5RMAT9PBfv8MP7frDRge6tZ9WJbjCqCkOXeVhgAhCPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78Pj54Oeh1W8ugFJc4FBLr4bFhcSrro7ysFVN6vYagPQ&oe=6A048482"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00oY_UM6h_4Q7kNvwF72B0w&_nc_oc=AdqNTnquTPchODB09mUD3QsqnAEPR2K8cIGlmwRztErvsnxZWsqQ4ty7Pm1oZOdwssY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mkgmaw2CYFN1yHkBARPxhxdOV1rkoBRYV3Wy9Sb5tLg&oe=6A047BC7"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V89J2SI9n8EQ7kNvwEpgrdU&_nc_oc=AdoGWPVsgIXJpzGf6WYohxviOIcfmjyeY6D4nDXE02BBdxmq39xeGi7duooFAZ5hl4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KMMN_QN2xu75F111FH97fwOJMYivEvRScWER9w9RYIA&oe=6A046B17"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xbwjfSybvIQ7kNvwHHqfzY&_nc_oc=Adrnp5tqItA-JWoOvqgtEB403UejlGsstk4SasT3Dx3jXgjzylXW9V66FwymGgSLBtk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AtWVGO1ae9WNdsiwC_o68MzOeZvJlO2c69dko8Pq9Lw&oe=6A048706"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3dCMTioNncQ7kNvwE2q0TJ&_nc_oc=Adr2_78DU-tZziT7eti1bmxn9IiyCy_j3RwDeebfK4wug54sE7nuEbP_3C1DNP35joI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tkSxNY6iisfFITacJqC_1AqWO7qeqIdjRyUdm88Zy6Q&oe=6A049325"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.\n\nThe PASIPHAE experiment has been funded by the ERC, the Stavros Niarchos Foundation, and the Foundation for Research and Technology - Hellas through a Synergy grant", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/documen
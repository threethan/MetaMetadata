": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303788_830752813068241_7415669986707009869_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctz-Pyo4mXMQ7kNvwHvvDUI&_nc_oc=AdlREML_q-JQUL9wVmlLkAnJ_yVRgXw7N6dxyiMvkrcJpFQMf66wc1JQ1xOyOVcSS8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afza2TcpV5YqefcTxduwuIQvMqAx9zqCHS1Xey7jSg09PQ&oe=69B9634D"}]}, "id": "743839654854832", "locale": "en_US", "screenshots": [{"file_name": "PasiphaeVR_1.png", "id": "1187376002824740", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1187376006158073_3029317609803786554_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vp1HpRDoQoMQ7kNvwEH--VP&_nc_oc=Admtfc4b9H5JDPx-e4HBzqS_kvjzWsbjPsNZB7MuhDiSY44JgGJFj_pngdCsK4T5I2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDDL2eDBMacudvmYvhRrtzY6Wvinp2GbM1jeN8qH_LAg&oe=69B9628E"}, {"file_name": "PasiphaeVR_2.png", "id": "906640621800739", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_906640625134072_8307358561371411782_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oihwjXQY_QQ7kNvwEa2K8w&_nc_oc=Adkrv776DkRYaxCWxr9StgozBjOzKHj2Rleq-a8AZmJBe0W7EOZ3zxEeIvxsbECmFCk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYHIexuiP9thnjNtVOgG6Vd0HPRmbQKnuzLOGrgQbftw&oe=69B95F02"}, {"file_name": "PasiphaeVR_3.png", "id": "1093848776036354", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824318_1093848779369687_7653038808158681630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdQ--g-zt8UQ7kNvwFh31lp&_nc_oc=Adn2mH-3MxCQ6Pmk_Q_JNkRUmwB3TrWxC2Da0ABb-VmetuQRWt6MknTDeDmBUHtL2Os&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz3hfhu5Q7OavMS1lGGAQBHwY3R5XUj9EE9U-TZFHbZZw&oe=69B95647"}, {"file_name": "PasiphaeVR_4.png", "id": "2077660742775072", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824318_2077660746108405_3834236817159191020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaL-vYkPfbUQ7kNvwH4mlLu&_nc_oc=AdlgCAcU3SmzjLWMGdm2TpNXyeKRQItP3qnoBc3xNTTJocktUrsuVZnnlga30z-Rp8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDVMps-lkNepVxpg44uWDmvxUykl1InkzI1gvOlmAhpg&oe=69B94597"}, {"file_name": "PasiphaeVR_5.png", "id": "1569596694176219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1569596700842885_2180200080814841656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rmnks57gARQQ7kNvwHoEhDK&_nc_oc=AdkJQhO0jk15EP7ccP6OK4FP8GxQAiP9i3VQnAYcB6xBi2pCOg8Y822OVY-zGSuCNbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyUuIswoezbWUmOD4AoyXuqeoAI8fv07izOLk8JDz8fYw&oe=69B96186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame-00060.png", "id": "2883980735278412", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_2883980738611745_7070582803337495383_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19giSgGpQw0Q7kNvwElKBqj&_nc_oc=AdlN9LWscpyMgniabOnlsr6a1A-dkHnhYT-pD7IdtkwcVicJNd2IE_XHrh6Q1CFVYKE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzZejO_sFMTYW9gB-1lh9cZFU802J6V8TfPE5QRce3NcQ&oe=69B93565"}, "display_name": "PasiphaeVR Prototype", "keywords": [], "long_description": "Step inside our Galaxy.\n\nThis VR experience combines the Gaia star map with measurements from PASIPHAE, a project that studies the faint \u201cpolarization\u201d of starlight\u2014a subtle signature imprinted as light travels through cosmic dust. That dust is gently guided by the Milky Way\u2019s large-scale magnetic field, so the pattern in the light helps us trace how magnetism is arranged in the space between the stars.\n\nIn the app you can:\n - Fly through a 3D view of the Milky Way built from ~140 million Gaia stars,\n - See direction markers on selected stars that show how their light was affected on its journey to us,\n - Explore different reconstructions of dust clouds, plus an all-sky dust map for context.\n\nIt\u2019s real astronomy data, turned into a place you can explore, revealing the otherwise invisible structure of dust and magnetism that shapes our Galaxy.", "short_description": "Explore Pasiphae and Gaia data in Virtual-Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1-CeYXvEi--UrCkOUj9pmz-IKhO3xSiqRL9SJETtHqrs/", "developer_terms_of_service_url": null, "publisher_name": "IA-FORTH", "support_website_url": null, "website_url": "https://pasiphae.science/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25330811573213540"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554338885604872"}]}, "baseline_offer": {"id": "1554338885604872"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766917020, "status": "PUBLISHED", "id": "1554338885604872"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25330734263221271", "version": "1.0"}, "id": "1899695333916790", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25010918205202880", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25330734263221271"}, "release_status": "
s principales:\n\nInterfaz inmersiva 3D en realidad virtual\n\nM\u00f3dulos interconectados que reaccionan a tus decisiones\n\nEscenarios personalizables por instituciones educativas\n\nAsistente con IA para apoyo estrat\u00e9gico\n\nCompatible con Meta Quest 2, 3 y Pro\n\nConvierte a tus estudiantes o colaboradores en verdaderos CEO con CEOSim.", "short_description": "Simulador empresarial con IA para aprender a tomar decisiones estrat\u00e9gicas en entornos de negocios reales."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ceosim.cl/politicas-de-privacidad-vr/", "developer_terms_of_service_url": null, "publisher_name": "Nueva Gestion Software", "support_website_url": null, "website_url": "https://www.ceosim.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CL"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24299247249708183"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1488257869006684"}]}, "baseline_offer": {"id": "1488257869006684"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753811280, "status": "PUBLISHED", "id": "1488257869006684"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29255923230707202", "version": "1.0.17"}, "id": "4128066390853897", "channel_name": "LIVE"}]}, "is_for_oculus_keys_onl
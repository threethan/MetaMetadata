-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdanHo3rRUYUmBC-eexQAbrLeePpR8gmwnXmohXLEIQQ&oe=6A8ED015"}, {"file_name": "Screenshot_2.png", "id": "631687689439232", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499311562_631687696105898_6656294784523684204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3RmNJvjdjsQ7kNvwGDNPkY&_nc_oc=AdpcZ39jLvAVWsUD9i6tfSISZmzihpcLg7BXmKRe8O-7DsbWIpqzHxs_0jT-mZiHV8w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFip9ucnmBYkMaYIbD7v44npQYqm6e1ENxoyyq0ggErg&oe=6A8ED4BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CEOSim: Simulador de Negocios + IA", "keywords": ["negocios", "empresa", "decisiones", "IA", "educaci\u00f3n"], "long_description": "CEOSim es un simulador inmersivo de negocios basado en Inteligencia Artificial, dise\u00f1ado para instituciones educativas y profesionales que buscan desarrollar habilidades estrat\u00e9gicas en un entorno empresarial realista.\nInteract\u00faa con m\u00f3dulos integrados de:\n\n\ud83d\udcca Marketing\n\n\ud83d\udcb0 Finanzas\n\n\ud83c\udfed Producci\u00f3n\n\n\ud83d\ude9a Log\u00edstica\n\n\ud83d\udc65 Recursos Humanos\n\n\ud83d\udcc8 Control de gesti\u00f3n (Controlling)\n\nToma decisiones basadas en datos, experimenta las consecuencias en tiempo real y mejora tus competencias como l\u00edder. Ideal para carreras de Administraci\u00f3n, Ingenier\u00eda Comercial, Contabilidad, Econom\u00eda y m\u00e1s.\n\nCaracter\u00edsticas principales:\n\nInterfaz inmersiva 3D en realidad virtual\n\nM\u00f3dulos interconectados que reaccionan a tus decisiones\n\nEscenarios personalizables por instituciones educativas\n\nAsistente con IA para apoyo estrat\u00e9gico\n\nCompatible con Meta Quest 2, 3 y Pro\n\nConvierte a tus estudiantes o colaboradores en verdaderos CEO con CEOSim.", "short_description": "Simulador empresarial con IA para aprender a tomar decisiones estrat\u00e9gicas en entornos de negocios reales."}]}, "developer_name": null, "deve
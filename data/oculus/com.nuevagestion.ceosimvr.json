_1137751578204162_7706900591654814821_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIuehBsX12kQ7kNvwGPGkKB&_nc_oc=Adq23IYKncfLt0dKJPycnCUJL-fEaI_mGDMeDgByCHuZjXtfHTlksE2xnW7KLU8Z2ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6XAOQ5UOO0GKHQwzha50oFPx5pzkqIsxg2Lm6MIjzvg&oe=6A8464B6"}, {"file_name": "Screenshot_3.png", "id": "575757075470213", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499624731_575757078803546_5993117745693113531_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdOrEiZbLyQQ7kNvwG4PS5e&_nc_oc=AdpniJ35RlRd74bF8Gh93PkJtBror_ABCpRqfpU4wqAFEO8zrO72W6eyCkdNiCEPHm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdjlFsxk41XpA7xHCXNcbuUBo8nZwYRwNvE6NDGlnRjQ&oe=6A844415"}, {"file_name": "Screenshot_2.png", "id": "631687689439232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311562_631687696105898_6656294784523684204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pj0Q5axOkWUQ7kNvwHNm4C3&_nc_oc=AdrmVeTAk3OmN299UWA5D6ajtx2jX-Ckzq1kyc1CvnK6A98tRyCgsEuMGz6iJn1N_S0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4nrn7DIhEFcfc835QuivFoIeuFKShhB3DqYPGvpNEUg&oe=6A8448BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CEOSim: Simulador de Negocios + IA", "keywords": ["negocios", "empresa", "decisiones", "IA", "educaci\u00f3n"], "long_description": "CEOSim es un simulador inmersivo de negocios basado en Inteligencia Artificial, dise\u00f1ado para instituciones educativas y profesionales que buscan desarrollar habilidades estrat\u00e9gicas en un entorno empresarial realista.\nInteract\u00faa con m\u00f3dulos integrados de:\n\n\ud83d\udcca Marketing\n\n\ud83d\udcb0 Finanzas\n\n\ud83c\udfed Producci\u00f3n\n\n\ud83d\ude9a Log\u00edstica\n\n\ud83d\udc65 Recursos Humanos\n\n\ud83d\udcc8 Control de gesti\u00f3n (Controlling)\n\nToma decisiones basadas en datos, experimenta las consecuencias en tiempo real y mejora tus competencias como l\u00edder. Ideal para carreras de Administraci\u00f3n, Ingenier\u00eda Comercial, Contabilidad, Econom\u00eda y m\u00e1s.\n\nCaracter\u00edsticas principales:\n\nInterfaz inmersiva 3D en realidad virtual\n\nM\u00f3dulos interconectados que reaccionan a tus decisiones\n\nEscenarios personalizables por instituciones educativas\n\nAsistente con IA para apoyo estrat\u00e9gico\n\nCompatible con Meta Quest 2, 3 y Pro\n\nConvierte a tus estudiantes o colaboradores en verdaderos CEO con CEOSim.", "short_description": "Simulador empresarial con IA para aprender a tomar decisiones estrat\u00e9gicas en entornos de negocios reales."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ceosim.cl/politicas-de-privacidad-vr/", "developer_terms_of_service_url": null, "publisher_name": "Nueva Gestion Software", "support_website_url": null, "website_url": "https://www.ceosim.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CL"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24299247249708183"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1488257869006684"}]}, "baseline_offer": {"id": "1488257869006684"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1753811280, "status": "PUBLISHED", "id": "1488257869006684"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"n
dQLQqV_rArwycYR1wfn_8nZM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbuDtGl-V360WkZyKzDhLo6F2D6F8NaRV8q5pxh-8A5w&oe=6A54E40E"}, {"file_name": "META App page_Screenshots - 2560px x 1440px-15.png", "id": "1610465123412280", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304305_1610465126745613_529628666071862288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjPXS5iH3DMQ7kNvwHsYQ4T&_nc_oc=Adr1BLjcvj9wq_Nuf1cse3F6cP4x7Jn9n9aOaYmHRPwAA2pya9XbyOgV4ZuI6C05MqI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3VxaznwFvkkRkSoPQ_LsqVBZebxzcns7bIwHEodsfZQ&oe=6A54E9E6"}, {"file_name": "META App page_Screenshots - 2560px x 1440px-13.png", "id": "1870640326990417", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821696_1870640330323750_8002609030324663600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x6f1Teo4kcQ7kNvwE-3Bqf&_nc_oc=AdoOrZo4Q5Yv9A_tTkuwwCILGB593Vbc_r2hWSHSfbgA-srbRR9MHW5qAk1kpIld-Wg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUTWEnilddNAn2Kd3Zh1oPqfDCru1zKG6sN9_qMkwbug&oe=6A550874"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META App page_Landscape - 2560px x 1440px.png", "id": "1856323875023788", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818852_1856323878357121_912182294544512_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO-aEgXwR9wQ7kNvwEr60T5&_nc_oc=AdqTj4NqfPvLWXPpA03GuZ-cWr3VkQHCBOQOxE_ZGh7nVlxnlyOyBRgR2QrY544LYF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlwJUddVsBbGwREjciEY4DLW30NkMaHQslKhwUk9Q57w&oe=6A54D93B"}, "display_name": "Reactivity", "keywords": ["partygame", "ouuly", "reactivity", "party", "memory"], "long_description": "# **\u26a1Reactivity | Better than yesterday.**\n\n### Technical Execution\nBuilt as a standalone **Meta Quest** application in **Unreal Engine**, this project serves as a showcase of high-level optimization and visual fidelity. By leveraging **Meta XR**, **Interaction SDK**, **Passthrough**, and **Spatial Audio**, we have created an immersive experience that remains highly performant while seamlessly overlaying game elements onto the real world.\n\n### Gameplay Disciplines\nThe application utilizes **Passthrough** technology to split the player's environment into a dedicated gaming zone and a spectator area, featuring four core training modes:\n\n* **Discern Ability**: A pattern recognition challenge. Memorize a target shape and identify it among decoys at increasing speeds.\n* **Memory Ability**: A test of spatial tracking. Track specific color-marked objects in the distance as they fade to neutral, then select the correct ones as they approach you.\n* **Visual Reaction**: A risk-vs-reward reflex test. Set your own reaction threshold\u2014the faster you dare to react, the higher the score. But be careful, the risk of missing is high!\n* **Sound Reaction**: A spatial audio challenge. Rely on your hearing to locate sounds in 3D space, turn towards the signal, and react instantly.", "short_description": "Reactivity is a competitive Mixed Reality party game designed to challenge players' reflexes and memory. It transforms your living room into a futuristic testing ground where users can compete locally to compare their reaction times and memory abilities.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ouuly.com/reactivity", "developer_terms_of_service_url": null, "publisher_name": "Ouuly innovations s.r.o.", "support_website_url": null, "website_url": "http://www.ouuly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
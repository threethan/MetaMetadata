KeL9MoNYxCJJX8zSqY_96b1M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAh1i3IS6ebZQZOedkmQRoVVDY0wRpD14JB-sNh7YwYw&oe=6AA0098E"}, {"file_name": "META App page_Screenshots - 2560px x 1440px-15.png", "id": "1610465123412280", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304305_1610465126745613_529628666071862288_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5tK4en-jZwQ7kNvwF_EBHm&_nc_oc=AdqfcnSI79u2NVHdR261AjNPIJBh29SDkbGtzXFZ3R22c2QjxFwULfQwRcSnHFcgfB0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0Yg0exZU8O-O_nkiUZs82XkMgJWs7WN0vjvpXaav_OQ&oe=6AA00F66"}, {"file_name": "META App page_Screenshots - 2560px x 1440px-13.png", "id": "1870640326990417", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821696_1870640330323750_8002609030324663600_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W0XSPqAKocQ7kNvwEY3YBK&_nc_oc=AdpGq0k8afgJVLncOKqLjscJMDoieHS1VPbE3y5bexIP307IGkCYUVJ3Mb3x50Jvcrc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV-JkKXZRMBr5WD8oB9JPK63U56hh9EDDS8sAOxRyrCQ&oe=6AA02DF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META App page_Landscape - 2560px x 1440px.png", "id": "1856323875023788", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818852_1856323878357121_912182294544512_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL_ICkKZsEIQ7kNvwEnjFH1&_nc_oc=AdrWhaAhS3Tl6My0B_w--GYbw0ACXbjGarB7b6iYaR8PRVereurHUO-XRlR_J30ZRKo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOXARcd4u2mNyUGaKLhDVdmyZfX4AgkHBJ9AhTo4YFVA&oe=6A9FFEBB"}, "display_name": "Reactivity", "keywords": ["partygame", "ouuly", "reactivity", "party", "memory"], "long_description": "# **\u26a1Reactivity | Better than yesterday.**\n\n### Technical Execution\nBuilt as a standalone **Meta Quest** application in **Unreal Engine**, this project serves as a showcase of high-level optimization and visual fidelity. By leveraging **Meta XR**, **Interaction SDK**, **Passthrough**, and **Spatial Audio**, we have created an immersive experience that remains highly performant while seamlessly overlaying game elements onto the real world.\n\n### Gameplay Disciplines\nThe application utilizes **Passthrough** technology to split the player's environment into a dedicated gaming zone and a spectator area, featuring four core training modes:\n\n* **Discern Ability**: A pattern recognition challenge. Memorize a target shape and identify it among decoys at increasing speeds.\n* **Memory Ability**: A test of spatial tracking. Track specific color-marked objects in the distance as they fade to neutral, then select the correct ones as they approach you.\n* **Visual Reaction**: A risk-vs-reward reflex test. Set your own reaction threshold\u2014the faster you dare to react, the higher the score. But be careful, the risk of missing is high!\n* **Sound Reaction**: A spatial audio challenge. Rely on your hearing to locate sounds in 3D space, turn towards the signal, and react instantly.", "short_description": "Reactivity is a competitive Mixed Reality party game designed to challenge players' reflexes and memory. It transforms your living room into a futuristic testing ground where users can compete locally to compare their reaction times and memory abilities.."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ouuly.com/reactivity", "developer_terms_of_service_url": null, "publisher_name": "Ouuly innovations s.r.o.", "support_website_url": null, "website_url": "http://www.ouuly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "377978390272490"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graph
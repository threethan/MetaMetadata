3702706_1872490027977897571_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biKT3fL3DTsQ7kNvwF9oC43&_nc_oc=AdpC3Jgum6lw2EsfZ4F4qAaNLkCTlNml01Vm_msXsIAIFxXrNQW17lVjj5bnKgNRN-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkqHkNBmjWUK888opOhVQteUvrpVlqXy4xpF3K1Q48jw&oe=6B0468A8"}, {"file_name": "ss1.png", "id": "467432749343700", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003277_467432752677033_4139747888612207560_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-i8jRvoeyx4Q7kNvwFQvBCy&_nc_oc=Ado-JOBeZdLv5pYzB3YJN0xIKQdhIZiLTh_koaxH_hnC1n-ajFQa-VPdFi--vX5jblU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-CN7KycRuU4CB9269UFcgHka7by9atK9Tua8uqBWifg&oe=6B0461D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplitChimpsOTThumbnail.png", "id": "488567727095851", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974732_488567730429184_4008640334868821400_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsWFd2uyNaUQ7kNvwFmpANQ&_nc_oc=AdoULr4A_ZQgLKpLpcHYf8s4OgbPmlsduLPW0xHMOMX-mGMe51ExBSK1kSdA1coNJ-A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRqG7BntCsIrSpmF3c6UDjSUOoWG9Liyp8v9RjFCbbhA&oe=6B046A30"}, "display_name": "Split Chimps", "keywords": [], "long_description": "Split Chimps is a VR game that uses movement through your hands! Interact in a fun and creative world where the possibilities are nearly endless! Play around in a game that is active, fun, and exciting! Split Chimps will always make sure to bring the best experience possible to you, and also assures the best experience you could possibly imagine! Not only that, but the game is heavily based off of the community! You can join this community and suggest your own ideas that have a chance of being seen in the game.", "short_description": "This fan game is aiming to be one of the most CREATIVE and FUN fan games out th
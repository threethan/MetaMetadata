g&oe=69E377E8"}, {"file_name": "ss1.png", "id": "467432749343700", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003277_467432752677033_4139747888612207560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOFPZ8DY58oQ7kNvwGCp_AO&_nc_oc=AdqLBGZYZP2lZo0nsHN4blNAVAFx2qQV2b1iksbjD_LU7wn_L3RYLg8z_mTrYV34Y1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nbib0mKcLUyAvgdDBP6WEa57io9cj6tNiLopb_6KUwQ&oe=69E37116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplitChimpsOTThumbnail.png", "id": "488567727095851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974732_488567730429184_4008640334868821400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhn8cw_SrYcQ7kNvwHpl7xY&_nc_oc=AdqpxUffhFxo8iz4MfgdFkuC5Dd2Gr9muBity8KN0t3oCprmhWwM563unpIADN3KfrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RyZz1S1tbtcy9-lwZchiSL7vYRhUJQu8J5V8oVPDqyA&oe=69E37970"}, "display_name": "Split Chimps", "keywords": [], "long_description": "Split Chimps is a VR game that uses movement through your hands! Interact in a fun and creative world where the possibilities are nearly endless! Play around in a game that is active, fun, and exciting! Split Chimps will always make sure to bring the best experience possible to you, and also assures the best experience you could possibly imagine! Not only that, but the game is heavily based off of the community! You can join this community and suggest your own ideas that have a chance of being seen in the game.", "short_description": "This fan game is aiming to be one of the most CREATIVE and FUN fan games out there! I will be releasing active updates, each bringing more and more original and fun content for everyone!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicysc/home", "developer_terms_of_service_url": null, "publisher_name": "SplitGT", "support_website_url": null, "website_url": "https://sites.google.com/vi
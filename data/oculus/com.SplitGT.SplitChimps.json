A&oe=6A3291E8"}, {"file_name": "ss1.png", "id": "467432749343700", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39003277_467432752677033_4139747888612207560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LhGgpkMvXAQ7kNvwEotP4G&_nc_oc=AdpkMiHGtRkcWeh4D-OM9YKOVUpwsGqzqkwF37vH3G8Ve5vhIOvwLIi66eBpI4NzNU4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tZOxuw4D1q9cEGe-hnR4McBdhe9isvy5ug8uVjRKXkQ&oe=6A32C356"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplitChimpsOTThumbnail.png", "id": "488567727095851", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974732_488567730429184_4008640334868821400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9rLuxqEf_UQ7kNvwHVm9fk&_nc_oc=Adp83rZrltaqmHywPl2WeSKercEw_YMfzv_bMfc0tfgX1LTLbNIU1xigPgBMmJ2r_Zg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qZJCqVtSxq_L5GSPGl50d2hoRsCb8ZqgmTnfZK_mJJg&oe=6A329370"}, "display_name": "Split Chimps", "keywords": [], "long_description": "Split Chimps is a VR game that uses movement through your hands! Interact in a fun and creative world where the possibilities are nearly endless! Play around in a game that is active, fun, and exciting! Split Chimps will always make sure to bring the best experience possible to you, and also assures the best experience you could possibly imagine! Not only that, but the game is heavily based off of the community! You can join this community and suggest your own ideas that have a chance of being seen in the game.", "short_description": "This fan game is aiming to be one of the most CREATIVE and FUN fan games out there! I will be releasing active updates, each bringing more and more original and fun content for everyone!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicysc/home", "developer_terms_of_service_url": null, "publisher_name": "SplitGT", "support_website_url": null, "website_url": "https://sites.google.com/vi
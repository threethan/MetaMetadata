Q&oe=6A4E4168"}, {"file_name": "ss1.png", "id": "467432749343700", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39003277_467432752677033_4139747888612207560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URZ3USxQpZUQ7kNvwG8wp_Y&_nc_oc=AdpjkTBxWIXy1znhX0eWlff_pH0uLwLdKBRizdIZXIBLvTlKTY8mZBui2SQXTV3nsnk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw14qUZJjaXs0ekYkHcsgeVRL8h8INCB8dY4K9gDDxvw&oe=6A4E3A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplitChimpsOTThumbnail.png", "id": "488567727095851", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974732_488567730429184_4008640334868821400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxZco_7_tv8Q7kNvwFBwhae&_nc_oc=Ado4bNt_bF9BZYRHCzCRSaPOFE_OHJUkKR9CRY7uWIzWpqsHD7OeGy4MPkA2pCvSiwQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZt5A7ArX-_3EgH528eE5FiKm-2bGKs_MNUry7_xmylQ&oe=6A4E42F0"}, "display_name": "Split Chimps", "keywords": [], "long_description": "Split Chimps is a VR game that uses movement through your hands! Interact in a fun and creative world where the possibilities are nearly endless! Play around in a game that is active, fun, and exciting! Split Chimps will always make sure to bring the best experience possible to you, and also assures the best experience you could possibly imagine! Not only that, but the game is heavily based off of the community! You can join this community and suggest your own ideas that have a chance of being seen in the game.", "short_description": "This fan game is aiming to be one of the most CREATIVE and FUN fan games out there! I will be releasing active updates, each bringing more and more original and fun content for everyone!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicysc/home", "developer_terms_of_service_url": null, "publisher_name": "SplitGT", "support_website_url": null, "website_url": "https://sites.google.com/vi
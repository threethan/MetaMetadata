w&oe=6A43EDA8"}, {"file_name": "ss1.png", "id": "467432749343700", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003277_467432752677033_4139747888612207560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTZTkSLBxNAQ7kNvwEFpfIm&_nc_oc=AdrSkXvo_uHYuMwtG4UvzJE9C2J8ZdJQivACAQxlsUnVd0N1v8FHrHA341TObFtnylw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2ISm6U2Rnm9OVhBvz1auxkKP7k91mq_gJ1JN5cau4Ng&oe=6A43E6D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplitChimpsOTThumbnail.png", "id": "488567727095851", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974732_488567730429184_4008640334868821400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rg_NmeSEP8cQ7kNvwHJx67q&_nc_oc=AdqZvosfFRVYyrJYMdTw3R5bHRnhhWLqijD3ZXG6hmAxnIHeAYqIvDy0pJe-N4w7GaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rxtKtptUBT6MuZ6COWisePvIrEPkiPEIixniKncafcQ&oe=6A43EF30"}, "display_name": "Split Chimps", "keywords": [], "long_description": "Split Chimps is a VR game that uses movement through your hands! Interact in a fun and creative world where the possibilities are nearly endless! Play around in a game that is active, fun, and exciting! Split Chimps will always make sure to bring the best experience possible to you, and also assures the best experience you could possibly imagine! Not only that, but the game is heavily based off of the community! You can join this community and suggest your own ideas that have a chance of being seen in the game.", "short_description": "This fan game is aiming to be one of the most CREATIVE and FUN fan games out there! I will be releasing active updates, each bringing more and more original and fun content for everyone!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicysc/home", "developer_terms_of_service_url": null, "publisher_name": "SplitGT", "support_website_url": null, "website_url": "https://sites.google.com/vi
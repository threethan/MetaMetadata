747888612207560_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YE68TNwNAVYQ7kNvwFPqzua&_nc_oc=AdkCDyrPwcYBprCXSxZ0CbETRWIPVQDnEY1x9ldtgMNhecr3f-PY-wC2Xi6i7TFMhQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv27DHEhQAeZ_u67_CpX_UaVQNw0Y6kHrknD5kWZpNQdg&oe=699AEE96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SplitChimpsOTThumbnail.png", "id": "488567727095851", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974732_488567730429184_4008640334868821400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmypB0WVuhMQ7kNvwETHjza&_nc_oc=Adm7jBPR_iUPQBtpWuCKdwkcwAXQZ9hfoH-xp8fKHTjL6ux-VxBB-gS5aedxr5PYKL4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsJiLKyD3uccNJFYAwZ5Bhq3vULMx6qRCxsRNfmYXuWIA&oe=699AF6F0"}, "display_name": "Split Chimps", "keywords": [], "long_description": "Split Chimps is a VR game that uses movement through your hands! Interact in a fun and creative world where the possibilities are nearly endless! Play around in a game that is active, fun, and exciting! Split Chimps will always make sure to bring the best experience possible to you, and also assures the best experience you could possibly imagine! Not only that, but the game is heavily based off of the community! You can join this community and suggest your own ideas that have a chance of being seen in the game.", "short_description": "This fan game is aiming to be one of the most CREATIVE and FUN fan games out there! I will be releasing active updates, each bringing more and more original and fun content for everyone!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicysc/home", "developer_terms_of_service_url": null, "publisher_name": "SplitGT", "support_website_url": null, "website_url": "https://sites.google.com/view/splitchimps/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"
G_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75203624_228948372743948_232547963467569675_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm5Xn4hZrbIQ7kNvwHCmaKG&_nc_oc=AdnXw-HU1raofd-Bg7A_1uE6QwYlKZgK_VWu7DRxuGFXVFnyh2x1mSI1apVGGuCaIrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_CD2hSzD95jcG2HhsPKYV_wd3xJpxOsp8UtresVltPw&oe=69BE9174"}]}, "id": "670478994103547", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "295426622608678", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035390_295426625942011_8429024671966479221_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfopGM-AWooQ7kNvwFozETD&_nc_oc=AdlYk8TaORN0xMfaqqaZ9ns26-xasXJJYbNbFSle6NZgOo2u4EdrJ-dMJvCZQE4AUE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjtGArOc_7RaV4uXXYDu3-mHx9pbPja1c7QYXgAsgTZw&oe=69BE973D"}, {"file_name": "3.png", "id": "1069390837128046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982552_1069390840461379_3627497982414637675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2UyxPmAHGIQ7kNvwF6rND9&_nc_oc=AdkrB4p7KWh4kZk3d50No3UfZ4tr8sO9-q5dm7A7fJmAZLr9a56QJsZV098XI9u08vo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzl-Zj4D3zp75OBCY60rk8xU1H1_CMESQ4qxTy-CrOzJA&oe=69BEA3A6"}, {"file_name": "7.png", "id": "441969617414325", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031501_441969620747658_852449844545913033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RtjOtQAmawgQ7kNvwGueQVQ&_nc_oc=AdmvlJXbuD1o4vrJtQKSIA-T6SAoVoGWnOq185Nr0oN4MGU71pn1s5CCwmsUvK5LASM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8GPFGd9LTp5uNKmGCDkNIq_t7S4OsTOEYGD4VlEEOsQ&oe=69BEA44F"}, {"file_name": "14NoneGamePlay.png", "id": "476273094002854", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031336_476273097336187_5275121461717294164_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtfn_0D2_jkQ7kNvwFGjOa9&_nc_oc=AdmglS5rl269ygImLunz8s9YFaqHtV9lagtUKn3of81-GfprSenechsW5yOjiWKIH5k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwhyiz4S1akr9uPGPxrgo47oHE08tlhJcIhUCpqrj6zgQ&oe=69BE8A74"}, {"file_name": "18NoneGamePlay.png", "id": "637368467384624", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974538_637368470717957_3352359126328573896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL-S9tLY_PQQ7kNvwHqZw76&_nc_oc=AdmoGig0OFpxI0Lv0a_xPLHHhUH7ZFFrBsjrpmHoQhKeYWo3hAJDFgiwX4eCAked_zQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlQx3drrgwZC-wGHhmgG33AS0fj0S9ZxPHXEbmJkJtVg&oe=69BE8705"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grabber", "keywords": [], "long_description": "Here is a crane simulator with which you can control a powerful grappling hook! Just try several control modes - using the levers in the cab or fix your controllers in special mounts on the table (on our website you can download free models for self-printing on a 3D printer).\n\nYour task is to remove the used iron barrels from the conveyor and throw them into the shredder for further recycling! How many times can you complete a task in three minutes? We will record your record and you can compare it with your friends! Who is faster and more efficient?\n\nThe simulator will be useful for learning how to operate cranes and loaders.", "short_description": "You are in the crane cab and control the strong grappling hook! You just have to have fun - grab the barrels and throw them into the shredder. Recycling is correct!\n\nThere are several control methods in the Grabber simulator. Advanced users can print a 3D model of the controller holders. And enjoy virtual reality like never before!"}, {"images": {"nodes": []}, "id": "241083788143565", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Grabber", "keywords": [], "long_description": "\u041f\u0435\u0440\u0435\u0434 \u0432\u0430\u043c\u0438 \u0441\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440 \u043a\u0440\u0430\u043d\u0430 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u043c\u043e\u0449\u043d\u044b\u043c \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0438\u043c \u043a\u0440\u044e\u043a\u043e\u043c! \u041f\u0440\u043e\u0441\u0442\u043e \u043f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u0436\u0438\u043c\u043e\u0432 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f - \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0440\u044b\u0447\u0430\u0433\u043e\u0432 \u0432 \u043a\u0430\u0431\u0438\u043d\u0435 \u0438\u043b\u0438 \u0437\u0430\u043a\u0440\u0435\u043f\u0438\u0442\u0435 \u0432\u0430\u0448\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u043b\u0435\u0440\u044b \u0432 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0445 \u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0438\u044f\u0445 \u043d\u0430 \u0441\u0442\u043e\u043b\u0435 (\u043d\u0430 \u043d\u0430\u0448\u0435\u043c \u0441\u0430\u0439\u0442\u0435 \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e \u0441\u043a\u0430\u0447\u0430\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u0438 \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\u0439 \u043f\u0435\u0447\u0430\u0442\u0438 \u043d\u0430 3\u0434 \u043f\u0440\u0438\u043d\u0442\u0435\u0440\u0435). \n\n\u0412\u0430\u0448\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 - \u0441\u043d\u044f\u0442\u044c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0431\u043e\u0447\u043a\u0438 \u0441 \u043a\u043e\u043d\u0432\u0435\u0439\u0435\u0440\u0430 \u0438 \u043a\u0438\u043d\u0443\u0442\u044c \u0432 \u0438\u0437\u043c\u0435\u043b\u044c\u0447\u0438\u0442\u0435\u043b\u044c \u0434\u043b\u044f \u0434\u0430\u043b\u044c\u043d\u0435\u0439\u0448\u0435\u0439 \u0432\u0442\u043e\u0440\u0438\u0447\u043d\u043e\u0439 \u043f\u0435\u0440\u0435\u0440\u0430\u0431\u043e\u0442\u043a\u0438! \u0421\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u0441\u043f\u0435\u0435\u0442\u0435 \u0441\u043a\u0438\u043d\u0443\u0442\u044c \u0432\u044b \u0437\u0430 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u043e\u0435 \u0432\u0440\u0435\u043c\u044f? \u0412\u044b \u0441\u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u0440\u0430\u0432\u043d\u0438\u0442\u044c \u0432\u0430\u0448 \u0440\u0435\u043a\u043e\u0440\u0434 \u0441 \u0434\u0440\u0443\u0437\u044c\u044f\u043c\u0438! \u041a\u0442\u043e \u0431\u044b\u0441\u0442\u0440\u0435\u0435 \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0438\u0432\u043d\u0435\u0435?\n\n\u0421\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440 \u0431\u0443\u0434\u0435\u0442 \u043f\u043e\u043b\u0435\u0437\u0435\u043d \u0434\u043b\u044f \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043a\u0440\u0430\u043d\u0430\u043c\u0438 \u0438 \u043f\u043e\u0433\u0440\u0443\u0437\u0447\u0438\u043a\u0430\u043c\u0438. \u0423\u0434\u0430\u0447\u0438!", "short_description": "\u0412\u044b \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0435\u0441\u044c \u0432 \u043a\u0430\u0431\u0438\u043d\u0435 \u043a\u0440\u0430\u043d\u0430 \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442\u0435 \u0441\u0438\u043b\u044c\u043d\u044b\u043c \u0437\u0430\u0445\u0432\u0430\u0442\u043e\u043c \u043a\u0440\u044e\u043a\u043e\u043c! \u0412\u0430\u043c \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437\u0432\u043b\u0435\u043a\u0430\u0442\u044c\u0441\u044f \u2013 \u0441\u0445\u0432\u0430\u0442\u0438\u0442\u0435 \u0431\u043e\u0447\u043a\u0438 \u0438 \u0441\u043a\u0438\u0434\u044b\u0432\u0430\u0439\u0442\u0
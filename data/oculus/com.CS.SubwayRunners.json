OhDAQ&oe=6A394A74"}, {"file_name": "Image Sequence_004_0000.png", "id": "1925756481381387", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818885_1925756484714720_440513967696505581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84ZQe7Ia3JgQ7kNvwEjqUya&_nc_oc=AdoqpvDUd8gnqcvwo2ShbeyAV78l2wLvSgfEdrmEjQCLeJr1ATmAevzJY9OVT5nEViI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eDntcuuf4_DfkrPdVUHDd0J7ul7oqaZDyxY11SuGhng&oe=6A39487A"}, {"file_name": "Image Sequence_001_0000.png", "id": "1443199864145050", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821568_1443199867478383_2000449272829871336_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEIrRq0nDuwQ7kNvwEzqibs&_nc_oc=AdpywjfHf0H-JI5sNBvjMuVCn7R1RGxU01BiQafXUHB3eG7PWOp48707Q_DIMv0J2wM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GcNuKLb_gRZRGzHlDSqS_GZxRqlYeke2AUZcPNnxBxg&oe=6A393B20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4adc9cc58839cb46bbd83c4f937394be_1773130913_t2nf9fnb.png", "id": "1720589459303420", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307433_1720589462636753_3199728227983661824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyeFk3hn6foQ7kNvwFe2RNg&_nc_oc=Adr_Cr8Yoku6FUU0sdTvXjoycs2NkKsEaGTzK2l3TJ9NLz1TatDIpuW9GvpduLWHxS4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_qSVt_EzKRUcwkYVg40XegGdEX0sjm5E_cahZYuilaQ&oe=6A3945FD"}, "display_name": "Subway Runners", "keywords": ["subway", "surf", "surfers", "runner", "rush"], "long_description": "Are you ready for the ultimate rush? Welcome to Subway Runners \u2014 the endless runner that keeps your heart pounding every second! \ud83c\udfd9\ufe0f\ud83c\udfc3\u2728\nThe city is your playground, but watch out: the tracks are dangerous! Jump, dodge, and surf at top speed through metro tunnels and busy streets. Experience the thrill of train surfing as you weave through traffic. The trains won't wait \u2014 only your lightning-fast reflexes can help you survive this mad dash! \ud83d\udee4\ufe0f\ud83d\udeab\nGame Features:\n\ud83d\udd39 Insane Dynamics: Run and surf as fast as you can! The longer you survive, the more intense the speed becomes. \ud83d\ude80\n\ud83d\udd39 Vivid Graphics: Immerse yourself in colorful, high-quality urban environments and smooth animations. \ud83c\udfa8\n\ud83d\udd39 Unique Heroes: Collect coins to unlock a diverse team of daring runners. Find your favorite way to surf the city! \ud83d\ude0e\n\ud83d\udd39 Epic Boosters: Fly high with Jetpacks, attract riches with Magnets, and reach new heights with Super Sneakers! \ud83c\udf92\ud83e\uddf2\nBecome a rail legend! \ud83c\udfc5 Compete with players worldwide, smash high scores, and prove you are the fastest subway surfer in the city. In Subway Runners, every run is a new challenge. Can you avoid the collision and keep the streak alive? \ud83d\ude84\ud83d\udca5\nDownload Subway Runners now and start your journey to the top of the leaderboard! Your first surf starts in 3... 2... 1... GO! \ud83d\udc5f\ud83d\udd25\ud83d\udca8", "short_description": "Subway Runners \u2013 The ultimate adrenaline rush! \ud83c\udfc3\u200d\u2642\ufe0f\ud83d\udca8\nSurf the tracks and master the rails: dodge oncoming trains, leap over barriers, and slide under obstacles. \ud83d\ude84 Explore vibrant urban locations, collect golden coins, and unlock a crew of cool characters! \u26a1\ufe0f\nTest your reflexes in an endless subway surf challenge, use powerful boosters, and set records. \ud83c\udfc6 Ready for the fastest adventure of your life? Jump on the tracks and start running! \ud83d\udc5f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://monsterrush.online/Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Cacao Mobile SP Z O O", "support_website_url": null, "website_url": "https://monsterrush.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags"
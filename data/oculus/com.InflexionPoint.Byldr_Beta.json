803975_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk3DVyJuhXEQ7kNvwEyZjH2&_nc_oc=Adkh6hgKT-P19o73LzVCAT7dIiHb_M97PZM5ll4Xc19Q8cTlT0KiV9oZpXXQT5i_FVk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfszEPb6FQH2w9Lv8oJmV8eMr4vZ4q3e4BsZVtqbDI5u4w&oe=69A5718C"}, "display_name": "Byldr", "keywords": [], "long_description": "Byldr is a code-free app creation tool for AR and VR. Byldr features hand-tracking so that you can build wonderful apps in VR using your own two hands. Upload your 3D models and assets, create an environment, storyboard your creation, and byld something amazing.\nWhen you\u2019re done, publish your app so the world can experience your creation. That simple! Go ahead, start Bylding and create the VR future you know you can.", "short_description": "Byldr is a fun and code-free AR and VR app creation tool. Create your own apps in VR with no coding experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.byldr.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Inflexion Point", "support_website_url": "https://github.com/InflexionPoint/ByldrFeedback/issues", "website_url": "https://www.byldr.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1955567221290027"}, "review_messages": []}]}, "cover_square
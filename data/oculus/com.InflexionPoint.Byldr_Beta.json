! Go ahead, start Bylding and create the VR future you know you can.", "short_description": "Byldr is a fun and code-free AR and VR app creation tool. Create your own apps in VR with no coding experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.byldr.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Inflexion Point", "support_website_url": "https://github.com/InflexionPoint/ByldrFeedback/issues", "website_url": "https://www.byldr.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "PRODUCTIVITY", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1955567221290027"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2795039577308404"}]}, "baseline_offer": {"id": "2795039577308404"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1620757560, "status": "PUBLISHED", "id": "2795039577308404"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3872375396223049", "version": "0.2.5"}, "id": "348131679544726", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3386673774793216", "is_concept": false, "late
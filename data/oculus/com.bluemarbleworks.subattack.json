1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5hkSXpLskUQ7kNvwG6yShR&_nc_oc=AdprWtkJ3uIuAAzzh2TOjVcWVrCb13L_-uux0CDzu4DAKk_g1qcTBqE9gYSqUU-9Qa4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq1kF5xhE4C-0dO-UdFSGTWFOItI3ngJZzR3sXR9p4VA&oe=6A7F21F9"}, {"file_name": "4.png", "id": "430052028023282", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031311_430052031356615_6019303628671812272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRsiBD-l3bcQ7kNvwExNQvR&_nc_oc=Adr4-fqpydZ6ZFYH8D8uPR0VuWEw0ffmpAMlgWwiilblJSlzX-Bh-9QM5e8fVsMg5Q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW6uL2Cobg2yWnBt1K3nlXL-L1mNlysJTRPBuymnAfRg&oe=6A7EFE7F"}, {"file_name": "5.png", "id": "387292359270904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974879_387292362604237_9140954614658497210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olQlWJ3B-qUQ7kNvwEB4a3t&_nc_oc=Adre5rdpJ0c06F-VyzJ1Hw_6AFZL7gcR1BleTUi0chz817rOWSiA934SPSTduY1cbVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgFNC3WDtffb_gbP9m2KwxXIP_gLRIF2aOssLldqupvw&oe=6A7F0E3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SubAttackCoverLandscape.png", "id": "2026642160806481", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974879_2026642170806480_2105458039432183189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZaCnCUMUYQQ7kNvwH4sOOF&_nc_oc=AdpkM9mtFCfJuHoUmVV0QhAozFGDEJDAv1aBzdKi0W03t4Sw4vR3p0CLYJgQ7IQ870w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyAkQsUh9XrxYl6UAche60upP32BJvOJ4gmvM3dqmrGA&oe=6A7F1056"}, "display_name": "Sub Attack", "keywords": [], "long_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission?\nWelcome to the silent service. Meet the Admiral in the mission room for your briefing. Enter the conning tower and find enemy ships using a vintage hydrophone. Shift the depth lever using your Oculus Go Controller and raise the periscope and scan the dark waters of the vast ocean for enemy ships. Fire your torpedoes and sink them before the enemy escapes. Dive and escape the enemy\u2019s depth charges to complete your mission and live another day! Earn mission ribbons, medals, and advance in rank as you complete more missions and do your duty! ", "short_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission? \nComplete missions by using your Oculus Go Controller to interact with the depth lever, periscope, and steering wheel to find enemy ships, sink them, and escape depth charges to earn mission ribbons, medals, and rank advancements!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bluemarbleworks.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Blue Marble Works", "support_website_url": null, "website_url": "https://www.bluemarbleworks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "984663129118431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003269_396514921791
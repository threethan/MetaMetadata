1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RM9i2hE7zPUQ7kNvwHhOE3s&_nc_oc=AdqPVSq5A-KjEp6LsK650RCHiVgDwY9EhWWJqIj0CidIeHJr4y_oyOFGFF513todrVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8_rIGjJUHXZlwJqEShGHYDT4K2O3kNjHWcYH_8Xk9Og&oe=6A6220F9"}, {"file_name": "4.png", "id": "430052028023282", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031311_430052031356615_6019303628671812272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inytZP-Co4IQ7kNvwFTeV71&_nc_oc=AdpSAJS3E4FQW3MjB7H_9KP4ov8okgxYGxf3Iz1HCKFSbgI2BtEquRjTZ0A1RoK_5b8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCebgbZcaNjED2wFAE8HgTereGXHCiKTVRqTO5tRGR0ww&oe=6A61FD7F"}, {"file_name": "5.png", "id": "387292359270904", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974879_387292362604237_9140954614658497210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISf1n23sRvIQ7kNvwFOZerq&_nc_oc=Adpo4wLEb_vcswSN9v03qxDx86BatupQns8CLDzKBovP4AJW0en-tDhR3DZLggnOFTo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZymdB3Jt0978g6YUUqpBUDTOMVoIIoAkdFafxOu_w6A&oe=6A620D3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SubAttackCoverLandscape.png", "id": "2026642160806481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974879_2026642170806480_2105458039432183189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNkV1b28wrEQ7kNvwHFomQ8&_nc_oc=AdpicRBOs76wtC2vSADgfgsxpYDtrmstUtldUTlYlULuZyYnvLQdJ8ptXtYtHwMyxRQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIHPGBu-R9geSUxVce9fa-CJ5G0zW4aom72UNH6xzAdA&oe=6A620F56"}, "display_name": "Sub Attack", "keywords": [], "long_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission?\nWelcome to the silent service. Meet the Admiral in the mission room for your briefing. Enter the conning tower and find enemy ships using a vintage hydrophone. Shift the depth lever using your Oculus Go Controller and raise the periscope and scan the dark waters of the vast ocean for enemy ships. Fire your torpedoes and sink them before the enemy escapes. Dive and escape the enemy\u2019s depth charges to complete your mission and live another day! Earn mission ribbons, medals, and advance in rank as you complete more missions and do your duty! ", "short_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission? \nComplete missions by using your Oculus Go Controller to interact with the depth lever, periscope, and steering wheel to find enemy ships, sink them, and escape depth charges to earn mission ribbons, medals, and rank advancements!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bluemarbleworks.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Blue Marble Works", "support_website_url": null, "website_url": "https://www.bluemarbleworks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "984663129118431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003269_396514921791
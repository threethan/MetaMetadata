1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCkB_ZArTvUQ7kNvwGindGP&_nc_oc=Adp3iQHppUT6vgnsJCvGagSpHtqIbpjAxxWTdR2owNMBY_xYPgcDHrgfM9OGuL9UJ4M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7mjnc6PJJ9WoSqialoE8Nih3bViKnCDgya9AvI7ow1g&oe=6A50FD79"}, {"file_name": "4.png", "id": "430052028023282", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_430052031356615_6019303628671812272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AeUre2H2-oQ7kNvwHtJ7g7&_nc_oc=AdoOHRvh-kWKQV322CQq4i9GpvQKKXNHMWypVjLwR1Vwa1Wu6wqO4Q5F-279NjEceZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3_sTYC-19o9NhSlfdLHTs121RkBGHkNht0XB4hepR1w&oe=6A51123F"}, {"file_name": "5.png", "id": "387292359270904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_387292362604237_9140954614658497210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2U6aoHjldE8Q7kNvwF530cw&_nc_oc=Adp0OgEYfMrOaE3Qq0zXA0F-Mv8E8QpJ6Wn_R0tWNO1OvMIvRzU79qsyZslg-F63HtY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAf9I8blTGaf-TddLIgFi5lNRwSd-tshCbQ8EH6DsW_g&oe=6A50E9BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SubAttackCoverLandscape.png", "id": "2026642160806481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_2026642170806480_2105458039432183189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMsJpbzmG-oQ7kNvwEUegEj&_nc_oc=Adr1l33JxXHnddKZQlPKoR6gxL_C4Y4Uj9XaruzJpGHMJvnxhTOVZIdra3svSFrY6pc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaK2UcXY0I0idX6p3h-fuKGgBTyTygQY-Dgy0iXlS2uA&oe=6A50EBD6"}, "display_name": "Sub Attack", "keywords": [], "long_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission?\nWelcome to the silent service. Meet the Admiral in the mission room for your briefing. Enter the conning tower and find enemy ships using a vintage hydrophone. Shift the depth lever using your Oculus Go Controller and raise the periscope and scan the dark waters of the vast ocean for enemy ships. Fire your torpedoes and sink them before the enemy escapes. Dive and escape the enemy\u2019s depth charges to complete your mission and live another day! Earn mission ribbons, medals, and advance in rank as you complete more missions and do your duty! ", "short_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission? \nComplete missions by using your Oculus Go Controller to interact with the depth lever, periscope, and steering wheel to find enemy ships, sink them, and escape depth charges to earn mission ribbons, medals, and rank advancements!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bluemarbleworks.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Blue Marble Works", "support_website_url": null, "website_url": "https://www.bluemarbleworks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "984663129118431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003269_396514921791
QjvCIszYQ7kNvwHVsi-7&_nc_oc=Adm-sgLrhUarBpi39f1mQy-3bBwbh1nY2tjhvZ486tyiKWYP6hM1tkDhvtQzyR3nb10&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyss7GWlIczsUQONrszX4M0wftNpOVv8L7C3RSAsFRcRQ&oe=69AC31F9"}, {"file_name": "4.png", "id": "430052028023282", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031311_430052031356615_6019303628671812272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfBEdRzpsfgQ7kNvwEkG_bV&_nc_oc=AdkTEP6b0rBW08eOOlThSuICyUhu8SjOELVGuedBjyVliH6xHxiSzozB_lUP5gjE8QQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzb8SitZkrfb6mwYEszXyC9j7xfIc77fp7KZrDThGB89g&oe=69AC0E7F"}, {"file_name": "5.png", "id": "387292359270904", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974879_387292362604237_9140954614658497210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7iro8wSyIMQ7kNvwGv3J2p&_nc_oc=AdmBWn38RD-jEQiMfOVLoeXYTxwSjcLdkI7Yj_ed9ao3upzzVbeCJ1fHrDaVBQdwgHE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyOWyaDljv-nV1bM5nOsrp5RVQYZ3EtfxD8F4297yTvjA&oe=69AC1E3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SubAttackCoverLandscape.png", "id": "2026642160806481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974879_2026642170806480_2105458039432183189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOJ6S2bzhQ0Q7kNvwHuaCj5&_nc_oc=AdlTHU-4eaSK97szQq6m0CEqlG2r98NAooHCXdMxfZESGLBJShkQp6C3g6X226ASeu8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzUcv2HuV0FF0ElR6YmfDrREPwBmdJL3Eui8T97JAmT7g&oe=69AC2056"}, "display_name": "Sub Attack", "keywords": [], "long_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission?\nWelcome to the silent service. Meet the Admiral in the mission room for your briefing. Enter the conning tower and find enemy ships using a vintage hydrophone. Shift the depth lever using your Oculus Go Controller and raise the periscope and scan the dark waters of the vast ocean for enemy ships. Fire your torpedoes and sink them before the enemy escapes. Dive and escape the enemy\u2019s depth charges to complete your mission and live another day! Earn mission ribbons, medals, and advance in rank as you complete more missions and do your duty! ", "short_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission? \nComplete missions by using your Oculus Go Controller to interact with the depth lever, periscope, and steering wheel to find enemy ships, sink them, and escape depth charges to earn mission ribbons, medals, and rank advancements!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bluemarbleworks.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Blue Marble Works", "support_website_url": null, "website_url": "https://www.bluemarbleworks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "984663129118431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003269_396514921791273_5423650463087692586_n.png?stp=dst-png_s360x360&_
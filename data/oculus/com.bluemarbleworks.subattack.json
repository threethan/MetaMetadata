IVaCMJ5QylcmOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftK4MC29SjZ856GRMAPXcRtjsdpAZK6_Ax7uZvmm2wMGQ&oe=69A2F779"}, {"file_name": "4.png", "id": "430052028023282", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031311_430052031356615_6019303628671812272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSOt91DiMaYQ7kNvwHG2H59&_nc_oc=Adkpac5FjY_E5frp9-VYDh3iQmy2cWrsMP-Hg8qUVGH7-9oJpUvuYOxupkeNVP4UbjM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfspceXS3ZUILMRcoOiauhC513DjlKYvDcWp-vXvz3TsDQ&oe=69A2D3FF"}, {"file_name": "5.png", "id": "387292359270904", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974879_387292362604237_9140954614658497210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfYakcF5swsQ7kNvwHJWnfd&_nc_oc=AdnRgCX3_8gQVemP5LyQ-WKoGF5E-mdKZx_aAGoKdD3yQVjRjr3qf9-4VuGxEgDwoNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftaMNyy1V37NjQN_vKVNp3A8XymNP30jOC1BvMcoMVeaQ&oe=69A2E3BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SubAttackCoverLandscape.png", "id": "2026642160806481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974879_2026642170806480_2105458039432183189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyzWv_-GpMUQ7kNvwGp0lYh&_nc_oc=AdlJi2U33J4_3iX60k2ljJLOeEqT8_xpwzuMwfcWbQe73NT6EwhKyWP6OF42zR4ljto&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft8_7QJ-00RhXEMSxoqxEvpyKL0a3_N82YoofwJkdHScw&oe=69A2E5D6"}, "display_name": "Sub Attack", "keywords": [], "long_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission?\nWelcome to the silent service. Meet the Admiral in the mission room for your briefing. Enter the conning tower and find enemy ships using a vintage hydrophone. Shift the depth lever using your Oculus Go Controller and raise the periscope and scan the dark waters of the vast ocean for enemy ships. Fire your torpedoes and sink them before the enemy escapes. Dive and escape the enemy\u2019s depth charges to complete your mission and live another day! Earn mission ribbons, medals, and advance in rank as you complete more missions and do your duty! ", "short_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission? \nComplete missions by using your Oculus Go Controller to interact with the depth lever, periscope, and steering wheel to find enemy ships, sink them, and escape depth charges to earn mission ribbons, medals, and rank advancements!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bluemarbleworks.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Blue Marble Works", "support_website_url": null, "website_url": "https://www.bluemarbleworks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "984663129118431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003269_396514921791273_5423650463087692586_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4x5y9IagWiEQ7kNvwGy3K0R&_nc_oc=AdlW9KbIw6n0hMStUf-Fz27EAqJiNeveVxp9NcgN-aH2
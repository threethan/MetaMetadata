_Ubm9vNkQ7kNvwF7NXFN&_nc_oc=AdkKrJfAGTcqBfwxHCOGHSoxRMZBanSj3smBp7-H7TXMlO4JkfHeWHs_x3kOMQ01EDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_Hd5BhVfblOm3X2-kRVFWm61ph9A228kg9vcS3X8_mQ&oe=69B41AF9"}, {"file_name": "4.png", "id": "430052028023282", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031311_430052031356615_6019303628671812272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCWTwnFmJzcQ7kNvwF7F8qt&_nc_oc=AdlD7GJjyVuh3jpdP7Xm7BRFQBlIDqMIK3z3kDbrpNB_GrM_tp3nRsk3QchVPBd4py0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWPwwcuu4I79ea04cgQKUC4bOFWedfs0hmEvdwCn0oQQ&oe=69B3F77F"}, {"file_name": "5.png", "id": "387292359270904", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974879_387292362604237_9140954614658497210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uRdv6s6f6UQ7kNvwGhlAUk&_nc_oc=Adn_mVkwb77i6n7rdXdjsK2XqK8r6WG1NGL_FUY_1I6GPmAip89JnS1Y04PuEcWNS6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxRKF0Sm5StShA4_iPxCGmCL6d_3jDb0vNpTD9zG6DLSw&oe=69B4073F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SubAttackCoverLandscape.png", "id": "2026642160806481", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974879_2026642170806480_2105458039432183189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toW1Oy3zLSoQ7kNvwHs0LCf&_nc_oc=AdmjWuRtc9OmPdE9VnzZ1uczSua-x4fxhsvhUC9hk8irJ3VG7AeWdsPUJHTJWtJS-30&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afye55wxzE38xKE8EeeJR2r2cyHW_UuYgqDFm3PmP-RTHA&oe=69B40956"}, "display_name": "Sub Attack", "keywords": [], "long_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission?\nWelcome to the silent service. Meet the Admiral in the mission room for your briefing. Enter the conning tower and find enemy ships using a vintage hydrophone. Shift the depth lever using your Oculus Go Controller and raise the periscope and scan the dark waters of the vast ocean for enemy ships. Fire your torpedoes and sink them before the enemy escapes. Dive and escape the enemy\u2019s depth charges to complete your mission and live another day! Earn mission ribbons, medals, and advance in rank as you complete more missions and do your duty! ", "short_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission? \nComplete missions by using your Oculus Go Controller to interact with the depth lever, periscope, and steering wheel to find enemy ships, sink them, and escape depth charges to earn mission ribbons, medals, and rank advancements!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bluemarbleworks.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Blue Marble Works", "support_website_url": null, "website_url": "https://www.bluemarbleworks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "984663129118431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003269_396514921791273_5423650463087692586_n.png?stp=dst-png_s360x360&_
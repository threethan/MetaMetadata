1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQs-taKOseIQ7kNvwEqtuJ3&_nc_oc=AdpKkklt1ddO4OAOJ4rFxAFRGeRJ1bg_VLNug04qe3Un5oTAul_rWaNxCLYpJmVRe2o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0223qRcohoYUKmgtiJma3Y2a3vSKoDApLtH9gY0XFbg&oe=69C53E79"}, {"file_name": "4.png", "id": "430052028023282", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031311_430052031356615_6019303628671812272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uNdlzbZx3kQ7kNvwEZ1xu7&_nc_oc=AdpxpuPrCwWNgYe7Q57eMh_Ni3BeqQWfLKAh065n2g7Y9SBkPe4qvkXzsSmSsc5bWVA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmyYMTF7-8iJCAiBPd2z1WYphhwC-7I11-aWngkNMMIQ&oe=69C51AFF"}, {"file_name": "5.png", "id": "387292359270904", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974879_387292362604237_9140954614658497210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXXjhqUqZx8Q7kNvwFdOcbV&_nc_oc=AdqKWOn5RiBv_5DiXmSFvEoF8AMnLaFIGsj-4HXT3Hs1K0IVNhsIDPPU1g4KFQpOl-w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFdFF_RAjk9A6NBZ2xy3IrYiWz7C5Pvn6EyaLHeQnFnA&oe=69C52ABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SubAttackCoverLandscape.png", "id": "2026642160806481", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974879_2026642170806480_2105458039432183189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjuSI_HuOxAQ7kNvwFC-Lu8&_nc_oc=AdpFF0cQNyjc5gSojduPwpO72KrdiZ5Ct2I1ErhQfukDHEA-i1e4EyNDts2q8gX_KnM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlfzfSBDhjDpYALlKXVgVjUyV6x4eL6hBYPz7xhrzC8g&oe=69C52CD6"}, "display_name": "Sub Attack", "keywords": [], "long_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission?\nWelcome to the silent service. Meet the Admiral in the mission room for your briefing. Enter the conning tower and find enemy ships using a vintage hydrophone. Shift the depth lever using your Oculus Go Controller and raise the periscope and scan the dark waters of the vast ocean for enemy ships. Fire your torpedoes and sink them before the enemy escapes. Dive and escape the enemy\u2019s depth charges to complete your mission and live another day! Earn mission ribbons, medals, and advance in rank as you complete more missions and do your duty! ", "short_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission? \nComplete missions by using your Oculus Go Controller to interact with the depth lever, periscope, and steering wheel to find enemy ships, sink them, and escape depth charges to earn mission ribbons, medals, and rank advancements!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bluemarbleworks.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Blue Marble Works", "support_website_url": null, "website_url": "https://www.bluemarbleworks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "984663129118431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003269_396514921791
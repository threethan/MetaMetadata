Mq0UrZb_SbOIY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftnJtQmcIAvgpcX-x92c1V5PXRt3Fz4qXsZkuxuVHUqnw&oe=699F02F9"}, {"file_name": "4.png", "id": "430052028023282", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031311_430052031356615_6019303628671812272_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uh4eyO6f814Q7kNvwG_seCy&_nc_oc=AdntVTTIKwN8swIm6CpPYkm0PDIyRX88VDKxyy-sgt0yezRU7B6OUa8gv5zkVAL5WiI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuT5BaorNRZzkrKCgmKlwKY0zAgDZ5mMA2Cc-O5gzKH9A&oe=699EDF7F"}, {"file_name": "5.png", "id": "387292359270904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_387292362604237_9140954614658497210_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xMfQYGBqzEQ7kNvwGHH787&_nc_oc=AdmrL2PEfVgZz2uFR7xNLuMGFEAO1VNrbZX2bs0Sx2JxXmjl2QFMiw6iu2entkVTGWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfthJnia4A5ppnwENEtBQxOHPvDblXTrl0VByN8VUbadcw&oe=699EEF3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SubAttackCoverLandscape.png", "id": "2026642160806481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_2026642170806480_2105458039432183189_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsZq2DuSaRUQ7kNvwFITiJV&_nc_oc=Adm0vmpQp-WSa-MT0qCGX9P3bgcdfprWf8nZmzAF9GcQU73h4l74XMsmBW3Zn9CNKWQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvieEr5cX4FEmwfuIYACo48ogwwX_9RFMwaK3AgZS1KQA&oe=699EF156"}, "display_name": "Sub Attack", "keywords": [], "long_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission?\nWelcome to the silent service. Meet the Admiral in the mission room for your briefing. Enter the conning tower and find enemy ships using a vintage hydrophone. Shift the depth lever using your Oculus Go Controller and raise the periscope and scan the dark waters of the vast ocean for enemy ships. Fire your torpedoes and sink them before the enemy escapes. Dive and escape the enemy\u2019s depth charges to complete your mission and live another day! Earn mission ribbons, medals, and advance in rank as you complete more missions and do your duty! ", "short_description": "Command your own World War II era submarine and accept your dangerous mission to sink enemy ships, but watch out for their depth charges!\nYou\u2019ve got a job to do soldier! Do you have the skill and guts to complete this dangerous mission? \nComplete missions by using your Oculus Go Controller to interact with the depth lever, periscope, and steering wheel to find enemy ships, sink them, and escape depth charges to earn mission ribbons, medals, and rank advancements!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bluemarbleworks.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Blue Marble Works", "support_website_url": null, "website_url": "https://www.bluemarbleworks.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "984663129118431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003269_396514921791273_5423650463087692586_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTuGhkdmdTYQ7kNvwG_TPZr&_nc_oc=AdkDW4qvSXRmtfLzlbDqHbJzwuhkFlwtDtE2ZaW8FwpF
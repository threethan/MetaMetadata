cdn.com&_nc_ss=8&oh=00_AfzIRi6lJkkflsq0DA3Wa99vrgI20bd3OjYPkOdWAz9moA&oe=69BBF996"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome! You are a Japanese Macaca, or here a Snow Monkey!!\nYou live in a snowy forest...or..is it a forest? Looks more like a pit with clouds above it...Anyways, you can run, jump, climb, and do whatever else a monkey can do ALL while in the comfort of your own home! We also have a rising lava game mode (Disclaimer: not real lava) and we have... an odd tunnel that leads to a dark cave with a.. macaca in containment? Why would he be there?\nAnyways, play today and enjoy being a monkey!", "short_description": "Welcome! You are a Japanese Macaca, or here a Snow Monkey!!\nYou live in a snowy forest...or..is it a forest? Looks more like a pit with clouds above it...Anyways, you can run, jump, climb, and do whatever else a monkey can do ALL while in the comfort of your own home! We also have a rising lava game mode (Disclaimer: not real lava) and we have... an odd tunnel that leads to a dark cave with a.. macaca in containment? Why would he be there?\nAnyways, play today and enjoy being a monkey!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Kx9ClIAKKxIyFgAdipbJpOgAii7uFH6Jz-0CtyDdgtY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "ZenekVR", "support_website_url": null, "website_url": "https://linktr.ee/zenekvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
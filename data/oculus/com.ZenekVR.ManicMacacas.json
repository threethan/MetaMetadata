": "625027989055329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCzB3uDJLWsQ7kNvwEvlxAm&_nc_oc=AdrejeLHSNsDloK8gkPOzNx5lTDkKhUqZkXawKWDiIOPIFowNV5cDmYNH9bu5j1E41M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVojoyF_qY9y34D-nSzcNVmxe3E35NLap90TSJMUr7hg&oe=6ABE81BC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD6oPS5I_88Q7kNvwGX5VSZ&_nc_oc=AdpKZWu0wVxHSW_LJ7PBEZrfh_Gq6tRBU9AnbBr5ljwnrQpGcuAodCakER8bbG3SA2o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9CycFDtR_yL5KZqBI_v_SNy5emjUutZnjZHIaf8Y-Iw&oe=6ABE8C3F"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A62W-3cIckQ7kNvwEcsBex&_nc_oc=Adoe3Z-Dx5ikaJFsMtDo_gm6niBTHtv8Xf4mkfAB9R2BYjw1xoqNeB2oNd_6yCgG4dU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRoudEvjNMgK524t0C_BwY7MSxMadX-q5asaEVYbkwDA&oe=6ABE7AC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
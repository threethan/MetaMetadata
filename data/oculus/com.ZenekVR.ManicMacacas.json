": "625027989055329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy5WrfYYRbYQ7kNvwGj6s_N&_nc_oc=Adr5wJ_wWAaV9NksP2QCEwa933k_ncavaBtmk6uKoE2NwnxxbU07ej7dRounAFcVUCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiIp9YpR835Q-sy9Z7zmd3ZBLqc-HIoZb0iYki7Y7eTA&oe=6AE0C8BC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxdXzG8qxGYQ7kNvwHFe0xt&_nc_oc=AdoH2AnPCX5eNSs_Bjcj5cglwwXsvlmd-bIkQW1QBGHsaS12y7XD5XzgZVMAh8-f5Ms&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgCy7-JN154CAI1cS6-Q_FF6nFc_LtJSnXT36ELMPUyw&oe=6AE09AFF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGdf5Fqz8IUQ7kNvwHoxIur&_nc_oc=AdqgHigO5lE8VuxpNv55C_ugSe6depDEFX4G17aZ_v-orCRxm3_MTy3VA1NiQsPyrzg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgTif6eFCjHRBVWwQ06RhIJwzGFjyEejMK_Ubj7PkF1A&oe=6AE0C1C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
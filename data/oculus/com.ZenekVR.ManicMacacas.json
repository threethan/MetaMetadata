979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFCIMfmvWRkQ7kNvwHzuXHZ&_nc_oc=Adpbw5Ilg4Tx3tAbweTzw5Mxgjq3weXcpf8ZJ-mHKYfq2MviGEp5m_xNCY9XBh-EoZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2EUkh5PVac7KIZyNYBe6kmRjjZ-bjd3CefeDYVE7rQzQ&oe=69F09F7C"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtBwvh-hHJwQ7kNvwHINxMQ&_nc_oc=AdryBgMVtnowUoqPW3IwW0a78X9amjnLAqaWT5ZdwPLEn0BN2Eok8C_nWSIX4JQ7hS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3_Qrzov6yceSD57QTnkDYXYtj1oRciKmZ4sHj3jOQUZg&oe=69F0A9FF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHqstMV4JRgQ7kNvwGSlmTm&_nc_oc=Adptyx2eoAbFjr85fdoV5RtuMOMK1tffjPf5Ey8oJbR4SK0ZCIVD3GTyV71Aiuw1nQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0C_VanvnBCJMMzOKOTMBWjIIVwzay25WCAeGP5DlKU2w&oe=69F0D0C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Kx9ClIAKKxIyFgAdipbJpOgAii7uFH6Jz-0CtyDdgtY/edit", "developer_terms_of_service_url": null, "publisher_name": "ZenekVR", "support_website_url": null, "website_url": "https://linktr.ee/zenekvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "930187371650519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031605_249145920827439_5371154936840900375_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rH5tSeisWYQ7kNvwFxfxiD&_nc_oc=AdplwSdCs3aR7l1Qw_raHONYuwInEqmXWav0DfI53tetf62oedLnQSTXIhdFZEri_So&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2TKuYGQgSWVHC-AKbnPMYq_cuaXebBpj7LuXGqDcWcFg&oe=69F09FD8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Manic Macacas", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1676335816, "lastRe
": "625027989055329", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph7CYZKJJ7kQ7kNvwE_uQ59&_nc_oc=Adr_kid3YaePGcF1B4H3Z1ko8APK76J66nzsUl2A0Qfjxav4vLL7odB-SWXTueeZYaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_lr21kVQCpGWR47wVQvLT_QV6I1Y_eTwk77-m2qewYw&oe=6AE7603C"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSuRL75KsL4Q7kNvwEfQvb3&_nc_oc=Adr_VLEUYSMXEGbumCM7eINDO2USXiWzwueayML2dYRDqCOPyccWuh261VmM3S07i2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV86eR69Ce3ICKkyWo5U2dzA5vv2F1IITU4T5SiD6p8w&oe=6AE76ABF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAxhKdlCN0UQ7kNvwErEt-w&_nc_oc=AdpaAO480CTF_b7gOmDpyg9f2TJkZQPH0A6GPxnxtU3B2tArRF26KYcu3k9uj1gPMgM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2cg4XHUnaMmKFs5XjpYXb_xgqkOg6FDx1idzegGZZ7A&oe=6AE75943"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
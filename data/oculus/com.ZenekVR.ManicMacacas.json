": "625027989055329", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yONe2I_3ipUQ7kNvwEvP4CH&_nc_oc=AdpBSSB5DJ5UwbZJeEwfuLJpEM9nSoQFV4XHAj6J8tEsXuL06Q2mkWJ8IAynaJddLJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11ySuvt6lMUa7f1HTskXHl-z13yJLIuCzc02bKFj_TDg&oe=69EDFC7C"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtBwvh-hHJwQ7kNvwGJTsjN&_nc_oc=AdovKJvrsi8aXALrXB1Ycar7NfUWrfgl7WN-FYndoNhWCfnjhZwEPF0jgr5s8n56E_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HXk8xJDg8IqM6QaOY9HOrsp-wCdvhfSgI9GlUGk9DaA&oe=69EE06FF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHqstMV4JRgQ7kNvwHcz5r9&_nc_oc=Ado3UhZ97-aQ6kqu3vTjztdSZtOw8tuJS-0O6cnSO0iOe-W1BeaSmfsuRONqhfo2HLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_RyuoE5fduSisZ4ETSMg40eA-VsNfEVTvChQuPd7BfA&oe=69EDF583"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
": "625027989055329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ct215CjdCwQ7kNvwGPJV-k&_nc_oc=AdoWGgP_iWWJIG0nU7tzwmFaKKASTqqNTtfRtHm2vNaNXRnXyiEICZ7B5ndHbaP08HE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSq_RaxikSXZCiUwLijoyv449LK1SlcjNc2PUl328t-Q&oe=6AAABB3C"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbZbQpZD7WkQ7kNvwEj2hZf&_nc_oc=Adr40dbsmvCmSbZJUlriN6B3fM-veyzr8A9SNq_aL2OQ18TKHtqQcP5TPaYGu61zu2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPBtfWWaThVf8u_dfs4Uv6HpLwkhX7mBVeiyY91mUybw&oe=6AAA8D7F"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwQekiL7WX4Q7kNvwHLjlKd&_nc_oc=AdpzEAuUdLzmbj7yQyzWaAL5eWb8z8C4xqqOdsM4lkNAlLHYw5sOzxECDGD_ILKjvyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLflHEJUhCSa5xkbIUzUer53C94BVqiGQ3BpBhSWP5wPA&oe=6AAAB443"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Kx9ClIAKKxIyFgAdipbJpOgAii7uFH6Jz-0CtyDdgtY/edit", "developer_terms_of_service_url": null, "publisher_name": "ZenekVR", "support_website_url": null, "website_url": "https://linktr.ee/zenekvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "930187371650519"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031605_249145920827439_5371154936840900375_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlyWph3aCvcQ7kNvwFX4XoO&_nc_oc=AdpMYo5AC07MDCQq6BhsqH_HT5m0-18Qtuy_uVLZqNpMuVUJVtFhJY6CQHtlS6656AU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMrYdD8T_FrmKXuGgtqNMcO6h846-Frxoycjuv-EloTw&oe=6AAABB98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Manic Macacas", "platform": "ANDROID_6DOF", "context_categ
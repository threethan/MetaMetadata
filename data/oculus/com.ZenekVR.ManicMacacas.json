": "625027989055329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhZGD2ouBFUQ7kNvwHQfZir&_nc_oc=Adp7YJjVwtVyXONlbovBMzau0zjk1n617wV5bw17mEss3Mdf-WJYzufF1f96ZaOVYfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rnkIjuhGE-xr1QcMvlpJgZWKoe8vlbMNgU9e3xiAdQA&oe=6A204DBC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi2U23ajpNIQ7kNvwEQEMcn&_nc_oc=Adr2W_gzp5i6N6QnT3iw-1e9f-ss0-Oi58pFWagpqnHK5GVaeLV7HQeW7DqKY7lrafI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af551VcB3M-3vIJWug8klDsgBFL74iJ2VVgOuBCZZClwJw&oe=6A201FFF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj5HbImDoLIQ7kNvwGRPAPs&_nc_oc=AdqvY4Se-7aniyIAvqUlPc94geozop2bIrOSmA2UdjEKztcvYCKZzDAmmv0au2RAM9w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z-bJUA4SuUpFg91z1qNMFzt6X_I6pM0l6FWSnOt6RUw&oe=6A2046C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
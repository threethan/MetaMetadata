": "625027989055329", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd73XEekrXEQ7kNvwFdrMv3&_nc_oc=AdpBNo_EffcYgslcJg-89sjd2AK__o8YMeLG52ZVk4OZZWagVhty_pDxmj9rhiQ2UZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGBbmNMIJMc2iCnQ9U1l58gaIjn9RwrmJY_gIUGJSaTw&oe=6AF33DBC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_LqOSQIykoQ7kNvwGDHspZ&_nc_oc=Adr2mpm9n2C-Q4cmi4lQkp4rYrWCbpDrX9xfDbcym-ScuzBfoQ-xVl8rE3ixvcb2R4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4zzvoBtuLr2q3NwZ_8akHV8nZokgGd_2hXxl_LrZpGw&oe=6AF3483F"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UxPdBbogPkQ7kNvwGeALUb&_nc_oc=AdoW_B3nxa7lwH07TXo0VidlvHA8Oh2Ukm84DIOhBi9dFxbRGnHga6t2cb7_XGC8ld0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSXtN4jIaNr_2BIrZCUkcxt0VmV3zoT0HcFlslP-cieA&oe=6AF336C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
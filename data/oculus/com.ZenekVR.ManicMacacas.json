": "625027989055329", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5lVlgxVnesQ7kNvwH0ZIIu&_nc_oc=AdqyZZSZ80AJj9WKVEPpyttT2PyCNNLULQBEosSYDLCLPOInyFCMePVLrUcFk1Dt-wM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOsEaxXhVO_Vu-3zISrV7PE_ZvcMvehk306r89aSk0dg&oe=69CFA9FC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIYq4dNQDLsQ7kNvwEbIXv0&_nc_oc=AdpkOlAQdAzfG2o5xKLiyKpG0oEH6SXvpAZkOCGt---hcgjFfftiinQL2pePIsG8s8s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1nZVPJoZYQIU_1CiJyGtXohsJVdzhgosWJeMESrhqkg&oe=69CFB47F"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0MdZI86dgwQ7kNvwGGx9Tv&_nc_oc=AdrJTp4HGR1mQo0pnR88H1DMq3dqB84HUM7Ci6uGKc-uLKgFr9uZ2dK9ub80IA6jPCI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzK3FCxpnNzfOcVdk8h9_ol92PXYTYigM4YYePR-O5Alg&oe=69CFA303"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
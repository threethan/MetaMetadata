": "625027989055329", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSKpy8IfyloQ7kNvwHdseVX&_nc_oc=AdpQHCBNObhWWbbE0DlLVVu_g-6g1ytKII1-0v8I0_xo7ycw7qB8VkUJZPIygBoc_nU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DVUns6U9AuZdijdVqnyTgPXSTG65tjPlO4bdoSl7Lrw&oe=69E21EFC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=suSfKdAvBlUQ7kNvwGN49OK&_nc_oc=AdoORRS8Y2iusIW9WtX0x0NimvQRDdxxKJIED0PqXMn4mXFEOVA9y2KEjpVRz7-yigM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FzXmBGAHmoLTK2pW3dcDUtZK6qsvq1acUGVzeF-4frw&oe=69E2297F"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z-47hNyd2oQ7kNvwFwzDh7&_nc_oc=AdpjqV-SSZ_OA4fmWrwHk2l_hTe4pSltEvtkx8MHq8jO1nMsgSYvfR5ITm7u6oxBbmY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FvfINh90zUNFUa1AEtvujjh6cHL23DC4iR1DRyV4Cxg&oe=69E25043"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
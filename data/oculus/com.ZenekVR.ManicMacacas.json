": "625027989055329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_MzHeP4ieYQ7kNvwGG7LcX&_nc_oc=AdoUBgG3-oWEPnzCWFJLxquHqD1uMdudaV5d_o8mXgqSflIM_jMf5YU6nXOowS65fSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QK21A-n5uSlig1i4h_NRnALcLSdB_XYcuK4cCtWVFtw&oe=69DE2A7C"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-X1keJDg_oQ7kNvwFKEG0U&_nc_oc=Adowj8x2mkiKw85CQmiJXBV_J9_aXNzOZvBFdQRJ5f3_t-YUU-GCIiTxpPv7aNZrPY0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gVPZCoD1TEqxFiv3VT9xnSMr6M4oXHPczjoun0BShqQ&oe=69DE34FF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQwjRmqUAHwQ7kNvwGk21dw&_nc_oc=AdrUdpA7SuLKDs6z4t5j3L6svhAWUQPgSM5ZWRoTbpOn385G442I-Hi73uENiORbXG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wmL64eMGA6N8Grb0inqBXa3nIipZXu-uSV6rerYSx1A&oe=69DE2383"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
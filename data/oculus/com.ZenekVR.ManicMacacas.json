": "625027989055329", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSKpy8IfyloQ7kNvwHcvAz-&_nc_oc=Adqd8W57sn2y-yDJrXqU246GnHoDGZFupsA2Fee_sRydqDKxY7CgaP899Ret_zionR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rKnjnrSVT-edsfe-Mea9nX4bfkE-4ytlE0BnCIEghrw&oe=69E0CD7C"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-X1keJDg_oQ7kNvwEz1qRz&_nc_oc=AdrzjjY2OEkB5v80-VTAWRtuebTmmVC7EAAVMng7Y2ANHRR1f0VC_PNCIciiJXTGM6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pQ1Ui1XSLdFa_NfY2WJ2Zteh5aZpWnf_lK5TBXIRQOA&oe=69E0D7FF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQwjRmqUAHwQ7kNvwF4WSj0&_nc_oc=AdohhZWwmzwAjKoyksH6zrjfks0NESLkNClpq58AVhcIh52kGgZSA3SOgO1_PLIj7jQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l2A-htcPFtaE6TwzFJ3P4AFYlKAg88wDutAlzd2agZw&oe=69E0FEC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
": "625027989055329", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy5WrfYYRbYQ7kNvwEUUu3A&_nc_oc=Adrv3K5c0YuuKKU0rjjgEbm-8A7y6SLUEBaaQl76SnYErms4-IIoWoDgIwGO7jWFpGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxWiiJ9VzvUXWrN6Iip21vXb3JxvZ-jAdDkXCL9uaStA&oe=6ADE25BC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cvpmy8-UGV4Q7kNvwH66n_8&_nc_oc=AdrZKs5GIwXYGKl0a6XWw1VQV1noYuNIrdu-AUG5El7aiQY1wx_lmNX1uZMn-wueNZg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVZ63CLjJOfZ6oJdrd8t7cGSegsC90oPSZvIe5LnTZlw&oe=6ADDF7FF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiri_MuP-TkQ7kNvwFHoNmC&_nc_oc=Adq3lxpoQH9V6wnPD2e88kBehkSLJu5fRscyVsdbHit1giR30cLsHOsEakHGbdgVh8I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOk4ljYMTuP-4yh-YDFRlZayAqsONzQrhdPnAZYUQiOzQ&oe=6ADE1EC3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
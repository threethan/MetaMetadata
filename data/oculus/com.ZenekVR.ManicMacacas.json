": "625027989055329", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkSF5LA-yJAQ7kNvwF2bYX8&_nc_oc=Adq2AJXwsMQ4w7VafUpTDg-ff-bAMmDSSxrSFThGRicpDXYoWed6TBZa17cn2P81a-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxN8eSUeiGmBAetuW9cz_yOakCkcbTsJZkMQG8bzkn8A&oe=6ACBB0BC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMxEeZluZIoQ7kNvwEDVwnm&_nc_oc=AdoODo-xt3D2MSOFdoPT3mkQmeLZN0aK9gSZ64kNnCT-mMMkrV3Uias1_LD5ZGIkd-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE5WIczYX0xllXm2GoV9zwC2q4x7iugLbiaiaVP_ewgQ&oe=6ACBBB3F"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TA42RefLmrMQ7kNvwEoIZ8s&_nc_oc=Adq0OHLfPaVnColAK8w-zlUkTiIZ9K-KVA8uuJroeiWNsHeT-4IyKaJjSMbx6jiV7kQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsSxMudNxvjZfXpU_Ld5f77h0dWRjPZTU7IPzJN3OsfA&oe=6ACBA9C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
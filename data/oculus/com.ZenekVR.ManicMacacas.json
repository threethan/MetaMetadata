": "625027989055329", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s00Z03XBH3cQ7kNvwF3hEEi&_nc_oc=AdpL7gDYwWrVsGeHZPuF2RqE8s0WziVcAUHD6BEy6eLdw1fUH7LwhG4ZLMUevtZEILI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96Y7JkFGKghFC1c2PnszU3cM_9UlC302lN_5pS0IefqA&oe=6A34143C"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll3gNN6HlNEQ7kNvwGovEbQ&_nc_oc=Adp0eVKsG8pUI-Mv-PLBsBdKXR_Zl3BVm5t23Vwj_UOuyOatUfpGOLPP3rTgMqg09xg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JL_Fxv4QQhwzk_nt_kmSZAwu5_WnBI9992_NbaGTwKg&oe=6A341EBF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1c4vrk0rPMQ7kNvwEdNjuA&_nc_oc=Adrx5353QRAPy4RonR1AqUO6Ya6e5orImVaIDMaCJCy7haI1PK91eAc7eUcDmq3j2rQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IVBxrvX-LXU5SvfRccsKcsN8Y7w18G7xbJrD3zvX94Q&oe=6A340D43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
": "625027989055329", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9uoOXyN_74Q7kNvwH9AKzh&_nc_oc=AdpZ58vcBg8PKAJhWf9Tt6M2tfq6iNPAgrtyKfSaI1pfAyYCDdFO_whEnoNQPdqcqUg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uRjtt2h8CJE7AnU1I6siYCS79vNB9HBRVvs8r30ef9Q&oe=6A1B07BC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7QvNxWjab0Q7kNvwFyetqp&_nc_oc=AdqBBp71xEOFS7L__hX68Z5wSFZRNkzy_NHJeZI-MYc3csNAjyRcN8yGyvXJR2I7Es4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QDjExWVKG6G5rtZNRzqdESOkgPs6sE-BFrjf6NpXQaA&oe=6A1AD9FF"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23A2fs0kNIEQ7kNvwFmAKvo&_nc_oc=Adov-_cptumKFZWHRFjSmiVSEavqCysUmdm6qAM8AMUdBn-5fTG43NEE3ugWgbuKBA8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75zjtxW5rhPEUXjBNC_7tfsshrp5wk2DODCy9Jrxz54Q&oe=6A1B00C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
": "625027989055329", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5c4VmfsSAy4Q7kNvwFAllg3&_nc_oc=Adp8dS3MJVqFl3oxKUttnOeIvmSyz-jwDZcaxoOGzbW_T-we7RKjMsRjZokg9F0RCy4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cyIqFV4kssNjmWVxL_j77A1ZeRu-KY-VbqWEUubfEDQ&oe=69E764FC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGEHZPpcneIQ7kNvwGLkbtz&_nc_oc=AdqDIhWvJrX2WOyV7L9pd5mbSA-SpWAE-NwecTEAZQq3x95finlSEqrEQ9tSFJD9-V4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FjiDzXPtd6pEWmjKiOAtaFW-ENUxDFGtEknjtJ2jVLA&oe=69E76F7F"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCGuaq3rdhIQ7kNvwGPOig3&_nc_oc=AdplqjSpOj4qRhNQdgnNfiA07myOx7dJ-mj_-y1Q0Tj0TUTpv_m51CPmkQV6vaP-g5I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KQjFCvuwfHb4ijALdwfg2wzbXj4l2bE4ObxZCVOu1gg&oe=69E75E03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
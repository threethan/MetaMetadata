": "625027989055329", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/54809987_625027992388662_7145469994979269937_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PuAGxAXyXJMQ7kNvwHWoh4C&_nc_oc=Adoutx7K3qjOZBeVXyo1hfvNJjS3R7Vv8E-MZ4dpQxvT7ccXWHvBAgdXpXkuIoXo6AU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Acv1XBEO4BiKt1Ky8tvs_PgfZgU504G6ujccKjRRjqg&oe=69D792FC"}, {"file_name": "SCREENSHOT4.png", "id": "1630072047419899", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75630200_1630072050753232_8815667827662802992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpSBmLX8IhoQ7kNvwFNBn2i&_nc_oc=Ado4fuJ68TZYsLqsMXW0aFhN-TYlVhiI5I6e7JVY_zYSUOm1p-ZwPxARBUzFboyixeU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sfwoLE6d6UuSOTXkGNDNvENJ6BfCVcO0eU1mjcUSV7Q&oe=69D79D7F"}, {"file_name": "SCREENSHOT3.png", "id": "904661080791395", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031410_904661084124728_1266681545736997172_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsqWXmxQAkkQ7kNvwGqKTaV&_nc_oc=AdriXztyNs33zfLJLDRXFYSLIXX9h2QK9-hNdjk-GI_LrEIskG5F3QeK9tiBoRxI0j0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RjQzbrUhnA0IbhFVeg2E5PyfSqMW2Yn75qjXCWp1lFA&oe=69D78C03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manic Macacas", "keywords": [], "long_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fangame! \nMe, as the creator, put my heart and soul into making sure this is the funnest, best game possible! We have multiple developers from hit games like: Rat Party, CatosVR: Multiplayer Horror, and Bad Tag!!\n\nGo out there and explore your environment, you chill in a cave but the elevator will take you some place new! Put on all kinds of cosmetics to look your monkey best! And don't be a bad Macaca, we punish those! Now have fun!", "short_description": "Welcome to Manic Macacas! This is a fun, well made gorilla tag fa
101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePw-6oIrgkQQ7kNvwGGI8Yj&_nc_oc=AdqKplKYPUPdD2DyFdCA1xywO5XDwr9tsvaLxmrlSeZyA7auVKpfZmU2lCIBwbvcChQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdKY-Gr-k3wHddnMcGK73o-Qpa9SXtJXN1F7TD4wAP0g&oe=6B05C91F"}, {"file_name": "03-validation-review-candidate-2560x1440.png", "id": "1403932588518001", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_1403932591851334_1010388596835881416_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ft9HET45oZ0Q7kNvwGRRPBW&_nc_oc=AdohfbO4nY4CMbutNkzE2FjSsc6TBXm0KFvrMQYWLsEbTKOrXNEpA13E_IC7hAoaXB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdG-mH0CtuOvZAazaCYUVg4vXSD5Qnwj15eBnywz_VLQ&oe=6B05D757"}, {"file_name": "04-samurai-garden-candidate-2560x1440.png", "id": "1060405923548281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585799753_1060405926881614_665347360310984593_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfYdu_6uSaQQ7kNvwEpnaXP&_nc_oc=Adqh6bbq00Zu0XN21L1zP9Xwks0u25RkWrrvV7chkdp4uwxi3_tF490oO_NqkwUq788&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSImcGLGwowPSWUK33emgXuPbzPNcPZScKfKrxNt2I4XQ&oe=6B05BB8B"}, {"file_name": "01-samurai-clinic-candidate-2560x1440.png", "id": "1422470310070674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673645340_1422470313404007_6307590377793942140_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20P40o2xUfoQ7kNvwEEt1i1&_nc_oc=AdoDvIGDakMA_OH8mY6xb88fZpmEOTTW3GAe4vOuia6rHu1JJQtMVQ9h9699x9zuRs4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTphERXUv8sej3RX97m1Lq1lDgA4wWuEenQhlg58Ecm3Q&oe=6B05D3DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SudokuPlusCoverSafe-2560x1440.png", "id": "1051330794528594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604317775_1051330797861927_3519623374142770828_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6po_Wy5JdAQ7kNvwEDCg7n&_nc_oc=Adrgz2-YjI3i0DW8yd1X-JKDasdU_rQ4wc_pNn1vVzwH2sDVFNB7_Ti3fys4vAxpWCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_YGV2QGWQIwpnCoGeDrc6NX2ehVspUh0a1Ycg5GsNug&oe=6B05B718"}, "display_name": "SudokuPlus", "keywords": [], "long_description": "A familiar puzzle. A hands-on experience.\n\nSudokuPlus brings Sudoku into virtual space. Reach for a number, pinch to pick it up and place it on the board with Meta Quest hand tracking. An optional hand ray offers another way to interact.\n\nFOUR WAYS TO PLAY\nChoose Normal, Double or five-board Samurai puzzles across three difficulty levels. Explore Astral: connected maps with Samurai branches, larger grids and mixed difficulties. Your progress is saved as you move between zones. Complete a map to unlock the next.\n\nMAKE ROOM FOR COMFORT\nMove the whole play station to adjust its position. Choose passthrough or a clinic, garden or social environment. The interface is available in Portuguese and English.\n\nCHECK AND CONTINUE\nOne press checks placed numbers. A second returns incorrect pieces together, leaving correct answers in place. Challenge codes and local time rankings distinguish matching puzzles and interaction modes.\n\nPRIVATE ACTIVITY SUMMARIES\nMovement history is optional and off by default. Verified adults can enable local summaries of hand use, placements and movement activity. These are game-based estimates, not certified clinical measurements, diagnosis or treatment.\n\nOne purchase. All validation aids included. No in-app purchases.\n\nCreated by Reisioval.", "short_description": "Bring Sudoku into your space with Meta Quest hand tracking. Play Normal, Double, Samurai or connected Astral maps. Move the station for comfort, keep your progress and explore new challenges with local rankings and activity summaries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://su
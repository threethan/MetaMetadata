00_AQR-3WKP9-CR8vve7F77Yb78D7pTkIJpBlfG0xdLb6s8gg&oe=6B007C4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Trailer.png", "id": "683566140563504", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458098_683566143896837_8000733319106201642_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0W9_CX6NEsQ7kNvwEEBUCz&_nc_oc=Adr8AWDj-iaLHKXj-DC5Phzb7xl8TK9nHmrQcgOQw6q53R0ISXKkPQ_hRpQ6eSB8wF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ8iUWfQogOjZH1EqDwSaIoArR3SBv4Y9-RdhP_x-xeA&oe=6B005D7B"}, "display_name": "Chimp VR", "keywords": [], "long_description": "You know, monkeys and chimps are quite the characters. They really know how to have a good time, especially when it comes to talking and swinging around. It's not just a game for them, it's like their version of a good adventure, but they have walked into a lab as a joke, but now THEY CAN'T ESCAPE! Traverse around the map and run away from MONSTERS and if that is not fun for you, you can play sandbox as one of the many game modes! Enjoy the game!", "short_description": "Chimps have evolved to speak, and even swing around and make friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://primatesprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Random", "support_website_url": null, "website_url": "https://primatesprivacypolicy.carrd.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STA
6140563504", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75458098_683566143896837_8000733319106201642_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3W651NQfygMQ7kNvwFdRKJs&_nc_oc=AdrNt-hJSIWF3YS-sRYOddIRhX_T8llUM6ImzrY9xMje0UgHeGT8QdGvwW_BxyICglI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcMR5zooJEQsQnQRLA_FXLwth-V_Wqv9MpKCBY6ML3mQ&oe=6A8D72BB"}, "display_name": "Chimp VR", "keywords": [], "long_description": "You know, monkeys and chimps are quite the characters. They really know how to have a good time, especially when it comes to talking and swinging around. It's not just a game for them, it's like their version of a good adventure, but they have walked into a lab as a joke, but now THEY CAN'T ESCAPE! Traverse around the map and run away from MONSTERS and if that is not fun for you, you can play sandbox as one of the many game modes! Enjoy the game!", "short_description": "Chimps have evolved to speak, and even swing around and make friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://primatesprivacypolicy.carrd.co/", "developer_terms_of_service_url": null, "publisher_name": "Random", "support_website_url": null, "website_url": "https://primatesprivacypolicy.carrd.co/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6576374219129290"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.ocu
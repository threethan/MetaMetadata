kE6VKMyMKxoWZrsB7fkUpM6W1kXDBFKAGtt0JDEiNaUQFI8sgsgkgUWupQwME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ya6YnfTPwvHDzYwmB3frdwJ6X3hb-P98uuiywjJSgJA&oe=69FC875F"}, {"file_name": "interlocked2-20251218-015935.png", "id": "1405107631003632", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_1405107634336965_8711253963433854534_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUxgZI3i4v0Q7kNvwE-Kf0v&_nc_oc=AdpCXNNfEHEgUT5lrdo_VJ7GF80eHy-_MIulo2IbVBkb_y_eQdo6VFaFPWip9FiVROA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CC527XeobBvPFukrczk-UqQ9bA90ajCMHBo-zLeULaQ&oe=69FC8493"}, {"file_name": "interlocked2-20251218-020450.png", "id": "1154974659725880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304131_1154974663059213_1578890625031157738_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7vj8iPtYJMQ7kNvwEfCEUW&_nc_oc=AdqU6rvRuQnjO7c6UbKeI62LYEbbsCo-qwcZdUfoDloRGkDyrtwI3_fLWjWNSsK3_3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q-DBegtHwMZGJMpU57-PFf1D4q-zopkjcSYrsIwEqfQ&oe=69FC92BF"}, {"file_name": "interlocked2-20251218-022030.png", "id": "669752732770131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307962_669752736103464_4726569693410667863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23_zwTw4tjgQ7kNvwErlVL9&_nc_oc=AdqPxg3CurpFKRdZUdX4rvKQUXbw5bS5Rbi1MvDfAVETDOWaJRrtWCmNAF8PZ0d6Q3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62D2Iv5FeNNmb8SQNR56ReC6KzRr9Y9vTMFXxc4_S1jw&oe=69FC9D02"}, {"file_name": "interlocked2-20251218-020401.png", "id": "856254443990842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304305_856254447324175_8107503482561766285_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdCimOQAeIcQ7kNvwG3h9qH&_nc_oc=AdqIXhKz260msoFaqb2D78bG7x9FGDGj9xuzjhHEIEK_c6QFs7TwKbEyv5ts8rW7CIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7twEIcMvEi6NpX7mUI1JfJ2OnbYJ6vktWyflAgRwUCag&oe=69FC9F07"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Interlocked: Puzzle Islands", "keywords": ["puzzle", "burr", "brain", "relaxing", "interlocked"], "long_description": "A world full of puzzles, and one very curious bird.\n\nInterlocked: Puzzle Islands invites you to take apart the impossible. Grab, twist, and slide your way through lovingly crafted burr puzzles VR. Some are inspired by classic designs. Others were licensed from real-world puzzle makers who spend their lives thinking in blocks. All of them are waiting to be unlocked.\n\nExplore a series of floating islands, each one home to a set of puzzles. Settle in. There is no timer. No rush. Just the satisfaction of thinking with your hands. Every puzzle solved is its own little victory.\n\nYou're not alone out there. A small bird joins you on your journey. It hops across your puzzles, cheers you on, and sometimes causes a bit of mischief. It may even leave a gift behind.\n\nThis is the spiritual successor to *Interlocked*, the puzzle game played by over 25 million people. Rebuilt from scratch for VR, Interlocked: Puzzle Islands is a calm space to focus, fidget, and feel clever again.", "short_description": "Interlocked: Puzzle Islands is the reimagination of Interlocked, a puzzle game played by over 25M players, now built anew for virtual reality. Drawing inspiration from the wooden puzzles that defy disassembly, Interlocked: Puzzle Islands invites you to unlock secrets hidden within the game, offering a series of intricate 3D burr puzzles that demand a keen eye and sharp mind."}]}, "developer_name": "PuzzleDev", "developer_privacy_policy_url": "https://armorgamesstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Armor Games Studios", "support_website_url": null, "website_url": "https://armorgamesstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "cont
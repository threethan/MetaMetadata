400938009016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xX-DG5WjCsQ7kNvwEp5V09&_nc_oc=AdooAprXyjCBYrPVQQAKWb5b1xIzaOTp1JbW_mgoCQraJJ_k6_06em1QdNdKhHkz0EE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsNcG5hA3GNlGzsQ4KOBawi-zL35YOYc3vfRlIiU68Qw&oe=6ADE05BF"}, {"file_name": "image-2560x1440.png", "id": "970780502243262", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296057_970780505576595_2415167899864831727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5g2UUDj8aZIQ7kNvwGu4UaY&_nc_oc=AdoUM3lOgl_qGJ9XDJoh30Ufmp9E0gqzqciMIk9dS9hsju_eVt8rHo9syq8a2Z9112w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtVCqQoeR4aQ2xxyFonu-sTlO4eGQH3MlcXW6pBX4L8Q&oe=6ADDF67E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Proboscis!", "keywords": ["proboscis"], "long_description": "Proboscis is a social VR movement game built around expressive locomotion, simple parkour, and hanging out with friends. Move through the world using hand\u2011based movement that feels fast, smooth, and intuitive. Explore multiple maps at your own pace, including a dedicated parkour section and the snowy Mountains area, each offering space to climb, jump, and discover new spots.\n\nCustomize your look with fancy cosmetics that let you show off your style. Visit the in\u2011game store to browse items, collect your favorites, and build a unique identity as you play. Whether you're exploring with friends, practicing movement, or just relaxing in the environment, Proboscis is designed to be a fun, chill VR experience for everyone.\n\nMore maps, features, and updates are already in development, with new content planned to expand the world of Proboscis even further.", "short_description": "Proboscis is a social VR movement game where you explore maps, try simple parkour, customize your look with fancy cosmetics, and hang out with friends."}]}, "developer_name": "Nico", "developer_privacy_policy_url": "https://sites.google.com/view/proboscisvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nico", "support_website_url": null, "website_url": "https://sites.google.com/view/proboscisvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1325982749623342"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1482458519747646"}]}, "baseline_offer": {"id": "1482458519747646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783359960, "status": "PUBLISHED", "id": "1482458519747646"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1413296530891963", "version": "1.0.6"}, "id": "1347900114010653", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1308852708003013", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1413296530891963"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1347900114010653"}]}, "change_log": null, "created_date": 1791688120, "id": "1413296530891963", "version
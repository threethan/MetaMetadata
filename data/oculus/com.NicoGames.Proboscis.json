400938009016_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcvytTXrcXQQ7kNvwG1jhLe&_nc_oc=AdoFI3KDR_7otdCgDWJwpzoYVwFBK0ZJ-qqUaZij6OM9Mb1VXj5ld-ymUVJdnYsHdYU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb1PRMESysKkAf79JFQFHOU2DoqOQJgLtTMWTzRlVRVQ&oe=6AA160BF"}, {"file_name": "image-2560x1440.png", "id": "970780502243262", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296057_970780505576595_2415167899864831727_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfLNinrjHPEQ7kNvwEihJzg&_nc_oc=AdrJWJkYMiUhK5JnBI3BxiM412dzlcJsINSpWVby0F6ynwm2nbg2Rr6WKdd52u15sf0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBT-A2nvEm2k5g2p2rvFp9-LWhMQmbOp2JeVseDJ9r6g&oe=6AA1517E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Proboscis!", "keywords": ["proboscis"], "long_description": "Proboscis is a social VR movement game built around expressive locomotion, simple parkour, and hanging out with friends. Move through the world using hand\u2011based movement that feels fast, smooth, and intuitive. Explore multiple maps at your own pace, including a dedicated parkour section and the snowy Mountains area, each offering space to climb, jump, and discover new spots.\n\nCustomize your look with fancy cosmetics that let you show off your style. Visit the in\u2011game store to browse items, collect your favorites, and build a unique identity as you play. Whether you're exploring with friends, practicing movement, or just relaxing in the environment, Proboscis is designed to be a fun, chill VR experience for everyone.\n\nMore maps, features, and updates are already in development, with new content planned to expand the world of Proboscis even further.", "short_description": "Proboscis is a social VR movement game where you explore maps, try simple parkour, customize your look with fancy cosmetics, and hang out with friends."}]}, "developer_name": "Nico", "developer_privacy_policy_url": "https://sites.google
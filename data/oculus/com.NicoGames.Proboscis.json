20f&oh=00_AQQG3Ok9A8IS1Xz85tLDJ3YMNf8JEnlPe0p_lfE1Q7EfDA&oe=6B06F7A8"}, {"file_name": "SampleScene_1080p_11.06.2026_13-36-58-2560x1440.png", "id": "1058235360246381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303790_1058235363579714_792312400938009016_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vunUOS7zy7MQ7kNvwGn9RuO&_nc_oc=AdpznxP_KYoy9XXfJrqspo71h1ltXGAo4AuhEOQR7kqDAUzlJ7YpGmPazH6LNDC2KJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSd1KY-57KyefDTt4aRLrMTNG0q2bOCvkb9VEHwNnHtQ&oe=6B071C7F"}, {"file_name": "image-2560x1440.png", "id": "970780502243262", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296057_970780505576595_2415167899864831727_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6rR2B9YkhwQ7kNvwE4810r&_nc_oc=AdoSfUhROaUjaB_p4ntXi4P6YXxaak3a9Vq_WU7BvLOTg9G28fMxtEWWZEwkPm0XaOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCgAyFOIyb0ZP2L50McjqGDg24CBxgxRfPQvEX5AYLGw&oe=6B070D3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Proboscis!", "keywords": ["proboscis"], "long_description": "Proboscis is a social VR movement game built around expressive locomotion, simple parkour, and hanging out with friends. Move through the world using hand\u2011based movement that feels fast, smooth, and intuitive. Explore multiple maps at your own pace, including a dedicated parkour section and the snowy Mountains area, each offering space to climb, jump, and discover new spots.\n\nCustomize your look with fancy cosmetics that let you show off your style. Visit the in\u2011game store to browse items, collect your favorites, and build a unique identity as you play. Whether you're exploring with friends, practicing movement, or just relaxing in the environment, Proboscis is designed to be a fun, chill VR experience for everyone.\n\nMore maps, features, and updates are already in development, with new content planned to expand the world of Proboscis even further.", "short_description": "Proboscis is a social VR movement game where you explore maps, try simple parkour, customize your look with fancy cosmetics, and hang out with friends."}]}, "developer_name": "Nico", "developer_privacy_policy_url": "https://sites.google.com/view/proboscisvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nico", "support_website_url": null, "website_url": "https://sites.google.com/view/proboscisvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1325982749623342"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1482458519747646"}]}, "baseline_offer": {"id": "1482458519747646"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783359960, "status": "PUBLISHED", "id": "1482458519747646"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1427065826181700", "version": "1.0.7"}, "id": "1347900114010653", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1308852708003013",
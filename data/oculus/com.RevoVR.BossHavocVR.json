anagement and quick reflexes are the keys to victory in this thrilling VR shooter.", "short_description": "Boss Havoc VR throws you into an intense survival arena where every wave of enemies tests your aim and your strategy. Buy new weapons, fight off stronger waves, and protect your money at all costs. If enemies reach you, they steal your cash\u2014lose it all and you\u2019re done. Smart resource management and quick reflexes are the keys to victory in this thrilling VR shooter."}]}, "developer_name": null, "developer_privacy_policy_url": "https://revovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Revo VR", "support_website_url": null, "website_url": "https://revovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24375817565417388"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821615_2841627146033560_8546465384244652375_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daD5w9M92BcQ7kNvwG7iJnc&_nc_oc=AdoVQbZnf15rRj0WA681JBHZejvetrTYJfJbekiLfVKJ3xZ35m8KgtslE1IHUA_uL8w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af015mmMXgrn1-qdZMUrUOedkzaFxzIsPiLkYITKcyh_Og&oe=69F1F57B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boss Havoc VR", "p
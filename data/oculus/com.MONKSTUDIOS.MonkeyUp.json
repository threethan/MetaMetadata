t hanging out, there's always something new to find. No swinging\u2014just pure climbing, exploring, and vibing. \ud83c\udf3f\u2728 With smooth movement, multiplayer fun, and a laid-back feel, Monkey Up is all about good times and monkey business. \ud83c\udf4c\ud83c\udfae\n", "short_description": "MonkeyUp by Monk"}]}, "developer_name": "MONKSTUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/monkeyup/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Monk", "support_website_url": "https://discord.gg/y7z3VJrMHW", "website_url": "https://sites.google.com/view/monkeyup/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25309365608650491"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618298_1095725781961907_162458132687960600_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMrIKFIaoF8Q7kNvwHH6tBm&_nc_oc=AdndM4y97-uyhx7ev8DxK1__uLN-wHetrO5PRDJehMXwSvOyoz_aISSRIbgLuohQ2bw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvY1fO4bgLRZDQWMImYLDtXTW9NN67gSTvw1NkTNf14w&oe=69BFE282"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "MonkeyUp", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topic
44", "version": "1.03", "version_code": 103, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29020442027621503"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793195398, "id": "29002971959368510", "version": "0.98", "version_code": 98, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29002964932702546"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": null, "created_date": 1793073042, "id": "28983460027986370", "version": "0.95", "version_code": 95, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28983451951320511"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Crazy Golf VR \u2014 v0.94\n\nThe Jade Lantern Temple, rebuilt\n\nThe Five-Storey Pagoda is now twice the size, and you can go inside. Explore the hall, climb the stairs to the second floor and step out onto the balcony.\nA new Moss Garden fills the bend with a stroll garden: a large arched red bridge, stepping stones across the lawn, and a stone waterfall spilling into the pond.\nThe Moon Pond now has gentle lawn banks down to the water and a wider zig-zag bridge you can actually walk.\nRing the temple bell. Past the final hole, grab the striking log, pull it back and swing it into the bronze bell. Everyone in your group hears it.\nNew cherry trees, with rooted trunks and fuller blossom. Hit a ball through the crowns and you\u2019ll hear the leaves.\nA new garden of red Japanese maples, flowering azaleas, bamboo, ferns, irises and moss across the course.\nWaterfalls now catch the sunset light, with foam and mist where they land.\nTaller temple walls, and the ground now meets the path smoothly everywhere, so no more stepping off hidden ledges.\nFixed flickering surfaces on temple decks, gates and lanterns.\n\nOther courses\n\nVolcano: a new summit, carved portals, smoke plumes, new scenic lookouts and retuned encounters.\nSunken Sanctuary: new tube entrances and a cliff lookout, and the tubes now pull in slow-rolling balls.\n\nGameplay\n\nA shared celebration when your team sinks the ball, and a clearer recovery effect when the ball resets.\nThe race HUD shows which leg of the course you\u2019re on.\nPar and target times retuned from real clears; the solo clock pauses while the menu is open.\nA ball that drops back onto an earlier part of the course now recovers properly.\nPteranodons plan their dives better, keep away from your head, and tumble away when knocked out.\nImproved seated-play prompts, and a vignette when your head moves into a wall.\n\nFixes\n\nFixed a crash when leaving a course.\nA loading card now covers arriving in a session.\nThe Introduction can be replayed without freezes.", "created_date": 1792779200, "id": "28938685685797138", "version": "0.94", "version_code": 94, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28938679022464471"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": null, "created_date": 1792423926, "id": "28881228868209487", "version": "0.87", "version_code": 87, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28881221251543582"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
racking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7242557179169968"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1008031367839988"}, {"status": "PUBLISHED", "id": "308438845097830"}]}, "baseline_offer": {"id": "1008031367839988"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740808740, "status": "PUBLISHED", "id": "1008031367839988"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8820460711379599", "version": "0.28"}, "id": "1438346520109192", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8820460711379599"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Hey guys, I saw some of the feedback and decided to update the application. I fixed some of the sounds to be a bit gentler on the ears & created the \"holstering\" mechanism for the golf club.\n\nI've been experimenting with Map design and Worldbuilding on the weekends, and added some additional maps! In the meantime, I appreciate your comments about accessibility and usability. I want to try to make it easier for users to play before I add in more features and gameplay. I'll come back with more updates, and maps soon :)", "created_date": 1732115905, "id": "8820460711379599", "version": "0.28", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_
ers-raptor.png", "id": "1445954297670766", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620532_1445954301004099_4334922826542964934_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-hG33Uhl2UQ7kNvwEECytf&_nc_oc=AdojbIT5oNxu9amZfrspTX8baFIzoDPb9ja41T5t5QZ5nxnOim1rsAW6Fcv0jM0k3pM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWk0vgcvuZPJxhjT4NP6vBCcuTm5f4At0VSzzYfkrWOA&oe=6B09C6BC"}, {"file_name": "05-sanctuary-pearl-hole-pov.png", "id": "1024895080652578", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623585_1024895083985911_7527913330202176631_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y0NRmA6UYwQ7kNvwE1ug7H&_nc_oc=AdqdCmDvCKTQikPhcWiUkDhNZHdqXCPZGR_qxsdLh0j6jo7OKh5JkA3D5uOneY0BOso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRo-udVFSO8ghJkLFFZbvjTAS5AmxnXilsXxN0LheC9Q&oe=6B09BF6E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1671715101338051", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623111_1671715104671384_5875727415432959553_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOgvcbwELSIQ7kNvwHUxg61&_nc_oc=AdoKR8CWYE0SfKaX6LTcIE5TpHBJjJ3_YicAR5YNNe4Hv4sLPOb_H52xjTQNNkDTUF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXZfKRP_lk7TluP5bBZmltqIxvxgnSh_JfelX0lNl0Kg&oe=6B099A73"}, "display_name": "Crazy Golf VR", "keywords": ["Golf", "Dinosaurs", "MiniGolf", "Multiplayer", "Coop"], "long_description": "Crazy Golf VR turns mini golf into an adventure. Every course is a race to the hole: take as many strokes as you like, dodge the dinosaurs and chase your fastest time.\n\n**Six wild courses**\n- Putt through woodland meadows, alpine slopes, red-rock canyons, a glowing crystal cavern, rivers of lava and a sunken sanctuary on the ocean floor.\n- Raptors prowl the fairways and pterodactyls circle overhead. Fend them off with a plunger gun, and ring bronze gongs to lower the drawbridges.\n- New to golf? A guided Introduction teaches you to swing, move and shoot.\n\n**Play together**\n- Co-op: two to four players share one ball and race the clock together.\n- 2v2 team race: one ball per team, and the first team to the hole wins.\n- Two clubhouses, a moonlit city rooftop and a sunrise lakeside valley, host up to six players with voice chat and driving ranges for long-drive contests.\n- Invite friends and join their games in a click.\n\n**Compete and collect**\n- World leaderboards for every course's fastest time and each range's longest drive.\n- 13 achievements, each unlocking a title for your name tag.\n- Pick your cap colour, and finish the campaign to unlock a cat companion.\n\n**Play your way**\n- Teleport or smooth movement, snap or smooth turning, a comfort vignette and a seated mode.", "short_description": "Mini golf meets a dinosaur adventure. Race to the hole across six wild courses, solo or with up to three friends, and keep the raptors at bay with your trusty plunger gun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.avivarma.ca/Crazy-Golf-VR/privacy.html", "developer_terms_of_service_url": "https://www.avivarma.ca/Crazy-Golf-VR/terms.html", "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.avivarma.ca/Crazy-Golf-VR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28857110523954655"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624990_2180131322928189_3959385310701763709_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3njh1Sue9QQ7kNvwGIOYLT&_nc_oc=Ado7QV60MEChxZiQvLB0dYRi2eghIsWgIH39eZSzPoZc_wQjITy6Bs7nPSe6-9FRM5E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4TMQtQwHOAHT-g_hKqbrhD2jENTpT-ZQ2_WN8PgnUQA&oe=6B099ED4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crazy Golf VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1707942780, "lastRevision": {"nodes": [{"id": "7242557199169966", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7242557155836637", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "7100018800105874"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverArtPortrait.png", "id": "3495314790733443", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031587_3495314794066776_8316139556651851441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDNJ1iZLYWkQ7kNvwEUddJ3&_nc_oc=AdqVDEzFcyV0lyRmzGWHAQlJW6hNxaAlUUFdSlZo829qZOTLYBSfqvO1ljMV4tFpKSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWD5NsIimjwB_yX6S7QkbjJ2HT4Vpz6WNA_15pfm2ZBQ&oe=6B09B992"}, {"file_name": "MiniLandscapeBackground.png", "id": "2116306672078035", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75593950_2116306675411368_8088691397984178912_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dL1z4t49uUQ7kNvwGF8A7L&_nc_oc=Adr51Ck_wH62SJwg0aJd9UFd0mAgCoGbczwRl-zA9hzkK3cl3Bzj9AgmNlRYHFV3-pg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYQ3hM9GY03qg0sDP4bNGk9bq28hd3ebopZqp51pNiTg&oe=6B09C2C7"}, {"file_name": "CoverArtSquare.png", "id": "1923719118059999", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031456_1923719121393332_4504351395349498027_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GV9m8QiHRygQ7kNvwFFiRr8&_nc_oc=Adplz5Zr-QUwihuJR9LsjyyAlYpnM0wbiki7nGp2lNeoDToN0GPW-_zNmrIEyFR6Yvo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHM6rBTngicK_U22m99e8lVbGz2ErUd4A5CVtN7lWW1Q&oe=6B09BF69"}, {"file_name": "Logo.png", "id": "1182902649359521", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86619816_1182902652692854_9031720951112319284_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvFr0ynDycMQ7kNvwHgd-bm&_nc_oc=AdrSdD_a5CAvQ_wFboefZwsd_4xo04YduJbpKNd3fQ7H6mLyJYvhd8IbcPXpKktDyiM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY-LOvF15bGaSq8OAJD-0NbK4zDgcLtGGikKYPiA8AAA&oe=6B09D174"}, {"file_name": "Icon.png", "id": "1037441694223645", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39003252_1037441697556978_3475259315052248174_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynJNfhJMV1wQ7kNvwGs6NQo&_nc_oc=AdrFMfujxOZ2SiAiUxvj0i-8fq7ZNXOlwuDhU3JzeikOrw9xgGEELg3hfiN3BQpfF4s&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1XsAw8LqwQFiBCI0ifYyGdQP_lGkXWIQ4ljrWbxJ3xw&oe=6B09A2A2"}, {"file_name": "CoverArtLandscape.png", "id": "927625695611298", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75361346_927625698944631_4861334867035495563_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAMUM1kEewQQ7kNvwHASHYf&_nc_oc=AdowjTcY02NGSB2ZDg7js83_ENBErzj9o3-sjVtFfgKkBSOs9Pu6oiVzJQT-Isy_imI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsLRdqYlgxVrCAO8fJxyilWqdJT6yAWnWmx998tRD8NA&oe=6B09AB97"}, {"file_name": "HeroCover.png", "id": "225984143843777", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982460_225984147177110_482557685155359975_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXwBf3O9-q8Q7kNvwF_edX3&_nc_oc=AdrZ6iR0ERlD_4pefwh_vtaoozwEIbIErIv131UMy-o_1yadTSV-UkC8DydVyiEqsqo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLtlCOnNGIs-aU8sW4RgNi6aBD1JXGM2srqzDYqLTEXA&oe=6B09B6EC"}]}, "id": "801624848432451", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3.png", "id": "7176409862448731", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75286676_7176409865782064_3152612281375049195_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6WyTfBQGiUQ7kNvwGaysVW&_nc_oc=AdrDPwx2iy5wgy7p5_BVuEOGG5QNe1KR4oYgww2EF5eqPQEL8wF69-a6rRSnjWErPUs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJzYUN1Aft_Fm0y_lQhk4SOU73PyJNlQh6iSpTpWJwyQ&oe=6B09A43D"}, {"file_name": "Screenshot2.png", "id": "404281905443729", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572950_404281908777062_8427973265631679341_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBK70qPfLDIQ7kNvwFaPj89&_nc_oc=AdrVOVd5Zph-nb9TU4zeTKvfUf3SX7-uRWxsX1uVGCU5CFMeMinUGXSZyOYS45DzDJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF-hkJliKksrkbkqveHFgkkkPNUr7HnhQv8dSuTMbd4A&oe=6B09A9E4"}, {"file_name": "Screenshot1.png", "id": "351439054482587", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035400_351439064482586_7709402978214007870_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_ekNnfD2b8Q7kNvwHo7Yrq&_nc_oc=Ado2IFjXBtFm3mdQr5_d9RiygYXakEk1rDUZNcNL_d_8JPXGHYmndvWbwu1PqWivbR4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRep6zYJQMHxyOgQJz9aCrzhD5t-En-znTrTD5T6lK-XQ&oe=6B09B92C"}, {"file_name": "Screenshot6.png", "id": "776949421005778", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/65402154_776949424339111_676970916754398417_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uma00pX2EP8Q7kNvwHCQl-t&_nc_oc=AdpTqlzCuKLJ49peFJM84ZEm5rY01Qz4OizGu-AOU-qxn_Mux_eRi2pFbpdeKVuF8OQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU-gPke1ydKE1Ht8R00F8aTUA9qSxwZVQMc69mmxy3Yg&oe=6B09B66C"}, {"file_name": "Screenshot4.png", "id": "1051867219381970", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1051867222715303_1336008833305204054_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IoJjVMdv7IQ7kNvwFyGdIz&_nc_oc=Ado_fIdr-yGEN76RiHjg7erS0VQa9GILUErRTvngMvGzt92DJ_lLvrh9RpNal8EOEHk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6Bwu8DiInm84oNXhIhMD0kRcQIx0K3LTho7X0LWd26w&oe=6B09A60E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1180299342948470", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982491_1180299349615136_4212956715900943579_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LLwr_aOwMIQ7kNvwEbKqhG&_nc_oc=AdqqSPH37NMis8qk5drwRPEoyTpItI1nQmYVb7F5S9euN0wMwNIM8gxqGVnQ94B-BIk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAwdplPHzl-1GwQ4DB4-ftZKGJ2lfA7BKhWoMsEo1HEQ&oe=6B09A0EC"}, "display_name": "Crazy Golf VR", "keywords": [], "long_description": "Welcome to the most jaw-dropping, tail-swinging golf experience ever! In Crazy Golf VR, you won\u2019t just be chasing birdies; you\u2019ll be dodging pterodactyls, putting through lava pits, and aiming for the elusive T-Rex hole-in-one. Get ready to swap your golf cart for a time-traveling golf pod and embark on a prehistoric adventure!", "short_description": "A fun golf game with crazy environments! \n\nMade for fun by Harshvardhan Varma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avivarmavr.artstation.com/pages/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.artstation.com/artwork/PXr3Qo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7242557179169968"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4433475373542610"}, {"status": "PUBLISHED", "id": "1008031367839988"}, {"status": "PUBLISHED", "id": "308438845097830"}]}, "baseline_offer": {"id": "4433475373542610"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792170000, "status": "PUBLISHED", "id": "4433475373542610"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29342790165386686", "version": "1.21"}, "id": "1438346520109192", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Version 1.21\n\nNEW COURSE: LUNAR LINKS\n- An eighth course on the Moon: race from the launch pad across rilles and drawbridges, ride a working cliff lift 96 m down, and finish on a green under the Earth.\n- Its own music, the Lunar Voyager achievement and a new name-tag background.\n- Lift levers and gongs show a marker telling you what to pull or strike.\n\nCOURSES AND VISUALS\n- Sunscar Canyon: no more pitch-black rock recesses, and fewer gaps between the rocks.\n- Golf Volcano: a richer molten lava network.\n- Rebuilt Temple cherry trees, new hole bowls with a stone collar, and art passes across the campaign.\n- Some courses have new names.\n\nRACE, CLUBHOUSE AND MENUS\n- Clearer race display: distances, the time left to beat and how the race stands.\n- A tidier results board.\n- The clubhouse and Sunrise Valley are dressed up, the wardrobe is rebuilt, and you can sit on chairs.\n- Refreshed main menu panels: join lobby, audio, online and companions.\n- The cat companion now unlocks after a solo clear of the fourth course, including for players who already cleared it.\n\nMOVEMENT AND COMFORT\n- Jump has a natural arc, a short grace period after stepping off an edge, and landing feedback.\n- Falls: you are held safely while the next area loads.\n- Teleports only fade to black when Teleport Blackout is on, and landings no longer put your head inside nearby objects.\n\nPERFORMANCE AND AUDIO\n- Sharper image on Quest 3 and 3S: higher render resolution at a steady 90 Hz.\n- Smoother first loads: graphics are prepared on the loading screen.\n- Lighter materials across every course.\n- New creature sounds, cleaner interface sounds and better music quality.\n- Updated to Meta XR SDK 209.", "created_date": 1795287559, "id": "29342790165386686", "version": "1.21", "version_code": 121, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29342786288720407"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "NEW COURSE\n- Lunar Links: an eighth course, set on the moon, with its own soundtrack of eight songs, a leaderboard, and the Lunar Voyager achievement.\n\nCLUBHOUSE AND MENUS\n- Sunrise Valley: the view from the clubhouse has been rebuilt with a stone bastion, groves, boulders and golden sunrise light.\n- The clubhouse platform has new trees and dressing.\n- Main Menu: \"Play together\" replaces the separate clubhouse and campaign pages, with larger mode and join buttons. Every menu button now highlights when you point at it.\n- Long Drive range: a cleaner board that shows only the buttons you can use, and clearer landing markers during a round.\n\nCOMPANION\n- The cat companion now unlocks when you clear the fourth course solo. If you already have, it is unlocked for you.\n\nVISUALS\n- Golf Volcano: the lava is brighter and reads as molten, with a hot orange-to-yellow glow.\n- Sunscar Canyon: recesses and overhangs that showed as solid black are now lit, and many pinhole gaps along the canyon walls are closed.\n\nSMOOTHER PLAY\n- Fewer one-off stutters the first time new areas appear, including the clubhouse and Lunar Links.\n- Faster, cleaner arrival at the clubhouse and courses, with less pop-in.\n- Lighter materials throughout the clubhouse and courses.\n\nSOUND\n- New creature contact sounds, and tidied interface sounds.\n\nOTHER\n- In-game notices now appear one at a time instead of stacking.", "created_date": 1795119390, "id": "29318629941136042", "version": "1.19", "version_code": 119, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29318627064469663"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Version 1.14\n\nRaptors, rebuilt\n- Raptors lock eyes on you when they charge, step and turn with real footwork, and lean into slopes.\n- New fight moves: sprints, circling, feints and pounces.\n- Plunger shots land exactly where you aim, and raptors react differently depending on where you hit them.\n- Raptors now roam their territory instead of waiting in one spot.\n\nHole-outs\n- Every cup has a stone-and-jade collar at the bottom of the bowl, so you can always see where the ball drops.\n- The celebration now bursts up from the cup itself, with sparkles running along the stone rim.\n- Fixed a black disc at the bottom of the Golf Mountain cup.\n\nJade Lantern Temple\n- The pagoda interior is brighter, with new lighting on the upper floor.\n\nMultiplayer\n- Everyone in a game needs version 1.14 to play together.", "created_date": 1793919493, "id": "29122350090764029", "version": "1.14", "version_code": 114, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29122345037431201"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Version 1.13: \n\nSTABILITY AND PERFORMANCE\n- Major work to reduce the mid-course freezes some players saw\n- Lower memory use on every course\n- Smoother frame rates, with less for the headset to draw on the busiest courses\n- Updated game engine and multiplayer networking\n\nCOURSES\n- Jade Lantern Temple: giant cherry trees, golden-hour lighting, Moon Pond, Moss Garden, a bell shrine, a larger pagoda and a rebuilt gorge waterfall\n- Crystal Cavern: rebuilt as a network of caves with soaring vaults, a worn stone causeway, deeper chasms with rivers and a miners' camp\n- Sunscar Canyon: redesigned crossings, an oasis finale, a petroglyph, a larger cliff dwelling and smoother canyon walls\n- Golf Volcano and Sunken Sanctuary: new scenery and art\n- Closed gaps and see-through spots, and sealed hairline cracks on every course\n- Rivers now run beneath the Canyon and Crystal Cavern bridges\n\nGAMEPLAY AND CONTROLS\n- New golf gloves on your hands, with natural poses on controllers\n- A new dimpled golf ball\n- Bridge gongs now face the path, so they are easier to spot\n- Plunger gun: redesigned trigger that squeezes with your finger\n- Seated players can now jump, and standing up in Seated mode offers to switch\n- The posture prompt appears sooner and is easier to answer\n- Cleaner teleport arc and wardrobe selection\n- Particle effects stay steady when you turn your head\n- Introduction: your ball can rest further off the course before it counts as rough", "created_date": 1793843316, "id": "29109294628736242", "version": "1.13", "version_code": 113, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29109288438736861"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793295508, "id": "29020448617620844", "version": "1.03", "version_code": 103, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29020442027621503"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
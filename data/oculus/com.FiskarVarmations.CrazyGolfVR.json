ent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628436_1760248491901162_3775620461819214231_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49Ksht76OvsQ7kNvwES_rWx&_nc_oc=Adr7NsSgrehmGE8nBzz-WEMkSDgjq8HDJvByGFkRMY5DMvQcEuAjfvEXbhPMvMC0dTA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjnttyd9YpMP458WWyHTOnmtL8mWzDahaZwIYBrh7OQw&oe=6AE3653F"}, {"file_name": "07-sanctuary-hole-approach.png", "id": "1405425701701319", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623551_1405425705034652_6058337297725769714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IU3Nm-EfZLQQ7kNvwHWuaHQ&_nc_oc=AdpdMB0RK_MWVApIr4dnUjwBFqbSlBMhTl5-8G7b_d928AE9rkHfGNZxvAXPHHgmAI8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNPY-oPUNjnZFDBF_HVreKvqLctFH2Dj6ei4-1lYlm_g&oe=6AE33BA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "2218453985746651", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593849888_2218453992413317_51539581911141801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wocdWS2xhJwQ7kNvwHhGd8y&_nc_oc=Ado6YW1vyZxxaXCLj74SJjGvETHQgqSGqGQwmjmH8AXJDC1tgHuDb3IjEVUBbCMaVkU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFKWDjAghuc4X5BXaZ0yXoSdmnZy77RMErBOBH0PD4Iw&oe=6AE35E24"}, "display_name": "Crazy Golf VR", "keywords": ["Golf", "Dinosaurs", "MiniGolf", "Multiplayer", "Coop"], "long_description": "Crazy Golf VR turns mini golf into an adventure. Every course is a race to the hole: take as many strokes as you like, dodge the dinosaurs and chase your fastest time.\n\n**Six wild courses**\n- Putt through woodland meadows, alpine slopes, red-rock canyons, a glowing crystal cavern, rivers of lava and a sunken sanctuary on the ocean floor.\n- Raptors prowl the fairways and pterodactyls circle overhead. Fend them off with a plunger gun, and ring bronze gongs to lower the drawbridges.\n- New to golf? A guided Introduction teaches you to swing, move and shoot.\n\n**Play together**\n- Co-op: two to four players share one ball and race the clock together.\n- 2v2 team race: one ball per team, and the first team to the hole wins.\n- Two clubhouses, a moonlit city rooftop and a sunrise lakeside valley, host up to six players with voice chat and driving ranges for long-drive contests.\n- Invite friends and join their games in a click.\n\n**Compete and collect**\n- World leaderboards for every course's fastest time and each range's longest drive.\n- 13 achievements, each unlocking a title for your name tag.\n- Pick your cap colour, and finish the campaign to unlock a cat companion.\n\n**Play your way**\n- Teleport or smooth movement, snap or smooth turning, a comfort vignette and a seated mode.", "short_description": "Mini golf meets a dinosaur adventure. Race to the hole across six wild courses, solo or with up to three friends, and keep the raptors at bay with your trusty plunger gun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.avivarma.ca/Crazy-Golf-VR/privacy.html", "developer_terms_of_service_url": "https://www.avivarma.ca/Crazy-Golf-VR/terms.html", "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.avivarma.ca/Crazy-Golf-VR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28769416466057395"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623876_2305225146941102_790130293989816875_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EuPj1RfH8I0Q7kNvwFZsjKl&_nc_oc=Adp_E4yqqCfcXXVdfdaa5OmVf_3yeSNiN9T7GdJG8rJS4-17PgcY775q-IkWU_Adclc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2uOU78MBhbS6lJsYsn8GSx7jy2TkNhPb3RzRIcdnnBw&oe=6AE34863"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crazy Golf VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1707942780, "lastRevision": {"nodes": [{"id": "7242557199169966", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7242557155836637", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "7100018800105874"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverArtPortrait.png", "id": "3495314790733443", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031587_3495314794066776_8316139556651851441_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FRZQ6cZj98Q7kNvwHgCih_&_nc_oc=AdrtlrZRm4dSU_1x5imP0FYOIml9c_UvReDjwHvZX51B5E74Gsu80u1lllb33dj5szY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZo58wkkqk02UtLkpclj8bVIhBR0DHs-7sjvPtR-uc8Q&oe=6AE345D2"}, {"file_name": "MiniLandscapeBackground.png", "id": "2116306672078035", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75593950_2116306675411368_8088691397984178912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQAuUg8a6cwQ7kNvwG39UR2&_nc_oc=AdrGuQuGBH8xa8ZCorNlaR_4lbc4QlwY27eF54yDvXV_NbWdC9xrE-LwJzxnLEu1iQk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhgb6n_9ncDgg7zjDFiRezIM2FXXSRaML85NiUxpwruQ&oe=6AE34F07"}, {"file_name": "CoverArtSquare.png", "id": "1923719118059999", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031456_1923719121393332_4504351395349498027_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeeMkXdgxNYQ7kNvwFveYg3&_nc_oc=Adop8eJouSZ-UN9y5DAvQoSeHVkGddDRl1TxxLDv84UqnnZPFQFs52jdAciKAaZWP8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDEI5SJvmYbCRfA3dX5rGiHSPqB7oqXrvQzvNSMUhQCw&oe=6AE34BA9"}, {"file_name": "Logo.png", "id": "1182902649359521", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86619816_1182902652692854_9031720951112319284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swHifJIVEEsQ7kNvwEknF5_&_nc_oc=Adoe9MOdKaejIdHO1TqokwMRuUcQgmfbGKJ10rRfZCXe9crRp8WJKflCN9Aon9jVudg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNd6Fa9tlfkn00E8AAchun0R2J7r-k_vPS8TSPRISq8PA&oe=6AE35DB4"}, {"file_name": "Icon.png", "id": "1037441694223645", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003252_1037441697556978_3475259315052248174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55Rwth3zTxEQ7kNvwGbSPbk&_nc_oc=AdrdrZEpbpFmlRjL6-3ribCh_hX8rvW9XPnXBaXhj1pJ3cx4qspJa4CKafL3VGGDgxE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbD30kORuWs-XJCKYOoklqGavt0EMlGP5ETamgBf2eGQ&oe=6AE36722"}, {"file_name": "CoverArtLandscape.png", "id": "927625695611298", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75361346_927625698944631_4861334867035495563_n.png?_nc_cat=108&ccb
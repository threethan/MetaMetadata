4Oy1vqogSZd7xtRipj1EqJWhrQXv3jAygVqHm0Mqx6mJg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwhDDdHUpPB1K1bKREdeenE6n8qb2UiIP5aXk0gWgPrg&oe=6AD2470E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1180299342948470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_1180299349615136_4212956715900943579_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qHhmH4-WzIQ7kNvwFqdV0_&_nc_oc=Adp9gjN_8b-Bd4y8GsAxl9026R69RmEhHUAIWo2AlmvLLPId1tfEGXpwUhoI_uMrpmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOuYMPUxqt2S3tuUYcPmqZUnEcShLcOvsLVrlG0oM43Q&oe=6AD241EC"}, "display_name": "Crazy Golf VR", "keywords": [], "long_description": "Welcome to the most jaw-dropping, tail-swinging golf experience ever! In Crazy Golf VR, you won\u2019t just be chasing birdies; you\u2019ll be dodging pterodactyls, putting through lava pits, and aiming for the elusive T-Rex hole-in-one. Get ready to swap your golf cart for a time-traveling golf pod and embark on a prehistoric adventure!", "short_description": "A fun golf game with crazy environments! \n\nMade for fun by Harshvardhan Varma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avivarmavr.artstation.com/pages/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.artstation.com/artwork/PXr3Qo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7242557179169968"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", "id": "4433475373542610"}, {"status": "PUBLISHED", "id": "1008031367839988"}, {"status": "PUBLISHED", "id": "308438845097830"}]}, "baseline_offer": {"id": "1008031367839988"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "4433475373542610"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8820460711379599", "version": "0.28"}, "id": "1438346520109192", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8820460711379599"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Crazy Golf VR 0.67 \u2014 everything since 0.60\n\nSmoother and sharper\n- Runs natively at up to 120 Hz on Quest 3 and 3S, with a sharper image.\n- Fewer first-time stutters as new areas and effects load.\n- Cleaner visuals across the courses: crisper ground around the ball, less flickering on overlapping surfaces, and less visible texture tiling at the volcano, cavern and canyon.\n- Trees and plants now sway in the wind.\n\nCreatures\n- Raptors now have health: it takes three plunger hits to drive one off, with hearts showing your progress.\n- New raptor combat animations, and raptor feet now plant firmly on the ground.\n- New raptor breeds: Crystal raptors in the Crystal Cavern, Alpine raptors in the mountains and Ember raptors at the volcano, each with their own idle behaviours.\n- Every course now has its own flying creature: the Crestwing, the Sailback, the Emberwing and the Geodewing.\n- Flying creatures lock on and swoop in more smoothly.\n- Defeated raptors now relax and go about their day instead of sulking.\n- Plungers stuck to raptors are easier to see.\n- A clearer impact and dazed recovery when a creature knocks you down.\n- Louder creature voices, and you can hear creatures coming.\n\nCourses\n- Sunken Sanctuary: ride the cliff tube, explore new column ruins and sink putts into carved reef and limestone cups.\n- Balls lost in rivers, creeks or the ocean now splash before returning.\n- The floating pause-menu course map shows lakes, rivers and the Sanctuary's seabed more faithfully.\n- Introduction: the awakening egg now glows gold.\n\nControls and comfort\n- Play with hand tracking or controllers. Set your controllers down to switch to hands.\n- Each hand keeps to its own tool: the club stays in your club hand and the plunger in the other.\n- Fall off a course and you return to where you last stood, not the start.\n- New Move Speed setting (2-6 m/s), with a slightly faster default.\n- Refreshed pause menu settings with easier sliders and page tabs.\n\nFeel and sound\n- Reworked haptics: subtler, crisper ball strikes, a gentle rolling feel and a distinct cue when your ball comes to rest.\n- Ball sounds now cut through the music, distant shots stay audible, and a perfectly struck shot has its own sound.\n- Music plays continuously and crossfades between tracks.\n\nAvatars and companions\n- Hats and visors fit avatars better.\n- The cat companion is bigger, walks more naturally and follows slopes properly.\n\nFixes\n- Fixed rocks on the mountain course that the ball could pass through.\n- Fixed the cat floating above hills.\n- Notifications no longer overlap the race display.", "created_date": 1791509108, "id": "28733088243023551", "version": "0.67", "version_code": 70, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28733084353023940"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8820460711379599"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "What's new in 0.60\n\n\u2022 Sunken Sanctuary rebuilt: hyper tubes through the reef, a cliff tube, swimming reef raptors and diving stingrays.\n\u2022 New raptors everywhere, plus desert raptors in Sunscar Canyon. Two hits stun, the third drives them off.\n\u2022 Multiplayer: a results board and vote between courses, rejoin after a crash, and host handover.\n\u2022 Hand tracking: pinch to teleport, fist to hold the club, thumb down for the plunger.\n\u2022 Clubhouse: wardrobe, 13 achievements with name-tag titles, world-rank leaderboards and a music player.\n\u2022 Seated mode and height evening so every player can reach the ball.\n\u2022 Golden egg, woven nest, clearer distant beacons, and a stray line in the sky fixed.\n\u2022 Smaller download (about 1.3 GB), smoother first loads and relit worlds.", "created_date": 1791222546, "id": "28687937047538671", "version": "0.60", "version_code": 60, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28687931024205940"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8820460711379599"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "This is the latest version of crazy golf VR! Featuring Multiplayer, Avatars, and a fundamental redesign of the game. ", "created_date": 1790104131, "id": "28524623747203336", "version": "0.36", "version_code": 36, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28524616973870680"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8820460711379599"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785266933, "id": "27807911285541256", "version": "0.32", "version_code": 32, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27807907032208348"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8820460711379599"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": null, "created_date": 1785244075, "id": "27804122585920126", "version": "0.31", "version_code": 31, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27804117559253962"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
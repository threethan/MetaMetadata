Y493UN_AIUMyILrx4Ve0peUVsc-iNwIL9rBDDFIhS2cTfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXQ0Kk3x7Pr_YVrSF3HERWsBj8_dyuaCURqqz5XMoNAg&oe=6AA5740E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1180299342948470", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982491_1180299349615136_4212956715900943579_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KryaKE5ujUQ7kNvwFd3FOG&_nc_oc=Adosyyr88OqeDoEnN5gRkYzO3DV311tDoLQ04Md1emkJZqpJx8OGQscnyheFMRa5dYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLFWmaOXrH7n3Uk9KK07lt3r2FJD3mhWfTJnLYgeaGLQ&oe=6AA56EEC"}, "display_name": "Crazy Golf VR", "keywords": [], "long_description": "Welcome to the most jaw-dropping, tail-swinging golf experience ever! In Crazy Golf VR, you won\u2019t just be chasing birdies; you\u2019ll be dodging pterodactyls, putting through lava pits, and aiming for the elusive T-Rex hole-in-one. Get ready to swap your golf cart for a time-traveling golf pod and embark on a prehistoric adventure!", "short_description": "A fun golf game with crazy environments! \n\nMade for fun by Harshvardhan Varma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avivarmavr.artstation.com/pages/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.artstation.com/artwork/PXr3Qo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
ers-raptor.png", "id": "1445954297670766", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620532_1445954301004099_4334922826542964934_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARVyPUW3pNMQ7kNvwF88SjL&_nc_oc=Adp-1cPvxb9xvKAmgR2YO6dl6EabPRCe5OeruYIehnnO_ceGQJ2gF0XzVPUL2FsFu_8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdnObI1OhaJObexsQ0l1c2BwlkXUaIuR5IA4NaU1iWww&oe=6AFB463C"}, {"file_name": "05-sanctuary-pearl-hole-pov.png", "id": "1024895080652578", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623585_1024895083985911_7527913330202176631_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHdo48Dlf8oQ7kNvwEW2lGg&_nc_oc=AdpAaZ7hyEyrJ3d1Jr50RtRj8O42fIuCy1dKdsnf_lys_G4my2QPggajqMg_aPZeweg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNm3WJhDrx1BwnEIcwnirzBdFgRb0FhBv7gvJBSpNwiQ&oe=6AFB3EEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1671715101338051", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623111_1671715104671384_5875727415432959553_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQE_9HkTEssQ7kNvwFfyCV3&_nc_oc=AdqGdKXuSOlD21fF0AYNo6D_17t-AZuACAUeP_H2BLNfczcTt3jc31qT4uCp_3XhLRQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRB_ExqPFIwIK7IUuCFTTOjCDLgXPBolubMkBUZnEI4Sw&oe=6AFB19F3"}, "display_name": "Crazy Golf VR", "keywords": ["Golf", "Dinosaurs", "MiniGolf", "Multiplayer", "Coop"], "long_description": "Crazy Golf VR turns mini golf into an adventure. Every course is a race to the hole: take as many strokes as you like, dodge the dinosaurs and chase your fastest time.\n\n**Six wild courses**\n- Putt through woodland meadows, alpine slopes, red-rock canyons, a glowing crystal cavern, rivers of lava and a sunken sanctuary on the ocean floor.\n- Raptors prowl the fairways and pterodactyls circle overhead. Fend them off with a plunger gun, and ring bronze gongs to lower the drawbridges.\n- New to golf? A guided Introduction teaches you to swing, move and shoot.\n\n**Play together**\n- Co-op: two to four players share one ball and race the clock together.\n- 2v2 team race: one ball per team, and the first team to the hole wins.\n- Two clubhouses, a moonlit city rooftop and a sunrise lakeside valley, host up to six players with voice chat and driving ranges for long-drive contests.\n- Invite friends and join their games in a click.\n\n**Compete and collect**\n- World leaderboards for every course's fastest time and each range's longest drive.\n- 13 achievements, each unlocking a title for your name tag.\n- Pick your cap colour, and finish the campaign to unlock a cat companion.\n\n**Play your way**\n- Teleport or smooth movement, snap or smooth turning, a comfort vignette and a seated mode.", "short_description": "Mini golf meets a dinosaur adventure. Race to the hole across six wild courses, solo or with up to three friends, and keep the raptors at bay with your trusty plunger gun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.avivarma.ca/Crazy-Golf-VR/privacy.html", "developer_terms_of_service_url": "https://www.avivarma.ca/Crazy-Golf-VR/terms.html", "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.avivarma.ca/Crazy-Golf-VR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKI
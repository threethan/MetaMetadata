2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP47Fmk9sHnjtU1ELcw0umlwQ-lNc7WuxttL6RIgmXUSA&oe=6AE3456C"}, {"file_name": "Screenshot6.png", "id": "776949421005778", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/65402154_776949424339111_676970916754398417_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1szuxSdUuOQQ7kNvwGRnZKB&_nc_oc=Adp1GqKcobWPADgTu5CFEVazZu4cfXW-9qWlVc0Xm_JDkjmDBoVaTaUoaSqTWQlsDJU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7fbFGmdud-yuwJdnT9L_mDyE3dG40zMqc1wRFxjIaAQ&oe=6AE342AC"}, {"file_name": "Screenshot4.png", "id": "1051867219381970", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974819_1051867222715303_1336008833305204054_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHXwxgCndesQ7kNvwFFUxa5&_nc_oc=Adp5dVVCLau1hO1f8Gcom_MWXHj_M8OJ5PTeLEKJCm5WbqxYkJrTDgnuJ5rBBVhWGL0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOxPZgld0Rt2mQf5fp4CAqu1mac444pFC01AuSZpU__g&oe=6AE36A8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1180299342948470", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982491_1180299349615136_4212956715900943579_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wcEIMzdKaoQ7kNvwFDVFI6&_nc_oc=AdpViMfnnyuOZZnK8UCGBPI-SBZ_84uGEUaivxGTr_0zlkv_OPnBjEKRdR4kUib-DfM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGpjVI-MEI_wy0pkh9pQCrD1Zw_Rv5Y9biD6PQrc_MQw&oe=6AE3656C"}, "display_name": "Crazy Golf VR", "keywords": [], "long_description": "Welcome to the most jaw-dropping, tail-swinging golf experience ever! In Crazy Golf VR, you won\u2019t just be chasing birdies; you\u2019ll be dodging pterodactyls, putting through lava pits, and aiming for the elusive T-Rex hole-in-one. Get ready to swap your golf cart for a time-traveling golf pod and embark on a prehistoric adventure!", "short_description": "A fun golf game with crazy environments! \n\nMade for fun by Harshvardhan Varma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avivarmavr.artstation.com/pages/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.artstation.com/artwork/PXr3Qo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7242557179169968"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4433475373542610"}, {"status": "PUBLISHED", "id": "1008031367839988"}, {"status": "PUBLISHED", "id": "308438845097830"}]}, "baseline_offer": {"id": "4433475373542610"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792170000, "status": "PUBLISHED", "id": "4433475373542610"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28938685685797138", "version": "0.94"}, "id": "1438346520109192", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Crazy Golf VR \u2014 v0.94\n\nThe Jade Lantern Temple, rebuilt\n\nThe Five-Storey Pagoda is now twice the size, and you can go inside. Explore the hall, climb the stairs to the second floor and step out onto the balcony.\nA new Moss Garden fills the bend with a stroll garden: a large arched red bridge, stepping stones across the lawn, and a stone waterfall spilling into the pond.\nThe Moon Pond now has gentle lawn banks down to the water and a wider zig-zag bridge you can actually walk.\nRing the temple bell. Past the final hole, grab the striking log, pull it back and swing it into the bronze bell. Everyone in your group hears it.\nNew cherry trees, with rooted trunks and fuller blossom. Hit a ball through the crowns and you\u2019ll hear the leaves.\nA new garden of red Japanese maples, flowering azaleas, bamboo, ferns, irises and moss across the course.\nWaterfalls now catch the sunset light, with foam and mist where they land.\nTaller temple walls, and the ground now meets the path smoothly everywhere, so no more stepping off hidden ledges.\nFixed flickering surfaces on temple decks, gates and lanterns.\n\nOther courses\n\nVolcano: a new summit, carved portals, smoke plumes, new scenic lookouts and retuned encounters.\nSunken Sanctuary: new tube entrances and a cliff lookout, and the tubes now pull in slow-rolling balls.\n\nGameplay\n\nA shared celebration when your team sinks the ball, and a clearer recovery effect when the ball resets.\nThe race HUD shows which leg of the course you\u2019re on.\nPar and target times retuned from real clears; the solo clock pauses while the menu is open.\nA ball that drops back onto an earlier part of the course now recovers properly.\nPteranodons plan their dives better, keep away from your head, and tumble away when knocked out.\nImproved seated-play prompts, and a vignette when your head moves into a wall.\n\nFixes\n\nFixed a crash when leaving a course.\nA loading card now covers arriving in a session.\nThe Introduction can be replayed without freezes.", "created_date": 1792779200, "id": "28938685685797138", "version": "0.94", "version_code": 94, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28938679022464471"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": null, "created_date": 1792423926, "id": "28881228868209487", "version": "0.87", "version_code": 87, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28881221251543582"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": null, "created_date": 1792170253, "id": "28842436362088738", "version": "0.86", "version_code": 86, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28842429288756112"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": null, "created_date": 1791841355, "id": "28786673484331693", "version": "0.78", "version_code": 78, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28786668074332234"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28938685685797138"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Crazy Golf VR 0.67 \u2014 everything since 0.60\n\nSmoother and sharper\n- Runs natively at up to 120 Hz on Quest 3 and 3S, with a sharper image.\n- Fewer first-time stutters as new areas and effects load.\n- Cleaner visuals across the courses: crisper ground around the ball, less flickering on overlapping surfaces, and less visible texture tiling at the volcano, cavern and canyon.\n- Trees and plants now sway in the wind.\n\nCreatures\n- Raptors now have health: it takes three plunger hits to drive one off, with hearts showing your progress.\n- New raptor combat animations, and raptor feet now plant firmly on the ground.\n- New raptor breeds: Crystal raptors in the Crystal Cavern, Alpine raptors in the mountains and Ember raptors at the volcano, each with their own idle behaviours.\n- Every course now has its own flying creature: the Crestwing, the Sailback, the Emberwing and the Geodewing.\n- Flying creatures lock on and swoop in more smoothly.\n- Defeated raptors now relax and go about their day instead of sulking.\n- Plungers stuck to raptors are easier to see.\n- A clearer impact and dazed recovery when a creature knocks you down.\n- Louder creature voices, and you can hear creatures coming.\n\nCourses\n- Sunken Sanctuary: ride the cliff tube, explore new column ruins and sink putts into carved reef and limestone cups.\n- Balls lost in rivers, creeks or the ocean now splash before returning.\n- The floating pause-menu course map shows lakes, rivers and the Sanctuary's seabed more faithfully.\n- Introduction: the awakening egg now glows gold.\n\nControls and comfort\n- Play with hand tracking or controllers. Set your controllers down to switch to hands.\n- Each hand keeps to its own tool: the club stays in your club hand and the plunger in the other.\n- Fall off a course and you return to where you last stood, not the start.\n- New Move Speed setting (2-6 m/s), with a slightly faster default.\n- Refreshed pause menu settings with easier sliders and page tabs.\n\nFeel and sound\n- Reworked haptics: subtler, crisper ball strikes, a gentle rolling feel and a distinct cue when your ball comes to rest.\n- Ball sounds now cut through the music, distant shots stay audible, and a perfectly struck shot has its own sound.\n- Music plays continuously and crossfades between tracks.\n\nAvatars and companions\n- Hats and visors fit avatars better.\n- The cat companion is bigger, walks more naturally and follows slopes properly.\n\nFixes\n- Fixed rocks on the mountain course that the ball could pass through.\n- Fixed the cat floating above hills.\n- Notifications no longer overlap the race display.", "created_date": 1791509108, "id": "28733088243023551", "version": "0.67", "version_code": 70, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28733084353023940"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
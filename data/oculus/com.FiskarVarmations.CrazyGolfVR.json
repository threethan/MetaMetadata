ent-ord5-1.oculuscdn.com/v/t64.5771-25/499628436_1760248491901162_3775620461819214231_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R_lKOOBlj0Q7kNvwFj1PKf&_nc_oc=AdoR6yamsK-YNzr_u8dkkWSawy4nTcX0i8_eTbmJmV19ibhJx6w9safvlu0D7vDopcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjSiM9WbVuA8KVKwabgOKn0A8117cH6RcD4FajMqPq-A&oe=6ADF70BF"}, {"file_name": "07-sanctuary-hole-approach.png", "id": "1405425701701319", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623551_1405425705034652_6058337297725769714_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1SchtfCINgQ7kNvwGd7H29&_nc_oc=AdqSDpcVbNOPRsXc8zXzNJiSOs2oUK45hpg6F2POB6mHZ1QBpfUpFHkJSHERYD0uAHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMETGp0w1mmKW90bcUyCerTmC0Q_GNTF8MQjYyCe4lQQQ&oe=6ADF4722"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "2218453985746651", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593849888_2218453992413317_51539581911141801_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5nLfKIJILgQ7kNvwEEx7Dq&_nc_oc=AdoLRbx5cqjPl2BscAUBAaSHg_Fc5r64E3UCDpGw1FIXdVpLOM7KuYDoGDXgxqZ4D58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV-z2_yWQC32SG1Av14ycpuEuPbFuZQc3G7mm1pJnqpA&oe=6ADF69A4"}, "display_name": "Crazy Golf VR", "keywords": ["Golf", "Dinosaurs", "MiniGolf", "Multiplayer", "Coop"], "long_description": "Crazy Golf VR turns mini golf into an adventure. Every course is a race to the hole: take as many strokes as you like, dodge the dinosaurs and chase your fastest time.\n\n**Six wild courses**\n- Putt through woodland meadows, alpine slopes, red-rock canyons, a glowing crystal cavern, rivers of lava and a sunken sanctuary on the ocean floor.\n- Raptors prowl the fairways and pterodactyls circle overhead. Fend them off with a plunger gun, and ring bronze gongs to lower the drawbridges.\n- New to golf? A guided Introduction teaches you to swing, move and shoot.\n\n**Play together**\n- Co-op: two to four players share one ball and race the clock together.\n- 2v2 team race: one ball per team, and the first team to the hole wins.\n- Two clubhouses, a moonlit city rooftop and a sunrise lakeside valley, host up to six players with voice chat and driving ranges for long-drive contests.\n- Invite friends and join their games in a click.\n\n**Compete and collect**\n- World leaderboards for every course's fastest time and each range's longest drive.\n- 13 achievements, each unlocking a title for your name tag.\n- Pick your cap colour, and finish the campaign to unlock a cat companion.\n\n**Play your way**\n- Teleport or smooth movement, snap or smooth turning, a comfort vignette and a seated mode.", "short_description": "Mini golf meets a dinosaur adventure. Race to the hole across six wild courses, solo or with up to three friends, and keep the raptors at bay with your trusty plunger gun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.avivarma.ca/Crazy-Golf-VR/privacy.html", "developer_terms_of_service_url": "https://www.avivarma.ca/Crazy-Golf-VR/terms.html", "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.avivarma.ca/Crazy-Golf-VR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": 
jBJu8BY6_TtVMTZF29_mGSa5fAdZ7EG1hIsqxeuC285oPQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPBiLm7J_xFldYqLTMhb-ksJdDuSWUar5WLRm7qwEOPw&oe=6A9023CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1180299342948470", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982491_1180299349615136_4212956715900943579_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dkqycu-wnnsQ7kNvwE3o2NL&_nc_oc=AdrFqoe39WX-6GnCrV2xNr3FdaCqhYCSvbCvIpDc8tHzqaz0KpDEJpX9nbWpHAyQwTU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqA7TTgqwQ-kNgmIv1b41gtzZcYOP3LVwb9vsOA3Fqjg&oe=6A901EAC"}, "display_name": "Crazy Golf VR", "keywords": [], "long_description": "Welcome to the most jaw-dropping, tail-swinging golf experience ever! In Crazy Golf VR, you won\u2019t just be chasing birdies; you\u2019ll be dodging pterodactyls, putting through lava pits, and aiming for the elusive T-Rex hole-in-one. Get ready to swap your golf cart for a time-traveling golf pod and embark on a prehistoric adventure!", "short_description": "A fun golf game with crazy environments! \n\nMade for fun by Harshvardhan Varma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avivarmavr.artstation.com/pages/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.artstation.com/artwork/PXr3Qo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
k2U2bXMbX513i9tPGtmZEsU6pPh5Plw0izj8kohRe2bzfqoLweGwVz-tH8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48OXfKxDaSwXpIJ9aXpujxUXwHfTDzZ7RdILCMs6gJYA&oe=6A11CC0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1180299342948470", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982491_1180299349615136_4212956715900943579_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNAPUIvp9DoQ7kNvwGDuTz8&_nc_oc=AdrIZNMRBpP5s9FCXiodEF2r3Xrb3Q-2Ndq8TxCMlMh-2HWGOEJYleBK46tDaOWKoMg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UJhejOnzXXQSDqukIJdc0IK8Eg-vClnFUebOHo6_-ow&oe=6A11C6EC"}, "display_name": "Crazy Golf VR", "keywords": [], "long_description": "Welcome to the most jaw-dropping, tail-swinging golf experience ever! In Crazy Golf VR, you won\u2019t just be chasing birdies; you\u2019ll be dodging pterodactyls, putting through lava pits, and aiming for the elusive T-Rex hole-in-one. Get ready to swap your golf cart for a time-traveling golf pod and embark on a prehistoric adventure!", "short_description": "A fun golf game with crazy environments! \n\nMade for fun by Harshvardhan Varma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avivarmavr.artstation.com/pages/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.artstation.com/artwork/PXr3Qo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7242557179169968"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1008031367839988"}, {"status": "PUBLISHED", "id": "308438845097830"}]}, "baseline_offer": {"id": "1008031367839988"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740808740, "status": "PUBLISHED", "id": "1008031367839988"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8820460711379599", "version": "0.28"}, "id": "1438346520109192", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8820460711379599"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779051568, "id": "26958569183808808", "version": "0.30", "version_code": 30, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26958565393809187"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8820460711379599"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Hey guys, I saw some of the feedback and decided to update the application. I fixed some of the sounds to be a bit gentler on the ears & created the \"holstering\" mechan
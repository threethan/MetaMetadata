.oculuscdn.com/v/t64.5771-25/75593950_2116306675411368_8088691397984178912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqWMdKW2NO8Q7kNvwFZrpx4&_nc_oc=AdoZLBaO1JNckSlFglojL46hQjpk9Dz1L7sKi0EbCIcgQvmRzIpZAsAPpP6HpWIGXsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME2aI1GNR-pmkUfyp4J6_eKxkhvRGOwGM1PJTajkfZPw&oe=6ADE0907"}, {"file_name": "CoverArtSquare.png", "id": "1923719118059999", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031456_1923719121393332_4504351395349498027_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoUOBlRxaBIQ7kNvwGM9z-P&_nc_oc=AdryM7pvfc18xR_QHqHq4e0zHBRS1uoMQqFcOf2Bu5esBEM7jo-G5Rwfiuf9RhdBHEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMutjc5jxVch4XOWPq3dVu2u9ZDjA72bZIMIFoypee66Q&oe=6ADE05A9"}, {"file_name": "Logo.png", "id": "1182902649359521", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86619816_1182902652692854_9031720951112319284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJDgcQO7IPoQ7kNvwFOQkCh&_nc_oc=Adp884Kv2DXSk0Hg5Va_erpqrl1k1hcQLPTYcbULvf8e1n7JZkdFKGNvEdnfHtMVsYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1nwPcrSeLndjbbORee_uW8lLNQT10qEtqdTsiHHCNAQ&oe=6ADE17B4"}, {"file_name": "Icon.png", "id": "1037441694223645", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003252_1037441697556978_3475259315052248174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkrAk0G08GsQ7kNvwGsIWaV&_nc_oc=Adr9QGlqlr0NGlZklaVfBU9EaKxSHswvav0cXgAr_1lGSU1X-a8vc4bGPHSDeRtJb-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwnlo_iQSLD1uSeYPvPQV4-czUj4ebnfCOmoo9NCu-DA&oe=6ADE2122"}, {"file_name": "CoverArtLandscape.png", "id": "927625695611298", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361346_927625698944631_4861334867035495563_n.png?_nc_cat=108&ccb
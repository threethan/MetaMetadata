.oculuscdn.com/v/t64.5771-25/75593950_2116306675411368_8088691397984178912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqWMdKW2NO8Q7kNvwEw8Hx5&_nc_oc=AdqatzKZ6iEl7ncytbzGridbLTL5JhuxLUcAe4wALzJ-mLUzSTnjcP6ULpcyXBlCDTo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGXmZJroKQUu2pYWMEiT6VXy12e6Wy8ns1k2EoyyUoeg&oe=6ADF5A87"}, {"file_name": "CoverArtSquare.png", "id": "1923719118059999", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031456_1923719121393332_4504351395349498027_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoUOBlRxaBIQ7kNvwFn4ub8&_nc_oc=AdrRKWbgwSPJmiSL_jxe9xNqdXTMncvEXQjPH8-f2jolCkzd8vL_otlzTmAsoxuJq-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHGWptfX64BhX3XO1lxHlxJdpv7COcF0uj-dOkZWQCxw&oe=6ADF5729"}, {"file_name": "Logo.png", "id": "1182902649359521", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86619816_1182902652692854_9031720951112319284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeUSXYQPd3sQ7kNvwHwpsZI&_nc_oc=Adqktxg6oxqtO0msdQgLQWy8j7nnmsTlAtpEqg0tYCaoiN_kKaZJI4QZdSQ_M4N071o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3FPXYYpGWhUFAhsZqhX7Q_Fc2GOYiY18njo2sWFaAHA&oe=6ADF6934"}, {"file_name": "Icon.png", "id": "1037441694223645", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003252_1037441697556978_3475259315052248174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkrAk0G08GsQ7kNvwHNLVr5&_nc_oc=Adp3jL8RUrC5t_-pzVXlDHsk_Q44C_0epMtCAB4uawwUQN38oxOPeoQ2q2xc92nfyEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4Gk4nGXk7a22OX53IZ2v984-wTG1L-I_z2B3w7BFn9Q&oe=6ADF72A2"}, {"file_name": "CoverArtLandscape.png", "id": "927625695611298", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75361346_927625698944631_4861334867035495563_n.png?_nc_cat=108&ccb
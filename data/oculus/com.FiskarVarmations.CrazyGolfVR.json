cYPOvRbQU3zohBFL9JSlRsgt8V4tShlMQd5rvvEbnLh-mTPocyZr4lrp6E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg01AFp5ikwLavkPbMvaWxHm9qTqeIMH_HbPy_ro4QrQ&oe=6AF34CEC"}, {"file_name": "Screenshot4.png", "id": "1051867219381970", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974819_1051867222715303_1336008833305204054_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy0sI6tPKwMQ7kNvwH7QbR1&_nc_oc=AdoYxY7WsI54cUV5N9d5iLQklNhW_MgBgkx8mYK_1QPjqo3d-Qid_8CoSd6QwFQ8PGM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_0ujZTjBiGeMh5fMSDmhDOK3jGrKQFEmgXP7syzVYLg&oe=6AF33C8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1180299342948470", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982491_1180299349615136_4212956715900943579_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujLZOGsngVAQ7kNvwGOKKGG&_nc_oc=Ado05ip6F2byq3U91I7t0LgOZr3KHyopT79ywYgbddY8mQQCbpRh4Z3Pipjn1LezSdI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNEtkuhS0eHkUIZqDB6sP4B5uwokhCX8PXRkxoB0R6jQ&oe=6AF3376C"}, "display_name": "Crazy Golf VR", "keywords": [], "long_description": "Welcome to the most jaw-dropping, tail-swinging golf experience ever! In Crazy Golf VR, you won\u2019t just be chasing birdies; you\u2019ll be dodging pterodactyls, putting through lava pits, and aiming for the elusive T-Rex hole-in-one. Get ready to swap your golf cart for a time-traveling golf pod and embark on a prehistoric adventure!", "short_description": "A fun golf game with crazy environments! \n\nMade for fun by Harshvardhan Varma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avivarmavr.artstation.com/pages/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.artstation.com/artwork/PXr3Qo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7242557179169968"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4433475373542610"}, {"status": "PUBLISHED", "id": "1008031367839988"}, {"status": "PUBLISHED", "id": "308438845097830"}]}, "baseline_offer": {"id": "4433475373542610"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792170000, "status": "PUBLISHED", "id": "4433475373542610"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29122350090764029", "version": "1.14"}, "id": "1438346520109192", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122350090764029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Version 1.14\n\nRaptors, rebuilt\n- Raptors lock eyes on you when they charge, step and turn with real footwork, and lean into slopes.\n- New fight moves: sprints, circling, feints and pounces.\n- Plunger shots land exactly where you aim, and raptors react differently depending on where you hit them.\n- Raptors now roam their territory instead of waiting in one spot.\n\nHole-outs\n- Every cup has a stone-and-jade collar at the bottom of the bowl, so you can always see where the ball drops.\n- The celebration now bursts up from the cup itself, with sparkles running along the stone rim.\n- Fixed a black disc at the bottom of the Golf Mountain cup.\n\nJade Lantern Temple\n- The pagoda interior is brighter, with new lighting on the upper floor.\n\nMultiplayer\n- Everyone in a game needs version 1.14 to play together.", "created_date": 1793919493, "id": "29122350090764029", "version": "1.14", "version_code": 114, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29122345037431201"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122350090764029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Version 1.13: \n\nSTABILITY AND PERFORMANCE\n- Major work to reduce the mid-course freezes some players saw\n- Lower memory use on every course\n- Smoother frame rates, with less for the headset to draw on the busiest courses\n- Updated game engine and multiplayer networking\n\nCOURSES\n- Jade Lantern Temple: giant cherry trees, golden-hour lighting, Moon Pond, Moss Garden, a bell shrine, a larger pagoda and a rebuilt gorge waterfall\n- Crystal Cavern: rebuilt as a network of caves with soaring vaults, a worn stone causeway, deeper chasms with rivers and a miners' camp\n- Sunscar Canyon: redesigned crossings, an oasis finale, a petroglyph, a larger cliff dwelling and smoother canyon walls\n- Golf Volcano and Sunken Sanctuary: new scenery and art\n- Closed gaps and see-through spots, and sealed hairline cracks on every course\n- Rivers now run beneath the Canyon and Crystal Cavern bridges\n\nGAMEPLAY AND CONTROLS\n- New golf gloves on your hands, with natural poses on controllers\n- A new dimpled golf ball\n- Bridge gongs now face the path, so they are easier to spot\n- Plunger gun: redesigned trigger that squeezes with your finger\n- Seated players can now jump, and standing up in Seated mode offers to switch\n- The posture prompt appears sooner and is easier to answer\n- Cleaner teleport arc and wardrobe selection\n- Particle effects stay steady when you turn your head\n- Introduction: your ball can rest further off the course before it counts as rough", "created_date": 1793843316, "id": "29109294628736242", "version": "1.13", "version_code": 113, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29109288438736861"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122350090764029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793295508, "id": "29020448617620844", "version": "1.03", "version_code": 103, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29020442027621503"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122350090764029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793195398, "id": "29002971959368510", "version": "0.98", "version_code": 98, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29002964932702546"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29122350090764029"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": null, "created_date": 1793073042, "id": "28983460027986370", "version": "0.95", "version_code": 95, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28983451951320511"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
.oculuscdn.com/v/t64.5771-25/75593950_2116306675411368_8088691397984178912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQAuUg8a6cwQ7kNvwHcZgBV&_nc_oc=AdodQJ5GM2L9_tML1X4ohwlEO3onTnnyFVCuCc78_GXd6o9GxtqMBmzZlNJOteE9aic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6QxVGRXT7qtEQgEDYaV8N5ZbRogrwSmFoO83ByQgwwQ&oe=6AE0AC07"}, {"file_name": "CoverArtSquare.png", "id": "1923719118059999", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031456_1923719121393332_4504351395349498027_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoUOBlRxaBIQ7kNvwEb6GEe&_nc_oc=AdqtnojgxLVaD9V48mD2xYeScSQoDeSjRdc4mLmRlhP5y32m3thBdSXjCYcJEI2jVNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXKGuqBcgrNQ1S8BNe14kxhIAnKFPU_5hYI__nfPhdlQ&oe=6AE0A8A9"}, {"file_name": "Logo.png", "id": "1182902649359521", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86619816_1182902652692854_9031720951112319284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeUSXYQPd3sQ7kNvwHBK6I_&_nc_oc=AdqBmcwq-S6wxyeEs7I3Vs1bSul28vLgEkRUOOz-4GtRlzm5gvq-j-5QL7QpeVQc6jo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiNLxgsxnE5mXYdkFGfQ5mccgvYsHD6zAcHWhDIqMe-A&oe=6AE0BAB4"}, {"file_name": "Icon.png", "id": "1037441694223645", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003252_1037441697556978_3475259315052248174_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkrAk0G08GsQ7kNvwHxooNp&_nc_oc=Adrhy2BY1fTn-EX88jifI_sB1QfpnBdntFPqLAD9g1peHZ7IT0Phm6Pc0l-a3OPHBwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBK26OXOFzmaMTN2G1oX4-WczKRC6gFiNna0iex6I4sQ&oe=6AE0C422"}, {"file_name": "CoverArtLandscape.png", "id": "927625695611298", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361346_927625698944631_4861334867035495563_n.png?_nc_cat=108&ccb
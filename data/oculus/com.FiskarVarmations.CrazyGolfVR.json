ers-raptor.png", "id": "1445954297670766", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499620532_1445954301004099_4334922826542964934_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-hG33Uhl2UQ7kNvwHiQzQn&_nc_oc=Adq3VBcWv4UyqxkUcw2YCInhhmmEqPf8FKe9uuY0D_QBvuN8JRFgxbb7lzZY4tr2aXQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpKpXE36yjizWTeEiKguDOti3oLn4-qOwqj11oy04kyg&oe=6B083CFC"}, {"file_name": "05-sanctuary-pearl-hole-pov.png", "id": "1024895080652578", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499623585_1024895083985911_7527913330202176631_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y0NRmA6UYwQ7kNvwERuQYf&_nc_oc=AdqH_2ER_zOOf9hCUp1zGm3g-BEaZiTR5gKnyudPI3nc0S9j7kUZLhQ1cqgMmfa599A&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6nsVAz1m0Q70-CQxsP9gXasigk5slBcbn0PG8A5LhwQ&oe=6B086DEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1671715101338051", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623111_1671715104671384_5875727415432959553_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOgvcbwELSIQ7kNvwHV2Iqk&_nc_oc=AdoQ_geh_QZU99GLlHuO5TwThowV_y4lu-qXWTDDFAmepoabscIgQVQDl-p8SXd_Hj0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr7TA_CUjUQCTrOhbt3sWqYPIM7VoK_wXDDV8D07n4dw&oe=6B0848F3"}, "display_name": "Crazy Golf VR", "keywords": ["Golf", "Dinosaurs", "MiniGolf", "Multiplayer", "Coop"], "long_description": "Crazy Golf VR turns mini golf into an adventure. Every course is a race to the hole: take as many strokes as you like, dodge the dinosaurs and chase your fastest time.\n\n**Six wild courses**\n- Putt through woodland meadows, alpine slopes, red-rock canyons, a glowing crystal cavern, rivers of lava and a sunken sanctuary on the ocean floor.\n- Raptors prowl the fairways and pterodactyls circle overhead. Fend them off with a plunger gun, and ring bronze gongs to lower the drawbridges.\n- New to golf? A guided Introduction teaches you to swing, move and shoot.\n\n**Play together**\n- Co-op: two to four players share one ball and race the clock together.\n- 2v2 team race: one ball per team, and the first team to the hole wins.\n- Two clubhouses, a moonlit city rooftop and a sunrise lakeside valley, host up to six players with voice chat and driving ranges for long-drive contests.\n- Invite friends and join their games in a click.\n\n**Compete and collect**\n- World leaderboards for every course's fastest time and each range's longest drive.\n- 13 achievements, each unlocking a title for your name tag.\n- Pick your cap colour, and finish the campaign to unlock a cat companion.\n\n**Play your way**\n- Teleport or smooth movement, snap or smooth turning, a comfort vignette and a seated mode.", "short_description": "Mini golf meets a dinosaur adventure. Race to the hole across six wild courses, solo or with up to three friends, and keep the raptors at bay with your trusty plunger gun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.avivarma.ca/Crazy-Golf-VR/privacy.html", "developer_terms_of_service_url": "https://www.avivarma.ca/Crazy-Golf-VR/terms.html", "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.avivarma.ca/Crazy-Golf-VR/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "2776542286000603"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28857110523954655"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624990_2180131322928189_3959385310701763709_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-ZSW5xW8eoQ7kNvwGsGQJz&_nc_oc=AdpSD8ctRBFbAsO1JJlLijIAnyETyb2GUzwaU4vbHaHAVlbi91q31WVktxW-FvY2Hrk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCAdpJOppN_f9kOLobklJV4c6K1aGLgINlftTQaKpAjA&oe=6B084D54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Crazy Golf VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1707942780, "lastRevision": {"nodes": [{"id": "7242557199169966", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7242557155836637", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "7100018800105874"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverArtPortrait.png", "id": "3495314790733443", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031587_3495314794066776_8316139556651851441_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXE1HtOCMHcQ7kNvwF9IKC1&_nc_oc=AdoHwoUzk02xgQJunabXAENrORLevhhcaJwGa0xaJwIgKfHthElrbTgoGFjZjxtVGY8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsBVR6vsd6JI5mNTeQ6qW-qxQzy3CY73lM6lXRb0vppg&oe=6B086812"}, {"file_name": "MiniLandscapeBackground.png", "id": "2116306672078035", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75593950_2116306675411368_8088691397984178912_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dL1z4t49uUQ7kNvwF_q25s&_nc_oc=AdrEvrxoUGJyhs72JGSFs4zZLQahK6n3SlO18r5Ut676ugoItI-hp7hC2WV3EJPunE8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZQSuwQEHBSBGgf2-sDEMRqCQx0KN2PM7Z5GxIfYk42Q&oe=6B087147"}, {"file_name": "CoverArtSquare.png", "id": "1923719118059999", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031456_1923719121393332_4504351395349498027_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2ecdgUVixMQ7kNvwEMfRoq&_nc_oc=AdpNrGAYyAw1_W0nRq0Edsmc7Ky2xzcqgFLr4cpvpyVFFXdc1zipkghnkkIYZS7sKxw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGdb8zboXrayPKvZ1dzgc0mY7BLErNZzBcoNz6hUq77Q&oe=6B086DE9"}, {"file_name": "Logo.png", "id": "1182902649359521", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86619816_1182902652692854_9031720951112319284_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_4dVr3n5fkQ7kNvwHlrgLe&_nc_oc=AdotrZsIYk0zAoEBikLiJFiPlwyz3e_ws8LR68ubwMFuDJjrwM1HSQaeNPLSq_2aZ6g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlN6LQoYqCDesjfoMTUg2zoT_FleT1Z3PWgsMkc9CYdg&oe=6B0847B4"}, {"file_name": "Icon.png", "id": "1037441694223645", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003252_1037441697556978_3475259315052248174_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLvB-w1hZ38Q7kNvwEIFsaB&_nc_oc=Adq-jCDBHXxUBaY6Q9DuO2jaHM9FyQQp5SaIy45P-NtKpnPNkLAk3iTeIM3pS1bJ-ic&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSntKIhiJD_tVPpLXUSg3hAFd8lPPZkADEiPX7obzVQA&oe=6B085122"}, {"file_name": "CoverArtLandscape.png", "id": "927625695611298", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75361346_927625698944631_4861334867035495563_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAMUM1kEewQQ7kNvwHPzBC6&_nc_oc=AdqhRPpNpJdOfNMxkB2HchNgSr-fqWlAGbJ0cNQNKLH-hX15s9PqbsZ1cHdINCbxEmo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLm38XkLjL1IxgQVrnZg8du9cGVKgHrSAxjSRf4lofjg&oe=6B085A17"}, {"file_name": "HeroCover.png", "id": "225984143843777", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982460_225984147177110_482557685155359975_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXwBf3O9-q8Q7kNvwHG57Ji&_nc_oc=AdoNBxMkbCdV2hc-fa5aZ7FnhHo3UF89pbpmN-2Rl1uvA9536hbqkACNWdPf5T2VA3I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM3M2CtYSM24AWSmZsVszgiZpGnsIS5NGOs1guAlxrKA&oe=6B08656C"}]}, "id": "801624848432451", "locale": "en_US", "screenshots": [{"file_name": "Screenshot3.png", "id": "7176409862448731", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75286676_7176409865782064_3152612281375049195_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6WyTfBQGiUQ7kNvwGEWKA0&_nc_oc=AdpAuGHwxbd99JDeIh-vEGSald1IZptiHPLznB6BWocR_tHy-xep8pKLDn8kkJvejLQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBMJZ7BzvWJBwzk7NZU0Q9SVicmMMHM-ZiULWIv3DELQ&oe=6B0852BD"}, {"file_name": "Screenshot2.png", "id": "404281905443729", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/57572950_404281908777062_8427973265631679341_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBK70qPfLDIQ7kNvwEE2XFo&_nc_oc=AdrvSW3ND4enmzkODHG3Z-OcUw_cBEinKZLg82Own0Jpo8YQ5PjFH43PhkLEec4KX2A&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLufArfTzAzIGljXxT_Z35FnprV77YPIBdjc3_buO3mw&oe=6B085864"}, {"file_name": "Screenshot1.png", "id": "351439054482587", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035400_351439064482586_7709402978214007870_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_ekNnfD2b8Q7kNvwEiTio3&_nc_oc=Ado_rEjwcBK3qEfGp_-ugpvasRdC9aLaWemAZIFFTuRUgzcyWfVTBgcO3M1ZYHA9qu4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPi5-RYxs04X9ML44gIroup_i3GeBfAOwprGE2vYkF1w&oe=6B0867AC"}, {"file_name": "Screenshot6.png", "id": "776949421005778", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/65402154_776949424339111_676970916754398417_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uma00pX2EP8Q7kNvwGRl_aK&_nc_oc=AdrkUe-NwpgRgPe9AMknK6h38tDbchsJSQLeHjWjyMFC-uRYmCzwVvSmFYslaMGjcdc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRKgDiyU3GfI9bxHT7u1fCDe6t3s1CslIYBtlft-J7ow&oe=6B0864EC"}, {"file_name": "Screenshot4.png", "id": "1051867219381970", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974819_1051867222715303_1336008833305204054_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IoJjVMdv7IQ7kNvwGAa0Jo&_nc_oc=AdqBG9Rnm6PJClmc6BAYpP8i_ZHQ2upBEuxsqj7lu4e9bP1CrvBAYnS81esoxkakb44&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN6ZjfK9zJUKAU7oE1G8u6BqVkHSb-828WvvmS8sSk2g&oe=6B08548E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1180299342948470", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982491_1180299349615136_4212956715900943579_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LLwr_aOwMIQ7kNvwEW4baL&_nc_oc=Adovb_HnUrGlylXyNtex_HiuVhAKnHN36kL9-YtZCmJ-DIjXHqo2PZ08lOfLRXaZ5u8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc9pR8RhgOB7AJx_eYlMAUvPXCJr4uzIzstnwDatgAFw&oe=6B084F6C"}, "display_name": "Crazy Golf VR", "keywords": [], "long_description": "Welcome to the most jaw-dropping, tail-swinging golf experience ever! In Crazy Golf VR, you won\u2019t just be chasing birdies; you\u2019ll be dodging pterodactyls, putting through lava pits, and aiming for the elusive T-Rex hole-in-one. Get ready to swap your golf cart for a time-traveling golf pod and embark on a prehistoric adventure!", "short_description": "A fun golf game with crazy environments! \n\nMade for fun by Harshvardhan Varma."}]}, "developer_name": null, "developer_privacy_policy_url": "https://avivarmavr.artstation.com/pages/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Harshvardhan Varma", "support_website_url": null, "website_url": "https://www.artstation.com/artwork/PXr3Qo", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7242557179169968"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4433475373542610"}, {"status": "PUBLISHED", "id": "1008031367839988"}, {"status": "PUBLISHED", "id": "308438845097830"}]}, "baseline_offer": {"id": "4433475373542610"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792170000, "status": "PUBLISHED", "id": "4433475373542610"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29342790165386686", "version": "1.21"}, "id": "1438346520109192", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Version 1.21\n\nNEW COURSE: LUNAR LINKS\n- An eighth course on the Moon: race from the launch pad across rilles and drawbridges, ride a working cliff lift 96 m down, and finish on a green under the Earth.\n- Its own music, the Lunar Voyager achievement and a new name-tag background.\n- Lift levers and gongs show a marker telling you what to pull or strike.\n\nCOURSES AND VISUALS\n- Sunscar Canyon: no more pitch-black rock recesses, and fewer gaps between the rocks.\n- Golf Volcano: a richer molten lava network.\n- Rebuilt Temple cherry trees, new hole bowls with a stone collar, and art passes across the campaign.\n- Some courses have new names.\n\nRACE, CLUBHOUSE AND MENUS\n- Clearer race display: distances, the time left to beat and how the race stands.\n- A tidier results board.\n- The clubhouse and Sunrise Valley are dressed up, the wardrobe is rebuilt, and you can sit on chairs.\n- Refreshed main menu panels: join lobby, audio, online and companions.\n- The cat companion now unlocks after a solo clear of the fourth course, including for players who already cleared it.\n\nMOVEMENT AND COMFORT\n- Jump has a natural arc, a short grace period after stepping off an edge, and landing feedback.\n- Falls: you are held safely while the next area loads.\n- Teleports only fade to black when Teleport Blackout is on, and landings no longer put your head inside nearby objects.\n\nPERFORMANCE AND AUDIO\n- Sharper image on Quest 3 and 3S: higher render resolution at a steady 90 Hz.\n- Smoother first loads: graphics are prepared on the loading screen.\n- Lighter materials across every course.\n- New creature sounds, cleaner interface sounds and better music quality.\n- Updated to Meta XR SDK 209.", "created_date": 1795287559, "id": "29342790165386686", "version": "1.21", "version_code": 121, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29342786288720407"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "NEW COURSE\n- Lunar Links: an eighth course, set on the moon, with its own soundtrack of eight songs, a leaderboard, and the Lunar Voyager achievement.\n\nCLUBHOUSE AND MENUS\n- Sunrise Valley: the view from the clubhouse has been rebuilt with a stone bastion, groves, boulders and golden sunrise light.\n- The clubhouse platform has new trees and dressing.\n- Main Menu: \"Play together\" replaces the separate clubhouse and campaign pages, with larger mode and join buttons. Every menu button now highlights when you point at it.\n- Long Drive range: a cleaner board that shows only the buttons you can use, and clearer landing markers during a round.\n\nCOMPANION\n- The cat companion now unlocks when you clear the fourth course solo. If you already have, it is unlocked for you.\n\nVISUALS\n- Golf Volcano: the lava is brighter and reads as molten, with a hot orange-to-yellow glow.\n- Sunscar Canyon: recesses and overhangs that showed as solid black are now lit, and many pinhole gaps along the canyon walls are closed.\n\nSMOOTHER PLAY\n- Fewer one-off stutters the first time new areas appear, including the clubhouse and Lunar Links.\n- Faster, cleaner arrival at the clubhouse and courses, with less pop-in.\n- Lighter materials throughout the clubhouse and courses.\n\nSOUND\n- New creature contact sounds, and tidied interface sounds.\n\nOTHER\n- In-game notices now appear one at a time instead of stacking.", "created_date": 1795119390, "id": "29318629941136042", "version": "1.19", "version_code": 119, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29318627064469663"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Version 1.14\n\nRaptors, rebuilt\n- Raptors lock eyes on you when they charge, step and turn with real footwork, and lean into slopes.\n- New fight moves: sprints, circling, feints and pounces.\n- Plunger shots land exactly where you aim, and raptors react differently depending on where you hit them.\n- Raptors now roam their territory instead of waiting in one spot.\n\nHole-outs\n- Every cup has a stone-and-jade collar at the bottom of the bowl, so you can always see where the ball drops.\n- The celebration now bursts up from the cup itself, with sparkles running along the stone rim.\n- Fixed a black disc at the bottom of the Golf Mountain cup.\n\nJade Lantern Temple\n- The pagoda interior is brighter, with new lighting on the upper floor.\n\nMultiplayer\n- Everyone in a game needs version 1.14 to play together.", "created_date": 1793919493, "id": "29122350090764029", "version": "1.14", "version_code": 114, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29122345037431201"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1438346520109192"}]}, "change_log": "Version 1.13: \n\nSTABILITY AND PERFORMANCE\n- Major work to reduce the mid-course freezes some players saw\n- Lower memory use on every course\n- Smoother frame rates, with less for the headset to draw on the busiest courses\n- Updated game engine and multiplayer networking\n\nCOURSES\n- Jade Lantern Temple: giant cherry trees, golden-hour lighting, Moon Pond, Moss Garden, a bell shrine, a larger pagoda and a rebuilt gorge waterfall\n- Crystal Cavern: rebuilt as a network of caves with soaring vaults, a worn stone causeway, deeper chasms with rivers and a miners' camp\n- Sunscar Canyon: redesigned crossings, an oasis finale, a petroglyph, a larger cliff dwelling and smoother canyon walls\n- Golf Volcano and Sunken Sanctuary: new scenery and art\n- Closed gaps and see-through spots, and sealed hairline cracks on every course\n- Rivers now run beneath the Canyon and Crystal Cavern bridges\n\nGAMEPLAY AND CONTROLS\n- New golf gloves on your hands, with natural poses on controllers\n- A new dimpled golf ball\n- Bridge gongs now face the path, so they are easier to spot\n- Plunger gun: redesigned trigger that squeezes with your finger\n- Seated players can now jump, and standing up in Seated mode offers to switch\n- The posture prompt appears sooner and is easier to answer\n- Cleaner teleport arc and wardrobe selection\n- Particle effects stay steady when you turn your head\n- Introduction: your ball can rest further off the course before it counts as rough", "created_date": 1793843316, "id": "29109294628736242", "version": "1.13", "version_code": 113, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29109288438736861"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7242557155836637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29342790165386686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793295508, "id": "29020448617620844", "version": "1.03", "version_code": 103, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "29020442027621503"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
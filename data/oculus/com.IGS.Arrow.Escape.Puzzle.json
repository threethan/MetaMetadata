771-25/491823837_869947099536049_7079369447557816204_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1NOsXsOMhgQ7kNvwGFP2Op&_nc_oc=AdrS1GTfaANOW24NAnQuHYbYHWJVRaORZgLbWC4zzhYlwsYv5yMgmVEAfq5WGwBrHSk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt7GQBIJwSbAFfJEDRRyDuxD_mVxfH9ejxvdYEKmqeqQ&oe=6AFC6C80"}, {"file_name": "1.png", "id": "1717687699344706", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_1717687702678039_5618665516178498940_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbwHHotWRskQ7kNvwHsUTBE&_nc_oc=AdrND2uvKt4SwpBAPBs9mn9c90tuXxcPJSZ1xel66-nLnNclnUR9hv_G_zpTojvLySw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdQ2b3RlaEq_uMsave-lCgWjwVsXU_vd9wwD4RDcSSdQ&oe=6AFC6E48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Arrow Escape: Puzzle Game VR", "keywords": ["Arrowescape", "arrowvr", "arrowgame"], "long_description": "Arrow Escape: Puzzle Game VR is a challenging and immersive virtual reality puzzle experience that puts your reflexes, timing, and problem-solving skills to the test.\n\nEnter a world filled with tricky paths, dangerous arrows, and challenging puzzles. Your goal is simple: escape the obstacles and find your way to safety. But every level introduces new challenges that require careful movement, quick thinking, and precise timing.\n\nLook around, plan your moves, avoid incoming arrows, and discover the right path through each puzzle. As the challenges become harder, you'll need to adapt your strategy and stay focused to make it through.\n\n\ud83c\udfaf Features\n\ud83c\udff9 Arrow-based obstacle puzzles\n\ud83e\udde9 Challenging levels that test your thinking\n\ud83e\udd7d Immersive VR gameplay\n\u26a1 Fast-paced reflex and timing challenges\n\ud83c\udfae Simple and intuitive controls\n\ud83d\udd25 Increasing difficulty as you progress\n\ud83c\udfc6 Test your skills and beat every challenge\n\nCan you master the arrows, solve every puzzle, and escape them all?\n\nPut on your VR headset and begin your escape!", "short_description": "Arrow Escape: Puzzle Game VR is an exciting VR puzzle game where you must strategically move, dodge, and escape a maze of tricky arrow obstacles. Test your timing, reflexes, and problem-solving skills to find the perfect path to freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/itgamestudio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "IT Game Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/itgamestudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1235098333030526"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673759338_1375692221393776_7017286337938440536_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck3POZOX1eAQ7kNvwG-j_n1&_nc_oc=Adoo0OAwmXIMRcKuwgrY9RECXxAzCyuSpDrCBratH2_qltgYQJYSurSM2G-uINPAK9I&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZGj20bkvZRPe9433vW4JhbkIuwwxoMSvC-Rf2ola1Yw&oe=6AFC6646"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Arrow Escape: Puzzle Game VR", "platform": "ANDROID_6DOF", "context_category":
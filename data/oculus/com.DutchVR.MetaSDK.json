m&_nc_ss=7f20f&oh=00_AQCNxB_uObA5uj9NPu408f4nsa0cMuCUajJv-snAgSNgbQ&oe=6A5628C8"}, {"file_name": "Screenshot3.png", "id": "352939060688567", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974482_352939064021900_5062912727479813651_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dr7JUD8PoIQ7kNvwEi81rd&_nc_oc=AdrgELfMJX9Cm0jURshkQhqiIGNz3JBebapj-tMFW4Swtw4zk2YucmSCtp72P2KUNmM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxOrdkeMWoAMyE1nbnjobhmUH9vu61ZlfYNVE0kN7APA&oe=6A5647FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VirTerra", "keywords": ["Educational", "Building", "Passthrough", "Management", "Ecological"], "long_description": "VirTerra is a city builder inspired by the classics where you have to build a good mix of housing, commercial and industrial buildings for your citizens.\nThe twist is that some of these buildings can become a polluting factor for your city which you will need to manage unless you don't mind the happiness levels dropping in your city.\nThrough the management of pollution we wish to teach players about humanities ongoing struggle against pollution in the modern world ", "short_description": "Mixed Reality educational game where you build a Virtual City on a table inside your own home, but watch out if the city starts to get polluted it might effect your actual home as well."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dutchvr.com/privacy_virterra.html", "developer_terms_of_service_url": null, "publisher_name": "DutchVR", "support_website_url": null, "website_url": "https://www.dutchvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1676485315806614"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
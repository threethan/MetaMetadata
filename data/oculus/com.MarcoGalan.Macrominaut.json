iPNWyvkH6ynPyDGnezWGq_qJoIGI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh81RGyLbK7DuZyUYshFmFCbTiYmzccZIlzmWTPhY-1g&oe=6AA40FFE"}, "display_name": "Macrominaut", "keywords": [], "long_description": "Es un sandbox experimental de previsualizaci\u00f3n arquitect\u00f3nica donde el usuario puede ensayar en tres tipos de escalas: de maqueta, de vivienda y de edificaci\u00f3n. El usuario puede imprimir una serie de objetos preestablecidos, sincronizarlos en las escalas de vivienda y edificaci\u00f3n, teletransportarse, y dibujar en el espacio, sincronizando el trazo de la maqueta con el objeto a mayor tama\u00f1o.", "short_description": "Sandbox experimental de previsualizaci\u00f3n arquitect\u00f3nica donde el usuario explora escalas de maqueta, vivienda y edificaci\u00f3n. Permite sincronizar objetos y trazos entre escalas, teletransportarse y dibujar en el espacio."}, {"images": {"nodes": [{"file_name": "mini portada.png", "id": "1751931112393398", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57572931_1751931119060064_5067081575884196754_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmScVh8UUxMQ7kNvwFzZmWG&_nc_oc=Adp-iacCcHwSqbKdvVvHsoA2djX8xbZpnhjd1sJsWc6ppKb8aqlcqcirdbRS9wYVy6g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZjfw07Tg2xIKdb0j8xdR1OFPHa-3plvKXgiOJXXCm_Q&oe=6AA42067"}, {"file_name": "CoverImageSafeAreaTemplatePortrait macromin.png", "id": "1638764136710700", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75203627_1638764140044033_6245969963711280394_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzNaRcZDAHYQ7kNvwEnTQOy&_nc_oc=AdpCnhpJGhGwOiV4wWwpKac7ql2CapcgpV2n8rT1aTD9Nacr4dhDUzKiXot5H1Ip79g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1-cMGCyT1JY9gH65bDIAvJEUv-UKV3sRdaYb78R489Q&oe=6AA3FDA3"}, {"file_name": "macrominautlogotransp.png", "id": "979838563995410", "image_typ
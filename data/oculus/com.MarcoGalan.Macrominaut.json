-1.oculuscdn.com/v/t64.5771-25/39031519_942873401274343_4659229286491248985_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wln865ZCPjEQ7kNvwFoDoTN&_nc_oc=Adknj6PeXwEprqI_2_LAYfzLznou5ayYkvr0DQwC0cKiyXVE1CTHVrhwGvLYQtYn0pc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuxb4GE2jehO_Qt99a73d8eutDMEmyZEu-CIe8ZAwmS2A&oe=699EFA2F"}, {"file_name": "mm im5.png", "id": "1208871290814434", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031488_1208871294147767_6460204993752988533_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-hJbcSfITMQ7kNvwGOOoCS&_nc_oc=AdmJOG67KTtgWmm_hbqpoE6v3PNWz8n676F1f5O-JbnFphhf2mPrY3tOn89hiR2QahY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuE0J0wQhjC8cWf7THunQ49g-G_BvPIzQM8QYXeMWcl9A&oe=699ED47C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateHero macromin.png", "id": "1124308266370819", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031584_1124308269704152_5426237491741803497_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiswh54r478Q7kNvwHGmz7I&_nc_oc=AdkFUpNydNPMdU4uPOgFKu9BOuLCemfOpDjKSJ4jcO74g0ogU7t3U9JW22CXfsTwYa8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsmxQ8PmT35mCdIrS1m_pVp0Fzl9dZH3MbewXAbUgwsHA&oe=699F06FE"}, "display_name": "Macrominaut", "keywords": [], "long_description": "Es un sandbox experimental de previsualizaci\u00f3n arquitect\u00f3nica donde el usuario puede ensayar en tres tipos de escalas: de maqueta, de vivienda y de edificaci\u00f3n. El usuario puede imprimir una serie de objetos preestablecidos, sincronizarlos en las escalas de vivienda y edificaci\u00f3n, teletransportarse, y dibujar en el espacio, sincronizando el trazo de la maqueta con el objeto a mayor tama\u00f1o.", "short_description": "Sandbox experimental de previsualizaci\u00f3n arquitect\u00f3nica donde el usuario explora escalas de maqueta, vivienda y edificaci\u00f3n. Permite sincronizar objetos y trazos entre escalas, teletransportarse y dibujar en e
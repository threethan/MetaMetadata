ienda y de edificaci\u00f3n. El usuario puede imprimir una serie de objetos preestablecidos, sincronizarlos en las escalas de vivienda y edificaci\u00f3n, teletransportarse, y dibujar en el espacio, sincronizando el trazo de la maqueta con el objeto a mayor tama\u00f1o.", "short_description": "Sandbox experimental de previsualizaci\u00f3n arquitect\u00f3nica donde el usuario explora escalas de maqueta, vivienda y edificaci\u00f3n. Permite sincronizar objetos y trazos entre escalas, teletransportarse y dibujar en el espacio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/marcogalan16/Macrominaut/blob/main/Macrominaut%20privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "MarcoGalan", "support_website_url": null, "website_url": "https://marcoaureliogalan.blogspot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24025374327152019"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974632_1667986710736104_1215062973447931221_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXo20dtS7VYQ7kNvwGEomif&_nc_oc=Adl0Yse8niImfk5ZFD9H-1Ei66in7VdeKka1_DT74hedFLdVx7VsEiU6GnCPUodAf6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs6AxhzMBedO5qtmzQDNKl9rsCICxs9GIjORq2-bn-Yt
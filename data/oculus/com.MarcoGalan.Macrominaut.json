4-1.oculuscdn.com&oh=00_Aft7XP1O7cf-DruqZPhu85egoVRHqwoJOrQgwfcd4BvNbg&oe=69A1897B"}, {"file_name": "mm im3.png", "id": "942873397941010", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031519_942873401274343_4659229286491248985_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wln865ZCPjEQ7kNvwHDH6lb&_nc_oc=Adki8aGk2SAffCRPhgR695y4cLYoXJCiy3Uim5qDjhvONFaKaJLctIXEhwKfZNXrkcM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftstUXxUHh7XMD6l3tlsejzPQb1uGTmAd7BUHfE6gewrg&oe=69A19D2F"}, {"file_name": "mm im5.png", "id": "1208871290814434", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031488_1208871294147767_6460204993752988533_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-hJbcSfITMQ7kNvwGeITbd&_nc_oc=Adk0wUsK3DBjdLwXLhFHLYs8KWmBWWOZ475vsVPM8GPb6cEOlv7cdwQwC6mKBkQ-0sg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvaBDg51NlQnxrQizMpFJuX_WxvuUljblEIPBkk0ImIgg&oe=69A1777C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateHero macromin.png", "id": "1124308266370819", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031584_1124308269704152_5426237491741803497_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXCeGrwPJ4sQ7kNvwHqq_Vi&_nc_oc=AdnCXogKov3Z-wUBIjmYzIqPsFyYJOrEtr8VuBYpqmJesyNB9ideUbznm8xVsyF4RJ0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfucXVOasZ0H0RChauAXSnDz9D-thGq1Va9gX8p8VaHK3A&oe=69A1A9FE"}, "display_name": "Macrominaut", "keywords": [], "long_description": "Es un sandbox experimental de previsualizaci\u00f3n arquitect\u00f3nica donde el usuario puede ensayar en tres tipos de escalas: de maqueta, de vivienda y de edificaci\u00f3n. El usuario puede imprimir una serie de objetos preestablecidos, sincronizarlos en las escalas de vivienda y edificaci\u00f3n, teletransportarse, y dibujar en el espacio, sincronizando el trazo de la maqueta con el objeto a mayor tama\u00f1o.", "short_description": "Sandbox experimental de previsualizaci\u00f3n arquitect\
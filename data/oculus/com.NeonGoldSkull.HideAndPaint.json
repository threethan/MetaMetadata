kWmkW25WGWgbUKuD3lK68eZZq4cQ&oe=6AFB257A"}, "display_name": "Hide and Paint VR", "keywords": ["chameleon", "paint", "hide", "seek", "multiplayer"], "long_description": "The only and top selling VR chameleon game with Mod Maps! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!\n\n# Mod Maps!\nOur Community has created tons of Mod Maps that you know and love in addition to default maps like Grocery, Office, Gallery and more.\n{3566892060141529}\n# Hide and Paint!\nAct fast! Find a spot and paint yourself to blend into the map. DON'T GET CAUGHT!\n{1946049456059266}\n# Hunt!\nFind those hiders! Catch them and they join your team, infection style. GET THEM ALL!\n{1251328623638355}\n\n", "short_description": "The only and top selling VR chameleon game with Mod Maps! Hide, Paint, and Seek! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.2080.games/privacy/hide-and-paint-vr", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1316157594914067"}, "review_messages": []}]}, "cover_square_image":
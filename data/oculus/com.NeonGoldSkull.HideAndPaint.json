124753602_5635742170459136536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VU2UuhKKUYYQ7kNvwGvpifh&_nc_oc=AdpyCq8q4crtnDWYrJpDr1wDCHIxf8geFALpF_DSVleiykkoTCETeSIJoXZhUNuNQ-8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy1XKkXfKFgH2Vk7SUQtXZZb6k5tift4GCrCgMjupjZQ&oe=6AA934C5"}, {"file_name": "Hide and Paint Screenshot 4.png", "id": "1343776461060043", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499622214_1343776464393376_6011160555344864002_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rfAbiZ3uqUQ7kNvwFejH7g&_nc_oc=AdqgcBr3q-LFdHqUSqumHkVRQwp8tr3qWwfb6h-L6zQRMrczH9ku6IMzD6CeNQu78T0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2HqP8jHORDC_W1PkucTMUNoJ5z6YgGsvHXA9gZ5k_Kw&oe=6AA94F3A"}, {"file_name": "Hide and Paint Screenshot 5.png", "id": "2235737257230620", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499301473_2235737260563953_3399477039213566164_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBUeU1mDkv8Q7kNvwGM0_av&_nc_oc=AdrbO5FoI82bPnPWM4MJlHYdPezLjHd8h7w4-KA-oDqHTFW_TYCs2Abfl1Uv6Px97yo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0z5zIg6Iah1DX5KauICgW4FgaF-OIK7wjaYlHwU8WaQ&oe=6AA93C6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hide and Paint VR Update Landscape 2.png", "id": "1699654347928778", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499312310_1699654351262111_5117771567315992972_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOCwjNAwqhMQ7kNvwGMgsBO&_nc_oc=AdrSIAEi-OnriI08O732oebLi0iILOYwvxhl2z1bfT_u3NFZTlLqpNv9j0KD61zgZUY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmuwhl-R1A9pwSD_V2-5ugFt4fRnrEmFFKbz7Y9iMOPw&oe=6AA9687A"}, "display_name": "Hide and Paint VR", "keywords": ["meccha", "chameleon", "paint", "hide", "seek"], "long_description": "The only and top selling VR chameleon game with Mod Maps! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!\n\n# Mod Maps!\nOur Community has created tons of Mod Maps that you know and love in addition to default maps like Grocery, Office, Gallery and more.\n{3566892060141529}\n# Hide and Paint!\nAct fast! Find a spot and paint yourself to blend into the map. DON'T GET CAUGHT!\n{1946049456059266}\n# Hunt!\nFind those hiders! Catch them and they join your team, infection style. GET THEM ALL!\n{1251328623638355}\n\n", "short_description": "The only and top selling VR chameleon game with Mod Maps! Hide, Paint, and Seek! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.2080.games/privacy/hide-and-paint-vr", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1219185501277944"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499307451_1059922520315001_2855165757393148414_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q822HoTjPtcQ7kNvwHugj4X&_nc_oc=AdplhnAb5bBBGrLMddX2uKquPsgv4jLP6dmWOxZs8Dt1W_7hUUPpSFH3eAAp2SZX7vo&_nc_zt=3&_nc_ht=scontent-sin11-2.o
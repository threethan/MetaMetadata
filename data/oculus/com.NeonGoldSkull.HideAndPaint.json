53602_5635742170459136536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ur9_07xtKeEQ7kNvwFV6Hd8&_nc_oc=Adp6sFewOHZoPT030c_L_XmuInMAz7CqiAY3A9F-FQW9WAIfK0ruAglLgffh6j2VuM8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2LHtdy-fgv5j652FD47seognpjQp60dWU2_25sDspsw&oe=6A9FFA45"}, {"file_name": "Hide and Paint Screenshot 4.png", "id": "1343776461060043", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622214_1343776464393376_6011160555344864002_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YW6oDLIr2uQQ7kNvwHezVYc&_nc_oc=AdrqJbKdO-Jmb5-2_6LIDl_AoWF-UGObnA2OMgtRnU8sMJiP41iUF03He9sMPhZcuJw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkMovtpbN3_Z1aI9a9KWCU5AlxpWjpL65iJoPLSp-6eA&oe=6AA014BA"}, {"file_name": "Hide and Paint Screenshot 5.png", "id": "2235737257230620", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499301473_2235737260563953_3399477039213566164_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAbcq1_NRioQ7kNvwHZtMVc&_nc_oc=AdqkjT2M3W8D9FdiexGCr0zLn01-s0KbbWvhqd5xr551ARHsN8BSAucmFc0e2gEVvoI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEETawSdjbsky3qYBhiU5dua7fQXKr48tjn4eC2I2Irw&oe=6AA001EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hide and Paint VR Update Landscape 2.png", "id": "1699654347928778", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312310_1699654351262111_5117771567315992972_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjaQdpwEbUYQ7kNvwHEyRcp&_nc_oc=AdoGWqAfAOKY0j8Je4QT18Owbdv6ScSQ1aoda6jvWtPedNXC0yY3Lr7D2TLywp_Wusc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSEpqGnluEBfMLzv2KifJaIg6jdEcsaq4ZeBa4NW6FpQ&oe=6AA02DFA"}, "display_name": "Hide and Paint VR", "keywords": ["meccha", "chameleon", "paint", "hide", "seek"], "long_description": "The only and top selling VR chameleon game with Mod Maps! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!\n\n# Mod Maps!\nOur Community has created tons of Mod Maps that you know and love in addition to default maps like Grocery, Office, Gallery and more.\n{3566892060141529}\n# Hide and Paint!\nAct fast! Find a spot and paint yourself to blend into the map. DON'T GET CAUGHT!\n{1946049456059266}\n# Hunt!\nFind those hiders! Catch them and they join your team, infection style. GET THEM ALL!\n{1251328623638355}\n\n", "short_description": "The only and top selling VR chameleon game with Mod Maps! Hide, Paint, and Seek! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.2080.games/privacy/hide-and-paint-vr", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1219185501277944"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307451_1059922520315001_2855165757393148414_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akx9pwyEORQQ7kNvwGv9ZK4&_nc_oc=AdqiL6yH5oKqM0Ry9mWIXAQ_6MtivmMgR0vXirohX-PzO8CK6BsArNpMTJiG_JmZN98&_nc_zt=3&_nc_ht=scontent-lga3-3.oculusc
7a0a&_nc_ohc=W3nfmzddTtsQ7kNvwFrpFjc&_nc_oc=AdoUJ1GbGEIjr7s6pGq52DCVkZ0U89ODvZGYSJRClzu1G4Z3AXPmXC4FEUyjMewF5fg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIfR0mD9aYuKR3tpi8wydMfp-br-1-nP5xvZzl1SErBg&oe=6AB519EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "1004796605629196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613051964_1004796608962529_8384955035182991480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNipDIVmuFsQ7kNvwEcbUnT&_nc_oc=Adpsuyt3vear-Bopf8Y3j8T3lCtEaZFknr9gY0cj8WZGayMyPLsZb__x8a7-Zf6ScBk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpeSyvcXunJq-vPhEVwymEXYi6pKrq7AnpPFPyRCjFcg&oe=6AB53791"}, "display_name": "Hide and Paint VR", "keywords": ["meccha", "chameleon", "paint", "seek", "hide"], "long_description": "NOW in VR! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!\n\n# 3 Maps and Counting!\nPut your artistic skills to the test in the Grocery, Office, and Gallery\n{3566892060141529}\n# Hide and Paint!\nAct fast! Find a spot and paint yourself to blend into the map. DON'T GET CAUGHT!\n{1946049456059266}\n# Hunt!\nFind those hiders! Catch them and they join your team, infection style. GET THEM ALL!\n{1251328623638355}\n# Early Access\nWe are working fast on more maps, more modes, more features and overall polish! Feedback and ideas are appreciated! Thank you for your support from the beginning of our journey!\n\n", "short_description": "Hide, Paint, and Seek in VR! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.2080.games/privacy/hide-and-paint-vr", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
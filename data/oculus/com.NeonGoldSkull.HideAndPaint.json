7a0a&_nc_ohc=17g1JoBlPOsQ7kNvwEf9AMI&_nc_oc=AdpkMZofKGJqTNZ9IutmOQLEga-K0ZkKHJVssS9ZyNHvXAHlsSaPzweB_XJygqGoWak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0hQcqkiDvHv5pQ1M5bVeVimFRrqeV0GhMtRdheWk15g&oe=6AC3D2AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "1004796605629196", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/613051964_1004796608962529_8384955035182991480_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_l8rI_PYswQ7kNvwF76VXy&_nc_oc=AdqGcy9PbMVIQuhiq274u4ThlwGOkwMTgJMb96htK9YMJmRkpf5w5rGQHOpJEbtol9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0sRt_hOIH8vHmKpFlyaY8Bxi2TjI270uZLXa_1SVgRQ&oe=6AC3B811"}, "display_name": "Hide and Paint VR", "keywords": ["meccha", "chameleon", "paint", "seek", "hide"], "long_description": "NOW in VR! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!\n\n# 3 Maps and Counting!\nPut your artistic skills to the test in the Grocery, Office, and Gallery\n{3566892060141529}\n# Hide and Paint!\nAct fast! Find a spot and paint yourself to blend into the map. DON'T GET CAUGHT!\n{1946049456059266}\n# Hunt!\nFind those hiders! Catch them and they join your team, infection style. GET THEM ALL!\n{1251328623638355}\n# Early Access\nWe are working fast on more maps, more modes, more features and overall polish! Feedback and ideas are appreciated! Thank you for your support from the beginning of our journey!\n\n", "short_description": "Hide, Paint, and Seek in VR! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.2080.games/privacy/hide-and-paint-vr", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_
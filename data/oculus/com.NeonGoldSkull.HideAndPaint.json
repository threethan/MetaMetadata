3-1.oculuscdn.com/v/t64.5771-25/499622214_1343776464393376_6011160555344864002_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zy5i0Z_LaGEQ7kNvwEFa-15&_nc_oc=AdqoFTQCM7MDDrxt9eikE-TEOj2LAp-p4GwVCa-Tm7PQoNvpnfOUbYePmylsNP3QP5o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXcWHi4g2RPFGqJkhPvs1NHk6hL1LaJu7MhscEVeezSg&oe=6AFB447A"}, {"file_name": "Hide and Paint Screenshot 5.png", "id": "2235737257230620", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499301473_2235737260563953_3399477039213566164_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEn9fhDbW-MQ7kNvwGxq5Su&_nc_oc=AdrpQn_9yzF5Zc4dwDxi00biB3llMgwN0bRpLXLDT4OQ2TJW0KavMbq6-jOqKwTUOOA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7YBiz-BtUlq2D2iEQ2GQXJBN_5znbYpaSzqPowjpjzw&oe=6AFB31AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape (1).png", "id": "1004796605629196", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/613051964_1004796608962529_8384955035182991480_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyoSCky_qlkQ7kNvwEv6vi5&_nc_oc=AdprIrClFoNW1g7v_BcIjAPyIoDv0YDFkNGGBzy41ZBacyMvJdCWwXns49pVLr5aiS4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOL9WpjtbEh1IdnFhsW0zlHrQftr5VOlx2qrZ5mffmIA&oe=6AFB1711"}, "display_name": "Hide and Paint VR", "keywords": ["meccha", "chameleon", "paint", "seek", "hide"], "long_description": "NOW in VR! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!\n\n# 3 Maps and Counting!\nPut your artistic skills to the test in the Grocery, Office, and Gallery\n{3566892060141529}\n# Hide and Paint!\nAct fast! Find a spot and paint yourself to blend into the map. DON'T GET CAUGHT!\n{1946049456059266}\n# Hunt!\nFind those hiders! Catch them and they join your team, infection style. GET THEM ALL!\n{1251328623638355}\n# Early Access\nWe are working fast on more maps, more modes, more features and overall polish! Feedback and ideas are appreciated! Thank you for your support from the beginning of our journey!\n\n", "short_description": "Hide, Paint, and Seek in VR! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.2080.games/privacy/hide-and-paint-vr", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "644354873106712"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1187808097749018"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1640559381137551"}, {"status": "PUBLISHED", "id": "4428121770835267"}, {"status": "PUBLISHED", "id": "1393659496036881"}, {"status": "PUBLISHED", "id": "1067852192583615"}, {"status": "PUBLISHED", "id": "1511747876566355"}]}, "baseline_offer": {"id": "1511747876566355"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1640559381137551"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1233999363129891", "version": "0.0.6
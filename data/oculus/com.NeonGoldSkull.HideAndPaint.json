}\n# Hunt!\nFind those hiders! Catch them and they join your team, infection style. GET THEM ALL!\n{1251328623638355}\n# Early Access\nWe are working fast on more maps, more modes, more features and overall polish! Feedback and ideas are appreciated! Thank you for your support from the beginning of our journey!\n\n", "short_description": "Hide, Paint, and Seek in VR! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.2080.games/privacy/hide-and-paint-vr", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "644354873106712"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1187808097749018"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1640559381137551"}, {"status": "PUBLISHED", "id": "4428121770835267"}, {"status": "PUBLISHED", "id": "1393659496036881"}, {"status": "PUBLISHED", "id": "1067852192583615"}, {"status": "PUBLISHED", "id": "1511747876566355"}]}, "baseline_offer": {"id": "1511747876566355"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1640559381137551"}]}, "liveChannel": {"nodes": [{"latest_supporte
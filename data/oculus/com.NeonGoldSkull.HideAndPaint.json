53602_5635742170459136536_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwq_4INCFx0Q7kNvwEeI3oB&_nc_oc=Adr-F0tExJRfxbGPHEYvCEy-ghT4M6NwABhUY1-PT0ovcCuMHX4u6DO6-stGSDeOo_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0q8iHSg6-RMqWJoutF7cWGHI4kuB6Q0oE-j4Z1Oh0wA&oe=6A999B05"}, {"file_name": "Hide and Paint Screenshot 4.png", "id": "1343776461060043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_1343776464393376_6011160555344864002_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XDr6vCBopIQ7kNvwG3TCf5&_nc_oc=AdqP41_gDDiuWEtLhatcKWbedAE2qHNYWkLASG9cIGXn5c9Xnyku_Ky8t-IUTz84VOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGAid6N7JBpA_IvrRK-u0LhmsEQYJQPbxZAMU0CcgRIg&oe=6A997D3A"}, {"file_name": "Hide and Paint Screenshot 5.png", "id": "2235737257230620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499301473_2235737260563953_3399477039213566164_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT7dmMhZP3EQ7kNvwHW93gI&_nc_oc=AdqcYfKKxd690Ovnfyxy5PzCxo9PaKeJxNME9VIIytD6mDBp8lIu7cOO8kayJWzb4w4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNbhTUQrJ9SGJeTqzqNqF1C0U_In3-ItCI4KifW9VOBQ&oe=6A99A2AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hide and Paint VR Update Landscape 2.png", "id": "1699654347928778", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312310_1699654351262111_5117771567315992972_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5n1BbI9uvUQ7kNvwG_MSBc&_nc_oc=Adph6b3Eyz_01Iww4Dw2E3dZuk2JRvTEOYfRmkjtOYrNQETS38DmVyOeH2p3icLs3t4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5lQu6__c6NPQfGh-6sAYj8ojyuwRFXpfwJlqNIPCFRg&oe=6A99967A"}, "display_name": "Hide and Paint VR", "keywords": ["meccha", "chameleon", "paint", "hide", "seek"], "long_description": "The only and top selling VR chameleon game with Mod Maps! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!\n\n# Mod Maps!\nOur Community has created tons of Mod Maps that you know and love in addition to default maps like Grocery, Office, Gallery and more.\n{3566892060141529}\n# Hide and Paint!\nAct fast! Find a spot and paint yourself to blend into the map. DON'T GET CAUGHT!\n{1946049456059266}\n# Hunt!\nFind those hiders! Catch them and they join your team, infection style. GET THEM ALL!\n{1251328623638355}\n\n", "short_description": "The only and top selling VR chameleon game with Mod Maps! Hide, Paint, and Seek! Strike any pose and paint yourself by hand to blend in like a chameleon while avoiding Hunters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.2080.games/privacy/hide-and-paint-vr", "developer_terms_of_service_url": null, "publisher_name": "2080 Games", "support_website_url": null, "website_url": "http://www.2080.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1219185501277944"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307451_1059922520315001_2855165757393148414_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nppdik4xxYAQ7kNvwGEZldA&_nc_oc=Adpt3DoI-bpbzTuivZ8NndI13TDUSwn2vjYko7SfJEgBGDN9osr0rxB3G-4Yu99NUbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculusc
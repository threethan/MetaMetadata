etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NFNTKbrAxUQ7kNvwGEx5kf&_nc_oc=AdoGKUMW3lm_ayR-Tmd7tnRAcXrenIr7NS1nl5aN09btnkwWCCeARudm3gL_Lvl1bBM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ18UPzo8XFVnGb4bJGdYGCubAXlqW3UXkkKsv213Jwjw&oe=6B0C63BB"}, {"file_name": "screenshot_5_ram_in_the_plaza.png", "id": "1004993022665857", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908835811_1004993025999190_7968582929834445590_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9lipNLtGK0Q7kNvwEUzmAO&_nc_oc=AdoMT9WvNWv4MWpyhzuSM7VkKn2RPCVwCg27GAx8F27d-ekaz6pkrCESjh3JBDwXP5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrTNi97825K84LMAMjuGTJxqmDBqcYd3ehf-fGQnIueg&oe=6B0C74F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Levanter", "keywords": ["robots", "shooter", "survival", "fall", "futuristic"], "long_description": "The Mandate, a masked army that answers to no one, is taking the coast town by town. The last people are getting out of Prospera Bay. Someone has to hold the line until they are gone.\n\nLevanter is a hard, physical VR wave survival shooter. You and two squadmates hold your ground against twelve waves that hit harder every round. Survive them all.\n\nFIGHT WITH YOUR WHOLE BODY\n- A thermal rifle, carbine, SMG and shotgun, blaster pistols, a magnum and a sniper rifle. A light gun in each hand.\n- Raise an empty magnum or sniper rifle to reload, throw grenades, strike in melee on the move.\n- Jump, fire your jetpack and glide down from the rooftops.\n\nKNOW WHAT IS COMING\n- Masked soldiers take cover, pin you down and close in.\n- Robot hounds, drone swarms, walkers and heavy mechs strike from the streets and the sky.\n\nHOLD THE LINE\n- Earn credits with every kill and spend them at the command post between waves.\n- Build defences, man heavy guns, revive a fallen squadmate by taking their hand.\n- Four difficulties, from RECRUIT to LEGEND.\n\nCOMFORT\nSmooth locomotion, snap or smooth turning, seated or standing play, full field of view. Left-handed mode, subtitles, aim dot and steady aim.\n\nEARLY ACCESS\nLevanter is in active development. Today it has one map, Prospera Bay, and it will keep changing and growing with every update. The price may go up after Early Access. English only.", "short_description": "Survive twelve brutal waves of masked soldiers, robot hounds, drones and war machines, with two squadmates at your side."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raetae.com/levanter/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Raetae Studios", "support_website_url": "https://raetae.com/support/", "website_url": "https://raetae.com/levanter/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29258809760405347"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1419931130354342"}]}, "baseline_offer": {"id": "1419931130354342"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795456980, "status": "PUBLISHED", "id": "1419931130354342"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29298950573057932", "version": "0.1.1"}, "id": "4477202005874378", "channel_name": "LIVE"}]}, "is_for_ocu
16IpQ&_nc_oc=AdpvhZwcq8Dgf36YdhzzYCtt5rxHvSLPTOpvfUPiU5x2H2cxMbQI5Oec5dznJ9xmqxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLtxUjVb72sgPZ5qxFs_kl00-_sfo9xjsvT1NLkFsN2Q&oe=6AFDAF86"}, {"file_name": "Captura de pantalla 2026-04-19 145413_2x_1.5x.png", "id": "1117533490550846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618499_1117533493884179_4870170364968926657_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgYJqLpw6t4Q7kNvwEem3Ln&_nc_oc=AdqEgYSv22dS5VQZPLdpAVbFuU_BdNb_Vrr7FsHRvss7GVPfrq2BRBxEFAvrMsTlXgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhs9sVmS_05wpJYd9N-6Fr7BBKnSc7EEr116-k8AN-tQ&oe=6AFDC6F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apes [VR]", "keywords": ["Capuchin", "Gorilla", "Ape", "Tag", "Apes"], "long_description": "Apes is a fast-paced VR movement game inspired by games like Gorilla Tag and Capuchin, where players use their arms to run, climb, and launch themselves through the environment. Instead of using joysticks, your real arm movement controls how you move, creating a fun and physical gameplay experience.\n\nExplore different maps, swing across obstacles, and chase or escape other players in exciting multiplayer matches. Master the movement system to climb faster, jump farther, and outplay your opponents with skill and strategy.\n\nCustomize your ape with cosmetics, experiment with new movement tricks, and hang out with friends while exploring the world. Whether you're competing, practicing advanced movement, or just messing around in the maps, Apes is all about creativity, speed, and chaotic monkey energy.\n\nJump in, start climbing, and see how fast you can become the ultimate ape.", "short_description": "Apes vr is a Gorilla tag and Capuchin fangame, where, as expected, you move with your arms and play around with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://user3-ship-it.githu
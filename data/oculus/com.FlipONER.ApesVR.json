=6AC27FC7"}]}, "id": "1067699978974691", "locale": "en_US", "screenshots": [{"file_name": "Captura de pantalla 2026-04-19 145525_2x_1.5x.png", "id": "1653587385833640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_1653587389166973_2374851509751393723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC-BsY7340cQ7kNvwEhlDN1&_nc_oc=Ado-3FLuB-cpEwyfEDI0D5jnMM9zugjhfTmUU2FvxcMG6KZAZjpKaDDzcOM1qW_72I4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIW2Oi3iUiuO0wXgQJs_52dwc1CPQnDWfhxUQt6Syi3w&oe=6AC24F23"}, {"file_name": "Captura de pantalla 2026-04-19 145509_2x_1.5x.png", "id": "953909380850398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_953909384183731_2760099021664216123_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYEnqAgs-UAQ7kNvwFfH4MK&_nc_oc=Adr3rLMl0a-v9aHPkt_KCdO-A5tiFA8Q2oLWxnrslfNTpCUGKH8d8HvqiKSEZFWARr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBR2H-QG8olr2dnRe6spdzh6B3EBFQ2gDFUZM1gWohrA&oe=6AC25B45"}, {"file_name": "Captura de pantalla 2026-04-19 145429_2x_1.5x.png", "id": "1566364612164267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626172_1566364615497600_7960032339533855945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVbUMcEEZnoQ7kNvwFmbNiP&_nc_oc=AdqJpwLtFJ11voevPZGFE_Mmg8yMMV9HFaHCDVGR0s340f-a4zW6h4JgelPU2eSsNjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLpPDtGC1d83yz2Dz1QTKDjjKJOiYgNbntCHw04Y_lvQ&oe=6AC25005"}, {"file_name": "Captura de pantalla 2026-04-19 145450_2x_1.5x.png", "id": "2001909853780799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_2001909857114132_5917169290183950131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qzxm3xnMWCIQ7kNvwF8eLnf&_nc_oc=AdqMqJpgK3YhSFUWog9iKcQhTeuAPt99NNgFgGEMhJMi6OMdYwfQ0kFQ0cw6ZIyZGa8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP82F_iANPRnY3O6Yz3cRx_EzHLgothKBNfHsa3fy8aLw&oe=6AC25C06"}, {"file_name": "Captura de pantalla 2026-04-19 145413_2x_1.5x.png", "id": "1117533490550846", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_1117533493884179_4870170364968926657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7OTfIhpQaKEQ7kNvwHsfJGa&_nc_oc=Ado9BBt6A9JOn8diffSfzMBfZs1_7pKaQsB2w5yYJSaQOgR3ik5ATPb0Rv_LOJ-FHfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2WkZCdD-vRFL_3yOV-WkGv-Aj4t603tWIhqQ0XZDBmw&oe=6AC27377"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apes [VR]", "keywords": ["Capuchin", "Gorilla", "Ape", "Tag", "Apes"], "long_description": "Apes is a fast-paced VR movement game inspired by games like Gorilla Tag and Capuchin, where players use their arms to run, climb, and launch themselves through the environment. Instead of using joysticks, your real arm movement controls how you move, creating a fun and physical gameplay experience.\n\nExplore different maps, swing across obstacles, and chase or escape other players in exciting multiplayer matches. Master the movement system to climb faster, jump farther, and outplay your opponents with skill and strategy.\n\nCustomize your ape with cosmetics, experiment with new movement tricks, and hang out with friends while exploring the world. Whether you're competing, practicing advanced movement, or just messing around in the maps, Apes is all about creativity, speed, and chaotic monkey energy.\n\nJump in, start climbing, and see how fast you can become the ultimate ape.", "short_description": "Apes vr is a Gorilla tag and Capuchin fangame, where, as expected, you move with your arms and play around with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://user3-ship-it.github.io/FlipONERSStuff/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FlipONER", "support_website_url": null, "website_url": "https://user3-ship-it.github.io/FlipONERSStuff/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
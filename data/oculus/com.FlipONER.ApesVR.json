=6AB51887"}]}, "id": "1067699978974691", "locale": "en_US", "screenshots": [{"file_name": "Captura de pantalla 2026-04-19 145525_2x_1.5x.png", "id": "1653587385833640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618515_1653587389166973_2374851509751393723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22-wqK_uJtIQ7kNvwHcC8g0&_nc_oc=AdpeF2el9qloTPQW9keUo3wQhEriS_79S_5IvLfil0_gcbkenUEIQt-I1sQh6RBe3hQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0lEx6UV9ycpkKfH8KfEtZHYFGgEHkAb8gyJw8Y-Mp4Q&oe=6AB52023"}, {"file_name": "Captura de pantalla 2026-04-19 145509_2x_1.5x.png", "id": "953909380850398", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_953909384183731_2760099021664216123_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_FFrzc3zxMQ7kNvwHw1gu6&_nc_oc=AdqA8G0auAPzZZ5reH23fwmS5l2r4m7-S20PJDhK8d-RILpdklbrDr1qozfr37bcmSM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL-Lo2Pg5ggrYkqn1xmtova3E2H7wWz_qFOhcLLW8-FA&oe=6AB52C45"}, {"file_name": "Captura de pantalla 2026-04-19 145429_2x_1.5x.png", "id": "1566364612164267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626172_1566364615497600_7960032339533855945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6quIdQWOycQ7kNvwH6tErc&_nc_oc=AdomVIvMG7dObamwN_e_x1Rje-kg6WRP7DdF9O0uB8TG5p6r1mUc0OHVs1r2VwtBNL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi_MshcPkFGb5GdVL1ukxf2MoRTJyO0fMQR0vdwCGYBA&oe=6AB52105"}, {"file_name": "Captura de pantalla 2026-04-19 145450_2x_1.5x.png", "id": "2001909853780799", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619681_2001909857114132_5917169290183950131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuYIS52sBPkQ7kNvwFnMPag&_nc_oc=AdpGaF3NrpyvHGJAmc-yNRgW0BOFq0xxi7-8w4xuiNajgoh6VR25dUy3Xdzw7DJkxJs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0BCgICARzjUVxgS-sMUt22YNQrWz_r6LMzGEfGWYAmw&oe=6AB52D06"}, {"file_name": "Captura de pantalla 2026-04-19 145413_2x_1.5x.png", "id": "1117533490550846", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618499_1117533493884179_4870170364968926657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jz6CPu0wgPgQ7kNvwEyDU64&_nc_oc=AdpQTuvCTSk8hUWg-3rwrKo40jG6Mi1vPAjKAvbB6QwGfFd3LbIRhqEgOLUXol1tUnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOOFkY_1BDsYc3OmsoQq-QBOspKNUyY5X_u4Bsz0S10A&oe=6AB54477"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apes [VR]", "keywords": ["Capuchin", "Gorilla", "Ape", "Tag", "Apes"], "long_description": "Apes is a fast-paced VR movement game inspired by games like Gorilla Tag and Capuchin, where players use their arms to run, climb, and launch themselves through the environment. Instead of using joysticks, your real arm movement controls how you move, creating a fun and physical gameplay experience.\n\nExplore different maps, swing across obstacles, and chase or escape other players in exciting multiplayer matches. Master the movement system to climb faster, jump farther, and outplay your opponents with skill and strategy.\n\nCustomize your ape with cosmetics, experiment with new movement tricks, and hang out with friends while exploring the world. Whether you're competing, practicing advanced movement, or just messing around in the maps, Apes is all about creativity, speed, and chaotic monkey energy.\n\nJump in, start climbing, and see how fast you can become the ultimate ape.", "short_description": "Apes vr is a Gorilla tag and Capuchin fangame, where, as expected, you move with your arms and play around with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://user3-ship-it.github.io/FlipONERSStuff/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FlipONER", "support_website_url": null, "website_url": "https://user3-ship-it.github.io/FlipONERSStuff/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
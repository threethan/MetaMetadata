d": "2001909853780799", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499619681_2001909857114132_5917169290183950131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzE6MAqRqNkQ7kNvwE8wifZ&_nc_oc=AdphwX3gZ24sEoZaQqXc5tmzLBc_ODRF61GcYg9yZLTh4dXuFHjacrx3Rh3cEMqVZRQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL61LrMzm_kOhjW_Volaox1CMYec0BfyYs4r9uoCqGYfw&oe=6AA94F86"}, {"file_name": "Captura de pantalla 2026-04-19 145413_2x_1.5x.png", "id": "1117533490550846", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618499_1117533493884179_4870170364968926657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V13lOpxil8oQ7kNvwHSdueg&_nc_oc=AdqDf8Dx3Oq2mo9vottl-N-_Bc9FIOr1dKTRgPPkCZTzgad6gnDK7kjhSPkM9aH2Z1E&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8ejqj8Vai6Y6oBjhk_Rnml3cVUIuR2-c8goFZPOulpw&oe=6AA966F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apes", "keywords": ["Capuchin", "Gorilla", "Ape", "Tag", "Apes"], "long_description": "Apes is a fast-paced VR movement game inspired by games like Gorilla Tag and Capuchin, where players use their arms to run, climb, and launch themselves through the environment. Instead of using joysticks, your real arm movement controls how you move, creating a fun and physical gameplay experience.\n\nExplore different maps, swing across obstacles, and chase or escape other players in exciting multiplayer matches. Master the movement system to climb faster, jump farther, and outplay your opponents with skill and strategy.\n\nCustomize your ape with cosmetics, experiment with new movement tricks, and hang out with friends while exploring the world. Whether you're competing, practicing advanced movement, or just messing around in the maps, Apes is all about creativity, speed, and chaotic monkey energy.\n\nJump in, start climbing, and see how fast you can become the ultimate ape.", "short_description": "Apes vr is a Gorilla tag and Capuching fangame, where, as expected, you move with your arms and play around with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://user3-ship-it.github.io/FlipONERSStuff/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FlipONER", "support_website_url": null, "website_url": "https://user3-ship-it.github.io/FlipONERSStuff/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28001084336178126"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1520003533177922"}]}, "baseline_offer": {"id": "1520003533177922"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787171520, "status": "PUBLISHED", "id": "1520003533177922"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28320882507531639", "version": "13.31.39"}, "id": "1482860203474526", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26596899476596626", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28320882507531639"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes":
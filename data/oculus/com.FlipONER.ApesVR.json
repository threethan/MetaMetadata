=6AC522C7"}]}, "id": "1067699978974691", "locale": "en_US", "screenshots": [{"file_name": "Captura de pantalla 2026-04-19 145525_2x_1.5x.png", "id": "1653587385833640", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618515_1653587389166973_2374851509751393723_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVDD8Waqp3YQ7kNvwHIEYGJ&_nc_oc=Adogile6t0oiT8Omq6TfI6Jxmnc8lhnX1LfVsGp77fkDBeRwDsOahdXKgyFAzO31xcs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuKvUJLYakuY70eNu3tdikNoaTqOLKv49iKyv5ZD1vhQ&oe=6AC4F223"}, {"file_name": "Captura de pantalla 2026-04-19 145509_2x_1.5x.png", "id": "953909380850398", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620921_953909384183731_2760099021664216123_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYEnqAgs-UAQ7kNvwFxkgUU&_nc_oc=AdpnROEmzoG-h5JNvS4YFAOk4g3nA45a2GsPSkbDD6Nz6Gc2OaHMFNAe9kJtg0i0BIk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMedcLZsenVcdPx1-YgW0YzdX6HdXjWIT6MdEWH51R4RQ&oe=6AC4FE45"}, {"file_name": "Captura de pantalla 2026-04-19 145429_2x_1.5x.png", "id": "1566364612164267", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499626172_1566364615497600_7960032339533855945_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nQqNw2F_uYQ7kNvwHVOz9C&_nc_oc=Ado7wHrkoTRKctouM7shh2U9yGOsLsiNDijC-INoDe5_YXRcLobbMyvubm9JD-fC69Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAXMF9Uryt-TD8XPb3Eer503K9lwMX5nA9OBEfhz-DGg&oe=6AC4F305"}, {"file_name": "Captura de pantalla 2026-04-19 145450_2x_1.5x.png", "id": "2001909853780799", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619681_2001909857114132_5917169290183950131_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0PSV8cuAj0Q7kNvwHYtS9L&_nc_oc=AdpGyOLVhMk5RNu_BQ-VeI0--wlQ18D73v2rl0KRJmVAubWMP9gY_ak1y20Q_0Ssmbg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM8IyHrjDl2XF_5QsNRFaLmq67_nzFYGRE0bbbH7kUSg&oe=6AC4FF06"}, {"file_name": "Captura de pantalla 2026-04-19 145413_2x_1.5x.png", "id": "1117533490550846", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618499_1117533493884179_4870170364968926657_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrPwG-in6dgQ7kNvwGLCn0D&_nc_oc=AdqGO05afutsZlVhQBtHX0jndiXEg8Rmcc2cy8VOI2hAo5w1B58Bp9eL2pckAm3d1CA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkjKOwx3psZF7Dad8gURrVAH8wi5EBavVWr2ODJI7VNQ&oe=6AC51677"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Apes [VR]", "keywords": ["Capuchin", "Gorilla", "Ape", "Tag", "Apes"], "long_description": "Apes is a fast-paced VR movement game inspired by games like Gorilla Tag and Capuchin, where players use their arms to run, climb, and launch themselves through the environment. Instead of using joysticks, your real arm movement controls how you move, creating a fun and physical gameplay experience.\n\nExplore different maps, swing across obstacles, and chase or escape other players in exciting multiplayer matches. Master the movement system to climb faster, jump farther, and outplay your opponents with skill and strategy.\n\nCustomize your ape with cosmetics, experiment with new movement tricks, and hang out with friends while exploring the world. Whether you're competing, practicing advanced movement, or just messing around in the maps, Apes is all about creativity, speed, and chaotic monkey energy.\n\nJump in, start climbing, and see how fast you can become the ultimate ape.", "short_description": "Apes vr is a Gorilla tag and Capuchin fangame, where, as expected, you move with your arms and play around with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://user3-ship-it.github.io/FlipONERSStuff/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FlipONER", "support_website_url": null, "website_url": "https://user3-ship-it.github.io/FlipONERSStuff/index.html", "category": null, "comfort_rating": "COMFORTABLE_F
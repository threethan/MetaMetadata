5771-25/499619805_25585023214524272_3875049790578712641_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKOL0diOUQYQ7kNvwF4WgbU&_nc_oc=AdrYojzfzIpof8P4GIXN5wsBwBjU0eFDnyb5PCQIN_xUx9GHBZdqqm3bODBMVQaKjro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEusO-Xed-uyJm69dSDw4YeabVNEj-avIa7IifZBhBrSA&oe=6A92BDE4"}, {"file_name": "5.png", "id": "927588693167420", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622315_927588699834086_7078030325816770901_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUpGWdd-1UAQ7kNvwEcgAuA&_nc_oc=Adra-8b7DKFc6L0AVVRvdLizDZNxxK8FiQwnt5EAcVW7nXZ9Mtvy9BXusQH-EAfxzjo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3r2U6rscwDrXRN_JmfwOM9VHs3oQZ06V51sPKTHWXQw&oe=6A92C697"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1774690216548011", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622334_1774690219881344_1439981286382078634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ugFTBKQi5wQ7kNvwEZc391&_nc_oc=AdrfTEZUge5pHgEc2Ic-dRz_EEsCztowE_nkHwWbCxisGFqhgghu6kZguUED1JML6Zc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOiP6tg32ZyV3wc832ClllfFFap4SIpriq0Itt4rlgFg&oe=6A92C5DC"}, "display_name": "SkiingRush VR", "keywords": ["ski", "sportsvr", "simulation", "skiing", "wintersports"], "long_description": "SkiingRush VR is a fast-paced virtual reality skiing experience focused on speed, flow, and progression.\n\nRide down snowy mountains in full VR, carve through sharp turns, avoid obstacles, and push your limits to collect as many Ice Crystals as possible. Every run challenges your control, timing, and balance as you race through dynamic downhill slopes.\n\nIce Crystals are the key to progression. Collect them during your runs to unlock new maps, each with unique terrain, steeper slopes, and more demanding routes. The further you go, the faster and more intense the experience becomes.\n\nDesigned for smooth performance on Meta Quest, SkiingRush VR offers intuitive controls, satisfying movement, and a constant sense of momentum that keeps every run exciting.\n\n\ud83d\udd25 Key Features\n\nHigh-speed VR skiing with responsive, body-lean-based controls\n\nIce Crystal collection system to unlock new maps\n\nMultiple downhill environments with increasing difficulty\n\nFast, replayable runs focused on skill and progression\n\nOptimized for Meta Quest standalone VR\n\nEasy to start, challenging to master\n\nFeel the speed. Collect the crystals. Unlock the mountain.", "short_description": "High-speed VR skiing with realistic physics, steep slopes, and pure adrenaline"}]}, "developer_name": "SeiVR", "developer_privacy_policy_url": "https://sites.google.com/view/jonesei/privacy", "developer_terms_of_service_url": null, "publisher_name": "SeiVR", "support_website_url": null, "website_url": "https://sites.google.com/view/jonesei/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26214739494816501"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622211_726083150366030_1329449869342729904_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9TgPvIc2HcQ7kNvwGKBtWr&_nc_oc=AdoRTrAhL-qTtPeIBZZJhlDZGPPyrtkdU_Y6wmZdAEnw0htcZitUyypTsIGCdO-8yNg&_nc_zt=3&_nc_ht=scontent-sea5-
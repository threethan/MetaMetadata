7&_nc_sid=6e7a0a&_nc_ohc=ZHSxH40cEIAQ7kNvwEklVS0&_nc_oc=AdrnoKdeROFBH8MMQoTKead5r6ejqc64cWu5tII0fVuqok4xaUuhiHOTLu9Y-KpwKaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY51dpyRR3csiafhprvB2ZZIQI02nmR86zW7wVg6B-kw&oe=6B045724"}, {"file_name": "5.png", "id": "927588693167420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622315_927588699834086_7078030325816770901_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qiehgmvrBUQ7kNvwF2Pt0v&_nc_oc=AdqDrrppGKr1-3F9G-wxDAPBYMp14cPhh6ZwJEWl1HKQ3vrTQmml8YA3sNP7EHFWs-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWN2X2rLiGRlUyaSr4xFtuZanuyzPmv9Yx5xOQRdyH8g&oe=6B045FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1774690216548011", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1774690219881344_1439981286382078634_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9xC6p_wko0Q7kNvwGAhpIa&_nc_oc=AdpVK8tyJtHCWxGhZc3E7djTk7astHx70uzMDFKp1Wln6S7bK1l0zckVeXTooohjaI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMgRF66nrKPOhRr6HjEBNnCCtyz1H2TuRidYzQjDo2lg&oe=6B045F1C"}, "display_name": "SkiingRush VR", "keywords": ["ski", "sportsvr", "simulation", "skiing", "wintersports"], "long_description": "SkiingRush VR is a fast-paced virtual reality skiing experience focused on speed, flow, and progression.\n\nRide down snowy mountains in full VR, carve through sharp turns, avoid obstacles, and push your limits to collect as many Ice Crystals as possible. Every run challenges your control, timing, and balance as you race through dynamic downhill slopes.\n\nIce Crystals are the key to progression. Collect them during your runs to unlock new maps, each with unique terrain, steeper slopes, and more demanding routes. The further you go, the faster and more intense the experience becomes.\n\nDesigned for smooth performance on Meta Quest, SkiingRush VR offers intuitive controls, satisfying movement, and a constant sense of momentum that keeps every run exciting.\n\n\ud83d\udd25 Key Features\n\nHigh-speed VR skiing with responsive, body-lean-based controls\n\nIce Crystal collection system to unlock new maps\n\nMultiple downhill environments with increasing difficulty\n\nFast, replayable runs focused on skill and progression\n\nOptimized for Meta Quest standalone VR\n\nEasy to start, challenging to master\n\nFeel the speed. Collect the crystals. Unlock the mountain.", "short_description": "High-speed VR skiing with realistic physics, steep slopes, and pure adrenaline"}]}, "developer_name": "SeiVR", "developer_privacy_policy_url": "https://sites.google.com/view/jonesei/privacy", "developer_terms_of_service_url": null, "publisher_name": "SeiVR", "support_website_url": null, "website_url": "https://sites.google.com/view/jonesei/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26214739494816501"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1694450755186487"}, {"status": "PUBLISHED", "id": "1009633791484963"}, {"status": "PUBLISHED", "id": "1477754343810417"}, {"status": "PUBLISHED", "id": "1677269729973182"}, {"status": "PUBLISHED", "id": "2023937124819930"}, {"status": "PUBLISHED", "id": "25589263224090392"}]}, "baseline_offer": {"id": "2
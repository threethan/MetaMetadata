zCg_gzIJiBut25Pc7BfUVkrLzmHkLHX-w&oe=6B0C60AF"}, {"file_name": "2.png", "id": "1123757379745176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1123757383078509_8285053019607335261_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Idsl2z3XQ4Q7kNvwGeVOLp&_nc_oc=Adqo5K1vHEpepML3HX-SrLJqYmA9tAmxc1c578eHfH3fvh4Ww3orw_PjLGQll9n1uRk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyiFJ_4tGxIGlviXnttsTcmBT4XEY6J5xOpKcJfIDHQQ&oe=6B0C6076"}, {"file_name": "4.png", "id": "25585023211190939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_25585023214524272_3875049790578712641_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HTKrIB28y4Q7kNvwGMMncf&_nc_oc=Ado2SwgWsfBqwjz1XAL5ANMpiku0aSmQZ37uwUWgGNAeJedpzFqkcc4C_FhMoD5Hh5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSZ2CCE0k5BVvOpM07PyPYweXViztetb6ny9yWAOS0bw&oe=6B0C7864"}, {"file_name": "5.png", "id": "927588693167420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622315_927588699834086_7078030325816770901_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRS-hw2URyoQ7kNvwFu-XC8&_nc_oc=Adp9Spg0cWKrV-oV_ph69PnIrLhg72BclTiijB4c3XRstuhtyi0T80Js_ZMMYVjxxZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ251KSwTIpMfHcFVpFwZ44a4sfxzz8Y3r66KfOtOPUBQ&oe=6B0C8117"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1774690216548011", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1774690219881344_1439981286382078634_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IWNj46Y7DoQ7kNvwE9OM_E&_nc_oc=AdrdIPosaAP-3uWjBhSmLwCpuSUitml3JTJ38VbTCmX1KetZfzFMvZx6njOqq0DtiVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLZjrhT9--jW5sjdZpjtna1ycB1OVzI7VOMpEtqLQMtA&oe=6B0C805C"}, "display_name": "SkiingRush VR", "keywords": ["ski", "sportsvr", "simulation", "skiing", "wintersports"], "long_description": "SkiingRush VR is a fast-paced virtual reality skiing experience focused on speed, flow, and progression.\n\nRide down snowy mountains in full VR, carve through sharp turns, avoid obstacles, and push your limits to collect as many Ice Crystals as possible. Every run challenges your control, timing, and balance as you race through dynamic downhill slopes.\n\nIce Crystals are the key to progression. Collect them during your runs to unlock new maps, each with unique terrain, steeper slopes, and more demanding routes. The further you go, the faster and more intense the experience becomes.\n\nDesigned for smooth performance on Meta Quest, SkiingRush VR offers intuitive controls, satisfying movement, and a constant sense of momentum that keeps every run exciting.\n\n\ud83d\udd25 Key Features\n\nHigh-speed VR skiing with responsive, body-lean-based controls\n\nIce Crystal collection system to unlock new maps\n\nMultiple downhill environments with increasing difficulty\n\nFast, replayable runs focused on skill and progression\n\nOptimized for Meta Quest standalone VR\n\nEasy to start, challenging to master\n\nFeel the speed. Collect the crystals. Unlock the mountain.", "short_description": "High-speed VR skiing with realistic physics, steep slopes, and pure adrenaline"}]}, "developer_name": "SeiVR", "developer_privacy_policy_url": "https://sites.google.com/view/jonesei/privacy", "developer_terms_of_service_url": null, "publisher_name": "SeiVR", "support_website_url": null, "website_url": "https://sites.google.com/view/jonesei/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
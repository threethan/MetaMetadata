t=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMTlkJqDbAcEUcqvRY3ODb_mn9CnJ0bqv_qbvAlnb0tg&oe=6ACB9467"}, {"file_name": "Screenshot5.png", "id": "2044339279831858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_2044339283165191_3552125756977829880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ps5Ed_mKt1gQ7kNvwEK7PsG&_nc_oc=AdpECGKfYWfAy-IISKaAsw75cQFvkImgtfIPGgyY0TDwWqhTVTmzCVXKh2npnSUBdfA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNycb_dz8bwvaQfv2z5WlVwsRv7A94y0Wdlisg4DmJ-_w&oe=6ACBC2DA"}, {"file_name": "Screenshot3.png", "id": "1496106725304230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1496106728637563_8982293806467625680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbXE9SDDO00Q7kNvwEWJRCe&_nc_oc=Adop4uktws2I4WpFIBcucisWEQLU_b6U9XNYo-r13NNGMVTRXUQmxtvviZK8HexAlHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmpsTYVLWgx5d3DrRy3Z-4oxbaxDHNnw7BXapjVySS6A&oe=6ACBB121"}, {"file_name": "Screenshot1.png", "id": "1326701139269758", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_1326701142603091_7252839890358147190_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tXw1-IoDtoQ7kNvwHNvLqg&_nc_oc=AdpedmFQlYbQpTIPs3H4mh5xM8dGagZDWiyCqShspYRBDun1SNAVXaP8SxsqcFgqcN4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeq4wm6Wacy8ktjaPqn-Nee8D3aGJGB19uUrfqdfcP2g&oe=6ACBB494"}, {"file_name": "Screenshot4.png", "id": "1673640950660004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_1673640957326670_5966886239856661691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC5lOzIiM-wQ7kNvwFbUoA_&_nc_oc=AdorVztFpe0qzDRHViIpSXuAMTgpy4tb33RMsL6468xkT8P_ullGr2o0Dwv0yygRS7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKTLuvkVUkcJ4BNHpPoDSey3Uf-tujj6crXw68LLhRqA&oe=6ACBA9EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mefager", "keywords": ["Mefager", "MefaTeam", "MefagerVR", "Boreg", "mefager"], "long_description": "Welcome to Mefager, a fun low-poly VR experience made especially for players in Israel. Start your adventure in a cozy forest environment featuring rolling green hills, a warm spawn house where players begin, a cosmetics area to customize your look, and a playful slide to enjoy with friends.\n\nMefager is built as a social and movement-focused VR world where players can explore, hang out, and have fun in a relaxing outdoor map inspired by classic VR playground experiences. The simple low-poly style gives the game a charming and nostalgic feel while keeping the world bright and easy to enjoy.\n\nThis is only the beginning \u2014 many more maps, areas, and exciting updates are planned for the future. New environments, new places to explore, additional cosmetics, and fresh content will continue to be added over time so the world of Mefager keeps growing.\n\nMade for the Israeli community, Mefager aims to be a fun place for local players to meet, play, and enjoy new adventures together.", "short_description": "Mefager is a low-poly VR playground for Israelis, featuring a cozy forest map with a spawn cabin, cosmetic station, and a fun slide area for exploring and hanging out with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nIY9xio4KMnVTsGHyFuIyDbClvdL1WqBk6Qt7IFWMnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RB19iGruCCcgvOccsswAr872GxvOaxmnbA7Dnlp4q_0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "
: "Screenshot5.png", "id": "2044339279831858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824328_2044339283165191_3552125756977829880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPy29TTh2WwQ7kNvwF1AZZT&_nc_oc=AdpTCTD8cFab_x-ng4koFpqAhwICJJ0IU9Oi4kHF_QKmFHXkbh1xFhceor3oqKj9jrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVbLJEyt_WYFEMgNCBuy40kae780sj8RN-2-VOF62HNA&oe=6AC136DA"}, {"file_name": "Screenshot3.png", "id": "1496106725304230", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_1496106728637563_8982293806467625680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFVjN3ajBDwQ7kNvwEsb35w&_nc_oc=AdpfqYysNde9Zj47uT5_AyahxhThn9TjHDqNye_R2GJ8xf3ZcBmV9BX4B0eRlFRvV80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGO6Y2DQ1vckl5s4091xmsfFc3Yv0kaSmofc2kB84mkQ&oe=6AC12521"}, {"file_name": "Screenshot1.png", "id": "1326701139269758", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_1326701142603091_7252839890358147190_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6FzXMkhIjIQ7kNvwFjlJyq&_nc_oc=Adrh_iw30WfUc0WapNupyhJDzjiZRuy2aI37kRn3d_u1nYaq1VZ2X-NzjUAPK8rJ734&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy6KGtN1wk-GABXa1NG43lfxLhXktVg2oLXwu0ICQDoA&oe=6AC12894"}, {"file_name": "Screenshot4.png", "id": "1673640950660004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_1673640957326670_5966886239856661691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NSMsgOQZqAQ7kNvwHlc_qL&_nc_oc=AdpB5GWZ-rhaNDYKuGtA2G34sb0zVkijDk1oShaOy7DoESoqBV84yoi9Wiyg7wEDN_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoYZmEgaC4zc3XX8RBD7o5eJxi3xYja1Gk3yZa1ODErg&oe=6AC11DEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mefager", "keywords": ["Mefager", "MefaTeam", "MefagerVR", "Boreg", "mefager"], "long_description": "Welcome to Mefager, a fun low-poly VR experience made especially for players in Israel. Start your adventure in a cozy forest environment featuring rolling green hills, a warm spawn house where players begin, a cosmetics area to customize your look, and a playful slide to enjoy with friends.\n\nMefager is built as a social and movement-focused VR world where players can explore, hang out, and have fun in a relaxing outdoor map inspired by classic VR playground experiences. The simple low-poly style gives the game a charming and nostalgic feel while keeping the world bright and easy to enjoy.\n\nThis is only the beginning \u2014 many more maps, areas, and exciting updates are planned for the future. New environments, new places to explore, additional cosmetics, and fresh content will continue to be added over time so the world of Mefager keeps growing.\n\nMade for the Israeli community, Mefager aims to be a fun place for local players to meet, play, and enjoy new adventures together.", "short_description": "Mefager is a low-poly VR playground for Israelis, featuring a cozy forest map with a spawn cabin, cosmetic station, and a fun slide area for exploring and hanging out with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nIY9xio4KMnVTsGHyFuIyDbClvdL1WqBk6Qt7IFWMnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RB19iGruCCcgvOccsswAr872GxvOaxmnbA7Dnlp4q_0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
83165191_3552125756977829880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2a-NMu1G5bAQ7kNvwHXE2sM&_nc_oc=AdrHtwroUXqHAiicSvmgdYdCMp_HcbyisCISMeAIjC8GT-2ETHiHIlxN1Rif2wvr0_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fz_uShqfFmILPEPKirJiqKP07K-5IOcxLcKmvgWmdKw&oe=6A086C9A"}, {"file_name": "Screenshot3.png", "id": "1496106725304230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1496106728637563_8982293806467625680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj_BxIyB1aQQ7kNvwGI3gY8&_nc_oc=Adoe3izBEa0qZDOYwtNAgyemRE9AhRLsxEnmpwdWKZWZoXOG3ue8-sCpXHjDfAzIQjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72bBkCQEX8yX6wGFR--zFijPtMEIxrRcsT8jNS2_b-JA&oe=6A089321"}, {"file_name": "Screenshot1.png", "id": "1326701139269758", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1326701142603091_7252839890358147190_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3XP9kqLOCMQ7kNvwGso-nI&_nc_oc=AdpsetKFDS9BZtKkvQt11MQB99jH-3tbdfd9qVfKzu9p-E1_A1gMfRjhSva8HRFCA8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61ZtunUc6_at4456J7hCX61nyRExstgqEpYfcypUODhw&oe=6A089694"}, {"file_name": "Screenshot4.png", "id": "1673640950660004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1673640957326670_5966886239856661691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M-rThrroA4Q7kNvwFdFWFA&_nc_oc=Adpb-GxmHCXudlG_EmLckyMvbVdiew9kVlqu07CnYGykNkHpgvFjepuqA0Zuxq5hUkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7coHNnLwvW9tKH9i3PNLKTJSktwsadLAisfr-a162HSg&oe=6A088BEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mefager", "keywords": ["Mefager", "MefaTeam", "MefagerVR", "Boreg", "mefager"], "long_description": "Welcome to Mefager, a fun low-poly VR experience made especially for players in Israel. Start your adventure in a cozy forest environment featuring rolling green hills, a warm spawn house where players begin, a cosmetics area to customize your look, and a playful slide to enjoy with friends.\n\nMefager is built as a social and movement-focused VR world where players can explore, hang out, and have fun in a relaxing outdoor map inspired by classic VR playground experiences. The simple low-poly style gives the game a charming and nostalgic feel while keeping the world bright and easy to enjoy.\n\nThis is only the beginning \u2014 many more maps, areas, and exciting updates are planned for the future. New environments, new places to explore, additional cosmetics, and fresh content will continue to be added over time so the world of Mefager keeps growing.\n\nMade for the Israeli community, Mefager aims to be a fun place for local players to meet, play, and enjoy new adventures together.", "short_description": "Mefager is a low-poly VR playground for Israelis, featuring a cozy forest map with a spawn cabin, cosmetic station, and a fun slide area for exploring and hanging out with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nIY9xio4KMnVTsGHyFuIyDbClvdL1WqBk6Qt7IFWMnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RB19iGruCCcgvOccsswAr872GxvOaxmnbA7Dnlp4q_0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
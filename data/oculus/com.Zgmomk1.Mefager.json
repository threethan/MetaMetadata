vwFVPVZ7&_nc_oc=Adpg0Tpc22wFekdz6fC-4qN2ZMPC8gqu9UKlLSERud-d2FAjhHiPbeNL9SE11FDLHRo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVs2VuwQMa-qg6s9IxobLOepJaVoHpvbXxP4R3s8LV4g&oe=6AE8B594"}, {"file_name": "Screenshot4.png", "id": "1673640950660004", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823296_1673640957326670_5966886239856661691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qXhxyI6VYoQ7kNvwHEGR7g&_nc_oc=AdoWf-1l_q_Az_2Xy51iqQ3tSVnwd3mdkObVEfjdWFbwF0s0MBz5o_ZIHU7I2l8KurY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM2xdmqZGN5dksbjf3jc1bhMQS_B0pmJbPiybx5Yl9AA&oe=6AE8AAEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mefager", "keywords": ["Mefager", "MefaTeam", "MefagerVR", "Boreg", "mefager"], "long_description": "Welcome to Mefager, a fun low-poly VR experience made especially for players in Israel. Start your adventure in a cozy forest environment featuring rolling green hills, a warm spawn house where players begin, a cosmetics area to customize your look, and a playful slide to enjoy with friends.\n\nMefager is built as a social and movement-focused VR world where players can explore, hang out, and have fun in a relaxing outdoor map inspired by classic VR playground experiences. The simple low-poly style gives the game a charming and nostalgic feel while keeping the world bright and easy to enjoy.\n\nThis is only the beginning \u2014 many more maps, areas, and exciting updates are planned for the future. New environments, new places to explore, additional cosmetics, and fresh content will continue to be added over time so the world of Mefager keeps growing.\n\nMade for the Israeli community, Mefager aims to be a fun place for local players to meet, play, and enjoy new adventures together.", "short_description": "Mefager is a low-poly VR playground for Israelis, featuring a cozy forest map with a spawn cabin, cosmetic station, and a fun slide area for exploring 
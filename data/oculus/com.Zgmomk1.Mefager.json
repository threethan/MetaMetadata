64.5771-25/491821568_1496106728637563_8982293806467625680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uoGjGefDmoQ7kNvwHWKSyR&_nc_oc=AdpytZ9Rqrh46dJr79Hhr4G6Ke3YWgk4cE8daCHYoj3vl-Zuv2FHUet9c-5Aw1zxGWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2eTwYLCFswXzSWdvtukJuo_gFGriOSDB6WX98zZCCgjg&oe=69F09FE1"}, {"file_name": "Screenshot1.png", "id": "1326701139269758", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1326701142603091_7252839890358147190_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCP8ugaYEMUQ7kNvwEsMecT&_nc_oc=Adqht27LVFrBbLc2QgqR6CLF1djJmJCOK8GPG6AkBUtrn4hG4Z6lz_1PTujnnNEgVho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1DwjO2HVBmu32oWXwfbAPXPxKoddXPFASkd7voxrRycw&oe=69F0A354"}, {"file_name": "Screenshot4.png", "id": "1673640950660004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1673640957326670_5966886239856661691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw0Xcw4Wml0Q7kNvwFm9nsr&_nc_oc=AdokEPTpNwENei_m87Dk6C8aGOJnBMjvvyVi8vBS6_Iv9r3TDQ65mTYbZuQpGpKEw8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0TryPZbNjNlq6zxsvpZ2DQ9kfk5JJqGynI9hw3IX2dIA&oe=69F0D0EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mefager", "keywords": ["Mefager", "MefaTeam", "MefagerVR", "Boreg", "mefager"], "long_description": "Welcome to Mefager, a fun low-poly VR experience made especially for players in Israel. Start your adventure in a cozy forest environment featuring rolling green hills, a warm spawn house where players begin, a cosmetics area to customize your look, and a playful slide to enjoy with friends.\n\nMefager is built as a social and movement-focused VR world where players can explore, hang out, and have fun in a relaxing outdoor map inspired by classic VR playground experiences. The simple low-poly style gives the game a charming and nostalgic feel while keeping the world bright and easy to enjoy.\n\nThis is only the beginning \u2014 many more maps, areas, and exciting updates are planned for the future. New environments, new places to explore, additional cosmetics, and fresh content will continue to be added over time so the world of Mefager keeps growing.\n\nMade for the Israeli community, Mefager aims to be a fun place for local players to meet, play, and enjoy new adventures together.", "short_description": "Mefager is a low-poly VR playground for Israelis, featuring a cozy forest map with a spawn cabin, cosmetic station, and a fun slide area for exploring and hanging out with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nIY9xio4KMnVTsGHyFuIyDbClvdL1WqBk6Qt7IFWMnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RB19iGruCCcgvOccsswAr872GxvOaxmnbA7Dnlp4q_0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "26522988153990204"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2146811172761413"}]}, "baseline_offer": {"id": "2146811172761413"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776879000, "status": "PUBLISHED", "id": "2146811172761413"}]}, "liv
83165191_3552125756977829880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nj2mLUvwS6cQ7kNvwFf8rJF&_nc_oc=Adojcoq6cwdqrbK6KLeMh67uhwbuUdLJDWz2z27nCdMES-fqQk_RUbqhPSXH8jp1c3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgyfY5DK6sCRUhTEGpWedLTNF4ZGAr6Og193n7LLsUeQ&oe=6A73361A"}, {"file_name": "Screenshot3.png", "id": "1496106725304230", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821568_1496106728637563_8982293806467625680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DSfv5pKtUEQ7kNvwEaCZCF&_nc_oc=Adq26wLu088298jfeK1lkI3PIQMvyoG1YW8YmfpD5zOn3FiUNIo62h3d7omLjA1kaZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq-QOmCI6GMDwY1MeQfUBk_GttuqxB7YnChatblBhVjQ&oe=6A732461"}, {"file_name": "Screenshot1.png", "id": "1326701139269758", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825563_1326701142603091_7252839890358147190_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9fT4Ac202EQ7kNvwHk0efx&_nc_oc=AdqTnsR-fyKSrcWxa37jnWSREZtsrQJQ0mNw26lU0VmmXN-fLyzDeHnyq6jO2dhyklk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRimFbgMY4ECwppfspXi8uY07OlY5Rl_1hpC9Ruw36KA&oe=6A7327D4"}, {"file_name": "Screenshot4.png", "id": "1673640950660004", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823296_1673640957326670_5966886239856661691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgdmHfL0pgEQ7kNvwFIbUNx&_nc_oc=AdrX7lmEJnFLtix_5WGWlunE6z235MIL62lmqZjsygEyBaO0ztdw4rzyMSp-AihnLQ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOKyO2-XHF8_Ahro-PACuQQXuGmDxGltJHDWrzDd7LIQ&oe=6A73556F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mefager", "keywords": ["Mefager", "MefaTeam", "MefagerVR", "Boreg", "mefager"], "long_description": "Welcome to Mefager, a fun low-poly VR experience made especially for players in Israel. Start your adventure in a cozy forest environment featuring rolling green hills, a warm spawn house where players begin, a cosmetics area to customize your look, and a playful slide to enjoy with friends.\n\nMefager is built as a social and movement-focused VR world where players can explore, hang out, and have fun in a relaxing outdoor map inspired by classic VR playground experiences. The simple low-poly style gives the game a charming and nostalgic feel while keeping the world bright and easy to enjoy.\n\nThis is only the beginning \u2014 many more maps, areas, and exciting updates are planned for the future. New environments, new places to explore, additional cosmetics, and fresh content will continue to be added over time so the world of Mefager keeps growing.\n\nMade for the Israeli community, Mefager aims to be a fun place for local players to meet, play, and enjoy new adventures together.", "short_description": "Mefager is a low-poly VR playground for Israelis, featuring a cozy forest map with a spawn cabin, cosmetic station, and a fun slide area for exploring and hanging out with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nIY9xio4KMnVTsGHyFuIyDbClvdL1WqBk6Qt7IFWMnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RB19iGruCCcgvOccsswAr872GxvOaxmnbA7Dnlp4q_0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_playe
: "Screenshot5.png", "id": "2044339279831858", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824328_2044339283165191_3552125756977829880_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPzRIbJJ_AAQ7kNvwG3vgoB&_nc_oc=AdoLgVpE3ksxgB3pucLAHCcBxFZxEtUe74-EApaTQjRYN0H-wwot_OvHITqmL4LCcq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2zP339iQXS2WqSEj_beoIijveuo-1RBBlJ9fsoybWaA&oe=6AA2AC1A"}, {"file_name": "Screenshot3.png", "id": "1496106725304230", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821568_1496106728637563_8982293806467625680_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWlfXZtRRAsQ7kNvwG2FW1g&_nc_oc=AdoV-sdIsptXDKF9-NiKeNGhCcavuKg_h0rjoP4VYo9QJJDF74qJuGvSnWXHnhGXQjI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjgJJ1xzfmNuZOD-dSdZs9u3lX8piVtIGexfqwr7B2Qg&oe=6AA2D2A1"}, {"file_name": "Screenshot1.png", "id": "1326701139269758", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825563_1326701142603091_7252839890358147190_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlzU8sospYwQ7kNvwGHhowm&_nc_oc=Ado_PtClHJk1PF0Il0lHwZve4eU3jg0eZIqRP8i6fVwFHdnizxCHbzlIOOqRm8uGDaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbvLeHTpGht3kaooW3rVQYXHr8j63tCqmFfVQvnN-wHw&oe=6AA29DD4"}, {"file_name": "Screenshot4.png", "id": "1673640950660004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1673640957326670_5966886239856661691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXBMZnNPwIYQ7kNvwHhdCwk&_nc_oc=AdqS81XazsGRY7tnTT56CelF9lGGcYaAY2f-umwxJp7BfQ3mw5gP8-NrqBprkmIsCUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzlXiOKIUtrjuPo5Ot5mDM78hvdRAAkdwV-j6NszvXVg&oe=6AA2CB6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mefager", "keywords": ["Mefager", "MefaTeam", "MefagerVR", "Boreg", "mefager"], "long_description": "Welcome to Mefager, a fun low-poly VR experience made especially for players in Israel. Start your adventure in a cozy forest environment featuring rolling green hills, a warm spawn house where players begin, a cosmetics area to customize your look, and a playful slide to enjoy with friends.\n\nMefager is built as a social and movement-focused VR world where players can explore, hang out, and have fun in a relaxing outdoor map inspired by classic VR playground experiences. The simple low-poly style gives the game a charming and nostalgic feel while keeping the world bright and easy to enjoy.\n\nThis is only the beginning \u2014 many more maps, areas, and exciting updates are planned for the future. New environments, new places to explore, additional cosmetics, and fresh content will continue to be added over time so the world of Mefager keeps growing.\n\nMade for the Israeli community, Mefager aims to be a fun place for local players to meet, play, and enjoy new adventures together.", "short_description": "Mefager is a low-poly VR playground for Israelis, featuring a cozy forest map with a spawn cabin, cosmetic station, and a fun slide area for exploring and hanging out with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nIY9xio4KMnVTsGHyFuIyDbClvdL1WqBk6Qt7IFWMnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RB19iGruCCcgvOccsswAr872GxvOaxmnbA7Dnlp4q_0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "reco
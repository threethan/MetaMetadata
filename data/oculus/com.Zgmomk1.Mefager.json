v/t64.5771-25/491825563_1326701142603091_7252839890358147190_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FGx4vccxeAQ7kNvwFMmvxn&_nc_oc=Adp0KNDKmPzeNxDhnW3gRNtMXsTAF5oIbIF7-6vEK_qxrUf6Y41CDrX0ZXHfLc_FldU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMto6dwEfZHaS3SBFMgKlT_PQcuCqBJSXRhd3u5g9ObQ&oe=6AF49314"}, {"file_name": "Screenshot4.png", "id": "1673640950660004", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_1673640957326670_5966886239856661691_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCTv2mUHb1YQ7kNvwHt2_2u&_nc_oc=AdqI5Uw38MqxFJYejtCkwfy7qIvclO_Hqohzcw2uRlJtka_RLCgI4tB4o9Q8CTfGQ2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgFN0Oeoo5oE8P2UfYXe-ne6jtXzeMMZdmnuqPHsalYg&oe=6AF4886F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mefager", "keywords": ["Mefager", "MefaTeam", "MefagerVR", "Boreg", "mefager"], "long_description": "Welcome to Mefager, a fun low-poly VR experience made especially for players in Israel. Start your adventure in a cozy forest environment featuring rolling green hills, a warm spawn house where players begin, a cosmetics area to customize your look, and a playful slide to enjoy with friends.\n\nMefager is built as a social and movement-focused VR world where players can explore, hang out, and have fun in a relaxing outdoor map inspired by classic VR playground experiences. The simple low-poly style gives the game a charming and nostalgic feel while keeping the world bright and easy to enjoy.\n\nThis is only the beginning \u2014 many more maps, areas, and exciting updates are planned for the future. New environments, new places to explore, additional cosmetics, and fresh content will continue to be added over time so the world of Mefager keeps growing.\n\nMade for the Israeli community, Mefager aims to be a fun place for local players to meet, play, and enjoy new adventures together.", "short_description": "Mefager is a low-poly VR playground for Israelis, featuring a cozy forest map with a spawn cabin, cosmetic station, and a fun slide area for exploring and hanging out with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1nIY9xio4KMnVTsGHyFuIyDbClvdL1WqBk6Qt7IFWMnQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1RB19iGruCCcgvOccsswAr872GxvOaxmnbA7Dnlp4q_0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "26522988153990204"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314659_1592297921874871_7848629408404273095_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg4y4FmqKScQ7kNvwEzaD70&_nc_oc=AdrHNlZogxn2IkLP9vVLZ3y9ELIAUmKMi9QaXWaMDeiEXIiQkUU7leF_84-g1HN4eLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSnuv4SVRQUs7Hamij5K6af-SqKrUumyq3oj56P9xsQg&oe=6AF48E0D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mefager", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [
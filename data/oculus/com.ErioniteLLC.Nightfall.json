A4"}, {"file_name": "nightfall screenshot 3.png", "id": "1065599051793145", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003255_1065599055126478_5756926247023560827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urlWMzH_-L8Q7kNvwEx58a1&_nc_oc=Adq6GQ4ZTWGHrqc7lXTkXUUlrbFDOhv15oi9A4DwgJeMtCXpkZGmfmDxueRd9nn09ko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TodFeW-2ftYdqdj7T37bDC24_fe5Nn7s_9rJ6nzS6aw&oe=6A03225E"}, {"file_name": "nightfall screenshot 2.png", "id": "1497879470857351", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001672_1497879474190684_2876899868746329028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtCIlbJUJPgQ7kNvwE0b_sd&_nc_oc=AdqosFJWFO-Vd4qriLFPBh4asU50u8zbgqrL74extErNRVX5-U2F07UeIFxE6Cvvyys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MkqEWmX_QayiE1vVC0eQqltOBseHOoba8aMkIM6ckng&oe=6A032FEF"}, {"file_name": "nightfall screenshot 5.png", "id": "388945917321262", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031338_388945920654595_4821277616870504580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-jt-PkMOuwQ7kNvwH9ZGAu&_nc_oc=AdqwOaKTspdNZsIoSpDeYXMLEpTW0Gp1uu2lcSxJ4XqS6mm-oE1nksWX1YSkairYO1Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P1EUUH3v4fYc2siliDDv2OAmw00SBnxLPgeNA5ol7og&oe=6A032458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightfall VR", "keywords": ["nightfall", "vr", "applab", "ape", "gorilla"], "long_description": "Welcome to NIGHTFALL VR!\n\nThis is one of my first official larger projects.\nI plan on Implenting a TON of community ideas, for that join our discord.\n\nDrop some down in our DISCORD: https://discord.gg/CNr4H6P9R7\nCheck out our privacy policy for any concerns, if any concerns pop up, please send over a message to my email: darkifiedd@gmail.com\n\nI've spent approximately 4-6 months alone learning how to use unity, on a previous game that I had named \"Ape City\", on top of another 6 months put into gelada + grand highlands..\n\nThis game is basically the re-embarkment of GELADA and Unreleased Grand Highlands!\n\nWith the help of Malex (developer of Just Chimpin + Grenade Game) (who is also the coder) we managed to develop the game you currently know as \"NIGHTFALL VR\"\n\nThank you all, seriously, it means a lot.\n\nAlso P.S. \nWatch out for \"big john\"...", "short_description": "Welcome to NIGHTFALL VR!\n\nAny ideas will be credited in a little secret compartment in-game!\n\nDrop some down in our DISCORD: https://discord.gg/CNr4H6P9R7\n\nCheck out our privacy policy for any concerns, if any concerns pop up, please send over a message to my email: darkifiedd@gmail.com\n\nThis game is basically the re-embarkment of GELADA and Unreleased Grand Highlands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfall-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "robbedauthor", "support_website_url": null, "website_url": "https://sites.google.com/view/nightfall-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7403957919707208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974767_8032855713488235_9115003381274114216_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60jvdsrlJH
nshot 3.png", "id": "1065599051793145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_1065599055126478_5756926247023560827_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQwblwu_MKQQ7kNvwHMCAkR&_nc_oc=Adn9CjWmfzBijOl8_5lLZKrU524VmuCcwMjT2h6ulQWJptjDiHO12EfeyoQuIkKnU4Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwurt2NRvcV0COi-FD45ytK4ySI7z7oRKOCsF0zg7j58A&oe=69AD70DE"}, {"file_name": "nightfall screenshot 2.png", "id": "1497879470857351", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001672_1497879474190684_2876899868746329028_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWmFcfpE4mEQ7kNvwE7u8Lp&_nc_oc=AdkOLPJE4_397XvpHuWL7lzikra9XytaOXPrzM_S5rfvSdppIrAKZ-JcPtTmhBAJH0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwV0DDbu4Um0NtAuoYFtKlBn8GS5zdIPxoHrev9pQvbVw&oe=69AD7E6F"}, {"file_name": "nightfall screenshot 5.png", "id": "388945917321262", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031338_388945920654595_4821277616870504580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiwBxksAElgQ7kNvwFkwCTt&_nc_oc=Adm0U4U0DL7QeWE_VECKyyj04czFqDPTQy1pYG9j2Egr4Ictwfm4XuodMzmGwPeMxq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGqTlmIrYiAEabojn-BgaqBqCKyr86x58BKB-daLxVrg&oe=69AD72D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightfall VR", "keywords": ["nightfall", "vr", "applab", "ape", "gorilla"], "long_description": "Welcome to NIGHTFALL VR!\n\nThis is one of my first official larger projects.\nI plan on Implenting a TON of community ideas, for that join our discord.\n\nDrop some down in our DISCORD: https://discord.gg/CNr4H6P9R7\nCheck out our privacy policy for any concerns, if any concerns pop up, please send over a message to my email: darkifiedd@gmail.com\n\nI've spent approximately 4-6 months alone learning how to use unity, on a previous game that I had named \"Ape City\", on top of another 6 months put into gelada + grand highlands..\n\nThis game is basically the re-embarkment of GELADA and Unreleased Grand Highlands!\n\nWith the help of Malex (developer of Just Chimpin + Grenade Game) (who is also the coder) we managed to develop the game you currently know as \"NIGHTFALL VR\"\n\nThank you all, seriously, it means a lot.\n\nAlso P.S. \nWatch out for \"big john\"...", "short_description": "Welcome to NIGHTFALL VR!\n\nAny ideas will be credited in a little secret compartment in-game!\n\nDrop some down in our DISCORD: https://discord.gg/CNr4H6P9R7\n\nCheck out our privacy policy for any concerns, if any concerns pop up, please send over a message to my email: darkifiedd@gmail.com\n\nThis game is basically the re-embarkment of GELADA and Unreleased Grand Highlands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nightfall-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "robbedauthor", "support_website_url": null, "website_url": "https://sites.google.com/view/nightfall-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7403957919707208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974767_8032855713488235_9115003381274114216_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1QG0JSLI6IQ7kNvwFqVyhT&_nc_oc=Adn7gctIg_hZ12LahEtXTyvDHSq
Z0TIpwWD-6Ftp3HaNo9Zitz4V4QZWaDXg&oe=69AFFFE8"}, {"file_name": "migrated_image.png", "id": "216008733097682", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162679_1644574582261757_2563065396525531136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzIfc8qBvNIQ7kNvwEs7UmI&_nc_oc=Admqifa1y0bMfJz4ci5N-k2SDffq5aUc4aNQFMEdZ4hLRPyL3KFQeZ6PqxGzBMY2YO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzyuj76cHpu8UAfr7oU02gEIRddvkLWjhGgirnqOJrb9A&oe=69B01379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440c.png", "id": "121977645092685", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_121977648426018_56455927766712320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqTmVaKjrkgQ7kNvwFZdK4e&_nc_oc=AdktHX4YkO82nJTAvHI78hCOxSfjlQMNOApOwous9YhiVKnOATCMm8yq0-kwZiaIdas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyyela9d76gQlTxc2jp3SQprBeSTC8XOLq3jUgoqrjLfA&oe=69AFFAE2"}, "display_name": "The Hopping Dead", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "HORROR", "ARCADE", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_HK"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "445173414008525"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "116624012323809"}]}, "baseline_offer": {"id": "116624012323809"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1501693200, "status": "PUBLISHED", "id": "116624012323809"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1541270672595658", "version": "1.5"}, "id": "1960139947602064", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1445816822141044", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1541270672595658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1960139947602064"}]}, "change_log": "fix some bug", "created_date": 1509016208, "id": "15412
_8w0QHCvWM3UmEfvg&oe=6A146121"}, {"file_name": "migrated_image.png", "id": "538292160399430", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162679_106961146670675_5840303701696184320_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aQJD4P7WakQ7kNvwGxSpDY&_nc_oc=AdqpeklT6i3fEIlupy8Ew1ZC1K9M6iQT-V73jIi4KEWGLaEs7jp-GYzj5dhj4P-U-NY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eQtGtVuE2q3am2nQkKLqAEiGmarH2rYL73w-z0GR4LA&oe=6A144C19"}, {"file_name": "migrated_image.png", "id": "255550612128310", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162708_141926896395588_5252038296204214272_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLhsXXwJG5AQ7kNvwHs3Y4C&_nc_oc=Adrg1WnQ-oPmMVs2r9AZXLPjMWkfPDBr2o9RlyDBBb4HTDgj3EfumlDt8JbEl4nhtl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6waG4pjeZYUe5IwniiEmcsL2ffbYn7V24bN3FcahCibw&oe=6A146A28"}, {"file_name": "migrated_image.png", "id": "233002211215849", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162730_1101505936708423_1612092936349024256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXcSm639PC8Q7kNvwHK-Gwy&_nc_oc=AdpfSBh97CO0wykiepgNT9ugNvh-4PIeyHrSOTzPN6_hnTYYB2basZtiSnwoctio3x4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KG4CSrHivqgkS0CmiWQjEFkZochBlqFgGVOhSesZ7iQ&oe=6A147044"}, {"file_name": "migrated_image.png", "id": "148816689725029", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162679_1644574582261757_2563065396525531136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8ZD12w98igQ7kNvwEcqFJU&_nc_oc=Adp32yHjVIvydzsxTV-gHZm1t3dAjYn3LHvKDxB8N4KNQKfPMDvBlA2v37new5sY4PQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ub17ca4i4iGcKWGweN8ZFokl5pWXdpJ7w7bbQOw-sow&oe=6A144579"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_HK"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "478902400415251"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162754_4238
g", "id": "538292160399430", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162679_106961146670675_5840303701696184320_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W72Na1GS1sMQ7kNvwH4S4SO&_nc_oc=AdrVHEfgkx6Df1XX4dHtSdKj3FlzNaUZLODYRDLu2dBBeih54BUE83HvXNuJ87b5A2M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af22ULt7yZFQ8Z60cFQW5ACXyQaXFpLw0_gDEJH-Oaw_RA&oe=69F20519"}, {"file_name": "migrated_image.png", "id": "255550612128310", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162708_141926896395588_5252038296204214272_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-AG_hZ6d_oQ7kNvwHEAq4Z&_nc_oc=AdpANiEXLtxRIniWn-SXkwaUFBQv014ccqMAzW4dCYlvNCWbagofzgHq9Pz-lfFEe1g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3l875NiWQ9xrYCpJBXNtt8i7QFe0EudiA9_O_4pwMMUQ&oe=69F1EAE8"}, {"file_name": "migrated_image.png", "id": "233002211215849", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162730_1101505936708423_1612092936349024256_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prduo3mLd2gQ7kNvwGNp8Ra&_nc_oc=Adp2jva33GkH_6EAqEmolH4Ra4snMKgGPhJV5e1wMWn5E3rSr9zYAz17bg9Y7wm13yo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CGY-kOFnvUB_0i5A1AnfUxqo54SgGdmpowpVhbWS8qA&oe=69F1F104"}, {"file_name": "migrated_image.png", "id": "148816689725029", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162679_1644574582261757_2563065396525531136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPyZv9EreMkQ7kNvwH2yCJa&_nc_oc=AdrJMyAcQmwiEegrkMx4t8R4Nhr4PTMtjrOZfGjASUcjPNmOShc29qp5CSNwgobbtXg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1HGakZw9S6qGoWVjxz9L0JzE1G7nbjS1ZnDHlvqAcg_w&oe=69F1FE79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Hopping Dead", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, bringing you into the Eastern haunted world!\nYou will become a Wizard Exorcist from the East in the game, and fight against demons and zombies with your partner \"Dumby\"!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.ideproduction.com/vr-ar", "developer_terms_of_service_url": "http://www.ideproduction.com/vr-ar", "publisher_name": "ICE Production co., Ltd", "support_website_url": null, "website_url": "http://www.ideproduction.com/vr-ar", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["zh_HK"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "478902400415251"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162754_423854774696148_4148710113244348416_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yV
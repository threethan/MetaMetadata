vH0-YLM2OVRsTPUbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKernThEipBNJuL5ZVyTV5wkiryd83AoQCzq7EjngvkFA&oe=6A9ED7A8"}, {"file_name": "migrated_image.png", "id": "216008733097682", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162679_1644574582261757_2563065396525531136_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JX4GSvMT-yAQ7kNvwENFhie&_nc_oc=AdqV-kQCHkWFkCSfbjXAjH6BmBLZfe3dxg6il8NPXIa8uFniaPdo1H9ABovkzAmyTZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXjf_9Kd8F49xj9OcWR0lhH-cY6zpv1n57A0AFo5XJ6w&oe=6A9EB2F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440c.png", "id": "121977645092685", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162707_121977648426018_56455927766712320_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzkieiNoltAQ7kNvwGnjN3L&_nc_oc=AdqbhdfktalPrdRSRmLWpTU8ciZGb4I_uSCGELwk3ZcUXK6PvRfAYboupMcypfVn_oQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX89_9dxB0SCNAFrRZMiBTJhRvSBjCTPeHPUcB8K6hvQ&oe=6A9ED2A2"}, "display_name": "The Hopping Dead", "keywords": ["Zombie", "Chinese", "Ghost", "Spell", "Sword"], "long_description": "Eastern ghost and zombies aren't afraid of guns and fire, the great Wizards shall use their own magical spells and exorcism swords to exorcise demons. For all of you who were used to only guns as weapons, we offer you a brand-new adventure in killing zombies with Eastern magic!\n\n- We offer the liveliness and smoothness of arcade games, it will be a forthright adventure.\n\n- Our game is not only about killing, there are also different challenges that need to be solved in special and quick-witted ways.\n\n- Different from attacking with guns and fire, we attack Zombies with unique Eastern spells.\n\n- The haunted atmosphere and set will definitely give you thrills!", "short_description": "ICE Production introduces you <<The Hopping Dead >>, an action and horror Gear VR game with Eastern style, br
_oc=AdpE3gd6RONklhQ8wlDGpVP3MFloPNZIMZsIjBSuZ88aj_CExyhImjZJxFK0a7-TVgM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFsrGdbdm18sN1m2KANpnXvubTZVAsMjeN2ss8gxniuw&oe=6AFC6E0B"}, {"file_name": "Screenshot #3.png", "id": "1409374617783488", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604366035_1409374627783487_8710979351423276724_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddIMqeXatf8Q7kNvwEb1Ogr&_nc_oc=AdoEvqh_6uRerrZ6sCyTe87yo5eVsqddUqeijCLTynkt1XuFd38i25TeGMlYBK3WVpI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2OTFmSPXx14CUsvT9CJ1uSzLYa4704ZSIqYwIgIdqGQ&oe=6AFC6BBD"}, {"file_name": "Screenshot 2026-08-29 122826 (2).png", "id": "1074926858260968", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673645340_1074926861594301_7780374485994863946_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3s6zdnxjj4Q7kNvwEY4fTd&_nc_oc=AdqO-6wuKaZWWf_E0I3D73btsl_auAMb3bmAI38chpj2lJxKcYKoAzMqvb2ZnhxWHCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTro3pMD4LX6fXV8SbDCyNZc3-rlvYm6F5ADRg66dLUuw&oe=6AFC874E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fast Gorillas 3", "keywords": ["Fast", "Gorillas", "3"], "long_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time.\n\nAt the core of the experience is a custom-designed parkour map built to challenge players of all skill levels. Whether you're a beginner learning the basics of movement or an experienced player looking to perfect advanced techniques, the map offers a wide variety of obstacles and paths to explore. From precise jumps to complex traversal routes, each section is designed to test your timing, coordination, and creativity. The environment encourages experimentation, allowing players to discover new ways to move and optimize their runs.\n\nBeyond the gameplay itself, our app also includes a cosmetic system that allows players to personalize their in-game appearance. These cosmetics give players the freedom to express their style and stand out while playing. Whether you prefer a clean and simple look or something bold and unique, there are options to match your personality. Customization adds an extra layer of enjoyment, making your experience feel more personal and engaging.\n\nThe combination", "short_description": "Our app brings an exciting and immersive experience inspired by Gorilla Tag\u2013style locomotion, focusing on movement-based gameplay that feels natural, skill-driven, and highly engaging. Instead of relying on traditional controls, players use physical motion mechanics to navigate the environment, creating a unique sense of freedom and mastery. Every jump, climb, and push forward is entirely in the player\u2019s control, making even simple actions feel rewarding as you improve your technique over time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/14U2_LUzuc2qTaFPU13kxqs9SZQU5ht2K_Ae7SYCAtNg/edit?tab=t.yuhy42gkynq5#heading=h.a61v3iyhz590", "developer_terms_of_service_url": null, "publisher_name": "Flash Tag Studios", "support_website_url": null, "website_url": "https://docs.google.com/document/d/14U2_LUzuc2qTaFPU13kxqs9SZQU5ht2K_Ae7SYCAtNg/edit?tab=t.0#heading=h.nzl94v6xb7nl", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"i
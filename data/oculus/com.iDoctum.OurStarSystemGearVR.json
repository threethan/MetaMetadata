", "space", "solar"], "long_description": "The rotation of the screen follows the movement of your head, providing a 360 degree experience. Thanks to the development of technology, this computer-generated virtual reality is very difficult to distinguish from reality.\nManaging the application is really simple. You can easily select the menu items or the planets with the centered cursor.\nThis interactive educational VR software introduces the solar system, the planets and the satellites. Users can get interesting facts about the space around us, our planet's past, present and future. It is recommended for primary and secondary school students. This virtual reality space adventure is an unforgettable experience.", "short_description": "Discover the star system virtually - Put the VR glasses on and let the virtual reality impress you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://idoctum.com/en/privacy-policy", "developer_terms_of_service_url": "https://idoctum.com/en/", "publisher_name": "Bal\u00e1zs-Di\u00e1k Ltd", "support_website_url": null, "website_url": "https://idoctum.com/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "708171176849106"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162686_273182019839705_7474381682280235008_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6NX3e1L6xQQ7kNvwEwm-DR&_nc_oc=AdrnuVp-bNoYumjFa
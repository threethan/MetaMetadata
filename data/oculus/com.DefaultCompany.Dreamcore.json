nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTYAzMIDhoF7_87XhVgsTJe8klHjQvg0RMHKq-9pDOrA&oe=6AB3C1D2"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JooE3gtMO6YQ7kNvwGtafDZ&_nc_oc=AdrG_ocNZPM7i6ZwRwC3BMiQwluFP36AjoxqLF7OxbMaltNesGmBGnZKOP0fmOUqJOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGcQkOIt4vuUe842CuiQa-s2J_raMv83wjoqeQnsluiQ&oe=6AB3D7B8"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKwJmJ2kLowQ7kNvwEJTukI&_nc_oc=AdqX66eKg7PO4-SlpE7n9fpaaec656xQQK3jiiBF5_SLI3Z2403YKHi3y1hBf1dGgLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu-TbT2NjFoII0NX3vPHqcIq8DeKNdlzmcsrDBb08RNQ&oe=6AB3EC52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4S_R_C-m8kQ7kNvwGBKQbr&_nc_oc=AdrnY-ikoK6sRMZu58FphV51rclxSPn0H_wDu7DG5GWNQq_oesxjt0umo4vEowWtdtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDEwLK7WSOGa_T9gLERplcatwq2DjwP7q_zCp2I4vz2w&oe=6AB3F669"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KXBr8SDsfIwQ7kNvwHYyRvT&_nc_oc=Adqk1wzPv-51VxkljoFmpveoG9sXaOZyVtP00MKT77VdNaNrthJ2uVrFk85ewV4Z5ZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL_kJUOFaOh7yO2BsS1sC0Z6C9u0Hw2XM2o4xFNgQsrA&oe=6AB3DF61"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcor
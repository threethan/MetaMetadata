og0gztqenKDVmi6Twzeg7MQwi0GAVcDEpZZyy7N5FmA&oe=6A159F31"}, {"file_name": "dreamcore (8).png", "id": "1046271510962042", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823351_1046271514295375_2251597577409392286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxvpIPDUSB0Q7kNvwHCbJ6T&_nc_oc=AdoqC0mu_AzajjrQoZTq-ZtSWr9A0F2G0m3vo1fDi44FrleLO3TyavhMpsId0RVdckc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5o44Pa5VUKR5iITb_eBTrHFynpSKcoUwXHkyUxaytO_Q&oe=6A15C612"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzW92Y3KrnEQ7kNvwEgU5TT&_nc_oc=Adr_eUwOMwXskvAii3f7sxcevn5geHach2rIZoiT1UzDsv4hIv9Q9YmQqO9DcsCBSko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ailcOL9luomwk59p_v_JfnvH2MvFn1JaA0kdSkSqfHw&oe=6A15A3B8"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6Up6dc2GwwQ7kNvwHuSxzk&_nc_oc=Adr1ZFiW4N0BG01o2iOLGdfUteIdrkEN5tr0pExNDMTrobPqg7Td2LoJ9kb7XAIOzfE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68jRUz40vGqF2CloXGL7AdS30cF_ajRQqH7wa2YpDo0Q&oe=6A15B852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sED-AUg10NYQ7kNvwGQNEnO&_nc_oc=AdrMqCPKpkGqCKgX24ukFePEh8Z8eQuiT0Kz1DT2A7UU4OdDgtYyCc2DNLP5fK8q_Js&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hHTDs5SljLZznQxIWAkcj2meQymW3zIXGesAcEUspiQ&oe=6A15C269"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1381629990418236"}]}, "baseline_offer": {"id": "1381629990418236"}, "is_approved": true, "firs
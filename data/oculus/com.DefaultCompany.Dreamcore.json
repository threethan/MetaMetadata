nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0gl0WNx1im_AtWAvv-sri9uqlrMCw-qLo3GBydZS6DQ&oe=6AC51D92"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLY8d1sO208Q7kNvwEaLxR5&_nc_oc=AdqSI-K19q6vEctsJi2PS1el4g71IkDWiLliZhMmpapVgLBQdZnBCSMIAUXxJpkFe_Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsJAHrpOAZWUcKj8X94c9S2CmaMTI0z7Sg9sdxATYPCA&oe=6AC4FB38"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rFXeRO6mMoQ7kNvwHMsUeJ&_nc_oc=Adq9DKtqEu7Tyr_qWlkmmNi7G1j5Gv51AV787NwYCYqt1q2brpXVNquI7ldWB1YNI6M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCWTbp4rbs5G4LgVB9mkQDQ4GTB9qG6ZpaghCm77uSjw&oe=6AC50FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xK-Fqf1Rk3kQ7kNvwGrEXnP&_nc_oc=AdrE9lgRkTkwD5C2L9Wpo4J91AQTLf6I-3sL8IgGT5it_iiXkomydJtVfdlo4jHXE3s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcBZflWFJ0jIfuTMAZ7DQ-6WhN_KRhgWqMOIUpytxE4A&oe=6AC519E9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-LN4mNn0wwQ7kNvwG87Fj-&_nc_oc=Adqi8yILekbv-ptz8b_CHmnus0sZaNki8tjVSbnMWiLzALdLRb5UsDw-ZThj12kkmkU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_rQz9xt2FSQxbjfduNkzaycC4881lSNn9BQUvahhpqA&oe=6AC502E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcor
nm2bXpk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeZsspPH6BPKLrPgTxBlJ7IlxUbHRVfaD8NUvZozUhhg&oe=6A8D8652"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VARbB8MmDkQ7kNvwGkFX5H&_nc_oc=AdpBAqQsEy4wwLLcAK1dlsfd2mOAepM-oeaK2vyRs7RwLxpOCIqvAl2SHdCQ1Sn74Hw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw4aFBwN9jK-TnowgBZd9688vxKb1mj92svwg0C2yyBQ&oe=6A8D9C38"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ulEezYYFysQ7kNvwFmJm5j&_nc_oc=AdrwzZ00nOieHyl3YGBYZF_j8Zx-wsy9CVnjrvcTobmcDP7laZv9VXb-dW8yu29DHCQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0YxFj8ToCi1-Anc3icRKFkGXKiar4xN5NSWHDBmDsxg&oe=6A8D7892"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YI-dPjUabQQ7kNvwGoFCVr&_nc_oc=AdrG-etdASXvQdNgr3JiHtRNXP5XzSJwpA1wA2saMTc3zfqUTwy1AGZj1J4ctUVCwRU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERr6BmY9-zf9JYKiJE-l4HdSedWn637_HH-CbpaGak1A&oe=6A8D82A9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYSqjP51jjsQ7kNvwG2OnVu&_nc_oc=AdqgWneAjpcG4Gsl_dzJp-XHIhwEkxk2lTz9qI_IX98AU5F7MF1dL75FLShuDgSGRQ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-Ly0JwEB-z0LYN9GOYesIt-BzDwy9zM542ccuZ6NbAw&oe=6A8D6BA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2hk0p8KPgmWbnQ9_YmxKUP3q8RTwcke8zZB5HI37O9Q&oe=6AF9D992"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPE0n9Ky_zsQ7kNvwE3dZuk&_nc_oc=AdrbasNaY9Hdq35g_fy9-rRAvu36KZ7Bvy4L6yFJHgH2o1SZZ9GV4vj0ipyWOjyr5yc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnSUiQp2fbT7DkVIzXTk2ZCC_r9Spl7sukESNFJtx5BA&oe=6AF9B738"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cuv65AvI5ZkQ7kNvwHOjEFC&_nc_oc=Adpr3qyRmn4K7oAc3tKD7Jxxbj41RutGgxoxJ79jutaoHiN3QPddEf-mSWvW49oMwSk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ0swVKBCClZ-qsKR2kUbC6IHXAQLhaangACpZtIyeBA&oe=6AF9CBD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fL6IkFyXQrEQ7kNvwE6PkZI&_nc_oc=AdqRUT0JXJzEbiUyBd_Q7IR2qF0qW16Y3SVeR0BXyf0EiMz-3Fj06m-W8s6Yngsrx00&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaTn6yP4colL4nNPRZpPGab5sotLtqSe3yjzVvwiL1vA&oe=6AF9D5E9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11ld9Avu-0UQ7kNvwFZaHiV&_nc_oc=AdpF-tGO2-t18O87a2RsmBwKkZq_t-rD_I5DbPVDfbbwIQNbLVRjeVH6CAGScO3JkFI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTJ_o7j5GlmLHFZwMXFRKJTH_QU1Gv9i8NmmM1on2V4Q&oe=6AF9BEE1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcor
eamcore (8).png", "id": "1046271510962042", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_1046271514295375_2251597577409392286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAG92eYr1QQQ7kNvwGwM4zv&_nc_oc=AdkQd_0n_NZOUQ5LmqBBd-X4eTgdSMlvDoQSHUzwClbbe7PWHGO8AQcZtBnjMoSbR-I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOupb4DM0kTdnDt069VHy-_4ydFinIUnJ5qyH0TrTlww&oe=69B6A1D2"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIUVL0JhyL8Q7kNvwFqL7Fz&_nc_oc=Adl25drJxBy__giDs83N-GSTUOyUyaDHRz6m2j6yILCt_caXJb0DMieGc-Rg1XV8-oA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUfjHCxZR_RDIfIq6ZnWFE2L5T4Uv7fzpf_bkTEcfbaw&oe=69B6B7B8"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlppyHzmcUgQ7kNvwH6vnKE&_nc_oc=AdlxyJXtwa1WmklwKL81luS85VKr58dpdzqnZvGFx1lr0xxzeUNGOcBEJgNlFtmyqH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwtu4KgQbOnBAFj36Uc04_c-8oIAzn2A46dLap9UQYneA&oe=69B69412"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK8j8r0D3LQQ7kNvwH6VDIM&_nc_oc=Adkld_GE2oEN80CWu1XH0KRlXzLjbcrJIrAAKilwWOnQdmZeovK49glL1Ny6319CD0s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaQIbcm3ccGpKsson63zNCvPk6WRWRNTgPKHKIJF2DHw&oe=69B69E29"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1381629990418236"}]}, "baseline_offer": {"id": "1381629990418236"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1764948960, "status": "PUBLISHED", "id": "138162999041823
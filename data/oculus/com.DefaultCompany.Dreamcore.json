L0RWEw&oe=69A2DB52"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NsBDKLRiyMQ7kNvwFHv8Ya&_nc_oc=Adm9LWKR9YIoPoFWO1D7yPiOWmQQvchSjjcHCZ7GFIqCvnLEkQ947mv1lLOBes6GBBQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvIE4TL1C7ymqugP-rhXi1crmoYF3Y-Uof_g6pYDbPwWw&oe=69A2F138"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcmmme3cr3YQ7kNvwGkSy4f&_nc_oc=AdlKtBD6bk79rYVlvNAQEdM4FeTl3PK_7oiwgqb0JNSSFTEz4NjjrW60Dx_LY2syCVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcqDo-RcLgckBDLyVpdpwz7Y-cJEl00aiSWgAk1IKfoA&oe=69A2CD92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zY3bMYl3fxwQ7kNvwE2MFtj&_nc_oc=Adk817IVDYki5-2y5KiC3_cMGgqc6BO0LPeb7mWtXRflDblBdjvikK3F5Vw_5bASJSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuj_rDeB2o3G1XXOo0n64pmdzxdaW0ljOfhdkvik4s-Vg&oe=69A2D7A9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu9wuQJ0EXUQ7kNvwFspsqY&_nc_oc=AdkFcZMmQGwYk35I7_dddmVofPXt7761NCPKl3W4whb-SW0JtS6FZprlwRspHhQvIwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsdKT4Qfkp9aZj107bjHhQCYqERsKKPjnPhi9rN3BdBGg&oe=69A2F8E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcore", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id
HDZncss0043ndQfaERj228VWG72ThK-vEMni21lxmKA&oe=69FC92B1"}, {"file_name": "dreamcore (8).png", "id": "1046271510962042", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1046271514295375_2251597577409392286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwdhFdzCXhwQ7kNvwE3WOi7&_nc_oc=Adr9B0Uch9hBVccCaSEbNBX536XNcyavY7jM0S1_MAaylBJ1UtFJynPCkxlybyChOXw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FZnDDQmqPAj3CEqRbtg1LQ2BYTAc2gaUF-MiX_I6P3Q&oe=69FC8152"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8jp2lcjYf4Q7kNvwFySY_E&_nc_oc=AdqwMatNs2UcDzCr7WqMnmK7i_4wWBkaTlYnLIaDItqLr7YiAkU_au1hkuUm1YGdvFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pjwZSVnSo4rfvasjjxqwIW9M_E0ly650E0mizSE_B2A&oe=69FC9738"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO7Z7Q5BMO4Q7kNvwGKMqt0&_nc_oc=Adq84R7wbDSPmzovY-H9UDT-YeR0eJn617dYrVYoW-nI91rYw-sgMy-Tkf7ndWh74t4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72GlPgNMacAUGgbH_Ksk9FRr3bfq__CxeIcMhYQG_j6g&oe=69FCABD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeNx2Vkcw00Q7kNvwGVPyRA&_nc_oc=AdoCryScsSBvQLjEj75gjG7texYrW7ErniHK7-bcbjg_VRowMf6vJ65TGjN4l1onq1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vpav85KOMcWRgLgnHQWiiOmcLKjn5p7QtGRfaABMjlA&oe=69FC7DA9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1381629990418236"}]}, "baseline_offer": {"id": "1381629990418236"}, "is_approved": true, "firs
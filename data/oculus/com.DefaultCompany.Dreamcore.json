nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW0kBvHJuEYMjj0qW0uEZWDd7J3VufIeS1Bv4BJ5qP0Q&oe=6AB69D12"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JooE3gtMO6YQ7kNvwH5i0XJ&_nc_oc=Adqb6qfYY2R2TAxG1dXzx_O0CIcaqF4coEU_O1CHH84B0J4IpRPua2ZeCYVUkySB_N4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmwkBI-DkpwcLnXqwwcCgtIO75917hZTgiGbVEaiU7Yg&oe=6AB67AB8"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKwJmJ2kLowQ7kNvwE4wQiF&_nc_oc=Adqvxe-XTCZz7Ad1rCnh03lE4asMxZSk6UbCPWxFD1FBqa0iAKOTyn2qXIsDG_N2ENk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVXL-0pV4avvwZmkpfrpt9Ehbodj2FiT_XY_h_I89kjg&oe=6AB68F52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPkdckmO-xwQ7kNvwFvrp4B&_nc_oc=AdrSxlEs8A25pYecojKv6mplh8tMGHiuovZcMu8snfp5QPuYrJn579M35QOVVGvzZlw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9HgBwYCaFx0bEC8q5HhyL82PaT0cqI07aLuOljJiQGw&oe=6AB69969"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFnJ8IF4raYQ7kNvwHKEsQm&_nc_oc=AdoJkx4UQdvCpDjv4w-JZ8gtOK2Oa_-O4DwzBfVIH7Wnf_dNZHb61fhJGuPn_DXagYM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhFWzm5dcTg48aQMH0cjYdpNCjuLroaGozBH_AvP2iJA&oe=6AB68261"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcor
6XJpt5pFHy0s-3FkuQE-6FatiUXP5T12LSJzp84DMAg&oe=6A942F31"}, {"file_name": "dreamcore (8).png", "id": "1046271510962042", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823351_1046271514295375_2251597577409392286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXJKZnCmkr8Q7kNvwHWYa9f&_nc_oc=AdpO2g6JS5ETjHPg_oT0WUM5ntu06hxeV7fwvgDfKXEqmEhQO9kPITmRfGfAl25KRlQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO0dnwxqOzdkTYJsJPRdJrP6Ijsj7_ls-UVfRiWBTxVw&oe=6A941DD2"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4tp73umtogQ7kNvwGmr5wt&_nc_oc=AdoZ2fY4-4G3UdZbfiwI0Ml092xeevU2EkfhGVsi3d0Hrp2tkV5J82SZdZ2kyCicZVc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDMuuG5-BqMOUJr572LgUTImErEC7IOttmmkEwT9TXww&oe=6A93FB78"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPzSYGUWa3IQ7kNvwEDWNOV&_nc_oc=Adpp6h0Eiq3VxcKVL9d3QBlJB1SnTnjadADQSgTjOnLEFqDvPM9y3DYL8P3eRXrh5zg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4re_ggfycMx3jqP1YivztlneEjHxYPo9bZ1sh8XD0Sw&oe=6A941012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EicBQpSzlLAQ7kNvwGlT7Rn&_nc_oc=AdpJam5SsTH0DpkNgB3d4raAFw0HQQF9XD3_a2F8Jupu5n3Ib7Fzsn6qSCo_YeDx9C8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8rHaPFt4Ms8XhS-a6uTqT_g8j8YBo-zHhPdKan6zqRg&oe=6A941A29"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1381629990418236"}]}, "baseline_offer": {"id": "1381629990418236"}, "is_approved": true, "firs
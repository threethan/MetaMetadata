nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzmNnFSXYfK54GQigRAwsnL4Ic3y388RhjuhC0z_w-8w&oe=6AE4C192"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nwt63AW3QY0Q7kNvwF1A7ba&_nc_oc=Adp-y5z5x2RfIc2H97AiZgAa2q7CUPF0WcmmXKr7DYDwtzA-iGDkY9paLYe5T1sWrSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDnD51WtjLP5zYUxRzP9iFi0tKrxZRl6gOfCwOwf3DiA&oe=6AE49F38"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYvGDCta6bkQ7kNvwGjbKeg&_nc_oc=Adqhx46FCzywDf9oJ9z2XECeXI-d5eBrEVfNdaqO34HAY7khgcS8dC1N4Ui1vG9iMnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0cOB4k-a-_KuDccSS2xMh1kWi6LMLjBVC6oG-i9ZQAw&oe=6AE4B3D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MQlHvBPXdgQ7kNvwF5_pxx&_nc_oc=AdoRMuBPamyfGXXJpHirZf_A3Hr4y1GqJG34k5pFF3j0eeZ9Gy7NJWqyTshHwL97Q4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFE2D8zvj9voqznjwf9C9yprfrFPzPY5eCcpm1auI5RQ&oe=6AE4BDE9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjukrOswlNEQ7kNvwGGXIDp&_nc_oc=Adrsk4IMaY_1osqn3DTsdfFsg_Fbn9JLfyPRauqKZlnIsqXM9LGl5NOMnoVZgyDtFRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMrC6vj5NbV_0_X59SQvUJgUP-1LWLqJ2oUPSiRd3mOw&oe=6AE4A6E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcor
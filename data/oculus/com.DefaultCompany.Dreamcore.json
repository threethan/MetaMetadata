rV_0qN1BCkkG6vFZ7M9lbx-P1HVZUq2mAa7b1Qr7jcQ&oe=69FB4131"}, {"file_name": "dreamcore (8).png", "id": "1046271510962042", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823351_1046271514295375_2251597577409392286_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwdhFdzCXhwQ7kNvwHJZ-kr&_nc_oc=AdoCXsiMQk0GewcqbBLpIGCQNI9Iu-iA7P6EsEzfbzU3x661mQcKQaQiRTVbrWbOOyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q66qt8dVUwryYMP0VecT9Kj31cJu8OaDqfYiuxK9egg&oe=69FB2FD2"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8jp2lcjYf4Q7kNvwGh0jqR&_nc_oc=Ado7uy2Ip3to6e8kU7qLVr2FD3JsB1emiza1PphtJr4vjd9CyW_v8YzK60H7a78aiKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45c8_Cm7NXEvQDW-Ek6u1ETFsFkw1KE93lHQXqCEWzSA&oe=69FB45B8"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO7Z7Q5BMO4Q7kNvwH3UeUi&_nc_oc=AdoCZ2etzvxlRhizaupiRDWNkqT1AQLkx6AxT4Vco0QwdRJLAFCjyKHrirxcAPtwVAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JmXsYLQiECT_uEDMnA-eJXwt50KojLa-_4o3Uf1m5bw&oe=69FB5A52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjVpr1Tlog0Q7kNvwF-a-wJ&_nc_oc=AdqToT4zFkl7EWjYPfE2RLopyyNJPKG5B1uhhIsc2sO-3fdf6UhgomLhBQ_UxGY3-IU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PJwSleNIfpWlDSfSRq_m23pWoqIpV3W9vyck31rCoyA&oe=69FB2C29"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1381629990418236"}]}, "baseline_offer": {"id": "1381629990418236"}, "is_approved": true, "firs
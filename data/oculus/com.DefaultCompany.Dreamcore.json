nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CswTjvlR1uc01UnCdQgA5LsX6AuG4SuoCaWo7wlnr_Q&oe=69FF2452"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyTGes3UFPAQ7kNvwHN7u3k&_nc_oc=AdqAMn_K7yGzYqS5H88-TH7CsSD1ATuEOX1cp1U1NW_ljmo9TyGEfrEwPP8n0EmvIW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52V1zS0eYD_rh0Ie8WVu5HnhLlpp52oyp_vm53QEGsmA&oe=69FF3A38"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDK72p7PjzQQ7kNvwECn1g7&_nc_oc=Ado2xTLq6hCQfTIPrQxcYR1hHlQfUB-46lQEZ5SBMHKBFlcBK6Oyph3GzmqmkIcUIAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RryxrDIfSUWi18E5QbV33CMQv639FU_iweR2tFDqbsg&oe=69FF4ED2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MeNx2Vkcw00Q7kNvwFGF5BV&_nc_oc=AdqVy0MAttXrE5UDGTo1SEKeU97AHSODGMuJ5vlM1SvenQmDlYIWo9kJVaLssF5J24g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PBEd5AmocGoCaho-JPUcCLNRPdYLfKLpVn_IpMut-9g&oe=69FF20A9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrOH0pF-FYwQ7kNvwFKfg5T&_nc_oc=AdpCe46sksE6odVL9OVCkywwHzaaekTRHGXFesGdx9TvIAOgXaH5qt013mQAh3aI59M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u7ACIiYGB9qCeelrumPW9aUKEeDZ6INGbvtV1gMiq8w&oe=69FF41E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcor
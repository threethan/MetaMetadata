nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MwpDAQ9O5hz0ptOKbyG3LePp85xOX00sN0s81yOKaKA&oe=6A4503D2"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pw_YRV8BRDgQ7kNvwFEyfM0&_nc_oc=AdrUwSdNdy_G5nfiMiY9QPYHg0xkH2DS27KyhWwxVCb7Wmcn2llW3KKL8ilFOJ4Awho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97pBSkOzSu2J1v8D5dQZev4aGUr8ITcTVekLRMtD8Brw&oe=6A4519B8"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGeqLyfI3MgQ7kNvwHSlP0C&_nc_oc=AdpYvVS7OjS_SEfWoQ8BBr2xLwSoymWaHeXOIot-TJ5si3DktuwJZBscN6GMmEcvWGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IM2k2QvyIFIefDYeAvlCt9h2GMzlS9zX3UF1svYImzg&oe=6A452E52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oxepc3afNQQ7kNvwHs0cWX&_nc_oc=AdrXik-E0zf5cmVhOPycE62pwtIxkIxE7PbmK5f7aERRg4xVXEpmU3dldn-bh1Thqd0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nvbLEWI0-BuSBTVRde3Q9qUJL0tdTe11SxifZvIaBbQ&oe=6A453869"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzj9sP6eAOkQ7kNvwHZGlEe&_nc_oc=AdqPOIccoBrwat7lS9YmYYD5KOAkUvVKe4yYMu3-eLSoCj08-2kduMxZqHmTVMVPv98&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HpzlXF0YG_uIfkXoMbOQGKy7mYFQxWXyDPcen4_Cq3A&oe=6A452161"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcor
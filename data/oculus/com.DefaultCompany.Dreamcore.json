nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzN63qAnMBBNM35e4oEArxUUDZ60vo5yIqEAAG7WN_E1A&oe=69CFAE52"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkZN6hkABAsQ7kNvwHiL5cN&_nc_oc=Adrs0FC7IV5IcCNUgbkyXV4hzURXYV83w8thLFXE3VStsZ6-GA04_Ub6Ho8N6bHaPQ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylTf1zZjsWzdGgQDAK0pab9Lycb-UyikI8TV4PQluv-A&oe=69CFC438"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9SkEjrK5sUQ7kNvwEMS3qb&_nc_oc=AdquWeVdx_ACdclDMNx-IoHS_Mo6JCD-BAhbNW3NsNrW3mIwuo8R88cy3Bigf3uoH_o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYws072aRXMB8BZUAE2tJ4PavrTlC8JHym4Rr73kZC9w&oe=69CFA092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFbj_VTJQJIQ7kNvwG13TLb&_nc_oc=AdrWpVLBZ1k4q_tICklc8rYJcSV4ZReX1FM1d4AeqvnbYdN-oPmi4wBqHXSgvkBDjXg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjzyuTbCs2OaLJ9XBDukkf26igf2lU_TwQiruiQ7zkvQ&oe=69CFAAA9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Fkk27cXOZQQ7kNvwFt4PlP&_nc_oc=AdrWmEOG6zU6vi9SX0DbaqLCgD0X7cq2wQI_HR1tympQ3Ogn2suYKWQOSC1cL-0rgSs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7jXd6o9yFPdYecXUPOnHjLK9edL3aPYQY41LTDovasw&oe=69CFCBE1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcor
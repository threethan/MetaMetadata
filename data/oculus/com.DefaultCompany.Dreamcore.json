Z-Xclg&oe=69A03852"}, {"file_name": "dreamcore (9).png", "id": "1610119639981720", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825481_1610119643315053_6459637218724783368_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9ShOmhompAQ7kNvwEAA4Uh&_nc_oc=Adkq5pcqA4XAS4iVqiOkfqCPFpSzOrhATcv98PKc0Mv-wbFe7Mm1TanXyOCkDABkV4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfszWNbhgWu5Vyh_2ndBBvK-3f5L5YO-m215vk4_2zfg3A&oe=69A04E38"}, {"file_name": "dreamcore (10).png", "id": "1204992428150918", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823910_1204992431484251_564884484974921216_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJlzPdTee8AQ7kNvwGYM50i&_nc_oc=AdnjgNooKd1Rr1etVutYL-xJP69Je5Pz0SyHjJDmGLnTYQov2x6wQ9U-cDIlD6sctjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkNy-Nm0_1z6zOhfFiAhFUYS-udBvjnjuiYDiIvK7jRw&oe=69A02A92"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer!.png", "id": "1141105781124914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825345_1141105784458247_9052716076793387671_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPXpf_OUkHoQ7kNvwGGHLUQ&_nc_oc=AdnLStQck0U3dwJBFTTI_bclsMCVSbChI4OFuDRuTWxZfcJoBg6DYu_dMxACKH_QI7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuH5Ed88geeCq9PeywaLjN64htTb-3ODkmmXtQdXOGikg&oe=69A034A9"}, "display_name": "Dreamcore", "keywords": [], "long_description": "Dreamcore is a VR Backrooms exploration experience centered around three iconic levels: Level 0, Level 94, and the Poolrooms. Move through empty hallways, quiet dreamlike neighborhoods, and calm flooded chambers as you search for a way out of each unsettling environment.\n\nLevel 0 introduces the classic endless yellow halls. Level 94 presents a surreal, peaceful yet uncanny neighborhood. The Poolrooms offer bright, silent, water-filled spaces that feel both safe and unnervingly empty.\n\nDreamcore focuses on atmosphere, immersion, and liminal tension. Each level is built to give players the strange, drifting feeling that defines the Backrooms mythos. More content and levels may be added as the project evolves.", "short_description": "Dreamcore is an immersive Backrooms VR experience where you explore endless liminal spaces, avoid dangers, and try to escape unsettling levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreamcore-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "BackroomDevs", "support_website_url": null, "website_url": "https://sites.google.com/view/dreamcore-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25281533601549097"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822813_3795458200588179_6515934740346605171_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUsxNby6z-UQ7kNvwERZClv&_nc_oc=AdnaK_M1oEkkMvckPUMtanCobuy1MfYd5lQxVFBFOu1F6VVr8nFckmtuyUbvIBjvy8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvEDeJPpOpWtmYSX85h7oko3dO3yekeBYJ5fmbhxQne8A&oe=69A055E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreamcore", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id
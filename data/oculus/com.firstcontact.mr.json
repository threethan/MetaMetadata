MEpNcW_Iy0fb_sMX4HVlmevU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQjUEYenHqkH_Copn7Qa5djgEHo8BbO_NsT4PiQQ472gA&oe=6B0DA35F"}, {"file_name": "shot_11_grenade_dark.png", "id": "2090611244927842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/585806260_2090611248261175_5251563814594972141_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0TP-E5T7EoQ7kNvwFu9W8V&_nc_oc=AdrTD99cA650igV7ZdnaN7hTFzjHOf9_hCn4IR0w1tSQdc7RTLYuIeXbIrGlZ1u9f-I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQP1GeFf4zFSkFEkbV4WdtbJZOtP7EaS4LS6XlDR7EDmQ&oe=6B0DC995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "09_Trailer_cover.png", "id": "1657132016065724", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831964_1657132019399057_5272055494586016425_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0ESEmTjlDUQ7kNvwHMCSid&_nc_oc=AdoOI4OPqf5MFnzAr0EOYkFz-NC8CAhOLG0_n0MMdNaUuZrQZXzjPA0Fyy7yeZIee3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKMVKxLkKuG41BbeYp0iS83pLdIlDYp-6olOMmz1mdjg&oe=6B0DCBDB"}, "display_name": "Wallborn: Alien Defense MR", "keywords": ["aliens", "shooter", "passthrough", "mixedreality", "survival"], "long_description": "Your room is the battlefield.\n\nWallborn scans the room you are standing in and plays the whole campaign inside it. A breach tears open in your own wall, something climbs out \u2014 and it is on your floor, on your furniture, on the ceiling over your head. No virtual arena. Just your room.\n\nTwenty levels against the clock\nEvery level runs on its own timer. Still standing at zero? Level cleared. Later levels bring bosses \u2014 something far larger tearing through the wall.\n\nA real arsenal in your hands\nDraw from holsters on your hips and over your shoulder. Reload by pointing the gun down. Grab a grenade from your belt and throw it; heal with a medkit from your chest. Eighteen weapons in two arsenals \u2014 the second fires live ordnance that bursts on contact or in mid-air.\n\nThey use the whole room\nFourteen species climb walls, cross the ceiling and drop in behind you. The breach seals and tears open on a different wall, so the wall you are watching is rarely the next one to break. The small ones hide behind your real furniture and strike from there.\n\n\u2022 20 levels, 9 bosses, 4 difficulty settings\n\u2022 Endless SURVIVAL mode with leaderboards\n\u2022 18 weapons, 7 weapon skins, 16 achievements\n\u2022 Seated and left-handed modes\n\u2022 10 languages, no in-app purchases\n\nRoom-scale mixed reality for Meta Quest 3 and 3S. Best with about two metres of clear floor.", "short_description": "Aliens tear through the walls of your real room. Grab your guns and survive twenty levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ggshoplimited.com/wallborn-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "V V Stores OOD", "support_website_url": null, "website_url": "https://ggshoplimited.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "it", "pt_BR", "ja", "ko", "zh_TW", "zh_HK", "bg"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1509715285551221"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1838495747458238"}, {"status": "CANCELLED", "id": "180107
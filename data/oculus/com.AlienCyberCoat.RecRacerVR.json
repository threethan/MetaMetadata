41_5705198829958418954_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DP-QRh1riwQ7kNvwGXm8Bv&_nc_oc=AdmTpuPPVWEAAAxwa1hZiz-kwCdMb_lMwFRDC0fwWY_DUf-B03-F89cIH_c235qqw-U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXxSrna2gqJqwMe20lqaYInVmRzoEyBnSYweKk6goYhA&oe=69AABD4A"}, {"file_name": "newScreen3.png", "id": "1401680097634286", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822719_1401680100967619_8985323988489815679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3z1n69AIcjcQ7kNvwHon4Ld&_nc_oc=Adk5ar2ojNBTImZSWrnmXnQdzLYfci57HsjHmht1JlRw6QzG4pDBYXir8ep-wqghJ1c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzeobfOWA8JMAkTQwMPPL9yoXwxdHYhE2gl5n2Vo8pIYg&oe=69AACAA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerPreview.png", "id": "1573538060363978", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499303788_1573538063697311_2218418378064029768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmeRXX6lGkQQ7kNvwGMmXYv&_nc_oc=AdkgyKhZv6EW159b9szGVVQu7spj5KgtySdg98-1bVuY8is4A32EndQh30y_Zr3dEVs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxv4EYZv2B578Qh3ZDzr8rQ08l8fkgN4uml_qWE0x9ZPA&oe=69AACC27"}, "display_name": "Rec Racer VR", "keywords": ["Race", "Racing", "Racer", "Speed", "Bike"], "long_description": "A retro style arcade racer, with elements of realism, drifting, high speed, brake control and intense crashes.\n\nJoin Rec as he races for prize money in 5 race events as an armature racer in Speedwave's underground racing circuit. \n\nTake a cruise alone, for a time trial or best lap. Enable the A.I to compete against other Speedwave drivers. Multiple tracks. Drive bikes, turbocharged automobiles and trucks. Win races to buy new vehicles and compete in new underground race events at Speedwave.\n\nGreat action, fun A.I competition and a great soundtrack for racing.\n\nGrab the wheel using your VR controllers.  \n\nUse Meta's first person recording option or the games third person recording tools.", "short_description": "This is an arcade action speed racer with elements of realism like drifting, brake control and crashes.\n\nTake a cruise alone, for a time trial or best lap. Enable the A.I to compete against reckless drivers. Multiple tracks to test your times on. Drive bikes, turbocharged automobiles and trucks. 5 race tracks. Win races to buy new vehicles and compete in new underground race events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home/news", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home/news", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26383333644584120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499308090_1249156593239357_2481401200253956595_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fKYrkoG5dWoQ7kNvwE5cWZd&_nc_oc=Adm6EoHX_h0wu_dH-9LO3RCNgUgr0hbizvKBbIuOFn4-1dOAMcmpr4pqoMbE4agRHRs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyC249kaWOLwEmjNhtM1LnkGcEYtwe5F_3tqUFA4INiow&oe=69AAD9CB"}, "is_concept": false, "is_test": false, "is_
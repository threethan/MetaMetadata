vwFtARYL&_nc_oc=AdkQgdqNOvmEt6YqFRm-ttq2EpCsQryE2yxM3RADZB2A0Ahy2ag1KrSVsOQCQiPA8mg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuj8Dh1xVPaY4pQjKEA3wClrhskJ3Klz3frzf5A-C-1gg&oe=69A2D44A"}, {"file_name": "newScreen3.png", "id": "1401680097634286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822719_1401680100967619_8985323988489815679_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSDuV0JbQ6gQ7kNvwHcQGHr&_nc_oc=AdlUzIJUUHbymYOikrf0yE0JdjBCflBzfzsEnKc_x0sAA8T-Ewyu7TlMKQ-opJFN5WI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftjVYbxhv5-Hsi4lubjN4YDiDDksL774Kep6lh616DKIA&oe=69A2E1A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerPreview.png", "id": "1573538060363978", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303788_1573538063697311_2218418378064029768_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gYC1Gda_xEQ7kNvwE15yzu&_nc_oc=AdmZzzinknfB5RMoKiPYEJV2Z9qlWLlj5_YfLK6CQB3vDCLj7QmJj7DTIbvX-T4mtks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvcr5frqjBwdP9bPJOJ1sXPNTmPDlf-fbiioSL9xiXE7A&oe=69A2E327"}, "display_name": "Rec Racer VR", "keywords": ["Race", "Racing", "Racer", "Speed", "Bike"], "long_description": "A retro style arcade racer, with elements of realism, drifting, high speed, brake control and intense crashes.\n\nJoin Rec as he races for prize money in 5 race events as an armature racer in Speedwave's underground racing circuit. \n\nTake a cruise alone, for a time trial or best lap. Enable the A.I to compete against other Speedwave drivers. Multiple tracks. Drive bikes, turbocharged automobiles and trucks. Win races to buy new vehicles and compete in new underground race events at Speedwave.\n\nGreat action, fun A.I competition and a great soundtrack for racing.\n\nGrab the wheel using your VR controllers.  \n\nUse Meta's first person recording option or the games third person recording tools.", "short_description": "This is an arcade action speed racer with elements of realism like drifting, brake control and crashes.\n\nTake a cruise alone, for a time trial or best lap. Enable the A.I to compete against reckless drivers. Multiple tracks to test your times on. Drive bikes, turbocharged automobiles and trucks. 5 race tracks. Win races to buy new vehicles and compete in new underground race events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home/news", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home/news", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26383333644584120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308090_1249156593239357_2481401200253956595_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twLzqSukbpsQ7kNvwHRyEfx&_nc_oc=AdlL5401o2zdnodzuz118TBCu6GSJIpbXItBrgntk70wlIvG732yp5w0yOWsWBkg5uw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsBl85x6IU2dkr5Gn2Ze-9QyyuJvoomlhc62mVkdya9Ew&oe=69A2F0CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rec Racer VR", "platform": "ANDROID_6DOF", "context_category": {"context_catego
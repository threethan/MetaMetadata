zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO5A_6rOgZlWk6m0WEMuB5i2MLmyq3NnQTeFX0ssSjpw&oe=6B05B737"}, {"file_name": "RRscreen8.png", "id": "1443659037161875", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304106_1443659043828541_5705198829958418954_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S92aF1KePUwQ7kNvwEtcPAT&_nc_oc=AdrUqFCqSSZqSiNyaVgf-Wnwh_HRKrDmDrpqhAfeENpiyd5z8of_4yHPHV6xi-KCems&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOGS15cuCMb3H86f2EtFIETH6W5RVcX5sycMsVjemuxg&oe=6B05B00A"}, {"file_name": "newScreen3.png", "id": "1401680097634286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822719_1401680100967619_8985323988489815679_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dckDFXx0DgMQ7kNvwGOdIIJ&_nc_oc=AdoB5ByrsgIXR4bCfPEQ37UHE1Ui8EcpXIhqWj54Qqpa9_w-J0wCzM3MiYUwrGHbJkA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu3IlILHr03WZA1UbSfIYGzgV-NNFlKPK44zp_A-aR2g&oe=6B05BD63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerPreview.png", "id": "1573538060363978", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303788_1573538063697311_2218418378064029768_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAmCIUWInjEQ7kNvwHUySyc&_nc_oc=AdpZsq1cxWCtM7Baq5yqR6rbMa-jgdh93lHj35HLRZ05SYXpGPHv0Z-UUkaesoi8Nas&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCPrhs-4FAouaZvfDYg3pQOvqmFV39TnYBO7YdEQH5OQ&oe=6B05BEE7"}, "display_name": "Rec Racer VR", "keywords": ["Race", "Racing", "Racer", "Speed", "Bike"], "long_description": "A retro style arcade racer, with elements of realism, drifting, high speed, brake control and intense crashes.\n\nJoin Rec as he races for prize money in 5 race events as an armature racer in Speedwave's underground racing circuit. \n\nTake a cruise alone, for a time trial or best lap. Enable the A.I to compete against other Speedwave drivers. Multiple tracks. Drive bikes, turbocharged automobiles and trucks. Win races to buy new vehicles and compete in new underground race events at Speedwave.\n\nGreat action, fun A.I competition and a great soundtrack for racing.\n\nGrab the wheel using your VR controllers.  \n\nUse Meta's first person recording option or the games third person recording tools.", "short_description": "This is an arcade action speed racer with elements of realism like drifting, brake control and crashes.\n\nTake a cruise alone, for a time trial or best lap. Enable the A.I to compete against reckless drivers. Multiple tracks to test your times on. Drive bikes, turbocharged automobiles and trucks. 5 race tracks. Win races to buy new vehicles and compete in new underground race events."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aliencybercoat.wixsite.com/home/news", "developer_terms_of_service_url": null, "publisher_name": "Alien Cyber Coat", "support_website_url": null, "website_url": "https://aliencybercoat.wixsite.com/home/news", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26383333644584120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308090_1249156593239357_2
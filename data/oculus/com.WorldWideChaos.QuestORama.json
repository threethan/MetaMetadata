38974789_158445806097919_6994715689088380166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJBqh8xFyzgQ7kNvwGhSwy9&_nc_oc=AdmNrtT4jF3J5xoCk0IkpcuNJIuCSJkRfw25wvdRbBUv308ceAnUKJSgI8utdWNVPro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfusMfuqnJO8NkhUx0Ghikfd-VK6V3aGopjwC3NURl01IA&oe=69987228"}, {"file_name": "AppLab-Screenshot4.png", "id": "125500966189671", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974853_125500969523004_3152039310657209185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMVez6hGnC0Q7kNvwGE-e09&_nc_oc=AdmOYBOw7-1E_AgUtMd3zsu_0JWbLpNc5ijI6Q23pre-rcTwKuZeWIpoeippxGwa9Ds&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsHeocgfApTGJGHc2h_M_OOG3IIltsEITGc99-ePHNPbg&oe=699846B8"}, {"file_name": "AppLab-Screenshot1.png", "id": "287089292808520", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974787_287089296141853_444106832633864054_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_-UCGWixNEQ7kNvwGK5DYO&_nc_oc=AdkJZWjTDOikj-x03TP2fuTNoQ7SOT6s6JMp3p28Ocz8unb6yYTngv-1eYyTr6UNB6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsCDS67JW2gsSJsMa5SKBZI96B-kf8ocPcYhZY8FQk6ow&oe=69983D74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QOR (QuestORama)", "keywords": [], "long_description": "Inspired by Dactyl Nightmare and Tron, you are the computer virus, sent by nefarious hackers to take down a server from the inside. Use rocket jumps, grappling hooks, and climbing to quickly dart around each Node of the server, stealing every bit of data you can before bringing the whole thing down. \n\nProcedural generation of the levels and enemies keeps every fight new and fresh. Slow down time mid-flight for insane maneuvers and Hollywood movie-style gun fights. Buy upgrades, modify your weapons, crack puzzles, and more in this Retro Tron-esque world on the other side of the computer screen. ", "short_description": "Retro Grapple-Gun Shooter! Survive in mind-bending procedurally generated worlds with a computer server you're trying to loot and destroy. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://i.stack.imgur.com/lXzGI.jpg", "developer_terms_of_service_url": null, "publisher_name": "World Wide Chaos", "support_website_url": null, "website_url": "http://www.worldwidechaosinc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27497852889861052"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974469_1724204525089306_1108077164007516831_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UIYIgV7GBMQ7kNvwHxGbeL&_nc_oc=AdmXTNhiVfrwZ3HcF_pNYKRphbWZAgiN9mhiXTXEGVRxpAcybLcmjA4PkTYv2uCm_f4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsarJtb_eEsgNQve3p38FwtwnvKz_HgijVkhTUW3jewKw&oe=699860A7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QOR (QuestORama)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1620930011, "lastRevision": {"nodes": [{"id"
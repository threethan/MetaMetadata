iO84mQpwI80pSzKtSYOwnx9P34-ek5lPJzoSDOHb9W_Z6t1WwOiiy-88&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8lKWWxdD_ouN-X-mnpOv4Z34vVQBtZ2VQg24Uu4uwtw&oe=6AFF0A28"}, {"file_name": "AppLab-Screenshot4.png", "id": "125500966189671", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974853_125500969523004_3152039310657209185_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACxRUCnUk2sQ7kNvwHndSE-&_nc_oc=AdriDoXD4VOTFtQBoW-B1mj_LK0OsfUklCF9Uq5jpkZn4pnvfF6aSfLerqsCQ5CPax0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGxlKuxv8dFDgwJ-pIZtOany2HBDT8ailCmANc5nLT_w&oe=6AFF16F8"}, {"file_name": "AppLab-Screenshot1.png", "id": "287089292808520", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974787_287089296141853_444106832633864054_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6U35Egq9dB0Q7kNvwGg1VXx&_nc_oc=AdoYcMrzToemaFUyGsRjuORlkP9BqzOjAWZG-qiU3mX3imjUS9PyIHhtF124qJu-p6I&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm_RSN8wQ3O4efqjYfk8pX4xyX6yXb8rKbsORILiTPBw&oe=6AFF0DB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QOR (QuestORama)", "keywords": [], "long_description": "Inspired by Dactyl Nightmare and Tron, you are the computer virus, sent by nefarious hackers to take down a server from the inside. Use rocket jumps, grappling hooks, and climbing to quickly dart around each Node of the server, stealing every bit of data you can before bringing the whole thing down. \n\nProcedural generation of the levels and enemies keeps every fight new and fresh. Slow down time mid-flight for insane maneuvers and Hollywood movie-style gun fights. Buy upgrades, modify your weapons, crack puzzles, and more in this Retro Tron-esque world on the other side of the computer screen. ", "short_description": "Retro Grapple-Gun Shooter! Survive in mind-bending procedurally generated worlds within a computer server you're trying to loot and destroy. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.worldwidechaosinc.com/PrivacyStatement.html", "developer_terms_of_service_url": null, "publisher_name": "World Wide Chaos", "support_website_url": null, "website_url": "http://www.worldwidechaosinc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37664075956571977"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974469_1724204525089306_1108077164007516831_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y55Elx7DLHYQ7kNvwGDNBCH&_nc_oc=AdrHMgifaLV1m_htRiwLpcSpyRYXJTrZqT4ES8-NU8Iqn03SzcNe1wkBiHgnXFAdqJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyqgg0Oddr8h2S1OFC82LzxaXCz-QM-muS1WPLvOUfng&oe=6AFF30E7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QOR (QuestORama)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1620930011, "lastRevision
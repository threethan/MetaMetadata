 [], "long_description": "Inspired by Dactyl Nightmare and Tron, you are the computer virus, sent by nefarious hackers to take down a server from the inside. Use rocket jumps, grappling hooks, and climbing to quickly dart around each Node of the server, stealing every bit of data you can before bringing the whole thing down. \n\nProcedural generation of the levels and enemies keeps every fight new and fresh. Slow down time mid-flight for insane maneuvers and Hollywood movie-style gun fights. Buy upgrades, modify your weapons, crack puzzles, and more in this Retro Tron-esque world on the other side of the computer screen. ", "short_description": "Retro Grapple-Gun Shooter! Survive in mind-bending procedurally generated worlds with a computer server you're trying to loot and destroy. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://i.stack.imgur.com/lXzGI.jpg", "developer_terms_of_service_url": null, "publisher_name": "World Wide Chaos", "support_website_url": null, "website_url": "http://www.worldwidechaosinc.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5125465950832013"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "163408292453507"}]}, "baseline_offer": {"id": "163408292453507"}, "is_approved": true, "firstO
38974789_158445806097919_6994715689088380166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vy2kb5LPFpAQ7kNvwFM8jlE&_nc_oc=Admt4uh2zfDfh6Mw-bvJ7gDEKVEoPdRlKOHrKtlPYLVlfpnXMCHi2bervB1vqUvjIYQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsQ91mF8S-_Evz3I1_D3sMGJ0c76TfG1yXcIJX_Ii9WUw&oe=699F09A8"}, {"file_name": "AppLab-Screenshot4.png", "id": "125500966189671", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974853_125500969523004_3152039310657209185_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvPNcEl9smwQ7kNvwHduGff&_nc_oc=Adn4PQUYz6r5sTXDKZixH1Ula6TSHDxZLis4gRC1XNKyh3Lc7H_l1GRQ9O9zg4ORzfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvSAPuffD_9V-asc6_jhV2vjuNjGPbxBBh6oMsXcYHXrw&oe=699EDE38"}, {"file_name": "AppLab-Screenshot1.png", "id": "287089292808520", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974787_287089296141853_444106832633864054_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VntrtpU6a0MQ7kNvwFYEros&_nc_oc=AdmIzt4n96M9xoyXGc9QOHfVSSa58oJlDC8Z9sdQNVD9XhrsEUFBCN6GCQeQGOkk0ec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvmLnz4VO1QBpKk_oZD0aps1_sVPrZMdTIWo51awFp6UQ&oe=699ED4F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QOR (QuestORama)", "keywords": [], "long_description": "Inspired by Dactyl Nightmare and Tron, you are the computer virus, sent by nefarious hackers to take down a server from the inside. Use rocket jumps, grappling hooks, and climbing to quickly dart around each Node of the server, stealing every bit of data you can before bringing the whole thing down. \n\nProcedural generation of the levels and enemies keeps every fight new and fresh. Slow down time mid-flight for insane maneuvers and Hollywood movie-style gun fights. Buy upgrades, modify your weapons, crack puzzles, and more in this Retro Tron-esque world on the other side of the computer screen. ", "short_description": "Retro Grapple-Gun Shooter! Survive in mind-bending procedurally generated worlds with a computer server you're trying to loot and destroy. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://i.stack.imgur.com/lXzGI.jpg", "developer_terms_of_service_url": null, "publisher_name": "World Wide Chaos", "support_website_url": null, "website_url": "http://www.worldwidechaosinc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27497852889861052"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_1724204525089306_1108077164007516831_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vrx4jUJ8sIQQ7kNvwF6PVsB&_nc_oc=AdnvUswguecjt4ZcWMJXxrO77n-SjGe2iVTIvT7ky5yCBSeAZtf2KY0rvA_RuxhUzx8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsvyou-lxRSBQdkZNHKN1pRwoNrLZPSsnk_Q0rTgIirGg&oe=699EF827"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QOR (QuestORama)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1620930011, "lastRevision": {"nodes": [{"id"
4.5771-25/499618093_1362652429240290_4794850623953363956_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGFiMnoaIg8Q7kNvwEEx_Et&_nc_oc=AdqFSB9D4lfRP8zNe4UaSx1V8h6AOLNh3UylVJ1MJqgIapzU2xZLvXHrKMdfi_85cj8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi1PQbHhwOBPS7OGf4mLZM5dQD3GXwVzIf7BWPV-eqcA&oe=6A55092B"}, {"file_name": "New Project (38).png", "id": "788910547590933", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618254_788910550924266_3793093031714458745_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVLcLvydiboQ7kNvwHz7NSA&_nc_oc=AdrK6StU6BQ7Z004rck3ECHSmz9_ZNqbvy-XgylmWZOry5fCGl5fDxRQ40yqTMiIIVY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0X0hfJWaGS4mXWHEOMQ6K0iT-XgtB-MVM9UiuNYRuWg&oe=6A54E603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (98).png", "id": "3583421945148700", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619672_3583421948482033_5567857744135550666_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9YBm-9XNwUQ7kNvwGiftY6&_nc_oc=Adoua3TiNiae3ejA9jghi861vYEjrAKbB56NTuKmzz2cZdXGuGcIELrVXIjqQaGAnik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqkKdIeDhBDxshMYM_8g8yVvVNWl85AQc9qdHcyAHt6Q&oe=6A54E342"}, "display_name": "Truck Racing Pro", "keywords": ["truck", "racing", "truckracing", "car", "race"], "long_description": "Truck Racing Pro is a high-intensity VR racing experience that puts you in control of powerful, heavy-duty trucks built for speed and domination. Feel the weight, torque, and raw engine power as you compete in adrenaline-fueled races across dynamic tracks designed to test your precision, control, and racing instincts.\n\nChoose from a variety of uniquely styled trucks, each with distinct handling and performance characteristics. Master sharp turns, manage acceleration, and outmaneuver opponents in competitive events that reward skill and strategy. Realistic physics and immersive VR mechanics place you directly in the driver\u2019s seat, delivering a true sense of scale and speed.\n\nDesigned for racing enthusiasts and competitive players alike, Truck Racing Pro combines intense gameplay, immersive environments, and powerful machines to create a thrilling truck racing experience unlike any other. Get ready to start your engine, hit the track, and race like a pro.", "short_description": "Truck Racing Pro is an immersive VR racing experience that puts you behind the wheel of powerful trucks in intense, high-speed competitions. Race across dynamic tracks, master tight turns, and dominate rivals using skill and precision driving. Featuring multiple unique trucks, realistic physics, and competitive gameplay, Truck Racing Pro delivers adrenaline-pumping action built for true racing fans"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0d00f946-8461-4ab7-b099-ed9129bbd7cf", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interactive", "support_website_url": null, "website_url": "https://redcontrollerinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26852086624387717"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823448_957059267043098_1115943232848161970_n.png?stp=dst-png_s360x36
b=1-7&_nc_sid=6e7a0a&_nc_ohc=izNwLenwQTYQ7kNvwF8sNV2&_nc_oc=Adpr7wCjeI9WbSmQ5zx0vIShtkIvbtwYWs-DshveKZjQTx5bRkUgY3_hGNPJGHkCDbs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoqT8ZJ0k_lM_9IKmtjOayxD2hZ0D2aK7K5PK93LwLCw&oe=6A54D452"}, "display_name": "Truck Racing Pro", "keywords": ["truck", "racing", "truckracing", "car", "race"], "long_description": "Truck Racing Pro is a high-intensity VR racing experience that puts you in control of powerful, heavy-duty trucks built for speed and domination. Feel the weight, torque, and raw engine power as you compete in adrenaline-fueled races across dynamic tracks designed to test your precision, control, and racing instincts.\n\nChoose from a variety of uniquely styled trucks, each with distinct handling and performance characteristics. Master sharp turns, manage acceleration, and outmaneuver opponents in competitive events that reward skill and strategy. Realistic physics and immersive VR mechanics place you directly in the driver\u2019s seat, delivering a true sense of scale and speed.\n\nDesigned for racing enthusiasts and competitive players alike, Truck Racing Pro combines intense gameplay, immersive environments, and powerful machines to create a thrilling truck racing experience unlike any other. Get ready to start your engine, hit the track, and race like a pro.", "short_description": "Truck Racing Pro is an immersive VR racing experience that puts you behind the wheel of powerful trucks in intense, high-speed competitions. Race across dynamic tracks, master tight turns, and dominate rivals using skill and precision driving. Featuring multiple unique trucks, realistic physics, and competitive gameplay, Truck Racing Pro delivers adrenaline-pumping action built for true racing fans"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/0d00f946-8461-4ab7-b099-ed9129bbd7cf", "developer_terms_of_service_url": null, "publisher_name": "Redcontroller Interacti
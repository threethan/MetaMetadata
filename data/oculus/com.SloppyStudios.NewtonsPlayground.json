72474088230344", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75514543_772474091563677_1215521127715163696_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bey2e0ipAlgQ7kNvwHE5Z9l&_nc_oc=AdnCBqO7nwn8B4VnSy2tQb7VZ9ZhECoimwR_lEhhB-3o6yOoD0FdTQUOis1AbtiQpGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvH_4IYbdmTcI4fQIRsrKoOPEi1BPbaBEt7MolFLjNBPg&oe=69983D40"}, {"file_name": "Newtons playground 3-1.png", "id": "1628925274581316", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031369_1628925277914649_5725811412307383290_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1U9iJEFB6UQ7kNvwGoq0RA&_nc_oc=AdkbLYh6m1mxrD1i70JRrOBEV2Ws5JzCN2cIYa0EKXnckxDJZ5G5K9Qn5I-PbYdoeJ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfslAm9LGhL7dJ9-fpgONBnL-y71oalaqsnCuwSKRbpqzA&oe=69985E87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 1.png", "id": "3566776536893791", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982628_3566776540227124_6140078054390482105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPJdafiNOmgQ7kNvwFQbhkr&_nc_oc=Adn70wau34Gk84dNrJynluHNZ-pxs9275JGQti10whOkhBnIq4lY9khfiU0nXk3o1fQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu4Ko7d_U9XYctK8CQqhsX5ryFoX8itlaq0jMubh8Um2w&oe=69983E8B"}, "display_name": "Newton's Playground", "keywords": [], "long_description": "Welcome to Newton's Playground where your imagination is the limit! \n\nGet ready to have fun with physics and let your creativity run wild. Whether you want to build a bathtub car, a custom weapon that defies the laws of physics, or just enjoy some silly sandbox fun, Newton's Playground has something for everyone.\n \n- Explore a wide variety of objects and experiment with their physics. \n- Tons of physics weapons\n- Infinite maps \n- Variety of utility guns that allow you to manipulate the game's objects and environment in new and exciting ways", "short_description": "Newton's Playground is a physics-based VR sandbox, where you can do pretty much anything you would want to. Introducing one of the most advanced and dynamic physics game in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://www.sloppystudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24802835465982620"}}]}, "scheduled_offers": {"count": 18, "nodes": [{"status": "PUBLISHED", "id": "1649216029376037"}, {"status": "PUBLISHED", "id": "2032902820823754"}, {"status": "PUBLISHED", "id": "908522498364891"}, {"status": "PUBLISHED", "id": "1536761767521315"}, {"status": "PUBLISHED", "id": "694314346291462"}, {"status": "PUBLISHED", "id": "826847366568604"}, {"status": "PUBLISHED", "id": "1111738311032822"}, {"status": "PUBLISHED", "id": "1169280791906320"}, {"status": "PUBLISHED", "id": "1937923396966598"}, {"status": "PUBLISHED", "id": "2426021321098268"}, {"status": "PUBLISHED", "id": "940591817969179"}, {"status": "PUBLISHED", "id": "954957930078051"}, {"status": "PUBLISHED", "id": "579081048263704"}, {"status": "PUBLISHED", "id": "552089010901432"}, {"statu
EE6PhGRvAXj3tRXxkYf8_t4ZqiyXqM9L3tiaQ0UHcv-Ae8unE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y1rtVXXmyAmDr27GuOaHZK9adpbl9nj1lVG3jS30EuQ&oe=69EE2700"}, {"file_name": "Newtons playground 3-1.png", "id": "1628925274581316", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031369_1628925277914649_5725811412307383290_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LS_4hc63wJwQ7kNvwEDpyGs&_nc_oc=AdryL36pQNQm_Ac0tIZw_OYz7ppktn2V6hizTR1U9mToSeavCzcarp23Q6Kcr9zQPYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23RJvz9dpgau18RWvjFkLhTiRJv-TGDiTDNmRvXynDLg&oe=69EE1007"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 1.png", "id": "3566776536893791", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982628_3566776540227124_6140078054390482105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ounc3yz0QWkQ7kNvwGbqAu1&_nc_oc=AdowtZ2ni-rErdWZ6pA2PHmm7-0C_N4ULWfuzJtha_Z4d1-SXjvv2xYOXJbqpDAUNVY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zsCXfuGtROopf92q4yzKXYtdc_6w4oDBAC6deOFbjZQ&oe=69EE284B"}, "display_name": "Newton's Playground", "keywords": [], "long_description": "Welcome to Newton's Playground where your imagination is the limit! \n\nGet ready to have fun with physics and let your creativity run wild. Whether you want to build a bathtub car, a custom weapon that defies the laws of physics, or just enjoy some silly sandbox fun, Newton's Playground has something for everyone.\n \n- Explore a wide variety of objects and experiment with their physics. \n- Tons of physics weapons\n- Infinite maps \n- Variety of utility guns that allow you to manipulate the game's objects and environment in new and exciting ways", "short_description": "Newton's Playground is a physics-based VR sandbox, where you can do pretty much anything you would want to. Introducing one of the most advanced and dynamic physics game in VR."}]}, "developer_name": null, "developer_privacy_policy
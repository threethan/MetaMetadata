Dn4vfoaQNiKx4JBuiS8Sq3eDNaRhClnyvj7KnwhsHLQA&oe=6A674461"}, {"file_name": "Screenshot Rest.png", "id": "623282587238843", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618499_623282590572176_2898599118648677581_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlCxBCk4lkMQ7kNvwFgSHs0&_nc_oc=AdpCkpCXmgmxTSDCuyn0rOGmOT7iMYhtic3vxSOi1um8QZdIkDWV3ltqq-fV5jK3Mv4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8hdqQRdnp6c3UYrYbGG8aLEwWnHwSQHTyOmbdIKcSlg&oe=6A67727D"}, {"file_name": "Screenshot 2026-04-30 170248.png", "id": "864130266712246", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_864130270045579_3981601663063246963_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_n7xuTgddoQ7kNvwH9IWoa&_nc_oc=AdokYZvixy8vIH0eDOFnHYUPAtdSaU0zOBnZxPxEwg-pMMsv_p4Ldj6U0InGSCHIAOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoIRaSRHK9fNXY5J5wy1IxjN6wkn6t-AhHmovh-EGa3w&oe=6A6752EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Build Mode Newtons Playground.png", "id": "4879744218835748", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307451_4879744222169081_7494555371032243795_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H3t0JRw0xwQ7kNvwGxQox-&_nc_oc=AdqX2Q8vxhfSBMOFTo8CounEdwS5qsrWiR7GxoNRH9RLCf82eWpx4cZBRGgDCMbE12E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDROThT7h3-7VTgQ4iAk-vwTm_7o-fVT2M8mA3rTuw00w&oe=6A676CBE"}, "display_name": "Newton's Playground : Physics Sandbox", "keywords": ["Sandbox", "physics", "fighting", "Build", "driving"], "long_description": "Welcome to Newton\u2019s Playground, the ultimate VR sandbox where imagination knows no limits! Build wild contraptions, cause hilarious chaos, or simply relax and experiment in a world where physics is your playground.\n\n**Kid Friendly Mode \ud83d\udc3e**\n\nNo Blood, No Killing\n\n# Tons of Maps \ud83d\uddfa\ufe0f\nRole-play, experiment, or goof around across 15+ unique maps, each packed with possibilities.\n\n{771069128883593}\n\n# Different Avatars \ud83d\udc3e\nBe whoever (or whatever) you want, play as a human, a mischievous cat, and more avatars coming soon!\n\n{760921390075723}\n\n# Drivable Vehicles \ud83d\ude97\nRace, drift, and stunt your way through fully drivable vehicles that bring chaos and comedy to every map.\n\n{1366761988210039}\n\n# Build \ud83d\udee0\ufe0f\nFrom bathtub cars and flying machines to full-on rockets, if you can dream it, you can build it.\n\n\n{287640354407665}\n \n  # Weapons \ud83d\udd2b\n\nUnleash tons of weapons and discover new ways to break the rules of reality. \n{1504654660791469}\n", "short_description": "Newton\u2019s Playground is a physics based VR sandbox where creativity meets chaos. Build crazy contraptions, role-play across 30+ maps, drive vehicles, and unleash tons of weapons in one of the most dynamic physics experiences in VR.  \n\nThe only limit is your imagination."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://sloppy-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mo
ng", "id": "331979676371711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65228806_331979679705044_5354118813566038953_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWbRUPPdnIEQ7kNvwENbH5a&_nc_oc=AdpxvYIKLFp_yoY0QZHDkzRt-Ldtv5nsWdfwhOXUO5dfLfYcKGBVWbFP8DISxm5hAtk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3mMB-YzTQRBhterlV_mb9xcrPRfipJQDyw1xGttD0EQ&oe=6A95E0F6"}, {"file_name": "Newtons playground 5.png", "id": "772474088230344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75514543_772474091563677_1215521127715163696_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDSWSnuVRAAQ7kNvwHCYnV2&_nc_oc=AdqXGfYrd4eQ1UV6kDAS8sFl-OTQA9_J9whPNT_0HYgSe3CK2tZNeIZZRRtt8sJchHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFszESF8K-4NB5w_LFB8Z0KMM5bwuTnPFOkhU0-1ULxVQ&oe=6A95CDC0"}, {"file_name": "Newtons playground 3-1.png", "id": "1628925274581316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031369_1628925277914649_5725811412307383290_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UJ8w4fE2bEQ7kNvwFfy_We&_nc_oc=Adp-aZ2Tb4lLuZ6UJkXGLK9ZKtwhDmSdhN-8taU_X4MQ7XBh6wPMwrQR0x1FsOxXSgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo2x5PU-VnAk2XiqIjsvNEv5EoCAuS7_KOiy7UYUvmfA&oe=6A95B6C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 1.png", "id": "3566776536893791", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982628_3566776540227124_6140078054390482105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZBVWD4TJRcQ7kNvwEizaiV&_nc_oc=Adpm0QDThcZK0--E58W7CLbULIqgj0QN5B5A_Jl6vMPa4xp-cbQ3EMt6ItX8XSh2pG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6cQwPNFYXsA4I8TZMJ2ymiySZrDqEh-Gin4RoKeF9NA&oe=6A95CF0B"}, "display_name": "Newton's Playground", "keywords": [], "long_description": "Welcome to Newton's Playground where your imagination is the limit! \n\nGet ready to have fun with physics and let your creativity run wild. Whether you want to build a bathtub car, a custom weapon that defies the laws of physics, or just enjoy some silly sandbox fun, Newton's Playground has something for everyone.\n \n- Explore a wide variety of objects and experiment with their physics. \n- Tons of physics weapons\n- Infinite maps \n- Variety of utility guns that allow you to manipulate the game's objects and environment in new and exciting ways", "short_description": "Newton's Playground is a physics-based VR sandbox, where you can do pretty much anything you would want to. Introducing one of the most advanced and dynamic physics game in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://www.sloppystudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24802835465982620"}}]}, "scheduled_offers": {"count": 25, "nodes": [{"status": "PUBLISHED", "id": "1007707185196787"}, {"status": "PUBLISHED", "id": "2505816829886222"}, {"status": "CANCELLED", "id": "993638363137043"}, {"status": "CANCELLED", "id": "4405918759628599"}, {"status": "
qnv5MxHX-Nb2mInlHnaQ&oe=69E0E043"}, {"file_name": "Screenshot 2025-02-14 122719.png", "id": "8809449612510078", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391872_8809449622510077_6541993467246747199_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfzwBlRWU-MQ7kNvwFLdvcI&_nc_oc=Adq-v5wH-mequ1alW7HoXwAcpQr6nIAKyfqC17NkC3INO5IQmSp_GDTtuA6s5j_kG3Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35GDnd4kt9xRTxEJQCLLp-zUjwoEgtDAkdd5WV7qjMxA&oe=69E0DC1A"}, {"file_name": "1000172277.png", "id": "1326129192859970", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617850_1326129196193303_6643934171486078251_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KvBQIa2k3vIQ7kNvwFLFOMY&_nc_oc=AdqfueaTzhghWWXhL_HhLle0fodeBIDC3VzKbINezJf7TDOHxHVpw4OECo5FQFp5F3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13BJi2r8FqBRJyYdeHrO4GTEt9koEAzdrvc-jKHxc0uA&oe=69E0CCCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000200332.png", "id": "838604338638482", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_838604345305148_5045739392142465562_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm7deCzYBcwQ7kNvwEndfav&_nc_oc=AdplmrjD3Guskd6kAdRWP1n0AQ93yfHH7_KiyIhncGrZDXpaoBvv1znUrizPbQStTk0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0erJ1GwEP8tBXkHB5ySY9l1HiEo9Q1Lgk2rJFe7nOeBg&oe=69E0CB71"}, "display_name": "Newton's Playground : Physics Sandbox", "keywords": ["Sandbox", "physics", "driving", "fighting", "Build"], "long_description": "Welcome to Newton\u2019s Playground, the ultimate VR sandbox where imagination knows no limits! Build wild contraptions, cause hilarious chaos, or simply relax and experiment in a world where physics is your playground.\n\n# Tons of Maps \ud83d\uddfa\ufe0f\nRole-play, experiment, or goof around across 15+ unique maps, each packed with possibilities.\n\n{771069128883593}\n\n# Different Avatars \ud83d\udc3e\nBe whoever (or whatever) you want, play as a human, a mischievous cat, and more avatars coming soon!\n\n{760921390075723}\n\n# Drivable Vehicles \ud83d\ude97\nRace, drift, and stunt your way through fully drivable vehicles that bring chaos and comedy to every map.\n\n{1366761988210039}\n\n# Build \ud83d\udee0\ufe0f\nFrom bathtub cars and flying machines to full-on rockets, if you can dream it, you can build it.\n\n\n{287640354407665}\n \n  # Weapons \ud83d\udd2b\n\nUnleash tons of weapons and discover new ways to break the rules of reality. \n{1504654660791469}\n", "short_description": "Newton\u2019s Playground is a physics based VR sandbox where creativity meets chaos. Build crazy contraptions, role-play across 15+ maps, drive vehicles, and unleash tons of weapons in one of the most dynamic physics experiences in VR. \n\nThe only limit is your imagination."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://sloppy-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35633226836276708"}, "re
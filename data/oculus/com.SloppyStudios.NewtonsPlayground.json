0&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGh03funuJIQ7kNvwHvPqYb&_nc_oc=AdqTAg7fHcrYF3jE4QtvC-Klztz3qtPmKWoFAQc133sbd1Da_gCoL1ZR_7yO1Um1ugQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVtJIjV7C2ishZ1AwPoswzy6L57KlGEvAF7CCLzvrnb1Q&oe=6B0F1CA3"}, {"file_name": "4\u94f6\u884c\u6700\u7ec8.png", "id": "1149553720811213", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908887022_1149553724144546_9024774415619985219_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfzekto2o7YQ7kNvwFKkPJx&_nc_oc=AdpMpu54wOFK5Z-Fhn4hDEte7_y6LvGmCOR1pLbOFt9MnKrtz-wO6nnrh4YkkCWok4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXaZlfUU70XSfLLMWnXQP5xYBgZbvIRtTmQ4_OkP6qRqw&oe=6B0F201B"}, {"file_name": "5\u98de\u8d77\u6765.png", "id": "1689110519556022", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839698_1689110522889355_3185838099667603747_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSV9LY_yx-8Q7kNvwFz8k3B&_nc_oc=AdqK90IWanOcbT7bp4HLSZq8YaqzodTviXt8ffjlmaYHCyKstiwnd42HmaHTPMoXD6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWCI3guOra8fAhUC883Y2tao1dxBPe642xdxChfJ0-yKw&oe=6B0F1779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NP_2560X1440.png", "id": "1505915238085839", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908839709_1505915241419172_28163490860241774_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xb4p3hg1dEQ7kNvwGVrdsL&_nc_oc=Adr0zpoup-x_TrBm3PZkgDCLg4mTcRNtbkcFGlRjUhnuxR5CycRjZOimRKOUBGEvFdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWrarv9yUcFBCaCUdFEmxxP0XBSENdWgsQyBNwE6NhfGw&oe=6B0F1D01"}, "display_name": "Newton's Playground : Physics Sandbox", "keywords": ["Sandbox", "physics", "fighting", "Build", "driving"], "long_description": "Welcome back to **Newton's Playground-Remastered**.\n\n# WHAT'S NEW IN THE REMASTER\n\n# NPCs and Interactions\nMeet brand-new NPCs across the maps, and this time, they're yours to command. Choose their personality when you spawn them, then turn any NPC into a companion that follows you and fights alongside you. Yes, that includes the sharks,  the snakes, even the zombies.\n\n# New Zombie System\nA whole new zombie system to discover - experiment with it, test what they do, and see how far you can take it when the dead start taking orders.\n\n# Map Updates\nEvery map has something new - except the infinite ones, which are already endless. The Neighborhood map has been fully upgraded, and the Cruise map now features a real-time procedural skybox with a day-and-night cycle.\n\n# Revamped Aircraft Crashes\nAirplane and airship crashes have been rebuilt from the ground up. Bigger impacts, better physics, more spectacular destruction.\n\n\n\n# Kid Friendly Mode \ud83d\udc3e\nNo Blood, No Killing\n\n# Tons of Maps \ud83d\uddfa\ufe0f\nRole-play, experiment, or goof around across 15+ unique maps, each packed with possibilities.\n\n{771069128883593}\n\n# Different Avatars \ud83d\udc3e\nBe whoever (or whatever) you want, play as a human, a mischievous cat, and more avatars coming soon!\n\n{760921390075723}\n\n# Drivable Vehicles \ud83d\ude97\nRace, drift, and stunt your way through fully drivable vehicles that bring chaos and comedy to every map.\n\n{1366761988210039}\n\n# Build \ud83d\udee0\ufe0f\nFrom bathtub cars and flying machines to full-on rockets, if you can dream it, you can build it.\n\n\n{287640354407665}\n \n# Weapons \ud83d\udd2b\n\nUnleash tons of weapons and discover new ways to break the rules of reality. \n{1504654660791469}\n", "short_description": "Newton\u2019s Playground is a physics based VR sandbox where creativity meets chaos. Build crazy contraptions, role-play across 30+ maps, drive vehicles, and unleash tons of weapons in one of the most dynamic physics experiences in VR.  \n\nThe only limit is your imagination."}]}, "developer_name": null, "d
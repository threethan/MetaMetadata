w75UQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzW4DV7sUDT88V1nA0yLuI57CKFS_gQ9NKqaD1HIwRa1A&oe=69B149C0"}, {"file_name": "Newtons playground 3-1.png", "id": "1628925274581316", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031369_1628925277914649_5725811412307383290_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr06tGyICsYQ7kNvwGTuJmM&_nc_oc=Adl7tUzb0CcVOSBeElT82q7x0JcgRPtkorT8JymaiJD_xZz-4oVwEThRjNwKBXmxjk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzaqy6zfCk64D-zI2DmJdsOMvMSE7yqV-psL531lcjuOQ&oe=69B16B07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 1.png", "id": "3566776536893791", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982628_3566776540227124_6140078054390482105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1RowduJcyEQ7kNvwEFjceD&_nc_oc=AdkmQ0pZ6_SfCZIfB9yKu7ycK3KD8jgWE_QxV8DdbGe04D_Va8g1PrCzJgo8YyxAq1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2COum_Q74lYTVksyXmQ6mLir7o9_5Dyndg_fbamHoaQ&oe=69B14B0B"}, "display_name": "Newton's Playground", "keywords": [], "long_description": "Welcome to Newton's Playground where your imagination is the limit! \n\nGet ready to have fun with physics and let your creativity run wild. Whether you want to build a bathtub car, a custom weapon that defies the laws of physics, or just enjoy some silly sandbox fun, Newton's Playground has something for everyone.\n \n- Explore a wide variety of objects and experiment with their physics. \n- Tons of physics weapons\n- Infinite maps \n- Variety of utility guns that allow you to manipulate the game's objects and environment in new and exciting ways", "short_description": "Newton's Playground is a physics-based VR sandbox, where you can do pretty much anything you would want to. Introducing one of the most advanced and dynamic physics game in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkq
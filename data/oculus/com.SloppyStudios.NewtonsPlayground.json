ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCMZUoQdfyIQ7kNvwEcg803&_nc_oc=AdpTeDn40xNKr20wYWWjG1iZztGvHsbqxh0fXRgV2_-Fe5jrfV7mSgGZkNN6GVg96Wk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTOkfsgVJAbUIrRQTa32W0Rnji-OfVEPrpZvlBUFNRzow&oe=6B0DCB23"}, {"file_name": "4\u94f6\u884c\u6700\u7ec8.png", "id": "1149553720811213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908887022_1149553724144546_9024774415619985219_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfzekto2o7YQ7kNvwGIwOVF&_nc_oc=AdrQ68ATCA_ee0vE1dK4P97Lbf3GtyHkUvcWGYgsJ-fjaUtE2_LZST_AnU-erEq19ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_EuL3FUMVB3oAs6XX-ku9D7al7nJOq-c6mVjR2BIO9A&oe=6B0DCE9B"}, {"file_name": "5\u98de\u8d77\u6765.png", "id": "1689110519556022", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839698_1689110522889355_3185838099667603747_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSV9LY_yx-8Q7kNvwHkGAnh&_nc_oc=AdobbsTUk-HnI8ZHQU82RTAhYWjg52e7LTcwjJigT0lA8txfkT5LLm27P_F9wfmxUFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5uXDRsfB6VLdO-eh1gddLmTmuxYmHEB006fqsTbrskQ&oe=6B0DC5F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "NP_2560X1440.png", "id": "1505915238085839", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839709_1505915241419172_28163490860241774_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xb4p3hg1dEQ7kNvwEQ2DSY&_nc_oc=AdoSpraDfjvtVw9ZQ0VXEYnk6U7zEUSXH0wmU536CavV8yI8ljK36HpdHZmqh2Yw3Nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLBD9UVbP0WQNYDd5RwzKj1fRDGyniZS2Vv7g4xTi1Cw&oe=6B0DCB81"}, "display_name": "Newton's Playground : Physics Sandbox", "keywords": ["Sandbox", "physics", "fighting", "Build", "driving"], "long_description": "Welcome back to **Newton's Playground-Remastered**.\n\n# WHAT'S NEW IN THE REMASTER\n\n# NPCs and Interactions\nMeet brand-new NPCs across the maps, and this time, they're yours to command. Choose their personality when you spawn them, then turn any NPC into a companion that follows you and fights alongside you. Yes, that includes the sharks,  the snakes, even the zombies.\n\n# New Zombie System\nA whole new zombie system to discover - experiment with it, test what they do, and see how far you can take it when the dead start taking orders.\n\n# Map Updates\nEvery map has something new - except the infinite ones, which are already endless. The Neighborhood map has been fully upgraded, and the Cruise map now features a real-time procedural skybox with a day-and-night cycle.\n\n# Revamped Aircraft Crashes\nAirplane and airship crashes have been rebuilt from the ground up. Bigger impacts, better physics, more spectacular destruction.\n\n\n\n# Kid Friendly Mode \ud83d\udc3e\nNo Blood, No Killing\n\n# Tons of Maps \ud83d\uddfa\ufe0f\nRole-play, experiment, or goof around across 15+ unique maps, each packed with possibilities.\n\n{771069128883593}\n\n# Different Avatars \ud83d\udc3e\nBe whoever (or whatever) you want, play as a human, a mischievous cat, and more avatars coming soon!\n\n{760921390075723}\n\n# Drivable Vehicles \ud83d\ude97\nRace, drift, and stunt your way through fully drivable vehicles that bring chaos and comedy to every map.\n\n{1366761988210039}\n\n# Build \ud83d\udee0\ufe0f\nFrom bathtub cars and flying machines to full-on rockets, if you can dream it, you can build it.\n\n\n{287640354407665}\n \n# Weapons \ud83d\udd2b\n\nUnleash tons of weapons and discover new ways to break the rules of reality. \n{1504654660791469}\n", "short_description": "Newton\u2019s Playground is a physics based VR sandbox where creativity meets chaos. Build crazy contraptions, role-play across 30+ maps, drive vehicles, and unleash tons of weapons in one of the most dynamic physics experiences in VR.  \n\nThe only limit is your imagination."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://sloppy-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "41398146393118028"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908839676_1136210795972863_8516999749976103733_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5uMZr6XQf4Q7kNvwGXFJJe&_nc_oc=AdpCX_pHDX2BhpJrpqAvk2WMmE-t5UGElDoCwCvpHzFdGY8MFdoFsZbAkpiDTG3yQi4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_LHQTpDOFvmhEifUFWVxA2OzcNZO64JvJvtdG5uf-KQ&oe=6B0DB4A5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Newton's Playground : Physics Sandbox", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Role Playing", "id": "821934236779161"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shoot
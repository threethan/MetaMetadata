ng", "id": "331979676371711", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/65228806_331979679705044_5354118813566038953_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjE_2RAvlq0Q7kNvwGlj7MV&_nc_oc=AdonHbsAibymNW9gF_VVz_vR69Zwdq40hRCdutds7avpe3DFla4s7G5KXioaZ5YP6zI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh02EF0Nh9eXX9eHtqq28eQAirtQzSXH1gindxusdpxw&oe=6A999D36"}, {"file_name": "Newtons playground 5.png", "id": "772474088230344", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75514543_772474091563677_1215521127715163696_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR7WEwpN8lkQ7kNvwFHekNO&_nc_oc=AdpfYMeVFevAUZ4ZmXY_uhxsmRW3EaOHt6aw3aHcTrgWHbJRUB0r9-XmszGdBbwSK0E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW72tW6aRhdpK2qqmnLO0HsxwmPR1LrmEUhZfmbVSguA&oe=6A998A00"}, {"file_name": "Newtons playground 3-1.png", "id": "1628925274581316", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031369_1628925277914649_5725811412307383290_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BggabwiTNocQ7kNvwEFPbNi&_nc_oc=AdrwVERVV7NS1p50jxyR0mBzlc6GFTGLWI8EochMHlqiXp2dzIz93278YF0YsVFcFNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeMS3pg5OWctlojfQoYO6W8JjepV8RiggMk_U_wfseLw&oe=6A997307"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 1.png", "id": "3566776536893791", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982628_3566776540227124_6140078054390482105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i9Sbz_7h9oQ7kNvwEbC7Tb&_nc_oc=AdrtluNtHEuElu_rKXJVqAtpqnQtmshCVlftluO-f8e1J53-XXGW2VP1XAcqs3LwT8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfNO7WgpyptTrq-jG53dPjbBJx7fJ09t0M03TMRXyVDw&oe=6A998B4B"}, "display_name": "Newton's Playground", "keywords": [], "long_description": "Welcome to Newton's Playground where your imagination is the limit! \n\nGet ready to have fun with physics and let your creativity run wild. Whether you want to build a bathtub car, a custom weapon that defies the laws of physics, or just enjoy some silly sandbox fun, Newton's Playground has something for everyone.\n \n- Explore a wide variety of objects and experiment with their physics. \n- Tons of physics weapons\n- Infinite maps \n- Variety of utility guns that allow you to manipulate the game's objects and environment in new and exciting ways", "short_description": "Newton's Playground is a physics-based VR sandbox, where you can do pretty much anything you would want to. Introducing one of the most advanced and dynamic physics game in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://www.sloppystudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24802835465982620"}}]}, "scheduled_offers": {"count": 25, "nodes": [{"status": "PUBLISHED", "id": "1007707185196787"}, {"status": "PUBLISHED", "id": "2505816829886222"}, {"status": "CANCELLED", "id": "993638363137043"}, {"status": "CANCELLED", "id": "4405918759628599"}, {"status": "
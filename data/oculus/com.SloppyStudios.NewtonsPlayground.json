ontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tForUjtzE8GkhuCuMtQSvJyoLQBep5OUVje9yNacoiQ&oe=6A1B05A1"}, {"file_name": "Screenshot 2025-02-14 120844.png", "id": "342768668931940", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473394202_342768672265273_6457984953409522667_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17XBDVzcD6cQ7kNvwFHiSJ4&_nc_oc=AdrITOX_Mn3zfPQ-CMQFMu6olvxwTnOTlHh9zz-M5I8FQlgtn6TmvdwriGQvpt2Dy3A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gMe6NkliPNgIr0emz557SmNFC3m8u0biV7uhteasdkA&oe=6A1AE243"}, {"file_name": "Screenshot 2025-02-14 122719.png", "id": "8809449612510078", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391872_8809449622510077_6541993467246747199_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LkpSAnsrXvYQ7kNvwEH2wMR&_nc_oc=AdreHH0-ntKTMJoQu0XOucqaLQCFWfXw_2geWvsJRAde8Z1kdlneORjwrAUIZe02s_U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S7zkBqp9n7zp-lteVKEFZzijl3AaXsfoSuFqh8EQYfA&oe=6A1ADE1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SUBURB_CAPSULE.png", "id": "1271821355119746", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623443_1271821358453079_6367354191726924627_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXesqSJxADkQ7kNvwFRyG1V&_nc_oc=AdotSv48pxcMP33jWD6Jx0zBvaPOmyQhIFc7yYfdrI0hXqn5ppD7w1avkNo9dWAJo7I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B8dxGicGZsyadVv5DfcB9bwYPOTsXEvdrBt2p7fVM8g&oe=6A1AE044"}, "display_name": "Newton's Playground : Physics Sandbox", "keywords": ["Sandbox", "physics", "driving", "fighting", "Build"], "long_description": "Welcome to Newton\u2019s Playground, the ultimate VR sandbox where imagination knows no limits! Build wild contraptions, cause hilarious chaos, or simply relax and experiment in a world where physics is your playground.\n\n# Tons of Maps \ud83d\uddfa\ufe0f\nRole-play, experiment, or goof around across 15+ unique maps, each packed with possibilities.\n\n{771069128883593}\n\n# Different Avatars \ud83d\udc3e\nBe whoever (or whatever) you want, play as a human, a mischievous cat, and more avatars coming soon!\n\n{760921390075723}\n\n# Drivable Vehicles \ud83d\ude97\nRace, drift, and stunt your way through fully drivable vehicles that bring chaos and comedy to every map.\n\n{1366761988210039}\n\n# Build \ud83d\udee0\ufe0f\nFrom bathtub cars and flying machines to full-on rockets, if you can dream it, you can build it.\n\n\n{287640354407665}\n \n  # Weapons \ud83d\udd2b\n\nUnleash tons of weapons and discover new ways to break the rules of reality. \n{1504654660791469}\n", "short_description": "Newton\u2019s Playground is a physics based VR sandbox where creativity meets chaos. Build crazy contraptions, role-play across 30+ maps, drive vehicles, and unleash tons of weapons in one of the most dynamic physics experiences in VR. \n\nThe only limit is your imagination."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://sloppy-studios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_
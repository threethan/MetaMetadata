&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWoyAqjalmK_1hj5HikSghmMhXVOnp_fLKl53mT_8Ukw&oe=69BA9776"}, {"file_name": "Newtons playground 5.png", "id": "772474088230344", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75514543_772474091563677_1215521127715163696_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NecB3_ibMswQ7kNvwFs8nN2&_nc_oc=AdlqGQE98BG2hiFchrfolnJshQKzrjzIId6D3OOFmbjsSfYe7gU_E-_ugHCxo7WT1gs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx81lvcunP25GO0u4akohsC3AWbks-U7mxkxoXj65tnfg&oe=69BA8440"}, {"file_name": "Newtons playground 3-1.png", "id": "1628925274581316", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031369_1628925277914649_5725811412307383290_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVC3uO3C8IMQ7kNvwGXn-iP&_nc_oc=AdkQpgOENZyHPE0Ziev__vsG5h5DLWJnwAUmXdsePkxa0Tr_ynCmmdybwKBmMe4IOfw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysW9Jd3llj4WK9loxGKW6XQ89fIuNL7nS4_iT63nHVrg&oe=69BAA587"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 1.png", "id": "3566776536893791", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982628_3566776540227124_6140078054390482105_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9DHGXwJMpUQ7kNvwEYHlLN&_nc_oc=AdmRhcO6j1GwRgb4GJQKBlRuqHeG8xmDdbfQxkxNTbW2wdhES0kUwK7U_ObI1aPlFh8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxY0jWUpwfMz0Jp70D7UBdMniO1sbUwivsTs8zAsLJDsQ&oe=69BA858B"}, "display_name": "Newton's Playground", "keywords": [], "long_description": "Welcome to Newton's Playground where your imagination is the limit! \n\nGet ready to have fun with physics and let your creativity run wild. Whether you want to build a bathtub car, a custom weapon that defies the laws of physics, or just enjoy some silly sandbox fun, Newton's Playground has something for everyone.\n \n- Explore a wide variety of objects and experiment with their physics. \n- Tons of physics weapons\n- Infinite maps \n- Variety of utility guns that allow you to manipulate the game's objects and environment in new and exciting ways", "short_description": "Newton's Playground is a physics-based VR sandbox, where you can do pretty much anything you would want to. Introducing one of the most advanced and dynamic physics game in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://www.sloppystudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24802835465982620"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "4299545590312688"}, {"status": "PUBLISHED", "id": "1649216029376037"}, {"status": "PUBLISHED", "id": "2032902820823754"}, {"status": "PUBLISHED", "id": "908522498364891"}, {"status": "PUBLISHED", "id": "1536761767521315"}, {"status": "PUBLISHED", "id": "694314346291462"}, {"status": "PUBLISHED", "id": "826847366568604"}, {"status": "PUBLISHED", "id": "1111738311032822"}, {"status": "PUBLISHED", "id": "1169280791906320"}, {"status": "PUBLISHED", "id": "1937923396966598"}, {"stat
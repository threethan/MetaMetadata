20f&oh=00_AQRSCjh40K8XjtR_LMXhtmDEKCefRQAY-T4oXpA9FGaWtA&oe=6AFB2C36"}, {"file_name": "Newtons playground 5.png", "id": "772474088230344", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75514543_772474091563677_1215521127715163696_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdtGa97P5lMQ7kNvwEuOBwG&_nc_oc=AdorutykZMf43MtuveH2PyuyhAjyMmhcjpVPXtS7BHn89yLJ_ffChKYYDLO-u_aah7Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4SZixli3OpGD01_F8kxaKkgNz7P-gBSYvk57_1Ll-8g&oe=6AFB1900"}, {"file_name": "Newtons playground 3-1.png", "id": "1628925274581316", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031369_1628925277914649_5725811412307383290_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7wSYh2onjMQ7kNvwGcEfmi&_nc_oc=AdqbGT09qxGfrOvoNsS3GN-M33rV3hJCvJXK0rvjVa9Hm3iUWHRZDgjN2o-omyIS4Ws&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQd-3tbT-AtOZnfGlHd969SB_wBmpU7KyQKQo8eWyLUQ&oe=6AFB3A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Asset 1.png", "id": "3566776536893791", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982628_3566776540227124_6140078054390482105_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypWy6hqkrz8Q7kNvwFIVhvN&_nc_oc=AdpbK4_TCDY20k31DHs3LCOaAt1rOHbIffoodIPtk9cuDONHLr-j_oA5WrwZfj8_rrg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ86koRTeYYC9qJviHEVtzlbnfdN4JRLI5tgilmcmoKXQ&oe=6AFB1A4B"}, "display_name": "Newton's Playground", "keywords": [], "long_description": "Welcome to Newton's Playground where your imagination is the limit! \n\nGet ready to have fun with physics and let your creativity run wild. Whether you want to build a bathtub car, a custom weapon that defies the laws of physics, or just enjoy some silly sandbox fun, Newton's Playground has something for everyone.\n \n- Explore a wide variety of objects and experiment with their physics. \n- Tons of physics weapons\n- Infinite maps \n- Variety of utility guns that allow you to manipulate the game's objects and environment in new and exciting ways", "short_description": "Newton's Playground is a physics-based VR sandbox, where you can do pretty much anything you would want to. Introducing one of the most advanced and dynamic physics game in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1D6BNfGb6atkqQcC0nfnctZJA78mcOWpeP5nuttz7Wlw/edit", "developer_terms_of_service_url": "https://docs.google.com/document/d/1CXW3P6emNNMZfK3T2PD8m-kpTUXwP29LklLVhr6prX8/edit", "publisher_name": "Sloppy Studio", "support_website_url": null, "website_url": "https://www.sloppystudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24802835465982620"}}]}, "scheduled_offers": {"count": 26, "nodes": [{"status": "PUBLISHED", "id": "1104807735728389"}, {"status": "PUBLISHED", "id": "1007707185196787"}, {"status": "PUBLISHED", "id": "2505816829886222"}, {"status": "CANCELLED", "id": "993638363137043"}, {"status": "CANCELLED", "id": "4405918759628599"}, {"status": "CANCELLED", "id": "1917293442992043"}, {"status": "PUBLISHED", "id": "1261219592131953"}, {"status": "PUBLISHED", "id": "4299545590312688"}, {"status": "PUBLISHED", "id": "1649216029376037"}, {"status": "PUBLI
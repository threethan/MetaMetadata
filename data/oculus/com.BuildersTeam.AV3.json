6628573493043", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974734_2766628576826376_6086476090495238385_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYYvzyZctxoQ7kNvwF6LE3g&_nc_oc=AdqtXZVkRgRd1pXFzbkqaeMTIoAfUxjjwo2D0DeD1Kbz_53z72yMSyXnegkGEcodnJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlScrCjg-tjKDmh-cMlsobwJQQNqu8X7LeRmTENQy0Sg&oe=6B05D4C0"}, {"file_name": "av5.png", "id": "965561804698294", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036641_965561808031627_3479686342881604064_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgNfy0FkxQkQ7kNvwE0XzAN&_nc_oc=AdqBNgR3GxxVro49jARgF78w0zVSm3rwArHsOkkrUhLIOeJgu60suqjn6R1WitLEB7c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv_wQqnJg-0HLPjgia9-Gg-u2HPnaiAdI41ZNMy4yG6A&oe=6B05CCED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AV3", "keywords": [], "long_description": "Step into the immersive world of AV3, the ultimate VR horror experience! Get ready to embark on a thrilling journey where you'll swing through levels like a gorilla, relying on your arms to propel you forward. But beware, for within the darkness lie horrifying monsters, poised to ambush you and your online comrades at any moment. Survival hinges on your ability to outwit and outmaneuver these relentless adversaries as you navigate the treacherous landscapes. Will you muster the courage and cunning needed to escape the clutches of AV3? There's only one way to find out.", "short_description": "Prepare yourself for AV3, the best VR horror experience! You'll be swinging through levels like a gorilla, using your arms to move. But watch out, because lurking in the shadows are terrifying monsters, just waiting to jump on you and your online companions. It's all about strategy as you run to survive the entity terror of AV3. Do you think you have what it takes to escape?"}]}, "developer_name": null
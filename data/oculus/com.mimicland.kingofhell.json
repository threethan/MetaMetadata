vOCi6iNDc8N55l5kkDUWIvMh_nhqbz8Oo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E_dN5MiKdxq7VniJeMSEaI-0x6WZCAkyT9TC-hOhpMQ&oe=6A0470A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bifqo45DuAoQ7kNvwEFPZWe&_nc_oc=AdpW3OpPxwwRvvO2S3VxrAheU8NniG3oFHkhOn71L-sDBfbQ_wChpSpui3jhQg7g2Kk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A685qdaLKVR1vugRMg1Sg-gyx9YQI-ulOlj7KfqB5bg&oe=6A0499BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywTQ6cRVRloQ7kNvwG-EoF6&_nc_oc=Adp2O-imUKZQ0YwoELmmw5fOc4FXOfJ9VXve5tusJFgDe3N4ZjYSd2NBockXWwKu1CU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FHx0FM9sgzaNjE-t8XDz0DcbWvjfZYFAWrBlQnHqFUA&oe=6A0478DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm0unY9tQvAQ7kNvwEK_zhc&_nc_oc=AdrhSsXuoXXDBXbAOSXSfPvWvmK5mYBwGoQUWL-PV80WQfUs5TdFHyU_2l0s6yLJBpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5chjXVXPasLOt0xDrprDtl3qChAamxWDuuGgJYwcUhOw&oe=6A04878E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
IdWywUf5z_b1iB5uzWffKzdZXuZnXEOfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ITizuC89hnmPaR3AChbvbaCWJELvaukBAm_N0NT_e1A&oe=6A202026"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEYfaFDy96MQ7kNvwGCPJwJ&_nc_oc=Adra6LRC9okfvGWo2jdbtIlrCwHOcqg0CXj6VrfzbKxb_yRhcxUeYEjtpKtl5tSPoTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52URcfqhypf9DIEVhQ3HI8gNKrIe11lz20qxCOBfyy9w&oe=6A20493C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMdq2J3Trk8Q7kNvwExwpaC&_nc_oc=Adr84PmZtxudsy-tDuth7kxBmv-ZZMwq7bMRtaXzkRfQJogO8FOzI2lHnNGOu-PnW64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YsazvAQlOcs49R3RcucCo1QfE3JxiIyJC9-e0o5saBw&oe=6A20285B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McySEE7pK3kQ7kNvwHZEJD0&_nc_oc=Adr0KKRRRRY8rtDN2NuhYlW1kSvvkeIZ9dT2dLnPVcQ7LyxgGRopmnnvb2NkeXGhM84&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wn5HYVQZho8N67K3xsKhShWze2_nF689LCT30Ex-3ig&oe=6A20370E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apGZ9IzaoCkQ7kNvwENiqsl&_nc_oc=AdqouHuUQGb1rslbc0y8RgPR-QRKd-q6BGucmAYUXEmK1eMUtuYNK1jYcE_uhzIgN4E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4inyoA8h-wDb1tOVwf0Jy_Zr6duxKy6-ibg6jorDjZmQ&oe=6A201C71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
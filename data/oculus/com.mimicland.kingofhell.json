oFupRkOdC4VfUniwtq-d1Kvr5su6LMb7Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdmho7cN8tGGYhQFpKMClrfK4Xn7X26zVDB6qd1VRwZA&oe=6AE09B26"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pt1-IG9KzDAQ7kNvwGpIhUa&_nc_oc=Adq-RwSCj6TTgllfo8PQYG9YXnvJ8FBbGdKPSvlrIRg-4vUdgmg7-bKWYAqVDUcjiZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQWXpAHMRjJ1rc4DtfgpbQfKebQan9s_bbuxek3cqb0w&oe=6AE0C43C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG7p3kWEegIQ7kNvwGEpimW&_nc_oc=Adpt2RIA4jVVCto1EeM-OO6LjGkTaPHWxw47VrsaF6dkVrzBGLDncu8WdEwML4XQj-Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBtLFv3idD4620KYJ5H5gohd6Ot4weRnrnBjgD1z1CmQ&oe=6AE0A35B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnPRVnPbMLwQ7kNvwEkBH3T&_nc_oc=Adpp6CgDIH16Fz5-eaUczMvv6yXlJXtEZfMq4dJnNbeebYbt4jkoL3smBhAM9h-bQq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSF8SxWPq7O33ssxIvEeZtANujKPlH2b6fivnVl0JWpw&oe=6AE0B20E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
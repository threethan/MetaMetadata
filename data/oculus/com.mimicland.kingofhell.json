z2zGOQ0scmYV2DTCQ9mSytBXff-_dTxuA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rz1cOXA1-Je-t1eymgAGMS39Z949H6MiQ4BJghTO2Ig&oe=6A12F126"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIQiUqYIckgQ7kNvwHAdibZ&_nc_oc=AdqpP5Itgi-vlsqNSN2jbTsEfxLbTTRb1V3w7Dlv30uuXT5cQBwPVtOxEKefUsc8I8o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76CDXn37gUwCjjjHVpM5B4wyz3FXJvfJtu9Y5zS-wxaw&oe=6A131A3C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zMahdV2bX8Q7kNvwGxtBlH&_nc_oc=Adrf2cB-_q799D8X8N7e346DvZEXyhiGMZSwAQkZcQye6_s43U2MVmN4MARoMVLh8uM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6himwcggFxF6yqF-durOsuuHP39CgFZPFCpvFT2SEq6w&oe=6A12F95B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLUScZaF94EQ7kNvwGaq6FY&_nc_oc=Adrf1KLwoe8tqI1erWXDJNVZxIOG6paeb38YqW9QfgXY2TBx-l8DrskpWT30-EgxwwI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P9N1hrzdf3XuGBNfKnw3iktI3YbWqjbSh0jVJs7EddA&oe=6A13080E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
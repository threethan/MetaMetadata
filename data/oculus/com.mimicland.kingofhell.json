4c465c4Tcus2ZOho0p3HKTlVoSL3ZLBSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESg6Q79XwiGXMN5gnN97oNpVP1ajTi247dcvqWJ4AKKw&oe=6A732EA6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txl8GS38bGsQ7kNvwG2ZbkL&_nc_oc=Adp3uY1DE9Y6JEyidenOIONncINwHBiLHfNHIU1h22sUIImrmqLdfM-IiDSc_zfxSgk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNxIrkOlYqyoM5i2RVwk72hXyOjc4GXJ3Zqw-w_JVm4Q&oe=6A731F7C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiV9AbdIzWsQ7kNvwGSht_w&_nc_oc=AdrH6qpifMmJLLiszTU0CHGmlSX8iwqZNskUN8sAaMKno03pPXUMUAvWe9HJJZ02cWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWk_j5x423kLri--D2Bz9OYir7k9TwC9XKBaOftHW5Eg&oe=6A7336DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfcUjqjh1jEQ7kNvwH-TbkX&_nc_oc=AdpfCH23S7PyyCfv6cf5JZZ4ONsmP6cE1y6AJU1jMmsx2D4_UkzqNXNBhAr3GB1mXEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa2uLAza8XMA3JVQMGnAEiY07yaay3wovmEOkoweCNlw&oe=6A73458E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
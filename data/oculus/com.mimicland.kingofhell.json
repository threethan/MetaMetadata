QlgkneXClgULCVZ0CmC4pDeHKGIhO0Kss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUPMNw9l4yVxxW3spa9z9YPmoYKOE2hFi0vAN9eadCqQ&oe=6A86F526"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF6nbQeImV0Q7kNvwGOPPps&_nc_oc=Adovt8cHaa0ZvkJmpDIyrzeApilKRQV9KNeIVXVkaVT1WhZ3funyhxy_G0rT0CxbTSM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYz0Thy26Jm3Wy680EjgEqPT-0GpnYrbzIKxqvI0BZsQ&oe=6A86E5FC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_g4YNuRRlgQ7kNvwGB-jbo&_nc_oc=AdrXIhmpta8fiAwGYse4d3-AcGBqAWz15empwqnoXSH1nBp7WItBNtPUTMYSfUXpxLo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBuPSOBCmUnrblPS4DrdXK3YQ56op0DuBslUIgvp6CVA&oe=6A86FD5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_U-Cde6h0MQ7kNvwF2GBhh&_nc_oc=AdoKmk-GU4JFZXN52uEpfT8k9w1gnfsIatiGMHieZkaxH9etcwOdWFry2Fs7mxBjWLQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW6SubvsgnbFq1-PBCI9YDBpvVpntJJBOHrprEKnuxsA&oe=6A86D3CE"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
qU2vcF-DP1ZiggoCA-9A7D2t2RlUiZrVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsg58pWdSiekYXV1i9gBFgENVjowrdCN2Aoe7vTMSZUg&oe=6A69F426"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sy593StPl6oQ7kNvwExeAxf&_nc_oc=Adq5EIJS9ndGBNiKKwW5LrxoFUnGfrFELJtnEB_rYmnAnFn8niSUipoqgVU23X4MBO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6JaidiiCenomoONXbt3zmmc5UZ3SVnXmVucBR3BCpVQ&oe=6A69E4FC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8DZVVPHdh0Q7kNvwFKCweu&_nc_oc=AdrxWEdbGdldSqhTbl1RkQIC-EXKT41gzOzx8XXT3rLEEDIwHTz8oAdC6saoXzlfPKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaNrC5ymcaybzlgRNMVn_U3_ybLPDv5WjNoPjryCQG_w&oe=6A69FC5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILnkm30BVG8Q7kNvwHDCH7W&_nc_oc=AdrWNmbgE0yqRuh4HtEcKSFrT89hO14mjx9rs_LAvE50nemYjsH4tA58i7knzcayvcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIl2_ioRWhcOJu1jLSLCeAPcNerSdeiOvfv7jd1oogjg&oe=6A6A0B0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
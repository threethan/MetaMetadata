0wWEFybeRGkG8x9r0L3SBRvHVVO4R884I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi80rcy7efuUVefMVG0QZsEUO4jUUfZK89uFq7ypMLlA&oe=6AEB5F66"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uKPOhTxkK8Q7kNvwG4rZNP&_nc_oc=AdpMn_Vq3xzFUibXHFYn4O3UsTS8WoyhDKRQodSX6QpbjD3aCE0aMXWSFXdirQqiGZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL_nZIKvhVAXjp1W1xWOuatm_ErmN5x3l-mXh1NJAdHg&oe=6AEB503C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It1LW9PGqr0Q7kNvwGCSTJP&_nc_oc=AdouDkS_xp9D_D-f6IKexgpW0rZ23T2zD95I7DM2qnRfVbas1O0986SDV-5h8av6WFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQpqMVT0UqoLw2Gij46NAx04DLuWJceo__N2ixLVD-Vg&oe=6AEB2F5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cSfWNOhYmsQ7kNvwG2xTJ2&_nc_oc=Adp5hNAZNzSiIyIt4kr2tidcH3IbGPdVQXzFwxo3deGm6gK8TMLaZ5JB7xhFsawpVsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHiUTbS9zWMV8yhQla7CQ7-H5hagN0ojxAUQFb3YX1JQ&oe=6AEB3E0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
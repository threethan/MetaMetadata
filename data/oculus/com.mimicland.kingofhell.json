oGboQrL0-LfsWPhLfv5DmwdFOfo8d0f8E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4tjLpSAHVxrSuUqD7PZ0PlHeFnprcYWds77l1PZQAWQ&oe=6AA001A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_8gEylppNoQ7kNvwGhoxmX&_nc_oc=AdrnjRJeUtwjiODnRhXbRmMrrK50IdbvIXtHkr0RaoTISgPwgDctMfOkvbD6-nsdf4c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhR4CK7HTrUkV8wJguEHAeM3c3x_IWJoPeAsefwLTrlA&oe=6AA02ABC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_iwkegCpWoQ7kNvwHkhlzF&_nc_oc=AdrBfCcXtzVXR3qhAdq-3Tl0YEJYDIU-ye-m9SD6aUC-5vXKWaL3m3InSlY6LU-wF9A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_Ey4sxBO3XLeGW8Q-e5pvBnWtsoXZAAJ4PZYUMQeYnA&oe=6AA009DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULgp6IBWEHUQ7kNvwESw7ys&_nc_oc=AdqkepllZGBZFBPa-nlBJjvBSRcjKIInekCeIhFQ4W3_g5Wk9nfd0oeGrDwdTb_jpAU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEiFwczuzPHOt64hwN7zoR25MIr5Wyy0stV6-G5C0SKA&oe=6AA0188E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
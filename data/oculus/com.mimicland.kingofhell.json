axmtYGujT0Vwt-XhIuY6KTivwspNTDpWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36qaNwVD-ZSRNbGJdhmN7eaQoPKmYkaiMP3I-I1Th2_g&oe=69EB6426"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx5HaACbS8kQ7kNvwFaH5Hm&_nc_oc=AdrykfPFHcPPVsAPgajIVrgRzf82JvitkR_kjEB3dXljh_zhb9J1eVm8Q_U_Cx4Vfn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-N8z9mP2D-HYhESg0JU1z2yzGyUfHznObfhsVHsADig&oe=69EB8D3C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgSNJHHRZuYQ7kNvwGcIyGN&_nc_oc=AdrEamlt3Mqr_4vZVBPgXjWBropzn1oQ7E4AbMFAHSYB72g7oX1MMKkS5c6tkqbILjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LPSATxit90hHkrrmCQWcAZMAw3pTpti7JOuzUh-2X5A&oe=69EB6C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1uBwQAeymsQ7kNvwGgSnAH&_nc_oc=Adpq2I4uJaUx6JTKuZsfWHA9X50w4HLnIBwvxEv0UzUuVk_URuSYzFdyPLaHEfikpkk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FA7QmRYrz9ZMkl1vGr9rzXWKyGLoQwtyAWoqP-mi7SQ&oe=69EB7B0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4tz1VmPWUsQ7kNvwF_uRGQ&_nc_oc=Adrv24Vy2r1TuHhyG6kWNzu8n9FqgCJvzC5fJ2jgjUiXgLkk1E74yXJ_b6iX0i-fAEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gbl-UP3l62TQ2urdWxGJMYE3B9df8QXqE9RqJXoQqfQ&oe=69EB6071"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
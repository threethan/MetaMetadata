2vAlZGBC5JCWLeaHL-SXFK-_-JaJhkKI4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pKNXh96QOXK7Y2ArR2IxxV8apKqMkDP7e41Haej_DQw&oe=69F34D26"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_fpBCT5mHwQ7kNvwFvXRoR&_nc_oc=Adp6f8UCdvAIRZ_DQC58Ds4O47fBwH3B3UkgtafW0ooRkTd6YPsBOhTria4-Q_d3oMw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1k0FMSOB3m4lUSH5Pz8i6gYVEfyYIOn8IgbE1GbmRzPA&oe=69F3763C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqDAAgQ77fgQ7kNvwHu9gbm&_nc_oc=Adpc4gyqfmfLiZ-UWH0rLHeRta6WaIeV-ZaYoVB3gykljK7zkIMgSOqKGO54cVdWsqQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3nUPwl2GtSTw2WO5KY15uhH-7IgweK1aA-CuJXt5-YYA&oe=69F3555B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nSb9tVwGG0Q7kNvwFFbRDz&_nc_oc=AdqYLlGDVWAIlfe-OtaXfBQbxi6RjV-HYoFAdgEcHeqso4xizAvL8-c7OCpm8XoRZfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LJjhtgNH0RId-ixdlGY6C0vUudcdZEauIg7nU88ksow&oe=69F3640E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
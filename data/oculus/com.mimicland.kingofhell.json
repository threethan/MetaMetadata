5fYoIdiJSTf-lhQNqtgfog7qiH-DkEIxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-BYCR6g-uotjIbcSs2cLYWTq0xcLB8ezcV7d6LzKmfQ&oe=6A9C0D26"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8szDrNR48GIQ7kNvwHUeJXs&_nc_oc=AdrcPleio6epZsrVuJhF4J3LgU6_fqDnKryX83feBjiWLDnPr0DQavoP4kbnsg3gDfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFJ5EIL0-r0FPl8hRI4pDeNWNRzWoiPgYNdaS579ktkg&oe=6A9C363C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PupK3Ka-pQQQ7kNvwFDOmj1&_nc_oc=Adp-J9rt_odmS8BRDiQUVlON01RL2L254gwTGXyCxPDH61QTSKkJyKVOh6jw_2PxOxc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrbsVOHtAYOj7T7kbIkG2-HoDGrncivItmBsZhE55alA&oe=6A9C155B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbW0krdOFc4Q7kNvwFKtkRT&_nc_oc=AdoSxdhUN5yjDfP9zJpQxkmqf9SHeB9Zms7CLsyut_-O3-XxB9cxPfu69ZE6Lwt7ez8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwab0iK7SlcznVPy_IM5byc430R7EdNx2lPTixgyBWNg&oe=6A9C240E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
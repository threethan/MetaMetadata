4CPmmb9lJFAQ-GcqJR16xBksya1-p8X_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Th1J0oZ2djTpsVTaV4Vi4v1vsioIyIFERF_S7oQz5rg&oe=69D4FAA6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD0PMctY2FcQ7kNvwHEda2e&_nc_oc=AdqFGOIplSsUmTbczTahFDLX0Z78PM_ypcNiJ3cAC-G9GhX9vVy__yfa7QPoRj9nvvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xgAgHTFXX07yt4-BAgjWbGQvx6RKihgcmspk0IgIkJg&oe=69D4EB7C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffaO8t0mMr8Q7kNvwFmHlSe&_nc_oc=Ado5OhZfIvkpnlg2C_NLoxcatU-gWIEsiDzTp7sEdWyl9aP064kB4Du7cthf5KqzeNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SYh5YOcrFHzVksWNcMMHpUFztmBCNZRAvzjoo75o47Q&oe=69D502DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvZVWS05_KYQ7kNvwErsomp&_nc_oc=Adra-Z8ri_j8iA_CFPWVR7MwdzcuRDGpBkef-njnNRcdp3V4n02rpSW-qVvtGpOg4ps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gytkAk6hzCuF2rSckMuvcxw-K52oKCJJfgBYDn3ATGA&oe=69D5118E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
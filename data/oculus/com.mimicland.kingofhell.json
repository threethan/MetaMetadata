uPG8niVDKvKAOO72RSxViE-6EL60NSQx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf5IHdJQHQtsFY57N1-4Bhs7X-IIeBoewttSERGJxH_g&oe=6AA7EAA6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYD3VHHV0JIQ7kNvwHsRAAU&_nc_oc=AdqnwBziXhqMEey4Ya_uBQxohhnZvq_qRuJCA2TK9WSxk83NMUxF9Gnd6kqG9c5E3-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1f9ERZDAmGuQOOTshMT5RJz69Y3BcuYzELPb_an_rAw&oe=6AA813BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdP-t3WqyS0Q7kNvwFcN4ch&_nc_oc=AdoFu8t-Ra5QFz82E0Ayq5kut1exRwcb_2uU7owoE3HkjI1ty__S__SqrRv0ZDqJElQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1E6fO--ycdnU0i4pBlz6h1_d2ICRqW8H2uWjr3s4Bdg&oe=6AA7F2DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prHxquCoESMQ7kNvwEW9eOf&_nc_oc=AdoqfPE465mdjVpDRfGBnDfyLkSDOTQhHkVNI5hOyivj3AVVgB6mDVZ4-0QLvwKVrJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsVk8P14IgAyhyzvfxfPOrSaHZIWzX5VTGEDmv1mO2kg&oe=6AA8018E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
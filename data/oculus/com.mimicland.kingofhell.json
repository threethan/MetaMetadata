9mvTeBqVA1magu1gAlOjtJVQtWqQWR6lY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yzHV2RR2VksYFb-_Kaf5tuLLzMJMk4CTotwWxOk0W-w&oe=69E0D826"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbc9ZvCGH-kQ7kNvwFWRriP&_nc_oc=AdpAMa0PoHusn0h5Dl23Ynx2H9MrDWq_lRd7lEDUpFh1ZvXGNl2e5ijLhSpCSd89KA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eGRapNH4Ue5Stza7tvLT0ZRUTjgZk_QLtnkg6rVyfKA&oe=69E0C8FC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9pSafJuCc4Q7kNvwHlHj62&_nc_oc=AdpwlOA79JjgLnn8V54-gFXoe9ii25lgGyKqVMGXz3uaB4OtCnuBu5lc0ha7_AQT_k4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z7WJSu-JnU82YIeVmpPTPataheiLLWd2cgh0NHhLhKA&oe=69E0E05B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFaGahbJxrYQ7kNvwGo4_MT&_nc_oc=AdqAcCopxf96z_27z1RkSa2X1mfZM4uPiTwdEs2U6j1FAzmh3tzyjAcBCuP-N8zCBAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E57Pf7BjjpGdKZWsPxqAXPY3LE31dwf_5Aze5h2SABA&oe=69E0EF0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
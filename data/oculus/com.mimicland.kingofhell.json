D-t4eBa8c_TCm5KFvJPjIteQ6bxuzpft8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8pILJ1KWIgakTi99NIlUyg_dRGvuKQNlT5hOsmUWJ_w&oe=6AF9DFE6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDrL1gGYSE8Q7kNvwFBcoyw&_nc_oc=AdpU209BYVdyMIcJz3U2-7-YVibizuBoRn5Vq2YnTegIZWpAi5s1VvMOmGwwoKGZj9o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJF0Gefrk0Ha6soY0iAUbgSLhv7BDNUr-qGwFuaJ_R3g&oe=6AF9D0BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r19FszcUPcgQ7kNvwFWV1Go&_nc_oc=Adq_cKzZYmcmQ4nsyhopvqeQKcaaLZGcX1vz2cYiCL2hBZdIztVvi4FhXXIPSJaiWMs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTo-AVJ04UK1QRBgM9kXTtThE766ISskw5cQwAxqi8lWw&oe=6AF9E81B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRex7Wog-TEQ7kNvwG3wxXV&_nc_oc=AdoZw5BF5YhANZ6Xig2yw7uHN-nO-vRnjIgZzhlyki4w02JhIK4CliYrL35z5MxGM_4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8Oi4cnDQH54HW7POlLhUDEv4E7FPzUHrIIg7dwchiSA&oe=6AF9BE8E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
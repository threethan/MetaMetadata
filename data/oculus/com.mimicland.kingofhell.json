bvFk2tqTBGHCXFZ2FJ2dydXY6DB7hIalg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70pL5txgEmvY85aQxBFfMs0jYzlIh_-hG1Gk1NteCclQ&oe=6A159426"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIQiUqYIckgQ7kNvwGM82mh&_nc_oc=AdpSqJKrRCyE-n66cPlurB27ya1LLzO6mCDNWGee61WY-at7GrX0scJyYcv22-DOOAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wIPFdrTOaSi6mP2AuSM9HqdAfSE9ZbN9dem_VfeWP5A&oe=6A15BD3C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydVEKI_CIjQQ7kNvwGv15rd&_nc_oc=AdpKhAgbwbyo4Go7c1MHa09RDybVph-Ppe--FxY4y6839_JTSybAIFHAjaylyQSzBgg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ct1Hb1OmIBiUtDwt5Y9ejO7jBNbuh8InzMoh9Obis8Q&oe=6A159C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti39A44-jj4Q7kNvwHeKHu1&_nc_oc=Adrj3NgbaoaJ5zm850G_S059-MSqVO1CSsUvDVE5b9IqzTi8UmDNV21SwbN_N_oOpsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bRulEfDKyVdknwFnTxxJNZw2PoYq_hPlUm_egnmZXDw&oe=6A15AB0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_dmEDc1JscQ7kNvwHWQRQG&_nc_oc=AdoaVvXJPQV4R-QW6LDMj09LKJ-LzCyp-3CIluOB9dysXiCixIDB4pX6Zf2n6IWSO9w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68gt1baP6IM_gJ9x2YT9I-1mkOWUyQ9jPDp5q-Sz9UlQ&oe=6A159071"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
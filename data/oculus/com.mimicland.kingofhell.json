-5V-FMYpKOel5kDsxhqb9RyqZ7KNoVWzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbqWIqsr3Iy4dxycdmM5zFw9S8TBkyh_DcTJ_sowu7hg&oe=6A7C6926"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xj-WEjtNTmgQ7kNvwFEJCDg&_nc_oc=AdrZqDdJnNWUr2qXJF8ccow4539h1KEBzIm5jeTnuTZdmrPyUfwQxGZtJr8Z_dMJVjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzGOrXlrSNLBLkw5HI85n5jEktqkcET1lw5RWhValtkA&oe=6A7C59FC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nVWoXg90AgQ7kNvwF9TAoo&_nc_oc=AdrY5Y-Jsf1qYRD3tZlZcTPjAcpXGHHVQpoRodk__KysvQuH3o8JkMZeHWCMuDLHLxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKs77CwS5III3rpawlJMUmpzMl8KXmsM004tGpWESkew&oe=6A7C715B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajiCb3-YFQQQ7kNvwF3eBIb&_nc_oc=AdqFqN6Y52EK6LuGed0l0JGcHJDMLVNmFylSwHd1Adeq5iBR5BjD7UTO-H_J4BxpeOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtbCps-26KwW8bt_w0tQ97b0HNnpvJ4WslCmBTBg8VlQ&oe=6A7C47CE"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
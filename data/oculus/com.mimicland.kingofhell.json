GHAIWwI3sPkbt2OpPfDzmtZ_jmOdQyXyw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO57Gwxsgz50ntTn4NpRp_oj4uIDg7YZYoiqgETgQbwQQ&oe=6AD3A466"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWA-yK7mzmkQ7kNvwHaEXWm&_nc_oc=AdpkhnIBGxwXE3hBXI8QqZ9AoD1sPfu_JE5DVJkdjVpUsUAnGeqVCxPGOYgZUfItYe4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP34sibrgFfiFU-EJHnL4au4ckZ1r0I-NLStWbEdbJ3ng&oe=6AD3953C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddq0eaDBp8QQ7kNvwHYG6q1&_nc_oc=AdqiiKkLhCf_HzwID3rlWwtqOsp4eC08b6Jff4PW9GsKbqeXGVZ_TZqOVOHZFrrMQJw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxO_z40RFK67HWASnQj32KMR44M97I3HycVC22bYgzxw&oe=6AD3AC9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq3OAa3UaJwQ7kNvwEBlJ5l&_nc_oc=Ado8nob0crWZlyyTyDWdneIm5o7caKuuA6wfnoklwMTclzsl1cVqqJA6CK6OaMQpPeo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZnorljT-jOS3K1nh6ilU0k5orUV89zDxwGHrwxSZ8aQ&oe=6AD3BB4E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
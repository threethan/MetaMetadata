12zhlFo1Cqv5PsBmD66pKl8n4Mk3TrSQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f2CSq9Z2pLp2n75Q7LNLV7xoDPM_PWqyMYk4ZJ7snTw&oe=69ECB5A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx5HaACbS8kQ7kNvwEOcSwJ&_nc_oc=Adr9aV3ZQbkGQLJq_y517bxOIVoFb7E1cIOgcOY0agGffun3HSANVMm1B6Q6AT_iMEY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03iAD0nUXVXcaEFA-RtEPXJ05iJz6mTblY46F6W9QBAw&oe=69ECA67C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IXyvIp6gtQQ7kNvwG-jnxP&_nc_oc=Adqza7VTNTinrFaajSlGLjdEy1e5zPhYqy3tqzXUEuTanhHo0zHHQyaYF7yi2n6WTkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S2NSIqDyfbEooH9Y5QKKbBJloFWfpJvJoQuKDrqBL5g&oe=69ECBDDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1uBwQAeymsQ7kNvwFGue8e&_nc_oc=AdoFvX-m0F8R_8Xck2oUuWJch3PySCmO0sNBFOyhAqnJLwe_olunAgG2UDwepkNUFO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KY0lTBW9TjI3_rfEfNid8wBj9JdeMDhGCPTcXzT3fog&oe=69ECCC8E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
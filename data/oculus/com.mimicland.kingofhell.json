9cQaKkeNd_cSajTHHmsJonUBaD45jR794&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYQRXtoptCDXEdsuOwRQNvzoINvnLUG5uoctpI9s4U8A&oe=6A75D1A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_X2fvMuOhQQ7kNvwExIGSt&_nc_oc=Adpd2lgZkecIxvhS3SjbD3j5wtuP2G4WLDnYw2sCGuRZaV_VayBBPAyhe20_TM_X9_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpIwutreqHhpnzGxKLWV6nL8vg0Ru0NStoO99TU5HXVA&oe=6A75FABC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiV9AbdIzWsQ7kNvwGvnjD8&_nc_oc=AdrNLS_mX8kksg0-ajT5jsWjngaPXu5PxecsbY4AJekrN3rosnoxFeIYdn-txN2tHVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt-4OgGWPFIl8A8p0JjIlJVA9vtVgBtLzlZQiUDRyetg&oe=6A75D9DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4WvRa9sVnAQ7kNvwGRSY5P&_nc_oc=AdpwNbCK5PqukTGGREMlH3srwKHgha-CY6htai-ENxUgIfZSmPYv4gUwaNlYV_mkZAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaTtI_Uop6enQGzX18qTPUswn82boyZUFYiE1nNqQeFg&oe=6A75E88E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
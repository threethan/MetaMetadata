5YK_HGLwZ0AW4MBhZpRRLGsnzwhoXZPSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J3m4GRjSIzjrovn7y3s8Bo__eA5dCMcbYhOnSOCD_Og&oe=69FF2AA6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztgPlRCfraMQ7kNvwH4O0cV&_nc_oc=Ado-YFsb7CJuoLJCJjPzwWGwdHI8kHZVcdS5Z4flS5t3nRZtV9tyRzUEQlVIA5rgT0E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E1MiptQcfn0LndiT9rrKUBewon0tgOnT9UruKL3y__w&oe=69FF53BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wGYApRSNF4Q7kNvwHEGdik&_nc_oc=AdqxStawTuXhG8JAx-hYyF01AUehAzt3EjSj9PpKjrd2KOksbwaKo54GdlbwelEza84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DVXrbKupcZOSA7O2FnRq9xFslyPpw8UUnSk46WgNrpw&oe=69FF32DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2By5ZeOiJEMQ7kNvwHSoBPN&_nc_oc=AdqcXsHsprMD_kaogd9W1NM0UYvkdoVrMrwNMypwpBy72M-vo1wOrsIyaK6KonD5Uh0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ApCOx48Q25umebkWmHK6KEoyBIN37CUHk0CJs0-jk5g&oe=69FF418E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xprXwK1YOtoQ7kNvwFzMKPi&_nc_oc=AdqZ9oKqclq9wpX3F-Gfud__f7l9FFQyzF1_qEjJ2B4KCNYWgR381cSMY2IXdVD3LoY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e0_oxPMLAQtCMc1PgUhHwRm5AQR7XRrOQeYh2Ei_8DA&oe=69FF26F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
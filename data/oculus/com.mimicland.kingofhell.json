HzFv3bOVtO49kuVCKF8_Ki5oFIcJKw8ag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GpvKuqDvtxS1_32JpYiIRF9rxaZhieM36MyteHAEysA&oe=69D8EF26"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15Aosp9MSXEQ7kNvwFk4xWN&_nc_oc=AdqS5_pLFrtH1-1Osv7D1W4uVo8qDeGc4X9T3WHDh5vhSfRsR15j4sXbln8Ej8p1d0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PRz5Ln0vd_Z99BKMo10QfkkwUqnYgmBShMd5xgYbzOA&oe=69D8DFFC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7dcx3ztY6EQ7kNvwEbavwa&_nc_oc=AdqQmMQyx79Ww0eoGqjtS5OZzdeHNBH0FgBSNkiCjYvWq4so_cybcp0rqIC6OuUbDCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qElPrYLc1w5SZxiCkC_iQHyqH-BPZl2xiEIwOBq-uIg&oe=69D8F75B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R4oF7_ijBwQ7kNvwFtKYvs&_nc_oc=AdpWVU6UsU_vuklt2WLivvzXhcNPUk4lO4wrHtxF_8WIja0zxfj7fVML83G3jBYOpd0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B9pYf7_2BSMmT1M0rKxl37CWwxnrc5wa9t4a1cCzAaQ&oe=69D9060E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8n1VIGFyrf0Q7kNvwGNun45&_nc_oc=AdpEsx2DevDRjJ-xR4WNgsURw4XV4Viq5U2UX-mc2Id1tiQfiX9sx8hB31yA3-CIYwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OgBR3JB76Xpn0rHpb4_U0-Lfj_AhAYJ5JlURP3KR1Iw&oe=69D8EB71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
TsoZ5lrxf3qv2gMzziKhPJTr0mOI3C6kQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ToMGq6EPmEHZQK3_iwOUj2n7dVf2yktq8L8-kRO7M0Q&oe=69D79DA6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15Aosp9MSXEQ7kNvwHXzCMG&_nc_oc=AdqIO3sExChBCki-X7--oSJz7gAJDLLP38OSfP3iltmJ_PIp_n_rohcZqZLwJjIT9rA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IVBW324HMheP8c3HACUVJrcPt2FGHoAbkVRaty5r8mQ&oe=69D78E7C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffaO8t0mMr8Q7kNvwGkJ0rm&_nc_oc=Adrt_LgQW2mXXgqnlx4YJHzfIzDDIjlDfLddtrKbEsvwE1XpqfQumkBnLa3x3gDyO6g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04yp9EssRQQ4VlSkQYfrZFjSvABjYIO11V5Q1JZJAjWA&oe=69D7A5DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9R4oF7_ijBwQ7kNvwE9qVVg&_nc_oc=Adr34ZYO0JAkTycdbgXt7vPYRN9lF-0QosGmGdZ9Ks0zVpqq12QqYG7tXztluD_U2zw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kkewZ2F68KM3zUC_LpdD4paWvw3gCQ303HqGcmMFI4w&oe=69D7B48E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2XpaGtZ7xQQ7kNvwG7j6Cv&_nc_oc=AdqZboPYtjsPSh0yqPIXl93NVw-CvHNoVKbUYjmS9nHFvAKFTai0mb57B8QL2kzzI-o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dJ1tmE-4K_H_tonrfoKDb-SOBz8qzedvftC_l_MedGw&oe=69D799F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
GXAfCPCyigX5m46znQiGhVBIzZseyPVX8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O6s6OfNNepFMOF5FIHyTJidMcYoPnt-c9qzTQWBu4Gg&oe=69DE3526"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhgI19qHqX0Q7kNvwHZ89_W&_nc_oc=Adr0eepdsgUCAlKjgY3--txnr5uQUL9uBEYcCBxc-1290hJBuIo3znXFGc5O_iLCD18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I5rc_XkpRLQARsw05SalMv_SkvHfh35cOH-I7swvNEQ&oe=69DE25FC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsXD0x3IV14Q7kNvwElLVK9&_nc_oc=Adoa94iIdPoPECWeZJstCKQSPtvEB3RxuI1W44dqzAvRGUSq3ndwizS1sSVHpjke1rI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gWrSMS4Lv06f_qy0J5ULuIJDTU_l_wtrszcos3Wfl-A&oe=69DE3D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFaGahbJxrYQ7kNvwFTZHpL&_nc_oc=Adq-u6a3nS1iJh8LzfcN1YnD01wtRKEp6FdAabErgLK6Y_ueYJ1IGKpD4d6AZdMXeIg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MV23FLwiKlBOyOSueubLcaTGCgCdmR4XT23ihmSHWbA&oe=69DE4C0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
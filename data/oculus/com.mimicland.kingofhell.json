P9IX0Bgc990-QPD-dthXiQ8z8wkoshdtg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqC1vqziYsLEuZ9u06dJQ0lsbenBE-5lKs9t2QHLolhg&oe=6A92D2A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZYH1keK2RMQ7kNvwGLVVAn&_nc_oc=Ado71YFzUxvH68e-LjiyKQPWJe1x0duCQskLv_gCPtl5erY_Xb0hCejRHxJerR0eiuE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFotK0G8GZs-LvzwHBltH9EGqpsFS9IVrsl39uNFYV91A&oe=6A92C37C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgmUWVh1n3QQ7kNvwHrACGC&_nc_oc=AdrEroFdVnxhWcvvjHVDVyQEmDMqvE0DvaEAgymyfM2WsA-TrizktIBG-UpdLOYshxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECenKpt1a24YtzfRJdK70P_JGyeJJZR5fuwGwfNqGj5Q&oe=6A92DADB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjLNo1C01ioQ7kNvwFzbHzr&_nc_oc=AdpbVla13JqhpxlGuH2a74uyPzLTgpLpv4irn7uhxLDOr0WK6_1-JFnVMFhYVCp9IbQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQER47S7oFwX7oFvyI99vmpEthv07f2ZmEEJynnz3zppjA&oe=6A92B14E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
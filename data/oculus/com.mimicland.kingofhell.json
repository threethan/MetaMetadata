leV4za8PZ4l00AzkE29lyThUwE7lxH77s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F3As-NTcKdLbezUztYeLWfLYpK7vmzGGjqdlko-r6fQ&oe=6A1ECEA6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEYfaFDy96MQ7kNvwHtPQxc&_nc_oc=AdoNMOOUquxJriZJ_SOsx0AFvTMB0agO2M9UZLNUKEXao86qUJzcECF9aHOgacC-xJM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45LdmxOWsFPl4tZeKA_6zrdR_oYYKS7gHMNtZ4qWtT4Q&oe=6A1EF7BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1Hkxu_BsvgQ7kNvwEwfTwC&_nc_oc=AdpvsmOz69H3EUSYPE1CFDeyS7dYqaUmX0gDr-YO0u4VFVwpUhF5RAxS1vZRg-cdb2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zNGzegQ6fwyykiV5T31VGONP5AeH1yuo5kWig4hzJLQ&oe=6A1ED6DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McySEE7pK3kQ7kNvwGY1R9k&_nc_oc=Adp3wTEATuGlpmgYIb_o37F1NeRYSWAVnWHfMnZoo44be5bdxwHAbpC2uC5CObp6DaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LNU6azHaFUcMtQNUsSLi2GyQYFYzTNIOteDiKRFqBGQ&oe=6A1EE58E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
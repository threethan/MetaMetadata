zPFkOEoNALCT4BebDTHqSRzyOo-w2jgGg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFXSgAwfX9BFJK8XiHw0GXpkm9k_8pawJOUoE6y5OUBw&oe=6AE8BC66"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uKPOhTxkK8Q7kNvwEiNwCf&_nc_oc=Adpl-75h-wRPrdXo81tp8dYE7YHAfXO3mwKbo3ody0iCUxSOTWHqqtDDyzwQKkNkLck&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBB1RtAyrdAP3tiHoypiGhYpUUxj2ux_u_2XLebUw8gA&oe=6AE8AD3C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gmtsdqbqfkQ7kNvwEKjHVx&_nc_oc=Ado7M_H64mmvkyoTcZ7OlxguQ9sY85ddCkcP3ml-D870vgGPXXrM4kxUcVR8TvIQRVg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUpi8pM45ol4dEOTC6F8GqcvpJ6Tonp6IoiXvzEeIFRg&oe=6AE88C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJdTaORj2M4Q7kNvwETOQl4&_nc_oc=AdqFReiOpDDohzohBWu92H3GDb40IXJFoWNYYdhZia4RHfuPvLWMOekVVeFjw4PT7xU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiUVyodLWjs9o8pqeQcaoiO9iKBpLkDPc5JY0-N5FiEw&oe=6AE89B0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
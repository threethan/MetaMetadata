B-QAKiyoY1q7wMRG7PvAB8voPmvJZZYBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbH8nqEBSH0t7VyW8QfeSBZ25yakI4vf7gOFDET_B52A&oe=6AA69926"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYD3VHHV0JIQ7kNvwHHSzAO&_nc_oc=AdqGzGxzdLNeZuCvLK9o9n7KiTph0lsndmR6A2lnkoUIU-Jake-m4WYXH8JjNt7jxn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmIIiqYOjMqyqS0DATvzRUHfkOKo3TOdcFgUlEHTxgsA&oe=6AA6C23C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdP-t3WqyS0Q7kNvwETRGfS&_nc_oc=Adr1cNZ7qVXKA_06Scej8fmdcKUL_auev4OAGy6XKCIB02tNztaYvcjVgi8zGhV4c6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs-4dkp6JVHicEluF8dVpVx2zKiCOTToi7V489qvdslg&oe=6AA6A15B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9xJZdHrL6sQ7kNvwE2SFZe&_nc_oc=Adre6uOr5VISkmUzpQIl7Alw1M42HzGOSUn4m7jTxE0Jsa8DccaDGYmgB13WNaeWq3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_GyqaVkj88WdGqjxzRRnqpe9bVX9qz2KcWldyT_39zA&oe=6AA6B00E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
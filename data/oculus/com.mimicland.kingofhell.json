pDKrDdH7PLkdv8m8mWFKRXRRVnzkToT3s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzpX3oWiJiaK2wf-xUcTjSi9ygClMqQp0WsEoHU3Xm1Q&oe=6AEA0DE6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uKPOhTxkK8Q7kNvwGQvmXd&_nc_oc=Adq-UIUzT2Svq4EHT5utDzpkon281ITufTbG33ykMsP1EFnVmAXUuCkWQUzlPBnH4Nw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJrvy26-XD55IIBzBhqxE7cN8TekxzaDN82-2yMATiNQ&oe=6AE9FEBC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It1LW9PGqr0Q7kNvwFNRFK9&_nc_oc=Adp6JMj8sQDsUCOyOCSoiTOXRYnrf8lCCIbEcJUyWYKk1xLS-q4PHBeD-O4UA5gCX1M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDLIziXptiQVjRORC_EDEOTH0l_eUblp-SG6VlyeE34g&oe=6AE9DDDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cSfWNOhYmsQ7kNvwFMaVwX&_nc_oc=Adp8bH37eeVTTMXRv45zC87DH0IjuKkA6097A8MbgN0bcLNc6AtvuWJnlj5eTOBb3SQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4k1ECCVq5Ukm6Lx-bzQd90DpNus5P91lmRce6TCEmAw&oe=6AE9EC8E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
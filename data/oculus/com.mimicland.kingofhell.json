XpqtIXr8GDXhJZeSTJWP-lE4g36IV0FYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsb-TxGTEqzwz3OmA9qzG77h4RG8ChtzLQ29cIdBHQFg&oe=6A5E16A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNDhQI_RPbMQ7kNvwHBKOuI&_nc_oc=AdoHABauSo1hQYgl6NV71dKcrCOh_77ubgPpsLH0T-AxwYcDvzyStV0xz8vq70pUtys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMdmC_OfWQllx-x7_LfgBNUrrRZZRLa23rdEqa0ihyFA&oe=6A5E077C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tf07RN2Yo3kQ7kNvwH89bT4&_nc_oc=Adrp6jp55XXUkUUs_z6R70Pseo2WxsucNUymnqW-4aCIuq4a44Kjgt4ORd6p605btr8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi3BXFBa-xefqlOCdoCmGTJDfpv_653N--3rW1dOQPkw&oe=6A5E1EDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEjfopniLeYQ7kNvwEPAdLj&_nc_oc=AdrkcD1zNmSXFQhsqsyQAhc_FoOPBd9cI3l1GmUeY-3EZ53ntpbMd9IDUKwXC3tsqNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvEtiACAhjJFB0mkTrhPoy0K4ReDIcTMMyjmhluGWMTA&oe=6A5E2D8E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
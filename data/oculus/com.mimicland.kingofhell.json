j_Ri-WgZCtUGnCDLKrqWGm6_l8URrrGkg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5gYdbPw2g-gglR86qrTfzViyI9oV4krM75RITuAKKVA&oe=6A280926"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z47W2Jld-rwQ7kNvwF0yL3y&_nc_oc=AdrDGka-K2KENe_OMlgd6pVUTu1CRC_uLaya32zG9Ku_HEiFSKpaeJERuC-5S2yQ2Dk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WR_HDH4cr8fpZ1D0dBfe0AsAMG1gxMOEBIS_7HA8kww&oe=6A28323C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWEXxWAlIboQ7kNvwGxv1Z6&_nc_oc=Ado-oPo7d7ytno7AVlx65MPNckwfLMrQzuWm3CkEMmsaag-7p0RJYw8WQfebzogx_9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8Pzw6vNIViaSJd8IVEt-Wofw2yzrQEBAZeys8smIofw&oe=6A28115B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiNRFvB84bcQ7kNvwFiJMo0&_nc_oc=AdrKMYqoNQpYqnBuZffNi7FauHHlKqO_rwCEsM1swM3-RfI-2Vcv0ldSNH078kTFylI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Na-BfwWRrR_UPfdAenIclmqYUJRklkLT2Zb5-wgrFbw&oe=6A28200E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
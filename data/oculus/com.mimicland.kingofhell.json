7mDB9pG8uRkTQDX5YLCP4cWJA2Yf0Kf_M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrxxKi89OmVzTaYlnsyNcYULwQTAFZcHCoM-Jfap7bcg&oe=6A9AF3E6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8szDrNR48GIQ7kNvwEP1Y7_&_nc_oc=AdoPrUPZG-jPLqGJXOu7U1v9OrBFXP4raz2lEcIc_Yk8x4vnazQ-KR-HKYsAXNNFkyc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHQ_ML0kivUDeMKdyh-0UDgE8MOHgYhcq7HZfFkJrp8Q&oe=6A9AE4BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PupK3Ka-pQQQ7kNvwEgWx9o&_nc_oc=Adr5ciW5rE1gLBEgHDWfJFivUU1FLZXqY3FF1_9CFCTluMiREmHCKN1WyEAJ4ITqANc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6gsT0ys_mnsvO3eie9z67PUDnD_usfSl3q0OMyY9R1g&oe=6A9AC3DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbW0krdOFc4Q7kNvwErZzJr&_nc_oc=Adp9Qrr0mTvo90BJCrEnd8vqTSQF52YWs4UgoxWvGwPC1gOdhyRL94Vzaqz0O9_Pu_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5QWEjFyL290yVSESdRbCyCha8G8c5XxtJu0jYnF_TOA&oe=6A9AD28E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxkx3pGHhUgQ7kNvwGCXmXX&_nc_oc=Adp_WIDmzRL8C9jjo-xyLBvam8ayscgNjXlXvTAKd4xSulHXpGVZ7b9qxy3E_Nzptsc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIduuUu_VfC3S28m2ltWzwM2yqry-KxtLxcOuAk7--8LA&oe=6A9AF031"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
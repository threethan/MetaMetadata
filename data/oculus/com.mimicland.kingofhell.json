GzbJNoxG9g6yARNwo0_6ujc22jxR6gC9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM82X-thBZrwEsHb-dnQKldc1cgO3NFy1cLcUrLywcF-w&oe=6ACBBB66"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KgUm6we2x0Q7kNvwG1_k6m&_nc_oc=Ado_rofZGQx1orWayGAwcoZMSSAd1vgUZGvrYTXUuRTYkOfyOG8IVTiN_4EQrRi1rdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmpq1AS4P3tLNE3D4LybcAYSLBDzDbjL1TQ3g_XgUInA&oe=6ACBAC3C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSwg153HdisQ7kNvwFDKX0K&_nc_oc=AdruJIooRtWoZjM4Y22Uw82amw-wq4BTfcajSrRPw6RS5SxG6GfivIwuzgqzrXPnMPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPvHZTIBMHm_VwVzWTHnyvXs0A10AtnYa3cXMknFGG4A&oe=6ACBC39B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uGidYSYrl4Q7kNvwFJ51qC&_nc_oc=AdpP5Ty6J9_gB9y6LHcCYqznjVH4g5V65ESOrNFgp3EB92j-MF1adPORJYOSvCkKW1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyv2xUyUZj5bHRg7XBy8J4ZL1cf_U-lJw-uP2I7PKSlA&oe=6ACB9A0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
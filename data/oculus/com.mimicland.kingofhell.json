6jWm7wDJL1uGVqBkffHPnnVt-AEBbVjZw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XDFMSYhsRDqKg1PfvZ5dNrZ99voETsOsg3HNc85AeIQ&oe=69E76FA6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSaJhQrCaqMQ7kNvwHdA2s1&_nc_oc=AdoCXeXTt9-WwgFqyQZENCbGyZf4X6JKB4kY35PWkJjqEDfqA6mO9zrkH9c9y-8oSHo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AsYVPmueGnefT6gv4vx7U5MkBjk7ygqMY4HXtL-8TfA&oe=69E7607C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7wiigzKG-wQ7kNvwEoo5Jy&_nc_oc=AdqPmNWYAblKB_VrUa6AaJ6YluRxZOs_10SV5ICozf5MVKZrD7E3Vk6l9y_4xDPy84c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iT4IAXKFaBWaTMY-VauNZOHPSmV7ppn6-2Q7YnregCA&oe=69E777DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1aQx7GY3wMQ7kNvwGyrusf&_nc_oc=AdpWP8AoDpUscEllBKsrs3N0uAhnDJt_iufVTCUGpxLOgV9--KIjm06QdryWeJqK3N4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af023w2wHCDc-mZ9oJEXE4HydBKsVq1r5476kVzt9e3Pdw&oe=69E7868E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
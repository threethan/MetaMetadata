8FchE2ATh1o3aNp-jfatSlVVY4xHh7tYI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qnzamVkpo5pZFbvLMOP05ftVdjMvNt90t4ziWeSQYKw&oe=6A183726"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yXAmYr0Qz4Q7kNvwE6iwNZ&_nc_oc=AdpgK9X6Y9Duh4RCo5ob8Cb0BSFFaZ7YbyxSZgbedWGlLnkQeZkMPtZ67R7sZgEpvlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R5dof3JFriS5-Kb5lm7n-F5f8U6slybIp9vEk6iXMjg&oe=6A18603C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwqhWBogWJ8Q7kNvwGhZPwt&_nc_oc=AdrkrTvl0EFZ6dRzzhJxRaH3tEhZMEu6jXyV_JQ50Nhe1SkSrk-FJOJzhxJpmk1Im3I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54Pte5Vdokix4USKx0BXWdDppomNWLWcby27_ScqBj4w&oe=6A183F5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWsiz7H3iDkQ7kNvwGdRO07&_nc_oc=AdpTMWbWu5vuCIiwUrW53WTQa7ED4opIm-peA7UW0YeUBcnPJhGSLUwHu58MnhINkOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SjONtHtxoIVzyfqrdJQZIJHtaOmDa7GeuwSwYE6TsSw&oe=6A184E0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
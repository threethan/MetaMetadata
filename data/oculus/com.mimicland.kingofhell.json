2bbjWyNtMa9A1AKPp0PjP5GWiMmrknuf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJomhF926dgRoQEErj60nX1EWNBJE6kiFXnEOgWFSpaUg&oe=6AB90E26"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkcPjcbSUzEQ7kNvwEVQe53&_nc_oc=Adq-Vf7nUI71k2Zl4DjJMdPWpeqTSJ5OHhIa7c9uXUfsKVanOwH1U1357d4TbpTy9HQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTvqtG7nxVEPn59rKgxMnQjlvTpDXbzGkDucpfUIvM1w&oe=6AB9373C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAiqM4RGSrIQ7kNvwH-u-Ln&_nc_oc=Adq0ECbpB54vwnppbv4WLJQQvZudGCu96l-CIeXjBdCPXdHLEhdFuq9c6J63-OkFTNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfE40kMaDBlDIWeivvgfLi_9hz9YlcqSvtJ7pRXU_miA&oe=6AB9165B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J_Mnrqcw2gQ7kNvwEOcdpi&_nc_oc=AdpxFG4LygJmPm7jqgVCNCd2EuzhmpJKV2nu-IVQouE7CFv5Q2mQ2umAUesH7YSELNg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLlOkDHti20jaIfOb3ZNEKSQ56CqJGU1mh85tdOhSaUw&oe=6AB9250E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
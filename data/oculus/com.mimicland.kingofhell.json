Yk8ZarTu_T8vrOvv78QUzatwk8ar4QKNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAET1-fPIMcSPWUtLc-pYhhA6WiiT9qpiRCDd4GEgvhRw&oe=6A4A5026"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6POa4Ir1y3gQ7kNvwG0N7mY&_nc_oc=AdqRGaCc8WoDjvbJ9kSO48rJd-TUzs3Mvz5iZObBG39qqkZ_D7ZkJqbP1cBZP6V5qVs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNwPNXO-xBLxQQN4Y_MewknNwiSVfbsMHgthYWSlM87A&oe=6A4A793C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3eN7ph_MowQ7kNvwGBdE5U&_nc_oc=Adre2JexK_z4Oh1aG-kVtrF0nGD_njmATexTs4F8uXQsIEFZSicSTIn0JzizYUtIXYs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIl8pThHicX0Dj2-D3ocdv5-Mfyej4jJ46D-n0PXM5zQ&oe=6A4A585B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMJyEkbsw3oQ7kNvwHjN8lE&_nc_oc=AdrBXSIvDn2nXuV863hwBffe72TnX_Yw_VAri7ijQVJUm4JRvUYL-NcgnM4DNPYAdN0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS4NWyGiBLF0Ivu_1L5q91S_Pv231G1NiONNtFbCh_ew&oe=6A4A670E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
a5ZfCxTfLdEfSSac0jaZovLS5l70LDymg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9flMozRotuoJnuGCPHeBqp_3JxgwaP7clttbSa7fGEgQ&oe=6A3BCFA6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hlol5XOwmPwQ7kNvwFe7Krf&_nc_oc=AdrA0NcullEnKe-5-kqCdxq1kZCBXdM8QB2BqjX6E8NU-RAJrmRPvRA1cfUp_FV1Y4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_blliTf_eXpO0CaUM_3U3xyv90-UfRhAtD2Grz9txoRg&oe=6A3BF8BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoDrd1yFq0YQ7kNvwF6FJy1&_nc_oc=AdrsCOONCTd6Sk7Rgdd8v39swGEYW-YFtcxj3O2jaXuTagQ4LhUSa6GRT9jQS4mvC98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_el8oG8iXjaGGG2CIdKDmjTIJKC4U4k9wDvDdE_ppcvg&oe=6A3BD7DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8C--TRX6WwQ7kNvwEH_5zC&_nc_oc=AdrKQlKj3FeaofVjoefISwjrwWnePbkcxIpjee1T0MEAAaVjzUhlz8w8Y6roDksMRlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e4lJrcVxcLbvke2PBz-s2r6V65smqoc6zZ--Qy4cs4g&oe=6A3BE68E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
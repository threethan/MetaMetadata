_lrvuZ59YLsNWgBnD3o6pcECs-LQ_uzuA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lu0xH5NKbAl0ta5ZHDemCvVX7xhIrHuQFeIeFx1mqJQ&oe=69F9E4A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNdKzGL976oQ7kNvwFrmmPN&_nc_oc=AdrnzwB8XGShHbBGh_Sk1UMvOqYVreYJfafCsvJSqtXyWT36ZxUEtJNzgAgFhMygl5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V2aTolMfzh59nzMSbMov3eKgIq3gaQlsvTRg8Bd007A&oe=69FA0DBC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDEAMJAJuNgQ7kNvwHy-B2U&_nc_oc=AdqIdAIsRnDu4eGJWH5GkWnoCvDCX0qHKxzC-0PvfZ4kTLFk7Gby1lYf5EIlCnbG3fU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WnlsZ02pwNUwKXKKGE2QEBRxPd8dLTptRUD_Rp8Giuw&oe=69F9ECDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47ZTIiQ2LPgQ7kNvwG82zug&_nc_oc=AdqEa5SqyQYUba9gcikXII17QVMo-aTay-kC-P51qIYerJQSL_vE9WB0wJyu8gYaLN0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TJmaEiIa0A2kxKL5StqXfRxA-Tk6_ZWfNzknPy9FkoA&oe=69F9FB8E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
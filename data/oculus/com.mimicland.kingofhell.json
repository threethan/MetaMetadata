FMJ2lz6g_9In6zbT_jWVtbdaw9iqvjbVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XJVd6opv50dAUZDT2UfFh3b5sBM0zLGHShCtOyrobaw&oe=6A259E66"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0RhLbYBTkEQ7kNvwFSt5Cr&_nc_oc=AdqQtE04jxhCs7Q181sOQWhGf-GHxVJ9bIzNWBAFbWU2yN3AEGY3IPBgkDvHHWnrJYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uZfQweI1VwsFRCPQoGMCo4YBmHoM6sScqzjUEbzCm1Q&oe=6A258F3C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg11uAgnAdIQ7kNvwHbZG1X&_nc_oc=Adrxx7gouQukXTBQwVw7d99StNG84PUiYi1eo5hs7ooW8vA9AJjl-yJy5no_-0G_p1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8htrosXt_-uRya-hnUaiwrR-sDlqCsjxLFXwSEDanZ7g&oe=6A256E5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvIFge88jaMQ7kNvwH9kZex&_nc_oc=Ado4vgMAuw38Y0KcXD-MD1oo5OQqVOJtc_noQ5tDzOkWJvqnIaKwk5wKPJK9gz5Ujq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OvFdLPxv2yAoa8MGOABIYFH_MBQFSUQWxI_PymEtdcw&oe=6A257D0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
-UagUIZwcKUz3T6WBwTdk-Pbrb1xSGaYc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBbMnvSSp5Go92VqjZqUgoSbGfGQpIrQZhO03m32P25g&oe=6A8AE9A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoxAaW_LRhMQ7kNvwGkgoGS&_nc_oc=AdrgePB9Pq-t9-NLNLS_D2j46QyblPWAkta9wFbL_zPUaVscvN6EH2nYqwTGkZrMXu4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMpI4JaVwpEetjct7OICvPdNpZWd7Um3wfIOI98mWH_w&oe=6A8ADA7C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZZXbM4CEXUQ7kNvwGfnuda&_nc_oc=AdrgY5RTs2CnM___u-pC2LylsZkBpgiATNfof4MDWCm4KPVsu-iw405Tm_EQ7Ae0KsI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwsnN8ief5FEZ9rQwAFxJ15HFDbwW4q5AXbvRjDGQ_mA&oe=6A8AF1DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2ybEnCMFIYQ7kNvwFzlX0E&_nc_oc=Adq-dCOVnC8Tbw8sag3zDQwE5K-3dxz9D6IvB2Kyg5BfEh2tgeBbrnFnH5SQ_P2Ztgw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMjHj8g54G-WHx70BKT2MidpAH1pXByLCdTlFMB3DIeA&oe=6A8AC84E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
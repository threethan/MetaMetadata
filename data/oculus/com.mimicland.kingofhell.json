UFKUBaZgj-Hb39chXFgzIAb68n3HK16aY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UWrRjp32NNaHSyiWMcTR9fbC-5-P-Z-CuBCGHnXpSdA&oe=6A2FF226"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL1Dc8eM1V8Q7kNvwGqdcvE&_nc_oc=Adp-lvM-fX4OERYHxYPJCl4bbis0DYDKjR_otLSZy1gA5UcA8kK9A9_ha1A6q251cC8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2oW3WVj6N_8f2d2g4D8MeErIgLutq1sMuCscen8tUgQ&oe=6A301B3C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jNWBrQRrvMQ7kNvwEJ7152&_nc_oc=AdoBMwa2tATXi9XdHYa1Rh79KXPiwQ71pvmZTc56wDFjiHVJtAMuSJARZEUTHvIBUhY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_diUuJPa42iYfxDz4N1biJwH3Evjt1bI3OvW8qqaEbmg&oe=6A2FFA5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAXmOAnpoKsQ7kNvwEY_V43&_nc_oc=Adqr6Ovna8EFmF4uBB5CmVSLj5KE552UOc25i764ZDb1OqkphY9o_2s6lDaIgocx880&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iwskb5bQc5tDwACDmxzpomQyh2cgHedY2v27f-0Rttg&oe=6A30090E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82ouzUYpDOoQ7kNvwF_qDP4&_nc_oc=AdosHCcLGs6_Xc2bNzAXwFnfVzUBK6YG3FDErP7L8k8kyscOE1fQEsrCudgObQyr6rk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t-RW1sOn6qtc71DlVcwM2WzBxEaRx6fvIUuB3k4QK4w&oe=6A3026B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
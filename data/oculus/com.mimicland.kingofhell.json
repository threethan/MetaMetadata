6nEr_YlDdDZZ605sBaoVhTUucuCjzZvvs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTXmOGqNcJCxciWyAmLPyeNtSKU8eWp3VJZY3N5PPH3w&oe=6A845226"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2jgbESeGnIQ7kNvwGlZFv2&_nc_oc=AdoRv8qRfcCu3e-hhzwNeRtkwKUbph8t1sWLbRghUjdBxWfH8xJLNxHezCPLwpS2rtE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLjm84n6CSFEO6vAotIM1t_jhJEHbK1IdjQchLO5hGhQ&oe=6A8442FC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sm8WA5xIkVYQ7kNvwFp_wQz&_nc_oc=AdpGo3XT0CRAO-Bh0ZwmIvNQjUUY9aembwJPZqQtfNl1Gr_yL0pOTK4KWcpzw2XbhHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYeZ05Sr4v9MSXaq7kxZ77BMRztgla5jpNLAoeLL5Ebw&oe=6A845A5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_U-Cde6h0MQ7kNvwFk_HNl&_nc_oc=Adrhc7LzO1A43kYEa3QLBSH3uC3wHeTpxrRX0aXCNiigVGPUzuZ5ioGyjsB_5Ydih7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmLGs8gHK9k92NL-Y2uuhNsCoEsgERC0h_6ONjR4gHsQ&oe=6A84690E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
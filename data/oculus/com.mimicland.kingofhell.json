jxtr_fzZ5wu1wDvcxf7QcAa_H1He32MGc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eKo0d9e83QNe4Sxyzf9tBhpp6m75eqHwgTSBqtQYffg&oe=69FDD926"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=II_y1czjRpMQ7kNvwFq03si&_nc_oc=AdoZmb7UqqL3QFNU3VthHA9pWFRXGEAUNy1q-Tns8nGusNLoIEDlObBmNloUNap535o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kKTDaMYW84-__n4oOxubiVbbaL8ATxLTz5fxWWBJFRQ&oe=69FE023C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wGYApRSNF4Q7kNvwFpaSlx&_nc_oc=AdpJiRONJdQc-3tJ3bnoEb_y3itPBpi7n242LHJHg85XF197bHjz6zU45H6ZPk2IQEc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SMog5Icsfjnks-cyF0REDUTbXzZ2pBlKj1VW5E_Kagg&oe=69FDE15B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2By5ZeOiJEMQ7kNvwHSVplp&_nc_oc=Ado_rRFg4HxI3oQOGPDSe2JK39nAx523mnbNG5mdB3dnS2-M4ZaTOPaZgS2TnCypMLA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7B0ZxMcWnI67yR-VcG15_yNpbYUyPuRsxWuBFpaxL4Gw&oe=69FDF00E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate the hell.\n\nHow many floors you dominate, more close you going to be a King Of Hell\n\nYou need to use hand movements to cast magic, your abilities and memory define casting speed and your success. This is not easy! But I believe in your abilities!", "short_description": "Turn your fantasies into reality! In King Of Hell, you can cast magics, build towers, summon allies, and\nmuch more!"}]}, "developer_name": "Mimic.Land", "developer_privacy_policy_url": "https://www.caiohv.com/kohprivacypolice", "developer_terms_of_service_url": null, "publisher_name": "Mimic.Land", "support_website_url": null, "website_url": "https://caiohv.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8200820640009359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974753_352136499798659_1346251698684454213_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xprXwK1YOtoQ7kNvwGU741k&_nc_oc=Adof3fV4FI7IGUezyvZuJutWh7FRTd7Wi2Q-ScgwgYVWaopHfV3HEvpApXEAXEegKP0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B1oUB5HiRSCvDMuCDFnQX9iDVPyTpKDo3G4IhCcaZ5w&oe=69FDD571"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "King Of Hell - Prototype Version", "platform": "ANDROID_6DOF", "context_cat
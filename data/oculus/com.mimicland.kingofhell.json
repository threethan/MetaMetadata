IBOC7MSiWtzyuzaVVOEqlVMDqePoflDx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrr8Yac84G7ZRfkUTvuZ3ZYewik6sG6AQJ2qbDt6g6jw&oe=6AA547A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYD3VHHV0JIQ7kNvwEh2CsZ&_nc_oc=AdpdspBl1bf5pHBsq8TqYVGmvyB3NrvXQyackfflh306FxIof2G9FVjaH6sVILkxLSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITVEF8RIU2f_rwZu70rlhW9T3aJgrmjeqDqfFL4RbvzQ&oe=6AA570BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtn8yg3Q5VgQ7kNvwFFAyE6&_nc_oc=Ado-TDjl-hGjzpB3x9W2HjOsyItKjOakHGJ6VSvRwj1tOxa_OH0O09f6apZf5b9he2A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPz_kIlx5qajpfSbCgRLJ39aud1XEoadaJ1ojuVxiS1w&oe=6AA54FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9xJZdHrL6sQ7kNvwFY6MHH&_nc_oc=AdrWrT8joHpLAOGJK-HtQTqwVoU2UmZDLlrIRAQhfBUYvBzeHQhi9mQ-BuHG-CjjjdI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSyci_tPWnMDMne37BnES3mGCzaWtTgew0VQV71Nv_DA&oe=6AA55E8E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
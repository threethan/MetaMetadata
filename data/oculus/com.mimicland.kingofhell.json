v3gU_74FxjOn8wPL_jYx17lth4-Rsfw94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcuWDZH-_6LlkRn2lfY0MaqLe9QsbWxkCTehSfeJ1T0Q&oe=6A9850E6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYrz9ewo-0YQ7kNvwGqDpct&_nc_oc=AdoIOy3InsK1n6iVBkWhcXRSP7Z0oFvzVLY-2EBGPuaVrya55WrCu8Xd1wHolcY5cuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmQRB4XkDizUL2HYED1NG6NH0HrvUO7CRDS3vhlJD8Ig&oe=6A9841BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3KhYTVl_jIQ7kNvwH0ibsg&_nc_oc=AdqdJm2rLT0qU1paDWrZLTW5irm9Dk45XVQhFoL7963ZQP11i4WEag2DrHRtpe9Yvik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7LaNw7Xnv-ygz5BGyOTIIvY38xXaXHkLCXV1iqOtkbg&oe=6A98591B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPRvj8-Ut4IQ7kNvwGecTDD&_nc_oc=AdrYPjltP-FOuWmsmyIjcRUrtxyupwN1AGnywIikoowEfz9Xh9zw76PZJd7fm8rQFHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUqsXQE_yYoQzWL6zzKEztDy0NpWh28-SJKfWKxtkkdQ&oe=6A9867CE"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
HevkVFIw_LpvC9SI8oj9NLQ7-TJTIEFDc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEEu-AHSILedXv3GqZrG0fqtv5Mku847vb0zz9_brAsg&oe=6A71DD26"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txl8GS38bGsQ7kNvwESpJZG&_nc_oc=AdpUvtLCxZh6Gz-GxGFR9IN1kzMxtWRwpZHWMRrCWBOlp4xjwzO7ndUsqaOfJ8xTrNM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpnjJkHPoubztdVlsvmscoiSqRsDvmKrvAtT746yayyg&oe=6A71CDFC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBqVqxuNusgQ7kNvwHZL8BS&_nc_oc=AdoJ1gLhtm7wCD9HLia8pm7D73f_RbbtbX31sRl9nLpatz4Wb8FBIa8ZV3ZaoqjZX1Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3f0gQibJmLpH-hByGH7-KSwOPwfBMxN4JkZS-_fHl5w&oe=6A71E55B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfcUjqjh1jEQ7kNvwFd7sOB&_nc_oc=AdpUXAaKFQgBP9JVvLJcEm0QxDpYk4WGYEzQsNY3BJZn_JWNThaZtg8UAzgJyrDqEmY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZ4QwxCtebnED5wE_duya6Y2vy4ekjXIYOeLKy-WGgDQ&oe=6A71F40E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
wS3caiP7iM3f-8k2vSxPZYnEUNlAcn37c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK421QE1X78sBuFRgtJidSh8lEGsOJm6AvDAFKCtBw-9g&oe=6AB66B26"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvJntXcOd1cQ7kNvwGdQhKG&_nc_oc=Ado_NHqPHc6Kjrjl5AvaOS5M3n8vDon-OaynxDh9sjUlXuxRoUW09qr0w5ijE5LmRw4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlJ8YHyT-Am2fnWAwFgT_tlYhDDylbYw4VLl-3tjh6zg&oe=6AB6943C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAiqM4RGSrIQ7kNvwHC4dmY&_nc_oc=AdoIhv2Bd4BlFeGjsCO3Pn6YoUjjuy6yyky05HEbwRPioPD9QHSyYCuLiSybYtmKhv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv0T3LQgpW_OdL6c79B9dtZYhZuTvDn0UIZj3yLcc-0w&oe=6AB6735B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J_Mnrqcw2gQ7kNvwE4REQ6&_nc_oc=Adp9aPl0Zs2O6YmyJRCBhPAB7i68Bqxl3bACAlpT44D-GNZqBTaqsJvK1XrWuqf6jBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJorVzPfWOQb1TA9jIqkHehrzL4GUrBZ3Kwh5kb-CTlng&oe=6AB6820E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
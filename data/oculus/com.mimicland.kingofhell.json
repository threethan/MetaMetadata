0lw25r9CDMGQgcC4xvrJ2cGqWc3nLDdMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyMUxn85j37vGXgRyu4UGxPSIeMoT84tPDnwc7DDv5Lw&oe=6AB519A6"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvJntXcOd1cQ7kNvwEJ2rK8&_nc_oc=AdpNG4Xovt_Ckk-uZTOzHXwUMYlwtGPeJ6BFYG8MOQcLnLJ8xyxEaJ2YiCH5QDEjwRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8EgPW2TQRTCUogbnLkIWPoUXwEjlrHmqjw-ImTaFJfA&oe=6AB542BC"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z88dq66ec44Q7kNvwFGzhdh&_nc_oc=Adq_mBV7iEpLQ-WALeA97WFU8c-CUnDt3CL0_S6jyIH7TFyuo0uBBouMHIZsO0kS_LI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQyISWvh6cUFRRDHMFSNN5UkiSeyQrqSNDYGYgaLuSVg&oe=6AB521DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L71LiWztk20Q7kNvwHuL0Kr&_nc_oc=AdoM4SbFudSuyv8HDyzfVCuJDaInHLhsHVBJAwT3kFZOn_NgdQsnuEtbUTz9TrQPe9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL95skDrtzKWO18OLsWuhye-4ylMVstYYsBJqcMLlR-_w&oe=6AB5308E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
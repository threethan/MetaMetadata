2_tt8DHLYoGc8Wth2BdFEuU0ANDx-7pA0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2czIjn9Njfe-SA8_PTObZrSJfcBoZ5NJa76-1SzS1DQ&oe=6AA15326"}, {"file_name": "01.png", "id": "187757353264667", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035305_187757359931333_8961427923975664833_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d56hp35bL0MQ7kNvwGiC-vt&_nc_oc=AdqqP9Kk0O_nljqUbPGj4dDd_l5C0VAgaljR4SmETPIBr7zns4VW1oU_zfwA3y5Ct5E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL82DrEZpKPuKZ-tSxVMjEK_YLJ_xyvN51rOMrr5_ZXTg&oe=6AA17C3C"}, {"file_name": "03.png", "id": "513502790085658", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974802_513502793418991_1839170041872327793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_iwkegCpWoQ7kNvwF6IV5V&_nc_oc=AdrBNH1z0oIduyDa4qTb0lG21vcl2wco8cr7SXmydw7WHWnKfVlRG3pYxUYVj1jeMbI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXztK5BqO879JQRcBa1ZZFKj1daFja9mdRBahTZqOm9Q&oe=6AA15B5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "490046042212849", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75495672_490046045546182_8844279482184451647_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULgp6IBWEHUQ7kNvwFhb6V_&_nc_oc=Adpui8nKUx8NlOnsjiarMivNQbANuKS0dpioJ11qRKF3Xe8B5Sysl7i0gtnGOzkdrJc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi9UXliEov7nk8XfyD3aVVSqZ_SZIagfTALxXQgGZqfg&oe=6AA16A0E"}, "display_name": "King Of Hell - Prototype Version", "keywords": [], "long_description": "This is a prototype game, this price is a symbolic value to help developers upgrade the game, add more levels, and help us complete this game. Thanks for believing us! (We recommend using hand tracking)\n\nKing of Hell is a first-person tower defense game. In this game, you can help your towers to protect your door to block enemies invade your captured floor and HQ where you have your plans to dominate
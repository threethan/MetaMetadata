nc_sid=6e7a0a&_nc_ohc=wS8WusVnBTsQ7kNvwGdxBoe&_nc_oc=AdrlKJ5ZfIUiaCNlfIfp1aLIciOwPWcuIS8vrJBgPaxzX_XC-ClysKCa7-ZYynyKIHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBofIw8R94oBF4KESMHf3BuDtI_BmlH0GmzKTbGPZGeA&oe=6B045F95"}, {"file_name": "vlcsnap-2024-06-19-01h00m30s429.png", "id": "989244316237396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75542968_989244319570729_1181348897418576703_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eB624HAWGQoQ7kNvwEC-n5e&_nc_oc=AdpQCtK-sf21gBpyxWFtalJbzNp8UNvrNGhpItDUx38L3nRLn4ElFh_eG2r-Coz0bgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8R9GcuFNUgKzaw6SVeg4GfDr5zGgoG4PeY628LNQUmA&oe=6B048676"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starlight-screenshot-7.png", "id": "948696866751343", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75322602_948696870084676_9063999772544294177_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSXwFlhVDv4Q7kNvwGS7vOq&_nc_oc=AdolGHXYunItow--MDUaTus_tNmydGfjzjUJveUBh1t-wfX0fgZV9cAStQOJxOd4pyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq_-fo_VqaqZk6bsMzsKCR2lV0ftGyi07WhLsF8bQmiA&oe=6B04527A"}, "display_name": "STARWAVE", "keywords": ["stars", "space", "music", "dance", "fitness"], "long_description": "STARWAVE launches you into a cosmic voyage of high-energy music and exhilarating freeform movement inviting you to discover a new way to flow. Feel the rhythm of the universe as you soar through distant galaxies bringing color and light to the night sky. Ride an uplifting wave of energy that delivers you a daily rush of interstellar euphoria \u2013 no subscriptions required.\n\n# GAME FEATURES\n\n- **Feel the Adrenaline:** Experience a lightspeed voyage across the stars. Swing at Supernovas in any direction, swirl through Stardust Trails, charge up Comets, and destroy incoming Asteroids. \n- **Free Your Flow:** Create your own style of movement and become the center of gravity. Never flow through a single level the same way twice!\n- **Discover New Music:** Vibe to a pulse-pounding hyperspace soundtrack as you journey across 36 unique areas within six different galaxies.\n- **Create Constellations:** Gather star energy and create majestic constellations in the sky. Chill out in \u2018Stargazer\u2019 mode for a meditative retreat to observe your progress.\n- **Play Daily Challenges:** Join the community and play new challenges each day. Tap into the real-time cycles of Earth\u2019s moon for bonus incentives, and complete streaks to rise to the top of the leaderboards!\n- **Grab Collectables:** Hone your skills and take a chance at mining the starfield for hidden crystals holding mysteries waiting to be discovered.\n\nComing This September to Meta Quest 2 and Meta Quest 3. Wishlist today to be first in line. ", "short_description": "STARWAVE launches you into a cosmic voyage of high-energy music and exhilarating freeform movement inviting you to discover a new way to flow. Feel the rhythm of the universe as you soar through distant galaxies bringing color and light to the night sky.  "}]}, "developer_name": "Skymap Games", "developer_privacy_policy_url": "https://www.tigertron.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Tigertron", "support_website_url": "https://www.tigertron.co/contact", "website_url": "http://www.playstarwave.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
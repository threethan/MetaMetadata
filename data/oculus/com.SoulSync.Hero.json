 demon mobs and take down giant bosses across the city.\n{1391411769404711}\n**Power up your hero** - Grow stronger, unlock powerful abilities, and become your ultimate form.\n{1206230354924367}\n**Big city chaos** - Smash through streets, buildings, and everything in your way with real impact\n{3226080060928002}\n\n\n\n\n\n", "short_description": "The Ultimate Multiplayer Hero Brawler."}]}, "developer_name": "SigmonVR", "developer_privacy_policy_url": "https://www.sigmonvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SigmonVR", "support_website_url": null, "website_url": "https://www.sigmonvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "28584795721112794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296236_1055749140778082_7982605267538367062_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X_K89bw89kQ7kNvwFbZ3aN&_nc_oc=AdqEmXMBRXCGtG_SHGwuu7F2qBFV-N5oWUIvXsx5wBmlTkIuUgG9yJZYsxiAvsUb_9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtwf5A460fmoxwYdr1NL6zRjTQQ_ra5AcGVc4J7lFHFg&oe=6AA563DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
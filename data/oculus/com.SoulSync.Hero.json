 city.\n{1391411769404711}\n**Power up your hero** - Grow stronger, unlock powerful abilities, and become your ultimate form.\n{1206230354924367}\n**Big city chaos** - Smash through streets, buildings, and everything in your way with real impact\n{3226080060928002}\n\n\n\n\n\n", "short_description": "The Ultimate Multiplayer Hero Brawler."}]}, "developer_name": "SigmonVR", "developer_privacy_policy_url": "https://www.sigmonvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SigmonVR", "support_website_url": null, "website_url": "https://www.sigmonvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER"], "id": "26708069048785480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618444_1942811213294619_8238253910913594454_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYQJHUMJx5wQ7kNvwHsRFmH&_nc_oc=AdoKogHhX4eOnesxeJCmPRG9hBuNjnr_MIcJ6PLnAE9QAxTR9a7Jk0QuBIDnqdLczbU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fFZMlHJuzVZycwAhN8X40qP5DV4OeikqlwPN08-TvPw&oe=6A11AC2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HERO x HERO", "platform": "ANDROID_6DOF",
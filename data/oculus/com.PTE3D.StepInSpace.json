C72DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Step In Space", "keywords": [], "long_description": "This app is in Hungarian, including the interviews with the second hungarian astronaur, Tibor Kapu.\nMagyar nyelv\u0171 alkalmaz\u00e1s, mely a Kapu Tiborral az ISS fed\u00e9lzet\u00e9n k\u00e9sz\u00edtett interj\u00fakat \u00e9s a PTE a k\u00fcldet\u00e9shez kapcsol\u00f3d\u00f3 kutat\u00e1sait bemutat\u00f3 vide\u00f3kat tartalmaz. A vide\u00f3k els\u0151 ind\u00edt\u00e1skor ker\u00fclnek let\u00f6lt\u00e9sre. Kapszkodj a falba \u00e9s l\u00f6kd el magad a lebeg\u00e9shez!  N\u00e9zz k\u00f6rbe az ISS fed\u00e9lzet\u00e9n.", "short_description": "This app is in Hungarian, including the interviews with the second hungarian astronaur, Tibor Kapu.\nMagyar nyelv\u0171 alkalmaz\u00e1s, mely a Kapu Tiborral az ISS fed\u00e9lzet\u00e9n k\u00e9sz\u00edtett interj\u00fakat \u00e9s a PTE a k\u00fcldet\u00e9shez kapcsol\u00f3d\u00f3 kutat\u00e1sait bemutat\u00f3 vide\u00f3kat tartalmaz. A vide\u00f3k els\u0151 ind\u00edt\u00e1skor ker\u00fclnek let\u00f6lt\u00e9sre."}]}, "developer_name": null, "developer_privacy_policy_url": "https://space.dev.coretechs.app/beavatkozas/policy", "developer_terms_of_service_url": null, "publisher_name": "University of P\u00e9cs - 3D Printing and Visualization Centre", "support_website_url": null, "website_url": "https://pte3d.hu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hu"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITT
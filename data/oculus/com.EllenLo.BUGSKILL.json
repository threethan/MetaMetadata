01441021815_8196978001827908541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6dtSTP1uj0Q7kNvwE42c0K&_nc_oc=AdkPKkI13ZuuNS0NtJbEnXlrgAfP17laZD7SXa0x8NxMmtST5eTSUZBZ5ct8-JxZNkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2qCXQ7K1rphdNjrOZg4PxnxC4Qf4jVJh8S-DmdR3EiQ&oe=69AC34DA"}, {"file_name": "Screenshot 2025-03-12 at 2.29.57 PM 1.png", "id": "1168039431478416", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391920_1168039434811749_8398898411443861078_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPUFgxgpkYQ7kNvwFJ9ApQ&_nc_oc=Adnp4Z8O16b6FScCsX-mm_Nsa-He2_zb11kS766x4toil4EP8QEJJp6W_y0DUnXVgeo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYF_nOR_QDevXkLPTf8jOGIIUQxU1BKzqZlb1bcEo9Hw&oe=69AC0F01"}, {"file_name": "Screenshot 2025-03-12 at 2.36.46 PM 1.png", "id": "1878907729604540", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393584_1878907732937873_4686257099949296753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jQTlcS_F08Q7kNvwE-DknC&_nc_oc=AdlB9uTlxIs19HTX3BcOZlm8cF_pNI4mizVsT-kqswJXc3CBDy4UxbtqVW12KWj90cU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxMM4zUBc9A_1zWUMuj0Wz6LTYD3V_sSQRqctNpp7wdkA&oe=69AC15E0"}, {"file_name": "Screenshot 2025-03-12 at 2.42.13 PM 1.png", "id": "1152601146322346", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393507_1152601149655679_2520310392683909651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTieorbAg38Q7kNvwHZVoKu&_nc_oc=Adl6NeFPHYM63bsxdMOsnKqR3R0WCc_2ENRZncu4zWKWxsuzvZGrto4yDqpseVYO0no&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztWz30x1fkK3qy5zTshDWPr-_240SkAogZ8zCzm_6xNg&oe=69AC38B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BUGSKILL Cover Image.png", "id": "589623914110746", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391950_589623917444079_1022935771109339523_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eBtXVrK5wYQ7kNvwH2ohrT&_nc_oc=AdmtZuBXt4Iy1pNkpyOxSzdwXjGpdMwXZrc_KcoSmhur8jgtnhSp8jOEzpWFwbUyPWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpHuoXlluo0YCwf3yRapnaPt7r2x9a0RGPEK5Nlhh6Dw&oe=69AC15EF"}, "display_name": "BUGSKILL", "keywords": ["bugs", "action", "workout", "swat", "flies"], "long_description": "\u26a0\ufe0f **WARNING:** Your home has been overrun by a swarm of pesky flies!\n\nTrain your reflexes and get ready for a workout \u2013 these flies have mapped out every corner of your space, and you've only got 30 seconds each round to hunt them down!\n\n\ud83d\udca5 **Slap every surface within reach and clap your hands with precision!**\n\n{1311848080050938}\n\n\ud83d\udd2b **Spend your hard-earned $BUGS in the shop and upgrade your swatting game!**\n\n{623392463949631}\n\n**Do you have what it takes to reclaim your space?**\n\n\ud83e\udef8\ud83e\udeb0\ud83e\udef7", "short_description": "\u26a0\ufe0f WARNING: Your home has been overrun by a swarm of pesky flies!\n\nTrain your reflexes and get ready for a workout \u2013 these flies have mapped out every corner of your space! Slap every surface within reach and clap with precision! \ud83d\udca5\n\nEvery successful swat earns you big $BUGS, which you can spend on upgrading your hands with whimsy yet powerful abilities\u2014from a frog\u2019s sticky tongue to firing bullets from your fingertips!\n\nDo you have what it takes to reclaim your space?\n\n\ud83e\udef8\ud83e\udeb0\ud83e\udef7"}]}, "developer_name": "Bouba Games", "developer_privacy_policy_url": "https://ellenlowing.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Bouba Games", "support_website_url": null, "website_url": "https://ellenlowing.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
01441021815_8196978001827908541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j459xQYJ8ewQ7kNvwHL8VYn&_nc_oc=AdkEtg0-8bBBhDuLojOIKuckAiYTGdyvVcK_PPvyzhMJjjJ5NTgIyi2qYicil6c5Woc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfssWs4ZTz7pU9ZLkSH1p8rinHltUfc9PONfyua6BgyF9g&oe=69A991DA"}, {"file_name": "Screenshot 2025-03-12 at 2.29.57 PM 1.png", "id": "1168039431478416", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391920_1168039434811749_8398898411443861078_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mxdnV2Nyv0Q7kNvwGG78uB&_nc_oc=Adkjv8WATZNCnw4ZS-TgF9ePJ5k0a-wFubl18P4LckDUG_o_0T5BDPytJv0JFvmgz7k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuynvwUR91468zNzFe-FB2e13MtLBSFHa4VX_fOWfHIIQ&oe=69A96C01"}, {"file_name": "Screenshot 2025-03-12 at 2.36.46 PM 1.png", "id": "1878907729604540", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393584_1878907732937873_4686257099949296753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bicPGpkcTrUQ7kNvwHicb77&_nc_oc=Adm07ZmlL8wn7MRlH8b8PjbrLx4UeG1pHDN9eac_uSS9GAteX_FhPwp5mHHU_boOxJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsUHnDj1taIo1jHXETI8syR1W_P9DLhpsOXTQMfgcjhWQ&oe=69A972E0"}, {"file_name": "Screenshot 2025-03-12 at 2.42.13 PM 1.png", "id": "1152601146322346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393507_1152601149655679_2520310392683909651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW7bsmkn4Y0Q7kNvwGEnWkL&_nc_oc=AdlYSRak7QpOGylWsryfF_znWcHCqULHyo-NWX3Zq7Dbog8UtJ6nyrIV_3QK5Duzx0M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuJQ3NT9niCBCRHgKSLwUrE1WKgS08kwqdY15Cn_HlYlQ&oe=69A995B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BUGSKILL Cover Image.png", "id": "589623914110746", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391950_589623917444079_1022935771109339523_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d--vekAvmcEQ7kNvwHGoTXv&_nc_oc=AdkgTHuPFTStsGp1Q0cPI4aXMu0Orrniz8t_Ax51eDuALRO6Yff0NQUqP83rAI3tHyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvdEAogAI5g6oAySFSHYzGiCAMsMHut7r_SE1h-hbez6w&oe=69A972EF"}, "display_name": "BUGSKILL", "keywords": ["bugs", "action", "workout", "swat", "flies"], "long_description": "\u26a0\ufe0f **WARNING:** Your home has been overrun by a swarm of pesky flies!\n\nTrain your reflexes and get ready for a workout \u2013 these flies have mapped out every corner of your space, and you've only got 30 seconds each round to hunt them down!\n\n\ud83d\udca5 **Slap every surface within reach and clap your hands with precision!**\n\n{1311848080050938}\n\n\ud83d\udd2b **Spend your hard-earned $BUGS in the shop and upgrade your swatting game!**\n\n{623392463949631}\n\n**Do you have what it takes to reclaim your space?**\n\n\ud83e\udef8\ud83e\udeb0\ud83e\udef7", "short_description": "\u26a0\ufe0f WARNING: Your home has been overrun by a swarm of pesky flies!\n\nTrain your reflexes and get ready for a workout \u2013 these flies have mapped out every corner of your space! Slap every surface within reach and clap with precision! \ud83d\udca5\n\nEvery successful swat earns you big $BUGS, which you can spend on upgrading your hands with whimsy yet powerful abilities\u2014from a frog\u2019s sticky tongue to firing bullets from your fingertips!\n\nDo you have what it takes to reclaim your space?\n\n\ud83e\udef8\ud83e\udeb0\ud83e\udef7"}]}, "developer_name": "Bouba Games", "developer_privacy_policy_url": "https://ellenlowing.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Bouba Games", "support_website_url": null, "website_url": "https://ellenlowing.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
01441021815_8196978001827908541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqiN-TdB8_wQ7kNvwHFu42F&_nc_oc=Admr58xFmfajZwrVYDRsYN0bsQXK8FoGlDyNVw_RT66nqzAKZ-23eC982aqLDV5GWGM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVaIrZafQ6T9B03qtTemTTLPP6SVIdQhSWOFzobM5naw&oe=69B17ADA"}, {"file_name": "Screenshot 2025-03-12 at 2.29.57 PM 1.png", "id": "1168039431478416", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391920_1168039434811749_8398898411443861078_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiihPp1nVmsQ7kNvwHABT20&_nc_oc=AdnK5DvEyDUfbXLXcKCLum5Xg0itMZ2Jn7UkFIz5x13GyyD6TnZO-ONlMjMMgQEhnds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnGUVwO51kgHEyicSSPtssXY-MQ39Gb_zilJYTjjGARg&oe=69B15501"}, {"file_name": "Screenshot 2025-03-12 at 2.36.46 PM 1.png", "id": "1878907729604540", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393584_1878907732937873_4686257099949296753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEpAqyhSajEQ7kNvwE4Qj8u&_nc_oc=AdkKwbcGIaM8r3TyuRQaFynUDuHitLL21RD3YMzujhYW_v_MMTzFeUlnCRE6xksXl9g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfystKMTbHtl20MjliX0REV3jvZPOAzlpnN_pc7kvK2YjA&oe=69B15BE0"}, {"file_name": "Screenshot 2025-03-12 at 2.42.13 PM 1.png", "id": "1152601146322346", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1152601149655679_2520310392683909651_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35SWSIoc6DIQ7kNvwFplG1y&_nc_oc=AdmhKmlNKNYAaikBcP-xw9OYwIxeCtQO8cR66W19JMC1TKLdI8BSAtBsS8D_W2_XG20&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpAr7rsFxKRZmGAfhEJRgascKopN2iKsts03MbS76-lA&oe=69B14673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BUGSKILL Cover Image.png", "id": "589623914110746", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391950_589623917444079_1022935771109339523_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Neiwu2K6u-IQ7kNvwEYpdA7&_nc_oc=Adk4G7cuwYtK3I0ChPP1b_latxmUQrsfAslCVO-rpTfuPVG0-b9hAQeb5-XY0ngkdL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLuvQrbf2M0I7dKRFlzNucn_6d4_50Dow32APQyyXWjw&oe=69B15BEF"}, "display_name": "BUGSKILL", "keywords": ["bugs", "action", "workout", "swat", "flies"], "long_description": "\u26a0\ufe0f **WARNING:** Your home has been overrun by a swarm of pesky flies!\n\nTrain your reflexes and get ready for a workout \u2013 these flies have mapped out every corner of your space, and you've only got 30 seconds each round to hunt them down!\n\n\ud83d\udca5 **Slap every surface within reach and clap your hands with precision!**\n\n{1311848080050938}\n\n\ud83d\udd2b **Spend your hard-earned $BUGS in the shop and upgrade your swatting game!**\n\n{623392463949631}\n\n**Do you have what it takes to reclaim your space?**\n\n\ud83e\udef8\ud83e\udeb0\ud83e\udef7", "short_description": "\u26a0\ufe0f WARNING: Your home has been overrun by a swarm of pesky flies!\n\nTrain your reflexes and get ready for a workout \u2013 these flies have mapped out every corner of your space! Slap every surface within reach and clap with precision! \ud83d\udca5\n\nEvery successful swat earns you big $BUGS, which you can spend on upgrading your hands with whimsy yet powerful abilities\u2014from a frog\u2019s sticky tongue to firing bullets from your fingertips!\n\nDo you have what it takes to reclaim your space?\n\n\ud83e\udef8\ud83e\udeb0\ud83e\udef7"}]}, "developer_name": "Bouba Games", "developer_privacy_policy_url": "https://ellenlowing.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Bouba Games", "support_website_url": null, "website_url": "https://ellenlowing.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
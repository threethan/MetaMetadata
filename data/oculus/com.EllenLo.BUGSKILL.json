m&oh=00_AfvlNpBZ1eHlluiDIiXITsS7-euSA2hcUCiyLD8pmOjJqg&oe=69A189EF"}, "display_name": "BUGSKILL", "keywords": ["bugs", "action", "workout", "swat", "flies"], "long_description": "\u26a0\ufe0f **WARNING:** Your home has been overrun by a swarm of pesky flies!\n\nTrain your reflexes and get ready for a workout \u2013 these flies have mapped out every corner of your space, and you've only got 30 seconds each round to hunt them down!\n\n\ud83d\udca5 **Slap every surface within reach and clap your hands with precision!**\n\n{1311848080050938}\n\n\ud83d\udd2b **Spend your hard-earned $BUGS in the shop and upgrade your swatting game!**\n\n{623392463949631}\n\n**Do you have what it takes to reclaim your space?**\n\n\ud83e\udef8\ud83e\udeb0\ud83e\udef7", "short_description": "\u26a0\ufe0f WARNING: Your home has been overrun by a swarm of pesky flies!\n\nTrain your reflexes and get ready for a workout \u2013 these flies have mapped out every corner of your space! Slap every surface within reach and clap with precision! \ud83d\udca5\n\nEvery successful swat earns you big $BUGS, which you can spend on upgrading your hands with whimsy yet powerful abilities\u2014from a frog\u2019s sticky tongue to firing bullets from your fingertips!\n\nDo you have what it takes to reclaim your space?\n\n\ud83e\udef8\ud83e\udeb0\ud83e\udef7"}]}, "developer_name": "Bouba Games", "developer_privacy_policy_url": "https://ellenlowing.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "Bouba Games", "support_website_url": null, "website_url": "https://ellenlowing.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "
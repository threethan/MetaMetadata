809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75340705_311024403870142_3357050452853084209_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TqPXwoA1T8Q7kNvwHo0kIX&_nc_oc=AdqsDUTY7eRtfe7T8Z5lhtlob5VYzIpdMbwapnxAI4RZmu6CX82py3rKpErKHM-u3vI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u4AYdqIzGAO9cES4sm_AxVRKqyxD0vyu_ZldDFBmVOQ&oe=6A19A03F"}, {"file_name": "HE2.png", "id": "303549211126470", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974608_303549214459803_438939639669068543_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4yBQGPqDBQQ7kNvwF6OLre&_nc_oc=AdrqcVYnmEtoxU5wJ9Osx88IFaVZVDOQRn7NUA3YOWuhH9g1pId9yvUxpQnKl_kvZFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fw1neZGhtGfYk2Q5arZSqFV7v0DKlahy5z9EscaYOQA&oe=6A19B291"}, {"file_name": "HE3.png", "id": "206473297559159", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572921_206473300892492_4336045712849382759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftek7S4RakIQ7kNvwE26zh3&_nc_oc=AdqXoVkbF3-DVz6Jf0xE2Y3AFZyEovI8VphR0XBVFYcnQSO-hsadG0KNhKt9AiZd3ec&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rrbuUdjIK6zrusxlWH-WRq11Ojuh1elTF-lRpsd-wjQ&oe=6A199E4F"}, {"file_name": "HE.png", "id": "108699074576608", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569434_108699077909941_7133727349026548389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hzo1bThlIaUQ7kNvwG9AZe6&_nc_oc=AdrD8vFv2mBRKOI6yn7RtzphKbNiaArJELMuT0faIFXBOQULjePDdlX0N32Jd7o9lCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VF9JRSHDFk0b33RtEbM16DYEtHGiPRL98Rmbvjy0GRQ&oe=6A198956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hevidimage.png", "id": "277758523843664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195904_277758527176997_7822016112091654481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHoooUQyDqMQ7kNvwFlyZsy&_nc_oc=AdrA0tzTAGEewlM2QZ_Dnd6dJvTZU34lL9A9oWQVD98VyeIR351vcj3lV8heuFDQFcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54ySu5jq2eDDnAf_p9LXIh3GnzP7-T-lOAys54QRRhyw&oe=6A19B1C7"}, "display_name": "Honor Everywhere", "keywords": [], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by Healium, T-mobile, Ohio Hospice-American Pride, Central MO Honor Flight, Midway Electric, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": null, "website_url": "http://www.honoreverywhere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area"
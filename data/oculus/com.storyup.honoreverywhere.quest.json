-iad3-1.oculuscdn.com/v/t64.5771-25/57569434_108699077909941_7133727349026548389_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN5uHHNsHBUQ7kNvwEOdH1m&_nc_oc=AdoWXkawPhRcXn4Z_yGVPMxCU_G_Z3IZCEcs08hRCtcOzlrsdAbLtv69oVBImp7iD04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSojjXy_PMFHskuPLflsx_yW-4hlc7jaO5IsPPvz1GXyQ&oe=6B05BE16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hevidimage.png", "id": "277758523843664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75195904_277758527176997_7822016112091654481_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0FgwxMymnMQ7kNvwEMXXkL&_nc_oc=Ado4_Az1o4MuYr5not1MuE1Z9EfKnNebB9ucOdUYRmIklpjtwzfdN3KAwzE4M7Spq7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA6SBio5X7IQkW-flw8mdJjIL5q5M0WjsBGirrlpkYwQ&oe=6B05AE47"}, "display_name": "Honor Everywhere", "keywords": [], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by Healium, T-mobile, Ohio Hospice-American Pride, Central MO Honor Flight, Midway Electric, Jaunt, Veterans United 
-ord5-2.oculuscdn.com/v/t64.5771-25/57569434_108699077909941_7133727349026548389_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC31NM_ovWYQ7kNvwESBUxg&_nc_oc=AdqQ-FrR-QttMvAlCcnjYmK-tDSv46ioyaG_7NgrMPlB-AuNHqAmbfM99EelkSr70Xk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlXbl9uxoHCWXbCz5gCrB9S_-79YGDrbkoUNEd6wrBuQ&oe=6B0DA716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hevidimage.png", "id": "277758523843664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195904_277758527176997_7822016112091654481_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bLbRKoCDT8Q7kNvwHBzKax&_nc_oc=Ado6jj4_4uoKFh54eummuU0K4rODRUwKBPF0FHgWeOuXxvWZVBpz2DCJMJynFJ6DmUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlx6BYD3I6-zOP8FbML9OzGO59vXGetli_e8ssJBDDqg&oe=6B0DCF87"}, "display_name": "Honor Everywhere", "keywords": [], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by Healium, T-mobile, Ohio Hospice-American Pride, Central MO Honor Flight, Midway Electric, Jaunt, Veterans United 
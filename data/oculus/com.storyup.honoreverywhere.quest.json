vfwVUlnLxAhBTwySBeyf8egzQKxLqxDqTO5CTtYWnqBy8IduB38liFs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvtWFv67qMP9cIGmfJXXoOG1lXqgLsForcBxaeZ5GKhWQ&oe=69A990BF"}, {"file_name": "HE2.png", "id": "303549211126470", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974608_303549214459803_438939639669068543_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Wl2quLrVaYQ7kNvwEGAv24&_nc_oc=AdnrDigASBj6wxk6PCmYiUgf-gjcPZ6Tl4UFaiKgN6ByyHjo16Ck9yD1EZTqePoxP2U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsxMfIOrMZtBvIaqFrzS52edUubACCqwfkhWX0IiCkiEw&oe=69A96AD1"}, {"file_name": "HE3.png", "id": "206473297559159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_206473300892492_4336045712849382759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00ArzSPwl3cQ7kNvwEqGdnV&_nc_oc=AdnYrn0TTvDGGWuT53zA4FGzVK4mjZ7xsj4FruTavL3XQAivtGuz1PPoyZ5NdNOuk-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7PX25F-91RfsKodhAQiKdE6rl_PiMjxASeQ02L86wYA&oe=69A98ECF"}, {"file_name": "HE.png", "id": "108699074576608", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569434_108699077909941_7133727349026548389_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sbk78CN1_isQ7kNvwHlozQk&_nc_oc=Adn_QsMyFk99_GY1PUesFBhIxCjqZUJECmipshBfeMqaHDTE3xp4bXK8rRVS-7C5LVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvtTu2NlrqmXWwkMtQGC6PXn4E5dthjp9NSOBka4q2-lg&oe=69A979D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hevidimage.png", "id": "277758523843664", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75195904_277758527176997_7822016112091654481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chqN5eWQIQIQ7kNvwHGJRCP&_nc_oc=Adl9I6_wjS_ucwe8kL8HK6I4GVxMTja9V3z-6HT8hgSo9jf5zFscr0Ml0XPJRjDW99Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvrvcXStj-f4BbQ2IYhpR0xnFEbln22UXE4lhHIfHNeNg&oe=69A96A07"}, "display_name": "Honor Everywhere", "keywords": [], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by Healium, T-mobile, Ohio Hospice-American Pride, Central MO Honor Flight, Midway Electric, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": null, "website_url": "http://www.honoreverywhere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OC
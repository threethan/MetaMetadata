.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3c6GhMP17a8JSgDo1W0CGQ81QEppuiKBXndbZ7VVjESw&oe=69EF5956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "hevidimage.png", "id": "277758523843664", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75195904_277758527176997_7822016112091654481_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzaojhXd0WIQ7kNvwFfqdHo&_nc_oc=Adqu90lgM9jejlHjZkh9De5ENcxtb9--8TES54DaF_-Pm3dluz1XdjlxNIkxxOIM664&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wmIm2gbZm6kiuZTyr61FejToZb7TdKmHjDLPlYGg65g&oe=69EF81C7"}, "display_name": "Honor Everywhere", "keywords": [], "long_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. These stories told through the eyes of our Veterans are a virtual alternative for aging and terminally ill men and women who aren't able to physically travel on an Honor Flight to see their memorials in Washington, DC. There is no replacement for an in-person Honor Flight but for those unable to physically travel, a virtual tour is one option. To support your local Honor Flight, please visit honorflight.org.", "short_description": "Step inside the World War II, Vietnam, Korea, and Women's Memorials in Washington, DC plus get an inside look at the USS Nimitz. This virtual tour program is for aging and terminally-ill Veterans & their families who are unable to physically travel on an Honor Flight to see their memorials in Washington, DC. These experiences are donated with love by Healium, T-mobile, Ohio Hospice-American Pride, Central MO Honor Flight, Midway Electric, Jaunt, Veterans United Foundation, & VR volunteers."}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://tryhealium.com/privacy-policy", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": null, "website_url": "https://tryhealium.com/honor-everywhere", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26082946444677627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031487_2969034223328716_9066247033374379319_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcRads5GkkgQ7kNvwEb1ptd&_nc_oc=Adobs3QyEbZsHSGJxPZOWihbh0VateurO4jAUkGqGSKHgEplVzzwRCO63ooLFB_mUbU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_bB7kFsmmCRvsSJ8v9oqr_0WIIK2-SQojo4CJX2DchQ&oe=69EF5A97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Honor Everywhere", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1625706066, "lastRevision": {"nodes": [{"id": "1811363599027150", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "3973885592677029", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2595858500442809"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images
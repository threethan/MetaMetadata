00_Af_CZ138Z2j2KajWTMqJ0maT8traydoETlrm7r_fnNY8QA&oe=6A26CA57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K_pORaGnu8Q7kNvwHrhcfV&_nc_oc=AdoeV5hNpEUV7ACfkM4bN27QWzyVuYMgST35eCN6QteUEHQDJ7c3pOJEcaqdgEL-eKg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uWLewmXoItn3k748phSj6xlmhUxXMrf0a9IwQVcs1Vg&oe=6A26C861"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HT1EiD-04UQ7kNvwGMlsNJ&_nc_oc=Ado55nEOkMFxIT1hu8xXv5UFEDF53CNmZVSi9uz-8IWC6Y5hJ4tBpwC-55KQ07M20Fc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bhOCURNkBSu77JvpMFJ9DUg25AbnRXntO2mZBcA3oTA&oe=6A26EED7"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vqClGpca9sQ7kNvwHbypUf&_nc_oc=AdpFM_wFkEJhyAOk-IVciUxE82Q7VtGdmNJ1uzNJjLGs5nFPbzspCYfhZDsrnTszfuI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OUSfZ1exqPVijGct1B-_4Gd5pKVh_seSVIP2n1arq0A&oe=6A26BD22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIGT26H4SP4Q7kNvwExhH42&_nc_oc=AdoMu0fOcz7ZcvnVUe0d4PeODzZBwcX8-JcMlH5SILJ7SA1V3GJ_wfS9dNeTqModKc8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p5oMC64zHqKRsbxw9R36iIMmLIt71nnRM2zVA7v-PfA&oe=6A26E1AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
00_Af7uH37H7cfGZkxQAkx-wX_Y3Jx2xdVmlnSQMFKGqcjtDg&oe=69FC9A57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viye2ta_MggQ7kNvwE0fSHF&_nc_oc=AdpPwJze49Jrrm3NTf4tBR7Dx1cXp2cdHcmv9DGrJBEps0L87VwoHsCUxenxlgv-pas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7oRM-_c9chSLzsC4DdTByn3fc9zSmtnaD9665itCbO9Q&oe=69FC9861"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk0wbmKMhSIQ7kNvwG5m6mg&_nc_oc=AdrbRFcWPJeUwUIDeLww_OE9cKkQ2psguadTF-bmbqDXQSs_lwutyv7S-qJ_u5KKNzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SC8Tqe5ItlU0BRIkUbBGOtir_1PQDDsM1eQcnuLZ0bg&oe=69FC8697"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEb7rJMR9uoQ7kNvwHZ6Xv1&_nc_oc=AdrB8nFeoa1CPt7hgBFZ8FDukSWbdx1zFktyJ1MEPXoAiQ_HOfh6dolXQ2mUwqpI32g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e341Oun1DyZ27QKHzPGcErndx2WXoFKYTmGiGrNpagw&oe=69FC8D22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9dJd5BmhwYQ7kNvwG9DGCa&_nc_oc=AdrPdFFbaH9Zt0iWvCw1n5zlrNwRdQe9cDgUhf1rEKYIVEnz5xLAA48qfwp-JasSFxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PzdgMn6SZqGgejBprgQc0SQOUCc8vHlwGi9LHRZ41Yw&oe=69FCB1AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
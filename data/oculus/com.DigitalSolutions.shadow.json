K5YQ7kNvwGxCFkR&_nc_oc=AdpYI3PSeOymcc5xglk49eft2ZeDblcTvRii-1Rp1tmC7RlutegrHMqnr-3oPWkj0b8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByu7GdEt1LwjdjLcIKwslpiwU29iVTjhea0YE72_5_IA&oe=6A6CA9D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ64iY23QK8Q7kNvwELXEIM&_nc_oc=AdpGVLouOuz3ojVWBLXz9fmp10yaQHCK_cMT5qcAD-WhbNmbGNRkXjK0ANZXaNd_0MM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjJ8gnY42nq30eQGQLAkHkEWNnuj8lpoM2fV6le8aPqQ&oe=6A6CA7E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9_2zMSmKRMQ7kNvwFW0YY7&_nc_oc=Adr3NJnBKCtKHz8ohbQym1h-70a2UbSakGEaETCmArcwtif6moimAmsIx1I0-vXY3Ag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjJsIVg3ojp_-ts2wUP1lfFohdgMFAvuRPhs3bsSKazg&oe=6A6C9617"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPLI8OcBMdIQ7kNvwHnHZBX&_nc_oc=Adrs8NlDNWtqrsFCkV5R4UfiO2yKJMxVXg0F_SA1vdpHxTbor_QVkNJ-i5dxRzsImdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWjehOMS7r1W96sVhJImw40xTWcgYTbHDjW1BFT7Ge4g&oe=6A6C9CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5j_v-6Ma_IAQ7kNvwFBJ8iu&_nc_oc=AdqytxEX8cu0ER2Vd7YgBVeRowno16MNuacoHpawax318qqRxURnyDHHRPnn8sBcnxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHMjixVWMb-AqFbToSp0XfepIpTPizO35SCPl3s7bQEg&oe=6A6CC12E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer
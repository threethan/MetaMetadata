00_Af0PpM7cPUNiAoWaUetjxG5xmrp9UvJVPJvKqxKnbJKojw&oe=69E78257"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEAdTiVTKhwQ7kNvwHFB6j4&_nc_oc=AdrxCT00xbbf9B32OBwgHU_AOi0pHJOzmg4ATlcdFnELn5iaPUqUNPzH-gFR0ju0f9Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xHYxbLuOt7Ej2NRdo5283bSy1l0stk-rOe4NiXe2zgg&oe=69E78061"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nowpvrOb1mUQ7kNvwGRiMTw&_nc_oc=Ado79rdaMeYQpbRycK2mbOwD8mYw0AwJ-gu8m3Ct-PYiQLLCiIV5tl6LnCiWJWy7gCg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OBtlh-R1eomkUFudehfywrYdeH9g0WJR9W9tNaMQEWA&oe=69E76E97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCxiW7pC7IcQ7kNvwElV7-0&_nc_oc=Ado0DRkbCQqMXhK2d_qR9FCY6SGGT6LoPEQYzZQlgDzj-jXkBWa9-HYAH1HMRGUJBMM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c5-F7upGXUCfR9wJciwzaoE-sW7AtKjMU99mAFwRHEg&oe=69E77522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRDCz0eFCTgQ7kNvwHTnMsG&_nc_oc=AdpIu3u5zuHaCJ-hq6tctdLHFp7LY25ZlAatoBlsIfKA8WjhB4wb8yuH5tn0Ias_i5k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xZ1DcSYQK6jY3xTYi7QNOvMEAykaeF0zkzhkw98Aoiw&oe=69E7616E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
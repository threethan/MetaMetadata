00_AfwUBbsWf2g_LC0PFDx-CHJBRfm2QpTDDqdrOynXvfdhWA&oe=69C3E9D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUxW_eUFqtcQ7kNvwE8YslT&_nc_oc=AdoczyD46tsKSzR1H0MrmoYoJuEOXq8okJ_yzg0mjywjrKS3LNv9pvtJNfm4x4HIT1E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkbgA0lAev3cvjT5HdzhGdFWJObkoW3N1F-TPmuYRCIg&oe=69C3E7E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlOC-WvqxOAQ7kNvwHM2I_H&_nc_oc=AdohSxPYFuqYqoXa9VtAFUa2r_zW-Iso0Rr61aXGXHvKel9WrHTomgl4htr99b_J_XI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIZfPoci8yfzolGV15k1vfk_X_RvwHJ0G_1ghuhn65Jg&oe=69C3D617"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66F-FFH97-4Q7kNvwFvE55v&_nc_oc=AdqjnKPLFa7Q3-ZjbinAZ3Kf5fea-7EtCPGhRVDInMshejb5T99t3jUPOHx3xhSz3L0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz9lsa93uU-uOwSXf3dOw7E48UjxrrxmoX9eIJ0umLZVw&oe=69C3DCA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV-MJg67m_4Q7kNvwFEsYBd&_nc_oc=AdpWSmP5w6Fjki1wEocdp2fAd3FFyM4HCT5zs619n_123ILEOlYDCDq3avMkBAJqDlw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQ9XdFrjUyHypAQmEUUryb3WCf-YqCHCXvGwm3bD47jQ&oe=69C3C8EE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
00_Afz_1XIdpnhSAtHV-sn0La891OGE-SueDGr_HxToFG4uXA&oe=69C53B57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IfToxnTVLAQ7kNvwFZ76c_&_nc_oc=Adqtz8PQ_5uOG_R1g6cKf8hgoUFCuIXfQ9eBNlM97_PIJmejoU0qoWFTkf3QsXZCRzs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxaemr2J4q51vQITMOPbNWvtVzUh8-OwIDjB9rxryeWJA&oe=69C53961"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3t5vHB8j8eIQ7kNvwEEEjCW&_nc_oc=AdpH2OEZp4-dHra-g111I_0CZ0a4tNtdFbVz0rBlZ97szrw5btKcTP3umqMxEP5vR6A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz22WB_eg7_bgzjY3l46dXXKQbS_gaLt7j7oXS0hjf4Ng&oe=69C52797"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVrti_uVFbcQ7kNvwHnF8j0&_nc_oc=AdoFozPNAB8A5XbkcyxI4MTtZK0DoF_9SNl2UTEppUrJlL8zzRfGQ8ovLOF4LfCCuEc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzco8bv4cleS9T0pBR2TGkeA_rNrWxSY_XD1f7LKf-D4g&oe=69C52E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV-MJg67m_4Q7kNvwF3FQ03&_nc_oc=AdoQ5f-GfTEYsCP35H8hNFwrckkMRCu5BGO_MdOgWElyNoinT9HPGwAhzuQTkEIFYuA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwwx7uyn29lHdx5tbybMsoum9KxBHolUlphtsVD6JcKsw&oe=69C51A6E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
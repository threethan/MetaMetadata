svvlfeWkgFcs8Eln0jU_IWe1epKb_uTiTPCBj92YTYng6l8xI62IpnP-ltez3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO59B9iBXsrXr2h3hKwJTeKb0OgSeDlBW6bymx-U1BXQQ&oe=6ACA4457"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6TAU1FO528Q7kNvwHYApfR&_nc_oc=Adqo1VtR2tP2RjpQjLlOGOs4mz30d16EwM0_3cQg0t9eUlZbF0BKQtgNS7zndF9MxFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLfzoCrUCrsdiD5imuOkp-eKZuHvBKUdAkID6UUZoKiA&oe=6ACA7AA1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJYuwGZixg0Q7kNvwFSri2a&_nc_oc=AdokRqYBRMBhiC6WwQhhhXn9Ed_lhophqoqzejQ9e6SLFhMqHbcYYvgs9coGXipYrm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkBkZJCZ2anYBvAlOPtQv97tMu94j6lnJw-ArmHm-4rg&oe=6ACA68D7"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPYz_C7K4EAQ7kNvwHPm5TB&_nc_oc=AdpUiYEwWd-6ThcEEw5uskt9Lcg4Sk3evn40V_J3XHfkjlH9XYCy0YvHx-xURH26lHE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-za0zIa3h09OFJSXf8q8F3C-I3BRIa0DwdLcIFssYmA&oe=6ACA6F62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYfL-hqSyUMQ7kNvwERvWs3&_nc_oc=AdqoxNTqnoysCEjl0v2AAwvsgzyKCjqKq7YF0L80TdDCT841sOJcl_GHR6vwnLD1jFg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2qE3U9lgC5oB4IUUODRPO2eplfLgsG-UGs1DyH3sFSg&oe=6ACA5BAE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
_oc=AdrKcDOly72SqSZzTGomSLSyJ_FC5G8hA05Hfr9Xi4ZlIXQpZUt-h_wGKfBpB_Rf1mA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEb_8J27KlQ3nuLpvv6wi256FrKVaDYsJGjWYYkbJ6TSw&oe=6A8EF0D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWlXSS9n_sMQ7kNvwEr5jXg&_nc_oc=Ado11Ij7iNUoTGWEuxS3Pr4ep5lcRPYXX-QxMgDvCmnETaAIgFf71oitLmzTnVd-Y04&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbAr87W2lpGPuetuOd1Cpa1BTK70KrYS4geYP4VWBPLQ&oe=6A8EEEE1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4m5BHfgGfgQ7kNvwFP8u9G&_nc_oc=Adrm0M8Iu7BaHsA5xffO0gPtc7ywqVjdPrG8TAXTiH6c5GwiUEtocWu2TRtOnP0DFA8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuBi6KrRveM6umad8AGX6z5JyoSD3Ibm0A88eFPT27bg&oe=6A8EDD17"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXqxLAzV-boQ7kNvwH3AbpT&_nc_oc=Adppv6kVE1l4locV57-uLFMF9Wvdrz0PBS_q39jquKsQeFsjfgJFI45XKWI1iCzA5-w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFclU36TJ-C1SZQZaHPgPSguFRLjoyEypo4LUqxTHyJqQ&oe=6A8EE3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFHJvPhLbQ8Q7kNvwHfX5RC&_nc_oc=AdpN_p-KWwZCUYBE_bQEYcscrbNuzASHY1NHuYpyhoJpgnOPI-gaPCgnElcjU1TsVgw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxjfNldnNr_54jrwquzwVV-58movU7rIKUmtljkPp5lw&oe=6A8ECFEE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_servic
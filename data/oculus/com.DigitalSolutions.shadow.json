le": "en_US", "screenshots": [{"file_name": "4.png", "id": "1539429179955690", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75295896_1539429183289023_1489445198920227203_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYYXDQKapPQQ7kNvwE9bHSz&_nc_oc=Adq-OX8Ch69aOUJVygl6tMWl7uTYMKLAoHGE6vr5v_W3hPVPhcndGX2Q8IaJGTCMFrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQpSOmgmKSKLP2kMb5gmVgNN41KEyB-s2cm6GbPhx_PQ&oe=6AFDDC2F"}, {"file_name": "1.png", "id": "7266609076781799", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75411994_7266609086781798_189086065738975421_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2z5EO49_mYQ7kNvwEYtgvS&_nc_oc=Adp6JjfEn94ygARHUIjdB-J6rF1WY8uukjBC5yC1015J9akTskRsjkGriwaUvya_gSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDpvPE2Z5L1xjN1GgUiwo51lvMuvagrcbAC6kLlgcPtQ&oe=6AFDAED7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIanOXdOozAQ7kNvwEIXo_V&_nc_oc=AdoI5DPQlzIAnLFR9YJpSHLR14wc5fYhJldcVgpYQe_wW2jFqKe_hMXONroKwN9P3oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6LwwDIxa4holWrY6Rf5ndeRuwmoQ2AV1wMqnSPvYJ_w&oe=6AFDE521"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f33mf_JB0LsQ7kNvwGtw2a_&_nc_oc=AdoggksCOeLHemJ9pQZBYZKeb1V_v19CLTK1lZOLZXDER4KXp297GT0-VXCYg3IyLf4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUG90qA1HN_Xs4FkWLvjq0lcpR4NE_Teo2QOLyjMaFCQ&oe=6AFDD357"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wEd0z4Fg_0Q7kNvwEwowhl&_nc_oc=Adp3BGCHhCjysC69GWDoVaLs0sijT5uR6Fk2nJ30UYIRh6h8YDExDKnYXfptNuJ2kgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7X3mW0altaZhKWO3FW4KfyCNiMkOl3Kjrz13qRMadeg&oe=6AFDD9E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGP6J9baFRwQ7kNvwHzkfJj&_nc_oc=Adr8A5HH0TYre5o8USxiSLFiiTpWHPEMI6WsQFi6dQ7LLaOay9MJnl1nJnhcCkvlYU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREPgrZImZLKPoYqBjvM6i6mUy0MMzrMz2lgu1uruL8Qg&oe=6AFDC62E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25925491753731653"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1444595050506360"}, {"status": "PUBLISHED", "id": "1091347323893331"}, {"status": "PUBLISHED", "id": "978389864552414"}, {"status": "PUBLISHED", "id": "988328797191193"}, {"status": "PUBLISHED", "id": "892581917026473"}, {"status": "PUBLISHED", "i
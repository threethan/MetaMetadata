00_Af_YZ7LDY-fT1iX5YbOCW796l1PA7s60DwFUICBBy1ocLQ&oe=6A315657"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9e1qOG7dVoQ7kNvwGfUE9v&_nc_oc=AdollpgEDzyfLMg4BiduB0ArvwKtok9lrrH_WkCLYgnh-daeip7GKCLRlVNVyCic1qE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NuftzBYaBQLxAmAZ42lTkaDVFO2hLlR36PjQ4fZbuBg&oe=6A315461"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dnnkqp6ZpQUQ7kNvwH9M4mE&_nc_oc=Adr_PPPzd2LGS1vtN9slQ1d5BlJqwdogMMXrsW1nifOUjXhKWCo2chHHBG5dz_w_AR4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iADfkggKyK00SpQ1YVUgEPPMohd_VcnvL0kDwUBTIGw&oe=6A317AD7"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqWBBUmaIe0Q7kNvwHhBOOB&_nc_oc=AdqTl6yBtZ-VFTIOmA5hjJWhbJE-dc9jx0XXcusCvJCSgWEkAQtXuOKfwbUMqdpzvDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hhuVKpyh2inl2jP6DoAQUAwA6OO5bfd8kA12VVSrotQ&oe=6A314922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmfBAWq8LKcQ7kNvwE9vT02&_nc_oc=Adr3WuKWZFEUL52dVWQ2-6BvQpefFwsS9qgb3wlCXSf0keAtgYJ4hFtnE9sExsWolBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i0BtwK3lJ8xN3voCbiAMxYPA6kGTXMW3Z-4Sh1hFzzA&oe=6A316DAE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
00_Afzd0urevqy358MM_bW32oInVIMFGy34h259vL_VVbRRrg&oe=69C68CD7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IfToxnTVLAQ7kNvwGE7KPj&_nc_oc=AdpxNqNGPdXEXCLsrIdEYpjlTjtH-yAHXRyrYTLLwJqLi9hpUI6efIMYNLEgwCkFeS8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT7tQ2r-bkt1nncdTSQMu7fxETx3ZxDQPb0D8_5O329g&oe=69C68AE1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3t5vHB8j8eIQ7kNvwEIzmyL&_nc_oc=AdqTZxdDyCmioztDYpd6922Pnc8f3somOXLwOoMgS1C2hKQYL9kIINjUpuUk-AkQsnE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylxqRrs1TK4cBWPfAH9yG4AXGC45KJf7FwCS67oystEA&oe=69C67917"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVrti_uVFbcQ7kNvwGNQwZ0&_nc_oc=AdoZybtJTqeKi6hd3d2heMVjdZ9hkA3ol17-lhySYCdNzH5WOS8-dDqdt4ms8NgVe9o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz07iSDSnZjyIUeSw-q0qmLlYpxPyxabCAi5yQddiFJIw&oe=69C67FA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VV-MJg67m_4Q7kNvwEq0B8x&_nc_oc=AdpfkFDClGaNMtZGqFBDlLPKNL30hINhRuiQ88-k_wPbnSVuGMYAg91mr0VTqAveVvo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1PopdKAUFyzUgecnNQiHPGYKbGEf2Xarpy20NBJAVrA&oe=69C66BEE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
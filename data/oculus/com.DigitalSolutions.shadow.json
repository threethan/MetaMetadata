r1DEHkymZhG3ogp9QLrs5AiYf9eryN6xPoPuuCzqKN1YMH_By_zlbFl5AKe0wE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ35pDp54CoyKwiKTAvf3UPUih8ZBliJW6iLj66aySv9g&oe=6AB7CF57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlHvRaPFJSEQ7kNvwElMzOA&_nc_oc=AdqilWc1ptGTdf32wP2BWfLOPpqKNS5A_uBJj7dkMtwKMdgnFqyPaGHe4nl0tkBEo6E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7tljd_y9-mNnmm3uK1WDMP5tTOGhqVF98jeWHuhfhzg&oe=6AB7CD61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGAyAdWegWMQ7kNvwGuOzdF&_nc_oc=AdpzxAU7d4yZpcRtcK4gVwhK6M-kCXpKp79SdHaSp8JZ64uMoj1yH5wWZY0nWU98Vrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjncCEyP4xP115IAzz5_RzWi6n8DY3KD0Oc7kkEtCd1Q&oe=6AB7BB97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBo-BA5YSYIQ7kNvwELAVLE&_nc_oc=AdoAI75kyGnGPUhiD61T31DNgqSL96lztqMckxXAfdEtGghyGQ-jGVAk4_kNhVXEl9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuS9dZLF9tgxCTlhMuXEE3vQEeo7TX8OmJtS0dVdZblg&oe=6AB7C222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcRqfLSLA44Q7kNvwE-gGIU&_nc_oc=Adpb3Fn6CXyPy9rThXA3XiBh-cbtXBIIreWSHJKpvirvtTfdmQvoJrqkVhbDSyd9nn0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsnaBBQTtAF-TwfYc2cQfM2K3IZ3qFg0DTVyubdT9Ipw&oe=6AB7E6AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
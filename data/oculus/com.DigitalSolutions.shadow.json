u74iW02vwPPwMX_3UAKuuwHli_M5-t4tDy2FxjnPKxzfB_rt3RvQ0iMDjdsSro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIktI-uut166L0mgzOijJnzSadaRuExVQf-k0vnDMb_GA&oe=6AABF1D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQ4U1K6DHd0Q7kNvwHfBoL5&_nc_oc=Ado0CAMN4ENHuTrZLn3OdVe6Z_vfUokwGr-tPHEb4rgqsMqO7A5uqh32o7tSCEFYhJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_ababuEfjJk2WzmHqt3bjEuwZRzNIOm8nA1UYjYwufQ&oe=6AABEFE1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIbY73lHvkIQ7kNvwEyy8mW&_nc_oc=AdqzP3E1ArSYC5AiRq11WmeWPCNz0m6zbWAZWApPMMV2IB_VF3vKyPQy-GbMRgV2ppQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL3HT2z4ICGERWdiMr5NsR7j4G1tbWB4jkABDAaVxYEw&oe=6AABDE17"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPR5UHqfiSUQ7kNvwGr7IQq&_nc_oc=AdpO9WAuAyv7oYXZJeqCBnMjOry0DyStPBEBucSK9HAHQZxg7DNWmliVACxfWemCJ28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0jazz-F0pr2CDPg19Z0yPF5K945bqw8hy3vUgHu9o2g&oe=6AABE4A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBfRsahCXMAQ7kNvwEUQshF&_nc_oc=Adq5UsxeqCezkQ9XRr-CyR5hZylU5hiImcRR5vfbjzdGMzboIS8LkKqBQZnvsNEuhoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgQlOpihw-8jbAHBLzqkzO5UH-kSF27atyK4yrF8UgSg&oe=6AAC092E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
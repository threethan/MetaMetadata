00_Af3yiOREW-_T5T3ALhQu6v__DfBKO_KFqMcC7ZMSA2cF0g&oe=69F602D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2Xq2tcgxwMQ7kNvwHG1JBm&_nc_oc=Adp8ygsN4lf6RRDgLcs_9TttiWL-3hrjnWbl-A-jGMmKr2VllP-z7kdlYycJT0rWjag&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3T8lAc4YsvtgamRONH5ihiObQlNKUB2qzc1bhqdhUgmw&oe=69F600E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGlYV0SDGa8Q7kNvwGsQRIw&_nc_oc=AdrqnVz5TLALN8Oa_zO16q6Rn-uS5MzkZu_J1ZbaE7aGszJiiU7tOKWLbB8R4DA88d0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38qffIIP01J5jRSb1CzfxwrE4gGQR_snC__pI2H3BCig&oe=69F5EF17"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTMZCNmUYYEQ7kNvwFMkKKu&_nc_oc=AdqcOzvzYZ5Ajbkv6QKX0LgFgPRnweUz_5Kj1Sy7MOGrB4EEl1KKCBJMKKe7dAma6z4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0g3F26N5SD1dx9wmmxmthq2WEqNh_9Dj631MmFgCf4Rw&oe=69F5F5A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQEj-_gLuz8Q7kNvwGdup2u&_nc_oc=Adr-V5us9GvYGARBRBpQEo0WbxE841mF-yHyL3esefnRtcWbHPhgi6LxwcZQ1NLAI5U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hcg25SXrYIqir1LnZrRv16YrDY9iinjBN7MZUQxFnkg&oe=69F61A2E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
dn.com&oh=00_Af0aVKhzMZInF_nzIJLb_4kTJ5noI8h0oQ13tpvi5vXZEA&oe=69F20E57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbKWgXqsaukQ7kNvwEy2m8T&_nc_oc=AdrgiSRFtiJ1g-0Pxwk16tV5dYYExHZdIrcfQwr0BBVUgW6JSZ2trMhjmJytBzgooqA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0tKvCACpH2x3hr0Pq982Tqw5kBWca8VrmQvvWy4BzkYA&oe=69F20C61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibBJsT2dbmsQ7kNvwFUOIs8&_nc_oc=AdqgCvNSmzkh6zBpXwK_9rO5SmU1uHeah4hE6exMhUwy59rU82jjH-biiXP9hg1A4wU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af016Vw0L0TEZdfFM--BhFEQwA9l9tFXiXwGFUvhj6DDIg&oe=69F1FA97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnruYfLP3ZsQ7kNvwFsDv-H&_nc_oc=AdoOh_2dMp3C3iZFRu-i1XxAXq77yup2vwHiLIBU-y3J1nTgfm1mUNv9K8ZJIPOF7lI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1Y7fLH3ElgAz92rDmKXGJObWpDeKIFBV6vxsF58NQajA&oe=69F20122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qkv6ZaL5dgYQ7kNvwEAHc1b&_nc_oc=AdrOqPCaWxKkGgqUUOmtNhwQt1sPiTL3osU9w11SSelcFZ0Q1yFxw9eG8e0CXPb-9U4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2J_2SoBOJaZWuSv4EYal2Dj7fF_rDMpMhxBcpYNrxoBg&oe=69F1ED6E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comf
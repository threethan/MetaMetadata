00_Af7DsG7fvwz0GsgUPATkR8jqa9SvrvibXCKvEck9M1bDKg&oe=69FB48D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoAeHJppht0Q7kNvwHodjdA&_nc_oc=Ado_nFKrTUNbH6Li4gURiQCc8U6dh8Sx_MxqGoxSDvJ8_BKR04tu2UrYKoSzCQxN86Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A5btpYM8BvnTkMwpkzzqQDOqvLtkMHdw7jgquILMEdg&oe=69FB46E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoKrEi-wZ7MQ7kNvwFZj0b0&_nc_oc=AdqEqqXjHpYex-uP4-LHHjKje5FfMnC8az1tTuFzGBVFR9ekJ5IeBieuIXq7mWQN-Ms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xd8LV3hNY8WBOpGKMZtmH_rd16PrNAAm1XvfOakk5Tg&oe=69FB3517"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3212hCJEZUQ7kNvwElyv46&_nc_oc=AdoBgHLIYSwVQrIvBPfb5dKKYtmwUgQQMVnG2kBO4XXD5-csmzAFh8q5uH1Gd2S1c2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JPbUfPgzKdM9AUcmqbedzT6UPooZUdy9Z6xbEj3sTFg&oe=69FB3BA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9dJd5BmhwYQ7kNvwH6Av6F&_nc_oc=Adqtl4CN_e-fZC_7N-vtqbPBzt_AZphxYdhPtLCuWyXBU3kBwjCbDk_XU8M1IK-gvXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZTWpq22j1v1TwT5ntC5NdleaBRxBedcfRAchaw6wUag&oe=69FB27EE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
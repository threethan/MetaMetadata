00_Af1E89Sr1DfN6LcULUp7nJhQeQO1H120lOM0DNl1GkTikw&oe=69D7B057"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttPWdjl0NLkQ7kNvwFPH1bo&_nc_oc=Adr0UH6vkaD1pN43iUfyPtrtsn6tzF6q2_TqZhU43fUxbRXiST9YNAJyTE3Ug9yJ6Ps&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af061hAe4I_SLNQ4tbe2yGWIJvjnmGZREJx61ymtlDUWCg&oe=69D7AE61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsy4wsEQhL4Q7kNvwEaWZX1&_nc_oc=AdpDt47I7DLJqbBstvek_gaR-iEPYvTVpGP5YMn70bL0KRhRVD7xTg-1VIpRzP0tQeA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0izjyGYC7ImoMSA3Q-EFySxPzE2v8CS4eOcctzti1iGQ&oe=69D79C97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNU2GNRTLP8Q7kNvwFVb7PE&_nc_oc=AdpnDWH8109XKqqPzEScr2UdOOeaxcZHFs_6vfk-5K5rWFKWz2zbA1NCnEZ8YIfC6RM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0174WYnV-ltH8wdyQkhTjLTu2JPxm10ZSxXIwIItdcrg&oe=69D7A322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzwHnA-sBdgQ7kNvwGIx26G&_nc_oc=AdrShRLCBRoFEUxIb5SMG1KZyCTNbHE_kJDN6IC0_ra4dKZ5hmcJdFDeK61zweVZtXo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iCzh2sRpAsjP-nkuLRrjf-UPPTllZ8bWouV5Ms_nZ4A&oe=69D78F6E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
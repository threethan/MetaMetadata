6PgQ7kNvwGMXTQp&_nc_oc=AdpXotSivPqV-Aat81o7udYbXdEfe755rVHt0m5NBbRMb6QhsTrIFb2D0Ta_MTKgGG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z4xyCYJO-EKUy2gt8VuNp7Jr7lWn4u64EPB_z-hNQgQ&oe=6A01E057"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VHrKT-rnB8Q7kNvwEEGTv4&_nc_oc=AdqKR9vsBe3kjnhOlKSumwG_-nYxUPPMnTUAPXepGVM9XcByJegDphucPbnj1XDatew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cv0XHg_i-ed0dAoe7093s1Za0o8ScT2jtGRcwNWQ7Pw&oe=6A01DE61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJmN2AIS2UMQ7kNvwEWpgjx&_nc_oc=Adrzl4v58TH0LRilHTk1ZpOdOtxmRn2c40JFhBO57XMs8ODF2BhNJEOyeHLh8kmlFYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wDr8YGUlX7LlZrSKRdrNiSbsiePVjtrTC7NmKHn14EA&oe=6A01CC97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBdk9VK4RGUQ7kNvwHrgOsu&_nc_oc=Ado77wz46VVJAQjdYA0RPxwsVscvyhRHCRd_adtYweyu_4b2rYlGdmqr6KqNPxwNh3s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65DTGknQ8nA7ywicMUFIJ-bMe-rteOqkd0GZRi2QkbhQ&oe=6A01D322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR7b7ZWM5NAQ7kNvwHv7ACb&_nc_oc=AdrPQ5FxihUS739htEkwIx4JlzMobMC-AIOqafHg1k4Q1bYN9H7oh4GJUQ2lgZ3b9oA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LyA4IUa1XdZpwh59oOrO4XkwRXLt4yy0RbBG5ZT1TjA&oe=6A01F7AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer
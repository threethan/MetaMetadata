jywQ7kNvwFjP1qX&_nc_oc=Adr1DKi8ermpVkBpTnn4WpjTgsNS6jqyDqJsCiAUj1PULr_bAOv5_mbOk6o8WrS0mWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vpZ6yLgnTrkzxnL1IZ5ORhtQ59w5qGvOaD8gQFNhv6w&oe=6A1849D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTk9EmuVuj4Q7kNvwHR-CvL&_nc_oc=AdqGl0mvFlyayZJDcB6QotxbFF2C1wxpmWXk3Y9pAOrFo4QKxJRRvpgrGoEWa0hdGb8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J3sD1mKzi8rSrFN0IixgRDpDjjaRWrXQmuw4uW2Mk3g&oe=6A1847E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hducRKu04CgQ7kNvwFHoEcb&_nc_oc=AdqQGepb_3gJRkhWahDDVCBqwzYNPwRsBGZ8PKZYWZz0qeXeiXqklHCak7kQ9FRTpEk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tcpNDRnHjqlHhDq-x5oa2a4V7fgEhXl0qUFQRxUwvsw&oe=6A183617"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLu1e8-x8bUQ7kNvwHlMAO5&_nc_oc=AdrQhKi7O-T7WsYDOMRX38TsukiY62rS4FFODZpUQumczWsD1XZdFGBT4IA39b2jS-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OZ-IGkkwcdX4KHRBVJUdPuIooa3FeA_mgXz0xVPTUKA&oe=6A183CA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwln4uFwTH8Q7kNvwFzPJIv&_nc_oc=Adqq29aP9DmEvY_IMnEI0x7MWlaiE6PJgtCGYrkbMZE12w6dNRfXZYAJmuk4iZIbK0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XAFFmUGx7JsBoTHf2L8h31bqHktAQOUmZKcw6a_pGHg&oe=6A18612E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer
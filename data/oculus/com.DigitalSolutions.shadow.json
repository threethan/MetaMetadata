scdn.com/v/t64.5771-25/75411994_7266609086781798_189086065738975421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNybi3gictQQ7kNvwHzuFrH&_nc_oc=AdrZ5BAsdGftAI9qMZo32Kb8b-2aktVMsmGXlabLyUe0SuOmL7ggmZF-hxbGszzAguY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZLZUHYPFMGAw8SEw216dA0T6b0QYRSoL4l94NANTI7g&oe=6ABA7257"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYioGmP28IoQ7kNvwHEC45x&_nc_oc=AdonvbP9GVruG-kUE0EZFE4M_BVbKhCQvZPq4j2bCGFYqvh3pIE6yAQJo7-DADKS67k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQup0KxEpW5q2ej0nSh4-ZVztKvHT6k5x70DYM_-bKyw&oe=6ABA7061"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J24WqJgbRCgQ7kNvwFmKolp&_nc_oc=AdqNbby0SUi2_g2j7rY3Epdpt2TfBQMy-7qdgC0c5jviHTH8Kj1tlDqmAqwql6VedPE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4rwHAT0NsICM-5FfK5XUJiSpxHme6CQ8twSPVkz0waA&oe=6ABA5E97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBIvRNvvyPgQ7kNvwHbGU4i&_nc_oc=AdpzRLZj0q-ynzbX5c1tsi9ruP8e0s24RyJ9NS-ENeXzVtUwsqC36QlhfzTdxnE2vE0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb9lC_mIF74PU_3s18goUgSayacf3oXOB5E1crLtOb8Q&oe=6ABA6522"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBg7tocjXToQ7kNvwH1BnZB&_nc_oc=AdoAFHWl0KWbZPbSR-3geC4K1P5Z5FDbHoJ86sLtIZ5uk8XVo_zNqSf5YuuMv5bKaUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu-z65LU4gKayJc4Zzw8eNrhgc5FfVcSLcfxNIcKSNgQ&oe=6ABA89AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25925491753731653"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1091347323893331"}, {"status": "PUBLISHED", "id": "978389864552414"}, {"status": "PUBLISHED", "id": "988328797191193"}, {"status": "PUBLISHED", "id": "892581917026473"}, {"status": "PUBLISHED", "id": "1509298966809523"}, {"status": "PUBLISHED", "id": "312667001685886"}]}, "baseline_offer": {"id": "312667001685886"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1091347323893331"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25925498390397656", "version": "1.0"}, "id": "1137839884129670", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25925491733731655", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBin
00_Af1RQqGPSXeaNtXpUI1qB9ULMtAYb3FHpk_GSUDMEQ6ARg&oe=69E23C57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixwiwAbkJUgQ7kNvwH1UYN8&_nc_oc=AdrGS7T62Wv8tLeI_fzHr8rPDid8KZMsXkPzhTyXF-__Ycy9t67jIC8vqVQe7jZSJQI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14pIqtD4F-RsGT1Zte23Xlo5hGS5VWQgLCXve_HsRWnw&oe=69E23A61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPpv1BtrtqEQ7kNvwG46TFN&_nc_oc=AdqtuJa8kTUdskxSKUP1mbp18AQRfdUF1FHaA6URbubJRnJaIsfqr8KwgFpNumDpma8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OXjtbHqf0FeN5Nhr8yNaU-_HMRBcqAQQh32kYN-TBOA&oe=69E22897"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gkzeiBdb28Q7kNvwHvAgR7&_nc_oc=AdqYK1R8P2qHoKCCUxuy95DAWEdLa-FA34J6pa8Gc_S-5ScDrTPxmntYc5Ubr2nRacU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bW44Vt4kw97G0n9n4-DBk1-jJl6y_wudMe9bloh8DcQ&oe=69E22F22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSnRnpeofyYQ7kNvwH4siKx&_nc_oc=AdrtzlovRYsnUQXoi7DCtBWSjNsu1VscPptwpfNol1crOmNhY_nsHYZMeE3_lbDr_4k&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37jCbpIRjI-RB5tADuwRa948vaHBQKiPY4IM-ZMP-TCw&oe=69E21B6E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
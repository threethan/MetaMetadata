266609076781799", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75411994_7266609086781798_189086065738975421_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dwp40v1UesEQ7kNvwFxJzbk&_nc_oc=Adqw0UIPN7_At_N0bvT6_HVVeCMxARURwuVt58AjEl2x0dkhsk7FxvWpGJFo0PNbBZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfiOT3XL5Ro1zZwKd0Bsom0JHH7xfErddNEAGgZ-D4TQ&oe=6B032D17"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mgQ36sqoSEQ7kNvwEug66H&_nc_oc=AdqDzZe-DGf9gG-MDZmcb67Cm-Xzjkavk9WMCs9S-re-79nCtPGZy-jHkQK3db6dkFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD1OOYmo9D8YY6uU4Y4e7t1THIuoAMAH5P6Uk7r-vmZQ&oe=6B032B21"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0LenwPA2FoQ7kNvwGEeSMa&_nc_oc=AdoL4LUuaXWTFakog6VyRrT3GRzSM0GQo5IrtqKwBkHwEDZPe2pA_ZdlRA9TWtVcfLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5oq7dP7JIan1PSwu-wqq0WSC-b74XsN8cRv0u28zNsw&oe=6B031957"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6lvKZOmagQQ7kNvwHjxRn1&_nc_oc=AdquHwmyCrbCPvm0-ad-6DVJ8xR-TQByfL7oATO1YFe633D006gHJjRTKL4FY3J_qr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_6QV0l4jqtoP5btGnPdnUpx8Tk7mGh9bOrbjOYzuq-g&oe=6B031FE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r-HbQ3YcbgQ7kNvwEJp4fA&_nc_oc=AdrAeWkwNSv8wmp1vNSmYIiL5Fv-qa-t7iAPVxUQ_n7qPZVWDQGaEtwErX4gJIT5uT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStPbjzFtNhCfNUJ3cEadNqGA2rayjYijNdHDXIyGXHUA&oe=6B030C2E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28168078639472942"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982539_542812305382691_6070273823410722632_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RG-iBY4GMoYQ7kNvwGkUa68&_nc_oc=AdrE023KsCvwIwUmlC29jO2X3e7q-skIKV6WsMogZVcWy4LIf7MDiYkT5ZqcGLs4LFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh-Mr8wAJi55oHpJ5-eZ26J9b0BbEA727MvHpbogNoCg&oe=6B032821"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "shadow", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1714
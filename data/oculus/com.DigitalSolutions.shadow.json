00_Af2wRAiBlYsodZrhuNRbdkgnGP6kiY_KKe-D7eQaBI8sQg&oe=69D3BBD7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crJkcdGXkGkQ7kNvwHHjPYi&_nc_oc=AdqARQeLpIQ7V76wsLUQp5VaJw6QFhD-8jlcFbWJEW1ieBRXGhCGYeY_dIFCydqCpI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RDAa9ua-_8SRrVS0P-b7l0hJrhW5Hdr6pEanHxzSWIQ&oe=69D3B9E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjuIEKHve50Q7kNvwFRj1HC&_nc_oc=AdqnrVRBhk_rUzORKb9jOkf9ayFwDfO8vZo40t3zutkTg1kTvWoJNcuKXirrL-i1LvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0USu-UyNFYB1AiSXvQbPtGE36FUPCae4zmalgr5mGphw&oe=69D3A817"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7xjPINBNqEQ7kNvwFesn2L&_nc_oc=AdraNUvD8ZwIrHV4ljXm54zDp1ya0_XLqhLgvpa8TIfPE7muUBfnM5CrieNBo0DtwfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yvmzSTGNlHqTEd5mtVxnfPZ65ovbiYHd3Rt5NJLBFrQ&oe=69D3AEA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRInVYXvW2gQ7kNvwH-9Fus&_nc_oc=Adqd9B_dxgbfEyZwaKJZwC1xTQBpFIFcAX0rjfgLWXL2APwCdvrAuL4FsTQslNHJeF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zim9Ak4EUe2hN48pmMRYHhHGsbfVHpjoDIFtP9iWIeg&oe=69D39AEE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
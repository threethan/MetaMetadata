l23_gQnMyuqjSymTp65KJZX_n0YtmLd-IWxwpT74iPE_MhDwNcgr3ewbg-kehY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnL59CA5lfRmSJkwClI_qnTGb0PWDdmqkAZ7RwGOcuuQ&oe=6AB137D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQGcYyCcHNIQ7kNvwFTXfGf&_nc_oc=AdrwW1ZT8UosSOVk_4SDq7Vt79K1tSp2NkW_Fk6O-rEgkHNpR5OjBqtyYIJHrG3nGaM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKwbqmGb0Mb7cCgcHkSBzbdVAhVrg8mnAsGwvOa76efQ&oe=6AB135E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cT5_Eshn918Q7kNvwFRvbBW&_nc_oc=AdqDiVgvDAS1J2aIF05Cionfbr7LusAxVlur_OgECiffzedLjGdrDQokiJcE8K6uxyU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCofmdUggubYpJxwllYbW8E-l3grmg15IDHCGBVc07ow&oe=6AB12417"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyBFWuw_W0IQ7kNvwEuPAMe&_nc_oc=Adou_ECeUQBfu4fJhKirU-wSGk4HVdzBUh5LIVIgkbqM6s_ohAS8zqVmikjFli-5g_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJh9ER-4pIsivr0hRK2UeU0Ra8FzJoj3-O2xB8lHo-iQ&oe=6AB12AA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUMpuOJvOvQQ7kNvwHvoqe8&_nc_oc=AdpwSe-ypv8cOhun_2Ywr7V1IJgAOs7uBIwYcKj-BiUzLvigZtZgIl-HGjxY03bZqfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzvekWo8Bc-2zxv7wt6TLL8bPIx7rZojscRKUQhwfWtw&oe=6AB14F2E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
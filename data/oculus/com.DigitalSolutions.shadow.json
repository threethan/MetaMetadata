tf4Q7kNvwEr1h2p&_nc_oc=AdrTiDlZ622ShbGcOWTzEsVLkHWrvQTuBHHm6X3tRV4uSQPIUKw_U2yuChgRC9O-rjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESNsNmT5HcqIcyPLWOVUu2eHUnz9TTNdEnCFH0MZ3FiA&oe=6A8C1597"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq5Fhvs0tz8Q7kNvwEl_DUG&_nc_oc=AdoPiKdPcR0DrWHD3a9GqFvRImjK0JJ0diVKn9YkAPtQ1tqk-HDCkjQu_-Rob2VhE7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGabJr8o68ThIa8xfPeFhRPckzms32wLiI6GppkxapS7g&oe=6A8C13A1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwiCUrCdeQQQ7kNvwHf4BcW&_nc_oc=Adp44y8F4Kn1ebcyct4asCICWv1Z_K_1h9tu9QCS7EYx_-uzkDA_onOC414sRrDDMdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlpOQFXJ1pllppQHpS8wowPWe00ktLpnMOp9rrZ53Y2A&oe=6A8C3A17"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbkoAUxpqxYQ7kNvwF7ZwhA&_nc_oc=Adq0aRJZCBN7o0_NLjD_BLyYbNzDwR4WtasxW9OI993cEdMHaqbsLpR-iumVrbLKTh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKBhgvpOrllvnoeStAykJdVmcLnQfPsIu91d6MUVbGMg&oe=6A8C40A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbxzWtl0F84Q7kNvwEkRCLO&_nc_oc=AdrHeSKrCimI2_ltSeToy6vNIvWjLSp0RNBWltPeOUjOH2vwvJ87MUjdffMJVmwDX8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFfKhe0nvueEEQxtiQV6H9z1aQHIYy_YWdSoNvmZSg6Q&oe=6A8C2CEE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer
1OnZ4CsSmqtPiyik3NC3kUnPJ90CZ116Pw3VwLpvtm-muCB_cvC7HIv_ogBSKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOdcV_7B7frsee-zyt_Is6C29nLQnBxNvp5hLY6OZWiQ&oe=6AA7FD57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VULN1cuT-xgQ7kNvwErge7Z&_nc_oc=Adp62Kp8LRHU7_jtfrN1lCYwCSBKKB6YSZF43DiVXJdFCNH0g2bCfgpFAbFlvFaHKK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0LaxDX7oMHzCz0p90HRXypqyY5OfNbRgrFOe90UmRyQ&oe=6AA7FB61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR2zK-rn_SUQ7kNvwHOx2G1&_nc_oc=AdpGxi_muQEMYNB2IMytstAV5lp1tnw3fe2DyIqW8SyB6_1k54mANJCa6J01xEHHHco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuYu7m4Bsnf8RIYIpupaE2No_pEIjcnVR4bqS-GnpF6A&oe=6AA7E997"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRN6_P4UFCcQ7kNvwG334kA&_nc_oc=AdpDT5odFV-xyuUzYm77qEkS8ADIaiIS3HWUWLPpKF0wBZhMbClFUqemW6NGfIpCG7U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiBdGKSuu3AI0Rw4XlqbuOYS1uYi619gbwUr2bF5Olhg&oe=6AA7F022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKfXl5KslrcQ7kNvwFWzTXY&_nc_oc=Adrt5JcOR8tNmoyPJe6ZNooC8pvEWVxhM803mXyrZVU716mSATpNU_wCDtefMJXYqxI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6GoNP37viYH27QbWbuzTlepat3-3BGfvjBzE-OzOEtg&oe=6AA814AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
00_AQCz32FzklgimaIkulEl0MLqI8_p0CnI_dYDBXQq_sqfvA&oe=6A564057"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM_6vWgEe-kQ7kNvwFyzDVn&_nc_oc=AdqiPsp2TmszJhAN5IY2C-L_JLqXhOzaaqVw5ZKZP17oCKkV1h0HqiyFfriUUM4Hys0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6GhPm_NFgjn7nm60pXLLQSl9yGcM2S4WrW64FE3WJ-Q&oe=6A563E61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0qrlw4Wmr4Q7kNvwHRvc1_&_nc_oc=AdojVtuc_ehjmAtMjBtt2x5a_qU55Kc_g9U8iMG3Nd74Mb-I3t4fjUp4TMS_KHexmfI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBt9_5olyUTtqvG43WUTWe7sjB9U9h912gP2pWj2alIyA&oe=6A562C97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmBzhJtjivIQ7kNvwEoOo2C&_nc_oc=AdrTK1h-f7Hdu7cr6786jiPy2l-_X1dOHkwXCk1Sn_TPkkrupMpZuVz20F9_ykFRSF0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwCjlIX3P0ceGE3_mTNiICo2v_ZUqzl9nabzoW5UGvzQ&oe=6A563322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMiiofw0rlAQ7kNvwFayzLu&_nc_oc=AdrMT_cb_n3-MXB9T3stHyrhuunPeVkG8kqZZAmOsinlJmZHRvq9PN9O3m_GAcIL_ac&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATg9n7b5VCH7d8z2uP-xa-ONXuNJN0CApihDkHHETWvA&oe=6A5657AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
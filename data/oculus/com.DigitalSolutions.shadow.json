kP1axnF9WJ9DdKWV585s5Y7q0OZpWPRWNcTz2-1xLY7KLyZp3fNCdNtsI03cSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs6yXl8l9Dqf64g7rROGcfC-WQjReOOtySuEZKQn_3pg&oe=6A9D7157"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddUn_dP6Wi0Q7kNvwHXOV4y&_nc_oc=AdoIlrk76BPUoYVdBvKf4g9WHNmmS5uPv2CcMrNMt9MkjnU2ODv6jzamiWFl0gIjA6A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlD7pU-NdH6bt2qWGVRpGriA_vz8iapt9AG0xS6dWCRw&oe=6A9D6F61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnnBXMTNsOsQ7kNvwFG-_oe&_nc_oc=AdpbsYc80k6dmhI3cshxZY-aLcZXrVl-CSNTVIi_PwvCgvxduQetf-EeFyVQ5w9B2As&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwRTjTPVqyly0J-ua24Phjq3RCt_pkdM1OaG2xQ_7L7A&oe=6A9D5D97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYvMWzZepQYQ7kNvwFnVi1e&_nc_oc=AdpIAtnJZMo1o70a7QhcCwNjNU6IBios42hmQDEsZqdaMJI1cUD_nDqabRhRb4grJiU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXp376Km8qyG4-qA1gM6B5REc-fBUsgSR2JR8PVLSbGQ&oe=6A9D6422"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJydwdKqsxcQ7kNvwFMqh2x&_nc_oc=AdrVVZBX47UtZpVHXRW6k1sVr2bXgGy5WcdF9TUdCScs5T-MlN0VG4Waw3DK9Ku5f20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnk7ukMQ-K7UrZGrncHT3SCRkKnWz7JKSYAhOrhqBGcg&oe=6A9D88AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
00_AQFMSeTR-vOmUiDEoPfanAW8HupxyItpFaCY8Z9IjO11aQ&oe=6A831357"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBnXrt_79BQQ7kNvwHKpUQV&_nc_oc=Adogb0GUtzykSuh2ku2FTbg3ULJIEhoJjWL9z9GOS8iiwGQ8wP9DKYUDXmhKFFPsNsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVWLuCSsUbfYoWGFt04H669VFYW9hReBlxAamGH75CvA&oe=6A831161"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTFKj2ByQloQ7kNvwH8IZS4&_nc_oc=Adpam7ti39BHxEObESqub1lv802uLuFZ1iZDw9HyU9ecGKPWelnMbeANB_O-2dZ7VLo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvE8NjyZt-YaZJFcNuSK8GV7N5QgItjbHRSJ5t2DpM0A&oe=6A82FF97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyupgbs2ZiEQ7kNvwGl9Guo&_nc_oc=AdqbQyl4JZgqyKafAoI6wYLWyjvboZMltNDsktBZbkrPfhHvdUn97bf8ekrzzyuaBy8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2zF8wiNFQzXi4JbpD2MdxZOIa69g3t_CbHxjRpS68lw&oe=6A830622"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJq1QUoKGbUQ7kNvwEvbEcP&_nc_oc=AdpCqqg4wQ6NY61p-Bb5ErTKLo-qgV81sD4NAlZ-ySKMBSqDn1dreJhqeA9q2n3Chsg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiNldVLcEJF_q_cw7tdC3VcduArjShCQfgYjIDA42IGg&oe=6A82F26E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
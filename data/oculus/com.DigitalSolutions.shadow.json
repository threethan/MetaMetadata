00_AQFSEbo-2XRZMl1pzNhl-5tTHycleRG9uVSsq_z1Q_bYEA&oe=6A7B2A57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j95LECeTtXIQ7kNvwHaZzpM&_nc_oc=AdpdtNWFQrsitF_4ba9QGTrmGqvlIQOAF0d4u56VGs6fbD90WgFMN-oIHD7_1m7CWXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEElN0fxXUXcX6jJ5vFTDo6TbBfoDiEGikoXzN4DMnTSQ&oe=6A7B2861"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAhPT6fds6EQ7kNvwG0RYDJ&_nc_oc=AdrmFwVO59YBAJNRcEGdbCtrqGrKvY5iC41d6jVP7-r6Kbu572FFVx4slN2Rzmw6n80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9AZXn4_o6aRntwY4K4LwvuPIOrYnNBzUvmnkb0oSMig&oe=6A7B1697"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWeI2AHIeG0Q7kNvwEZLz86&_nc_oc=Adq0B1hf5ObGqTJzNH4YD0lWEVcqYbKHCJsE1xk03AEURyW38x5H1u6-SP995iHQZVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRLPvhy7pYeQEbLh6NxMy0ebMCiQlvMsvHo8h8TfHuPw&oe=6A7B1D22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUnmWtaMUN8Q7kNvwEzJpgk&_nc_oc=Adq88nEp-43VUAgrj0VMyAgjCtyH3zpxiqewsD57UVqAtKfOGnVcQx1eb62RvZk4W7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTS6uJRKD_kij8ysES5EkOfSKiyRrPXrcj7HIukCLmsA&oe=6A7B096E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
TQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afybcl7W4PxB-aUuh-VzkGQtSUpIKQ71U_V14IcLyIXgMQ&oe=69BFF557"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NveteZvA8cIQ7kNvwHQY8Tz&_nc_oc=AdkoyrbRNwHHuSpj6f1-AQJj-0pugpCO3ancss0--6MhrsC-V8Rx3iH7DdrAPoQ7zm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzgf2fs2sCfA8x6VS5SAq2Fr-VvGHswlPUd732oH4Zlig&oe=69BFF361"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py2A5xyUm1gQ7kNvwFYCjki&_nc_oc=AdmondXqpctP44Eq8Mowf4VxYytvJLcdM8zZdxFaifXShzsY57pdSunKLsVxXgp-ZLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaP_Tmy2qgL3NBm37IZX_sDS0wUnIuQiy8Eomp_8j6Tw&oe=69BFE197"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ryfr3KdbLhoQ7kNvwGW31Cq&_nc_oc=AdlOhXdsr9JX2UInU14Xc6kj3_Gder0d6xGCD4dKSjsyLUwm0w5s2x9kSiOw7419jAk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxsNWH8AI6aJ179f6Rz8KS3pl8K2Oc8ZOOngVbiuqYZQ&oe=69BFE822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMvDYJURpKUQ7kNvwGxuAVm&_nc_oc=AdkyI7wFmkDVWGGHWbEoSvWwqGCiuvTGyF9Lml6u22YD8HW95UZvIBSvNym6oa4ZwR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymSqB1hXuSx4KJf6G9i23t72aAc5a59lSH1cd_RCzApQ&oe=69BFD46E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_
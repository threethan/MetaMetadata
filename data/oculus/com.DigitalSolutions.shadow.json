kCRPid4UBI59NTcZwfd7OuZzf7UFPIBlTHvZsqIqJ4bceEI1wpXETGhksJOIbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKriuuNk9plB9smLQjtwnyCr-gTWkPLzuM12e5QQmneQ&oe=6AE74557"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a9O1xZiWiG8Q7kNvwHed3wi&_nc_oc=AdoDDqrdnEg1Gz_1kLnS-RNbjTlb-gMAmYi0tSKYCPAR9edcGDsK6fK38qnla-0JZOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDj4KgJgIFu_S7allKfKxpTm5IKUHZtjVWHZltGu1Kig&oe=6AE74361"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiloVC7i_rkQ7kNvwEmxZZW&_nc_oc=AdpuSWb6msAqBN8jFK4yDvnN6AZMan58zt5qdV8KRMpr5zQS-yyoXSb4u4MZQ1yLTjg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqDEK3NASWpBh3IeNSMOYzZ3SCqWaP2NhufdL0HpU2cA&oe=6AE769D7"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdOIiXzPItYQ7kNvwG2zcHs&_nc_oc=AdqNKcweZ6NnT_gL-UdbgvBzulI47w9zVETWtBGFHLciujSCjSEXdHOVeA7s96o9TPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKK-tLEajslZnYEvglT6WeOwqrs16JSSo7ux3b8us0Ow&oe=6AE77062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAliyRcDqioQ7kNvwGJaKss&_nc_oc=Adre09fdIaLkNRum2kiNKkkIyIGyc135XYuwcOZB04G_Zokm4rpgaOcgmkZTJeiTMtA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThqgFwCYApFUAMGk_VW1sxAr8QBw1_s61nFsXS59PWDA&oe=6AE75CAE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
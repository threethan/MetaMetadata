=AdrGYKgWBxo0hhS2cGDyxWJh8860VLiE8pQUR3zWu2p0osmDUZcbcNDMKIsVag5ruHQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoFU6MhfAMpKuBkayZF8Jt1028MpJOmyP58vwIDPAK0A&oe=6AA94ED7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VULN1cuT-xgQ7kNvwGsZfRC&_nc_oc=AdqZyAvXRtrQ7tAp-1kPzrztJD-ZY3QSbEJC9fqGEevea3COU03687vQz20_IeDNLbw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8LkveuQlEHXPHrH3e3abWi5aPYsdaWSZ8VzJqsR6Tyg&oe=6AA94CE1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GR2zK-rn_SUQ7kNvwEfivw0&_nc_oc=Ado-J0bkT0hvyz1HiZBlMFYIf8TR896XDBwd8wASK4p0xDjEfTUoxNTc0CJlNGVUeCA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNDWjOjR9oaLrglYqSI3bj9lpnByw6GKimQ-DReb0weQ&oe=6AA93B17"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRN6_P4UFCcQ7kNvwFL2fB-&_nc_oc=Adp1xCJje-Q50xwAbBr2koOiylwFktcmAYBGo1_OTDS1rNA719PkjyJGiqxMjsn8jRA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJezz-yrPjufyLqvN14tRR_V7eEcU6fpY5M2gAi1X9jSg&oe=6AA941A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBfRsahCXMAQ7kNvwGqZZYP&_nc_oc=Adr2UmsVPQimP2LekxGeU2S3w-LFTKeE5ni78BVI72eEflnETQ_szkxeuuiKnEr8y9o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgrzxcMoPa6xpcEEdRYs8nhEHKNM-FEajI2ZsZHWCL-A&oe=6AA9662E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_
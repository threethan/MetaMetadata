00_Af69QVEy62LdpncaKitfCC1pkw-sP0K51E9bcdPW4-MImA&oe=6A0B1AD7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXr3cT_PWesQ7kNvwFbkhr_&_nc_oc=AdrjD2aN0hrwkQm-xCzmzL3btxVKndpYDSoU_S4iiKg64SafhZp9GNAJvek34IQBTNY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tc85SRxaPmIOz7Uo3UzOVbgL88o8a7to6OyodGsSQLA&oe=6A0B18E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAINb8eXTaIQ7kNvwHY7VSs&_nc_oc=AdqGwym5R5v9F-bfmBV2qCzR6FBalsKm55_CTcDCDfFmpfjrfF8HcZt4CEyld6vlx38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50YKMyYjvf63s56izxIcUvVij4ZStWuatM3AB17stsZw&oe=6A0B0717"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkIzL7qE4_QQ7kNvwHq1SH2&_nc_oc=AdoBpBz8RaeOQmuCQhQgAAL0UWOg_hwjrfLWPGEJ0CLXtb0vJu9a0y69tRYjCpDKiN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53Vs4wQd-wMwpCH0cKJEOmUZDPd0hYMLnxYmRA14lR9w&oe=6A0B0DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTTWFbeF_swQ7kNvwGFZOcK&_nc_oc=Adreth0CimrTErQvQUpiGrUr6EgMdnztrzYxelVCn9C1swRn1_cBeB6ZeWQzK_OZlBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vKa7SWlQ7-nXmb5c9ds9_s56ZO04IyXcQ1MagMPt1mQ&oe=6A0B322E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
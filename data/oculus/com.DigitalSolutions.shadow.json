00_AQHA1gos1oRTfiniEc2o5lA3WjN__5jufsArK7tc46bKUA&oe=6A882117"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Dh1uN56DmcQ7kNvwHZ2byE&_nc_oc=AdpBEHMaSuDZOJUwR9Y0HsKviH6G0hTCLKAdABnCgK0BSHYOyDQzd4_kYXp1FMV9rr8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwepbuSQfvq1Vl_djTS-Ch25cK7jPpu3A1__u7cIvqaw&oe=6A881F21"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYb8iQR4oRYQ7kNvwFaNeNH&_nc_oc=AdpY7fZ6LfkKNLfFAy5byWFBstxsH4R7MHIpVbZ61FG78E3HTcl3EW8MNyRiSSmJs4M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRnpm_fquoUVmd3YAiWfIFl2hiaCcnRSy9Iafcm9OtQg&oe=6A884597"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl-0kN16ha8Q7kNvwE-n5DI&_nc_oc=AdoQgCchB-rXl1ATv3HskbwfBaYDUA8OgvHEFN5ugP2nHLHN39cFf6cj3feWT_BG25Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzkgL8462UibqLCeWkN-n1iPXWgUMNawdyj9xiDsYP2A&oe=6A884C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuABfJd2SkgQ7kNvwG01A4h&_nc_oc=AdrRQ7Jc_bL-_ti6jhfcQgi6fFn0wrQa5biv_oaNULaZdk45dhO2AmexZunQ_iiSHxo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVdgY5i8qxmuoaitra4_UEzEEG1pRJLff4ff4lBLb9tg&oe=6A88386E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
00_AQClfnSzT6D4bD0-_gEXXMpbZkGqEyckMa50630pX9dZAQ&oe=6A539D57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM_6vWgEe-kQ7kNvwEJh3ZY&_nc_oc=Ado0UUaR8KqyGaM1chnW1sb7TkIH2X3fp-vsbhoP9Fr1k5CHlb28EQARHw-VZq4SwPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNj3y6wqrOEYm-XFo5RabBwfsPz3hBRZCuW3Jt8Saqyg&oe=6A539B61"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0qrlw4Wmr4Q7kNvwGD5RkR&_nc_oc=AdrOs7zazfmUhwCchnz3j47kMgyhZDI9Vayx0Ul2C9AKHezbe8FsbT6e5BKTS8_Mf_Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC19gy66-H1qpRlI5MfrEnokgln_6nM8eHWqm164O20qg&oe=6A538997"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmBzhJtjivIQ7kNvwFzNDoK&_nc_oc=Adr2_mRdk0rplo477AkiMlNrPyOhkoUcG1nnJeZEJ7sY3trkstw7VzTnw9i5mDIHoCQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIi7hDG5OZletL2N_LA_9slmsg_OQNfYqYsSKZvH5dkQ&oe=6A539022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUPtAsVcYkAQ7kNvwEv7Gh8&_nc_oc=AdpLp-92KaBD0FWStW_ufYuyI7uv_Htipd5p2Dynx8Bi0MUnQS2rQ1od1erPGbYVqeU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBycZgi06ptsGoY0cO7XVIRi24FGWQBWir4B89cFihPvg&oe=6A537C6E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
00_AQAKYqQ1U9PpEAstP01N0ZhFV5hnZyRAeElVT-ZKOacj_Q&oe=6A68B557"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2-bX01bXdcQ7kNvwECJt31&_nc_oc=AdolVAHLp4pRppWIF_EQPnSufUQBoPMp8cnvSLrPa9jc6WRiVTsmp6chMSXNdpxkKzI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCekzpJgmZZBZM-RvkoyrzyNuRiEvhm8ko-Vn_3kfPOMA&oe=6A68B361"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUuQgKvZ2GUQ7kNvwHcqG_W&_nc_oc=AdoJ8Uxmb7laiK4e7QwMrEjmAIpTh7c2yuFQ4DmdxSx3GvW2_5KnbKQs9FPp6Pjjl4s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2QNibJrfRU65UaAZCrB3aIaZUM7E-YgPlgFaHdIzdmA&oe=6A68A197"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hGfa0admXoQ7kNvwHHQT8T&_nc_oc=AdofL0sdx-2J4unIj4_lvpyBbaqf0wfNubeOtnNxdd6M2dGjoyD5R-NHHhugv18Qf9g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB44ofMzAK8-UfonpbFf_lwwLmeH4FWKu8jLJpijwJG0g&oe=6A68A822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd8GhabgpNwQ7kNvwG3_vGZ&_nc_oc=AdoCyS43ARarO77iERbmZWiCSWctLkyfUohc6nRyrmRSajP7eyA4emOkQIC7B40tYSo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpsy3fYW9vkD_bgYMl7ICwQvT6cv3hbjGzTPt_olrBew&oe=6A68946E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
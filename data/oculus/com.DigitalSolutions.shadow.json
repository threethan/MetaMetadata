le": "en_US", "screenshots": [{"file_name": "4.png", "id": "1539429179955690", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75295896_1539429183289023_1489445198920227203_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icsSE00EkNAQ7kNvwGpykOw&_nc_oc=AdopI5s-mIedNZj5X58FZNbrf7Tgra1aS1jH9uWyQoJLEtPsKZn6y3cCMw4zPjMU8TY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUgqdV9veHf1MX-Lq_cDZeuBuvnuWbOyA55ZK_CL4p5Pw&oe=6B10512F"}, {"file_name": "1.png", "id": "7266609076781799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411994_7266609086781798_189086065738975421_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa3-vomFc6kQ7kNvwGL1dTR&_nc_oc=AdoqWQB8mb8ERm5tM_WN-ZbfgPNj_SQ1oH8Z-GMKLVhioDG8Xw6G_CLI-VV9xMZoOE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWeUeR8ED-Iqdn5HJNO6SLfOqXK3iL9xzjXEcX6-NbxCA&oe=6B105C17"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0P-qcx8qEIQ7kNvwFgr2k2&_nc_oc=Ado893UotSftAy3vSqrA6eSsfu4rbCp_Kv15lgbO6QkvD6ezkj1WsBx0HpzST1tmXm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWqQ17K_OLyADy8FNzk933lvfdvLd_ZnIkaGxup9ldppw&oe=6B105A21"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhjJ9ZNNeWMQ7kNvwHCD_on&_nc_oc=AdpskELWT56LUNy7gJx5ifBN9bIv2vDx9B-fNgqNh_IkF5aT4NbANb5lL1InuALGeWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXBAaQYsw4EnCsekFxQBAd-SGLTJErDfkNygTCpenWdew&oe=6B104857"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqDkcbSx8sIQ7kNvwFaPa5Y&_nc_oc=AdqffCmhWZZHx7bXheiibrsRSr2gsPgf-2sdJSR8AY5Eif9H4FL6Otuum9G-uZwBJC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXrEMEhaoGBSEoQUzBICzYxhp4of5lcK1vd9miL9SfUsw&oe=6B104EE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah_zF_AShfEQ7kNvwHrYs-V&_nc_oc=AdoFzCep3-oDSYlH5DIL--A2HzMQDa3Q2RfEukRBQl2SF5N9MVhXOUvGu7Dci920By0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXe2TFZuDXMCcbNCqwtySNFikX91CrpSt2sJSnZDcok2w&oe=6B103B2E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25925491753731653"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1444595050506360"}, {"status": "PUBLISHED", "id": "1091347323893331"}, {"status": "PUBLISHED", "id": "978389864552414"}, {"status": "PUBLISHED", "id": "988328797191193"}, {"status": "PUBLISHED", "id": "892581917026473"}, {"status": "PUBLISHED", "i
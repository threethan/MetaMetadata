00_Af31oKoJ_xSdy7uanrpoFxcbeD2bK0Lllhch9Im7O4cfRQ&oe=69F35FD7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbKWgXqsaukQ7kNvwHwawRZ&_nc_oc=AdoPbqgikLFzw8I85bQbK95FZD8Rlgc1b7J5Fg3HuDrpBtw1xjYe4g2z_Iz5jAnrVzg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VKSdetHzxwfao2_Tr6e9XuudzVtPOWTavYHBd814cnw&oe=69F35DE1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibBJsT2dbmsQ7kNvwHcD1d0&_nc_oc=Adp4uP_-RcZE_rMxqMoveNKBuAyiEnQSm-vuhZct-Hs5cIEEcQc98AEx9oxxLt5vagA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xCrq8wsn0nX3gQM1SjUhqVZ113Iwy4-C3ag914AOseA&oe=69F34C17"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnruYfLP3ZsQ7kNvwHwbGbU&_nc_oc=Adrb32207-F67jDWHLeEKGYQ5bmQ1Tk31OTByoRs53CosIGhlh_BBXZ7m1V-TE8O6RI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1h_8zlcBUY7faudmCX1eWrEvUXWNYemrZYWRd1wFDMNg&oe=69F352A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQEj-_gLuz8Q7kNvwEfvjZe&_nc_oc=Ado7XhQ3hnZ7HGs-Ap639EZvdL0-d4QzDuWjUqIg_lN1TZqaCYAOLWnu6ETTSLCtOgI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wiETy7q0DSBAU0dPI8sfvJIrMi7oq8xai6sdmrmM_yg&oe=69F3772E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
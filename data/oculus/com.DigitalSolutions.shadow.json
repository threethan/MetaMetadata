266609076781799", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75411994_7266609086781798_189086065738975421_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa3-vomFc6kQ7kNvwG_i-by&_nc_oc=AdoAHa3WHCTmQYn8hrWUl7Y4ADj_TA1LSopPIf5yKfJhOM55Pw3nn26qAKRdTOtoR8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjo8_OOaVo6xXvGO-P_GNAVHilGeI55YHwAhIOGKE2UQ&oe=6B0F0A97"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0P-qcx8qEIQ7kNvwHtgrUY&_nc_oc=AdqGMgHIjkWSy01g3QGhzJJMwUZJPftBXxtS4rlYIP55MREPMyBxTeqSst0efll4r5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4_Ov401d-IKCaWvqPCaVDsavyB08bBxvXErNlIw8ROA&oe=6B0F08A1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhjJ9ZNNeWMQ7kNvwG-E_wH&_nc_oc=AdqAweuDQtYGuZp2mtGbONbpZWMl9_TAMhYLNBcUq9zzdsWw4BpH-JsZORRxrvxmXkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHtBpHg7QlMumfix1DXnFceef6LMeehAzf3-V5aAmHyw&oe=6B0EF6D7"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqDkcbSx8sIQ7kNvwE0BrlS&_nc_oc=Adpw0Tsj8Tq7-4wMKBfbzDcBjreGGQDx_k16hPPAMAYDbBwBQ0P4TT4dQcCIxIkHsdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVR4fp-kMwQWQbYgYhDS8GJysDy197g1O04YtK5cqurw&oe=6B0EFD62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixCMZFa2tNMQ7kNvwHxR0iy&_nc_oc=AdqfBvIyTzdo88P0R4VjX-c6FZ0tj3h7c4SxbxRVdllq2TARmpZxy1C8PgxspY6sm2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCoUGZJ80NktSpqOSlWjfA0LOiz7EUlCWFwn3ETYO_aw&oe=6B0EE9AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28168078639472942"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982539_542812305382691_6070273823410722632_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBSDfBIS6JQQ7kNvwEd1iUQ&_nc_oc=Ado86Tw0qNIhrkD6i0bJs8mDCTGpyDpMZyntcFdVH7B5tJUZOyBmD3iEjmT9BDyzN0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXioOMUPG7QtU8c7L6ifeQl69h8N2qe2ibgZub5020lCA&oe=6B0F05A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "shadow", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1714
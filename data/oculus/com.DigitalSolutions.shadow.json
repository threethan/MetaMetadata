00_Af2NHESic84dmicyX8SxTKjvxKCAszFeHZiL7Y4iTOEeYw&oe=69E8D3D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsU2Ro7sFz4Q7kNvwGuB1Lp&_nc_oc=AdpECXgi6jITXT5M3Ip_gbu46oAdIE-20_DFH8kh2iD1VKOU9MRSkp8tdR1p6kdiufg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JymX7iSg6y_7FJG4B7Hzj_IMWHtBP9R_dSWFfhePUUQ&oe=69E8D1E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S12pvH2HKUQ7kNvwEeNZYx&_nc_oc=AdrKOh2MrhjvapQYq-UfQqobG3d_jA5y61PJcPFy7xRKjmvItTn3Q5d9ABqCWmpqx_c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0COrZ4IoOEsUExvMRJfw31KKLAM0Gsg8TStg_-g_PN6A&oe=69E8C017"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aecvo_H_VEQ7kNvwGcYHgQ&_nc_oc=AdqgqcOiOnP45LU-lEZlfZTE9m1S68ZLt3i1ALcXEThLI0G6t_gzFvnzp-ZkX2hLGk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Y3mFSN-8d9LVYhx5-7UcE0AiUcYiT5JUL7prpaxUPxA&oe=69E8C6A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PRDCz0eFCTgQ7kNvwEs7VCB&_nc_oc=AdrVHpDjnBAqgRojVxttLF2nAOOBn6mIXQD2aqr6gmNLfSlk_wbp0KjQusavWeYufgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RHtyjYa6RJgJa56ZWd42XqRb6qnnWhwbycNR8KTWLmA&oe=69E8B2EE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
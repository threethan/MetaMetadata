00_Af5xp5N1or5OS5QH89mE_tOcbJFe6UrUeVch37tbMGzM0A&oe=6A05D4D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jz33RDRjyDoQ7kNvwH7g_Jr&_nc_oc=AdpBCmLOMo0kAf4oozewajPaQMSQZ3koRUbYKUm3jTB6Sch0xKYpGlXmpM_NKoyXO7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pp3g4syQkaIL7Oz1-7tS8U_ElPcDOrfcmNQ8xgZIVhA&oe=6A05D2E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dJz1RiUeAYQ7kNvwGogu4X&_nc_oc=Adp0hcTYsZWXtppVyr87amM6NenVTzTGa_op6yU-VTuHlizTVSPGd8hZn_fxigTRcwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44gbYlTjrgRXjDMAznC8e9kzeNmBD9wA1rBZAcfEQzMA&oe=6A05C117"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqHdQZwsi9UQ7kNvwGBK7O-&_nc_oc=AdrTj9lfDniXbv-YP0gL2Mpfs3lFo1QY0i0-QX0fPF6GdKijspTZ4xvRGOLijPuGseE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Rv6vA9Y1SFTAQG2VSeSlSpMtBri0RYJ5KT8gZKhfybA&oe=6A05C7A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc656Ul79E0Q7kNvwHggsWW&_nc_oc=AdolN_bp3N9xyrT500Ioyzr9oVJsDvVJNUmTgJjxD6zzpzRm8ZjRl-kfr4but8Ct6oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_7SSTOIxNMiheEFPMgXvSJpnoj-lPElz9D95Xc4MMpg&oe=6A05EC2E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
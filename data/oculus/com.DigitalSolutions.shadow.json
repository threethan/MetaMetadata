tA6nNl3yKos3MDgYOdS-hEpMgdfNTeUsodRpGtB5-jfpNaej4u5KqrPeFGiWYw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFTir99lv5Exk2O98QlQZp_xgOnp3YGFZj21-jcSUw9Q&oe=6A915B97"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWlXSS9n_sMQ7kNvwEiUItO&_nc_oc=Adq0XlYe947Q-86GYMNiE1TP_lnmgiw_aC2C1vrIQQxeQCWPk4H72vMOASNCvRmFdxA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAQpKPbvDzzCjXJ1ehCMSC5BeZY88tMNqP0WZAxqVj-Q&oe=6A9191E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4m5BHfgGfgQ7kNvwH2_ZTC&_nc_oc=Adqy4KdEG3tc1kdAtE6ppHd8Kb8z6RjGHD-agXw1Juf6OZBBwHskSYzxavmyDyEitCc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpR32Il1-m1TSJBCC0J-3RhYpuXVqMmCiALFE_9bdKqg&oe=6A918017"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXqxLAzV-boQ7kNvwF7KV54&_nc_oc=Adqq8u-XEUUdxl1oNcoG6xllZ7MwH7OmfsnN_MRR8qv6O-cdGmO97HBcj_F4H3x5eP0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNyrjI_yrW1u23VhZ8Oc0rluZwjbnMj9e5729eSJsbyA&oe=6A9186A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hP_ppq4iHqgQ7kNvwFnBeE1&_nc_oc=AdrNJ5FJnVh4WgVqDkRJyotJ8SDLGJeBnNkNAuWusfVZGQn__sYRPoHRqtxKJOEMjy0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUCXfs3Ky72BtGDO2M3nlnuFr1va86kwM-qbcxYy32jA&oe=6A9172EE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
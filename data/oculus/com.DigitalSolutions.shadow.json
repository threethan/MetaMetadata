00_Af1tfEaqtTsUPljRCkaf9HW6uBrJwFFNA3n3S8UcszQh-Q&oe=69EF6B57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OodltTJX4MYQ7kNvwEP1drL&_nc_oc=Adrbu2sp5axUkB8ZfWjh3v1VlGJ967s4nQh1OaIHvmtzCUU7iEuH4Nu93iOPBsHxUoQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QYzsk-RWWTvrESLjl-kTgAuLt2X7n2l2tdtvawlUmUQ&oe=69EF6961"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsVznI1RsKYQ7kNvwEC6-OL&_nc_oc=AdrdhpY_GzfAl8Scqy7kWTnQywmIRbuRnuE9kKMEzllT5fBhkNIe31tiwuCos6z_bRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2iKkvRa-JreuUrzKoV8egro1lPLjG_KII5yEa3SNpQYQ&oe=69EF5797"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orh1EZP53sgQ7kNvwEz_G_0&_nc_oc=AdpsFhfWVR1Wor7EdBKknd60wwQshY8ydR5S7naHFzlWXYnX8q2YL-70za2d33_Z-0M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2GIDpvmBe-3Wv5SRWBQl5VXecZ6H1DFpDZfkOC99d5Yw&oe=69EF5E22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qkv6ZaL5dgYQ7kNvwEc-tNJ&_nc_oc=AdoRfp905tzfsxDUNo0sVcJ_YmEjbHe-R9EkYa8G61v1S29rOd24Ew6usAbldCDvOuQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1njk9P7hVq_hswJuTH1Tn_TufZbo4pwSpMZhRzoGZR_A&oe=69EF82AE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
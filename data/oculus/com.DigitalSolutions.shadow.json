oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SSFbiOF6fNUQ7kNvwEldvdq&_nc_oc=AdlMruOHeDcOFSZSHjcYDsCTALgQMoBohhXVULF7XxkCId6tKZadY4OOvQvJLILTdUY&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfudLG2p3i7fzzDwLfuXplZ7bG2VtKEH4OAkungha7K-vg&oe=69A1A0E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLcDD8KhgpQQ7kNvwFOvwXk&_nc_oc=Adlsm64tLb_NgLqb1WVTMu2Nt80VgL-FybcEdu3XmQoxHTfsqGenxKJJW90th2Cs0wk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afub869FA6PcwX6dRGQU4TFXkwAHKCv7vb27V1eT0nJysQ&oe=69A18F17"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97I4Y9CJoIsQ7kNvwGpPkZ4&_nc_oc=AdlU4IvuSltyAPd4l19JfpOGuhIu0pTpUt4H6WyOJUQLAKyHYiQjEn-_f9_GRrqc7Tg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsWVx8zK-NPAgwr9Mp4R-LRc4tloen7MJcvZFvGhSN9fQ&oe=69A195A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wjf9wzogoU4Q7kNvwE3eWQI&_nc_oc=Adk9k-eVrPV9-M3nC5gtb9KL6kTfDYHzg7Vv-vP_HLMLaWXl6yDEsBYh-tnDlna-Lec&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftRaF8fpVaIhv5OTJlKrl-9QkNwgFB3vM2lkSbEyYaLSQ&oe=69A181EE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "269189016446
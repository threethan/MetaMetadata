dOdc11MExc7higGnsjsqhokD-uaWKUhM54XHu6MIB_6fe8I2hWCQ8_yztCOedI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZHHmrRy64RWs9hmYsJa8BRN2jFTYiEiYCwkhQl8BusQ&oe=6AE9E857"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5EYGLKGqSAQ7kNvwFE6gL_&_nc_oc=AdpuWgdVDZz6oSpebjngnhNhdalWv6PuOeViSNldqT2KYb_1ZBuhAW8QIfRBO1ECWDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy3fgjgPf6PTZVSrQgpBqt8rVA338qKKcNw_OpHh-EbQ&oe=6AE9E661"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHWbxVge9_cQ7kNvwHC4hN3&_nc_oc=Adqr0dHqQI8y477y6VOda9c0fBL2Mno2H6LoNIk5SCgJXC0OlNIzhYlN_UU_OFF3wYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0RFixO6L9gCe11qJJPSWC9q2wNHwOuK6WVm82xQJQ_w&oe=6AEA0CD7"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVlCWKPUQAEQ7kNvwFS7r9o&_nc_oc=AdruyHO4T_SKUexdAZ01X0F1fhc2SM68iTMG24W_BcTsrgNZAQZ2eFOnXY3CxuH3e-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrZhZ82hTcZiTiasu80l-YrwdIoOhsqsih4wJjcaoaIQ&oe=6AEA1362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGWgdnrCYa8Q7kNvwHPhH03&_nc_oc=AdrGuZVHgrcY6x0yu-PRP_R_g-2CEooSQ7oZqR8YWmWxlv22l-IKupF4UX7FgdppgxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT4QvedrHVThpstepe_jdLJrtn_WgKBICUR1HYugH6OQ&oe=6AE9FFAE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null
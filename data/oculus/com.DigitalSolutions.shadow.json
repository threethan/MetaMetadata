xm4Q7kNvwHVj6_R&_nc_oc=Adr6O9etd-aYnZ4Eu7xluHRaXoF2mfuULZK_A0gOolAzrJY3SE3awvHE__5FVLZu2sA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lAvzXjd_h7fokktak91upTMB0tieIXd53DVxn1m9NyQ&oe=69DF9957"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j9SuZTS9eAQ7kNvwH53vE7&_nc_oc=AdrLe8X5FHroIxAfjXaJrVY1VRaUWK90rQa4gwUIEkfBzILB_My8maQyTeaQ5gKH6Jk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XSj2OvmqHwAdZR23sqzMIt-pe2p0JQe7ABcMypB0-Ew&oe=69DF9761"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P68VugDsygEQ7kNvwHcf-Li&_nc_oc=AdqC_qRDuJroVAffgGsuLum_58QigK4MGwybMTmschtSFCfwhpG9tAtk6scX_sVAy8A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IuybfseTH54Yz6-IOi8kLgQiBavnu9xI96nMV-GXr8Q&oe=69DF8597"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMhkolFBNwIQ7kNvwH9ep4I&_nc_oc=AdrL90KBIOk2RUVAH63ckK5tbY6wYM7Opjl8MQn-nTBYh5zWbVwqQ8T8gm605UC5nI8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0I_umNKAKZuzQvZ2f6dr8H0HIxWBgFwDFGqJlFH9k-Tw&oe=69DF8C22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSnRnpeofyYQ7kNvwGHMEjA&_nc_oc=Adrg16lfCoZJcaISyOcYZ3QzDE7rGS5F3KZaaNCE7ksuRY6Ci2kaEPavWpsAokVSOeM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XCVCB9bPMwRXZtAVjpUiwAcKSygnlw6r58C8C4hXqRQ&oe=69DF786E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer
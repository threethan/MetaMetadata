_oc=Adr8FHciexdmCZm80lLSlw1BjH0cGwEqxjrDyl4_BFcaa9XGAxi4xkO9OpsgKNQuCAE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS_E5n2ejTo3QaGBL3wtUtHOT8GmhNZjU6siK534_jVw&oe=6A8D6717"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq5Fhvs0tz8Q7kNvwFhPyri&_nc_oc=Adq-D3B3x0ykJ8aoEH9rSz_SohqtXUju48oAw_BZ29IOA7U9t7dE2CzuL_-DuNDZztA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuvvUBDr_1K3HJf5CyF7MKcumC115pokkt6cZiZmZrcA&oe=6A8D6521"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwiCUrCdeQQQ7kNvwGX9qNQ&_nc_oc=AdoIG-QR8hUsadW5P3z1Ztld4wSO6yaDc0ovkOAL9TOsA8cixvpMlBwZmpRD9_rjPCQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLMq668d9ZYg4i8u1Wp4xHBgz0uDkUwxDXn0s3fAYinw&oe=6A8D8B97"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbkoAUxpqxYQ7kNvwF96o8V&_nc_oc=AdojzlpaytmMlrzA6mGV9zwngC0yTSmk-E8cGFnfyUR_eNuj4BAVikZuumTCP_w7vGE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEW4ewzHhurE6XYErbPVIoLA3oNL_Z5VkK_Bnc3vJ9ww&oe=6A8D9222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFHJvPhLbQ8Q7kNvwHjUUid&_nc_oc=AdrAiGJJL28heNOEVkSndx53bQdHor_VU_O34y1t-mNqAefUMtuJx-nabQszsTfyjkA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRdikhSPEqx_20rCcy1QvAfVe38xmMyC6TZ_C6mXrtbA&oe=6A8D7E6E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_servic
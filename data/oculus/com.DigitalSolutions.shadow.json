6PgQ7kNvwFcTr1L&_nc_oc=AdqlnUUUd-3Howyo21cLoe07Ztb4HW0QeW5-GGg5nTOhOM8VqHP0jcXNTiFHoccaU_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J4xfnoytakrVz-xUTDXnnpqzcAPymu4_3Al-a9yIjpw&oe=6A0331D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VHrKT-rnB8Q7kNvwF12DYl&_nc_oc=AdpX88wzeJjyxL45W5wJFZ8ns7HFW6GEoxA3V-Zau_rrdDLkONkd8fZVh8miPW0AkIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wFAhiLeAjXD6SJm7xIDXyP7tvDNPEyEMSSYIYThTZkA&oe=6A032FE1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJmN2AIS2UMQ7kNvwHVTb-v&_nc_oc=AdrrmJ_UJ1skEF0PRwFDAWB30u6q2QTPSdo7ex0hPlyjB75a8QEyW65gD9mqaDep-aw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41-8QTa8NzoYqlV4v8YsbXk0BPcoG8jnSZTFvQsy5C1w&oe=6A031E17"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBdk9VK4RGUQ7kNvwFz5Iig&_nc_oc=Ado_FcQW2JkPleTudq67CKnh3R3bJmXgm1GOS09DnXjMsW42ytg6xgTn0fhOfbaVgMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vmalhRrYxCzoee96-xUOtXFKzM0BzmHYxJKqX7qwC9g&oe=6A0324A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc656Ul79E0Q7kNvwFZcnnR&_nc_oc=AdoQe32pzOOBtjroCh8mxohH5v5vbnRPEaWiOldLDEpqriLwjsA_odfJxGpxMwZQeOE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rm8sUC3gPbyZCZK38zMnyqYOokOVMX16E0wOFdGTrzA&oe=6A0310EE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer
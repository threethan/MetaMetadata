00_Af4SgSeVr6d40rt16gvdrL9xEafqZ1h4Zv5E3EJV4OGuXw&oe=69F9F757"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoAeHJppht0Q7kNvwFKJFBT&_nc_oc=AdodYO9yNySx3qiEc-PCqXo64JOF-z8XQlD6F_ygAiU6PJ17qg76smOVho3RblwQQj4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V0Mx5pcP8ms3EUp4HrZIfqfWKhmGGgt9-8G2TGrgNmA&oe=69F9F561"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoKrEi-wZ7MQ7kNvwGJ0ihn&_nc_oc=AdqOxwyLTBX0Rch4OUBx7RUZaxy9pOhrzX3MlFz2R_imAwR05t1EC6zAUS8-5YPOAX8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tZoVloYtU9Vjd_Z7-Lq8DGoyECrsBFT10ia83JOlz5g&oe=69F9E397"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3212hCJEZUQ7kNvwGu-78h&_nc_oc=Adp1_HWafQjz8HWHVWCNuvAz9u7dmHMyvYaCTwwbQjZKzfTa_piWEq77qTqMQnzx83o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59kLygLblTC9HKGt3NI_fZOjRzZMpfw3sHgBtqQCBUZw&oe=69F9EA22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oby6f1v_6GMQ7kNvwHMfNxq&_nc_oc=AdrI4NkSfl6S1HNnJ-6inTnMX9hd09u26da3DjP9DRWlpqRm9IuHLpYc0XDdZscby5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-Gen7eiR_w-GTMbaZwlwBC6q6bDPUjJaH3oW5_53Sqw&oe=69FA0EAE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
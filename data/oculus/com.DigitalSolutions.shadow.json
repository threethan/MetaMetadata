scdn.com/v/t64.5771-25/75411994_7266609086781798_189086065738975421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN0eU4iMG7QQ7kNvwG_eJrA&_nc_oc=AdorR7071ipOGVHSLq2LtcL3xYbVrSaxbVKKFkMfNWhzx1SX5muEmsMKOaWjKNYG42w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYd7LoanDSTYzry-FVDX1ftL-4HKTImUUHjfOV0gcJbw&oe=6AF47457"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4Lz-JLLpWoQ7kNvwFWrn36&_nc_oc=AdpUtgv8qsXhqxf1BS4ZTxFB3CH-mI6EkNExJos-RwuU3nornRgDXj30Z8iTFCxlh4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9cjE6tHIStVn37YmUuH6hc4aZ0bLOHOrq9ADUD4UhkQ&oe=6AF47261"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peNyxkRKskwQ7kNvwG8hbAZ&_nc_oc=AdqzU3Zr5CUX7Oib5Ne1UwEcIwb-qWfgL3rHAN-yp6Czo0Wtp48X6oqNU50wJa41tTM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRseoIl7nJXiV1wuiCyVvvG_d4scVWGaUGJKNMtg8n-8w&oe=6AF498D7"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdQhEDbFDnsQ7kNvwFgtsLZ&_nc_oc=AdrkMoKqkVS14QcTUWAFGjmengw0IZDK-pKtadj_j9hPJb3hJHWEA5gO7Vzo-0-G9X4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd0xEsVrmn_DKkzGgJQ49CMPzWc5t_ZtegaYa_RPboYA&oe=6AF49F62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcvY1MwZ7G0Q7kNvwHxM4pj&_nc_oc=AdpUu4_Cto66b9ASjp_MBGIXntQOwX2NLXWPBXWEKWp0Qr8b21BC_EHTi7Vn-JNheyo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSqiVLIodv3w36rPMUMiuTnr4MRwy1ZS42wc9xFH05gQ&oe=6AF48BAE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25925491753731653"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1091347323893331"}, {"status": "PUBLISHED", "id": "978389864552414"}, {"status": "PUBLISHED", "id": "988328797191193"}, {"status": "PUBLISHED", "id": "892581917026473"}, {"status": "PUBLISHED", "id": "1509298966809523"}, {"status": "PUBLISHED", "id": "312667001685886"}]}, "baseline_offer": {"id": "312667001685886"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1091347323893331"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25925498390397656", "version": "1.0"}, "id": "1137839884129670", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25925491733731655", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBin
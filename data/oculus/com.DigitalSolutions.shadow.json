le": "en_US", "screenshots": [{"file_name": "4.png", "id": "1539429179955690", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295896_1539429183289023_1489445198920227203_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPZAo1SzKJgQ7kNvwFgTSvl&_nc_oc=AdrPm7SkGNtrFHrwtB8eAFjN-RB0M1yncDqvLf0zVCFDpR7563nppcWzF0nJ2JFYn3w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-TfPgOYGM1Sde-WHn2_aA8dRI6KUfr0peXEUI2W26wQ&oe=6B08682F"}, {"file_name": "1.png", "id": "7266609076781799", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75411994_7266609086781798_189086065738975421_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI_TgXyUDYcQ7kNvwF9oZnU&_nc_oc=Adq2X6M4qJ0Q1BL8d8_V1D-NKb2tViOnd9wkBt44dTPYBoqE4Lc46_xmakXzTbyxGWI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWdMDkIhgIgAMmN7aqHLTkfi3ZnnRaFDDmO_aQOh95VQ&oe=6B087317"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5RkFg77R5AQ7kNvwGG9u13&_nc_oc=AdrsPzOJ-JjXtigDXwAYoFDMXV0y_uKIeHOlvCnjYs0vB0q9-Drfgd13MF91gpIkLbY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvDE0Yy2Vk6ykreB5KrRk-tlICXG1ABP0t_d9gOMIxyQ&oe=6B087121"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef4YCC5ADtkQ7kNvwFb0tJO&_nc_oc=AdqAF3czfqGrDV35gUj3CLQyKHUml5BqxsRt9qanGT0P5Qjt06SBYCVnCFer5n61o30&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQp0IXuX28mEwI7yU_v-pxHa06vdHYOOPln9NnHbOncw&oe=6B085F57"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vK07h5jkWgQ7kNvwHZlnKu&_nc_oc=AdpxNZVn3vEKtJVm5nR5F4flKHGDYlsCsc9ZqTbzvL0puxvW4qaOShFO5p7g6N6xt2s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAXvUSz9_FtzDm2SNXVir32OsdDHopIax0geMuRcBhzA&oe=6B0865E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wjRfkjIOP0Q7kNvwGdIU6y&_nc_oc=Ado3Uf2tKOQcCq7lPQw5oaT1X2s7jjHpiZdheMUjwRlhU9Qzf2uU0URntvxgEWbltIQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSPtptQyROMzYp31RE9NcxB5mgb5wx1pYdsZsfqPvvMA&oe=6B08522E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25925491753731653"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1444595050506360"}, {"status": "PUBLISHED", "id": "1091347323893331"}, {"status": "PUBLISHED", "id": "978389864552414"}, {"status": "PUBLISHED", "id": "988328797191193"}, {"status": "PUBLISHED", "id": "892581917026473"}, {"status": "PUBLISHED", "i
xrpoWX4KMMTIw&oe=69C146D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUxW_eUFqtcQ7kNvwGDkw2x&_nc_oc=AdpP1MiLllUAcUS5PA-UpyaHjts5jLoqYwcMGxkHS-IRomzFJY3B-CGh9wS-yulQBCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzlvHMa1KpCrF5GxT7B9o0bi_FJk_wQnknyefS1C202TQ&oe=69C144E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlOC-WvqxOAQ7kNvwF-ZamG&_nc_oc=Adr_Yzs_9MP_Vxgw6-S95GvdJYU26Zlzq2tZzfx9TpB8yzmnzqlrnTgSqck1Hx4FNpU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwgp7SkAKZ7xxvj_DL4mW-6bLIQbZYV6vJBKNA2_x3CCA&oe=69C13317"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66F-FFH97-4Q7kNvwEy8uHc&_nc_oc=Adp2M_vd38zEV8h2e8yd6BE6B2D--mXS-eQk4iTtWyxSqvqH2BuvwCjpSfWlhUiXtbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJRt7ipWwYbli3wvLQUgBpp0T6dXXIMqJDgqwqu-ifWQ&oe=69C139A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMvDYJURpKUQ7kNvwHmXqr2&_nc_oc=Adqd6LOd5Oc4Ej52kS523qQlBPqrl6xfqkEo4MGiqbk588aUXctM98PGC3F_Ose91pA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyDTjIMeuYlyxu5UyW-l1eRE-7AvoaDnapA1lnLsd91Vg&oe=69C125EE"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST",
00_Af44QU9xZf3Fg7mmEVQo1T43ac6xVunzZxt4_O4KtBX6fA&oe=6A1303D7"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmrfkdgJ3hsQ7kNvwFxQIId&_nc_oc=Adpd7I65qTAs5M5nsi2S6982dSyLTX0pUGL2UaA7xVjKRQ1fNmSnXiao8vWVA-pe4_Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HPXUbeS67eZH1xWV9JRANnBl9Wh25z4Z7Daf_bl-1ww&oe=6A1301E1"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSivb822SvwQ7kNvwGdSQlV&_nc_oc=Adq-HLiguoZK6rX6C_0nnKx_b0OZzMFoVnJ00TSG3-1MjSOB6MZgQV53B3qv90E8qVM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69gMherEoEbzyO9ud3hsVFUbWre3ZPnzBUXJHttWBTPA&oe=6A12F017"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO31VtuEeaEQ7kNvwFeEqmg&_nc_oc=Adr0Uy41-k23J4Pp2aAUwzTs9R2503Unxz9vf6oqP_PqruRATZv0hYUEBXTgEf8RYfA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78mYdoDB5Hhm97f2yQ6VwCrKkr5SiYo3W4MEvtGwjPGw&oe=6A12F6A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUOqNBfxUGAQ7kNvwGm7jY_&_nc_oc=AdpAAdxO1u7ZKlXXdEbD8AZCdCu0EoMIxTXXyAI-bLKtj7k7RxlPgKqfuw1JA5fp0Q0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CYoAWo30mCbE2wRX7Tx_ZZ5QD4LdBxW0UzvCWs8Ilgw&oe=6A131B2E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "catego
43XX8Up0WPnAw&oe=69A83A57"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3KatGQC_JYQ7kNvwHjzPrX&_nc_oc=AdkI69at2MicIyZxu2HronlVxStSTa8rx_fN44wYNtRlLIaSAXtA3bVnhMmTdW2oh24&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvHOtaGqDA46sWtZLT60592je5GxS9Qo09csQm05x0_Xw&oe=69A83861"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0LnG31aZvAQ7kNvwHMf5sJ&_nc_oc=Adk4R_4xpxwphrNKO851iolguGL4o68uOWBePkJeBre62CGNBsme7AGRQPMRog3OkV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs175RdCpUXclTrpkol9u39c5wQ6KqL9E460r5u3r7g_A&oe=69A82697"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjuXOJWQ5JgQ7kNvwHbWHPU&_nc_oc=AdnwEhL8LTO5kGZg60imnPfA39bFMQV6lZNj2QbUUAYmVp_gvvW7a1aa7r-Y_bBv7q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuKNVyYkjKI6WbVsxEJUTG3iw3oygG4eRZXBu-MZe5S5Q&oe=69A82D22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4REfFJRciy0Q7kNvwFS6hFu&_nc_oc=AdmEx444t3Ue7nSbOCtptnPFN54TfQ0sFVc2gHuF0ak-56xn-jEx3hREMoGzuFcj_UU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuDPuhTszv2RMLNa5oJdC1BOmLeU3G9gGwc_FPkqFAgDw&oe=69A8196E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST",
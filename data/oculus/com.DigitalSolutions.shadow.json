266609076781799", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75411994_7266609086781798_189086065738975421_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2z5EO49_mYQ7kNvwFA9lHG&_nc_oc=AdpAu5VixnpoCt7yLPQy5Xh1bI_NGn7mYzu98LDTYZRp1EyfrRRuvA-26PSXQtoLKOQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj4hoz5G8M894Jd-O015XRL_mWi0MxP7vDDnC0gmZJ-g&oe=6AFB4417"}, {"file_name": "5.png", "id": "1158447621850397", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035353_1158447625183730_6458765565871963951_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cGekuUecyMQ7kNvwFS5jcd&_nc_oc=AdpPFeemqFKGLkIK9_DteLpgchsM3hwmQUW6iw-Dl6039VnE5V1xhQ8Iok9VQATbpWE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoSeu1IOj7zIQiZvH_Wt59YjAjAiHvm7TcdsygPsJiAw&oe=6AFB4221"}, {"file_name": "3.png", "id": "430710953030699", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982609_430710956364032_6150975977529824521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYnQ1lxV6ygQ7kNvwGdP5Vg&_nc_oc=AdrHEymDGI9fiQq12m759GfEiBbh-H2gwQrLHTwYUPL-pf1vradmxo5TH_gaWS5im8Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb9KWp2W56bzB2umhYJEIbucRyT9FC_2wg9aEmd3CT7Q&oe=6AFB3057"}, {"file_name": "2.png", "id": "837774275033767", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982616_837774278367100_4897090437410338032_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSYX4HdPP8UQ7kNvwEwlLeU&_nc_oc=AdoF5qX8PeFroDLL6ay-r1LCHiWDIGgMJawh9UKtJZm-aKHC19Z_MaydIYAJFeCWz2g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb7V5NZdQ8EZNCadkoN__G2U8jmqm1KzfG9NOHpsHJOg&oe=6AFB36E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land-2560x1440.png", "id": "801538871433377", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984470_801538874766710_7104644288614866285_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ0xsbTim8MQ7kNvwH5OxMH&_nc_oc=AdrdpY3gsINx5Rd6V3j2Kvj8z-cf2vcUzwijCheRZKBPi1Yy7FgxU_yuCjlSa_aWmQU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYtZ1-LYyW4hjobzDm-ZWnozBgdXOZ5b0Ll2l4lLcNOA&oe=6AFB232E"}, "display_name": "shadow", "keywords": [], "long_description": "Travel through a series of increasingly complex levels, each designed to test your ability to visualize and manipulate 3D structures in a VR environment. With intuitive controls, you can directly interact with the cube and tubes, manipulating them with precision to create clear paths that abide by the rules.\nShadow is not just a game; it's a brain-teasing journey that unfolds within a minimalist, visually stunning universe that evolves as you progress. Each successful connection not only brings satisfaction but also unlocks new levels and complexities. This game ensures that every solution is a burst of dopamine as you see your spatial reasoning skills visibly improve.\nImmersive VR Experience: Feel the thrill of manipulating complex 3D puzzles in a fully immersive VR environment.\nChallenging Gameplay: Master the art of connecting points without intersection, crafting a continuous path through various angles and perspectives.\nProgressive Difficulty: As you advance, the puzzles increase in complexity, offering endless hours of engaging gameplay.\nEducational and Fun: Perfect for puzzle enthusiasts and those looking to sharpen their spatial thinking and geometry skills.\n\nPrepare to stretch your mind and enjoy a unique blend of puzzle-solving and construction in Shadow, where every level is a new opportunity to prove your ingenious problem-solving prowess in the virtual world!", "short_description": "Embark on a mesmerizing puzzle adventure in the virtual world of Shadow, where logic and creativity intertwine. Dive into an immersive experience where you must connect the vertices of a seemingly simple cube using tubes based on orthographic projections. But there's a twist\u2014ensure the tubes do not intersect and remain continuous, challenging your spatial awareness and problem-solving skills."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28168078639472942"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982539_542812305382691_6070273823410722632_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7AcYpM6FnUQ7kNvwFoSVo2&_nc_oc=AdqcDnI8ICUJBWC49larH0yuZI_OZ3Ey_r-vjdnxFMjlUZwiY7HocxCdMNmQiHv08MY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWrNlW1rZNE_YFwXXdGrfyMfSNJjsRys-vGN-fViZ8SA&oe=6AFB3F21"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "shadow", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1714
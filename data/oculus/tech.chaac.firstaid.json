bmI4VAAKE4tXe4XUJngjDA_3bmnZXbHcKmwA2CGqWXUJz3LsWEYeqG1A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r9xMcGrBw-TsHXvKkA6vSjjTwPLkgh-hD_SAPaEvuqQ&oe=6A146081"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wbh6YitQAEQQ7kNvwFRxnb4&_nc_oc=AdrfrirtZ4bHxF_8pTPKUfO0AIyDA88actamnHre8u6Ry9jK7nQUh8pAX3BVG5WEqR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PZFEdCuqcrYlNYzxqmtmYKAwy_S5rA3--HOp_1ILq3Q&oe=6A1457AA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owoO6DBUd2EQ7kNvwHYSR8j&_nc_oc=Adr_Jo1SCZBg8hfJbxUZ-8BparGIBvjY69lzu-JAmQIRfLv5UAGi0etQ6mDyfZzlmug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74BNhZSCmeR1oMq1M1dNVQ_GhC7nv24LVgAaJ0gJOO6Q&oe=6A144A2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCalqnyR1y8Q7kNvwHd8Rky&_nc_oc=AdoFCjIXJTP19NmfpjG7h6umhth-3Xb8jk6Ns0yTql0ypLY8ndek5tl3wIHdeVBGPME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66VILuIoED6lUIt60TagIETjE1XtnVrYKnZu1RTDYI-Q&oe=6A1472DC"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEQRJS7rpN4Q7kNvwFPquB8&_nc_oc=Adp1v74W_X8OrtjzQr8WaLkoIKeF0D6dAJFs5N68f-ZIsrV2dtWH3tqyr4JBSqQJx_8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m830FeZm7j5YkWRfzvEALqsS4RCH0KZ8Zkh50D1CdPQ&oe=6A146585"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
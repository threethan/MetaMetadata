k7jaqnwdNAZeA2tDkml7xpZKGlOT4-lwqAZSdFBbTIKuKUIjU6_MAgEQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xWM03Rt7Vk07AsXP7HPuPQwTh0iQ1gXynmzd-mAiu3Q&oe=6A452801"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvhK1tUNQn8Q7kNvwHhJyVS&_nc_oc=AdrBCcFIpE5ze4-ekT7hK-SIlgnD8aAbd9srqlAlnAQeYpRjqfn5-ggReEtLlzEvYXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NRr6g_qISRHPzogosEtzYfwkixc6F22Qn_0DHu-uQoQ&oe=6A451F2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RqpoAv8ULYQ7kNvwEBzAvN&_nc_oc=Adowg1fdaraEUb3676cCjEgc26WO4090VDrSqSB8I5np6Z6gQRdsaOurqVRDJGGMZ50&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uYq-RrYSKNyJJIjKp2KHKoT20-XNBccKnCa4hEx87sA&oe=6A4511AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvf56XnmMugQ7kNvwEM20tU&_nc_oc=AdocacroRzLn_Rh5jgLfe37IJfsvsZNhPtfqR4noFq-Yu5V_GgLoT2bbhcdUAPTxyoI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99EikPJYzN2WnarT3xFY0yiYFfGCTD1rwaMr1c6HoA2Q&oe=6A45021C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eshzyzsDPXAQ7kNvwGcG5sQ&_nc_oc=Adp8D2yoKjURtkN1J3EXD1RFJZa_CTnzgmQFPUhhJ21K7_CHkRFxehp6CubbcoXC3m8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n7q89UN7MJRwsEHrFXgPDbcGzrKcd-YbsqQr3FYXXSw&oe=6A452D05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
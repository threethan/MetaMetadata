dxBz2TP5iJKzR3lVsvTR73K5h_bGYLvjgjB1aKCIJtrOOpKA4p40rfvQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3C9TGkFNdRH3GK5fiMxFaVdlPoScveKfS7qdlBtOx6w&oe=6A3FE201"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeFsiA-wgIoQ7kNvwHghv-X&_nc_oc=AdqRXUEN79C0tRlOvFUtjAYUKgeeFM4XSzJPtNo9xWNG6OsWGr9kLXwdQjJ9xCNkqQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AmxTU9oO9XYbm4jl-3dtUt4YZfsggMtC9l9_aC9aNsg&oe=6A3FD92A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fI-e-wYatR8Q7kNvwGT8gNE&_nc_oc=AdpTRdD8sW894FEx-lIg7-ur2URHo5adU54ojH7wzUGzYvCGuRGWAMkB3UkpC1JT6Q4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kSwEjmFsZ2CiGUlluUhINpA6Y1k4OfkLkzCoGLYO2Pg&oe=6A3FCBAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIaQZYV8-6UQ7kNvwH7wLu4&_nc_oc=AdpqH5abHGw8dZrSk22sf-awUz92EYVN-U_XlzbKnxWc6DKOgngapI8897DzmzlH2lU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86wgkReR2SjWg8ujnsPYtIOqi2_VnKfIxcB7ec5qerOA&oe=6A3FF45C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOO5hj1u_2UQ7kNvwE8Nujo&_nc_oc=AdoOI6JnE74TS2vyk1ZMflN6EMCwK6JYNA8wGhUVK6MshJEFpAOrY48njiN8yrsL6p8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94JiOC0MKQS4MC3s18ispYMLmFmBLZZXJvfV2ZuXrQ-Q&oe=6A3FE705"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
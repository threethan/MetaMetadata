Fu1OhF9NoQMnlxqcLAdRM5MXdQvK8mx_CA-VH9PLjoR6YNbXfrfAsvDc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbh9gF9tz3dz8FpohGdCn50nhX3GlbavhT66F8VurlyQ&oe=6AA01F81"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59ZC4PhDWykQ7kNvwGYvaFU&_nc_oc=Adq7Oxt-phNMPTWuVrLcs1GHi6LLbxWmhLdX5bIsGTJGWvUUhv3_o_2eeMJi5WlkrSg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCeUAQgm-_e3FMZ1qSbkBjKIPKAqydBYNWY74_SpC5nQ&oe=6AA016AA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-huaT_4h6asQ7kNvwGkqAJJ&_nc_oc=Adohf-RXPdUUqywss2scpspxrsxFl51iUZhAxbiLH8tjqIIzAi1Ey9sYkzelrJ6adds&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAsOv8qW_zXssISGgEQUIjT-YT3AfcAsO3GEM7utq9vg&oe=6AA0092F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku45ueu9Or0Q7kNvwFTWNDW&_nc_oc=AdonHRHFnVEsfj0c4RF74HNy2owChUCYEty_9rIS9NTPkmFwW89KhU9GKiQBOAiF4NA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVvR6ar3vk6ub26rpIM5jhh0KiMXeXr7lebrFJxpOXJA&oe=6A9FF99C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNcAMvyrP3kQ7kNvwEDBjWf&_nc_oc=AdqrLy8HUpyXUNLFV9vvwdsIuAofq7LCuLfyt8R-DgOnyD_iYvdRm9VUcAWMqCba76w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCKGw3kDlI1fxzz4ACWqQiqpAruEuq7Wt74KveVwui4A&oe=6AA02485"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
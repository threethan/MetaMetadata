LBvAJcUax5gnXy5ahgOmmSzInvRpB68OpcNrsA&oe=6B01BFC5"}, {"file_name": "Sprayscreenshot.png", "id": "1134219074671891", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974521_1134219078005224_7179707438156380427_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjX24X8lrfkQ7kNvwFlueAK&_nc_oc=AdrLnPKhAmlhrIv8DYvt718-eGvEV05C1WlNatetNjreCt8S3pPe1j6EejQEUZNcViI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb-QT0MZrIAL1M4WiGbzn9DJ3_xYzGGZ_IijXd3GxRrQ&oe=6B01BEC4"}, {"file_name": "Lobbyscreenshot.png", "id": "1106361077362388", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75305882_1106361080695721_2077980112903714015_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7Ozdm5iZ08Q7kNvwHBmrWh&_nc_oc=AdrVu5rs7Cu21eV4ZgNKMCoBIRl7X5lyqelsms1rNKTihdt8wAfU2JnwYUccNNSUcm4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbSOjD2qyAlj_UsXtQVgxprE2qOzudJMa44OZlSiGoXg&oe=6B01E07E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iz6kakU6rgQ7kNvwGmDcsx&_nc_oc=AdqLAp7NsGmDbqLqEd-EA-pYpPqu3Xq_LzqbtlnrKvjVrLaQqbtbFaGPUzvLsQ4C1Pw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEYV-L_-v9ONK1Ftle-mB-bdNkRWMr-FLyjGeAs_AntQ&oe=6B01C0DC"}, "display_name": "First Aid: Opioid Emergency", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, administer Narcan, and respond to opioid overdoses. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, from recognizing signs of an overdose to performing necessary interventions, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, administer Narcan, and manage opioid overdoses effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6643572715745666"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2697605097075477"}]}, "baseline_offer": {"id": "2697605097075477"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1714417320, "status": "PUBLISHED", "id": "2697605097075477"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6644216545681283", "version": "0.0.12"}, "id": "2416108708591012", "channel_name": "LIVE"}]}, "is_for_oculus_ke
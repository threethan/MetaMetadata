nc_sid=6e7a0a&_nc_ohc=vLiD_onsrb8Q7kNvwFfz9ZB&_nc_oc=Adks5RSjoG0tZU4TjiVsnsY8_ytc77z-psgHril9MvbBLGqWmhaUWxr4i5gDhczOpio&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4z8hy1ToQ2ZnsMYovgsC-4bul8LhU5NKB3fbt_Ge5QQ&oe=69BAB43E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4mHYs0zWVQQ7kNvwFc7Man&_nc_oc=AdkZuaCVWHZ_9o4AVvNoFrip9AZZ3R4vqSuEE0M3riouIy3zdoyfTVNdbJiK0d9dZlg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwN_1HFJ81SWpfCPeFSk16dg4ju0DFoihAPDxbGfmd49g&oe=69BA949C"}, "display_name": "First Aid: Opioid Emergency", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, administer Narcan, and respond to opioid overdoses. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, from recognizing signs of an overdose to performing necessary interventions, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, administer Narcan, and manage opioid overdoses effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https:/
EvaVk0oin2BsUf5D5QoTi5WTo2mTQ2sZBUN_PHlf7WIbc0oSnE_jV0KM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrjXuK-k6BZUrGv4vc65KOQAIszPD-3S3DXWnYAmRDzA&oe=6A4FB401"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H5xx3SptLMQ7kNvwHHwwuf&_nc_oc=Adppx0iUDkcY2pVCu2LqNcqITQ1o8m-Ypy4j4PdgF4gn1xD_BSZvvLl41JlCTfm5h54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9BJ_VyZ_0xS-lqH2FhrcMMfG4HktaeYNYweum6z4upw&oe=6A4FAB2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIckTWwvMRIQ7kNvwFQ5Xhi&_nc_oc=AdoCYAHSheDCdGsRJ4E_ns8k7_N9r0UlSYk3GBBPRsqu4T8C2TdCQMVqWesqMA1D4uA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrTHeAB9v8A3W7wv-t3mEe4FomqdfUHIk2gYT_mgIeqQ&oe=6A4F9DAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKQ4Lzpiuc8Q7kNvwFANmQC&_nc_oc=Adp-gXzUbwqg3zL5ykGAxce0J1K4eN1muuAvZp35kH8fSa56WPkD1wIMHgFEvndkJN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-gw-7OTlWvcZIUSCMVW_1gHPeaQCTOWXtMONCImxzxg&oe=6A4FC65C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs-HI7P7oykQ7kNvwG22cDR&_nc_oc=AdqrjiufFzyiOVV6oyUweU18_FT_5wqq-I41BUy4GnJ5tglrRNeJ8QwI25GRhaj3PEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA1_gDeduQftLbFkUASxl5uwtvU8q8K83Jp_DWxVmkPA&oe=6A4FB905"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
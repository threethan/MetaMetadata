45sN6evcqb2vEAl_dcrYwZUu2NgL2Ml0Bg-7fcIUilwcOnocKXa1AhVg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMmHVoRc_tIYBdlOJknsaMEBbvcgEv4cr3IxgBzWu8uw&oe=6A60D781"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXZ25wyQkfwQ7kNvwGUQxlM&_nc_oc=AdrtATsCanqeANiy78Cs93nqHJlDfjfV7aJstjM06CMVBALurqgEGxC-UaonIWg2uo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcuiS_3cDIz2Gz1svuSMOxTtw6RO7k_U5xE56-rida_A&oe=6A60CEAA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yA-cgOQFZAYQ7kNvwHv7TWq&_nc_oc=AdpKNdUoaXY_ydGrAAWeQDO4c_uVNTuewbVyE37NAU_9UOIp96C4YxUGub82yDAkhGU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC62Irutlgo6BdSkZX_vdsiCtM2jG4zOYOkHkViZ2zPBw&oe=6A60C12F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wx0qKmSdFbgQ7kNvwGsibDp&_nc_oc=Adow9Hnvgn-h697YriBUwsWlXrimoh2gyxoCa3uo7edcgv7sB16ush9gEaD6uujN2eE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeSysG6dLDX8mUBFlD4uFh2AOdIB5RipLkPx2dro33ZQ&oe=6A60B19C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcXOLbtxSUgQ7kNvwHy9OKg&_nc_oc=AdozipB9KnyWAWPq1xzlf9camyRVF998Nu8prHTsJGJzU4e1P5KxurQBpJUIr_jGfNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxfz_YkIfHuqQEjw1VSnXR5B1E0dI-4yWTXeTInjYaqA&oe=6A60A445"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
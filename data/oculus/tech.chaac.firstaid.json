9th-VP3Zg8MX_pq235b3KVkmcNkRUrSaLXRpn6acKiq8Zt-phfpdt0sZUE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMJojbyrLCD7BYdFrqxHohaZnqDAeM2cG2yNNQSzHnuw&oe=6AA95A01"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cvEF_XQqRsQ7kNvwHzJSuP&_nc_oc=AdoQkLhCgsH8G2MInMqqYAZBcanfQp92fZOkU4bANb1hsh9B6taKO8ym0EgVIx3xfwk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJf2MpmPNiHmstQ7gfRmknOs50DmbkTUkxgw9JaOMu2A&oe=6AA9512A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPKqGQlFoSIQ7kNvwGCBwrN&_nc_oc=AdrExxVE5yY8ZLGVMWcyrodvCtkiFMYCVI2JsoWYIUUj0HNdi1SiOE5L7a5o4G_n5q8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvLtHNSwj42aOOIPkq5X4Mt1g7DEVwfBsdeRpIDkjZPQ&oe=6AA943AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZK9r3-tAHi4Q7kNvwHlDnTZ&_nc_oc=Adq2HuuLSjYFSctTJUxUfG-C0fnKceeTEAyNhHIHZ11LfptYMkYtDcj552x0ScvJL_w&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-9lVEjGQ8GE8EIoNm8NoNR8ozux4ECbLceoY4l3Os5g&oe=6AA96C5C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6q9MozooAoQ7kNvwHuNLhH&_nc_oc=Ado-F7S39cPy2Qkxsl4Bgi2abhZl1kNRs0R0A4nRvXvMYprL94lhHj_xpSgJkUfGF64&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsTDU0rPCxgT57CbC2yzJNf6vovd8LXetoyQLXlgcN0Q&oe=6AA95F05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF",
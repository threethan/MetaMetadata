dC-3iATSFYXq5zOkz8H7Q5_zwDMXnyr-OoH7JrExZqPzV1hhoFsKkXWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB7dTikne9O7DQ_e4dUPtsRcl1RbgjOyRmmjYqzv6JTA&oe=6AC65B01"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RuIR6FhhFsQ7kNvwFtbjfC&_nc_oc=AdrQJTdxngmr5UO1X7Wn9-gnrKMwb5Frt_qyIJvovcKC3x8duTv8_2J7iG2UDZcZXlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIPb1Y0gLh9VDd0E_tOka4vmPc4nrBgYDWUCSXS4J1vA&oe=6AC6522A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOdVOfvAwV4Q7kNvwHwS3KA&_nc_oc=AdqkwlVALlytU7D2R3k-oosBBSnUiLNS0pIefGrkoQLGQvkhYXXPABg1xl20bYas24k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY0zPbRIFVrmCQucGW6zYYcTOoyWGpvuHRUgGSEX10pA&oe=6AC644AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7Nql31veWkQ7kNvwEOKBrM&_nc_oc=AdoSNwCYFVHEK4_b_QllwIl1EpX1UcNl-LVrwQEynlqbPR-8OwdKEPlVYh9E97MUL54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNL6emI2G4LMHh1lE7HigERE0Imgq6b8RLCav7X4LH8A&oe=6AC66D5C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iIQtTjKOc0Q7kNvwEP31nC&_nc_oc=AdpZbjELHhjUzPQagAHS6GV7nhTMUfC57IBkyly6KAvIKj-XFg2p7Dn71r6WJtGpY5Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5VhmAbp9LZMFZqzyKK-WhIzDUAShEeC51mDNj8gMkOw&oe=6AC66005"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
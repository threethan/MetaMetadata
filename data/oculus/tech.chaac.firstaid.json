-Uivd0c1aR76db9lJb_PLSgexS3ZCp2qwn-TN83ySDIswAm60nWM4_kg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S0hiFln9zj8zK0SI5IappNQ74q6_Y0jT3uJ8scU1hXw&oe=6A1AF801"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oN7GDX6V3Y8Q7kNvwGEwF8d&_nc_oc=AdqC3ucoJdOQZdKfAu925KoVLH159BAqmQF4jI6tDGdLWcyOwOl25ShOR2H6KM8uu5s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75tSs-OaVevGzC3cT7CUU7AcnMwKb6RX4zUx0EbLFWHg&oe=6A1AEF2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzFz4CS8CjIQ7kNvwGZAp3z&_nc_oc=Adr5Fy92Q3rYZ1mAbf3yvK06WpwsUBMsQG0Gp3bSSkbH1qHGcDQ3_-Sah_tk2ZlDcG8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vXiJ0Pfu70BmutfoK9UdC_tA5b7w1s01M4nTa27T-9Q&oe=6A1AE1AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U586PYFa8igQ7kNvwHjab0f&_nc_oc=AdrIgn_YKVs17MNLBddcMjUOq8tghXN_uknkE8NlRCJ_y9CnbyY1-ZYKMpXdQmKhN28&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dUkyISwx4k6mmc5oYyVcYpi1siXxWjE1WsSqxOMTGKA&oe=6A1B0A5C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wxrX7PaX94Q7kNvwEBBWuJ&_nc_oc=Ado4msIB13m0W-FblRZvMvY1d9c5Q2je0jyuQ9gukA00k-cpZE3THBNyusxWkzd3pPs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N5fQoEmjZmbP5-qTn8yvgBaTpGHZduxDejYu1b965Gg&oe=6A1AFD05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
Wnmnz3Ny6sAdFO0y2RnG01gsltKWCs74hLkpz9WQpWljLdghF2zwkYxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lFXP5-dEUYY9i0MPkUOch1oSbx59DXRm5AmsU6THjAw&oe=69E8DF01"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=by2SEspHJ6EQ7kNvwGcKaqN&_nc_oc=AdoksT-VgjdQia4q6IYxv5ViFP4J6XLg-MKkVwYFIbBAgi3Qi9Iju7mo_MNyEKCrReU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20rqWNTFhM1i_LbtoXL1xiAGc1mZq5Yl5AqIM-5-ALRg&oe=69E8D62A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtrpPL07NlkQ7kNvwE9BXDC&_nc_oc=AdrtReWx3HTomUQvyEYhbI4NKIRqR2Ijxe7m4mtQVikQWpTkEvOteZjOF8KYT-b31Jg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dtp_O1-E0iMsew8hbriNn9UfisTQ8HYf0_UYjHrCqhg&oe=69E8C8AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQIdYDoQalEQ7kNvwGF858v&_nc_oc=AdoDmIYV_O39KMGZl5DE3amBibOptCtwMlV4imAYOsqWMCdJHbFu7xZtZuMUsfSRsBg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PgChpBANO8gANUfhbNAaaDMpkk-id-cVuyjUUTpk12Q&oe=69E8B91C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mytDO_0Y_kQ7kNvwG5P2ZL&_nc_oc=Adp92J8HIB8C0eILGk47Rjhahyko1E4SYBv_UuC61ueZEK6JIdX6wLYRJ0QzxDtZkK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-Ymee-wyiAI0m-jIf43CZzCfCd10ypx3zmdPJIAuJaA&oe=69E8ABC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
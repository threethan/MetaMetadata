1m1OFPf3qAk0p6AjCEPUIheAxLV19sMtaLkmabxM2eY87kThK_PRaMrs-M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4o7wyE7fqzILzxhOT48XDiaZupbTQvnjB8-h7V2tqWCw&oe=6A11BD81"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-RWVv1uQikQ7kNvwFhg7j0&_nc_oc=AdphIR67PX2SjeKyHtI5d3VXhukbjxCo9Pk5uYaRwUYiDziBHHZZ-V7QB0sVcSZyAl4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gn3gy0y74aqjCyKU6f9j1Mh-5bHUQC-feu_kTaxGCXg&oe=6A11B4AA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Adz-khzS_SgQ7kNvwEMOMKq&_nc_oc=AdrhYpSnpB-dHycNzm8w1CISwn1ozoZEftmZGZ43GbHsdQGtR8lVw1BIm4-NkVVrk80&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gwIl-Txr9Urd6fENv3gvOLQr01DDQJaWXBwOsMs2kfg&oe=6A11A72F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6scFxdholyMQ7kNvwGCZB_P&_nc_oc=AdpFfOFF0JePYjydTVXGEpDI0tymS_deIzit4nwNALn5B8Fz0EUdbPa4wGzJafwzBBY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4suur2Hgc8riz3oxN9o2mYBTjozdVxPE4NEzfviaomaA&oe=6A11979C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQauXfTy6EwQ7kNvwEde2t9&_nc_oc=AdruvCpNKKrG_Z9CLypUoefP1FlkRI2B3GAo2AspM49G8b_hjzf9UBkZF7Ce9HAU4EI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OkkTTFfYbb0ZxYvQCCLVvTYr73x_QxwvJi8GEUpuJzQ&oe=6A11C285"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF",
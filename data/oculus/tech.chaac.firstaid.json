ZsVeOVBzYhcHwjcq7LGrDJR4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvTMqFVouozNUOUpERgeayvY5rFNUQZKYX37MXEl122A&oe=69C15201"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q87-Fn-zuwQ7kNvwFjfdg3&_nc_oc=AdqxZAyWW_hgAnayKBRVPCk4HBYtRrIY600QQ8nWM2yznCLgaX7kKnKYvGoXCsLrSyI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLVoz3q7FUFW22meWI7hvu6b184wfqlkg0hGu6urXV6g&oe=69C1492A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAoHNEHn3iUQ7kNvwFFOU82&_nc_oc=AdomFPY8AripwjbuGwu3pqa-sVDcteeh6bWiUkECiTOX0ivrdi2XVhkapaF887HVDAk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzRbj7y1TH93xHvxnIzBSEaa5tNHL6-RFcvAaKTnwRpA&oe=69C13BAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HRG78nlI4MQ7kNvwEA_5eQ&_nc_oc=Adr-WwG5M_k9iETxc1aKC720UNgtM5mx1KZjq5XNzm00xI5OjaGVMzVWRYrEU624RMY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsNzEmcDIIdma9eZWi-G4ivoE6QeYinqmh1842--RCxA&oe=69C12C1C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku3AqYZO2RMQ7kNvwHIgqoA&_nc_oc=AdoVSCqGzGiPpp5Sd0lY-yGRA3g_CjciJJq0BS3OqBWvgZPt8dv1UkXMG0PSPgXT2Bo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwDMNSpmOjhwCINzdPvRb-UrcxCeyWwI-0QTlVifSe33g&oe=69C11EC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": 
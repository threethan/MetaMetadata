E4YIaD_b_oDlktpHhBF0uutqbyXLyT-tli7WO9cB8zR3p81KtN1FNixYOM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mFHScD_aJt8vWpW1KBlhKp1lIHpWqEfeps97FFYjoPA&oe=6A394A81"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNAGkdJQhFAQ7kNvwHjHm8-&_nc_oc=Adpu6G1isRRmHo1A-27eG5PACT8gGzyHybrKYwotQbQwEuYpTDtDtfNW-AmMjcWdLnU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fUsDtiJWrCA08ygkU88Fa0xAuoewXuoYmnBD-oU0bqQ&oe=6A3941AA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erjIaNm4k0AQ7kNvwFK_cFu&_nc_oc=AdpfjUFZFO4tljJSay9B3Gnl_Jd35R_NdESoA4fGjmyYYvk9VdH5i29omPNJlBalwZk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xRuTa-TMS2fEK3o-oy_sM8PPmviIHKxNNS0THk8iBeQ&oe=6A39342F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odupxmVgIgQQ7kNvwE60JMS&_nc_oc=AdqmzR8lSXIlx1-Lm095V0YRGJlNg1tURfoSG-I7LluzH4UmUwCrQ6J8keWdETXHCjU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qv_mOkSnvmedoriQx4fPLmEtzwJH5U4P35uUlwVwLAw&oe=6A395CDC"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLpVhtWghWwQ7kNvwECWyoe&_nc_oc=Adppy2-dQlqoMLeVB30GvnCfeHYVGHn66W21ELBWt9igdxTBqLuMJOWkyCPwJUbZz6Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ekp-apnexaWZoisWVPCkzMCsLz83K0-eLivdVXBz4Lw&oe=6A394F85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF",
0tNmzj1UjGSI-iQsFA48mvhB6m0Y4KNl_oK4TCCSbykhWTVKcfz9w9Wo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NUuTd_hIud3G7lx8EOBcv9gSeK9wyAfaJR-cHeY0-qQ&oe=6A43D681"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvhK1tUNQn8Q7kNvwEZD1v9&_nc_oc=Adr6BUIcnqZO9dkMBIplKEwGVYq750G1GBdTQD61RS_ndT_ZBK33B57R_7cRQzxKI-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JCnXBb8V7JpHJ7Tcp3XNBbYWnUxIZWK-RvtjaGzHxDw&oe=6A43CDAA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RqpoAv8ULYQ7kNvwEIHOfX&_nc_oc=AdqqtZZ3oqBynuGu_cqejfJHFtEszD7aBqw-niR9umDBkmbZrPH5bAhcu_g7miHnJ1Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qwYGGkZ0_PqRkIlqhvJ13TJX8o3LOWdteZa4tGkmBbg&oe=6A43C02F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pvf56XnmMugQ7kNvwF4pFMc&_nc_oc=Adp_N-qxI5qtnpEPh8S49A4GMR3r5B_QgglCdZEcS_yB4JWI36T2NkiLiasmtjratnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ANUqkZ1tvNewsvI03jNTDLbY9ZgzK6RcsR1GKkizLhw&oe=6A43E8DC"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eshzyzsDPXAQ7kNvwGB6jsA&_nc_oc=AdptkjlBLRCSA7XRa4Zgk91cXpUClwofgsQVyyZKrgbhrgFaVILgtP0B_K8ieXQ29ac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PyQMteSIkaMoCdO0KEGQnxQnQYVHT9OiylvC1xqQCKg&oe=6A43DB85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
5Wxxl4gmjKP-ZoyRrvQxkgfQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzW8lLOartneY6vaqyGiBQkeZVbZRRhmW1FUTMZDldm3g&oe=69BD5D81"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sbCOodXEBEQ7kNvwHx65G2&_nc_oc=AdkHVYakLvPe2-Qvzql2vNlqxSRlutDCrTSzTzqEeqioqfXy3AB5ANESwiE3n5ugnU4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCJZG377OInMNXwQ6r1Iu3RnkmnStlFUmHZAgP64g-uA&oe=69BD54AA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4xRgJwY_xJEQ7kNvwGrae_t&_nc_oc=AdlfCMII-HoLxPdnDTFLkprdwjN3lWbodcuiaZn_6EqtDelBOB_nz_BvwG7bfCReC2E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6BexQm71aChLQ8owT2oC_Rc8x8ts8d3kSrWQCq5mCAQ&oe=69BD472F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvkJ9jDVCUgQ7kNvwHpRorO&_nc_oc=AdkSMTZSa6lj_2WULeN_P9XlFXfTQz8XgsYrSMMw3vSxLMpa1gBy_y84q_3zDu6AzvA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9yAWzhM0nQ034jx4yjiFHH_Ui1E2onDMYt_lk8nr-Qg&oe=69BD379C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_Hx1FBFvFEQ7kNvwHTConA&_nc_oc=Adkdrca4ymcVC1uxpMjZ4A7sdHS09lAkaGjvZ3JI7VGUg73mfCpinE5HHiVfXFW-aTM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwt9DaQCgfZUy3tGvbvb5U4jWUQQrJRm0u0F_PD2z0vRA&oe=69BD2A45"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": 
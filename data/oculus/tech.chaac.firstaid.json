_-ERJu13jRjCCKfXMIB81m5Af7kcXUquS8dfFIU5cUa0NzCCaFvcbvRE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XfdZBoAeGfZKxSVjj6NCGru1NX5HPuY2xgAYI0JUsRQ&oe=6A106C01"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-RWVv1uQikQ7kNvwFZZL2U&_nc_oc=Adog5BX427rUF1goQFn0iCTEBJVynfN2CkBCZ2f_Cb7xMzADVGID9oFQ9JbejpIrTj0&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aWL3MuK50nGjmhOLCrrjoUJ-MxXvKs2P5FQ3HBNLV4w&oe=6A10632A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Adz-khzS_SgQ7kNvwHKr6J1&_nc_oc=AdoLC9ov95QHaVuNMENj3-2cH3AjMSHaWh1R5ESZq0BpcONxHBqpp_A6n6himIFDOHY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OQpJiMZoVeEZvgoO9waAOwuRHjuzjblHw1XorgP9YpQ&oe=6A1055AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6scFxdholyMQ7kNvwE23JTv&_nc_oc=AdrNaq03rX0Qko5TUpsNOtrqujkmTl8JHfKNUXGzqsT3lm7l9W7vhw_rpp1E6n4b7fg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MBJmWB3SqN9xpjBiAP_phLCgqvUC02BAvvIQsAzWrHg&oe=6A107E5C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQauXfTy6EwQ7kNvwHWS6ry&_nc_oc=Adp-0aziAhQ_DMtOXwVlMM0eLKHEY8To1OPw-pqyFA-hQJmz5JBXhYE9ZVZpagdymEs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zgF6r99D2vS3TbnDtJaj4XbxmN4coEYKVaKoORr6F5Q&oe=6A107105"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
Ykb1lnLa7pkipHKNlUBTM8Mg0RQ16LA6K6TGZv6NyeFujrzpSeMEI7Mk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0izPAKuF6s-KDN_QxAUiltVJaqpT5lxD47b0qCKG0QAg&oe=69EF7681"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO-V94MR-EYQ7kNvwE9eUbK&_nc_oc=Adr7vmhKhfBolEsKmZXQYJKwnwkpGm22Nw9B9EY-Ww1GUHKKsB2O7jTEk9gCNdqCU7w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HRvWS050UDm6iKQj1aaIHVLC4EhPlN5thWEuWK3mnxA&oe=69EF6DAA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJ1eBBOgi-kQ7kNvwF-MOFH&_nc_oc=AdqgPxp4B_0sAp0YNjHNlsT-NCVjvHb7DEyMCKNRTyKIYHw_UyD0kl4SRWhSNWWEhQc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2jivY29FWRBwY2zGteCwHL0EiyhxdnYVzytfCfI5y_WA&oe=69EF602F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQ45KEpf9pAQ7kNvwHezz47&_nc_oc=Adr9iiTRG90upuy42FzzpFP_9GujugXL9AO_8c9mwJXQmLLs5b57_Clo8p7G02LWceM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31Vs-6sB24w8BrY_5fdFrbJf3wO4DPOoSRsF0Cy9g3iw&oe=69EF509C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toaqXpQpNGwQ7kNvwGAop8I&_nc_oc=AdpJgJhSB0YFzEjUrR52GlK7B21qF2svYI2sarXqmgHa6sxK_5bxUd-er6tm0IXMVdM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2X0VWWng8jLGdpuEOWQiANis5eKBFxtr6cbRYv5SccwQ&oe=69EF7B85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
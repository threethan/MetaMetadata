wx7JI-wENPA04P6mCgWrLhULsgpWCrd2IWZWRpgDtjXnEVPYgA40IlVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTS8MEtcSSF_XowLqxmlq5R1VQVEmknd9E6MXYEjRNj9w&oe=6AEB4501"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVlcoKMhGM0Q7kNvwHm3DCe&_nc_oc=AdrtZs2rgwxg-4pJwXj2qZi7BhIV8UWTbn5peG9H8MJUgXAQR8W1G36QxrDi5Oqv39c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM70m4Dg2bri3t-VQjzfnxJbpjShON0pq8nqWNwgYu5g&oe=6AEB3C2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9uMtkIvoPUQ7kNvwHZzznZ&_nc_oc=Adp2DgaJsXQWZ6LzbynCfzCGXrzBF4bUTSl1mmwn--bbywhIsZ8xWmh7sH4Bc0IflAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzcWNGiLiZyzMCJ81DNDEJ7CDIGjlaLIOka95rOSgIrg&oe=6AEB2EAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XbQPkJaVuYQ7kNvwHYdbIi&_nc_oc=AdouoEcS8YmpgJoLAWmqj6O0Ohw2Wto4v4MR_CKlzMX2MuUGRtr_NNoMoiGmYPBJ7uQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwMuyTGLXnyON30biRSZ1gDb97IUVIbZ3PlXfwMEkfdw&oe=6AEB575C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZ6CJVDrzs4Q7kNvwFQ_fet&_nc_oc=Adqy_kqbxOiP71k85KzNEFdJ7ZZY8ZIlc43rH_cil6Y_B1iIR5hngw30dcG5Ar9VKg8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGTsdI9qrHn38u-BL-2UQ3cSShpTT31FWsSewdWCe9wg&oe=6AEB4A05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
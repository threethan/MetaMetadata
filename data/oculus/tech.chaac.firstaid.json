YyEtzPqZlGknzw-J-YEUUdx_tGIdAFMUHvrKYzr3qeECJhThCQIFmTJ4dk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS1mgQymfaOLJkdaeismMBMrlxODRBBP-a8Sf57mYh6A&oe=6AA41401"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF5MAyzaH9kQ7kNvwFlLQa1&_nc_oc=AdpbT8BKG1OyAPWoY-6s7Di8GQud-vweUk2ifelnqkPmf3xpBHE32Dc6uxcwxo71rSc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdSu9SFdf_gGUvVS_W-xWigs5-oIud-z1IgsgeFdIKug&oe=6AA40B2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2TP0QnOs8IQ7kNvwGKYZsF&_nc_oc=AdqaWfFz2tcJj_jBHMRrHWwU1Zr7jOrTahCiTpgLfGFU30cNGnP7VwO68Ni2YrABVoQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRNrbLHGuPc0-9nGJRl4MaWoLBNH4ojYcD3MQXANPzBw&oe=6AA3FDAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlxnZ_dvk74Q7kNvwGh4BDo&_nc_oc=AdonEIJ97Y86o8DJvsIeMKMLv9YGEOml-Jtx105CHv_xgeZv1UOi1ZDxtXB9yExsdiQ&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuzux1ooAZclVXiYP06NMxf9IopKe8lX4Kax3c8qv7Vw&oe=6AA3EE1C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_ERCfFKzuEQ7kNvwGgFR0l&_nc_oc=AdosQoTomA6hRwPtqkkZHRkoD_TLAcaWOyHN8FveAzf1wdWAcdt2d-nokjYhuSeY808&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSnFhFF_O0xngBcd9O9WXiiuKyqdp_8cr7oqk5fAIORQ&oe=6AA41905"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF",
ChnedlZ0eb9zP8DB6UBITaoEHsBhpUrcir-baosymWYuhDIf_pae1VA0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDwO4KoBVcbvrI-QuMHtBW1llKD9wrrFrQzgxrasjhyg&oe=6AB68901"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Om67CuU0k_gQ7kNvwF6mI9E&_nc_oc=AdpnH0aJplCDwagV99P78uPV45kWFbW-kHKDdg2ThHyMUlxJMBxAqSIsDnAz3Ij4_A8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWqcprJma43MhZDIHbV9MnJxptmDAOQwOCwHF4PJYpmw&oe=6AB6802A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug3DDknSxEoQ7kNvwEgJs5e&_nc_oc=Adp0KvFzwM4BluoC-p4r411hpWVjlVLHjH_xH2YVrnbhMEWFNBTnFRT3osRw64boV_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGhGRg1cku8OnUa_ASYeQN_5y9g2nwnIfAJsnDoRjmWQ&oe=6AB672AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpuJsz8czYQQ7kNvwGvHazD&_nc_oc=AdrdNiIDen2WRc7eVyiY2FFW113yryXkJGC9gPp5E3GRs1EwZM_fCNjGMCOIor1lrF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_LzhPfkRbY-WvHAPsBHSNxwXkeQK4U_SQaXDs4qcqzw&oe=6AB69B5C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsbXRVUVYagQ7kNvwEP0j0U&_nc_oc=AdpKj6GDeT8smu-9jW-pA3aobSLSxWRKDo7O-kTIH4NrPc54gqV-eHQa9RC_kx96wEs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ87GP8BCH0dIgZxHlRv5hCFt_IAcKi4-juCssp4su61Q&oe=6AB68E05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
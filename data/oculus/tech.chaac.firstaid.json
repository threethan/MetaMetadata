h=00_AfvulmH9MtVev_4N3z9pBgaG9kPtGoG3mAufxX3EJCGS5g&oe=69998CC1"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck755RVGqxcQ7kNvwHtfWgq&_nc_oc=AdnOPMOSKWDtBrKAo0IDtCQtUy7LbiHWMO6B4eQKCi4gC8dTvxhYksGJA3QXM_KbfXc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuty9stj-yAv522XOubRwGBaXT1Y3rue7WFf04f5Ep3OQ&oe=6999BC2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KOZUsP_5p0Q7kNvwFwlpGX&_nc_oc=Adk5ixMaimftXdpQmzFBHa2SvPUCsh672Bm6BQ2aR1yXE1rc8mX5sjTpdWeC3BObOUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvfv2eJKVNHu3cXL9PhgO5luLFjdGxi2zm0jIcyR_eJMQ&oe=6999AEAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vP4nvUf5ObQQ7kNvwH9xqhr&_nc_oc=AdlHh1hb2K31hTm0LHE_Io61CYz3dRnqalFvKqlyMowrlXDNrRaRwKmUBN2FH1dhVIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfucpLLSZmSSZ0_mwCswSKZn3dR1h8vuYWQlSPu-lr74gQ&oe=69999F1C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qas-8PzY9ZcQ7kNvwGphzJ1&_nc_oc=Adnbm0JZZCYkfNMIz3cXZalSzMP-0vLojmBAh0lVOO-WzREVs0kD6thXwFoMfeTRU8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftcqH7nWHuyrqwvebctWajGJgSZ8nkYffSrAkWXzmiQ2g&oe=699991C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "
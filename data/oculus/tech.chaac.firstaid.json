-Npfv_GggEiNqaoQCNT7cHdNTTSed6vn4cIVl3SzfpfL6pA6_HzDPEzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1aKG9hEp3UHLAsQQ1shGK_Z1Wp500jT4iCxNer-jXnw&oe=6A5CE301"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x20ljxmCoBEQ7kNvwEYgpL_&_nc_oc=AdpYVKioktmDafOJXC36_QPflgIq6i_a_JFRmnVg1JwuBb2ej3eJYUNB9aNlHyX0oLI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcUZ7zgmZ6jN8sQnnvFPIgaubm7qgWlzZ4lhZG6Wg1cw&oe=6A5CDA2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W67tjROOQBkQ7kNvwGJj1P_&_nc_oc=AdrrZ7Dp9jAb8AgkSiMm04v13WsJM4Zj5UtySsPBVGqAI23c7FE90qsI7DKAPLjGyIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj55CkQ9yQb4kgzNco0vVfIn8sQtKrp886wD11N8uc4A&oe=6A5CCCAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUiSoaD8QsUQ7kNvwG_Vl3C&_nc_oc=AdpOk2PEZxk06lTD6cSVrqUYNwdI868hzdlTkDQEsLn2sjdPgeF0CnqKlYmm1zDNAhs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJd7NCM0gPwfCIdn3Wy58T3RqlJCY6KdQojRsjJ_kAvQ&oe=6A5CBD1C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCg1vbNIQyEQ7kNvwFzpcVd&_nc_oc=AdriWYarRHAilGIwdrkOClwqALFtYPyAv1zi1JHu5r9NKsTwmqpun8vWrgaYx35846A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB33dtpW0aY7PQwXd61m31AM-ycZleMSQdnvE4PFWS1dQ&oe=6A5CAFC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
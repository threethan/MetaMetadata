PoV4A0Zt10MBeePCHHUj21AWJyBi__WrfIr6-FdaYwlBuesUxl5tXMUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNICROHZKAOww6qI2bduzWQ_1FNW33JUARBBF7DwxeVBg&oe=6ACF9581"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfAqENZHY68Q7kNvwHZ1UrD&_nc_oc=AdpoL3C-jgaqAJ777T4aeqeh7WN_929xx8wvZQXV5hoFOO2-h1d4mlB-P_RVQHo_XAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2oCAZwFaWA0UUsxVzoVQhnnkBYMd19UxsECLgfrFarQ&oe=6ACF8CAA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8u9TKladBEQ7kNvwEu1Op0&_nc_oc=AdoTlQFFQgygBBPJ8oH5xqRbJd2GEGcWGnn8jhDLWmQHe6zANEYlDy2oKsqNihnUpmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9cyVEiSL-if6B5ZZw3taR525S0UO-IB7S57mxRxxrTQ&oe=6ACFB76F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHAXDcc6v_YQ7kNvwH1nBYK&_nc_oc=AdpBRnFcVCM2UBHf5j8fv2WxUyikFGRj9yL_vqoHIykdWXINvXraFHaQOv3_gTvWM9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN__aYFQK08NaOSvPwup5Rois6fuHPwMd5D9Mx8oOnTDA&oe=6ACFA7DC"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRy9Ni2fbNMQ7kNvwEZqRBT&_nc_oc=AdpEcSdfoUJePacxVqz4MNd_DIqlYcn5g_T5TZnbPdJ9QTeeJAdDgeKMAizdq6PMR44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORx_Lp0RGS8xD9227tsVH0zPxsHKEhRSJAV_lTX3EIbA&oe=6ACF9A85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
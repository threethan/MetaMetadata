3UMyyJEHAre6SZfUN5fa4SOIBOS65PuRrxaYCtJvuqd10dW237grQZUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LGFd4VEM4qC0K6vtjvIWvfy2jgjNKUQfZ6qsHLojmFg&oe=6A316181"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC6l8QvtMoUQ7kNvwFa0rdm&_nc_oc=Adp5I-jUzUBogd3OnWw9IeGIdgZfGytVGVvJTulMQRUXasxwW_Z7cA8hue9LSyATs90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LPqzFcxcRO2lT9OrdU4LHE0UOz7dhfSZzDs_nnQn7_g&oe=6A3158AA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx6EcTUXAk8Q7kNvwG_45sn&_nc_oc=AdqMf6pscf_YnYYnjMEw45e-Iwe9dIlmR7xUfhlx-nwEuboQDX6djERO_yIjFUXsomI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l5lRo95ItVs3tl8zRuOXggkuILgs4pRgovJlbqz301w&oe=6A314B2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rblSO_pVWsUQ7kNvwHwZM3M&_nc_oc=Adp5sI3YeUZbWzLy8H8v2dV88KaV4O8nFOFRsUsh6KU9FayyjZxHj6bLuX7-qSncp6g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84uFyalFlAI_NU18hX2y6Om07msKhBhS1XJe28ARV5KQ&oe=6A3173DC"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W0I077IzqcQ7kNvwGw_E--&_nc_oc=AdozyMWca4f4MGxUc81041e7qU6szycqNizh6axbxFneKsil03BfcQ8VHhi-Eji1-hU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QmXegg1q-rdukOZEJUy53Ipm3K7AFmEk1zz27IGZ8hw&oe=6A316685"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
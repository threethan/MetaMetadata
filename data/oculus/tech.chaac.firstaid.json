h=00_Afu3WSJxwr7hUD8mZtiYpDwgvLok2Ha_NGIKZ8vaIrohLQ&oe=699C2FC1"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IcdIiWfN5YQ7kNvwEyji7g&_nc_oc=AdnaJ4JMi0axjPrFsoAD7wfZvaK_2wdX6AhEl59jmEKyA17_vl8O-GPOtfyBQXSeXnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuLd7LvYA6cItg86gsLbDAT1Ply_AgZBFnKbeG7iWVoYA&oe=699C5F2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwlAvKTVVoAQ7kNvwHw9OC-&_nc_oc=Adkzzw687D434pIH6Bhst3kE8OI1HDINrvBSfH59tM5DQkbTCik0h_Z3gt3Dr5CtESY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsg-7dmILZftRrtCp7PtO3_AlyLFMj3FeiANuJH1bptwA&oe=699C51AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-y5dcXEZogQ7kNvwEKnzu6&_nc_oc=Admi5nQ0u_g0Cd3BvYupeQ3cjo-eH3VSCkUQGn7-vs3NTwkaEfT8k8xf4N3k3JTqRGk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs2pNHKv8I32m_-_A1oJcgiP5lO6K2jyGF7Kf6Pgu61YQ&oe=699C421C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qas-8PzY9ZcQ7kNvwH5zntF&_nc_oc=Adl0fTFqDMgTMoGizRfOweMMZHd342-T8KVArFUvUrxakEb1nhVP_kp1rN4ThnZ6L54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuCiQcYogIMnQNXQJ-OBFlX31EQ4C6v8gfGvKRKw9brNg&oe=699C34C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "
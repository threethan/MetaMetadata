_fU0bfC8m_KdRwJUeoI1J85RAQWmA_Ga0KI0O83ZuzRX0-KOeRvR9KkQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0au8BSJ1gP_RM25ca_SbjzDY5k2B5v5qTV2Wsn9RXdVQ&oe=69E24781"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gvz8WeLoinUQ7kNvwErKzBK&_nc_oc=AdotUx_91ZDbaIjiVTnW-mWAZtSS-HK7dUdG5FTd4aVjskfH27qeJFMTpdCay8pj6fA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qaNW_lNc7UkVCMs34JGj4Pyi1RUft8cVh-p7FgAYJEg&oe=69E23EAA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKsYlpr8cvwQ7kNvwFpCzNP&_nc_oc=AdpBiOX9z073MC7oatOP_54cQehSaIyW5bvqonhFPPfHaqqrjwlBiGxL4fBpA8ou_fs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sQIW9jwiip097Eq7q__bewsnAxQ6uw_a8hOtASXvphg&oe=69E2312F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dgE69KPe904Q7kNvwHMTRCB&_nc_oc=AdqKIkjcs1dvStypg5rDzOm80ItybCfanHNagas6QaTjjKU9YT3P9xisDQAKScMw5i8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tWCSB4bNGekEm6BA7AVLcptiqSZrUqWqWj0M47UOwPQ&oe=69E2219C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIM6YxVZDZ0Q7kNvwG8rNkJ&_nc_oc=Adrj32CGVVISVJJsCO2OjX-5k6tRAjrNNrCwDGn6bkeCtZFjMMGY6qEmna6pqMXK6fs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SGk8tcr0LHrYhO9PyeYqfF5iLDPBMhoEwgHvHvxWa2A&oe=69E24C85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
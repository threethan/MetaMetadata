nc_sid=6e7a0a&_nc_ohc=N2Uj9s6k930Q7kNvwFC6G9w&_nc_oc=Adl7HR4gf9MJ_hIOlHB0ylWYMofOuqqKYmfXhcBUgYuwOykYH1NPXCed2wFuvEk7Mns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyhfSElIfVGIHqZ_AlkyimDSKHv4LwNDek7yH-GLShYAg&oe=69BC05BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvkJ9jDVCUgQ7kNvwGhDPPs&_nc_oc=AdmfUbgY3fNocbP48Dh72qu2DMLamfy3ZISMOCq8cz-7h1eN_hBoyIUoKIhgjYveqz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyP3XdLACmduLgSOLuF7DsAQcafK5Fc2rdwlxqjK9TY6Q&oe=69BBE61C"}, "display_name": "First Aid: Opioid Emergency", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, administer Narcan, and respond to opioid overdoses. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, from recognizing signs of an overdose to performing necessary interventions, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, administer Narcan, and manage opioid overdoses effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https:/
Pvn3GucfPAjqvCSAlNDbXgSQ9F494dZPn8dOA5WfdF-tIKXWHUGCG7HM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pATnLHEH7lJxGmt1-lBc0Oqi0y82Vrm6Z6Y2Q8P7awA&oe=6A26D581"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcT1GUM8JnkQ7kNvwHUoBrs&_nc_oc=AdrfBVf8DrNL2o1vpU4VRzP0ltO1RZ_aMWxWZqh6R0aXciNghpyG_ugehkm1fth9_9o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sP3qjlLXYdXGNCeo72fbj1rqdP8MsqJQ7yK2BHCY2Vw&oe=6A26CCAA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OS4yElZfaPsQ7kNvwFjTSuU&_nc_oc=Adqefq2MzEkv8sbCLJQrGjKV6Ecsr7VolStMOtDe5bu_QKqDVrpcx1h_l2GWmAPcRtg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7r2UtZ15PwbPuei6FmaCgdYT_5IrPE3qJ91pmayr3Hg&oe=6A26BF2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFBZ1o0qwLcQ7kNvwHM7n_m&_nc_oc=AdocV9CKiMl7MmHDTwWtyags0kLz1wXc8G_l7KnuD0GqVv9s___Hwlv_z17xj8XzJ8E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0QnCLsVlq1omYcglfJ4hKwnMH1zOXbSoerWCC4w-Nzw&oe=6A26E7DC"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzzZE7_4imgQ7kNvwHJmOel&_nc_oc=AdqZz49mXbsKR6t_XiYgmJa7PTevYrczk1gq5o9hI3YQEJxDm7lrJHhrQOATDByE9Gs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u_8rcwYfVMptMpAVaU6cO_wKZAunnHeL5Xv8p49uMAQ&oe=6A26DA85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
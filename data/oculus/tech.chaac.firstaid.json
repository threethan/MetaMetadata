6Tg0XvSiEei2LBqUqdNZG3qZeY81_N257GBZXR8P6QurN23L-L-w_t50&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mm2Egw3p-W1ioy6ph3hHoprsw3LnUXjKb2SueSQ1HDw&oe=69FDF701"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt-hNVsGQc4Q7kNvwFBsR08&_nc_oc=AdpPhT7Y3wEcv8rI3SYyD-MfI_p_qRK491y8K7D5zoQgy5ic8tSxhRdAC2c3nSntJgA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VEBKnUP1J2T_b_VjFDY_VKFxuBnMS8CzKfxfmDZkLiw&oe=69FDEE2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dy4VIjBVbiYQ7kNvwFyZ3hu&_nc_oc=AdqhCFVZoAmYybiO4fY8DImMfs7dLCblv8wsJNMHfxbP8oUA_jyKcYinl2Tkj3yZ_xI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Af5jlo39offv-p_RFgLa3LN2YWAQExEYcLmuZArGGPw&oe=69FDE0AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVc7l1ytQpkQ7kNvwFvbWyc&_nc_oc=AdortaVCLQ8AtgvhTdNOm8KcdCvV6VEgL-W8_bglyLvhS_hkYwjUmgs_GuZe9kImJIc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bL0hxy1zkZq0xijQ7oRSyei3w8MuunsCyT2Ttk1SHbg&oe=69FDD11C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wo7_l8yHDf4Q7kNvwG8Wji2&_nc_oc=AdoRJy76PIkAjf8P147UB1q77nKQMyto102oClqwgrxNXFbrRMYnzwI-pWwWZFiu720&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lhKAdt8RkNJ7EpkWx0scg9l3-u_0d2vxTTbAwhUj9tg&oe=69FDFC05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
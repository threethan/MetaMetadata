9202077676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821952_674979205411009_69166282637722563_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdv2K1X3Uo0Q7kNvwERSg6C&_nc_oc=Adq3t1dxF3PWqH949_APIxFzJDwafXCHJuHU392qlBZZ52pgSZ14llvg02Pjnf8KKH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9lrZFYiUeAZb8uP6PorLaA86aa8psiq9D1b2QTYaeGw&oe=6B005D01"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3X0tIvNuiwQ7kNvwEjpO5Z&_nc_oc=AdrSxgQiCibVDOCE4AThqSSSRJKcF3Q5Re5hnuSlwQDxYBKU93Y_gTyPFpFWOv98TY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZMRmygtCvqoPF5dKSokuGFZV8oBxJW9u8bcFEGn2lAw&oe=6B00542A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFHKao6fUH8Q7kNvwHGtkWk&_nc_oc=AdpCIQIyvKIRyRxBjHVbwXmX8F27-ZkknkLnzKxwKCw8qqHXD70wUSD60l1EaeXkXSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrDfbG0VaCLEDX_rHH5DLLGa1jy8AYzfMjO7YqQ5kE-g&oe=6B007EEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iz6kakU6rgQ7kNvwGQUSZa&_nc_oc=AdoPcwoMG0Det7A_41uoZpGsks5wuoeurA3PqJAv1LEnFA3nZQJa5DT8ZxFDWthQfaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkBEUUteWm_QoZB69wjtOv-WHCq8HfMdN48evbufeSFg&oe=6B006F5C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqRg1UykzLUQ7kNvwFOIJ
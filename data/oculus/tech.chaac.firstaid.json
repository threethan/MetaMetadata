9202077676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821952_674979205411009_69166282637722563_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdv2K1X3Uo0Q7kNvwHf1cbO&_nc_oc=AdpIJLgfluxMH4qWfxep5pmOlR4UxJPNbVnowFpJc7WEo-6kJeJqX807Rp7EsaQ5D4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ45KW9AyL9CANd_yCQMX9IYRtkIlq-UtBLNwYWvSBeg&oe=6AFDBA01"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20Gsdy82_JAQ7kNvwF8D5Wa&_nc_oc=Adq4dVERo2Oq-j9CjWbsuu2HnJUpihrbn5IYzy-uSMoH2ufHyoh7V5Jqvr22tE6OZXs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJEQrUKsj9M7WXkiha-Hm-ztrg6_GlOJUBQvJHCShAIA&oe=6AFDB12A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC7nsJpS4jAQ7kNvwFdAIp6&_nc_oc=Adqt50t-79DvIxEINJ_OS6XOnRv0fRgBpRI6Seh2fN3zmx6I_1KEejZCR-cPJ_zpFrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJNoNALcC46J9lzEsdoZp9y4mRfJm9RSsWS-xpXSQ4pA&oe=6AFDDBEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOLE1sKA8AwQ7kNvwHTmA5l&_nc_oc=AdocwkPnRpm7ClEkThzjSYRexsjlonb8JYNf48bWjrbbyDE342necX-N5nUGQ64hVng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrAWOkyPZFaZ6sOQ6WaZ9_85u7uOu2mZhz8h9SQHkLUg&oe=6AFDCC5C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqRg1UykzLUQ7kNvwHUYT
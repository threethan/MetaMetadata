wWqqYsg41Pe3qEXTLv4l-1WHwwrZuU5cSwDnS3IZv5XOHumEO5YZFBsM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPboHbzXvq7PxZBL0mYqOD9H1CUJq_50HSbNSfEP2BXWw&oe=6AD0E701"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfAqENZHY68Q7kNvwF6kiqk&_nc_oc=Adq0iHJMpYtn-ZT6R0bbuXr1lYTA1ICsan1wcaLBQ70XZ-5tX_UHBjWZJNRrB7hOdRc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdBsmJS29S_ZIG8m3hi84lsPbIHLp9tKAfPdlmaPChdw&oe=6AD0DE2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEoVt3c7JBkQ7kNvwHPiO0q&_nc_oc=Adpq6YnlLqzGraPJ0QpTxrBKkavOHiWX40ZyFnqD_pWER7hOmUfpc2sOkZhx46uVntg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbPp-TDaYSJ6E_BoQX9tPvgf2NypH9cXqAcMy8eep51A&oe=6AD0D0AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zYi_kcn-0v4Q7kNvwE49Jw7&_nc_oc=Ado2FoXfbsjcwgeBaGRhYw-pB6RniYPXlL7spSLAKvyf-feIvsFL1THJAIXtPJ999oY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcfNlCQv-T6L6WjNgS_ww_-vsgYvi27PuTY3-LTKmjXA&oe=6AD0F95C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRy9Ni2fbNMQ7kNvwGPG4x1&_nc_oc=AdpSlonVn-D03oiZsXKot-TVl0bE_hwy9dDh0fM4eh8wE3Nusj7HAm8RzYGqfBTqN1w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhdazaqFX0M5-x1qMaPW5cxEO5d7olxwhrsG55F7jj0A&oe=6AD0EC05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
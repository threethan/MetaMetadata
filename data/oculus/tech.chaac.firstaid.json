-k8mSdFXCm7aoD4kblOvHSzrhcdhvPOc8a4nTo14HKMNUKaa_q45soL0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbeMnCoKLijO3AYwY3GTqaLdEfr8ZF-dmL9M-RFGuCyQ&oe=69C2A381"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q87-Fn-zuwQ7kNvwEbYbO2&_nc_oc=Ado4ybDmufxXSy6q3e_oPjtERMnjhpKY_1rQ2MbaCbxQtIotgdATZ_iu3LlliK0rZV4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBC44eqvH66OwRNA739NN-2_0OS6anMlBo0WPHApraJQ&oe=69C29AAA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAoHNEHn3iUQ7kNvwEcCDJz&_nc_oc=AdoFXQBgxfuPJuJxYJBYI2XM1H-ihIpX6wcqiKTjKRoFDTdbX_cHmqa2D3ZLXmqkV9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSMXPrXoTwn8WL8deWYee8n1ALUcR4igi-iRM6KHtkFA&oe=69C28D2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HRG78nlI4MQ7kNvwEdKqlu&_nc_oc=AdqRlP8P1z4LCIMCGkMSltEQmyiWrj9rSW8FrsYhJz-HpOGMb8eW3J9Vgbl7iTy966s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwW6FFOu1o8UAwJ5sVGHw3Wgeqf9mpou8azN38blv2TpA&oe=69C27D9C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku3AqYZO2RMQ7kNvwG4ymVO&_nc_oc=Adqt5zJws14VCAdgG8p0aD5Rakd9PgazQufSimzVDmX2EozpXes0-A8KbMBd0uxjsXs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-ER9R4DI6inLIkudVJT9W4V876O-O0NfBGa44JgjMKg&oe=69C27045"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
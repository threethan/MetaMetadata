ug9igevZo7DZ9alkoVhLVspfyI5OTYSWIF3YgTloMFSUYXPcRYJYYDRU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aU2tM475IpJeYq0CIQ_b3teyzl1B0njf00LhVI7CMtg&oe=69EE2501"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luRnZGhpRM4Q7kNvwHmGMFg&_nc_oc=Adrr2oiO7LIq8g6XpKBeauifQTxT68-2L1-fGwar2lwNtm0XfNqS3Yg5twfztPx22QI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PG3gfkHVxrMycwnDV87sN8-ee8O3bnycZz9lHnk2OYA&oe=69EE1C2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xhco_OwGFnUQ7kNvwFMA6MA&_nc_oc=AdoXPV6k4zuCW_iDu9YsEv7Ioy36HrsK_uxRbWPyLBGBevIYFn4IRMwPZJ2NMPyXaMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aCpGDDiJeYfbKNaxeBXF9667gEuII3qJXFYUhYZ7VpQ&oe=69EE0EAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSLWcVLbZpkQ7kNvwH8PUCa&_nc_oc=AdqxDXxxh6F8LCzFYT6AbnlL6tAfNyCspp_tkR-_t6dxeaZiMxR6ovVoRQB75Z3PB0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GVu-mu8CqDUgqG73pWM-rPHtQzTK1da8bWdtBynFSLw&oe=69EDFF1C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toaqXpQpNGwQ7kNvwGBK40L&_nc_oc=AdqxwftdvynHu2QyqBU3J1lB7nvalWXaMnV3XgYcJqkzm26FrdsQb2o2DiH8oaesP5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FN8UUzlUiOGcnnCHbuCNG3wtH4UzvVbkmmG1CYhQskg&oe=69EE2A05"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
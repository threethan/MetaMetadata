L1UR_uopApQgw4tvx2jeyUMaWkUfiW_gEgqHQ2bwP7-MF_iHS1VBzESs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdzreCnKc0xAjPeGRepBYJdNPYvesjxVxRxSESgzPosw&oe=6ACA4F81"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wrZh_ooA3wQ7kNvwFUBtte&_nc_oc=AdoBrPJcX5jdujPzujg_kq__rssfXOtM8UdKNCEVaeuAUPX7PG3LxYRWLBLVLlIhaoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZHOOO03FTI2vh9erkx9cSdwJ1w9rFmn8eANHeIl0G3g&oe=6ACA46AA"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sG_llY7Zs_sQ7kNvwEnVmYk&_nc_oc=Adr_bgfI6gv5hxoAsF72rF7WBZ-8Lm9HJLeb12l6ShZNFe0QSjFCVjt-vNgkkHi9yBM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt2irW5Y51Bqmu4fHIXZnhcMXxjIsZ34uAEZUZFSEdDQ&oe=6ACA716F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdF5bnfC5ugQ7kNvwHFtgc_&_nc_oc=AdryDnu20x4moXrvFAt1fJuI1HqyNv9-KWOvkxmxVLwBkGYRw8vgLsrvBt3M6ZpQEdk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXUCyIXo0K_3P8luQI-PoGi74Ti7m1L5W09tdRVpYrwA&oe=6ACA61DC"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbz_GDlv5SYQ7kNvwGo1mzX&_nc_oc=Adqvs3AOiSk1o8kR9cE1Thkkdq7yJS5TRAMRuk5h62-BG0JOn1sxWFDIR9LWp8wgMxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa2cOIjn8-cdSd4grH41VDezgvQrVp12GoXUZYseTu3g&oe=6ACA5485"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
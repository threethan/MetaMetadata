WiI4JITTGNNd7x2GnK-DJ1XE2kuq2nj5a3LNzkDigv5u6F_qs7kMBvBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUJc5mJ4Z_-GdyAllaahFuj0E86xI58vsuRlT_SLNM-Q&oe=69D12401"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E13bniwmXFUQ7kNvwHCK2dU&_nc_oc=Adqq0wP9GvEcDD1N5yQtCahZKm6NDs4ERPDR8s34cJD7ZXmfmjBfieiueXC9QeFb8mM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5iAiB0U1ROpUTN3NgyeJvJGZ574IYjvH65KWqm7gIig&oe=69D11B2A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxoNT41on3kQ7kNvwEwPpfs&_nc_oc=AdrgL02rllJLU5T1jrMsPFhdIJiJphdKjBDRASKNqX_M_DA-YUiVPTvU9FUXCriHbIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afys2QM3z28QEeHmdqaB3tEtKjyInFWWPl70FBGqlv1P3A&oe=69D10DAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgOONSizX9kQ7kNvwH2vJE8&_nc_oc=Adq1ABMqVSHAA1h_WzgcJncXY2UkV1K615vi3cmNSQGW4V_HyiDaCwYAcJDrPoJQwOk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzlWts1FnLMuIzJDdoknuEuUGeWIkXvsygaIn9ECzr6ug&oe=69D0FE1C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0nWIxmoQm8Q7kNvwEzGuxl&_nc_oc=AdpOOxduMKfE7fyih8-sK4D1wB0tSZop61PaFJKeXbHft8SIr2yKzVj6yJdGkeMO9YA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwknAdoacIXgWC8To_coGkrvITdOqPjI908-k5BOuDx3Q&oe=69D0F0C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
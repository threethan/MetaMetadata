7TXw4B3r-_Ekg3TVJLoEWWmardm_r7GaZLSfajkmFpDHj3YdNX2d1Gow&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsH5viImAoRbpbzV0RbTNReHIrfncmuj5JhiOEYDyh7w&oe=6A8ACF41"}, {"file_name": "tutorial_2_1.png", "id": "1773059633308930", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819417_1773059636642263_1249842756487671690_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYV9bofQ9wQQ7kNvwH9yW4Q&_nc_oc=AdoaMT1UFxxejpsdWfcIoKP2ywjK2kb_3yto57qtUIVoGGt3E8G7l-yEBcHOswSvGfI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm1G5fTt9ZKXxinLhqYdxl4XW_o7u4qPqe3CXvsBHAJQ&oe=6A8AC66A"}, {"file_name": "tutorial_3.png", "id": "671040079255517", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824202_671040082588850_7751685470772367233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBIjUpYp2EgQ7kNvwE0v63H&_nc_oc=AdpELRggowjYXkDTwvvWFMbLg3QEt0ZoOG2LB6uYnO_FHkkA0evTmS9eXFulVY-g7D4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhecRMbbdk_uj5Brtbj8Gl5pfkmxZPU5FmzdsZlmcdoQ&oe=6A8AF12F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "779497757477543", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982602_779497760810876_157322345244620332_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5VoXudrbVkQ7kNvwGcbNBv&_nc_oc=AdoofG0-3qlzxIGfgdtVFPCR2rLBqEnYKOh0Z9w4VPdP_utKjkxudcQMEseln3o5qrQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1V8o5d-RLQp8K3Cq2b3j5R6rIgGuPcs5xL3gERermQA&oe=6A8AE19C"}, "display_name": "First Aid VR", "keywords": [], "long_description": "Welcome to our VR First Aid app, a transformative learning tool. This application is meticulously designed to teach users essential emergency skills, including how to dial 911, use an AED, and perform CPR. Through realistic, immersive virtual reality scenarios, users gain hands-on experience in managing these critical situations with precision and calm. The VR First Aid app guides you through each step, all within a safe, virtual space. Ideal for individuals, educators, and healthcare professionals, this app is your ultimate resource for becoming a proficient first responder in today\u2019s world.", "short_description": "Equip yourself with life-saving skills in VR! Learn to call 911, use an AED, and perform CPR effectively with our immersive first-aid training app."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1B3KNESmF2S8bFCdivo6S0UMBaS68peIqZfzvLoRR6-8/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chaac Technologies", "support_website_url": null, "website_url": "https://chaac.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9200522273384018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822045_745008811328157_6598126243229672152_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjBNuW-o-3sQ7kNvwGuA5z_&_nc_oc=AdpjmC0q_uhaSTkf5wqrX_CYkaEthDX_iwLYQ2JEOwg5Ma41ntsHB0Z0vSwgewQVAag&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4yx6_WhLM0cC4TusvBQvdY0t9-0wQUG5seuW8Q0Iy0w&oe=6A8AD445"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "First Aid VR", "platform": "ANDROID_6DOF", "co
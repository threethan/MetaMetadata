IP4HjF_0gU7ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVlPqZINra_F_mDZe3AZ2mQo_9goQsb0a1LnEs6ejWmw&oe=69B56F2E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgh6lYub8XAQ7kNvwGqNkom&_nc_oc=AdkTWO5bzp44ahTr7cUGQLsH1PvmCtTlaVUIb3cXVXB-kTucKerW7JVJ9bqalZvvmUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2s55ybjIkVI7Idif-rKosbfQe0i4arzbtjA4xf5KBHQ&oe=69B55B85"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jpVnqrmK2cQ7kNvwHrOXnF&_nc_oc=AdnGoJNxq0p4xR-WataObfEWEA7zfmULhiF19aMVM35FqvNWd62GySzdO2aaFeAAq4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyygT1HT3-YTdUz9Bq6ISvvlqy83_uZoA7de7Psj3PjZQ&oe=69B541C1"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rjihpa-8EAIQ7kNvwFJnZnI&_nc_oc=Adk_b_PqA646LcOYo3P35seAdEXS0tF9PpAmKN8n_JKDIz8HA8QcCnBTAms60v4n6zg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQmvKN0GtjU_XZ5E6DczAaLntT8QzeLUchYy1I5n8A_g&oe=69B54B18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dthv0y0QtwAQ7kNvwEq5HHE&_nc_oc=AdkDK0o-uafv3_3hDX_w5XfICCXXQS6BTAF07qeVQgYOnbPlyybixE0Z0rRiKudhnd4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxbHuM0kyAo0WDGaw7cmxJjUP8-YnEpzeCFZwB7KNHHDQ&oe=69B5581B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/littletagvr/home", "category": n
ZB3iYfO9iQQ7kNvwF4sXsQ&_nc_oc=AdpX9dNcPOmVu-zR5DjE2cosxLfgGwACEBbxMylhlzswKGrTpMv-bXB6bk9O8WrPshI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IMfKyRN6f-QwhRae3nnoT8DjaMgeet8dytWCA9pOAAQ&oe=6A3A96AE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rycIBFWKnyAQ7kNvwHnfYXS&_nc_oc=Adq_t6GkLK6syVcCR0GDzraKAz6z7yD2dpyw2KB1bCL5VZjka6fNPGhJu-Em8C127Q4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VMO4_60B1l-0A80tLDXZlFsROWeEhHtp3O8bkyRukvQ&oe=6A3ABB45"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlKxP4p_0uUQ7kNvwEKlxcg&_nc_oc=Adq99hATEhWRKV4tYc8dfk0Wz4sYOJ1lQP_1eg7KkeBk9aC7Qn1rLCCinapmJgXQQQM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n_brCw-o_Se1mqtbXZ-QOInlxdF3Z3X7YyFuKbiJlEQ&oe=6A3AA181"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9k2m2S3SvQQ7kNvwG6ezeK&_nc_oc=AdpOSDeoDdhOsqKWc31-s92fyd3UX5rOzCLlHXGDCs6Rxm-AIR5grwfOCpN1deCp6TI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zM2vmHKImJpreKFjCNDj6lZR-RHKBM39NtOb7y1SiqQ&oe=6A3AAAD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERnpOupZLIUQ7kNvwGo_vjD&_nc_oc=AdqedGgd8y3_cYOL0FTk0uN_-SlVSLhx_j-FEhQWgu-yjN5LPZOVa-fLvYe4pXqSDBw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IOXVoVu-xpGm0Ok3Dw3hivQrUACTGX6p0sO20Nbh23Q&oe=6A3AB7DB"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
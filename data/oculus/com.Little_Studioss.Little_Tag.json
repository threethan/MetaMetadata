ljqYVM2c_oQ7kNvwGAapgP&_nc_oc=AdrMsccV0ukCKrCCbVcX9rifluVmCVf4Y9msgU9JJP7OdEuQQGErxhSn7cE3-ekzRtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfXSlB4gkjpw13gVr9cdUKEXlPrf5BmxDZvCXUeFlDhA&oe=6A98696E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s6uX3oRLSgQ7kNvwGflsC0&_nc_oc=AdoEcLPqmLuTxDD_RmCa0H63oncENLRt1uUFfj9Rthcs0N0PyNzmksYFBmdKk6SaG2s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyo9LSejqwaF2-KYw0rWq5oN6w8T0DBHpRjvybWWA31A&oe=6A9855C5"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMl1zhSK9aMQ7kNvwGyA9TJ&_nc_oc=Adq3czr6yHCFQtJe-6rKDJxYVlLU7Mj-WEw6_nXGUVcfKgLit94lcfcJVi9rpUbX8D0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI-oI-EDn6k-g2z8zPUV9Z0RVSxTpUd2yQ0mAQlaLCHw&oe=6A983C01"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSn2b0PfOXwQ7kNvwHqyB5Y&_nc_oc=Adpf0cbrYXE6CdzX6eP8QVaqFSJqnztShrST5hEDc4heU-CNvG_YxEm6rP0OWTzjxzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3yDtN4TgMym1JvCSN2vpPYR4TnB5bTjqWWrJ1NYLHQQ&oe=6A984558"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFQuJM3UX-UQ7kNvwHpJrvq&_nc_oc=AdrI9ZtZQ57fmBOI1QGoYaLgqHf8C7G0YesEijG14eh6kyigqy8nnr43URo_KpuAygU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2t2dNpyZZCcK-Q0tb7QdHY27eb1YYxHVHduU9S_SncQ&oe=6A98525B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
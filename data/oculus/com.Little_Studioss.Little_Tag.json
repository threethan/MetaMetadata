lhO3_8IGhQQ7kNvwEvPcoN&_nc_oc=Adqci-igHbMcyeEgcL_O_iKSBwrof2o2o5sfp4zk2I_XvZRLbDM7hBZMmRJYIMx_Z4o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0niCjSbJqI6A7QeyZMeuFZJww6VINhVzzPMQmJbKfqvA&oe=69D7B62E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6z8VajaoXYQ7kNvwFybett&_nc_oc=AdoklI3JRsu5rkqhUQCQLEXAG54Pkw0ziJnGPx5AgRjkI_mSgdE1osRcywBtcuI9QZI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11x3o3TuqrvSK3Do6EaQGkvZ9YDdbBiNJHrA8e8NfjBg&oe=69D7A285"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuvHFi2gyiAQ7kNvwHCVSY3&_nc_oc=Ado3JQbYvTDwnh7KLk0LkKvLZcW6wGRgmcHgoUEX5d7pNvhreuEYYGly8qspK22Isvs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ll1bfKuwKBY-JLCKjp0ksuxLFg6s59IQrN5k8B7zPEw&oe=69D788C1"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6m0QlFNkJmQQ7kNvwHCurKS&_nc_oc=AdrBMM1Gqlez1M_kDn3avcwSFy8tRhI1Ko066UpG3R8A2qVSj5R6eFUs2NwwYVvJtSI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uTKYRQMJiS44d82CsZZOLaDnzfXui58Odp5yW8oKZcw&oe=69D79218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY65AQoY2kEQ7kNvwFvlZnW&_nc_oc=AdpOlR1IpTiI77Sq43Ew1eG-q3_Y3LOOg7SzIdA8IOxvzU4t-bLvS6ALYhTsJj6NcWU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rhoOLemU3-CHdGKuXaWFXR3ZRewGN2gjYkgsbYnzOiw&oe=69D79F1B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
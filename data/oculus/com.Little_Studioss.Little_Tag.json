fHz48ZrefwQ7kNvwFkOIOf&_nc_oc=Adql3LOcc1iJNebd9oBAH0lmsnFW02b3CGIqw3zB7vyf19a4GXDZfA1wLOTCGiGAOgs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0niiGGc1dtH41s-57V7oN22ith0_LhC9Qy8AVGYm2EeA&oe=69E636AE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9Ei_a1pyqsQ7kNvwGC-XBU&_nc_oc=AdpxPqN37Y7RqMOE4GI7umjW3ooI200310bhkihhj0JwXDDkzoMDquSAhro1I4VbK44&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17HyXf8p6tUwV5T8RXJvho9-LA-FMukyHUIne8KJMb8Q&oe=69E62305"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVsEgCkm6f0Q7kNvwFWheyr&_nc_oc=AdoZhLD_xwaOKiBCJo-lMev7Xwtl88wOImFaIJv-kuQZcnYI7MSAAcNUIlmjz3ARWxc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lQ39-9DSRQ1hqtVl7MAAtSMzYpQiJeSj5Q6e4q3NFNQ&oe=69E64181"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J5Wm54hihwQ7kNvwE2Dhxz&_nc_oc=AdryDu3stSiVcGO8YJUuY4-UA8LRFPLS1xvvZgjB3e0xK549nEW1qyM2b-yKBLBeaHc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AkrEc7HJhUGzAzQ5Jdip_8qLG-2ZK93Dsfm4Ufdrq2Q&oe=69E64AD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qijsdBaMYWwQ7kNvwF1CPf_&_nc_oc=Adq9nEToOp4d_pZ2XuZYA3KZ-qsT0vrngAjOIsmOHFq93cOyX7uIhqFWTnoYXDy4VqU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ra5lLnlKw2KkIlQUr5cLVpJqAYMJS5qlmhv178VCB7A&oe=69E61F9B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
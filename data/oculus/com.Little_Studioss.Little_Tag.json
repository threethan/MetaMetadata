GJU8XBXqeIQ7kNvwHwXlzu&_nc_oc=AdrpYEpByBvkP_AjyrQHBw9w-_LD00P5qJ9G0tIDNQBreNnDyYOlc9Vo5EhbU2jDwUQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RSAho1ENYJKLHMvDML57Vcfp18L4tGe8PGtUODnwlWQ&oe=6A0C722E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nEBBebi2wYQ7kNvwGRD0ma&_nc_oc=AdoTmSA324s99zaevsnZuYxrsvmCR228xOYkauHUukYsNivR4-c6XUXNbvsHqQyRucY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l9JMuoRvE3um1SkD0g0S_RZ5zpKcEHYq1FneYM5b30A&oe=6A0C5E85"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIAhhfMOd_sQ7kNvwGIkxSH&_nc_oc=AdqsBqWfddl_jdmBNE3ZOzHUBy6jGOcEHyQumJAOvTp3MbS8nGUoYAsjTV7veA_3Gss&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fYqVob_eFLjqkBXrp68ywKHCNNtg_IAOgnt4sUBlMQA&oe=6A0C7D01"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_ifTzOupwMQ7kNvwEtLegc&_nc_oc=Adrhoq1uOu5mClupPJBRr-qBha7tehhedmDyw5tndv1cXzltwt11kAx6aU5_dSymsAs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5W6wb-tbHuWQ77qbzmrQcq2ym5VdeiCdWqccXUczv1Iw&oe=6A0C8658"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-dXx_hlM5QQ7kNvwFIvm8Z&_nc_oc=AdpLN1JZpuIvuR4nYAF-OTAn_06nxQUPfucVMFE7sFU04RUvIzl698EDgrOqPphgITU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u9cyiOv1LA-Aok1dKJ5rt3HZWAZ_VHCJYTZggq05Y8g&oe=6A0C5B1B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
sVNFZfd7T4Q7kNvwHbaicL&_nc_oc=AdrlLeP8USZdSJhd-WMXepr7zT8D8Sqn7rlm3uT3h5KxGEimzYAV7NLxHN6lBzl4pF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R4UBliWC3KNUReo1-ApgnEgSapBOybHkzVEJFCU-PSA&oe=6A2821AE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6_s8hB0g4kQ7kNvwF-dJKm&_nc_oc=AdqHrjtW6zk6lgJn91eURi5zDfcqxl7Wm6_DEM5IN2SFIR4rPfQTcJEAh_w-fF45cgw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bsUw3N29zHA11vcDLIn-HLvFAa0bPuVEiIA8Dk3CBrg&oe=6A280E05"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmJpUpTru1oQ7kNvwF77YIy&_nc_oc=AdoqeLAVJ_wv9tDCn4bex3wXgKtn7rVUOoi8VD8ap4tqALjR20U9RWL8JJ_obFOa74M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HndqjxBABsMax01Bu0oTWU0BjKtD0ynD-3vohI0c_Lg&oe=6A282C81"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofAmVVuvsKYQ7kNvwHvs2cw&_nc_oc=AdrDranZW_ltNVQzr5BU9wosCJHe1bT4AthS0JLPvr-kNgwxraUN2O8yqM9-QSPzJkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A5ciDbSe8nVBXaLw24PFbsPWYxfI3bIbjyAbZ9Fauog&oe=6A2835D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_7VBp08YAMQ7kNvwGwGrlZ&_nc_oc=Adqp_IFg6G7-yGAw_J6fCrZn4zLmUQn0_orAeC0kMPB4hPJ8x7h3rPeo7TVvhsvqZrE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gj9yOcmpE2K8oYax-LjMUFZG9Ro8lts1KQHg9m9-4Mg&oe=6A280A9B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
NB6rxvqzq8Q7kNvwG3bO1M&_nc_oc=AdqtQ3VjzMwDhklqvAVYwMnvLcCWAtfvz5nqhSdJv9GcDQ872bc0Xm5UZUofKmahgfk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SRwi0jHXtw7e6nbwb7VM9QfYLba5_YWteS3nyoziA_g&oe=6A218A2E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaM9Y4km9SUQ7kNvwHsMcLP&_nc_oc=AdpQkadEbrzwmZmSnH51iRlvff7cRI6-qhopFpXHzBTFmvPLGWmG3hmNTnr_8nygVE8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W1i0UzPJ1NE7LTuhFxXcv6d4VFhdll5it6ek-_kWGmg&oe=6A217685"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJQCYrNLYUIQ7kNvwED6T4Y&_nc_oc=Adqm6ugUYGdEiv-XgFGwNhydPpmE690OQ59UDdKZTUQ4XpK4LhMRwU3SXZ1eK510ojM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GXuGwz7oILR14VWLmHMteN2gVf1N1sTWPqjrQX4Y4mA&oe=6A219501"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KelcK6l5PaUQ7kNvwEllltN&_nc_oc=Adqcz8GfnXtdAjKoDvVXIsKncrtfJVfv9n6XhEPknbmtzUXyx6z7l-k9Kado6lrZM_8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-7MhJoSKtcUb9MeZG1o-GR2yAF3aC_UYktjn-NYMi6w&oe=6A219E58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DJ6y25XW_CkQ7kNvwFvHQ0k&_nc_oc=Adpy8DsoQ474R-1Tq8k0nRvOXeXBz8frMa_ukLEOoU2DRDpbLD5R4QOrpEFKqUkRRCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Hk8ErHHfmc4GVvKZUkCpdHvtC1LDsWDRly8t5FDYXxQ&oe=6A21731B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
kH4YJLQjU4Q7kNvwGOM7TC&_nc_oc=AdqLFxL5W9bW7YzPo7B16Bj-aySFiSD4EkGIcQ0q7NEnrAKpRM0ahVmtDKtutF-AGls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x4elQtpLQphWBt5mcPrhVHJhKealTYM_8FLW7OtmdKA&oe=6A4522AE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CAqB2hLBmQQ7kNvwGHsr97&_nc_oc=AdonNPDI3puUx2m3eyVU-ifeXmG9MicygtysFMl3lLUn0SDl6xSbFaCJ3HfvnN4biTI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WlQIulWI-JsINf0FP8pPw3529BYzXmWHFGIP2oaaeHQ&oe=6A450F05"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t29Mzg4IfjwQ7kNvwFZmxtg&_nc_oc=AdoUUGHPXtklxjQAA91upFYYa80C3vIoD40_0mD1IU_zvtwYdKeq9JZz38QNbBgsa1Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MVfGnIX9LnH5H-AFm7AkEPAl2niWB_w32E-DCkMFD3g&oe=6A452D81"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMnvB3pNhD4Q7kNvwEs9a5-&_nc_oc=AdrHt8IJTzvt4K7LU1a_7NzMLxZKfcnpquuBahi2V32305X6r8RxOsh4AvvS2JTnOJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qyjstd-IXzRf5R46mjPIDAwfKFu_w6_mzqn22IzaE6A&oe=6A4536D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ghqxr1DjlQgQ7kNvwHXoySL&_nc_oc=AdoSvJdFflMmgmG2L6wH3uPJR8sdQzlyQkiwcNal-qcVA1yW6PfcmXLibYm0t6mzyp0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SX9CXUqEZ2Tq5-PzSKFtRF3mT-lmK3NffTmmcnUnPWw&oe=6A450B9B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
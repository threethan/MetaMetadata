rbAlYSVtAoQ7kNvwGY-jmw&_nc_oc=AdrU-04UywSpCbqEmU5oqsO_qGP3pcGcZqArqlFeEOmx6th7tTtLKn29cpcw18cy_0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J2q21NOsa0ECAF3z3cPMbaUsvzykLhAIIs734F7puXQ&oe=69D3C1AE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_uoXNu86uQQ7kNvwGZ1Tc9&_nc_oc=Ado59OTM1yqtxmVM1O7tT_2fJUHS65svwkmhutwecFBRA1vng_IvIJ9DjJ8Af5N_O4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gtKcrbmsGXBdyRWt2B3lDS8ptPidjd5Igo83m4v21tQ&oe=69D3AE05"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUpMKC8ors4Q7kNvwFQKP7n&_nc_oc=AdoUk022VbTFfjMaevLzH3jDHwa_PhqAmXtjwOuoP4-lVKI1gnc_F_VWZmxmkVcgL2g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1svBXr6VqwtyQOMF4i-hb-OaQXOSAOlJC9jc-wJBd97A&oe=69D39441"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ls9wd9w4OgQ7kNvwGgOSbP&_nc_oc=AdrosWkbeYO5O5yL-2BzmJdf2PEWxoF7ceBwsrR35JFqNtFVyrZccbtDXe80Md9gupE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KyosZ5oSR8O66QjY47hxIz0JOx951p8DncWgqihEHOg&oe=69D39D98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wg2YqO7EhQQ7kNvwETHSek&_nc_oc=AdrlppqXM9NMAKdu-gjUHA4lOVC2QxbHybN5e3IrNBrHJVz_XE7e3T2jC7Z55HvopPU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DLez69dEdENsWs65u9vUJzD05RT4wU7YYZ5WfgaYpbw&oe=69D3AA9B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
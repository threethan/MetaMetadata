lnrFEIogRIQ7kNvwHy_2XK&_nc_oc=AdoOESWfJxCUr65aLz2sAG9_5Fw5Km-MDBTFAtTqVBQ6Ok-0wz9n4dmU6B8ugwOjlIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFod89bn4t9IJXfD75mpk442uxqhePuW5VjyNg-wPVuhA&oe=6A7B302E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7ZeohQ5LegQ7kNvwETL0CK&_nc_oc=Adr1jN31dyyke7k0f_BsTivKpyBukmTninszW4VWixlOEkTElWvGUK9fl4D6do80ZLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1SpSRtssoSjULl91JNbxr3bIzW3Mcp14Il9n247781w&oe=6A7B1C85"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxOTh2KTHUwQ7kNvwG86hzv&_nc_oc=Adqp4NPXn0n49unwRMwNDSvOtymuhXbwvsCog9VyoYvrkMnb6I0jQVHGvVW-c9pvj74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoeD-EdFDBuZIyIIFkWhSbcrxPYNWBy_a79in8JVC_-g&oe=6A7B02C1"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm6viEcfmf0Q7kNvwHRcBY1&_nc_oc=Adq8XZ5MwcSJsy6jq8mvnGSbSD8JnfJ_2apu6eCxxugAnaLPoqz60xlARLjBQ09DjVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESEeVS4igWCd2dsVi8Lc3FvpOobECL4e9hGihMJndy4Q&oe=6A7B0C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4MyzdUh-UIQ7kNvwEhdhir&_nc_oc=AdpSpoZnTuyDUrrFfp7FKNmelY9rRAyyVJcw_JEj72dck0FLE5jnnr6hS7xm5wrG4G0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdquROHU74AA7-lZF2v6kG_3DjrVU01yRFmjw43YnDmg&oe=6A7B191B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
ptWcFGNrtoQ7kNvwGNO1nS&_nc_oc=AdoTEgI9_iy566qgWp4RwYXC_mNVBcc6Cu6CBka5xl0l7uQ7GnRdFZRiyx3Au_wLqxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO0Dt-c2GhBahvPkka7d3my34dApICMLHSrRvUhpCSyA&oe=6ABA782E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ziaGKLINE30Q7kNvwEVXk3O&_nc_oc=Adpwmb3b6vUwZ5r1ZvkbHzobLJXl3tmM0qgE7c9NNy_j8ptWRzbEd-I3HjWN1jJqVyo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHF-OCjDidBAWYpBcNJS1eGkcrxlFrUCHeaPvlrE0agA&oe=6ABA6485"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RljaajcfX5IQ7kNvwFQWcEz&_nc_oc=Ado_G8eh5wSxLyLfO7hL5cJiy8hjIcw_XkRSsaoztgMsem2JWzMX15zm68PrcGukbZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgJHFnQWVnEZpzFo9XwHseyGupffMQVveipL2hApliAg&oe=6ABA8301"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE6Zdr4FA0oQ7kNvwGUXARh&_nc_oc=Adq3cKsDNLcVVUFXGYX2_ekW2MNyULAED2wYNPTbxW2E4zmsVqGpAdiKBmMxoo7eTCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJdN_v1PCICtf2w7AsJ9WkfZv8Cy2GY_eVbeA-PbM3ZA&oe=6ABA8C58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFiyf1dZo4cQ7kNvwHKDP2O&_nc_oc=AdqUvlfBoz8uOY0aTwBkn_RY5u5LFUvkpPwEnxEu8_tZGiwBmOiNRuvHOo_ulaPcH-s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvgNHw1j-47K_H-WZKeXArvQUDcfNGweNGXKC9GmV7Cw&oe=6ABA611B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
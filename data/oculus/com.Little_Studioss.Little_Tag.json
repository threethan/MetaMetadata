2XYZL6JXw0Q7kNvwHcyWVJ&_nc_oc=AdrdQSX-tXUhxVbGqi5sOcvbLtk5bBN6pC7gIUnuH_Sh7hxoC1JMWXJB8L73uGCBU5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCgsOkgDZe12CuCDENblYgUjNSva87UPINc0TGdaEfZg&oe=6ACB9BAE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kKfQLULCTwQ7kNvwGRTyUl&_nc_oc=AdpvrbwDNH0AGFxQtbJjNzkLX316D2I2ZxSxIQDDCORfgkROAEn3AFOFbHSXu5koVC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNP75SBcRflt2EtCt41HxPeC6mJL5jmiUDOAXxpI7x88A&oe=6ACBC045"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5IsI3f3tnsQ7kNvwFjxRas&_nc_oc=AdrJngu4t5olx-e-jWY9-tJT40KpuS5Fbr2Clwk_LaWyvnKFgCX-Cjky2wfM37EGP9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8fg88v1V8xehySmg7WRzQ1-0FARmuIAnsHj-dv-WzLA&oe=6ACBA681"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsdUi_ek-yMQ7kNvwH5Tvds&_nc_oc=AdrXudTjktgUEtWqNkI8PPNonTkRtaLRv2rDVhrnUSq0KEwpZ3ViN1DXpY6xAStPakY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoxIQYJD6t_WazViFVACz09-a0UIde9Ct5XRK1ARGF9A&oe=6ACBAFD8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ngq59sGV4OQQ7kNvwF55Cdk&_nc_oc=AdoNwxHuyGIZlYNOjJPMfmnjQYmLoo-MV_9plTBOELPGNPq1iZbmG1gwrSGjKycRPpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhQYO_dZNgmOPC9M9mlJ2Td_Y1xJlDqdYAl7QXkrSoDg&oe=6ACBBCDB"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
ljqYVM2c_oQ7kNvwFudODz&_nc_oc=AdpykxnFCPmbWZfE6skS2PtV0kBbn5D8Ajp-gVwWKV7Uxct9FczYqUg_RHruV72785s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFX5P_8j4gNzr8dfr179dcDc1MEmNue6z7or9iQ5DfaA&oe=6A95C66E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s6uX3oRLSgQ7kNvwGyosPp&_nc_oc=AdotURgFpDqr0OId0wystbJMyuUojo61SfVCT1fcGo2pgEQ8N-xXP0ZVEWGf9i-rK9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGoHW2dXO_GCYPgQemhQerHamK5Y3jBjkZCEDKcm_eMA&oe=6A95B2C5"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gMo2WPDQQ4Q7kNvwFxR5MC&_nc_oc=AdrLuTS51hFb2BddP9Nf4DQFFb3VbgpGrPaP6PzsA77l6Co5K2PBtBZubmlx-hI37IQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUEuogdQP250RwDaW1Iddd8pvLj6f2gsPGlmxtYTXp9g&oe=6A95D141"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt-CF3a28egQ7kNvwHF514s&_nc_oc=Adq4eJEUaHvJ0POp4FKv3uM8RyPP-U-3hDlKzQ3GQUQjlwc0ED0drpscGWCkXBenchs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECr0iSekPDnv3leDwf9ZkT84MqSOvYiONlvVcKYP8uFg&oe=6A95DA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFQuJM3UX-UQ7kNvwFWxnEd&_nc_oc=AdpFSMohDVTjZsNl3mdvxQ8fSf-bELGBxApUPvStmZHQC_7TtMFoUQC11i_O9kad9fQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsm5oz3w2a5gL6V2jzVG0iMWupB2h1DXqV9hF00wUNNA&oe=6A95AF5B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
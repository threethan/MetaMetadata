dfuA9DMC_sQ7kNvwFZ8ty2&_nc_oc=AdpL_RPZ3AXKd1zZW6EsLYuKrbWVlJ-_idq-uTyen3l7YWaGkEL4LefR_fzwEaLNI28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBL6WeOlfUoLTVGe-yirq5wj8XRv3tPYmj_6PlXVBI8A&oe=69CA872E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr95kc-IJdoQ7kNvwGirjKQ&_nc_oc=AdoBQjD7Bu7Z9QYFkYb7rBMvbN-xajBLvbOk6Y8YI0kzj678ETsrZ8pUB57UlHiMYt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZSZfO_ll4rp_LA5mDFt_N6UOPtpasjjjuSh11XzNviw&oe=69CA7385"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APpoZ-KTeqIQ7kNvwGDUO52&_nc_oc=Ado-voBiRN3k1aKgiLSy-lqOxRe1DSnUqBcL6oq--_zA2LdEIJWNMpVS_Tsyd71Wxb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmPAixrMoG9x9_YcdkSOoy2H3aEgSuuVByrulEe0gV-w&oe=69CA59C1"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU8uPx5rNaoQ7kNvwFCK25Z&_nc_oc=Adqs-7kYVWc2M800vfJXs-3UqSVaBrrNAifKdUUta52Usarjy4sKDzcG9dxnmgakOI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1LThdmSOYIIhPcv3ziR53QjydtzPjE_Ct6-9o0H7OsQ&oe=69CA6318"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZfM0LH-50oQ7kNvwH8xkdG&_nc_oc=Ado2zVCgOJlizVxq3uC552wqR674NcIrK08S4EHfLgw83N5Mw4-e1xcXtt8_ksYGez0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHQ2aZY7FZC6JR1j2MVsKrieuWJaRl-wHNTPzjEMIluA&oe=69CA701B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
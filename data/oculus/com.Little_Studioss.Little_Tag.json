GIAx3F3_0EQ7kNvwGThPu_&_nc_oc=AdrTObA_imy15nKZkAWM18bnDT_yJmQk1PwQ4AKwUgVA_AG0bW_FwjbZtW50tOd9YH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vB-QHyNxyVWajog3qLy1_B9LoH5cwcQh4eEaOUEs2zg&oe=6A37F3AE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cz7lEjofZAQ7kNvwGldrAb&_nc_oc=AdqZa7fKuQ-D45pAca-Vtq8UczZ72SJ2i7RlwxXHX_8-A02-JbLCVcds0g38pDD5wTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wqW7oAAAkXEx3AMUiXisjqT9ny718K0VTcrJA1XKuNg&oe=6A37E005"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlKxP4p_0uUQ7kNvwFwP3It&_nc_oc=AdpuDDt2SQTyomi4r_G9U47v-Zglis5Dcas8A1ti_EG5DS1F9ddn_6X-4UFKORXDwSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u7Kz8UaCiDpXKYAhtCefe4qacDCuTN_PiW2HiXYVTdQ&oe=6A37FE81"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9k2m2S3SvQQ7kNvwH-U5WT&_nc_oc=AdqwyX3jjPWyySelKVrh1tW5i7w9M5UAORk7RexFO6bOKoaYgEy50PyEc4iSOnfxgdk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xRLpPnCx_ak5SqlsL5Ne-UIonQ05KE8f_6PQRxDZQ3g&oe=6A3807D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ECh6bnMQ8QQ7kNvwG4PJzs&_nc_oc=Adr-8bc-xbPAtk6I07fMxWZ-FOmmsx9zzEBkk_5aMO_QSWQTMcqhQ5wQXURDTND8bLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k11OvCs8BjXgY4bET29ZPoznsDE9EgOcst7r5Ga_JQA&oe=6A3814DB"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
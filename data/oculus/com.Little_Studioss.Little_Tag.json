dfuA9DMC_sQ7kNvwFOek7j&_nc_oc=AdqnhTVZfUP_G8_RmWr7WIhCTeBxxFzjjS1qJHkavFBs62WywnML0UaP3v1t_iwJo-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEZCMRcw-PU86cTe5H9b1iIuznxda6oxBhuo9IQ5Jl7A&oe=69C935AE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr95kc-IJdoQ7kNvwEpRu84&_nc_oc=AdqOod0LF6j3s4ItsdFlAkpUNjtwgbqqcfD8zylluWRCXD8DbYiHai0bdd9WIxUluKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2nbfOHvM-oLLMo26Sv3vQs7hSzRdhDMHdBlU2xe4lNg&oe=69C92205"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APpoZ-KTeqIQ7kNvwG9BYdG&_nc_oc=AdoVAxe_oZ_ioiExEncVW_EfxSxKn5jUoree-35EUyxknZ_4yBa02RJlfO6_ccDVfLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAci6pME17zQGUW74U3jqL95SdZj48lOddDBXQETsdLw&oe=69C90841"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU8uPx5rNaoQ7kNvwFTXLjU&_nc_oc=AdrXgRK8i6r0dq9otI5yb2_hlGDHENWMcRrHWAE6I4RYsrZFpUvBke1e-8c_yurcMzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXeuxJYeOKYGgJcWyOIBI0eG7wc050rS0NXeM7NrHsLw&oe=69C91198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZfM0LH-50oQ7kNvwEtrxIU&_nc_oc=AdohgK1WbYNMz8Kd7doWkReFqjI9ECUmPxTuqcnsZxSDvNFhvFEq-ntjog3l2GVAev0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzo23YIq9XK3ZL0DWuM0Nz2phYudh2c1kyfNygrNvWqXQ&oe=69C91E9B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
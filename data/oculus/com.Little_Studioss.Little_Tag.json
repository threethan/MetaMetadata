jZzPfUcumkQ7kNvwEyQhQR&_nc_oc=AdodrVNd0qoI6PRbtv_ZqARZ4pzxSwF_7tUpctaRA-7yIeWR5Y6PaHiPSWh4esK7t08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgihaxDtATSyFxDaNjwaLDD_XXP0hFEMYgnS0vDInhMg&oe=6A63752E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDV2NwBzxp8Q7kNvwFjss-_&_nc_oc=Adps0wugDpkua-D_3f0Pf2smFUzp0kdiHyQ5WZqDcwcq9VT5YxwSY7UMLI2KMXmnZWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsCX27qlXgHP9TNmCLMyKWz-AycDF92hGyCYtIbfAZnQ&oe=6A636185"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwvdAUZPVRYQ7kNvwEH2bG5&_nc_oc=Adr1EtjACkXeeW5tmXSIdmcTceJ9GYyQt600_bIYYduTM0bZc9riDmt_krYplNA0pOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmKi8zsV_KcpbxBNsWGCDCQrYYasw2AjNlOt9Wve9Q4Q&oe=6A638001"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inJm-AmnM6YQ7kNvwHCqYl-&_nc_oc=Ado1BO_rVgbuqbZ7k8PHwBbeXwZPK3ztHkjWz5odpkDmrGBNM59blt9sZ-mZK3NVUbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiueMvO-PjCi3EWiGwDgYbF6yXpVRplBA1_OICnTkVPA&oe=6A635118"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XjXZHkgoY4Q7kNvwEfSeG_&_nc_oc=Adps6V21B0BonIzskc93ihE6VtWPAeKzDqdYpsZdtYqmGq4GB2JA4hEAhMrrKwJ76Vo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNp7ahfrU87r5AyS65CdvcN1m2ZxeO_Yy86rMFWejmrQ&oe=6A635E1B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
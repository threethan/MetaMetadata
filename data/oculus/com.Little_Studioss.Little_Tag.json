ZB3iYfO9iQQ7kNvwG02ehP&_nc_oc=Adoe6D-gEXCr6Qbu7objRX5idzq0_NRNFw74Ps7SbI9FuKpowtUEEosiE56m5j3CW3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rtoPmj3qqJwQSYoPXAp5pkZfJ3NFj_OkWy5xh5ARF9w&oe=6A3BE82E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rycIBFWKnyAQ7kNvwEPZcnF&_nc_oc=AdpPPpyI9aGRsSLfTs-pscjlYNVUPaCQmC1vYamfFEt3Jj5e8-s41E779m-YzEMVntk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92-4bBgBt6QOheSleUmhMsBrW-0PhWRhQSNC0hNLL_LA&oe=6A3BD485"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXr_1jxM2PQQ7kNvwGg3qMk&_nc_oc=Adr7rbSZa3Z_gKmG5fePo9uT4YoFfpUVCXlQSqsZuT0DqaS5r3g3U6F4ylGNMYTGOS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TeBKDMRWJnzMzyE9KpKRrPL2Cz3Mplq9wXAKMW4U2cA&oe=6A3BF301"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAN3rO8ZYqYQ7kNvwFqbS0E&_nc_oc=AdrKtnwB_AxFM9MVO9rgEhWqpG3TAvhae1heVKM5-krf3DoLegu3RAqDmiRwZtEI7JM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gK4oI41aa216c844SYFBx2D0QD29Kt8JMm4cppUzyvQ&oe=6A3BFC58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERnpOupZLIUQ7kNvwHCofQe&_nc_oc=AdogKXbqufc_DHbK0W3ZyBhGldH8mRgoHkgd-65qT-vZYOkNkTmG1SjiwcqVIvDFTeM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89FEtH1UnxY3SyHPiJwd6MRdqnnyYxeTzY-D-Gkp5dvw&oe=6A3BD11B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
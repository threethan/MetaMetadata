s://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWGvc9KaDAkQ7kNvwHv-Mn-&_nc_oc=AdkKq9NhgklOTNeidnEow3ObkbDMwrUBbsfx_QBHzqdiGrek9oVv3ynFTFYcfcxluVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuwth9biCvJoEwXzPsIuoWQtezix8cMDBZ0UFSi3qBZqw&oe=699EF205"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB1LhqYKMJwQ7kNvwHpIAGx&_nc_oc=AdkY1QJ0IIXJdJAWeOhN0x0IPZKcqh4rSRkv3J111BU-ItV74ByOJA_5N60WstAJpGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsh0e2-QnnvFh926bn3cOxa67sfpaKp9leEJTzMHGxsyw&oe=699ED841"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tes_35oyq3sQ7kNvwG71bAb&_nc_oc=AdnuafSrbuOUD5BwuZWxGbtU2q7VSF3UpPtKHStnvICwDKc_nV7gUU43C9Bp1YJ1Z4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftIaGYoXal-t4jr3sFHTBEnd9hDGyZzxbRYbORWXJLDoA&oe=699EE198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6FR1O-dyDgQ7kNvwHT485j&_nc_oc=AdmrjuMcs2-kjkp_n52Qxjs6tj2SCwH91POg5cyU2VGlXl-JoRUFWALkL6tNGtEnGYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftbpDUvfqgBDaLSfV0xZMlxvj6Dbvjw-vdguSQKTeYICg&oe=699EEE9B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/littletagvr/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NO
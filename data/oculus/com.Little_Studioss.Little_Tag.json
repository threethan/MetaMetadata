-aFwUZfbq0Q7kNvwG0enpI&_nc_oc=AdqK97T1xcVeIGj08fivaqYBV3Z6GUYMzLVkM1fbwynBrs2maE8VgjbEyBtlXzZqgS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO56sNGpqeUB-96SP_Br0g_XTWlB9P5akqTzILE2QFpwg&oe=6AE4A82E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFstu7rkF08Q7kNvwHrUbpp&_nc_oc=Adr-9f4QCsWDO6GIkHorr2XeooL6df1tAXW2KbgC1Ll4swIAiU4qj34SiiGRT8-YBZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0uDRxMZveFg8fLDRuVzvF6N0z6PoSjfcLAJW4axfcCQ&oe=6AE49485"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkZpKh05DT8Q7kNvwGWCrH_&_nc_oc=AdrRTDXCZmWcb6nct8Uq9SKjm1GyGSy-suClsi62zKTsGri0dH_bnmaUz50wym3c138&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOc7FO_KscsxxI6xtaAgRCqGoYHQoi_M2vN13S-qep7eA&oe=6AE4B301"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DKF_KlDtVIQ7kNvwE91gzR&_nc_oc=Adp94lanfuLAbo3Z1O2Ql4i28Cfs2NMnuAeFuKkNtldh3hXAMh2MRqhNU_hbeWDWZHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOhEkh0FEEhQUqDY70DQ6XcOqj-qolqmznbgvE5qxwhg&oe=6AE4BC58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWjCpfbmwyEQ7kNvwHCLysx&_nc_oc=AdpSo2pokgL5BDIAiw-2FgVb9ZIEarRr5wFC8ghNr_KAAYnGp4DjpFEQmvIT1O1KtZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM05cAVhIFPItOc8zqhTkJ-lgZPyZhfhct0d5pW31jT7Q&oe=6AE4911B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
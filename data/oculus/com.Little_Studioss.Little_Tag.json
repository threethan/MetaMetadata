dh4JjfL13gQ7kNvwHyE02S&_nc_oc=AdrfqC7A-jYcGIwUvTX2gmtQVzBsbksBY5T8m6gTXQP6c5KCsRnYgdDX4K1SEYPNSTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV6Yz0B_1nVCj4TzVJxUAgMrpoyWWWkAHybBAQg0lwjA&oe=6AAAA62E"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3L2XYv-gPHMQ7kNvwErZf8D&_nc_oc=AdrHBD2U-Hnv9QPp5FhmIkCDluAZtMp3MIrBngR3TEtTOL5zfmFMb8kI9DRFfHkvQ1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVYf7tbTdbtz7Jx-8VEV8Bup-4i0caHbVrxvW110PqZQ&oe=6AAA9285"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueV9GnTDZqEQ7kNvwFQcavG&_nc_oc=AdoqNV4Y3kmqr3yIjJn0lCb6bOTTLXBt0lgXrIXQGykYP0ghB67N5zK9qQgSyzSFTBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFqdc1TtJ5G_lN0NxyDnP4P17H94NdIVy_WEEnz6t5rA&oe=6AAAB101"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OxGVn9oDj4Q7kNvwEg_GGr&_nc_oc=Adp-d1j1hhVaON4skb-pKdeHy_OhSzbc8FSd0PkkUZIEUNygsBaiydkOXzj4UU_7Lao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM29XkzZ1PmoIaPK-lENbTBlj4WhoqAii9Fnfh9_JUkg&oe=6AAABA58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTvNNkunt8MQ7kNvwGikx-r&_nc_oc=AdpAvaseCTmkRjCEdskSSV0wx9zGVnqTf8YzC5bsYoSfBZybXxVlWHfGu56eGagUOik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVIDwgte1EM0v9ZVPdSLRVxODLhVaG5KK-GrQe7VBinA&oe=6AAA8F1B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
5bzqEYAki0Q7kNvwF8uq2V&_nc_oc=AdqpqJUPK_btZSjJU6JKdQLL2kcgJHLzj6Mrn-fYny-tr4-eWML3LUAkA7xp_ANnMfM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhM6w9-CFTIK-nYAlHpxBgl8Ah_thJoLUbiaAWEhA5UA&oe=6A79DEAE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7ZeohQ5LegQ7kNvwHRzFy_&_nc_oc=Ado2jxRBlNhMcsH4ajKMDi0xAUGyMyR1345B-roZiKu2SDSWD-XLzdVwk3sxMQxNq-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUtqycGT4uqoSjYo1nE42Hz5RHNAuYK2lRWGUlF_76QA&oe=6A79CB05"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4WsGhMUMw0Q7kNvwEy2MRv&_nc_oc=AdoU7Mm4fDQZ7odwFBtZFz948xkQ6Ob5s41Wd2RnzCTgve4oCQmMXwZzW92sbPjhl2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX4qve5uHbW0QTr6if38_ELRtxeizGryXxy19gKI18zA&oe=6A79E981"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqYQLjsvS-UQ7kNvwEL9zf7&_nc_oc=AdrctungsrTDdf3ne3DxIamJ3_od83-FsYhGm_Ii8sSqZrvnzTInt0vkLv0U7r9o1mw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH00UMwsOEIVKqhGRmMph_7C_SLuM4i65ldQtIpfL5uQw&oe=6A79BA98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4MyzdUh-UIQ7kNvwH3lb96&_nc_oc=AdoUycI-P-iQlN2mTN2P2whtMEPOZUo3AgYNnbPG3eb0_xuKb9EfRx-SzLSn62jr_OA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTa9EPeWyZcceijZBP7hFZEM3BpIced-w3HAaFNC5n8Q&oe=6A79C79B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
g1BG9RLsI8Q7kNvwF6C225&_nc_oc=Adq4jPGIKN9q56B6tIVvD7xgLLvugBPZEY61P29H2Zl6DxOuL_7gEsMqbNd9IdZ3Bog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yuF_G2SAHhVj-WY5S73YFZrESSPq57Ped5pFqfE3Z4w&oe=69D907AE"}, {"file_name": "e.png", "id": "1176367396967866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_1176367416967864_6498282404026519499_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6z8VajaoXYQ7kNvwE6_t0Q&_nc_oc=AdpbT2h2eGgNX4ylcdai6ku5OY4C_vJvdSyNwXo3p7L0patsW4tO9JArguGq69jdpRk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TpO8PIx3GaFYh5wy7AcC6-53C8moee3orFIa3uKNKxQ&oe=69D8F405"}, {"file_name": "e.png", "id": "987591143138336", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974757_987591146471669_5909785087520772796_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQTj_CeA3vsQ7kNvwEy7Xaj&_nc_oc=AdrUpshb6-MQIYOWRYLry4Phcu3eg1dX133h2ztqyx4BrChgnCvkJ0uUCa_qo9dwM5I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N4icVBaWrgRYlyINSwfyg9gjKH7CYN4JP737HqVqjjg&oe=69D8DA41"}, {"file_name": "e.png", "id": "455430310805737", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982557_455430317472403_7018293787988506357_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aafMszR9wNEQ7kNvwGxw4Uu&_nc_oc=Adoqb_aQt7cgAgJH7YZn8UVELHQfUqO1l1nrLjauCHxqb9kthVyVFTG_N-juaI75Blw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HmVndUV8PT4zCRyIuCSPLHLDPsQZkzKsZ_0sndU93Fw&oe=69D8E398"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "e.png", "id": "2474202839635484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566690_2474202842968817_8266260323957973746_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY65AQoY2kEQ7kNvwHn_yy8&_nc_oc=AdoYDHpmqWGa0JWlCR4GZoav-V1EnEPOrwPurll3cOPV7r1rXqDanfB3Fji8xtdTJnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dk-4VP6AZN36JXuWoh5fG64k-450TLYpaWUTtYLwJvg&oe=69D8F09B"}, "display_name": "Little_Tag", "keywords": [], "long_description": "\nDive into the heart-pounding excitement of *Little Tag*, the ultimate virtual reality experience that revolutionizes how you move in a game! In this fast-paced, immersive adventure, your arms are your ticket to speed and agility. Swing them to dash across expansive playgrounds, leap over obstacles, and outmaneuver opponents in an electrifying game of tag like no other.\n\n*Little Tag* isn't just about tagging and running; it's about mastering the art of movement. Feel the rush as you propel yourself forward, navigating through intricate environments designed to test your reflexes and strategy. Each arena is a vibrant, dynamic world filled with hidden shortcuts, thrilling jumps, and countless opportunities for epic tag moments.\n\nPlay solo to sharpen your skills or join friends in exhilarating multiplayer modes where every match is a test of wits and agility. With stunning graphics and responsive controls, *Little Tag* offers an unparalleled VR experience that keeps you on your toes, literally.\n\nPerfect for players of all ages, *Little Tag* combines the joy of classic playground games with cutting-edge VR technology. Get ready for a workout that doesn't feel like one, as you immerse yourself in a game that's as entertaining as it is physically engaging. \n\nAre you fast enough to be the ultimate tag champion? There's only one way to find out. Step into the world of *Little Tag* and let the games begin!", "short_description": "Step into the exhilarating world of Little Tag, the VR game that redefines movement! Swing your arms to dash, leap, and evade in this high-energy, immersive playground. Whether you're chasing friends or escaping foes, Little Tag promises endless fun and a full-body workout. Ready to tag in?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/littletagvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little_VR", "su
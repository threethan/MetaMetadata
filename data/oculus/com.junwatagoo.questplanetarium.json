noqohsm1aBCd8BnUqg4PBmvSx_y7RamSE4lVLdQmxU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFCnIC3pdaCX6NYrtvB82NiPhGKDagIdjFQtuF-V95PQ&oe=6A50E4DE"}, {"file_name": "\u30e1\u30b7\u30a8\u5929\u4f53_2560x1440_\u7cbe\u7d30.png", "id": "928449043540559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620497_928449046873892_5039419999345752228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riDVLEKmY40Q7kNvwHzPu4F&_nc_oc=AdqRBsWdmyQYHAXznP4VBoOUKrc2ylfIcN85YWGQd8kyNQL20zjyp5k-gFKrjfZQ5MA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm-oKuoQflF0PGOkpF3UYV049Rcwa7gFzckdDJe7mozw&oe=6A50FED4"}, {"file_name": "All_Messier_Image.png", "id": "1384252640199962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619672_1384252643533295_9106431120821389911_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FPufU-SZ3kQ7kNvwHu8q0h&_nc_oc=AdqzmfHQgmnI-md4IyG_1TXswbCgHJNV3GlAFF3KIv2vVSio1MYAP4mTHCRPnOK1HuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2le1FTJdk4Q0KhO_Q1eyDjzNF6XWQJynco81zwg4PZA&oe=6A511693"}, {"file_name": "\u65b9\u4f4d\u9ad8\u5ea6\u8868\u793a_NGC\u5929\u4f53\u540d\u8868\u793a_2560x1440_\u7cbe\u7d30.png", "id": "1025334883254279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619681_1025334886587612_6154543376722504040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoqsrJAMzw0Q7kNvwFV40FA&_nc_oc=AdqUY2PikrttU9XuuTa6Uze_pjKXsmmRZHamPxH9gNI6h_ldMZfjk--jsF6KLNNBssA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLPu94Fi0jeViSlUFL5wRcHpZL9hCX2FV5hmdfA61_gg&oe=6A50FA17"}, {"file_name": "Imege_select_dialog_EN.png", "id": "1678630010019708", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619113_1678630013353041_8553940172815155487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPt0p0HU17sQ7kNvwFFyX5Y&_nc_oc=AdoL7kFsEKybt1iO6kFsMTYvZpFx6tjz5p3hrk0T2ncI28Dj096uCPJBc4mc3SpAVnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx8-oXtS4447vyqv1lTb38F7z07MPfjWSG8wnpW-y6SQ&oe=6A50EB98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deep Sky Finder", "keywords": [], "long_description": "Deep Sky Finder is a VR/MR planetarium app for Quest that supports real-world stargazing through passthrough. It overlays a real-time sky chart onto your surroundings, displaying stars, Messier and NGC objects, planets, the Moon, and the Sun over buildings, trees, mountains, and the horizon.\n\nFor accurate alignment, face true north and hold the Meta button to reset Quest\u2019s forward direction. Set your latitude, longitude, UTC offset, and north alignment to display a real-time view of the sky for your location. Coordinates can be obtained through WiFi or entered manually, and saved settings remain available for future sessions.\n\nBright stars display their names, while Messier objects display M-numbers. Point at a Messier object with the right controller beam to view its image, name, azimuth, and altitude. Point elsewhere to check the azimuth and altitude of that direction, along with nearby bright NGC candidates. The Moon is displayed with its current phase, with its illuminated side facing the Sun.\n\nHold the side trigger to display image thumbnails for all visible Messier objects. You can also long-press a Messier object to replace its displayed image with a JPG or PNG file from the Quest Downloads folder.\n\nDeep Sky Finder is designed for everyone from beginners learning the night sky to amateur astronomers planning observations or searching for deep-sky objects.\n", "short_description": "Deep Sky Finder is a VR/MR planetarium app for Quest that supports real-world stargazing through passthrough. It overlays stars, Messier and NGC objects, planets, the Moon, and the Sun onto your surroundings. Set your location, UTC offset, and north alignment for a real-time sky view. Point at a Messier object to view its image, or look elsewhere to check nearby NGC objects. It also supports Moon phases, thumbnails for all visible Messier objects, and replacing Messier images."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jun1wata.wordpress.com/2019/04/24/spectraview-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "jun1wata", "support_website_url": null, "website_url": "https://jun1wata.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112114375326495"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620875_2036376710331374_2851968861187468501_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuXzzI9-_NoQ7kNvwGP8MK0&_nc_oc=AdrQHGYMZFYa4B6M2Y5FbQ7QZ7M-XmmS7YhjRP-sIO-PqznjX-DTkXbU3z-r8jYnzoc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQ2U0FpKUdOclWWzt7Nyxy1Z7ps-fW9LTOtjwtY8mcxg&oe=6A50F40C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deep Sky Finder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1781216040, "lastRevision": {"nodes": [{"id": "1092172223987377", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US",
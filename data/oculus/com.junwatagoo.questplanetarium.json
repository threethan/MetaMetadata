1-25/499619681_1708842766790638_3374115277694561849_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgwNsNpyUEkQ7kNvwFiYio9&_nc_oc=AdoA9xTbGv0cUON5wac-0eIgqFYidLx6huKfVAOre3sx1d4VMBenxftA-UqqOv6X7gY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e8UcRVrK0uQLn4QqzxIuB7aqbOMV828hBQ6EZs2Uceg&oe=6A395C5E"}, {"file_name": "\u30b9\u30c6\u30fc\u30bf\u30b9\u30d1\u30cd\u30eb_2560x1440_\u7cbe\u7d30.png", "id": "1023810790097588", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499620965_1023810793430921_2068711180993559293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDS-KB-yhKoQ7kNvwGPGmPW&_nc_oc=AdqedhkmzEzSxOYTMEOXjZ60pngi-YznFEPVVeJJeRzyTgtd_rjwJ07yL1fDQEUmSE0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PITgmCSWqfCsz3ene8P7_PG_sHa3Ynx6g2RC8D46L_w&oe=6A392C35"}, {"file_name": "\u30e1\u30b7\u30a8\u5929\u4f53_2560x1440_\u7cbe\u7d30.png", "id": "928449043540559", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620497_928449046873892_5039419999345752228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL7QWXKC4gQQ7kNvwHl7b8Y&_nc_oc=AdpsmrEmrQLXdpBXCy7YklUvQZSG5oglWqr0Wv5PvzESeCuDOGymF__ZOzPMSzcehGE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IsdcSJj2Uoia3n7yc8HCtI7XwXGnKtxpz7bu3wl2iTg&oe=6A3943D4"}, {"file_name": "\u30d1\u30b9\u30b9\u30eb\u30fc\u6a5f\u80fd_2560x1440_\u7cbe\u7d30.png", "id": "1462994915573734", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/618758916_1462994918907067_467584338542375037_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rdFGjvgptwQ7kNvwFXBveo&_nc_oc=AdpPA6MjHOcjbIMaRc3yOYMbURJ2lZLFhYLv5zXnRNAU7m9w3nCDWrplp4AuZe4-nuo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UdSRuqDOIHlnHVKG3HOXXslBmO5b2SsQuCo5sT3RsNQ&oe=6A39621E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deep Sky Finder", "keywords": [], "long_description": "This VR planetarium app assists with stargazing by overlaying a star chart onto real scenery using Quest 3's passthrough feature. Unlike standard apps requiring mental translation to the actual sky, this app overlays celestial positions directly onto your view, letting you intuitively check your target's direction and altitude.\n\nUpon launch, stars, Messier objects, planets, the Moon, and the Sun appear. First, face actual north and hold the Meta button to reset Quest's forward direction. This aligns the real sky with the VR chart, an essential step for accurate tracking.\n\nBright stars show names, and Messier objects display M-numbers. Overlapping the chart with real scenery like buildings and trees makes it easy to see if targets are above the horizon or hidden by obstacles\u2014ideal for urban stargazing.\n\nThe status panel displays the local date/time, coordinates, UTC offset, and a WiFi location button. Coordinates can be fetched via WiFi or edited manually. Saved coordinates persist for your next session.\n\nAdjust local time via the UTC offset (+540 mins for Japan, 0 for UTC, -300 for EST, -480 for PST) to ensure a precise simulation of your local sky.\n\nClick near an M-number with the right controller beam to view its image, name, azimuth, and altitude. Clicking elsewhere shows the azimuth/altitude of that point and nearby bright NGC candidates. If an NGC object matches a Messier object, it displays both (e.g., NGC0224(M031)).\n\nPerfect for both beginners and amateur astronomers.", "short_description": "This VR planetarium app assists with stargazing using the passthrough feature. By overlaying stars, Messier/NGC objects, planets, the Moon, and the Sun onto real scenery, you can intuitively check your target's direction and altitude. Set your latitude, longitude, UTC offset, and north alignment to display a real-time star chart for your location. Pointing at a Messier object shows its image, azimuth, and altitude, and you can also check nearby NGC candidates."}, {"images": {"nodes": [{"file_name": "DeepSkyFinder_100
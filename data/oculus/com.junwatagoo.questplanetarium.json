mfs7zMbAi9aBJMHN2IQboFzwoyBhuCGK9cJAmyyQXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOrg9QOOZS4ohyWgXL7KyuKaYbbiMKFW5cmDh2TeI8iw&oe=6A4CF05E"}, {"file_name": "\u30e1\u30b7\u30a8\u5929\u4f53_2560x1440_\u7cbe\u7d30.png", "id": "928449043540559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620497_928449046873892_5039419999345752228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9BP4j4cVw7IQ7kNvwG6Git9&_nc_oc=Adq2GEdXKjVUvWAoKpOqVXp5hqUUgVp4GgJEmZSXi6vXdZN2D9oCGK_LA_K_eZRHZEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlnglM7Gdm6UVweN6zxPi8CepZfYzjierVEurn8uwVLw&oe=6A4D0A54"}, {"file_name": "All_Messier_Image.png", "id": "1384252640199962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1384252643533295_9106431120821389911_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yj78crWI1wsQ7kNvwGjv-za&_nc_oc=Adrkt5V2-JjsFpTLvDF9YUuJpfS_zbmzPlLblXyj5LEKoKEfK_hC2LKrox-LKpSsrhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAowsV_mUiLSRwgRfh-DfRSlBWpB0GhHgryDpjYWCz36g&oe=6A4CE9D3"}, {"file_name": "\u65b9\u4f4d\u9ad8\u5ea6\u8868\u793a_NGC\u5929\u4f53\u540d\u8868\u793a_2560x1440_\u7cbe\u7d30.png", "id": "1025334883254279", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_1025334886587612_6154543376722504040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxRiAi1I8DgQ7kNvwFr-zIj&_nc_oc=AdpY5TcvJrKHfJsn0QNDG-38cv7aRZ4Et4Ga43GIlQQFOb3a9aPbGdoeoL12DwtWhwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ6TYr4lr1l3Y3sN0n8J4W7HSzKpYZw3_voVviYQCHYA&oe=6A4D0597"}, {"file_name": "Imege_select_dialog_EN.png", "id": "1678630010019708", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619113_1678630013353041_8553940172815155487_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTZnTrIerOsQ7kNvwGqxMnO&_nc_oc=Adp9YcLirgQcRAbDHkT4dzMSIjUOmF_NrTfpSjuKTPPdR30GFSrmigXzfAYq8Fwq_oE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9USw9wwx5QVlO6FAg3N3dIuNe3bgt5nuLp0t_37ut6g&oe=6A4CF718"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deep Sky Finder", "keywords": [], "long_description": "Deep Sky Finder is a VR/MR planetarium app for Quest that supports real-world stargazing through passthrough. It overlays a real-time sky chart onto your surroundings, displaying stars, Messier and NGC objects, planets, the Moon, and the Sun over buildings, trees, mountains, and the horizon.\n\nFor accurate alignment, face true north and hold the Meta button to reset Quest\u2019s forward direction. Set your latitude, longitude, UTC offset, and north alignment to display a real-time view of the sky for your location. Coordinates can be obtained through WiFi or entered manually, and saved settings remain available for future sessions.\n\nBright stars display their names, while Messier objects display M-numbers. Point at a Messier object with the right controller beam to view its image, name, azimuth, and altitude. Point elsewhere to check the azimuth and altitude of that direction, along with nearby bright NGC candidates. The Moon is displayed with its current phase, with its illuminated side facing the Sun.\n\nHold the side trigger to display image thumbnails for all visible Messier objects. You can also long-press a Messier object to replace its displayed image with a JPG or PNG file from the Quest Downloads folder.\n\nDeep Sky Finder is designed for everyone from beginners learning the night sky to amateur astronomers planning observations or searching for deep-sky objects.\n", "short_description": "Deep Sky Finder is a VR/MR planetarium app for Quest that supports real-world stargazing through passthrough. It overlays stars, Messier and NGC objects, planets, the Moon, and the Sun onto your surroundings. Set your location, UTC offset, and north alignment for a real-time sky view. Point at a Messier object to view its image, or look elsewhere to check nearby NGC objects. It also supports Moon phases, thumbnails for all visible Messier objects, and replacing Messier images."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jun1wata.wordpress.com/2019/04/24/spectraview-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "jun1wata", "support_website_url": null, "website_url": "https://jun1wata.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1112114375326495"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_2036376710331374_2851968861187468501_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh2325M55sUQ7kNvwFDA9D2&_nc_oc=Adpd9rIWLyMaDQu2yMBqWMLX-4wXMjaZHbWFRZJu8ihP-LiT503DHYlUdLH4Zh0AWEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCyGIHmHoiWZCIWolUThQRYEq3dxicsyReyfeiUsLgRw&oe=6A4CFF8C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deep Sky Finder", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1781216040, "lastRevision": {"nodes": [{"id": "1092172223987377", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US",
upported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1092172217320711"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1318034526463576"}]}, "baseline_offer": {"id": "1318034526463576"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781216040, "status": "PUBLISHED", "id": "1318034526463576"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1187763071094958", "version": "2.7"}, "id": "36981254941459587", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1092172207320712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1187763071094958"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "36981254941459587"}]}, "change_log": "Deep Sky Finder v2.7 Release Notes\r\n\r\nAdded a new Quick Quiz mode with a 30-second astronomy challenge and global Top 10 ranking. Players can enter and save a ranking name, answer questions about Messier objects and constellations, and compare their best scores with other users.\r\n\r\nThis update also includes usability improvements, stability fixes, and general performance optimizations.", "created_date": 1786170440, "id": "1187763071094958", "version": "2.7", "version_code": 32, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1092172207320712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1187763071094958"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "36981254941459587"}]}, "change_log": "v2.6\r\nAdded constellation line display for easier sky navigation.\r\nAdded a new Wide Nebula mode with 10 large nebula regions.\r\nAdded Cassiopea Region with calibrated placement and image settings.\r\nAdded Monoceros and Gemini Region as a new wide-field target.\r\nRecalibrated the Rho Ophiuchi Cloud Complex.\r\nRenamed Cygnus Loop to Cygnus Region.\r\nRefined wide nebula placement, rotation, shape, and transparency.\r\nCorrected license and attribution information for several images.\r\nUpdated display targets and calibration data for v2.6.\r\nIncluded stability improvements and minor bug fixes.", "created_date": 1785311173, "id": "1172194672651798", "version": "2.6", "version_code": 31, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1092172207320712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1187763071094958"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "36981254941459587"}]}, "change_log": "Deep Sky Finder v2.6 Release Notes\r\n\r\nDeep Sky Finder v2.6 adds new astronomy display features and improves stability and usability.\r\n\r\nNew in this version:\r\n\r\nAdded constellation line and constellation name display.\r\nAdded a Wide Nebula display mode.\r\nAdded calibrated wide-field images for 10 nebula regions.\r\nWide nebula images can be shown or hidden together with a single button.\r\nImproved wide nebula positioning using right ascension and declination calibration.\r\nOptimized wide nebula updates when latitude, longitude, or hemisphere settings are changed.\r\nAdded horizon clipping for wide nebula images and markers.\r\nImproved wide nebula labels, center markers, transparency, and spherical projection.\r\nUpdated Credits and Licenses to show only the images currently used by the app.\r\nImproved license-page formatting, line wrapping, and pagination.\r\nISS and Meteor Shower buttons are reserved for future features and currently display an unavailable message.\r\nImproved guest log layout and line wrapping.\r\nImproved landscape orientation handling.\r\nVarious bug fixes and stability improvements.", "created_date": 1785235047, "id": "1170821896122409", "version": "2.6", "version_code": 30, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1092172207320712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1187763071094958"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "36981254941459587"}]}, "change_log": "Improved image selection, fixed Host hold-trigger behavior, and cleared Guest thumbnails when returning offline.", "created_date": 1784459374, "id": "1157449194126346", "version": "2.5", "version_code": 6, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1092172207320712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1187763071094958"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "36981254941459587"}]}, "change_log": "Online Stargazing Events (LIVE Feature) Added\r\n\r\nDeep Sky Finder now lets you host online stargazing events from your own observing location.\r\n\r\nAs a host, you can share a sky map based on your current observing location with participants and introduce your own images of deep-sky objects such as nebulae, star clusters, and galaxies. Registered images can be displayed at the positions of their corresponding Messier objects in the sky.\r\n\r\nParticipants can join an active event by selecting it from the LIVE list. Once joined, they can view the sky based on the host\u2019s observing location rather than their own current location, directly in Quest.\r\n\r\nYou can share your favorite astrophotography images with astronomy friends in distant locations.\r\n\r\nMain New Features\r\nAdded the ability to host and join LIVE stargazing events\r\nSelect an active event from the LIVE event list\r\nShare the sky based on the host\u2019s observing location with participants\r\nDisplay registered images on participants\u2019 Quest screens\r\nAdded the ability for participants to send \u201cGood!\u201d reactions to the host\r\n\r\nEnjoy a new kind of online stargazing event using your own night sky and the images of the universe that you have captured.", "created_date": 1783384200, "id": "1138886909315908", "version": "2.4", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
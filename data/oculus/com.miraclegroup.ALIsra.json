. It highlights the miraculous Night Journey and offers important teachings about kindness, humility, justice, and devotion to Allah.", "short_description": "Surah Al-Isra contains profound guidance about faith, morality, and responsibility. It highlights the miraculous Night Journey and offers important teachings about kindness, humility, justice, and devotion to Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26215949734735840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820141_1495895725393759_4990435069307223559_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_L325zkaokQ7kNvwHngZVN&_nc_oc=AdqU0Nlk5alJznNRxkRKPZOpxYFRY8kmv4fm3enj4rsILsMK_2zJDTeDVXl0AJljIu0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0ZYNd4BzZlkN7eB5r9UEl536zqnmvdDUv5aw8TKDcHw&oe=6B071EA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Isra", "platform": "ANDROID_6DOF", "context_category": {"context_ca
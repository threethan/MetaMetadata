3744767", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818885_954330317078100_5353965650251353767_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ogxpz8TGXSUQ7kNvwH_V5Ix&_nc_oc=AdqPAmDbb6JMLdk9Pc79TsoPce3p4LHYoASo2HuR9t9rxihdZshP3f_V7iRuBpZtgOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSesQvQVe5Ukb9n9fAPh9H2LbMhMaUOr5u3Ja5rW2cyoA&oe=6B09C6E0"}, {"file_name": "image.png", "id": "1688354618989819", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821081_1688354622323152_7421489280442573885_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yBI3y_2ADkQ7kNvwH4gM4o&_nc_oc=AdogxY0YbLu0M0jtmHfXlaU0Ow9ahTqYCADgPQHHB2lex5Hc9S31dkIAtgLpQmGgJO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWxvMoOsinhHWRdqn9nzDYJ1Wm8WagbXNrzCTrt7_iZw&oe=6B09C12F"}, {"file_name": "2.png", "id": "964481229492879", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_964481232826212_1141424375651318650_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lW48sVVT4kQ7kNvwGxqYNW&_nc_oc=AdoVGyVb3ZVCDA74dudZ2QHAFcquuRKaapmYnF5wya4L0a2jPVD6L2SZ3pkieOpNTYs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuVHOIgYBhkP39qaIQOqZNaw6PewDMRO3wwASKDa-fYA&oe=6B09A193"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Isra", "keywords": [], "long_description": "Experience the recitation of Surah Al-Isra, the seventeenth chapter of the Holy Quran, in a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a calm and distraction-free space where you can listen to and reflect on the verses of Surah Al-Isra. The carefully crafted virtual environment and high-quality audio help create a focused atmosphere for spiritual reflection and deeper connection with the Quran.\n\nSurah Al-Isra contains profound guidance about faith, morality, and responsibility. It highlights the miraculous Night Journey and offers important teachings about kindness, humility, justice, and devotion to Allah.", "short_description": "Surah Al-Isra contains profound guidance about faith, morality, and responsibility. It highlights the miraculous Night Journey and offers important teachings about kindness, humility, justice, and devotion to Allah."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26215949734735840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_1495895725393759_4990435069307223559_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlvDtnm_KsUQ7kNvwGZ2qeZ&_nc_oc=Ado5qoxvxEaRp4SS5u6_YGv1IZPQhmQ_ezbCGbnS_Pyoz5DumkZurn_nP7X5CFsQU7E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6di05YeT_LKN0zCCYdfwtuaTwoKsttClQ-oUGuUxo_A&oe=6B09C1A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surah Al-Isra", "platform": "ANDROID_6DOF", "context_category": {"context_ca
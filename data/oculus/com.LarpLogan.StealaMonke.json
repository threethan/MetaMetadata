ape/home", "developer_terms_of_service_url": null, "publisher_name": "LarpLogan", "support_website_url": null, "website_url": "https://sites.google.com/view/officiallethalape/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1478434625349607"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673759338_1777142516886133_5835852221554874592_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1tODE_SUXEQ7kNvwHCt-Oi&_nc_oc=AdomRWMnQ9crJQGVNwyTTplPqBkKhCRshcmqW2k-l-M6j7BREw8AicveYnPmrrh933s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfkXsNdxJ8607YmJ6HDRghLSQGCLD6mZwnnzi9JDVLfw&oe=6AFB3BA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lethal Ape\u034f\u034f", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1791910800, "lastRevision": {"nodes": [{"id": "1389737134219357", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1389737110886026", "is_first_party": false, "enables_in_app_ad
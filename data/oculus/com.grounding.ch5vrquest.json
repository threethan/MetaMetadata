, guarantee 100% satisfaction & WOW factor. Experience the return of Ulala for yourselves!\n\n* This package includes \"MIKU'S FAR-OUT REPORT SHOW!\", which allows you to dance with MIKU HATSUNE, and 10 additional costumes.", "short_description": "Dance is your power to protect the earth against invading aliens. SEGA\u2019s legendary Dreamcast rhythm game \"Space Channel 5\" is coming to virtual reality as \"Space Channel 5 VR Kinda Funky News Flash!\"."}]}, "developer_name": "Grounding Inc.", "developer_privacy_policy_url": "https://sc5-vr.com/en/privacy", "developer_terms_of_service_url": null, "publisher_name": "Grounding Inc.", "support_website_url": null, "website_url": "https://sc5-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_HK", "zh_CN", "zh_TW"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1356279328145408"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203613_651643685770241_1321978969380327974_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0FCLnBQ8bcQ7kNvwEFV_sA&_nc_oc=AdoXiZDJrAvx3yNt9rKHmdXMkSuLawdjMBp-fr9IynjBOKxhTZ7UxppJjlv4hiUgXiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1V4XWSNOTOTTb574TW3Hz0R2RdgC4I5xaVD3xWXJM1w&oe=6B105F55"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space C
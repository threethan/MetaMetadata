nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d77FssWNK0QQ7kNvwGJgSZt&_nc_oc=AdoJ7_v4oyC5o-Di7Y629d0T8zoxGZmJ9arFu58TMauTX9S8QAY1EtZaGumgDmwyxqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScIGBlLYRhFGE_oGUPpXw3JmPvNooEnD2RHZHb5c-Cqg&oe=6B0DABF8"}, {"file_name": "dump truck - screenshot4.png", "id": "1591206768338607", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982485_1591206771671940_4816006253531546774_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhTZXp_gZyoQ7kNvwEDus7s&_nc_oc=AdrVUp2nyghYXY9nd1k6f618ob7n8f-hZk1aKlwICRQVqsGuqU8SA5LfGt6AYBrC5wY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHidVkACVnRCCWu1i_vubgzXWyfCvG3L0lUdY-bobmNg&oe=6B0DA044"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dump truck - trailer cover.png", "id": "721789129719006", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982683_721789133052339_7523797105498363227_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0EDsfZT6kAQ7kNvwET0_YR&_nc_oc=AdowSav0qvB76aK8DmGTK5fUuy0XizEBw3OvBnPMCIxxYQJJA1fFRnPWeLKFTruYvRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQUuHgY5Kl7FgjltPHiD_09rven3x6GoydQTDpt1vSDA&oe=6B0DC8D1"}, "display_name": "Dump Truck Safety and Operation", "keywords": [], "long_description": "Dump trucks are essential vehicles for many commercial purposes. They are designed to transfer large amounts of various materials with ease. One of the key features of these trucks is their open-box bed, which can be raised or lowered using a hydraulic cylinder. They are equipped with an adjustable tailgate opening that allows the material to be dumped quickly and efficiently. As part of this engaging simulation, participants will operate a dump truck and complete various tasks on an active worksite. \n\nOverview & Activities: \nParticipants begin with an overview that provides context and helps identify key parts and components outside and inside the vehicle, safety tips, and the basics of a walk-around inspection performed before using any heavy machinery. Participants engage in a sort-and-match activity to reinforce essential controls and their location inside the vehicle. They are then asked to perform a single task to become familiar with operating the vehicle in a VR environment.\n\nParticipant Simulation: \nThe interactive and manipulative simulation allows participants to explore, learn, and practice operating a dump truck in a safe and realistic format. Before starting their simulation tasks, participants must wear personal protective equipment (PPE), conduct a pre-operation inspection of the vehicle, and complete one task to familiarize themselves with the operation of the vehicle.", "short_description": "Dump trucks are essential vehicles for many commercial purposes. They are designed to transfer large amounts of various materials with ease. One of the key features of these trucks is their open-box bed, which can be raised or lowered using a hydraulic cylinder. They are equipped with an adjustable tailgate opening that allows the material to be dumped quickly and efficiently. As part of this engaging simulation, participants will operate a dump truck and complete various tasks on an active work"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
bpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwsfEJ03YhJywepWf0R46_SJaTmwHQQxUItHr98WUANg&oe=6A64C78D"}, {"file_name": "Untitled design (5).png", "id": "7648870331847484", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001678_7648870338514150_6427994541675011308_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYPXFwaOebIQ7kNvwH0crhK&_nc_oc=AdqzpLImDWe170_PZIk8uhxy8XqJE_zMfW8WshYe6fQXii7aq862xI0day9B59utjPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVnwqJv8np2iBMhvpylsOqAXeAcx8wXkc-p8gxcys90A&oe=6A64C2D5"}, {"file_name": "Untitled design (3).png", "id": "2252612128419831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035344_2252612131753164_5533417813444521654_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcJGeIvaC38Q7kNvwES7RaI&_nc_oc=AdqsDyNiICSEWkj9sndYPh6VUnyH3BP3ULlp7LJRLbQZECNfWLmZVpHX5oVXc-EAs8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA62626dTmbdag1ArM9a8apM6TKym-fyna_MjGriIs_QA&oe=6A64B1D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Paradise", "keywords": [], "long_description": "In the atmospheric horror game \"Nightmare Paradise,\" players are thrust into a picturesque island retreat that hides a sinister secret. What begins as a serene escape quickly unravels into a nightmarish reality where idyllic landscapes transform into haunting scenes of terror. As the protagonist delves deeper, they encounter twisted puzzles, spectral apparitions, and malevolent entities lurking in the shadows. The game's immersive narrative unfolds through eerie environmental storytelling and spine-chilling encounters, challenging players to uncover the truth behind the paradise's dark descent into horror. With its blend of psychological tension and supernatural elements, \"Nightmare Paradise\" promises a gripping journey into the depths of fear and mystery, where every corner may conceal a new terror and every step forward brings them closer to the heart of darkness.", "short_description": "\"Nightmare Paradise\" plunges players into a chilling world where idyllic scenes morph into macabre nightmares. Navigate eerie landscapes, solve sinister puzzles, and confront terrifying entities to unravel the dark secrets of a seemingly perfect paradise gone awry. Brace yourself for a haunting experience where reality blurs with nightmarish visions at every turn."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Z2J0-tafp9N7JXKX2vzO7dwTzuJA9uQ88isfV0gwEeM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://sites.google.com/view/nightmare-paradise/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7375021239286312"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8112520555536373", "version": "10.1.1"}, "id": "978494256988903", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7375021225952980", "is_conce
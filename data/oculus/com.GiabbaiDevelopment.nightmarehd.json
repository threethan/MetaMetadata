5451338", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031320_1518440358784671_3170060066457791401_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQirg9oowIcQ7kNvwFjIFMr&_nc_oc=Ado_hnURDgOh7nzK_36LlqhemJX2O8MxeSz3-y1Oq9lqanAwvjeHnyYqzSy7gX253wc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKP8Agnc2wjPEBzr_GcoM_7MDVpBbhUZFleSvpRYeE4g&oe=6B0B1CCD"}, {"file_name": "Untitled design (5).png", "id": "7648870331847484", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001678_7648870338514150_6427994541675011308_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2OUtbZhQ-8Q7kNvwF9uB_c&_nc_oc=Adq67kuDsQG599IwP-UoXNwaTp7rPT73sicz5tY6hbqpkRMbvzbfY1W3bgMMJmyjMaE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToCdwM73t09QDAM_v7-PLnZBufXZDEzIXx2PWsMe8XYw&oe=6B0B1815"}, {"file_name": "Untitled design (3).png", "id": "2252612128419831", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035344_2252612131753164_5533417813444521654_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGL5aQRMVdIQ7kNvwEv41GZ&_nc_oc=AdqVRDW_VEC15C1Xi2FUk9Op7MM46sDSNgVRX-HhZeclKLUoHm7iBRCzEDr9ffXc5Jc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEyDC86VerzD6f47F5QDiN0-SjUnnIRRLWM75q4c9SOw&oe=6B0B3F55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Paradise", "keywords": [], "long_description": "In the atmospheric horror game \"Nightmare Paradise,\" players are thrust into a picturesque island retreat that hides a sinister secret. What begins as a serene escape quickly unravels into a nightmarish reality where idyllic landscapes transform into haunting scenes of terror. As the protagonist delves deeper, they encounter twisted puzzles, spectral apparitions, and malevolent entities lurking in the shadows. The game's immersive narrative unfolds through eerie environmental storytelling and spine-chilling encounters, challenging players to uncover the truth behind the paradise's dark descent into horror. With its blend of psychological tension and supernatural elements, \"Nightmare Paradise\" promises a gripping journey into the depths of fear and mystery, where every corner may conceal a new terror and every step forward brings them closer to the heart of darkness.", "short_description": "\"Nightmare Paradise\" plunges players into a chilling world where idyllic scenes morph into macabre nightmares. Navigate eerie landscapes, solve sinister puzzles, and confront terrifying entities to unravel the dark secrets of a seemingly perfect paradise gone awry. Brace yourself for a haunting experience where reality blurs with nightmarish visions at every turn."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Z2J0-tafp9N7JXKX2vzO7dwTzuJA9uQ88isfV0gwEeM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://sites.google.com/view/nightmare-paradise/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7375021239286312"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3521310548160421"}]}, "baseline_offer": {"id": "3521310548160421"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1719528688, "status": 
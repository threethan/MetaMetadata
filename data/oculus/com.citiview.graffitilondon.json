at=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9AstjgaHQEQ7kNvwHBNQWy&_nc_oc=AdoIHL9oPpdewCJBZrSBb6GE_4kyjrZzgN-4hniBKXuZo7so037AVfa-Z624urTYLSY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB9vr8zZUQLlQ9qdwKDr_Fv2kqZdu2I3BRe0NUpIqc-Q&oe=6AFC6B5C"}, {"file_name": "screenshot_4.png", "id": "1114749941518563", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824318_1114749944851896_4227438920457637931_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kjt3oFKHk3QQ7kNvwEYXS-5&_nc_oc=AdrsLVcWr_m8pIOH3UXCnZE8jEHuIIK9fICDq_CWCfY1_H6IpQhz0dZ0Us-TKtUFzhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu9y1rXeB_EzVTZfHTpaAUxuC-cwolvBmCd36OccQjMA&oe=6AFC6E36"}, {"file_name": "screenshot_5.png", "id": "1575774170462084", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1575774183795416_7633826600516375024_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnZbRMyLkLUQ7kNvwGk1rn-&_nc_oc=AdrziAJ6Rl451JdVoGg4OnomCsczwzob8bMWw6M9MfRZv2h55QS3-Pg-Carj9zdqAOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShf5GZ85q4gEFMGFN25B0xfEBXuDA9aj3Qwl7EwxCARg&oe=6AFC88D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1207885271610337", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1207885274943670_7399210152842095946_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYZEy2ELi0MQ7kNvwEmNZp8&_nc_oc=AdpmOlNxos9VTUK48uiU4gimrJfKT5ehvqRrQ6OA6JxqSWak4c_sZJ_f5W4D4pBiw4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW52utgytccHeZSo5arytMFpkXJlyNcm6oWZBwSWMV4Q&oe=6AFC606F"}, "display_name": "Graffiti London", "keywords": ["graffiti", "london", "painting", "art", "sandbox"], "long_description": "Graffiti London takes your spray cans to the streets every writer in the city knows.\n\nFOUR LONDON PLACES\n- LEAKE STREET: the graffiti tunnel under Waterloo station. Eighty metres of brick arch already covered in pieces, strip lights down the roof, daylight at both ends, people walking through with their phones out.\n- BRICK LANE: a Shoreditch street at golden hour. Paint the roller shutters and the old warehouse wall under the bunting while the Overground rattles over the railway bridge and a red double-decker goes past the phone box.\n- SOUTH BANK: the skate spot under the concert hall. Paint the concrete banks, then turn round to the Thames, Big Ben and Parliament across the water and the giant wheel turning beside you. Big Ben strikes, gulls wheel over the river.\n- CAMDEN LOCK: the market wharf on the canal. Paint the old yellow-brick market walls beside the lock gates, the iron footbridge and the painted narrowboats, with stalls, a cafe and bunting all around.\n\nTHE CITY IS ALIVE\nLondoners walk the pavements, chat in pairs, sit on benches and at cafe tables, stop to take photos of the walls and turn their heads as you pass. Trains, buses, river boats and sirens keep the city moving around you.\n\nPAINT IT\nEight CITIVIEW spray cans, skinny, medium and fat caps, 32 stencils including A to Z, real mist and drips on 20 walls of brick, glazed tile, board-marked concrete and steel shutters. Take a photo of your piece and switch places from the menu.", "short_description": "Spray paint the walls of London. Bomb the famous graffiti tunnel under Waterloo, roll-down shutters on a Shoreditch street, the concrete banks of the South Bank with Big Ben across the river, and the market walls of Camden Lock. Four real London places, alive with people walking past."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitilondon/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/graffitilondon/", "website_url": "https://citiview-games.pages.dev/graffitilondon/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1372992042563998"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/822999402_1812550756549345_7981039904521271866_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gbgCLZ0djUQ7kNvwESHTXF&_nc_oc=AdozQ6v24B-zNmeo4wpVEY668Z5LKMLVQG3fYwsvXeH2G9WKMvd4meExRcVybA1WArM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeRZpJeY84wcM8KSKFhJ5AFu-Kqn0ZQBdvudVIqd5j2Q&oe=6AFC9027"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Graffiti London", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1791642480, "lastRevision": {"nodes": [{"id": "1372992052563997", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1372992029230666", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1598443678419096"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [
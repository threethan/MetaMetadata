nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBxAANcIxywQ7kNvwEhm34h&_nc_oc=Adr4C006pQFvFjt2Z_P82WepWpgb-3s3-bB6DM8UUeNpOJGk5OXTY66d_JssNfZomQo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DtrUD4IFEJhrKV-I8kbugjxLy6uBLrqY4LdyOk_bzIg&oe=6A2EBF02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1chifhUTwoQ7kNvwE1s38-&_nc_oc=AdrP9QVLnY2Zibn9ykU0s8gw2bDUuIjt9wNVRsK4CpVJrGFJocDrhu5bOSnUmqZkhC4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IDndEg0f9YICkyr7HuPMtV1EiuD2t6jFkQDX1u9QX_Q&oe=6A2E9DD5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm0l4NfTyLcQ7kNvwFTH8p1&_nc_oc=AdqdWpM5rqNoutAmqTx4EAaAKfNy9GLV6gQS8_XgHDDAI02iaQslOzM_DHJIuLiFUQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K6FOSRPC9YI6C3qIpSVscGIuCXv0AfRlPA9pWSWbbBQ&oe=6A2EA54A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRcDUND1vUgQ7kNvwFLcP23&_nc_oc=Adq7UeHmOc3o6EEdsebexSPquzgX_d0IQH7VTuGM5dd3UVow5QWI7cnggKaAC0xaXD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uFjjLR1kazrsYDPz8Tcp_dzTCAaAcoc-JC7pOrTFIYw&oe=6A2EAFC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma6K2b15D4cQ7kNvwEV75CP&_nc_oc=AdoQXADTtNjH512EPcWMViSXPR9-LoPisujGL7Xp7Wl7Ca_PN5qQ56oqXjtp4S0dOTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_atyMfbC4gIVAgjha-bsxM8oqm7nj6X5mzstP0dndzfQ&oe=6A2EBA56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
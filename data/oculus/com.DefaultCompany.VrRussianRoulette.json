nt-qro3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpQ5P8hclNEQ7kNvwHoml35&_nc_oc=Adp4V1OTBhHUKDc6OUoIySdRRuD8rlRajkJTzo0KpL1Fx9c8aYmvgFUPBU4ihDgsZOI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHojgMbgvWrOShei6b7MRaJNeTBQ5tyAj2X29lNMKNvaw&oe=6A940A42"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzv1WqSZLuUQ7kNvwEBngTA&_nc_oc=AdrbHBrCWwknBWzon_gpGtnUVF3tCHs1Pr8JNjZ9SSVPQFfT6J9c3QjNuNOfsifqbUw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3ZrUjbq1OXxs63X6u6bV9uTpVFMZsVHC9g44CY0fqvw&oe=6A942155"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9co4IPGvVwUQ7kNvwEGpvQu&_nc_oc=AdpNw-QKEOhite1o8ZYxNsx1sGkQTUHpmSu26ARq1Xeu9RikOdTgnFyve1Lghh6lHCM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYyu98nISCXUlaieJbxz42TW6jo378dXIxPzy_NdVgLw&oe=6A9428CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vhBwb71TcwQ7kNvwHS21Uc&_nc_oc=AdpoOjDHoEpeDwgPrtejmUIDEGy63HBhMJU-O6orYiWakK8PyGgLkPhbAjNeIHBgx1A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOy5H34QYPaQsslocWuhkLGspzxrIKlXoMj3DnuO30hA&oe=6A93FB06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of20iEau7fgQ7kNvwFgVhsH&_nc_oc=Adpv-JnOuKlkKFU3HUC8qiPW59dG9VQxm4mcuqdIZJwC92BP7_zZ-1GU5BQWMSJt_Uw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYKXbU5R4JTfsKNUrd9PtjtFmGaSn1n8_HYEG_7CP9SQ&oe=6A940596"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-atl3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LoH93BP80IQ7kNvwGNquQi&_nc_oc=AdpDQ_VdmE_2YkFyhSINJ23CAIhoChREI8JDIISQATgJxqME5yf4OVU9nfvQGWf7wfo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cZCcHckI1tuxpB__qa8bE-5q9KWfAHJAO5-uItemlZg&oe=6A219002"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2aSWxdez1kQ7kNvwGv8kim&_nc_oc=AdqZ-HphlmWMidSrPGkpc-T2wyG-Irg_XGYm7C0ISQJ2pexcfBIgmGx-6y5l457UxPI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_3Efl2e-WplXfmubPwAEWjfZW42aOXhw6kcKGGSkjWg&oe=6A21A715"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPM4iReeoxoQ7kNvwEDa5yI&_nc_oc=AdrI4RW0NlxG6irIzSTdCkjpkK4R4B1Wjou8_KdO5EIhL4zuJ7UEIef85qes4cK13Y4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fXuq4WoLBiAJhPuzDXv7IVOjThAqD7MtdCFMfQPPeHA&oe=6A21764A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IipXNy6eRFsQ7kNvwEIq4Q2&_nc_oc=AdrNTvqlUsbFRyt5oyvKbcMGQYZmfBZ0z9ZVFDyVBJWRlDYS3lCLPeflikVGDXKZL0k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Ms61rVqoe1dAvrrQbkH2yVz9ADOIYPXMF9bGga_9Bg&oe=6A2180C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5r4TpKPZLkQ7kNvwFlNi3K&_nc_oc=AdovvyKBsUbFMSHvC2DyF79vzAlyfYtVMnhFtJ42xB45uf7pUysJmxM4YzbILIjzYgM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h-zrBnj9q6_eN0MYB1jabfp1ulnBVFxLvBraz0Xn--A&oe=6A218B56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-sea1-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnGV80SHcQEQ7kNvwGiizwP&_nc_oc=Adpu3zw71R3sqrfrB5hKlKpz56XohH6UQ8TqYDY5xOcllRjQfQuym71qu2pj_uM_-SU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-1Tk4WwC7JwyWeSJo8-0JOpSbcj_amgSEDpGljr9Kfw&oe=6AB68982"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTq_Ab20RykQ7kNvwGTlsab&_nc_oc=AdpWecovXyhVawKnt_XWHreedR1aRuYkN0HPFCn4nJvm9rVIV-jLWDxlLqW0dYo6BqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnbjumu6gmDyFFpHLiel70ofhhy5-VWvS1T_E8lPeLRg&oe=6AB66855"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQZ2VF8Iae8Q7kNvwGWs4aP&_nc_oc=AdobcI8ZcyH8h0EeSDXnb-chkR98KBun8_JuEgzCtujEb3w7rG6sUv7vTLCTCw2VPrQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCpDeA8il0Yvh_97BTKvbpjXapV0Ca0_dvs-XV82dSag&oe=6AB66FCA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44M082jilwUQ7kNvwG3tVgq&_nc_oc=AdrCYhI5gvV9MGsL1unD-dzxpNuZf3f339NeH-tgUz4hr5vjqbgXeB7UawS7xqxtUF0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl90HyK4hQPbcsWw0RFw2iLFx68Sx0NyTmYxW5fxlMHQ&oe=6AB67A46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiDIHGlF0ZAQ7kNvwGMAiml&_nc_oc=AdpLVovKGakDka4AOC2YK4tnpH6LJUJNmI4uGC0KiXxVGPBtDoaDoZ8U3jeekehTyAo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlNjJhpZFtZ7_zY__V75gk5kjvfqXEB_HwFpDtZMVw3w&oe=6AB684D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaFPoUlfc5MQ7kNvwESo-Yi&_nc_oc=Adp463MdPFquj3negxT8j2QICe35s-MILI9ErCstYcEaTUQh6F7vJXIy61rPP5IlRaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WB-2ij68yMuWYrPsDbDOizxW2pBGlvWe0lHpdP_XBPA&oe=69D90D82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5aUKlNtThUQ7kNvwFs_w-o&_nc_oc=AdrtKK-VR1mrzTT8EuT7OU0ocnqCeTaIhCatQfr_OcT8ddYuak-qUp-nve36bDTEEx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2THMsAERjR67-iDeV-VmvO5vH0Km9QXMVGBzZmEBbisg&oe=69D8EC55"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZERNprTXI4Q7kNvwFoyI1A&_nc_oc=Adp6Rvi3QR5qiou0NpIn1GGBF9TGHxZKwI3rrcqV_F6-6XlZl3hRxvMGRQrvOnwHvto&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hK8heg1AcLbx6TCK-0vqCIn1Vg5eDtHaRqRw2bGPMoQ&oe=69D8F3CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIJCKOU7EXoQ7kNvwHtMBQn&_nc_oc=Adob5yj48ZoYwU5EzZlxQ-9PjZ1ypYvisysxW8XXXonqEuZ7kWPumLAFArPwJBXbLAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rq_MEfcDvEkZhAOYJ5OjA_-mG-oeYLLUbACThPc7RLw&oe=69D8FE46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cw2mvxZtsE0Q7kNvwEW2K5F&_nc_oc=Adq61yXswRMQ7eqAHj7j8ZQhT3Y0_oHgAEXBAQ8c-iDUH0Cxi1DAgB15ZPyRR6gGv5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q8WRG9j3ybbWzlnYglawsC-fPFjrA5A0N3IO3jSm31A&oe=69D908D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
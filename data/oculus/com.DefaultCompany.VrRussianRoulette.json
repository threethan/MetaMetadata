nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYxTiwaC2HEQ7kNvwExZygN&_nc_oc=Ado9jrb1lGGqg9q1sf0TkFJmb6xgLGuBUMCXzXOnZEKKFGTycWE44cWZlBu-l_7NXLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ15OBaY1JozqBHOKukdeV1tzokAI7FO3-L3NgaOfoyMg&oe=6A9ECE82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wthwzorvvtUQ7kNvwHarp5W&_nc_oc=AdrG-MUdkjle0Q-8EqCPipFFD1japAcZXxwbv1BvcS7aR11wNUSkZemZbyWK4aGCHLA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaqLp_qUJMtHRgStvsDOTxaSFhSGA-c5DrD4D0u9BMcg&oe=6A9EAD55"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efV4-9PrCCUQ7kNvwGP8Em1&_nc_oc=AdrJbw5GK-k0-lNz6SKW65vvVLbKDjwXpd9rg1402LZk4ushp3Z3iqTZdH2pguaSops&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVh_xFmTgUuolDpppFDXyYBETSXVrW4-nkSvCJ5xJbJA&oe=6A9EB4CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Y3ErydPGrkQ7kNvwGUOROC&_nc_oc=Adql7JFUUNmxbD3arkjrPp0CWvrjVve7X_HCnVqF5ULN7_R_qxwIJilXgMZWiUk2EUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzsnnWBuuCVcBGQK92ptgxVPlpzwip7uAaf795Qc_gVg&oe=6A9EBF46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6KdOMG3PrYQ7kNvwHdeR9Z&_nc_oc=AdoLyDQ4QIsOXHB2_zxU50zOOcwCO7jwU_3D4h-GWW5BljDc6kmX-4avshMgfOh7pdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLweot7Pc2Agac4VqBXOK77gpW-CFw9RMtAZoBfmwWsCQ&oe=6A9EC9D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-atl3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz1gXWLO8k0Q7kNvwGdDZTo&_nc_oc=AdpF4wy8Gke6JkaZX-X3i7Gq3DhFD0oCJxuJZvDYyLDwxnp_yVGZgx5w-bvRkcQootg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hvCeyc7J_9hrpcSWuFORb4_HSUBmMVEUBJzcWVuIYFg&oe=6A340502"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRSE5S8Ky2sQ7kNvwExwak5&_nc_oc=AdoxU5QjNsetgTN9tmoIMl5IvAO2Swy083p1Rzmp-lS9sR2DZOAdPgYOaj485D7Ct2A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86C-T0SBT-6pSj-NXDQCIAgbCflWJ5XUWsAncg-HnjLg&oe=6A341C15"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6552DZR3_m0Q7kNvwHvmr7d&_nc_oc=AdoB4mmmGnIxMzZRDzeaqk1UMdygnKlUPBohJ40yq_wu1hnHKo3ZivRjL1MDSnviOPU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Kh9mf7ds3zwOuscVbO2weYrmZ9D0raMyCYmLJeLhQEQ&oe=6A33EB4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRwcAQN2x6UQ7kNvwHkg9p6&_nc_oc=AdrOhDzQCTnCs_uCpmcDVl3OK57Mb4YYWvGYgp47oiloiNETgFqVxsSQKZB-FUy7gcQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MGnn2cFid20ucuj2w4KCI-e0Bvmkm1iGNtU4Hyy6wQQ&oe=6A33F5C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_tB5TR5DNwQ7kNvwFaVC7i&_nc_oc=Adrl9NrJk3IIdizCWzOYqkC2baUD_iOQNz174_wDuKglgescw9lTHkIpaOv_LMOIcVw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qNExknfaPm8X-Px0hLZopCV6hT6PNfbJgKvfmaJ2IYQ&oe=6A340056"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHteWAJlKdEQ7kNvwGM4al5&_nc_oc=AdrmbASfB-cyLYyb2oaVyHW7n4VnJCDGmK-bEf0e9FaIL9BRFOPE9LdOFKxG7GKogJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Twuhkavz8WfCMe0hmFZp-YvEIHOL061VB_3UwHRBGwQ&oe=69F76002"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UufovUnO12MQ7kNvwGFoZf_&_nc_oc=Ado0_k_cG3RtJYebwDWJR9yy3weyTOnXdz-LIRaH6KNfRzGUVs2RJv0UPv_Nt7D5ikM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TTsh78I-0AAhR0ZIle_BN7A_L0M-YGtvZmFy6I9-wAQ&oe=69F73ED5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4mw5S9-ifYQ7kNvwHZDJJ5&_nc_oc=AdpLHBUA01mbX9wOHJ3wBjpBpRlsFA0G8vyKR9mYQbylDxCZTIFxpHJxm3p0bL_85KE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19BP7qjZ0aoY_1F7gHPJUaSw_w_9KEBrFvqBmTLuP-5A&oe=69F7464A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8CDjbBFaCYQ7kNvwHV-hia&_nc_oc=AdrJ_ZXQJxRXL78Wcea8_-0ypfxou5FgaHKW4eCUcij7wzyuXjVpED7lXCJ239sPPr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Op-Rgi47kbf_91YbQGRzQs9cYeu6eGXhoFkqPe-HgfA&oe=69F750C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AgoSEvn-eowQ7kNvwF03zKC&_nc_oc=AdqFBeua8Pw73HEOassLl_-EETBHsJcDCgnkFFmOvkom9DYo_fm3mzgUKIn4pWo8T_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NrfaVuKSnXO7NFI5SZMii21Ek4uh-pvqxbZ7fz0BL8A&oe=69F75B56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
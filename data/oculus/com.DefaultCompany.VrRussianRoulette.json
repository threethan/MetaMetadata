nt-lga3-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCk7iU9d50AQ7kNvwHneABN&_nc_oc=AdrqxYjjeAUy79gITM8XGa4mvWiTYfYZcvMlVclELmP2UoZ8WP7jVkd7ePgKJVk1NXI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErFKICyMNYY6OHmYjpGKfpW1JtgTYOTiC1jSJQbsRA3Q&oe=6A8043C2"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyeMR_ELP1kQ7kNvwHIuox0&_nc_oc=Adq6xJB47e8E7kHv6OTQVJpLEi8XvTGnslyvXr8nwofiBhUND81GGc9DcefroRSllpM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpI0ui-tv0kuTi1ebf-umW_C6f3vaBbyPtZ3_nMvY6cw&oe=6A805AD5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLEVtAB1rzYQ7kNvwHVQ7Lu&_nc_oc=AdpN3WKV1qd7C41gb81WkHMGolxsJi8EpynPNjWEwGsZlXs4MBmH-m1_1K25Mak3OJ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzWQ1cLtpFVaQQ0_N9k8jPmwvQGa_yuaC1kCiGIoWDqA&oe=6A80624A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lp3wDYw_MhsQ7kNvwE9KV_Z&_nc_oc=AdqyjrDWSMQGK5QDYw-F79xpJdSBBKlJXqvD0ZC4BIy1ootL7oLocJZlcDfCg2UF_yI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcJRrHO7yP6ZexVpHt-Fe-lRC7n93wua15rgJBr9zktg&oe=6A806CC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyWmdOGKUf0Q7kNvwGMECPK&_nc_oc=Adod3cRq4ALScAoFTNZtefEIowpZXKeEYoel-ViUNy69PLx-4erqmwBe3X3GKRkxQAk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtwrEPEceNDejyyx01CwUghtfmKZVOwfOvkRyiz5qiyw&oe=6A803F16"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
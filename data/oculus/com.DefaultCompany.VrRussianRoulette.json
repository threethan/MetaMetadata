nt-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE1SQJcs2mcQ7kNvwF12pa5&_nc_oc=AdrgN6kT-XlxN2ktzIxRioanS2S7pSOZdDM6HE0PNkNQAaFvWxvTHhQWrHQDs3Ywk40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IgJjr-BxasqdZDjuom8CP-wIp6YEQ7Wy6DX2Rb2nqHQ&oe=6A01EC02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-v8ZahcmfYQ7kNvwFINvNj&_nc_oc=AdpsJQXCG4f_YExhTQUm0jV1-sXO98JPwwvR4o2DDE7-7mb3iJufz60w7HCp5TotdpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l938Os0GhSoKlnHa812IedrvByWskUXfU7tPcm1i2ig&oe=6A01CAD5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvACckA3EswQ7kNvwHV6Aq0&_nc_oc=Ado4I59ffOJDKyr9-PlwpEgTpoSE7D3PYxrNRpVbxp2QKyNknE_0MUd23C24P2GbWYs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fj8RtUSALlsrd8PPFpBe3m0fZdcOyiXOp8jkiTe48Sg&oe=6A01D24A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tskafToUW8Q7kNvwGUwkoy&_nc_oc=AdrGzu-6Ehq--devwxnuujrhEjkv7YAycrG1uywaPES3rmLl9u7su_XKbJWwCqlzLnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ijzDYxTVqZhBgeNE2a4vpP2oWgbZMrhL-2pfk5uRW_A&oe=6A01DCC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjevm-OTFpoQ7kNvwGeestW&_nc_oc=AdqknV3c_oqr3sxIcRDx9MH-k7l1uDWKbpMhyNmNVVockW4LRGt0Z77joWyVQnwxufw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bj_1I5S_X7CSWkcz-FKM7Bry3W4Iy0r3IczBCxEMtCg&oe=6A01E756"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvjI2ZPivugQ7kNvwE7pmku&_nc_oc=AdrNR5JTr4DEchetnL5_7TjE3p7f9K_DOwOaDkKBvyO-qo0fdS3JUZcMkYrDIdhu0ns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NoEgmw6KCo8qJ3BolQLDW4iAz4Y-vGn-OuFJRRLFz2A&oe=69D51902"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpF7e37evu0Q7kNvwGF46mP&_nc_oc=AdoNdOfceNtBaZrwyjkw4gCxUrpzCQTfsi4pxEBZffiYKxJz2DBjVPgguBiVrpWbZQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GD5s07isJFr5rJ_1BHdaMdPTKMYU3WKtFJMeNoN0cvA&oe=69D4F7D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpfk6FBqxt8Q7kNvwFSdiX_&_nc_oc=Adp7D-P3UTZRkJKwbWuikjK_O0OJNHaWrjmGpm3woNh_LWtOEUfX0HDoKSZtok1__YI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_5DOoVH3p2AV_tJH9ZHjku3uhVaJtfml9Obcis6zjxA&oe=69D4FF4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dhwp0rHteAQ7kNvwFAqlKT&_nc_oc=AdrkeNWKjeBtIjA21IblKbUAypYZdj427E8lZEVtffxRs5L6zf5n_tSIy6czDPAZj-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OWFMUm46wOGxQhrz5BGgr2vUsfkYcRQv4fPTSdz-KgA&oe=69D509C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBDhGOXnVA8Q7kNvwHEPr1n&_nc_oc=AdrR68_cQXoiCZhUOVwEeX22_s3eDTetKm12kTdZuu84GPpYNjtP2f92FySa9J8rV0Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2za2aJpEd-5ChbnZ7iM0zA3Y1SnuavROJY8IXTU3ssYg&oe=69D51456"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
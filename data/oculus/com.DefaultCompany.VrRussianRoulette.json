nt-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtOPsuK5lkkQ7kNvwEVD6wZ&_nc_oc=AdqfD_adnSK7EwN-JLZnKzbLhpIE4TKEOBbe5N0p0e5DgtJ6iwkARhD5vAus6jFR31o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC63si8hMN4OJrAGFF5FrvAjmoYXdTEYWUiUDWzNYKg7g&oe=6A525782"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqhviJ8RkZQQ7kNvwHtZTH-&_nc_oc=Adoa84l_xyuhyIdk6tqGs3Y3rMNI5BEFfyfTM6zuKdo5PGi_E7WKTxQNhBlvCImcdo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8tNCMhOyzL862RqvOkMVVAgoB8E3zGIwqq1NqR5QFdQ&oe=6A523655"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8FdcuLnOesQ7kNvwEcLjzd&_nc_oc=Adrxp5isvFMOP1nIpolzGTH3cTrjXjyzZs8e6C3WAJpcGWnGiMFqsuWb2j0hIg-X0Gk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcRobCeh1R0nShVW1ULn8476nY_uuC46FPyjX8ELzzyw&oe=6A523DCA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsYzq3hq3p0Q7kNvwGGHnHs&_nc_oc=Adqhzcw9uE5gahNpGo8AzY0SsSahSw8takfu-SsmIv4r3x_aaVQwwjM9m7ogyH0ScQg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXH_LAVKyWKuy_2aYcbilnnrvA-lfOg5_1snvLS1kW8g&oe=6A524846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLj2Kr1wDZcQ7kNvwHrBpK5&_nc_oc=AdrwbMuRy7Hz4XJl78-BxxW_npMHyN9nfPKj7b9pSEbTWE7U9YJq4fyX6Seell4y7CM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChwPSJf_lxe-B0dYkqCtO5Hv1gt5D8ZDnsbwGGlEG6Cw&oe=6A5252D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
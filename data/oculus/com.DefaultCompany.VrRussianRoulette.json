nt-qro3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpQ5P8hclNEQ7kNvwHmiNx9&_nc_oc=Adr3UDIyfc3b_XosjEPv0jtfW8JDKPEGMbh4FMgOhtdEfWgksTf0zgfbzR1ia4Bfmfg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQizrseXhHSgR_I9j3vj-Wiw-tVcnj8Tnb-9h59TTtDQ&oe=6A971DC2"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUQpLPQ8cn8Q7kNvwEGDAnz&_nc_oc=AdrW4tKIhJ4Sgcyc46rYafZ9WZpuQ0GI_EjXYvfd2V3gZDWacmnr6rBzlHnO3oRXHqY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAuW7KIV-kHMaV2W-6TUwLuYegU9P1Ow9NqkX47ZdowA&oe=6A9734D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvAZWIQ3SQcQ7kNvwGUk2KB&_nc_oc=AdrBtvIpAcVo4fpbU6dOI4LbY00QJcaeW_zGOT1yFAXfy-I_hHFiTpx81L_4YlrcNDQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJqi2ZnWChCh7JnBPGGngWXikGoWHfm5jB0DfSsH10rQ&oe=6A973C4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KSw4U94O_cQ7kNvwE2K-32&_nc_oc=Adq2B0ekH0H1qZUPs-ZYDfN5DfyBhDX-5LA6vPXUKF12OEo8NWH61dtubeC-7iFzH50&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr1PozBuDEoItIyw3_IqLkZbaCyUsLLyYubC84OUwnMQ&oe=6A9746C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQfyhGCuYzMQ7kNvwEN50KL&_nc_oc=AdpRfrrDPfkBX8SNHuMkdCWt2tGjaz_kVi2nD35gUDCE7ZyTtqodkpW3xi4rR49PFjg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIFaA25UtFiGPqgYU-gXxTz4GZ-8PT_mxpAXauoAZQiQ&oe=6A975156"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
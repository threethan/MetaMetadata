nt-sjc3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paiXcg0xpxAQ7kNvwHd-2l3&_nc_oc=Adoywkt6vp_ZuwmlC82ZaZbnMfe79UIII6g8TBZrEembwGso6zrTV7ksYsGbhLp5DH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85uy5Lh0e-nK_THzAbe5NnOsGp8EgiowN2X1h5Jmgwjg&oe=6A3A9C82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZFgG2Jm-T0Q7kNvwGShOiA&_nc_oc=Adr88RtzY9yLA9RuYioUHyGAivWSdODf1h2FhcfQudfoxHmHfBQ_mfKZTfHp8jT_YIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x2jqnBhYUd50PqAmRaz7fmV4Pwkq9tr0ySaKOzytbrQ&oe=6A3AB395"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGLE9hsrwTcQ7kNvwEkMxem&_nc_oc=Adp7U6MIAH0gKobRBxJIfnwmeKDk538EkkwNuszw_rcOpmqbEKcPQpIzsKxEwEMre14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eraItaivgjZDlPnnDZK-8PVgAJYUsal7XkX8tgHldDg&oe=6A3A82CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahpHlf8KI7gQ7kNvwEzoxVy&_nc_oc=AdpgZO-eXXtAn0Kglb5B7QkXpXeBybyiIQNp11t32z2vMGk7nqcjR5bHRlZkYpcNRAg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jx99_0FFcUgWqMKTxidO3DwiQqzoZkYXfYtJRJDYOUQ&oe=6A3A8D46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9kxtsJLgVcQ7kNvwG3eSi_&_nc_oc=Adphzm7PixvZPhRlRpr05iHNUqvZYcxZVIgp2bkFM27YM9wzmj77vRMcuZGSqiTyOdg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WDzMcdM5JPVzGHubpXM4J1z4bxPpmKBSC9iJX20albQ&oe=6A3A97D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
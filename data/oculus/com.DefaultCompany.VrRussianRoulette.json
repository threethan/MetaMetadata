nt-atl3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KkEgh8mUqYQ7kNvwGxPISQ&_nc_oc=Adpd4kLQhP7uCNfDlS4yHqFT4JqdDUBB-dB6IduFUq1m1ooQTJHwEwukWL6NjVNfjRc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvSlETvCD2JEl-NMEnPn2MVem7GtfFvgymFbZlSx0g0w&oe=6A71FB82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_WcsIe4sMwQ7kNvwHqcc3f&_nc_oc=AdpeBYujA16dLSsWRpFMGsbJAhaC_Ozoc2d5kLkj8ub6z4PDUMg3h_TOAaHfC6M6wwI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWTUVilj-4VxeN03wjQN75qNAruf-beZ35n3m_0fJpsw&oe=6A71DA55"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlQ11ZYbU_0Q7kNvwEIwf4z&_nc_oc=Adokjs6ZQ5BrpYJGMMDG8z4490OQyoCBssGJ9AaU98yI1eVVrUpIa16yahimsMEE4D8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaxTk7cbvzu1SwZ0LCRyIXeEDwQz1wHdtv8QmuFoDbRw&oe=6A71E1CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIAU6u7spUsQ7kNvwHLK0gA&_nc_oc=AdpH89wKLiapBnAU36YVgo3_Gb6TeTREPwHtGbPtDwzG0XnFgNESNpgM3TyqCyk1yiU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4bD7j-E3zJzG2Irm6gpbC3k5JZBQdVpvsy2-T6czTBg&oe=6A71EC46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkftTW21OhgQ7kNvwGRW6ah&_nc_oc=AdpKEB_P8LIeA58BrLmmHOMKZQmYbn87Sw4isz3-uI3ALI_d_jarbPXeAv1PGV8ffCs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAWv1MdpNdaH4k3euEZ-VB_p6dXUrc5WjYzHefOOhcew&oe=6A71F6D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
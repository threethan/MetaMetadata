nt-dfw6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ButZ8bqqPg4Q7kNvwG6hXfj&_nc_oc=Adpdf0KEGeJw1xdRh6D-Gom1DeWzfpSKo7LEypT1I43ga0JpigS15P71W1we08-SN-Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yDKcJ0dgpcZLiMVPFfvH_YmlkLu4LBtG3xyVykVxAVw&oe=69F4BD02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UufovUnO12MQ7kNvwFJ36Nl&_nc_oc=AdqZ6dDOB2P-S77Y6rtYwPOh9XsR4tCMAKqfVZIt66Bz61w6CxorlO3TmMJeMJdmej4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sWLj5eJ3iS5Xgw16y0egopnQBEYYcPa1PWD2R6wBTzg&oe=69F49BD5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKKFDRKX58sQ7kNvwHNKjCd&_nc_oc=AdoqnBnurogCgp9sgq5jRUYdyaUTMLYSnpKsYty3gGNpybTccSnSc61GCSEKs1NpF8U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3jwxkG2IEwBvdvyh8XMVnkBkSaL2meifHZW1JcyZfA1w&oe=69F4A34A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ea4k2I5jo8EQ7kNvwFk_ffJ&_nc_oc=AdqMBOz3itF1QYz5gTZBl5Xe3C-uIhRh-uqwp5XMFh6LnpPoYJiXFA2BCSZuyV9_5kc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1mhhbL0rtHDbA3zVhPhfJJuLz4dgH2ojPWNYZu7ka5kQ&oe=69F4ADC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8tq4MnTJMcQ7kNvwGxOOpu&_nc_oc=AdoC9GHLacENZ4wgGt1lksCWecej2JhrdR8RKRBe0z_uGVyjKttgRMG-JX1Ll_Ms7Gg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13mkQnhHiYgljlbj_8sD1tT8XqPR5zdYT4kBQ8i5ekPw&oe=69F4B856"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
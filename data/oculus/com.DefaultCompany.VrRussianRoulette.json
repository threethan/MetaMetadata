nt-sea1-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqKzZCNxSz0Q7kNvwE7iCMM&_nc_oc=AdqUUwgYm_J5c5It__ZCsVDNrfL0zQmVpLk-L0Oz1GCAHAShKjV6e1nyMQvQfsgB-70&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCq3EXh1sL2SCt3IurTsHxsmgmOrQ2KOedZmNy05qljw&oe=6A9015C2"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5R5AkCCJnH0Q7kNvwEQNtlh&_nc_oc=AdpkssjhI6C_U84lFgO0oUOfjb5z0PN4tGWV-Zre_yQ3cC1LlEQO8vaMnqK5hy9NVKc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH27r-fhGMJs2YouRwCfIeFBOgQ5LXhDJNVP_XxwRUMyw&oe=6A902CD5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg_hWxYNFoIQ7kNvwHQ09nG&_nc_oc=Adqnl2bGSkLyWLZs_l5ghWwJ-DKgKprxyBmx3ctxwn8OReLJe8TocfTinbspegKoVZo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyimBO-Eim-bljduhdmgcFmcczOJEuO3SOFCVIawHBbg&oe=6A90344A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ltNjcGMEeIQ7kNvwHlISG6&_nc_oc=AdpHf2WiZ6yM91aEyhwFe_hgeyUH2FeuT7B9_vZgYue41Zfgzny0KulWNDWhruM15js&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeUvOgBPd_8G8UBq1BF4fyEYkviJgiO51k3HdbeD3Icg&oe=6A903EC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEeIxSE0TFgQ7kNvwH_e5lX&_nc_oc=AdofSii_ApOktYG2DPS7Pqr57b-K10ZObKuhdn8UDt46U6ZhedUlt87tj5TubvTfNn8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoVf3ZIJ0kifkd9HkRlDlRrfODZaP5wFbZ0x83N9dT3g&oe=6A901116"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO86ZeaD47UQ7kNvwFS3R9n&_nc_oc=AdrEnurD1_KYpgXrdQvt6u4QPz4IH0ML0oYzMNZJnivQKBE3c-pH69fVl47QIeLguJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LGryMlyV7hZEydablslHgB6gXbhnVvLO9mOz7Y3na5Q&oe=69EE2582"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=52iQSWIQLPsQ7kNvwEAkIrg&_nc_oc=AdpWcAQ8vNrBIoIYKMwENT-cL7pp8aKpoh3ZJGHcFcaioR2NNFW8BykyqfXurQrJyRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18sJvKQ7uFLVokAhoAA8Vm4VcYctbOSkembGTDKzZ7YA&oe=69EE0455"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8k8RvWhYG0Q7kNvwES46tp&_nc_oc=Adqz00B9OuHLGAynK-J1i5k1BVeB62MvX6wAKh6H2vNNRzgsACK_Tsb0O3LvBCu3eWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tbbv1aa6sDRk3UvgKb4e9mBfrTp1iQZKLnTfOPN2rvQ&oe=69EE0BCA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU3sHF2BsIoQ7kNvwEH6fPs&_nc_oc=Adp2H2Fp56d79Ur9bjR_hTG8E7MQfx0FBtnq-21UiBISw8OFKjXXR9xBJGQr29H7tQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vmbqvXSUmDuV5EaKTacbAPOsjviBgKkIRRmjB6pqdig&oe=69EE1646"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfCOp4vPmvEQ7kNvwGDTtjH&_nc_oc=AdrQKIZ3DLQedI9ZzzEbXMbCWqYZuChCE8vueSgRhV8Y9fGyPAKwSngKGejyk5gQEAU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rpf7UuIQRiFDdLYPjYCmJ_H7w8RYTGKRChQrMmrKpJQ&oe=69EE20D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnGV80SHcQEQ7kNvwFDDdgS&_nc_oc=AdppREfQRtkjGyEOaibLarQmUsxVu2r3tT9Ujkb_7myyV9_cA6UJ8RQwghgrf96WbLw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKehzq4-d2R1YiaHeijieFlnzlVUyC6kUeMGGhf7_9vyQ&oe=6AB53802"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvfTf54zPBQQ7kNvwFoo6J-&_nc_oc=Adp-OH8ylj31Xl0DmwF6GSsBOgaJ3ITKmR7C8jycRqMdWSjMgBf3ktX_yUG38LemIVU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrLyY8GfbVMWOVq8xgg4Qr7rijwD8uoxPXKMqf4Ya1cQ&oe=6AB516D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQZ2VF8Iae8Q7kNvwFAhXLe&_nc_oc=AdooU-iBpzlvjhObjJeMdfqdraTGpGc9XCN6ruhQbIBLjc_I1K0maWJqasM8WbLYRvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJmtuhMNALXWGwzkszc_F-kwAmzPlO8Efz8Okrd3Gdyg&oe=6AB51E4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44M082jilwUQ7kNvwHgLulF&_nc_oc=Adrzmmae17b4HAv0px8dA5lrwU4_kVwUb5st9bWzxkEEYgh1fd-U8EQL1RliJgpcuB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ83x3jV2CrsTUmW6_tDT37fwU08znKkywo7jAUMOZcGA&oe=6AB528C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiDIHGlF0ZAQ7kNvwHqKSso&_nc_oc=AdpaSq7ZUvRxf1C8GFv2Vgf_bDEImaC9SB_RpQcAISeOms0YL3o_EvqzXLP3shsRhe8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8ysmDV1Opbj-l_fsYLyU6dl_Nu_7etJeWQaddLkKeTw&oe=6AB53356"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
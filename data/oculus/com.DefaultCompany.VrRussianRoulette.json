nt-lhr8-2.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxxL2r3FhnUQ7kNvwGfV-n-&_nc_oc=AdrhRoLeBmX5t7B2nV83hoRQ-O4XOYfwvEewPhGVQYsOmtEDj5jR8q5tDCG1JzZYnkU&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2emcOi1XrTYksrl3MzzumyWjXel0ZGTiZg8fGPldNRng&oe=69E24802"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kHHf2Va7VQQ7kNvwEFIX1A&_nc_oc=AdrzppGEcgvxWuuLoXJJsvxYSUEVfcKtmCTc-TdZ_-c_0rcT8-hefs43CBCrDdpj9hs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z0vLeVIcGtINIIK-Jj-LbSOHqd3K_8Q4utL_AF6_KdQ&oe=69E226D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPomtvUzUEwQ7kNvwEL1ukH&_nc_oc=AdoTn5zRucEqACWeMuaAyBp8odxQhnymcyqAGOHMvWBHOto-Jo-DKU4KtMYQNGyOQkQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MKRj3G-WshRt2fYilpDANFzSsv6d17paQVLMURhsQ9A&oe=69E22E4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRhPylnlehAQ7kNvwHOl9DM&_nc_oc=Adoz90d6rF6It-r8buBEapqt6h4zS2nyR0UUJUdu8xLmWQRSwAqpOhwI1D3Z26SVSRY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GjyCwdVbmMb4cbsxPMFqUkhLXrUail20YCzhBrR6tdA&oe=69E238C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQQY7r6h1DwQ7kNvwEYEuql&_nc_oc=AdoI_lCdQfqVdc2puHy8g5YKGT9KapN9FS1ZxQICEPnGj69KMm7zMGwuy59vGssY1Mc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RNqw-SvqynfvD8v8LDQvblf_skVmCSa4_sCHinY5m5w&oe=69E24356"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
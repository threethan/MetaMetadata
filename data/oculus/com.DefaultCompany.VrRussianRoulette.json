nt-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvjI2ZPivugQ7kNvwHPoLJU&_nc_oc=AdqkjcZ7G7xE_nOXx7InTCsft2w5isx1-SexYOOp0xWxWnJb5mlvWqIyVL13kd0UyXo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S_AM_5h7tyFQ1jvSFpzQK3A_PsPY6RX3-ZpoWjfQMYQ&oe=69D3C782"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmaRxVqfJ2QQ7kNvwFk5M7y&_nc_oc=AdqFudAQSlZAEMooeyP-GOmmCI0ZeDkRHTJlZ8R6YaQ40my0cBWlja88YsgC2OPn41Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ne0e-E69ttXY5AhrSwrPr6C8Zy-d7qE8wYst4NDqRHA&oe=69D3A655"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpfk6FBqxt8Q7kNvwFF0soM&_nc_oc=Adps_on-xHM-7TqEk6mUsILdpqYNapmjRS_nXuuZPwZ5APLLhvB6ZGcxcW01U-L9Cbc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GwXgCM7qqP3vBELAh3QBzLLwRvsgQJDclGAMdclRukA&oe=69D3ADCA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dhwp0rHteAQ7kNvwFtl_Hv&_nc_oc=AdoISc_fiNALpGLGroNvmn6lYF77UECdp-b6Uq-_1bDXaweYqaRWgy0Ai54itP3BVDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e8Jvt60fjfzoYdVkFb2ZLzo5uNO49U694c4t7y6AUCQ&oe=69D3B846"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBDhGOXnVA8Q7kNvwHgrXVD&_nc_oc=AdqQ4gUqJrXL0QgnbmIu-4F8ckW9Ax45RwsNkNKPyk2InvpFd0OikCIDdthLHd1v9fI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IwVFn-LNjuMP9KLBo8NRmWd2tXfo48YSyYOyE4sgMEA&oe=69D3C2D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
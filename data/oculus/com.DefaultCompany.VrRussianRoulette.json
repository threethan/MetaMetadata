nt-ams2-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYqVyJDEeE0Q7kNvwFF6e3o&_nc_oc=AdoOauijAQDUOUH5Nk_JxDmLy3IqMcOlHrjNOocCvC8eepXT1PD1SiVDWm3dSasouoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YvApmrpLv7Uz86PO3oVjOAdon9XaXPjclKEmzMZ68-w&oe=6A3E9102"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjKHoEB10JwQ7kNvwHjdkMf&_nc_oc=AdrrrsFW9rzq_xFxfS16qyrMV84-zZpC-IwCWcXryf2rjjiPKN0B5Sodfad5GAh6BA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AOxJ4zMd1aOrZ58OYNXPslTkAMsWoB-jGNkIyJZAz_w&oe=6A3EA815"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89Flbd7nNn4Q7kNvwG2kCXg&_nc_oc=AdofY8ng6I6KI1aw_yxRgBgK-BzUnOLm_yM-L97e66vpRzeUriEgfLHwtDsyJRaWiiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Cf9JUoUWELIdIkAcy-MINDZm6CWNH3WASQ-FMcjX9HA&oe=6A3EAF8A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWNBDVkKCSUQ7kNvwH20F4J&_nc_oc=AdoJH-LX7Y-HRKztIwxrq44_5cjVDSkgJX_avx91N202QJO-lCptxo0p4r1D6btV3hI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OTm48QdD3BrNqZUARoEn_KlutyNw9D9-qe31EFJKBwA&oe=6A3E81C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VavKxO9MFiEQ7kNvwHlNAFI&_nc_oc=AdqAbgzg6qnovLRA1cwkpHO5OwjcN_hk1nvQnWPAww-APaDs_N2th0Dgq-JqtIzomiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kOXX8t52EUWLjTaWzNO_qKMXtFvNjK4AoZn8oDDklfw&oe=6A3E8C56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
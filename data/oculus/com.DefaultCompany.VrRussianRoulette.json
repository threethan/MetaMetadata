nt-fra5-2.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUxAjBdMch4Q7kNvwFlhoyf&_nc_oc=AdpoSApxt1fxC0PW_Lqm209T9_aGynZeirzIX7cHaJcem91m0FN9swH357ewxUQLUh4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NoVrDBNgcomK5AS3MyTrMzQ6ZaTBkA1AbwZxhFm2B0Q&oe=6A2C1C02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1chifhUTwoQ7kNvwEHKqQm&_nc_oc=AdpKCzdsB3lbYUnHVHxq4X6CVI9BqGXj4Rve5bptMoucWaHfNeEzuXIaHLdJDZeW-H8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pMo9EoJEciz54JaqdVStYDfggdnfQp39GRJjepZS80g&oe=6A2C3315"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-osYsAwhn8gQ7kNvwExrQB3&_nc_oc=AdqlJFNMrTmHFvmzCMmycNcMeQx8NZXWnB23ujJp7e7HWKB8O-VpJXMuGbRQvc4BdbA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e2bwrj89D-7tF3ABhzJ9FOcNxqnxnbFAVNLbs5yrU-A&oe=6A2C024A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WClMHV28a08Q7kNvwGcBP7B&_nc_oc=AdpGeTvSjzbU1knTh6Vx3qHDPGNRyaifgfnVP4H5OgbRkujethpdBlrS6iFsXeRPvQU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ziVCWc-XaPg1PmEE2FMxaPgcYjBzLz_CeNDVHlsn8zQ&oe=6A2C0CC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyZr2KuBhboQ7kNvwE-t7OP&_nc_oc=AdpGQCAVc2dApZHgddhHZIaQpu5RKDF1hMImSYUW7LotPDPixb6FdDEBoarpbZuV9zE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af876btqi9GCY2oXaoLg_s72-o8NePw71GFUc5B2AUPdsg&oe=6A2C1756"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
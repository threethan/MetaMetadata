nt-fra3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGDlfrXopDwQ7kNvwEWyKFd&_nc_oc=AdrDNSlS0pyCzKYEyk6AVj_4f8inABp9K6fTKpnG-6JgsRRm3q1VAtjspJhylau02qQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44mUfXMBEaRHwOk-swOfzjjXPodnzT6CyXL5hoQrEfGQ&oe=6A1C4A02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MXjWii3H7QQ7kNvwFKHz1u&_nc_oc=AdpyAL28SJS8VooT8ro9CFPywxs624tQL5hglCi5ZCIzz9QD89-GtxIzFTJmfq0EGco&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52i36-vyR_GOEIqeTRuzUHAKJ3y2uF61VPnuSMCjXw6g&oe=6A1C6115"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZpFCEfFb44Q7kNvwERXvAd&_nc_oc=Ado1uT_zZbdbWaDuxHPa-K6ptIJTp1_KjtkL6rxbItgNcZKvsFlXvQNGgJ6hdqyorcc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pyWq7lNvFT6eG9vRBeg9DJ6QxZMaX8r9UcgSB1wGMjA&oe=6A1C304A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qsko_5rj-4wQ7kNvwHmmmwc&_nc_oc=Adp9XRM9Ds_UEJweVvkPOvjR-scgQLyfko35cgcxDGvO_9eP6pTL4K47UrXVvie2c7U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7njzitd9E7aHgujPJaPfDimIp8EB8gv86W31_F7LP-EQ&oe=6A1C3AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IgB9QG6mll0Q7kNvwGRhjcv&_nc_oc=AdrFndS_mpeENFB6sUQBYl0EDJ1r9fygI98EQ0LaHbtgI3R7iB4NqncqylQ4YiV7lNE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UuV0QIppBWfX49Av90B7sZc56OECaiEYT6GENfoOaTA&oe=6A1C4556"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
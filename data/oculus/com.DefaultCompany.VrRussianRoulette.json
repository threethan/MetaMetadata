nt-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6MIVGfTqCQQ7kNvwHHATWe&_nc_oc=AdpZUXioaHDSA07PSXuMkeY2iO1NJCHUbkZ8ie_5noqQeFzD9Ykc4BvlwRtelgDER6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cX8MjlkPm4emYdjhn0WUw-s4l-5BkpDbK5Tdc7zriMQ&oe=6A43D702"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMu4Y6EONXAQ7kNvwHp8t8q&_nc_oc=AdojeUVhXZ6wk7yRPaFjdffnNS2E_9fgRGA6qvABksuzlhX1thdz9kqWmiWJ8omDVAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S8ywsfqUS51GMiuoGx0sFt5rI6UbuR3pYz4bJZsjpQw&oe=6A43B5D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AeqI-KFN8_QQ7kNvwGdbuFZ&_nc_oc=AdrqdNPIWc3peNFY41pHE7RrKND9R6FDtnBic_0Y2LJ2tjNQ7gDfdwb_DIiMoz79sV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kJ41G3wYgt1yQ3gufckQawrupB0JJGNttuA1E41igkg&oe=6A43BD4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUEDejBvehUQ7kNvwE02cYd&_nc_oc=AdriI0vgqzdWz2bec__w8Q8gArk1qP3iMyVIwu_10oyrorydTEgbtmTlwj3pWg2zMlE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-becHMKTBQxaP6O3LC-0BuMXRnYbXGo6n--38wINCHDQ&oe=6A43C7C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgP55uigiJ0Q7kNvwHS9wCG&_nc_oc=Ado5vH3cL4ET6IgeRGhtOgprJhdaGAK5BN2lfKCfu3_8zDvnObYshaI3n1jvemARJ0I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HP5N9HkdR94jubaV8oie26AgSYqo36Zpt0wlpBEl5Uw&oe=6A43D256"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-fra5-2.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChRp97BBF8IQ7kNvwH-45u2&_nc_oc=AdoQ5djPArB_5GVntms8Od5Ppnv2Qx0fnJ_k4IM6nETuuVpDz97RvwiD4IljMoSXbKM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwBP838JYQ2vOTZac2td4O9Jw61j8cQLF8F-WkB27scg&oe=6A58EF02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1wr1VphZLQQ7kNvwGzYjGx&_nc_oc=Adr_NNpDAHXwbQ8-vW6W4W5SM-dfBTS4ZLi0_BrjSS--jaD-Xmot5QbIm548zB2Tamk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJo_4V8O5lzwsojfds_-J-No8WxAj-VxtizgFmRciq3g&oe=6A58CDD5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gooSRHPLpoQ7kNvwGT96Pp&_nc_oc=AdoP6cLl0NAsO9Ku9R7KlrkFpbBpoymJ9_PjgBK6PxRASA9cIFSVLUlIMC1UNxhSpaY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSresdZwChqkVdVgKIYxeMc5y-O-tXU_dl0OcHuataxg&oe=6A58D54A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uFD7sYv7KoQ7kNvwGwR9e-&_nc_oc=Ado43m06yGongCE9r6PulvnSNyWczqpNgj4bXGOEOl3U3zacO3WJn9m06cqGn02zMMI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrEm9Bd_2B69dtSbtAdK41blcCRLrJUowJXi2xZLJwfw&oe=6A58DFC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29ywALoTD9cQ7kNvwGwTy8W&_nc_oc=AdqajxTlmGrY-yCIjh5sTO1dJ2K2dPLuUD1CCxGwZ2rY0BrpS8nZrrQm_7S68jXCMxQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS8yev9hWxj7_cvNOaZLEjcgDTdt5AK04KRncIcAS5wQ&oe=6A58EA56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gANmVlI8VuwQ7kNvwFsFbJS&_nc_oc=Adql3xhL2rOXz_3WZbPfpk08haP8_Hd0BWDXl_Ny9F3Y-Ty8vNlcJU_vPVsZQh2Q7aQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsZ8sXHBStaNmx7ttPZ2YNYFQgm6QCifcj2B2Cx1sbyA&oe=6AC3B882"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFrEqffHoj8Q7kNvwHhk2lq&_nc_oc=Adoh8qoSMDZpr4nZj97_T3gKKshLqsw795QFcd1P1jdc4OFqZo2S-RJ8FfHlOGoHVQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMst6STFVuybjvFH-OJwMnF0Y8Va_VVQtbaplSu67Rx1A&oe=6AC3CF95"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-LmHEhw6zwQ7kNvwFTnakH&_nc_oc=AdqMTjR_kSFi_aIjzquFrFKOvJm4u5MYUZBjoHFTDnjCqv_uGgGkpkf0j-jf4LsTKDU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfEkgdwWAgE1djtOQQjq6j-hyewxUI3DpTQybkVA1QAw&oe=6AC3D70A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUov8rXYGDQQ7kNvwH81CaX&_nc_oc=AdpK7Qbv3ftCWh-62IvNCuoSkmFILs4Vtkc93Iht-7zSAFJwErzHblHA6WdJ4wWbPVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEznWzdOimTNkdsIbdb0M-IYiYOAeRR4j-KlZOrIs5dg&oe=6AC3A946"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtFAcNXdji8Q7kNvwG069AO&_nc_oc=Adr3BurG_qsbg1RQQAFK-fyHV7N_h0GkxA8fl2DAsphq-J8fOHunofbKLEPSrqvqAbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDw9jdwt5s9QWhw3LLvOEB67eg7oR_TamD1iEx07n1vg&oe=6AC3B3D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
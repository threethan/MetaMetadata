nt-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRAfiXJAgaAQ7kNvwFnCQ6e&_nc_oc=AdruDxeOgIL83CRW_fAbxUCodWREiIr6H0KFOklW9FNAo_Y_xQLdko_AM7Xv-kiy2os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJz_roRNSB_GPb11VCp3kdjLcGS8Cr9oPB1DE8uWpCsRg&oe=6A998882"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUQpLPQ8cn8Q7kNvwFhX5Df&_nc_oc=Adqyd529I26VXeS7ovrZgNshQWzmFSBvLSbY9Oz_kx48cFyh7fBkDmLBPqK16gWBOuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKudzrJkmkLm2LKE2DfojZUdW_HLlURM_Dhy_6ZGixwGQ&oe=6A999F95"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFZFq-QAd4cQ7kNvwGazRYP&_nc_oc=Adrf9LZeeTZgE_UmSFCjyMJS9BziG5SYZ27Wu-qcGYWkdK1iHxoXhX3lsPnaZ6pGuPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMfqLTHoiEaSDaocKtPrVgqWWRRXxhmNAdANTfeaErjw&oe=6A996ECA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJxTYqK0jxwQ7kNvwENv3C9&_nc_oc=AdrMzGxEw0Kiss9DwBjk2SqMXRBmaFWL-jcxbPbwcVkPefp6Sggic0c_WJslrH_RL10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgrEn0eGgYyr7BUGS285IRdNWIHZahOPo0UioD7VOHIg&oe=6A997946"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKZUMP-g6IQQ7kNvwFOd-o5&_nc_oc=AdrWxhjL5A5rtRQzz8sKli5AxoHRSsJh1TlKkXYzZ_iCWzk5ioj0MadW6yaAPChp_kQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA5KMAk8x9mO3xEbgi3SuMgRke51A_qILGlDoe5sKTRg&oe=6A9983D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVV7QebDtLcQ7kNvwHEq9Pk&_nc_oc=AdoUkN1IgN0uCX65uQ4_ODcmUNzI7AxDQvrT4a4kBgKIdFyAmv14-6XydTUGG2PiVmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOtbmC1aUQIukcz5bwh3vigsQKpkeDB9Fyw3rMoicuTw&oe=6A789302"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OiyQ9t_cvEQ7kNvwEZpdrQ&_nc_oc=AdrACB3MQ4AXGPShMWUuMNvtHY7XNLYReXkFvA5DDJ-t66TphCfeakJTOvQ2fZkZ6jQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT1Ucd9t-j2l8FAtGDuq5PyU3qBkI9CZJoTD3RNnp8MA&oe=6A7871D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI20dWFUeAUQ7kNvwFkN5dF&_nc_oc=Adq6nElSB_LMUOSJKknw64T7wyabOuowek_JgMeX0VKWpOpe0MGIMG5-eJXuEuek97E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3bbfi6EtvEHczq6Xe7vTNK76zxVW9VHUARPz0ZXbBUQ&oe=6A78794A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0i9xoagZT4Q7kNvwGjPaXq&_nc_oc=AdoiRUX3Zsx-6PydgbdaKAP0x87iFNPF2T0P--sZ41dNNFfIAOjesC8gUyRmZE4gnhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIn5Nd2BvNmBOpFPQP-DGkmbLW2albYsMspYR1mpNlgg&oe=6A7883C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XouftbCLRukQ7kNvwGv0nbJ&_nc_oc=AdpiELVstwZDTLrKMZCezNOaOWfoipX6iPu5p9q-KPZ1yEZBwU7vhvHLF1tNf9kbFY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKsTmk5xCHMKlJhe6xVo-n4dvq7Aj6tXQOcLYfcPxvlw&oe=6A788E56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-sjc3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBtBbirGXEUQ7kNvwGEteE5&_nc_oc=AdpGqahcmNjlm7NqKjogswt8ThDFPIRo-D5duTudusy46V1Kj5UiVcPZYj53HUKgFxw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7GfYIsv7j-TGy1oFl3J2eTungiAuiqNbLtSMf92o_yw&oe=6A622982"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuUp45ZLZE4Q7kNvwGesuro&_nc_oc=AdqKPheuF-fYYLDj2ZPyIalSEv0EjtOZIuMRTDDKcruwmHbg1oe86zumynkNJPtjNyk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvVrGXURLwfH_ldTMtPPxM35ed2cMNBBiXDVHEbkVPsg&oe=6A620855"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0VCpobjVzwQ7kNvwGHWUWZ&_nc_oc=AdpJ89w6l05AbOdBnY0Rt0YT_xtGzWFqBKTjjtrj_8pAD-rG294xodls6BCSwZB9-uM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzWBg-bytA_iaESPZa2N3qGF1MR1JSL87PavvT1dDU7Q&oe=6A620FCA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdBFtoz2gl0Q7kNvwFaNMqt&_nc_oc=Adpz0NOPtMJ_o4whQ19qwL45RrJ7pD8lQKfcIG_L_RMhXyOd3pWn6fyp6lJuPiMrOTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfqLieICu0droDpgJ2MO2LZ5_xmrm1p3wi2eR3NHxgIA&oe=6A621A46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlvO4ER7sCcQ7kNvwEumQpy&_nc_oc=AdoBfg6Ll9WwSGjJjnwaZL9YyEF6y2RqP4WMj5T5gCcEcBXODa5kgY0e2r8IrHHG4jo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgSMSgPm01ai-ejTAKVJQ_4FtdFjiG_YjDz58OE1YK7Q&oe=6A6224D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
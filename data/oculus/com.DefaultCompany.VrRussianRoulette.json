nt-lga3-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRjGBnSrVboQ7kNvwEu5I2Q&_nc_oc=AdrCWLmAG0wtVr7ZIEmP--QMqDbI3gEu_rKQkFBzQ8cvmgRckTYt-7CwojdNk2Qj-Qc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVTibDbPq02d8KBGfQLLFDcmuZ01jTAUZEViasm9wHQg&oe=6AC7AD02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZj2_X3q4U4Q7kNvwF8yHAO&_nc_oc=AdrVyUopM4fX7CvhrVh8XsCppsk3bEI3Uqzjsy_iw6EXtYrW8IBrfZLD_DVELzsys0w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaiGrhFC-HkIY6FMOqKUZMJT6to-hubg6yjvrcgOPOow&oe=6AC7C415"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtbX44kzv78Q7kNvwE1z1os&_nc_oc=AdpgFRxPjOv5lnQqGLFxVUeblXFpoR6xREUyw5jE6Bqu4D7eIEahqACFBeCWKnalGAU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxbe4lnlK8q05anFdcO2X0QUqCJN72PJH5oBrMSU1FFw&oe=6AC7CB8A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEHMHjCTYs4Q7kNvwFSOKM-&_nc_oc=AdoJybs44SpPVZpZPSgbVT6sLgtI5gJ8jZ2aHdS__38hBgxzHsWeAVJxY-sKg0VZg4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkMDUMm76OhV9Xn4SdkOnq0KFa46ZBKQp8erXcBxYEig&oe=6AC79DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv9podLgSIAQ7kNvwGUKLIa&_nc_oc=AdqXWhyeSSI_rgm9nfa6DXDGAzLobocsTz3anXwkjiNtKAfl77Y2DcNRHMcauWhDBt4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjGAi2XAISiyE5vls8lBPZURUieKJFcOderPIcDAQtEA&oe=6AC7A856"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
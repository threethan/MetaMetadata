nt-fra5-2.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX9SZab4M7MQ7kNvwEu776G&_nc_oc=AdqGZhai6sUs1k2cT1K6u0Sj5zBGMitOixX3R2eyBDSYgzOlbYG6GxqxMOhkaGzzD_0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_XSJ8K72uuw-XFLAONA0LZoamr6bpNa78vZqOJSXViA&oe=69C7B1C2"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhCICDbEeQgQ7kNvwFoPPR4&_nc_oc=AdqKTx2wF1WDo3BFqIdTLYQIOvrppXY_GBn3hrnoFr4VUiREOIpD6R9AqAZaFPG7o98&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy2KA5Zf4yXZgP6eyapv_OvfkcqqVmdXrnMo6kBRv6E4g&oe=69C7C8D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7pgLy59A1oQ7kNvwGeqZQM&_nc_oc=Adq3bIvQAChDzSxZ6Rp8kPc0RN15OkZ0zDwaun-z0n0iQecfoQmiA_CAevIIcxxTRlk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3puRKZfIp8DptAkNPIm9_3eIU29Yx3bw_CB-zSjGcOQ&oe=69C7D04A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHqbRObK7rAQ7kNvwGOSRKn&_nc_oc=AdoorRxCxBnTqRhgqlCd3_ylS9BG6TVJY1VmbqEaJwKbrJNR5C-5P3LkJyDUWunRp9Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5H0Wbptt7CF51RCT8ZZhnqIWZRbSnVszYOoSaIsgBHg&oe=69C7DAC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrZMV9tFPKwQ7kNvwGN6Vql&_nc_oc=Adp8ZFtVdJtpfYrxbhraWJFoNLNWrRxpIL85Atp2R9Y2JLd0CkuQf4Ld7fONDkRmXNM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_lrakhRwkhM5BF3Z7EK0z2CCilNtOCrYGpMl3peXY_g&oe=69C7E556"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-sjc3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFicaDRHOEAQ7kNvwHcrf2P&_nc_oc=AdrcJ0Bt-MORZA42ZMmoja00w0Uhq2Th1uD7M8_-H2PhQpr4grs8ba6LQV9qvIqWU-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX32VLxn65JhciJLh0Q-VnbZ1NzYh9opz_WafmalqwFQ&oe=6ADE1682"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrW4RAAVABcQ7kNvwEIe3lD&_nc_oc=AdqUVcVAQbxW3g8IeWRs_Zy9sgg6q92VhaK4I46A-k9w6iliCUtQBYjk8elC2CBadVk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg1IRacWe4btihe0l8eV2PDP7jF-rdugTktQnNUhMfcA&oe=6ADDF555"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06vaSVBdnZUQ7kNvwFqoOS2&_nc_oc=AdoU9syywTKhk4bUuL97Syq1lM3DVCT6DurA6chrDy0xHBmK8rsTrAD_CWpzxheAE8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmuiKc1F9FzjqBhwBE3_R42wGZ1hvG3Cn0eBcYnUIS9A&oe=6ADDFCCA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bah7Ry5IH4oQ7kNvwEig6pi&_nc_oc=AdrfrziMouMEuIlFrLukCuGMOIjz_37smdSJ2UiZLO7HBLcwd99V9aLpIVZ6oEsrMXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOidpPZxmGsX5Q9sRqSEOa1DQYmZAWOESd_GWydE_lXQg&oe=6ADE0746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4tlLvNh2_5IQ7kNvwH-kd9L&_nc_oc=Adq4ERrvnx4RowvT09jRy3RbkTfkm9E36MRBmO7nPW5npAzXFugttBqGNzAp5q_9tzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJ_k9RBWmb03sJQoh7fhcNozw17opxcQlqO3qVwLjPDA&oe=6ADE11D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
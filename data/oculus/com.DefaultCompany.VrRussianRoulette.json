nt-sea1-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4fltEX--JwQ7kNvwHXGwu2&_nc_oc=Adpa8NXGvpOmDpDUqkmzMjpSkoYm1MfTraE8IfLTbFDPUEEkq_aAGttht2rjNCMuKt8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNPJ10QRd9u-PMI24NjelnIResLmo5Ly-KMEYkS5lLNw&oe=69C26BC2"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ7K8zKacoMQ7kNvwGzhTc2&_nc_oc=AdoTo4N2N8tdGLz1njxXY9CHP4yfZTbtRA826I8Mzs1vb65ViUsQV70Pz-4KsW5pNJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwtb_uEkbdh5zaxLszSn9c-25XU611JMceca7fZlrInpg&oe=69C282D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpsbbT6n-UoQ7kNvwE5BklV&_nc_oc=Adr7n-Rok-Ub_O8UFgSzF7AsClGUsREgL8-RXiN65sGsC1-iYIuZklv94udH0cn30bE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYVqHQ-PsOHoISYzHDg4BiQfEIB8WX2w7_4BXbdbK3NA&oe=69C28A4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUqaP-Yzh5EQ7kNvwG0iS5c&_nc_oc=AdplvH8jH-dByfFlUQRMXGzaVPf-hduS-6MDQQsc1BJMDWIC4fug-2knBu7szkCb7KI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEg5Cu8iUjZTLDBhCrca56bmJdcem7Ce4Qv6TxTKeKww&oe=69C294C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk9Y1r8OWOwQ7kNvwG252fb&_nc_oc=AdrwzUsbEygzUwH_U1fC3LFPsAYD-mplk_F7Dz30_d1tYD6h9mVMb32PIhAMI_kqj7k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHiepJF-97dEa4rbh9A1IjKlGq92gb5DT11OXFvH1uPQ&oe=69C29F56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
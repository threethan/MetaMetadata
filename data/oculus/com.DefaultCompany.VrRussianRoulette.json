nt-sjc3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGxhw1dOTl4Q7kNvwH8V4t2&_nc_oc=Adr8YvX509KBpISUHueozdeEYUE3kb0y9DT_G1MU5FvYOLhqfGsQUY_Abb_sS3_gQ-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ09K4zIO-wa-nhtghO9_W5yXIjm_hV6OIjxwnEM5ZkSA&oe=6AB29502"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvfTf54zPBQQ7kNvwFzKRtY&_nc_oc=AdrM26VRrjYzlpjejoKpDwfwNR8971csuPiFMqEnrXuh8rxseExRD_m1a2VExcllcA4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3yo_GBdZNX2CSE2UP1Z5SqRPjPC3-toIYJC3nS4EagA&oe=6AB273D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-6l7YtgTZsQ7kNvwElHz2i&_nc_oc=AdrGH4LmMGQbMa5yUE33EGZkWVdX4ZONKh51wIsvbKL1mFrcmbUzqCW3ibNGvGVCWYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_tO6_F7qo01baPog13T0sRpvXvXA9YND78l8cgAw4Dw&oe=6AB27B4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TKBiSZRUV8Q7kNvwFOoIM_&_nc_oc=AdqKU9z2JnXbAnpThMD7RRNEMRTLFZSyQXvMBQLhjWHt1b1p9y-vZBnMrmtxloyApZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDm6wXre9bY_2UV2DtXjyevr2mQ9vxdg4QAUtbI9iksg&oe=6AB285C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNlfr-4nokwQ7kNvwExjMXa&_nc_oc=AdqCkjfWBuG4eobVZRaqjeJN4yMv5W-GqlHQVD4bebV3fDc87AOt91EEW2x71DHEeoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu5-6orUyeF0LUfxgofgKT1em5mnUceoCj73gGyNpI3Q&oe=6AB29056"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-atl3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MR7B0QonT4AQ7kNvwHWvYBV&_nc_oc=Adotl5XA8BnRxw4Z5t_nPm9ea5O0j1Iz_O9nVDVbVgSDPcVyOg6R24AjKZCD6wvYJQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyN1mcUGnB_dhOME1gTN8aNvkNbICX80v7vpMfo3M_QnA&oe=69CFD302"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQyFwO6_JW0Q7kNvwH7EfDV&_nc_oc=AdrwMaYUmFlo-G3Ow-J0ln7LWeDqTLYhwzKy03PrMv5FwJcL4PUCc2Nsvua9xCbfuDM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVD29lEF4D-dXHCjzL6OSz2MOoSbtJkxka2bKQLYrmHw&oe=69CFB1D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoQ4eEyRTNkQ7kNvwGTuPrQ&_nc_oc=AdqGjKXBXYqxWxBWs1em6OVA4s22bFUkFCxn2VHenIi8FIlL12h8E1wSemhlXIlARZ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyluk7Ktq2yxAxKaYTmzOroCxLkyvLrrvXoxK1knU22tg&oe=69CFB94A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jZimkCckxoQ7kNvwHSrhHJ&_nc_oc=Adr0-yrePW1h_P4aQBbdTi4P-lBqmvk_1ItKSwkYLquZKDMoOd44yaWkw9BIaa1qlgs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKWIUoX-5z0fdX_V031_snnRx-xKj17nHL3zFSzApKaQ&oe=69CFC3C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEk0C9OUxfcQ7kNvwHVy-zs&_nc_oc=Ado8ou3CB3PSnMWqi3YlJAdt6gr_xj59gxTDEi6kz3P7WrNV2KQMIKi4xo0u1LLtBs8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHBefBYm0VEBg5wywHIeErPKUWEhQrbnLML9DCtd_J5Q&oe=69CFCE56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
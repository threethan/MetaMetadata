ontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m4Yl8-11mIQ7kNvwFtezV1&_nc_oc=Adp-EEOeI5iQw7lKsJDO51AzyFNbCSMlNcDAILuSFBOGi0BMjdZNUcSM9SQxuvI4nV8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-tNiPEY-Qxjtkk60jW34_-k_TYvzngli9_nkGxRMW6g&oe=6A7DA0C2"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7t6x6ctYVNkQ7kNvwFazwyY&_nc_oc=AdoLwmE7cI0cSnCHTrY3pE_Ycs2FE37Cj9jR8gWzxX35VMpHq_zqva4MA_Xlyi4aD0Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkFkD1ltANggM0jjqOox4y3ZjSv1c8jdaT-jR6Q-LnDQ&oe=6A7DB7D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLEVtAB1rzYQ7kNvwGjMapl&_nc_oc=AdoMBJjQKxHlrv2z6i-7EMM3S4Fe-0XVqcLyjp-uULI_-K4TTarjM8Y_ljN_NNgfzOU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMyVumQ_LY9o5W5HyZjK28jfhvy08A1pApdK8pw7gX0w&oe=6A7DBF4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lp3wDYw_MhsQ7kNvwFORZFI&_nc_oc=AdpDe4oBdvvzYtrp7-m6Pa8gnjRyEUFCsBbEh_z833JsDU8AGivG7OP_JkRzUDGjOxI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoaXa9FgM20cdhyMm84o0Mn8u3LuOJcKBnE_cokHkvcg&oe=6A7DC9C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyWmdOGKUf0Q7kNvwFzBGVS&_nc_oc=AdoZkk8O9DmnaEMtQEyIgAETWoXryFHTnw6SwS3XSaW66mjaBwB7U3RlYd8Fcc4-j7c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYeX_G4qzzpfYVWkK3HhR6lYJy4IxI0ifDTX7kMvdrIQ&oe=6A7D9C16"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://bl
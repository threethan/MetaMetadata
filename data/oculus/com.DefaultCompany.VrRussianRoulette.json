nt-sjc3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HR3BXSTYRjkQ7kNvwHc-0cV&_nc_oc=Adq2ncOhYTixJR59h7N2P8VOU6aTDvkNmx-bUyWZnJVEeaTIdlsV5ckb495vEAqIw4Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKzl6h7kXs_b9GGPPfafgY0kKB0eaFrgJh0A0abnPA4A&oe=6AA56602"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2anWgLpiirwQ7kNvwGb6Cn2&_nc_oc=Adr4lClsmOPo9DuOqfvpxaU-bJuE354uXI-hMjRjIUTTlqzg6iwXxg8Xe9mojQ24_Xc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgJKd8N-1tiHvk4-Tu4jhYO8V1wGEnFCRkE5LD3wY_Kw&oe=6AA544D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsaSCLxxVb4Q7kNvwEpnCu5&_nc_oc=AdrIW6acv6RyWMYGWVY9bjySxF64JW9FF_iaFpgfEIEv-wUiwUqGBMnDqx0-wC_A_xI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcEdYtuIFltmt08YnEjreOce4b2gNNF8SAHqR3_Tmn6g&oe=6AA54C4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6ApLWhH_EgQ7kNvwHqimAd&_nc_oc=AdqMrsgwbUiYwwitE527V-mZ7vwVIZsCcuKn5ednLw-ysABmVW0Wyg9e_epkLLYPwL8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlCJjv79gyYbzF5XO30TQoXxT3gyko0Qu1ZpU85wWrJA&oe=6AA556C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCiQOArFn3AQ7kNvwGiwLY5&_nc_oc=AdpbVKnRLXho_IJ8mSY4rEBnGZ_DdaveOFEuwJPwZysL2INdQAnMyzasjwoDQp8MgYk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_6yHS41khh847RcrMU-w6OieNpPLMg7sJjr3hbScPVQ&oe=6AA56156"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx1CEORfrkAQ7kNvwFFpsVS&_nc_oc=AdqoIToL5BD-7RK5d0wkWOvSUvDeReAhg4RxkM--5qg4c6ATv_cfoTkUKIq4gpSxfUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAfDPh9Mu7DCWQIHWtQmBWbbk9uS-dRKF9ay68MgIyZA&oe=6A6A1282"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbUO8LzHyiIQ7kNvwFPR-PS&_nc_oc=Adq-ThtrhL4xSZrzq3APj_jRVQ7yzwD60VD6Zb67-bQzL9EVPX3ddvZXAr08nJKlZ6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_FgpFG_g0CWkNoCHsmz4NImgcJb7Y-oVOTeaZhWsJuA&oe=6A69F155"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MDeE_s43vsQ7kNvwEeSyNj&_nc_oc=AdodxBpte8y9DEnmeoTKt56vfNJoT8NVkrn2_0GL8qOv3Di0F62HQN53wrxwHjBqDmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJIOfGVyciHiGidcYxqiTbweiIpXQAan2KFc_TP3Rpmw&oe=6A69F8CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyXAHVTAePQQ7kNvwHYkeNF&_nc_oc=AdqQiNFylby07sXb6Lp51o_0g7ijxEPrkK63M6w6BMyGoVVj_3_xgSINc6v2N-j0ExI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8pjzyrUByW9oIs7q9tRDH0nEY8NPYuvZrZg6vc-2EIg&oe=6A6A0346"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNKIjF1jzqMQ7kNvwFhgR6N&_nc_oc=AdqIfprgLv0ZvmAoAQzWGX3DgVQM6WHUuwY6-jadCIkWt8LbQH_z2JR_6g94e0JCtiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVaW9XsHFyX76-5RMnpCtehW1KPGQAJAsxKycfHamNKQ&oe=6A6A0DD6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-hkg4-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqKzZCNxSz0Q7kNvwHU-fvE&_nc_oc=Ado5HL2k8JmZxccJft8oZjeeYVJ0xKxt_9eFC8ywgdTBq7OkE9hCjY4ZRioXzlbtVqw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHze5U3u5fwaYeFYpfPvZ26FBWPY5BT8H4nMG25J9UAFA&oe=6A916742"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5R5AkCCJnH0Q7kNvwG6QRHm&_nc_oc=AdrA7KBf4awWDC9_L16EV7p6pYqaFndlJfkX9zuoUGsrd95TyBt5uL7kXQP2OfevWLI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdY7mlPC3zGNLZ0Q9J-bYveH4Jv2AqY4komtGQ3IH0wQ&oe=6A917E55"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9co4IPGvVwUQ7kNvwGt_QDk&_nc_oc=Adr1ty83sXS07-vLMI4QGPpnQ0kGeyueQ2ruWJyqQiv407_aVNml3jewrOow8gBbcXE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzoauEA_bRUtexhrGn1PHHMTHS2FOKryPCVwzYsdTgqA&oe=6A9185CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vhBwb71TcwQ7kNvwHkWh07&_nc_oc=AdoEoYfHKAazE4WJWu1qnTXpJDGlr7ayN1ylv7Zr1YqpPo2eK0LrCLlLbUCuVI4TWrA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKYxKhC-oX4UtdXz7L-2_wR4wRERyvhiSB6t3K4kNsaA&oe=6A919046"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of20iEau7fgQ7kNvwG2U8NI&_nc_oc=AdoaIv-qBvkABp4pf8tZcYjG1aVvCF6MMyd5UtHbKPUbO0hZdY7Ej6XiPLtbW4vsz38&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQCTUeDm5JkNXvelVqtorEXVaSQkJxNA8jTLgf-kLLwQ&oe=6A916296"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
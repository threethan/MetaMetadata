nt-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7MwfKHJZjUQQ7kNvwHdXPuT&_nc_oc=AdpeRThZhjBJg2BKs4I7GyfOJ9cyBsDLsk0aZsIvhH5GLAFHJ_M7HbYedzYwAseXX9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUDQ9G8atCz3Axtr9nFkw6k268Eb9-jTvp3nE7wb3ePg&oe=6AC11582"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7s9Kac9y_aUQ7kNvwGp9DaO&_nc_oc=AdqapjC--CQZyPvb9w0NSrtkyoUPmwodp9P4ygvtaRPB52f7ErGoqO9BZmhKh67HCLE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2osOoPwp13TzxVu96VffYFESb18OPQ-dWPOYeibmD6A&oe=6AC12C95"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-LmHEhw6zwQ7kNvwGdbh5N&_nc_oc=AdoequUdPhXTehTmV9pf9DCKd18QFqBm5oQ-Z2qpNOkvkZCdyScvb07WEyHndXD7vbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu-hOlmxtj5FnYA13GAiPapJX6UTlmGsyWO06S-JnJPg&oe=6AC1340A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUov8rXYGDQQ7kNvwGv6yyI&_nc_oc=AdptywBvg3esQw7vzAVmNdgFSqCiiEi16tPJmSGEQPCaWolLbcoSnlmExbD7s_NRyeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVZ3UEAaVUWxVI9UdYTFPQLShCwVOSNmZ5Ig2gn6hlZw&oe=6AC10646"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtFAcNXdji8Q7kNvwH3lzM4&_nc_oc=Ado2tbfDS8a456Ztgf-DqgkmhhCAjZ6q7bb5K-9rGJYcIvYUdomqzqZp46DrUhyZz_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG_0Np4ny69Ason8nzpcWuDY5MPEdyILQk_CnRApr38g&oe=6AC110D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
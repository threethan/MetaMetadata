nt-sjc3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYxTiwaC2HEQ7kNvwH7VMPd&_nc_oc=AdpkS7EOJTs1u7QwmsWh0ZkFQrDaKTgJ2lHhRysq4ImGOJfTCJKFDDYYkOnaOHKapIo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvA-ZpqDpVwiHxAOkno0Acd-PJfkJzizbamTBCZ0PHTw&oe=6A9D7D02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSMFsnhF3_AQ7kNvwFO2LXp&_nc_oc=Adp_k9FETuD6nAUPtsQd1HRLVDNAe0mTxjyDmOaSXkmrpwLKbTifqAnlewaCjZ1Pr14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-F888DBay_9f87kDmnK_Kh0kUKE_J-zMBe6hgehNwwQ&oe=6A9D5BD5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efV4-9PrCCUQ7kNvwGhRyuN&_nc_oc=AdoxDa0vwfM472AXvsOtJPNA30JQIdeY-RUUcw2swVcdafNFYK29vgG297_LXzxWlAk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbw1yyd-_ijA9V9DOAhUEwnJi8R_aQaaPk45CSSbMwcA&oe=6A9D634A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Y3ErydPGrkQ7kNvwGkOkex&_nc_oc=AdpJmmKwDPpycd4xCJKzt3BUMHLD_GTgXD8Xu0XrPKAmGvJzw57rSBGLkIS8Ut2JR0o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJltuUsR7dqz5znjX0sKBlyYA9aIygeK3hxs1hFsXtWWQ&oe=6A9D6DC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6KdOMG3PrYQ7kNvwFhNFmG&_nc_oc=AdpB12foQjCLxW3htwLREWADm8g7COw-tp0FabVyRFyRihoV6tZf6J_ctimBEzdfpug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1fKYMiSDc7QH3Azxo_F_ypMRP0AwPJ-iztNA_wY18pw&oe=6A9D7856"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
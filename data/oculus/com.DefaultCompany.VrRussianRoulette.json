nt-lga3-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRjGBnSrVboQ7kNvwHy3o24&_nc_oc=AdqG6imAwQQDhbeuLFfj5EsnWGXldJWzoBqi6KADT61YpndLLFwYpZR8PlB-A1ydGYo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPok03E4Y3BmNfEzzKJ16zEo3sfQDU4ge2FWEPy_ab8mA&oe=6AC8FE82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZj2_X3q4U4Q7kNvwEZr3N0&_nc_oc=AdpsjyhopLHLMgZYQrDorNYZcZGcG8macp6NckLOxluK7IEag_D9BgZMGyJEcyUxj7w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA__Q_oy-xaFU0HpIkb90OsTV88Dzcb0h7g63mwZRzZg&oe=6AC91595"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy2OEZjYgeUQ7kNvwEihYI3&_nc_oc=Ado7tkpxB8fIhjioOcSSl9QXLsG1Zvn_GbaUNAIuvUKeZijUkGsTCHbrfX214wkzev4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWhSdCAG7htkjzgE2XLoEHmsyHdMiNJHf_frLG_hF4hg&oe=6AC91D0A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CA3oJNFNjZUQ7kNvwFdWH7v&_nc_oc=AdrfFqLw1KPhKM51NPeAeh6A7CUIS-d89Dla1LEmUB0fWbcPc0-J6iHh09wHt_38QDE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7D_T2bACMdcwFWkcl-gIhB0XXlq3W4ZlQE0GXmZ9Kww&oe=6AC8EF46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhWGt85l1rUQ7kNvwFCZeVm&_nc_oc=AdpZT3cRvg_eFIiPuE2rvgd1-Jr2mGaARDUAq_8-e6N7D8VPgCm9Sv6luxdLnP_77I0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlmBh4pUDrNGTm0fA3Pl1Zge48zop3kJIDnys0pNk2Bg&oe=6AC8F9D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
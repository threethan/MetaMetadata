nt-lga3-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmImoHb9V-YQ7kNvwHAlwv9&_nc_oc=AdrU-p7pDfheVpmV5G4-wOgjey09Q6b-anqFRcZ4uDGrepf6cBdCdRdP5LBd6PHcC0U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjbLk42aHg59MC_NaUJCkm05f5_5gcC_7Vh3BWDLN38Q&oe=6AA02002"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wthwzorvvtUQ7kNvwE_lt2M&_nc_oc=AdpZXnw7kaKnKs6mtzKRdlfbaIh_tHWg3RpZiqpMeq6zrBUow0O4MHu1FN7oMgaup-E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQYRPnFXjEkDfIPWUnTy9U1uApU8cxNXDz4eYXdaxYBQ&oe=6A9FFED5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efV4-9PrCCUQ7kNvwFCv71n&_nc_oc=Adpu1TcCD3W1T0o-vqZdTR5-D-KuJADaLeqyfCXHSO5dlhSfk1zgM-6oJGPYk6prCeQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFv5l-TrYxcWEuPoPM5w4PFUhL-Y-G2kcdPF9N8DKb9A&oe=6AA0064A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Y3ErydPGrkQ7kNvwHJgMDN&_nc_oc=AdqKvUXZ9vTDGJDhDcHkHPm66Iags2X_hTZo_Z3bj6l5J6yc6PpOaQn8LTl_-4MvC8E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHzqhOgU-0y9fR79ZbbjfBljs3DovpuYcUJsDa_SywZA&oe=6AA010C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6KdOMG3PrYQ7kNvwF5d4jZ&_nc_oc=Adp-8wwXm_KkNePrmDLxHKAyJ0DDzp5K5l5WCcuj6ZMLsjMT1pN-zfmzvj7gXwPH67M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjd2zGeAjQFf25fKXb1ABm9FuXdXUqpVu_uxy_L93KGQ&oe=6AA01B56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
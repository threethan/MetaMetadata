nt-sea5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFTtH5uGF5sQ7kNvwGviIb2&_nc_oc=AdqHvKbXW4hcbidtusH5xIVCoFyKOW7H-AALGvKPpq2tQ7VDWQZq4R7wJq0kxieU3ms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZfKjJUGsS9CbEEyD8ISoEX8ymQEaqy2TTMVHDMJZ28Q&oe=6AF08B82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhHzR7CciAsQ7kNvwHYDmR9&_nc_oc=AdqUtfq-IfRvfUbO7T7YRUt6QJbgXxpEpRCM5cClADrWTZetYsRjc7a2NmimQ-1jf2E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvUM28QED1ubE8bLSJYPmCmeOvWs965BthongEFBhzAQ&oe=6AF0A295"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqNJunk59jgQ7kNvwG-4_si&_nc_oc=AdpaAB7krJ83VqnkMvHpC7SUovmbHWzYqnSia61HVr3r0J32eN_zKk51i9z_Kr9zilI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCz3nUa4iuGYaWhLZ0WIMlWN51rAb3Ntd8xKCDq_-OrA&oe=6AF0AA0A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb7TXm74ljcQ7kNvwHz6CV3&_nc_oc=AdrdVFciD_ZJFju13yzoE36CIFmZKFg7ZhwcTR073BZ1SVuT3i4_GbzwYkG2RwIAIS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOmiWWQLL8KNorL-WJUwaPXtSU0a1Fo6X-vCpt9_eh9g&oe=6AF07C46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y8GSoVnJpIQ7kNvwFaj4L3&_nc_oc=Adppwc3q03vOQOGVtC9mttA6XDrmcKwcX-nPlp9nB8bu3Z_NS2JWEfUAMZq2KJ6LNhc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJgFxoFSCFqt_s2Ed2T0nWhQe3C2983lIVfU585kD91Q&oe=6AF086D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
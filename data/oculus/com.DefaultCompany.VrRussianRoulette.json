nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KkEgh8mUqYQ7kNvwHtanQk&_nc_oc=Adp4LwkhTWuJcuUDXQm6h9BcHLYnx4I3lkjL8CcKygS6Nc6awZIMDTC1fw0SrfVSEdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFZamdkw2mn7pCRbZ5DeCHLToVdhHJs_ettdLZnJA7ug&oe=6A7071C2"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_WcsIe4sMwQ7kNvwFGPMZt&_nc_oc=AdpumaWBuTrOQuG_9Z4ushM4xrI1eGRQ-ekmBiCVUUbUeD8EotaSSnBoHYxbpf68phU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIawwrVHwsW-mGOBeleSlX1DmaThE2tpFmKhEYaesSqA&oe=6A7088D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZ46JYTH-GwQ7kNvwEK8p-_&_nc_oc=AdqgMAbjgI3sKfyqNTwe9eJmb5niJnW2wS7ueNmvekTuJE5ew3IGtSq02CZBUEbGwlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7Lwn1HuQUt4OU7x_mmi5QW1RBnskcexfqqJ0l6cN7Pg&oe=6A70904A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZ6IiU328T0Q7kNvwFyugYI&_nc_oc=AdpQkU4uenv8SvCUlmd9J6f_dVKYOq7x-GgwDtlSySyJe-4IzLn7Zw01arYV1nU3HRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaKgn4UHKPGYtniRqfzRvqJDTLrT7fEzutPNK8H-Mhbg&oe=6A709AC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LwWCWLDMAwQ7kNvwHTzBZ7&_nc_oc=Adr5R3S6GK5qn4L-jVNRd3JkebJx8HWZY2wU39Mv4D-ROKdZoFkPdYNhMbId2tzukEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEwF2VLNptj7bV12WpYWr07SjW3b43T1APp6WLqUHqCA&oe=6A70A556"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpQ5P8hclNEQ7kNvwFCBQR2&_nc_oc=AdpzIzBYaJMzP1e-M0r7sh4SWuE5lSKgSUN-d_l8xOx0RlyCjpZj-p1ivYw_Ab9XMgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwuVf3ciZ3p4fL1XpCGZstzoA1QCKW5Fzyc6EAkLxD0Q&oe=6A95CC42"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dzv1WqSZLuUQ7kNvwHjWi3v&_nc_oc=AdrMruOTQxoIN-PmR81F1KqY9tndZda7AiJoCecW3tDDNCsngYetf8MrmLeAQEIHPyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmGmq4zstfnU_vEEmD-kuYvD-8-IQXz8JblmZ8bYRZvA&oe=6A95E355"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvAZWIQ3SQcQ7kNvwGCG_VD&_nc_oc=Adq07zZ6V0uZKI2cfYGKNOzXWjG96qHceJDSE9xHwjLsAVp88lihiaZc3Opc56XtAj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeiW5zmwGrsiH9urMT5jDCH_ert8iWsHofFi3zz3ZShw&oe=6A95B28A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1KSw4U94O_cQ7kNvwHz-dWs&_nc_oc=Adp04tDtRap_2TWX18KM-F6NQ3jZC7U9TPW-9-0E1EygtlUwS6oM6IiiRq9AmHXYYI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlYr8x5iwLQ8RotXgVvkhIgVtZeBcB4YFgsIQ06AjVwg&oe=6A95BD06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQfyhGCuYzMQ7kNvwGBOzbx&_nc_oc=AdrPH_n6MjIJl3Lvajhv-dhKfdaNLWy6ytAV6Wu2bV3SQvI2TR9sJp-nfCdmNYJ6_HY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFk0Z_s9wH5g1Ilv01dhA6rD9pwnPgZbqrU-MpPJJOcg&oe=6A95C796"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
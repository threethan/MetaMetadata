nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paiXcg0xpxAQ7kNvwF-pI3f&_nc_oc=AdoD6uAnFHO-IhI3lQKzOHi5ARDxA37PoR829bqNLzRwyTickbS-y-McsxYs7jMDTNI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yeNVns93YSX3PkF3FunbBX2JCnAfObO7Lk6IfDqaS4g&oe=6A3BEE02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjKHoEB10JwQ7kNvwFY2aR4&_nc_oc=Adrc5S3LMieMg4tX1E8Y7N9sv7fnqr2HIHEXzgdMEDK6jfcZsYhOXLhTUcB-4tAa6XE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l_4caQRCrp-ym2OQ0lN-w5a73KU6iaENfld0Epm-j2Q&oe=6A3BCCD5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGLE9hsrwTcQ7kNvwHo7Gt1&_nc_oc=Adq9E8HgeZ09IicWwFGohO-tMnOoIOzfrY2fqwzf7w2c4ahnmnalfu_8PBhGWosa8Hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U6udyCsaH4wNBFUwW6ViPIw03WAzOqT1F-xBZf9JWJA&oe=6A3BD44A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahpHlf8KI7gQ7kNvwEqzBU_&_nc_oc=AdqDEKDt8QXTBDLDX1Bdb_V4k22gjuaRbT1YcPZztjInhENwn2Cgp43LP-f8ogMmFpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BxvDquC-TeXZYLvfHT75q0ISDQYTbEGUoIPLDqCl5XQ&oe=6A3BDEC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9kxtsJLgVcQ7kNvwGhnNqB&_nc_oc=AdqbBd-hMB5D5wxn_z8pSiOZvuHAEuXhemJ9CvW6ZUEEcq-1cRMz3akbuQC0a7q92lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bbHrzirm6KB9TNgqK2giNDnzLK9n5T8HMt8zNzDMwyA&oe=6A3BE956"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
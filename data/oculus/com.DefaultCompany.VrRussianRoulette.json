nt-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGDlfrXopDwQ7kNvwEKhfti&_nc_oc=AdrBrHgHX03Fm1FtaN71nBS-7jpuSYCDRJibct5HOQOu4hk9IQutRLwVk10Jd4MtPQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TLhW-xk3pz1PIBHr0HuGhhh5HjOzkYW-3ROHtn33bTg&oe=6A19A702"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDTzmeOKw1IQ7kNvwHk214N&_nc_oc=AdpBIpNeK7kdI8BMQVYDyJ6_EXNRyJN9eUSNkPR_Dn7gEOfpsoTUV7ylMpMS47gR4OM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bbjnSBAJ1Ph_niAz9p2BKrqt-wScJzXG5uaIo8EYwBg&oe=6A19BE15"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ4vVRtf6CsQ7kNvwF2B6lk&_nc_oc=Adq0P0BXEQWPpaos232hwhGEnJwtMhhbrmFzOEXU7aYpEmjxJRVfUaDnRY9GlXQ0gqs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77-WO95jLS7fM5seLPgFYjfgvGDrmv3vE3Z-BUWfFi9Q&oe=6A198D4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBCqBYHnogsQ7kNvwGqUxs7&_nc_oc=AdrHcnZy4fO5ZiizZGeuKjnJ7NTBB3qp5DRIfS2VdG0-Q60lBPXD_x3UitHRqPMIQK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KxBMPncAXGOzBm-EJDJhkPCfFqF38z_oQ-12_tCkQVQ&oe=6A1997C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1p7C34iZy0Q7kNvwFg8WQz&_nc_oc=AdpQlu9IzngLQee8ve1OqBGtjg7misX49I9_oVxttIS5RthsKq0Yv0cyf6u3G2BYGBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vvFQJJvtFtfQgOBnaMLQwMeNBibwvEp43fdXLBYaT1w&oe=6A19A256"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
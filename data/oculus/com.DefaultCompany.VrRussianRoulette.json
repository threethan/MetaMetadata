nt-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzKpif-FoZ0Q7kNvwEGxsVY&_nc_oc=Adqfww4aSoBpTt_GGbXrlnbKGNDX4eeOp3Q9UAk-SgNbMGNFg7jYujM2NxQ0K_CwWHk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ayp2k0g6QQnja9PzqbYC3UEb1PYQ9YTQD5pHv3zESLQ&oe=69EB8282"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTVubXWcqa4Q7kNvwGdIACK&_nc_oc=Adqgvm7Y1dxHx6XY6dW3KdtWcOH1SusMHClkVk80qk03lOC8Wp4CHSIIuscP8Wk5Vpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oVzZgHCM0quNxMOdJQffZwKd016IIoQSs8stTogLlPg&oe=69EB6155"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8k8RvWhYG0Q7kNvwGPM8l7&_nc_oc=AdpGrV90Nbz5P4w9DRvZhDSkssFKV89XPsbuLxcflH2z2c1VO9z4uoMUPZ8IrnI1_VU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GQlRcTnZaMN--6FBmxpJz9XDdVv8-yjeuNzK4aFgHlw&oe=69EB68CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU3sHF2BsIoQ7kNvwGu7krq&_nc_oc=Adr_LQklINZlMOKSsSwHa4FuOphwYDVqDW3ZGXi0La2PRkwMi69-s7kvcGysSoGfo10&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tdn-Fb7aQhVB2MIMGuYl15vJ-HKB4IRtfWRHlm4jLjA&oe=69EB7346"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yfCOp4vPmvEQ7kNvwFG3MgD&_nc_oc=AdpcuE-butocJ7vDtmKzoL95oL1_nr2u1N7O4JHSVwVs-dXuyfwZF1gSEQdtWI5AgJI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02b8Aa_MHifq4E8rhHa8HbtmJQK5BcIdHvNdqM0wlYNA&oe=69EB7DD6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
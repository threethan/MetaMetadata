nt-sjc3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvqlk0X508EQ7kNvwGfwTBk&_nc_oc=Adp3uuvfiSl5y9heq5K6NaM64yIFxaImoza7ngR7dJEZyunqVIOX7-VU9sFvUyO9oCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmMphbafG1aQUO7E7EPzCOa6CiVufq1bEm-gu7t5EHzA&oe=6A749E82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUr0ctRo9uMQ7kNvwFt3tdo&_nc_oc=AdrZ2SBLqTncZ0ill8RIV47KtXQpvB1ZOirGNiCLZzjQzCGbCu99Gprl_iKfmi0a84g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDv0q7DqKDHn_PH0JThRiX_PmFg9qjtWQEJjyec1fMhA&oe=6A747D55"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlQ11ZYbU_0Q7kNvwG_eG2i&_nc_oc=AdoCJhVjaR0JhsKHx9XobBIC-zgdLt8jScWz0Nrv3piuGfe6jcUT76gVJQLzTKcSuTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELUhfCJuKIdu9_VMdE0DrJDd_GRLwDG-D_YRcgccywDw&oe=6A7484CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIAU6u7spUsQ7kNvwHsgHDc&_nc_oc=AdrMNbaOAaY8ugRgcmXLE0Epay-ZUF6lJ-gxjion-YXNvO7f8nChis79LaH2gj1GL-8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2iG-M5qiL1BJrjdA1jaoWxNt6G289TKjfx1nrInk7mA&oe=6A748F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkftTW21OhgQ7kNvwG8J8L0&_nc_oc=Adqbf17B9bd2wz6r_l747OK25Kk_O7Sg-3n5_u52wGhBW8JVWhNU-vs_O5kwSxUX0Vc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHke-zTjvYsNsRqCCMKK2yRofJ2hWNkMwtLSI75G8p2SA&oe=6A7499D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
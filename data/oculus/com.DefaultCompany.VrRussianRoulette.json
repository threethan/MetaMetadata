nt-sjc3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dtkqva2NWjwQ7kNvwEWAvll&_nc_oc=Adr_-AElbXPT_J-R-TZ3z2b2gy4QAQubQj-ffwE1dLZM5ZjihoyfHTHeIZX3Fir-geA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh5QtJWyaDcS5p9-RIIEv_p6tZ7TKj0HxiF9vJ6ChwbA&oe=6ABD2102"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GDfAmFNM4EQ7kNvwGAjAFe&_nc_oc=AdpLOH8kVFnHjEeX3DzHfC7JSr14yp6hUxTjWsHzRZYMFZ8H5vMkHQDz8tOs9Srx8Nw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAzPT0AIqqDEWt38QzeKTYG8DcQm626TI9WLYjV63tIg&oe=6ABD3815"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uQjSaQerbgAQ7kNvwGVeTwD&_nc_oc=AdrhSM262YhMX3tdfCYLoIua-595JqePca4XaA9m5bVSPEfPTksvwcaG10vOMPTBsNE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJteg9BZQbWJVW8uOsOuTewryc45iLTvK_edQ66fXxmhQ&oe=6ABD074A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UObURaLkd3wQ7kNvwFeB8Ad&_nc_oc=AdpngeBfWRnDBTAtuaJ44gE4AQipxeHovDGzeMigwKYYtEc6Az7pIcpGafAOMQ7JwYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj6gxYjHysyoQhPrrYUz0HtJxsqjoyHyB46Y96LOtFnw&oe=6ABD11C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCEC55I8UDoQ7kNvwHl_7J_&_nc_oc=AdpN5eHq8_7fbNOWSmwSigM8EdC11E3GrBbdhMnXplwkpiWYKzWpsGRP_h0L1LoHFXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaOXx_dvrvvcTi_-BcxB1uRLvxcPsERsuhyPvnQW2bag&oe=6ABD1C56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
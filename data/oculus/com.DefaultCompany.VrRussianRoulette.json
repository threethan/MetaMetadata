nt-atl3-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYqVyJDEeE0Q7kNvwECl5ji&_nc_oc=AdoCmsRE6z-ENlmyLpVss_vliSabd_4d1iADCazVzu09FsZt5zbzd8CUvY36Vuc9GBI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x6Wv0c39XUMeT0xX1a1hcGD2As-vsbn5QejPq_upZ2A&oe=6A3D3F82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjKHoEB10JwQ7kNvwHNDQlf&_nc_oc=AdpscYEEMkE3OXG32hMiNyNfbLl7mLXwP76MUU-D8BV45yodRIHsR67dwr7Uurj85S0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-44Mq2PhDkbRe8q79R_aQaPpFnyr2QKZbsRp7_05i2XA&oe=6A3D5695"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGLE9hsrwTcQ7kNvwF14bkg&_nc_oc=Adq1c21q-xRXdC4z8zsH4sXGcYIPPKBpIpHSM8d2PIC6RIKvjLMUAQQipwqZMe8ySSE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x7TWQCF60VgdkYRWv2bnopvUeMZqJq03yIdJhi-X7WA&oe=6A3D25CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahpHlf8KI7gQ7kNvwGQwsMO&_nc_oc=AdpkBbpVnMXNBwvwQytmUqfEgeoLBGzdsE9BHgChNG7t01Yq_e1G5NmA-w8LbnXw10Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LLhq91e7aUrkgMKhUsg9pKlppBR4Qvq_mQC2wLy0yag&oe=6A3D3046"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9kxtsJLgVcQ7kNvwHopFlq&_nc_oc=AdpMOUnXwgZ7odjDZHXsW-cUFcLXlvexnKM7hb4Rqkc02meRkFIgvZ_TeVv-1zuYMl8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ubd-rl66Vk7vKNzxAqTvTlvCOnQHQIET1GcpPOgOLpA&oe=6A3D3AD6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-ams2-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vz1gXWLO8k0Q7kNvwEg2Gi7&_nc_oc=Adpc4G3VxAwCNtV8P0AYP_RqHfIzY3Cf3T1XDMYfS_XJbnkx1_-j1qmQXu0_C_A7u78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zL6GfyItASnEKFhB4sI5733gqtLPODZWvIByRxOXmvg&oe=6A316202"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7l7BlLMLKQQ7kNvwGrLOYA&_nc_oc=Adr0tpjo1JJJSsOzUVS_Z56Xefwcv5Afbs1r9yJO-2hjE_lfOvxs9EJgX_wjoKwngbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85VPIbuPr4hM-SqI04wECHR5GTIVaEFkbEO4JGIvWR2A&oe=6A317915"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cm0l4NfTyLcQ7kNvwELq05j&_nc_oc=AdpGb8CNLaNPht_v_RLLnksFm4cTHbZ65VvwqX4XR7FoEOB4Ab_J8Git4tJzSFBOMOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KVu6Sg6aLS6Z63T-62qkTyeMaEs5DbnZpJeeLh2VxOA&oe=6A31484A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRcDUND1vUgQ7kNvwEZcomv&_nc_oc=AdoiXdwzYZQfhmWqRU9HV5_HNQLYDUCBkSm1eXoATKwztMa7A6JewWj-vsMu9WK93TU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zc-IaT4t9fwKg_PCKkjDeHRMspVdYXICNg1HaJFtAMQ&oe=6A3152C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ma6K2b15D4cQ7kNvwH3Vb7H&_nc_oc=AdopTP-I2mqfsnfoR-WU01Waf2yeYrrgxcPY28vnw5vFMVqzsRUCNgDCGShcEnzjja0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9twsK_V5WL8ukvzZWwwcBBnEGs8IESyloJ39lSsCCxcA&oe=6A315D56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
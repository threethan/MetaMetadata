nt-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiIVaUQJMsQQ7kNvwG9ApEb&_nc_oc=AdrCWM053jSaqmkCjGIz9-QqbUpLNbORGSb9c1DMgqU9k28an16dsyAz6oQeN1NP1TU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-yG0S_DEVhysi7o_QSeGoyxY-wQr8OU1dtiiS811I8g&oe=6A4A6E82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkYfbs7M71AQ7kNvwGkTtvv&_nc_oc=AdonHsPEp8-IdF4yfT3-JX0-54SMURyfTlOZ7DcFYrMk-631XfuslC9rpEJOAMedUDM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKgovJ_ukLsu8RTJjCmUETB5stBVt0Qqv9p4JQ0qsFGA&oe=6A4A8595"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF7sYVJUzZQQ7kNvwH-YdZr&_nc_oc=Adoh6zIlALCShGkn97P3al6hXXKlxDxQDN7QDw168Tt19i4giuW8yd4FaNDXpIKt0Uo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpI66kWl_oU_l-fAsrdjzgzmEhRJGbmTEGMo_z6eIoHQ&oe=6A4A54CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcZvak3UCIcQ7kNvwHOL8hV&_nc_oc=AdqFfjTIjHqllF7LP7WOlIItqvrAkfFw4Pk4Pab_V9UrENlQn0YUxd1glREvR6_jxPc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALS4inciBk8F0wzyaotGbqwVjeLnOfoewcKMPss8IvhA&oe=6A4A5F46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNK_qg8iMC8Q7kNvwHSaDlf&_nc_oc=Adrmaj9JY5lyw-9KGFDkoGp2CbLfBS5Vb5OKH0Yv4NdVMelluJ9BmDZnRs191fHTs4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz4IsSJuM1R5gMh5Bh6lUO94RaoanWc3WaMtb9nb9vbw&oe=6A4A69D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
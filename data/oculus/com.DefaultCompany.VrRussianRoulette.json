nt-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE1SQJcs2mcQ7kNvwEHpKZa&_nc_oc=AdqchbjJvOaJl3U7BoII7fBht0r1mO4bihviAEMxV_rgHq8_zfgnINmgYk2iUsNROXc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c5w-Rouq9KJ6YfdbKZkNlwpgIEePMM6xwAK9QkMDe6A&oe=6A033D82"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-v8ZahcmfYQ7kNvwETmWsz&_nc_oc=AdplX2PphCpbUvW6RfxAXGsXG_4hC2Gm3dnoiUqImoPNcCXmWPBrw_72sm4TGfmUU-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BraG8KHGN2AFa-L8lgTx33h1mPcrzwfCVuTY-F4p2bg&oe=6A031C55"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wiqcnipwe4cQ7kNvwFkEkLj&_nc_oc=AdqC-7FgxjWUZd1ClSgWZwkJqH9ym6LqaQFhpnZvVNSo63N4NtqhXwdmKJLTr1WjWcs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43zoCsgs39WUWGkpp9INk01rZaZYUrjlqyu2_VKQLR3w&oe=6A0323CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDsStPrGCUcQ7kNvwFrQKxu&_nc_oc=AdpnMUx--O_p20UnCtq3sD1-DqzkdpTWvtT6AhXALBxEgvu8d6UssOK87HzVGNEzFdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UnFYHl9e18zJQsKu5PF3iYdACegR7ypeFOO1BjEH1mA&oe=6A032E46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jus8wSm8G-AQ7kNvwGWMFrB&_nc_oc=AdrrdCda4KCsrslvbcNzlqdDQrL11ZyIvYSg8UZXk0N2kug3XP4V4-ROk04XIHtrEcY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E4ach1vUEgTV3f2FLq-oAtBysUcKjrDI63WOmjavtsQ&oe=6A0338D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
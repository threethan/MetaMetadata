nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF0h0gMcBc8Q7kNvwFHxvm9&_nc_oc=AdpXHKEyZfjtuLTbawlgbVF3n_Rw7eS5_1c3Gm44vZCH5tOGaGBK9PDerKIiZxdcU_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCqFiIex0lbc7TKpBc5CsFLDLbCTu-fqzLkdtAI9qFDA&oe=6AE75102"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpkHxTDUSaoQ7kNvwHx0TYC&_nc_oc=AdoeXaPYn-jPAgIDjnBMjJ9yvEgCaOblNvglbGzLFU5ymjY2Mg8_UdJaSq9RsO5JFIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNnS2zmBGPLkBprUllkeCLr8e6fTPr9Y3EZhteZAE_QA&oe=6AE76815"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtK22FK-MygQ7kNvwFEV8Y8&_nc_oc=AdrlEO88rUuclXZR-ipM1-bwheBRUX8bvnST2kY17RF4_O6djQpvzxgwUVQY2UNLLR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIX7dKlPJ9IIGXGNSodrd5g8nXNZFj-XkdnFIXpHqpsg&oe=6AE76F8A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOqYtGB3b5kQ7kNvwEojDlQ&_nc_oc=AdrYWOrCC8PIYoUnXYzPlISU5dZsqJ_wNunBOd9JA5Szgnjx6HY34eU1MwxjsA-EtqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShVEafPAX-lamYnORFFdb4YwcP5eeqZUKrOIlwsFAgeQ&oe=6AE741C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1_3iiZi-HwQ7kNvwH-wfGB&_nc_oc=Ado3Gqo27vvHEPwxP23yZ3oGj-Kz0pymMKc_wvIEykRyguTj2QtWy0esxEp8ixMI6yo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFJXwUnPuKo0gLH3l9eNL6rd9oj_LUqtWoh6XO0xEeFA&oe=6AE74C56"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
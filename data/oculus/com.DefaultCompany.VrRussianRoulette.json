nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXs330m7c8QQ7kNvwG1N3hw&_nc_oc=Adr80EnV5VX2Y5Fn6s9nllqEHdXYYjw6T3Ra1KZd3IuKekbGRwjsb-NCmewPQJvceyI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXe9CJsuDf6_F0x3Fzv8tF9eFNlI7XRWz3kvmLK6v-dQ&oe=6AB7DB02"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTq_Ab20RykQ7kNvwGx4wl7&_nc_oc=Ado0rt04o_o6dXl6dHu-QCQivCwSySHLC4qNGOX23U410GL0blgkmsiVCkz2ERCp7dE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg2UMjDWmeCGdOh1NPvTopcqMD0UyPR67AS5YNUQPERA&oe=6AB7B9D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQZ2VF8Iae8Q7kNvwHUNGWE&_nc_oc=AdqW83nvskMGwHu3UggP0wHYT1f_P71XJ5Eow-7w0fkQqXm39Gqx8uvLMXcmxZZb4iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3kv8YtD7dnvdQJjyOQKXRPkw6g5tHmp-dA6CpxvnfGQ&oe=6AB7C14A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44M082jilwUQ7kNvwF5IFv-&_nc_oc=AdowGNoFD6X76eNIsO48Q3K2fliO_Nk-ZbtUh_HVJjuDdO5LYupEyib5M5OIcfjGWiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7yODiWAFVHeySMEtYwoSjT41kVz9IsU_2yLxPnIH_9Q&oe=6AB7CBC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiDIHGlF0ZAQ7kNvwEu76PW&_nc_oc=AdotSuKJBJqWI_vRSdx891OVtT7OLY7QLCb-sIbDGoQfOBIAgwRx7qmIEYtu6lETAbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZTFSJI68opnZmU6av5bbfbjnJzLZsQiO5k7C6wB6pWQ&oe=6AB7D656"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
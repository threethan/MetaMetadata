nt-dfw5-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChRp97BBF8IQ7kNvwGo04wv&_nc_oc=AdoLQRGHPyL7NYqCz_WRyns8fM2lf9XBl1qownNQey0PsRpoEKUYQOzFnPDec94j2cQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDel9q8NwwP2HQG8_eWsWjmFtd_kJfg9y6T7apw86uJGw&oe=6A5A4082"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1wr1VphZLQQ7kNvwECTrKh&_nc_oc=AdrPtJg6cBuSUOTWT-bwFCoM-trR5XfvtvEr0mzISF6FpdfH88fz488NXAqJm2lKl2M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcKtFjlQpmUup8gfU6H-L_USCUf_ARKALSq0iN3FOCUg&oe=6A5A1F55"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LaJM_E9W5gQ7kNvwH7viDz&_nc_oc=Ado-FFjK_Xruzud0Gv2jOE4yIYwWaLA1TlXT7p12WXMhieVbzBi5bmaglPID6kZhCUk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_jexFZuvzPfxMJI3v77FExxrJCa4PxL8Ivo2P02JjWg&oe=6A5A26CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8GgtKB3ZwYQ7kNvwFt1NE_&_nc_oc=Adp0XvYWY5lElZ9YpiIFrQrUGToa5B2T0COqqCl6HCimNskF86GB0p4RBh75dbdG4TM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0sUOgSkMdwKEf9Jsj-boD2ohCV4zz6WT1MW1swbirHg&oe=6A5A3146"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbDnWykyyEsQ7kNvwF7Fjex&_nc_oc=AdrAKKh1BhbYstm6TPE7QmfaSmqoKWnsZprLiDVobmG3ZTxA99LMKCHx5qQlNJYwxY8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8sg3Kis6c9PCjdEtMxWIJgMJobNY5-4r4lo6lP7gI7Q&oe=6A5A3BD6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaFPoUlfc5MQ7kNvwESADvf&_nc_oc=Adrjn1JEp9TdlOzKueRoOPCulcRkeNv310HK2KKzrNKgcHnOgEwvrMNSHYRmU1bQXPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ytqjASk-KgAPqMEGwalPQ5pioY5MdqW8Gfzr5b1Vn4w&oe=69D63242"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpF7e37evu0Q7kNvwHvdppo&_nc_oc=AdqBSPazMWL54lQOdhRQWaiDUSycvze2oVcbjn4Nm1BudrkuW2UVGf5LLQFBZx0F4mc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QX_m2jZYii7M8bKroCguBmQr_z62vZar3vn0v1wd-jQ&oe=69D64955"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpfk6FBqxt8Q7kNvwGV3SZq&_nc_oc=AdqsNIrqwxM56lA6FyIrzn8GRrPWfBx3PLWPHHw7txjnhlgiX2OLeCdnTld-jBlA05Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dwL8rdA_tEKP56Zg0S5HFL18rQjruH3cTGO7HblFAlQ&oe=69D650CA"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dhwp0rHteAQ7kNvwFftbNW&_nc_oc=AdpFOD2Gwm7elxTPEc5WARQQuJs0JJchV8IrWQlSgJ7FlwAcnlXXaO9ofS3w8bJeVyU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1otymGLsOldCLR2R9niCmanfx5CyiNd4w5ayM2QQYcug&oe=69D65B46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBDhGOXnVA8Q7kNvwG1OTtN&_nc_oc=Adre2MOI-fz74Zy-FPL1zyGAF--L1CRNhQLY2U2aAlIVBj7DWjwb8eB7UDtUj_qqQ5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jSpJgoIdmd6OlXuVGvHliiEHjadPC-UlmPhINfkUZyw&oe=69D665D6"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
nt-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_543218148163494_796712651587504956_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKxPy1RbTGcQ7kNvwEEINhs&_nc_oc=AdpYiFJPIKRxwRS4YCUwIrkc8Lr8s1SrSp8jfc4AiSjKLYSTjHN2mTtpct_co66W8eE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzNjBgUJG1m9hFM-H2fnj-FR-chcoFHzcc7WclJBYO6Q&oe=6AA80902"}, {"file_name": "ss5.png", "id": "1194739435137516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035329_1194739438470849_3177391223606864205_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJr28E2lx14Q7kNvwH8FYC8&_nc_oc=AdqpuDljqdqRkP8cIwY7FgcSz7hX6vZdjKqe7C7guVp71nZrY2gVZwCqK8P0XApZC68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeWMglZoClzt2u9RG2VHBi5u5wsiTIQr6gY2YnhvyuPg&oe=6AA7E7D5"}, {"file_name": "ss3.png", "id": "825803459637534", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031631_825803462970867_613125718274049068_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsaSCLxxVb4Q7kNvwGrjhyV&_nc_oc=AdqMQQok3J5deODhKXq1067nyunsDGLe7-uEt3NDZE5ckna7l1sTT3EptIGDbqUTdYE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs8bOM3CF9xPd4kt7AT58ZTLdbkpc_kGk1RNmDPmmuEw&oe=6AA7EF4A"}, {"file_name": "ss2.png", "id": "878915074198405", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984475_878915077531738_2888961735902259771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6ApLWhH_EgQ7kNvwGRpt6k&_nc_oc=AdqaxiBWbAIJhtPrXF4-W199v73-ppx4YgI1xU49Y004BpEvUU8lwoaUM8SlEIzjAYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbsDXHpdyoHfuEMNCUg-lLTZDs8oqa4M9xg2QQGDnk8Q&oe=6AA7F9C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover1.png", "id": "1192361738645756", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031625_1192361741979089_3870097066250648076_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCiQOArFn3AQ7kNvwFPs44m&_nc_oc=AdqXzHE9aCOPAWOYSJHBZKI_cuJZC6HFVITEShIsbUhit2Waye63slOMLDYx5ErNZ9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt0Lk8dZb7lmr8SC6NupRYImO8wIjHWWNOgoUe5twq6g&oe=6AA80456"}, "display_name": "Russian Roulette", "keywords": ["roulette", "russian", "russianroulette", "onlineroulette", "RussianRoulette"], "long_description": "Russian Roulette is no longer just a game of chance\u2014it\u2019s a survival battle that also requires tactical intelligence! In this tension-filled game, every move is made on the thin line between life and death. With a variety of abilities at your disposal, you can take control of your fate and outsmart your opponent. Use the Handcuff ability to nullify your opponent's move and gain the chance to shoot instead, putting the power in your hands. The Energy Drink lets you eject the bullet from the chamber, providing a moment of relief and a chance to change the course of the game. Want more? With the Double Shot ability, you can pull the trigger twice in one turn, taking a calculated risk and applying extra pressure on your opponent. In this deadly duel, knowing when and how to use your abilities is the key to survival.\n\nBut this adventure isn't just limited to solo play! Soon, with the online option, you'll be able to share the thrill of Russian Roulette with your friends. Plan your strategy, take risks, defeat your friends, and claim victory! Get ready to find out who will survive in this deadly game.", "short_description": "Here's an adrenaline-filled experience: VR Russian Roulette! Push your limits in virtual reality and walk on the edge of danger in this heart-pounding game. Gather your courage, pull the trigger and see if you can survive! With realistic graphics and an immersive atmosphere, this game will get your pulse racing. Are you ready?\n\nPlease let's meet in the comments to make our game better.\nWhen giving your ratings, please write your requests first and wait for us to update. Thank you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.co
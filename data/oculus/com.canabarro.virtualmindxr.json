me": "01-mapa-no-comodo.png", "id": "2547637069090786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/787972803_2547637072424119_7677945030428935068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBU_UigiFg4Q7kNvwHlcOYa&_nc_oc=Adrf5aM9GDFmifWNIu_Uxbw48VaP7EiiHZ0VgHJLNRhC9zXLrh6J3mx0PsByvnLQzGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC3rffxgsussU4rVZrMb0JxCsRWTLZD0O97HKvfrOCog&oe=6AE7652A"}, {"file_name": "02-menu-da-palma.png", "id": "1697594718480029", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596068480_1697594721813362_6509520897072515486_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ywLjLA1ApYQ7kNvwFThu2h&_nc_oc=AdrftAlq3Pj-ZJ_Le84RdK_MApEh544WJgLvJ5talAE39BZZWwBW3KqD13xnbmeAZPQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN5B1EwzvoqMyU_USrkmQOm-YHu_ywGLvWJpNJzVqdXQ&oe=6AE7443F"}, {"file_name": "03-editor-de-nota.png", "id": "1533368765222322", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1533368768555655_1023884476417425483_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L7djSzNe_sQ7kNvwG5rmRs&_nc_oc=AdqH9tj_mezFzTSV2RNnC_PVPruvlD_zNfMRQbiEFetbs0ft3Bu0U6SgIOLk0aoGoXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeAalm2NCoR0HuOvdgWiz_57s82mpT6KTdqTGukWgmew&oe=6AE76847"}, {"file_name": "04-estudar.png", "id": "1877101763280328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1877101766613661_7452402769513696_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE6V_Iudy0UQ7kNvwGfSB6T&_nc_oc=AdoU6P6xcz7SUkpzWQvOml4I-LOQ69aLfHGKnXzYi8FRKdD-S3i4yWXGbY8vAic661E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp47UZrXWYcpOgMIV-2x4Cuw9gFpZK77OL8X2enavQRQ&oe=6AE7680B"}, {"file_name": "05-modo-detetive.png", "id": "4543508012630531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673536876_4543508015963864_6971427279434924248_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jeTWkcdJ2EQ7kNvwE95rUA&_nc_oc=AdqniU6fqWL8ZOLx1xJy-yzxq9aiQ1ag5e86hMhQsp8-0A7gOgKnGBCZvF0vZFhho_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGCgFz9clsVGsIdlIlw_Leo1McC4vK9vucKWjgYWVEIQ&oe=6AE7688C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capa_2560x1440.png", "id": "4027361930891700", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_4027361934225033_8364794649901117601_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILquZmKA6TkQ7kNvwFxHKEj&_nc_oc=AdpDWoLw9ZB-B892dt_JV1bkQWGX2db4GjLHQcs1hIOvqu-R6LmPKMI8nemsvXvYvfw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjuA9d3gKC7nUQezYzNUg8EQ30fRxEFdbagjOhfDICUA&oe=6AE7701C"}, "display_name": "Virtual Mind XR", "keywords": ["notes", "productivity", "study", "mindmap", "brainstorm"], "long_description": "Think in space. Virtual Mind XR is a mixed reality mind-mapping app for Meta Quest 3 and 3S that places your ideas around you, in your own room, using only your hands.\n\nMAPS YOU CAN TOUCH\n- Create a note from the menu on your palm, grab it, move it, and link notes by pulling a line from one to another.\n- Each map stays where you left it in your room.\n- One tap arranges everything neatly around you.\n\nWRITE, SPEAK, SHOW\n- Dictate notes by voice or type on a floating keyboard.\n- Take photos with the headset camera or pick images from your gallery.\n- Rich notes: headings, lists, tasks, tables, links and audio recordings.\n\nDETECTIVE MODE\n- Pin cards to a board, connect the clues with red string and draw with five colors of chalk. Stick the board to a real wall.\n\nSTUDY AND FIND\n- Turn any map into flashcards with spaced repetition.\n- Search all your notes by text or by voice.\n\nTAKE IT WITH YOU\n- Export to PDF, to Markdown (Notion, Obsidian) or as a project file.\n- Open and edit the same maps in the web app at virtualmindxr.com/app, on a computer, phone or tablet.\n\nMADE FOR COMFORT\n- Hands only, no controllers. Standing or seated.\n- Five themes and adjustable text size.\n- English, Portuguese and Spanish.\n- No account needed. Microphone, camera and room permissions are optional and requested only when you use them.", "short_description": "Virtual Mind XR turns your room into a mind map. Create notes in the air using only your hands, link them, dictate ideas, add photos and study with spaced repetition. Mixed reality, no controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualmindxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Canabarro", "support_website_url": null, "website_url": "https://virtualmindxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381288841736441"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1107463082209424"}, {"status": "PUBLISHED", "id": "1848936409572834"}]}, "baseline_offer": {"id": "1848936409572834"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793736000, "status": "PUBLISHED", "id": "1107463082209424"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1405872115944780", "version": "1.0.1"}, "id": "1069184295946838", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "
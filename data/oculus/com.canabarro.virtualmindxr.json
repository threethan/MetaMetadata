3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBL7ohFz1sDZOJylXeM3OLufMq3NL-HaPDzxDEfMGrwg&oe=6AEDFCAA"}, {"file_name": "02-menu-da-palma.png", "id": "1697594718480029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1697594721813362_6509520897072515486_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cgxSJLa8rsQ7kNvwG7UOK9&_nc_oc=AdryPrJ82Ab4cfaNUqMdwlLLcqLq5cE5r7yYnv7mjD5sr2VMbVn_h3drUZoFd4eyytY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkJArBx6iVCpCeV3fhwtyaEO9fHMpd-5eOF6fYX7snEg&oe=6AEDDBBF"}, {"file_name": "03-editor-de-nota.png", "id": "1533368765222322", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1533368768555655_1023884476417425483_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STsFzkTtrbMQ7kNvwHKsUuZ&_nc_oc=AdpwzbaLjmEcoI_mgCJTXyaxd1Tg2xHpC1NYuMyDIzunYURUEIUsA-GZQU3lMpJzQzk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcM28Yef6w4WYaocKwBbcuStWphEnRzi7dNTcElQn-Tg&oe=6AEDFFC7"}, {"file_name": "04-estudar.png", "id": "1877101763280328", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1877101766613661_7452402769513696_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltmOnsfww2UQ7kNvwEuCK60&_nc_oc=AdoNswzGKL1VJCzd2cwD8vngcM-H9wB-QNPNH0vdGO0nUNnNzzTno_sp_4SDM0TaACM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm60Dfow6fOvNmGAJ6Iq-H1KJ90Cvh32PWF7pCbkvEFg&oe=6AEDFF8B"}, {"file_name": "05-modo-detetive.png", "id": "4543508012630531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673536876_4543508015963864_6971427279434924248_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOtqLcYsy9sQ7kNvwHPoihh&_nc_oc=AdrVrpwuDLFVsSDEzDI6Pxs4GAEtjNJxRskwTDTXzMtUrgiDmlU_hf5Yq3HX7GJXbi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRTyE9deF37sXOq1UMJ77_JkjI99XsX1ePQlS_JpRnZA&oe=6AEE000C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capa_2560x1440.png", "id": "4027361930891700", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_4027361934225033_8364794649901117601_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iBoe62QI8gQ7kNvwHgN8mb&_nc_oc=Adp15nAJrIph8TJxfMFCEAewwCvfMUHX3FwyxHh6qVqYL-nzWfShgj46yh5t_gVwx7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW95ggQY5XYMyvlzQ5fM3K-7n2qVAsNbSBMBEJ4OWtLA&oe=6AEE079C"}, "display_name": "Virtual Mind XR", "keywords": ["notes", "productivity", "study", "mindmap", "brainstorm"], "long_description": "Think in space. Virtual Mind XR is a mixed reality mind-mapping app for Meta Quest 3 and 3S that places your ideas around you, in your own room, using only your hands.\n\nMAPS YOU CAN TOUCH\n- Create a note from the menu on your palm, grab it, move it, and link notes by pulling a line from one to another.\n- Each map stays where you left it in your room.\n- One tap arranges everything neatly around you.\n\nWRITE, SPEAK, SHOW\n- Dictate notes by voice or type on a floating keyboard.\n- Take photos with the headset camera or pick images from your gallery.\n- Rich notes: headings, lists, tasks, tables, links and audio recordings.\n\nDETECTIVE MODE\n- Pin cards to a board, connect the clues with red string and draw with five colors of chalk. Stick the board to a real wall.\n\nSTUDY AND FIND\n- Turn any map into flashcards with spaced repetition.\n- Search all your notes by text or by voice.\n\nTAKE IT WITH YOU\n- Export to PDF, to Markdown (Notion, Obsidian) or as a project file.\n- Open and edit the same maps in the web app at virtualmindxr.com/app, on a computer, phone or tablet.\n\nMADE FOR COMFORT\n- Hands only, no controllers. Standing or seated.\n- Five themes and adjustable text size.\n- English, Portuguese and Spanish.\n- No account needed. Microphone, camera and room permissions are optional and requested only when you use them.", "short_description": "Virtual Mind XR turns your room into a mind map. Create notes in the air using only your hands, link them, dictate ideas, add photos and study with spaced repetition. Mixed reality, no controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualmindxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Canabarro", "support_website_url": null, "website_url": "https://virtualmindxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381288841736441"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_1093156297035796_1507638616224185464_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyIAek3dbo4Q7kNvwGmMwgm&_nc_oc=AdrFbcwmKTwoQjikW3A1nJgQZG0ZSPrcLoDmkufR87k_fzsO7-cqgOhKotqBvnTJXlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNGW8J2sUuCuMMwHrimjjQa6M5DWq2YP8bB_CKY1XpKg&oe=6AEE0910"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Virtual Mind XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1792491780, "lastRevision": {"nodes": [{"id": "1381288851736440", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1381288831736442", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1090054347098522"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1576752670310063", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Mind XR", "keywords": ["mapamental", "notas", "produtividade", "estudo", "brainstorm"], "long_description": "Pense no espa\u00e7o. O Virtual Mind XR \u00e9 um app de mapas mentais em realidade mista para Meta Quest 3 e 3S que coloca as suas ideias \u00e0 sua volta, no seu pr\u00f3prio c\u00f4modo, usando s\u00f3 as m\u00e3os.\n\nMAPAS QUE VOC\u00ca PEGA COM A M\u00c3O\n- Crie uma nota pelo menu da palma da m\u00e3o, pegue, mova e ligue as notas puxando uma linha de uma para a outra.\n- Cada mapa fica onde voc\u00ea o deixou no c\u00f4modo.\n- Um toque organiza tudo \u00e0 sua volta.\n\nESCREVA, FALE, MOSTRE\n- Dite as notas por voz ou digite num teclado flutuante.\n- Tire fotos com a c\u00e2mera do headset ou escolha imagens da galeria.\n- Notas completas: t\u00edtulos, listas, tarefas, tabelas, links e grava\u00e7\u00f5es de \u00e1udio.\n\nMODO DETETIVE\n- Prenda fichas numa lousa, ligue as pistas com barbante vermelho e desenhe com giz de cinco cores. Prenda a lousa numa parede de verdade.\n\nESTUDE E ENCONTRE\n- Transforme qualquer mapa em cart\u00f5es de estudo com repeti\u00e7\u00e3o espa\u00e7ada.\n- Busque em todas as notas por texto ou por voz.\n\nLEVE COM VOC\u00ca\n- Exporte em PDF, em Markdown (Notion, Obsidian) ou como arquivo de projeto.\n- Abra e edite os mesmos mapas no app web em virtualmindxr.com/app, no computador, celular ou tablet.\n\nFEITO PARA O CONFORTO\n- S\u00f3 com as m\u00e3os, sem controles. Em p\u00e9 ou sentado.\n- Cinco temas e texto de tamanho ajust\u00e1vel.\n- Portugu\u00eas, ingl\u00eas e espanhol.\n- Sem cadastro. As permiss\u00f5es de microfone, c\u00e2mera e c\u00f4modo s\u00e3o opcionais e s\u00f3 s\u00e3o pedidas quando voc\u00ea usa o recurso.", "short_description": "O Virtual Mind XR transforma o seu c\u00f4modo em um mapa mental. Crie notas no ar s\u00f3 com as m\u00e3os, ligue umas \u00e0s outras, dite ideias, adicione fotos e estude com repeti\u00e7\u00e3o espa\u00e7ada. Realidade mista, sem controles."}, {"images": {"nodes": []}, "id": "1374972829034262", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Virtual Mind XR", "keywords": ["mapamental", "notas", "productividad", "estudio", "brainstorm"], "long_description": "Piensa en el espacio. Virtual Mind XR es una app de mapas mentales en realidad mixta para Meta Quest 3 y 3S que pone tus ideas a tu alrededor, en tu propia habitaci\u00f3n, usando solo las manos.\n\nMAPAS QUE PUEDES TOCAR\n- Crea una nota desde el men\u00fa de la palma de la mano, ag\u00e1rrala, mu\u00e9vela y conecta las notas tirando de una l\u00ednea de una a otra.\n- Cada mapa se queda donde lo dejaste en la habitaci\u00f3n.\n- Un toque lo ordena todo a tu alrededor.\n\nESCRIBE, HABLA, MUESTRA\n- Dicta las notas con la voz o escribe en un teclado flotante.\n- Toma fotos con la c\u00e1mara del visor o elige im\u00e1genes de la galer\u00eda.\n- Notas completas: t\u00edtulos, listas, tareas, tablas, enlaces y grabaciones de audio.\n\nMODO DETECTIVE\n- Fija fichas en una pizarra, une las pistas con cordel rojo y dibuja con tiza de cinco colores. Pega la pizarra a una pared real.\n\nESTUDIA Y ENCUENTRA\n- Convierte cualquier mapa en tarjetas de estudio con repetici\u00f3n espaciada.\n- Busca en todas tus notas por texto o por voz.\n\nLL\u00c9VALO CONTIGO\n- Exporta a PDF, a Markdown (Notion, Obsidian) o como archivo de proyecto.\n- Abre y edita los mismos mapas en la app web en virtualmindxr.com/app, en el ordenador, el m\u00f3vil o la tableta.\n\nHECHO PARA LA COMODIDAD\n- Solo con las manos, sin mandos. De pie o sentado.\n- Cinco temas y texto de tama\u00f1o ajustable.\n- Espa\u00f1ol, ingl\u00e9s y portugu\u00e9s.\n- Sin registro. Los permisos de micr\u00f3fono, c\u00e1mara y habitaci\u00f3n son opcionales y solo se piden cuando usas la funci\u00f3n.", "short_description": "Virtual Mind XR convierte tu habitaci\u00f3n en un mapa mental. Crea notas en el aire solo con las manos, con\u00e9ctalas, dicta ideas, a\u00f1ade fotos y estudia con repetici\u00f3n espaciada. Realidad mixta, sin mandos."}, {"images": {"nodes": [{"file_name": "capa_paisagem_2560x1440.png", "id": "3112310915628003", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_3112310918961336_7502897891340459478_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZHvLWMxHB4Q7kNvwGw-azB&_nc_oc=AdpZozjCBuCLeyHo4s5kbKRbAxRhB5P-JH6i3odA7BVxn__b8wbgk0tWFU0ajIcYWpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgps2DkDCBPK0w5XpQnhnp-Rm7wK39lC29dt7CKF9_Yw&oe=6AEE02EF"}, {"file_name": "bloco_espacial_frente_180.png", "id": "2318369515653977", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604370996_2318369518987310_4062740802642117823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cue01sX10HwQ7kNvwFzEE8g&_nc_oc=AdpFDV07IPnyjB6NTkuE0xcrXDqzXrPydu5UGbtpwA51vLayT5gPHvUsLxzidKH_ul8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqchvToz4He-cLtx_YPCV0HFNSbzqALwXTG6dYTN15gA&oe=6AEDDC31"}, {"file_name": "bloco_espacial_fundo_180.png", "id": "2201987960729481", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/646409637_2201987964062814_1768031713959379694_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPcG7pP1y8kQ7kNvwFtt5jk&_nc_oc=AdrHGxkDaUrdy5dQTJ7hIIhGdBhhPLdGUYkdOviLWvibQo8LoadTwu4dCuKTD7sewE8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqRSyTBBfTvry_Vqe8lAAF9XXfoeillbq8xB-w5WEhUA&oe=6AEE053
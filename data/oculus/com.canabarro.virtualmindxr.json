me": "01-mapa-no-comodo.png", "id": "2547637069090786", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/787972803_2547637072424119_7677945030428935068_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm1l225SzakQ7kNvwHiysB6&_nc_oc=AdoUDXJF82dN9rzX0vi0_uM4sOCsxT1uo76vYE9loFmnkS2VwOe9ikk9TKUG_nQ_doM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSlMvdKSjXGxHIQp_1YHZ9ATvJBRWliO4QveNvTGFXZA&oe=6AF5E5AA"}, {"file_name": "02-menu-da-palma.png", "id": "1697594718480029", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_1697594721813362_6509520897072515486_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zd68FoZvde0Q7kNvwGLkQy_&_nc_oc=AdqIFR_HWxfNtcFzXQWma7JAdygZDhlYDjRFC1beQq-jp1XT41DYme4kvJIO_4lNjrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKrLkpPOvqb9Fm8L9bgaOjCTDlkbztzyKoKkUd8ATAng&oe=6AF5C4BF"}, {"file_name": "03-editor-de-nota.png", "id": "1533368765222322", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830904_1533368768555655_1023884476417425483_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UK6hYhitZBAQ7kNvwFs7e5v&_nc_oc=AdqURqCn1BsP038mHBsKlWbvo5RNu1F6Vrf55cxt2-zRg8Yqsk5vFwIPSD1e2osoGGE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9_eqBCviikGMrJtkR6bXTGhK1ETPOLkDcSLqNwACSyg&oe=6AF5E8C7"}, {"file_name": "04-estudar.png", "id": "1877101763280328", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_1877101766613661_7452402769513696_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nr7Q1qCbsUcQ7kNvwHewNS_&_nc_oc=Adoa4iPnLnq-8Wad6OwoDs1_lcLen3NUznTMA0dMkVqjRGed5KLactZ8PWa8bkbVK-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz9LwdgD9hJQ0SLBl52ohKRZpI19pFIqslSVahRT-TMA&oe=6AF5E88B"}, {"file_name": "05-modo-detetive.png", "id": "4543508012630531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673536876_4543508015963864_6971427279434924248_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0JKvfGC0G8Q7kNvwFr8sIk&_nc_oc=AdqgfGcS2dgnEkdoDm23L-xwfPV-vRmHEnajg93DPamX8dYJPc7Vvbo3z6ZGv7FO5_E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0enrsHM_htmS3_B1kSHq9Nq1Ryhiai2C6sxxOQGpzxw&oe=6AF5E90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_capa_2560x1440.png", "id": "4027361930891700", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_4027361934225033_8364794649901117601_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSN6tUVt1uQQ7kNvwHFeNDD&_nc_oc=AdpIEZW0q6nuBO3pVj7ag42_XE3P1FgnzMDo-Gr630HyYYe5dGgbhv8uu6GJp5XgKtY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjpS2FHqUOL4Lk3lefd_T3j4kVAp9Y9U3Nyy41ZI_8Qw&oe=6AF5F09C"}, "display_name": "Virtual Mind XR", "keywords": ["notes", "productivity", "study", "mindmap", "brainstorm"], "long_description": "Think in space. Virtual Mind XR is a mixed reality mind-mapping app for Meta Quest 3 and 3S that places your ideas around you, in your own room, using only your hands.\n\nMAPS YOU CAN TOUCH\n- Create a note from the menu on your palm, grab it, move it, and link notes by pulling a line from one to another.\n- Each map stays where you left it in your room.\n- One tap arranges everything neatly around you.\n\nWRITE, SPEAK, SHOW\n- Dictate notes by voice or type on a floating keyboard.\n- Take photos with the headset camera or pick images from your gallery.\n- Rich notes: headings, lists, tasks, tables, links and audio recordings.\n\nDETECTIVE MODE\n- Pin cards to a board, connect the clues with red string and draw with five colors of chalk. Stick the board to a real wall.\n\nSTUDY AND FIND\n- Turn any map into flashcards with spaced repetition.\n- Search all your notes by text or by voice.\n\nTAKE IT WITH YOU\n- Export to PDF, to Markdown (Notion, Obsidian) or as a project file.\n- Open and edit the same maps in the web app at virtualmindxr.com/app, on a computer, phone or tablet.\n\nMADE FOR COMFORT\n- Hands only, no controllers. Standing or seated.\n- Five themes and adjustable text size.\n- English, Portuguese and Spanish.\n- No account needed. Microphone, camera and room permissions are optional and requested only when you use them.", "short_description": "Virtual Mind XR turns your room into a mind map. Create notes in the air using only your hands, link them, dictate ideas, add photos and study with spaced repetition. Mixed reality, no controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://virtualmindxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Canabarro", "support_website_url": null, "website_url": "https://virtualmindxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_MX", "es"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1381288841736441"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1107463082209424"}, {"status": "PUBLISHED", "id": "1848936409572834"}]}, "baseline_offer": {"id": "1848936409572834"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793736000, "status": "PUBLISHED", "id": "1107463082209424"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1405872115944780", "version": "1.0.1"}, "id": "1069184295946838", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "
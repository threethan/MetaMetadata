atform can be the foundation of your developer network and the key to better engagement. Deliver the resources and support they need, the way they want.\n\nDoes your technical workforce know what they are building and why? Align, train, and skill up your developers with custom curriculum and professional certifications.\n\n", "short_description": "Data Protocol is a web-based platform that promotes product adoption and drives engagement by scaling developer communications. It\u2019s a better way to support your developers.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dataprotocol.com/privacy-policy", "developer_terms_of_service_url": "https://dataprotocol.com/terms-of-service", "publisher_name": "Data Protocol", "support_website_url": null, "website_url": "https://dataprotocol.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "197244756455505"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031579_1247332739480073_5195501883820124069_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vg8Xx7A7gjUQ7kNvwEg3oqP&_nc_oc=AdnmMCngqaPLVg9NlOs-oFkAR69YCf0cT4Gi9QFFXFcU9jHVKtXFdjTJRScwY4eIcqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftgwWt_9ycnGHzsvWlIWbpn6fDc2C3uyEaXLXCoQbgtCg&oe=69999E96"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Data Protocol App", "
3762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75330717_586814763477095_2828473824874768675_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D3JnsN-MD8Q7kNvwFYsKIl&_nc_oc=AdoJ_7ZOaAZTibInhbEs7qHjPyaOFUH5JG0JWs7cbkHB7FV7l6U2MQCNzQ82wqdvYhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVKZWFONlKzjlfi3qjy4qR1SvK0DnFyhQ8dXAlaa0ieKg&oe=6B103A54"}, "display_name": "Data Protocol App", "keywords": [], "long_description": "The Data Protocol platform can be the foundation of your developer network and the key to better engagement. Deliver the resources and support they need, the way they want.\n\nDoes your technical workforce know what they are building and why? Align, train, and skill up your developers with custom curriculum and professional certifications.\n\n", "short_description": "Data Protocol is a web-based platform that promotes product adoption and drives engagement by scaling developer communications. It\u2019s a better way to support your developers.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dataprotocol.com/privacy-policy", "developer_terms_of_service_url": "https://dataprotocol.com/terms-of-service", "publisher_name": "Data Protocol", "support_website_url": null, "website_url": "https://dataprotocol.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "197244756455505"}, "review_messages": []}]}, "cover_square
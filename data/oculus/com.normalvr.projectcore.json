F&_nc_oc=AdpSyuDTCXqFDZVgGUhxp8HwC3q9Oe_xPgaIm9WoS6YPh5bB8Wt33ySWeOTkxZSpo-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsNsLj0QllBvCeUClBWyY6iSNXat0c8U1Mtsib-w70kg&oe=6B09AD95"}, {"file_name": "screenshot7.png", "id": "2342178149594921", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820956_2342178152928254_6942947980259121782_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUGjxsGd048Q7kNvwFjJ8cg&_nc_oc=Adq64EUuhRNxoXhxSvczisX08viqiqX0AwJxmeouG45yxB7ZIyRukBAZvaMZRpACVxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfv3qi37fVWCuXG2WIXBRZk9M4KckR7eDXuUKB5Urrlw&oe=6B09AA1B"}, {"file_name": "screenshot3.png", "id": "25651100131217074", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308050_25651100144550406_9163080158762182614_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4Vk6OcASRgQ7kNvwF22YyV&_nc_oc=AdpThj69EgGwXX3Ai38HqPRXhjcfGVzx97pVzMm2_z-vwfGc4C3oJ2GX56fGi-ecBAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvISq6vYQjyHo6se4c009GnZufpAa_xTng1XWoxs1uDw&oe=6B09A811"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "1975977013127284", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298212_1975977019793950_7542380448459658303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLQVp4i05d0Q7kNvwGCccN0&_nc_oc=AdqzBfQbCKyifVPjBUrD3cSFtavZEb94jQfMNTSIzB9jCgzc3RPjoo50PWHD7J4eaGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTndgwzA7jb7JmcgfUH537Ddq0H1EkElpwsNXht0kFm0A&oe=6B09B7FC"}, "display_name": "Flag Games", "keywords": ["FPS", "shooter", "guns", "multiplayer", "PvE"], "long_description": "Flag Games is VR's fastest co-op campaign shooter. Play solo or hop in with friends to beat the campaign together.\n\nYour goal is simple: CAPTURE THE FLAG and get out. Enemies close in fast, and every escape becomes a scramble.\n\nEach mission drops you into a massive, hostile facility. You\u2019ll fight through a sprawling solar plant baking under endless sun, a roaring coastal hydraulic station where the ocean crashes against steel turbines, and high-altitude wind farms where enormous blades cut through thin air.\n\nDescend into geothermal tunnels packed with pipes, pressure, and steam. Battle across drifting airships high above the clouds. And eventually step into The Void \u2014 where the rules of the world start to break down entirely.\n\nLow gravity means every fight happens in full 3D. You can close the gap fast or get above enemies for a better angle. Movement matters just as much as your aim. Every level you beat unlocks a Super OP Weapon that you can bring into the social lobby and use on other players.\n\nFlag games uses both joystick and the award winning movement system from Nock.\n", "short_description": "Flag Games is VR's fastest co-op campaign shooter. Play solo or hop in with friends to beat the campaign together.\n\nYour goal is simple: CAPTURE THE FLAG and get out. Enemies close in fast, and every escape becomes a scramble.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Normal VR", "support_website_url": null, "website_url": "https://www.normalvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
h&_nc_oc=AdqG2W98yuPgl-r0fjWTI6PbHfXRTkWh8VNvkKzJtdQb9S6rxKEMmi68npmzAlOtL4A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_RtaKxSP6dxBabe1NXi0KPoSJSCbGf31OyTR8ZhzN5A&oe=6B0DA215"}, {"file_name": "screenshot7.png", "id": "2342178149594921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820956_2342178152928254_6942947980259121782_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dpEHA9FJssQ7kNvwElaiIp&_nc_oc=Adr3_-EMTQaPekqB_VA2zJRf49ZqFN64s5kk5MgUKD3RnkN0ReBhh33kpU-OdyLCYxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNGZcQq6Q4ES9IiStjRgBKHcnMUovzDBsEJSLE4TC1ww&oe=6B0D9E9B"}, {"file_name": "screenshot3.png", "id": "25651100131217074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_25651100144550406_9163080158762182614_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_02Rd2QnBcQ7kNvwE2XoRb&_nc_oc=AdpSlyze0PqFflYcNoF1gRmTJZ_c0-bzbbpnHYONzM3HRWqFuX57cLcSivrZz5hdP7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRShCP5ndrIn0MTycROU3xdQBrmV34GdY7xKNIvng4Y6A&oe=6B0D9C91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "1975977013127284", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298212_1975977019793950_7542380448459658303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XITQHz_ZdWQQ7kNvwGejD7I&_nc_oc=AdpcAaA_1ZGW59MUaIKOW4H4lapMZisjWusFcmxZm7dCVKRPO4M56Cs9aHRywQ2fmt4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRl7GfxfdfTnwBCUtiPytqoy-Ri6oQ1LG-Sqo9bTy8Xwg&oe=6B0DAC7C"}, "display_name": "Flag Games", "keywords": ["FPS", "shooter", "guns", "multiplayer", "PvE"], "long_description": "Flag Games is VR's fastest co-op campaign shooter. Play solo or hop in with friends to beat the campaign together.\n\nYour goal is simple: CAPTURE THE FLAG and get out. Enemies close in fast, and every escape becomes a scramble.\n\nEach mission drops you into a massive, hostile facility. You\u2019ll fight through a sprawling solar plant baking under endless sun, a roaring coastal hydraulic station where the ocean crashes against steel turbines, and high-altitude wind farms where enormous blades cut through thin air.\n\nDescend into geothermal tunnels packed with pipes, pressure, and steam. Battle across drifting airships high above the clouds. And eventually step into The Void \u2014 where the rules of the world start to break down entirely.\n\nLow gravity means every fight happens in full 3D. You can close the gap fast or get above enemies for a better angle. Movement matters just as much as your aim. Every level you beat unlocks a Super OP Weapon that you can bring into the social lobby and use on other players.\n\nFlag games uses both joystick and the award winning movement system from Nock.\n", "short_description": "Flag Games is VR's fastest co-op campaign shooter. Play solo or hop in with friends to beat the campaign together.\n\nYour goal is simple: CAPTURE THE FLAG and get out. Enemies close in fast, and every escape becomes a scramble.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Normal VR", "support_website_url": null, "website_url": "https://www.normalvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
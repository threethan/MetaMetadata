I&_nc_oc=AdrEpz0L2YRFzH3feTwqJdPqEcAdOHZnkxUd1clg3O0TehxQsYOe1PujvI5XZG3kaWg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0A7V6UREyGLnMyuryvCTxOACX13gbJ_YsCresE9niaA&oe=6B0B3755"}, {"file_name": "screenshot7.png", "id": "2342178149594921", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820956_2342178152928254_6942947980259121782_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dpEHA9FJssQ7kNvwFRr5kp&_nc_oc=AdraCVb0FC0LOKFdjgAHnFX3APokrP2M4DeBxym-7o8IKGD2a-A117363BdF2dhj3tk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRSZ5nXiMUBeQM88Stm6K41xxPZ7M7E0uAX9B1rHWcMrQ&oe=6B0B33DB"}, {"file_name": "screenshot3.png", "id": "25651100131217074", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308050_25651100144550406_9163080158762182614_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_02Rd2QnBcQ7kNvwEbhJ_J&_nc_oc=AdpAchtORV4bFuu7j0hpZTP1rQuSRxZ-y3Ov6aMdtHlIqbtUXonnqVG_itKplOd2WhU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT0MCx0AF07Y3Hsd1W21rjpyKb7MXZyS4yyQJMNzIunNA&oe=6B0B31D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videocover.png", "id": "1975977013127284", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298212_1975977019793950_7542380448459658303_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XITQHz_ZdWQQ7kNvwHLZEIW&_nc_oc=AdoxReQiKDzefMPXk8ah6u6NgAbVGQpPGA5iRycwhzlJKtZExxAGXhHeKORokDEXCBc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9PsiBcsTBqeZARsig-79acbuJlc4-qcT_PvKmU7iVcA&oe=6B0B41BC"}, "display_name": "Flag Games", "keywords": ["FPS", "shooter", "guns", "multiplayer", "PvE"], "long_description": "Flag Games is VR's fastest co-op campaign shooter. Play solo or hop in with friends to beat the campaign together.\n\nYour goal is simple: CAPTURE THE FLAG and get out. Enemies close in fast, and every escape becomes a scramble.\n\nEach mission drops you into a massive, hostile facility. You\u2019ll fight through a sprawling solar plant baking under endless sun, a roaring coastal hydraulic station where the ocean crashes against steel turbines, and high-altitude wind farms where enormous blades cut through thin air.\n\nDescend into geothermal tunnels packed with pipes, pressure, and steam. Battle across drifting airships high above the clouds. And eventually step into The Void \u2014 where the rules of the world start to break down entirely.\n\nLow gravity means every fight happens in full 3D. You can close the gap fast or get above enemies for a better angle. Movement matters just as much as your aim. Every level you beat unlocks a Super OP Weapon that you can bring into the social lobby and use on other players.\n\nFlag games uses both joystick and the award winning movement system from Nock.\n", "short_description": "Flag Games is VR's fastest co-op campaign shooter. Play solo or hop in with friends to beat the campaign together.\n\nYour goal is simple: CAPTURE THE FLAG and get out. Enemies close in fast, and every escape becomes a scramble.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nock.game/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Normal VR", "support_website_url": null, "website_url": "https://www.normalvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
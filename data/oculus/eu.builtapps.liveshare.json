KLaLgYFZHVLOgsrGgoattj5zvR89swAACK05oZJMc6jwO89HkPFqFwbIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsGdc6GWhdH5NAcLLWVY1rKQ8odTylIamcK-4HSJFUbg&oe=6AE74B09"}, {"file_name": "IMG_9031.png", "id": "4804613706426715", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593887116_4804613709760048_2940972110848745203_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SCRBTX6SeUQ7kNvwHADoeV&_nc_oc=AdqVTD73jpQLUb4xTnXnO8pmCRluynewnlecwbO3ke_RyIUv34kEDyl7X369szS1X4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrN2Co_iEu3W44CVpDjYdEuCB4uUNwqW4vO4cmsJL-iQ&oe=6AE74CB0"}, {"file_name": "03-player-launch-pad.png", "id": "2100394760561516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624583_2100394763894849_4690947042987175454_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NrONYY5g08Q7kNvwEvuEfh&_nc_oc=AdrGCLLhZUfkgqGNVE2KE-_Sgc9AVNa-fOOrIvTGcrclLtdw89GqNBaxE49IgUwnU94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbA1TEteFRPWTt8bE2GWAcOB1jxhOeU56nMH6WsWS-PA&oe=6AE75FE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Liveshare VR", "keywords": ["video", "vr", "360", "livestream", "liveshare"], "long_description": "Liveshare VR puts you where the camera is.\n\nEXPLORE IN 360\u00b0\nStand on a mountain summit in Slovenia, fly over Alaskan glaciers, watch a rocket launch or sit in the square during a medieval festival. Browse the library by category, then look around in a window or tap Enter VR to be surrounded by it.\n\nJOIN A LIVE MOMENT\nWhen a friend streams from their phone at a concert, a hike or a family event, enter their session code and see what they see, live. Send reactions, chat, and nudge them to \"look left\" or \"go closer\" so they can show you what you want to see.\n\nBUILT FOR COMFORT AND SAFETY\nYou control where you look; the view never moves on its own. Hosts choose who can join and can turn off chat, lock a session or remove viewers. You can hide chat and reactions at any time and report a stream or a person from the player.\n\nNo account, no ads, no recordings: live streams are not stored.\n\nStreaming is done from a phone at liveshare.builtapps.eu/stream. An internet connection is required.\n", "short_description": "Step into 360\u00b0 places and join friends' live phone streams. Watch on a big screen or look around in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://liveshare.builtapps.eu/privacy", "developer_terms_of_service_url": "https://liveshare.builtapps.eu/terms", "publisher_name": "Builtapps EU", "support_website_url": "https://liveshare.builtapps.eu/report", "website_url": "https://liveshare.builtapps.eu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING", "TRACKED_KEYBOARD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1360143910512104"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1080497658031046"}]}, "baseline_offer": {"id": "1080497658031046"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790676300, "status": "PUBLISHED", "id": "1080497658031046"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1392253247301170", "version": "1.2.0"}, "id": "1585468799941853", "channel_name": "LIVE"}]},
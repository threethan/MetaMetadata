h presentations and share them in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fracturereality.io/joinxr-privacy-notice-app/", "developer_terms_of_service_url": null, "publisher_name": "Fracture Reality", "support_website_url": null, "website_url": "https://fracturereality.io/joinxr/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "563345551459808"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "401402018651544"}]}, "baseline_offer": {"id": "401402018651544"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649178180, "status": "PUBLISHED", "id": "401402018651544"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29067064099651978", "version": "2.1.12442.0"}, "id": "297743429002202", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4721401157978278", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29067064099651978"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "i
_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7kzbzLakcGQIfqcmTk3W1QTa2bMGbvkhprojiO9hO6g&oe=6AF0974B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "519739662640094", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001667_519739665973427_5542869304180809156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV4GwonSSKkQ7kNvwGQOq-l&_nc_oc=AdrpKPCSxGlgycNGTr3bnA-mBn5EIKmbYz6xgq8ejZSI7JPNbDnxWAs5biRssdqNIk8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzl6iKc4_xfyxQCF3U3r5WiVV97wGvTu4SLq6eLe5a-g&oe=6AF08D9A"}, "display_name": "JoinXR", "keywords": [], "long_description": "The enterprise XR Remote Meeting platform, designed for collaborating with both people and 3D data. Join lets you create rich presentations and share them in real time.\n\n- Collaborate with colleagues and clients from around the world in holographic meetings. Lifelike avatars from a single selfie make you feel as if you are in the same room.\n\n- Use a simple on device workflow to create your own presentations, mixing documents, images and video alongside 3D design data.\n\n- Engage stakeholders, Collaborate across disciplines, Review designs in 3D and Accelerate training by rapidly sharing knowledge.\n\nNOTE : To use Join you will need to have a trial account created for your organisation, please register an account here \n\nhttps://join.fracturereality.io/\n\nand contact \n\njoin@fracturereality.io", "short_description": "The enterprise XR Remote Meeting platform, designed for collaborating with both people and 3D data. Join lets you create rich presentations and share them in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fracturereality.io/joinxr-privacy-notice-app/", "developer_terms_of_service_url": null, "publisher_name": "Fracture Reality", "support_website_url": null, "website_url": "https://fracturereality.io/joinxr/", "category": "APPS", "comfort_rating": "NO
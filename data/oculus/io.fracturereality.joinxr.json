eenShot_2560_04.png", "id": "272553581650079", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404385_272553584983412_4655041319607554489_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49p6_dN2aUsQ7kNvwHQp7-Q&_nc_oc=Adp-nIZTateHefBphr5qAioWGJdaoeXKeClvyMKw_u1yfaFONZ8It4rpgpoaWU8RG0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUtSBReZQ3SfGGHLP0sLZoz58qwwTSvnUqhrhYXmVQyA&oe=6B0DD08B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover_Image.png", "id": "519739662640094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001667_519739665973427_5542869304180809156_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhceD1_y3LsQ7kNvwHznC64&_nc_oc=AdpRUnqbHOdoxuiVRgcDSgeifCMcmTw8XcNnmMyiC-heBLi5Z6tMXlD77G1DyjXef3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQReRbDZAcvZXhfCkVs3REUBSYU3VH9z6CZ1QqkvbMYVXA&oe=6B0DC6DA"}, "display_name": "JoinXR", "keywords": [], "long_description": "The enterprise XR Remote Meeting platform, designed for collaborating with both people and 3D data. Join lets you create rich presentations and share them in real time.\n\n- Collaborate with colleagues and clients from around the world in holographic meetings. Lifelike avatars from a single selfie make you feel as if you are in the same room.\n\n- Use a simple on device workflow to create your own presentations, mixing documents, images and video alongside 3D design data.\n\n- Engage stakeholders, Collaborate across disciplines, Review designs in 3D and Accelerate training by rapidly sharing knowledge.\n\nNOTE : To use Join you will need to have a trial account created for your organisation, please register an account here \n\nhttps://join.fracturereality.io/\n\nand contact \n\njoin@fracturereality.io", "short_description": "The enterprise XR Remote Meeting platform, designed for collaborating with both people and 3D data. Join lets you create rich presentations and share them in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fracturereality.io/joinxr-privacy-notice-app/", "developer_terms_of_service_url": null, "publisher_name": "Fracture Reality", "support_website_url": null, "website_url": "https://fracturereality.io/joinxr/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY", "UTILITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "563345551459808"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "401402018651544"}]}, "baseline_offer": {"id": "401402018651544"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649178180, "status": "PUBLISHED", "id": "401402018651544"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29067064099651978", "version": "2.1.12442.0"}, "id": "297743429002202", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4721401157978278", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29067064099651978"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "i
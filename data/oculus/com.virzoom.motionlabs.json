4439_234476232441488_2328289974164587499_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGoR2Sndtg4Q7kNvwGc_zoQ&_nc_oc=AdpXxVjArWGMfaDi91-aHcTTnUI8hdFyWG3-MNhHQ7LMrHRez4Za5MEbjfWpJgw9jIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLgCeVzrZn1d-XlwLLDKXRltc_-5VpB4IunGbR9M8YEQ&oe=6B006E23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Motionlab landscape.png", "id": "5847786668637074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469630_5847786675303740_8745980182832545324_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aZufMkDMrYQ7kNvwFMjB2E&_nc_oc=Adrf_ErlNx2ZuVEJp5Yp3MsJczWni2vsh7q75MdJCH-KJ6gmV8d5OH409fm-eHjZQ-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbKGIu-YagItphBs8NcwuA6V6tFTdxIXC-VicoiSqKfg&oe=6B007D6A"}, "display_name": "Motion Labs", "keywords": [], "long_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement.", "short_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement."}]}, "developer_name": "VirZOOM, Inc.", "developer_privacy_policy_url": "https://vi
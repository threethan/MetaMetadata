CJC5lf8MHI-HlQQnvxg&oe=6A22F223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Motionlab landscape.png", "id": "5847786668637074", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75469630_5847786675303740_8745980182832545324_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlaAIqk4T1wQ7kNvwGLFGNB&_nc_oc=AdqjZAuizxkwZSZGQ5vNq2gPfQVXubKqOD1493pxG3RCqyZnqRKut-jHhxUafeH3Xwc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1iIPmU17CS7A_jG6HaBWpoVbhGfLiV4vIDgh9kYRUTQ&oe=6A23016A"}, "display_name": "Motion Labs", "keywords": [], "long_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement.", "short_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement."}]}, "developer_name": "VirZOOM, Inc.", "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751-VirZOOM-Privacy-Policy", "developer_terms_of_service_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056435331", "publisher_name": "VirZOOM, Inc.", "support_website_url": "https://virzoom.com/support", "website_url": "https://virzoom.com/", "category": null, "comfort_rating":
4439_234476232441488_2328289974164587499_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4Nh8FWqTFsQ7kNvwGBZ6Bp&_nc_oc=AdrAzW8Ip7MjVy9Q6PKSTR2wm_UoomVG0axMtrTpMcB3meboaiRqQgml37oB9WLdiqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTX9aF3dLCMKFadExL7CrWPXYYR10-d5EMm_SH8300zPQ&oe=6B0D9D23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Motionlab landscape.png", "id": "5847786668637074", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75469630_5847786675303740_8745980182832545324_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHbamEBlhPsQ7kNvwH_Jnkf&_nc_oc=Adp1yhS9Icsjav77gx1J9EU4cbXfnKXd1a7mSbhb_mDG_nds6Iq1tUbCSmK0uF_Nj5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSt5gmGV8iMm_WGQqwFeHrhIl3DGtvLl6g3bkx51yAO6A&oe=6B0DAC6A"}, "display_name": "Motion Labs", "keywords": [], "long_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement.", "short_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement."}]}, "developer_name": "VirZOOM, Inc.", "developer_privacy_policy_url": "https://vi
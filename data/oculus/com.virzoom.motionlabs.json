4439_234476232441488_2328289974164587499_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TxCUbAeMNoQ7kNvwE3IVD4&_nc_oc=Adpb0hs9KTOidXWxYr8rZEaTaaRr5exb8sem1fM8uHH8xMshGhfGyV977sqo7lEH-Wo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpuaKNvohDj8YyvU4gVFEhUbmNICMYk1H0mTD6lyuQwQ&oe=6B0705A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Motionlab landscape.png", "id": "5847786668637074", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75469630_5847786675303740_8745980182832545324_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJ7A-qBCL20Q7kNvwGMEzc8&_nc_oc=Adr9ZNSIBHkE3q59oRwqfHoCFoS2_2YfS9PxBpd2WjVYv7SzWMDtJsDi88aLA9rcHlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSznMKLspNbq5qHgM5OH0l7bQ383pPJdSqPfl0hks60Rw&oe=6B0714EA"}, "display_name": "Motion Labs", "keywords": [], "long_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement.", "short_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement."}]}, "developer_name": "VirZOOM, Inc.", "developer_privacy_policy_url": "https://vi
ull, "video_trailer_thumbnail": {"file_name": "Motionlab landscape.png", "id": "5847786668637074", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75469630_5847786675303740_8745980182832545324_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITFWZmL2_IYQ7kNvwFCG6nM&_nc_oc=Adkjkcbl5kK40AY1vDqxMFC4MLZZoCtvgK1huohLS0lk2qTJDZW85HbdTCc7SVnA00o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwlC7A8LpC4R-9d06RzNclii_bc-BjH10KEJGIxqywsgw&oe=69BBF42A"}, "display_name": "Motion Labs", "keywords": [], "long_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement.", "short_description": "Get ready to experience the newest way to move in VR.  With Motion Labs your body is the joystick and you have complete control of your motion and turning! \n\nRace on a hover board through as you try to get the fastest lap.  Battle for hours in our combat mode as you take on wave after wave of tanks. \n\nYou can even challenge your friends in up to 4 player races and arenas.\n\nBrought to you by the team that created VZfit, Motion Labs is the next evolution of VR movement."}]}, "developer_name": "VirZOOM, Inc.", "developer_privacy_policy_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056428751-VirZOOM-Privacy-Policy", "developer_terms_of_service_url": "https://virzoom.zendesk.com/hc/en-us/articles/360056435331", "publisher_name": "VirZOOM, Inc.", "support_website_url": "https://virzoom.com/support", "website_url": "https://virzoom.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_cate
oe=6AF5BE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1735624040834135", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_1735624044167468_2934337482837258805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7MruPI6YrMQ7kNvwFtGPcn&_nc_oc=AdopvBDPY6JGIFFXDwUWuouHt2DIlxDHKgTE3LhKE0Kq2X3cU-VqQxKGKfJy-stQ3k8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcQoo0mfgKsxAE3icaWdqo9JDdM8q-WU7j84JbcdYUsA&oe=6AF5CA56"}, "display_name": "Truck Simulator", "keywords": ["truck", "trucking", "driving", "simulator", "trucker"], "long_description": "The open road, from the driver's seat.\n\nA SHOW TRUCK TO CALL HOME\nA long-nose sleeper rig built to be lived in: walnut dash, black leather, cognac tufting, fourteen working gauges, chrome and a starlight headliner. Reach out and grab the wheel with both hands, pull the strap for the air horn, push the yellow knob to set the parking brake.\n\nHAUL REAL LOADS\nTwenty kinds of cargo on nine trailers: produce and ice cream in a reefer, electronics in a dry van, steel coils, lumber, pipe, logs, grain and fuel tankers. Pick a job from the board, back under the trailer to couple, then drive it across a 27 km desert loop to one of four depots.\n\nDRIVE IT LIKE A TRUCKER\nThe trailer follows the rig like the real thing. Watch it swing in the live mirrors, feel the jake brake on the downhill, keep to the limit past the speed cameras, and back into the dock for a bonus.\n\nNIGHT RUNS\nSwitch to night and the gauges glow, your headlights carve the highway and the truck stop neon waits in the dark. Night loads pay extra.\n\nTHE SLEEPER\nParked for the night? Leave the seat, walk back into the sleeper and put your feet up: a made bed, a TV, a galley and stars on the ceiling.", "short_description": "Climb into the cab of a long-nose show truck and haul freight across a desert highway in VR. Grab the wheel, work a 12-speed gearbox and the engine brake, back your trailer into the dock, drive through the night under the stars, then leave the seat and rest in your sleeper."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/trucksimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trucksimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1261027857103187"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1092342767099298"}]}, "baseline_offer": {"id": "1092342767099298"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791205380, "status": "PUBLISHED", "id": "1092342767099298"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1261915067014466", "version": "1.0.0"}, "id": "1759195085324851", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1261027850436521", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1261915067014466"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id
e&_nc_oc=AdqWwO-Mxp2i4BpC6tlKDhYZUyYpPkQUvcDfOgM00RfTNfi_ii-MpztfjiVtwySX0SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPEUJZzpp8JjAwVVQLhiCdgmjjCBT8IRxD8YcDFP0_Lw&oe=6AF5EC10"}, {"file_name": "screenshot_3.png", "id": "1871742477569386", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596061819_1871742480902719_8010162929055908493_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8WiK6lCn68Q7kNvwG5yep0&_nc_oc=Adqhas0TDsCr2wGB8hYiVokc6AdomiT4SYlrPsS6vKr1Mf-ic1a6On5tgVZcKRifdmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHvjZ7sFJUiYAjJHJiBxH-pt60ruDVqEn51k2ofbD-1w&oe=6AF5D645"}, {"file_name": "screenshot_5.png", "id": "1992545054768955", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673716021_1992545058102288_4771226789900105857_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9ZssmhAWvMQ7kNvwFrYhJK&_nc_oc=Ado7ZkgE7v78eeo2t3XkieCgcwUEg8pAGKjiMcaqURL6clA6gPjh4dX-qsKnPUXxvHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7OJPL-Yl2Rd8Qm8rSq9X3EWlDD3HIIuuRy5Hd0ciKDA&oe=6AF5BE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1735624040834135", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596061819_1735624044167468_2934337482837258805_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7MruPI6YrMQ7kNvwFtGPcn&_nc_oc=AdopvBDPY6JGIFFXDwUWuouHt2DIlxDHKgTE3LhKE0Kq2X3cU-VqQxKGKfJy-stQ3k8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcQoo0mfgKsxAE3icaWdqo9JDdM8q-WU7j84JbcdYUsA&oe=6AF5CA56"}, "display_name": "Truck Simulator", "keywords": ["truck", "trucking", "driving", "simulator", "trucker"], "long_description": "The open road, from the driver's seat.\n\nA SHOW TRUCK TO CALL HOME\nA long-nose sleeper rig built to be lived in: walnut dash, black leather, cognac tufting, fourteen working gauges, chrome and a starlight headliner. Reach out and grab the wheel with both hands, pull the strap for the air horn, push the yellow knob to set the parking brake.\n\nHAUL REAL LOADS\nTwenty kinds of cargo on nine trailers: produce and ice cream in a reefer, electronics in a dry van, steel coils, lumber, pipe, logs, grain and fuel tankers. Pick a job from the board, back under the trailer to couple, then drive it across a 27 km desert loop to one of four depots.\n\nDRIVE IT LIKE A TRUCKER\nThe trailer follows the rig like the real thing. Watch it swing in the live mirrors, feel the jake brake on the downhill, keep to the limit past the speed cameras, and back into the dock for a bonus.\n\nNIGHT RUNS\nSwitch to night and the gauges glow, your headlights carve the highway and the truck stop neon waits in the dark. Night loads pay extra.\n\nTHE SLEEPER\nParked for the night? Leave the seat, walk back into the sleeper and put your feet up: a made bed, a TV, a galley and stars on the ceiling.", "short_description": "Climb into the cab of a long-nose show truck and haul freight across a desert highway in VR. Grab the wheel, work a 12-speed gearbox and the engine brake, back your trailer into the dock, drive through the night under the stars, then leave the seat and rest in your sleeper."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/trucksimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trucksimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OC
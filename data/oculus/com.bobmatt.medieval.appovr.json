mXb&_nc_oc=AdrnwN-COKVsRsiGEMB3cQ6-XqQ8N0k0gLt4i_N7VuhaW1KRe-KdpxXGAOejh_1K5Z0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyBYRxzqT_Xrzco6DZasHoe48aia4J4-CnoyMVKFp1Uw&oe=6AFB263E"}, {"file_name": "8.png", "id": "2914893158763578", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta6Q-jVGHGwQ7kNvwHhD0W8&_nc_oc=AdqkL6ty3A_SNrrAgVvLxI3RwBnTAsOsMSdsnfmmhvFKZxmS9otXiWZMzRTjOX-znLo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHy0zS5Vf_32RQqDnpSjL6nMkNKDtiNUW6GNpe4Or33Q&oe=6AFB3617"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqQWfEHZPTgQ7kNvwFzcocW&_nc_oc=AdqxtUnvU9vDaq3Lx1ABGo0VgmuYbEXIzqbkhnRKBVuCNUtey9s6nqUfAxQbt1d6PbU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSC7CqaEG1zIJgleH_saxLW9k90iSUrTPSt1Vl2DkJjBA&oe=6AFB393B"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubq4S-JBQnMQ7kNvwFoRIkQ&_nc_oc=Adqps3zd7Mwl4A9W3t6TovjOyfDUJryt0GkY5KIiz75woMO6-6X2t4qwp8SULOt0kk8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-G3vc8dYIqh26b57DBbH8vUOd_VfT-svl0WcgOfjEEw&oe=6AFB2659"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkePlh-5lLYQ7kNvwEBKyOO&_nc_oc=Adq_0GY8Kio27eGOBIdeT-tOeRXgfTOCrXMT0A52eIXK0C2pjHayzLi6694Q7ZTfnHE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmYHNsAGoxrT_sl-Le8uHnvVQE2_DnjEkuvYLLH2gvVw&oe=6AFB246F"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
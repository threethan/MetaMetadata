dQw&_nc_oc=Adrnv7JNkJU0EoUpIltBQLSyc3bUROJHko8yaZ1Ex_tiJsE4cwsrdML8a-JDGYCKQWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSPuE1LhOMOQUs9B79_GJ_K_7eSugtto1Qc8db4J9ULg&oe=6B030F3E"}, {"file_name": "8.png", "id": "2914893158763578", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMVBzRvwHi0Q7kNvwGDb0Bm&_nc_oc=Ador6q3wp7FSuC18dpgpvGywm_rFtfDnAQ8-qa9lRvCdvn4czSepXuIgVSN0w3d5ZeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ73FMJ6ppqRlOmbrZVjGgkwxVsqXzfS-uyQiAAN-soyw&oe=6B031F17"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcGOPlVyn3IQ7kNvwG-xUP5&_nc_oc=Adrovddy54nhvyBqyersDw6OdU9JGyH882KLDWboTqsGRQIJA70OUf_4qLmb7MyB2-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8_la1RHeVJ3yc0_tEHlIu3poUkON7oHbZ2nKC3_SX3g&oe=6B03223B"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pdpceg7ATEgQ7kNvwFrQiqJ&_nc_oc=AdquxV9S_0pNeP5G470EuiGxk_6os0v-gQAo_fvBeFMoZfTX8MsCphLpRUTcOiB3UO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmGEX6uhMNloCDwu190W8tB_M90JTHLC4167EdFuj4rQ&oe=6B030F59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJwzZo4REm8Q7kNvwFs1nIr&_nc_oc=AdonLtnhU5N1HL9m1FyErrW-8izr9o50IbBwbPt2wRbroFiimV5OPgaoaUbEPfdcYIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeARzOlBSa8GyLo4bHsFZ-8nfAuUapiIkg5Z_TG16fUg&oe=6B030D6F"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
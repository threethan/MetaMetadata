file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgibzRWG5BUQ7kNvwHpbA7M&_nc_oc=AdocSvqUzJ45htdxqLhTWb3igxVIJzM8b4a0gbfHVeXz-X7qFDA8TJe059Xdw_x1gSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVJbhD7NTe50_HuJ4jIBiMjutkPrtvPRhSNoqERQ9alA&oe=6AEB2EFB"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICYp3rXzHiwQ7kNvwEp2CEp&_nc_oc=AdoMF5s-6sXAod7-tEVnwu9pMMxWnCwZUKmyL-OjEPhAWhnEKpIFDxa9KudKnqmLkT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIhIlaylbwJfBxXePat8X0e0EIxy4QrCnIsO60bKrU3A&oe=6AEB5459"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other evil-but-fun dead guys. Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- A defense game that's as first-person as you can get.\n- Over 50 levels of wand-twirling VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n- Zombie-free zone! Aren\u2019t you a bit tired of them?\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n- Melee weapons.\n- Original Quest version.\n\nCOMING LATER (HOPEFULLY!):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "608940430204171"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5683487758437405", "version": "1.6.7"}, "id": "1722419071274639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3916103038509228", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5683487758437405"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1722419071274639"}]}, "change_log": "Tutorials are now optional, and instructions are shown during gam
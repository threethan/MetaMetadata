mcJ&_nc_oc=AdobUc53g1gEzM-1Pooj51dpCWK56JSxw8JVpcHeJhqmPJEhtUgmQ7PhfJT3uC_etpY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGrtu4zX0qodKY0Jij76EFUumFvJdBiUx3Kh3w-3DJjQ&oe=6B0C81FE"}, {"file_name": "8.png", "id": "2914893158763578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMTq5xCxAncQ7kNvwFbCfVE&_nc_oc=AdoIR6YLjlNYTtNDmzZ4k59ZJtRJ7NBqT2ICtGaPkiRTwBh82izZRD-J0GGhzL9PNdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRIGHcbX8NAr_hQaXjaLuTIHlLU8m8tImZbNOSJ0jgIVQ&oe=6B0C5997"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRmD8ISjvBEQ7kNvwFBG3w1&_nc_oc=AdrADGkQUZE85H8QZaBl9ESrk0cFb2_M3B4IoW59H0HvB3xgN0DaV7RRiWFae3FA6Pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_ScLs5LwDXOja8T5oAaoGZhISFErnhYpDY37sKcBqqA&oe=6B0C5CBB"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUcnoSdv_3MQ7kNvwE6gJgb&_nc_oc=Adq_QKrJiIiDom3FWIOI_VpXG8Yye__rYSoeomNcWJJE1MsvVPk6gcg1vCi8styX1ao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTz0Ayf5gXJpWy5bYdSfB2ArxF06muoFOrVKmn40hQeVQ&oe=6B0C8219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drhREbJihtcQ7kNvwEaISYj&_nc_oc=AdpHg9dvSwTIUVo3h55Cn2BHqWAivuLhNk1ieHU-Cywy14477V8MUu55Z375TgUXG0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1_ggOH2KtLLI1fUc06EVHT2BXgl9rU7OYaGx7CCpHQw&oe=6B0C802F"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
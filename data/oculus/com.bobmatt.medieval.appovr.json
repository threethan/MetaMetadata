hBg&_nc_oc=AdquZWovlkcQqGKIEymRUcg55ODB87NuLwBQasJs_n-RUdeSy5Uy4BKJM4frVw10pqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHzJK7vKeATFqRKO8XpVTNRZ1V3QCwsW76bMoPxzlppQ&oe=6B0703BE"}, {"file_name": "8.png", "id": "2914893158763578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhOeTprUpAcQ7kNvwFOk7Qd&_nc_oc=Adq-EXllQ5Ybz-0VWe8x1zsus6_CPUJcOdYDNc7UIaORPYT3QKmfC1Bk5c1MeZ1r0DE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-FDR3SwNLyBSneTvNCVnzxzS0pZAlpzhRckieLli0DQ&oe=6B071397"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF1GbIpt7kAQ7kNvwH5ZAsW&_nc_oc=Adqj7L6VZfKiO5gvxRlTM6jRh2UXCRwYe-WnxlEIzbZfp3Jk27NaKNBT_oo02khWJ2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCBuZVn09gMDbKo0WF_6PyvwONO46L09hhE2XgSD3mqg&oe=6B0716BB"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7NodHj-hI8Q7kNvwHBeW4e&_nc_oc=AdrRqLYg3ryG7bYMGiwlXcRL5F079KBrOt4nMc9cgME5GBsyZPXcb6JDBhYtW9UqjRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBBxpw6VTkCgeTN1Asd28OmiEalvHZHlPGVdE8zXtJjw&oe=6B0703D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlFmCw2vJ_0Q7kNvwHfdX3T&_nc_oc=AdqakaBJ6aBohEGXTyScR4TEDeY4_YpWaJ-uWez_lu7x58JBo9OfOVic4pqjY_ygR50&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0UcuFDeKHhzPOOe7obNGgRpOMEBYVhQLvRyYb2oc0FQ&oe=6B0701EF"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
UcH&_nc_oc=AdpCeBESooRoxe8N7Zsp-Sqq9GWpASrvz8TsGf883wkK35j4JnEwLjEiTsjM8O8l2jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdq3XzgzfMJRqixTcF9CdGF_MYgwDBs20gDRzTaH8sbw&oe=6B0460BE"}, {"file_name": "8.png", "id": "2914893158763578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMVBzRvwHi0Q7kNvwEY5oqm&_nc_oc=AdoX4LuwtSq8GTt0kWh6KBipyqn70mADh9vK26bmOLhEijNUCUG9QTufPG8WcaJ0LwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6T684Vssow_DdlKLlIKUWEsqHrwt2-GUxLgCRqjjWlg&oe=6B047097"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF1GbIpt7kAQ7kNvwHQw_WK&_nc_oc=Adrdv8gojGkdBa1Q9GnXMLy9_VH8t1n_fIyrMO39PJrhydg4KWZmDVDgYS9gdOYZCFc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3fhgZclclYD0uWXhOw5h7SqhucgabT4PzY5TMG6rjpQ&oe=6B0473BB"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pdpceg7ATEgQ7kNvwGinFmG&_nc_oc=AdoPKXxehM7zcBZ66MLB1fI2ww89tdRAMR-rZtku8YgNLyOdSORYHiUpzF29C0vbw-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_KhjSgJrpYdK2F5mJAZUF7pc1iMFq_eItDZrxVuRolQ&oe=6B0460D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlFmCw2vJ_0Q7kNvwFfkivn&_nc_oc=Adpf_d4EgPmrQToYw0cXkPN4YIXMSI6O4PMTygTNMwRMHjAHabWnHRsuUU09PkgS_UA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhEhIXnL3W2G9MBYfjmv0NQJtCMokmKBvdyGsalWzWWQ&oe=6B045EEF"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
4.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OaPaQxC9VoQ7kNvwFmJNev&_nc_oc=Adk_nMrUe3F3ECm6UBe-cznOiV9nFjn3bnSctjAIF3NOY-OAqaT3CYHg8MtNUuhGetE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxpSQR8WhFynCeHDSH5Wt4CcaBGbumAFIbV-usj3eDQTg&oe=69B952FB"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfDuK6RcTNsQ7kNvwEm5PP0&_nc_oc=AdnYVEdu4GDv-3QHKoj5o23q45T_BhhewcGG96NNRuJ8-RVCjGaGc2VwgqSHE7R6euI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyH0SAenfSkEmOadhh_FlHTO-TCVsUIBzqsdVaJg2jz6Q&oe=69B94019"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other evil-but-fun dead guys. Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- A defense game that's as first-person as you can get.\n- Over 50 levels of wand-twirling VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n- Zombie-free zone! Aren\u2019t you a bit tired of them?\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n- Melee weapons.\n- Original Quest version.\n\nCOMING LATER (HOPEFULLY!):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "dev
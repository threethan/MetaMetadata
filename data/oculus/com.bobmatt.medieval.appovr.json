4.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IzGT9_JxN6QQ7kNvwHH5mFf&_nc_oc=Admmzx2PER4pL5CCFPdbnwvmr5-bjcc15eoBx3d8xHd8TrmP98enqsUJDhpn0Z69drw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV633paqO8uHmmpO3THlXAG5pYz1m-JLIZPmT19B7Q7Q&oe=69B0187B"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMC-a5FtwZwQ7kNvwE4pEW-&_nc_oc=AdnEn6v6fWqP_gwINjE9I1blD6TuyqJT13x3kp0PBuLC3GbCcCzPqU139yMq_ckYR5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTcSwPejrvP5HIBZwWTU9z5lQ3UUlZxn0GAhgEsH4zEw&oe=69B00599"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other evil-but-fun dead guys. Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- A defense game that's as first-person as you can get.\n- Over 50 levels of wand-twirling VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n- Zombie-free zone! Aren\u2019t you a bit tired of them?\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n- Melee weapons.\n- Original Quest version.\n\nCOMING LATER (HOPEFULLY!):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "dev
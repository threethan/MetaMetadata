id": "2914893158763578", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMwKD4i_D6IQ7kNvwEae_55&_nc_oc=AdppgVjU4EaF3sCp_uHkVivUHlhc_jTV2EuNlOTglt6nFo6C--khEzDv7IboOHY8jAo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fGWexk18N1aGJxIZxvqVDrXITI7zucFLG6T_D96bL6g&oe=6A466057"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQj4i0hsKrQQ7kNvwE46VuU&_nc_oc=Ado0I4RxS4iF0bHKO2HUwUXBvneCbWLjfEE_gyOeWW7tNJ3e7vI7pWra9MOG7N2dJdY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D-DEZFxabHfcbP81ecngvixfxqwQiiOcq7mP9y6n8Dw&oe=6A46637B"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51AeI7RdohUQ7kNvwE-Xj4g&_nc_oc=AdqOPJr9xqWCLUodyc42lKfhEYSbAsdfvWuuoRSqyV3iaztDv1rhjIFTbejgNCPVhvU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86WWHQdOGngvAOdVTp1-at1KJJ35RSHknO47NgWVa9gw&oe=6A4688D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hce38REf_d8Q7kNvwFCnXvu&_nc_oc=AdqWr06jehA3i_LDlKwcjhT2h4Su8ZCHW6RFnWiYAqSynzZjkYTMjjRAsyFVNzZJYeA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hHfKuxlecZF7j2if2dbssx5GS5h4ysXiWJU-FAAcKzw&oe=6A4686EF"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "es", "es_PR", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3393476147548229"},
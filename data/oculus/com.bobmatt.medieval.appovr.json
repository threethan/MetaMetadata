/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=By1z9s6FLM0Q7kNvwH7TzWk&_nc_oc=AdlyGqI3RvtnNM8fPJSvpFsZ-Z12PXWtr2OokRDOCwTbBO_rbITqv4rZD6fmfv2Yeaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFB2WOdTFyr0vyc_jdgFe9R_bt8TyRfDSLgp7G_4cdPw&oe=69AD7257"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHDMwSZ7lPsQ7kNvwF3o3fI&_nc_oc=AdmTHYfQ7uutTSh9xxlkLFeAgR18yzzK7ccVJDeQlvdmFKgyXdxzYQaHEoaKuclr9_4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOEmXWHJm5yXZyvh1OyLNw6ew490LZVS0SEpg2Srd0Ow&oe=69AD757B"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7UHWXVzSnQQ7kNvwGkdoLD&_nc_oc=AdlX2xOtb7P7iCKkwt8pHhWjrLyGoUa9vVBPpuMyzp2JK-BWZRK5WLwYXNLpazYgI7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDYkIjTu298r98VJCpAVcDaHw0eonbULKjR3BDhsWq8Q&oe=69AD6299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxkxT3lEOTAQ7kNvwELC8FV&_nc_oc=AdnH_00CRBM2ZkIZ_yTrZWQNbuyvKZWbcSHwFienT5HMSYbs7VCIafhecUa5G8LJo0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwThL7EGk0CMcS3jVbE_PAf2w3cXcuEUhROIHvkZUHVQQ&oe=69AD60AF"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "es", "es_PR", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3393476147548229"}, "review_messages": []}]}, "cover_square_image": {"uri": "
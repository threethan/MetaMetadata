4.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvbUeecklmoQ7kNvwH9OiI7&_nc_oc=Adl3BaG9yVTQMzEC2c0cJe_iDFG2vDPKoaxxas7yMUwOl-Ae66VHO7b26aa-SMlye_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwj87L6kxEztMZvNWrqT52KJVXFVi8DyAaxMRAH0UeZJA&oe=69B55E7B"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBasZ8nunHMQ7kNvwEH1t9d&_nc_oc=AdlOjLYWc48pqph2hpHQ12ZKBCcr1j7S0qGg9j5AtQQwVFqZUKSSxuWEOItBQ-t75oo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz-LpEzqw_3-KUIizS-yGKuQj0UNOQ1B6LNI1NEhbbAXQ&oe=69B54B99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other evil-but-fun dead guys. Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- A defense game that's as first-person as you can get.\n- Over 50 levels of wand-twirling VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n- Zombie-free zone! Aren\u2019t you a bit tired of them?\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n- Melee weapons.\n- Original Quest version.\n\nCOMING LATER (HOPEFULLY!):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "dev
kjP&_nc_oc=AdouK-QPYRkDyeRfrY_2H2-GY-HSOH8DlzoII9gYnJ7NQfSW9kTRn1TsbGoSU2eAPeQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2af3kIknZq2iV-il-1YvPDwZhNF1kmY0kqSRDftrLxA&oe=6B0B307E"}, {"file_name": "8.png", "id": "2914893158763578", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMTq5xCxAncQ7kNvwExVSRr&_nc_oc=AdqmZwrla4bCVFtEq-kOU4yUFjXR-l6HU3OVX5TtAdRYiN6P5rPomw367DYQuooX-eo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmdvE2culoor-dRstJEgixfVjhwOKoK71omg-9JFZvZA&oe=6B0B4057"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHVcgicyLm8Q7kNvwFnCRYy&_nc_oc=AdpzyTCfv48a2KsaW1ip4Kx3JMSIESJMZKzTs5KRPRLH3p2ez2U1DfWhGpotd6_Dv_k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6W3wMhyQpDxYZIYemLEFviya47AiH8n_cZRhGpwP1pQ&oe=6B0B437B"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUcnoSdv_3MQ7kNvwHsqjci&_nc_oc=Adr7MXTamxQY0QwME6_Q7WBGnR8GlRJcd_uxGf1lO-3_FHfvIHb3urGEI-K8fgFIDFk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvbPqF_AQOXgvRZSqNoFVBf_JSCFndMdnEpLGIUCzD6A&oe=6B0B3099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnyyBdBNrFgQ7kNvwEK7NsP&_nc_oc=Adr03Jm5bCrfRVyqkImmS7iLgnmSEscOOSnf94xcFqLDNE4zM4FWTRxxQgsDAPBMi_I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgnfxpFx___xdz9KyJ4ZDyTVvH8fWOiLXMhUPG1jhMvw&oe=6B0B2EAF"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
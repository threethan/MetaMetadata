yjX&_nc_oc=Adr6RCETUxYa93YSIW5A3cfGif32LYi6JfD8YXE9l1YeXv_RB-cCXpZ8kqzgL3VRTMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXycC_DhpplI-9UuIcIlDk8-rl7NZzSGLV05dBvcPhugw&oe=6B0EECBE"}, {"file_name": "8.png", "id": "2914893158763578", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsoHL7lBrSwQ7kNvwHZtGy0&_nc_oc=AdoMbfpTj0GKWgaGUijIRlCbs2s33Wjs-NZXbAb9IDy2UglumRTkuR7R4uokAxN3FTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBO3ZxGOO3VnXc2_00LVmi2XH5VILfHx2FyO7Q6gp8LA&oe=6B0EFC97"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRmD8ISjvBEQ7kNvwErP39T&_nc_oc=AdpSJ3EPP8R5da3LoTMmJRuMTUnnboTIjokuJYPixzA56wVsBG9OGLofTBSe3Bttb9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9M_4MmBcFUAU7By66PhUvs9GgTqjw31feMsgZj9XtTA&oe=6B0EFFBB"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VKfzar_ud0Q7kNvwEI43U1&_nc_oc=Ado3vMxCtVD_vMFSMnCTLMozXL9QhAgQw94MtiqoJTzLz3pdPRNH6PBT4htb-hoKW1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV3EAI6Jkz4jC8xiC_9y74MVhD25m5Tt4CG_KNHKIL4ZQ&oe=6B0EECD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drhREbJihtcQ7kNvwHRPmqq&_nc_oc=AdqARDAcsMYoXtJUj4HSr1EEZOHPbBn2Aks3hYLQQbmEjqpzi1ahCTqm3z5PPz_mJNg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmizKhcmlpPjc4tde9Sk2SNB5NYhPyj8wSCwCmbNXG8w&oe=6B0EEAEF"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
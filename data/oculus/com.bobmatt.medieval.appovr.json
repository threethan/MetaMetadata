188248175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRPFocig878Q7kNvwGROSOp&_nc_oc=AdncnEfoJCR5ftEW9cWBGfBw1gllPoSzw8RuPuM_0nL1dQ3tCbRu-WOwrefTy3Hb-zQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afsn0zdYf_H34a6aJlItQ1mYkW1UAG5Ko4uf_Gx8f0yznQ&oe=69A58957"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8GEMLPaazMQ7kNvwHTv-jM&_nc_oc=AdlPcBFeVX9X-k3mMchr22j4G9uX8-ji9z_VZsH1RFsxhdlxBAFmqkqa13xoTje9wvI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsn7wEdacoLxT_b2f19jqGHXH-MNOX2Kx5WZiah98xFqA&oe=69A58C7B"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZ0E9gpvNSsQ7kNvwENZNCx&_nc_oc=AdmNEMan5OFKTSpQnj-0kwHcchmJH_BnBkIRD7TA4RtrcqdXRRuwMEYYwASfNtqyECQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfufKQ12_-YYGrvgzu1T0rTVMc7WDSes9hQRODXwJrBp-Q&oe=69A57999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWLlUmd40rIQ7kNvwG7bLsk&_nc_oc=AdlNS9ubEk4rcftevcj4l6d-5YTcl7e5WkF1zDMMfO5T5MlL4SxP0w5xSbI_kYuHqLY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afu_gPp0lQvj_1Ft-f_28Snurld5J5MRx8Zn11SLqoPwgw&oe=69A577AF"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "es", "es_PR", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3393476147548229"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982708_585305766054342_7552598081797663953_n.png?stp=dst-png_s3
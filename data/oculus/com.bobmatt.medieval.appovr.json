4Zd&_nc_oc=Adrc__CrtxqUXz2j6zd-N_6GZcOI_Z4XJQulXvguIYA3A1DaeUEQYCjPguc9pUPgOuw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNCetQDrE898VbSlejDDuSidl_Ch5fASNGIcxOvoXHJw&oe=6AFF1ABE"}, {"file_name": "8.png", "id": "2914893158763578", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57570295_2914893162096911_3240936520188248175_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9p19JufnB4Q7kNvwGIW1ap&_nc_oc=AdpbED6LPP4mKTC23DaDCokdZtOH57WvAcWQtu7pVabQGUIWBK6AmHZi6O8FZQ-H2XE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwWS4tuxbk07mLHA6SZsiEZFDm8IKUz5IvrUeMSeIkrw&oe=6AFF2A97"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7EeC7Xb5OwQ7kNvwFSL4w_&_nc_oc=Adq7tnLbb8s6gF9MsvEmsJRgNuQuVSONpcE24kDauYdwozkF0Pj0N3vwtM9t_frO1hI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXrU3tj8jrZRwePwijaYjNuK8Zt2A7J4QqNxEg5m5wNw&oe=6AFF2DBB"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Se1wAfDB0_EQ7kNvwFD5M68&_nc_oc=AdoOeRNgzh0xR9BygdC_nFWjaWTL5cS7qq8892AibunlSpWB6pSNzFna9GaV-r9yu-Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScKQKsZh4KXflATyfKu6Jelto4ukR5fdQEulkUu3q7jQ&oe=6AFF1AD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd7TWlGciF8Q7kNvwERSNlZ&_nc_oc=AdomNGT83hVkX1eMOmPOvCvpYJhWFMcXB51i9Lxq_BFejGqLzK59slGEszUJbnciapY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBuPoqYoCfFrvxuZXqL307QcL1zvtiKfuufe8aqFlKPA&oe=6AFF18EF"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proc
188248175_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zo5RXn1kE94Q7kNvwG0AqMv&_nc_oc=AdllTBNsgFHUEnHWNALSHdBvNrpdOWUVLElz0Rjq1tcm7Z6JTleE7U0R5w8-M5ZPZGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afur8_zqyVgh3Oxf69YWLOzDD7JyiYvy-3lQ05JZ4kQPFw&oe=6999ABD7"}, {"file_name": "7.png", "id": "541310820430267", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572957_541310823763600_5727178647050322211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XW5xWvIzhRsQ7kNvwGaCrUL&_nc_oc=AdlpUNHcKJH1h8XkTNAZ5lvnXI_qKnZ1GrVOpmU8QPqCE5bfm-UXlplLVQRGL8CAZeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu-OKuNADKKXc7mmVRQUENMWIPeWapkdCdi0SyiMRzu7g&oe=6999AEFB"}, {"file_name": "6.png", "id": "408877787475060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_408877790808393_2364571868396123249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ly9d6-pUnGIQ7kNvwF992Gs&_nc_oc=Admz0HdLmqbsKA3zpLgnj82r9kDC_me9yTJtH4Li-3FXqLXrvGDNMRcrTcw5hpmGiQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvlavWAnnLc5GwGX5v8g6F40MOYxEbSjntTnvOP8Kqg0g&oe=69999C19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hordz VR Cover - 2560x1440.png", "id": "571294210875456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031440_571294217542122_4911004266676535459_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jln_y4WrloQ7kNvwGM-BHJ&_nc_oc=AdlaLQnIL2aILKkuc9ggUYgdrCFDR79BvsjA0mrezHQNm0jTUIZqmlqgFJEa6B2Pmqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfurJsZ9rYPKke6z8u71z0gFM7J9xxzo9AofD5ol2gAWUw&oe=69999A2F"}, "display_name": "Hordz", "keywords": [], "long_description": "Battle for survival against the mysterious Hordz!\n\nTest your dexterity to your puny human limits, unleashing your twin lightning wands to defend against waves of unforgiving foes. Battle witches, goblins, vampires, skeleton bikers and other members of the \"fundead\". Can you perform intricate monster kill-moves under unrelenting pressure? Probably not, but you should give it a try anyway!\n\nFEATURES:\n- Fight using magic wands!\n- Get a workout wielding spiked maces in the new Melee mode!\n- Over 80 levels of VR horror action.\n- Perform simultaneous kills for higher scores.\n- Silly monster sound effects and pumping original tunez.\n\nThis is an App Lab game, and as such is IN-DEVELOPMENT, so we have a ton of new features ready to be added, plus more in the pipeline.\n\nCOMING SOON:\n- 360 mode with multiple fogs.\n- Projectile weapons.\n\nCOMING LATER (HOPEFULLY - but not guaranteed):\n- Level editor.\n- Movement within levels.\n", "short_description": "Defend your face from being eaten by the horrible hungry Hordz!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.languagebug.com/games/Common/Privacy/PrivacyPolicyMobileApp.htm", "developer_terms_of_service_url": null, "publisher_name": "LanguageBug", "support_website_url": null, "website_url": "https://www.languagebug.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FIGHTING", "HORROR", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_VE", "es_AR", "es_PE", "en", "es", "es_PR", "es_CL", "es_MX", "es_CO"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3393476147548229"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_585305766054342_7552598081797663953_n.png?stp=dst-png_s3
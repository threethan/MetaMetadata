le", "scary", "night", "halloween"], "long_description": "1972, Texas. One night, you had a car accident near the Stafford farm. You wanted to get help, so you went there. But it was your worst decision of your life. What after came...it was the real CURSED NIGHT for you. This horror VR game will show you the real fear. The house is free to be visited, while you have to solve puzzles, and the jumpscares are waiting for you. Play this VR horror experience if you are brave enough!", "short_description": "1972, Texas. One night, you had a car accident near the Stafford farm. You wanted to get help, so you went there. But it was your worst decision of your life. What after came...it was the real CURSED NIGHT for you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.facebook.com/vrpiratesgamestudio/posts/1528767920821553", "developer_terms_of_service_url": null, "publisher_name": "VR Pirates Game Studio", "support_website_url": null, "website_url": "https://www.facebook.com/vrpiratesgamestudio", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7994485027313473"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974706_552471009134308_2277001319933542986_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1impSjN8pwIQ7kN
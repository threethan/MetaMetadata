=6B0C70B1"}, {"file_name": "New Project (22).png", "id": "1581929555861002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392298_1581929559194335_2970278535347755081_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXsak3hDZkwQ7kNvwH4lS4J&_nc_oc=Adqmh3FgzuurdDfB6WT6WpV26UPqh9_7MzdAYBZEu-Qa3cbmfuYDrgilApm8eJmyyN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTObUoVLYPHsiIFEcZhVLFED7mzyhVnDRUWGEApseqSeA&oe=6B0C54BA"}, {"file_name": "New Project (24).png", "id": "437583852677117", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_437583859343783_9054707282491822689_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5VUFXOyAf0Q7kNvwH_4BMZ&_nc_oc=Adp7EglGPY0oqQ0lIAd6iXebyuWpRoWHpeC5x2oH2f0YDUfqP-z48XqOOjlWylUk9PY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpz3-HzpnDG5RyObCIhbztZn8hSeeuLJIqqN0llNPUaQ&oe=6B0C7260"}, {"file_name": "New Project (23).png", "id": "9070624232991147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_9070624236324480_3671440102803764334_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoXPZoE6lLkQ7kNvwHUhYyQ&_nc_oc=Adp8yJybhZfqGDHV7i8xCxnw7S98m6XnwD_x-DLJvRaFr02swWQ5r0hZH6dJgFrsgqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-uykhAhk1P9fJkU0LeuY0ZkhLeglh40ho9rMr0aNapA&oe=6B0C7FDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Balloon Pop", "keywords": [], "long_description": "Balloon Pop VR is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, Balloon Pop VR is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Balloon Pop VR is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.life/policy/baloonpop/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28538769325738656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_588512100721623_2380751256707199357_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3Zc5cgMrqgQ7kNvwF8v4CL&_nc_oc=AdooKsfJ36HJlPt8olY61Z3uA2LJ_QOuFpacxcJ82YxcZ3z9HAbNFiw2TFukbV13CIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRNbpyCopA2dWwwqxo_txNEzr944I3H1PLqRkDG9kp2JA&oe=6B0C6CC9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Balloon Pop", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_
=6B01E4B1"}, {"file_name": "New Project (22).png", "id": "1581929555861002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392298_1581929559194335_2970278535347755081_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xYmz_4Y_cgQ7kNvwFqQ94C&_nc_oc=Adp0WDXpVcyovuYl4LhfYOZKI7vQv90ZoeYcJORU9QufXL63U-9190FJfoI9sa7eBt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFWZGKQa_W2zA3YZs8MiILBZw7SvtBqc8r5-jkySVUdg&oe=6B01C8BA"}, {"file_name": "New Project (24).png", "id": "437583852677117", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391911_437583859343783_9054707282491822689_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2dV7VrL82EQ7kNvwFkqnYL&_nc_oc=AdqGUxKR1R3RJsn8DA91oTSDYWIZBHfPifqh2dtP4kMxXnEMQGRy_vZa1osjeQFp62g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSChoDtZFLIXNF-WbgsJsfTmfR2iOn68UfZFyxy93VtcA&oe=6B01E660"}, {"file_name": "New Project (23).png", "id": "9070624232991147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391959_9070624236324480_3671440102803764334_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ty7HbCpQ6zEQ7kNvwEuH2ga&_nc_oc=AdpwNb0zGizKzxnR2rUH-E-QQDL9QiIH6vahVb3mp7pdSOxEuR8bqmLmNk3SjhU4nOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_1S842vd6aTKo61WX8vDC0ifzU279N5AYSZNnjp3L9Q&oe=6B01BB9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Balloon Pop", "keywords": [], "long_description": "Balloon Pop VR is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, Balloon Pop VR is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Balloon Pop VR is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.life/policy/baloonpop/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28538769325738656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392309_588512100721623_2380751256707199357_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzXH3GGFWc8Q7kNvwHRSubu&_nc_oc=AdpvgQk3fQBAY1XDOeZMBNZzHWuL6OamMpJ4MfSW8Q21W797YoX8KebqnpO2r1v9PHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEkxA5Nla2JRHgP7Y6j3leZYWPTWVGe1DGOCvKVEkbUg&oe=6B01E0C9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Balloon Pop", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_
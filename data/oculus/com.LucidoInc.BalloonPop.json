=6AFF0971"}, {"file_name": "New Project (22).png", "id": "1581929555861002", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392298_1581929559194335_2970278535347755081_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xYmz_4Y_cgQ7kNvwEUetNi&_nc_oc=AdrT_oQVJJs5wFbU8cPM-TE21Ad6C-JTuGEgE60znCwb4IE49mt6X-EkNUq5U-r0LmY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSds3W3NGGJZZjj3T-1cvGct0GYiBZ8JuZfrIjAM9EZaw&oe=6AFF25BA"}, {"file_name": "New Project (24).png", "id": "437583852677117", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391911_437583859343783_9054707282491822689_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WL8GgK-rd8cQ7kNvwGKOVck&_nc_oc=Adr9ysVirNAjvpQ0UPSA_OGQCttW955SoOwrMqCCKJn3ZtlFDjD2G86cgpE1Z0P-WOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyuV6_65wTOiKVMRPhmvwPoxRfA7EH_l5ooV5R1iNCwA&oe=6AFF0B20"}, {"file_name": "New Project (23).png", "id": "9070624232991147", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391959_9070624236324480_3671440102803764334_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAtIFyahsvcQ7kNvwGzRm59&_nc_oc=Adp6R1j2RHzhtitlMfGl3Ft_qgoMUExhWHsnNuRA-PRFoGAu9SQd0A7OAiRyfUhj70s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkuyPOL4eehWYhFhm_KH2AZHVYRdlUxHagpzYmJmhnAQ&oe=6AFF189F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Balloon Pop", "keywords": [], "long_description": "Balloon Pop VR is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, Balloon Pop VR is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Balloon Pop VR is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.life/policy/baloonpop/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28538769325738656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392309_588512100721623_2380751256707199357_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJp3SKgBfJYQ7kNvwHooqTE&_nc_oc=AdroJTv6dqt3s7pzzVvyoAsykXRLFxuvKmHZVc4Vs-l7YtEvGHFA9ZNj4nLiZGmoS1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLFYY9JlpXARz9yfBivUxk-5_SX6zDJ-6OYm5GBVbmyA&oe=6AFF0589"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Balloon Pop", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_
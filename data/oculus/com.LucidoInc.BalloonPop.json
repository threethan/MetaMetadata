s": [], "long_description": "Balloon Pop VR is an exciting and immersive target-shooting game set in a serene natural environment. Armed with a crossbow, players must aim quickly and precisely to pop as many balloons as possible before time runs out. Featuring intuitive controls, realistic physics, and a challenging time-based objective, the game offers a fun and engaging experience for players of all skill levels. Easy to pick up yet rewarding to master, Balloon Pop VR is perfect for those looking for fast, skill-based action in a relaxing outdoor setting.", "short_description": "Balloon Pop VR is a fast-paced shooting game set in a natural environment. Use a crossbow to pop as many balloons as possible before time runs out."}]}, "developer_name": null, "developer_privacy_policy_url": "http://lucido.life/policy/baloonpop/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28538769325738656"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "929055746012156"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739337120, "status": "PUBLISHED", "id": "929055746012156"}]}, "liveChannel": {"nodes": [{"latest_sup
71-25/38982584_456865842548988_7373684852645531548_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtpTJmRkMH8Q7kNvwGQ3NiH&_nc_oc=AdnZdYCWJF7L2qtBQjIc9IlU6NTrVfiv-gtm2wwKOqcfL8sfvkmuCSCdpsPNQuC5Xdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzpUvC2EC8dMt8LYado38EC6t_npj_q255HJNfWuDeuXg&oe=69B56256"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LUXUS", "keywords": [], "long_description": "Outside of the common applications for virtual reality in entertainment, healthcare and education, VR technology has the potential for completely revolutionizing digital marketing moving forward. Beyond question, it will also make an indelible impact on the way properties are presented in the luxury marketplace for many years to come.\nLUXUS is the first Luxury Monthly Lifestyle VR Magazine on Oculus platform with a focus on Luxury Real Estate, Yachts, travel and Private Jets.", "short_description": "LUXUS is a Luxury Monthly Lifestyle VR Magazine with a focus on Luxury Real Estate, Yachts, Private Jets and Travel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.51Aliens.com/vr-privacy-policy", "developer_terms_of_service_url": "https://www.51Aliens.com/terms-conditions", "publisher_name": "51 ALIENS LLC", "support_website_url": "https://www.51Aliens.com/contact", "website_url": "https://www.51Aliens.com/Luxus", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NEWS_AND_INFORMATION", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAM
ohc=pM0kDPYTQNoQ7kNvwHuKkK1&_nc_oc=AdohXr3XtF3rfLonJIATGm4oKBbH1uQn_rP3EdjgcP7aYaweYEE1700F2FlETbbxXzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA7XjrqZbtrsrOEoREUK-c7pCgXlveNyIeJkw19P7gCg&oe=6A770EFC"}, {"file_name": "Screen1.png", "id": "1583023412721189", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823366_1583023416054522_6300916767423891282_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyNMeWAROo0Q7kNvwE4yHyK&_nc_oc=AdrNEZcoyaXK_qjGnL_bBydnKswf3OTx8WQOrfXy8tyemp6qGXCNmNsdq2tGtuyTsNA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPSQDTcxNj-yM2ifXMTU4KGvkld9HfV3KHmWbbyK_E7A&oe=6A771410"}, {"file_name": "Screen2.png", "id": "1409058487543197", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_1409058490876530_8596743297534186469_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSRzMjqHBfUQ7kNvwEe__et&_nc_oc=Adq7GzAO-kLWERIb43r08eTntHIW67bHbvHfwjqRYYxg4hZU6XlHr4ZNA0FbGn3OOzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlEOz6q5UhTpnfAO40o9V36ju5cJhlY2W4yhVAMStUQg&oe=6A773A0B"}, {"file_name": "Screen5.png", "id": "762394523559935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820923_762394526893268_4517060361624265389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lRiwH7trrIQ7kNvwHfIUz0&_nc_oc=Ado3by-stEPq1ekE2wxmCSjjhhSusiIWGEj3VtCmFISg7-paZzQei6dGMyoRDb3QT50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5d1Qd7UWqVYYSnV0IslldYfaboqs_WabRumk3CV4uug&oe=6A771E8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s2.png", "id": "748644034368386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_748644037701719_6986868492997336920_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZbi5-WdqWoQ7kNvwFB2HZ-&_nc_oc=AdrqOxQzqd6lyWENqFSX-AnyjZFvJSmEN1sMvduzQjR6mmL7RPMe8N3-IDyqjv9eIjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbmd6Aoz804pMq0w-u0TSZYkdK_5U1Z7Y8kuCnY-u2cQ&oe=6A77271D"}, "display_name": "Jazz Dance Fundamentals VR", "keywords": [], "long_description": "\ud83c\udf3f Jazz Dance Fundamentals VR: Hands-Free Learning\n\nLearn the foundations of jazz dance through natural movement. Jazz Dance Fundamentals VR is a hands-free learning experience designed to help you build technique, timing, and confidence using intuitive hand tracking\u2014no controllers required.\n\nMaster essential jazz dance movements step by step with a responsive 3D instructor and clear visual feedback designed for effective skill acquisition.\n\n\u2728 Key Features\n\n\ud83d\udc40 Interactive 3D Instructor\nRotate your AI instructor to any angle with a simple finger swipe. Observe every detail from the best perspective\u2014like training with a personal coach.\n\n\ud83c\udf00 Motion Trails for Precision Learning\nVisual motion trails show exactly how each hand and foot moves, helping you understand, follow, and replicate every action with greater accuracy.\n\n\ud83d\udc3c Slow Motion Replay\nReplay movements in slow motion and adjust playback speed to break down each step and refine technique at your own pace.\n\n\u23e9 Fast Forward & Rewind\nJump between movements and phases instantly. Focus on specific fundamentals without restarting entire sequences.\n\n\ud83c\udfaf Fundamentals-Focused Training\nStructured lessons designed to improve coordination, rhythm, posture, and body control through core jazz dance techniques.\n\n\ud83c\udf04 Immersive Environments & Music\nChoose from 20+ environments\u2014mountains, rivers, oceans, and more\u2014paired with music to support focus and motivation.\n\n", "short_description": "\ud83c\udf3f Jazz Dance Fundamentals VR\n\nLearn jazz dance fundamentals in VR using hands-free, controller-free motion tracking. Build technique, rhythm, and coordination through structured step-by-step training with a 3D instructor.\n\n\ud83c\udf00 Motion Trails show hand and foot paths for precise learning\n\ud83d\udc3c Slow motion replay\n\u23e9 fast forward & rewind\n\ud83d\udc40 Interactive 3D instructor for all angles\n\ud83c\udf04 20+ immersive environments with music\n\nLearn clearly. Move confidently.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "https://tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26059938193676695"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_2330227120773294_4069856042447151664_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWQTv9PY0mgQ7kNvwFyL_Is&_nc_oc=AdrEQlgDZsJarpztmTViJ4ErJDicIcGmqParQzKVtWxoGjNNg4Oy8MHydGqtPm-689o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEotxUneclLD89Ft2B2lK6qN97u7REhdLHYC0WT2kd6HQ&oe=6A7722A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jazz Dance Fundamentals VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "r
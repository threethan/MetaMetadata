AO-kLWERIb43r08eTntHIW67bHbvHfwjqRYYxg4hZU6XlHr4ZNA0FbGn3OOzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlEOz6q5UhTpnfAO40o9V36ju5cJhlY2W4yhVAMStUQg&oe=6A773A0B"}, {"file_name": "Screen7.png", "id": "1824883158915291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819845_1824883165581957_2725393410263908533_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqKYY2EBuSwQ7kNvwFOZrb4&_nc_oc=Adrasdr1dLM0YoCS7iBTB30HPbja4zhXhvzLCvhb9aRItoOWzIbmNVvuBeiLPKorDNw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtI14dEbNAR4qpQRVEygHkwffoZeoEp-BjKe4ujSLg7w&oe=6A771F56"}, {"file_name": "Screen5.png", "id": "762394523559935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820923_762394526893268_4517060361624265389_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lRiwH7trrIQ7kNvwHfIUz0&_nc_oc=Ado3by-stEPq1ekE2wxmCSjjhhSusiIWGEj3VtCmFISg7-paZzQei6dGMyoRDb3QT50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5d1Qd7UWqVYYSnV0IslldYfaboqs_WabRumk3CV4uug&oe=6A771E8F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "s2.png", "id": "748644034368386", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_748644037701719_6986868492997336920_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZbi5-WdqWoQ7kNvwFB2HZ-&_nc_oc=AdrqOxQzqd6lyWENqFSX-AnyjZFvJSmEN1sMvduzQjR6mmL7RPMe8N3-IDyqjv9eIjo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbmd6Aoz804pMq0w-u0TSZYkdK_5U1Z7Y8kuCnY-u2cQ&oe=6A77271D"}, "display_name": "Jazz Dance Hands-Free VR", "keywords": [], "long_description": "\ud83c\udf3f Jazz Dance Hands-Free VR\n\nMove with your hands. Move with your body. A Jazz-dance-inspired VR learning experience using hand-tracking only, designed for comfort and natural motion. No controllers. Just you.\n\nThe app features more than a dozen popular Jazz dance movements and pop music tracks.\n\n\u2728 Key Features\n\n\ud83d\udc40 Interactive 3D Instructor\nRotate your AI instructor to any angle with a simple finger swipe. Watch every detail from the perfect perspective \u2014 just like training with a personal tutor.\n\n\ud83d\udc3c Slow Motion Replay\nTap the Panda button to replay movements in slow motion. Adjust the speed to learn at your own pace and refine each technique step by step.\n\n\u23e9 Fast Forward & Rewind\nJump directly to any poses or stretches with easy navigation controls. Focus on specific movements without starting over.\n\n\ud83c\udf04 Immersive Environments & Music\n\nChoose from over 20 calming backgrounds \u2014 mountains, rivers, oceans, grasslands, and more. Each environment is paired with pop music to keep you centered and motivated. Switch instantly with just one tap.\n\n\ud83c\udf1f Train Freely. Move Naturally.\n\nWith Jazz Dance Hands-Free VR, your hands are free to move just like real dance. No controllers. No barriers. Just you, the movements and the flow.", "short_description": "Welcome to our immersive Jazz Dance Hands-Free VR application, where you can enhance your practice like never before. A Jazz-dance-inspired VR learning experience using hand-tracking only, designed for comfort and natural motion. No controllers. Just you.\n\nLearn Jazz dance with 3D tutors, nature scenes, slow motion, rewind & fast forward!\n\nIntroduce precision into your practice with our slow-motion feature. By touch the panda button, you can replay current pose in slow motion. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://tianlingamestudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Tianlin Game Studio LLC", "support_website_url": null, "website_url": "http://www.tianlingamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25151345054536018"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1365927262346652"}, {"status": "PUBLISHED", "id": "1223357886469732"}, {"status": "PUBLISHED", "id": "1506448907503524"}, {"status": "PUBLISHED", "id": "1413640850508029"}, {"status": "PUBLISHED", "id": "4134776850073163"}, {"status": "PUBLISHED", "id": "1282065027082398"}, {"status": "PUBLISHED", "id": "1721900152120595"}, {"status": "PUBLISHED", "id": "1579529619911087"}]}, "baseline_offer": {"id": "1579529619911087"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1365927262346652"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26059805837023264", "version": "2"}, "id": "34062334056698690", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25151345014536022", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26059805837023264"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "34062334056698690"}]}, "change_log": null, "created_date": 1775330648, "id": "26059805837023264", "version": "2", "version_code": 5, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 
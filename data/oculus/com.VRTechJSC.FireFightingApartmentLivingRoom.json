"}, {"file_name": "Screenshots_5.png", "id": "688538363710214", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825083_688538367043547_8339565361145244299_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0qrrqUCmYwQ7kNvwGNmuoe&_nc_oc=AdpqfpGu9Su_TDTwPX8PqGRzAGOLt5hGFicpH-GzfwSwhDFekl_5dM2Vzg1E6hOyKNg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEQ_BPJZ3o71eoDfYnT9gG8Fo3n2phgq_Mbo_JUNK_5A&oe=6AFF0835"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgeXwsxkoPEQ7kNvwEfUFzv&_nc_oc=AdoY_9r1URygcQKEAHmAfR0XtOdmgUG4eBrGpuJSd48iBfKd_GTdfablqOCtK0j5T14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzuQ81dkOsKtGqP3GRE3Jwcebaix8RTjdv0HLotPE88w&oe=6AFF22AD"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsXO3l_-CpYQ7kNvwFTzt9W&_nc_oc=AdoAsGLCOncNRAw9ZE2Bnleew-daiMKO13HP6dQ5qK4JhKycW94YaNvOWPMK2AQZyn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXxpoMMvNJMXMrX0criYfBbtZs-L8f3AltQWTRWSt6mw&oe=6AFF082A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS3qJh7sjnsQ7kNvwFleUQo&_nc_oc=AdqFxcVyMHLzbtkMXf7dQrS4PXq5ZtRbOehsijIZRY3xPChNKfsERcNDfIn-fZIWhlY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqjEYZ1pT2YIIU1ggEL8phYQSquxgPvkSKYKZDLfaH4g&oe=6AFF1580"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category":
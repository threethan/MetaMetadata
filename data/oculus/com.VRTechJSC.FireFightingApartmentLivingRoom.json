"}, {"file_name": "Screenshots_5.png", "id": "688538363710214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825083_688538367043547_8339565361145244299_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbykrDVGcr4Q7kNvwHG9rvC&_nc_oc=AdrE5f6B0js-LdR7Lne0-yOLrp-TV-DNImDh2rPDyMfFnwfuZUgVAUW-UQJEVZbVdrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDmRK1-EQ0IrY4zoGUkIirxxRbLObe4lhg__1WAnoiDg&oe=6B01E375"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPLrc48itpUQ7kNvwG9yKlp&_nc_oc=AdrN00Iz3Cb1YsIEX4zZWdLGow_A3pWLj8nJ7RFBTvynh1jPdL-vfthNwzJ-dOVWg-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1KfEsTZP06K7CXcVrM1aEGmISdoJB5KHdQEpErKrD9w&oe=6B01C5AD"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsXO3l_-CpYQ7kNvwH0GNKC&_nc_oc=AdpnIzW9yMCQ61ZmRQn-vVUQnVaMdLVJO-hKWRv9cNfRyr0tMDEqu4v54HrOEX9HP5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7LSHhz3j37oqNnlQa3drdKhL_VPInGgdZwZMhLGYLzQ&oe=6B01E36A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WM-MrcmWJwAQ7kNvwHBfTCP&_nc_oc=AdpuE2TL8m-px4TFULXo7-xwUNc2CmMUsweFM5CJfMRRFgiJBvkU2Ug7il71FfmLW-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_z7NbiIH0yJcuU6N1kgc3dAqlG8K9QMmXSv4Njf8QfQ&oe=6B01B880"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category":
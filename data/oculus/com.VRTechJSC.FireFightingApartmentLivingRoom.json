1pv1NQxhNEpyNEXbLiP7AxldnXvj5zVYjee-MUM8WEB2Bijwzf5wwNbwU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3UVIcbe-2uQcMyGk7Bug1ASxOlrM2xebGy4sTq2MFrg&oe=6AB685B5"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb4hN_ALm60Q7kNvwEbS7HB&_nc_oc=AdrcYS3iiBxT06zNqoONQGcFVqwvQXjZmzDJjkcrhfTtLO_0yr-ZbuHJwsqTqTFGkvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI24czH5So6YhzhHuaumpaNSmhJHfbY8jcOwG_a8ptOGQ&oe=6AB6A02D"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLAeVyqc_sEQ7kNvwEmhUnl&_nc_oc=AdpSLE9qOgErL9XT5XMhT1DlG8afwBXqFpgufEg6G5RFm5au0iX-NdKk-APJkMHfN7U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJniZtMDdUPrCJvGRp9DUU3801Ms_BxOQbHpsscJYv9cA&oe=6AB685AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7nrwU3WLVkQ7kNvwF96sU7&_nc_oc=AdogeWHvdAJYvN9YJdn-Uy4i9FAlS2bXRsUYTu41tZTp-_k6PTS3lofPabdXZ9ppQ3s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7TuWHfBdJNLcvMrtHi1pluVnKx6cIXEpzdIeBUmnOiA&oe=6AB69300"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
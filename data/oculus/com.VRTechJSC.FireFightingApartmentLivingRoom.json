Mc-yf&_nc_oc=Admc_VZpBJC8zCFrUJsrxkeSxjPsIUSTbc4s7ZHxmwTcyJowDc_OLpjW2ccLy8litCU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4lxlKPUo88zBwIgEFXl5CEYcz-xieX8uZQAiqiDOY5w&oe=69AD6A6D"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWQJg1nHgmoQ7kNvwEu45Rt&_nc_oc=AdmIWjtNSssEqn02SHSoep_RqBCQMiyRhVlRVb551gifJvtFSUJQ1nyvZaZD18jJFjM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu6fSXHmoF1LsMvPKAtRVjFBgpauy7DHiUer0eILP-ZQ&oe=69AD882A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxPqol3YhEAQ7kNvwGKn7Ex&_nc_oc=AdkuQEmJDt2DMgnZBsSl33My_vxekFb50cE_aKFNJo4oEtR8DGa4k4iOnbGA9lVe-NU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtwTnHrFYKOz79pJQ5Bpo5UC0lVw22GtaB3XgZwt9fCw&oe=69AD5D40"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9561515030552958"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "893599366983238"}, {"status": "PUBLIS
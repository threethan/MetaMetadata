qw9Hc8of5XLpiwE9TgljQO-YfFc1-ejJ_Wvdwc6EbkPiqspQ95aNAkfmQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqDtVsy8AUOgX2HXo7fkwFMJZaMQt2rSYS-HApW4wnXQ&oe=6AE89EB5"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Jh5QATR5qQQ7kNvwFu78NV&_nc_oc=Adr1lYyvxJ7NPjqkkErirPJkCzQQFKJGiC_qS3BrAxgu5kSi7MpnAZqRoJ_XSnCymkA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXVGjxmVv4XiaZehkg5ruqo1i46gOKRPdHRWu97Y-jQA&oe=6AE8B92D"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vfiskx-aA8Q7kNvwEHrfgJ&_nc_oc=Adprl5xBnzRevrvrHqzaSgdCiMAI77aeUpVJbL88-74VCY1nCUN0D9w-RJX4ORyS-48&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuIBCCn3GSFcBDHL62GZqR2Vn22PQ3ypnVrmhI9KXyYA&oe=6AE89EAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GN4epKVDRl4Q7kNvwFeJWZS&_nc_oc=Adrx0EqmGOFAQZhkWvu0YlYLaZKMNLePBnVxJZORmTMmKdvuxiSnMFKyJ5Un-B-6k3E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTJ8PA1RVQ7kQ7BfmM7_9rzK5SCTRP4761E7rCIsM8UQ&oe=6AE8AC00"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
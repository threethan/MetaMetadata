c_ss=7f20f&oh=00_AQHD2onOvzJ1k0729KhBID9Ur5bw3czrIbqYBRHicGQT5w&oe=6A8D6EF5"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBWqSx-dYq8Q7kNvwEmaKoC&_nc_oc=AdrwRGSAuSAjN2vq2Jtt95Vxvb92L-SEh_-EBsVPk6ZmCXYF1LjLFZ0npXM4Y4YdjEg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_NDJebbQQzsbf0XVrCt-3_klNbU9FXBJ2Ue7ql9bJig&oe=6A8D896D"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSb9tIqoVNYQ7kNvwGGaQdQ&_nc_oc=Adp9Xo4HwwSoMGrACEPG7dDjipdmH2aa1s4i7iLeZOCN0OJ3fNwDu_RoAV0F3Zq3Upw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLolf-ZYKbENWh-e2qHhRWqEQpkJxGnaegrXY8NMbmYQ&oe=6A8D6EEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZNRwNLdItYQ7kNvwFIXl5v&_nc_oc=AdrwqTE3BaDqzu-zcl9hKYUtN_xErBKK8zfcj-V15kaFe1mkptOeSjSZ-lL8wv4Ior4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgqehYI0r6Q6rds9BSGTJ7_Eq6KUiElknPWd0IlHhRcQ&oe=6A8D7C40"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
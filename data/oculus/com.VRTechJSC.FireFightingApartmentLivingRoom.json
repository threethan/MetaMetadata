ontent-ams2-1.oculuscdn.com&oh=00_AfsTYhejVACl0KNPQE0JfvJ-uNYV7FvbeMPvtx2LJQoDlA&oe=699EE9ED"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr8k0cjXwsoQ7kNvwGtZQTP&_nc_oc=Adk7H9x0Al_EKqffIZdk9jayWxi9d27M9s5LwjY9THOyHOjri1G7jDoOqfxvAfC5aVo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvwTeN5WUfSNxWQ8y-ejyP9oTviziJ-bPMVEob5I7bjAQ&oe=699F07AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrZFnAI5DwwQ7kNvwEbeE5S&_nc_oc=AdkYprR3Ur6DDuRZzEVAsrns2ZsyLENsvqsNRL82toY2g-JRuLdqOITRT-y4P7RgGgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu4eN9joKj26TZ9lshlU9M9bCXBmw5GWDwHUY1c3Cog9A&oe=699EDCC0"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9561515030552958"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "793996670393723"}, {"status": "PUBLISHED", "id": "833918799633334"}, {"status": "PUBLISHED", "id": "1440629090520292"}, {"status": "PUBLISHED", "id": "120833129108
Bmqh9UF3vChI_IRogpMHbT6Hqqbct0ndHYxYNkTO111NulGopuj0OVrVY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYxdc-wjCHb2nzNcahYBaOT8bSEkdyd3_Azy9QFAwYbQ&oe=6AD386B5"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gv133Fp-5kQ7kNvwG3CWVz&_nc_oc=AdpYx0nQFqTvcPn9WIgcsx--obUdnozG6HI0vJ7fqm-kuHUw_KBEnizfyeoQ6-9VKg8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTGhkBtv34u4DrZMftBozVxFTOJw3sXZFQwBUbgLWA7g&oe=6AD3A12D"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKwkTHVvqPsQ7kNvwF7_qyj&_nc_oc=AdqZZdDisnMyXASjFtTk3QGSZWol5CouBSxf1uqAIzVKwGOG5l9BqmqGeE2ml2CFLyk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzDar1qo8fPk4a87Cba-LZcbxYA6_EZbjFdgNGxUPvqQ&oe=6AD386AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWhoz9-3AEkQ7kNvwHIjsKa&_nc_oc=AdpVSgOprGs3zH3krfd0OQqCdU5xmRZeZf6AibXn4EZ2wU95dTijGlIHUAjXh7tkt6M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsDagR_mXfRd__Rhi4Z-M4zsRHWw6zfH6VSbhAoUMHZw&oe=6AD39400"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
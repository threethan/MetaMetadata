"}, {"file_name": "Screenshots_5.png", "id": "688538363710214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825083_688538367043547_8339565361145244299_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CHvMugfDMkQ7kNvwEMJXot&_nc_oc=Adoo8wTqyzU5WuAYKDndCyg-UH-B1uX-N_Vcnv73g9igzh22P7O-4HrShgGDcQJ2kEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUGzoM-SoLkiQ_-w_LYTS0t96rJYM0T8ksRRFtxHOehw&oe=6B06F135"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrUUH7qIpDwQ7kNvwF4zqJ0&_nc_oc=Adod1OdcnZnfIlTCKfyr7Qox_K2U61EFCQKFbLVRaf6VWtZhU3V4ZujeiKhD3dy__UM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJsTkKG96i8bPDu9DixqRaafkEifov5fW9D0QNTpYnOw&oe=6B070BAD"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lGxPCJP-g0Q7kNvwFFfuGo&_nc_oc=AdoM2Nq7Ot4Ll3yvMeHqELTH6m2GJjRG_cf8I102QtcM3idqkHbdbKvtg2spCrOQY_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_7mSDkT1sklpHbOWb8fteKbdJ25wu9gL8J3mYWbYw4Q&oe=6B06F12A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAXvIVcIz98Q7kNvwEoBykT&_nc_oc=AdqLTrsEnE0775N7Mx0PgGf0SFcj7g4VQBpHnjkSzdXKbMCeEWVYnElARgZl0loOdlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqUDOIuLwmyZvrAVKI4IVK6Nd-z4RBE4xOOuKJzz17ng&oe=6B06FE80"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category":
-7&_nc_sid=6e7a0a&_nc_ohc=XhI5UkXT96gQ7kNvwFRmuCs&_nc_oc=AdrTaQAo37C_w2IBReqqxbifbvauMkDvSoza81WOve8celdilOf6v9qqMFRPiEfsT6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUkuntSySpODeJ3oZAiXV7QpNOnua5YvMZavIEuUxAnwg&oe=6B0EFCC4"}, {"file_name": "Screenshots_5.png", "id": "688538363710214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825083_688538367043547_8339565361145244299_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoqU_TjaVuQQ7kNvwHV1LKS&_nc_oc=AdqGNb1pKS5XdwNew7fwtjc33VfimFi3x2rSqE1jhxU5k7-MOseXhGTIvAT8OsEMO34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6Iksdn3P0w2tWe7tMSR15FyvC5EqmPJvvZejz4xKO5A&oe=6B0F1275"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYALFfTP9mUQ7kNvwG8uaVr&_nc_oc=Adqlq5XYFixeTP5er2GA3-VCxVwzYBl48dx2rvNjzLkAK3WzY_r9P4mjo-N-5QTRC2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWnXUgN5rdc6WBt-U_fIP31-VbR-HhQlcKSTyQ4Bvvnzg&oe=6B0EF4AD"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTi32QAPIBQQ7kNvwFyUniQ&_nc_oc=AdpQxbJk1zduQG9S0XPSi8GfTRfH8dqjLzHnV1TQL7WB8GkeP8el8wfVbzxwSj64Py8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZeMecyXQsx2Adgim40dYHchaKZkKUbVQD0yCMPdkCxw&oe=6B0F126A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rs9JDjbQDpgQ7kNvwFhQhU-&_nc_oc=AdrX84CLZ8lBf4tG_QBi7WeYmpRvVY8WB2mzOg6YDE-GvcOY347oS0oa-jY6vfBv3tQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXe-f45-w8TiqulCahWcCMJPZ7RfmnKUvq4ZxdioqIChg&oe=6B0F1FC0"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null
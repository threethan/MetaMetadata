"}, {"file_name": "Screenshots_5.png", "id": "688538363710214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825083_688538367043547_8339565361145244299_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbykrDVGcr4Q7kNvwGmW7qx&_nc_oc=AdqipXYX-TGhYFg84WEVKXgOUGqqL8muIuJDjFWNo4qj1Ea-W5CMnTfsnHW4PIutijM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_dM7JREjv-2Y5gZ2p6HDPageTLTd6oEPadiyitV_rhg&oe=6B05D7F5"}, {"file_name": "Screenshots_3.png", "id": "1203859878006635", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820287_1203859881339968_5313052375179452446_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrUUH7qIpDwQ7kNvwGHMrkc&_nc_oc=AdoN8-dkepx89bEVr_EYCGDy6zTJKvjpmtoTthTS8z2KMoVVPY2TcNar3Zk9r1HRaww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAgf5_CowAMOXE-ZVyO5imCd8kX8oV65FCUVuYKdCDHg&oe=6B05BA2D"}, {"file_name": "Screenshots_4.png", "id": "1024321326299470", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820956_1024321329632803_8115950694386031837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhgJ6dZDs08Q7kNvwHkDyV-&_nc_oc=AdoVyXc2ElVWnY68VRpDeFGrmNgT0o9KtACFEVnv1FaJiOvVeut3v8vFLaX9RdLotgg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUQd5rzSCWPsELWsZj87lfNcE1TBEDx57uR0tEnU7JAQ&oe=6B05D7EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "696616942709319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819376_696616946042652_8477370952557970672_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAXvIVcIz98Q7kNvwHiHP_q&_nc_oc=AdoDB6-0kv9ZtgXdLrliwvujYlyPkKXjit948kuoHo-DtG7JJnrX4UMqink8Q6LiVFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkc1mG-LRpKts1PMPnbYsiFT3UIfNEewUsZvVmoLOwag&oe=6B05AD00"}, "display_name": "Fire Fighting: Apartment Living Room", "keywords": ["training", "fire", "extinguishers", "rescue"], "long_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter tasked with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game combines interactive gameplay with practical training, focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles.\nGameplay Overview: Players start in a virtual office where a fire breaks out\u2014caused by electrical faults, paper clutter, or chemical spills. The objective is to assess the fire type (e.g., Class A for paper/wood, Class B for flammable liquids, or Class E for electrical fires) and choose the appropriate extinguishing tool. Using VR controllers, players grab tools from a nearby safety station and operate them to put out the fire while racing against time. Visual cues, like smoke color and fire intensity, guide decision-making. Mistakes, such as using water on an electrical fire, trigger feedback and a chance to retry, reinforcing learning.", "short_description": "Fire Fighting: Apartment Living Room is an immersive VR training game designed to teach players how to respond to office fire emergencies. Set in a realistic office environment, players take on the role of a firefighter task with identifying fire hazards, selecting the right firefighting tools, and extinguishing fires safely and efficiently. The game focusing on the use of water extinguishers, CO2 extinguishers, dry powder extinguishers, and fire nozzles\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category":
//scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593809430_1036484882775303_7394003769219211494_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtWb9ucB-1IQ7kNvwEIfeSf&_nc_oc=AdrsqsPfpig3CJ38dSw14r_wFxi2TDF4DQDwBCpX93WZmWGk4ln2xD4_TuXhCZtKluE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJvnkioWe6CNS4d9Tdnzq47LPaKS_8794KJbBoCwWFmQ&oe=6AFC933B"}]}, "id": "2569762673501259", "locale": "en_US", "screenshots": [{"file_name": "screenshot_3_mansion.png", "id": "1752007076048929", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628454_1752007079382262_4225575784723097995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBUUI_F3tBkQ7kNvwFwEsGS&_nc_oc=AdqU_So_6XqKUpVK7TQrZi_EdTBgxfJo4AkLZlJ78G_sLiuv2XLK-bdRULMmZU4nImA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZAMLhoXWLkG48iTh9FnMCLgBAmv___GkqpRFguzXQKg&oe=6AFC6979"}, {"file_name": "screenshot_2_island.png", "id": "1735942167482301", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623551_1735942170815634_9205096390784271792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDlBZhMle94Q7kNvwEh1NuM&_nc_oc=AdoNCtzJXfdfX-kx7UFapLcxROB2FS_qzItz1omyD2Ic6cgf68QJ6kE-5YYd6F97b8Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT70kZd8GMSgBTDBrHaUSQ9n7ETlxIaaI5KLhweGi6vXQ&oe=6AFC8D18"}, {"file_name": "screenshot_1_farm.png", "id": "1132143579494283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628449_1132143582827616_9096500143647862894_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VM5B1Q_jW4Q7kNvwF3bqIl&_nc_oc=Adr3ylM23HZIcxJur9Npp2KHOocHUCdUxv2kvLFgrORBYD7fGYbuyg90yXu0vP_rZYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTal8CxvuqZznqg3SJw5MCvZpfcJzOg5S_cIIJ5Ed9qMA&oe=6AFC80F7"}, {"file_name": "screenshot_5_lobby.png", "id": "3293807807494648", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628050_3293807810827981_5247912479582331179_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJyCVrEzzNoQ7kNvwGXdpaz&_nc_oc=AdpZuS5XwHl6oY24FmkcfeBWmLwqvDr-PKUQMvc_oMhxMl0k83D4BfwMeSV4B_qnLFw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY8qUc2xUa0FZJPDj2LhCWOByfsX6b8FojfYBm7GN1dQ&oe=6AFC6D6B"}, {"file_name": "screenshot_6_space.png", "id": "2281822585990491", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628446_2281822589323824_7804340298528583219_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hea--jeyi7YQ7kNvwGrCe6D&_nc_oc=Adp6fIXEnq87q9BKMFlxUQGSU3_XwFmd13PJkh8VHeZcVtAC1cJPSC8xWhWNlZxsXjs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQWWa0geYF0pgbZZjhSc2WVxKaZs3Gc4uig5zccnApqA&oe=6AFC5DE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FERAL!", "keywords": ["horror", "multiplayer", "monsters", "climbing", "sandbox"], "long_description": "You have no legs to run on. You move with your arms: push off the floor, climb the walls, throw yourself down a corridor. That is all you have when the lights go out.\n\nGO IN\nSeven levels, each with its own monster and its own way of finding you. A nest that hears your hands on the walls. A house whose owner is home. A crawlspace with a doll that only moves when you look away. A train that should not be running. A haunted mansion with five things living in it.\n\nGET OUT RICH\nCarry out what you find and sell it. Photograph the monsters for more. Spend it in the shop on gear that keeps you alive a little longer. The richest players are on the board in the lobby.\n\nBRING FRIENDS\nPlay online with voice chat. Everything is better with friends, and worse.\n\nTHEN PLAY SOMETHING ELSE\nPortals in the lobby lead to more games:\n- BLOCK WORLD: mine, craft and build in a world of blocks with caves, biomes, a Nether, monsters of its own, and the Moon above the sky.\n- BECOME THE MONSTER: one player is the monster in a corn maze on a farm at night. Everyone it touches becomes one too. The last one alive wins.\n- GUN GAME: drop onto an island, open chests for guns and rounds, keep away from the lurkers, and be the last one standing.\n- SPACE: loot an outpost on a dead moon under a ringed planet. You weigh next to nothing, and the stalkers are fast.\n\nAdd-ons change how you look and never how strong you are.", "short_description": "Swing through the dark on your own two arms, grab what you can carry and get out before something grabs you. A multiplayer horror loot game with seven haunted levels, a block world to dig up and three ways to turn on your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Jvl0v3CHiaziL3dc4AhvfRHmxyrAS86HmPH1tleYfZA/view", "developer_terms_of_service_url": null, "publisher_name": "WackyRY", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Jvl0v3CHiaziL3dc4AhvfRHmxyrAS86HmPH1tleYfZA/view", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "1467927318766230"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4647040015525450"}]}, "baseline_offer": {"id": "4647040015525
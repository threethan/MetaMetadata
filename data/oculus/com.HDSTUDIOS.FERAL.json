//scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593809430_1036484882775303_7394003769219211494_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U57W8Knztd0Q7kNvwHaYUD0&_nc_oc=Adrlzq-LIDcXC0Q3PAG1HuFB96JffeyBvEKRqx_OTIL8UJO5wtKRmsGwXhb3jyKJCtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWk57TdG-Fz0SjLdcwIHkFxArr1bgwlsUX_w9KlYdBuqg&oe=6B1059BB"}]}, "id": "2569762673501259", "locale": "en_US", "screenshots": [{"file_name": "screenshot_3_mansion.png", "id": "1752007076048929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628454_1752007079382262_4225575784723097995_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMe78snASewQ7kNvwGVTGHL&_nc_oc=AdrQ-Wncp9K68TVYVEhKjm0hg4VA_KRkglcT4SLReuBeFRJUWY7z-Nh1PgR6Scz5gos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5ITzzF6XmGAfNGPUxF07N6JUw3v5uESxvpTtk4ucbqw&oe=6B106839"}, {"file_name": "screenshot_2_island.png", "id": "1735942167482301", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623551_1735942170815634_9205096390784271792_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjAf7umeEtwQ7kNvwEEZEOm&_nc_oc=Adp4Y4rsO2pNEkLqQW1bu0fZmhT_koAQd2oPfg9FGcFKRFCZwiPz9UNZ5ZMnGqEQYz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8vq4M9LB0BesKbJ4-JlopB9w9IUy3GqNg2FkaiHEpIQ&oe=6B105398"}, {"file_name": "screenshot_1_farm.png", "id": "1132143579494283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628449_1132143582827616_9096500143647862894_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ruZxgqu2wkQ7kNvwFPbmFs&_nc_oc=Ado9ZEITkbVwSzkUVcP7yvyhxj9dZoTttsBk9nQQIHQv8syuvrFg12lKZ7sfmNTVqzg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX36WvnJPTQfRuwhj8zB4YN-i55ymBf1dFBS-1-0_UPxA&oe=6B104777"}, {"file_name": "screenshot_5_lobby.png", "id": "3293807807494648", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628050_3293807810827981_5247912479582331179_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpgKchy5398Q7kNvwF2BjG3&_nc_oc=AdocdtpMlLvvcLqKnTIL1Whg19SpDynLxczIsCX3fy_3YdG61h6GrykY8oX_8SsUJjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1zqEhFNQ8DLdWJJyCTdZkQbqkF22LrkaJtxOv2GE-YQ&oe=6B106C2B"}, {"file_name": "screenshot_6_space.png", "id": "2281822585990491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628446_2281822589323824_7804340298528583219_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b23ZzX9gvxIQ7kNvwF9kyqv&_nc_oc=Adq5TotXqDq5HuF2_zPpU5-rC4P92W3Ao9cu4EzLR-l67Z6EipQPOkb4g_pxJPfN6rc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJ7_O5FB-Tedw5EATGaV8lAkPxl5BI3M-7QbWKkspObQ&oe=6B105CA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FERAL!", "keywords": ["horror", "multiplayer", "monsters", "climbing", "sandbox"], "long_description": "You have no legs to run on. You move with your arms: push off the floor, climb the walls, throw yourself down a corridor. That is all you have when the lights go out.\n\nGO IN\nSeven levels, each with its own monster and its own way of finding you. A nest that hears your hands on the walls. A house whose owner is home. A crawlspace with a doll that only moves when you look away. A train that should not be running. A haunted mansion with five things living in it.\n\nGET OUT RICH\nCarry out what you find and sell it. Photograph the monsters for more. Spend it in the shop on gear that keeps you alive a little longer. The richest players are on the board in the lobby.\n\nBRING FRIENDS\nPlay online with voice chat. Everything is better with friends, and worse.\n\nTHEN PLAY SOMETHING ELSE\nPortals in the lobby lead to more games:\n- BLOCK WORLD: mine, craft and build in a world of blocks with caves, biomes, a Nether, monsters of its own, and the Moon above the sky.\n- BECOME THE MONSTER: one player is the monster in a corn maze on a farm at night. Everyone it touches becomes one too. The last one alive wins.\n- GUN GAME: drop onto an island, open chests for guns and rounds, keep away from the lurkers, and be the last one standing.\n- SPACE: loot an outpost on a dead moon under a ringed planet. You weigh next to nothing, and the stalkers are fast.\n\nAdd-ons change how you look and never how strong you are.", "short_description": "Swing through the dark on your own two arms, grab what you can carry and get out before something grabs you. A multiplayer horror loot game with seven haunted levels, a block world to dig up and three ways to turn on your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Jvl0v3CHiaziL3dc4AhvfRHmxyrAS86HmPH1tleYfZA/view", "developer_terms_of_service_url": null, "publisher_name": "WackyRY", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1Jvl0v3CHiaziL3dc4AhvfRHmxyrAS86HmPH1tleYfZA/view", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "1467927318766230"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4647040015525450"}]}, "baseline_offer": {"id": "4647040015525
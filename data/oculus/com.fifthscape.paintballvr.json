_nc_ss=7f20f&oh=00_AQNwk6V2r449wybWRHIOlIcac6gt3F3OBjD6FH4dgGhejg&oe=6AC7AEA0"}, {"file_name": "SS-02.png", "id": "1859409644637729", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820983_1859409647971062_2598337465331465651_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk8g3Hum2rsQ7kNvwH3Rpt_&_nc_oc=AdowdpztkhfBk3qK4_x5gkMjEQ3eK1-ZopwGsGkgCsPjhlo7gNAv-0Rbbyy7am5Ug6o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC3ijIKoEiIrrW3n4UIALN-tW9Zy-pNUnnieZLKjLYJg&oe=6AC7C3FC"}, {"file_name": "SS-04.png", "id": "1313260503647812", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830460_1313260506981145_3147020933492067818_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1S3we7EFLcQ7kNvwGs93iO&_nc_oc=AdqEqhsSAfXQQWpsa1cnso_sBhBxAXxD_pXzHHXdXgTTMbXaF-88yzcFCinpHvBx6DQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbtI96KrHu2pwc0VgBO9-Dq6rnSmFLbAPonjMTVieEDQ&oe=6AC7BB2C"}, {"file_name": "SS-05.png", "id": "1931776387370693", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824592_1931776390704026_3136616894731673635_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em7inZvCBRQQ7kNvwHuJ5_A&_nc_oc=Adp9k8uW6ySIvWlTwBARg8hmoA0d7Qk1bJTAnK8e3wc35GuZ_pQfhSz_N5bOVISJJtQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu_arpOywCiWDgtlrYD-Z-MvaODvBhi6n1lu2YSEshKQ&oe=6AC7CE36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "paintball banner-Video.png", "id": "1433063661242494", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620875_1433063664575827_916081321644795467_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58TR20-GyxsQ7kNvwEzEC8O&_nc_oc=AdpuhJic4HsFuT3X3Jjc2Wlz8YHgejZY4bXUKzp7-M257Rrldd8oY4KPtHpVa5vfS1Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpIJ-9wBgclDjIPAunT1GCNqOsk3qejlnyXW3bOeu5dw&oe=6AC7CE00"}, "display_name": "Paintball Arena VR", "keywords": ["Paintball", "shooting", "multiplayer", "action", "shooter"], "long_description": "Paintball Arena is a tactical, multiplayer team based VR shooter that captures the energy and excitement of real paintball inside immersive, lifelike virtual arenas. Designed for both casual fun and competitive play, it combines responsive motion-based shooting, realistic combat physics, and flexible game modes for every type of player.\n\nBefore diving into battle, sharpen your skills in the **Training Ground** \u2014 a dedicated space to practice aim, movement, and shooting mechanics against static and moving targets. Whether you\u2019re a beginner learning the ropes or a pro refining your accuracy, this calm, pressure-free environment prepares you for the action ahead.\n{1044855834177549}\n\n# Choose from multiple ways to play:\n\n**Offline Bot Matches** \u2013 Play anytime, anywhere with smart AI teammates and enemies that adapt to your tactics. Perfect for solo training or skill improvement.\n{1109996237752723}\n\n**Quick Match** \u2013 Fast-paced multiplayer 3 round matches with respawns for continuous action. Great for short sessions and casual fun.\n{724646193895010}\n\n**Ranked Match** \u2013 5-round, no-respawn mode where every move counts. Team coordination and strategy decide the outcome.\n{31045581248422511}\n\n**Custom Lobbies** \u2013 Invite friends and set your own rules for private tournaments or team practice sessions.\n{1308944160937709}\n\nWith its highly detailed arenas, intuitive VR controls, and multiple play styles, Paintball VR Arena ensures every match feels unique and exhilarating.", "short_description": "Paintball VR Arena brings the thrill of real paintball into VR with tactical, team-based matches and full motion-based shooting. Train in a dedicated practice ground, battle offline with smart AI, or jump online for Quick Matches, Ranked play, or custom games with friends. With lifelike arenas, responsive combat physics, and multiple modes, every match feels intense and immersive.\n\nStep in, aim true, and experience the ultimate VR paintball showdown."}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/paintball-arena-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24455561094105777"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "715487827524834"}]}, "baseline_offer": {"id": "715487827524834"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756809840, "status": "PUBLISHED", "id": "715487827524834"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28516850721310107", "version": ".47"}, "id": "578631928523103", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9494373130651152", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28516850721310107"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "578631928523103"}]}, "change_log": "1)Updated the game server configuration in this build.\n\n2)Updated the game URL to point to the new server.\n\nThis build is intended to connect to the new server environment.", "created_date": 1790238229, "id": "28516850721310107", "version": ".47", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28516846287977217"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9494373130651152", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28516850721310107"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "578631928523103"}]}, "change_log": "1)Updated the game server configuration in this build.\n\n2)Updated the game URL to point to the new server.\n\nThis build is intended to connect to the new server environment.", "created_date": 1790170502, "id": "28506026812392498", "version": ".46", "version_code": 46, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28506020925726420"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9494373130651152", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28516850721310107"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "578631928523103"}]}, "change_log": "New Update is LIVE! \n\nWe have just deployed a fresh patch for the paintball arena, focusing on getting you into the action faster and smoothing out the overall experience.\n\nHere is what's new in this update:\n\nStreamlined Lobbies: We've reduced the current lobby size so you can match up and dive into the game much quicker. Less time waiting, more time painting.\n\nNew Sprint Feature: Mobility just got a massive upgrade. You can now sprint both in the lobby and during the game, allowing for faster tactical rotations, quicker escapes, and dynamic movement across the map.\n\nGameplay Improvements: We have fine-tuned the core mechanics to ensure the action feels smoother and more responsive from start to finish.\n\nBug Fixes: We have tracked down and squashed several bugs to provide a much more stable and seamless experience.\n\nNew Season is Approaching\nKeep your gear ready, because we will be rolling out a brand-new season very soon. Stay tuned for more details on what is coming next.\n\nJump in, test out your new sprinting speed, and dominate the arena.", "created_date": 1786362308, "id": "27927027616959090", "version": ".45", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27927012723627246"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9494373130651152", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28516850721310107"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786032389, "id": "27880948608233658", "version": ".44", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "27880917771570075"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applic
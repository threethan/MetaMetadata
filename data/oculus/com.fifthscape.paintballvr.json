_sid=6e7a0a&_nc_ohc=8G2mSsyDjPMQ7kNvwG0cFI4&_nc_oc=AdrT8F582dCs85v6OUTOnOER8QCMXunmZRa2mGL4lCIqc7Yp-oO7eTN5FREsZY95sxY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKBlKYWQr95m_1ZNVr5KKjic4sz_n5l2iJkr4I3xevGA&oe=6AC797C4"}, {"file_name": "SS-03.png", "id": "3373035476192737", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619594_3373035479526070_6949748614229280830_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57MYRXZ_NGwQ7kNvwErL58X&_nc_oc=Adqe1ZUe_47H2vIUpfz_sFep76MJGOh10qo0XdkDbyLw14vMEAmvfQDrghwFS3xexDk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOe33YIw1ju5ISUPbl1ohHTaBnVjlHTG6GCafer737bA&oe=6AC7B8AB"}, {"file_name": "SS-04.png", "id": "1654722125945447", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620432_1654722129278780_8128584804568889365_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTAkzdHxBT8Q7kNvwHKRxRq&_nc_oc=AdocRxuw8opMSYZSrDQGn5XFVqNBMEy9Lap-BASo20_ChcmmgLg8Owxg7FsNbz78iU0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfu1sA7pqwg3HeOO6vm_IVCFFdYBMTuozG9I04wYy7gw&oe=6AC7B5BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Art-2560.png", "id": "1064554993397751", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499617850_1064554996731084_7729893910795051758_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYU9tGMhse0Q7kNvwFyq34c&_nc_oc=Adr-0U-Dy8nhA7iq94fUJjZbuPc-2kZtuZ9G5-WESzJtKHr9qdPcBLKGYpXgtiWUSqI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeTKeU_kiKIYbOpct-YUgLtx3OPx5owo_SgDRxjm4VFg&oe=6AC79826"}, "display_name": "Paintball Arena VR", "keywords": ["Paintball", "multiplayer", "action", "shooter", "Platformer"], "long_description": "Paintball Arena is a tactical, multiplayer team based VR shooter that captures the energy and excitement of real paintball inside immersive, lifelike virtual arenas. Designed for both casual fun and competitive play, it combines responsive motion-based shooting, realistic combat physics, and flexible game modes for every type of player.\n\nBefore diving into battle, step into the **Global Lobby**  \u2014 a vibrant social hub where players from around the world can meet, chat, and interact in real time. Explore the space, challenge other players to matches, watch live battles in spectator mode, or simply hang out with friends before heading into the arena. It\u2019s the perfect place to connect, compete, and prepare for the action ahead!\n{1432320101863017}\n\n# Choose from multiple ways to play:\n\n**Ranked Match** \u2013 A 5-round, no-respawn mode where every move counts. Team coordination, communication, and tactical play determine victory.\n{909910678575976}\n\n**Unranked Match** \u2013 Fast-paced multiplayer 3-round matches with respawns for continuous action. Perfect for casual sessions, warm-ups, or learning new strategies without affecting your rank.\n{1419756740190310}\n\n**Capture the Flag** \u2013 Work with your team to steal the enemy flag and defend your own. Strategy, teamwork, and smart positioning are key to winning this classic objective-based mode.\n{33900714266211048}\n\n**Custom Lobbies** \u2013 Invite friends and set your own rules for private tournaments, practice sessions, or fun community matches.\n{1323818729699938}\n\n", "short_description": "Paintball VR Arena brings the thrill of real paintball into VR with tactical, team-based matches and full motion-based shooting. Train in a dedicated practice ground, battle offline with smart AI, or jump online for Quick Matches, Ranked play, or custom games with friends. With lifelike arenas, responsive combat physics, and multiple modes, every match feels intense and immersive.\n\nStep in, aim true, and experience the ultimate VR paintball showdown."}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/paintball-arena-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_
": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823930_1621246612871932_5118596721133413120_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDIluc8tzZsQ7kNvwGKrXGU&_nc_oc=AdqD2c5AZGSDUrO0XU5zlqYOTDpkrJwO9qxuz2AQLHa0e3FHw6OSPkp5jlzk-EjZpp0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlk1vVu0BUjrl57xuzFw_NxNVsXzqBT2hYbgOPl7Ay8g&oe=6AFF2057"}, {"file_name": "jump.png", "id": "1067193762804368", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1067193766137701_1864089817485910432_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1HvbpBePpQQ7kNvwFddfRM&_nc_oc=AdrRugPFniEpeLHDMMwI8epa55wymyWlZKEb2pizmP56XIHhBZKKZIwl1_2EPPpDv14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwmeR6PjYSIF84YdUUOleI2PNqwo00PPDATX4WOXxs1A&oe=6AFF2D32"}, {"file_name": "Screenshots.png", "id": "1697195898011182", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823351_1697195901344515_8467668524758431141_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj4UXpFY1H8Q7kNvwFNpsoe&_nc_oc=AdqSDeO3gwPPmj3ID6BBflUluuNZop3fSf6xowb3sQNBf5cHHTH_u2QrLXsTs_gicwg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR5DsEW5TK37BCldXZwJdIDjQ4lH2yXdFp4NRqSfXoCQ&oe=6AFF1BFB"}, {"file_name": "Screenshots_adj.png", "id": "3378583259195794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825257_3378583262529127_6729149010717644827_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRTdH6DKtcwQ7kNvwF5RuO9&_nc_oc=AdpsJVcEDGVsXPOD5F5SJYn8A-ZepD6ADj_ZL5R59v2Fi3vLu5LoG93hIZ3x7cRwwIM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNj4jPJ-y4IFvPjs6Lxm4tFqcrnP8x7oq8CV3Q1kvpWg&oe=6AFF163A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_sparks_big_clean_vibrant_fixed_height.png", "id": "1704861847971475", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824741_1704861854638141_574811952172854045_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVm4_GMLVdYQ7kNvwHjO1S7&_nc_oc=AdrzcKes6ylrh_h1iTTjokJz2i-XvY4MNiOGnJjsCB1doddVgn0AuzlaUqiujBZ6rcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqh5XZ8my-ehlJ-W50ciLd-95D6DyJ3sy6eYLqFgc9Ww&oe=6AFF14CC"}, "display_name": "Boxing XR", "keywords": ["boxing", "rhythm", "fitness", "beat", "workout"], "long_description": "# Switch your body on.\n\n**Punch, duck, slip, squat,** and **jump** to driving beats as your room comes alive with light and color.\n\nBoxing XR is a quick mixed-reality **rhythm boxing workout** that gets your arms, core, and legs moving.\n \n{2259319264630003}\n\n**Key Features**:\n\n\ud83e\udd4a **Inspired by real pad work**. Targets require cross-body punches, including a varied mix of jabs, hooks, and uppercuts, naturally engaging your shoulders and core.\n\n\ud83c\udfc3 **Full body workout**. Duck, slip, squat, and jump to keep your core and lower body engaged throughout each round.\n\n\u26a1 **Ready in seconds**. Load in fast and jump into a focused 3 to 5-minute round. Do one for a quick energy boost or stack multiple rounds for a longer workout.\n\n\u2705 **No subscription**. Train whenever you want without a recurring membership.\n\n\ud83c\udfb5 **Music made for boxing**. Every track is created specifically for rhythm boxing, with driving beats matched to the movement and intensity of each workout.\n\n\ud83c\udfe0 **Mixed reality, confident movement**. See your real surroundings, move with confidence, and watch your room light up around you.\n\n\ud83d\udd25 **Three intensity levels**. Start with WARM UP, step up to PRO, or take on ELITE when you are ready for the hardest challenge.\n \n\n**Choose your challenge. Step in. Switch your body on.**\n{4620560564856440}", "short_description": "Switch your body on. \n\nBoxing XR brings pad-work-inspired rhythm boxing into mixed reality. \n\nCross-body targets call for jabs, hooks, and uppercuts, while ducks, slips, squats, and jumps engage your arms, core, and legs. \n\nLoad in fast for a focused 3 to 5-minute round, or stack rounds for a longer workout. \n\nChoose WARM UP, PRO, or ELITE. No subscription.\n\nChoose your challenge. Step in. Switch your body on."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxingxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": null, "website_url": "https://boxingxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4647409812137480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821796_2012832716095814_5244257658477166615_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJsf8W6ZipYQ7kNvwHEHHLh&_nc_oc=Ado7sPGfVNgtDhzGpIomvcvfucMRVk60MwVifZ6Y9Z1pdWgceq9Jf9cpgaKZNUusduQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAQ-gUt-72CEheYC1K2IOVsFWEaR2Q83bcJqqD6rkxsw&oe=6AFF096B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_
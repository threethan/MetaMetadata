": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_1621246612871932_5118596721133413120_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etMRChmqGdgQ7kNvwHBQXJK&_nc_oc=Adozh-1KmzXm27tALuUVjzf69oIPuSnJAxI0tNu2tVgdJ8Lgmsq8goBbEZt0Y2CxucI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9hj_rnsYm3DI6-csTRqHlsxq606wuDRWRQMTxUtwz-g&oe=6B05B7D7"}, {"file_name": "jump.png", "id": "1067193762804368", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_1067193766137701_1864089817485910432_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl8e1CotF5IQ7kNvwG6h4Kg&_nc_oc=Adqww40rfYHVdMKSrEZhPzWTx7E1NIr5IzK3DRk1mFuPu454oCda_br8U8M-sbFPqO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH2-gF6-T-spDlWoyR6ZZXR8lXSE-FwcDmEY66TD1JRw&oe=6B05C4B2"}, {"file_name": "Screenshots.png", "id": "1697195898011182", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1697195901344515_8467668524758431141_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM82EwFVI8wQ7kNvwFYK6s8&_nc_oc=Adp0lwO3xkqxyWqXTF7y1D9-TFl5EEe7JqxwkNJfchLpUxcXMYDWJna58lQUtQz-Aqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSoElTRonLU2nO1YakcFbWsB3Fpwb_6sF22-unC_9iqg&oe=6B05B37B"}, {"file_name": "Screenshots_adj.png", "id": "3378583259195794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_3378583262529127_6729149010717644827_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2YTEyHvMLAQ7kNvwGXGUTs&_nc_oc=AdoWFBLMHjpl2PxtNOvDkFP1egAzMn7TyveWZSRuj55gj78FOpl4BvNqeT5xpztakuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR36B9J7ZlcSV0MsrEChmtyGnFHjKf4c15kBPKA1ECnvg&oe=6B05ADBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_sparks_big_clean_vibrant_fixed_height.png", "id": "1704861847971475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824741_1704861854638141_574811952172854045_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyNPQsttUKIQ7kNvwETE_7l&_nc_oc=AdobzbKuS_lIu_tSnIgQPABKQ2AikMQWIciItHecrfJUPnH-TR3xAXotc75Ykl0Iqhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjmwouez8Q0NDr3TZHfoZKQPEx4wMGR1Gt9Z4uyFc8OQ&oe=6B05AC4C"}, "display_name": "Boxing XR", "keywords": ["boxing", "rhythm", "fitness", "beat", "workout"], "long_description": "# Switch your body on.\n\n**Punch, duck, slip, squat,** and **jump** to driving beats as your room comes alive with light and color.\n\nBoxing XR is a quick mixed-reality **rhythm boxing workout** that gets your arms, core, and legs moving.\n \n{2259319264630003}\n\n**Key Features**:\n\n\ud83e\udd4a **Inspired by real pad work**. Targets require cross-body punches, including a varied mix of jabs, hooks, and uppercuts, naturally engaging your shoulders and core.\n\n\ud83c\udfc3 **Full body workout**. Duck, slip, squat, and jump to keep your core and lower body engaged throughout each round.\n\n\u26a1 **Ready in seconds**. Load in fast and jump into a focused 3 to 5-minute round. Do one for a quick energy boost or stack multiple rounds for a longer workout.\n\n\u2705 **No subscription**. Train whenever you want without a recurring membership.\n\n\ud83c\udfb5 **Music made for boxing**. Every track is created specifically for rhythm boxing, with driving beats matched to the movement and intensity of each workout.\n\n\ud83c\udfe0 **Mixed reality, confident movement**. See your real surroundings, move with confidence, and watch your room light up around you.\n\n\ud83d\udd25 **Three intensity levels**. Start with WARM UP, step up to PRO, or take on ELITE when you are ready for the hardest challenge.\n \n\n**Choose your challenge. Step in. Switch your body on.**\n{4620560564856440}", "short_description": "Switch your body on. \n\nBoxing XR brings pad-work-inspired rhythm boxing into mixed reality. \n\nCross-body targets call for jabs, hooks, and uppercuts, while ducks, slips, squats, and jumps engage your arms, core, and legs. \n\nLoad in fast for a focused 3 to 5-minute round, or stack rounds for a longer workout. \n\nChoose WARM UP, PRO, or ELITE. No subscription.\n\nChoose your challenge. Step in. Switch your body on."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxingxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": null, "website_url": "https://boxingxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4647409812137480"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_2012832716095814_5244257658477166615_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kjgc4Xh3mxAQ7kNvwGHYl0m&_nc_oc=AdpFRgaqGXevHnFWanEa1o_kR0d-KGfxIgFQhEIncH3pEnAJHDHln7Jt0gxKOo7GHv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoAfIJzYU4mkiGS8ZA-bf9TmVhkoQZfZbHsf7mMGMJrg&oe=6B05A0EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxing XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_
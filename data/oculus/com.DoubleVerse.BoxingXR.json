5FqC5Nkdh0-pjpYSi6S3ezzbFOwIjEM6aZ-uMOM7dw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQxXStT46IeKVaA59nJAPdNp1pZgOhQ9h5oSX6LkgZOA&oe=6AE8B6D7"}, {"file_name": "jump.png", "id": "1067193762804368", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823783_1067193766137701_1864089817485910432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5Oo4zEcL1kQ7kNvwE09YnD&_nc_oc=AdoQtSN7F2RaxL8-9Vq8Z6rIv8k2rv2DGLu5lnDKq0Xsnc12SAkhLSAB049MBpdqww4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmq_D-FhWg9goJ2-zlpesu33gEGDK8Grw1Lv5weproAQ&oe=6AE8C3B2"}, {"file_name": "Screenshots.png", "id": "1697195898011182", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823351_1697195901344515_8467668524758431141_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0csfvTw9SwQ7kNvwFsnkHj&_nc_oc=AdpEZ9eBdbEo_loE_Kg5roxdATpHyu90IhsD0HWCf2fhG7k9cj1pEDKHuQFYsVCLOQo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfLDiWJs57cWj1Jp54kjPYbOe4T9Z2V9glS3Vak7qKdw&oe=6AE8B27B"}, {"file_name": "Screenshots_adj.png", "id": "3378583259195794", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825257_3378583262529127_6729149010717644827_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpyjAIRhmL0Q7kNvwEePHyl&_nc_oc=AdrEWzvU2k6xlFzeqy2lAUV2_EXjjXvXdL2fjJOSEmSZ1QcHQenk-aEWRANnNZiJfGU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEMkV3bj6LooKV78X7bE4An1xIyIvFI_XiG04FKVeHZA&oe=6AE8ACBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_sparks_big_clean_vibrant_fixed_height.png", "id": "1704861847971475", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824741_1704861854638141_574811952172854045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-WBA4OhBQcQ7kNvwFdroNp&_nc_oc=AdqPD48_rpZTfus3xNxhlOTaxrYMG1Jb9RVzjdni2UD7MzfWhxZFhbsxY9t87uFNdY4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQnXlGnhnUGvNtN0DC6tRTtcrs3dC9AN1n3Y2VoeHvWw&oe=6AE8AB4C"}, "display_name": "Boxing XR", "keywords": ["boxing", "rhythm", "fitness", "beat", "workout"], "long_description": "# Switch your body on.\n\n**Punch, duck, slip, squat,** and **jump** to driving beats as your room comes alive with light and color.\n\nBoxing XR is a quick mixed-reality **rhythm boxing workout** that gets your arms, core, and legs moving.\n \n{2259319264630003}\n\n**Key Features**:\n\n\ud83e\udd4a **Inspired by real pad work**. Targets require cross-body punches, including a varied mix of jabs, hooks, and uppercuts, naturally engaging your shoulders and core.\n\n\ud83c\udfc3 **Full body workout**. Duck, slip, squat, and jump to keep your core and lower body engaged throughout each round.\n\n\u26a1 **Ready in seconds**. Load in fast and jump into a focused 3 to 5-minute round. Do one for a quick energy boost or stack multiple rounds for a longer workout.\n\n\u2705 **No subscription**. Train whenever you want without a recurring membership.\n\n\ud83c\udfb5 **Music made for boxing**. Every track is created specifically for rhythm boxing, with driving beats matched to the movement and intensity of each workout.\n\n\ud83c\udfe0 **Mixed reality, confident movement**. See your real surroundings, move with confidence, and watch your room light up around you.\n\n\ud83d\udd25 **Three intensity levels**. Start with WARM UP, step up to PRO, or take on ELITE when you are ready for the hardest challenge.\n \n\n**Choose your challenge. Step in. Switch your body on.**\n{4620560564856440}", "short_description": "Switch your body on. \n\nBoxing XR brings pad-work-inspired rhythm boxing into mixed reality. \n\nCross-body targets call for jabs, hooks, and uppercuts, while ducks, slips, squats, and jumps engage your arms, core, and legs. \n\nLoad in fast for a focused 3 to 5-minute round, or stack rounds for a longer workout. \n\nChoose WARM UP, PRO, or ELITE. No subscription.\n\nChoose your challenge. Step in. Switch your body on."}]}, "developer_na
yAZI8axOgzcKy2QCauFSjEF29w6T3Xxp4n0VwEnzt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdpAmcj1uXKjTqnw029u3YkL_39P6qsCvOdwtp0zBUyg&oe=6AF73757"}, {"file_name": "jump.png", "id": "1067193762804368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1067193766137701_1864089817485910432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqtU0k-PoTMQ7kNvwFZpzss&_nc_oc=AdpMsvJvtkCNw7aMp2sPjnNNW-ehz6HcH07xESmxsQKjj5JuSGza5Z5zav_Ebvty9Os&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEHrF2f4v9Hi2ibNjEGyhBXLUN-aM9oY9ol_ad984jrw&oe=6AF74432"}, {"file_name": "Screenshots.png", "id": "1697195898011182", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1697195901344515_8467668524758431141_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDOKqcwbeQ0Q7kNvwGk7YPr&_nc_oc=Adqj4FRMQ0s3Ep53iLbrB7sbuwvlFmasaXoN_JTjazG-sdXKXHqzaib7BvSzafDziIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx1AvcztR42hkElMBpLv5DfADC7Yd6wq18ztFwbigojQ&oe=6AF732FB"}, {"file_name": "Screenshots_adj.png", "id": "3378583259195794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_3378583262529127_6729149010717644827_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqzI5aNgCX0Q7kNvwGWeg3r&_nc_oc=AdpnCJUtW2eFXbggPdP4F73z6MxbGWipnH_TznOLBKPBYrOXF-pWtyL_nTDas0-5g_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnfT1OtDjypyQRZE78t2nNL5IZ8odU_lhNzon96YWKDA&oe=6AF72D3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_sparks_big_clean_vibrant_fixed_height.png", "id": "1704861847971475", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1704861854638141_574811952172854045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nR6qsnACz1AQ7kNvwHiumdw&_nc_oc=AdoUrEx10Ck_fAkiafdOkHKc7YvC2RdDR8eZnMqc3VeC98Mo1o1h8m2iYhSIV6qvDwY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbTkTGKzE0SEJbTfOxh5kRdVZwvjn-GkriHewwiUAPKQ&oe=6AF72BCC"}, "display_name": "Boxing XR", "keywords": ["boxing", "rhythm", "fitness", "beat", "workout"], "long_description": "# Switch your body on.\n\n**Punch, duck, slip, squat,** and **jump** to driving beats as your room comes alive with light and color.\n\nBoxing XR is a quick mixed-reality **rhythm boxing workout** that gets your arms, core, and legs moving.\n \n{2259319264630003}\n\n**Key Features**:\n\n\ud83e\udd4a **Inspired by real pad work**. Targets require cross-body punches, including a varied mix of jabs, hooks, and uppercuts, naturally engaging your shoulders and core.\n\n\ud83c\udfc3 **Full body workout**. Duck, slip, squat, and jump to keep your core and lower body engaged throughout each round.\n\n\u26a1 **Ready in seconds**. Load in fast and jump into a focused 3 to 5-minute round. Do one for a quick energy boost or stack multiple rounds for a longer workout.\n\n\u2705 **No subscription**. Train whenever you want without a recurring membership.\n\n\ud83c\udfb5 **Music made for boxing**. Every track is created specifically for rhythm boxing, with driving beats matched to the movement and intensity of each workout.\n\n\ud83c\udfe0 **Mixed reality, confident movement**. See your real surroundings, move with confidence, and watch your room light up around you.\n\n\ud83d\udd25 **Three intensity levels**. Start with WARM UP, step up to PRO, or take on ELITE when you are ready for the hardest challenge.\n \n\n**Choose your challenge. Step in. Switch your body on.**\n{4620560564856440}", "short_description": "Switch your body on. \n\nBoxing XR brings pad-work-inspired rhythm boxing into mixed reality. \n\nCross-body targets call for jabs, hooks, and uppercuts, while ducks, slips, squats, and jumps engage your arms, core, and legs. \n\nLoad in fast for a focused 3 to 5-minute round, or stack rounds for a longer workout. \n\nChoose WARM UP, PRO, or ELITE. No subscription.\n\nChoose your challenge. Step in. Switch your body on."}]}, "developer_na
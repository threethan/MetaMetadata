11ITIXs2-mNUJyvVf6pDbkJ8VG7neeoJJKCnpSrc2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd7jNRNy3yvVnISod0q-2nUVFV5_3_xDkdNS8wn8JbBA&oe=6ACFAA57"}, {"file_name": "jump.png", "id": "1067193762804368", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1067193766137701_1864089817485910432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3glBfloNNx0Q7kNvwHXWp2i&_nc_oc=AdqfrI2qCTq4h2gKGjjXW6MO-triUjkw6nvM-XT7wZiRNN6JnzIAJzOUhNiEzJOS-FA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwG6f7ND8NHF3ytYlV7R6mpGIccpdvYGj6_fbsxu4SLg&oe=6ACFB732"}, {"file_name": "Screenshots.png", "id": "1697195898011182", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_1697195901344515_8467668524758431141_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MGAsMNkGUEQ7kNvwEev98U&_nc_oc=AdrAh0UHE6j6WP7kY9bpqkqzCzw8HsWQNsWf-qSo0A3R8oyrNEHzPZg0iKcX9Hy6yTY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5qD6nRG9V8K3mxam2hC7X_IcATA3O3gBi0XYDS0-h9w&oe=6ACFA5FB"}, {"file_name": "Screenshots_adj.png", "id": "3378583259195794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825257_3378583262529127_6729149010717644827_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCFNpOtnKXYQ7kNvwH8ivgA&_nc_oc=AdpJ3u-y1l7CaL1UMz_b4ZTkfLzxz3q3foBkRwq-zDrqEUel-EeXZAH1kdbqdmzQCUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRdt1Hr44X0CvpPzNM-ZjMhkCK4bI_yYOoFSuDWRmxWg&oe=6ACFA03A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Boxing XR", "keywords": ["boxing", "rhythm", "fitness", "beat", "workout"], "long_description": "# Switch your body on.\n\n**Punch, duck, slip, squat,** and **jump** to driving beats as your room comes alive with light and color.\n\nBoxing XR is a quick mixed-reality **rhythm boxing workout** that gets your arms, core, and legs moving.\n \n{2259319264630003}\n\n**Key Features**:\n\n\ud83e\udd4a **Inspired by real pad work**. Targets require cross-body punches, including a varied mix of jabs, hooks, and uppercuts, naturally engaging your shoulders and core.\n\n\ud83c\udfc3 **Full body workout**. Duck, slip, squat, and jump to keep your core and lower body engaged throughout each round.\n\n\u26a1 **Ready in seconds**. Load in fast and jump into a focused 3 to 5-minute round. Do one for a quick energy boost or stack multiple rounds for a longer workout.\n\n\u2705 **No subscription**. Train whenever you want without a recurring membership.\n\n\ud83c\udfb5 **Music made for boxing**. Every track is created specifically for rhythm boxing, with driving beats matched to the movement and intensity of each workout.\n\n\ud83c\udfe0 **Mixed reality, confident movement**. See your real surroundings, move with confidence, and watch your room light up around you.\n\n\ud83d\udd25 **Three intensity levels**. Start with WARM UP, step up to PRO, or take on ELITE when you are ready for the hardest challenge.\n \n\n**Choose your challenge. Step in. Switch your body on.**\n{4620560564856440}", "short_description": "Switch your body on. \n\nBoxing XR brings pad-work-inspired rhythm boxing into mixed reality. \n\nCross-body targets call for jabs, hooks, and uppercuts, while ducks, slips, squats, and jumps engage your arms, core, and legs. \n\nLoad in fast for a focused 3 to 5-minute round, or stack rounds for a longer workout. \n\nChoose WARM UP, PRO, or ELITE. No subscription.\n\nChoose your challenge. Step in. Switch your body on."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxingxr.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "DoubleVerse", "support_website_url": null, "website_url": "https://boxingxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscri
WtQrqKyGqKlPHSCTVLsOHXC9Nr5RDRjKeFjpbDEdzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdX3gVEOSk6rjC9yC5ZBLRdQ1BotEJJQJzcbuxReHoBw&oe=6AEF4E57"}, {"file_name": "jump.png", "id": "1067193762804368", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1067193766137701_1864089817485910432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzkVl-K3ETIQ7kNvwGE1DHl&_nc_oc=AdoDuoEhRUYkUCPBrWeekA-VZpux5ALdFeQOHkGMkqe5qMvrk1ssKJN_QfjnR3ZVHNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQchMh47B2Y4bbBxIn4TUmSfyOfTOR_PtKV_9gPIbk7rQ&oe=6AEF5B32"}, {"file_name": "Screenshots.png", "id": "1697195898011182", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823351_1697195901344515_8467668524758431141_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giQUemD_XJQQ7kNvwHWmQMc&_nc_oc=AdpSfmPaxX3czS7Y_DvlBHuraesXszxqB8zIbO_t9nODtpMAkH4eUbE6nfmCwae0vzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIa-29v-MC1OzUjYRp-sfxHRiPasaiLKsY1JR3v8nW6g&oe=6AEF49FB"}, {"file_name": "Screenshots_adj.png", "id": "3378583259195794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825257_3378583262529127_6729149010717644827_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEGV1oiebYIQ7kNvwGt1VJw&_nc_oc=Adpcdo69cIsBD7lvm2M8BnnIfkAJYWV9C7h6J5Y0iKVN2srGL6QADt3scDLoPe1wjwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8GHIbB3G4MhU3An7b6kyWLf5s2PSt5wC7sPOy70tTHQ&oe=6AEF443A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_sparks_big_clean_vibrant_fixed_height.png", "id": "1704861847971475", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1704861854638141_574811952172854045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caUeDW_N1iMQ7kNvwF0bDAs&_nc_oc=AdqC1xR56t7DizomGZPzpk05b3zsdyjqc9BObVkT3YB2_ik1CcKEKRqL1C6opj5MnMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT7scuavj5YzZ6QiiwmKZ1MqHv1vCtAg32AQlzCQA6eQ&oe=6AEF42CC"}, "display_name": "Boxing XR", "keywords": ["boxing", "rhythm", "fitness", "beat", "workout"], "long_description": "# Switch your body on.\n\n**Punch, duck, slip, squat,** and **jump** to driving beats as your room comes alive with light and color.\n\nBoxing XR is a quick mixed-reality **rhythm boxing workout** that gets your arms, core, and legs moving.\n \n{2259319264630003}\n\n**Key Features**:\n\n\ud83e\udd4a **Inspired by real pad work**. Targets require cross-body punches, including a varied mix of jabs, hooks, and uppercuts, naturally engaging your shoulders and core.\n\n\ud83c\udfc3 **Full body workout**. Duck, slip, squat, and jump to keep your core and lower body engaged throughout each round.\n\n\u26a1 **Ready in seconds**. Load in fast and jump into a focused 3 to 5-minute round. Do one for a quick energy boost or stack multiple rounds for a longer workout.\n\n\u2705 **No subscription**. Train whenever you want without a recurring membership.\n\n\ud83c\udfb5 **Music made for boxing**. Every track is created specifically for rhythm boxing, with driving beats matched to the movement and intensity of each workout.\n\n\ud83c\udfe0 **Mixed reality, confident movement**. See your real surroundings, move with confidence, and watch your room light up around you.\n\n\ud83d\udd25 **Three intensity levels**. Start with WARM UP, step up to PRO, or take on ELITE when you are ready for the hardest challenge.\n \n\n**Choose your challenge. Step in. Switch your body on.**\n{4620560564856440}", "short_description": "Switch your body on. \n\nBoxing XR brings pad-work-inspired rhythm boxing into mixed reality. \n\nCross-body targets call for jabs, hooks, and uppercuts, while ducks, slips, squats, and jumps engage your arms, core, and legs. \n\nLoad in fast for a focused 3 to 5-minute round, or stack rounds for a longer workout. \n\nChoose WARM UP, PRO, or ELITE. No subscription.\n\nChoose your challenge. Step in. Switch your body on."}]}, "developer_na
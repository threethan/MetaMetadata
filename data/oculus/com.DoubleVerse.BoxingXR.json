OoCcZA54WHoV4lOd10H-W1MWd7ZWsReAGgEcDanuXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDGmGt-aJqLQpw62273PY8PI9aqfOqzOGoZynuWvCvVw&oe=6AEDFCD7"}, {"file_name": "jump.png", "id": "1067193762804368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1067193766137701_1864089817485910432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzkVl-K3ETIQ7kNvwGGQe6c&_nc_oc=AdrqaQDU-vj5v8F6FOWwhXtcneWljeh93zZHxt1l8sd0egptlFltpaFmqhS_J5cCN60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSGL8H5dAc2uHzrU9nPJ7_AavtdknvpuvDxUVqrC7jug&oe=6AEE09B2"}, {"file_name": "Screenshots.png", "id": "1697195898011182", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1697195901344515_8467668524758431141_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giQUemD_XJQQ7kNvwGz9Jb0&_nc_oc=AdokP8Blo8EksUiHJ73HH26OjdgPOFMPzyDPkyjqSmWH4CjZkYztaRbJQkjnSddpey0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO5eNx8s1x2Il4K5NPubpJy1k3Heo_PL1dv1_VUK6ybw&oe=6AEDF87B"}, {"file_name": "Screenshots_adj.png", "id": "3378583259195794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_3378583262529127_6729149010717644827_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hha3CuHspP0Q7kNvwEZA3_k&_nc_oc=Adp-2GfR_runxvVPlGO-Mp_GJFInzmAGI-bVk0qnfDeuvjqRUVJnmmC1JRZohp625ow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkQQhkmADDQ4gLU9R8TKHA7PE8aQlZjB2dHTRsjq9hKg&oe=6AEDF2BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_sparks_big_clean_vibrant_fixed_height.png", "id": "1704861847971475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_1704861854638141_574811952172854045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=caUeDW_N1iMQ7kNvwHtj9cb&_nc_oc=AdqTuUNzLTNEnklzPNCfXQW4ZdUVdODWzGC-P9O6fxw17ZeLiVIxyzOkjP48C0A9Zks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNHLDJSW1KtWQ5TeGPeoMnivIifuu0L7Z5e5fxscR1cw&oe=6AEDF14C"}, "display_name": "Boxing XR", "keywords": ["boxing", "rhythm", "fitness", "beat", "workout"], "long_description": "# Switch your body on.\n\n**Punch, duck, slip, squat,** and **jump** to driving beats as your room comes alive with light and color.\n\nBoxing XR is a quick mixed-reality **rhythm boxing workout** that gets your arms, core, and legs moving.\n \n{2259319264630003}\n\n**Key Features**:\n\n\ud83e\udd4a **Inspired by real pad work**. Targets require cross-body punches, including a varied mix of jabs, hooks, and uppercuts, naturally engaging your shoulders and core.\n\n\ud83c\udfc3 **Full body workout**. Duck, slip, squat, and jump to keep your core and lower body engaged throughout each round.\n\n\u26a1 **Ready in seconds**. Load in fast and jump into a focused 3 to 5-minute round. Do one for a quick energy boost or stack multiple rounds for a longer workout.\n\n\u2705 **No subscription**. Train whenever you want without a recurring membership.\n\n\ud83c\udfb5 **Music made for boxing**. Every track is created specifically for rhythm boxing, with driving beats matched to the movement and intensity of each workout.\n\n\ud83c\udfe0 **Mixed reality, confident movement**. See your real surroundings, move with confidence, and watch your room light up around you.\n\n\ud83d\udd25 **Three intensity levels**. Start with WARM UP, step up to PRO, or take on ELITE when you are ready for the hardest challenge.\n \n\n**Choose your challenge. Step in. Switch your body on.**\n{4620560564856440}", "short_description": "Switch your body on. \n\nBoxing XR brings pad-work-inspired rhythm boxing into mixed reality. \n\nCross-body targets call for jabs, hooks, and uppercuts, while ducks, slips, squats, and jumps engage your arms, core, and legs. \n\nLoad in fast for a focused 3 to 5-minute round, or stack rounds for a longer workout. \n\nChoose WARM UP, PRO, or ELITE. No subscription.\n\nChoose your challenge. Step in. Switch your body on."}]}, "developer_na
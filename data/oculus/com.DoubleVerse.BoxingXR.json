e2XuzrNfWdSwQ7gOx5gt8O589F92aHvpEFut02VswM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVxyrJQ2iyx4Tg5EGm9wC0h--j7m-wZlGQwgMkA9_mCQ&oe=6AEB59D7"}, {"file_name": "jump.png", "id": "1067193762804368", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1067193766137701_1864089817485910432_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mb6zL91lQ5EQ7kNvwGcldaw&_nc_oc=Adq_fNgr0ZlZoRXPpefg0vjVe2x-Qd7CalpAnS8dF_m9FEURlB1zPbq6Yw1xjc-v3M4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDguu9Ivclb7UxN7qJa0S0m3tv7JElhtDLYkUjbeN8cw&oe=6AEB2E72"}, {"file_name": "Screenshots.png", "id": "1697195898011182", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1697195901344515_8467668524758431141_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0csfvTw9SwQ7kNvwG6CjP8&_nc_oc=AdqBPx5VwcJ3sOhMgADO9tpjpMusUepFxQpp2T4_Hd594M1ae8zcWSosrJVgrbxTGG8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvK__1ve5DjDlfwlXu9M2DMYoDGup9FBsjGTJvpHIBjA&oe=6AEB557B"}, {"file_name": "Screenshots_adj.png", "id": "3378583259195794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_3378583262529127_6729149010717644827_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hha3CuHspP0Q7kNvwHhnD5r&_nc_oc=AdrIyj-O0L_ELXkDFfdTtJzFvHZv-xIkcHILy9zkclc3GRd67YEPzPYsrVRyWR9LCAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRn3VhdBI3uP2_mcmWKCyFg80jaxszELLnZD-awF766Cg&oe=6AEB4FBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_sparks_big_clean_vibrant_fixed_height.png", "id": "1704861847971475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824741_1704861854638141_574811952172854045_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-WBA4OhBQcQ7kNvwFWA3TE&_nc_oc=Ado8lkxtQxwFbsme9TwlCbbhjo8yJBT6bKS-M6HmyIs-Mtiwx9d-1gvpGg2WFKh4gs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx7XIqfV051gyH8SaFnDpsgdIBdyAFnDaeNPVDt1W8oA&oe=6AEB4E4C"}, "display_name": "Boxing XR", "keywords": ["boxing", "rhythm", "fitness", "beat", "workout"], "long_description": "# Switch your body on.\n\n**Punch, duck, slip, squat,** and **jump** to driving beats as your room comes alive with light and color.\n\nBoxing XR is a quick mixed-reality **rhythm boxing workout** that gets your arms, core, and legs moving.\n \n{2259319264630003}\n\n**Key Features**:\n\n\ud83e\udd4a **Inspired by real pad work**. Targets require cross-body punches, including a varied mix of jabs, hooks, and uppercuts, naturally engaging your shoulders and core.\n\n\ud83c\udfc3 **Full body workout**. Duck, slip, squat, and jump to keep your core and lower body engaged throughout each round.\n\n\u26a1 **Ready in seconds**. Load in fast and jump into a focused 3 to 5-minute round. Do one for a quick energy boost or stack multiple rounds for a longer workout.\n\n\u2705 **No subscription**. Train whenever you want without a recurring membership.\n\n\ud83c\udfb5 **Music made for boxing**. Every track is created specifically for rhythm boxing, with driving beats matched to the movement and intensity of each workout.\n\n\ud83c\udfe0 **Mixed reality, confident movement**. See your real surroundings, move with confidence, and watch your room light up around you.\n\n\ud83d\udd25 **Three intensity levels**. Start with WARM UP, step up to PRO, or take on ELITE when you are ready for the hardest challenge.\n \n\n**Choose your challenge. Step in. Switch your body on.**\n{4620560564856440}", "short_description": "Switch your body on. \n\nBoxing XR brings pad-work-inspired rhythm boxing into mixed reality. \n\nCross-body targets call for jabs, hooks, and uppercuts, while ducks, slips, squats, and jumps engage your arms, core, and legs. \n\nLoad in fast for a focused 3 to 5-minute round, or stack rounds for a longer workout. \n\nChoose WARM UP, PRO, or ELITE. No subscription.\n\nChoose your challenge. Step in. Switch your body on."}]}, "developer_na
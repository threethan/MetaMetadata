uy5vV95r4ojjvybKds48eP3A&oe=6AF88FD8"}, {"file_name": "vreader (7).png", "id": "2233828427177755", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_2233828430511088_2484381515643135757_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_Hww1yYNf8Q7kNvwE5EQnX&_nc_oc=AdosEWSw9zlBA0EymqSkDLrYJnNB7A2z1plLq91pldtXoxNAAyXt-apjsRHk07qSB3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8qpHwSB4XLZ17C_FoV3OUnCJRqLl5OVqgop_KtvSyBw&oe=6AF8A017"}, {"file_name": "vreader (6).png", "id": "1414931703649452", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831964_1414931706982785_860093032418922205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwMckzsRN5oQ7kNvwENF5Dj&_nc_oc=AdorRFASzCjYNj_zVWdDuz_Yxoh1i5k4hsmwPqbIOadeDxCk4azBRC5QcLBfUHHeFK4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKt6a0FW0du49N2ntJF3n8YCA7KwjYWOufdPw34trJCA&oe=6AF8A358"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRead", "keywords": ["book", "pdf", "ebook"], "long_description": "Make room for a good book with VRead, a standalone reader for Meta Quest 3 and 3S.\nImport your PDF, EPUB and TXT files from your headset and organize them in a visual library with covers, titles, authors and reading progress. Read in a resizable window within your Horizon home environment, with a minimal interface that keeps the focus on your content.\n\u2022 Three formats: open PDF documents, EPUB books and plain text files.\n\u2022 Comfortable reading: scroll smoothly, zoom into details and hide the interface for more reading space.\n\u2022 Light and dark modes: choose your preferred reading theme while keeping images in their original colors.\n\u2022 EPUB typography: adjust font size, line spacing and choose a serif or sans-serif font.\n\u2022 Quick navigation: jump to a page using the system\u2019s numeric keyboard.\n\u2022 Automatic progress: return to your saved reading position for each document.\n\u2022 An organized library: sort by title, author or last read, and browse library screens with the controller stick.\n\u2022 Offline reading: enjoy your imported books without a PC connection.\nBring your own books and settle into reading with VRead.", "short_description": "Read PDF, EPUB and TXT files in a comfortable, resizable window on your Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://veenstudios.github.io/privacy-policy/index.html", "developer_terms_of_service_url": null, "publisher_name": "Veen Studios", "support_website_url": null, "website_url": "https://veenstudios.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1394831730379043"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2113482735956590"}]}, "baseline_offer": {"id": "2113482735956590"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794262380, "status": "PUBLISHED", "id": "2113482735956590"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1401959179666298", "version": "0.48.0-editor-style"}, "id": "1147591538222770", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id
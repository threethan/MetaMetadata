": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982585_1648333092725565_2005341481880093428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p41xw3Qvu4MQ7kNvwGF1Tji&_nc_oc=AdoQtFMI3fDeZN-PiicL1P-ta6NIGM300Ejwslrd73F39lsdsxPypt4kIddMJt9CtHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5qgUbzRoP-qa17UaIKxt1BgFPrS0m5-g1uLewj-WGOg&oe=6AC66226"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqZK7Hmh7SsQ7kNvwFg7e7b&_nc_oc=AdrhUgABA59vDACixPi6nxFv6o9dx2QmlmEyXcLSVgufL4t1U0X1TqFdCMAkSS2MYQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWRZMua_gBSu1w0cPWlf8IpzZ5hrkLlIOUU_Qil4zyIQ&oe=6AC65208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXg1TOoGEbMQ7kNvwE4pwg5&_nc_oc=Ado3hl2GljsQlZEPh2Jpckawa8lQ7-dquG__GT4fZNCCWCCPW_EtfeOkViuDQvB65cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3hH1huT82bD0TpguTU22s5myWu_Bqu3yABuMtgI3Bog&oe=6AC66E96"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.github.io/badmintonxr/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Chunjun Liang", "support_website_url": null, "website_url": "https://chunjunliang.github.io/badmintonxr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "zh_CN", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25037437762541525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031555_1513022456009865_8607747565322085322_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Buv6u30qtcUQ7kNvwHIQbB4&_nc_oc=Adrfyzu6oVMNMyOzqvP0W9-pff4aaa84qMzBWjc7tZFB3wDu8WnXN6TZQigcuu38VkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOQ1QSW4pVJkzZjasC4xF8YqZXPqadF-dRtnwV4VjENA&oe=6AC674C7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Badminton Battle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1687447562, "lastRevision": {"nodes": [{"id": "6942168885
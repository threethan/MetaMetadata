O26x6Iw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvv6EN6cJbc-dddJ_TTG-D2Yo5burEGHVoE9XCr_Z21kg&oe=699AE566"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBAg2s20XJUQ7kNvwEBKu32&_nc_oc=AdkxUO84nDeqPlIr8o36lSx_OYXkxkjENR7R6Lj_Xj_QxA-3oG5m7cX3hNIvicSu304&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfudtcFnDVbEjDFsBpRgOHtjonMJ8zJ8KbC5l9Ef2xqEdw&oe=699B0D88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtydYn6dd7kQ7kNvwFNPqg7&_nc_oc=Adnh8tqQcUJIZ2adFa6iGptNYiG_9_hPTXdjV6V9ZBKwxEpQaBvrGDrnw6J-DIqyhOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvY4z2ZGQdvQ4ZiaNEAr4wR3nQYW-hhigugyXLmtGcOPg&oe=699AF1D6"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.githu
dJlIa8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuWvL303vErNMRmrTEZ12oRfH29lgzFttnNtI2C1U0EiA&oe=699ED9E6"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BT9O4J7_6oQ7kNvwH9Jt68&_nc_oc=AdlsMJ4hlEZGMlGZabL6F_pM-lF7mreLrawtKCUZ5YhY8pf3PT1sDpTnxqKgP2MAvtQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvn2_BFauWUy2QR_mJmvtr0Qa_WQ-h-4C1Wq2AF8FJ_mw&oe=699F0208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7jofQ_lVc8Q7kNvwFF2OtX&_nc_oc=Adm7hAvgYFdezbWM2x8q6NeWVXpLbwDLo4bZcdSKAsLyBFZEaqofeF8XthVKrLOD1-c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftZQJOrSp2sKcBilZcBGu_vhzSZuhWcILuCsv_GpEW3Og&oe=699EE656"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.githu
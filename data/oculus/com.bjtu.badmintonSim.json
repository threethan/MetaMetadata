2iLrYIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu-JvHF6JrFc8SRILaSct49eYrCB3SJNqNha1OK82VsuA&oe=69984266"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ju3aSzzOZjQQ7kNvwFtaJKU&_nc_oc=Adm78OmNoeEcRTEx35LSi5YpK5GZHRPJ0MTAYHwoIpwXsRW9mtJgOAlSMmVTqHxL21s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsgwOVDPtQGBZ9tkxGmE-7_CKNPh_XLZNXvwLeVD5v6kw&oe=69986A88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOvRnWFn21AQ7kNvwErJt0c&_nc_oc=AdnjoQYNzYH3gEzwdjE-iCS6FHFPiC573JeDm0wELOc-cwMjE-Dqpj8sy7Uk8MDc2MI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuhgGqzqY9OY3Alej4gctr7_Eul1sIbMO9JnXM1bGvg9Q&oe=69984ED6"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.githu
232", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982585_1648333092725565_2005341481880093428_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAnwl2D_k84Q7kNvwH1nYIr&_nc_oc=AdqcFKq3yFlfo4WJjrsbpNZRiuf70-qlqKiLpXwU-Ys-gc9cICXu4PE97wcCto2Lrs4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKROVAvCXci4NTWvCnxILHUGXuPCvgaYYkoajbrw7azgQ&oe=6AAEA726"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cE-E2puRId4Q7kNvwFXRI0q&_nc_oc=AdqHJoS_efzZ9Z-Eqy-4Z1lc9GnTa1QdV2rdVqfl1ih9yMkLWoTdKU27FOOolQWbFag&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxX2jsTvQotPdKE2VHEQ8NZakCWBKQDKWjon5C7S_dtA&oe=6AAE9708"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orVkO12VgYUQ7kNvwF43XUo&_nc_oc=Adp8AayYVcH8BnfOGuJqrPvxzrhK8zlE-KQ-CVSyY9vWGE4AlfRmZwvrpHfF1AzDh8A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI8UZ3WA95PfAEbpxoLuvq426LqQDEJa2fheYQfmVB6A&oe=6AAEB396"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.github.io/badmintonxr/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Chunjun Liang", "support_website_url": null, "website_url": "https://chunjunliang.github.io/badmintonxr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "zh_CN", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25037437762541525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031555_1513022456009865_8607747565322085322_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwdN-tNl7YgQ7kNvwF4FAC_&_nc_oc=Adq0z4_PzWLanFYlI2r2pJjAgGqWdNWzUeGCeSJZOsHN9HCU3fuq5pJyUQsl96RCWUs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh8VxHjcQbKHiOyZeZx2GGd2DfAj442frqLSmVu8KoMw&oe=6AAE8187"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Badminton Battle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1687447562, "lastRevision": {"nodes": [{"id":
cQ7kNvwHFLdAG&_nc_oc=AdmOWz5rRnR3QUOcdgrbmosFSw0aFLTqOTnHSoeUVnY4DKH3NbcPExRqd5CRWQHfhkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjogU7bmApLsCF3082lQRVmAUEmrhFYhEo5xUat8kObg&oe=69BFCF66"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1w_t-Vdj18Q7kNvwG8aBJ9&_nc_oc=Adk6AbqU4Cxt_OWzOJ9uS9CcirkBoO6UYYiMXQE2XnZ3USJ8IE_RGWD1F29xOk7djyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRLXo_a8EUhA5XCt2wwjagJUjAJW3nViZ9rXGu2oKloA&oe=69BFF788"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vwn_-AGCk9sQ7kNvwENHD_s&_nc_oc=AdnXDyIpy3ar37nF3j9MMyDlAZxiNvWt3SYBA_4BIO_50URZyq1vvOsqMR2nxHaYTdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6tfMr-L9J6TsIzwjCX2kRAbtb73Z29r17h2q7YzDB1g&oe=69BFDBD6"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.github.io/badmintonxr/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Chunjun Liang", "support_website_url": null, "website_url": "https://chunjunliang.github.io/badmintonxr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko", "zh_CN", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "25037437762541525"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031555_1513022456009865_8607747565322085322_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYwkXVHma34Q7kNvwHc6X7g&_nc_oc=AdkCAVB3sZzquXR67q6RyNDrPEkInNa-E_7mX8OpuSMnu_Jj2lCGt8-KGimP53SONqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsA_H0EAgocML2fFZhV6uudjJNylJz4KB1o_2_xfpSOg&oe=69BFE207"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Badminton Battle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1687447562, "lastRevision": {"nodes": [{"id": "6942168885828356", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6942168869161691", "is_first_party"
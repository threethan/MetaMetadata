5RokEsg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afty82HKeD5Ix16mxv8kpeVOqdcHbzsgyEEYFFdr7xDLoQ&oe=699C36E6"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBAg2s20XJUQ7kNvwHK9Hae&_nc_oc=AdmBwE4u6-CqNASDON4w39BVcYRSAmjc9R5Srzr9U1RNOpJkvfpg10N9GdJwL4CjQhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu8mxrEZNWb9gQzXjVCcWDY5qk1HAqnsI-3RewkVgdxYg&oe=699C5F08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtydYn6dd7kQ7kNvwFOgjwR&_nc_oc=Adm0X3wu6EcUhmngF9MTxcu38Oc0M5OT8lW1sZviZ6GAlNK2MPUW2qO3rqeP7D2GiKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv7-O-vlWqSESgzXBTOklh28K4OuIK3nFDG7bPyVAYV5A&oe=699C4356"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.githu
gFCxXSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhPXKX6uJVw8ogVRWqdFJXJerTtEtwLhX43Ls300_tGA&oe=69A02B66"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BT9O4J7_6oQ7kNvwHBWusJ&_nc_oc=AdnP9czyWLTM5cs5spZjGdLmFawmV7_c1ChlfyJO5MdCK55_bKATuY1Alr2N9gla72E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs5zNJbxEQbFe1YnlrElq1oRz82lTuLKlIwG-t0jqVqKA&oe=69A05388"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7jofQ_lVc8Q7kNvwF5LZYa&_nc_oc=AdlM-kucBihjK5r90w3A1nLWSy4qITAGIp8T24KZ6eyKTTrUd-wW1JR9l5vTnA7Cd0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs72PHLc8oNRbk-pe_P5jFh359gDDRX6iPjM1UgoKcZIQ&oe=69A037D6"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.githu
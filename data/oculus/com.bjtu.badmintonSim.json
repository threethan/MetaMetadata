aWb3cs0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftG_v9DwSMPCiUxf6j8ZiBOMv6IKZ6O1xTpGRtmgRaoNw&oe=69A17CE6"}, {"file_name": "screenshot4.png", "id": "3281669428795019", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974494_3281669435461685_7676053831912823077_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gY008P1SjSIQ7kNvwEA-kqA&_nc_oc=AdnlLXjE3eM0BYrENdkQ0JJsDB0zPHnG7I3PsQ8Dxbsdoba7QITeSTwRVwyZkKS6czI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfueoyIWBTsT7dW1rdHzUI74O008_r9hd9LQL_8gi8Y2iA&oe=69A1A508"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screenshot4-2.png", "id": "741114268739942", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491831382_741114275406608_648245404336983457_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7jofQ_lVc8Q7kNvwFUHxuH&_nc_oc=AdlS6JZiSelZqFlCH3LXYdbwged4E7eUaw8fqwIZSbY_xJ-0rnHPv3EM877slga0t_Y&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvNSjEFrIKub60hYEyDke4bLcldAEk_eRpT713j4riAuw&oe=69A18956"}, "display_name": "Badminton Battle", "keywords": [], "long_description": "Badminton Battle isn\u2019t just a game\u2014it\u2019s an immersive shuttlecock showdown powered by cutting-edge VR and MR tech.\n\nThree Modes:\nVR: Dive into a digital court with a headset.\nMR: Turn your living room into a pro arena.\nPortal: Blend reality and virtual, for hyper-realistic rallies.\n\nGameplay Options:\nSingleplayer: Face AI from novice to pro, climb rankings.\nMultiplayer: Play 1v1 or doubles globally, with seamless cross-reality matches.\nTraining: Customize an automated feeder to refine your skills, beginner or pro.\n\nWith realistic physics, responsive controls, and stunning visuals, Badminton Battle redefines digital sports. Ready to serve?", "short_description": "A realistic badminton game that presents virtual reality, mixed reality, singleplayer and multiplayer experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://chunjunliang.githu
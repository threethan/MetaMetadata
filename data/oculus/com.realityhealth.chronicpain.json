1746", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974855_1175345356515079_6439235782414517138_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw3WUosGKRkQ7kNvwEEloSt&_nc_oc=Adp2FJfvjSZ0aEP06b57oxrqMf11aPprojnURf-MB-cIDNXwPgBhyv5bhCwEHrBssHE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWnUn16YkPDKWadI3w6Kv-RjTLWiEb2Qe1JdBdiv0Ahw&oe=6AFB180D"}, {"file_name": "Screenshot-4.png", "id": "926649662093614", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86625127_926649665426947_1286850211151475476_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VILoUEBQHaAQ7kNvwG-GaX9&_nc_oc=Adrb3QUneUbk9Vt3dpa1PCob07q5ilCKa8O0QUSoicgTohJeJ4Opigpq2RLPFtksnl8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpwZlzgaxjpICS-lYr9Wf7WavMVz6-TeDbvBkW_zk36A&oe=6AFB35E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reality Health Management Platform for Chronic Health", "keywords": [], "long_description": "Reality Health Management Platform for Chronic Pain is a virtual reality application which provides an immersive and scientifically-based virtual reality learning that enables healthcare professionals to deliver chronic pain education to their patients in a safe, consistent, and functional way.\n\nThe app is, from the ground up, based on current pain science and evidence-based techniques to convey the target concepts in an environment that encourages clients to explore their own experience with pain within a therapeutic setting. The platform then integrates modern pain science into carefully designed rehabilitation modules.\n\nThrough this approach, the emphasis is on giving chronic pain sufferers compelling experiences that trigger positive adaptation and enable and empower them to drive their own recovery with their clinician.", "short_description": "Reality Health Management Platform for Chronic Pain is a virtual reality application which provides an immersive and scientifically-based virtual reality learning that enables clinicians to deliver chronic pain management education to their patients in a safe, consistent, and functional way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uat.reality.health/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Reality Health", "support_website_url": null, "website_url": "https://www.reality.health/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3416541941995635"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "630868928905884"}]}, "baseline_offer": {"id": "630868928905884"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1691118002, "status": "PUBLISHED", "id": "630868928905884"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24255272784079392", "version": "1.2"}, "id": "649822220157355", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6015148421851773", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24255272784079392"}, "release_status": "
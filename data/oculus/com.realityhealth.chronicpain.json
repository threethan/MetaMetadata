scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVFLTNn_s2g5ruOZxyv0pcVajadKwbFbjBfcgxUXVfhg&oe=6A8D734D"}, {"file_name": "Screenshot-4.png", "id": "926649662093614", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86625127_926649665426947_1286850211151475476_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzggAJiBUVEQ7kNvwFZ1Zw9&_nc_oc=AdrwJnTf1bz0kBLS0z6qTGQjWPaFdXRFLO6xoD6T_AQmItc6ilOEyenjK5ki6_SFYHk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI8WeiehPAQJ630weY1n5P1FfAbdTl1HEtfJjcnCzEjw&oe=6A8D9122"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reality Health Management Platform for Chronic Health", "keywords": [], "long_description": "Reality Health Management Platform for Chronic Pain is a virtual reality application which provides an immersive and scientifically-based virtual reality learning that enables healthcare professionals to deliver chronic pain education to their patients in a safe, consistent, and functional way.\n\nThe app is, from the ground up, based on current pain science and evidence-based techniques to convey the target concepts in an environment that encourages clients to explore their own experience with pain within a therapeutic setting. The platform then integrates modern pain science into carefully designed rehabilitation modules.\n\nThrough this approach, the emphasis is on giving chronic pain sufferers compelling experiences that trigger positive adaptation and enable and empower them to drive their own recovery with their clinician.", "short_description": "Reality Health Management Platform for Chronic Pain is a virtual reality application which provides an immersive and scientifically-based virtual reality learning that enables clinicians to deliver chronic pain management education to their patients in a safe, consistent, and functional way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uat.reality.health/privacy/", "developer_terms_of_se
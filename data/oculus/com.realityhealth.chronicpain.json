sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjULwWOtHHpMcDEUC3AIfwRezSjLl61By1SEfFzPSFEA&oe=6A897ECD"}, {"file_name": "Screenshot-4.png", "id": "926649662093614", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86625127_926649665426947_1286850211151475476_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQHRfr3ld5IQ7kNvwE0o1mn&_nc_oc=Adqst-L8nslfCyGICyyy6z_w94AVVn8GjqLIinjs8ugmsi7259ZBuFDpamlfdgXlIdA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMGxt0iEJNbHbANoiIRRAcKw2AF10MFjzqz7LZidU_ZA&oe=6A899CA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reality Health Management Platform for Chronic Health", "keywords": [], "long_description": "Reality Health Management Platform for Chronic Pain is a virtual reality application which provides an immersive and scientifically-based virtual reality learning that enables healthcare professionals to deliver chronic pain education to their patients in a safe, consistent, and functional way.\n\nThe app is, from the ground up, based on current pain science and evidence-based techniques to convey the target concepts in an environment that encourages clients to explore their own experience with pain within a therapeutic setting. The platform then integrates modern pain science into carefully designed rehabilitation modules.\n\nThrough this approach, the emphasis is on giving chronic pain sufferers compelling experiences that trigger positive adaptation and enable and empower them to drive their own recovery with their clinician.", "short_description": "Reality Health Management Platform for Chronic Pain is a virtual reality application which provides an immersive and scientifically-based virtual reality learning that enables clinicians to deliver chronic pain management education to their patients in a safe, consistent, and functional way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uat.reality.health/privacy/", "developer_terms_of_service_url": 
ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSf-cDxOlq6JdZSz85ulNvd-SLyWSMYpTB5_DSujbJSw&oe=6AF7238D"}, {"file_name": "Screenshot-4.png", "id": "926649662093614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625127_926649665426947_1286850211151475476_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJPGmmIBrOIQ7kNvwEQCjaf&_nc_oc=AdpcBgYg8hlMnSgr-YkyzpgRTNslK0LjkseQs0KGLavgbl488Okyi0n41T8jvjpA274&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyNkNLrMeMPTnPA4fP9QVvGRg8lZ2cFtGl2xNg9nd6KA&oe=6AF74162"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reality Health Management Platform for Chronic Health", "keywords": [], "long_description": "Reality Health Management Platform for Chronic Pain is a virtual reality application which provides an immersive and scientifically-based virtual reality learning that enables healthcare professionals to deliver chronic pain education to their patients in a safe, consistent, and functional way.\n\nThe app is, from the ground up, based on current pain science and evidence-based techniques to convey the target concepts in an environment that encourages clients to explore their own experience with pain within a therapeutic setting. The platform then integrates modern pain science into carefully designed rehabilitation modules.\n\nThrough this approach, the emphasis is on giving chronic pain sufferers compelling experiences that trigger positive adaptation and enable and empower them to drive their own recovery with their clinician.", "short_description": "Reality Health Management Platform for Chronic Pain is a virtual reality application which provides an immersive and scientifically-based virtual reality learning that enables clinicians to deliver chronic pain management education to their patients in a safe, consistent, and functional way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uat.reality.health/privacy/", "developer_terms_of_service_url": 
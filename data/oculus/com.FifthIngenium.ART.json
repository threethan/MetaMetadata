vwEPBgiO&_nc_oc=AdrSOgnW3JnrrJEXEhfJ5FnqrlAL3VapmSr7mPVdus4vjGbTiZHRZBNTZKbHOhW-KI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMb3mfe-H9gBxBxAU16Wsavh7MQWDQP4JfVnTe85LRvvA&oe=6AE496EE"}, {"file_name": "Screen_1.png", "id": "595640345736954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_595640349070287_4494131456388180167_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LF4Ab2pRMEcQ7kNvwFKOtAQ&_nc_oc=Adq2yRkn3W8IqP7boK8SWLTNTYJSI4DwmwTKqrljEapRHDGVqW1522gMpJUc4V7EPiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkRNYXJKdiEAZpySzCzYvLkGZCIew0HSuMTDwLuvCRqg&oe=6AE48DC1"}, {"file_name": "Screen_2.png", "id": "736482344752427", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003240_736482348085760_7376138505813274972_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBooEFYjZMoQ7kNvwHIq1ej&_nc_oc=Adq7LtAHO8W5rcnVn8mPtTFQEIC_Xd_D1IlNJsDb26Ki9nn7VfAYatMtAVbk-Z8L3R0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgZJ1SeNXxlj5OY_JzjJvX1gms5Wd-VfHSwo9-VJPsTA&oe=6AE48F1A"}, {"file_name": "Screen_3.png", "id": "1307205410057683", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_1307205413391016_3453099530593234066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-lDpX4ZLZQQ7kNvwFtdF-s&_nc_oc=AdrTYtFY2FwG1LAUt--amvGPA68RNlIrmVhf_C0otjxjxC2uOR48s6-S2J8Y7M-oGr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnHoDEeVOIflw-F_J2DJRLb_-T8hkYstmEef9SJqq7DA&oe=6AE4AE4E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ART", "keywords": [], "long_description": "Out of the Frame is an eXtended Reality (XR) platform designed by FifthIngenium to support the tourism industry. \n\nIt is the definitive XR shared experience for tourism, empowering tour operators and event organizers to create engaging journeys that captivate travelers. \n\nThe platform seamlessly integrates 2D and 3D content with artistic locations and virtual tour guides, providing a compelling and interactive experience. \nWhether customers are in a physical agency or participating remotely, Out of the Frame delivers a new way to explore and connect with destinations.\n\nKey Features:\n\n\u2022\teXtended Reality: Create immersive and engaging experiences for tourism.\n\n\u2022\tShared Experiences: Allow multiple users to interact with the same content simultaneously.\n\n\u2022\tContent Portal: Access and manage a wide range of 2D and 3D content.\n\n\u2022\tVirtual Tour Guides: Enhance the journey with interactive, virtual guides.\n\n\u2022\tFlexible Access: Deliver experiences both in-person at tour agencies and remotely.\n\n\u2022\tMultilingual Support: Available in Arabic, English, French, German, Italian, Russian, and Spanish.\n\nGo beyond the conventional. Download Out of the Frame and start creating the future of tourism.\n", "short_description": "Out of the Frame, an eXtended Reality (XR) platform from FifthIngenium, creates unique XR shared experiences for tourism. \n\nCombine 2D and 3D content with real-world locations and virtual guides to create engaging journeys for your customers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheframe.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": null, "website_url": "https://outoftheframe.art/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SIT
488579162", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/57566698_5948141491912495_5490350728290106751_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4wTiNzoDRAQ7kNvwFRfglm&_nc_oc=Adp6PD7AuUoiLoufgcWuwIE8V_0bU2mtf1UKgWgxi7mVKCFolufoLVUaBqy1d66T9oA&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2wK8d9v0vxkYMIf_Uo6kZIawuCZVlVTVgSUnr8IrbjQ&oe=6B0867AE"}, {"file_name": "Screen_1.png", "id": "595640345736954", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982584_595640349070287_4494131456388180167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAMVN7K1BlsQ7kNvwGobf8e&_nc_oc=AdoHK58VOTOMmyRYWA1nG7DtPrP6EULWXafK1Ka5ooSCV29FkUd7pEpXMnD0YsmCwKw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbWn5mPQ93yLkwXKGocfBeCDHXRUO_jjZD4zCA4-PnFA&oe=6B085E81"}, {"file_name": "Screen_2.png", "id": "736482344752427", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003240_736482348085760_7376138505813274972_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZX4vnPwCVsQ7kNvwGmcn3h&_nc_oc=AdqFt8elXop0kzTcO0HQuul9klze4QDGqsAKAySpP_uHWKEzHcs8lA8PAvZ-0JPLccE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDKwxMkXj7GqNWd8euM9EBfg9lfd24IwcQYhKXhV-B0A&oe=6B085FDA"}, {"file_name": "Screen_3.png", "id": "1307205410057683", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036641_1307205413391016_3453099530593234066_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6KyMgGAtqcQ7kNvwGJEeha&_nc_oc=Adpesi6q5wSnExOtbE_3wbWPlfDNOX-K6UJTZe9ntCizY-6RNYolf7-HfVOclyRSIfQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPjmpDj0aUtw6V7XU1MS64525F-k2Q8Q9o4pySPe7ijg&oe=6B0846CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ART", "keywords": [], "long_description": "Out of the Frame is an eXtended Reality (XR) platform designed by FifthIngenium to support the tourism industry. \n\nIt is the definitive XR shared experience for tourism, empowering tour operators and event organizers to create engaging journeys that captivate travelers. \n\nThe platform seamlessly integrates 2D and 3D content with artistic locations and virtual tour guides, providing a compelling and interactive experience. \nWhether customers are in a physical agency or participating remotely, Out of the Frame delivers a new way to explore and connect with destinations.\n\nKey Features:\n\n\u2022\teXtended Reality: Create immersive and engaging experiences for tourism.\n\n\u2022\tShared Experiences: Allow multiple users to interact with the same content simultaneously.\n\n\u2022\tContent Portal: Access and manage a wide range of 2D and 3D content.\n\n\u2022\tVirtual Tour Guides: Enhance the journey with interactive, virtual guides.\n\n\u2022\tFlexible Access: Deliver experiences both in-person at tour agencies and remotely.\n\n\u2022\tMultilingual Support: Available in Arabic, English, French, German, Italian, Russian, and Spanish.\n\nGo beyond the conventional. Download Out of the Frame and start creating the future of tourism.\n", "short_description": "Out of the Frame, an eXtended Reality (XR) platform from FifthIngenium, creates unique XR shared experiences for tourism. \n\nCombine 2D and 3D content with real-world locations and virtual guides to create engaging journeys for your customers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheframe.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": null, "website_url": "https://outoftheframe.art/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_
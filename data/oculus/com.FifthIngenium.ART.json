488579162", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566698_5948141491912495_5490350728290106751_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLZjGOAaujYQ7kNvwHppbDk&_nc_oc=Adpz4Qacaz_ZztW9i_XBCs19Ek0o4UXrN7VmauGcXnNzT6ApZzC9y5MV0IDUy8qpd-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZnrbJMoKKdVpKkdprf6CRdgNJU6alEfy8JRHvMMgffg&oe=6B007EAE"}, {"file_name": "Screen_1.png", "id": "595640345736954", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982584_595640349070287_4494131456388180167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcUGHvA5IYMQ7kNvwFyRssV&_nc_oc=AdrFF7wYvO6MekPXk6INixbPswX6TvfceSSlHzx5kiHV7EYNUC5D_Sf06VwXgBtkdm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_fG0u9pnCcbqg_OrEU5TzE-YgJ3LwbLkLEaIKGxJP0g&oe=6B007581"}, {"file_name": "Screen_2.png", "id": "736482344752427", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003240_736482348085760_7376138505813274972_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA1pqueRtaMQ7kNvwH9x2Mm&_nc_oc=Ado2p4p4mL-zEJCsdrj2r_-OQjSKSukj9kQg_n2fJBRMEny4zFU9S1te2yZxE9uSBf4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfSQZGlrtsm1RuQXCbK3hVxcLOq9nbveSAPqxuRXn5YQ&oe=6B0076DA"}, {"file_name": "Screen_3.png", "id": "1307205410057683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_1307205413391016_3453099530593234066_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne8IhCYwy_gQ7kNvwG84eBm&_nc_oc=Adq6ggfPUiKwyiPs9fagC_omv7si2errNNguJ_v-9MLO_cv3NKuNEYi_iwTc5ub7BX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLHUSnXOF87lIHXtymVrtG_7AD_HaUnskLyMwIeQ2TBg&oe=6B005DCE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ART", "keywords": [], "long_description": "Out of the Frame is an eXtended Reality (XR) platform designed by FifthIngenium to support the tourism industry. \n\nIt is the definitive XR shared experience for tourism, empowering tour operators and event organizers to create engaging journeys that captivate travelers. \n\nThe platform seamlessly integrates 2D and 3D content with artistic locations and virtual tour guides, providing a compelling and interactive experience. \nWhether customers are in a physical agency or participating remotely, Out of the Frame delivers a new way to explore and connect with destinations.\n\nKey Features:\n\n\u2022\teXtended Reality: Create immersive and engaging experiences for tourism.\n\n\u2022\tShared Experiences: Allow multiple users to interact with the same content simultaneously.\n\n\u2022\tContent Portal: Access and manage a wide range of 2D and 3D content.\n\n\u2022\tVirtual Tour Guides: Enhance the journey with interactive, virtual guides.\n\n\u2022\tFlexible Access: Deliver experiences both in-person at tour agencies and remotely.\n\n\u2022\tMultilingual Support: Available in Arabic, English, French, German, Italian, Russian, and Spanish.\n\nGo beyond the conventional. Download Out of the Frame and start creating the future of tourism.\n", "short_description": "Out of the Frame, an eXtended Reality (XR) platform from FifthIngenium, creates unique XR shared experiences for tourism. \n\nCombine 2D and 3D content with real-world locations and virtual guides to create engaging journeys for your customers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheframe.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": null, "website_url": "https://outoftheframe.art/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_
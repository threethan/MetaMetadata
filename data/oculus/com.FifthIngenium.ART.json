vwGHIbSu&_nc_oc=AdrOU_pSTkz1z2ZPYsQ3JgLgexyM-8SfZqO2rRcEgPzpcDhUwmz4RrQsmHNt1ynSLPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaUA2a-Znt7WAEV_tRV0u9r9wZxViztoKtNFatHXjqQQ&oe=6ADF50EE"}, {"file_name": "Screen_1.png", "id": "595640345736954", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_595640349070287_4494131456388180167_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbgmKRZKdRMQ7kNvwHvBmEP&_nc_oc=AdqSdjq5EKfCJrOGhY2HqCW37DNjS55dkr_nmrKVUryPgURC5hS4-Httm_SdIvyV1dY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPSD88imMBj-zzOcEL1OICwN_vohpXaAQRZqOxIPF6rQ&oe=6ADF47C1"}, {"file_name": "Screen_2.png", "id": "736482344752427", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003240_736482348085760_7376138505813274972_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGYuDSS-65cQ7kNvwF_u2G5&_nc_oc=Adp_XdHicrJGLE7E9oKdCGXofC54dZfiA22pAqcgWUwrRWabziVLoYzxdQ3KCk0C_Uk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzSF9hfQeol-mUr3-R-eDVg5OCbaQ4D0UWpMWDtg3dvg&oe=6ADF491A"}, {"file_name": "Screen_3.png", "id": "1307205410057683", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036641_1307205413391016_3453099530593234066_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd8ajWqIfB8Q7kNvwGVrLE6&_nc_oc=Ado2sHAAi0ZZxwT5hXihJDBmG8FNY_2UEnlfxOcIEdk8LS9xNzlnAT54Jt7TMHLYvC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2q15Frkod2xMn-CH5nPcKglA8-ALXQ5fptVXTRej1pQ&oe=6ADF684E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ART", "keywords": [], "long_description": "Out of the Frame is an eXtended Reality (XR) platform designed by FifthIngenium to support the tourism industry. \n\nIt is the definitive XR shared experience for tourism, empowering tour operators and event organizers to create engaging journeys that captivate travelers. \n\nThe platform seamlessly integrates 2D and 3D content with artistic locations and virtual tour guides, providing a compelling and interactive experience. \nWhether customers are in a physical agency or participating remotely, Out of the Frame delivers a new way to explore and connect with destinations.\n\nKey Features:\n\n\u2022\teXtended Reality: Create immersive and engaging experiences for tourism.\n\n\u2022\tShared Experiences: Allow multiple users to interact with the same content simultaneously.\n\n\u2022\tContent Portal: Access and manage a wide range of 2D and 3D content.\n\n\u2022\tVirtual Tour Guides: Enhance the journey with interactive, virtual guides.\n\n\u2022\tFlexible Access: Deliver experiences both in-person at tour agencies and remotely.\n\n\u2022\tMultilingual Support: Available in Arabic, English, French, German, Italian, Russian, and Spanish.\n\nGo beyond the conventional. Download Out of the Frame and start creating the future of tourism.\n", "short_description": "Out of the Frame, an eXtended Reality (XR) platform from FifthIngenium, creates unique XR shared experiences for tourism. \n\nCombine 2D and 3D content with real-world locations and virtual guides to create engaging journeys for your customers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheframe.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": null, "website_url": "https://outoftheframe.art/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SIT
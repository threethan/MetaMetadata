488579162", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566698_5948141491912495_5490350728290106751_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92j94fJW62sQ7kNvwHEdAKv&_nc_oc=AdoutdHegmfP63uKe_NmRJM_mbjj5YSkNRr-R7IrfWCwAzxEOy5T6SUfcCVXYIigsYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHz7tB0Z4qalHgePBWGCJTGhCuO4ZBgZ9VZDbh3fGd8Q&oe=6AFDDBAE"}, {"file_name": "Screen_1.png", "id": "595640345736954", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982584_595640349070287_4494131456388180167_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOsUFP5CsPkQ7kNvwEvbiyg&_nc_oc=AdrF-AyX3OB80RDIU_YXnO8KL5Ps3OL4x7nuOGBhE7RbcpLjC9Ef3Os0-VBPpdZghfU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr7aPffjqSfNjv9V9vjJFZH0z7uJ_O9Rhi4BMWabxvfA&oe=6AFDD281"}, {"file_name": "Screen_2.png", "id": "736482344752427", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003240_736482348085760_7376138505813274972_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp5wl20xbRIQ7kNvwHUioCX&_nc_oc=AdpLICrzNpFSWgfgSdI2HYApzAQVjfJyu4QC3vbxqzgFxKCyQ55pMyiuXFrL9Aqkenw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZKNyJ3WYD_YCJANQYKiK1NQOavn5sEXP5Qx_XYdXSfA&oe=6AFDD3DA"}, {"file_name": "Screen_3.png", "id": "1307205410057683", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036641_1307205413391016_3453099530593234066_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne8IhCYwy_gQ7kNvwGAQn-U&_nc_oc=AdoknbR2pM0X0LuUM0924E9iXBQzMkrtAabTIv5rtm5Xnnvi_nDZoUfoyatI-w_1Hn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0y7uRNbZvqn1JwZQJDDF9WetxYSxkJ9OjCTIdCGhi9A&oe=6AFDBACE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ART", "keywords": [], "long_description": "Out of the Frame is an eXtended Reality (XR) platform designed by FifthIngenium to support the tourism industry. \n\nIt is the definitive XR shared experience for tourism, empowering tour operators and event organizers to create engaging journeys that captivate travelers. \n\nThe platform seamlessly integrates 2D and 3D content with artistic locations and virtual tour guides, providing a compelling and interactive experience. \nWhether customers are in a physical agency or participating remotely, Out of the Frame delivers a new way to explore and connect with destinations.\n\nKey Features:\n\n\u2022\teXtended Reality: Create immersive and engaging experiences for tourism.\n\n\u2022\tShared Experiences: Allow multiple users to interact with the same content simultaneously.\n\n\u2022\tContent Portal: Access and manage a wide range of 2D and 3D content.\n\n\u2022\tVirtual Tour Guides: Enhance the journey with interactive, virtual guides.\n\n\u2022\tFlexible Access: Deliver experiences both in-person at tour agencies and remotely.\n\n\u2022\tMultilingual Support: Available in Arabic, English, French, German, Italian, Russian, and Spanish.\n\nGo beyond the conventional. Download Out of the Frame and start creating the future of tourism.\n", "short_description": "Out of the Frame, an eXtended Reality (XR) platform from FifthIngenium, creates unique XR shared experiences for tourism. \n\nCombine 2D and 3D content with real-world locations and virtual guides to create engaging journeys for your customers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://outoftheframe.art/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": null, "website_url": "https://outoftheframe.art/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": ["ART_CREATIVITY"], "has_in_app_ads": null, "internet_
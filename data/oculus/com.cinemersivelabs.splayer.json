-iad3-1.oculuscdn.com/v/t64.5771-25/38974632_721780813088370_2274276864167816402_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8DkEcPXzkQQ7kNvwGmwVZp&_nc_oc=AdnQrJVdPDjl1Ss-Yx9558-riwD_Ab_pl7s56wXpjjEBlPy-eJ2DkSQlDUEMk1PhOJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSJj0M0k2v79-N-NuH5qiOlQiJIGsFDoPOtRvij2zNkg&oe=69A2EC75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031626_1014834092788725_4495441295368305048_n.png", "id": "993624428731354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003285_993624432064687_1853182759585078974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebBw8-1k3V4Q7kNvwEvSNOf&_nc_oc=AdmpYgjH6q34tupHSProygwDWYXsXycuk0sq0Y9-KKv9ckoavwBKA6drs8x3Pu_dIo0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6KyKEm06Gw2DpsnFGVl1446j0PnkWKpNZHoD5E615lw&oe=69A2EAD8"}, "display_name": "Cinemersive Video Player", "keywords": [], "long_description": "Cinemersive Labs brings the next generation of fully immersive, three-dimensional videos to standalone VR headsets. Our technology allows to acquire, process, store, and render images and videos in six degrees-of-freedom 3D.\n\nThe current version of the app contains the comedy film \"Love Square\" as well as four additional short videos captured in Yerevan, Armenia. This content was recorded with our proprietary five-camera rig.", "short_description": "Hyper-real immersive videos in six degrees of freedom. \nSay 'goodbye' to VR motion sickness, and an exhilarated 'hello' to genuine, naturalistic immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cinemersivelabs.com/apps-privacy", "developer_terms_of_service_url": null, "publisher_name": "Cinemersive Labs", "support_website_url": null, "website_url": "https://www.cinemersivelabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "43496192621
 Labs brings the next generation of fully immersive, three-dimensional videos to standalone VR headsets. Our technology allows to acquire, process, store, and render images and videos in six degrees-of-freedom 3D.\n\nThe current version of the app contains the comedy film \"Love Square\" as well as four additional short videos captured in Yerevan, Armenia. This content was recorded with our proprietary five-camera rig.", "short_description": "Hyper-real immersive videos in six degrees of freedom. \nSay 'goodbye' to VR motion sickness, and an exhilarated 'hello' to genuine, naturalistic immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cinemersivelabs.com/apps-privacy", "developer_terms_of_service_url": null, "publisher_name": "Cinemersive Labs", "support_website_url": null, "website_url": "https://www.cinemersivelabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1019557185715254"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "676196150623978"}]}, "baseline_offer": {"id": "676196150623978"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1691179599, "status": "PUBLISHED", "id": "676196150623978"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24166107593091092", "version": "0.0.73"}, "id": "531462132449
-ams2-1.oculuscdn.com/v/t64.5771-25/38974632_721780813088370_2274276864167816402_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lO8HJhDTdUYQ7kNvwHleRom&_nc_oc=AdnurZKniCpV-T-pWSt-PUrNXLCtZ0onYcxPKH6L0D8h8uGGzrOQhkI3dG54CXMmd3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs34iLmxkb0u0f2UYXQ4Cd524E5hhGKVFIYeaooTKdYMw&oe=699EF7F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031626_1014834092788725_4495441295368305048_n.png", "id": "993624428731354", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003285_993624432064687_1853182759585078974_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M84cIFUePIIQ7kNvwFJAfrg&_nc_oc=AdmMibi2BQJ8kZdqAqwb3XGbvxAJE83yJWYWmkye6d6bcW2BJ0rhcOIwvoHeroW5VPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft1rxkmuwOqAp1qP2gwUbKkVhu41z2cKEDMQcKzM2g8DA&oe=699EF658"}, "display_name": "Cinemersive Video Player", "keywords": [], "long_description": "Cinemersive Labs brings the next generation of fully immersive, three-dimensional videos to standalone VR headsets. Our technology allows to acquire, process, store, and render images and videos in six degrees-of-freedom 3D.\n\nThe current version of the app contains the comedy film \"Love Square\" as well as four additional short videos captured in Yerevan, Armenia. This content was recorded with our proprietary five-camera rig.", "short_description": "Hyper-real immersive videos in six degrees of freedom. \nSay 'goodbye' to VR motion sickness, and an exhilarated 'hello' to genuine, naturalistic immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cinemersivelabs.com/apps-privacy", "developer_terms_of_service_url": null, "publisher_name": "Cinemersive Labs", "support_website_url": null, "website_url": "https://www.cinemersivelabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "43496192621
ng", "id": "993624428731354", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003285_993624432064687_1853182759585078974_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcaFY6trg0gQ7kNvwER_UqW&_nc_oc=AdqfyOW7ZGIHlrfDrVwQBjnRCFstP4b8iRWpQEY8QxFOhfTGsX961dR1d3cEkNKZF1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRaorRRBAIkKRPeLyChQ-_aK0vBdDsXYGBk0a3cL6UxVw&oe=6B0DAF98"}, "display_name": "Cinemersive Video Player", "keywords": [], "long_description": "Cinemersive Labs brings the next generation of fully immersive, three-dimensional videos to standalone VR headsets. Our technology allows to acquire, process, store, and render videos in six degrees-of-freedom 3D.\n\nThe current version of the app contains 17 6DoF videos.\nTen of these have been converted from regular 2D smartphone videos using the latest generation of Cinemersive video conversion engine. The remaining seven were acquired with a compact five-camera rig.\n\nTeaser video music by bensound.com (icense code: BI56PWJUBIBMM9NY)\n\n\n", "short_description": "Hyper-real immersive videos in six degrees of freedom. \nSay 'goodbye' to VR motion sickness, and an exhilarated 'hello' to genuine, naturalistic immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cinemersivelabs.com/apps-privacy", "developer_terms_of_service_url": null, "publisher_name": "Cinemersive Labs", "support_website_url": null, "website_url": "https://www.cinemersivelabs.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_i
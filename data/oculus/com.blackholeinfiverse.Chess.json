tegy, Chess Star provides a calm and engaging atmosphere to enjoy chess like never before.\n\nThe game runs entirely offline and does not collect, store, or share any personal user data. All gameplay is processed locally on the device, ensuring privacy and security.\n\nKey Features:\n\u2022 Immersive VR chess environment  \n\u2022 Classic chess rules and gameplay  \n\u2022 Smooth and comfortable VR controls  \n\u2022 Designed for focus and strategic thinking  \n\u2022 No data collection or online requirements  \n\nChess Star is built for players who love chess and want a pure, immersive VR experience.\n", "short_description": "Chess Star is an immersive virtual reality chess experience designed for focus, strategy, and realism. Step into a calm VR environment and enjoy classic chess with intuitive controls and smooth gameplay.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SharconGames/Chess-Game/blob/main/chess", "developer_terms_of_service_url": null, "publisher_name": "Blachole Infiverse LLP", "support_website_url": null, "website_url": "https://github.com/SharconGames/Chess-Game/blob/main/chess", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25594451030250546"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1512296729881301"}]
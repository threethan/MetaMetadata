4awOXPnn-f-rAYGMuUAVryyF2-uoVUNsQK2lG5gQ&oe=6A15B78B"}, {"file_name": "chess2.png", "id": "27029167350006337", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618512_27029167363339669_6036731182102263684_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dJr3d-OSGAQ7kNvwFaXF8J&_nc_oc=AdoK6kJ_6HpRl1L9Dm14g9oE0DGzoH3wH5WHJnY91IceewTK-Bd5C1liYfBZS6gZC30&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X8hQ42mO-c3Vl0ogBX0vAIdIftPbGSCAn-DRNy36xfA&oe=6A15AE5D"}, {"file_name": "chess5.png", "id": "2283917292135831", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618442_2283917295469164_5237685265964022437_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWAj873fo5UQ7kNvwEAl4hY&_nc_oc=Adq1dJ8CMVyd5V5-JrtV1r-StoHa_2k1mX3X7MptSuejGPbDj7RsogDcyNHX_eSp6SY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af714QSpC-Q0V4LmfdS7j4PODgNEbkuQWKf5O4LNZ6BAbQ&oe=6A15AE5E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chess Star", "keywords": ["chess", "boardgame", "indoorgame", "mindgame", "star"], "long_description": "Chess Star is a virtual reality chess game designed to deliver a focused, immersive, and distraction-free chess experience in VR.\n\nStep into a realistic virtual environment where every move matters. Chess Star brings the classic game of chess into VR with intuitive controls, smooth interactions, and comfortable gameplay designed for long sessions.\n\nWhether you are a beginner learning the fundamentals or an experienced player refining your strategy, Chess Star provides a calm and engaging atmosphere to enjoy chess like never before.\n\nThe game runs entirely offline and does not collect, store, or share any personal user data. All gameplay is processed locally on the device, ensuring privacy and security.\n\nKey Features:\n\u2022 Immersive VR chess environment  \n\u2022 Classic chess rules and gameplay  \n\u2022 Smooth and comfortable VR controls  \n\u2022 Designed for focus and strategic thinking  \n\u2022 No data collection or online requirements  \n\nChess Star is built for players who love chess and want a pure, immersive VR experience.\n", "short_description": "Chess Star is an immersive virtual reality chess experience designed for focus, strategy, and realism. Step into a calm VR environment and enjoy classic chess with intuitive controls and smooth gameplay.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/SharconGames/Chess-Game/blob/main/chess", "developer_terms_of_service_url": null, "publisher_name": "Blachole Infiverse LLP", "support_website_url": null, "website_url": "https://github.com/SharconGames/Chess-Game/blob/main/chess", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25594451030250546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618254_1663124501731855_2922186917688525156_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLc7-m2qXLsQ7kNvwGc8qX0&_nc_oc=AdovTIU_A52C_WMeSzLXS5AUXDG-8zlbB66OGZf85UZ6PJTNBgORh3HY1aoVejb3jRQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yfNkMvtKp9AqbTWYkm0VpLoq0mN_nIDGM7Is6rFA1Yg&oe=6A159B72"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name":
ng", "id": "433103806427554", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001697_433103809760887_8322752550691061600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BX-WuQCggkQ7kNvwGPC9AR&_nc_oc=AdqkG0Fe_d_kKm6XmLO5qBMVAkw5S0AKhrGm7-11RhhsjZ7TBaus30gB8ZeSisOb7iU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfqUBAGbttU5u0dCm61d0EzDQ-H3ciSRmdN9mLNzbAnQ&oe=6A8AD5B8"}, {"file_name": "Image Sequence_002_0001.png", "id": "1056220476068384", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982697_1056220479401717_7840162379227703404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6wXHFFgPSMQ7kNvwHDHgWU&_nc_oc=Adrc9XC6x1E86U_oJsAh6n-icanj6XKzo2XhVcoPhB-M6z6VecZ8lk37dETLpzOM9_c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQQGEYp1zdTtxDXrXAUgzhkB6Zp9zY2wT3SCfu4I4LAw&oe=6A8AD383"}, {"file_name": "Image Sequence_005_0001.png", "id": "1051164063205208", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984466_1051164066538541_7036220709104598103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wlIxs7cRlkQ7kNvwHCJ1zr&_nc_oc=Adp5_OxhHNMQXCHL2NRLvG8ZBo0F2ZDnFmuvH8XTsiPOUa9vHw0-tR8NzmYoCKRZeN4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMSkh8biBL7XUjfwLclKUuU7XFpde5zLEaDNbVk_yKqw&oe=6A8AF28C"}, {"file_name": "Image Sequence_006_0001.png", "id": "865084521857384", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003242_865084528524050_4676146938380815761_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKgI91fAIeQQ7kNvwEhOEkq&_nc_oc=AdrqhOeu8GvOBEF8327GK4zO6D8gxcJ7we2PuHMSp3rMLzMxozBxwZexpf_UP1SpHYc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnFvWZ9sCiAlRCNmcOjEhTBgvQ9o-OVfBVOjFoEAdbJQ&oe=6A8AD029"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0001.png", "id": "1032584778066271", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001697_1032584781399604_3190573640588349027_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiGCw4ckrFAQ7kNvwGVqqTO&_nc_oc=AdoJL1JtQKNGYV9I3YdkxCI8Jp3Enw3e1CRX11AD93t-rx5Gc7xPF2QKDmeTzz2zD7Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDAk35aDwgJsnKBX197ZwquDFfYcgkbZxIfDPkiepJTQ&oe=6A8ACF4D"}, "display_name": "Portal Rush", "keywords": ["casual", "runner", "hypercasual", "action", "challenge"], "long_description": "Portal Rush is an innovative VR runner game that immerses you in a thrilling, action-packed world. Your objective is to race through fast-paced courses filled with obstacles, aiming for the highest score possible. What sets this game apart is the ability to instantly teleport to different locations by opening portals with a click. This unique mechanic not only increases the game's pace but also requires you to strategize your moves carefully. Each level presents progressively harder tracks that test your reflexes to the limit. As you advance, you can collect points to climb the leaderboard and compete with other players. The visual effects and VR's immersive realism enhance the game's atmosphere, making every run a captivating experience. \"Portal Dash\" offers an adrenaline-fueled adventure for both VR enthusiasts and runner game fans. Dive into this fast and dynamic world, teleport through portals, race against time, and become the best. Each run brings a new challenge and a new adventure!", "short_description": "Portal Rush is an exhilarating VR runner game that challenges you to navigate obstacle-filled courses at high speed. As you dash through the levels, you can instantly teleport to different locations by opening portals where you click. This dynamic game tests your reflexes and pushes you to conquer increasingly difficult tracks. Your goal is to reach the finish line as quickly as possible and achieve high scores. With its unique portal mechanic, this game brings a fresh twist to classic runner "}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/portal-rush", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9149118831771162"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "27897937653180335"}, {"status": "PUBLISHED", "id": "971964525323088"}, {"status": "PUBLISHED", "id": "1247839350573258"}, {"status": "PUBLISHED", "id": "1200472308593597"}, {"status": "PUBLISHED", "id": "1238586687807226"}, {"status": "PUBLISHED", "id": "724948046634333"}, {"status": "PUBLISHED", "id": "1222874756210291"}, {"status": "PUBLISHED", "id": "959982552294373"}, {"status": "PUBLISHED", "id": "1090927169150299"}, {"status": "PUBLISHED", "id": "440231311698876"}]}, "baseline_offer": {"id": "1222874756210291"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "27897937653180335"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9136314546384924", "version": "0.2"}, "id": "1953219375149693", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__i
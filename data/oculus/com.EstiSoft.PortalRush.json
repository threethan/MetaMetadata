ng", "id": "433103806427554", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001697_433103809760887_8322752550691061600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3x55jXAAr0Q7kNvwGN4bAv&_nc_oc=Adpi6zVo7pUcAMfeaRe4Ymqt8RkVNI_DX119Jrupfo20QfxwkusMabMj9KLKVwNpNwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPcfSW2nQxrLvq5Dr8yJgzvTeVE6G7BKS7mYlPPSrp_g&oe=6A843E38"}, {"file_name": "Image Sequence_002_0001.png", "id": "1056220476068384", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982697_1056220479401717_7840162379227703404_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pp10ZqqZSWwQ7kNvwF0-t2D&_nc_oc=AdpHcfXLY2goOJNRj5Fn6ABbo5NdEVJiYBoENTsXm2NX959FFoDIXfA7TzH1mL9aW_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8K_7jd35YupjdQ2Ln3M_itaJ-bfC5licDEBPoSoBlhQ&oe=6A843C03"}, {"file_name": "Image Sequence_005_0001.png", "id": "1051164063205208", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984466_1051164066538541_7036220709104598103_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUPCYx31AgEQ7kNvwGQFDxT&_nc_oc=AdqdyaNMgegJ4_eAdCXY8imNveeqm7j9wCoJpKKSkrZYVcmH9Vvn0ODr6pZEnyj2_X8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRBfm_350P_iRhlISvY_1Ji7DB9cSyxnK1UNqI1YtFPA&oe=6A845B0C"}, {"file_name": "Image Sequence_006_0001.png", "id": "865084521857384", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003242_865084528524050_4676146938380815761_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqE6Bpe7JXYQ7kNvwGeKbcD&_nc_oc=Adq6uwHxZKkTOdhK1aStxm6mGPZ10NNet_X6lSF0gpFUGkCRHK5WXPyNQBrPyyfdoxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeCTxw_aBubdWMLd1ED6u85Hju1KiMsKd6t339NQie8g&oe=6A8438A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_006_0001.png", "id": "1032584778066271", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001697_1032584781399604_3190573640588349027_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=590f2LwIOrUQ7kNvwF_K4DS&_nc_oc=AdovYjBrMEsBJe7nIsDER_SBHgbtliUYS-5T4Xzj3YoyV8HnWr9-IMX90lnZToBgjIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4zOulaFABCCW6fijLKUa2sAcKkP4UCXzRK6fS1KufgQ&oe=6A8437CD"}, "display_name": "Portal Rush", "keywords": ["casual", "runner", "hypercasual", "action", "challenge"], "long_description": "Portal Rush is an innovative VR runner game that immerses you in a thrilling, action-packed world. Your objective is to race through fast-paced courses filled with obstacles, aiming for the highest score possible. What sets this game apart is the ability to instantly teleport to different locations by opening portals with a click. This unique mechanic not only increases the game's pace but also requires you to strategize your moves carefully. Each level presents progressively harder tracks that test your reflexes to the limit. As you advance, you can collect points to climb the leaderboard and compete with other players. The visual effects and VR's immersive realism enhance the game's atmosphere, making every run a captivating experience. \"Portal Dash\" offers an adrenaline-fueled adventure for both VR enthusiasts and runner game fans. Dive into this fast and dynamic world, teleport through portals, race against time, and become the best. Each run brings a new challenge and a new adventure!", "short_description": "Portal Rush is an exhilarating VR runner game that challenges you to navigate obstacle-filled courses at high speed. As you dash through the levels, you can instantly teleport to different locations by opening portals where you click. This dynamic game tests your reflexes and pushes you to conquer increasingly difficult tracks. Your goal is to reach the finish line as quickly as possible and achieve high scores. With its unique portal mechanic, this game brings a fresh twist to classic runner "}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/portal-rush", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9149118831771162"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "27897937653180335"}, {"status": "PUBLISHED", "id": "971964525323088"}, {"status": "PUBLISHED", "id": "1247839350573258"}, {"status": "PUBLISHED", "id": "1200472308593597"}, {"status": "PUBLISHED", "id": "1238586687807226"}, {"status": "PUBLISHED", "id": "724948046634333"}, {"status": "PUBLISHED", "id": "1222874756210291"}, {"status": "PUBLISHED", "id": "959982552294373"}, {"status": "PUBLISHED", "id": "1090927169150299"}, {"status": "PUBLISHED", "id": "440231311698876"}]}, "baseline_offer": {"id": "1222874756210291"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "27897937653180335"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9136314546384924", "version": "0.2"}, "id": "1953219375149693", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__i
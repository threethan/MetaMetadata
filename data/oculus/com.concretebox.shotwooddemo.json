B&_nc_oc=AdkxBTrOQ9FqlfKfrpKHtQJ4K6jzh2kCFE6atfcLMs8lPcUcxoZqvBhllZYh6UQGXQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsh-mdz5vpQXC0iTSd9NkhD6UxlmrXoIxw1EqKUtINvLA&oe=699AFE85"}, {"file_name": "equipment-terminal.png", "id": "3958226264503543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_3958226267836876_1387244605674504322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIu3-BxIPJ8Q7kNvwFWAIDP&_nc_oc=AdnMix03ANlRk07zsMrMtgTNCIjYjuxM0KUGjFjCs-ALzFP4TeWAIxeAB4CBhv8uKXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftvv3uy5Glg0UAqfqrOYfuP7pK4WvYGi5gKo1yvnuwK0Q&oe=699B07D9"}, {"file_name": "screenshot-4_v2.png", "id": "1050360773266784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031417_1050360776600117_7915853884089917557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fu4Kz0yUJIQ7kNvwGbTpvB&_nc_oc=AdmvPwiHdL_blhH_Ll9t2VHd8LPR8D9IR4Cr-eANkSD4-4gkvo1ACY8WifqEsguqg-s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsvHTzsg_NhQc1oq2LGf0pb_PwX0Lz3VDazJMbb64n9qg&oe=699AFBBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1191951792116232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982570_1191951798782898_1277406797779782208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXbO8C_Nz7oQ7kNvwFUhurE&_nc_oc=AdnSlkufI8IzLDmtaoHbI1mobtvQaKLhob0NqxkhAe9yclbvybtffdDkNA70MuwI99o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuKYyfjNqXzmTYxMAciLQ8H4jegDl1v9MvRx6EkgEvDDw&oe=699B081C"}, "display_name": "Shotwood Demo", "keywords": ["Shot", "Wood", "ShootWood", "Demo", "Free"], "long_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!\n\n{866219128900813}\n\n# Demo Features\n\nCheck out the awesome Shotwood gunplay with immediate access to some high end weaponry, plus the full practice range and 2 **shoot-house assessments**. Chill out in the home environment. Earn credits by completing runs and challenges, hunting the hidden cash wads, or mastering the ridiculous **Balloon Stabber** minigame. Spend credits on ammo, grenades, and gear - including the awesome **sidearm camera**. Find all the hidden clues to access a **secret demo area**!\n\n{427997739692963}\n\n# Full Game Features\n\nThe full Shotwood experience (not in demo) includes 8 shoot-house assessments with 15 challenges each and 3 modes, 20+ firearms, 9 tactical tools including **kamikaze drones** and the augmented visor, 2 minigame floors, playable arcade cabinet, facility induction process, **progression system**, working grievance booth, big secret area \"beyond the booth\", more **story** to uncover including 120 random announcements, 4 save slots, various difficulty options including **permadeath**, new game plus, and even more!\n\n{2300077013672023}\n\n# Tech Features\n\nShotwood runs at a **smooth 90hz refresh rate**, supports full room scale movement as well as seated play, and offers multiple options for movement, haptics, captions, and whole lot more.\n\nGrab this **FREE** demo right now and... SHOOT SOME WOOD!", "short_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.html", "publisher_name": "Concrete Box", "support_website_url": "https://www.concretebox.net/support.html", "website_url": "https://www.concretebox.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592
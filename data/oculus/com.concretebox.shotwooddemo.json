 "861445076021181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031640_861445079354514_4968430877850706782_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oIRbXRK8iEQ7kNvwEoPbRi&_nc_oc=AdqDtkUqOx_ko56jSBZDiVduwCDYI6wDsa3g25HvgrLrQnPqgohrMbJEwnsyNH75Fjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiXqEFc-Mp8lEZEVXylhr1MPoDHL_7nCDtzQQXD-0Zcw&oe=6AFDC3B2"}, {"file_name": "screenshot-5.png", "id": "1923238414795379", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984442_1923238418128712_4769228846090391027_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1tZV0_JTGgQ7kNvwHcuDaB&_nc_oc=AdrXcDh-mpG7OQR5NFEOdR6Wgizm1_zjrFIvxd9dbNmnjq5K-4lFAsFQr2je4so6aFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkFrH4Yny4lzw7AjhnNCIM6tvZ0AdJ024M8nq1czGg6w&oe=6AFDDA45"}, {"file_name": "equipment-terminal.png", "id": "3958226264503543", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75203624_3958226267836876_1387244605674504322_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El1c8SUz5O8Q7kNvwFxRHRb&_nc_oc=AdqZJjBlTYNufiJIbTuOHfuAC_mTdoMGj0hb4pnVVdfmf9dnNSzQgXqQv0hbQHtjjw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZhGHGGRvbRfXUuf6loDFikjLBmstqrlAB_V0dLXpTTw&oe=6AFDE399"}, {"file_name": "screenshot-4_v2.png", "id": "1050360773266784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031417_1050360776600117_7915853884089917557_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRJGr7UY100Q7kNvwFsBZKS&_nc_oc=Adr1DoQi8L4sQBaEPytAUDFoBk6j1-hrjIuc0QcHF1_B3lL4BUJaU2b1AgGw1lF1LRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoR1nN_9ensnm484ZYxCt88pxVAQwgqaYwn_Y7PjUjuA&oe=6AFDD77F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1191951792116232", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982570_1191951798782898_1277406797779782208_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q98QdpDvPV0Q7kNvwFWkXsL&_nc_oc=AdrMCbDSEWf7VPeqjxbxK-MpaKYpyvADZGSvg26LqQIkfeNNCQ-uDMvsX1R8OXIjlEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSoKk2Pgql_vFc9Qn9VAq1HnV3AA8GqIvRN6Jer8zx4g&oe=6AFDE3DC"}, "display_name": "Shotwood Demo", "keywords": ["Shot", "Wood", "ShootWood", "Demo", "Free"], "long_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!\n\n{866219128900813}\n\n# Demo Features\n\nCheck out the awesome Shotwood gunplay with immediate access to some high end weaponry, plus the full practice range and 2 **shoot-house assessments**. Chill out in the home environment. Earn credits by completing runs and challenges, hunting the hidden cash wads, or mastering the ridiculous **Balloon Stabber** minigame. Spend credits on ammo, grenades, and gear - including the awesome **sidearm camera**. Find all the hidden clues to access a **secret demo area**!\n\n{427997739692963}\n\n# Full Game Features\n\nThe full Shotwood experience (not in demo) includes 8 shoot-house assessments with 15 challenges each and 3 modes, 20+ firearms, 9 tactical tools including **kamikaze drones** and the augmented visor, 2 minigame floors, playable arcade cabinet, facility induction process, **progression system**, working grievance booth, big secret area \"beyond the booth\", more **story** to uncover including 120 random announcements, 4 save slots, various difficulty options including **permadeath**, new game plus, and even more!\n\n{2300077013672023}\n\n# Tech Features\n\nShotwood runs at a **smooth 90hz refresh rate**, supports full room scale movement as well as seated play, and offers multiple options for movement, haptics, captions, and whole lot more.\n\nGrab this **FREE** demo right now and... SHOOT SOME WOOD!", "short_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.html", "publisher_name": "Concrete Box", "support_website_url": "https://www.concretebox.net/support.html", "website_url": "https://www.concretebox.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8355918424452259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75443247_7543803869053816_6307277751832370588_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSJnnjRwIi8Q7kNvwELYhSp&_nc_oc=Adp8PK_opBKr_XWR1vjHWXDfYvcLEqaj7-Vu3aaYQHN4NkUSohfQPsntTK8S-g2nOFw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-3UpJ7FGyOJap2YDqc5ItinAcHA2MAQTGxkpc9wC3dA&oe=6AFDB8FC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shotwood Demo", "platform": "ANDROID_6DOF"
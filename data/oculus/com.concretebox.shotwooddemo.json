-atl3-3.oculuscdn.com/v/t64.5771-25/38984442_1923238418128712_4769228846090391027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVH_p7swwMwQ7kNvwGjg_MU&_nc_oc=AdqdA8Lpc60hw8Fw1DCPRVG-jGCKvPEnKjF-F5TWHT5Gy7TpA1fG7Hs-cqJlVnpboWE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyVL_Yx21Jy8ae7Kw0Az6ysvjTBeEfa5CbPR1KrmG3m8g&oe=69C13A05"}, {"file_name": "equipment-terminal.png", "id": "3958226264503543", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203624_3958226267836876_1387244605674504322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SusktLZE7BwQ7kNvwFoeOG7&_nc_oc=Ado-Ln7drAv_xg8vm_H8GMsTobjjefVdZhz0hD7sR3uS9WM1x_GnULdRr5b7Ld1dUtQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZ5vzTEBshWNYq6uI4rREg43BaPkhuKAlDjGfBkcTU4A&oe=69C14359"}, {"file_name": "screenshot-4_v2.png", "id": "1050360773266784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031417_1050360776600117_7915853884089917557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lceutdfp0-EQ7kNvwFhesDa&_nc_oc=Adpyeolx0aTVJSetLz9I4pst_PbO9uGJhcBD4dbsaMc49-xv4p6p8nsB4qv2XNTkJcA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1X3eWPHEPjiMQqZsEbqkJJeYb7QX5lT-Pg8l4J5rNmA&oe=69C1373F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1191951792116232", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982570_1191951798782898_1277406797779782208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOtZv8ufYjYQ7kNvwHIUGVw&_nc_oc=AdoiTktZQuoTb-zmMDdUZuN1bD0AjHVU6dL0ROWJofI-B2hWS6Zz1_YVw0hmzlp1bA0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyeyWNRUeLkOeFtPoNaZU6QH0ApOLLY2Pm998sQwZVM9A&oe=69C1439C"}, "display_name": "Shotwood Demo", "keywords": ["Shot", "Wood", "ShootWood", "Demo", "Free"], "long_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!\n\n{866219128900813}\n\n# Demo Features\n\nCheck out the awesome Shotwood gunplay with immediate access to some high end weaponry, plus the full practice range and 2 **shoot-house assessments**. Chill out in the home environment. Earn credits by completing runs and challenges, hunting the hidden cash wads, or mastering the ridiculous **Balloon Stabber** minigame. Spend credits on ammo, grenades, and gear - including the awesome **sidearm camera**. Find all the hidden clues to access a **secret demo area**!\n\n{427997739692963}\n\n# Full Game Features\n\nThe full Shotwood experience (not in demo) includes 8 shoot-house assessments with 15 challenges each and 3 modes, 20+ firearms, 9 tactical tools including **kamikaze drones** and the augmented visor, 2 minigame floors, playable arcade cabinet, facility induction process, **progression system**, working grievance booth, big secret area \"beyond the booth\", more **story** to uncover including 120 random announcements, 4 save slots, various difficulty options including **permadeath**, new game plus, and even more!\n\n{2300077013672023}\n\n# Tech Features\n\nShotwood runs at a **smooth 90hz refresh rate**, supports full room scale movement as well as seated play, and offers multiple options for movement, haptics, captions, and whole lot more.\n\nGrab this **FREE** demo right now and... SHOOT SOME WOOD!", "short_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.html", "publisher_name": "Concrete Box", "support_website_url": "https://www.concreteb
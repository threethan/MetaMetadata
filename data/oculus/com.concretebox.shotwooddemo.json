creenshot-5.png", "id": "1923238414795379", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984442_1923238418128712_4769228846090391027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfiibD7Qt5EQ7kNvwEdtu1e&_nc_oc=AdoexOjDkxbQ9vyCbVeBem-UqQ7YvZJyIFLk4hJpLm1MLgZL_oPfQvgPgUN44dssLYo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzMgWlEhjCY8aXpv5eWB0Xkn6GzTLwVncDWv9PmRUDWQ&oe=6A9AC185"}, {"file_name": "equipment-terminal.png", "id": "3958226264503543", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75203624_3958226267836876_1387244605674504322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pga9SxP_dCUQ7kNvwHCM6Vg&_nc_oc=Adpk8ue7QW7CIhJqT45bys8DXUALTv_z6om4DRVRhv-SY9E8Dl0GQQHfJ5fAGhBSRGk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnGrgZXrBtz4kN29GCA8JL1bdOc19-URuq_gI0hjueMw&oe=6A9ACAD9"}, {"file_name": "screenshot-4_v2.png", "id": "1050360773266784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031417_1050360776600117_7915853884089917557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l0IXGFWhAMQ7kNvwEBBsIW&_nc_oc=AdrrAhEaSjBwK-PBM-1CNKfO5OaIiu1eSPe6XeUIiUXxn4bbrTm5VM3hEE30dYkW2gc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkVjtqbDPSLtOyhnmW5rB8SKMpZGL3KHw_GVvKuQqZtw&oe=6A9AF6FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1191951792116232", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982570_1191951798782898_1277406797779782208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqFTpEeucgQQ7kNvwHKFuMG&_nc_oc=AdoGgiGiEE728bbnsQe-sB8OEhAiPhG7jDpewEk_xpmx02yXHJBvl11K6yCbTUCsvf4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK39cXZxkZ2Brc4mYjWSwzvR30py4Q9eG7hBvndUF_dww&oe=6A9ACB1C"}, "display_name": "Shotwood Demo", "keywords": ["Shot", "Wood", "ShootWood", "Demo", "Free"], "long_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!\n\n{866219128900813}\n\n# Demo Features\n\nCheck out the awesome Shotwood gunplay with immediate access to some high end weaponry, plus the full practice range and 2 **shoot-house assessments**. Chill out in the home environment. Earn credits by completing runs and challenges, hunting the hidden cash wads, or mastering the ridiculous **Balloon Stabber** minigame. Spend credits on ammo, grenades, and gear - including the awesome **sidearm camera**. Find all the hidden clues to access a **secret demo area**!\n\n{427997739692963}\n\n# Full Game Features\n\nThe full Shotwood experience (not in demo) includes 8 shoot-house assessments with 15 challenges each and 3 modes, 20+ firearms, 9 tactical tools including **kamikaze drones** and the augmented visor, 2 minigame floors, playable arcade cabinet, facility induction process, **progression system**, working grievance booth, big secret area \"beyond the booth\", more **story** to uncover including 120 random announcements, 4 save slots, various difficulty options including **permadeath**, new game plus, and even more!\n\n{2300077013672023}\n\n# Tech Features\n\nShotwood runs at a **smooth 90hz refresh rate**, supports full room scale movement as well as seated play, and offers multiple options for movement, haptics, captions, and whole lot more.\n\nGrab this **FREE** demo right now and... SHOOT SOME WOOD!", "short_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.ht
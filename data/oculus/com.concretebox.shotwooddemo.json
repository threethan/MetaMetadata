8&_nc_oc=AdlNaNx-9U6Rz38T73ZDDEAJcRlLGkHdigr3qTpuofkC_RI3vud2neCS8qNxKZSQ_lM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftK50POXk03jgCEVjN0vwW0Sr8DbST_eNbjE_Diumr7IQ&oe=699EF305"}, {"file_name": "equipment-terminal.png", "id": "3958226264503543", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75203624_3958226267836876_1387244605674504322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bm7hLvTZcXcQ7kNvwHzz8_e&_nc_oc=AdkZX9EM9w8A4oKbEZ7I52oBBS-BuMIt7-BBtT2OK54AC0Y_ZJ7eNf_DDb3KckC9P0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsNlQtYQiiRm7XNtl_bq8stJBHK7zzYrEDLE413Q_FElQ&oe=699EFC59"}, {"file_name": "screenshot-4_v2.png", "id": "1050360773266784", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031417_1050360776600117_7915853884089917557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIJxyh944GoQ7kNvwEklpjQ&_nc_oc=AdmEKAPdFH-l4-oF7gCKP_cEBnTey3SKw1Ar2PZNKFTwopUw5oq3N33TZCEmFlKIWGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu4liEjnrRX5_gAC8Pzc6rGrGEdff5-4rgzeN0x8TvaHQ&oe=699EF03F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1191951792116232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982570_1191951798782898_1277406797779782208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_ElR0LP_voQ7kNvwHAbYDo&_nc_oc=AdmbMi3XElMzZKENicErXZ1kBNNpMWGVjpN7J0RMiORb-t0R93fbSrxLDhLdkE-H4vU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftOcdvDo2R4PfAy2PYCX796F5FQ7ITvrhGK-Kd79t1UhA&oe=699EFC9C"}, "display_name": "Shotwood Demo", "keywords": ["Shot", "Wood", "ShootWood", "Demo", "Free"], "long_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!\n\n{866219128900813}\n\n# Demo Features\n\nCheck out the awesome Shotwood gunplay with immediate access to some high end weaponry, plus the full practice range and 2 **shoot-house assessments**. Chill out in the home environment. Earn credits by completing runs and challenges, hunting the hidden cash wads, or mastering the ridiculous **Balloon Stabber** minigame. Spend credits on ammo, grenades, and gear - including the awesome **sidearm camera**. Find all the hidden clues to access a **secret demo area**!\n\n{427997739692963}\n\n# Full Game Features\n\nThe full Shotwood experience (not in demo) includes 8 shoot-house assessments with 15 challenges each and 3 modes, 20+ firearms, 9 tactical tools including **kamikaze drones** and the augmented visor, 2 minigame floors, playable arcade cabinet, facility induction process, **progression system**, working grievance booth, big secret area \"beyond the booth\", more **story** to uncover including 120 random announcements, 4 save slots, various difficulty options including **permadeath**, new game plus, and even more!\n\n{2300077013672023}\n\n# Tech Features\n\nShotwood runs at a **smooth 90hz refresh rate**, supports full room scale movement as well as seated play, and offers multiple options for movement, haptics, captions, and whole lot more.\n\nGrab this **FREE** demo right now and... SHOOT SOME WOOD!", "short_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.html", "publisher_name": "Concrete Box", "support_website_url": "https://www.concretebox.net/support.html", "website_url": "https://www.concretebox.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "274332603592
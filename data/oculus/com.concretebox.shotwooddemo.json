creenshot-5.png", "id": "1923238414795379", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38984442_1923238418128712_4769228846090391027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jNrYFa9O9UQ7kNvwEH0LzY&_nc_oc=Adq4hiTTcdrb74PYYrRDde_O1TBcqbNTcnmSjEs_Q77IYj3mi1iyvwDE5I2k9DHdbZ0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERFJ7q8w7A4phzLcbVMLRN3nBgOMnvRhr5JpskFxxqig&oe=6A8AEF85"}, {"file_name": "equipment-terminal.png", "id": "3958226264503543", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75203624_3958226267836876_1387244605674504322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9UuJK-htJoQ7kNvwFbXDNY&_nc_oc=Adqcd-cxdk7Yq2A89b9cbhjUJfu4g7DIhxdM41KHL4xR4tz5hYY3Fd7QLDDbbzjfBs4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdl8fZKVi7RJaMYt9WC1FWUiiguwszG1-mWni5RYYFMg&oe=6A8AC099"}, {"file_name": "screenshot-4_v2.png", "id": "1050360773266784", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031417_1050360776600117_7915853884089917557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G752rm2d2iYQ7kNvwEmQLZJ&_nc_oc=AdoOZF6_MiR-9LsZcUc56lrLpt6NeKGyk9yHSXw4BOhQuVB0ez7PQpLcw9BGoByBdTQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxTt4lI8FrZERS6Fx8fKz0ONNh_44-rYspqxaJE1I4iA&oe=6A8AECBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1191951792116232", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982570_1191951798782898_1277406797779782208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-yL4Z8cRvQQ7kNvwE4Gdgt&_nc_oc=AdoOvIrug1siAs8_T6U8M63ycKHSb6_mhphAK9GRo2xMim9rUgPdU3d7F_ZD-KQwows&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlJ02azX6cO66jPbBS-p9wh4raMYGBTPjZf_054G4a2w&oe=6A8AC0DC"}, "display_name": "Shotwood Demo", "keywords": ["Shot", "Wood", "ShootWood", "Demo", "Free"], "long_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!\n\n{866219128900813}\n\n# Demo Features\n\nCheck out the awesome Shotwood gunplay with immediate access to some high end weaponry, plus the full practice range and 2 **shoot-house assessments**. Chill out in the home environment. Earn credits by completing runs and challenges, hunting the hidden cash wads, or mastering the ridiculous **Balloon Stabber** minigame. Spend credits on ammo, grenades, and gear - including the awesome **sidearm camera**. Find all the hidden clues to access a **secret demo area**!\n\n{427997739692963}\n\n# Full Game Features\n\nThe full Shotwood experience (not in demo) includes 8 shoot-house assessments with 15 challenges each and 3 modes, 20+ firearms, 9 tactical tools including **kamikaze drones** and the augmented visor, 2 minigame floors, playable arcade cabinet, facility induction process, **progression system**, working grievance booth, big secret area \"beyond the booth\", more **story** to uncover including 120 random announcements, 4 save slots, various difficulty options including **permadeath**, new game plus, and even more!\n\n{2300077013672023}\n\n# Tech Features\n\nShotwood runs at a **smooth 90hz refresh rate**, supports full room scale movement as well as seated play, and offers multiple options for movement, haptics, captions, and whole lot more.\n\nGrab this **FREE** demo right now and... SHOOT SOME WOOD!", "short_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.ht
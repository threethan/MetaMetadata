creenshot-5.png", "id": "1923238414795379", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984442_1923238418128712_4769228846090391027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqiQ1lagqFoQ7kNvwF3RI-z&_nc_oc=AdqJjrnacZoQLlctCYsQN0RqhWdqcZV09ARcYZgNdVeQM7oo7iQlrLNnauomoCRnQTA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_P_nBpV_f17DAWlOOjDn-84blIo900ViC7W6tz1XBAw&oe=6ABA6585"}, {"file_name": "equipment-terminal.png", "id": "3958226264503543", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75203624_3958226267836876_1387244605674504322_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjXQWT2Yc6kQ7kNvwHFQ1fx&_nc_oc=AdrQYnUM6E9QVFU3E6o3Q1Kng9zdPl7irjC3XgwWiL1300wqsVLWCiFUbwp6lE1CNMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKOpeIIjmhmI0Q2t6QscrLXD76Nnwr5RcGGftYliBwAQ&oe=6ABA6ED9"}, {"file_name": "screenshot-4_v2.png", "id": "1050360773266784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031417_1050360776600117_7915853884089917557_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FRmLOlrIuoQ7kNvwEd6aCL&_nc_oc=Adr7RexvABa0VYWBLRmQeJ3YXq1SZM0DUvE0BPZU6LDQyXc9Zh6pBg3kqcBKn_j6mCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOTPFWoJdBwSZoxnmVVpxFWm-tM_IM1L_NqzoBgz7W0Q&oe=6ABA62BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1191951792116232", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982570_1191951798782898_1277406797779782208_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXhfHlxhknIQ7kNvwEg2sGq&_nc_oc=AdrNVhfm6NldqDIkY56uYQ2HOPgrwGFGGANiQUmY7sWGqkgf0f8Mh4w1zxzi3IUEAXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINWX3kyTmln64ysa6wt0oV8fD_d3fd_gKQHYCnwDR5zA&oe=6ABA6F1C"}, "display_name": "Shotwood Demo", "keywords": ["Shot", "Wood", "ShootWood", "Demo", "Free"], "long_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!\n\n{866219128900813}\n\n# Demo Features\n\nCheck out the awesome Shotwood gunplay with immediate access to some high end weaponry, plus the full practice range and 2 **shoot-house assessments**. Chill out in the home environment. Earn credits by completing runs and challenges, hunting the hidden cash wads, or mastering the ridiculous **Balloon Stabber** minigame. Spend credits on ammo, grenades, and gear - including the awesome **sidearm camera**. Find all the hidden clues to access a **secret demo area**!\n\n{427997739692963}\n\n# Full Game Features\n\nThe full Shotwood experience (not in demo) includes 8 shoot-house assessments with 15 challenges each and 3 modes, 20+ firearms, 9 tactical tools including **kamikaze drones** and the augmented visor, 2 minigame floors, playable arcade cabinet, facility induction process, **progression system**, working grievance booth, big secret area \"beyond the booth\", more **story** to uncover including 120 random announcements, 4 save slots, various difficulty options including **permadeath**, new game plus, and even more!\n\n{2300077013672023}\n\n# Tech Features\n\nShotwood runs at a **smooth 90hz refresh rate**, supports full room scale movement as well as seated play, and offers multiple options for movement, haptics, captions, and whole lot more.\n\nGrab this **FREE** demo right now and... SHOOT SOME WOOD!", "short_description": "FREE vertical slice demo of Shotwood. Smash deadly wooden targets with realistic firearms & explosives while you try to escape from this ominous, ridiculous, mysterious facility. Shotwood is the casual (yet satisfyingly tactical) shoot-house themed game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.concretebox.net/privacy.html", "developer_terms_of_service_url": "https://www.concretebox.net/terms.ht
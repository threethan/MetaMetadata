uscdn.com/v/t64.5771-25/499618896_735216225917375_1532435367808202754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-tWbfX2umwQ7kNvwGZ8Lpf&_nc_oc=AdmKeQxOmCa5KSRn_o5UYuGlTstZTg5rhGI3TliGjFlUXtX5p6YXDPTCkPMWbfP2ZB0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftXlfzk55CV7ONsv31Z2IAc8gTEXgYY9v6mjP0chJyM0A&oe=69A588AA"}, {"file_name": "ElectricStation_Custom..._24.07.2025_18-06-53.png", "id": "1267377294921132", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619163_1267377301587798_4394042950143461609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQbry4Sp9jUQ7kNvwGYnvb1&_nc_oc=AdnYqwvJU9M6Yrr6UNNyHjE0BNeO7sXUWILzZdXbB_svpNeuIQy4J2mOQ_JzBG_xbqY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afucrrf7bwhfrwd8atrlQKAr4YvAaN-rm5Yo8Yr5K4HFVg&oe=69A57065"}, {"file_name": "DarkPoolRoom_Custom..._24.07.2025_18-04-48.png", "id": "1378769796557352", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307444_1378769799890685_5539753672978896794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9bTW3_kATMQ7kNvwGDx7yM&_nc_oc=AdkHx3LreDTOjoDH72sccbavE5_9dTdQvCXObDZAzWSYs6_pXkrQbkdNqNss_wIYEWo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsm1JWMydD_gMzrgrsUWdbARDhGJ8SbdlXGVwZXwMb5Og&oe=69A57E0A"}, {"file_name": "BackRooms1_Custom..._24.07.2025_18-05-37.png", "id": "9621677827933060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830441_9621677844599725_3930186152962896061_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eo5KnF4cCQQ7kNvwGFSBeL&_nc_oc=AdmUAK146k11pg3w3knEh_NSbyI7pjwYHDE057WI_XUzFpnVkQC56YZx2wH_p-clOCY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvPJ4AFxMYKzQQVwppNI4SKAlNHn10RKCezBVipbPR1QA&oe=69A57B58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Apes 3 Vr", "keywords": ["fa3", "facility", "apes", "fa", "fa2"], "long_description": "In Facility Apes 3, team up with up to 6 players in a fully cooperative VR survival horror experience set in the eerie, shifting world of the A.P.E. universe.\n\nExplore over 23 backrooms-inspired levels, each filled with secrets, environmental hazards, and lurking dangers. These maze-like environments are constantly changing\u2014and surviving them is only possible through strong teamwork and communication.\n\nEvery challenge, puzzle, and threat is designed to be tackled as a team. From opening sealed doors and solving multi-step objectives, to keeping each other sane in the dark\u2014no one survives alone.\nYou'll need to watch each other's backs, share resources, and make life-or-death decisions together.\n\nYour health and sanity are constantly at risk, and falling behind\u2014or dying\u2014can have devastating consequences for the whole group. Only by working together can you uncover the truth behind the facility\u2026 and maybe escape.\n\nTrust your team. Stick together. And whatever you do\u2014don\u2019t die.", "short_description": "In Facility Apes 3, team up in online co-op with up to 6 players to explore the mysterious A.P.E. universe.\nWork together to survive as you roam freely through over 23 backrooms-themed levels, each packed with hidden secrets, deadly traps, and unpredictable threats.\n\nEvery aspect of the game is built around teamwork\u2014from solving puzzles and navigating maze-like environments to staying alive when things go wrong. You\u2019ll need to communicate, cooperate, and rely on each other to make it through."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://unknown-knowledge.com/#privacypolicies5675665436542009", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge", "support_website_url": null, "website_url": "https://unknown-knowledge.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "64435487310671
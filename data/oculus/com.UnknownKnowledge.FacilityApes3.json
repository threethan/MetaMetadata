_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33nzSsBqXPal1Sgz9rAxUM0McMEsVA1LLPB5jxHAgLOA&oe=69DF9844"}, {"file_name": "Corruption_Custom..._24.07.2025_18-06-14.png", "id": "735216219250709", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618896_735216225917375_1532435367808202754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrUxdIT5rIgQ7kNvwGTIW3a&_nc_oc=Adrymn8RpH4TqXpHDIEIdznFkYFv24AyxLYoxJ1TmcjAaEn4yxSEi3F1hwM6gGFIIoU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PraXjLhHNSVdHEOwrYQSnXr9uLzRUrJ8WuyziHBoAqA&oe=69DF8AAA"}, {"file_name": "ElectricStation_Custom..._24.07.2025_18-06-53.png", "id": "1267377294921132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619163_1267377301587798_4394042950143461609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RJDKXuQFooQ7kNvwFjUiy-&_nc_oc=AdrA-u_kYlTGlBL7YztQ6FSWpF5y_sjU7699SxIfZSG196sptscQHNcyCNSEgiqeLeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32Ksdgu3-lOwwE8DjQ8tpAjpRmmR7uzkrlgXnfyPqYcA&oe=69DF7265"}, {"file_name": "DarkPoolRoom_Custom..._24.07.2025_18-04-48.png", "id": "1378769796557352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307444_1378769799890685_5539753672978896794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OU3bsav6NYQ7kNvwH3Mmeh&_nc_oc=AdorT_ZlKWRCblrEySHptSZrbcwILf2LEh6UNVZIh3Pny15pqERrkQBFDFFC1ow0Jr0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nb5RYM2qo4MCoG2ylYMuI3HSxGJ-ad5bcRVdrR3UJmg&oe=69DF800A"}, {"file_name": "BackRooms1_Custom..._24.07.2025_18-05-37.png", "id": "9621677827933060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_9621677844599725_3930186152962896061_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRrM8eD2eXgQ7kNvwGgTWr_&_nc_oc=AdowWU7mip-ud2R1YfFOeLF9P2QVBzSNNDLXRdN27d1bZuWUz22o8rw3MR_PRsoFdmw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2w9HmNLHX8XYj4_KtNmIwu5IMJXTmCYU_D8Sci4Qs74g&oe=69DF7D58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Apes 3 Vr", "keywords": ["fa3", "facility", "apes", "fa", "fa2"], "long_description": "In Facility Apes 3, team up with up to 6 players in a fully cooperative VR survival horror experience set in the eerie, shifting world of the A.P.E. universe.\n\nExplore over 23 backrooms-inspired levels, each filled with secrets, environmental hazards, and lurking dangers. These maze-like environments are constantly changing\u2014and surviving them is only possible through strong teamwork and communication.\n\nEvery challenge, puzzle, and threat is designed to be tackled as a team. From opening sealed doors and solving multi-step objectives, to keeping each other sane in the dark\u2014no one survives alone.\nYou'll need to watch each other's backs, share resources, and make life-or-death decisions together.\n\nYour health and sanity are constantly at risk, and falling behind\u2014or dying\u2014can have devastating consequences for the whole group. Only by working together can you uncover the truth behind the facility\u2026 and maybe escape.\n\nTrust your team. Stick together. And whatever you do\u2014don\u2019t die.", "short_description": "In Facility Apes 3, team up in online co-op with up to 6 players to explore the mysterious A.P.E. universe.\nWork together to survive as you roam freely through over 23 backrooms-themed levels, each packed with hidden secrets, deadly traps, and unpredictable threats.\n\nEvery aspect of the game is built around teamwork\u2014from solving puzzles and navigating maze-like environments to staying alive when things go wrong. You\u2019ll need to communicate, cooperate, and rely on each other to make it through."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://unknown-knowledge.com/#privacypolicies5675665436542009", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge", "support_website_url": null, "we
_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLcKLL-bdabUqC6xrtTWLBzgoczTz72qGxsVV8sMjURA&oe=69C3E8C4"}, {"file_name": "Corruption_Custom..._24.07.2025_18-06-14.png", "id": "735216219250709", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618896_735216225917375_1532435367808202754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qcsz-3Mk6f4Q7kNvwGw0fHN&_nc_oc=Adr8ZVKsjU5Q7vYcvfLnaeU6wgQgg9_ClcYHMyaDJweHjsu409Nn8zj9dj99MotlkBc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWwa5Cy8oUxumWMax22rZcaZjJn64aldfeGSSRkWHjQw&oe=69C3DB2A"}, {"file_name": "ElectricStation_Custom..._24.07.2025_18-06-53.png", "id": "1267377294921132", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619163_1267377301587798_4394042950143461609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGMlAUdxHP4Q7kNvwEDkU7k&_nc_oc=AdoRUrNEgyqSEyzoEO6fUoTxAPf6K9oRos4_ggSA8vPLxoCBevgBgFHeixK6MaSwocE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXkSNmQKYWOGtGnNHHV_NmJMQ32CfJ_RZ_G7rJAV22dw&oe=69C3C2E5"}, {"file_name": "DarkPoolRoom_Custom..._24.07.2025_18-04-48.png", "id": "1378769796557352", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307444_1378769799890685_5539753672978896794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXRoxFayrp8Q7kNvwHgL0V-&_nc_oc=AdrCky1zXtTr2LhOSGyxr66scUVYx-Wh86mhrEd2KHMpblZ6i7B4ynh8ilhk8quESzc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwxu9x4oUZh7VOkoCg5YgDEAbFFoTizkZk_AVdE9rBP3g&oe=69C3D08A"}, {"file_name": "BackRooms1_Custom..._24.07.2025_18-05-37.png", "id": "9621677827933060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830441_9621677844599725_3930186152962896061_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZbfvYLPRRoQ7kNvwFfGsAq&_nc_oc=Adp6bTKxdBTCL202mXm96Ab55kCU-Ecp2sM1Dvqq7nfS1QkSqw_EW12S_hsiUJ_SLAY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2Uf03yngE3feUpIj_ZheFPkb-eVuRlvdzZSFknxIp9Q&oe=69C3CDD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Apes 3 Vr", "keywords": ["fa3", "facility", "apes", "fa", "fa2"], "long_description": "In Facility Apes 3, team up with up to 6 players in a fully cooperative VR survival horror experience set in the eerie, shifting world of the A.P.E. universe.\n\nExplore over 23 backrooms-inspired levels, each filled with secrets, environmental hazards, and lurking dangers. These maze-like environments are constantly changing\u2014and surviving them is only possible through strong teamwork and communication.\n\nEvery challenge, puzzle, and threat is designed to be tackled as a team. From opening sealed doors and solving multi-step objectives, to keeping each other sane in the dark\u2014no one survives alone.\nYou'll need to watch each other's backs, share resources, and make life-or-death decisions together.\n\nYour health and sanity are constantly at risk, and falling behind\u2014or dying\u2014can have devastating consequences for the whole group. Only by working together can you uncover the truth behind the facility\u2026 and maybe escape.\n\nTrust your team. Stick together. And whatever you do\u2014don\u2019t die.", "short_description": "In Facility Apes 3, team up in online co-op with up to 6 players to explore the mysterious A.P.E. universe.\nWork together to survive as you roam freely through over 23 backrooms-themed levels, each packed with hidden secrets, deadly traps, and unpredictable threats.\n\nEvery aspect of the game is built around teamwork\u2014from solving puzzles and navigating maze-like environments to staying alive when things go wrong. You\u2019ll need to communicate, cooperate, and rely on each other to make it through."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://unknown-knowledge.com/#privacypolicies5675665436542009", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge", "support_website_url": null, "we
_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uwYDD5x-W_mRPmRdq8M96d63lCXmB4Vy66XAG9hPlQA&oe=69D65DC4"}, {"file_name": "Corruption_Custom..._24.07.2025_18-06-14.png", "id": "735216219250709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618896_735216225917375_1532435367808202754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBKT3TERs3UQ7kNvwFmqYKW&_nc_oc=Adqv3TcJyW92608Y2Oej4WBY4eDwEc1UzGMFxGKYZ3ZH0fYbifja7AWTvUWvdbKinHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AuV7SM_4mdEiBE9aMKOXWwpNyE0WE0WEVFVBoNU7etw&oe=69D6502A"}, {"file_name": "ElectricStation_Custom..._24.07.2025_18-06-53.png", "id": "1267377294921132", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619163_1267377301587798_4394042950143461609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-4tmtTF1NMQ7kNvwGMOShs&_nc_oc=Ado8YAxzTjR5CLvIll6o0b5nuyeNDFgBPAYPAXZxjv58gRoSqPJ-CaxAQEnAsMRPsIk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DbiSEsi8T6F5sbRUQ6hFIfaMPsoynL1yJbNgcDfOxuQ&oe=69D637E5"}, {"file_name": "DarkPoolRoom_Custom..._24.07.2025_18-04-48.png", "id": "1378769796557352", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307444_1378769799890685_5539753672978896794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mc4NYsuGoXcQ7kNvwHZb6qe&_nc_oc=Adqz13kDLrfBV2g7DGZVv9Q1Q199JepTeBIsDbxjQiAKR0V6tVpzZGNgeUoOpvhfIBc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2F4KCAzQ_51D7o63DduJRuCjwXQVxuEZTyLiKSVzab0g&oe=69D6458A"}, {"file_name": "BackRooms1_Custom..._24.07.2025_18-05-37.png", "id": "9621677827933060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830441_9621677844599725_3930186152962896061_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HY4zyUMjA0MQ7kNvwH7Vn7W&_nc_oc=AdqkBUgCeUXDiXON2rI1sTin9q43ODbcy8inoPwXZT3AaMJNvd8RLEQsfkUxmWJ4_Ho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2umw8JUVx6NNq4otzdIs8j--daiDQzcPnuWRpN_z00Rg&oe=69D642D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Apes 3 Vr", "keywords": ["fa3", "facility", "apes", "fa", "fa2"], "long_description": "In Facility Apes 3, team up with up to 6 players in a fully cooperative VR survival horror experience set in the eerie, shifting world of the A.P.E. universe.\n\nExplore over 23 backrooms-inspired levels, each filled with secrets, environmental hazards, and lurking dangers. These maze-like environments are constantly changing\u2014and surviving them is only possible through strong teamwork and communication.\n\nEvery challenge, puzzle, and threat is designed to be tackled as a team. From opening sealed doors and solving multi-step objectives, to keeping each other sane in the dark\u2014no one survives alone.\nYou'll need to watch each other's backs, share resources, and make life-or-death decisions together.\n\nYour health and sanity are constantly at risk, and falling behind\u2014or dying\u2014can have devastating consequences for the whole group. Only by working together can you uncover the truth behind the facility\u2026 and maybe escape.\n\nTrust your team. Stick together. And whatever you do\u2014don\u2019t die.", "short_description": "In Facility Apes 3, team up in online co-op with up to 6 players to explore the mysterious A.P.E. universe.\nWork together to survive as you roam freely through over 23 backrooms-themed levels, each packed with hidden secrets, deadly traps, and unpredictable threats.\n\nEvery aspect of the game is built around teamwork\u2014from solving puzzles and navigating maze-like environments to staying alive when things go wrong. You\u2019ll need to communicate, cooperate, and rely on each other to make it through."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://unknown-knowledge.com/#privacypolicies5675665436542009", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge", "support_website_url": null, "we
uscdn.com/v/t64.5771-25/499618896_735216225917375_1532435367808202754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-tWbfX2umwQ7kNvwGDT8mK&_nc_oc=AdlBVGUiR-8UOANb_WvDOENjrTSmgyPqDKgIU2BcKK9R-A_SvH2GoEKheTX00F69pgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfspqnpxBl4hXsd3rY76trQEyd6M6Sc_u5MsSpMSyPrLuw&oe=69A4372A"}, {"file_name": "ElectricStation_Custom..._24.07.2025_18-06-53.png", "id": "1267377294921132", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619163_1267377301587798_4394042950143461609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBugdOwLXH4Q7kNvwGIl1re&_nc_oc=AdnQzFBxFDDzc_TkP0cQYFWla0SGVG4Z-VIg6tngGys6FxEUbf-IqTRmDdEQTdl8Z_E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfteAmLqp7WJVYi7jvvBONjamduav76tY47MnQ-Mo_ZJfg&oe=69A41EE5"}, {"file_name": "DarkPoolRoom_Custom..._24.07.2025_18-04-48.png", "id": "1378769796557352", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307444_1378769799890685_5539753672978896794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9bTW3_kATMQ7kNvwE7oDFT&_nc_oc=Adm3N2s9Xs7l1rFKwtnD82x5F1lBenGdFGIJwOfAj6qI2Jj85afsen0uDvzHXZ9GUzo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuXisfTBB_IEy6akAl3UcfMClt88FNjNtGD375vUJ4Z8g&oe=69A42C8A"}, {"file_name": "BackRooms1_Custom..._24.07.2025_18-05-37.png", "id": "9621677827933060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_9621677844599725_3930186152962896061_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eo5KnF4cCQQ7kNvwF4ckMY&_nc_oc=AdkZ7dQnlda02oy850DbI_VjE4CRaUnUOGlGCmZGTHr6D5aThIBxcZY2NTWeDwLOIWE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvDgCLn04JiczR9rAvEhuT-KXyRldd-SF86hpmLL2olcg&oe=69A429D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Apes 3 Vr", "keywords": ["fa3", "facility", "apes", "fa", "fa2"], "long_description": "In Facility Apes 3, team up with up to 6 players in a fully cooperative VR survival horror experience set in the eerie, shifting world of the A.P.E. universe.\n\nExplore over 23 backrooms-inspired levels, each filled with secrets, environmental hazards, and lurking dangers. These maze-like environments are constantly changing\u2014and surviving them is only possible through strong teamwork and communication.\n\nEvery challenge, puzzle, and threat is designed to be tackled as a team. From opening sealed doors and solving multi-step objectives, to keeping each other sane in the dark\u2014no one survives alone.\nYou'll need to watch each other's backs, share resources, and make life-or-death decisions together.\n\nYour health and sanity are constantly at risk, and falling behind\u2014or dying\u2014can have devastating consequences for the whole group. Only by working together can you uncover the truth behind the facility\u2026 and maybe escape.\n\nTrust your team. Stick together. And whatever you do\u2014don\u2019t die.", "short_description": "In Facility Apes 3, team up in online co-op with up to 6 players to explore the mysterious A.P.E. universe.\nWork together to survive as you roam freely through over 23 backrooms-themed levels, each packed with hidden secrets, deadly traps, and unpredictable threats.\n\nEvery aspect of the game is built around teamwork\u2014from solving puzzles and navigating maze-like environments to staying alive when things go wrong. You\u2019ll need to communicate, cooperate, and rely on each other to make it through."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://unknown-knowledge.com/#privacypolicies5675665436542009", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge", "support_website_url": null, "website_url": "https://unknown-knowledge.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "64435487310671
_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yRqHjXK7UM1L_szWmVmGJq8gye5PX2V_fmuk9ro--Gw&oe=69F35EC4"}, {"file_name": "Corruption_Custom..._24.07.2025_18-06-14.png", "id": "735216219250709", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618896_735216225917375_1532435367808202754_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kAullsgPwIQ7kNvwEFOrM_&_nc_oc=AdouQiZyZ2d-rYygqF12A2ECeCFSQzCk6qZgQAvq8j-dMe1r_cJTMO2bLXFeD5L8yEE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0EfvBHFv31RCnU9gMU0Zsy-Ur2VuvrhX1Zonh8ssYl2w&oe=69F3512A"}, {"file_name": "ElectricStation_Custom..._24.07.2025_18-06-53.png", "id": "1267377294921132", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619163_1267377301587798_4394042950143461609_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EckfAuobUIUQ7kNvwFTWEo2&_nc_oc=AdpqlXkC1mdJhM8tHK3LO34XNbCp3iwdfVwKfmP1iNYjKhws-AdG5JAbieGW1SKDZC8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cFxB8icuxVYhj9-1RVaefNhCauWRaFUPII0qNJirQZQ&oe=69F37125"}, {"file_name": "DarkPoolRoom_Custom..._24.07.2025_18-04-48.png", "id": "1378769796557352", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307444_1378769799890685_5539753672978896794_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yda5RYhF5IQ7kNvwHLh5AY&_nc_oc=AdqL5A2_L81Soqa91-x3hXmDN_tusvzDlq3cEDZ7CoTgZhe-MZJH0V9P77O-cce7QIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FofDMBvP9sLIElX-aB_OdPRnjaqJ_XlsawM8_0WuMrA&oe=69F3468A"}, {"file_name": "BackRooms1_Custom..._24.07.2025_18-05-37.png", "id": "9621677827933060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830441_9621677844599725_3930186152962896061_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4YF8OeTVTIQ7kNvwE-aLpj&_nc_oc=Adq9SJQEtdpC4itagA-wihulzkDxhi_Ur1X5b4IwePR5iMTFOJ1zNWCTOtJDvxQu4EM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FQtdX1TzkQNVXx5SRn4L6O8I1KijstnCSENGlMPClZQ&oe=69F343D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Facility Apes 3 Vr", "keywords": ["fa3", "facility", "apes", "fa", "fa2"], "long_description": "In Facility Apes 3, team up with up to 6 players in a fully cooperative VR survival horror experience set in the eerie, shifting world of the A.P.E. universe.\n\nExplore over 23 backrooms-inspired levels, each filled with secrets, environmental hazards, and lurking dangers. These maze-like environments are constantly changing\u2014and surviving them is only possible through strong teamwork and communication.\n\nEvery challenge, puzzle, and threat is designed to be tackled as a team. From opening sealed doors and solving multi-step objectives, to keeping each other sane in the dark\u2014no one survives alone.\nYou'll need to watch each other's backs, share resources, and make life-or-death decisions together.\n\nYour health and sanity are constantly at risk, and falling behind\u2014or dying\u2014can have devastating consequences for the whole group. Only by working together can you uncover the truth behind the facility\u2026 and maybe escape.\n\nTrust your team. Stick together. And whatever you do\u2014don\u2019t die.", "short_description": "In Facility Apes 3, team up in online co-op with up to 6 players to explore the mysterious A.P.E. universe.\nWork together to survive as you roam freely through over 23 backrooms-themed levels, each packed with hidden secrets, deadly traps, and unpredictable threats.\n\nEvery aspect of the game is built around teamwork\u2014from solving puzzles and navigating maze-like environments to staying alive when things go wrong. You\u2019ll need to communicate, cooperate, and rely on each other to make it through."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://unknown-knowledge.com/#privacypolicies5675665436542009", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge", "support_website_url": null, "we
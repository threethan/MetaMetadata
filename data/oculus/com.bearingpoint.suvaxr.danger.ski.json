gFpepUzDR070CBsI7P5BYm7VpIYrdtyOwmCf_o0Vl6bNoSfIjFTXJ3cYoPZAy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXA-irj83lgiwxHfhxKeNEBcFPEe1spH_VxZWZ9IUjKA&oe=6B09989F"}, {"file_name": "ExchangeSkies2026-04-15_11-22-49.png", "id": "1671229864194634", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823279_1671229867527967_7812831820935414945_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q1M-fMFvxgQ7kNvwHrjW6b&_nc_oc=AdpQYqQhWYFT2mdAvcUeGgt6sGyDZlIcwqCiQoYQ_tkJfFwM1hyA7BOeE8Qhyb_wT0U&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRboxMEE51qblF0JyPZ9zHq4ilaGai-bk6-GzQou_yP5w&oe=6B09CE32"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Swiss Safety VR: Snow sports", "keywords": ["Ski", "Accident", "Safety", "Snowboard"], "long_description": "Immerse yourself in a new dimension of snow sports safety with this highly immersive training program on FIS rules for skiers and snowboarders! Sharpen your risk awareness in typical hazardous situations on the virtual ski slope and experience firsthand how you can prevent accidents through careful and considerate behavior.\n\nThis learning module teaches winter sports safety in a practical, engaging way\u2014and completely risk-free. Start your personal safety training so you can enjoy your days on the slopes with confidence. Can you earn all the snowflakes by making the right decisions?", "short_description": "Practice safe behavior on the virtual slopes using the FIS rules. Sharpen your risk awareness and learn how to prevent accidents by skiing or snowboarding cautiously. "}, {"images": {"nodes": [{"file_name": "HeroCover.png", "id": "2401638593675517", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824741_2401638603675516_7974573436289791455_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJrsOcR07N8Q7kNvwHMlrH5&_nc_oc=Adp33a2JLivtwR1K7aMJ7nfmawa
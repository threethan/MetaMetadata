F0D"}, {"file_name": "SS4.png", "id": "526279853021815", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982642_526279856355148_3030454436123846930_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_0GRJYMKuIQ7kNvwFgo5GT&_nc_oc=AdrtQtlPJX4r2r2MR_Io8M8bFsOeyQDvj9x9-ywif_ajRDN7pD6exGcmiWEnlLN2svk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g6XgMqz9GG6ZJE6kpTKd0U8IwdEFwf7DNHA55izWYsg&oe=6A466559"}, {"file_name": "SS5.png", "id": "1812486589168073", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974758_1812486592501406_7879835244810546459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoqdoDhokz4Q7kNvwGm-yGY&_nc_oc=AdqwAcnQONHejfUDncpQQIhtk02aAe34AKMiwNkL11_IHHRsvmSPbmq3MlWbDvOkVN4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YItC10omwTGQuRDRFJZiBmXe1gVCYeSZgqKo5sencyg&oe=6A46765C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "173303908883088", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57566698_173303912216421_578228095664584610_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jElPcuwaHfsQ7kNvwE9zmQo&_nc_oc=AdrBKYxPEa0__cGuiT8HzmUDCz7QiDZljL2Otoz924Z3QDSEabG4S4zvGbtpNtaMSNw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-98teBIWHNndR1-VppZQcM3udiqIwQNR27DYS9XPICw&oe=6A4667C8"}, "display_name": "Nano Force - Early Alpha", "keywords": [], "long_description": "Get ready for some paint-splattering, adrenaline-pumping action in this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!", "short_description": "Get ready for some paint-splattering, adrenaline-pumping action in this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1UCJTcG9bjXxyAPVJ62DqZzAM1eobgXpWWsKchGMShus/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Deep Technologies Inc", "support_website_url": null, "website_url": "https://sidequestvr.com/app/14468", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25941794282085605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974522_746888170224333_6495478242466476911_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9r8lCEIfZAIQ7kNvwF9DpgZ&_nc_oc=AdqQj9SkmzTniHnxNW04VlsoJ1-kUxdl61u3E9liWL_QF7AcOu5_h8jGtOXMcBYQ7KI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pOk6F-uQBcK-Gk6djTepQ6iQX8uaURDzhDYQGtp5mKg&oe=6A466190"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano Force - Early Alpha", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [
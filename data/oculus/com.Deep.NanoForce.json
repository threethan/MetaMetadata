68D"}, {"file_name": "SS4.png", "id": "526279853021815", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982642_526279856355148_3030454436123846930_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ3m_LnrZ4kQ7kNvwFs5qxj&_nc_oc=AdrImOIH2ew2pZEewLABkbHG9TV4y642Hf1o-17M5hNf_se2TgwAmHsYObMhpfUPn6w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dFC5_qomhg1dV6PhuGc3y_-bXABGZrVPAr9IXhBcZSg&oe=6A22CCD9"}, {"file_name": "SS5.png", "id": "1812486589168073", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974758_1812486592501406_7879835244810546459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kg-GwhmLfwYQ7kNvwFNKSfm&_nc_oc=AdrOO2RQnxUMlisnBsDfa0ai8lTo13ybxKArgSju-sUSwT1c_VWPZg5BY2hYGjPPNJc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OZBiQfzvEn5L6NSSSwYH001eG9eHWb0QK21uCyMI1_A&oe=6A22DDDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "173303908883088", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57566698_173303912216421_578228095664584610_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mCMit7N_L0Q7kNvwFqhtMR&_nc_oc=Adp7eW5ccf0VO3pf2yMnphM0SRaY40NcCKL0dgu82heNAD2qSmn-kCWXgHYFRJ1cIvA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_l69LIDwSX-VfypfOJfhU-awBOt7adFm186ByCqC2OLg&oe=6A22CF48"}, "display_name": "Nano Force - Early Alpha", "keywords": [], "long_description": "Get ready for some paint-splattering, adrenaline-pumping action in this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!", "short_description": "Get ready for some paint-splattering, adrenaline-pumping action in this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1UCJTcG9bjXxyAPVJ62DqZzAM1eobgXpWWsKchGMShus/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Deep Technologies Inc", "support_website_url": null, "website_url": "https://sidequestvr.com/app/14468", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25941794282085605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974522_746888170224333_6495478242466476911_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6wagjXKB08Q7kNvwGePq4T&_nc_oc=AdrtwSgmUk1EWlrfc4Xv67nOvhXCO6_M4s3woHjsAGbZOYwni-3rO5NGnobj9g7isNg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ms43yAy2d0_y5A0qMUlfPHxp-guzXxKyKod_uvoEahg&oe=6A230150"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano Force - Early Alpha", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [
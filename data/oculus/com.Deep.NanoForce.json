00D"}, {"file_name": "SS4.png", "id": "526279853021815", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982642_526279856355148_3030454436123846930_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dVUP39Bz9QAQ7kNvwGrz-YY&_nc_oc=AdqAEOcoU3PFyPI-4FoHYaWEe3U__8MOIIjtDydUwPlw4OZf9Le-MNqzcTE7gDDIfK0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fcHnWx0fwepTWoXJ11YuQv_7-Jb9dJaVXpdI3ynu5Vw&oe=6A393659"}, {"file_name": "SS5.png", "id": "1812486589168073", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974758_1812486592501406_7879835244810546459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gg7FkN1h8AQ7kNvwF9OWHj&_nc_oc=Adql-lHmAMdQEvV1o6gdSaqQRlOP9KC2FZOGzba-p8x27OGosesRrx1E6-YBrnuGh9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J-HNaILNeGuhaTR1pShiGL2WmT532qI8i9FZUDekRXg&oe=6A39475C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "173303908883088", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57566698_173303912216421_578228095664584610_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GHRu-9bfqYQ7kNvwENotHU&_nc_oc=AdrxyBxRP0TALImo-GYNO8JE-K-3vipNlwFlq-0PQwsPb0CZe7YKi5U9PemQrwcWUEg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hTTPFgXIeg2_yB1KuroKVtDlgkoP7XpPQJOcQsiu81g&oe=6A3938C8"}, "display_name": "Nano Force - Early Alpha", "keywords": [], "long_description": "Get ready for some paint-splattering, adrenaline-pumping action in this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!", "short_description": "Get ready for some paint-splattering, adrenaline-pumping action in this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1UCJTcG9bjXxyAPVJ62DqZzAM1eobgXpWWsKchGMShus/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Deep Technologies Inc", "support_website_url": null, "website_url": "https://sidequestvr.com/app/14468", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25941794282085605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974522_746888170224333_6495478242466476911_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_XAkaejy4cQ7kNvwFSy0SG&_nc_oc=AdraOHJXVoxW50CnSHq-paonrYFnE1JCCy3h4TIBBQqls2CjUIYNuT6x7Zv1KZbkW5g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3FazimPO0l_v1DK70CSY-V4eC-OP_Qsxlaud31ZhhYA&oe=6A393290"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano Force - Early Alpha", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [
F8D"}, {"file_name": "SS4.png", "id": "526279853021815", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982642_526279856355148_3030454436123846930_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy7271YnWBoQ7kNvwEMrmH2&_nc_oc=AdqvEsO6NiNouEhR_1ZAYO1xz5wmyNNMtg8wZ6u8_RJ5RWo0AP79wdzTDCxwUneRt1g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL8OtJb_j3-E4_TdQNWZyZqis4GLG_FHTshhMhMuJiQg&oe=6AA945D9"}, {"file_name": "SS5.png", "id": "1812486589168073", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974758_1812486592501406_7879835244810546459_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q_wM95ubyBIQ7kNvwExF-mU&_nc_oc=AdqMRBpkuCnUKCc2UIfxnpulqNlfufDTgNvaHeuuGrEC1wvJycr9CqUHn-3STvBUD3o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf-5ek2ssXss65IQN4hd_xcUGUGeAa4JJ36JbXCwYGiw&oe=6AA956DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "173303908883088", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57566698_173303912216421_578228095664584610_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMKKB0MBOAoQ7kNvwFLh3SL&_nc_oc=Adr5-SMPf7bNUghkYDZlSMQu6fGrDZLfjWf2upqox4hrleQ_uS2Jzq-XaN2-mHAzCBo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjzNJBoupxkf085HqFrVCUxqLrmaCO2LIV7Ucr6wdV3Q&oe=6AA94848"}, "display_name": "Nano Force - Early Alpha", "keywords": [], "long_description": "Get ready for some paint-splattering, adrenaline-pumping action in this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!", "short_description": "Get ready for some paint-splattering, adrenaline-pumping action in this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1UCJTcG9bjXxyAPVJ62DqZzAM1eobgXpWWsKchGMShus/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Deep Technologies Inc", "support_website_url": null, "website_url": "https://sidequestvr.com/app/14468", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25941794282085605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974522_746888170224333_6495478242466476911_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKfOEoh28gQQ7kNvwFFOVNW&_nc_oc=AdqtApwkOpTtbr9uWyWF0Ht_Hahjvk5KcdUVtFiD03MskRnW3QJELkAhJgahz9DbcOU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDZRaaGPcHvIVUDeHKZxY705f2fHXud5zXF36kOUc71g&oe=6AA94210"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano Force - Early Alpha", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [
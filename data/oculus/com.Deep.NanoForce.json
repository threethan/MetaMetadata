n this color-filled multiplayer first-person shooter!\n\nBlast goo and cover the playing field in your team's color before time runs out, all without getting soaked by enemy fire.  Whether you're a casual or competitive player, come join the messy, colorful fun and shoot your way to victory.\n\nPlay with friends or make new ones and experience the ultimate thrill of this paint-based FPS game!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1UCJTcG9bjXxyAPVJ62DqZzAM1eobgXpWWsKchGMShus/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Deep Technologies Inc", "support_website_url": null, "website_url": "https://sidequestvr.com/app/14468", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25941794282085605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974522_746888170224333_6495478242466476911_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnvhjafX7lwQ7kNvwHeXaic&_nc_oc=AdoC00mQnR98DmiMfzHzWiBCx_YDhKEHMYKTR0iLILJSFrAut_GBCreuhUIf9Q1TaeI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj5TNtDAFRIK66K_Im02YWsFUiAOF8_-Sn5lXOu3twOw&oe=6A8EE410"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Nano Force - Early Alpha", "platform": "ANDROID_6DOF", "context_category": null, "contex
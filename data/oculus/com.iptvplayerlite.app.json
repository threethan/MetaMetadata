632222599855_5347857928395650445_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZVVc-rjus4Q7kNvwGj8NYR&_nc_oc=Adrs22_beIp05VVac4VHE5k6xbxUKfOJkVSx-Q4-u-ObJjl7A9lEJwMD-n05Ozd8D9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL3wqqgIspZ3hTAzCXaKXOd6qtGjCV6y-cYBUdLuAcsw&oe=6AB7CE5D"}, {"file_name": "ss3.png", "id": "1632772967854302", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821115_1632772971187635_7031552636561219361_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOLp7Wz4FXcQ7kNvwHO8_He&_nc_oc=Adq3WTXLd97cznQjg1vwMu9oA92_Q1uNVYXLukfEZJDVgSa13HUN5_vCmx9vO8cSTrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsn75x35SwSSNoEUBtHgYDS6CbsRMesNYNHuuVL-MGbA&oe=6AB7EB0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IPTV Player Lite", "keywords": ["IPTV", "M3U", "streaming", "player", "video"], "long_description": "Manage and play M3U playlists quickly and intuitively. Import local M3U files or remote URLs, organize channels into categories, search and filter by name or group, save favorites for instant access, and export updated playlists. The built\u2011in player supports HLS and HTTP streams, fullscreen and background playback, and handles multiple audio/subtitle tracks when provided by the source.\n\nLegal disclaimer: This app DOES NOT provide video content or host streams. The app only manages and plays URLs and playlists supplied by users or third\u2011party sources. Users are solely responsible for the links they add or import (including compliance with copyright and local regulations). We assume no responsibility for illegal, unauthorized or copyrighted content accessible via external URLs.\n\nKey features\n\nImport: Local M3U files and remote URLs.\nOrganize: Categories, folders and favorites.\nPlay: HLS/HTTP support, fullscreen and background playback.\nSearch & Filter: Find channels by name, group or URL.\nReliability: Detect broken links and refresh playlists.\nExport: Save and export updated playlists.", "short_description": "Manage M3U playlists and play video streams easily."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.extremewebdesign.it/app/iptv_player/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Extreme Wed Design", "support_website_url": null, "website_url": "https://www.extremewebdesign.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25787909144236821"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25737196372617724"}]}, "baseline_offer": {"id": "25737196372617724"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772608860, "status": "PUBLISHED", "id": "25737196372617724"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25787986080895794", "version": "1.0.1"}, "id": "1306531604643864", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25751593524535050", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25787986080895794"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE",
 VR is a chaotic co-op VR brawler where physics-based combat takes center stage. Fight your friends, knock opponents out of the arena, and be the last player standing!"}]}, "developer_name": "Madden", "developer_privacy_policy_url": "https://sites.google.com/view/riotvr/home", "developer_terms_of_service_url": null, "publisher_name": "Madden", "support_website_url": null, "website_url": "https://sites.google.com/view/riotvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1414134890563187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311582_1749025516543259_8510833406562407042_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZV4DlxcQwIQ7kNvwE6Tf9C&_nc_oc=AdofjBqlduBxMErioWstslKtgEufrUwqIFsHfFm8ZFF3GGFI2-gsfFa_YdcVNSaSq84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKNJsUHbVopKONQmYJBZ9ErHIQVFSvS7MsjrtLnX90PA&oe=6AFF07D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Riot", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Platformer", "id": "
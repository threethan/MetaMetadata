uahw&oe=6ABBC7F3"}, {"file_name": "render_volcano.png", "id": "1732363051417212", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507894088_1732363054750545_5920854348734163005_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dCUn_RHxewsQ7kNvwG_4596&_nc_oc=AdrKwiLVk3f7MAOhK16okICISrpYe_-gufNpKpgz7wJLQvU4NdARWOLNDazf8btBJTs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwdGTCK861RENvlpxqOVdd1m25ffxoSxUmFCOtIyjtog&oe=6ABBCBD1"}, {"file_name": "render_cube.png", "id": "1614936956865595", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310667_1614936960198928_6584050074377488560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH_5GLpKLdsQ7kNvwEhvtfs&_nc_oc=Adr8pGiPUwx89owLm0UO7zAKPG8N_sRKfDHUBPEDzd6xR1CQv6fl7Zjko0mynerJ2mY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImHsSfDkNj9VSGFF2HjfZBH-__U5VwU1MrRvJAqQMdBQ&oe=6ABBCD74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Riot", "keywords": ["Fighting", "PVP"], "long_description": "Riot VR is a fun and chaotic co-op VR game where physics-based combat creates nonstop action and unforgettable moments. Jump into exciting arenas with your friends and battle it out using punches, grabs, throws, and clever strategies to become the ultimate champion.\n\nEvery match is unpredictable as you push opponents off the map, survive intense battles, and create hilarious moments along the way. Whether you're competing against friends, mastering your skills, or climbing to victory, Riot VR delivers fast-paced multiplayer action, endless laughs, and exciting physics-driven gameplay.", "short_description": "Riot VR is a chaotic co-op VR brawler where physics-based combat takes center stage. Fight your friends, knock opponents out of the arena, and be the last player standing!"}]}, "developer_name": "Madden", "developer_privacy_policy_url": "https://sites.google.com/view/riotvr/home", "developer_terms_of_service_url": null, "publisher_name": "M
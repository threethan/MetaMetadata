 VR is a chaotic co-op VR brawler where physics-based combat takes center stage. Fight your friends, knock opponents out of the arena, and be the last player standing!"}]}, "developer_name": "Madden", "developer_privacy_policy_url": "https://sites.google.com/view/riotvr/home", "developer_terms_of_service_url": null, "publisher_name": "Madden", "support_website_url": null, "website_url": "https://sites.google.com/view/riotvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1414134890563187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499311582_1749025516543259_8510833406562407042_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBJN1lGNM8YQ7kNvwF_mPg7&_nc_oc=Adr0h5MPbCpYfPLKh8jEK3wzz5ZyzaLaFtnMSWPXwx3RHtxPJAW0q_5r-WwvICd6ZHg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbEwXwLbIdZ8vLnGLPKhSg-HWZljVzlGgX5sXBmlNRuA&oe=6AFB4B92"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Riot", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Platformer", "id": "
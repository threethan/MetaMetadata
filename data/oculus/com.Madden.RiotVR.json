0565_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQzH9seQiS4Q7kNvwEqW4xY&_nc_oc=AdqOvXVdZmaVuXYA-UoYqXUlCAIXRDDKuoaOQK_8HF4WL5h8iLwZG-8598ctYT_ASW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY8v_g2AGz-KVvPQ83CbAJBQdAbXJdl_h5WP2HeZPmxg&oe=6B05D433"}, {"file_name": "render_volcano.png", "id": "1732363051417212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507894088_1732363054750545_5920854348734163005_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlX6vMlIkmEQ7kNvwHF5agq&_nc_oc=Adon7ZmFRdlmUtWoCBG4oUzGFJJz2-rA9nbRvUYGO05qTjjnQNjnRkJOWsPIhofKplw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEBWVGU_zjvMJfG4iw80_zeAVi0NRwfj7KUKPCOJmerQ&oe=6B05D811"}, {"file_name": "render_cube.png", "id": "1614936956865595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1614936960198928_6584050074377488560_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXwTahBFiNEQ7kNvwGCJFGA&_nc_oc=AdojLoHM0YlDSQBpHyCgTjLwLLb05Sn6XEPdW2VwDx2WCDLC5rRVDaRFmKd6x1WDqvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWcj8h8T4kLX02t60x9rk5ZW_3C_Cuh8NgZgLToaWyow&oe=6B05A174"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Riot", "keywords": ["Fighting", "PVP"], "long_description": "Riot VR is a fun and chaotic co-op VR game where physics-based combat creates nonstop action and unforgettable moments. Jump into exciting arenas with your friends and battle it out using punches, grabs, throws, and clever strategies to become the ultimate champion.\n\nEvery match is unpredictable as you push opponents off the map, survive intense battles, and create hilarious moments along the way. Whether you're competing against friends, mastering your skills, or climbing to victory, Riot VR delivers fast-paced multiplayer action, endless laughs, and exciting physics-driven gameplay.", "short_description": "Riot VR is a chaotic co-op VR brawler where physics-based combat takes center stage. Fight your friends, knock opponents out of the arena, and be the last player standing!"}]}, "developer_name": "Madden", "developer_privacy_policy_url": "https://sites.google.com/view/riotvr/home", "developer_terms_of_service_url": null, "publisher_name": "Madden", "support_website_url": null, "website_url": "https://sites.google.com/view/riotvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1414134890563187"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311582_1749025516543259_8510833406562407042_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOIZ2mYso18Q7kNvwGb2tUw&_nc_oc=AdryhIgRCiIs5tec-72qaItyehWAvRNc0OQ1u0HxJoYmffcxoucK7fHg_5mLDlqZ-B4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbJqCR-D2F9UBAelST_cu2bKHOrVXrT6lhI6wESbWeBA&oe=6B05D792"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Riot", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Platformer", "id": "
_name": "9.png", "id": "1246456381019280", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830822_1246456387685946_7731620433663246340_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYc5A5hwnKAQ7kNvwE06E58&_nc_oc=AdrEr24L0UQNVQa-Hm2Nadgpd6O5SVJ2pv8U6QOYpTIAw1E47W4ZsVYHQtH1Kt4Mbw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVuugdJb6oxMh9JyyiwAkk5HotX06fzAfaAm78ApaeKOw&oe=6B1050EA"}]}, "id": "1167903538998631", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1763155884971546", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_1763155888304879_1209957046765274350_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrTP8IP-xLUQ7kNvwG7xloi&_nc_oc=AdoFmQpMS2haAVmUlh2hHE7brsf7kFSQnv8PCtyVzfQyr671pMXgDsfg_B4Shmkw7fQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1QfEF365Lm2l1RZD8qKRrR-Ht3MenIiWCrz5dF71UWQ&oe=6B105DA9"}, {"file_name": "3.png", "id": "2660792911001751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303116_2660792914335084_8109323970374251934_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjXZMgb9eEgQ7kNvwGF4YMu&_nc_oc=Adooqr1_hpB4C2nszinHr4EhJMCQgxqlX4HPgz25pIUzb8I3Ga5qAtIdUh3wdGUzMU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIvtTgtSDWX6XlN_SeFjBK6x0yYqDnnpkaEnelPQVsUw&oe=6B10626C"}, {"file_name": "5.png", "id": "925516563772673", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312310_925516567106006_2138199604713965596_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qGdlei13AEQ7kNvwFbyxgJ&_nc_oc=AdqJjKXNMnMA3tMZr7NXME0cwUjDCTGZ12akRlPWNp-TnXiU__bhrVUecYT7bgw2TJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVEkALPyrYofLWUYAZJV9uo_TOYjlyvcWysDfe4OIpwoQ&oe=6B1037A7"}, {"file_name": "6.png", "id": "1123750956855900", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314623_1123750963522566_8040415741317048374_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANBcHB1ZdYgQ7kNvwHCsUL_&_nc_oc=Adq4dwvHdwFsgt_eeX3SEtVfj5sPPomYjkwgXVLqM8NHZHQx0cu-Q3wWPz0cksmX7Ro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxyAILlS8c3SFGcmMa-ZTaRX3ySlwuvPmKbgFP7hXCRg&oe=6B104FB0"}, {"file_name": "2.png", "id": "1671352701444614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303471_1671352704777947_4056999304490330198_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOAvSkXIuNwQ7kNvwEC_4fx&_nc_oc=Adp1-tGUnLwx0vmDU8aH_cTHqRwAd2_PoJb1jlmbevsSAKaYDn-pJuAh-z3WQy55qO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWnlVWOUOicZR46Hvat-3PCfjKno__CrT4iqgrnjD0SaQ&oe=6B106814"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Offroad Taxi Simulator VR", "keywords": [], "long_description": "Your taxi. Your mountain. Your rules.\n\nStep into the driver's seat of a mountain-based VR taxi simulator where every fare is a fight against the terrain. Log into your ride dispatch system, review incoming requests, and choose which rides to accept \u2014 or decline the ones that aren't worth the trip.\n\nCore Gameplay\n\nAccept or decline incoming ride requests through an in-cab dispatch interface\nNavigate off-road mountain routes \u2014 gravel switchbacks, loose rock, narrow cliffside roads, and steep grades\nPick up passengers at marked locations and drive them safely to their destination\nManage fuel, vehicle condition, and drive time as you build your route\nEarn fares and grow your reputation as a mountain taxi driver\n\nBuilt for VR\nEvery control lives in the cab with you \u2014 steering wheel, dispatch tablet, gear shifter \u2014 for a hands-on, seated or standing driving experience. Terrain reacts to your driving line, so momentum, grip, and vehicle weight all matter on the way down the mountain.\n\nWhy Drivers Keep Coming Back\nNo two rides play the same. Weather, road damage, and passenger requests change the pressure on every trip, so mastering the mountain takes real skill behind the wheel.\n\nGet in, check the dispatch, and take the next fare \u2014 the mountain is waiting.", "short_description": "Buckle up and drive the mountains. In this VR off-road taxi simulator, you run your own ride service through steep switchbacks, gravel trails, and rugged peaks. Accept or decline fares, navigate to each pickup, and get passengers safely to their destination \u2014 all from behind the wheel in full virtual reality. Realistic 4x4 handling, unpredictable terrain, and a living taxi dispatch system make every ride different. Build your reputation one drop-off at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://pai-developers.netlify.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pai-Developers", "support_website_url": null, "website_url": "https://pai-developers.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1453049911218357"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_1559710525474958_7522974095763477364_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q68uD
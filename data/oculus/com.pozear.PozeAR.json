2_8148387968762372959_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyP0_opbmroQ7kNvwE2L0YS&_nc_oc=AdoK3Xi3QNYIjnQBnYNlIl1cpLL1qxjQBwfRHZcP4GC1zhhgDvpTZTyhZAkOuDsFwG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtE7gq6eRTwU6eqF1wVDkUvAWPN1QZJbEBpS6sb1LTVA&oe=6AFDBBB1"}, {"file_name": "screenshot5.png", "id": "856004939525227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974567_856004946191893_6542402092757279352_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-gJwK0Pj0UQ7kNvwHbbmfk&_nc_oc=AdqhLjXDVZuvzMzkD99EqTkHcqYSsoWDfRtaI6BX8nLBzzBkn5lCDcH2m6x0C70UNPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI5YgdqYCBkXdnul1_NHXJrpsPqSRFBN5xyBrjzzzwCg&oe=6AFDD6AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-trailer.png", "id": "170725302753749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974564_170725309420415_2345260497058008468_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eScNmJ9-EGkQ7kNvwGVW8rZ&_nc_oc=AdqITx4QbW_FCQIX5-ezT_lCbV3PgfjXmN7xFnmzA78VF-m_sU8pgZqbAdjpHvdgJ6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs0PNRL86Lle14kdVIwxxjPOxGw_6r-vvbkGtbozq3Tg&oe=6AFDBC65"}, "display_name": "PozeAR", "keywords": [], "long_description": "PozeAR is an Augmented Reality martial arts training app.\n\nWe record the movements of real Taekwondo experts performing real moves using optical motion capture, then let you step into their shoes and learn poses from your own perspective.\n\nFOR STUDENTS\n\nGet motivated with a scoring system, difficulty levels, and achievement medals.\n\nPrepare for each move using step-by-step yellow guides showing hand forms, body rotation, leg heights and more.\n\nAim each move using the red target. The front of the target changes to show the type of strike you should use.\n\nFollow fast movements with the help of motion trails.\n\nHear your instructor provide step-by-step audio instructions.\n\nTwo virtual, lifesize 3D instructors are in-front and behind you at all times, performing the moves.\n\nFit your body by adjusting height, arm lengths, leg lengths and more.\n\nAnalyse your performance by watching a lifesize 3D replay of your actual moves. A true 'out of body' experience!\n\nFOR INSTRUCTORS\n\nFree up instructors: spend less time teaching patterns, more time helping students refine their technique and master more advanced skills.\n\nAdd variety to training: rotate students through stations, some spending time in PozeAR, some one-on-one tuition, some group work.\n\nHelp students learn faster: by teaching all moves from their own perspective, PozeAR capitialises on student's muscle memory.\n\nMirror mode: if your dojo has mirrors, PozeAR projects a blue outline inside the mirror for students to match.", "short_description": "PozeAR is an Augmented Reality martial arts training application. Step into the shoes of an expert. Learn by following their moves from your own perspective"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pozear.com/#/login/privacyPolicy", "developer_terms_of_service_url": "https://pozear.com/#/login/termsAndConditions", "publisher_name": "Kennard Consulting", "support_website_url": null, "website_url": "https://pozear.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
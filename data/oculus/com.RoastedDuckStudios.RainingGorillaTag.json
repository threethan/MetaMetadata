cdn.com&_nc_ss=8&oh=00_Afx6JA5o9LFeKt8E0Fdbrx19vF2j6h2S06C8cb8WRRrrdg&oe=69B560A3"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTHXYHLVoWwQ7kNvwGcByBh&_nc_oc=AdkhM4wGkEv9nW_FBbSAwmyddm2xhghPZzVq1fAZyopCusS0vQ0v8m3a6HM3RtzZMQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEbxs1yf1-uf58oACzoVxSY5xnIl6NQJz9QQXCoyx_2A&oe=69B568EB"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFRb-TBJOswQ7kNvwH0JYXU&_nc_oc=AdmwK3gxmgQJfoN75u4ID1WDplaO-MHH4bMqofHZYV9immRcx767P4jryWtSS8taelA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxMCWwy5sZVbU8zjjDd0SQDRv2VfRau9xQXhckWnYtgAg&oe=69B55084"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "Roaste
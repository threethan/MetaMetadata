cdn.com&_nc_ss=8&oh=00_AfxahyTLQY27z5LD4SSeO7MQp5oPD-o9_k9bjvCOuPs-FQ&oe=69B2BDA3"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylhtyStpyKMQ7kNvwG7W5Cz&_nc_oc=AdlYPJU5QpzJzIgvq7XByVE47C5nlOqe2YgAApo2DaxnAwvo5-083-jPVrbtLmfyjlc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyzokw3sEU2ElnSwQMzf-zL7NyTNLPltfkixHExBkWOxw&oe=69B2C5EB"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cyWvIRVxMQQ7kNvwFf1tB1&_nc_oc=Adk4cNPYUrRUTPQNX-6nO6qMe1uoac6gjYw__TmoMDLQcZS3izNjSBOs1YtwKV_7lH4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSDVaRX9ZGJSCbBGJ53wtBkRimvhHbA1L4F-kfJXxtBw&oe=69B2AD84"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "Roaste
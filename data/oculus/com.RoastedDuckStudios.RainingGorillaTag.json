Yg&oe=6999AF74"}, {"file_name": "499305194_723443870338897_477755634879631917_n (1).png", "id": "657083954050230", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831056_657083957383563_3745917411100427982_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0xf0tdOZPcQ7kNvwG2fgae&_nc_oc=AdkhXCxdbXz2HaiCWBh9d6W6qWSMagYMGODNFD7zR2jl2DinEf9tx-FvltBOFVawLWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afugb-EgfOKfB7_j2AoCoLRf2fmUzlDNe6O6q5hgUl76fw&oe=6999B123"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGA62chFTvoQ7kNvwFJ7KjG&_nc_oc=AdnmRto0k84NVEbKo18wyxVb0pw45jVXPleqq0sNm8x0Ov-GXppKN95n2FmrI9JyhcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAPuc-KqH0KjZiTFE8gOWyiHuM2oiXf3QIWVJnGuN-Mg&oe=6999B96B"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16s_8ATwggUQ7kNvwEwVK5v&_nc_oc=Adnl8Kwk4XNE5GFZnM0z_5A4-uYSrXu-eUrg11EZlhWWN1kI7W8hLqooWQP4OJgRIe4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvK0LLl7W7DKG6zOtHQ-EoIzeOvxU5MrZXF5gdxTI8zwA&oe=6999A104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastedDuck", "developer_privacy_policy_url": "https://sites.google.com/view/raininggorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/raininggorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24020521007577350"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1757000734896756"}]}, "baseline_offer": {"id": "1757000734896756"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751111640, "status": "PUBLISHED", "id": "1757000734896756"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24028407420122042", "version": "1.1.15"}, "id": "646527621736476", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "bi
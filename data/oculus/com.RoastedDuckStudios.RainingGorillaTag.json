cdn.com&_nc_ss=8&oh=00_AfzEida0j-NVfjfbDCBjRysqKscR3d3YJlXB49g793U0Bw&oe=69AEC923"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Sz_LpSecVUQ7kNvwHzCVPl&_nc_oc=Adlf1bOmanoVH23tB9urlgalM1M9nWkqWKJQaqsXREMI8SQAo76MR32ZOm54biY5DsA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzy19Uo3JLDJIUfcDoQ-01REESAzYCB_-09922GA6EfzQ&oe=69AED16B"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zz5b4nHRC2MQ7kNvwFDy4Oa&_nc_oc=Adm5VtYdEGN51eiya1gT2poLfElWd0hNsuWpm9xoLBOSouMeNt94Gm90prMLuvUdRNg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx42oIn1d0_7tuezySoNsW8V3HR8-dm30n5H0fHKk6c5g&oe=69AEB904"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "Roaste
cdn.com&_nc_ss=8&oh=00_AfwSu6pu6QzyvUs-uZfQURRGOjCrcJvgz6a1XzS3DZhbFg&oe=69C13E23"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0l2-p7mm0UQ7kNvwF2-y3V&_nc_oc=AdpkO8XM26QwGPDQqTliGy1okxoFPkd7hBYj06CRQ8CymxEaPLVXCOVjO-FRDUphN-8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxaL90_9PNKxau2q6siNcqeRATYyG9BFzUIEfp_bdXWww&oe=69C1466B"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdtKFjbIIBYQ7kNvwF3Ju4C&_nc_oc=AdpWjcTEuMC_UhzYDsLQc6XBvwj-ZKWoaKzMHyWJ99qutVc5wKctigqsQbnL5NRh8lI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6FC-kglB5CJbdYorCQ_vLM_WgTJ7gS92-bmvPjYE_4Q&oe=69C12E04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "Roaste
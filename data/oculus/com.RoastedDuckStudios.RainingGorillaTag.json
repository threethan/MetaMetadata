cdn.com&_nc_ss=8&oh=00_Afy3CSLFI6FUL_uTCGds7q6wb_nXvhSZ-wpbGbsX8L7Iqw&oe=69AD77A3"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Sz_LpSecVUQ7kNvwFzx77G&_nc_oc=Adm4FqRaFX5djDfx3wGN5NSEhhE3xdBFsT9TX22ptiNhW05VYCXswll1hdN9E-M45b0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzymsFlxqY21AJD2g68giUTaqIkLkzjkWOyXuhh8x-aAw&oe=69AD7FEB"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zz5b4nHRC2MQ7kNvwGvu_gl&_nc_oc=Adn3bTYiLcRThUFa4XqYIJ2nHkY39ZfRFlARHO_Ry160wdveoY1QrnNHgMKPna52rA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGSku_6SkB-GCrE2Z266gtvazlMk2R7tRER0LI9bxAtA&oe=69AD6784"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "Roaste
ttps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831056_657083957383563_3745917411100427982_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tcck6vp1gesQ7kNvwE-xBCZ&_nc_oc=AdquwwvlfqUfegYU2GG25tnUI2uZrARZvfzalp6jXjxSoX1f_mDetbodFPTPFAFcqTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7yDfIXV3qQBN8vz_yb__kVcbdwFR-tpFRgGHOhshQpQ&oe=6AE1F6A3"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn1XcBBoV4cQ7kNvwEiC9Sk&_nc_oc=Adpuwn1owpakVQvl-Kta3tEcgf1xu1BNEx0DgrYLE8rOwe0pAET5a3pQG_Y7qMytG2g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2JHYij_XJayNktg8UsJDdPciNOZm2TZuVL3JuJUmzqg&oe=6AE1FEEB"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud6e8BX6fbUQ7kNvwFTI4VW&_nc_oc=Ado_DLBz2h5NFKrI0FPKtNlptD9Biisd1lTO11nVcbWYNO67piL2PQlYn0S2ogcQmb4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAlHb3Jm8Oe7MjP4soF4gMVYtaHq0fQ36lzB4-7lYwUA&oe=6AE21EC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastedDuck", "developer_privacy_policy_url": "https://sites.google.com/view/raininggorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/raininggorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24020521007577350"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507833247_1095609155776382_7574205931241990898_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kANOg_IKoR4Q7kNvwFFPBBt&_nc_oc=Adqc24PVXr9FMLq61ZUAmlgZg7UcKzRrM5NXQUgrN-cKguK5jBa7KbfsmFpTavuxYac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjxeJkhjkyJQ0wlYnetUWIMI1fp36Ag_fxdYLYUMdJyw&oe=6AE1F550"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Raining Gorilla", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "4
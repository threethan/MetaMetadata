"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGA62chFTvoQ7kNvwFJ7KjG&_nc_oc=AdnmRto0k84NVEbKo18wyxVb0pw45jVXPleqq0sNm8x0Ov-GXppKN95n2FmrI9JyhcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAPuc-KqH0KjZiTFE8gOWyiHuM2oiXf3QIWVJnGuN-Mg&oe=6999B96B"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16s_8ATwggUQ7kNvwEwVK5v&_nc_oc=Adnl8Kwk4XNE5GFZnM0z_5A4-uYSrXu-eUrg11EZlhWWN1kI7W8hLqooWQP4OJgRIe4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvK0LLl7W7DKG6zOtHQ-EoIzeOvxU5MrZXF5gdxTI8zwA&oe=6999A104"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastedDuck", "developer_privacy_policy_url": "https://sites.google.com/view/raininggorilla/privacy-polic
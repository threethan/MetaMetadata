ttps://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491831056_657083957383563_3745917411100427982_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iZaUj4pKNUQ7kNvwFaRS_Q&_nc_oc=Adpi4hjn3th1IjrZt2WUfyT5UOSH_keXftHUB4l5v0KZCIPbpPcOS835Vl8--1Oa494&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAstq1_R8MahZ2qATUWeZnpkYI2sflZM3WDL5Yujhlfg&oe=6A918B23"}, {"file_name": "ffsf.png", "id": "705643542218445", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825052_705643545551778_3290678460847503480_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpfElqYTY4IQ7kNvwGdILnN&_nc_oc=Adoc9f2R2SzzV6-9oLxrROOYG0ggxOVYWafb7ehMuGkpl5WFzXUlw-rDbrO8FCUHqYQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvR_P_wh5IQMvfMzRl1RTTvOxHVMe7sloMCKzDnRVFaw&oe=6A915B2B"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xh8D-CYXE8YQ7kNvwGvLyNm&_nc_oc=Adprt8EPojhlQsv8J3fXS1Ddy913I-zG_jM5D79BoXVQzTpgHm8cik1dDdcuMssfYeM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERl7SaZmmtlfyP1MMD8NGjdpsavK5u7YDFJD2iNrjPDQ&oe=6A917B04"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastedDuck", "developer_privacy_policy_url": "https://sites.google.com/view/raininggorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/raininggorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24020521007577350"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/507833247_1095609155776382_7574205931241990898_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjaWQEcnFncQ7kNvwG4H3MW&_nc_oc=AdooHG2cUbko6HnE80bD5cQpONND9MG8PSTA1x8LC2jLCllZKXh5pWa8yCD6bW5EIMQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFs1Tmio512D6FadkUfdpFrCzuTLWRkg9PbS1zbMjaGA&oe=6A9189D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Raining Gorilla", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "4
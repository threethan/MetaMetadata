AFEFFEB"}, {"file_name": "Main_Custom..._26.06.2025_06-09-39.png", "id": "710069651639149", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827718_710069658305815_176634789271042779_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im4AIJWpHY8Q7kNvwE2rFQU&_nc_oc=AdpoEr0ocBXh0K-klnr7l9Dv7HAWnCiAkbFe9pWCTq8MM6C5aQ-62XbHPUBJAwoXqiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2qk3-tORWqY6dNGEh0HhnomPD1hWFAsijsz8yRWsCDg&oe=6AFF1FC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raining Gorilla", "keywords": ["horror", "monkey", "monke", "gorilla", "tag"], "long_description": "Raining Gorilla is a multiplayer VR horror experience inspired by Gorilla Tag movement. You and your friends are dropped into dark, creepy environments where the spookiness never stops\u2014and neither do the horrors lurking in the shadows. Use smooth hand-based locomotion to climb, run, and escape terrifying creatures that hunt you in the dark. With immersive sound design, unpredictable jumpscares, and eerie visuals, every match brings new tension and fear. Whether you're exploring alone or trying to survive with friends, the storm is always coming... and something is always watching.", "short_description": "Raining Gorilla is a multiplayer VR horror game with Gorilla Tag Locomotion-style movement. Explore dark, 3 short different maps to choose from, avoid terrifying creatures, and survive the storm with friends."}]}, "developer_name": "RoastedDuck", "developer_privacy_policy_url": "https://sites.google.com/view/raininggorilla/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Roasty", "support_website_url": null, "website_url": "https://sites.google.com/view/raininggorilla/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {
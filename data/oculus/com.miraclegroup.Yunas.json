4_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CLxALvrf4cQ7kNvwGD3E9o&_nc_oc=AdrFwLcReWOzaDFOTSYoM5TVSFxbLrwZtHOk1jrche8wXOXwaLh9c4q9oF6xq3NseDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKQvBS2TXt8vgfP2IGCGCak09lJRBjrKubbR7obImA3Q&oe=69D11F4F"}, {"file_name": "ss 3.png", "id": "1538921097170246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827987_1538921100503579_8326549767277409040_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zls1_QDVJgsQ7kNvwEL3K91&_nc_oc=AdrrrmqkjGq3kbbYs92EXXFG5KhZXBYoIARVJ2U8dQ8QS6dgmNluDEEJorBIrtwl9LA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRk75XUaOrdG7zsu8GZ6llnAXQxuKMZ6gA0eAEaAhVRw&oe=69D0F058"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Yunus", "keywords": [], "long_description": "Surah Yunus \u2013 VR Experience\n\nImmerse yourself in the recitation of Surah Yunus, the tenth chapter of the Holy Quran, through a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a peaceful and focused space to listen, reflect, and connect deeply with the messages of Surah Yunus. High-quality audio and smooth verse navigation ensure an uninterrupted spiritual experience.\n\nSurah Yunus emphasizes the oneness of Allah, the importance of patience, guidance for believers, and lessons from the stories of previous prophets. It inspires faith, reflection, and trust in Allah\u2019s wisdom and mercy.", "short_description": "Surah Yunus emphasizes the oneness of Allah, the importance of patience, guidance for believers, and lessons from the stories of previous prophets. It inspires faith, reflection, and trust in Allah\u2019s wisdom and mercy."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "
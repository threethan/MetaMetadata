/t64.5771-25/491827987_1538921100503579_8326549767277409040_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqZAeegtwLsQ7kNvwHNEY3F&_nc_oc=AdpV60026z-KxtxC2awBFYr37jdaxJFYD1t8bu4OOIbJJtcUh-ib1yUftWfcKkX8VU0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCfhKUaGKnpbf7tntubsYWhl3pape6GPfJ_LGO-exXzg&oe=69C66458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Yunus", "keywords": [], "long_description": "Surah Yunus \u2013 VR Experience\n\nImmerse yourself in the recitation of Surah Yunus, the tenth chapter of the Holy Quran, through a fully immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience provides a peaceful and focused space to listen, reflect, and connect deeply with the messages of Surah Yunus. High-quality audio and smooth verse navigation ensure an uninterrupted spiritual experience.\n\nSurah Yunus emphasizes the oneness of Allah, the importance of patience, guidance for believers, and lessons from the stories of previous prophets. It inspires faith, reflection, and trust in Allah\u2019s wisdom and mercy.", "short_description": "Surah Yunus emphasizes the oneness of Allah, the importance of patience, guidance for believers, and lessons from the stories of previous prophets. It inspires faith, reflection, and trust in Allah\u2019s wisdom and mercy."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMEN
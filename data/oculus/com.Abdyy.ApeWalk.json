g_description": "Welcome to Ape Walk , where you'll experience the thrill of hanging out with your primate buddies in stunning virtual reality environments. Explore lush forests, bustling shops, serene gyms, and even zero gravity arenas as you kick back and relax with your monkey pals.\n\nEngage in leisurely activities like swinging through the trees, playing games, or simply chilling out together. But it's not all about relaxation \u2013 challenge your friends to thrilling player-versus-player matches for some competitive fun.\n\nImmerse yourself in a virtual world where the line between reality and fantasy blurs, and the bond with your monkey friends feels as genuine as ever. Ape Walk  brings the joy of camaraderie and adventure right to your fingertips.", "short_description": "Dive into Ape Walk  and explore lush forests, bustling shops, serene gyms, and even zero gravity arenas with your primate buddies. Relax, swing through trees, or challenge friends in thrilling PvP matches. Immerse yourself in a world where friendship and adventure collide."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/7bf20958-7d6c-498a-b724-4e9a513e08e1", "developer_terms_of_service_url": null, "publisher_name": "Abdyy", "support_website_url": null, "website_url": "https://sites.google.com/view/apewalk/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"
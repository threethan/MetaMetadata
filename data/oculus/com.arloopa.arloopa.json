7&_nc_sid=6e7a0a&_nc_ohc=aADqCedUPB4Q7kNvwHCEUNI&_nc_oc=AdpAxf_TmguG27OTipj4DNODblkYBFfd-sFaOIG1WTnWdtx-On1ONxZxc9lo1mGJLEg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS5cWzl69VYM6Z-L6-SVQAPJdG2ty9inGQO45k64HEh9A&oe=6B0B3C90"}, {"file_name": "Screen 4.png", "id": "1224927946316551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823445_1224927949649884_367142433819038213_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IE0qzrwHvbEQ7kNvwHE8Hye&_nc_oc=AdqCfc064T71SrmrsA4Stc0B7BQR1USF98ltz_IqCTSjPcQXG7hpyfTbavVD4QWlfck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSbz3AinOYcOF5je2w9p2Goi_-EN__DotI3a8guJDJQVA&oe=6B0B32FE"}, {"file_name": "Screen 5.png", "id": "3745657892398959", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617749_3745657895732292_5747188233596570557_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWZlsIIPHrcQ7kNvwEDot3c&_nc_oc=AdrV0pZwtfRgvtbAHhiiIEDt7L7X4GG-T-HeTOkd0MtWclfrlZF4I0fSdzroKFgx1Ps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRKAkLtmY8_xsarM7BU4Ay5GYvt4-EfCVjg8wKvOfL2Gg&oe=6B0B4409"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover & Cover Image (1).png", "id": "742560078727303", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308646_742560085393969_6060264461465957656_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0sd6JbhU2cQ7kNvwFxOvKI&_nc_oc=AdpBIj8vKwbRqCdArclwhHDImLjMw1bNLnm9qpGQn5RPOn_vgWbEn-uKF0E3ZT1_KDg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbImcSFKV_rJEOGaZUV6ezkcK_2FVLBHAI1rjWYVHFWw&oe=6B0B3796"}, "display_name": "ARLOOPA XR", "keywords": ["Arloopa", "art", "ar", "augmented", "dinosaur"], "long_description": "Step into the future of immersive reality with Arloopa XR, now available on Meta Quest! Bring digital worlds into your physical space with hyper-realistic 3D AR models, interactive scenes, and mixed reality experiences that blend seamlessly with your surroundings.\n\n\ud83e\udd96 Explore & Play with 3D Models\nPlace lifelike 3D models \u2014 from wild animals like dinosaurs and sharks to futuristic robots, cars, and artwork \u2014 directly into your environment. Scale, rotate, and interact with these digital objects in real-time.\n\n\ud83c\udfe0 Transform Your Space\nDesign entire virtual scenes in your room! Combine multiple AR models to create magical, themed environments \u2014 like a digital art gallery, a fantasy forest, or even your own science lab with planets, the moon, and educational content.\n\n\ud83c\udf10 Portals to Other Worlds\nStep into fully immersive XR portals and travel to new dimensions \u2014 from fantasy realms to futuristic metaverses. Meet virtual humans, explore sci-fi settings, and experience new realities right from your headset.\n\n\ud83d\udd76\ufe0f Mixed Reality with Passthrough Support\nThanks to Meta Quest's passthrough technology, you can experience AR in your real environment \u2014 blending digital elements into your actual room with precision and presence.", "short_description": "Step into Arloopa XR on Meta Quest and bring lifelike 3D AR models\u2014dinosaurs, robots, artwork\u2014and fully interactive mixed reality scenes into your space. Scale, rotate, and interact with objects in real time, step through XR portals to explore fantasy realms and futuristic metaverses, and share your experiences\u2014all with Passthrough support blending digital elements seamlessly into your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arloopa.com/privacy", "developer_terms_of_service_url": "https://www.arloopa.com/terms", "publisher_name": "ARLOOPA Inc", "support_website_url": null, "website_url": "https://www.arloopa.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "A
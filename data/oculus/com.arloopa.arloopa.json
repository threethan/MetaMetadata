g&oe=6A635D90"}, {"file_name": "Screen 4.png", "id": "1224927946316551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823445_1224927949649884_367142433819038213_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxDf0Cs4nwkQ7kNvwE40Et_&_nc_oc=AdqnAK8GqSv_eleNp6zFwGO6_MDEq_fDW9An2bsG-BgbOLzYgCYnlX03A8ufntXcXHQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwyAzQxw27KvCadMnKp2-boJd45EPcJ5_1YYijd41mcQ&oe=6A6353FE"}, {"file_name": "Screen 5.png", "id": "3745657892398959", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617749_3745657895732292_5747188233596570557_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3uUUmfGYUQQ7kNvwFg2tEM&_nc_oc=AdpVd122lBipbQtLv6qylVk7HUHgaueWiGECrPg5gkPPmguj7Ko5PZvHwwWW5Ji6xkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOQoc7HQQMqNdX02vvduhWdfBoROFRNWBcl9Qde0gdzg&oe=6A636509"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape Cover & Cover Image (1).png", "id": "742560078727303", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308646_742560085393969_6060264461465957656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et7NPDhHwQcQ7kNvwHJ3jXw&_nc_oc=AdqgeCFU1ND_vSKVvTZ1ppLJNKFNkrcesgett8jQBKiLLlWAqA-ly--NRAEwIMDHtbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmMW-ZgFKY-eI4wnYDuEOs6EkOA705cXZ57E8Jx5DMzg&oe=6A635896"}, "display_name": "ARLOOPA XR", "keywords": ["Arloopa", "art", "ar", "augmented", "dinosaur"], "long_description": "Step into the future of immersive reality with Arloopa XR, now available on Meta Quest! Bring digital worlds into your physical space with hyper-realistic 3D AR models, interactive scenes, and mixed reality experiences that blend seamlessly with your surroundings.\n\n\ud83e\udd96 Explore & Play with 3D Models\nPlace lifelike 3D models \u2014 from wild animals like dinosaurs and sharks to futuristic robots, cars, and artwork \u2014 directly into your environment. Scale, rotate, and interact with these digital objects in real-time.\n\n\ud83c\udfe0 Transform Your Space\nDesign entire virtual scenes in your room! Combine multiple AR models to create magical, themed environments \u2014 like a digital art gallery, a fantasy forest, or even your own science lab with planets, the moon, and educational content.\n\n\ud83c\udf10 Portals to Other Worlds\nStep into fully immersive XR portals and travel to new dimensions \u2014 from fantasy realms to futuristic metaverses. Meet virtual humans, explore sci-fi settings, and experience new realities right from your headset.\n\n\ud83d\udd76\ufe0f Mixed Reality with Passthrough Support\nThanks to Meta Quest's passthrough technology, you can experience AR in your real environment \u2014 blending digital elements into your actual room with precision and presence.", "short_description": "Step into Arloopa XR on Meta Quest and bring lifelike 3D AR models\u2014dinosaurs, robots, artwork\u2014and fully interactive mixed reality scenes into your space. Scale, rotate, and interact with objects in real time, step through XR portals to explore fantasy realms and futuristic metaverses, and share your experiences\u2014all with Passthrough support blending digital elements seamlessly into your real world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arloopa.com/privacy", "developer_terms_of_service_url": "https://www.arloopa.com/terms", "publisher_name": "ARLOOPA Inc", "support_website_url": null, "website_url": "https://www.arloopa.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
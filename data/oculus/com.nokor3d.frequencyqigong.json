.com&_nc_ss=7f20f&oh=00_AQT3Giq0JcphFHv3esw1zarP1-99yTWPRE1MwGzqY8ZvFA&oe=6B047DC0"}, {"file_name": "output-onlinepngtools - 2022-11-09T111821.089.png", "id": "798606437915116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_798606441248449_4184627079989753020_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmnpRuKEoJ0Q7kNvwEQOWX_&_nc_oc=AdpxJ-OGpC_m4pMokif9-_6Rfnrq4ivlCn4brGy1cz1QopnfnLnJ5PXXoDGwBndJWjo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMwo5SNnaNMBMI5yvV8aW6ci0mFMcHGPG7bMio0pzkrg&oe=6B046749"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "output-onlinepngtools - 2022-11-09T083120.068.png", "id": "1034691971259231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974762_1034691977925897_8456523063144377820_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4vEmBsooeMQ7kNvwEif3Au&_nc_oc=AdrwMFElYGLQgJhWDnk6ZuCnWEDnGrji3TcNsQmi9HPTPi_w-MLyOVWMMVMrWHNmRCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYxkC2jcbA3yOnkaKfxm1zURN_MI09vNthgtIDvfk7zA&oe=6B0474D0"}, "display_name": "Frequency Qigong", "keywords": [], "long_description": "Had a rough day? Come and empty your mind by doing some qigong stake standing! Nothing fancy and exhausting! Stake standing is simple and everyone can do.\n\nStake standing is the very fundamental of qigong practice. It is standing meditation and helps cultivate energy through your whole body.\n\nThe game helps you to visualize the qi when you do the stake standing, and it also provides a timer. Moreover, the game contains well-picked meditation frequency healing music to help you heal the chakras.\n\nThis game includes 2 very basic yet most important qigong stances to help you improve your energy. These 2 stances are also of critical importance viewed by many Kungfu masters.\n\nHunyuan stance The very basic stance of Taiji quan.\nSanti Stance The very basic stance of Xingyi quan.\nmore to be added in future.\n\nNOTE: Hand tracking required supports quest/quest2", "short_description": "Simple and relaxing qigong practice and frequency healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3dnokor", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "700877215021729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035380_3192392764407813_2230470143619774658_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1euFGnMuww8Q7kNvwH2Keul&_nc_oc=AdpKhWCyAXOzOkVyZSPMhMsVGYcmzojCQnjTiBVkzsn0IyHAbs5A30Rf1XfZvnOrCNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpuWfLIXM4A8STOiqijNz8eqzc1hOdJ1GexPRzorBB-g&oe=6B047908"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Frequency Qigong", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1673845200, "lastRevision": {"nodes": [{"id": "5449903188421593", "release_type": "SCHEDULED", "
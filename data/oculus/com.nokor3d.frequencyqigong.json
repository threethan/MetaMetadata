_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6iBhd-xZcoWsjTT_kTe-s3lD50kOMHGW_S5TOz9SJLA&oe=6B01DAC0"}, {"file_name": "output-onlinepngtools - 2022-11-09T111821.089.png", "id": "798606437915116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974854_798606441248449_4184627079989753020_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGSgYnMqNhgQ7kNvwFawSn2&_nc_oc=AdqmNI6dUTVezieKJekVpvVlS9AUsSPnW261aHa4CXsCYS36hjzdkvL6cLBv7wN2Zrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwfvKcXz3A3QgbScRdXZ5RFM1IMCpZI7XybPpbkGdAfA&oe=6B01C449"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "output-onlinepngtools - 2022-11-09T083120.068.png", "id": "1034691971259231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974762_1034691977925897_8456523063144377820_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swQR5mo6B2IQ7kNvwG1evkn&_nc_oc=AdouYo7ysAfavRB8P73zro2BNN8eUHv_-aOgF0m2czfHsoPD_ik3fncE0XGU7t7TmAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn4VTw_9LaXacHeWswi26dTCiCAX6CZEAzwcXxTGT4jA&oe=6B01D1D0"}, "display_name": "Frequency Qigong", "keywords": [], "long_description": "Had a rough day? Come and empty your mind by doing some qigong stake standing! Nothing fancy and exhausting! Stake standing is simple and everyone can do.\n\nStake standing is the very fundamental of qigong practice. It is standing meditation and helps cultivate energy through your whole body.\n\nThe game helps you to visualize the qi when you do the stake standing, and it also provides a timer. Moreover, the game contains well-picked meditation frequency healing music to help you heal the chakras.\n\nThis game includes 2 very basic yet most important qigong stances to help you improve your energy. These 2 stances are also of critical importance viewed by many Kungfu masters.\n\nHunyuan stance The very basic stance of Taiji quan.\nSanti Stance The very basic stance of Xingyi quan.\nmore to be added in future.\n\nNOTE: Hand tracking required supports quest/quest2", "short_description": "Simple and relaxing qigong practice and frequency healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3dnokor", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "700877215021729"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "465854642404336"}]}, "baseline_offer": {"id": "465854642404336"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1673845200, "status": "PUBLISHED", "id": "465854642404336"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5455467647865147", "version": "0.1"}, "id": "437593415119290", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5449903128421599", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5455467647865147"}, "release_status": "RELEASED"}, "bi
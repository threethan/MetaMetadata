hv8R3muU3g&oe=6AFDB052"}, "display_name": "Alien Tag", "keywords": [], "long_description": "Alien Tag is a NEW, FREE VR Game that includes built-in mods & built-in custom maps! Join the Discord at https://discord.gg/alientag \ud83d\udc7d Check out the built-in mods at  https://alientagvr.com. Alien Tag puts you in the shoes of an extraterrestrial trying to tag other aliens! Use your long, flexible alien arms to swing swiftly across psychedelic alien worlds. See if you can master the art of alien locomotion and become the top tagger in the galaxy. With Mods & Custom Maps natively integrated, no two games of Alien Tag are ever the same. Challenge your friends to out-swing and out-tag one another in intense, fast-paced rounds. Transport yourself to new worlds and catch some alien vibes today!", "short_description": "Reject Monke, Become Alien. Discord.gg/AlienTag. AlienTagVR.com."}]}, "developer_name": "IRLDLC.COM INC", "developer_privacy_policy_url": "https://alientagvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "IRLDLC.COM INC", "support_website_url": null, "website_url": "https://alientagvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "28722342947364793"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031578_1564064461164663_2854215056481622
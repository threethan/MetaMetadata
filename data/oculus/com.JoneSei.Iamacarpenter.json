 "Screenshot 2026-04-08 033510.png", "id": "2428799340895665", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619774_2428799344228998_822165111937658774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hB9YWBKwcYQ7kNvwFUDh3D&_nc_oc=AdqpkctYRnNpm3KaAu1n-zEyBOMnh2wFON0aJsHN6sPxNc9S2PKpNfHa1Sl90f_rj-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CtYFOqA7f_BVjDAvJYEuBAhpW9IayGrtQ_ozeTTNvVw&oe=6A283911"}, {"file_name": "Screenshot 2026-04-08 033850.png", "id": "959949313638930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617748_959949316972263_1235946824831140353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PvjcN5OTxjkQ7kNvwEHQb2t&_nc_oc=AdqV9i7dlLhj_69bx6mSTgHo2YqmfntiUE6eCPHLpuqFHZ3KJZH8CXyCy5xIANs9how&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xo2WH_M86CVOS8e-ww3NpNgy9gHED62d-9hCQwvLNEQ&oe=6A281615"}, {"file_name": "Screenshot 2026-04-08 033905.png", "id": "1517355210036167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618254_1517355213369500_5545983108349185083_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mctRfuV4UtUQ7kNvwEAKzjI&_nc_oc=AdqWW311kgRKRNYWaQlwqF9g_xZapOb63cnD9TOj1h9U9Gp5kq_IYz-C9qvrwNxPguU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9L6HxeLxo5bqDpt6AjvGUQYFYXwYO35PYIZk2uNL5inQ&oe=6A2828A7"}, {"file_name": "Screenshot 2026-04-08 033720.png", "id": "930536159708086", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_930536163041419_678909339630689490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1cYN3o7BEoQ7kNvwEJHk55&_nc_oc=Adr3Rc_TzRYqS1efEb47OmvAkm1ebaOuGSIbE4f9jORGTLVHlp2el1k6t7SAGFZRk7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3quqT9GAx9nFGa2G_tG3bxKtfbtkWGlrfKAUP5GjTGA&oe=6A283BE9"}, {"file_name": "Screenshot 2026-04-08 033809.png", "id": "1268369585469721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622211_1268369588803054_2694265129572373421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lbs0gVbeImwQ7kNvwGDmfAi&_nc_oc=Ado5ds-tfPhRtfPuAwEEaF2eq5dSJWEod4lUXM5NfIHzstoGU-HtzPa21H0nx-UJu_0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cWAsNI4YpmgepTjAh95XMTXSXfuUdB1rHJNn6CeEoAg&oe=6A28301F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "2148736982627005", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618064_2148736985960338_7090380788208660940_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISktzhZPVT4Q7kNvwElComj&_nc_oc=Adofu2Zf5q3Gd68I5-nmOBmbSIF_W3-Ga_Jfp9XcIujBH_Per_7LctQQh2t4K1RitCY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7g8Yr4zjYNusnFzCNwlNRvZTOGhITzWJT-ErIEnZ_tg&oe=6A28235B"}, "display_name": "I am a carpenter", "keywords": ["VRSimulation", "carpentrysimulator", "woodworkingVR", "vrworkshop", "VRbuildinggame"], "long_description": "\ud83d\udd28 Become a Carpenter\u2026 or Not\n\nStep into a fully interactive VR workshop where every tool feels real and every action matters.\n\nSaw wood, hammer nails, and assemble pieces with true-to-life physics.\nEvery movement is in your hands.\n\n\ud83e\udeb5 Satisfying Crafting Mechanics\n\nFeel the difference:\n\nPull the saw back and forth\nHit nails with precision\nSnap pieces perfectly into place\n\nBuilt for maximum immersion and satisfying gameplay.\n\n\ud83d\ude02 Or Just Break Everything\n\nNot in the mood to build?\n\nGo wild:\n\nThrow objects\nSmash furniture\nCreate chaos\n\nThis is not just a simulator\u2026 it\u2019s a sandbox.\n\n\ud83e\udde9 Challenge Yourself\nMultiple levels with increasing difficulty\nFrom simple tasks to complex builds\nTest your precision and creativity\n\nCan you master every project?\n\n\ud83c\udfae Designed for VR\nRealistic hand interaction\nPhysics-driven gameplay\nSmooth and responsive controls\n\nMade for Meta Quest players who love immersive experiences\n\n\ud83d\udd25 Why You\u2019ll Love It\nSatisfying gameplay loop\nEasy to start, hard to master\nPerfect mix of simulation + fun + chaos\n\ud83c\udfaf Final CTA\n\nStep into the workshop.", "short_description": "A physics-based VR carpentry simulator where precision meets chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35209668448624267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623345_1309448684367900_6977062164139956845_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNYASBw3J0kQ7kNvwHZsfJV&_nc_oc=AdrsxDGoDQ3S06CWao7iZediyMFXK9iHqc_PdAEa0v_LeF3Rpl1HQrU4Vi-6LFQ_Ln8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DBOe3yY_e-RXXJCHRFbLmSwFni8YGaFNY_Ls25_Tnug&oe=6A2826BC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I am a carpenter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}]
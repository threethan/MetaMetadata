 "Screenshot 2026-04-08 033510.png", "id": "2428799340895665", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619774_2428799344228998_822165111937658774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSa48axQLiIQ7kNvwEpbXMR&_nc_oc=AdqcS44RTVbQb_gGC8J9sQt7fu1SpwKupi77olx1rGLbCgbthMUN5v3otBcOGF5cfYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tM1nwp0IlANU5C-vXy-8QE3pWrUjX5Qlt0kfgjxbaPg&oe=69ECAD51"}, {"file_name": "Screenshot 2026-04-08 033850.png", "id": "959949313638930", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617748_959949316972263_1235946824831140353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgHTTbS8-nAQ7kNvwEmJWmh&_nc_oc=Adoh8wgSrfk4Hl2Yw9xYILS1-7k4xHK6ZMO3bLHYmI8HEcgq14t1rPpjTOl5pwkHHMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22-edNS_0MhnLq4mjcg3YiLceOJiar1nF_LliD06biHA&oe=69ECC295"}, {"file_name": "Screenshot 2026-04-08 033905.png", "id": "1517355210036167", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618254_1517355213369500_5545983108349185083_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VQxmtLAUd0Q7kNvwHftd_4&_nc_oc=Adqa3EN04lz-AI-RVUWbhIOrR-lLdCbMzz4l-sBgfXeG10K2Pi_5ooQECGiGfKUq-u4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G_os3AJeIkmi6HsTbQvtFSErVBcy6iwyNcpyQL_jm1A&oe=69ECD527"}, {"file_name": "Screenshot 2026-04-08 033720.png", "id": "930536159708086", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_930536163041419_678909339630689490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wtKFJDck9oQ7kNvwHq1UXz&_nc_oc=AdpiAZN2vkOXaEoYdXAq3fP8EGbczJZ6qv2md-_6Ah2mu7ApFGxUY6QSJAh5Ogn_yhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T-NGVdbt4V0hlpNk2F9uNheZc1kTkScLkEffGvl7DFA&oe=69ECB029"}, {"file_name": "Screenshot 2026-04-08 033809.png", "id": "1268369585469721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622211_1268369588803054_2694265129572373421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzUHZNgnlCIQ7kNvwG4aDrH&_nc_oc=AdoV2gQpUnj5kTkuczhw2Tk4Xur7DPFCQU131VsLW4B_qvtlckmsLm0Gulm6l1DYRYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NNoFMyBtqWGyYX4xrOECOjIEVktSsftPRpM1ZNcsz5g&oe=69ECA45F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "2148736982627005", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_2148736985960338_7090380788208660940_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WW7NveuvXhMQ7kNvwGIhgER&_nc_oc=AdoIB3uXGMGaQyOkUTgcdCo39A8uyXWy5R3JQO800okQYiM2ZZyqdxtJ_MHJBe4r4P0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39YbG7wPvW6hkcQISaulmjbtjzNnW4GatEM9HsKfIFlA&oe=69ECCFDB"}, "display_name": "I am a carpenter", "keywords": ["VRSimulation", "carpentrysimulator", "woodworkingVR", "vrworkshop", "VRbuildinggame"], "long_description": "\ud83d\udd28 Become a Carpenter\u2026 or Not\n\nStep into a fully interactive VR workshop where every tool feels real and every action matters.\n\nSaw wood, hammer nails, and assemble pieces with true-to-life physics.\nEvery movement is in your hands.\n\n\ud83e\udeb5 Satisfying Crafting Mechanics\n\nFeel the difference:\n\nPull the saw back and forth\nHit nails with precision\nSnap pieces perfectly into place\n\nBuilt for maximum immersion and satisfying gameplay.\n\n\ud83d\ude02 Or Just Break Everything\n\nNot in the mood to build?\n\nGo wild:\n\nThrow objects\nSmash furniture\nCreate chaos\n\nThis is not just a simulator\u2026 it\u2019s a sandbox.\n\n\ud83e\udde9 Challenge Yourself\nMultiple levels with increasing difficulty\nFrom simple tasks to complex builds\nTest your precision and creativity\n\nCan you master every project?\n\n\ud83c\udfae Designed for VR\nRealistic hand interaction\nPhysics-driven gameplay\nSmooth and responsive controls\n\nMade for Meta Quest players who love immersive experiences\n\n\ud83d\udd25 Why You\u2019ll Love It\nSatisfying gameplay loop\nEasy to start, hard to master\nPerfect mix of simulation + fun + chaos\n\ud83c\udfaf Final CTA\n\nStep into the workshop.", "short_description": "A physics-based VR carpentry simulator where precision meets chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35209668448624267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623345_1309448684367900_6977062164139956845_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxqwZUL9VvAQ7kNvwFPkDqR&_nc_oc=AdoZqnIJ-IxcEL7TgiCCHnz0A2hGqtc4KoaSUahgS0BRo273Xiqfxe3n8_6JH-o8LHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hoiD1aumjybTyZrg51teZoiMeiOT4xfsYUOQtBn8t8g&oe=69ECD33C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I am a carpenter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}]
iu7ikw8rkJ9-178esLvS6Q&oe=6AE9E295"}, {"file_name": "Screenshot 2026-04-08 033905.png", "id": "1517355210036167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618254_1517355213369500_5545983108349185083_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqCGl3jWvD0Q7kNvwEvokuS&_nc_oc=AdpNNPZcm19t5mCC5-t3e0bjQl29qMsQIz8sBPWQcv59HNROelZ-DnVz_vRcE7sWxLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4gl5vhm6j5LFa5utvhMq1h9vZstMeByXdN7dU6iSktQ&oe=6AE9F527"}, {"file_name": "Screenshot 2026-04-08 033720.png", "id": "930536159708086", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_930536163041419_678909339630689490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UOo1OZRjvoQ7kNvwG7sLrC&_nc_oc=AdpjSkGVABnyCr2-8hvoCkLkOrV-BBKg3Qeu1yQDt0IBi21PQXyFR3kWPEW7lR2mknI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3waP52pisUIOm7h4r7--oJVurt-UhnFRZOu7t3VFPfw&oe=6AEA0869"}, {"file_name": "Screenshot 2026-04-08 033809.png", "id": "1268369585469721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_1268369588803054_2694265129572373421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtJkbWq92SgQ7kNvwGHGOo0&_nc_oc=AdpuqzxeNknRXO6pPZRcudamPk00Y_X5lKYOSVtpunLKKFSvx63y2Zj_s5hBZ2m4GxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLZf-jVm78l8fvmY0Z0bAdO7ov3S5J6cR9yWnKY5jqbQ&oe=6AE9FC9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "2148736982627005", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618064_2148736985960338_7090380788208660940_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0roAV7FH2iMQ7kNvwGz4I70&_nc_oc=AdoSD3b_51fUl3ACJQGkcPG6e6_A1WONDLRfSD6cAQRtvGPbmxfrvzhOob6i2dc4Jn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwBhEb782UPIbUzDjt50jwxfKwlHGzGC1m7yhv9HLooQ&oe=6AE9EFDB"}, "display_name": "I am a carpenter", "keywords": ["VRSimulation", "carpentrysimulator", "woodworkingVR", "vrworkshop", "VRbuildinggame"], "long_description": "\ud83d\udd28 Become a Carpenter\u2026 or Not\n\nStep into a fully interactive VR workshop where every tool feels real and every action matters.\n\nSaw wood, hammer nails, and assemble pieces with true-to-life physics.\nEvery movement is in your hands.\n\n\ud83e\udeb5 Satisfying Crafting Mechanics\n\nFeel the difference:\n\nPull the saw back and forth\nHit nails with precision\nSnap pieces perfectly into place\n\nBuilt for maximum immersion and satisfying gameplay.\n\n\ud83d\ude02 Or Just Break Everything\n\nNot in the mood to build?\n\nGo wild:\n\nThrow objects\nSmash furniture\nCreate chaos\n\nThis is not just a simulator\u2026 it\u2019s a sandbox.\n\n\ud83e\udde9 Challenge Yourself\nMultiple levels with increasing difficulty\nFrom simple tasks to complex builds\nTest your precision and creativity\n\nCan you master every project?\n\n\ud83c\udfae Designed for VR\nRealistic hand interaction\nPhysics-driven gameplay\nSmooth and responsive controls\n\nMade for Meta Quest players who love immersive experiences\n\n\ud83d\udd25 Why You\u2019ll Love It\nSatisfying gameplay loop\nEasy to start, hard to master\nPerfect mix of simulation + fun + chaos\n\ud83c\udfaf Final CTA\n\nStep into the workshop.", "short_description": "A physics-based VR carpentry simulator where precision meets chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEM
nc_sid=6e7a0a&_nc_ohc=oCgdpB5AvPQQ7kNvwGwLBJj&_nc_oc=Ado3Dwa8oDkktb73zsaP-lzOV3kCari84xNtCZTk2Y0-MywjJCtEzauRJyM79Kpf01w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Fse69oW_LdVB8M3aUmG0zlGUzT9M-ogZkz6C9djxXvg&oe=6A0884A7"}, {"file_name": "Screenshot 2026-04-08 033720.png", "id": "930536159708086", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618499_930536163041419_678909339630689490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqlkKye08A0Q7kNvwGivgPP&_nc_oc=AdpF97YbajMrUlDHeSVHVllOlF_PLnAZcrvTLJeE0IPTIM34X9U40YbH1xXhEiuDFck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5O3IhFjlPzvGL6FiODeYITKxlzI-uoa2B1AltC_oFKSQ&oe=6A085FA9"}, {"file_name": "Screenshot 2026-04-08 033809.png", "id": "1268369585469721", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622211_1268369588803054_2694265129572373421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zn_o53JDYHYQ7kNvwF26FNv&_nc_oc=AdrFXXOzPd0NqibTIL_sn169BYS7qgj1kJ-0qvulAY3tP3nMGMNXe0BquXYqQghJ56E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f-8RGfmbc5SEj8-21b17zf7bSiGh80kA97LgR0sJFkg&oe=6A088C1F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "2148736982627005", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618064_2148736985960338_7090380788208660940_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXYkVwqT_PcQ7kNvwHP37F1&_nc_oc=AdoHuNVMsY35tvZHDwuZNx5aIMcocurPYyHUNtT77fef2GkZ5h8iCDJRVqGalylGrDo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iOcZlLxLh7svnuyzXXVwzjUBxSWN2odXhORjaJSp1mw&oe=6A087F5B"}, "display_name": "I am a carpenter", "keywords": ["VRSimulation", "carpentrysimulator", "woodworkingVR", "vrworkshop", "VRbuildinggame"], "long_description": "\ud83d\udd28 Become a Carpenter\u2026 or Not\n\nStep into a fully interactive VR workshop where every tool feels real and every action matters.\n\nSaw wood, hammer nails, and assemble pieces with true-to-life physics.\nEvery movement is in your hands.\n\n\ud83e\udeb5 Satisfying Crafting Mechanics\n\nFeel the difference:\n\nPull the saw back and forth\nHit nails with precision\nSnap pieces perfectly into place\n\nBuilt for maximum immersion and satisfying gameplay.\n\n\ud83d\ude02 Or Just Break Everything\n\nNot in the mood to build?\n\nGo wild:\n\nThrow objects\nSmash furniture\nCreate chaos\n\nThis is not just a simulator\u2026 it\u2019s a sandbox.\n\n\ud83e\udde9 Challenge Yourself\nMultiple levels with increasing difficulty\nFrom simple tasks to complex builds\nTest your precision and creativity\n\nCan you master every project?\n\n\ud83c\udfae Designed for VR\nRealistic hand interaction\nPhysics-driven gameplay\nSmooth and responsive controls\n\nMade for Meta Quest players who love immersive experiences\n\n\ud83d\udd25 Why You\u2019ll Love It\nSatisfying gameplay loop\nEasy to start, hard to master\nPerfect mix of simulation + fun + chaos\n\ud83c\udfaf Final CTA\n\nStep into the workshop.", "short_description": "A physics-based VR carpentry simulator where precision meets chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "s
 "Screenshot 2026-04-08 033510.png", "id": "2428799340895665", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619774_2428799344228998_822165111937658774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pF7eNwlYSEEQ7kNvwFHtS3-&_nc_oc=AdrCGNetVfgxGwf3xwbTTC1-o3wC2a65zGXPBnEZH8s6FwLHTJ9UzANSqefGzL7tlTY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMRFtzbSFYJDZV7cKyhU3e7_duGVwXvNYTgBOnpeKbng&oe=6A6202D1"}, {"file_name": "Screenshot 2026-04-08 033850.png", "id": "959949313638930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617748_959949316972263_1235946824831140353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdUGrm9kpFQQ7kNvwHtBn7r&_nc_oc=Adr9IEwc2O_2vekpf-MtHyqLbBMjXY67TSZZrUTNFdzxOU-pcqvL1QrR9NVl-UpRJus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxieb0Pvqjoa8-Kx2ALJ1i6po1Y9bx4NwiGfr7zOaVrg&oe=6A621815"}, {"file_name": "Screenshot 2026-04-08 033905.png", "id": "1517355210036167", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618254_1517355213369500_5545983108349185083_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLoUrt9iesAQ7kNvwEyAips&_nc_oc=AdqvqiUAJ5Oajom3wpml_6Cw9YIvH9Y1lcKAA5IzrViULhTbBI4IFhd4rmKjhqLCpn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpYE0HYs5WmwkdQlNbcenZvOciUaBqxLQBZScBDp8KFQ&oe=6A622AA7"}, {"file_name": "Screenshot 2026-04-08 033720.png", "id": "930536159708086", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618499_930536163041419_678909339630689490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVHaIdwLjfEQ7kNvwHHBmMR&_nc_oc=AdqFXZDDdnS9UvlhZzlRdVSr2mUhcoHj3-q18K5I6lLj_wAvyhIpdrtyucD5a9ESceQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsPjxN9fbqJ5eWYdjov1Nrk4SAmuS-1EMGaO5lAHD5lg&oe=6A6205A9"}, {"file_name": "Screenshot 2026-04-08 033809.png", "id": "1268369585469721", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622211_1268369588803054_2694265129572373421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R39BTSunh-8Q7kNvwF6zCpz&_nc_oc=AdoAmnkClaEZzh1FJpjIbfyU0gTRwez83CyXcCZawVz9Jl_XpX6sCsJ4-eHHd603CnE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE_HPupWVyK3m7JgaeaPbDYiPsO_E_9uArTtboLkK4mg&oe=6A62321F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "2148736982627005", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618064_2148736985960338_7090380788208660940_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnZBFtKAE_sQ7kNvwGFs2ZW&_nc_oc=AdpSLB1dcjD6PxajUX42Rtr0ABBzJmF376V_4bqkAkZBNPvRofyiLnjY8nfibONXUac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlx7EMrUciqGojV5IxGTXOhaRcbjFk0Zm2BTwSslxq7w&oe=6A62255B"}, "display_name": "I am a carpenter", "keywords": ["VRSimulation", "carpentrysimulator", "woodworkingVR", "vrworkshop", "VRbuildinggame"], "long_description": "\ud83d\udd28 Become a Carpenter\u2026 or Not\n\nStep into a fully interactive VR workshop where every tool feels real and every action matters.\n\nSaw wood, hammer nails, and assemble pieces with true-to-life physics.\nEvery movement is in your hands.\n\n\ud83e\udeb5 Satisfying Crafting Mechanics\n\nFeel the difference:\n\nPull the saw back and forth\nHit nails with precision\nSnap pieces perfectly into place\n\nBuilt for maximum immersion and satisfying gameplay.\n\n\ud83d\ude02 Or Just Break Everything\n\nNot in the mood to build?\n\nGo wild:\n\nThrow objects\nSmash furniture\nCreate chaos\n\nThis is not just a simulator\u2026 it\u2019s a sandbox.\n\n\ud83e\udde9 Challenge Yourself\nMultiple levels with increasing difficulty\nFrom simple tasks to complex builds\nTest your precision and creativity\n\nCan you master every project?\n\n\ud83c\udfae Designed for VR\nRealistic hand interaction\nPhysics-driven gameplay\nSmooth and responsive controls\n\nMade for Meta Quest players who love immersive experiences\n\n\ud83d\udd25 Why You\u2019ll Love It\nSatisfying gameplay loop\nEasy to start, hard to master\nPerfect mix of simulation + fun + chaos\n\ud83c\udfaf Final CTA\n\nStep into the workshop.", "short_description": "A physics-based VR carpentry simulator where precision meets chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35209668448624267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623345_1309448684367900_6977062164139956845_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZGeymUSvsEQ7kNvwH5DtxE&_nc_oc=Adrdhr-AwsAx8sc0l-u1Ll5lB5TGhvZhZvV38a70Sj34LGhxe8t_zGPLAPgREXRV-9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEyyELh276iXTJCr0m9BkbTZCsWpLWGjJdEVSkXY3ezQ&oe=6A6228BC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I am a carpenter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}]
tps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618254_1517355213369500_5545983108349185083_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEK8v-btYHEQ7kNvwESSzfv&_nc_oc=AdoHq6KqfuDwUgk7LJeNoaqu4CG4f26PweVcUvW8EMS_JtFj592lvcmOyY3GxZzffdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9Lj5w2wP5SUfWPnCy20SOWXMdBGQ1698MpnmYcLIA3g&oe=6A9989A7"}, {"file_name": "Screenshot 2026-04-08 033720.png", "id": "930536159708086", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_930536163041419_678909339630689490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j7zCYZC7JwQ7kNvwHGSQ9V&_nc_oc=AdrSfQwc_HocrZC2TBwBXwvCETaMAwsh6jfNAJZgnCwOcsvDElWwH7-mK9z7b6zUf_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWPgAK4R-IQS4Bs3m9W5iWfXFS4Abq-TtqwFpvF2kUVw&oe=6A999CE9"}, {"file_name": "Screenshot 2026-04-08 033809.png", "id": "1268369585469721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622211_1268369588803054_2694265129572373421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-74DLoTSFYQ7kNvwGKyum7&_nc_oc=Ado-JGKTXLpR2r1AuyIXoEhnr3S97k81f4MSbUN87MB8cZuXSCuwWdz_UFk-cjj6a_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK38Z04_hKMG6ydO8i6WocWAf3I1Ru1PS6dD2AAJmHa6g&oe=6A99911F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "2148736982627005", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618064_2148736985960338_7090380788208660940_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnwvZrOX4GAQ7kNvwHv3W8Z&_nc_oc=Ado-7CodXb8QlqVxGVU_rL0_4EltKKrE8rO8JceSIDpuDefaP6CbjAbFvKXiInw3FX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0d2zMpQvI8DeHNw9d9jjQLcA1aU9x20DqT9MiEBphdA&oe=6A99845B"}, "display_name": "I am a carpenter", "keywords": ["VRSimulation", "carpentrysimulator", "woodworkingVR", "vrworkshop", "VRbuildinggame"], "long_description": "\ud83d\udd28 Become a Carpenter\u2026 or Not\n\nStep into a fully interactive VR workshop where every tool feels real and every action matters.\n\nSaw wood, hammer nails, and assemble pieces with true-to-life physics.\nEvery movement is in your hands.\n\n\ud83e\udeb5 Satisfying Crafting Mechanics\n\nFeel the difference:\n\nPull the saw back and forth\nHit nails with precision\nSnap pieces perfectly into place\n\nBuilt for maximum immersion and satisfying gameplay.\n\n\ud83d\ude02 Or Just Break Everything\n\nNot in the mood to build?\n\nGo wild:\n\nThrow objects\nSmash furniture\nCreate chaos\n\nThis is not just a simulator\u2026 it\u2019s a sandbox.\n\n\ud83e\udde9 Challenge Yourself\nMultiple levels with increasing difficulty\nFrom simple tasks to complex builds\nTest your precision and creativity\n\nCan you master every project?\n\n\ud83c\udfae Designed for VR\nRealistic hand interaction\nPhysics-driven gameplay\nSmooth and responsive controls\n\nMade for Meta Quest players who love immersive experiences\n\n\ud83d\udd25 Why You\u2019ll Love It\nSatisfying gameplay loop\nEasy to start, hard to master\nPerfect mix of simulation + fun + chaos\n\ud83c\udfaf Final CTA\n\nStep into the workshop.", "short_description": "A physics-based VR carpentry simulator where precision meets chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
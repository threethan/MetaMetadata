 "Screenshot 2026-04-08 033510.png", "id": "2428799340895665", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_2428799344228998_822165111937658774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v82ctqWXCEQ7kNvwG8zmGl&_nc_oc=Adrx-Plm00dAU--bs6I2k3niE52lS4EWktECh_An_RsdIBJdFaYp0ssLFFMAAKjJtLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFZb5Q3gjExcgzTOg2DKoN-e139PNmLtv5A5sbGlGBWA&oe=6A5230D1"}, {"file_name": "Screenshot 2026-04-08 033850.png", "id": "959949313638930", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617748_959949316972263_1235946824831140353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Rzq4kGzqG0Q7kNvwFG3pbb&_nc_oc=AdrEOtHm2KFED2xyzp7JDJaB3uONjFYswjiVn3sAE07MC6akAi_sUpAVxp0P7PQ3XXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhKJ3cbSMjDTrMo263ZK6zVlAm5dftlBvqQ7ztUKnubg&oe=6A524615"}, {"file_name": "Screenshot 2026-04-08 033905.png", "id": "1517355210036167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618254_1517355213369500_5545983108349185083_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb1cf-IxnYEQ7kNvwEPObPM&_nc_oc=AdrNZxLzCJk3qROLj538jaEW-ZVZlgieEwqK4kvZYKKKf51pGMwBWust1dr3aAJsq1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoFWScQgDppK0QCIuohEuGZD--XYeAoD-LwAs0hLlBhA&oe=6A5258A7"}, {"file_name": "Screenshot 2026-04-08 033720.png", "id": "930536159708086", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618499_930536163041419_678909339630689490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8_mb1haEB0Q7kNvwGndxgJ&_nc_oc=AdouClNCcZERUffdF5yfoPvFPWJdBMAwuf4zCSXE_k6iTTcTji7XpkPbplrj9rBT9ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd1A6n2M0f5_z4vE9s4VXP9KkJHXXHAmI1pARdhVloNA&oe=6A5233A9"}, {"file_name": "Screenshot 2026-04-08 033809.png", "id": "1268369585469721", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622211_1268369588803054_2694265129572373421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v91LXZ4xnYQ7kNvwHSdNkq&_nc_oc=Ado1jk1AkSMKg_Nz7eRLxAfSszu9S-aJEfogGDn0wl_ZDRt1OBwjneXu8p1HQ_FD7WA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFCqcwNIBk0yAyeFInPuD2lHFPWh_3EogbMZ-a1r4LSw&oe=6A52601F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "2148736982627005", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618064_2148736985960338_7090380788208660940_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1oeVQIdd10Q7kNvwEmBvUl&_nc_oc=Ado7_51K4pS0EGivUvAjL_b7hnYkiRiwQKJZKJU-ICaFQiASIwMbT9rZqBzQil7Mmqk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6tH6k57zN7zcJfyL9-pTHHRw5av4zR_bqiwrlxzDPJQ&oe=6A52535B"}, "display_name": "I am a carpenter", "keywords": ["VRSimulation", "carpentrysimulator", "woodworkingVR", "vrworkshop", "VRbuildinggame"], "long_description": "\ud83d\udd28 Become a Carpenter\u2026 or Not\n\nStep into a fully interactive VR workshop where every tool feels real and every action matters.\n\nSaw wood, hammer nails, and assemble pieces with true-to-life physics.\nEvery movement is in your hands.\n\n\ud83e\udeb5 Satisfying Crafting Mechanics\n\nFeel the difference:\n\nPull the saw back and forth\nHit nails with precision\nSnap pieces perfectly into place\n\nBuilt for maximum immersion and satisfying gameplay.\n\n\ud83d\ude02 Or Just Break Everything\n\nNot in the mood to build?\n\nGo wild:\n\nThrow objects\nSmash furniture\nCreate chaos\n\nThis is not just a simulator\u2026 it\u2019s a sandbox.\n\n\ud83e\udde9 Challenge Yourself\nMultiple levels with increasing difficulty\nFrom simple tasks to complex builds\nTest your precision and creativity\n\nCan you master every project?\n\n\ud83c\udfae Designed for VR\nRealistic hand interaction\nPhysics-driven gameplay\nSmooth and responsive controls\n\nMade for Meta Quest players who love immersive experiences\n\n\ud83d\udd25 Why You\u2019ll Love It\nSatisfying gameplay loop\nEasy to start, hard to master\nPerfect mix of simulation + fun + chaos\n\ud83c\udfaf Final CTA\n\nStep into the workshop.", "short_description": "A physics-based VR carpentry simulator where precision meets chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35209668448624267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623345_1309448684367900_6977062164139956845_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iifSg9subRYQ7kNvwEqf7TC&_nc_oc=AdqY0mcjAmcaRK4D4__nZqLkGlo_X-3bV1kxIrT7A6PyQylO7eJuLTpqUORRiE5x8SU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQNwbt5kwwO4IZN1NO0wOgr6QItjse3XvEuxzd2gouNg&oe=6A5256BC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I am a carpenter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}]
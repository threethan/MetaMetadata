 "Screenshot 2026-04-08 033510.png", "id": "2428799340895665", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619774_2428799344228998_822165111937658774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsmRxWrjaWYQ7kNvwHiftUN&_nc_oc=AdpmPuGqxpPE3GjavE1oYNoHDR_ghXuAIEnQGl4DD0MhitBKmr3hKM467kUX6i1aItk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xeOD0aEbiLDyV9b42d-wN7BDVlnmk6XS5Y5AzI9dcCw&oe=6A0EF451"}, {"file_name": "Screenshot 2026-04-08 033850.png", "id": "959949313638930", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617748_959949316972263_1235946824831140353_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_VJ-a2HCMEQ7kNvwEf1aC4&_nc_oc=AdrMVELSGK70yCAHKQhgU4pfdJFOb0aUFqL-yvaYQ95DasGNpcwiccvLON4k6iuBB6A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uB-w5NwpskzHEWJypeqev04vUOwddDW_uivXkDsLSCQ&oe=6A0F0995"}, {"file_name": "Screenshot 2026-04-08 033905.png", "id": "1517355210036167", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618254_1517355213369500_5545983108349185083_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePNBRIs6w7IQ7kNvwGn1JYZ&_nc_oc=Adopr6yL8DTs3lIjtw0ILnkUvFHXM-3iatpOArIkWOUtCj9P9oTBGbgOP_dvAv9t1j0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l8P0QBIJ_tTTwRVw98VvxbVkBT3Si54BMe-YOkcjmsQ&oe=6A0F1C27"}, {"file_name": "Screenshot 2026-04-08 033720.png", "id": "930536159708086", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618499_930536163041419_678909339630689490_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZK2GIqDZHQQ7kNvwFFDIc_&_nc_oc=Adpc7-LHrHh4I-DYDURxYRdjZaE5Q3qggchN1vxvGzPiDIyNkwhd-tMQ5RtOzQN-c2Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u5f99A98eJJVbLp0qpbHDM0uCw1h1gnGicCwf95YuUw&oe=6A0EF729"}, {"file_name": "Screenshot 2026-04-08 033809.png", "id": "1268369585469721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622211_1268369588803054_2694265129572373421_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOXksWCebTIQ7kNvwE8UWc0&_nc_oc=AdpHah4lMVyUpb5mN71zHfI5Th8vkAez-PLumAadh1j1tQKWtdK70LNjxhT4ebdZAn4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WrIMrjYScYiPAb5aYfS8WGtndyhLByyZdSDG7CJDzSw&oe=6A0F239F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lands.png", "id": "2148736982627005", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618064_2148736985960338_7090380788208660940_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVXwzHdA05UQ7kNvwEf-Uaq&_nc_oc=AdqzeO0bnugBUjGuMdPd_K8KHDUkWLbyEEyrREwBl7GTPeKmMrVW6mCXOlRfmjPCdi4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zmJp8puNEi2yGFHa2xKa13At_jt-iB_2CRKkgFploqA&oe=6A0F16DB"}, "display_name": "I am a carpenter", "keywords": ["VRSimulation", "carpentrysimulator", "woodworkingVR", "vrworkshop", "VRbuildinggame"], "long_description": "\ud83d\udd28 Become a Carpenter\u2026 or Not\n\nStep into a fully interactive VR workshop where every tool feels real and every action matters.\n\nSaw wood, hammer nails, and assemble pieces with true-to-life physics.\nEvery movement is in your hands.\n\n\ud83e\udeb5 Satisfying Crafting Mechanics\n\nFeel the difference:\n\nPull the saw back and forth\nHit nails with precision\nSnap pieces perfectly into place\n\nBuilt for maximum immersion and satisfying gameplay.\n\n\ud83d\ude02 Or Just Break Everything\n\nNot in the mood to build?\n\nGo wild:\n\nThrow objects\nSmash furniture\nCreate chaos\n\nThis is not just a simulator\u2026 it\u2019s a sandbox.\n\n\ud83e\udde9 Challenge Yourself\nMultiple levels with increasing difficulty\nFrom simple tasks to complex builds\nTest your precision and creativity\n\nCan you master every project?\n\n\ud83c\udfae Designed for VR\nRealistic hand interaction\nPhysics-driven gameplay\nSmooth and responsive controls\n\nMade for Meta Quest players who love immersive experiences\n\n\ud83d\udd25 Why You\u2019ll Love It\nSatisfying gameplay loop\nEasy to start, hard to master\nPerfect mix of simulation + fun + chaos\n\ud83c\udfaf Final CTA\n\nStep into the workshop.", "short_description": "A physics-based VR carpentry simulator where precision meets chaos."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35209668448624267"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623345_1309448684367900_6977062164139956845_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-BZB2aMrgQQ7kNvwEkNqPj&_nc_oc=AdryR_ItkPuak3MGVuMi1aEi96olStP8WaAMg79bU_AsaikA7j7XMiBnPbjB5ZYeiXQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L4BmKR1l30uyNdJUCQKavgOhEHmCmo_XjXl8mxtGjVw&oe=6A0F1A3C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I am a carpenter", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}]
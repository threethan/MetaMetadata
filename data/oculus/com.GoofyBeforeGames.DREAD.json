tion": "DREAD\nA Virtual Reality Horror Game\nFrom the developers of hit games \"Static\" And \"Static Replayed\".\n\nYou're a gump. An ancient race of monke who's numbers have suddenly declined massively. You're objective is to find the source of all the extinct gumps and save your species."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreadvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GoofyGuy", "support_website_url": null, "website_url": "https://sites.google.com/view/dreadvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8706532136091765"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1260081745176882"}]}, "baseline_offer": {"id": "1260081745176882"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1731780000, "status": "PUBLISHED", "id": "1260081745176882"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8954580671286909", "version": "1.4.7"}, "id": "779543027553155", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8473306966080951", "is_concept": false, "latest_released_binary": {"__typename":
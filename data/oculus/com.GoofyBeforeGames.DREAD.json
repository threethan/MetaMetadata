er_thumbnail": null, "display_name": "Dread", "keywords": ["dread", "Dread", "Horror"], "long_description": "DREAD\nA Virtual Reality Horror Game\nFrom the developers of the hit games \"Static\" and \"Static Replayed\".\n\nYou're a Gump, an ancient race of monkey-like beings whose numbers have suddenly and mysteriously declined. Your objective is to find the source of the extinction of the Gump and escape terrifying horror levels, ranging from an underground mine infested by an amalgam to a lost ancient civilization guarded by a fellow Gump corrupted by a mysterious force. Will you survive these terrors and discover the truth behind your species' extinction, or will you succumb to the horrors facing your kind?", "short_description": "DREAD\nA Virtual Reality Horror Game\nFrom the developers of hit games \"Static\" And \"Static Replayed\".\n\nYou're a gump. An ancient race of monke who's numbers have suddenly declined massively. You're objective is to find the source of all the extinct gumps and save your species."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dreadvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GoofyGuy", "support_website_url": null, "website_url": "https://sites.google.com/view/dreadvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8706532136091765"}, "review_messages": []}]}, "
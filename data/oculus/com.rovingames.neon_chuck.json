5-g&oe=6A67606E"}, {"file_name": "hero_0162_2560x1440_CoverCrop_Center.png", "id": "1616024686341945", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304938_1616024689675278_5593405100122793841_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muOzUQq1HYwQ7kNvwHeQ7Sb&_nc_oc=AdoYk8Dizhad-SyLM-dv_Up5lBnhYrKoZfMnETFXADTj8tTynglvqBAJijn6zcIagYo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiAE9FXDyYZoqhlWpv5II551ZsrF4LfwVv5NWXpxNmpA&oe=6A674DED"}, {"file_name": "hero_0224_2560x1440_CoverCrop_Center.png", "id": "1525731279195172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499305194_1525731282528505_1084594158928512393_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFvnRYfu5oMQ7kNvwHeGrUd&_nc_oc=AdorYSLV-gbqNAj2uTyc_-zT3aotM3O661YkVsGf7BdSp7HaQvkPvQdQdhpBlLZfC90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgEcTGLjjhBU7OArfJYDsJ89VFvf-Yg3SpKC8PR98jLQ&oe=6A675EE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video_Conver_Image.png", "id": "1940007093351065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820496_1940007100017731_2005598359044672368_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvlWVGZ_EvoQ7kNvwFAlITh&_nc_oc=AdrfSTGW4KFffLVo3sZbxTi9URgs2wxtSjcItiPyUl3sw8yzdwqdwZAG95qMjHudcsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATNjJJA2nw0Thr4UDAzVw6FlrHzhXN0xZsA1_edqD9Cg&oe=6A675DE7"}, "display_name": "Neon Chuck", "keywords": ["Rhythm", "Music", "Nunchuck", "Fitness", "Action"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR nunchuck rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26400896319594158"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1021169563668823"}, {"status": "PUBLISHED", "id": "2402413036891668"}]}, "baseline_offer": {"id": "2402413036891668"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "1021169563668823"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26785358591147927", "version": "0.1.4"}, "id": "4263356293916105", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26400896279594162", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26785358591147927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4263356293916105"}]}, "change_log": "Smoother Gameplay, Dynamic Themes & VR Polish!\n\nLocked 90 FPS Support: Major performance optimizations under the hood to ensure buttery-smooth gameplay and native 90Hz support on Meta Quest.\nUnique Song Themes: All 21 songs now have their own hand-crafted, beautiful color palettes matching the song's energy and vibe.\nNunchuck Particle Trails: Swing in style! Added glowing, color-coded particle trails to your nunchucks that follow your movement dynamically.\nBetter Miss Visuals: Missed target cubes now fly smoothly past you into the distance instead of freezing in mid-air.\nCrisper VR Safety Panel: The startup safety panel is now twice as sharp, making the safety text much easier to read in headset, and we fixed panel selection issues.\nVisual Environments Polish: Enhanced fog effects, smoother neon arches, and better visibility lines on all levels.", "created_date": 1780179872, "id": "26785358591147927", "version": "0.1.4", "version_code": 335, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26400896279594162", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26785358591147927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1780179060, "id": "26785248257825627", "version": "0.1.3", "version_code": 334, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26400896279594162", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26785358591147927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4263356293916105"}]}, "change_log": " Gameplay\n\nNew Merge Cubes, strike with both nunchucks simultaneously for bonus points\nImproved hit & beat feedback\nEnhanced approach cues for better readability at high speeds\n\n Visuals\n\nBeat-reactive tunnel lighting that pulses with the music\nEach song now has its own unique color palette and visual identity\nAmbient floating particles for added depth\nNunchuck motion trails\nPer-level fog and haze effects\nCleaner, more polished stage environment\n\n Stability\n\nFixed intermittent launch failures on cold boot\nOptimized graphics settings for Quest 2 and Quest 3", "created_date": 1779785115, "id": "26717234974626956", "version": "0.1.3", "version_code": 311, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26400896279594162", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26785358591147927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779744259, "id": "26712236781793442", "version": "0.1.3", "version_code": 310, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26400896279594162", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26785358591147927"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1779742241, "id": "26711996555150798", "version": "0.1.2", "version_code": 307, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
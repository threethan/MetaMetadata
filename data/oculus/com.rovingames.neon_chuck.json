6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuKnRTflfRsQ7kNvwH_dnN7&_nc_oc=Adoz8bfMKTfBrkInghslp_1IrmIkp_OIPN979x20XiOy5xcPQDghjZlEmiu31ePTWDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mLvaYmGZzSM0GJBAVrTEV9fLCCcp01_YHns1uQf8pAw&oe=6A43B911"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcIdEv3b9yUQ7kNvwFqpt1J&_nc_oc=AdqPdh4VxtUgsTBYDOSWwhXbJGcWJK2i3vEFN0z-iKGvocX8QVcsR0N6UVhfX4WrowE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bpK10YQDb6MkMnqtczpRPGGppuxgBVsmC4qLs3d0HgA&oe=6A43CDB4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2h_Cd1gqL7gQ7kNvwEdjeWY&_nc_oc=AdrKQmhh06oGmNO16QFfTq3_zPr5Cx7gGCItEp8_hml7GegRrxgcrR2Lx3JPOw_wbhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MZAOG2TTY83LMrDc7CNxSA5I2SyzIh47ViOoZupun0w&oe=6A43CC06"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cxb60R0wa8Q7kNvwG6-V3-&_nc_oc=Adq2QUCeS1ksB_Rkg9O3ThIeeSYfTfvbFCtqTpTAP2rfXc67MUkbKob5fkMSMPfvyxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N-8eLlpKIIMX_03gfW2Ria0yLSU58LSEeZV9eVLeUKQ&oe=6A43D2FB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZ9sTSKIQngQ7kNvwHye4g9&_nc_oc=Adq4c7M0XuMPWyC00kRmY9Zs58_-0NgywXE8aJ4IZGD1lPgqSCivlcCrfCmR7iNPNuc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Kbt4iiEryqtOeM5tRXKA-y5KMdVNWbe1GIF3RrLLjtA&oe=6A43D39E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CZCm9lbT3kQ7kNvwHC44SE&_nc_oc=Adqmhm05fjiNs3JaZSXpeIOJydysNrXtWwT49-QlBKMUhoPuFiCnWiP9gKIZTHcJOyA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yAwbZo_9Gn34qqo4XKc6YqT7rY_E_RYA6CDAGI1azjg&oe=6A43BFE9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFJWeoRszoMQ7kNvwF3osVk&_nc_oc=AdpVqHZUp3aCOAw_ZcyKph5qRVeMY8uusd6aMPWp-I7iF2361ck-b09zXy_Z6ue11DA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89d7PePw3azkpU6TDpFRk6Q1mndZC6TNB4LPImMyc4bA&oe=6A43CC2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uNGhIBRXdQQ7kNvwFAjcBh&_nc_oc=Ado9pB1AuLfZpOEoubb0MuR7vHd2Nb6kFM0sVw59rlsSTxAjKpViIs97PyHRLj6fM_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Zy8u1_1qrfS7zdp6LzG2Xx8RWjUw7lQZ99Mb3KAqxtQ&oe=6A43C42E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
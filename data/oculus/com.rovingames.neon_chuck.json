6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnEPdhPeD1YQ7kNvwEfe93T&_nc_oc=AdrOk3hfefXePcLZumC67HLYERlLoZLrCmvIR_NbvE66qBD93AH_W9pl0PGyArjLsL4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM_VWDCvDsyeZ9jyFP6DhhNyDfLMGC3CGifs2gO0eNRA&oe=6A6C9791"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFHd133DL-gQ7kNvwHH3xQy&_nc_oc=Adr4GLNLaHOlwTDZNkxiUYAXXocFpF_DS7nyiAmpWCrwr2_4wwmA84Wn6l7B73a3FtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRoRHowOzMRXIN-88yBUjRwpyVr4_ZcGsQpBYEbryl4g&oe=6A6CAC34"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCkfSVnr4pcQ7kNvwH7cdXH&_nc_oc=Adq3ZZ_esMW8pyy8A1TBnk2kCxcTdUuxus8I8QJCFKMzkdA0P5iHSBIwuhC6dLV3NZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk9fn11f4NRqP4Pif8vGxWsPVMuvAisxthA3e6aOLLQQ&oe=6A6CAA86"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f7pNPmbAegQ7kNvwEFcw0p&_nc_oc=AdogFK-qSyhFjKU4RDEdr2OJYAYNTd2_Epfz-vZcleAofSPFNIy9Oxe-1-zXsxGvre4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDurDufdgtPaQ-Z1-ucdI8EY2LVtSavqLT53XeBrbx0Bw&oe=6A6CB17B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRhkZ45IEGcQ7kNvwE59alh&_nc_oc=AdrWHT8GHoqBccbayHOnKmrZEOo0IN-FGSlqjv43JlctWM9N-H7P-0zMhlGGBiUNxQ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV-4JeGvZQ58l_YbHeO1CE-HT5qy653WR3hGCrHtAnLA&oe=6A6CB21E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6wqsxwCXVYQ7kNvwFT5JnB&_nc_oc=AdrPrP_2N8tK2P7PFUG9A3nW49Zsl6gIKiAD4RZvWmH5IzXYQ_DErmcKJx5knlBDmrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmATKqTn6BOlPrKjEimXhSzu6xLYMoemf3I9bMp_VWQg&oe=6A6C9E69"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8xAkqXKN3kQ7kNvwHnzr1a&_nc_oc=Adq-Al7zNLhmmFY-QbIv6TfEI-QFONMOtn7D4R4LNS32LkMfJmmoNaklMFL9TcAHNn0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9z_5LVmgsq2n-o2tmggparqn-lynkF-HVPkMfTZwqeQ&oe=6A6CAAAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaCCm0VWiLQQ7kNvwGVHIsm&_nc_oc=Adr7RJ9sYBwrs4oTSnWRoPMkEgl3I5ESJiorNJakMYNhPunTIZsZHbhzAawdIwU7dcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHnR4IjQshhu4uhMzNUSBSvGY9m7tVlm80ULLhP2wiPg&oe=6A6CA2AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
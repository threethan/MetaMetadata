6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWz2YLlRAW0Q7kNvwHMy8Up&_nc_oc=Adr63EAHMCX0dWlTg0TCRZ-Sd4zs41NFqIDraxDntHltViE-aVp2ZYUB2fypxnB3tHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIytaVpMYlYKzgvMklNMKbw3Kcc0Rm70Oh9bZ-4h1KRtQ&oe=6A9EB091"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCIi2xhz4D0Q7kNvwGHQC3h&_nc_oc=Adrjr1IYhk4gOFW6w7V7paeBM5jLT8mJpfDyqRVU-Ha6yRdX9-2kdVfO9ITh3ljwkG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtjTmGo8_QgXZBDER3hm47dtk3q6-ZXI_F05HZJBb6og&oe=6A9EC534"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT9ygyE3ro4Q7kNvwH1-n6P&_nc_oc=Adp20z7MUpKHuoSR-1dSJcAeLfBzOzfyExlcz3LC4O8V182X2wXr4ZqjSxauRiNBUS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4tmtcHVvsxIRmHnSmhqwJppY4WlRd62FAFjEaRLq06Q&oe=6A9EC386"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ejbG7M9fEYQ7kNvwHSUG64&_nc_oc=AdpNRZra2aapiB10rQGpiXIMcdthYZvM5sDteAbkbr9w0AOAhai-brcQJtCCgdtniDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi2uHJfQV8k7PxSOY0YMa0tjmutlEEJO5Pnbj3eZzgzQ&oe=6A9ECA7B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB2RLrTVPCEQ7kNvwFu-vNz&_nc_oc=AdqgMDC99qxg0lCg63yqckF6TuoeE1bQyfsVUfmX8NmE8X52tI2BcYPyRZWbPxaZexk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJK3wllbOWrX4exm5m_GdHICfYzN4c1C30ayoYZM8UdGQ&oe=6A9ECB1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YJ1S8UKq9oQ7kNvwFsoGcp&_nc_oc=AdoBULQ-qRjKaUYGSXjbKGy1MU4lSGQ6iumCcSQq4nBymZXPys0BdHCjzxKhk2zHWMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-bq1Y-HEg246jsQKFAdULJ1uYErzwaxZcAEu8Il8vmQ&oe=6A9EB769"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPnjWVniB78Q7kNvwHbUUnt&_nc_oc=Adrc0F6ucyTQ394kUd0BwU3c4bsv2UnlcK4ZAq72-KV9GwjTbY5cRcj-eqW0RmNHB04&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBxM018rnmW6Ode4S9wh4lDpkq9CQajxtaHQ0QxNNIBg&oe=6A9EC3AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCTJovaE-wkQ7kNvwHhpogi&_nc_oc=Adp2BYklHyOs-03HJD8_WDKQuEbt7AWRbEJF38aHqEWyp0VNqo__p3kvPbEJrB7tBwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsz3XZNcI_lYcvxaLhJoFwklV6IM7Vy5_AOq5cIQDgDw&oe=6A9EBBAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
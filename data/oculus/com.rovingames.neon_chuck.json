6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFz0tVIHbn8Q7kNvwHYbjpQ&_nc_oc=AdrQRRnG_hFpKf3r3UfRgthU-pssrnEQYRVtdh1fOD7hIYhzsnAd3fZpdrwqXS_lTa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0oPEke5_Lu45zSlAfUFt0G8tYJeMSAOORwkSSzSCL8w&oe=6A4CF391"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCv-EgF-Bm0Q7kNvwFSZJgS&_nc_oc=Ado2Va57G2BwCkTM3lFuUKyw4zU466O9M6VXajVdhkI1fBFIw06sI_9kpXlZCIKXaR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzwZbjaFgre-SRi-0kZ_VYGRo9AFH52q3P8koD9pXIEw&oe=6A4D0834"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHBMgTq8jR4Q7kNvwFBc7sk&_nc_oc=AdqOJVlsKjWwrboykhMvMycPFagwfZDZ5EUdBw0gQwQKDmh4jm8QHcwBLbjGMyiBisk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpjuSHsvzyN9a2-KOgA-nLLMBA3XJaqGiVBXXPuI5zVQ&oe=6A4D0686"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34QO0pAK_DUQ7kNvwGJR4rJ&_nc_oc=AdqxMTqIZZK06H0betHAeVh9Zc5v733foT8chlUZMnBewWjmZzUAYLKd_DXY6aPOMw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ6I7HO9nJT72mAYu3uDPFs2hMnGW9kdylD6JB-ytaQg&oe=6A4D0D7B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwFfSKnLwBMQ7kNvwEoLBA-&_nc_oc=Ado0D6jAO69vGF8htiBBF5SVpBJ8wOeJIdM5THn0mXDZzx1xNAuQc3cLiVN37zV-wyw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZsvt_9GxD7yGnPgthVKc_jGeFEAGDz5xOVz0BOFbDAA&oe=6A4D0E1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7IEJN4TtKMQ7kNvwHdHqGR&_nc_oc=Adq7vohKMyaNlsoEzFNPqrsm7oWXmblXa2N8uYuw2TqnC9w5JqVpThFpGD9DBaSXNPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXzo-CPT-CaAHK1-0jEz2SWPrVR9Wna2oFyFn_LLBszA&oe=6A4CFA69"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR2f0qeNe4gQ7kNvwG6-R6S&_nc_oc=Adpsz4cUWFxP6cdLnm-ZT49A7Qn-pK7zk3O_iG4d-J1MPoPlu3T2s6naSNnfy-s2TXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjnEn9h75ud6NTDETrIezZXSRrR4o-6jumz3gDd5u6_w&oe=6A4D06AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2GyPFH30zIQ7kNvwGZWfWr&_nc_oc=AdpHMdw6ruR9lmTaLZkS0zYGCIwp3gfaEgj-LTyWoYach2nfFy4cSHFRXjCVmKZgECQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1MIvaxLQBNEy4A1T7qUKi3hLyuggZICWniEX6n8vKbg&oe=6A4CFEAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
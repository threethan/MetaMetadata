6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qZhREvTpckQ7kNvwF3_qfw&_nc_oc=AdoQX0HF6aypqMg6ya6CJ91oGOCFDHe-1HELNo5KlX9fTcNl1jmtEN4PiIl5saIrRCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB3jYy6NNxd0smV1e15OqcKXvIpn6Tyi8FGC1qJBH1CA&oe=6AAA8E11"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u6DwdzG_RAQ7kNvwGm-_ua&_nc_oc=AdoF23IajbmluIvpsXNdTGPqQXO9mFfiD-HS7eMwG2wW8fbDCOaFV95iYPXGbMaB3cY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLsnEoE6F4m8pLb8ho5WooXrQfzvcT5KTqwfV5sqbFQQ&oe=6AAAA2B4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH7h7SIe-8AQ7kNvwFTnrLc&_nc_oc=AdoZSRAyZtxg4B9RJD42DsNjHkvDNYfRgV6WIX_ZzwD9fStvmYh61ErJYPDMmD14EuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqEYUHx3b7w0V_zeKM-CSBtQLDjRrDVeOTTArySYCceQ&oe=6AAAA106"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB3qmrlPBGsQ7kNvwHMJ7NO&_nc_oc=Adqha1H2B0q3VZ8UliyAjbon1h2J496zmvViB0cZmEWHsxqWKozrTgvDU17UFGBEo14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTEC8iduQJL5lmkE3rFxT1i64ZYLlDl3qlXX-I7iTSyw&oe=6AAAA7FB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPgB8JSpdcYQ7kNvwHRYDvq&_nc_oc=AdrKWn-h2tEW-wrgEs80M6lmQf6eYu3sxF2cGqGIUPbFTpvb8HFANrqZJvAWldkv1M0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbRFZbsI66lHANjVxx-N_7amuhdJdRPuav75uFjZqHuA&oe=6AAAA89E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhbjULnaVFgQ7kNvwFtc49U&_nc_oc=AdrtVQL_HlZ1NtHyqO_57TojWIVmBCQh8PZzT4ejvH9766wQCR3wEL9Y1umKx1CLu6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAos_AoJb9oUE_HaNVmC4DOImW56TL_Ut2FprhZXv2WA&oe=6AAA94E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9vCKldX9hsQ7kNvwGizEKP&_nc_oc=AdrRaj0uOzEaAF0qSPdFYUAncvxMlvphVDlt6xAvSVBkxuPmnZOSKS8v68_dsSyzM4Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6S4Uu2gak_hKgs3VWzXgSfoXYx250Ac2Tw0gsur6SGw&oe=6AAAA12F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6LMfZ65900Q7kNvwEAK6Dy&_nc_oc=Adp5k-85410MUMy1qqL4VI3ceipfeRYaO8_nSVlHmQbT-nh6pfDfevKLyyDOaE3PM8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnbMgUvOZU5Sucag9HvQ7Vzso8mfVkFc6m9cJYg2d8PA&oe=6AAA992E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
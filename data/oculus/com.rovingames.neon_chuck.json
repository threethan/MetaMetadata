6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygQ_RLDjp4QQ7kNvwH9yQnA&_nc_oc=AdoMsj65fU6Db3qFgvDR9c0POtdrpJu9PUVLKm9f1lBot4bzz9Bl2LXTQnh4FtSqSrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsY1WyBCxJqn16XIbSbJ7lhMygucpPFDr3D5uN9vI3rw&oe=6A5E1711"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjndecpdPugQ7kNvwEXYm0K&_nc_oc=AdpkLmtwdyaUpmI1Br56f_SFKEwXIrxZQoYGhyBYElx90Rfx4xyNhg7FC8yK80F2qew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWXCRc0itavoD4fMF5bpS8q2v2FoRgO7-y5NXvMG0ayQ&oe=6A5E2BB4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km2hGWUCnn8Q7kNvwHL9adg&_nc_oc=Adr1gYggz00vZaOPC_uWz8-D9F8lKWdBRBBaEz7b22cDDYIeVdIJeRow_mauXOmFACg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMi35b5mNH2DxFYBMRkCi63w1tamUaHc-Mmts15qDUog&oe=6A5E2A06"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_zaYtDipHEQ7kNvwG1dD0C&_nc_oc=Ado-vcdT8nIIMInvXuxP9fNr2V6qo2Y6NlYweiCBEs77ssCrrelHLvUqV6ZdTpldoFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCs-TePElKAiaVLLMvA2kEh7KA0IvxE-UtVHK0_e9nqRA&oe=6A5E30FB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRq8NIhLqZoQ7kNvwEe4EtX&_nc_oc=Adr-xlrqZXVYGTK82vuO-QT2_s5sXRC1ZcIrVN70Fwddu9Aeu79gD--_X3qjEbcv5nI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAskb3Wt4yIUm0s8Y2ERGlzah26H7wXKFsAR56fm9k2Dg&oe=6A5E319E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpwsayOMNGIQ7kNvwFwzMPL&_nc_oc=Adosqsq-t2z7GSWCXhl72c0sv1uF0Cu5ml-Qg9fWbEn6abRcE7XI8l6VXk6L49Ms0xg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4AGBkgWsM9WWFLq1Nvo8JiOV5CY3NvARAl_ENH5q89g&oe=6A5E1DE9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehl6ZStV3soQ7kNvwGx2v3t&_nc_oc=AdoS3o8hagRi55gUJUI8K9gDvCbHDr4W10ichsScjBeQWOzKz6E1hikYWEYOfTKrjOM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7Pm3gkuyv67PGftbuDwjiz-sYWlzvygFPO9ZXeYQSTQ&oe=6A5E2A2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja4O9JyS5M4Q7kNvwGYyL-_&_nc_oc=AdqM9OnEPmIBCnD0PYheC9h6xq5AJc_L9ktQOLGTDDtNpET_PHR2hybe-f5CXFw5hNI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjznvp9Fwxw6S2l4XPhcwLQQ12NvgnA4nClfpuOLE8CA&oe=6A5E222E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
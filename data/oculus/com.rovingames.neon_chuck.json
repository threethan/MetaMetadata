6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv_PlexC1Y4Q7kNvwEtY6R1&_nc_oc=AdqwXnmEeZRuW_m-xz5YZBmpDWV43sq20nQfD7eSHVf86Dxjm1rU_yD6p5oMqu61MOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN5__YrszZL1la9ZnKX3WTwr-9J-ugkJe9zLk6FqLDwQ&oe=6AA7EB11"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOM2YwZpKVgQ7kNvwFr48Ln&_nc_oc=AdoltdGlp0gXBgpu8AvOIydzbg86wvqcDMVdvOcKredkLIvWCc6fEhaj28Q3f6Maex4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNt6b8hNtalzQvLiSp8jGPd6p59op0EwoUMtsgvcQJrA&oe=6AA7FFB4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW18VY874iIQ7kNvwGuyzWM&_nc_oc=Adpy2E7ipAezWfmAjMQnEjAqMkqcs8iVGdFwdG4qtkYDlnSibHbg5Kwjy5dd9GFRhb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkhuv2EhYyyBaCkJHYr3hD38EHbXDLug_yy2MUJgfSeg&oe=6AA7FE06"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYDYfJIDcU8Q7kNvwGILlww&_nc_oc=Adqe8zV8YpC-UlihaFZYOAcceNUtKo4BU6nIHC0TWVLc1O0WzWR0DzYnek_xA7Wv3ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqKGopMFjUHuDVTiAisvbruh7BxqKJHE5XCEBrz73eAw&oe=6AA804FB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvvSTjeC4dQQ7kNvwHjTF9D&_nc_oc=AdoflvcD968MJKq3PzwlP_FP6pJT-KAoctrbWqzjzIAMOLGVMW17iDV2wSYvF49KD1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgFO7PTvR2Yp9IxpL67Gzljokmbaj9lbhqj31RMAweHw&oe=6AA8059E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhbjULnaVFgQ7kNvwHXzd2P&_nc_oc=AdpxoMYDY4dFMT0UEtgD6UGziWD3o3EuCPoeJj2jWLW_fE0IfKAbsG2fe8wj7jaYTk4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg_n-sL1Dlvy0a7R6tNV4_zrMkmxXP5VUDtzkLoqFXcQ&oe=6AA7F1E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQu49jSmbEwQ7kNvwEgzf7C&_nc_oc=Adr1pEenIwikRJn-U5yJOm96ro04IpG9nrzJMDwxMmt32_nGai3GPtSgzAx3PVijtCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAKqy7mO98zWTST4ltvpoaNgVb9TUGkLeOj7fgCb8LNg&oe=6AA7FE2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8To57mi3rGMQ7kNvwFUTgM0&_nc_oc=AdrCsOv-X5fty-yTwWgEjWglH8JqcC4UmtzdBt71mCBYCxfWNCL-AaEhg54qvmwxQVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9SOvqB6PgFjhQPbOSep6F-BaX6E9qXMT9zF-LOGO3zA&oe=6AA7F62E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
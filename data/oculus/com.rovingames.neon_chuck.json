6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdFy9pz_SjAQ7kNvwEdbb_1&_nc_oc=AdreA-U9QtciIo2MrX6JQGB9FKb25LrmqHp57uHijxnj6tpsVB-BHOuu0902SOqY7zI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKopg08wdEuNRvq9_DlqZtNOTHw-CtEr1OkisSMGmtxnw&oe=6A99A2D1"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etNER3cdEtwQ7kNvwH5fJir&_nc_oc=AdqcZ73oVlktgGSEQ2jOci9cQekEBq1h27pVTGTidL1CC8E7sg4iZ1PhB-blWWvck6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0sIKZOSXMkFNWHwr2hcqpzyP4F-WwsWIbBwHm0dNIoQ&oe=6A997F34"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maAzxgTLaR8Q7kNvwFsWNMI&_nc_oc=AdoC-8l73_nxyMss4hC4Pc9kdHxuWKuYER6eOeIayv16ms_Y3KVo4ZwAO-8DRzkilys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrVbXwDdg6cpg5wGhCZtRiTugaTqZOShwMNyycKATaXQ&oe=6A997D86"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4joWO-G_gd4Q7kNvwGAXVO6&_nc_oc=AdrdPMPjAvy4nym6Vu0Bh-crvK8nKpuI1Y2N_yPvRsmHKfezmwLAnM91rydOF0wjap4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1GWzJfjt261td1mYDfYOvLdh5zeb-RgKaFBMyBghetQ&oe=6A99847B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUVUIbBofBQQ7kNvwFMo7Pp&_nc_oc=AdpZXWTwCelfTdvn8Xz4j9Ryje4iG1UbxyEA6JYLqOkLyMiA7S3cbW8MEP47qXEOWh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSFECQzt-JSocAwVpuoY2mdqn1YHajbRHB8jBb3RoE4Q&oe=6A99851E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohZuwYZ6W1sQ7kNvwFct5sS&_nc_oc=AdrvcbXrt1FNrC7yrBqDgMrSvD8Znf2egMw9iXceFfqT0ZvwCEDCW7cKTHZWsaxxtBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEV98yPxSINySB6wqrmVxPPaTGizXJRK6gi0u0mNa-Ww&oe=6A997169"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgpwbggJzMYQ7kNvwFxTSjc&_nc_oc=Adq6uixwaP3BDJZczYfAZuLb0SRkZ-sqVmQbFXCQ5c4XcVy-dGDsCNHtUdHpUFSUXZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoKV-pBxGyVbShHzpWdbslCAACcEWDai9m8nM0mrESgg&oe=6A997DAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU8Grq9HKK8Q7kNvwGqD5_Y&_nc_oc=Adq02jZGw1YAewoN6oem2DziSzRY45NzpPPtm9NbVPHcOURc4uWF3EVCmUqf7qI7zbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZrXq9ctX01U51_OwQj3LQ04eAUDUYZD4_k8PAJdPKZQ&oe=6A9975AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5mX5jpUkNgQ7kNvwF2QIaX&_nc_oc=AdojGuUsQAMAVnItkk28_B38XFHlaFUHHeJTe_mnsMCG-jd8lpMS1UBuSvTNXplF_dk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5EBYuI5jlKCuZvEYQf6-zgINh9kNlXzcfNchRcN8xdw&oe=6A2D4F91"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq6oIV_tIQ4Q7kNvwGdExUS&_nc_oc=Ado57XS78UbaOfW-VzFMZG6N8QcFbLab2tAcb1Hmpmi0nUos-rUy_JZnm8-rtuJqLVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HjaV4WdLKW6wNlFZHZiJfbBf8pQqQBw9yYLthFz4HOw&oe=6A2D6434"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDKm9qPy0BEQ7kNvwEf-RmF&_nc_oc=AdoP3jSk365zd4vYYLWEhWiT8oP1ZsLtARCmYqoz4kr7YM2ZykcAp6480uiXFfs9xmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K4dFXAqr8wAi1Glvsd6lKo9YIPIqgIL8eWPsGoXCuVg&oe=6A2D6286"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qP-alRcT3oQ7kNvwF4xwbi&_nc_oc=AdqLgtCyA15Y1dhKJv2YlOKox0Wf_rWtlmw4evb6OoI5CjnKtXaEjrZx61vUWkS70J8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n-btYB0cYIBKNvl3Y1XYtI6zPKXNMRL7f4_EvWL_GvQ&oe=6A2D697B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GdVbbmE_lkQ7kNvwH0rmT2&_nc_oc=AdqPYuMwXjytgINdAzQJXFh47L5dV0eZT2JLZ-ABmuA1tevRwq_ch_FhITVk3g5pW7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UYi6fnWrk1DFqrtTag9zEq67qjRFK_eKRmm-vwoOdJA&oe=6A2D6A1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtE7EtoNKX0Q7kNvwGs-fpL&_nc_oc=AdqgMH9EZnhoRfMNX_zteo-XjgeQdnTzksKsU9QXaxWt-GkSJefSATK93XRMmhvBaq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87nFoo2oi2PzKj8xp-XwP9vWSdyJ22Ho0lcTLlhJV3gw&oe=6A2D5669"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJkhdkogYTYQ7kNvwH4Xf0G&_nc_oc=AdpfGlbBX6Mu8x1dTD1Zou_z2l6hjQ-n4Jhg0_9Ll8Twms_JVKT2ItCY5aEIKKM_ECw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SaXFn7pa3eAt36UckJaTm4gIIwkF5hljiHZdlgAndJg&oe=6A2D62AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SjY_jk3fMIQ7kNvwFJZEVe&_nc_oc=AdpIXK7_KQNP-Ba_HOiC5ld0idvvegXOdIVms4RP_wzsRUy8OBb5sm4uld4vg1YcwgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s4NOR6LisjlKvTZ7G8i2jhiczmTlTalI3OYqb_FWmJw&oe=6A2D5AAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
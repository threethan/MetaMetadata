6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqDdJqZibR8Q7kNvwGck_ea&_nc_oc=AdrKfDsSrUSP6jBv7e40Of6c1TV-qxTlRa3l_-w_P8LxBcpRwND9QC1W3YO-nBbItS8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEef55DHtVpIT_6MfB_kvtZkinn_fKeOm_yL_IA-LG6lQ&oe=6A81AF91"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owea_GPUFF0Q7kNvwFbdQMC&_nc_oc=AdoTVHkbURVd18p18p8DJLK8L6EQCqtXcqg8CkAjKJMG4VTx4_FZHSdY2z5fGd9cd-w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZWWMlkXa8Vp-1n_4GjCdO8RUh6ARIRObzt346_Iz9wA&oe=6A81C434"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=um_J-EUa3EgQ7kNvwEnFRxD&_nc_oc=AdqngT1hl1HtRcGbB_1Yf3QjANJ1lb74IjDhHA_suh7n4oF4LYzK0ZcQRrK7mbnKU-Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAJUhKqTJe2ORNYfrAdw-P6vt1MpJEcLwr5ceWB7LuLw&oe=6A81C286"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKbDhpFLWHcQ7kNvwHvZ9vT&_nc_oc=AdoavBsM3yMWLnhz7AK2l2Dkewbz-ijukZomJnV-4LPwgLJOgURwjh3s3jKimA3-ttw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH50RWhtY1gBcHk3s7RzYi5tQMTn__LRqudc1iGpzdzAg&oe=6A81913B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLs7ZgciyngQ7kNvwGRJTPb&_nc_oc=AdpCkHqul6W36g9xmqSdkni4_bJPT3lEYKj-iiFXF77uvZJDsexEzEza3xaQVILpXvk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGT0ES7-Eh4OXJZDu8xGqF50JSjJSgAC-eNpTO_aeVqwQ&oe=6A8191DE"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ss6OSg4AlrwQ7kNvwHtorNS&_nc_oc=AdqVhVjXLg4djrCFthgrRqLnSBXrQA3174sQF2Wt3ZpuxVVW-SbCEGiCEGhmWhzrBTM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl_LccOWviK8SNXt7RTdsn5qwVfTl8EByJFj-NjFn9ww&oe=6A81B669"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqHS9rnnTFkQ7kNvwH8g8X0&_nc_oc=Adp-sISXV7NygzFtyFY5mIzowdvXzJCb9KejMs1px4Bu84qhZhX8wjr6sKmU_cTC16Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfmD5yb10NDspJ0VSVKdKj9_HOBIY_IGzEejo8M-tYUw&oe=6A81C2AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Cm6XXX8lyUQ7kNvwEizaJG&_nc_oc=AdqiH9q_iIX_2CMGY2I-4A9Px6L_mh5Sy3ctiJR5euhejx8LlQy7JmJnEJivXfA-mjQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRl61A7CjQdiUcnEDRnb436hDIoZ6kDuy33M_5h1bVXQ&oe=6A81BAAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vaxexs-i02UQ7kNvwEWkKMQ&_nc_oc=AdraeKujN9XcyjIRy4IHLwYHzatALm-hOeTQXViXKA7o4rg6e_VBVUUcDBRYAVpncC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEiW8NRQcniXTrzzD-o28N-WwhlXhr9k7mLpptJcntaw&oe=6A4F9691"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--fGe2G9lp4Q7kNvwEybvM3&_nc_oc=AdoWIJgV5xPEH2KQUAcDf88RKeUDfBD9Re1rBJJK1eeu1JEYq2xi--cd92m_3C9WHyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAd4hHbl8UFsWr7dfMmOMIiVx3V96yI7bJZU-Njz0Sseg&oe=6A4FAB34"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjVTMWvoFdEQ7kNvwHUnu9O&_nc_oc=Adpcp4hvmumPFPdBjyVGvlUXFSuQa4Uv4PWkd0xYwRE47qAfYm3t-SGPR7Zvozs22QM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4fylav6CDKIPxzVpqUJWoIZ2K9y7yfk4Co4txfux8uQ&oe=6A4FA986"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5P56Y0x-8gQ7kNvwFaI0jN&_nc_oc=Adp8QAbj0PgHX-33R-8b_3lMax5dYDPz-w0EPQ2C4JtLgvc3UY155-ZGmk74VZmp9UE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrveLtsbnevDaV9WZNxOcelBudhvtirK5q62zKMYEsTg&oe=6A4FB07B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5thPzsAmi8EQ7kNvwEE0Wdu&_nc_oc=AdpA0I1tAsP2woqPlIpXcLChCx00sJ0GddqCc-5AVl4bI7QKz9k_8h8I7Ay68Snbs3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXMe2EgjogKpPQfKRAg88Lk6L3QsZWsJ-P8F-Uxm9Ujw&oe=6A4FB11E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7IEJN4TtKMQ7kNvwHiPBMm&_nc_oc=AdoIYGCY3lh8taem42eyyQNIqw2NHsshaeqBmeSm_osvGJsP6D-oW-lELeGMwHR2U7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeNugRdGpnJ1K7jxEo8Kg5UubfYlWgyL8d5qf5ZtnABA&oe=6A4F9D69"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-I1Y_R5MkUQ7kNvwGXOX8c&_nc_oc=AdqQBlzEEyqp4WIO8UAW2FykF1sr-HR9on3I46WVnBfCuQCTtfBOgawxsCoriTx0Cbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQHfJVZ0bJbE7EeyHJlKBkyZ3LTg0dY3xoXwdqjS2GZw&oe=6A4FA9AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLvDIh0ZrAEQ7kNvwFxwIO1&_nc_oc=AdpeMKtg-IKkd3x71k4DOgbkS0b5WicCRotQkjW-v-KWTuaXYD4w-XA0XzX7Na1JqsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuSC4zerIXJ1TW0tkviEafxWQ4S8tabjv2VepjE69MTw&oe=6A4FA1AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
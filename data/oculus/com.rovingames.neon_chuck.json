6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEd5JFh36hMQ7kNvwEhLQGl&_nc_oc=Adqpevj9AwGxpHdyFU-gbYsVW3QL6GvBl53bDowxiYa-qOPxl5YEwETnpYNtsMatOPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92svBpg5uhEe_75bGWnlUqa1JstAzqmfeLFx-uoveXsA&oe=6A3FC491"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhud67-YoQEQ7kNvwH8KIYE&_nc_oc=AdqDQLfTfzPptXemvzrP1kOYt12QtSeuu7TQyhuCqE_Ku6YjJjeZqy1zddI7qjMDDyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PY7vlu0lrXCn8ixT6tVVjNIB_CURmVTYkkVi8eTQIWQ&oe=6A3FD934"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVeQ2ZmWIiAQ7kNvwHYNiXM&_nc_oc=Adr_QgKfpn1dt8qY4sM8nDq3iIa7SkSW5AT1-3AlqXgB7oR4SoSunT5M_WJ8uBEO03Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ynKPxowUy_YibLhrZtaKeJQCI1zYaa0cPZpYKn4QpuQ&oe=6A3FD786"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkDSV4D0NhcQ7kNvwGVLuqU&_nc_oc=AdqCek2OXRVA1ETVdRug_WfzcBRae3gdkTCF8RYcTqGFi-A1yaOBgtedUb_Z3JUbPa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90x-3YE5bkI8mAFWjbd2Bojx6pIoMhexj5_CQCSk2rVw&oe=6A3FDE7B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ouPMKMhjOYQ7kNvwEAzsme&_nc_oc=AdpTwAuXyer6Myt7ZheUFKQ14cQiq4eHPVzZ3VtNYmq9NJQKqt7vKK1ovasWDY8ONEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_No3Wwf_UqHXZogu0xxLZ7hKBnmTMlS_SPtH3QrUFkZg&oe=6A3FDF1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QpW1MHB_1AQ7kNvwHUWdeV&_nc_oc=Adozi7zBQCNF3ftAJtnUsbK1qiEUdGBjpA5ap9p8hAAUPLqXaEIf2b7JrRVXnC5W1VU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-62MA3uE2t5IiiH-ayOWp4oFns62btEcnVA9d7Z9zCHQ&oe=6A3FCB69"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g66UoqnexwQ7kNvwFhTdfU&_nc_oc=Adq0kFgfqO180ifyztN8lcx6MwMmbRfjAMR8uEUJyUMIt9hkfRR3XxGkoYJPfEZqMbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YkFsIuP-m1eUJA5kSOAS5MOFt8UNeT0VMV5cMxkuUJg&oe=6A3FD7AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeCqmD5JT3UQ7kNvwGGVGir&_nc_oc=Adr_o3-F-tW50wU9UrR9Ne0MFFiNbyrH8745GecUkYRDXbUxhMK_NVDq88m4dIvxDV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_3xhYBTmuGnMnR_Ed-ZU_B9AunYMWic8d2oC7Yc8ekg&oe=6A3FCFAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
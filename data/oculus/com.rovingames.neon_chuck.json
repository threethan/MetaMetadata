6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hLO7nFntPYQ7kNvwE2iOyz&_nc_oc=AdolkPsKIsXST-tGckZXAaRpQHrdUx-JopuOgT3m6DyvucZpm5BxPGZ54iT-6ck_SE0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVKqPXIXIgkrYABQLHcPVuK0N78BUREqei0rdysSl3Tw&oe=6A5A2291"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgZn99kT5PoQ7kNvwGYKmCu&_nc_oc=AdrQDVaa_DP0uRuxMRHE-MSM3npanPVBidFor6XyQkrWFcFJ1qmNyY5jU8YBSdc69Mw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOnE6XaYYhXZEBQWcmQpSdWulWtTCDkAXLfCQCyW5yGA&oe=6A5A3734"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zxcq9BOcNUQ7kNvwHhHgJC&_nc_oc=AdoqmyxZsv2TQLhIEL1wM992cNG4jOXsAorxG1oNnPQ69aqZWdbcYQBkc7PdJG3_lAs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQlO5xKgff2kwF7LgQYyiLlLu3C-H3MNySi26yRr8D4w&oe=6A5A3586"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEndTX47ZJcQ7kNvwH4Ypm9&_nc_oc=AdpLjT7m-J4PaeFBw1_PpYzPnWsOfk1v3ozczLzFIZEVBkwPtUlEPGo_BdvMgnMT6HQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmsild5q06lt9T-OHdZA26DXogKJoCa8Hbc6yuRVvpVg&oe=6A5A3C7B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHxTKa7zJ-UQ7kNvwE8-g7P&_nc_oc=AdpUj-K21_DyqRW-pbLTneMFYqVU2MGbp7GzUdIER3Z_6YV0uwMJorqMekN1Pr4Rtbg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpKZCCP632pRioBkcJPD7f9qu4x5oBPajBKEnZyN41Yg&oe=6A5A3D1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blHvcBAd9AQQ7kNvwFqmU3C&_nc_oc=AdogiEEvmZ3P-yzU_gQ5NO_gb6t0G5SUUQoWb8dyBtXEDGtdPCEYRkv7GtHttPkuiVY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZUbHGGckfHGi0piEHE0M8TSlwR24bXx5cLYnkQd6iLA&oe=6A5A2969"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GksRr01xluEQ7kNvwFCWLcQ&_nc_oc=Adr_1JtFz__NtmDJnjzBrmcMWxR6lS3laqOoMOU8XYae4WrXM7Pb4IFFCgjws_Zd9SE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADOeiGZY_Q640EQtMR_ZeHTaLiQKDdHX0s2rHQD89YIw&oe=6A5A35AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SkA8ryf9xQQ7kNvwHFLla9&_nc_oc=Adoe6l92ejwNsIXpQpZDQ1-G6yHRSdbZjrlBPE82GV6JE_UJnJ6uUJlQhIC5ApL41Nc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARcWtsw9IGao4PzKUREBtaAh5OmTfzB_CJN9Vk8fiiqQ&oe=6A5A2DAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
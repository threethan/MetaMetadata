6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEd5JFh36hMQ7kNvwGBEY9w&_nc_oc=AdqGHHsl6ki68fFvnH10F-sHfHr6quW-hhY-_3Q4C_adKNeqr68VexR3gcHChx4KkYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bQApcuy43i74h2urGOBUeVMBb3009jclhoafowfhwJw&oe=6A3EAB51"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mhud67-YoQEQ7kNvwH7NEoz&_nc_oc=Adr2XZK75QUdTV0MhxPg7BHNNGmvfn5Izh5nw1EGPCNwvB2ExiInyojQlqPkSs2D3vc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uTMVEwQz1AtzHhm3vo_EDG6-IxqX2jGRG0oDIVt0Mqw&oe=6A3E87B4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZobbV9f_joQ7kNvwEup0UC&_nc_oc=Adpa1Fjb4NxjAKnlY61QlVEIXVdYS28P-tRfksomZrjIqM0UvR7T_1H7NZF2koXIpoY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VNs04uZ6-kXeyzoeMrIoqNg6Nw4nikLsJnZVg9s1NBQ&oe=6A3E8606"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEtFMuy2bcgQ7kNvwFWTlPy&_nc_oc=Ado2LnLL1Hq4tf2ARwaPwPIV8RcjaxpGd5O4flDrTdTx6kaWRCNnSPjBTvkn8fyUrxk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4xuv88D5I9vCMY6QyjyK-KL78Py0Lug6oxJgF9yPnFw&oe=6A3E8CFB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ouPMKMhjOYQ7kNvwEHoAAr&_nc_oc=AdrIw1OyK2H6_KnLq4ZvU78Tqk0f4pEhbd3L77p77686wDSZQKpZu4T69yEpRvFc5HU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mEk14RFzOVEMGsyMoo83wYvBSlY4O8tt8WrTmvokzXQ&oe=6A3E8D9E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QpW1MHB_1AQ7kNvwFQvCYN&_nc_oc=AdpBasK47l_2cpvzxZJPTzmlENbfEFdRM2Nvc0nsGe_gJdB8ycenqIjxvYcfuR5AqiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rKSNYwvgxQcqskjQ5NMpcSnnJQMm0Zahk8E-v-xQhAg&oe=6A3E79E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIRfv_FA6JkQ7kNvwFxNXgN&_nc_oc=AdqLMWNo_-pvunXqaQ7d74NhpCKNobGdiqKXlCCg9SZ3D1ZS9-pTxznOyxNluykCDuk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4t8NaH_bMdj0HGBthpJiv1qia8fbX-T5LF0EcQA-BgQ&oe=6A3E862F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmOBwiK4mJgQ7kNvwFEaQEv&_nc_oc=Adqe5BVsaHA62S3imewwBxj-ymrTkXoR9NIPFF9cYkwqwjU7-okdhPh-9GIsJWlaxZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ywmVHYBdradX1UkDiK7H9kAETrUM8KThkvQwmgtQ58g&oe=6A3E7E2E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
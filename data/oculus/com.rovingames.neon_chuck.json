0PUcsd4QhyY5Asyd8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TnbBrDq1-TLjIWpbly_2Lyvi_MGjvs0x_UyT4ZIYulQ&oe=6A36A49E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nz40OwD2KZAQ7kNvwHzOMsD&_nc_oc=Adot9TlO5ULIAPeQeTW-OhX7GpFF3EpJzOgsWzyWErQuNGfBtSq-5AKvuNlvjCc-Q7c&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZxVcs-PsRxm69rkM3y4qPN87wQpfzDIHb5G5ik9GhrQ&oe=6A3690E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y1-wyTAPxYQ7kNvwFfwgpl&_nc_oc=Ado-yXwYqQmOAIkUsO4PsvGRmnIF3IXpd88zSstypkakflRWcvSAedJF_HMxuVCsrXo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-c4PgCYJwcvjBVLHuDT2PIim7GlLpB1FTU1SW_6n9Zhw&oe=6A369D2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWxtLsncG5gQ7kNvwGvjtRK&_nc_oc=AdqBr8Q9LEhIpA7sCRqcG-fRumJOxlTRZc-TMhPPkIWja16ZCpN7o4pKHV6kPDbOoKg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0ZHNJHnAmLPHEtA1SvPcFd85CjzZSHGBmg63RuUZjHA&oe=6A36952E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_
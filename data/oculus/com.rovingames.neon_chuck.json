6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrNxYaA6SOoQ7kNvwGMhSzw&_nc_oc=AdoUtfqxj12vKh1MEjo3Y9Z1kjzYO3u3LUa29xC3JSEnLVWpWEsEpWzWKjmaIo-zZZ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSHLkJTo5Cww88M-gite9AZDmC91E7zMDm4x9UWKpZNg&oe=6A6F3A91"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LFGnDf7VLkQ7kNvwEeMowd&_nc_oc=Adqg3_SOE00OVrsgA_vxZHWSGQCetZRVRbR-jTywzDysrk98vxsy39OlnJ5hy6KBrac&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYOkq6LSjsJnn0GfBKXOiTduCw3VyvJzzaSUmn9wqGOg&oe=6A6F4F34"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSdU-Sd8l0MQ7kNvwEJC0Fc&_nc_oc=AdruAop6IAWi-5RnN1vQ7i46fgefpF8dZygVnF3cwDJccOXPsXyTl1FUsocL5NEQq-c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc4dl96xZN94baR8PoL-asXexVWNLsu3hfyF1eJstxbA&oe=6A6F4D86"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou94RsTpLoAQ7kNvwH8_1C6&_nc_oc=AdqcpG3rrP0udEQqv8UtjWYnPd2sM6j-AYDIZUbVS7FxdFy8FV9lNAzq9JPhFT9MyXs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkDi0NAmRLEDT3hFMf_qL2i7_PTUcBqxE8IIgLgqGaeQ&oe=6A6F547B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq4NL_19OJAQ7kNvwGP2iBb&_nc_oc=Adoy3mwF_us2gX5bn_hoApeoqS3tMEXXAPl3KSlC6x9xizbXM17KQYbBhUDIfngHYx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwUcdXhKD0XdDBou43yYWvsV0kQ07PpGM3qcUNzD2Rgg&oe=6A6F551E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6wqsxwCXVYQ7kNvwF6KAwK&_nc_oc=Adp_GTCBVNt_dO7LONnAFdIOfLVab4X-At9ris4RlfYlIBqRe7CN4vj3XzNQ9Xy7bho&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAORT98nn--kWourDifNJDrOTFOoHX3guzS4dn_uy0fYA&oe=6A6F4169"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqS739oRANcQ7kNvwHPnTYG&_nc_oc=AdpP3io7ykxoqQnwFL10DUwtAnhQxpojTHjXEUWmQHEuDPIjIqM2id7-XL3gZpw2zi0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7YTz4lFrz_wLgCloZpOMEEs7dHHRHguF5VhVZ0qV_6Q&oe=6A6F4DAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfmLyzrd_9IQ7kNvwFCjvM_&_nc_oc=Adqn0niH3u_zFeSeaRSSSd33XZLstAH5-e_Ik7cKgJRP1BB3I7kEgpGxIlpBMYSoo08&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN_-t0jZLCFNs6kWsCWmSBAVp-aeDDs03t_VPmaexYCA&oe=6A6F45AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQufrtTg-lYQ7kNvwFikDWs&_nc_oc=Adqd_LkGuUPcytoTPsaO61xDCTfRK5dEI6kwWVJXlf9zmTN0RkF-d3hw7QNBh5am5l4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD8YZzxyg6rjBQuUUCCEuNXRJWVzHaeXINxfh3BL4q6A&oe=6A732F11"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rOpx7D8AWwQ7kNvwEc_m9C&_nc_oc=Adqn7kNe5tqtE6LCvH3k9fOVmypEuPZnP_JmxSxhusltTixf9oHkLsI_FPZb0ZSbNHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXXirXXnuI_HNcCSjEJQj3O-SWzUl9e9XZiqJMxtTd7A&oe=6A7343B4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-Fs1Pdrf1oQ7kNvwHHNxpA&_nc_oc=AdqausKTmKE_iuR-9Rql9Q4bemf04DxA5uUNvgdD_n9fITg-q2m_4xXq8aHZyIyFKB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjJTAQrgXpZ-QNbjXApGR9p9gt4cSbEkCRsGCTSPiPHw&oe=6A734206"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64PT4XXEiO0Q7kNvwFEUZS0&_nc_oc=AdoNqNSNKKuvsrlv3hEgIf44twrx800-6EMXhvig0_BiXWn6RL87qV-Qu9BVw6Ws60Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKGDSaO60ZoUWjP6MB4YZ1eD7XzWkI7wSQTdujITTQkg&oe=6A7348FB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VU6k7dlN780Q7kNvwFYzOdW&_nc_oc=AdrSCrvTvVl7HfweqqK_4vCRw1X7GyKNI8G9ginab5Cbxj9Fut6gR0apN3v3pUfzi6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9ieR5sIM4Vu6PIE8g36Cy63C5BDELPR-FDqXgmtvsuw&oe=6A73499E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2fiNqUwoTYQ7kNvwH3uUKH&_nc_oc=Ado_My9iD4KuMxvSljm3U0UYN4r4YpmpLRw_VMNgW1yR2kWyCpzISvaUkrBRwNXU7SE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcTJL31ZFfnAzG5gYXQNWnlNmgb5a05GL0AbYVJ-K9lQ&oe=6A7335E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCPWbFqmxuMQ7kNvwE7FRMm&_nc_oc=AdqZtKrRcpoGyqIgAAJBA4KFjriPEL0Fw83pGp1Qc4aDLrmrmMz3b8KQCnaMEL2Pits&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ5jK8sAekY-PZm3ctx_KGmi6SdaX3eo3ZXjf7j_PLzQ&oe=6A73422F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1p3xU7EIPXEQ7kNvwF5wgQt&_nc_oc=AdqwYKNl8EYQ1FJVVsHp5iLzAETV-E6Px27QgM42fzCvAwwNbAYyLkSgRqmeCa9mmco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF70a6OrmPoR2qEqjxRsM3n9u2KEvNofwhzp-xqWvoCzA&oe=6A733A2E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
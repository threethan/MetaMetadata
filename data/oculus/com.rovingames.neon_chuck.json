6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-wuvm_QEzgQ7kNvwGHRfvL&_nc_oc=AdoWaXuEz5rV2jx4IcFR2EkxfXNDySVtbqxjD355QNuX_Alns8uxU5jXpQHPvPqIIx0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YMujQ6miWdbiAuZyC3FBudqHRevqlN3-Ttz2yYS0rTg&oe=6A329591"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFaxHAT0CPQQ7kNvwF0SCG3&_nc_oc=AdojoE77bmKqXSL_iHZkPDx9RabSknEebaQ0gsBKXH4yuX1e18oRfKdev5bxGBQ8SmU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--zEYYcOnYIPourfdk8RM5Ou43UBPB6ti2GWOXWvvafQ&oe=6A32AA34"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFVrSAs0HvkQ7kNvwE4VrlK&_nc_oc=AdqpHu0LV-K2rU8vDiO3FXTz-6hyU2e3L8kUdzKSYqejwnN9FstVGK0rVUnupDbiZWM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZucJ2c6rY-p5bjwargr5J_omYKYXYzPW6z7A5k_CvYw&oe=6A32A886"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCyiSQ8TXxQQ7kNvwEYMbhK&_nc_oc=Adq0jNBJj5hw15ZZ_GJt9xjZGRBy2hJHQkdsUrAYInqsPpZckVuKt1Tofb5qmA9Kark&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tBeDJ6J1i3rujeIc6E3HYdOZAfkIlNBWJCiI-MiyjfA&oe=6A32AF7B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2ADA-_UcdcQ7kNvwHLvtpv&_nc_oc=AdpqqgrjsMekH0gh5VWkbu9clysO-Vzzmn-xvLtoKORsz5u7FEir6mFMyV9n1OP0GPY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QiiPAHsc-m00idHg3QyMUC4_RLeH-zdoGK_4G40S7Kg&oe=6A32B01E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-z18Kg3JOoQ7kNvwFDaB4U&_nc_oc=AdobfMiQRwoGpyMxTgvuThwE0llL-or3T52tHyTjcul9juHRvHa4IRt6gavNmWwjH6A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9n5xWTxp-Q1EexsPfd-KWwl_IRC3SzPVNBUGp8chYa_Q&oe=6A329C69"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxtRqUuL9iAQ7kNvwGIhfV2&_nc_oc=Adpaz9iCnHD-t-gClUdzgx5282QSvnBiAsVilV7ZDgYEXYrlDdYSz3hqZCqunJqzjZc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cFaukQYm5OPhHbAf6ivPF52m5nJ3YFVvGvkeb5j7sWQ&oe=6A32A8AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2TRecUu0VIQ7kNvwGaVvm9&_nc_oc=AdqCsCg4rhJH36x4Gk58KMsfBsVCOrImQ978lkGUlTFXYf7SSlaKZ2LIDXoO-lmmrGE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E7h3-5VXGG8rXpeVLft08pjn9xa-e6RQc-zpisNXtJg&oe=6A32A0AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
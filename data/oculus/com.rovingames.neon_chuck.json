6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6_Pcgilj48Q7kNvwHi6c2T&_nc_oc=Adp82hWPtXbD0esrICa7NCy8ByTx4GYTL9AbfmpKPgXRGpwX8eH9i20zA8y5sLSYSCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjRRxvkgWib1_neNq_8WljhwOSBd9KrAbev6-c63uS9Q&oe=6A8C3B91"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0ULJYFO2jkQ7kNvwEgeqgH&_nc_oc=Adpg67nEBAgtGqqmBC6hrAupRUuqlEol9v07NXaGvYTM0YMl0KdZdhLuNECmn-J2Q4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ3AcTJ7qu6Jnvm5cz4h9UkicHoAnEBwChra-R7_gggQ&oe=6A8C17F4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJUQbbiPKxgQ7kNvwHmk8fS&_nc_oc=AdqkKIWJhCgaT8vvTFmL-Xh9Hv1KZ4yQIc62FuAf5Yu9lYrRwMlyMQG2JAQYPzBEVZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnJPzuOoOe8dbF5UQdGA7IstGgrXO8pnw4NPfHQk3V7Q&oe=6A8C1646"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll_KgbP8FP8Q7kNvwFZkjld&_nc_oc=AdrlZgpRoPNN-xFQQRpcVTaJ57b9GpW0gy3Z7uwquy4CMWId5ueHVpapU5EbHhuPbfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmQNjZ7Ea7yVCwB4coi7dPxWurUBjVwbttc5wQ0X5HAA&oe=6A8C1D3B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2ipe8U-z-UQ7kNvwG7oiek&_nc_oc=Adojf6f4OGTQZ9U4oI0vwCCfgh6_Xr97K3jd68SxLTt15xTyb99ZvHSUO947r_LUjVY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGliLAnMysOxB9n4EZalp1PSkfhHhKtNOp4LcnnmPuwLA&oe=6A8C1DDE"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCgOfqWrR1MQ7kNvwGzrc55&_nc_oc=AdrH6jAuILAH4i2VxjglsjXICYF13cOT3F01UHLZ7KdHD1AXUDXkglIGADKgRGaT-lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAYKHKsylhpYVslKdg5_678dbSHoOC9_5FnZfbbyzQ6g&oe=6A8C4269"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KT6q6g-tjfgQ7kNvwFSi1Qp&_nc_oc=AdrV3-QoPYPG2pqedFlLB6bKvmYnZtqYM7n5MHRVkkjQlu45CJx6Ua6KT6ZckY9Xz9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFqwJfWvY6Y9rxBpn9d9WIcrQiMArC56T-4vj6KqByxg&oe=6A8C166F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2V7sdWsqxQQ7kNvwF19KYk&_nc_oc=AdrpXnxw3XPqW7dKnHf-hXUxdo48DTqimoioXd5GRs4hNq6hsywcUAPF34A4ZPGHDQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhsoaXS0FzlenN16-caBu9MPgvDYHBwB8-MPXO8taLQg&oe=6A8C46AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
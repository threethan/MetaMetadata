6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dv_PlexC1Y4Q7kNvwElH6Uv&_nc_oc=AdrtcZkMqvxg2DFAA4FWac5sESSnJamoPKZa7ltUm49xSZwGGKmAXoT25P_q9SfI2vI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISYh9Sf9B7dWEBOD8Bm1ekREaUT2uIwSkACWRe0KJP3w&oe=6AA69991"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOM2YwZpKVgQ7kNvwHZpAoW&_nc_oc=Ado5MuffYAN9MpxuXP104RY3GgAcKU8a3ADA-9lVAjny_zy9l6te48qBKJO5b6thXgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2qf7GNz_TPwBRbUmfV-ShrWzTcRwBYKqq2Lj5Z_8KTg&oe=6AA6AE34"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hW18VY874iIQ7kNvwHfENcM&_nc_oc=Adr43poe35LQ-SUtFzmdwFHOy1iGFs4z8KY_S_XirKuT7IiLqmYqfsau7VTjvKhd1Og&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9BDpxtKZuQJsoLZ0B27G3yF86nl7iF2oJ_t0gs843sA&oe=6AA6AC86"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYDYfJIDcU8Q7kNvwHdwenU&_nc_oc=AdqYjLlTavyUSBMqCjjvvGggs3PxmAJvFZHc9cNl4e9BVRKWg7sxNyxUyQUv6wKafVE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHJ8In__AwjKn0xIhBvaAQgZkz3zua0WlmekRrRfgF9w&oe=6AA6B37B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvvSTjeC4dQQ7kNvwFuqbpi&_nc_oc=AdqKNCbFFTU14f8mBZFr1hQmuuu-UJgAt1HM5oGK0_6ZdCa6m4An3-bbK4Yjio2ikPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtkgnoxtyqRzYiQk4Y30yBfzVcnfZ6pOwI34uytxxkJA&oe=6AA6B41E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PquMqs1lnHEQ7kNvwF-X6oa&_nc_oc=AdpPHhCepaEJFzFkhhEg_wokHSWAohhMmwZ_feGB6BOhB667VMj889F7Od0JOgWRIec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_YVd94BsRYiauMo76JfW8iQNYv6VlyLVcpLTBEfCHHA&oe=6AA6A069"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQu49jSmbEwQ7kNvwFGruR6&_nc_oc=AdorlhRN46efQnKuRuAGf2uZl9a3PybtbpV06aaa_QtTOeG6fuDAgue16DcFWcFZhlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJST21tzajlvf6Eahy7gCaPvsKYIfViPxYhFncw31d1YQ&oe=6AA6ACAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8To57mi3rGMQ7kNvwE-CwoV&_nc_oc=Adp1FjEv3iMXH2gNuGP1zy1L6CRMVJbsXWHjPVZEXehBsaM5dgBKrrDNibPB3Ox8no4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUzbvz5q2QBhlkFmHDLGRZHwpAfRQgY6LGm7JWA-2DsA&oe=6AA6A4AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdFy9pz_SjAQ7kNvwGn4kmv&_nc_oc=AdoLe6N5Ul-EX2c-johc_5A0vlM3OQnD38gTXBhpbwEepGmivWKbbzvhjDlL9K5saz8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiApjsp4pdLYsrVmBWbvrPZGc2CBgVG0HK-YqCexEbCg&oe=6A9AF451"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etNER3cdEtwQ7kNvwHdpjq8&_nc_oc=AdqhJJJSFOw-FVEXSrG3sxNsJLHFVwb68m7DceoUNus0sCOWASoKDbGYSQY3L2r7SP4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIh7a82878XCnmOT9x-hh7xK424GCoGbWj56-31e03AEQ&oe=6A9AD0B4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4HrmC-OPOUQ7kNvwGq5QwR&_nc_oc=AdoLpoHacagzoOVp6HhRt_I7hGswEMx18sjM3wY8HurobT4ZkA5FJo2Y2Dr2rUjLpBA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdVOseooXA6ds1p-4d8jlqVeUQ6px5dPpl-6BX3a7EYA&oe=6A9ACF06"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03swJLRx6DAQ7kNvwGKD1as&_nc_oc=AdqdDKIyc3KmLxQ-85WsiGxSoPpJkfwU3urQwmmUgzgOp_z3WemIDtud21bd3mjXlIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL__sYyWU3eoxQHeCxh3vP41wUlCAk4t5kuuYWy9DZXOQ&oe=6A9AD5FB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUVUIbBofBQQ7kNvwGXWdWw&_nc_oc=AdrF9A7VQ7pidqwDy4RPqxaX0ma1lWNUOsUIeX-f9tZ4_cE0b92LNAh_fLJHTqyWa68&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5KUPZuNbRY38fSi64bTwnWL3X939z1Rbo7r7dkghsZQ&oe=6A9AD69E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohZuwYZ6W1sQ7kNvwH2IsW5&_nc_oc=Adot48VjnRDvTqQRNaXrUi9qM0AkbficJD2Q1wQdguqu2gVdg7Le6Lsn5Hkiuu6K7FE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINP9fK1a8gDaOLNxJuspAepl33YRhkjCoCrnjYdcVo3w&oe=6A9AC2E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnhVY5-4JpwQ7kNvwFXWtEg&_nc_oc=AdoRCsuENUnvpRa5lovciqAJd-_4KX_iF2NJEKMjJUTwPei373C8ElW37ue6TT9zaNc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEt6IL7Rl-7aD0W9QkrduEud8B52VmasX4gDH9EhGoHg&oe=6A9ACF2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OivdiUiLtPAQ7kNvwFdut6f&_nc_oc=AdoeeyD-7L6Jv9uwkLsogzWzwL7roknXnI7fHV5MYlrAk8rzLJtKPSzznPV9TycL6Hc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgEtOGZ-moT7BSE4Z9ciLlD1emLzPNIVB8FeXCIV3Beg&oe=6A9AC72E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
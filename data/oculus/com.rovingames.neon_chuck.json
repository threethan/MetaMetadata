6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe4YGrukqxoQ7kNvwHvmLdB&_nc_oc=AdoG6Hq_loEMm4diQv-B_r06gBNIF5semzjt89_itrNEa56Ra0vis4eTLSVXbqGF3Dg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8X29n37WfXZTU2LuoN3PY2EJ57EiLFNGTbgu9EYWbEMQ&oe=6A2FF291"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4z76LOG2awQ7kNvwGvOx10&_nc_oc=Adol-s1PXeSxq3in7J4G7KyMj2VHqHQ-hnRsD0dGuVLGOCo_w9EyvbfSOTiD1c7R6cw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-STggN5blG0VeYAkWVosmrfQqBCcXLlnF7c9JN7lNaaw&oe=6A300734"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFVrSAs0HvkQ7kNvwGIqK_g&_nc_oc=AdpFD3XdQXwycPV_Itr0HmCmIsllohHA582t7GNUKU7Bp_ve446iygnChqw8uDYgggg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sVzse7N0cwy9VggtdR96eK8tztCwFAB0e8zxUBpVB1A&oe=6A300586"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tCyiSQ8TXxQQ7kNvwFlfsCo&_nc_oc=AdossqJukpn-zJo7tu0AlQjv_ZV1qVC5qY2_GmcwaO6gOCsVW23QJdpJ7mr5KsniyXs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rZ_Cqy3MHHxK9d5TsTySXAU2IzuCdgS5SivEbnX5fRQ&oe=6A300C7B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNIkAbAZdQwQ7kNvwHg75r0&_nc_oc=AdqLKSuaZtpuvJCjFm-MOEvLxM4OPDt_V2EKOXLqK_19agOR4FZT5Ws6dfRzmB7GQSI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_371Ci4PdGYkGPVsQoe6O9SpmeRGojJ8t7dueZHqqg2Q&oe=6A300D1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtE7EtoNKX0Q7kNvwGuxlEX&_nc_oc=AdrYMREZzPi5RzVPDFIF-ZCAHGopxfsGVosQmrKxLNGB-JFVJmJbE-Nvrce-UsFfkpw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ch6u9uu0lt6orhDkLry6qd3rZ9TpNUcsDgcZ_grCzkg&oe=6A2FF969"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxtRqUuL9iAQ7kNvwHURu8q&_nc_oc=AdqgGuINW9JjpUqewrH8os4RCzc84AUMRBWWXvx1YEHMyYK77D5tkgA_CXlb3pgSYE4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-FCWVat-4NN665_D5CQSvyi7psbUfmDqJh97wgxx6ZQ&oe=6A3005AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2TRecUu0VIQ7kNvwEPR34p&_nc_oc=AdokIda6rdFuxu-beHV62VHxXIe93z7-astIu3pwzI_WLbTSNFrPE7wCZjb9Fj-RhCI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YGANJMcC6tXTBJCxvtkJHb3cdV7cAQt3l5jG4kJhfKQ&oe=6A2FFDAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
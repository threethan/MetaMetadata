6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qZhREvTpckQ7kNvwE3VoL6&_nc_oc=AdrIyMpy6tOx3bUNpTjZ3xLHdgUG8YoxLGKOvets7jCreb2rs5mjtoPvPVP7gOgWFY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl26tv4IiFP2nnB76FBeG35oQ_jnN6ibDgAF4_Ejnsvw&oe=6AABDF91"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u6DwdzG_RAQ7kNvwFjX-HK&_nc_oc=Adpi17_pzVvTsp0_PRWN5OIGUqAHAUi-PGdMTx5O9a38_1UcPl3NfE_l114J_rwJ0_I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL1zfthSzlbiWt-wM9LL6BGyiDtW1ear2sX1_tRZDvGg&oe=6AABF434"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MH7h7SIe-8AQ7kNvwEb4pKL&_nc_oc=AdrUy2ofvjyOZyhKwZGfBvQFrkrJf0vO2lqxLWl-ep7oH0ZgyMTNRLza_XL-c3m35LY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzpknjRXauyJuKiXkPZrcE7u3gherS70ogdW3iLQjf_w&oe=6AABF286"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sB3qmrlPBGsQ7kNvwE29GkP&_nc_oc=AdpWAe7DphxrWd_6daVhKgx5v8nNvx8PBTPmexek4ZeHujJzcnJcEAbDoY5usTYZYH0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxwPoer5_e2g0BxvxYBb93P5VGhQdWVWh01dN1dwQhlQ&oe=6AABF97B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPgB8JSpdcYQ7kNvwGo5rjY&_nc_oc=AdrlmC3uXHab_JbiizNpod26dxpzRlgdYxUeCPy2WGx29UIm_cfTTddmr0ic1bfZX4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrRGI5H30mVpk5BJ62JuoS5ra-kw6tHQU01CALKkm-MQ&oe=6AABFA1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgkRa5rhXtsQ7kNvwGIKOUf&_nc_oc=Adoe5EawTNMBfxUztrZkwCJWQlk5vaMKQZh4JTT3BltwAmz--6zoStSQnY2nBIobw4M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6CZBHtQFUXEsHfa8acezkhH5GnjISH0qeTX4Wbfq3DQ&oe=6AABE669"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9vCKldX9hsQ7kNvwGNru1u&_nc_oc=AdoWFBqR1sxI9JQIhJ70qY2OL6osMbVNv51k2GMe7cRmNCW0JvptlkYgw-3h-OD3JJE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_MKBJyKBZNutT7WgkQKRGTEaG4fR8LoHPXf7LPFT1Gw&oe=6AABF2AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6LMfZ65900Q7kNvwG61fH7&_nc_oc=Adq15dEWQo0cV-pzSiovzLOI0WEkfTELEZfkX3Yu-hnGLO2pWntqfg3WHoyhs6wgXdw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvmf8_a9LK9zGoMZRDTGS0ju7Sg-VS7QnbI7xCg5YAVA&oe=6AABEAAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
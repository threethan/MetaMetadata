6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0x276tkJDIQ7kNvwGJ8KXt&_nc_oc=AdqKaJ_Te0dTWfJs06DtFl7v95dLJbKwvvf0TU6y0Jk3UQu8NqmTStgu5Ohd7rB04wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6lp0qxx04IC2SO60k4dvQj6fJ4oJYa7YVKeVW83oRpw&oe=6A577F91"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u47EWq020UoQ7kNvwEHn_Nr&_nc_oc=AdouAAfdtYCFaGYQuVoo119iUXIcc-vXTp9qMbs1nbpqUgVpBQJk5VaUORhsehNetr4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC00kBp-Yw2TiNdxkKYpD-3aP3BWxlQ2X1jSiZcMrVAYw&oe=6A579434"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zxcq9BOcNUQ7kNvwGlHcQO&_nc_oc=AdqpDCx_TXD6n_A-_-z3Q04ufBdGmqJfIXPZYKwhf-uA1wjE2xRBMEDxnKumhkHrc4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfnl54WM2afCaLL8r65yrXKmhc3KmUwwLdbbO4Hp5wzA&oe=6A579286"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEndTX47ZJcQ7kNvwEiCPxo&_nc_oc=Ado7hXO4btuAGasvswlnuBsnLInMs_2Dcj3L7CsgXyxrDGNouXO1_cTyNQ5ebE-JQAc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm0NHBjL6kS44Tpyl6qdhGmWJg_Ij3n-Ljo4SdIm83Iw&oe=6A57997B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZG1qLqDuOEQ7kNvwF82aNV&_nc_oc=AdoSsuYMqaf4D2C0u2qgpfvR-AqueUYv3WdC0NFSHAnyGrH-FzDa2wTX33e1I2qYGfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCt5nWUY9wTbTmfhnX0P8wRaue1MmrHErjinFE1lItKDg&oe=6A579A1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnYCxeJyvncQ7kNvwFANv2t&_nc_oc=AdqjezOhL3tJ6IM0AMzXCKQsBLaq7VqCXLBCcUq2tD1PbL5vWRjhIr5BBnvfX50BimQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLAqXYX7pJRNvMDvzO5BK9ilkxdAih3rSHingVzhXYTw&oe=6A578669"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GksRr01xluEQ7kNvwEGyxGU&_nc_oc=AdqIwpcWgVuv0hdpbZ85nHq-47XKz6asc2gZ6lnabBN8TpEbFCwwHXjN98Aji7Jjnfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTKZCatRoMaPWIqCH_K72jcurdRngTXDgDrarnpSrfXQ&oe=6A5792AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SkA8ryf9xQQ7kNvwEAxtU_&_nc_oc=AdrSkVddgSxiatQPlsKoCufat-cxCEaslGcI1o3ulQBPlDga2PjQ0L4PivkaOPEfvJg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTsUe_pnuTEio9RB3xFnn0c4EEQOlsfW09mvXQNvByVw&oe=6A578AAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
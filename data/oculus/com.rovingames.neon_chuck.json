6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYd5mdhTmHsQ7kNvwEHyi8o&_nc_oc=AdoHrUsBWT1nMW6jlSAS8AE7ZKrQu1ZQ2rd9rQw70qK1HTwDs78F9u8QPEcAHGFATRE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNslcACnRKU1sjUAyYO1h1oOAu9-mUfOcd6LCsOR6Ohw&oe=6A92D311"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yWNKG1xI9cQ7kNvwGjhWgr&_nc_oc=Adr64mhMP77Hmzm__NaiQXcvkzqmQ7gNZJfl9U6aUivSCnmKZ3LxdCgBQpBCa4n-CUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxHTpPgj79RO1lL0Lk0tB0vg2xsN0aEkYimn1hAN4Khg&oe=6A92AF74"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLpwSV09JvcQ7kNvwEbKOMz&_nc_oc=AdrnBB3K0g3gDH3RUv1FYtQA5feUdUDDXKXg4OecBr-NLixbEQhdcsvDfv8YG12dVQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwhMUGketuI23C-teSM9I-ZxMMJS9C-Eq-r59MSCcm3g&oe=6A92ADC6"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPZFv2HjhTYQ7kNvwH_8Oys&_nc_oc=AdrUyacgOqYaG8e2LqpqmNcq1xRbHZCt39tj57O7EBAXdbqTM-UpkAMgjDgiolbyEBM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnlOPzv42dYRN5FDum_4k0UVtrQLjKiae7QofCa_Q3aA&oe=6A92B4BB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PufIqWxsYAQ7kNvwHqefPF&_nc_oc=Adpgu-elLCbEfn2mPIhpgVD2nVmY1zvuMLSXcPd0yWOROkC9kOoF6IyuK7ZaA_D27fs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElHwfQcevRwR2AHDUrSolbhnLsL4bRNOfPfTAoLvLRNw&oe=6A92B55E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_zN8mUpHckQ7kNvwEF_l5S&_nc_oc=Adr8ZKM1jSRjNmp44z2MioQA9slEPrOudOE7WigcPoqLyL7tPCJ8L93dU2uHUC2BGi4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-cHNZ93_x7pg01geiuoHup-3wIgQH_WDxjVDOTPC4Bg&oe=6A92D9E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1rw0hurHfcQ7kNvwEtMwlz&_nc_oc=Adpbh20tky9SGT58iPiR6verefB_0bnbHbzMxjsSDyChDvQZOmD6ZUcjrJEECj-VOjk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOb6aokCRR8Bfd9MHz6DDN8YijVkleG7UeUIOeC6bkUQ&oe=6A92ADEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7bnnYMKBJIQ7kNvwFWfwCz&_nc_oc=AdoRMgqdqr4HqOe9V7vEOb1rPn89UxKM46ypPk03PX4oB-6naENI9XA7pj1YAlk5do8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdLLMUvkVKXWwcKy75Zeon-idf-VQseC_EvgGNuwebeg&oe=6A92DE2E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
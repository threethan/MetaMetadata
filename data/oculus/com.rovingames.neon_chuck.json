6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFz0tVIHbn8Q7kNvwHFzCRk&_nc_oc=AdoiiIadlfvvs-RW4tnR4pCLs355Y27G9hSRjG_-q4gstFF8pHKMNjMpVdnQibkM7gs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfC4gdJCK3oOBRYgL8Ohm6Uu-s8jxit7kcqhgHZRVndA&oe=6A4BA211"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCv-EgF-Bm0Q7kNvwEtyG7f&_nc_oc=AdqKAnT9qC5K40yahzr6UAq5NF8QJppjQrED1Co8TxwbcboI7Nmly-7pwZuIwsM7gqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAt3JzzeSZkZd0E_8NSIfy3DZbcLbwN4qbi3hHny6WhTg&oe=6A4BB6B4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHBMgTq8jR4Q7kNvwFPUKzE&_nc_oc=Adoa3SijC0r7Gotp0_DcK0Ciz48-QxpcX0tLG6rdq1Yp_c_wwgNDIct66OuC_9sUQ0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoD-a_pg3bQ6YyRzc_vMfop44Vwd9J0XFTQwrBNh8jMw&oe=6A4BB506"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34QO0pAK_DUQ7kNvwECTim7&_nc_oc=AdoY5i2etdtpXHIAY99kYvFe4Jesyf8buh9js0jPH2rQWuIAdoEm0wgAJ2BBvqcIDx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5Ocv_1pjERg9JIFW89rEbuFTL0giia7HBNtaSk6jPvQ&oe=6A4BBBFB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwFfSKnLwBMQ7kNvwG3mxeQ&_nc_oc=AdqDJ1bLUKA_ZG2J04ykanEN68FMrjPjX80x_DN2jE76xgv2njflPYhV1PUjAXf7tA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-eZvpcE4kYtb79xgA9_3Thhh-wh6VKtwpYWYxAW83Fg&oe=6A4BBC9E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o-i_-JbpFYQ7kNvwHcYyYy&_nc_oc=AdphayugEG1RPeTEtOZ_9x7o7mzvMsGkwA0stVLXSzQt9Cps3FfJhLshGh-hScBvE54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5Tz7_DIvpW7PsmtVP72-sbAIruMLcb-7vRG8MdEHeDQ&oe=6A4BA8E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR2f0qeNe4gQ7kNvwH1vzIc&_nc_oc=AdobNABSVX13eJtdCMXb-pkF8rJDmIMNyCtH13kj2SwRyNycx4QEGN8XOm_zHsKzvo4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB1nnts3B0dYho_8uVb4m-2guth6T25lBKCCwq_yX2Iw&oe=6A4BB52F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2GyPFH30zIQ7kNvwF2Amye&_nc_oc=AdqSvq-jK58T_ot696SuxcdKlmxL-D7hySjDVUp4L3Bs0MyCic-Qhi83GKnTyw6jSoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFETImeZ5ZYkOp2yW3m0qRfX9bFwH0fxSYGtMZ4BCiyQ&oe=6A4BAD2E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5mX5jpUkNgQ7kNvwFO4_NP&_nc_oc=AdpwG06CH-U4oPOBKM--tm5tB9rufZb6jMzqFf2ogi9cvqhjy8lk8bh85dTIZJkqs6U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84_9xlIWAoB1ZyQpoYVoM0kWcMEnVaxFqSWZEpXUiYvw&oe=6A2C3651"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq6oIV_tIQ4Q7kNvwGvFCAk&_nc_oc=Adr0rrsdolb58nCL9VTwSfF1Sf7rApcl40QFUvlnF6kx6EmAb4Zyv8YJkzAYOeGx6L8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lrHIn-sgZe8-E-hkU5FOjE1NEfIYZqWBhGJHTXUr_pQ&oe=6A2C12B4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDKm9qPy0BEQ7kNvwGfW0p5&_nc_oc=AdoKbfoOiP3pubyNatDNRoojqC3RMIuMhLFgLSRjErCnxY5s1FfeZSKoumdgVBgrIHw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bguIsFzuZu1RaPTI3TNM25JF9VeRj2EDemwysiaUhyA&oe=6A2C1106"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qP-alRcT3oQ7kNvwFW7bqW&_nc_oc=AdoPTYt-XnB1D0IA8jZf9CH_OhHXjoevMlT8vMdnq3_FLg7xNFc4cnPcekbVjnoI8L0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8knmdFFbEXBfzR3rlTElv9Jgil-7cFUlbnCCKUsxg4GA&oe=6A2C17FB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GdVbbmE_lkQ7kNvwFxwzlA&_nc_oc=Adp4eM2N_fRGwyBBaBnITrUqwwcQqBZjs-U_k_KGrIXpaPiAngZPw6vQJn76drd3oEA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J8E7zCHQpwbC0_FPK7BDIRKhbCQ_xaO3Chtoy0Zxwlw&oe=6A2C189E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mex2HLOYvskQ7kNvwEK9yIn&_nc_oc=AdqA2rCCBMyjbnAMhqykmOBn5ECwiH_Z0PvRjbpAhIy6R-WqNAEwMh6i8-5jLCmzSbs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85DqqJQI5jzz-pncqwIBxiNUoU5B0yPyY2JMFwpCmC4w&oe=6A2C04E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJkhdkogYTYQ7kNvwFIc4sg&_nc_oc=Adq89se1ttNSEZCOPVXtMlE7fwU-KgLQoCWEaQHR6yAA5EPKLDEnd5591sXHManCtEA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Co-wonjDXWLo8W844_nWsv42cBp7aY0twy0NiyhSj7g&oe=6A2C112F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SjY_jk3fMIQ7kNvwF7orTX&_nc_oc=AdoBP3HUZoP1eguLbSu8NBOjYwrctS2Xpd_AMOzW0eIchDUD1Wd2ai4hUIgQ0YBq-Ic&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96FFrL8F3vNSj4agK_9GECIQTmHVjrty_LD0Tekhc-WA&oe=6A2C092E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
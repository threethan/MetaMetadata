6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9hCEnEhtVUQ7kNvwEkYE8P&_nc_oc=AdrOZiQepcCEsSFpG4oDeMjn-m18wmFfkQP-FRJpY8NJBI1BSlsVZKE_T9YIAO3rSwI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv9E7epyllWWXGKx4jTv0gSytihBaYxuKzOB5tbXfShA&oe=6A660011"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6mCpxMrG_8Q7kNvwHxHuS-&_nc_oc=Adp7N93ANrP6oKZmsiS0I_zHZ-uXjs78t5R5RzlK6VyEHeF69FeN0LabOvl5wg-g_C0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEYvzpsQxc-38gYNhVXMgYlqxcNAPS74qqjVu8z0tACg&oe=6A6614B4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbDe3sjBTH0Q7kNvwH4hmn_&_nc_oc=AdrDzcw7BawQaZd8s9_rilqrHqunp5ggN-sesw_FshORXYKi76SoPCwoj4yYqHatPVs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu7Fm1hT6Dv1YwbDtpVn8jM7Y_nrwwIZZZJo3tZV2EQw&oe=6A661306"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GTOgCKEZksQ7kNvwFOZ4Hg&_nc_oc=AdrvnM5XC2dP9AFR01pu05WX7WFaqxUYyQ3Lc6QNX3JZFoNwZ1PD8zkyH_KRFeXlin0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmC2_Mqvy936f3TvutUB-e-MfYkBVBPakTDaeBtr0O-A&oe=6A6619FB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQu9p4zba10Q7kNvwG16V19&_nc_oc=Adpy3Y46pHPjU2eB7YZnQyGci9fC6vjjfskm5DO_R_qGT0gIubcAdlOsahmexgEOcQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRtDWED95agsQRhnCWxjBpIZ_C3re7w7tCqGiSdiKOOA&oe=6A661A9E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw2wMjY-SDQQ7kNvwGbhkA4&_nc_oc=AdpCTn0Iu-DmccEY3tR_Wy634du8SaGB3GFAaHIsAZoS2hfzidVBMuHt1tGkPU8PX2o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFgIu5NZiTpin3m3BnjsPKWszPBXVEIuqyAykvtiHZdQ&oe=6A6606E9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3PhnMIrDREQ7kNvwGfPOCW&_nc_oc=Adr9aZDDdPYf2yBI4Rv3Qqh1-Zizg_9jUKQuj7r2PebLbo4wyQduD7eLtRqUJkPQ1Xw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmV8Gqc2kgWEGR-zyEn6YVqbUOJB5vUdW1LFzFNrqzFA&oe=6A66132F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK4FOrPpW5YQ7kNvwGABCnZ&_nc_oc=AdpIXfHyXZbFvcf7o2HokpKWBNdg26lfE0wZvsQN18PzaUCc6aUIXrDYPfDW4jQaHHc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9K0jXg-P39r2Pd2jIEqVybJQEb8LhUuz73r1NmIDnZg&oe=6A660B2E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
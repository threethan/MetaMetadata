6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6_Pcgilj48Q7kNvwGY0e6F&_nc_oc=AdrkY_JBt3WTEDMadRgo5uD1o_5AOB7AJqJHfDnyfjmq4gxPRW0iAFPbeV0Aa_r6qKI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCbSK2qCdyT8VBbj7vWRwSNsY8Kx355we7BIVYk2rWtg&oe=6A899891"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0ULJYFO2jkQ7kNvwFfYg4j&_nc_oc=AdpLVr4F8Jf4t8tHa3m-eQ2DOyIaPmv16G0ntJuYQfijQguq0kw3WSqC-J8XOCo7VMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1LJCwVyVLKKr93E6pmgm_OXeI3HWBin5SNzjvLViE1A&oe=6A8974F4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDtqjaulXIoQ7kNvwEai9uX&_nc_oc=Adr1PImM52uxyLHhW1yyG1xyKR5GPpwzvh2NeUe5TFRgKa0Uq6aP2eOVCiwpmhmT0ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_VhUoAvrWUIVicrDD_rmZ8uxysb8hVrexrO4FoNXqNA&oe=6A897346"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LtkmvfXEP8Q7kNvwENzsh3&_nc_oc=AdrB_H1zNaX3JhpfRJB3-EDkUiQJ5tISKm4SRSlNwWmV8APwRmUeLeS_bXwt6rTPsLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBeQEqwq9YEfcQ5Rtuzsqf4rWYK57fAnYHgbavDwQQnw&oe=6A897A3B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2ipe8U-z-UQ7kNvwHZtiEo&_nc_oc=AdrCX3oowlnIPegv1HNR1pfazDOmwPkvyf1EzVqUwpwE908jMrUYRUovUI9-1t9Tjkk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETngh-ctsOURrCNcmxBPB5jSWCDW6FUctAmWlHrp5QhA&oe=6A897ADE"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgCFnvB56n0Q7kNvwH7NZGX&_nc_oc=AdpFW35z9w6wQDaQds6vfFsKef4L64OAQhxV2FYyOvHQDRQ0UcHuVkRNzkD6K27S9oc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkZipTd56XWu_JbFVFwPlpCBSpIpMG5oB1LVGtFVvN7A&oe=6A899F69"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VRlFhm8PJUQ7kNvwFSV3CP&_nc_oc=Adqf3XBufED0Fs1uumx0vcy3P3G7al5qnzSCgir-WhCbPJRfPNRcJDpQitu7eg9gSS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkEcynlAs35LBSG78wlT_tl5jGdybNfYzPQYpZgAEnVw&oe=6A89736F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0T0XQZfAW_sQ7kNvwFlDYUC&_nc_oc=AdrNShOkJLD8UDMueAg5qBw0UicNQ4HbXPXpSeLW32kBAPNhAyhFwfIuE3jbL3q44uk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHETsfJpoc5jJd2CuRliXDvnPaL1EULLAndv0aRlx5bDw&oe=6A89A3AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vaxexs-i02UQ7kNvwF03Fpm&_nc_oc=AdpckI3TNGBOs7uPQedCt6QTPYWkpO0pEobWpyQtp99qNmvhXvqa6zc5x5NB7pAey9E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_g_KsnlkvUjIWXQYY4Cr9AzD8HJVcmkYU3yMor0hFNA&oe=6A4E4511"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--fGe2G9lp4Q7kNvwHnDL3O&_nc_oc=AdqZeJIbdeLoOKIhqFkiIoYRqil8gNwU3CyzZMqNN2hJS7_eBEPAUXOUABnEiqOBcLM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp63yUveTRwsl2T-z06Eswwnf0ZSZD6pbIIuot1FdDKQ&oe=6A4E59B4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHBMgTq8jR4Q7kNvwH4Z26h&_nc_oc=Adq1PmTjKZ2Gc3RaV7zMegpqEqKCfjLKjZZWIxYiWA1xFpUbZU7kiE7rrgHejB9a9pw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_AFlE774T_INfpqh2A_MMxrT6KzPL0n-pX3L1wFTsnw&oe=6A4E5806"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34QO0pAK_DUQ7kNvwHm5C3l&_nc_oc=Adp_oyWT-Rs2rlTngyHjlTfZPVnZxVgXlKUruB7_ZVDww1YmUwdA_YUp4HaszvPSRBU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDMJ7_QRIxaLZW7kRQyDjNmNn2vPsNv6b4R1zjKkFpYA&oe=6A4E5EFB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5thPzsAmi8EQ7kNvwHBajs6&_nc_oc=Adp5I0r6vlOruk4eCbo74EBmOlJsSMJXEle8l0X00PBj3uyIYNMyEup0ftTTEWDg8Yw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY_3hP7xfvcyaOhQDvcRX_45s3V4na6nb3mZh73Z78Sg&oe=6A4E5F9E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7IEJN4TtKMQ7kNvwFONorU&_nc_oc=AdrvqQekAtgz38iDyh-fyg15-S3bg9mVcuXsXljlA-_6bkS3PTOtdvEs7gTwJFGxKw8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD35r-OPLq9Jmez9C1hghcJw0jqYqd0bEiAju8q1MoJKA&oe=6A4E4BE9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hR2f0qeNe4gQ7kNvwF_zaTJ&_nc_oc=Adpt6CdYOOqVtkbQJ2yS4GzgqyInzuAq6lxvEGEQwuXdPt1rhNIWqDTbnzGAzJHVEXE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXKEBqC0fDvmVnM6TMfqTunRXjmlGDmstTTbuH8T9ONQ&oe=6A4E582F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2GyPFH30zIQ7kNvwEqW0wE&_nc_oc=AdoJoCECtMVnc-qf8ZY4H43cafPLD0e4wksci9Kw5-iH7OkmwapQPavDBdsqZZK7Mss&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCepzbEq_k21GdmTkqUe76Y2sA8j7chGvETOTdRr6czVA&oe=6A4E502E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
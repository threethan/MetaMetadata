6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygQ_RLDjp4QQ7kNvwHCdlH-&_nc_oc=AdrrfGCOB72JaA16dYrA4A_qxlTXaRpVGR26IBhNTQLYHxKDKtPgc2bb3VhB8SQeWJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqWSTdk4joCSVdrVe1QOMH92HM97oqLvls0fIbr6uv2g&oe=6A5F6891"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjndecpdPugQ7kNvwHK3LBS&_nc_oc=Adpd5Rpu9A74jZtwixmexkzWxtZPUFj55ST5OMg3s3uZiuwrC89Cv68qFp24_WWAMXw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPu45fAN3hCeg0xSTwtVGbKsfc2jjgGs5W27h9V7M-oA&oe=6A5F7D34"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tznbYn_3LgwQ7kNvwEu8WLs&_nc_oc=AdrvvgNGwoEiSwYvGFQV26KOLBj7Y4MxL5UP3D72OqwkhX9Bv-owk5Ma1RndUwfbx1c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfmqMOCFtao06LmFex65UzLwTnq4EFL6wIdWs6R-BuWg&oe=6A5F7B86"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pbr8fgFkyTsQ7kNvwF4oP7t&_nc_oc=Adq38fV5rSM_czE_smLBYrF3Rii_shitW2HA-XeBqPU_nHHkUS-rBC_JEiXsuMn9lsM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8u4y91cCpzPdZw08feAVHBzJzTybxNVcMU0AcqxT0Og&oe=6A5F827B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRq8NIhLqZoQ7kNvwEtjCZa&_nc_oc=Adrt-c7HY_hSxCLrRkHmTQXNZuCnA726fU7L0FDAvuERDXDO04_jOCHM7t99iiQpxUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGHv-rpf-hqgsWMiAk2vKU9Me97WJa-fBoFMIKemyWrA&oe=6A5F831E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpwsayOMNGIQ7kNvwFDp4Z3&_nc_oc=AdqI6c5u4VG6ZhHI7Xl2w8tfXjDD4vN_volnxOFyIwLqe3KJqBKJQhBjyrCRFe7y7Jc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_lvYBshLnyrMh80NSMeBEauSXaHtYbaaqVDxuTFcKqQ&oe=6A5F6F69"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZE1W_9CFUQQ7kNvwFTNnu1&_nc_oc=Adr-0eD36c9Pizt0Tt-Mz7c14My-u6rYxwEcYCkOpkRAr6hWWN3bMMpk7noUl3Yj-40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASAfDLqx_cSczO4LbTFOsHFhdxfS785dEnG5jrM7g7Qg&oe=6A5F7BAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yi2n7s9Q-xgQ7kNvwEmxsXn&_nc_oc=AdpN3EkXT4P0IAMgVwIUHx-7c-VilgTmaig_Elx1JfXKJN7Zh-S2Y3gnc1JA0r-gVjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAEDGvI9kR5rAVUCry8DUNeRYRwRazmaidihajrj5hDA&oe=6A5F73AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu-e114OpvEQ7kNvwGxYpRH&_nc_oc=AdrFFyO9Fv0P4s7i0riYNPgnRuHk7l1a-PTLfffQZp18NniguefStzFfEGUYFLV6nF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fRSngR1p6ewEecBRcTcYi_Szg9hFuNiemmYxx8S5XDg&oe=6A47AD91"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yf89nj9CoCkQ7kNvwEqSpnj&_nc_oc=Adqx2-PDy9t8Pt34AlJ0bJb1yiwBKFoViTFmo6bQSJOu7Cclv1Ooeub8dwQph2_TY6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Bo7kknty2cRITir68in1Zs4fRf761ZVSi0JhFlDZKkw&oe=6A47C234"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8F2uxj8MNsQ7kNvwGP_m2V&_nc_oc=AdpzqGMEEhZVza4_ntM7fytEGI8y29YBgP5KBUwNUcP2jikA_z791yF_tN0nTGgJcrM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j2sQSztGDKHZSzXCdzszSkQ_aWwoTogI5IDW1uno2Qg&oe=6A47C086"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOOWEPPdgw0Q7kNvwE-Rix2&_nc_oc=AdqN4Vo-7xEDc-RVFf2zEOxWiYiHGVksoCk9lZ--8WWgx_tXhoAe8SnipLJU7F4N9qA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h68Wm1hYO3YRtp1W9qaT9AVs31GE8p8txHiyZKEQQjA&oe=6A47C77B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxD_kgQrcrEQ7kNvwES3eNo&_nc_oc=Adomgw0LqXVvMAeXtMiL1kLLlmmp1STFXP_xhu39XnkTH1dbwsfj0EYGSlHaOVCnBdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gPneHkhq5XPOs8a_V7f_W9BYy3FdWAcdOPlFBO1ZOCA&oe=6A47C81E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeLpyGkR1v8Q7kNvwHIGh2K&_nc_oc=AdqodWK6Cr9YJW2lsV5hxMDJilUjEodjMfkcU2ukJYfMyL8vnWu6yqCc1BXHuCTg9QQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tZCt7JUREuQShKUngwT8bWAMHWWi8i8P30010rKMT1w&oe=6A47B469"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQqpasy6mB4Q7kNvwHwlgLo&_nc_oc=AdoLcvH_gLzlrO6sqgJSWHZaiiNKOfHo3eFQsDi1ZDM1w5cM604fXmcHLkX-UyqzHIM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N1w1ArRU23_6PACU4Pd6j2ic_H4S44Mx3eH3Cx_0iSQ&oe=6A47C0AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llwY8E33804Q7kNvwFAs-At&_nc_oc=AdoOLKtLLhNRy5NN-BbUHFSZbDAr1ekCq_jeXD3DN89QiOOTj16pClEPhUo6-JsrG9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pZwE7gJblq89PViapK83UUOAje2UEosDLcMO0rb2Uaw&oe=6A47B8AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
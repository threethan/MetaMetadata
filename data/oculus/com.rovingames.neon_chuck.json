6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdFy9pz_SjAQ7kNvwFNdrt0&_nc_oc=AdoxzWAuKDRkPpUeJarCL1FcGW3Z5-LQD-ZEIHXrSKliK5In9VCQU_3FQm7ktFYlU-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIydSTPBQuCqyD9ZhLqgFIngMzat_Wal4tkdZzHjBeyw&oe=6A9C0D91"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etNER3cdEtwQ7kNvwH2XtKg&_nc_oc=AdqsWB8RHQxSxANmgAbG49rRw2laBo4ilDHDhBNOlRkUqMz-n4hUg0zdRuUaY1lwyF0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwEj8lBt5EbWkH8kzLUJOJygNVREyrHFS1dSPd8ZuvFA&oe=6A9C2234"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4HrmC-OPOUQ7kNvwGurl_7&_nc_oc=AdoAG96AVHbYdn5G1zdLp09hF8s7uKGn-n8_kimdH5aW07aJoC_syRln7vaeWHEso2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6WuCyf4FHRqULlGQrh3Tlq0U7j3ya1M4-DdJfgDG8uw&oe=6A9C2086"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03swJLRx6DAQ7kNvwE7LHAK&_nc_oc=AdqQrFU3hDtdewXzAY63wkidR0gIB0tKrVf_l6d5eeXkd5hBFvN5VhHGutWCWIYOdFU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfkEUB2vXxkyBRGFjY1hJOwJFhuQ3AMjC3lpml0SsnAQ&oe=6A9C277B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUVUIbBofBQQ7kNvwHHx4GM&_nc_oc=AdrlfE7IXNVW8uV_QQ2JdUqdLcvti1G_JUharCtzU6zyXBXzhuby8I0_pdpKugeqKIQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPN04XAhgkukC3y1iUF-YvPykCcqmQSUVlJtqaNAFwwA&oe=6A9C281E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YJ1S8UKq9oQ7kNvwHSqRa0&_nc_oc=AdrNsmbfhQ2iHKN4oITK9mdBjbkUjMpPDkTF1AtjbqxjedIcKKpy23ubTr8oktxrOJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyHkFaNLjfnaFLwegkaBQiF6_j5MUVlBE_zFYjMfAbCQ&oe=6A9C1469"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnhVY5-4JpwQ7kNvwGRPxtc&_nc_oc=AdoYYw1hIAprF7TcSc5A0DFpol73dxbzhSrwXtuVwGMPvTwL2a3ggJGKZW4LzxfVAbU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn3Mst6B7_O0N2UBv6cCfS1L8NX5o8r5G3ojjGDQ8Gfw&oe=6A9C20AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OivdiUiLtPAQ7kNvwGuCRYX&_nc_oc=AdpgIzY6UgzeCvzf8jcQV8bau1SPRsNM-dNdtTTyXBPgxnyuBEQ2dfbeJEhCBxoST18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvSd6yZhxnJ088edQjiZw-P2LoR5vZuD1O7ZsPgsOvTw&oe=6A9C18AE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8m53newdBIQ7kNvwEnUBSL&_nc_oc=AdquJytyR4h9DKVSb-5a51i_D6wD78HnT7MafuEIJVIa0PwKz6kYnk5KcUshbEt7Vhg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AEgQ1yfbiO7yyWgxQ5ZWyJSEqDi_KgoLs7qzR5TyWLg&oe=6A3D59D1"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3OGE3WR_hZkQ7kNvwEiQed_&_nc_oc=Adr8_BdpJl3Aww9c33niv_6ch1LIu_y06_VXFgCt_WAkb2S4-FZ48RrjeFyIERo9bII&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K1fvkfLoLkI4IuudQ69QWmgVT2qyLc1HqJ0rj0q6Qow&oe=6A3D3634"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZobbV9f_joQ7kNvwHZ63QF&_nc_oc=AdoGYjin89F4RWW9yobfJHM_Mjn06FMk2YQVF27ZekQrZIf8wTq66t4nPLEWwJNR-Eo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UFZEGqNqwsls0LPT6t5-O69SKFe4ke8UfeCPACiJtkw&oe=6A3D3486"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEtFMuy2bcgQ7kNvwHxJtoh&_nc_oc=AdpsOJeCcZLAdpvGIZ16svcAe6ConLbKb-lTyawFHh7FvLD6UHNSyktpTls4Y-pOt58&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7yrrTmioY0M9IokS2j_cxEi1x3vfTkMMXsOm9wVyI0w&oe=6A3D3B7B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bpNXhwg2MQQ7kNvwFeE4_m&_nc_oc=Adrfa5_ZuBiMxsIyigF-GM-TL7rH8jrAJ_1vSDLr1N4SCDQKiNHoK6SvmRGZQVgwwfo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Obt5VzUIu77pfD11mLBcky6I5_ojUrwRxjWtd28G38w&oe=6A3D3C1E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QpW1MHB_1AQ7kNvwEurcAG&_nc_oc=Adrk1yI1WKOqzuBs7nueg1lm-aGgQfjGufxnK_ODLJQXtFQfNiq3BmB54aiFuQAUGjo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lpaXwU8eMEfXdE2JESQlnBPvz28_n5LVUlTvHCYKKnQ&oe=6A3D2869"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIRfv_FA6JkQ7kNvwH1NI6a&_nc_oc=AdrQtKQ5Ug-MBKllzpL1X1kBEt7O1RclDmc8fQrNxMAXNosAkZ-JjvvgglXcth2oLBs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MAuZ0by03snEJyboJxaqcj6zXJr1QeeIed6BstZj8cQ&oe=6A3D34AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmOBwiK4mJgQ7kNvwHu3Wx8&_nc_oc=AdrLmalmRPOpK33yUgOFAz846iarfDfLTWuJwz3e8MOX2i0K-fI5C9ZZ96AOcLqu3pE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9N-vZauR5fXquzxUDF6FOKZE5EWj1XdV_H1zpV3vjZJw&oe=6A3D2CAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqDdJqZibR8Q7kNvwEp_H22&_nc_oc=Adp7AWbHxg1n4dbEvT4PF5pIgqcdUL4BxzIJBWHZSS8My2GvipV0dEyEYQ3NX9ap544&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTYlKdsQFXGZShvfdHq8A-OFbpFyR5a3uI3r8oYPlzYA&oe=6A845291"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owea_GPUFF0Q7kNvwGNxjRb&_nc_oc=Adpnua5IY0AHDKNqS5k5Fi5VvvqU7ZAs8OgXaL4LD2nQACPbPRp29Y9VQWWRXvCsjS4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqj4EsjgdE93EBhhGYSWcCBjuu-6gz69o2J5NY-et9fA&oe=6A846734"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGSVJ-waDx0Q7kNvwH1mnYU&_nc_oc=AdqOkW9RdBMjH2bVYZeqZApgOdMqNfNs4TFkrqN7wLg0ApcMs_DJJWYhBwD_oG2eyiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZmfshYyFVIRpY-AeFhFi-Bji4MJb3meCRrxdlkOIk6A&oe=6A846586"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDbd90ZC4i0Q7kNvwFVFC9-&_nc_oc=Adr-P102_Yhh0Weo7qP6LY7_P8k-urlTP-473htsek61njsPXzc1jzZUfFcGEYfS2VA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENMYqDpZvlxoNCdqP1ttnO7FX9J-coVx1Du7CvGkKmzw&oe=6A84343B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLs7ZgciyngQ7kNvwH3nSeh&_nc_oc=AdomnavcdZBQT3PxZ4wKPkJD16ZOdOdSGm5d4bi6cR4Fq7hxf7qcdGPyJwGkfvg-uus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG75n8nkw8zAlkOZE1cDR7s5M_zKFBXIGVqLviRisgA5A&oe=6A8434DE"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_Trnv6PEtEQ7kNvwEomhWb&_nc_oc=AdqLjIkFdgj_YVIW5W1cSJdA-094eZSIsRn8pshTxhPz-MB97QfNw15nagJXqHpC8SU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETl24vggnMVQLTxH4UxaDMZBnyYidISb2ceuRus_n5Vg&oe=6A845969"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eU6MQUCAwaEQ7kNvwE7Kgik&_nc_oc=Adr-ufjbOAo1A9ZdUA_ieJTGyKgNF0yoggYp7IC0UtheGgVvVJcwHuNqJ2NYJNhCdno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBvE2YAqmdIwPs1zM5CUHgXoVGJwtohSutxKpRm8_Czg&oe=6A8465AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoBRm5btlFkQ7kNvwGMg69j&_nc_oc=AdryfxFykPIF41Qg1TVjp6B7HjbutUQr0E9T-AiTDta73naLMTvmohVdjwMmlISMb94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkCvdmr_YUnvj_g9VG_-sA5jvHWztSpWnnmXkF4OpI6w&oe=6A845DAE"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
6_1280964760915046_6635963612115786791_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnEPdhPeD1YQ7kNvwETnRo_&_nc_oc=AdojL-BCykWTzdL2qhHZCs5H8ieJAMEMblvt56dJEYfcQ9RW8uCRv9yqN-oF7bTmSII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDucaxl4zzxzSEkFBjLeQXmCGpN2tKRLBzbYUjApsGVcg&oe=6A6B4611"}, {"file_name": "Hero_Cover.png", "id": "1008253918323370", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1008253921656703_5042124209973883023_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFHd133DL-gQ7kNvwGhKGTV&_nc_oc=Adrth0EPTcChgKTUaGC3P1CwCYD1zt3kqN3nLgVoIgVmBM71BzXtdfRY4D3u99wsUmo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXReVq_VqCVqBoWTTnsJ9GB1vNUhu2wkGfdlXZHqRGBg&oe=6A6B5AB4"}]}, "id": "1794736934833949", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCkfSVnr4pcQ7kNvwHqI8hX&_nc_oc=AdoYRIIvmDc9QWG75p8T1TWMtu7TOxRTUoztcP5ct2hVMQSaDmENfCGSfIchPwg__iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCibvNNRfJdQYgdGvf4_9sBLp5NcS0QEvhznFbzqKOhRA&oe=6A6B5906"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f7pNPmbAegQ7kNvwHZH66D&_nc_oc=AdrsOW60EX50T5erY6-KlR1149916GD_dd0L-DtwelZ7tjAsj_pF8FCB8y0HjIijqmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXzTmn1Ttg_JlzrK9bUZ0_8Vd3tzBzDCq2S-LuS4C62w&oe=6A6B5FFB"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRhkZ45IEGcQ7kNvwElx7KE&_nc_oc=Adq-QIUqb5X7VEZGa8mb4Xt_6er9y6EbcDNti8TfFkSj040E20VSNvZZ3KwtQ2ITdlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcsixH-JXpYRnWe7YP6P7tYfk_VDgkuL3yBassEuygWg&oe=6A6B609E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYYWk1BcNOcQ7kNvwFRgvWk&_nc_oc=AdrcpuxnmqNaoh4nAXjI_qdH7_KqsyQpJ8AHPYcS1nFrrsDCy8-sAL2J15ujF54nOI0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFoxnG5MMEW0sJrmV96rmvRAPctKbMHZMhiOTS8FUv3g&oe=6A6B4CE9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8xAkqXKN3kQ7kNvwHfR1Nb&_nc_oc=AdoqrxydALQSRX_9-oNSWhKs5ZMgUbfzeAwdpY-wUWhy3XhfnIPFZFmxgj242hamDXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArikeCur-nTt4XZoZ7sEu11T5sEfKxUd9YgZEhba3LXA&oe=6A6B592F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "4011976365767233", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/618758916_4011976369100566_7485671115037897259_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaCCm0VWiLQQ7kNvwGJjEpK&_nc_oc=AdpbyEKuPk68v9re62JqMn8ZyRZM4bjVAbIILntuk0l0cUnq3FTVq3ZEg3zlg9Ymiag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAszJzfpuNdd6-BH2DoLy5krwGtbiBvzvsGafmHs6yZEw&oe=6A6B512E"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
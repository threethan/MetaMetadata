, "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_876311032113920_7442341123408578566_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pjCnVib9jkQ7kNvwENv8iw&_nc_oc=AdrDRMde2HPZNdj0VwTvIXIUmMgrH8JOQe6RuDScBM36sXxfkPZtaoP80YLB4-0-vx4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFVVT8-Y2776ZoqiTcl82tAY127hA43HHCT1WDRtRpIg&oe=6AD39A99"}]}, "id": "1968756490411048", "locale": "en_US", "screenshots": [{"file_name": "02.png", "id": "1506016057740494", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314657_1506016061073827_8392164705989798001_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqTOZOzNiSsQ7kNvwHmjp6A&_nc_oc=AdpMGQOwTlGFLknlBEa0iwK8Pz7sJgbBb0cM6G3sxdTryp4jTK7ehBbHHJ-WFn_mOiQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7EtEVPFELqRAnTnDBEs8yGravBWrIGUnPcWqa2iEKUA&oe=6AD3B7C6"}, {"file_name": "03.png", "id": "988783110565370", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499300541_988783113898703_8631220613921703153_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKvrMZwsdQEQ7kNvwFW4rGR&_nc_oc=Adr4hlfuzOtqUtVN_mVX0V9Kp52iTfJi6LWmGgu38NYz7ymSWkynTEK0HPgyOwLQ3i8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOxCHezSmkfUTnUQjsT0O37FBPNu3N4neQtjk0Wl6fgA&oe=6AD3867B"}, {"file_name": "04.png", "id": "1351569360403079", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298790_1351569363736412_4669347196592878590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4jQLY78xy8Q7kNvwHPOgfe&_nc_oc=AdoK6ST4uLpM5dFCxt9jqpKWr8M70Qr3IwrqI7y7wdNoHxga9Q5j9rE-VS1dM_AepIQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfIqa5w822qpEIIO_E7slCBkZMXP20n-BgTGEfrIjiEQ&oe=6AD3871E"}, {"file_name": "05.png", "id": "1355250863168631", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307309_1355250866501964_2756353681174667794_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwCqLoXjOQ0Q7kNvwGgeYrt&_nc_oc=AdooAME7xk3CDUUB1EEPHJl-7Ebp4_eHxg4A5edFU_n02W2VbjV7Oic8gXBUrErXSvs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqvU1AvmzJAllvYPM1iHcvOKvkJBoR4L9iNiDxRm_3Fw&oe=6AD3ABA9"}, {"file_name": "01.png", "id": "2379160409234343", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499314648_2379160412567676_6934786071623767694_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5m3Jgw5H1EQ7kNvwHeHf_R&_nc_oc=AdqeNMp6UMtrWsJD-Pyy6e4r6GFoY-5VRaXQbX9PQt5nSa4JGqTuBwpwuh-OP12pjrM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcHvqBqIB0kJ0tgToC2cTg-LTPBIxw2s6EMU9Ddama3Q&oe=6AD3B7EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_Cover.png", "id": "1414263040849091", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823905_1414263044182424_6032869734681018677_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVcYy3x8sEUQ7kNvwHEvlyn&_nc_oc=AdoeRik0otVQ-ZR9PhgleQxTD3cCCCYIEV25f1oNN_VYkn5LlxX-y-xsHj2n3y64BAg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOmydYSWBOfoZK4A4c42W8tDwV8WV_oAkc0Y-g_nChrg&oe=6AD3AC94"}, "display_name": "Neon Chuck", "keywords": ["rhythm", "fitness", "action", "synthwave", "arcade"], "long_description": "# Feel the Flow. Master the Chain.\n\n**Neon Chuck** is a VR rhythm-action experience where physical momentum meets high-energy music. Forget abstract timing. Here, your movement carries weight. Swing custom, physics-driven nunchucks (nunchaku) to shatter incoming targets and turn every impact into a stylish display of kinetic power.\n\n# Core Features\n\n- **Weighted Physics Combat**: Feel the drag, momentum, and impact with custom chain simulation. Your physical swing power directly drives the Kinetic Scoring system, every hit feels real.\n- **Trick Shots & Chain Reactions**: Launch shattered targets as projectiles to trigger massive score bonuses and visually explosive combos.\npersonalized swing.\n- **Play Your Way**: Full support for Standing, Seated, and Lay-Down play styles, ensuring maximum comfort for any setup.\n\n# Immerse Yourself in the Neon\n\n- **Audio-Reactive Environment**: Flow through handcrafted beat patterns inside a pulsing, sci-fi hex-tunnel, all controlled by a sleek, transparent black glass UI.\n- **Original Soundtrack**: Master bundled tracks, featuring high-energy hits like \"Velocity Point\", \"The Calculated Move\", and \"Sunday Morning High Score\".\n\n**Unleash the Neon. Master the Chucks.**", "short_description": "Unleash your kinetic power in the ultimate VR chain-weapon rhythm experience!\n\n\u2022 Feel the weighted momentum of custom physics-driven neon weapons.\n\u2022 Strike and launch targets to trigger visually explosive trick-shot chain reactions.\n\u2022 Flow through high-energy original tracks inside an audio-reactive sci-fi world.\n\u2022 Choose your play style: Campaign, Free Play.\n\nMaster the chain, find your flow, and become the ultimate Neon Chuck master."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rovingames.com/privacy-policy/", "developer_terms_of_service_url": "https://rovingames.com/terms-of-service/", "publisher_name": "Rovin Games", "support_website_url": "https://rovingames.com/support/", "website_url": "https://rovingames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
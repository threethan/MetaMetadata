com.medvr.nrp_eq-20251007-155947-0.00_00_14_53.Still005.png", "id": "1910379529911902", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818943_1910379533245235_4710911537060047151_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4rmuZuPWh0Q7kNvwGMU2Wc&_nc_oc=AdkVOc7UnYrrnCpEoPuTbUwU4fCCtxa0TBSh8HWmvRPDqM1QAX0Z5A0ik4E2wlMnJnk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv6H9CzNOSTlvMYe7lkDIM0UCEuvy8vJC-4KbzU2HjzNg&oe=69A449C9"}, {"file_name": "com.medvr.nrp_eq-20251007-155947-0.00_00_01_09.Still001.png", "id": "1309942576951358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820559_1309942580284691_6729993173347973829_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l6POR5Gip8Q7kNvwGO2u4n&_nc_oc=Adn57ka0D1mGf_FrBKh9PAcmfvoyPhi6KU-P5Wc-tebvSihmCMd3O3D06pIzqJWTdwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfteDmnXIE7gTE7A38IPZOp95wNUANbKKcBDlb7l11TEAA&oe=69A42694"}, {"file_name": "com.medvr.nrp_eq-20251016-120813.png", "id": "780587854823263", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827130_780587858156596_6069951116015656116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyw_HY-mMZsQ7kNvwFAklft&_nc_oc=AdmOplxeij1W3764-RRQj1RnaDRBWl5YIqCjRWjBFDn-2hCnES82XSEqa7aU4rL49Kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft6klUACodutzSMzg78XeS4lBROhf3KlG-PkT3sgIbsPg&oe=69A4277B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NRP Equipment Review", "keywords": ["NRP", "Medvr", "VR", "Medical"], "long_description": "NRP Equipment Review is an immersive VR simulation designed to help learners and healthcare professionals familiarize themselves with Neonatal Resuscitation Program (NRP) equipment. Step into a virtual clinical setting to explore, identify, and interact with essential NRP tools such as resuscitation bags, masks, suction devices, and more. The app offers a hands-on learning experience that enhances knowledge retention and skill readiness in a safe, controlled environment. Perfect for students and practitioners preparing for NRP certification or refreshing their equipment knowledge.", "short_description": "Explore and interact with essential Neonatal Resuscitation Program (NRP) equipment in this immersive VR training app. Learn the functions, handling, and setup of each item through realistic, hands-on simulations designed to enhance your clinical understanding and confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24654520380884375"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619668_1379168560495052_6607609252003207036_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mhPeAyk869gQ7kNvwFjt1XH&_nc_oc=AdkmtgBXxd3LVAOyHBZ35BG1ml3OHTO8p1peYZOeslUQHLkJOo1XSrGGgbY_NZtI_h8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft1WJprythqFZ98wKhpCLCFM4IGgMBBGbWkScSwmsR6Eg&oe=69A449E5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "NRP Equipment Review", "platform": "ANDROID_6DOF", "context_category": {"context_
_1309942580284691_6729993173347973829_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qAIfEnVYVIQ7kNvwGHh37e&_nc_oc=AdovZPfGFYwqnytETOzfv1G3OPkQKOEV_krym6-JdSkctSpO5l_Ar6OOrjCEEincHpI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4jrFMkqAuQOkeW4UPZjzG7bF5Umccupms47DOQV0wxQ&oe=6A6DDC14"}, {"file_name": "com.medvr.nrp_eq-20251016-120813.png", "id": "780587854823263", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827130_780587858156596_6069951116015656116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOENApOylmYQ7kNvwHJcBMW&_nc_oc=AdqNeO98m2kBk7sz2HnkX6muF93bj_VJ_Huil-iSA8tmsA4OX_7d0Z-HbAWFNhOtVqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp2InK0V4X6h0iM6xi989C8AfCXp8YzjFpmCK0s67vhA&oe=6A6DDCFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NRP Equipment Review", "keywords": ["NRP", "Medvr", "VR", "Medical"], "long_description": "NRP Equipment Review is an immersive VR simulation designed to help learners and healthcare professionals familiarize themselves with Neonatal Resuscitation Program (NRP) equipment. Step into a virtual clinical setting to explore, identify, and interact with essential NRP tools such as resuscitation bags, masks, suction devices, and more. The app offers a hands-on learning experience that enhances knowledge retention and skill readiness in a safe, controlled environment. Perfect for students and practitioners preparing for NRP certification or refreshing their equipment knowledge.", "short_description": "Explore and interact with essential Neonatal Resuscitation Program (NRP) equipment in this immersive VR training app. Learn the functions, handling, and setup of each item through realistic, hands-on simulations designed to enhance your clinical understanding and confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "sup
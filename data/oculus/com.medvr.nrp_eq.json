_1309942580284691_6729993173347973829_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yc2XDDVh98Q7kNvwFRwmn9&_nc_oc=AdqF6IreBAEwfNP0m1HjSsvFpJjXEJ-aWWBMr0S-i2uwg-MjctE0DxQsrpSUTsclGhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE61ep3A3RnFb1YyLpCPWJo9VvqLgTbYo5zp4IL0Boe8w&oe=6A786814"}, {"file_name": "com.medvr.nrp_eq-20251016-120813.png", "id": "780587854823263", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827130_780587858156596_6069951116015656116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdE5UGSNk5MQ7kNvwFzCkcR&_nc_oc=AdpeiYhtAKMtE3MAol6XqYG6wsbpUx_tyGpcgL2e978NpfWZY8s-3mmBqOmon75DwqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgGEBsgkBXHjufWF9dTEBYKmUR0nQpYXL2_KjSrd7zfg&oe=6A7868FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NRP Equipment Review", "keywords": ["NRP", "Medvr", "VR", "Medical"], "long_description": "NRP Equipment Review is an immersive VR simulation designed to help learners and healthcare professionals familiarize themselves with Neonatal Resuscitation Program (NRP) equipment. Step into a virtual clinical setting to explore, identify, and interact with essential NRP tools such as resuscitation bags, masks, suction devices, and more. The app offers a hands-on learning experience that enhances knowledge retention and skill readiness in a safe, controlled environment. Perfect for students and practitioners preparing for NRP certification or refreshing their equipment knowledge.", "short_description": "Explore and interact with essential Neonatal Resuscitation Program (NRP) equipment in this immersive VR training app. Learn the functions, handling, and setup of each item through realistic, hands-on simulations designed to enhance your clinical understanding and confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "sup
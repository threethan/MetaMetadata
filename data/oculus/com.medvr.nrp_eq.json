_1309942580284691_6729993173347973829_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuyeV4WLGpgQ7kNvwHaKXrC&_nc_oc=Adqp-xg4u54T7X2kQMSsD1kCXzkO4_yKDDiJcgtEtowH0NQRgz7t_b91JR6oNQ8N9sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDaU7yazqsLMEgzmMAMRuAAAdLAhhcTebJ3z1NMWQnyg&oe=6AE75E54"}, {"file_name": "com.medvr.nrp_eq-20251016-120813.png", "id": "780587854823263", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827130_780587858156596_6069951116015656116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pPeO8c0yI4Q7kNvwF7BUye&_nc_oc=Adps9Eq-8RckDd9o_XhMAsd15DJm4EpjLJHg4Vyiv2uwvsA-nq1FNBgShx5FigJunQ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwsCnd7Wapn-dbBqDT_kLrJ_jKgb5isredH08rH9QmiQ&oe=6AE75F3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NRP Equipment Review", "keywords": ["NRP", "Medvr", "VR", "Medical"], "long_description": "NRP Equipment Review is an immersive VR simulation designed to help learners and healthcare professionals familiarize themselves with Neonatal Resuscitation Program (NRP) equipment. Step into a virtual clinical setting to explore, identify, and interact with essential NRP tools such as resuscitation bags, masks, suction devices, and more. The app offers a hands-on learning experience that enhances knowledge retention and skill readiness in a safe, controlled environment. Perfect for students and practitioners preparing for NRP certification or refreshing their equipment knowledge.", "short_description": "Explore and interact with essential Neonatal Resuscitation Program (NRP) equipment in this immersive VR training app. Learn the functions, handling, and setup of each item through realistic, hands-on simulations designed to enhance your clinical understanding and confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "sup
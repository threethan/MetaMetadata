cQ7kNvwFd7H8V&_nc_oc=AdkSjRIX2nnh7QIpGKs0woXUToZbZS2XZen3oqhym7v2ahGSqk_OSt_LuUZMQD70Oas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftd4DvK6aWCBOnwIU-5zNpqfnsTYdg6bzn3up5P0DliTA&oe=699EFF08"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrcWQh4XcpMQ7kNvwHDL05k&_nc_oc=AdnHhn4grRArZUzZRIXkYntKXA56Ty7REmdkWmUzR52xmpYBrxt4T1L6wX_i6S7QSD8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs08yy-MT0ZL1s0b9oiYiAmnFoALgHbJ10fwKtdtv6ulg&oe=699F0282"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyu239jkFJQQ7kNvwGyEs71&_nc_oc=AdlcxzS0S4cEHmIq7vl-nv29jc3SafChAHsU_AiqXepk48VtKUXtYJPpeYGg5nLvjes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsZtuI21G4q1PaIQznDsWWybbL2U8132KcS6KA9QjA-Ug&oe=699EE43A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfFqLqdFeZUQ7kNvwHcq9Ns&_nc_oc=AdmuWr_iqVjKHzlZFbQLmq_PA0LcanQ7if0q4I5l1nbypuMhkF2umTQOSA0DCJeOlBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsUBKZ99IMsc5Hh9pm_-Ugud12uHtNY99VE6_s39T_wJw&oe=699EEF4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJTeVaYcFJIQ7kNvwHoYIA-&_nc_oc=Adl71GOhI8IcLfPSRzgi5g3hRn1MT6j4ZHANl42OMVDi559xH-vB5Ij--lAgxW-CTcY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsICJQJbOmEdHm_UAD4Sg0pZCmnxfCkB-wbD-Nnt0YSkQ&oe=699EE8D7"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, 
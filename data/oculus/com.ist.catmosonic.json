tps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZIp_VEOYAoQ7kNvwEvFhGX&_nc_oc=AdmWHJ9O1htVt-SvOy_nhz_lW4uL-vf69BY0s1QsLhijuVRoO808q3fIPnH91xk9Ij8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1J5_hZfMTIuRvRaDmvNisZxAVXXiJ77FxurreIVXP_A&oe=69BC0008"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYsir6rsabsQ7kNvwHA7yak&_nc_oc=AdnlnKfC4mNv9nyjc7wkKToOnEiBU7Vx760SvQU4nuc-htC9ukE3rwTAoOC93QcaBFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-QYXTe2-1GC53z0oaKuwxFmsPp4Gc6ncj_H7jWflikQ&oe=69BC0382"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHjS70i4_sUQ7kNvwGdZt7e&_nc_oc=AdmhTkNaDBq9NQT2O6XFkprLdAk_9ug4eWopTqWgGHleOOkQYjJjn9gjqKfFWLpNE5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzF6DsTyOuWfjV15ULOUE98XvGbrHmZZDSeS3P0vUWrtg&oe=69BBE53A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n93McbzxiUQ7kNvwHxyZsk&_nc_oc=AdnJyzAN0jwRJXaksH0Ujvh5lSahDbh5gRrXH2jvZi5De8Vh9uVQa_AgpvgQXi8waAI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy00e5AuOHF3uE5ggZ-X_I9mYoDZfgDsJo4d1uhIeME7Q&oe=69BBF04E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gPfgIWy_CwQ7kNvwH2Qjjp&_nc_oc=AdnuLQYxfPmLYlvuYLyH836pknEReGj7UknZXX7tKW2iVZU9l78faLQ189roaFRhRMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeVwOm_GMxi25Vr4_t-cFErUmcX4NIg6S5uQKPWHNw-g&oe=69BBE9D7"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url":
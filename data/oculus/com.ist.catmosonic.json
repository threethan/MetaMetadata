91820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyVinS5iiqIQ7kNvwEai1uH&_nc_oc=AdqTmyMslb0sc1u-O6CwrFQdxrCizJrUZJ256fETKZdcNaHf7Kh_67VP5QTIkVrmrMs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjZHPIdiv9Tc8wcqDslCJHFYADNUxrBkBZS_4w2aFgsQ&oe=6AD22C88"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKFljQz-pSkQ7kNvwE5I5r2&_nc_oc=AdqBML89uE3BQWCVgCJ-t0PL-DYRldzNcwgbOoEDxv43ra0_LkjyoD-f2uJHDaPpbNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTX7gX5cfj4jTyYKsUJrKSrnNjnHz7WzxeIlgQEZn-Vw&oe=6AD23002"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2zsom5NXC4Q7kNvwHfQRtk&_nc_oc=AdoRjmv6e9cK-NSAkxqQT8zroV1cl05kiTdBu2vOPgzkHRgxZdBNVfmg89fe0Bm1R6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdPaHmXV3LAb-h7wqTifSP293i3rBJHeO-ioOaKDMD8A&oe=6AD249FA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaHvYgSj_5YQ7kNvwGSU119&_nc_oc=Adrr4KpK_4m5EW3Az2_VLlpdStAJXaf_r1Ns_lflyQl7vf-hyskkeOWI_JkJLwTNVTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3lsLcOtVyz-JvxL4dwvUJZzI5Y1hHzm203Qg1vxCsuA&oe=6AD2550E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvBxpUo664QQ7kNvwGpxt2u&_nc_oc=AdrSfxgZh-xxQKSKiuFfBBsGF59t9B0rmbtSFFnL9G0lsribAQZgm346x10f7nsNf3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNseP8VrdhLRWq88M4Iz4iE_M8rl_DcxrOUcggU30_F6w&oe=6AD24E97"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, "website_url": "https://www.catmosonic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24816391041380558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827646_2149485165839124_1281185112460763741_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSRMmWvUGaIQ7kNvwFUiwPO&_nc_oc=AdpMl_GfP9WkCPW9NNl0XXaQ4O9s2UbUGwFgjoxq8dnz3YXKIh4HxKTTo4Gl7AR54_A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsoJgHra06KePQsOxwwq9HG72-vBnpMutZTckMQLcY0Q&oe=6AD24B90"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Catmosonic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1771488000, "lastRevision": {"nodes": [{"id": "24816391074713888", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24816391018047227", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2552179244749318
gQ7kNvwG1WUwa&_nc_oc=AdnQPw73JymnYHBCVry5TQlAq7g4FUFtirHRzQ4e2cQeEMchMJwfS0iAFttznlRUPdQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftxUvN_P2qPBprmazmldIDyyWZjFGGn51A5vbjyTHEn7w&oe=69A44508"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TrCUophsKWUQ7kNvwEPZf8T&_nc_oc=AdlzojlJzSJwGpik1-OAb1JFrEGEBaHKocy8un-jOXYc3rJV28ZCOwt5bOv9bM4gxb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsgbQNgxqh-DcGA7iy0b6MZFibKBbfMRMZDc3SiCMhx6Q&oe=69A44882"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0x8PRTh9uoAQ7kNvwHqla6i&_nc_oc=AdlYX5NZXzYeTspR-M1FA5upw-90Xwb9oyWL4JVD9NnLvXWI1hQTp-jeMNGIS3qey6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsmz8kdEtKuqAEjGuZDA5ChDp1gXjjGN-xfYifa301xRg&oe=69A42A3A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SBt9GMiXrEQ7kNvwGxAbtX&_nc_oc=Adkj3TvxJ46X1U73u0J5gTlBmhkI3tFSiK7NLtjrdDxqgdWJNCT-mwOTNvijHZ77ZMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCgSIByrFbwJwbmca6rmkPmKj6Nm0VYgLl3nXL0MfqNg&oe=69A4354E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fJPqQG-jk58Q7kNvwHJtqhu&_nc_oc=Adnd0kGcSXXEYS_XFMOTe2B6mAsc1zF5uik8pTUQYWheZrQVwDv1_BcfZa_jPmtSx1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftfjQCTgZTQfRO0u4USHQnALFdr9ZA_hw0iTcg5V-nIVw&oe=69A42ED7"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, 
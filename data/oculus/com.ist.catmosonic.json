91820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ4qXZQohXsQ7kNvwGjJ3IV&_nc_oc=Ado3hfvGjo-flY7YSOfqjL4RFs2OlrBNJ6aQHS2USme5aSYZ5Mfv686I_hwR2YXue1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNofBJtdt8DFxVVYbGKzyyLZ_kWnHtjvTgblkHZswQSZQ&oe=6AC64F08"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzRGFIuVqxIQ7kNvwHH9uZb&_nc_oc=AdrkYsCIjuLaZb6Ybfe9htvxNjznKBFVoNZnuDcselybvJOTZnLOR0Hu2iF8_swBXeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK5crWe_CR9i-VpQgR9hw2BFdQbDIiJs73N-DcUOISkA&oe=6AC65282"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-QXtZQ40wlgQ7kNvwGlJTv-&_nc_oc=AdqGuT0NXQJV12ooQmBN2TfjbC-rEHFF6QOMr_YLb5o3lt2BtFG9t_VF_K-gq0ho0wg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv1Y-TEatUWnMVkUhFntjRL9rHdvpFvgK6b1JnaTNyQw&oe=6AC66C7A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92hKyjqe-Q8Q7kNvwE_45Cy&_nc_oc=AdoY2v3qA98fx7G_uqW6X6XagGfg3AlON-CAWc147gmbUHEi5szo0iOBNt1PtlPWOec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwW-JSNseQnQYjJRwNEl9oWEPJllMUUSOuAw8sxXbN3w&oe=6AC6778E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hz03lQCXrMUQ7kNvwH0t5NK&_nc_oc=Adr5j5vFsqkG9wA_5azAgjZ7SZ11Xp_HWmJrw0nDTcEJZ7vJq0W-N92HQtlJBbG65CQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvGoOdMZnMMnhdqwJxoMs6H_j6PZG3pOIc9c-PQUgBNg&oe=6AC67117"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, "website_url": "https://www.catmosonic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24816391041380558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827646_2149485165839124_1281185112460763741_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7epR3fLAVYkQ7kNvwHBY427&_nc_oc=AdqpIYSLj-17UYMjL7-rWJ-SdgPMfh2n851UQIGx-fpVluBHGPlUuBTgsIKhItFf-KY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDBKCNxicNh7XZwKv7TdlTRn8o2apbB6ONxYfiIE4Fyg&oe=6AC66E10"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Catmosonic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1771488000, "lastRevision": {"nodes": [{"id": "24816391074713888", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24816391018047227", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2552179244749318
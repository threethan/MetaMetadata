675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L-n47l_JSoQ7kNvwGUJI3A&_nc_oc=Adk3om5iO2UUa78fE8iyb6Zec-Go1VoWXr0ntknPIZnr2RNpoMuhGKZ1EzakTVtUeDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgXhRwt7U-7Ox2D3oi4bDtjuTQQ5SRctDk-9UbPtkD4Q&oe=69AD7F88"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gnkrda5GUSEQ7kNvwEbazRP&_nc_oc=AdmUfZstxBxd1xbRpI31nc5XDQ3E8GHIMg-qx1bvnSWNItZYBBuRHpFVsoI7JdANdjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyBhRqMa8FTCvya781KEahqlY79Ae6cSzgrtPZibALsIQ&oe=69AD8302"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT9Or7V2PMEQ7kNvwEdNk-2&_nc_oc=AdnzILRg27Z3dfzIqwa0evIwddyc3Cl4jwZV3g6UdlVjxn4nqglxV8eHnkguSvlQco4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiD5xUaw6X4CZkSa26_YPMmSrZ3N1EXuw_w7gwo6tsJQ&oe=69AD64BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acnidLV1O7IQ7kNvwGaUeQ8&_nc_oc=AdleZ6hlw2lrpOOnBFrx0KnDd0Cy3OKv6No8JEmCBV1-X7lzWykOfCHE52roT1l1Aq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDH9aLPoqbxcTTHGysyxS38wMQS_9FAiDVj1SdL4DSlg&oe=69AD6FCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sw5AUdMzdpgQ7kNvwFmF22v&_nc_oc=AdmSdx3r6ZZutoM1cXruWMNPOIIz_eUDf_qfMBZHRP5MbYs2Vy-n0QCNFIUoTfTqfZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz8q8mOmABD7oUNbnQQzbVNex4qQWVNBCsXnst_fnqbtA&oe=69AD6957"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "ht
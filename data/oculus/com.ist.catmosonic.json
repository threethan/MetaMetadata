tps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyWOgx8_Jg8Q7kNvwHBDWON&_nc_oc=AdkhlPQmwLxK1AmOMKlGzZfnwUpUdeUxQ1ZAqakyjxVVB1MheV5DNJLwtvW_h6ap3I8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuM7Z-_4EQQruhlFYuJvIwacQQ9aINAcoqpXpUO4CG4Ug&oe=69A83988"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yh7Z8QNnaIsQ7kNvwG3lAY1&_nc_oc=AdnUSCCr4Y3I9-c4BIt8IUOcPeHsAQ_oEnjjO8l8Yyptq9IYPZ50YLkr6MHehfT-1jU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu4FxGRqUkwpwT9dBy7764SUA122V6JqJOssYg1cgegNQ&oe=69A83D02"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q33tWt-CsBAQ7kNvwGOM5DK&_nc_oc=Admp1A_5cPOda2MEMPaHHAMswPxQL3P7QTevssSZH2DAEL-TI9m5e8PjFbg7wo7CKqg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu3kv_RQY2Vkf76ydUsH4VfPT9VvHPstwQxLyEp4GKvSg&oe=69A81EBA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kitB_iyvB3MQ7kNvwHLJZ3h&_nc_oc=AdkVo7usN-hepO19YPV20r87ACJW2Tww-ZPYXTer3RKY6yL1qCLQ-HVih-1wfPGNyqE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsBHbg6ItJJHAtMjQO_30L1iXkZO_pGZa5MVgdadPo06g&oe=69A829CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BS3kfWreb-IQ7kNvwGbh3KF&_nc_oc=AdmUaAhXMFGKaTAS696UKgyJxfJRFjuZ1DKQhCkaHjxJvSL4CO4ssnYypqd1zykswW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfssRLIJMasNxzmJjDZgFvgvIP2Avb1RhzJRPFu1OW1e3A&oe=69A82357"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url":
91820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9KoHulwNfkQ7kNvwEHxDeM&_nc_oc=AdrZ5SGfHzKNZL_SOA198RoL4osPlXN0uDjgDW8TOXuvB14UkWAjYMKkpxyYOSayFcg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tTMZGpxMoktbh5XOcnsIkgcexGXZNTWMiduMmIMzWvw&oe=6A33F888"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S8h4KlrSC8Q7kNvwGYsIRF&_nc_oc=Adr42_LcRtesJxw_L8keeZDnhToprDhwshrKcfVacGSbYd8t0LKLI4rafAQwYe7NIuo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Llz0gBaeRTWlojf5Bm7YJqcfVKMj7y0-BE6YjCeER8Q&oe=6A33FC02"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnwIKSrAizQQ7kNvwEjs8Hb&_nc_oc=AdrhvcPLJ81LmZQOYw-qi70jiuk2WU7mbYnUSww17R1uogwrURkwwtkFQcVlKTTX4zA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LPED1f-wuOdhpn3GSN74F0QzOLcr42_7_TYsp-NCQtw&oe=6A3415FA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H2gDQV-E3QQ7kNvwGIFfc-&_nc_oc=Adpcun7vPjCTnSJOuh9AE99wHqlHXnOoAyNBHk1wvSXxLFGUTOSNdXbDpgx6Dc-licw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gHmVsgkJCduMeP3ojFfgso6Z0HyevSBuuRln0ImdPvQ&oe=6A34210E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4vco3jKzK4Q7kNvwGThLkl&_nc_oc=AdoC6e2braVxk03yBatggF1gfy_7hrHR9jRgwuCYg64CF1KOrwMX6AgX2LQOe6SUHK0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_isanBpa_Y8n3IU_tV36vH5SRXXYNohiyhv7QWQR7Oqg&oe=6A341A97"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/pr
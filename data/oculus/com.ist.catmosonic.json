675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36NS3cH0CQIQ7kNvwFa0ZC9&_nc_oc=AdnjZiOrptkZHoPO10T539BZHFsLFftR2Y5DZoaAlKsvX8Fq1gHGCrN7zu0vawfzW-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6zujgOKs16gXSJchvQ1cDFXO1fZfg_wsZOBhMgUl5MA&oe=69B17408"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2KhrR75ApIQ7kNvwG76IAG&_nc_oc=AdlxHm9xVST4YKvjuAXKrlqFXAKWN_JFpqL_PXgEZDu9tvrUuOIjMhU8PRuNVEHe3OQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzm9BxX_Hkj04tO1-RIzTmDSVenFCAPRqrFsUOfLJEj0w&oe=69B17782"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbc7D-1VGDIQ7kNvwGWIUgP&_nc_oc=AdlDKVFkdkX0biuTv9B55Bz6gnCLbdQgt0-McyWEgrrjrx76mgLmXmsrCeO54ctL7-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWVkMcfjWoDEJjJ_63bVtU4OQBs9i4w48NjB3b1fWAXQ&oe=69B1593A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-1JY20UZNEQ7kNvwFg5ZXs&_nc_oc=AdlnqMn-_I9K6vwZgs8E4GKzei-RYYpPIK1lAVxuYalp4aAokWg29Up4cL2QVER-kn8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfySWPcb80Wq0AWvckVeFywawU7OufcUK7mFEIeJjdGI1w&oe=69B1644E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eft6JHjwBAMQ7kNvwHcQNOg&_nc_oc=Adnuuw9e3usxkzjQFQXo1w9IQG2BA1dMQ2qe_YD4ueGKaK-biQ7Djn8tDzWOubEPLh4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvqE90JCHJ54SH765FAsAuM6NyxVBYWRHTl-XHY4cxQA&oe=69B15DD7"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "ht
tps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZIp_VEOYAoQ7kNvwFvBJlQ&_nc_oc=AdkcVM7fn98Ju68qbefuWEAXekByuzezaxkpfofsrqSNOdm35_QYBwqElGZsW4WZXCQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCKg90V2A21JjhPzCDz7wpE2OQ1fZMBsveCGewNyo1Vw&oe=69BAAE88"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYsir6rsabsQ7kNvwE8cZqn&_nc_oc=Adk14JldZllhEoeJii5zpZMqXmo0nN0b3Gch26T5MciozPAZR_fLazbIVU3XdGj6ViU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxn8DIKArJWhbLet_tXq6X0mW3pswmueawRZykdEQOvkQ&oe=69BAB202"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHjS70i4_sUQ7kNvwEd3WmY&_nc_oc=Admclb9MU5dRe25uqmMLEOt1lx4N9viYYhVgHnO-RUnr1KAn-7ss6DKpzMzMc_ksrFo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwoLuULxCyCEPOUozlz1w2LYi1ZPDTGisTIINGNXyi9GQ&oe=69BA93BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0n93McbzxiUQ7kNvwH_rkca&_nc_oc=AdkL-mSmUT7PtTtWS6vjKyLHv-AykjJOj01KG0vZpp9oo5Jj8_VL5iGPsrrIZ1F6Qfg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9C0KxZMV2UHvu1IAPkuMjWXfZBCUG2pGBZsI2A4AY5g&oe=69BA9ECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gPfgIWy_CwQ7kNvwG98BtM&_nc_oc=Adle4Y8WebhjvkkXtsKC7XXh9Nsw9M806RsQveADHV0xQ4iI8-L-VRFYsUc8uP0oU2I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgbGjmIInjATICxJPC2ibSoa9607RNiVuFzs9TZWVldw&oe=69BA9857"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url":
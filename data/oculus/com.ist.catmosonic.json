e=6AC7C6F7"}, {"file_name": "4 exercises words.png", "id": "926056739940343", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ4qXZQohXsQ7kNvwGAUocy&_nc_oc=AdoPg8MwH61Goo_jM8ntA6q4jbYHQEN3jw53YG-lkSC67OqPN9QJj8ANuGyo5mpbUgA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBicsfajLEI1WIvTN-uBUfDP3KTJf2IZMKXod_Od7J3g&oe=6AC7A088"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzRGFIuVqxIQ7kNvwFo_SlR&_nc_oc=Adrg1jkKuelFcTFNiZaxzwrIFBL2IYt8g9FjFQD7rFsolItC5osagIY9uBtt_QvJqkA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHCC05o-P2wMmsRDIs4L6q2sA0ju4JLK0M1QGyNES53A&oe=6AC7A402"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4rEPXMVsbwQ7kNvwGaYoPd&_nc_oc=AdrMyeIJVeAAiXj7FnIqnGGz0Aao_3NEhbQiGwbCQiZkQBimGydotSQE_09OS6xizJ8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0uaa1Kn3NpM6y3vHUee-dXkwv6pNsdA-tVO04d2N3Dw&oe=6AC7BDFA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92hKyjqe-Q8Q7kNvwFIr-zS&_nc_oc=AdpUa-wPT0Vk_81QqGUWbYyRZvDNhUVF6iw5q4Zd_MSmC6X7vVpSKNI8X4fG0PbW6A8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsRjpWYhq-6TmWvtAWJIoweKNkNCugfQ-NjKKTCA8sAg&oe=6AC7C90E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csIPgvG47qsQ7kNvwGiNAZY&_nc_oc=AdoF-CJjZmsMI238NuMvxQ7cZ3DGmKn7LpS9V2KJJhQIxPtqINV_gcFBdfqJiA94q6Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSXVg80MdzzfhjEu3pVBKcsQ0z8b9sbBCOEuMOaDKa-w&oe=6AC7C297"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, "website_url": "https://www.catmosonic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24816391041380558"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1865870960720538"}]}, "baseline_offer": {"id": "1865870960720538"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771488000, "status": "PUBLISHED", "id": "1865870960720538"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26043822598637390", "version": "1.0.2"}, "id": "775538828731038", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24816391018047227", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26043822598637390"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "775538828731038"}]}, "change_log": null, "created_date": 1770414
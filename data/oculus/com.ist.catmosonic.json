tps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcgpyZOiVm8Q7kNvwER-jX2&_nc_oc=AdnvRKat3XrojaPGneiAcjEoOguuUGkvIu_wN2yUwrQXhe9PQuioWi-L7I6DxTKiuLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXGfzZ2JxUdh6NP2RKromJSRQbicxoj8pLoaqGIf9UPw&oe=69BEA308"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXUZD8DzoM4Q7kNvwEDosUS&_nc_oc=Adl_gBGojteZ2mUXmPMkCp6rGRoGV9JdAuNdnRu_qHE9R3Lf4g1oreZdYG0Van6sX5Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7_hLCB6FM-CvDeMejRnZ0qb_UpfnBeifn6lIDZ8tMAw&oe=69BEA682"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr--EKy3dRQQ7kNvwEvYc5L&_nc_oc=AdmWd5BEZW2Pxe8NTmqjgNysB34wsftkYRJbCiYbGswpWJKN2-2TWBPcmrThrDZzAqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afylj11SuSVD_lzncJc2T-q-Lwn59vPSUOYXpY4i0lzlfQ&oe=69BE883A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sC_vlKOCy4Q7kNvwHHpKB1&_nc_oc=AdnW91EHmXGxBLPJ0wEdt4AIOeKwMu2-tw3SzFh-0DeyW2WAizdpMdg52wIVqJvDG4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxa0JjX1Yf2bvDV0JLaQYIb7bTSa7AJZdTt7iz9dTuMRw&oe=69BE934E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnnYLbIhcRcQ7kNvwGav_3f&_nc_oc=AdkOlyLksUxgFX-rZl3TQdGi1Grai601L8UV_Hbm0h_DltlsNUEPr-6XOCX9-5S_JLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyaLwojsT6e0SICxgbeH86uzwIthlYOUn_aEZ05JrPag&oe=69BE8CD7"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url":
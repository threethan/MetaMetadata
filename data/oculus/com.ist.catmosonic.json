91820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CObm4WYxCisQ7kNvwFYHYJy&_nc_oc=AdpbthyDg3LN10E-vFw6e5yGLrTis7_yTTUrikfxgWsl7ryjGoU3QsVKvmGJZ9DuGoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ibjKF2Qfl2KzdKKjgDna7besM0iMG7MAdr96M8G1OWw&oe=6A1EE088"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G_gFb_qRlAQ7kNvwGnaInr&_nc_oc=AdqCBnsYZ6pimP8nhBf4t-7kYzZsmh3Y9o4LkdwDFdfls1CbMTwKQPiQz7cxvXNnrwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yk7B5mKk-HMKdVqb_eEwLKmYtJquS7UMnp-jTMhNlmQ&oe=6A1EE402"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxHlVDvkuQsQ7kNvwHe7LIU&_nc_oc=Adp3-O4aAlsSBRV3kqLTHRoh3ZyjxWDQ5YHXj2iuUAT4YF3NZG4YFdY21vxgbJ_MxNk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ace95A1k9enbIUx228XuL13BW6jsWI18HkVR_CKOzmw&oe=6A1EFDFA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qigD9-3UjA8Q7kNvwEfCzSr&_nc_oc=AdqEZxQi6XtRCw_3mtb3trp_Egm7awspyvyG2-71LT5h0tx_tshx1QHlUqtqMgXsFvk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r7Y2CLimKCWHPesu0c8gFQm16oQpcVb9VoIFBRadw4A&oe=6A1ED0CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hy1w1SmTVsYQ7kNvwG8IbtU&_nc_oc=AdrgVnSdXPlimpvqFhsNgBDaAwoh5tqhJA-K8xAarZ59kVQX-K_Oin-IV8MXV52jkpY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sDW7YNaR408hZOO7Uu2031rCPJ2UHAoVt6nUbVCrQMw&oe=6A1ECA57"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, "website_url": "https://www.catmosonic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24816391041380558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827646_2149485165839124_1281185112460763741_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuUCRpPDTSAQ7kNvwHy6KAd&_nc_oc=Adq-ZOrt08A2E2q1_YGgKy7qJQ23HEm8lrC8kn9mYrhuAVUfrW-KKf9IuVVZ1UalQ88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YC1o3yVClYmn8Q5uISsyOqMjoootLkmMlMcLey2OOSw&oe=6A1EFF90"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Catmosonic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1771488000, "lastRevision": {"nodes": [{"id": "24816391074713888", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24816391018047227", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2552179244749318
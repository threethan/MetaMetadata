91820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pR-ullrqOnIQ7kNvwGbpM8v&_nc_oc=Ado1WkWll8TvB6lh-eMPVv4PFWbAA2e32JGNeGYlJ_RivS3aOWorYQI5vX-_JXFCUpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9gZENsxstvosamYZMgYFwArWPNL_1THEV24KQ0lmSIg&oe=6A37ED08"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xu45w3m3BMQ7kNvwFDH1hv&_nc_oc=AdpOj7bILRB9UihD1s2LEbj0X0E8dqmCKypBsSe5tjpWdLhAiXsoKLgJjKgcSTxtEzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X6N3jt-46s0UE96UPvn38NZXxsFec_nWW0njqDgkllQ&oe=6A37F082"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miOvaECrjxsQ7kNvwHlsHPi&_nc_oc=Adq8NgDN9PpK7Q1_CIDM6_Nmchn_stquoOuggOqwBqkhfqfGThgQZBJ5LmIrv_cFjSI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HqDDKtZib03HzQcPbM5SY0AV5MyCEWSuHRzyUE7aZOQ&oe=6A380A7A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8aD6M8fMSUQ7kNvwE7-KUv&_nc_oc=Adoj3FrGcWgr3E4VqvM0Cprw83sXjcLBi3D0h7SoHS8hf_K3k8PnocPguyKE5CFGNus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kJgd_20eEZ99Bf1EanEFbsjd30xrFdrB4X-5txqejYg&oe=6A38158E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wipiHP65bwQ7kNvwFA7WtP&_nc_oc=AdpsX-viFJyTUSd7GlHnzb1SkmTLV_dSHHclVvIhpJEjycAauT5E1mA1Us1g4CCh6xo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WKLth_Wj8W4djuqAB_3mIjelNEhEe_2bK8ctgXZSG8g&oe=6A380F17"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/pr
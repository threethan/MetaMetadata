71-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dovTJkiOSWoQ7kNvwH11pts&_nc_oc=AdrbNjg3lWv0B12EbqccYxOU0J0sPqt80UJ3TaXH7Enz_GJfvg8inS85s-N8_WtivIs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfIx-5BdpX66sYj_cvbRe6fz_vNDYs7muK7uxi1gMWHQ&oe=6A7DCC88"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Rlk7kXnkX8Q7kNvwERWuOv&_nc_oc=AdqC2E3gbuJRdgMFWaPgKelMMeB3yDdubdSHaI2K2k76xnMKycJ3QBHs8nlMQXEuC4o&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBd5vslxqJ3jV225cm5yimEvMGoN0INqesP5PO9AbjJA&oe=6A7D97C2"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7WGyOAbJf4Q7kNvwHcVKT6&_nc_oc=Adp7yP-2GAVIqMvPuDbJsVZh2yTpey8oJUSKZInGvOlVzBjHOmeuJMyc3kGvN_0C4_U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxjUIYTS-aEfFfYfJ5pu--5RWiHjmWScxw1o3X5ucZQQ&oe=6A7DB1BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVD9N9XucN8Q7kNvwHqIxKx&_nc_oc=AdoaHmKJRAy78Fa7skmEWhrNpGPvRyypZgWfq3NKYEPPlDb7xc_OtrrO3tvFUOeiPiM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn5j9kXtQRzpbq2LUGcB7YxnPcfepqPJLrK9uWDptKLQ&oe=6A7DBCCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XHxpaV5J6oQ7kNvwF_i9RY&_nc_oc=AdrZL_vJjhFkiRjgdmyI5UiRd2_RVpZy7hIdCSCYy-Gg994KSY271UIae0Gnm7_q6mI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_8MnbQPbaICj-CeWVzULN4hvOt7xln4CSAQqgRd7KvQ&oe=6A7DB657"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, "website_url": "https://www.catmosonic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24816391041380558"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491827646_2149485165839124_1281185112460763741_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mADXN4D-uyAQ7kNvwGPAIT-&_nc_oc=Adqa5MU6fDDlw1uZXnWkOZ0WoX5kNJa2173B9TbTmg83uQBwDtaeRqdYCa8oonOX6DE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNw3gCdoXzBqSf_fjEZWffnq6b1iB-Q7DlNsmn9Wceog&oe=6A7DB350"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Catmosonic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1771488000, "lastRevision": {"nodes": [{"id": "24816391074713888", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24816391018047227", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "255217
tps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L-n47l_JSoQ7kNvwEKMdyz&_nc_oc=AdlwQjLSO_KRsGG9tjjJsKPyvqE2YAle6LfptVceKvzCqDIPdI3TGHrnPjwwOxiFzik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2jPU6AyHIKz3yJaFYPlOOqQjz77AtG-1ZiDCfpKafsw&oe=69AED108"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gnkrda5GUSEQ7kNvwEDqS5C&_nc_oc=Adkq5zscWgxkw8fdzzlj52lzqLBN7ERugRMl81PwGkWIvnppjjtKSofDBGCP6iUSbnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdIJY8iNiMN6sV5t00-LYx-UAVS1xN6bOYyjeTqZ7yxA&oe=69AED482"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbc7D-1VGDIQ7kNvwFcSGLp&_nc_oc=AdlA1nwjX9v7UuDWVmo6MOiBEkc_fxWI4ZYI9_q_D8uJvnIw_MRk0QjOX7WKEJxChro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfznZV6uZ0txpLslQQ4eWHf4WJbFQbJSSPfLSy0isZAJdg&oe=69AEB63A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acnidLV1O7IQ7kNvwFJpICZ&_nc_oc=AdnWRpcalh1h4yB89svSC8jYPiqjJ6-IRNhuo2Md3n8MinlZUQjsU1llb9dAYdosa8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtjNpSf_1pweKwXjQdPNFsEsYrIwoLZxCGQWtr08sQzA&oe=69AEC14E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eft6JHjwBAMQ7kNvwHc6lSq&_nc_oc=AdkOH8PFO2HSE5E-m2JQOnzhMAH2Zq3pJ6M35QYmXq4wFS0rZQcde9UH4WW7Q3Rev54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5cmTbfuWAtKC86T0Sx_iVqzikcDfGTQRLtbbsFTwqNg&oe=69AEBAD7"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url":
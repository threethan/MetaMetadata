675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcgpyZOiVm8Q7kNvwF9XgeX&_nc_oc=AdkR31cH7M_bDjtprs24N_xz0QG19wULeSFo7P3u5MbS14OI8LniwNx6GDo4lvf4ciI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZlDN22GRm3gtxYk-sPsw5Egl0dDuRtF7p70nKMeTVSg&oe=69BD5188"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXUZD8DzoM4Q7kNvwG6tqbv&_nc_oc=AdmTlaL0TlXw1GCMMGMhO1tM74vmaN6XE8QN9MJylCzFntQ9atpxNhMzJ-Oy0aZRzv8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQA1jn2G5ameaeBWQ1W4DNzZ6HRYs4_cU3FN1hZjQ2aw&oe=69BD5502"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHjS70i4_sUQ7kNvwEZqVq-&_nc_oc=AdmhgnPAoftam2K6GVFwg_gpD_HjTbBdtyPuiZ3LTfN1CZhC29wTOSzPUPVY2L2lBUw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzN08RfJKvkXAetI1YaJ3S2D4lYCfXz3JD50AUTesi48w&oe=69BD36BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sC_vlKOCy4Q7kNvwGFVGDQ&_nc_oc=AdlWl_8CLOjvCm9NpbkXLVlmZ7NdwwB7VqZb6rKnNFjtsSgVh8vl82UmJRrERVE7zNo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFLowMmc8TOafbompcCrsxL-Zy1pU8JspSO-T7Ua-50g&oe=69BD41CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gPfgIWy_CwQ7kNvwFfxjaR&_nc_oc=AdmozzfUk_IvxWQh-bBgyj26m70Ql_dngtMO93mjqCRb_FvgYI-RHIn-iUngdwD4sro&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwD-VwFXgd48-0psm2kAR-98UzCmC4tpNsWCLp-oxGrrA&oe=69BD3B57"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "ht
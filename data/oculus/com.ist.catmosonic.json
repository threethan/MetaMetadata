cQ7kNvwEzz4G5&_nc_oc=AdltUBXpVZZt0fzkCj5_5A59kQGiiDEikQCyhMhPJCY-BzJbqb31eyYk7oOQ_wzLftE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWXJwfrwQlNzHiobUJAS3fGFFFg6jBofkKhz9peMjpSg&oe=699DAD88"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrcWQh4XcpMQ7kNvwE75g5H&_nc_oc=AdkGCSoK69v-TXKFMgiCyl_k1KJixxtOmMOEaF-TBSp-yF82Xpw-rfomV9U28kwlCJw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUeTU0Bhbu8e6Ut_yaNud_ykJSl1X1fl6iZMv77XFYfw&oe=699DB102"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGKZVZH7hkUQ7kNvwGVkZqV&_nc_oc=AdmeaX6--9bWDRsRgnpthpSkG4ZyhD8-6iv3GofFkySeKeYpzhHp-45WRzOuc46uRNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvcbN5hyfVWZ7XCFPJKlHpl8XaybbuvbCyiKkzLSXKoyA&oe=699D92BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfFqLqdFeZUQ7kNvwF2SUTi&_nc_oc=AdkdPways7mWaKRtiHKnDAxwt6Fnl15d51uc1VWWm4Iq3Kfm2kd0nmL-zXWSlp1Y6vc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsC675LdUi1qhryc1V8GI_2Im6xoSaanUt_k_e9HCUvQA&oe=699D9DCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKesuS5FkSYQ7kNvwFh4-M9&_nc_oc=AdmbYlxQqFgGvLPblxMcF1847v04sA9eXLmZMCw_ttbn2OXzApcRT2OgdPrbcnMCQGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfstKhyJvd80i9aQiLG3E5Bm-2cgro0lYVjjYG1_aTY0Dw&oe=699D9757"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, 
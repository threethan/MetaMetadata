e=6A538AB7"}, {"file_name": "4 exercises words.png", "id": "926056739940343", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxI7Y6IvUKgQ7kNvwEc4pRs&_nc_oc=AdoXF256BZMFnDOFG8nfTrwnhxmNSR-oU7nPFUtehBctSRgLiSd1B9pfPtzoLm7Ye-M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF2Q1aWwmBDDk-XJys5iieiiY3F8Dwh52q2bW4L-P2Bg&oe=6A539C88"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSx93Fn_Sd0Q7kNvwEK8bmE&_nc_oc=Ado2kk-z7xbHHYxzrUBXT00L5nZQ3MexQ9YPznJwW11D4SOuQgioMP9ORy_sE2MWIwg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBobGEsytfoJMoy5xjY6rl1KkkF3_DoMRORhGXd6G2e4Q&oe=6A53A002"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDDiDC-vywcQ7kNvwEUus_s&_nc_oc=Adqaz-lgla0S23HVmubjBu8rnY_HHsDdIStIIG6O8wT4dHstO7L1HJtmoVk79g1eixA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSHCApWaUl09ilXWh3MIIrlIjVTf_2gafC06EF2WW-xw&oe=6A5381BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrCW3IWPWN8Q7kNvwGlOMJC&_nc_oc=AdrHI4iGTZfb80RKohFH7emwouwC2hh-dRZhvYZBwl5s42dDfQAI4kxgaegZnLFhoaE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDU-DM7X7DfLWdf7S4FNJOIzSo-7T-TJYVU5LtSYd9kOQ&oe=6A538CCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMjvadAud0cQ7kNvwF_1MH-&_nc_oc=Adp27my-_tgnLj-fsRIgOkqfDC74m1OeGoFbWfjMKyW0Ax9FA6iAXgAuE3KDTRRfC-0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrtfqcQ3-S658XIXC6E1_5ya1-f8fr_FQZsEFVeZIKoA&oe=6A538657"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, "website_url": "https://www.catmosonic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24816391041380558"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1865870960720538"}]}, "baseline_offer": {"id": "1865870960720538"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771488000, "status": "PUBLISHED", "id": "1865870960720538"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26043822598637390", "version": "1.0.2"}, "id": "775538828731038", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24816391018047227", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26043822598637390"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "775538828731038"}]}, "change_log": null, "created_date": 1770414
cQ7kNvwFy05_w&_nc_oc=AdlDg12bvpSR0SlSfuSf3RsD61DaC_GF7bt9eRURygh1tJcAJHzMYfj_WrAtLMlZ0Zc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBzg5Mc5AVrHntIahqIiWJ3Q8ek5yfS2XWTTmLpiMYPA&oe=69A05088"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrcWQh4XcpMQ7kNvwGQpnhz&_nc_oc=AdlS-13EUfqSOKtDDCUYHZWHKX08uHZXc7AMHRgeof0Z8L8NL4jsMeyty7-Tftw0LXw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnXzM5gC4spb7qkVtdRYQg_hPaD3iV0DFKiaM0keMXog&oe=69A05402"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyu239jkFJQQ7kNvwElAdQC&_nc_oc=AdnHazu7mGZ5Dnw24FqzqtxVUxZQwzxgTq9NcZmY17jp5yxYSL1HvzUvkRDCuNJkKMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfutxPTYAz5ZD8qsbJzlB1ebhHERSF_K2UUNJw0jD6R3uw&oe=69A035BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfFqLqdFeZUQ7kNvwHNq8cB&_nc_oc=AdlHZDVCGRZeI6LU7q6i0Hr7b2WI2o7dKD8qJhjed1R9R_uu8Y6xmjUDdl358ITTylc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvK7b8o3kcf5vDO4gfQx0pQt1NJmgEN-gpFRpt2l_QJbQ&oe=69A040CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJTeVaYcFJIQ7kNvwHWfROd&_nc_oc=AdmOuuLvmN01UcXFOnl3u9g3nRnW_pXJ-FIViO7D3-X30Cz9hu3Xaw2utFi0jNpX-sQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSfFx98zYElsdOhePmbsIsXzTeBjABQ2dRdyaRWSSE_A&oe=69A03A57"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "https://www.catmosonic.com/terms-of-service", "publisher_name": "Important Small Things", "support_website_url": null, 
675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcgpyZOiVm8Q7kNvwHD-Bcy&_nc_oc=AdmW8BTx6E7_ua903E2p8VkfV5fOD2jm-8CUKior2MsDNg76kDMteMg2tcW9vjjtm3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJf9hzPMOPd7zsiKZT2v1mE1zKYIcmkVraC9K1euQUjw&oe=69BFF488"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXUZD8DzoM4Q7kNvwHdbKFt&_nc_oc=AdlDwBm-gGlQnzXHZUbsvfq_XGvSDjuP_sE_Q71Ook9EMn3h3_LFtVeVEk4UwaC7w-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3z4M6U1guR-tQ9yEV7awE4ascX60kSH0I8sBHdqEDFA&oe=69BFF802"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cr--EKy3dRQQ7kNvwGYEmsr&_nc_oc=Adnrn223yz9CYqkd1nrbpS-O9pEDPlkXch_90X9EB4D3ETp73QFKvqqC03iKlXJUEw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHXNDxX_Wcj1HbcCPKPs7imm7bjZWlNQo3Xz2zP6gtRg&oe=69BFD9BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4sC_vlKOCy4Q7kNvwGZ6-oH&_nc_oc=AdnOjd1v8ms15xaIpD92b20D8ayVKytJ0_sozAJhPlplXTim8kvnGcn3xT_XzkNMhQA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGjy2pmiqmv1rpkAeKHyr5yuWCOj5HrGiVbWJfdrd3hQ&oe=69BFE4CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnnYLbIhcRcQ7kNvwF-9BAN&_nc_oc=AdlPCpnjE3NY3QGiEFBsS4oHeILgx91J1NYsiMiFpavjCT2Z8ZgnwrXMDjEzodfNeCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrWUGg93JXGElUkx8Te7cYWprKIWCHySwMJ2pixUeGEQ&oe=69BFDE57"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "ht
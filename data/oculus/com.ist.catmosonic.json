675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upHt_qnDzYYQ7kNvwEsESYw&_nc_oc=Adn1xsAYUZ3vs_2ld3NnHIqDY9zs1m0rOaKJ25qgDJochVtjXH8vn3olGxgg8ANq67A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxlvnv3gcD5JqLBgm5pHs8GKkdfXyQJQEjhfnEq_mSISw&oe=69B80B88"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E4nbv_PkP8Q7kNvwFIWt2L&_nc_oc=Adk4MskzgrsbaC7tFLEPRvWZ5LjDGTpBexpT-eLwo0x9I6g30d8XidCNF1j7Q_mu0vE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzjSOFqgoET4nOMFU8n5E32uJ_gPtSo0_SQCZnUFdfmlA&oe=69B80F02"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loznV_l0yZ4Q7kNvwEcF60r&_nc_oc=Admiwr0-679eVO_F0mIuyTkpdSU7L0KZTOq7Bx4ax1tIJvMtAnYRGjRXi9KgFG00GYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyneJpJr6GPPH1ofzc2OnPD9hLnVEdbX6XMPH01mhWJyQ&oe=69B7F0BA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0BFLcgjuHYQ7kNvwH8XbCZ&_nc_oc=AdmvgWIUelGdnFJzU9h12Qjf_aO1XGURAzBM6WsKjZHAXs03rTba_Jv-tfEHOn2QB8g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwgZ79_PahcqZMAnRjaLMPjye7fdfBS90cG0AwCErB6PA&oe=69B7FBCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD9zUs7quGYQ7kNvwER7liV&_nc_oc=Adk4h4yXR-QGvWGK3P6iz6Kl-7so3L8KLHXkysZVhGFxE7ubZd6tUnY90377MCi54og&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVyRojaeO6S5MFbkYUTQZUmY409bcB96PnLxmDzK-Phw&oe=69B7F557"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "ht
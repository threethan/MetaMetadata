675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upHt_qnDzYYQ7kNvwE5Pv78&_nc_oc=AdkxhCdQRK082vQLEidox9Kmze5fL6VTlljjt6LGRpGv7xu5I63WJef_bM_NqaGVdSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtLFD9VKqLYZii7QAe_-irGyAPUCMZPxE-3ck08lmXtw&oe=69B56888"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E4nbv_PkP8Q7kNvwEyzWt-&_nc_oc=AdmA78ijl5PvysCvP10W1aKe9Nr7h4Lwg4OOz-gItGDhhyKaMyv_4XrZP5CchvRC710&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz687X_T3UvpT8thpE5VDdE4lIBfioNXk_IZaYJwg1Zgw&oe=69B56C02"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8ZzAy3kJJsQ7kNvwHm9jcv&_nc_oc=AdlHlLOyovxStbk3sxWW-LwnUUT2j5XhwqqeUN6jRYhnQQ23eLAxnioCNOAuwVsGzVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyvImoUYh6OpeM_1bgiTARCanAnD5H23kxBi2Et35M_7w&oe=69B54DBA"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0BFLcgjuHYQ7kNvwHr36NL&_nc_oc=AdnoTWz_r5Nosi_0Ay4FS9PCKS8jEUZ8D6TapzWvN2MNCKb_b8YQ-g07kl4yf5_3joM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx18FArFqtESluf4lU-JeScAoQxwwyhZ1zjpnfj4xTuRg&oe=69B558CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MA2q_XMGegQ7kNvwFZIsvQ&_nc_oc=Adl-OCFc0jhIOUtqOQaoJqEANWVyH6UomBrcGsQ5_NDmXMbg3ylAnYJb1l2ttnT2Eug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKYB7JFPPaagh1rCAgdgT-pV6EX4aDJ_q-Y18S7Xyw4w&oe=69B55257"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.catmosonic.com/privacy-policy", "developer_terms_of_service_url": "ht
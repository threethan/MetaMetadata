tps://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_926056743273676_7797959675577762335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upHt_qnDzYYQ7kNvwFDQcjb&_nc_oc=AdmBeYXTXLTK9tRUalAIE07F2DDNkmf4XVllgcgBDRV7shZqZQcghnSf4GuH9kvskh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCLnudxVDgR-gPi_Vi6iMfiqBV3gKeCJ0b0RH9QoUjxQ&oe=69B6BA08"}, {"file_name": "laser words.png", "id": "1583370626225154", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819239_1583370629558487_6027097366284581157_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1E4nbv_PkP8Q7kNvwEmMe_T&_nc_oc=AdnkuVTfc9gi5w5kMfTMTDNIqLi4YcNixXdB2O_-0o9HRusf51Awb3YV7JGk25e42JQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxIYXkpX-vecsL-G_qjHONvFwsKZlGJtd__xX1VPIDxIA&oe=69B6BD82"}, {"file_name": "scratch words.png", "id": "2196081177865801", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_2196081184532467_3733008201201394551_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loznV_l0yZ4Q7kNvwHvOu1q&_nc_oc=AdlN6oITTT2GTMlzs-hb_fQh5gO8HxjvYDtfagEu1a5_yVZB7vdzpOc-ifXkSGdpJYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxntntCmyOpaJrI-Tfh-BpSk3DrRaUY8jYw29UwQbCteg&oe=69B69F3A"}, {"file_name": "cat milk words.png", "id": "1575427086909439", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819356_1575427096909438_1283873792020265335_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0BFLcgjuHYQ7kNvwHZdYQR&_nc_oc=Adl5E0MZENSQvuYEKMeLuI0SuPefBzYkJFe0tVGqTtU6n4Vh339dlHLcVpOWa_Uu9ak&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuBqCFKq1SPtpXTRNgIJjKAriVwaT3w7Xw1HFCJfJbHA&oe=69B6AA4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "catmosonic_meta_trailer_still.png", "id": "1641031940390170", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_1641031943723503_4116094651450144434_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RD9zUs7quGYQ7kNvwE2tuwN&_nc_oc=AdliUGz82Wc0fwUicwpFOfueXi1hnu3X3UoSUV6uXu_O9d5VUmi1V66HzFLfw3I-3NA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNOWqdgRORsUecC7FP14lIx1qMn-wGKeY0eKpSkEGcHA&oe=69B6A3D7"}, "display_name": "Catmosonic", "keywords": ["relax", "cats", "pets", "wellbeing", "mixedreality"], "long_description": "# Meet Your Virtual Cat Companion                                                                                                                                                                                                \nCatmosonic is a VR wellness experience that combines the comfort of a purring cat with calming haptics.\n\n**Relax in the Cabin**\n\nPlace your controller on your chest and the world transforms into a cozy cabin. Your cat curls up and purrs \u2014 and you'll feel it through gentle haptic vibrations.\nFollow guided breathing exercises that sync with the purr's rhythm.\n\n{1381062923261029}\n\n**Haptic Purring, Real Calm**\n\nInspired by vagus nerve stimulation research, Catmosonic turns your controller's haptics into soothing frequency-based vibrations. No special equipment needed.\n\n**Play in Your Space**\n\nIn mixed reality, your cat roams your real room. Chase toys, blow bubbles, and place cat beds and accessories to create the ultimate cat-friendly space.\n\n{1345847440894820}\n{940776278276975}\n\n**Features**\n  - Mixed reality cat companion\n  - Haptic purr power with customizable frequencies\n  - Guided breathing exercises\n  - Interactive toys: laser pen, bubbles, mice\n  - Cozy VR relaxation environments\n  - Cat furniture and accessories for your space\n\n  Whether you need a moment of calm or just want a furry friend, Catmosonic is here for you.\n", "short_description": "The wellness app that turns your VR controller into a cat\u2019s purr! Relaxing & joyful, Catmosonic brings a playfulness to well-being! Made by VR therapy experts who have helped 1000s of NHS patients."}]}, "developer_name": null, "developer_privacy_policy_url":
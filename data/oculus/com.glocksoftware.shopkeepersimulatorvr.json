b=1-7&_nc_sid=6e7a0a&_nc_ohc=W5P3z6pQqNoQ7kNvwEEhyJZ&_nc_oc=AdqtjX6_N0F3Xq0yD9iKfvElttTBOOu96xFI80TZXtgFb-DHp2sx0tt5FH0evrK-nSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDENbj4JIZ2-XRhQ5s7NL1j8mCLt4TPwpw_3OqwS-b8FA&oe=6A675D19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noUHuXEPiuIQ7kNvwFbNm-i&_nc_oc=AdpEt0aY7dCA7HKwiLIhWincnqrFIP6qtFg-t3_CW6X-9sy9-TCuCHt8kRDY9_QPrSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8JeyFPNddmA2HNZyivYJpStKyhxhfzXTNYJ11acmXxQ&oe=6A6748F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ku1f2YR62O8Q7kNvwGXJ8JH&_nc_oc=AdpakgvzjGS9KNur-sg9RTDRXUNx_HCyvA
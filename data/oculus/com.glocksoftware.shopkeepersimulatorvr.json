b=1-7&_nc_sid=6e7a0a&_nc_ohc=fizlW5F-BdwQ7kNvwHp9_R7&_nc_oc=AdosTKc1TKdpGxct22gNCSTAoLJpTj_JvF63yO6WJjUmPnkSfw3k-EY8yR3vld3Haz0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i6uXaoQa2T5gac4AbSCG2eWsfHR_P0UR7L82hVKK0AQ&oe=6A26C399"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l5uBUBTbIMQ7kNvwF9wUbC&_nc_oc=AdpX-JQsUNk5tKfQGiQDfnEHJFlmrcCmt-LMpYytMxqUFMt_sK_92ppLofUyunQsquw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nwsaDVhcV5lb1u2RR7qoDgCQZ-Dcz7iLbzkP_j_X6ag&oe=6A26E7B7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kja_qDFzaWUQ7kNvwEEyoRJ&_nc_oc=AdpIIRWZu4-p29FyvkVDF5u0RqbF3WLuTU
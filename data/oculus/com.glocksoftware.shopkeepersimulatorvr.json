3-1.oculuscdn.com&oh=00_AfvNwwL0n0W5nTzWuZ82mk-EGnlTrA60-5iylediTIy-7g&oe=69986199"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6qxGbLD5NYQ7kNvwFLmMBw&_nc_oc=AdnAcbLJJW36tIpmw8UL0uVeYJrzRRBTB5W2grq89JGyErelgYMlDUNqLMjwc0tcjtk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvDd2n8xtpUlCY1CbNLNWxHsv0ZG1JqGmVKh2JA0UGtYg&oe=69984D77"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0_B7HL7wiYQ7kNvwHvyIY6&_nc_oc=AdnnalOCBvflDB0bEkH7TH-9LU-3y6ZJVTH8tQyZ62hR8cvSjEdqUFcGH2yJcCIrak4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuLnxw0ZgoD-DVdscyrEwWOxdTa8A92RyWiiupcAEZJMw&oe=69986417"}, {"file_name": "Cover_Square.png", 
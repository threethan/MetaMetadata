b=1-7&_nc_sid=6e7a0a&_nc_ohc=UHNSc2kfhywQ7kNvwEWQcza&_nc_oc=AdouYQ9IFv6yhH-Aytyl3hxnsgZ4z15BsO8AFXerwW4zf0GHPNgZqQKjKGlmCy6iclA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQwzHdc-a9xYhzpIoRoTnVfEte5bxUdJmwgZ2-eh7GZA&oe=6A8C4719"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4IG6OjGLAcQ7kNvwFySrIK&_nc_oc=AdrID0QAU84GoGI1UjqOzHyv2e6g_axlmk_S_U-zAzb_ngPTRM_4Hv2TeCmV66Inn0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGelYPn-qdo-2h4xQ180cJzOJPPfAKf6K-l4W2e8_oCZg&oe=6A8C32F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wfbs6z8gsOgQ7kNvwGPOyA7&_nc_oc=AdpIRpQPFm4UCd2MH4mWAa154CNDRdC3rH
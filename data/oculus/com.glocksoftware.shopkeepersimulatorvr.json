b=1-7&_nc_sid=6e7a0a&_nc_ohc=ZK6I3hkebHUQ7kNvwEbqpF2&_nc_oc=AdplV3Nh9Mfw8naarbZfR4DUJUs-SpePF7oQw47xMLLMlhOGteLhv5bjzpFyfv9tSvI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78G_I6-DtSpFEL818gHqgdN36_X0udKXyt1wG52bbc7A&oe=69FF3699"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Oya31lGh_kQ7kNvwEQxN3q&_nc_oc=AdrwEJ-DR9DAnaS-a2ZxE5IqCE5IuUgFB0zAUVqa5Wj755uWYFTmYXhvGfsUce44TXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OHiCG2MzDdYWoBNOEMq9Sb7gh01OOCQjTjelCYaNj4g&oe=69FF2277"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOYjDt4d2b0Q7kNvwHU7XTs&_nc_oc=Adr6pDxF1bnZX8J21suYJ-fn7Ed_cxV7LU
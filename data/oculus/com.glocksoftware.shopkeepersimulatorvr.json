b=1-7&_nc_sid=6e7a0a&_nc_ohc=CgeKI84H3MUQ7kNvwGBwkHW&_nc_oc=AdprP7coVVOHQj0V14t3JKJJz7J6RB_l_fbXqlFmmh5GL-rg2bJ6k95sK7gVk0BBzwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E6T_ZrLlg6C-bzRglqYwWjF80-PqYEDYFFAVzpNWm1g&oe=6A071F99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iq90g9oSFZYQ7kNvwHmBhAt&_nc_oc=AdpX-lcH9PT12yW9fwsoRUaBXm3ZKsqb9Y7BvHKFMumcaAl5n7NbIIVBRMax4flccKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WXpWrg7ZFDVFTArFIqRNNB7yuWLc0xu-KceC_DPdadQ&oe=6A070B77"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_G-Ut8BxpcIQ7kNvwHY_y29&_nc_oc=AdrhvgTMuVozxP6QrqTD9JSI0s7RgKATQR
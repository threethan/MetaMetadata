nqsG&_nc_oc=AdnMqqkqNx3GAuikEb7_zKbRdm7ocgkY7iy_sk52AqrzBGnqKGRvKHj2Gs3nR_efXp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyL5bFuCdBvu48ak2w1FA1xfv4dxef60W8kfYeccvyv7Q&oe=69B56299"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJoJyTQDaocQ7kNvwFYiqmc&_nc_oc=AdkyPyCc6f9w9mpSMThIaqyUTTnHv4PNHcoVZRj-6Bdl_0HRfQvbXY1juF6xHkwwirE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwqMBNUEQ3GZQEG_pD6qUF-lCJYHrblgScd-KY4Ruyr0g&oe=69B54E77"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5itNNOR1_wQ7kNvwFOK__l&_nc_oc=Adkq8c3YAWj3QqTD_dlHS5NDTlU10kYBgcuUIojm5BjFF3-DfOFMv9Q_Lqo8RI-kvYM&_nc_zt=3&_nc_ht=sconte
b=1-7&_nc_sid=6e7a0a&_nc_ohc=mfGWXw2dO80Q7kNvwFXnkAR&_nc_oc=AdoMLPD2Nk_ikckwZqu8R8VvNFwl0OZGNN7mG0QLaFHactZWHC0mVJdc1WgIRreKOnc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwrn1fX0PDM816g-2Srp_Hskkd5aSkCp4klJAmRfC5zg&oe=6A81BB19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC3NaJv94IkQ7kNvwG_KSsE&_nc_oc=AdqAbnjS627juAIaoHHAZC8NHtQabi735DsYFc78N4ZQRsI4M1gfQL-bIvB8dHiu4a8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFblMau3k125AezZ70I_B21l8pS48eW4p_7gp2tc1DY2Q&oe=6A81A6F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H2QxGWI5UoQ7kNvwH6lVQ_&_nc_oc=AdpBUU3Wat94ZCm8o_aXZ_AFkyDdK9C3Xi
b=1-7&_nc_sid=6e7a0a&_nc_ohc=MjWQ-h2xmSEQ7kNvwH8IthC&_nc_oc=AdoeWO7uPGyVQ_nmxcffbQxLuAG_LavY_SvHLIeZGw4gO7eOqPeiL9nvaG1czV4MpRI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6REU-s1uDCySJmjFCgGQjA3IZo3B_XZF35X2CkzuU4w&oe=6A5A2E19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsDkyZmyPk8Q7kNvwEyZ1xp&_nc_oc=AdqmUfECrTgGfVGU20Og2c7ukBjBOoCYDiyQiD4n7b_znGz32bCiKjJXi0tUkeLx5A0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCod2gsMxYGYedHc02Dm8PGS4NaDVtew0F6Rp64b0gaw&oe=6A5A19F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPu5-LuP1tIQ7kNvwEoXgBY&_nc_oc=Adr85iRvC3a8zdV34FtEKeUw7zuMN2_8pT
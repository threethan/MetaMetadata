b=1-7&_nc_sid=6e7a0a&_nc_ohc=KaR89AVCe-gQ7kNvwHT5eme&_nc_oc=Adov8Aob9w5r08kZRoLx-z7D8DyBYUW3gAbxT_DslVeUEQ89mcSOh5s1GCbvl6hnsT8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiJ9zxiFzLD-BF6mW356P98cYNhkqqvBgCGLVpeFvUhg&oe=6A621719"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUt2b8AQAhMQ7kNvwHjrRBU&_nc_oc=Adq5BN1IEsV5nyKt1eBo0I0C-358qFZ8JspviCY01V5SZuVYmSLQ1CwG6wNZunmZpWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0ydXqmmGQ3Z_ID9aA3CAW2fj17RVT6kfJD8Xcm6f3PQ&oe=6A6202F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9INb_AyXRg0Q7kNvwH_0Z4q&_nc_oc=AdpAhhDqUchQ-0wLJsvcIgQEhtCnNuYEgh
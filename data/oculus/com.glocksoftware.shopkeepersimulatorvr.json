b=1-7&_nc_sid=6e7a0a&_nc_ohc=FbwIM1p21kEQ7kNvwEn0mBL&_nc_oc=AdppSwlTF-FIRJVCJozO2DytvGv4tKaohsxSpV5rN1GZf6bAkWnyE-h-DHifwL0yjwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBACvzhXYTTUggl9irApmUAzVxm93bXT_BeBLR82K-DOA&oe=6A4CFF19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qIskCaysgQQ7kNvwErSlId&_nc_oc=AdogV_WtOWs_wb2U_aljR1JqWj1fJB2M95mwQiSdzY75gfI2NJUowVuqPl-wILB_mEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGG9CdRiBO2ndqGZvFS4J6ZE1rpKWxR9-b6qsl1bC3fQ&oe=6A4CEAF7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0EyGOv4XiIQ7kNvwH_hKgc&_nc_oc=AdoNprOuEnnoUybsKoptoR-f9Roe2y1W8g
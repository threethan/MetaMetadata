b=1-7&_nc_sid=6e7a0a&_nc_ohc=k2rBElJSQQgQ7kNvwF2fHHv&_nc_oc=Adqc-wFFg0N3iGzipF56RVjwMHKSpmT8P3_8TgroKXWU9Rbv40Oeoap-Wk4El6VCmb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMphpy7CxDmbUT0G-P_wRyzZlKhPbs-ONtH37dhWTJxTQ&oe=6AC10319"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gebgKRevz9QQ7kNvwECmwQ7&_nc_oc=AdqVZuD8Z7k5elDIxVSIpHuwvHYdD_Q9c1GNocOW8Ij1HwtsHVnXXDoWd_YWyZ7vHG0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc0n83EQukSBThVN8YBBA-K2ryUS2yN08NaEUW-ai76Q&oe=6AC12737"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1l0AYkX8T0cQ7kNvwFv4_Dv&_nc_oc=Adp5sApuK_GTeoo0JIvxa6FKPkRSlqAf5b
b=1-7&_nc_sid=6e7a0a&_nc_ohc=Ilo9a89zTGEQ7kNvwFLkkxn&_nc_oc=Adp9sHa3TrX4mkrvCv291QrhbVo2pjEWZ7WuqrsdhbfUWH4FTYOP1GBNJf9ApYXyG4Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ-3Ufagh5xDzkjQ2_LvyO8J7i1J6C7eDyQv_gcW60Vg&oe=6A9AC799"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N88qUX6Vn74Q7kNvwEVJWSS&_nc_oc=Adrn-E0VGQc42UESUwyQCukamck1rgBM2DjgWhoE_pD1bPWm6q95O4fXUodqV2tlJiI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCZWx1fi4YQKJ5oQpyP21_920xwV04DxBwJn9PoF3MGw&oe=6A9AEBB7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzluGbZwa7MQ7kNvwGhA_OG&_nc_oc=AdrqBPssy0k14v2763UDaEsWrU5rYR3toO
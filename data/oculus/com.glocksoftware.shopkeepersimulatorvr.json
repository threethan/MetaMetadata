b=1-7&_nc_sid=6e7a0a&_nc_ohc=xnsWNYnyHC4Q7kNvwFO07t6&_nc_oc=Adppwd-c6qsGOs4fQrun9NLUH-HHkPeRDL6MCxcY_Or5VhsUbg1DkkALkjCajNYQ8Bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvEmhryskljTCNsY57v7NMLcswt49pQuKQfA1yw20-vw&oe=6ADF5599"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALUf-sOsIYoQ7kNvwF-ptX7&_nc_oc=AdqwziEmXkNyfUh2Q9B7xbgnMhK-je6hFv6E4NQUjgUH8j1v-0DiSerZpmooIlqrbVQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM1DJHU_IbdOcKCSNzH3pvPTB-K82wQmgxVdJ31gv54g&oe=6ADF79B7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HsQappJwO0Q7kNvwGovFAu&_nc_oc=AdpKQn1UzS-n_zjK1rB9Dtbo2FCpCQN_eJ
b=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3wAX4x27EcQ7kNvwHqBtHM&_nc_oc=Adq4IC6cO36XasCBASc9tDm8Qh5lbzfIx3mEwLFpV1B1kifyViCFYRuUwfNAnGTBrlQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFI8EnaVvEXU1ti0My3UQxOhXk5Yia6XJY-WqQHzCZ5g&oe=6AE34A19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kojPYUC_GToQ7kNvwFm0449&_nc_oc=AdqdTLThGGgH1CXw6aMZw7Ymi3wjZSUNI8liVUqgkHMm_p76kpA3hDu9qSjmveySop8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV8VDhkK7-Tc-hYFIk4c9Y3DFnpIS86t4nUXwxzF1H7g&oe=6AE335F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MqN_D0CK04EQ7kNvwEhIYOQ&_nc_oc=Adq8fplN7x7woENhbAExjM2ikmHZaHkfgj
b=1-7&_nc_sid=6e7a0a&_nc_ohc=BDICFcSAuloQ7kNvwGV08Ar&_nc_oc=AdpTpmc2pZMg5oXXSeY8brvVwYvL2mB5KhIXdArf9aBt5-5CkYOl69aPiE3BRz5M4N4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTEWX7Q8xlzTeKpl7LTqQkNDIPA1QivKAOMshLDMoWMQ&oe=6A539699"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bluqKC1xOmYQ7kNvwHhiogt&_nc_oc=Ado9RHComUD2nlXDUuhj7dlX5huo2M8Urs1M6KsSDmazzmIwxGv0u8xbTRqBFlqXLvE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrKBbwZcwMF4dMHfiqCioHorsJjovWpvd5Qwk9HhBviA&oe=6A538277"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B8JLdyXbuMQ7kNvwFyt6ek&_nc_oc=Adrs8-KwQD4N9kVMPr0s2F0WRvDOU5nkK2
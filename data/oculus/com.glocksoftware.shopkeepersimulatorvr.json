zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmNfcb9MtlxBg0bnNRSKjmmPJNEdNL9LZeURJ7YSoziw&oe=6B046C89"}, {"file_name": "Unbenannt-2 (1).png", "id": "1065112948588367", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035426_1065112955255033_6685537883324586242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac-sd2E3nukQ7kNvwED8GRL&_nc_oc=Adq4Wnph1pcuPXfyUYUdS3w7e2hbIb6-gZa-yCegX5OcFhurfys8nOOSlGoOqqyNaTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmFpq_9fWH6mySW_mXw3GUaCvr0gOYlDjGMBcMef43eQ&oe=6B0477D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUFE1hrr78cQ7kNvwFXFWgK&_nc_oc=AdpEAmb_zIGxlcqZKMBTBeVUQoP2sUZJxk0KH5IGj6ebL7mgVmxuz1yNmLaf1kMKjo0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_
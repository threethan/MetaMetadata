b=1-7&_nc_sid=6e7a0a&_nc_ohc=R5PcA0A_qMkQ7kNvwH4283a&_nc_oc=Adp7YqZrjYvwSDC6cjghEsNlvfgdop4hoo5E0kCuztIoaoNjYY__oQskzqQ-m3NbubI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lJ4-47clw4_sOvRetgwDEduVM7-szv3strktQfuvBnw&oe=6A1EDA99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fso_xBMW2lgQ7kNvwGga7aT&_nc_oc=AdrNztLy5umx0CathmLi8PAHbbG9MfARZfWtHOH2QPalv71ZhC2_kwgW8wl2fbO3TVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rwH7aKGHSu3DJc2sHxbmyjsN_yLf8sRrZm_oVeNT9UA&oe=6A1EFEB7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fue8AsV2BS0Q7kNvwHdSCiB&_nc_oc=AdpmWaInD1eZlaOKmgEcOMJ_T6QvoDM30S
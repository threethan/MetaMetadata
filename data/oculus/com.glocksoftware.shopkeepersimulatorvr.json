b=1-7&_nc_sid=6e7a0a&_nc_ohc=QlBfvcwK4IsQ7kNvwH1PjaS&_nc_oc=Ado9b068tclUL8Q7PX5mxUC1DZskNWrw9oXLwlj1MLOgO93X_82QTd73blBVeJiyEXk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzge8rLqbNElVNYUwmCIwy6yDZZE99f4BY46SRcZZiUMg&oe=69CFC099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzEsag8p4z8Q7kNvwH0carr&_nc_oc=AdrwXb8Npa3bYEae4Ms43pD0xeWIQdBeCR5eUtYcUbLHCi4tPGEPMw9LZY2YasA_FQw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8P7FgSAnaNbx4BLmlU3RhN8voOUMgO7M8PGRFX8_Vrw&oe=69CFAC77"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV9bAxGS2nQQ7kNvwE327_r&_nc_oc=AdqJagbnjZI_6dqsH4PD9emcSZmA0yWVRY
b=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9CO6D_KBLQQ7kNvwGcg0_K&_nc_oc=Adp1sdQRgkrvDPH8Kx3Z2G_Pzm-sA1qDgUzjWFO4rj4qgbt13x4YmScAi7tmjbxJaI0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V6NOq-DMXzHlXFQtyNJj6UnSoc9HHzlX-U_0DelW5oA&oe=69E62A19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te_DZWfVwiEQ7kNvwEF6uLn&_nc_oc=AdrnSrDznT80m8QTsmXLhA16EH371iP7kU4te9q8rEryPkgL7sELzF19maa3za0Qkmw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rm3PvtdP_np3r4jyllS4ZQetdULcUILYGHLJphsMhZg&oe=69E615F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUUp4m_oK2QQ7kNvwFbnupo&_nc_oc=AdoZ9miZYrjl-5bSlxcpDPCBkO2NxOY0Mr
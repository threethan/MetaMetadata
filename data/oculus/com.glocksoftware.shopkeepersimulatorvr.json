b=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWHNrvRZmxsQ7kNvwH-QLfp&_nc_oc=AdpLd8l0ArAOr5KNrXFh6dIyL3Z7wOgyZCykKdE6M3NrUfTE0QfikOsLJ_uYkfX_BoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtTHSzL4RGvGRg5izrBzq2rk08BDCFofPW8iaYubpFig&oe=6AB3D419"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eed5Idh7gL0Q7kNvwGZi_b-&_nc_oc=Adr1oHO5VwdBxTbDb739VtAj5f4NT6-ExZIwwCMTJOLSHPEOIY-nBEBlCJS8WdU3X2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-U-4RZHBdSMI67DrYgf3DJVHXcaV6SnbeUwkurjlOUA&oe=6AB3F837"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt6r_qXWligQ7kNvwH4LwOt&_nc_oc=AdqJ7yRkCif9JGW7LPtcH_PyLGpG-fktAO
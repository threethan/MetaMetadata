b=1-7&_nc_sid=6e7a0a&_nc_ohc=mR_nSH5XtMoQ7kNvwEuTCeb&_nc_oc=AdrqzcdcImVYZDEPDWKPgIc9ymf7n4UK_BE8mDNo2zXUPA2mh8GLVf9joU_o97MhkP0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZemS2VSeUOSnqX8g0RTBjhx07DJd5iq_EZqgqLZ1L1w&oe=6AAD3C99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-I2Agz-__oQ7kNvwHAzt-h&_nc_oc=AdrxPjyzh7wSEEMsfy2HozYfWZ0HWcW0nBr87-fnUJdnhanahWfoPNbBcyVDT0Bt2kc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh69EnJ9EZHFYKPSEmHlEDxabzxDasmDJyK7eZvFtEyg&oe=6AAD60B7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiJSBuZd5q8Q7kNvwGanrku&_nc_oc=AdqRu3Tp2U4C6iK_QxDGrIp8Yn66b3i9zQ
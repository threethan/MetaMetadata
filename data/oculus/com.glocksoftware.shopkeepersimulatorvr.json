b=1-7&_nc_sid=6e7a0a&_nc_ohc=N3zdZlvAqb8Q7kNvwFHYxU9&_nc_oc=Adqf2ofaYf0OOro5pVL47-890vCJVFIHkJ6B6umJuqteqsVo7baizmHlcNZ5VtrLbjA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0KJ8YpI_gy9Yp89cJwWXovYbxp_NcxVHkX61skM5Z0Ig&oe=69F5FC19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKxiInE0688Q7kNvwFgy6d4&_nc_oc=AdoHuKcONm_bgs6-w01oUGM-n0egi-37A3Xfru9g3n30yMfNwGJAFyzFH8W-wZ6TrPY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oSTjsy5LmaXTphUQ_SgxycvWT_OtGzXVPZCG0l49uFA&oe=69F5E7F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAKOn0pj4j4Q7kNvwH3JOCJ&_nc_oc=AdqoB10B0pQgj6U931ELzhbezl7Gn2sIy1
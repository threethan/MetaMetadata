b=1-7&_nc_sid=6e7a0a&_nc_ohc=KY27aw7LD6IQ7kNvwG5ctow&_nc_oc=AdrxCDLF_qZRsNWW10B8AiB6S7SCUcgDx0BXNP2ZmClWie1PcA7yVDkAOJ_jsTkEwKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OyJKK75OP4ITxXvZRWDF1zu_VQ0Ydl-p-gIR51WSFRg&oe=6A2FFE19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKCu_nvSY8QQ7kNvwGz7qJS&_nc_oc=AdrEQWyJdrla8wlfCjoPGF-B0NiYtwHF0uclfSvwtWb_pZqllgcuasZLKqHKn-wbpRc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R5UflaRVWzTpPZVan8CncZzQSZjnPs4i0t4CsJz9PYg&oe=6A302237"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFsd2pPeS_cQ7kNvwGILTtV&_nc_oc=Adp4Q13BVPlkWvVV3zn9LiYdz0tewEOWKV
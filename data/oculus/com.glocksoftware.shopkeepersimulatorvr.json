b=1-7&_nc_sid=6e7a0a&_nc_ohc=AQF4y-I2x8IQ7kNvwGVmFgG&_nc_oc=AdrrFXIH88Zi8gcKHmZaFUWGzUG1R_cGeOLtlqZb9njXy3_Rn00Qi5wtDpiP7yDvicc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jTkUnAlOW6E8XH9ZY_n8w0mGSHEArcCoWJJer6-e0pQ&oe=69D7A999"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oUrROhuCoAQ7kNvwGzB4Tf&_nc_oc=Adp9BVEMsFjLYCGj_R7XT2yK2nHlLoNTGOuLCeAr2ZgpG7H9qD1iusegaXhcv00yLNQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O25HR8RXYPc0NgxX_JEJKDhY7SuOhQvsQnjT2iCFk9A&oe=69D79577"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gx7IXBGjyMQ7kNvwFeEu5u&_nc_oc=AdqkjzliY0_imTYzF2wYLu9k_zOAXmTyiG
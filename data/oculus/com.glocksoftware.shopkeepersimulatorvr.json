3-2.oculuscdn.com&oh=00_Af0H3aKXMgrOqoA0pJUsrk4SFCAq_ORhnkarFraqcfHMvQ&oe=69F0B619"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce6OLM_s_9wQ7kNvwHDoX18&_nc_oc=AdqG8JKUa5csBX2ntftTYBCiKs92oJkW85WrjJpIUbjcOGYc6xDPra_a9NM3HxU3S8c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1WmHQcYeGvV4rJeYEIdIKT_dYD6QwGiY-vY3sMObs03g&oe=69F0A1F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RC9DHaToxQQ7kNvwFKDw3A&_nc_oc=Ado09Iu8Ze4aikpbkVsqPN0dO_4OF3Q4Eux4Stje9qOuSYjZ6QZ8TcKKbOtV1h6fFLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0dG5v5LEVLX0LijNhqHx7wS39Mn4a_TjdfeltMxLdx_w&oe=69F0B897"}, {"file_name": "Cover_Square.png", 
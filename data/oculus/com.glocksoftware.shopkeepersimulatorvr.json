zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4ZnipDid32esZfkVR56E3nysV6Hf3x2RzrKym3t1opA&oe=6B0DA709"}, {"file_name": "Unbenannt-2 (1).png", "id": "1065112948588367", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035426_1065112955255033_6685537883324586242_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5qexsJX2ykQ7kNvwFNIbcU&_nc_oc=AdoVZccVefOY-CSPfKoyFHWBFKdQkBShoNk8EFBi4JCgmqkPwRWzI92Mi9dlTw9-5gY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRVJOQmwGy6Zwjz0-s_UtZ-jEBtGV7O6HZ7NtD8KsEKng&oe=6B0DB259"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMQ47aeC0kAQ7kNvwEquIyL&_nc_oc=Adoc25qs7M-Xo_9C767L05NzsmhUI_i9GgpADmuxYCykm-wRpUU8qIwtoBaduzccuXk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_
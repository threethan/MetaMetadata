b=1-7&_nc_sid=6e7a0a&_nc_ohc=L7pbnNFCzRYQ7kNvwGum0HQ&_nc_oc=AdpI5L39lC-Xq8C5VrxPKnISlipYZC3bRVMJZexw5zfbkwQ21cyP3upkIm74pv3cgJI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiiOiy5UqZrKU2I_k4NMcpA5lqTgp4lWCTq-RrmAFJlg&oe=6A6F4619"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXu3rNL5qqIQ7kNvwGcvN6g&_nc_oc=AdoOd0sCu0eugvULmKBHPEaYVmZf62skNN78sFe_R-wlx4VqcR5mweVqskTlFKUOFFs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJOP1dWCEFlWkr7whh_PkiB_9J5WsdAJKdMeXnejtoMA&oe=6A6F31F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDPZLS_cdO0Q7kNvwHZ2iVa&_nc_oc=AdqRqC-hLhUVeqaU2UO6b-pbSf0ECRN01B
b=1-7&_nc_sid=6e7a0a&_nc_ohc=FJt1HaKSS0UQ7kNvwETubkw&_nc_oc=AdrYw8F7oIKm5lhNonVOYvgQNRNX1oMe3vFG-NmNP-VlLVJaC-JICwi9VpRMmhUvVpg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kuExcgHC9aVph0UhptV9oFulxIg_v2-VxNrfCXmAJgQ&oe=6A0C6599"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWtE5MDbhogQ7kNvwHZ17UO&_nc_oc=Ado2r9eGqiIIif1Botgv2z4ADUnXnFK4DQi0W7E_LijdoQyYQBzIvj7Jl9ytfVs8pcc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_FsiT96lOq-bKyIfeT2DCxQy5fbm0CC6o1rkANKEAvA&oe=6A0C89B7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16ggrjY3tAwQ7kNvwGIWlm5&_nc_oc=AdqaeoV7Fr1bDs7PvV3sFKzJFK9_oH0kV-
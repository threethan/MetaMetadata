b=1-7&_nc_sid=6e7a0a&_nc_ohc=dezxnJEaGckQ7kNvwHbQZKO&_nc_oc=AdqCwkEs3Nw2135mOpFbGfDmLIXWhFdYt9olXX_M4pPx94Pn5qlp8UTHoAcHZb3RlK8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CGVOueOGIsC-uNMKto7E4JXf_gyB5LMIP_hl7PRfmDA&oe=6A3FD019"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykC6SIWsXz4Q7kNvwG2luRX&_nc_oc=AdowFgquB9k8d6SWxSqUIgUKuI1HSqde2oAdwMMPFYhDReGgMHfVJuK5nO4tdVv-am8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XxTXn56A7tVzrluFNBUW__BdayGMJY_KU6l42kF3HcQ&oe=6A3FBBF7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqRXdiHjJx4Q7kNvwFnp3T-&_nc_oc=AdoNtFSCz47s_9rPzXy8OW295JqsfjFskk
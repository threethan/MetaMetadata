b=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9CO6D_KBLQQ7kNvwFTHoh5&_nc_oc=AdpP4z1C0bwpblS771etsne--RNQVJmi_S1gqY1Wxy31X7WJ9ANx3Q_Rjq6ukm1vYKc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O74XBfm5Fxh9maQkAp1SNemgVu53J8LXmQNl4__yQBw&oe=69E8CD19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ9RhOEwxwkQ7kNvwEu66ie&_nc_oc=Ado2cbFue9PetCB92w3nTRgref5TTh-35pt23zvK0kTHJrN9d5zjRqHJGSts-uLd0YE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hPgeYsRV4rN1GtNyxUaEIaVbQR78dgqLGBOP9k3BIbw&oe=69E8B8F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUUp4m_oK2QQ7kNvwHS1JoR&_nc_oc=AdrYy9xr-dkQvTCs3JaQygamWnEWmlNjJ7
b=1-7&_nc_sid=6e7a0a&_nc_ohc=xnsWNYnyHC4Q7kNvwEBll7n&_nc_oc=AdplOLQ5NIj5qC6yodC6GL5jzxICCZ_0buJ3zLIVoj3MVsXvMo9JSX1v7q6dF0Fuwko&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe5UyQiet5f8OeKtYMgXy0L1blR0St-q5WdzBHSiyq7g&oe=6AE1F899"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kojPYUC_GToQ7kNvwFnMHK8&_nc_oc=AdpQ8ZOppl7RNAHM2SaFO46dkQnEiKT1I7wl4fHaMolDRDAK55rHFXsShkwE-8skhoI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtdYLtHjDi9f12PSqybnYOp_W2QnmVx9pSk2UgTBoxdA&oe=6AE21CB7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HsQappJwO0Q7kNvwEn9rWg&_nc_oc=AdoVWbGIkeSx8dv1Nj3k9q55H1Ag-ynxhr
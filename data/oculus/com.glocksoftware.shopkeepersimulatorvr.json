b=1-7&_nc_sid=6e7a0a&_nc_ohc=MjWQ-h2xmSEQ7kNvwFlUBQU&_nc_oc=AdpCcNAaOGANKfGwJ-SUBuGK69lmUSfrOz3w2h7MCdVI4gQ53s4iUcXSPCiwYzfDZ-k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmjsCqMV8mFBJL5xfqKdHYXG0h5lJEAuazCJyrtQdHEQ&oe=6A58DC99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsDkyZmyPk8Q7kNvwE1vyeF&_nc_oc=AdpE9mt6aYmTVeP8yyjPQK7U6Q561UeiGZk2Z9LzmiAFbU0Fc9dAbPz7SOl2H4_THRw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA_I9lzJ9O5wZwvZzIio-uWgD29YjKrNH6U8RjuIDBZQ&oe=6A58C877"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPu5-LuP1tIQ7kNvwEw6yyE&_nc_oc=AdokLkqPgGs3t2R4KiX_EmaFuI_EyAdDi3
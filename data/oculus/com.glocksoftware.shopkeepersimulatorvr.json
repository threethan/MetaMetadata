b=1-7&_nc_sid=6e7a0a&_nc_ohc=DvW_FJc_C6sQ7kNvwFAwYro&_nc_oc=AdreJMCnNdiGKGCtbj--brpQu7ek6ES1WXNOqPBvlG_ThNiMJFZrRbNBNkA08VppCUk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz3Mt3cFapdkSGW6VRwhYH8wqmCFImVK6C88OSmGej9Q&oe=6AF0B159"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNnc9nBbJAQQ7kNvwHatmNK&_nc_oc=AdpDKsJRxHjx5PNWjCqlATRSTLZrQK5_SXyFHqRQmcDtBfzUD4AF10sz_4LsIMyS2No&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0WbAdeEOzrCWsNRERj937h34d_tzmhvbZ_Q7MsSAG9A&oe=6AF09D37"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGYQxHnmnXYQ7kNvwEnF688&_nc_oc=AdqEQz_LgJr8qLHRgmoWo3atft80r0_Pan
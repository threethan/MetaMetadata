b=1-7&_nc_sid=6e7a0a&_nc_ohc=uOFSOBS-EowQ7kNvwFI7jZW&_nc_oc=Adpi88RqBhM4oqSNMRn_iXG9Df72AfiZ2JYqxMtAKR5PUzzT5sZWA_PkVmTCahCfnIE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl_0wdkaZ_NBiNtRYhh8w-KgjRy80hZM2mL1SkUMdHXg&oe=6AA55399"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M1CAY6fPRkQ7kNvwF7251q&_nc_oc=AdrBJ_As9SUfrG-aUjHmjXz1FCrCCMtJCCzjrmjyf5zsFeUtFFCVxm-BqvzWBZL8icM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXJN9bJGAgaqBT-WAVGu7MSoN4gbGGTIVYbehDy23pSg&oe=6AA577B7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlQSYUZpJVYQ7kNvwEGKgHC&_nc_oc=Ado7U6fTHMpRVYjiV4bi7bDgvm1R_yNhnu
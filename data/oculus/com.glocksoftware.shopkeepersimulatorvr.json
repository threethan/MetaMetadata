b=1-7&_nc_sid=6e7a0a&_nc_ohc=qJSxeTpvhQIQ7kNvwEbmcUg&_nc_oc=AdrQk_RUxsTpwHfA-YpnFoq4lQDFyg7g3tUd15aIXC71NnGF38mgXRThD3H3H-igJuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlt2FJZdOunEV-V8K70wRyhsRi4MS_-3wBgxfKULToYw&oe=6A4A5C19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-BbOhR9REwQ7kNvwH1g5xf&_nc_oc=AdoyMObwb7C6MGMjmzmUgbC69-EY8nqTqqV0xfgktB4UH8DXq6quMYJrLMSeR4vOXZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwEIG2PXctTf8AgqQ8xsw4zsda6RMgiX-bt3jdv46JXw&oe=6A4A8037"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXLaWB5z9XQQ7kNvwGixCEQ&_nc_oc=AdozAKbCssNAHO2wMg5tzTkwcPEbzmkzcL
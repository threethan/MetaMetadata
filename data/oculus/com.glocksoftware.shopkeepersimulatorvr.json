b=1-7&_nc_sid=6e7a0a&_nc_ohc=ZK6I3hkebHUQ7kNvwEAmg_7&_nc_oc=AdqF6Qmn56aZnv14aUXvGoPXUqMeojYHNZ11sd-9wmSjWLhTLMNS_5P29cCDg-yIv2I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zVWHcnwN-cKqIvlw1r3WVWIXZ6lLCxdN86EoK1id_ZQ&oe=69FDE519"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Oya31lGh_kQ7kNvwEXRhWw&_nc_oc=AdryDGjUqrxLjeWOFh4KnoX5kNOR1kMGNfwXfbgLX7M5h1TXf3Zsu43xDR2kog8WU2Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7V4i0l1K7QJhKPemdJw-dk5chxsx_xh8hq67S9dq0dTQ&oe=69FDD0F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOYjDt4d2b0Q7kNvwGrwcWQ&_nc_oc=AdrFGALb2ZrhvliMnfeieZK0q3px8MlkvD
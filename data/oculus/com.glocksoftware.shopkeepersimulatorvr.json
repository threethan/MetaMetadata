b=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9CO6D_KBLQQ7kNvwHCd_D9&_nc_oc=Adr9VB89mCmSgwHHhBMIhwTkpH82OchhMd1rL8uUhEyrM92rPHt0FUZKDDUKS1o0ajQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jBNS5VzzLqUyholpC1iFPDm1Vz8r2Bb_UpNu1tkCUzQ&oe=69E77B99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te_DZWfVwiEQ7kNvwH-3ycg&_nc_oc=Adq5m4wyK6Iyz9a0dPgYW_mHZ47JgnyhsuFWRVRAVWZzj_q-7N5mwHRsl_8UBmkCo7o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28iyghpuvVA290eed9ZxxEMFbFszO2mjAd4f44i60HlA&oe=69E76777"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUUp4m_oK2QQ7kNvwGlzbx5&_nc_oc=Adp0xGMaIA663Xk8umYZgvU7tOcYxYAgEZ
b=1-7&_nc_sid=6e7a0a&_nc_ohc=DyH3PEubggMQ7kNvwFlWgzH&_nc_oc=Adp2onbOK04083xyA7hkzGvdchKLopCaft8v89R-p1OUK6S15y6jAuAjoGmLUjNZ6tE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LK-iIrq9B_pa-DbEmET-u10eKLqJByl5skjdp8vvNag&oe=69DA4C99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIPuFsVTwO4Q7kNvwF0gLV_&_nc_oc=AdphxlMdKnon4mxnMTyP6Q4yY3VzKDAWnbeAw_1HoXAQX5WMDbSai5I7ZEGsU3nV4aY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a2NBaVPrASpUaj_ACJPzzmbdgCTcDgviX2ncLaW75zQ&oe=69DA3877"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KucJ76_I3YoQ7kNvwEc4i-m&_nc_oc=Adq00EjkucY5G9ii8N6GC5Ezvuvy7pb-Ym
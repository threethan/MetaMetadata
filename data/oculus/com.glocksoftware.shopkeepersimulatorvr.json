b=1-7&_nc_sid=6e7a0a&_nc_ohc=N3zdZlvAqb8Q7kNvwEUEQLz&_nc_oc=Adrf_fqS_GeypCQp1dXqkadwA28RObEDU_z3CDfdS9T8JX5sUDIaBUkPRVP305DBr3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-JWprlAddYgsmCWcGBuUgqe28TPpyBblNk0jSnKZoQQ&oe=69F74D99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKxiInE0688Q7kNvwHdFCRb&_nc_oc=AdqoK8Cm89k7Swfr3yvA3ojv82WhapWNWqT6Fh_N7RRURDyJ7yYEsX1vcu9tHZPEaXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vETStSlx_-VQdBNKayUrFly0l-VfOEEec1HhNQpG7HQ&oe=69F73977"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAKOn0pj4j4Q7kNvwEgNzO7&_nc_oc=AdoxkgsjnXLFmA4QxqEWS5QiyLOYkFCKWP
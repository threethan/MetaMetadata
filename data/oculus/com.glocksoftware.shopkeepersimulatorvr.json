b=1-7&_nc_sid=6e7a0a&_nc_ohc=0fLPNZN4ftsQ7kNvwFZ7Aap&_nc_oc=AdrbzNNkXO5QU7BptB_GIs26Sxt_LHpoK1Jxh-VTWxuCWe_hbW0nT1pWIAkBAwzbRjw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BxFfdt44RHVPcaojp_QOM3lPz7ein1RpCCYOzHMPlKw&oe=6A105A19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ7BRAmIPT8Q7kNvwGJf4Gw&_nc_oc=AdrlR9QRB9ESdxW_h1geZdQfoLMs_BI1mVAlMp8dA2b-ZCIqg0dDKn0Lw6RTpHYok3A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N8nDl47c8Px-MYmJrwFQjvqQWZlbt6t_B4oJ389MsqA&oe=6A107E37"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMfsBoW8hskQ7kNvwF9e8ax&_nc_oc=Adr3iKbSO0WPqohj6i0m9Ke-DaVJ9v3f4v
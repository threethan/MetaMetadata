b=1-7&_nc_sid=6e7a0a&_nc_ohc=pL9eerIaqOcQ7kNvwFoM_iL&_nc_oc=Adova_EaQJtnHckdIWWmWz5_jN6ov4MdeTMh26VUqppAl-cb240Prmie6oV3E0Hd_aU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MGtB18VP_EcI7T22g4ofOc0E_xlyDKie2vjgHjb1EVg&oe=6A217D99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v7-O6mS0850Q7kNvwGzgopB&_nc_oc=Adr5ee-bcCLfF7IVjC-owM0ltTtauBbY1v1w7Je2NYANQCNspINN-oJLcOokZ1bNvac&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af820IU5eLgpYBrM-sp_JoUH2OOcCQME_V5fNgPw83bAuQ&oe=6A21A1B7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZxM1_rvewsQ7kNvwHk787u&_nc_oc=Ado6lHNX5h-OaOt6liobCGj-dZFhOQtkOD
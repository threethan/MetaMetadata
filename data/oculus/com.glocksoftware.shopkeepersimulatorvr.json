b=1-7&_nc_sid=6e7a0a&_nc_ohc=JS-2XkOgAvoQ7kNvwEjbUQc&_nc_oc=AdqSuowAUDxolVE7uIumQc0pVNu06o7x5z8maItRgrILN9qeOz765JeIFyPofZs9F44&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VJw6vWy1Ts_loqnQFR3fBdGYQmYugzZ6G7knIdvIOAA&oe=69DE4119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgkQpe3ONxcQ7kNvwFJrSbh&_nc_oc=Adpj3za_lt0MxazFf-_fzHW0ME1AAS5YkZv0OjmroQ0nRrOJFUNETfSjZq7pIkYaZiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jpkrjc6FibVOxJ7Vhc6pBIptscCHkSWt_ayovaplP4A&oe=69DE2CF7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QELIX5_MiUoQ7kNvwGP4gNd&_nc_oc=AdoJDWHGJ1_tM9bYqdJqRoeC8oMM-_Capx
b=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8tJj4NRi7IQ7kNvwGqV6Uh&_nc_oc=Adr6sQbwUNhbHBkC06YP9ju2cbH1TSWY3hhwsybrBXURjWgWuBRnjNt7HL7RZmWsQRE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qEYkyq_v1bnF0-7I2l66YqWnWIX9wzEo3b3NjLwZmHQ&oe=69EA1E99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ9RhOEwxwkQ7kNvwFiT7lw&_nc_oc=AdqOKZROj3diK46U71cK5lk1w9YopODORNv2yCFpgnVBk1I1_IQ360lJ1nNd5ED0HfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rodpDjVbKeErcytDv5fa8hoZzvk3dyism_6Y_3hsfAg&oe=69EA0A77"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asZ4GJEvWJYQ7kNvwF1o11G&_nc_oc=AdqsJ8Z_gMrlP2nu1JUBadxOBQBtfRU7rd
5-2.oculuscdn.com&oh=00_Afvd38pFlgw9IoBGABETq-cdUq4kRC-2lvhdS4QDAvy1fQ&oe=699B0499"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SkSGzT7itoQ7kNvwG-c0gr&_nc_oc=AdmsJzy8xr5GlqFbS16Q9xQD3yXlUtBjNOTmq8IWZC4z7bNo4UoU3Zuqap1_kkAP7HQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftsXuG2mlVyX5F180ZYpx6WtIMO3M-_IL8AtrWrQ8N6Yg&oe=699AF077"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwDnzb9D7uUQ7kNvwHxLlby&_nc_oc=AdmZcvXY9lJOHWK_ASDLuIFccAwPLC_mXl8by0cymEnzR-cjT9gGxbrvs0h8UmcijsQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsLzonuspXKCSyakWB9HYti8qjDkRrS8zbtRGVu1ZJ-tA&oe=699B0717"}, {"file_name": "Cover_Square.png", 
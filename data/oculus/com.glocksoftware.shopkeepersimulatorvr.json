b=1-7&_nc_sid=6e7a0a&_nc_ohc=dezxnJEaGckQ7kNvwETum5Q&_nc_oc=AdpoqigrwP5TlIJb89BDu59KyVKiBJ_gJ1irc01kXmMQefzLxQJ5Ojgl-Xb8c85w7Dk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o2JN_mAckeEZOxUYqbCEH0OO1TDCIbqGVBtxOS3G2lw&oe=6A3E7E99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9eTT5dkhtEQ7kNvwEFgCEG&_nc_oc=AdrLoI13vctfkTI_IgmMaDhuQ60gT0gDmHNnS5-A2Z2dJp6rwq3456aNogxNgploHpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KsHhHudZyKN-xkTrt5-4pJkg1Ckwrh01liSw4o-D5fA&oe=6A3EA2B7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqRXdiHjJx4Q7kNvwEpBjoC&_nc_oc=AdpKKC94oa3miIbOHwmNXPUTvB_ubXmkMi
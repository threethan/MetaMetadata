b=1-7&_nc_sid=6e7a0a&_nc_ohc=aDL6w2rLrUoQ7kNvwFD5yiX&_nc_oc=AdqNAYGHN6v4fIYs28KNUGGH8UOWFEYpQAxwlbu_VxfvHxlNOp4p_ZWVLKG-AWMQlOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG12ylm0FJN4GwMB344x_g9iZmISH61EkTcvmec6TARSw&oe=6A845E19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1QPQmGLp-0Q7kNvwGQZ1M6&_nc_oc=AdpWjarAkUtjaPbFJWGC5hhlvWA1f9ruKmV1Ib7iYGqVR-xK4c4apOMsnU2Yy54neVU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7lifp8N1eehqNhue_CdPhjhfrwfKbZ0AA_h8dYEy2EQ&oe=6A8449F7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPK5G9AMeFAQ7kNvwEcDPtQ&_nc_oc=AdobuHn1bmVI5ihqcuoXiYZTGe3E0GWAwg
ag zahlen zu k\u00f6nnen!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.shopkeeper-simulator.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Glock Software", "support_website_url": null, "website_url": "http://www.shopkeeper-simulator.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26982957284683737"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "934081066258050"}, {"status": "PUBLISHED", "id": "756620410646028"}, {"status": "PUBLISHED", "id": "2466338080524235"}, {"status": "PUBLISHED", "id": "1603505547730862"}, {"status": "PUBLISHED", "id": "2525284517824073"}, {"status": "PUBLISHED", "id": "780946284442028"}, {"status": "PUBLISHED", "id": "3946776198911903"}, {"status": "PUBLISHED", "id": "1296674931560012"}, {"status": "PUBLISHED", "id": "513282965147312"}, {"status": "PUBLISHED", "id": "1469713217749530"}, {"status": "CANCELLED", "id": "484059857676769"}, {"status": "PUBLISHED", "id": "1276575680036674"}, {"status": "PUBLISHED", "id": "539429171875943"}]}, "baseline_offer": {"id": "2525284517824073"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "934081066258050"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results"
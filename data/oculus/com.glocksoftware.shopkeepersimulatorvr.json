b=1-7&_nc_sid=6e7a0a&_nc_ohc=biiZ_FAfwv0Q7kNvwFsSs4b&_nc_oc=AdpnDe_g7l3uBa-I7lRN4F4aZ_v25a-KI8W0u8OJuTwYJr-EV3QmDJ5X6NyHDwZjYZM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4z3WRv-w17jCY24wtCVJs73tYnfnEDkVsgGKMv5IC2A&oe=6A8AF599"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4IG6OjGLAcQ7kNvwGxL_Bf&_nc_oc=Adpkr0nIGiq3RvgHGDhIeJHqs_08Q3FlDHqIvIYM6BwU4u3MLkFIkQKJSUVJLcBxVZM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJNi8e5fpEbAhSCFlsNEax9CYQgytAT7WR7BnixDdAEQ&oe=6A8AE177"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeNzP8FHDcMQ7kNvwFsH_8-&_nc_oc=Ados8QfKeTR1_Dl-vpytKPKFXQC04yMZTd
b=1-7&_nc_sid=6e7a0a&_nc_ohc=DajW2E_ZAVcQ7kNvwHUVDic&_nc_oc=AdrKOwqKLYqvHCNVyQ6CGyGIdadf7So7Jul9FM9XAz-vKuZyh-NYvGMxy6kKtNNvzu8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92AF8Cw9jQXq5yBmCUCzDZWXp2i-XX7LeOuwbupir02g&oe=6A32A119"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKCu_nvSY8QQ7kNvwHaf7sj&_nc_oc=AdriKekFrsjjD1WinB2JS6xhMEC0O4B9pgLVLsia1P45SfamUnYw4QUi8n2xJawPvIk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dEW96l8yBA60ve6_zbw9OZp2T9PJhyR_X9FhSXdd27Q&oe=6A32C537"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLAO-Ph2K04Q7kNvwFKnOQi&_nc_oc=Ado_5cPrzvdBB7bWZAsNEjCUrol9SnoiRs
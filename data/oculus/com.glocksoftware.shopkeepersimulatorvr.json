b=1-7&_nc_sid=6e7a0a&_nc_ohc=BvgCvKQsL4AQ7kNvwH7r-6O&_nc_oc=Adpph94XZih80WfDOk-RsWIwP5y9lvZ9IyZ7CQO8UMA7y-S54GGId8Uu5OmfpJvHpBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEZU7w1axIM5akV9cjHLfXF0FaWmlwG8CR3zDWFWdCZg&oe=6A6A0019"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=noUHuXEPiuIQ7kNvwF34eB7&_nc_oc=Ado5uOhD5i--_w8vdskh0M01A_HUEPDwaQnebn2mRcm97g3gClK7N4Oz1hktFMLDSNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtWSRF0e-s1DrN4uI_QcMxCnPIMgyV0bs-0ySA1_RO0w&oe=6A69EBF7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi_whq0tE50Q7kNvwHzyxWx&_nc_oc=AdqHX1x-lfg-bxO4VGfnkPvZTDuATmY9vm
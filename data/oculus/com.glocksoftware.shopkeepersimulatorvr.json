b=1-7&_nc_sid=6e7a0a&_nc_ohc=pL9eerIaqOcQ7kNvwFnnM3h&_nc_oc=AdpWOG3tedx-a-NirwTMB0xyGgEEtIcezoA1dTaov52qG97yaFKdmYbKsvVFm6I8dOU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tY4faJAbzeFWV5mwt-Ks3rnASyDRJfdD2QZn8tWptsQ&oe=6A242099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l5uBUBTbIMQ7kNvwE3cRDZ&_nc_oc=Adp3AlFAxSgZztiAEQEgM_NaEfYeFHU4KOPG04EDpsVDjbUpmKSFU9kOucfn3NW6Abc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-035gdJV1Gw3ltp0177nC0zc7mW6iMiQ0EiqGtOZb0Pw&oe=6A2444B7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZxM1_rvewsQ7kNvwEbN26t&_nc_oc=AdrZBzTogSgwGYB7lh0V4IrWZOYa_BxyWQ
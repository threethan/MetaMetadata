b=1-7&_nc_sid=6e7a0a&_nc_ohc=JS-2XkOgAvoQ7kNvwF1rIDk&_nc_oc=Adoq5wV2qFff1Wd1iQNscMB2U9gq3lPCdoG4j6jTLv6hBb2iVnTC1W72ALjLqnefg7Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tXzaLFUL3_9z0AUxeWXWTCFJOY9_UkzTBGKcgQAm2vw&oe=69DF9299"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgkQpe3ONxcQ7kNvwEKep-P&_nc_oc=Adq_B-gOW2xGMHqFaKDeX5vQigFF8Tgl47uJUNCb4kniNwu1asGn6kKG1tCNKIVgPy4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Xo3TNPhoRU9MZYmGSZ30y6R9DZYLHz2jlpvFMIkY4hA&oe=69DF7E77"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QELIX5_MiUoQ7kNvwFkhKXa&_nc_oc=AdpU_Ztw6Vx2ObVPlGVvYr9FaRYjoIMFGm
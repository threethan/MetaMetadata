kQ7kNvwFrE2kf&_nc_oc=Adm0X7BwM9ty3FiP5gM2BEXP3jJ1NjSITCR_zhnHe6NeX3REza5DRw5tyX_kMnNbu-U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi8G7rGBGs7f7bbzitUSY3FBs6YQAMHT0O1Lk0zXypEg&oe=69AAD699"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7Jsq4ImcNAQ7kNvwG48Y_W&_nc_oc=AdkAbSMcEchBHXIn9US9ZSkUoLtEcuwXpYZcISumsRhsrGA5GGGPEv7Az82fV_IvPgM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afwv5z-JBMX6jXXMXPT-ZbaSy3h5srErp4sEED69cbWjMA&oe=69AAC277"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzrIAwfoJf4Q7kNvwGYdzOm&_nc_oc=AdmzMwhnnZvPxNxEiFYEWvG282ALUd5wUxxOGkRvWBL0OAlSH2v3VBK5zjMpu6y3bEk&_nc_zt=3&_nc
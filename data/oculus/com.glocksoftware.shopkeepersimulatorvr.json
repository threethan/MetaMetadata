3-2.oculuscdn.com&oh=00_Aftzn2TF7sqx-DkKyuQHTOeREvx2za7oXkmznGb-cbNJlQ&oe=69A04A99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr1L5XejUQwQ7kNvwEjMPjF&_nc_oc=AdmGLWLaCnAcJg1I5eYZCv3grAmIk-yx_EzJOPerVjay9YVBeoDbAtlKgTkrfnY4niw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftgRCBPF8cZ6CTzJcDBrPeZY8JDy3gl-KXpvpdEKTgzWQ&oe=69A03677"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVriJJ3ZmYQQ7kNvwHQypG6&_nc_oc=AdknfjhWexTbYT7kswAbgziizWjRtPw8hsXo33lzZ1bFnsU08GzrZ-6M-okIkAuRmOg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbCkCZBdfgiFNQpCLqIpIz-osgIRcSu7J39gkkRJNzZw&oe=69A04D17"}, {"file_name": "Cover_Square.png", 
b=1-7&_nc_sid=6e7a0a&_nc_ohc=WVUdUrQP_KgQ7kNvwFXauX-&_nc_oc=AdoGIpzy8mYf9oNmb1hMVSorhMo-soYRoCyALU2OFmhuu0jrvYCFrcHuHXRk_xmCAA4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgOXUYcBTwfY8v59xjL6EDB3iTpTuMNMqk8EWL93EvPg&oe=6AC79A99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWBJ8ETNm8YQ7kNvwFwQ5vM&_nc_oc=AdrvX56K2Riz0XQlF2cSbB5RADbGzu7a2GgXEnohkXsuAFQs3LM-R6SODmcg3ulxUM8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRNcjgQkwQDNZidU3nOqsqH3Qv0e34P8PsWE0MJxS72g&oe=6AC7BEB7"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbO1TRnXfcQQ7kNvwErr2yD&_nc_oc=AdrVqOh3aCo6OfceV9ILO6wsy1K8DB-NSE
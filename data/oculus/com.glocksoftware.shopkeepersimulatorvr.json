b=1-7&_nc_sid=6e7a0a&_nc_ohc=MKWIc8g44n0Q7kNvwHt7UqO&_nc_oc=AdoPoSMTTqFl2Eo6tN6PYToPrTTQVXjGdjDNWQ57ABGQgEPQP0Wg41FDyqalXllnu4Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyljRj0C7fDvsmHLvFNCMCH3rKwQbNLvMFkf9RyZPc3Eg&oe=69C53499"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9LO-pXP0ScQ7kNvwECQbDx&_nc_oc=Adrx04NWxVSINcRD3CBCfUC0-11N5kU7Phn7U2V-aejKG2h-YKneR7M2TDG20-Kr-Tw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBiXSHnJGWr2plfGGRdDC8X40T0p6hp-nQkC65bGAX3Q&oe=69C52077"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2jLyxyZoNgQ7kNvwGhzE03&_nc_oc=Adonrm6XrvGir9E1aDkUWpG41sLq_--Tki
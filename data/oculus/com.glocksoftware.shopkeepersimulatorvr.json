b=1-7&_nc_sid=6e7a0a&_nc_ohc=mfGWXw2dO80Q7kNvwFryXZB&_nc_oc=Adq_W8CaLhMNFI8QRVG4bNY0ryAe0iqIZLvNM1e9qlTAGZFImeLeKiJxB0EKt8gQlIA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK5vI0dnQSsRf2dpq2v6IBIL1Tlle6u_mn6rLCInWGhg&oe=6A806999"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TC3NaJv94IkQ7kNvwEXH487&_nc_oc=Adq3jvPkWy75TIoC3FppowFzsSh3zPROrtryQDS4GGWlAu-qBy4qGj8JekfCAsTcvfk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh1aujIQRo7yjtoa5ThI1CdGL35QMUg1NRuj5U44Fyeg&oe=6A805577"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5H2QxGWI5UoQ7kNvwECVb_J&_nc_oc=Ado1H6bH40uO_sNNutKlO8PlwJjKRjgFlS
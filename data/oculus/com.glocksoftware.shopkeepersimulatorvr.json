3-2.oculuscdn.com&oh=00_AfuiDPwtCRvSGVq2Qrtr9qJlAhgyp53Pv5ENY8xnUX4eaQ&oe=69A59099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shopkeeper Simulator VR: Refreshed", "keywords": [], "long_description": "Shopkeeper Simulator VR is the original trading game for VR, now also available for the Meta Quest! You have to run a grocery store, restock goods, and earn money from selling food. Unlock helpful equipment to make your workday easier.\n\nExperience the Refreshed! version on your wireless Quest in a revamped visual environment!\n\n**Features**\n\n- Various types of food: From broccoli to meat to cheese!\n- Unlock equipment for better efficiency: Store products in your fridge to keep them fresh; be notified of new customers by a doorbell, and store your money bundles in the safe!\n- 3 difficulty levels\n- Dollhouse mode for smaller players.", "short_description": "Be your own boss at the supermarket! Serve customers, buy goods, and maximize your profit to be able to pay the rent for the next day!"}, {"images": {"nodes": [{"file_name": "hero.png", "id": "8349211358474029", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031574_8349211371807361_1227774605904861488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijGVHNyogdYQ7kNvwFOg8Ba&_nc_oc=AdnsuXnZFeZBCxGZMYkPa2U8Ez-3R_FdkAQOcctcInqZhOY93Z6ScqTwWTOXgIJjrPQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftI22_vD95fjZxlzfh9tP8Z063mMXJ6T46FZkS-WXGpSQ&oe=69A57C77"}, {"file_name": "Icon.png", "id": "2559169200942243", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031490_2559169204275576_1944046110828056335_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3Nvjh9Qdj0Q7kNvwFYp8mg&_nc_oc=AdmlZcgTK2tkJkacf9jkMNyx_jxkeUflIAhA6lYwRC9D_G943f01yJPhT0a-p37PK88&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv9bE3ZYOHd9i3h4hg2749KnVbhdewTZNeg3_3qg4AXSA&oe=69A59317"}, {"file_name": "Cover_Square.png", 
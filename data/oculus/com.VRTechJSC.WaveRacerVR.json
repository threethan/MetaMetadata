A-HWPGSMXLC4ju_f3hAjZlOhaPruLww&oe=6AA016B6"}, {"file_name": "Screenshots_4.png", "id": "573454281714156", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473397645_573454285047489_5413129427020084913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6F6M5zfL_kQ7kNvwH7I72n&_nc_oc=Adq7LnIIrNf9aOZzpCYlNxCzKvV6S8xYDUTohvG9jf4A4-3ns-EVtnk_eHf42EiXSlk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOBAtqPV5ZlEzwDVpbkuL9KIxpyso9WtDZXVu7kqfGNg&oe=6AA0230E"}, {"file_name": "Screenshots_5.png", "id": "1846048859476620", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392122_1846048862809953_4612977317377162490_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HJkf0eQ2TeQQ7kNvwGglV-g&_nc_oc=AdqYXFonHmC1xjx_4p6Z23gAZbUnnpUS80-64MGWFq0Cn-kKh8oSyw5S752rzbda3Xk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfjjxiFZihdo4ww4WAmvRZxl4jb7uy7on4DcwNtCHwoQ&oe=6AA004C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1700905870497513", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391889_1700905873830846_8581928073233380250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE654rt03QUQ7kNvwGbVMFB&_nc_oc=Ado3cV_BLuR1o8CE9DedUwOZQDSuaDbC8eOHc9-t0_GHzfyl25OT4nPa9-l2ori7l10&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwiKth7gYbURbgmCx7itjv_TLeX4BJYiCDZQUzZfA8jA&oe=6AA018E6"}, "display_name": "Wave Racer VR", "keywords": ["boat", "race", "simulator", "sport", "fitness"], "long_description": "Wave Racer VR plunges you into the heart-pounding world of virtual reality boat racing, where speed and skill reign supreme! Step into the shoes of an expert racer and command powerful, high-speed boats built to conquer the waves. Race across breathtaking, dynamic landscapes\u2014wild rivers, vast lakes, and perilous coastal tracks\u2014each rendered in stunning detail to fully immerse you in the action.\nFeel the rush of water and the thunder of your engine as you push your craft to its limits, mastering tight corners, evading hazards, and taming unpredictable currents. Thanks to state-of-the-art VR technology, Wave Racer VR delivers lifelike water physics and immersive audio, making every race an electrifying, real-world thrill. Whether gliding over serene waters or battling stormy swells, the intensity of speed and control is unparalleled.\nTake on cunning AI rivals in gripping races where every decision counts. Customize your boat with stylish designs and performance boosts to outpace the competition. From beginner courses to elite championships, Wave Racer VR offers a deep progression system that fuels your drive to rise through the ranks and seize victory.\nBoasting dazzling visuals, seamless controls, and infinite replay value, Wave Racer VR isn\u2019t just a game\u2014it\u2019s a high-octane journey that redefines VR racing. Are you ready to ride the waves and cement your legacy as the ultimate wave racer?", "short_description": "Jump into Wave Racer VR, the ultimate virtual reality game where you become a pro boat racer! Pilot high-speed boats, conquer raging waves, and compete fiercely on stunning river tracks. With vivid graphics, realistic water effects, and thrilling controls, you\u2019ll be immersed in every moment. Outrace rivals, break records, and rise as a boat racing legend in this VR world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9112149962244124"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1066039289614779"}, {"status": "PUBLISHED", "id": "1798850084679327"}, {"status": "PUBLISHED", "id": "1576027667289066"}, {"status": "PUBLISHED", "id": "1309353258056466"}, {"status": "PUBLISHED", "id": "4340010932911271"}, {"status": "PUBLISHED", "id": "1214493773534592"}, {"status": "PUBLISHED", "id": "1586225536058122"}, {"status": "PUBLISHED", "id": "778019961346176"}, {"status": "PUBLISHED", "id": "2074452016375869"}, {"status": "PUBLISHED", "id": "1002315551861364"}]}, "baseline_offer": {"id": "2074452016375869"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1066039289614779"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9223756394416813", "version": "0.1.3"}, "id": "1163588878797208", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9112149942244126", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9223756394416813"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1163588878797208"}]}, "change_log": null, "created_date": 1744861020, "id": "9223756394416813", "version": "0.1.3", "version_code": 4, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": 
_kAMv94wUa12j1U4Ab1zEzzd6IhsjbeljrXeejCLrEc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1kqsLJHHueEYcg6NGTPe4SMWh6P6Ewe9gyQA9TTGU4w&oe=6ABE6936"}, {"file_name": "Screenshots_4.png", "id": "573454281714156", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397645_573454285047489_5413129427020084913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydbMW5cvedoQ7kNvwFm4bjx&_nc_oc=AdrnkbnZDczuMvDvwfAH02b3t9ojFLsBFDukFk9zp6YN6n00Zr-RbkGErIbx2GWB9Ew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqMmITLRsl679Qw0tN2WVALEXoamzpM9etoJuHdhEgKA&oe=6ABE758E"}, {"file_name": "Screenshots_5.png", "id": "1846048859476620", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392122_1846048862809953_4612977317377162490_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANsf-ii9sccQ7kNvwFChZr2&_nc_oc=AdrDJ2iG-uM9nSHpRPeAwE7YM8xy_z3_fBakZNv9VwAPvQMi11q-yWi5xj7KCE-Y2xY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbL64g_Ri4pUTcBgi6BWeoNQMcmwM3HKjXWBi6nxFa5g&oe=6ABE5742"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1700905870497513", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391889_1700905873830846_8581928073233380250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lKclRrmXvIQ7kNvwG5ZGz_&_nc_oc=Adp_9r8bfplTN_j18_PnTlzZG9Z6v2uxGaiNYY_i2K5TE22N1Q8C3b_lWAWox3QntsY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY0LpyV8Kli3ZBwNkFTQW7h-iB1k8vOHMOn6SP6nyJ1A&oe=6ABE6B66"}, "display_name": "Wave Racer VR", "keywords": ["boat", "race", "simulator", "sport", "fitness"], "long_description": "Wave Racer VR plunges you into the heart-pounding world of virtual reality boat racing, where speed and skill reign supreme! Step into the shoes of an expert racer and command powerful, high-speed boats built to conquer the waves. Race across breathtaking, dynamic landscapes\u2014wild rivers, vast lakes, and perilous coastal tracks\u2014each rendered in stunning detail to fully immerse you in the action.\nFeel the rush of water and the thunder of your engine as you push your craft to its limits, mastering tight corners, evading hazards, and taming unpredictable currents. Thanks to state-of-the-art VR technology, Wave Racer VR delivers lifelike water physics and immersive audio, making every race an electrifying, real-world thrill. Whether gliding over serene waters or battling stormy swells, the intensity of speed and control is unparalleled.\nTake on cunning AI rivals in gripping races where every decision counts. Customize your boat with stylish designs and performance boosts to outpace the competition. From beginner courses to elite championships, Wave Racer VR offers a deep progression system that fuels your drive to rise through the ranks and seize victory.\nBoasting dazzling visuals, seamless controls, and infinite replay value, Wave Racer VR isn\u2019t just a game\u2014it\u2019s a high-octane journey that redefines VR racing. Are you ready to ride the waves and cement your legacy as the ultimate wave racer?", "short_description": "Jump into Wave Racer VR, the ultimate virtual reality game where you become a pro boat racer! Pilot high-speed boats, conquer raging waves, and compete fiercely on stunning river tracks. With vivid graphics, realistic water effects, and thrilling controls, you\u2019ll be immersed in every moment. Outrace rivals, break records, and rise as a boat racing legend in this VR world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscri
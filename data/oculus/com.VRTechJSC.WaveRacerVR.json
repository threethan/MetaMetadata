oDNPxV7-E05j4ysFMfc34Id4ubUSeTKRa6RXq9-n_dU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQanA0RjiQuxB-6wpDbnYw25qpMLIid3l7iRfx0aAI6aQ&oe=6AE9EAB6"}, {"file_name": "Screenshots_4.png", "id": "573454281714156", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397645_573454285047489_5413129427020084913_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFy37ZUtggYQ7kNvwGOGdLC&_nc_oc=Adq7lXawbHgZ_UTbI1nURmovBz2vn9B4yfFuSA41iav8EC-rb2p7xX1U6OfjLqojUBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpRxheoQ1_aoLmxaZU8yqcm7s_yj48taSrsSncLoh35A&oe=6AE9F70E"}, {"file_name": "Screenshots_5.png", "id": "1846048859476620", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392122_1846048862809953_4612977317377162490_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYhBjNn7kDgQ7kNvwF5rRjG&_nc_oc=AdqEVvykiqdwuQeqQh9xsndbJ_Ht5cWe5uWEnwB1emwaoUULduAh9-rl7ycy6vEsisw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1corOE9sm7aofbnDL1X2s6Tbnea5zsg5JNSodHCyJCw&oe=6AEA1102"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "1700905870497513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391889_1700905873830846_8581928073233380250_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Of47TgdPT60Q7kNvwEdzdrV&_nc_oc=AdqeP5YNgeVYnnat0v4ycD_CnVh0wv35ugqDeU7qsGU50F5CmNj5KkKjdDkZ2a7q3Cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROB3bcv0qCjwWVxqea18m0DVWsdPsTbHTx92fTFnuEbQ&oe=6AE9ECE6"}, "display_name": "Wave Racer VR", "keywords": ["boat", "race", "simulator", "sport", "fitness"], "long_description": "Wave Racer VR plunges you into the heart-pounding world of virtual reality boat racing, where speed and skill reign supreme! Step into the shoes of an expert racer and command powerful, high-speed boats built to conquer the waves. Race across breathtaking, dynamic landscapes\u2014wild rivers, vast lakes, and perilous coastal tracks\u2014each rendered in stunning detail to fully immerse you in the action.\nFeel the rush of water and the thunder of your engine as you push your craft to its limits, mastering tight corners, evading hazards, and taming unpredictable currents. Thanks to state-of-the-art VR technology, Wave Racer VR delivers lifelike water physics and immersive audio, making every race an electrifying, real-world thrill. Whether gliding over serene waters or battling stormy swells, the intensity of speed and control is unparalleled.\nTake on cunning AI rivals in gripping races where every decision counts. Customize your boat with stylish designs and performance boosts to outpace the competition. From beginner courses to elite championships, Wave Racer VR offers a deep progression system that fuels your drive to rise through the ranks and seize victory.\nBoasting dazzling visuals, seamless controls, and infinite replay value, Wave Racer VR isn\u2019t just a game\u2014it\u2019s a high-octane journey that redefines VR racing. Are you ready to ride the waves and cement your legacy as the ultimate wave racer?", "short_description": "Jump into Wave Racer VR, the ultimate virtual reality game where you become a pro boat racer! Pilot high-speed boats, conquer raging waves, and compete fiercely on stunning river tracks. With vivid graphics, realistic water effects, and thrilling controls, you\u2019ll be immersed in every moment. Outrace rivals, break records, and rise as a boat racing legend in this VR world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRtech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscri
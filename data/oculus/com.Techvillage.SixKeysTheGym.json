?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKfTRsPQ6jkQ7kNvwFblV3s&_nc_oc=Ado-k7ScsV-uZwSkZUyTUImf7roiU7IEEr5-0SbEzK1XSRBxu-0zGGT6U8uQNT5t37I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QOUCFJLHyJuilxoepR9lTGBhBRhmetcUaVAWJCX8tvg&oe=6A1AE90D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MO5hozLvRkQ7kNvwETug-Q&_nc_oc=AdqpU5MBx_cqXyasJ2YoDlmlYcmzcRHO8QMFSRFHY1qdFM-1EDtpN2x96CqbZZt8Qy4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Rf9Eha_j7B1aD6IWR7I46Q-tgJAuMrgmwQdBbYJS8RQ&oe=6A1AFA03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxhX-B1gWcgQ7kNvwFFQyKJ&_nc_oc=AdpErmoOyazbbvsATWJ86vSyXz3Im25xCQQn2l6kx6FtzH8iqqESyLF8U6OdE7HgY-U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xClP-zOvNacVS3I46yajP24Q5Xh1i1kttGr8R1Izqzw&oe=6A1AF7BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogTEivDAZjwQ7kNvwHXxxCF&_nc_oc=AdqXz9b6gtQlyEThT0SJfXfN9qBHRTbHq9auDOiJ5IJcM4JJ3zRePBZqZWsCDStSp_4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yTzHfc44dg9XGeSTwY5ETO4NYoAa52e01GDeJ779NtA&oe=6A1ADA4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_hY7n2DpToQ7kNvwG9_qqh&_nc_oc=AdocPOCL1U4wKPxMef8dLWFuD_aajrZvLQoOgOcFnz5JOlZrR5dEFNXSiUYbWU9i8QM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BGZy_0DzD45OHFQGWLsGKHyUC_f8UIwuu8MQhI-e26g&oe=6A1AD601"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GraLNS5VpUMQ7kNvwFDoFKh&_
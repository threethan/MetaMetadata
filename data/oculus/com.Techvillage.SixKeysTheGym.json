?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqwwB2WwMREQ7kNvwHEW-pS&_nc_oc=Adp-PzbV25tsHMx_QMuVLmIA_FXPBT1N3sOgQHIEp0qRUIeC3js4ov-uxwTBCaNNjTI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM1StrXc_mfpskj9k5OfVBdCw1-6MNRgXArNEpyzBj1A&oe=6A806C8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYoAHSdbMKwQ7kNvwH8NCqs&_nc_oc=AdoTRyUYzZbtVepd3CfxcYM51rLgfBOdeelKVRf__VYnu_MmbcukQsOufGXNmiv9Bm0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8kigAXRpPwn_MJ4eHqYw-x2RtWRA7hh5mB8yOQ_Gt3g&oe=6A804543"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH03ULTEJNUQ7kNvwEUx59l&_nc_oc=Adrf6LEnMBjBEB6LVMa3BdmUE8-hkLq1aCWj0dvflT70cA05Jmg9J4KrzWtu7Xs7Pkc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDt4J5DaEktCMHZRKst9jSpaXC1lUymm0SoHJy_6YsjA&oe=6A8042FD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYxDq6idy_QQ7kNvwHtq-De&_nc_oc=AdpTwbc2AhQSE3Zb8Tuv0GzjG_Bwcl5ixnx_mzjls0fNI904NkDgkSzlL-35TAMbgEw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvwF0prRoIc9d_-8ltfvCJCi9F5hTnUS2A8M9lNUofDQ&oe=6A805DCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbxP8Qryhg8Q7kNvwGXX0Yw&_nc_oc=AdpBft1zhLOisAlxZ4DdvCTjdPmhGe35GltX9Zu_xpEi8nkRPq3U0iHbu_bR9Ok2HyU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRCUXDUzb9crh5-YVGdT2_d9a3n41D0SDWQu7VGRH-BA&oe=6A805981"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SvKM5NjiaQQ7kNvwFIWKBZ&_
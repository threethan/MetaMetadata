?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X08WCffEzGkQ7kNvwHeuUFO&_nc_oc=Adr7lLVGY58OSShOEHyJyuWuNFrLsuGT-7BzMScbxCc9Z2z8Dm5b1MNDSp1afV7Eygs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64zBxHMacT0XM23YohYaV2f9YwpbrVN-85hQ_aKO-r5Q&oe=6A18460D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZemwiRxMvkQ7kNvwEojY47&_nc_oc=AdozI38NNHmwPfvAhu6UazxGpyifdcRHm0v9LnDLv4jEefmNveCTjKE9kJsmC5guzUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6t2_5AUkQxi-Ro_tgl9zDr4T5wtLQcSh5I1tU8hhVExA&oe=6A185703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxhX-B1gWcgQ7kNvwHju531&_nc_oc=AdqHRbICnDs9nbFv9CXBoUwli0nBC3wuuMxDe16HGrUACeSNP6rwvz_r-NlrmLeGjiM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hslYnbclRn8XwLirB_3D-pdjGZViSWUME27YS0Vy9dA&oe=6A1854BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogTEivDAZjwQ7kNvwGfAuzt&_nc_oc=AdodEYi0yQBHIDl33gXYa1VFWZpGeQKozchrpTmgHijMdDN3cn7Tcazh6e1e2OUH6Mg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JAQkQMG9HQUtrsOhGmhYVq2J2HL0Gb0TJJkdNb3f0nA&oe=6A18374F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_hY7n2DpToQ7kNvwEIoymR&_nc_oc=AdoIT7LO1G281P8V7PUUVj1PZKz9__ZgmywGPdq1LzG2UOYYMMLyyanXXysjQuhjvMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56xP6XL9DlDM-vyk-Um-muoNUx_YRl5oMN3Tjf5OpNFg&oe=6A183301"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBZyRWMswnMQ7kNvwEZh8eW&_
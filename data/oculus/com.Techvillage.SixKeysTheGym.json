?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAcXVmn-8IAQ7kNvwExO71u&_nc_oc=Adqt_CfJyctmQpevRCdX4Vq9PeCOIzdy2keBbuc08Wy00ieZ4BqQlpuDJZDN0jZYDQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I21bLGIYdUQAPz4ptIQA6oL1hMJtxbMgBF8j2bQ40qA&oe=6A01DC8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxEmjYRY7SwQ7kNvwHLcyav&_nc_oc=AdoU0PnuQg9CbYOH7jjvCEB-FTsUn664d5IfsmUkFQnOrD8qI8SPSBWes9BX36V_LmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u8YueP8c5yB7Jkbg67wmQbEWzE5y287YFtaEhlUUKtQ&oe=6A01ED83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trxkwfAEoFoQ7kNvwExtjOp&_nc_oc=AdpZTbu1Eq1jhgQfSlp3FPAmHTj5H6qj7KIydUOD5kZUzukWWmzWxmKRfKtxk1GRXfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MUzSC3Uk_qtNPrM805Tqm_XAJrDeKXFgXooSIh1fBzQ&oe=6A01EB3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGYHRhKQ-jEQ7kNvwGF-13f&_nc_oc=AdoUz9SGcMdeuwn1kPOx9m1-BZw5E4jplH2dQdjc4p-PJFUWWrHOKje1ibjPn_JD68Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wFRu-JqnLtlCnLGMTj5oJQlUchtd-qbMnU8QjNL2yJg&oe=6A01CDCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S09GrkkcwzIQ7kNvwFk73Yg&_nc_oc=AdrrmbglcqqwLFHwsUlRqF3FfmzILWZVS9PSZ8bBQcX9ZhAPgFkE34htcyg_tdfAII4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ME3Dv8Mk0CtPji4vS6wwD4n4XJLmsEl4opdT8z49bGQ&oe=6A01C981"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-qju4IXsfgQ7kNvwFvTHRl&_
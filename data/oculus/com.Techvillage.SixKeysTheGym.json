?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOLYoieR5SsQ7kNvwFKxxTK&_nc_oc=Adp4NWX-sT95QqC5USYqg-9W9fh9QWA_EAh3LpjBtqAl9CVEhslq9Fz3gVntJC6kNGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwJZXk4Z4tYt3I2dUyu8aVGYlhjD45m09lQ2QXTYysUw&oe=69D1150D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9hvUelBF6MQ7kNvwGhfDXi&_nc_oc=AdoMN8AubBLeLI7esystrQvCIf7nMrxNfKGiTbUVcteA-rkGB7iF8tZWhtjiQYrTPyQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzs9fU85Fc7mQ0y9T2R9S1Z1Q2wp7g4C8HRkTXzxCMhcA&oe=69D12603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhLE3LWWCuQQ7kNvwE4R63F&_nc_oc=AdpWwj5ccCJjB5YE7W9tTPjTz_YyLiUCSmv4PlfJ1ypyaUTpEugJ1pxh_6jCnXm_0w0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRRrJK9jFzSc8fbUMIKlrM-YRr6skDmD_HqXZLk9wrTA&oe=69D123BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZxiNigTm-UQ7kNvwEQybzY&_nc_oc=AdrQBdBVvNSpUyXEeHBnHRoxdzewM5yb4t-IhcGnf9At8jN_YdjJqAk_rwSIsazCpF8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNJlav4GFqht5RkYnI443lrkCA_MbQaLNTfY4Qh0FprA&oe=69D1064F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOgNMo3QDy8Q7kNvwF9t8yC&_nc_oc=AdpoWM5B5A779FJMp-gFiNiDiZiWo9ghENrrht4_qbMjIHsHuB-5rHJu5lL-QrzXBPE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_ric7ecHaYObY98BL2G3W7WqcIlAWdpcQ3IlP_5QOWQ&oe=69D10201"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n85ZABm2K2YQ7kNvwF9o7vW&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaoTAGd9uxUQ7kNvwFdRzlw&_nc_oc=AdoGQf_Ve0XY82u43fVoypajQmDZpSyplNDCvYGIju82-aFPMQ9f_SwVgTiG_RsGQaM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkZW3KboXjVOVw8Zx4NCaBeApbtWRFw4tkNNuoB809RQ&oe=6A748F0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F07CcP7wrsQ7kNvwFwMdMI&_nc_oc=AdpjmFwskK_epSE_yOrnVB5hP1RzVJglEn4zzVY8UGKx5kEgsgGqqeOZQ7jVrEmx8FE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE-bj5efvuSd9wk-oz7qjI0q5v_MVayuG5YyhWhIcV_g&oe=6A74A003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZeOTy6XXb0Q7kNvwEX5abQ&_nc_oc=AdrlSQLP6BbpbMEUmOU89H7nR8cqpFTgGESWpdPFPL1rtishvA4ZzX6ecnrOG3Rn3Bo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyP493BUeN7GA0OK1k4XMOgUznquckw3ljjqzkC5bkVw&oe=6A749DBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv-Qdw_gJXsQ7kNvwHFfFmq&_nc_oc=AdpJuA-iqOSsyU0ldhkBDeWCL1nYgGIooCrZGJnKI3jWWY-3nk0yi_Ydd3MFMoe32UA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk0VSpJT_NmsFVIMRwYZ_NXMNaP3A98jXF74jni3ClMw&oe=6A74804F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tf2Gd9ssjsQ7kNvwFI4QBo&_nc_oc=Adqc5A2sundDYQnJ4ha2YtWZvQ3TcBE8QG8e_5-kRJlKZpdHJQrT4On4SgEkDLuN3eA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkSsG63Qdm6i1JdCJ40CafW7NOHsyn4lMfUAzW3Xg-HQ&oe=6A747C01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aprgsJMA3Y4Q7kNvwFTngMt&_
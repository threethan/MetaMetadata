?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWYJDh1ll1kQ7kNvwGpLAQO&_nc_oc=AdrGx_Ua4YuThEdrJj0GKHw-RUjf9aryP3GX6fYRzPWvLYuupMPRiHHLPI2i_KXrhYs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA687lF56A3upTcYYbSi8gVGv7YJAro8pREb7-wIXvEw&oe=6AC79D8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8j8byprqEiwQ7kNvwFyetp2&_nc_oc=AdrbKDMup7kocQqhRocKPevj6dp38g9KVd1q9pfspfa16AOgXbgr0aD9X1yLo4W5Hyg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeeyQlIzfN9GgAKG6L0qaI47QMOpYVn09FD0MTxyOfSA&oe=6AC7AE83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad7_HDm8lMcQ7kNvwE37SpX&_nc_oc=Ado0iNAOdFg-Fc486UUdC8ZAUgU0P8H-XcOsXiMcew176TT9Kr83-__rCIrF1PdnGFU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKT8gOL-X4pQ5E_IWPF__RSxmL0TsplP_z07YfK0QgMQ&oe=6AC7AC3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOtXDBNVS4EQ7kNvwGkjGWn&_nc_oc=Adr22m0IId_hme-bD6lBPfeuxg3Ws3lezz4lJRnN-tKEmd6HQxs0QYx3b4tHRj1mPgg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGNAkL5XQAxnK00j_wzuV9lz_Wr-LmFfgcVBxsWy2oaw&oe=6AC7C70F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wDGgHpUOEcQ7kNvwE4rCQE&_nc_oc=AdrSLoQGQ6tCBfg8gBuH2aOxk9L3rWvB_QvbusSs6rnWI0G5L8OAUGtUnaIUypaXB9w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtepvA7yQTJwGcRhXK0MsncR7CRZAmGuT2bKyqA0aVRQ&oe=6AC7C2C1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOvVcY1yPp8Q7kNvwHjEyvd&_
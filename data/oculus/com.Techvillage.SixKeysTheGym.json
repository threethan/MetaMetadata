?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4l4kbRwTAhYQ7kNvwHZv2Pf&_nc_oc=Adre2JF7bA-G1Xu0oeAMZbvjEzXBIP5nwVe35DCkdr_vtl4C_Fq6ajosHjNk21lRuMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Lgg0qiVgI76NaPOfaA4kcVsK65aq33ntb1teQ1hCRw&oe=6AF4708D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETv4bzEKbVUQ7kNvwFIMmZn&_nc_oc=AdpWZlopAuAyCJZJR3WghosAy_DVS1UiFQEQLc2rkXmiuk67BTjTlLjDviwKCZtfhIs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjDuUH5tW5YYC_YKyf-TlLYe6YQCepn2MBdg_9x7h1qw&oe=6AF48183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cp6jHi9CIeIQ7kNvwEkkcBC&_nc_oc=AdoHJF3Wv9RoMEIcuEFvyIhR2N7oe6sbnj_2gYJCNj780sNuX_-lamH6YquzLwvMe_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAbyxHGEZrS9B2TYvNL9SW20dIAoxN3U4ZjkqcDTtO4Q&oe=6AF47F3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yu8qLtl1s_4Q7kNvwFeM82u&_nc_oc=AdqcSCmeZihUev-5-YkAxCeAmv4WHfOjKXg5-NTi5G0LL8vjUd3nduH0x5vCBJ9z0O8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvo0sWOkjIlEiLO90a3wVqyN1XZhrgUNphGUs3OphnrA&oe=6AF49A0F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjgsyW5DarQQ7kNvwGC_5r5&_nc_oc=AdohN_WWX1RoEetjXM37GrhHFgHPE-WjaQvGFBuhNyBRDs5dJdBe82x-o1p1TnGJH0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ74-CvzAKHvS0TGZJtRIbRGGyVHbHnb54EwK7EdkwbQg&oe=6AF495C1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzzixmnUG2wQ7kNvwEZ5sF9&_
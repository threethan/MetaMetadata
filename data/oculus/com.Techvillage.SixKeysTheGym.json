?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpM1X-UPmxcQ7kNvwE8XBgC&_nc_oc=AdrEPCO6xRogEjCEr205O07ITnIwuUkHtC_-wPhidkFVMGagu0cWG5dCwe3VxBx5Q84&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-J6IRIP9Uv1QLGGUO5biXURX5F0nM7mc2xNLHue02rw&oe=6AD0D80D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2Lg75iJ3MsQ7kNvwG7UB0m&_nc_oc=AdqOuGPOnjOolso4-sIKRjqrG9bJ9qBkP1jYZdxFWDNXLtOtegsRXSCTiZfWap9RWbc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgOYa-VV2TPXY0PXpl06Ponx1MLtYBo8wX8aZVR6pajg&oe=6AD0E903"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cXxSlFX2QUQ7kNvwG014sW&_nc_oc=AdqHJXmeuKvq1cB_5J6_qXye_wFvLi3iIzhsjz6pg61EWjdtyrHMe_A-uZOq5Z_W4PA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUTkkurWl1KojFX23BK48-DO1pvbjb2HwJy7Z7NAD3HQ&oe=6AD0E6BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRvGllRk3GUQ7kNvwESDdCC&_nc_oc=Adqen2XC0it2zga5naLXTeJGlVkCBcnfGMxhpVB-2WJXfkHoJ4nid1IWYaQuejBa7Uw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2QQDqXop7L73UZiePvRIJnr3stVQFUX8Iuq1mz2hxhw&oe=6AD1018F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD0xRMYeDWEQ7kNvwF3dByV&_nc_oc=AdosA5ufQpKelsUGSWn7fZlcd_RzJRm4mxWvYkP-6THCx65wbKmF4cGvSC0CysccDYk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZMDuVqXppiUbXdiipbkpXC28sNV_WDh-yFgwmMfZtWQ&oe=6AD0FD41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGHb-T8o9b4Q7kNvwGbtmyY&_
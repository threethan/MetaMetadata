?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-VystXskDcQ7kNvwHQ71Nj&_nc_oc=Ado2SUOe9ZbKZoPAs1HDDNViGhdqYlPQ-23j_-6E_n_CgbL7vGVnvy9be-Z6dLdO1ao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MFYcgI084XINzzOBHeTare-dh_dR962AbvBDpUqffPg&oe=6A07228D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCxipC5bLGMQ7kNvwHtnUXt&_nc_oc=AdpZ5tY7fyKCqJTJRuU_Pnbo-5Sn_aaNwvVAW9hvP74SuEh8lPgrZUHJkE74rNy9VWw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y85RsellpH33av46XheZHjxVUS7kDzR59eXJACIwcBQ&oe=6A073383"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxnZMARt0fIQ7kNvwFKZ6if&_nc_oc=AdqCQnS4782iYJkj_xnLJYPKqzjTxjv9I5ca0PDZ0r0zlzx6D6ehRr7XNQXTvuHvN6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nouTawwXTN8-MqxyZhpBJCKVWaE7YMBFKWZcVXBBu3g&oe=6A07313D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTW3nq9lgDwQ7kNvwEmxrtv&_nc_oc=AdplarHwSAEl1tvnWtuHRtx5YuQ_hyzivEoRuuTpSAsSHXP3nukSR4C8GFKmW-mGhVw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YJxLQKLcXC3OPdtJ6A31uBdHuvLucrrir7l6n06SuxA&oe=6A0713CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsxduMcrkIAQ7kNvwG9xsS2&_nc_oc=AdoWu-KMQDArJhHT1fDfPdPMuV5gS2xCtXUSv7s3Ty11HcJd0k0Seuqin87Q5_rde3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70Ro48aG-IDzFa7oBcO1cwPR4MnZq6OwcdfM8eZfWVFA&oe=6A070F81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1xwwa1wTQ8Q7kNvwEaeYGQ&_
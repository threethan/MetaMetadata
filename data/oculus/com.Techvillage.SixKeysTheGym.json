?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l90drNo2UwYQ7kNvwFSeF1w&_nc_oc=AdphjryfIQuHe-xsgNPy0MRkwl3tZV4CmV__1j979g9klqQcJU_tm2h8FHjej1M2jBs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCvqS1Le0KBy1e3hG6PvPlZN9ZZJwBaapTo9DN9W5nPg&oe=6A97468D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4o82bm5R-UQ7kNvwH3IbNa&_nc_oc=Ado3KiTSukIdstHzn9RUrCGnlQ7T6GcoMLoS9pS-ocHR1Z5e2f3ps4vbaDIg2MXio1A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAeoek8NuGI7F5Z1DX7x0dSobRKJ2680sYM3L7A96MIQ&oe=6A971F43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W_j55MwgGAQ7kNvwGcODcO&_nc_oc=AdrPJXnkSfpNTLKcXmCkAta4jLbD4Mw_hb_DS9VtS6Sswbiwl2PFx3UkP14X_PMqU2o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBTrK33B1_9iKd5830Iuj74xObPxZPnnDHzd-nlauRSw&oe=6A971CFD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRGOarW8_eUQ7kNvwF6KP-g&_nc_oc=Ado9PDv-0ci34lh2FB-zERt2iczns2odyWXgbFeNePAXHZxGyEJ5UXywPJ5qWwCd0nM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcmTwUYOIaChenrc_RS2yOnLl1i6kfGjViwdhy4riY4A&oe=6A9737CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7zVpqGLNbgQ7kNvwFhZscK&_nc_oc=AdrGIvVJ4k3c_tKG7BCUZgSz2qrI3Md38CeDxtPqp5CF7GTHufHCFLD7llgx4NO6c3Y&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo0McACy8H69i3LNlktiydEmef_nl6q1Ofk0kf3XFwvA&oe=6A973381"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy8QafwPs2IQ7kNvwEOEnpP&_
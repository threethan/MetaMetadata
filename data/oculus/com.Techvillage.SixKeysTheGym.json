?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHsj2oUgaakQ7kNvwFUyfy7&_nc_oc=AdpG5O56W-84ROKO17BCsv_xWMMZr2RcFqtsLHuogd74zaGPW0tMKO4wNJ1XWunODSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0apnO1MmGOqAHExNaXYxkLqsSQOYSddmKqryIdl4i9hw&oe=69D2668D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9hvUelBF6MQ7kNvwHk6yv5&_nc_oc=Adpiot86u7TunJySjRPKayFW6UTXrTR8EK89Lj-V4HCuX_g1D2U94k2FsSSSzTH4t5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lKot5Lc_b2cJKqZb2zZYFjQAUdxeiO92RgdDpqB8ZFg&oe=69D27783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhLE3LWWCuQQ7kNvwHnx6_1&_nc_oc=AdpVQnPhwgiJmQqxvYKyXn5oNmQ2sYYsk91t4ABydoS5m20bhgFWUwm7GFmy5yb-0P4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LjS7cwMD2LifHrfDBMqtq6rt9luyH-bF5Qt5GAfDSBw&oe=69D2753D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJy1ixq3wyIQ7kNvwETs1_m&_nc_oc=AdrziKiAZtqe07_wZvroRoVP_Ukih53HuY7w2qcf2Dh1bR23pv03ABkjnXgTjQK3b1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N1NEm61ET8C4KSOv_EGrquMNwTPtE3ebwLr1ehKb_iQ&oe=69D257CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOgNMo3QDy8Q7kNvwFeudle&_nc_oc=Adoq-UUsaiSi7u8hVrWR6iWU-StJDs64FwXC90FFkJiw_4BK7H41iC7oquXzpy7ykn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jtvMFE4ffNc0MDsvCaAJkGdwNECGmWNe5L8PeaiXn-g&oe=69D25381"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n85ZABm2K2YQ7kNvwGxcdZf&_
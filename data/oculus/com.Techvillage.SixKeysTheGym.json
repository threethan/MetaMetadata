?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sY6nTcPIcYQ7kNvwHj5hGm&_nc_oc=AdonLxEFA0mrS25IzdnG1l3HXc7lIvxGGfTq1EJxj-wX4fFIIjpTg-Nnu4p0N60IjpU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvTXAt1zC3oKlmhfNXDXBf9p2TfKpipG2U5wqk3zy1Vg&oe=69C5378D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4ZGhqQAEIMQ7kNvwGsNX7Q&_nc_oc=Adr21oJPaennfaODrvRAIdWw_9Tg5zdOYMnrAIMwnrzUZhhjTj_nz_kssPibNqN6C9k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwm8EHxqsGxmqRWUtes1dc3Lkp4ODyr7eBgCNJPGT5qzQ&oe=69C51043"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwtarHwrgFYQ7kNvwEZ7-bi&_nc_oc=AdoO4vXQFpnXKceQNzTkpJj3Zx1uXNcVOkrdZ5VYReGWXvJ4sa6V9Sm_q7pCMO-56ds&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAQEgtxcBt023ujjm-7qNPNqcz7QLaLNJYq4MaRYMvng&oe=69C5463D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzPWZCNPDDwQ7kNvwGBSTqy&_nc_oc=AdrhgjFKnZ2GbDOoUqIxWeEtZfJjrOgEedeHeHLfbKRyM5eB511t50IkqmKGQH0-oBw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymT3oPUsSwU5FSWyGpHs492t9h9tNnDPvfGeXjIn0k_g&oe=69C528CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1fyCi8xy6cQ7kNvwFIJ-E0&_nc_oc=Adred0Jr8Kmiju9znrshCyNIAjFLee3ZihU43S9MOZu1gWVIDodvweg6QTu1M-O_a8s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUp6LUIAfgYsHWCw3WkDE0EO9xmvV8V0j4t43dYsfR7A&oe=69C52481"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0nxhTw4NrsQ7kNvwHvVFu1&_
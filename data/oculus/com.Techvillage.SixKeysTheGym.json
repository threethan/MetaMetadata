?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViC6tJ0fEH0Q7kNvwG7dc17&_nc_oc=Adp5EkNiGoqgMf-oL7hEnnVtz64uz6wtuO6Nz1QlbjFB9H30Czo3uVMI39tFsI3lwts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XXQvKFUY87MeSBHuLxEkitu9tE2mszi7gf77MMJiTSQ&oe=6A3A8D0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AE8KqK47u78Q7kNvwFpFFd2&_nc_oc=AdrEbWts72NjPm_6iPwxrUWoh53tYmq-qZw2-nuEbxktHfamTFdCoitzdK3UMIcc11k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nuULOBZk3IYdO2JvgiXoluL_ucdwjiKNZOm8fQmhNbQ&oe=6A3A9E03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12vhV6bITtoQ7kNvwHzzFBv&_nc_oc=AdrWcz5QfieUc6so203-Y7mOgrarF2OztObVGkjQITjVxHpF8Ma5227OoGZftlJWhB8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_lTnnKjZETOxP6pEdgEuqnbIJFljZwSCa9m45LcSDuw&oe=6A3A9BBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fI-zt9Aa0G4Q7kNvwHgTEbV&_nc_oc=AdolY4FegtSJtmp2Qu5ftcQYu0JrLb8YuH5bzWE9JljeAxNlzwcn_609TCeXBDF8XPA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Bzd8pB-QhXQKy0zBTiptGfCqx6cBAcrj4MCHrRRsyIw&oe=6A3AB68F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU8BRvFUTCMQ7kNvwGeO9J3&_nc_oc=AdoO3W4gsKig_HQsuzbU8Ed0BuqHkOr4vXmFJqtZHd2AC9v92rRfCiRj8Dj8FyYPm2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jXcv5FqrMdXdBQ0MEJlmp8hGG7jfguyur9FPU4-ir3g&oe=6A3AB241"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYoTeGHMmDYQ7kNvwHlizTj&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGrORyMLEeAQ7kNvwFfuWi4&_nc_oc=AdrYPdhIgqx98c0Ba0OqctoJIofnWOicWGbtyNY3hr3Zxe6S0kr7oc0Aw8siQVDXjNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPghc7rmXCygHbSS4GENuVi85t7CLSjFjEhq8QZOTKgvA&oe=6AC1060D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMuW_7E3AzEQ7kNvwHqq4rg&_nc_oc=AdpZ0PhG8SJsmaVi4CZjYETfddJN_WZuW7uGGksQIdRrfDSJrBxrl6u-j_toh5BjpVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTQ5EF08VOdUZLnGuxVFC0yFRNW6GKy7vhG9GmqDipug&oe=6AC11703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TImbPCTQftoQ7kNvwFXKG2N&_nc_oc=AdrhG9feAT3HgKHx9P5HZKSj02nS2v8YG4IsrECinIQ3PHCfWi2WY9l5UI7Qxs3YCL4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPON6mh6vkHSMz-Idq2CVnU1Gj7EVt8i6cxAMPABJIXkA&oe=6AC114BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDy3Mu09GDEQ7kNvwH1RBV_&_nc_oc=AdoqndWtSIFkMxbg_OoPWz-7vMzo5nLOgRVzrO-O2HD8gynxWvRlcBS3P_YsNoX3-rM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCE4dJskMaa_-vOoz_c2lWsD3wywlP3_Z0yf3E7WStig&oe=6AC12F8F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ztwlffSQIoQ7kNvwFiuV5N&_nc_oc=AdpTLtRea7ufksTuKpreoLmqoo7JAwnd_72rrgzQ0nAHd0O-HjKeaO9TnVLpONTrzIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF7h8BIwS4nFa6-iRUbtLlhKXAsAck9u4JzFXlB54AVw&oe=6AC12B41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mWLe73sjmcQ7kNvwFme3Bh&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CR3E9ULXricQ7kNvwGiApOB&_nc_oc=Adonl3ZHa9sGgOZOEdk2-nusoaxpK_2k1PmxqDQww9xlKP8-SMUmhTHzjmwLJPDteSU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnwfnY67t6NJgoDi5KxrzB247RTLuTqv8jWw7ltMO6MQ&oe=6A621A0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDrblonROB8Q7kNvwHNjyei&_nc_oc=AdraqqcanVjoMv2LMKMKK9rFSv6hDjyMn8Jx_Yv352OIZC9GduiHffs9hFQOveoUtEQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiaXtbgOaofuZUqTS5EHPEkNtypsKc2u9xYUu2BbWPpQ&oe=6A622B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GbCblaO-f0Q7kNvwFkh0HJ&_nc_oc=AdpVtez0S3l9SlLWHsIQY7cy-2-HptOXkFxNI94XUJ98J9C36kScGd3QWKYKNzv_JNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeY8TAWWxeyydZdtkauR0LGKVp0od18U_THCcXUxQI7Q&oe=6A6228BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlJCX5AkQlMQ7kNvwElgUd5&_nc_oc=AdqFfPW5ETVpZvGPvM64JixG5OZthIwzqVkVBO7Yh4VjF0T3sdTYw8eqHLHqtj8PA2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH27o9qD9mNA6VtHN54DNo1sPq1snTj9RcnYUulBdWDw&oe=6A620B4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmsIFuttIjoQ7kNvwGtn8ZY&_nc_oc=AdpZDCgZpPJnwzNVtQjx10GWwHCAhXbRf91-IivjcGAg-IpsbEOfWOfBkOMNi-rwDwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhirfxF0MFkzy7PHbsEKiK_vKWCnCtP_koJZDKFbSMuw&oe=6A620701"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_chsNQSxGwQ7kNvwHOc_CM&_
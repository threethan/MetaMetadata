?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXo5Po_nYzUQ7kNvwHShCjj&_nc_oc=AdoGPLKOToc0IKq04NovuMgPCE-CtCr-bLCIO5e5x4T9kbBkR8TC5EB5VKxxWohDfHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHWj_NHqGCtEe5xLyEX8APSXTKwr6jioh0_hkoJz9tMw&oe=6ABBC00D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bRvnL_siQsQ7kNvwHFeajR&_nc_oc=Adqe9qOrz_Pfm3jrTf-2sSubbYwItAUd0QwMoIvaCtvEXwqfhnGjfRqZPs2KDpsoxdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcu7RCChRlAc-onaRw2raSZ_LG72o50mzmbX32No-FJA&oe=6ABBD103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9vhWZKDW5kQ7kNvwE-CSlu&_nc_oc=Ados1WnrGcSdE0Z8E4o_FhQ087BNxM1MR2RU_ZtjFqOykzRf88cpGUBZn9bq6Bip3hI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi1ODWsk29Cb58X7Zu6On2l28az1S06-6pqGn0gZiYMQ&oe=6ABBCEBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMQWJh0yWmkQ7kNvwEccWbC&_nc_oc=AdoATcZbdayjsFJBNwMX5qtLEP7E9OBrG6uqPHjc283ogbPYYDLThgiukdeyH1mWNoQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPr7AMasgCiJvDPCCRFF1JzItmHbGb1W9RbA1cshW_qQ&oe=6ABBB14F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaLgWB47uq4Q7kNvwGSOmzW&_nc_oc=AdplDo32bYb0T8wjPtOe7xVwMl4iiGBDKNLtrvmuceLyhTd-BI94sRNNyPSptFv8OgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqUGeHpsGB7dt2owadNVDIlabus_mzmOECinr11IvOQw&oe=6ABBAD01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDaWenWiXTcQ7kNvwGHQThC&_
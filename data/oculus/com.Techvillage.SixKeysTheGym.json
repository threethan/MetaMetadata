?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmD9d3cZe7cQ7kNvwEHTvR7&_nc_oc=Adp0raibt-2cL6qY2cPt8cN8li9JFIX0tKcfcPdZ1PloyUw44bsSXYuc62XH9ihe7R4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gxKWrbms6vLsJbcihEprjjE-4MYR4dx9dLk3SJYysFw&oe=69F7508D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vx2vCfw6RwQ7kNvwGGakTe&_nc_oc=AdpWKtoeu0-f_epL3IfI7O0hhuEpaW62i2cLrSXVeD1vJs8hvvDxZbnLkkw4w4rhcdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yQ0xXLsOpXOv1NpQrtjpe8dgBPlH1_UPym2eF8kMXAw&oe=69F76183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxyCrotfm-oQ7kNvwEpNgDV&_nc_oc=AdqEgsJgycyvD_aNItvtA24JaxMo--96QJ82C-CSQ9VEJ2J4BTfc7vHiivJpa7OAjRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hIm1Tzr5G7-NLkfMsGOauXnjBeaipiMs06uLHdOT7cw&oe=69F75F3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN7c7Rh18V8Q7kNvwES-VNc&_nc_oc=AdovxhmdgkEqMIhut_WckyAYNvPG_FvV8pMri8sAcFO7xJipfB_oBZYoX3jErlX86tI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2IblupzzbBnGB862z8aplaBQzK6EsT0_cEGI-5G5vwMA&oe=69F741CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tElGZD8TIg8Q7kNvwGoXA5K&_nc_oc=AdpBAa9nG3AOkjtwf8tWFMfqyZk95nx6_dZtRtwSaUWFKk7wRh3nGg-_Y-5s-yH09ug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Vh4KkSSLAobV3xuoAkl46XwO0QjQonxaYQac1M8Wkgw&oe=69F73D81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrhAvJwTlJ4Q7kNvwEKnqCv&_
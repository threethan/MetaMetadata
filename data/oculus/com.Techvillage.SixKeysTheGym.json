?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqjU-BlFeH0Q7kNvwFErZcq&_nc_oc=AdqPyhO9jT5ml1Ik8bIR2g4QXbbjJaYNhuexYAGQaZ1unatPENBHSLwW6Q-j7kG98Zg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxlEkhnNnAtT10RUngb8TLCeyFiUusOQRhbX7HGbQ2oQ&oe=6A99790D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ik83pvdb5QQ7kNvwG2pi_O&_nc_oc=Ado3OWo9UGby85LRMHosTczk_lmPI_gTdec308AO8ZtNzGuzTDU2u8p6lPbDqP2VsPI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJphHwitvaR5IC6l7-1tsFnrmAw-7GS2VJy_27a9Gscng&oe=6A998A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W_j55MwgGAQ7kNvwGgPiDG&_nc_oc=AdqnAgFiSyj-evDUn-TMecZKQ2PjUZeiA7lmVBxZhGL5XARGepnULi_YISEImjm0Wls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGARlXup6WdxkvzFDFafY-1vTd5MAd0ozc1Dj14YRrDw&oe=6A9987BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRGOarW8_eUQ7kNvwEcdDT5&_nc_oc=AdrpeE79eL2-ELU10ZyV0rkyVQA3tbYSOTCszHFZf9PiKRI_xSvaYy6oRLt9Rz2sDbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIczEktY6bEdpzjFEH-AgTdOraj_N1vsd1eccPQmxS1Cg&oe=6A99A28F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7zVpqGLNbgQ7kNvwGD0IPa&_nc_oc=AdofjyIiyv4mL0NCsPuA9wjex6ybbrKSvz2gVP_lvm1jIO_S0-NTNPXYCAH0gHf53k4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx6n32aYdCr5joYmCYgjwMDGznqUAzWACLJZ72x8kQWA&oe=6A999E41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNkT458TbewQ7kNvwGEBOGT&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpM1X-UPmxcQ7kNvwHSwMW_&_nc_oc=Adqyc6pDuI8oHTOklPfhS4--53zeDXRJVZwY18kZ2d6exNQtAWv6vle9cwwsta6x-R4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXRx62dsNvFiCK4fM2beqJrdQURR105Ku2hkFFvHAncw&oe=6AD2298D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2Lg75iJ3MsQ7kNvwFErPsM&_nc_oc=AdqNHAOxWqpivdA6lWp77g8kw8UIltEXzCJvlc1lv-c6pQ0YxROqlzEqCHrtk8tSPfU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhgtkqevyLb_bwZD6ziY8r0fgdNeApa4_g0ETSZO_cTw&oe=6AD23A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-RnKODYFOUQ7kNvwGZ4t-k&_nc_oc=Adptz_kxAN-kSszTZvyZEwJhBlu2DHqzBIaEmGJoEw-ClSBbWHUxbveaN3VPjvbeSZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8oT6HM032h39Lgyxg0bChXy5Uztbzf4cO1aLUS1iDqQ&oe=6AD2383D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yto20If_WCAQ7kNvwEmKT9y&_nc_oc=AdrXE--zGzNDsiUozjfRnTx1ZYd6-Oy7oiuXq1T9M0BK-j9-YTC4GSkoqbPEXalZO0g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjU4DvXwhqd4qLTuRtX7jRJRcx_qSaWdW9FYDIae4frQ&oe=6AD2530F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3600NqvluIIQ7kNvwF3InTk&_nc_oc=Ado6VZxJvn9ESsn2IgJzjXAxjoPEdQ4eD1NEKsTeGpSthz0nNF8Yh9wxcEY2NyetXf0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbu8Vy3JgbtQnsQYQXR5tFy3aPhNqZRd7FHgdPuzV1iA&oe=6AD24EC1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGHb-T8o9b4Q7kNvwE9v85A&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqKq-U6qsTAQ7kNvwHc8-7S&_nc_oc=AdrRGZFfaTey9GxExlsSOvZE18YQlJDZTCi1qLl-wU6RmVRrH4013X1U341IKLUf97w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyscyH8ymEO6cfhpD5ON2t7dE90v5tyum4WzOfGWllZQ&oe=6AB2858D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylruCKeEd0QQ7kNvwGLdQmX&_nc_oc=AdrbEihq5vjOXtgWyDyAWhhYE434TJpXv4GLeovfcXocIN7CIXLR6vU_QQn7okXS6vI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRX5QmgRLjf2cR_2C5oiEojE_erP2rrmUiw2aJ9TYizw&oe=6AB29683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9QkYsg8iKQQ7kNvwHsTrq2&_nc_oc=Adrw5PTR04gXAaWCK02PLvAaLd4LqwJ5uuLEj_6NPF3q3jIJLPPC20_qryDjoGWoQTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm2ppyI77G4QmfMJGMbRo3ExzbvZVrMh7HdqvB5e27Fw&oe=6AB2943D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kHd17gqltoQ7kNvwEp6kcM&_nc_oc=AdpGEg_2D7uIlnkekfY1-ywhZIkedZL4RMMzUft1A5MuIsncnOoB4T207c-5loBe3kE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3x8ho6ok1RuRkpL606tUc2uw7qUFU7WifKng0cnbX3w&oe=6AB276CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2JL4xHUQGUQ7kNvwEfELHp&_nc_oc=Adpr1meKXPH2ZAeGYEopWwfj88w1Ka-Dm3F4p-CYqYsgPJfSC-TcUL7hrZViuuwrcBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjxYw9N8Cw-FZ49G3XOLH7vR3KcxW7SXk60O1XS-ztcg&oe=6AB27281"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYri1WDkGXcQ7kNvwF66jK3&_
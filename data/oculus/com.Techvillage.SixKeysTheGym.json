?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADhyV5SqKTgQ7kNvwHWuV8V&_nc_oc=AdpxLx8FxDVQfnienfuCzBfNRK7LxZTaLEArveQacTa-tYnLDZw6o4wqszjFfQBuNaw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12ggRf_1z1RUU-APfeNyzDhPI6ma_Mau9mgUTrhN-2nA&oe=69D7AC8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi5a7bqZc3QQ7kNvwGN-9c1&_nc_oc=AdqzDFuEgbDut_0lCnT1YpTJovbrjL9IvKCa09OQnDdqvivMx5XQGO8j0lLqWty3YhU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af387seWhbbEmprWdOKbQDeqBILiCLRtg9cF_QCNcW3GMA&oe=69D7BD83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD1lAhBZSsAQ7kNvwHrFhYL&_nc_oc=Adr5C3qfhPQceugNDdBQSe2mdxrqd9dNO63_S6IoD8XF2HHqdecn4MHqO9NXetwVsKE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FRU30gdfY4mWm-unUsArY2SV2tMCC9rUocm0mcdGS0Q&oe=69D7BB3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0EFP2ELJWAQ7kNvwE9JJIJ&_nc_oc=AdqfN8VkHQeAo08S5nWcdO25oj1z5LM4IF9YLXlB-Rl0xwLGq918apu3oMAa0SsFdkI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21WRygFwcOvVCjdumW8dYRVzkfEXICfZavgA4gtf-aqw&oe=69D79DCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HlV4PoAXPAQ7kNvwFW17I6&_nc_oc=AdotiKAHQ-r1YJkZYL5i9doH-S9hqW2AsQrllQh-SWFzHP_o8MNfvErI9jFHNJTeKRY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v-HRNhL4mTTz2pn9dXQvW7b3tMmMn1Pk_MZSuXA0Dmw&oe=69D79981"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApWEoq4oOg4Q7kNvwE9WWkS&_
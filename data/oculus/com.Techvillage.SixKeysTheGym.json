?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MmVQTIlP5UQ7kNvwGDafGU&_nc_oc=Adr7kYsXOAza1VPQBkuZ-yU8wYcPXojQ-NE7CyRIFtIpm9Pdb4-GeE6wKk2qomrbsjs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfLYlQuD_oHWEeT9DF3N5jXX6g5fu0oLrH8TY8_oyg8A&oe=6AEDD90D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR6P8vgJfGQQ7kNvwGbFhrP&_nc_oc=Ado-cz-xL5TvYCuLxOFqCTTHPmsduHHt874bPf0qjxCcUwrpszkrlj8EXBWP8lOEzVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy-HGnUBd7l2RNKRenfBsq0qZAk95j07wYuh-5_wdtHw&oe=6AEDEA03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHFL7qBDVtYQ7kNvwHKf85S&_nc_oc=AdrtiojKQQpOX3xdH2WE9YuL83vA44pYDHbhqOlZ9u4EEdZDJI5QrRkJA6VZZdjpUBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx6Q-Ni68f_RMwYeCwUUvfRHnZmKpv4F2TgqmZmaP7TA&oe=6AEDE7BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw30dLo4SNMQ7kNvwEsfVPW&_nc_oc=AdoF5l3jA6l-y08lTeEO8o26hwMBec2hhEUy50mwlIndjijcStEWdrpREBfxfzuWclw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSgh4mEPQhmJDaIIHiQ_q77l1D0CMUuJu26nw9HNkmmg&oe=6AEE028F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o-Qt1t9rm4Q7kNvwFsrI6_&_nc_oc=AdrYywxvnOO9cc0rf8v3m8N2eOA9w-VGXiedXHjTpyo198Ct2uccUTW2XAwzmaKXnLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAPuzsDpaJNjrW5xB_aR2glxnQZcCYWeluKsTy7QIILg&oe=6AEDFE41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbVmuYQlgTsQ7kNvwEEjFWm&_
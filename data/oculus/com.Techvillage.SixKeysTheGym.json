?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3WnIT3Jfs8Q7kNvwEQdVTg&_nc_oc=Adph6lEvuTdaOXRgzws-A5iZoHBXXFPF_RJVr_B-uECRIOd-XmFlICd_des1ppiyOQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z-kCJls6ws2NnLo9PH4iOxrmtnMHu5AyR0VbvHh1v9w&oe=6A14518D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AklbwoSDO48Q7kNvwHzGu_K&_nc_oc=AdqWvU5REHYFhtzpMc502LNwd8qfph60qUpcH-wsHXb7hzOBqx0AvXkCn6AsLETFP1k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42pN6H09tiQxdVY3ggzuyE54CStemEtcwG1fHcSb9BCg&oe=6A146283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmmHccfyO8UQ7kNvwEi1ccr&_nc_oc=AdplpBxO6rCLEoGMAum0g0FuxrWzT8LL-imSFNglgic1TGbyoliBxq3dD0vvwfwdmi8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bnhvR2_xjegodsS4ALqaw65_JmrY_DipuJpdGmx-3ZQ&oe=6A14603D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oxvk2ZwcMg0Q7kNvwEU5Ktc&_nc_oc=AdocGqli1qXjCOU-CviiGXmCla_f7pdsCtRGeygv_xzA-A-NATqespm_hcBpdP37ToY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eylW0dRvqirwg08sfrNFWf2Hib7dPPSL_JfNNFfXPSA&oe=6A1442CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NN1zXoepLI8Q7kNvwEJWJv1&_nc_oc=AdpNw5flSrH2lpBI_uKD-dEZzHI5zBxLk6zRUj-4NyqFoKtZwJmkyxEBmfEv89O-nwg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fii9PpYpxIj0j60hpqCepSI7ZlwKU68ciMgQzuCiADw&oe=6A143E81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwzxPci_L3cQ7kNvwEnOH27&_
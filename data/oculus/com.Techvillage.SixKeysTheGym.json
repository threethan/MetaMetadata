?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYId2B7bfC0Q7kNvwFFCXCX&_nc_oc=Adqxk_a48wiO4IBM25wKn-WvkJpGPt6nHKIuNaUqBd8SYsS2HdgHzfME02U_1ByFTM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZmDX4SACB-IHKiPet6hRyMOqq30gk26xADPwC9kFFLA&oe=6A5E258D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJITVcYzxgEQ7kNvwEHdMPS&_nc_oc=AdrpcZkSithLvKp9MKJSbKYDIZvHGTk15mCbUO2I1JDgjVv6a8bVG9NTn9sZx2VUTa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEcYCqQh_bxrsjB1VkhH1EqmYLArcJUKIniw1q_CGY1w&oe=6A5E3683"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYMc0egU9EgQ7kNvwEfYsa5&_nc_oc=Ado0zaTaWkyakoWITWmGhRFzK0h58iYHrauju4YquL-DJ1YyUWW1KY-eamHJAK4BWTQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2zkW6Nn9_noRk7aLbuz_LLdUjPfhc05lTBjmn2GPHMQ&oe=6A5E343D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tjdyLIHJz0Q7kNvwH2kHWc&_nc_oc=AdpVOU2c7gG9m8C5UNULi6bat0BKVmBPW9hmAiiGF0Q6vWuQiqj1xjUmWZqklHDGL1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWzqiSZer7YflDK8i0Bp5a3o6HmGcUHwNXM2wXXx4LNg&oe=6A5E16CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5PcqgONG-EQ7kNvwHmsIn2&_nc_oc=AdqJktltGYMJDz0BlmPtERoadRxennI56BFlEZUS__IpevWKaA3xqfS8QQmZSYGwI7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkJGjbHAXdsyZjHWzcOkuOIzdJ3wEgX_bG2M_eFhjEMg&oe=6A5E1281"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcEfdWg-JMQQ7kNvwGM14qs&_
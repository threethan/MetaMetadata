?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l90drNo2UwYQ7kNvwFWqBHc&_nc_oc=Adpu_4wo_ewnW22mojI4g8NqcAyWJZwqXhDvz-P7qAWIWqyD-c8DVObxYjIFsz2t42o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYsH9KdIXyEicprLRR93fUMLboUovGnGaPnc1TxAOc6Q&oe=6A95BCCD"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4o82bm5R-UQ7kNvwFxUmJE&_nc_oc=AdowNTBWg8xCUOMMqfAsrWGjXNNmlh19BNUqSJeGn5oA9EK54eVgN028hfcApqR8qls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF40DYqaTxLOjF8nAgT6ZH62LnInv4ZEqiUuQslHqGwug&oe=6A95CDC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W_j55MwgGAQ7kNvwHy5zYZ&_nc_oc=Adopet2RpoeCAjmB2vfwR1p3C1NT4UBWU4SS7aLlriftCHCRvWV3Sd6zcSmivACsBek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEweildGSEn88l8sKgZMYvJEZBzaBrJi4ZsP0X-s-ZKZw&oe=6A95CB7D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTdNsi_4ze0Q7kNvwF5yj_i&_nc_oc=Adq_EG85eP91h-QmMacM1LVHOr-OgtKpVNm5t-nMQCeWKx-d6GwKGPC0_E4jro-z6qQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMollEis9l21TRsSA5HmPzi-Uih6lgjkV050W0OBsSaw&oe=6A95AE0F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgyjzPiludkQ7kNvwH0TyfG&_nc_oc=Adp-S-_pyoxOaD-H5UsRezevGWSdn5zdBeDRjAj4gRtTC4tw_I3LPcsh1XA0YtiyVKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6hWZJ-QQ00SeEeCT0Bc7qf781uKGljNV5f5xANGV64g&oe=6A95E201"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy8QafwPs2IQ7kNvwHGY6uL&_
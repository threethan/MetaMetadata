?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7KN1rfvfFEQ7kNvwHwruDM&_nc_oc=Adpzr4nACh2xIn5Nr55nNzWuvIF5cZjM_NZtEE7ocbe-gK_zvoHEgs5BEouYXU-pdaw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZpFSTmmDh4N84RPpSBcw3ThZyL2GRwo8lFgH0XvYadQ&oe=6A660E8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERUSM-4qtdAQ7kNvwHRNQY0&_nc_oc=AdrbkpzaSjlLjGYp_21r8YWYaDiwpPtmwgpC8cJ5S-4ayqBpFMNtm_NYdnSp4fv_UQA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpfaJYLf0cGDxJEekf1zm62oidx3Vbn6SdzC7Ny2yuZg&oe=6A661F83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3E6_AW-Zd8Q7kNvwGF2jm8&_nc_oc=Adp0PY0LCNmtWxcaRSeoy8PR8wuvt2ZM_aK5QXjyY22EEtQb3XF1ri062Gtm9fEv9GM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi3DMbiW1VoyY08vb6q7zEIMx0Eyuixgg9eOMJyb0qPg&oe=6A661D3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKAdxD1xOJwQ7kNvwHVVitr&_nc_oc=AdqOxY9h4M5GCeODC3CixjqQiI3eshYayd-aFlh7cNmFZUDnLTByejq_SMCZNktgfnw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8suQUsapd8qFWE4guKmyOVREMv6X6YCvL4VxPUbmVjQ&oe=6A65FFCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqE8ax4s89oQ7kNvwGbcmXT&_nc_oc=AdoDLC482Zjm3j8hSyViqRVWaqE-b3S1EwWChASJgeh8OuNBDV3LXfUWJt5s0EFmLXU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmQQIrTw0a1IyuCTU1HZ1sYKnYQTTAa7QgZpeEKQnXBQ&oe=6A65FB81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQyFwOWhgeoQ7kNvwFw1RUr&_
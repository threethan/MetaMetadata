.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8FfhIWk-hIQ7kNvwHGYND3&_nc_oc=AdqgL8b4L4AqisZsZ1T17m4ylIpi2E31BCn4Gw_HWyiANGKUmW7TnED_aRwiiZErZj0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpKUpPSzqhYQA5g6njVT8Wlk02odJBSgJUv-4ASPfr3w&oe=6AAE910D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrAGIusU1UQQ7kNvwHWT19w&_nc_oc=AdrGTs69y3pB_SdKENL9PQwTruj-sh3ncC1GHDTrlQrYMV5fmX3JFy8U22X1f3qEtRs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdkxYYIKDaLJXmKL0TtISxTngQJeeyTngKCR_Sneiszw&oe=6AAEA203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt6j6za8wSAQ7kNvwEqGf-K&_nc_oc=AdrKlH_W1rNq43uWK7TMNi-mxBqOCAhjeUtwhq1JVbvImn4NJVeXwPC9_E-QbVfJt1w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU1PAkFINDpIDVqsCpERbHwPIJM1tjNH9zJnutwhBUUg&oe=6AAE9FBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adLGdMACEe0Q7kNvwGVq7NC&_nc_oc=AdrmSskfEvd8SqU2xeGYbsu0DwjjrphGzyNQWW7SRHHLnfX1_DVhavF1WLYYymT8YBg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWU05gc4XdIPiQpanz-nJEtCV8qPUzkJvToyWoCl5I9g&oe=6AAE824F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRj0CsOOylsQ7kNvwFkX-DW&_nc_oc=Adoiz7mcWR6iqlXuQEZEQg_nYeqqexGjPNH7DgJcwMshcygSiCslLsTYvREf99tB-W0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKNH8slOMLvHSXw3VJPIWsm7oA8btesscEIEpbk-uKFQ&oe=6AAE7E01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhAhPCam6CQQ7kN
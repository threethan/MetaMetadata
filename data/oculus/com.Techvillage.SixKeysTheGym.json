?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTaHjqiU6akQ7kNvwHL5DOy&_nc_oc=AdqGoqto-8OO75P1GOGpFEKcJq4eaBHwWJ5hqFfhcG7eRcOxTRfdPA5FDWnuq8odZU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItgGUuKRcf_fq_zVPWMnOZZhfcyiEeQSVQEiW2vRj9lQ&oe=6AA7F98D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nPkssUDYXQQ7kNvwE4LAOd&_nc_oc=AdpAIpyl3qBbvHXslSVtJgiyBTjunDCA7vABMGDk9x4ZKpUqi7Ba599v-mr8XF5_r9Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpejz1qegg8akpqY80NT48V9wXKfjLlMLHGRM9UTTFZA&oe=6AA80A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxBHws3i-30Q7kNvwEr1Z3n&_nc_oc=Ado_gcITmfH0tB6RrUYAXFulUsGEEN0LoII61s2e504lqcDj93USWC6OyH3eXN1X0WY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsKD_2xVD4i4_xGZS_odIRhF_d8pgt1Y7X6YItIIjuXw&oe=6AA8083D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8_yi0pXS0gQ7kNvwENfxx1&_nc_oc=AdoCIWg4lu2CszJjygz7X7ggZQK69QZsxk6k55Z6_WU3Ke0Mrx4-9XGD5T9gZqVpNa8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhDS4HmkysTRSJfquakP9s-r0iYL5HkpaL4nvJxoBy-Q&oe=6AA7EACF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylAwyeLMGYIQ7kNvwFaKm2Y&_nc_oc=AdpCjE8mm6sriqlEuJKUYv9e2N_xKqC78B_foH__yV6uLXDuHFBhDhSC5eo1FZxbgWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPlP2zmnFJIbRzLrHuDCVaJSsrS12sL6lQVbu6SJfU_w&oe=6AA7E681"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9F4BTyGFCUwQ7kNvwFoodfl&_
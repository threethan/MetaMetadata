?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzoENkPf4KwQ7kNvwF60VwQ&_nc_oc=AdqNBpUvvdU2BwzAkzAH6u2flx3dnIb3HPsh2z1VJl_rHTl6of8ahKOuH4J1vLn53jc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhmKafTO5iPJ-WbEseR5uUS5BmC0KziZX7ByaKlmIMvw&oe=6A58DF8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNXP9KPiFHEQ7kNvwFjPg9X&_nc_oc=Adq83mcPuD1Epw9_N042uN9k16uThYsbAWE2nvIMJm6710jqba__lIgfWCvmdc0CqOs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChPycBhZNtkARlogU3u-GlUNOddu2gH690NCUz8cTC1w&oe=6A58F083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgvzQA-IkZcQ7kNvwGcCeGD&_nc_oc=AdrMrZZ4MXJuT3vcoL-HkG0ZX4LykNBoueI_ocp4lWwjqhzI4z03HfnC_auR0gxIZ_s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnW_pj09TeUtwGfsCf7gznZwigPIM6uZJ9rCnbC-MKlQ&oe=6A58EE3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vlB9SyFqwoQ7kNvwFhj2qa&_nc_oc=AdoRTR71rp4gV7a6wFQTxx7tTnGnzCxzeXF9bC54kbUWOMJyfxoixUctpmh53x_y3Pk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfhekNsaqc8UG5JCQAVCLz4ov45EBw-b2CZoJsQ_HSxw&oe=6A58D0CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7wbpE8nyjIQ7kNvwE9Zo6H&_nc_oc=Adr95DiZOFSSqNX4iTs6-GOWe83pDLXgwI0dwjtsXoJspTbxcyHCdLX-Jmzkzugl6mY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXeB6myenuoyrVm6uGxAsxsM1zl4htdTACpXf026Jidw&oe=6A58CC81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-TV28sOyrUQ7kNvwE-u1UQ&_
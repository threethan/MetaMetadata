?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkn5frcLVd0Q7kNvwGyzmNp&_nc_oc=Adr41VeCoQKLNogMY1srmVLFX_AHo1q2T4rv0qEidCErbHqye-YZZu_tMx1M9NwmKwE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OaD87fvILwivexByNqILlef1AG1VyLLESPGQEpRwFiw&oe=6A21808D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AzPKI246ZkQ7kNvwHr_-nN&_nc_oc=AdppgTyoYwkJLSjg6qfK--gfLFUPx6KuUssANYbpJ-U6oyLlr8_ISrWSNWXx2JZZNzw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LzAD1Aks4GtWXD4c_CCda2jzGxjyaI7X_0oyqW2zSQA&oe=6A219183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFY7_LSsFZIQ7kNvwFae965&_nc_oc=AdqGi5RsNPAnqFGkQAJgNomZGNedn0gMezRtOMarF8mAq7aa0EZreMA7J8KxXeIvFW4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EfqIvtjDVnUY67MIA_wD-dgvD4HYdM6KIfCt4DVRpyg&oe=6A218F3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X012_n_CO54Q7kNvwGf55lm&_nc_oc=AdqCYyXtiiKkjjJyDuJ70jYyCi1kWF8k1bMnIhvZMNK7iyo1xdockZIRytYH6AZwvQk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85fCw_c03-9YR_bu8ber6x7DhS3geI_mmR8SIpesvJEA&oe=6A2171CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRDfohOYhAcQ7kNvwGdVNPn&_nc_oc=AdoFyjlUOaajFtplA5qJXNHywHHAQSLp_Po699xzk84qoVEDfcg-mRddh2UeLB2eEBA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dlhPtLWkqc3woF1ngZL2zj8l2A9qcqI87yBGS-Vbrqg&oe=6A21A5C1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHenVxSZ_iwQ7kNvwHu2ISd&_
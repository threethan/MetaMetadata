.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkn5frcLVd0Q7kNvwHMu0FU&_nc_oc=Ado1LjocCneSVQov_LNK3WgnB2WFxfgeAhCU8W5rjBTfs-Smx1qAym2DLnonitJbf6U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KO44dYLc5Aeo9-xGSYdBURWUNMAyDmB9lPIk0-6V54w&oe=6A22D20D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MFx3zc5_PcQ7kNvwHZo4zn&_nc_oc=AdqFvEK5ImNN079Jx3kOsGWb_hd6r4MbmZ-VoCkHTnhBd8-cmaSGBCgndzwVYP09fpg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vhJsMzhxjyCqsEo-5ZqJcx1qYd49OBDBCzA1TuQHozg&oe=6A22E303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFY7_LSsFZIQ7kNvwGYrkLE&_nc_oc=AdpkSfIVNg3NX339lTI-u5FpDHiivDnzosAhCaeFv_Wmym0vEKRGRE2DeiMg2oL0_lE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af897QORU22E242Rp6p3uZQSlloIY3xVEYWEElCL5XSX6w&oe=6A22E0BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X012_n_CO54Q7kNvwGrO2Lb&_nc_oc=Adqd9VM7jcEjNrcZkhSyjxfihD8x8xO4bbu8emrfGnccA1v5DFFX_wlEYOwXjTL--JA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hxe7rN84PRZYH3TH27j0HSvhEc6DbMGl_yAl-1PczRg&oe=6A22FB8F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRDfohOYhAcQ7kNvwE1ggaT&_nc_oc=AdpErVfWvRhfXeCU814XwqvSZrMf6t106as4c-d9oURTuPvTmTZVjrY6hzDvyJ0KBgs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-mr25p_YiuDs4RliIZgMW7OX_bVDiwCF2LaLthxp4Sg&oe=6A22F741"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EKWS9HG0RgQ7kN
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRIduwJUw70Q7kNvwFWm09k&_nc_oc=Adqtokn28a1SjQcmODayecTGjAbpvqOud7fDhw2eayMuy7CJApLvap9xoV1uty4Pz8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTry0rjS_XHDNY4fart8MSCHLkpsnXYtLgKYawL4OeeaA&oe=6AE7418D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hg9WlD7gjhwQ7kNvwFj1dvN&_nc_oc=Ado_oLeVpc_yhGWhPQuYvg4cP6ppofROIkk6952_-4UVsUJm7Qb8Ib1WDDOInLG8QkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlon9JSX4gbbuT984GNcCiHJeqh30Tykleb5o8LN48Pg&oe=6AE75283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNitje99gy8Q7kNvwGQJrnU&_nc_oc=AdqQnrrFR54DXMbToIifcGRtSb06XdUeeQn3Udph_QwtSjF5Dqn7CpP_-95aH-9kVOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvP2JmowIcNfsYtDw91Qxap0El2DQjsdHEEUl2IluwUw&oe=6AE7503D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pztp6i8OOngQ7kNvwFZijSP&_nc_oc=AdqM0Zytd19ZXSVoZVu7UPSsNC3tq1Y9l1JjFKUgqupXEzc0baVBUUKz_WjAojIrZ8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOvItDFjva0h7Asr2ruPqFMmjQkd4q_mKpGlCo_UbqvQ&oe=6AE76B0F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVrlZw5A-24Q7kNvwEa4G0i&_nc_oc=Adp1ueaW31QcJK7yvKMAk3qppG2bmay_MKAuAxapPGziuu1Y-vovUHRHHHrE7KBto6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1cx5BZw8_cIGG-wLp7NJoYlZK2ME6zfIPKqa2EweD3A&oe=6AE766C1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZfhkhoPDPAQ7kNvwGJERwh&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTaHjqiU6akQ7kNvwEBvWSa&_nc_oc=Adqyhk5WqYafrm2RwhwjWaaofX6Wsfm0-_xLa6YSrHGrSWwodnQMykdJg8TuOsE-h2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwFkSKsU2yFyMct2fRcs8F4DafA3Ye0Q9B7uwG-zLU9w&oe=6AAA9C8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp5oI74A-9kQ7kNvwGvnRX7&_nc_oc=AdqfrW7cDqofuiFV7b_zQ5lw84167ndoq4dPMOFQddas0feHSvaJWM85rnPJGFg4Vn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-ptcgIiit5IDCyaSFQjWQlR5HZreEJhs7rAMBGGfPgw&oe=6AAAAD83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=614DKmcugdEQ7kNvwGQUlgh&_nc_oc=Ado1mVdWxB7r4vhpbGiIxpbwi_iLQxbD4JMnE8vApAL7wsVH0kXn9BoR2ciDMNvKNZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdDGivqQBfjzYzZWXBkFmku65cNSG4UfhINE_BGc0BfQ&oe=6AAAAB3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj-dU6eOMzoQ7kNvwHP4Wkm&_nc_oc=AdobulYAOE4rduU5To21XnQjz8vbO6yIsjeSo0y0dR0bIiOP9tZORrnlKOg8duS04-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjBO70KKUk8vbivVzpjbvzwd_6enKYDgoewREQjyAmSQ&oe=6AAA8DCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHi_-0SbGBwQ7kNvwEWqGIX&_nc_oc=AdqUQtE-Ncaoj-OsDipfHRscpOXdS4_2dHQcMop7fNif6q0BM0ushLIdl4S9mlj6b_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRMqjPw9aoX9KJnrZhcUEKQEnaKbOK_OxoeGiSl4nIlw&oe=6AAA8981"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USk6qb47JTgQ7kNvwHFm0I9&_
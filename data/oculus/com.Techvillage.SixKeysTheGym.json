?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLDE_ARqkmgQ7kNvwEGHcvk&_nc_oc=AdpwZSCOkUXwYuffISWjMPFuM6cEeCD4CdizY_pKX3keDO6sRTFTk4cjPYGNKCaHtuU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuK-zD1iTuxi4aNUY8-LjNc05n5PmX4wSoqixCdPD2nw&oe=6A78838D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1QZlpp9jYMQ7kNvwHHvNxb&_nc_oc=AdqjuUUCWiFHjmitY29FFI-H41f2qT_1Eb-jXrx7xZHYWNLK-dFpuQw-c69AB-ubTiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbGgV9I3wKsJeUEHpGXQKc_hAAQI9G4rIjqCuxjgSjig&oe=6A789483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL8_xkuWLZgQ7kNvwGa1fcs&_nc_oc=AdrK7YPqZrNDlwZRRD_NMR8B5dA_X5XwN6jHSwWethX9JBVLVecB_44cSzmuGCfwfX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1HLY4YDnCDnJwshOff8Ph3bgqC9BI7nq3u2jwE6Sigg&oe=6A78923D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE75Djq7LwgQ7kNvwFw9Stm&_nc_oc=AdocIAT6suKJOPWNv9LmCe8KrD2BC0ewl7P_4CBxLR35_BMyLPVrYhM0U6q9307EAWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnRFDDvOD16xu9Jicazi-DJjMIicqMTE0uBaBAfFFFsw&oe=6A7874CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wykmqGJq-u0Q7kNvwG73ZR7&_nc_oc=AdrnrNWpPklzmoFja_GoC_olWii6parNXRjwEWoKR16CW87p-Aqh9vmRzwnYpJrUFMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkn7l6jNQYaZpDz3EViNWJB1K3ZipfqmpclAEnGH3HqA&oe=6A787081"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-mr6iRtyosQ7kNvwFD6Lcp&_
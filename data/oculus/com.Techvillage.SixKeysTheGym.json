?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHsj2oUgaakQ7kNvwEe7rvZ&_nc_oc=AdqCUNZ2ZqgFPxamNk8ga8dyJOcoUQGgW22yCr1PIm5A0NKFdvc6dT1MXO89JDCrHtw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sCmLEwxcVthsO7TsDdKghh10AlFKO4M9rgju3qDsXCw&oe=69D5098D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi5a7bqZc3QQ7kNvwG0O2c_&_nc_oc=AdrPUd6JN_vNmbTzn5PAMWbso3zBpMmwBwiQFE_bE5o8gsD6R-Ti4ZLwuyNH5cFl8cU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28eNL3xhfXfcqxi-uzFp-7CFh47vl34NyP1comwoRW6w&oe=69D51A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD1lAhBZSsAQ7kNvwGFBelw&_nc_oc=Ado3735DRLUxInMlSQ4kELK0ycgIM1ikOzAPvb7J__KeKvAY88wIaP7cWwb2Upaw_RU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WGaNXdqegXCcNB85aJ9v2jU1YyF7gbjPj5D7mJK9Pwg&oe=69D5183D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJy1ixq3wyIQ7kNvwEhxzRR&_nc_oc=Adp53vVyJraTBSSgXco4Z7-6HAcToy31gT5WGZ_K4KkZTiZB_sYwdgkxeb9oGU5L9H0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3abGj6DamFFxZTdCA4rcQVthxaEjgOZ2r4kmSALYTAgQ&oe=69D4FACF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HlV4PoAXPAQ7kNvwEJhKB_&_nc_oc=AdozAkoYrffLxx_QR6llIAKyMwsuzwDTGtBzGeHeBovtdZ2N5OIE2lIesgNnrIBuJks&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zSai-t2lhh5pqLzb7eZyFt3pNR5_W116AEJrOgZtkdg&oe=69D4F681"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fozhda70e0wQ7kNvwGOHSfg&_
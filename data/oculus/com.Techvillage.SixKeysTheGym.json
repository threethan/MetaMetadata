?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpM1X-UPmxcQ7kNvwH-68C2&_nc_oc=AdpAi59A2lkIdKUDPaKHt2K92Flm_ab7SqWSSKdl4VYxc4Wx2BUGEB_UDe4Fbfj6BnU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb9fVG-XIs-nd8emN3_5ih4FFg1qqYtOlT6F4QAjnaPw&oe=6ACF868D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdT9aVJO7oMQ7kNvwGPgDdu&_nc_oc=AdrUkFM7DqA3TpCOGSoLWhew1NGcsbMM0oOzHfnKNMvr890RwvTZ9CyLTksYotxRSR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgY-Mwtt2ordj134MLT0ubxYSWkkgXmUEav09DExr6QA&oe=6ACF9783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cXxSlFX2QUQ7kNvwEs4tsA&_nc_oc=AdodJri-mV5IRNPasbTXfoa9G7wpQLN1CiJ0sNMAk7e3g5QakAQii5p_t2VuxMqgBp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSaO6E8Iybq4BzVcAvhVY1qj57NkhdOnNDdqLtYMjZRg&oe=6ACF953D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRvGllRk3GUQ7kNvwGLxkpl&_nc_oc=AdrtMsVl7bpUKmQgS4frFh8wdRNqLEhUBgEpJaUo6OJBLjnRtgx2a3z1Gh5tThDwq5w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtpIhZpgt5814R23Ucq_sHcVqoZDoYGKvtjLgmRol22Q&oe=6ACFB00F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD0xRMYeDWEQ7kNvwEADcbj&_nc_oc=AdpuVYK5YDN9dte34pSBcJDuOzyNjH4VD9EcXjO2gSjxMIsk_yf6wTZQatGopTemM-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfAh461DnmLc-Xe5JOBGLCP6HMiCQZqiID4d0de82TWw&oe=6ACFABC1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rMdSkhhq1YQ7kNvwHYnL7G&_
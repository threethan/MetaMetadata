?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V67gjsBnAKIQ7kNvwHfmPL0&_nc_oc=Adr-zJI-eur6tn8fjnwv3GjB1CGFTtvAWRrFetLmGqaPImMz04FXvwXIM-4SyJYa_aI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAH7XHqv-C2oTOhdJvgtLm_f7DeWwTkR5zTk0FHHM_4Q&oe=6AEF62CD"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR6P8vgJfGQQ7kNvwGwNMYp&_nc_oc=Adp5Z6HsTdDdAQzcV9g_99yGzNCKruqbBmJ3KHBr9ZUBdHqBz55OepjG0uD1Q5yf2kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzYLLT5Qwp84GuC2DZzi1LiAcuwk5S8I9wYu_ejo93sQ&oe=6AEF3B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHFL7qBDVtYQ7kNvwFcxEbE&_nc_oc=AdrBli89exVQlY3zhXYBPpW-gBZOaahrvFok5pFzpfO7JgmQUE3rfpnCz-xYlFDdPuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Mcu2Mt11GOt5F99F7vyRjxZ6muaiY7X3N5PS5vvZrw&oe=6AEF393D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw30dLo4SNMQ7kNvwH5AEp_&_nc_oc=Adq50FrcdY3k8m-datgOABlVFnl2XxZ2L0ZAtWp0iKzlvELFW-JacC6jaXLFYld_8UA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjRLTdlV3ddTRRMWBqOcW9FgapvjpBrE8_rq3arsi8zA&oe=6AEF540F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o-Qt1t9rm4Q7kNvwHTzxoV&_nc_oc=AdrF8LA9PmmiSCj1CFUpjIeBqU8RNhvwtOkH4SEWRMl1599eGX-yUGewrz_eSAKjCbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3MDBZrWhtLprbIOPIQlH4Z_C5mPlJC15K3FvfPPTjDw&oe=6AEF4FC1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbVmuYQlgTsQ7kNvwFqv4aB&_
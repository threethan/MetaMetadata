?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUjB4MGjoIYQ7kNvwGZI0Tt&_nc_oc=Ado7jpFEjQiYlGY-2TAzFYE9v3zqrO0J4aA3YxiDzEnYfQvoJfoSVfvGxCFlZS03lBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsIw-xDnxBJUxn9C6MFoN4aihev-Jwz1Q5cD3Pzp27zg&oe=6A709A8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddVsQUJAYkMQ7kNvwHRfTOg&_nc_oc=AdqWDiAjlbCRskaLj9MX8Yau4xhbGEZEBDsNXD1PvZlVVYQmyoCa5JEWDF-tjQSWzaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD8UmDmLDvxuU53HXIessf-NoWurn6scbnBz6hSg-kiw&oe=6A707343"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flG_fC-OrbIQ7kNvwH5yCfZ&_nc_oc=Ado0DNuNeByXO1rUSLkc7t7O3yenT6_w9mLTHv5ndLnqbkWRv3Czarn_PyDVmaVyhpo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbYV7WMVj3RYcJZF3clLiYIHYU334OMwO_DHLFq5o8yQ&oe=6A70A93D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHQ2H5TccIkQ7kNvwGb_gy8&_nc_oc=AdrNfAfJJMnDXLUDeGbpTR_g0Xbk03jDKJ4yPRsNOJ2KcOVAcsh7caKDKVNtqLzaGzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGWiNp0Em5OTtDMMhgfu43txuyNraoOjBBcoFA9pvWhg&oe=6A708BCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj5jOCKHMcgQ7kNvwG2cpXD&_nc_oc=Ado3JeF6_WDBvkxAJnYaLZQ3lQYQac4x_AxB_QLA05wF_yCYcj-82TkPDJaQRLKeqPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyr3v0JjE5_z1BpoRrkN7NeSp3ie9D69E3HJf_sjVl4Q&oe=6A708781"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceDFa-uUv94Q7kNvwFflQaH&_
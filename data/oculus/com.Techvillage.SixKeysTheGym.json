?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SinFkGFkVKwQ7kNvwH333lw&_nc_oc=AdoMMIxMMalsd_gHP3kVYT0GNiOreNj-_sLmsXSa1WOVEStBvXjXHkSEeG7D5vxs-kM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOj3b6Dp9WNZIuS_noYHLG5-ComqFDRMR4feLiGYRAyfA&oe=6ADF588D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p00P4TLc68AQ7kNvwFtr6pe&_nc_oc=AdpDXQsBZEEG5kuDMuFh6K4yrR8VoKRw2e1s3OdLgEmEkZ4jJTBe6bZA62-FXbt5QB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPvfAMcbb5gTWn_-9UV1zQwlm4p_luC6EUeGBH1hg6xA&oe=6ADF6983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwaRiGOWnrcQ7kNvwGIyeAg&_nc_oc=Adqus0K7dQpirs7bqcGfEISKF51rNzW9wcFJ21t6ABNdMTJPjWSfayWe8ssDmhBN_wI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgCz84PEr5HEJ_ZLzjPvAIk-npTabJNSWL-wTIPWMbGw&oe=6ADF673D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3vD2BvvgtkQ7kNvwH6bcIP&_nc_oc=Adp1IwH18hj_iIZWwpObSKLrpCCV-bcMmgKKzDKfJHiibCT7HiY9LYRei0N7y7xz2_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP50j-lt812RHfiRaI0765smXSs8pNlxLPpYgslAbDaCg&oe=6ADF49CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AJDbw-DQnYQ7kNvwFK05Pi&_nc_oc=AdqSZAN16Nwihmopld_chR6QjJldrBM_qQGFpj4BoPWWKHX2iQMzo3nULFCE1HUTgJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMaZYIVNdIIep4JwItTcPh9j2Hqx6HhyfLSfs6EAibmQ&oe=6ADF4581"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zA914cIAKCUQ7kNvwGuF2in&_
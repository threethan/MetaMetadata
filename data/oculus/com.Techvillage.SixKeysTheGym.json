?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M628UUqOva4Q7kNvwEUbVCZ&_nc_oc=AdpvNpdybI47j4EsQt81uWg0PmFNrlu6JDsYAGxJv1hwvg7acx_o_qoX5vci1rGaQm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26dSmruNuQxRiGMdJA1fxGi4KOKp1ZLLWjQaRC0iVuPQ&oe=69ECC48D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmPCNMq3u50Q7kNvwG4KJ5j&_nc_oc=AdrBTKiOmAM9bGEarVipy-FS1fL6xR5VYntt4BBdAVpf41GnHKS01K6F-D7JYM1sRPo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x129ty6Ie5uhzhpWjslIZ_D_spmysmV4o75UB7vXZIQ&oe=69ECD583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_M7Xd77dgcQ7kNvwGOE_u-&_nc_oc=AdoCCTxdSZnOMg6LOTNoGk1ATaWXyBjbmo_lGssTFPmkq6887UK1FjIdj26aUqBIwBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ux4Z3V5IWK5m03hMyiIHfHojb1ZTfN9LkPZkT-H1TSg&oe=69ECD33D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAJq4ndM7ssQ7kNvwHuuYqJ&_nc_oc=AdpHqH0obRkfP6dsvZte1UzWh0N_8tLFaXBEbD3BSx3S6W0hg_4mpHyVV_sMc1_TtH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AOgOfTkk5WZEKyikG2D5_7Ef-yJ_jdPu3uPjva46eXg&oe=69ECB5CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74yB2rnrQX4Q7kNvwHmv84y&_nc_oc=AdrYUAXY-LorPAKzt4Gsa1UR2N20J83XSV7dLUXcuGnFwQZ7Z_pRCPjCb6jq6iXF6wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1532Btsh6DleJVLy1qYnnvIOWQSvcHxgnqn1yVkKEiaA&oe=69ECB181"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmHNFJQ0LE8Q7kNvwG14REl&_
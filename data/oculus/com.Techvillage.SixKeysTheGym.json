?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnrtoAfII2AQ7kNvwF-DqIW&_nc_oc=Adq2a_-Zbl9iRSrJ8h6Dk7XJnj4cofOMGOyU1hFdz2DYWu7_Vnl10enKuJuBKfCwNlI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E4Vq6lsCUkOl788Uz0SGgnm4-LW7qxvCMkkEm88FBBA&oe=69E2388D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDMjl-ieuFsQ7kNvwFegBMF&_nc_oc=Adp09oS_lW9Bgm3xzHrIN-iwZ09IY8RHipnZHFLl_CIzROxlc83AAqSOKyD-sjejZy4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fXnm3w2Z7316U8M4W6q-ercAxG0u9SqfFcIFKFrJCsA&oe=69E24983"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7_uFRW_pN4Q7kNvwE2Quui&_nc_oc=AdpeS3Yeq4UJGNY1di2hb2HXAyKzQD5UZn18eeR2BPcUkbCKX-JByxRdTUVOoJJOvJI&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25xOpopzaWA_5KxmMdX1SUl1plXrEM6PVCrI2tshQObA&oe=69E2473D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrU0kSqv8bYQ7kNvwG7ZlSU&_nc_oc=Adr0O4yIssa-sFuqu0k_FOePpgrgLUgJPMHOpg6hJKzve_AlRfTLvDQC_XgZrwreiAQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ut54zTouXEQ0T54oKCB_pzr4DTLPzt-nZG4U8QOYlzA&oe=69E229CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wvt2_KwKC-UQ7kNvwEWAJK2&_nc_oc=Ado8su2zqG7oRM7W0hiBDKhJvG9tNhZTb52loasDYxSizBgEJ2Mp4Wnz09V9zjUgeHA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wabJzRJmy8BYNauFQprkvMwTE6RYGTPRlgBZGt6Uj9Q&oe=69E22581"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaCQRE1dbEUQ7kNvwHRkYgY&_
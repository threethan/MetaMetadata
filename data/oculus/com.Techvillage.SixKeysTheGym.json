?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIlP4R9ctn0Q7kNvwHEnYCY&_nc_oc=AdpF0yz8RuGP4xN4J0VRPcV-60enkuNVuAJsfc9hPBJeK7Di2SJC10nfW7FguPn3POE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESeo2vGQfyH0MkrtgmPfExo8bCoG-Y6OfULPaLiYtU3Q&oe=6A91900D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zarXCN3SIssQ7kNvwHmEfYu&_nc_oc=Adpcd9g3x6OBs5ubMVTBqbICJKGIBSiYHB0tyTmQn-T5h_aDcTUJA8Z4JIKOLndmOOo&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG69NtmyXsuvJlfkxhsSgKt50z12K7FGRpRd_UrkPJ1aA&oe=6A9168C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQJtrBCkrzEQ7kNvwGP7JVE&_nc_oc=AdpJeTRCcflPl-I35IjrkI36Bn0-9W0w73F9_uc12VD-w2Zd6EnshLskfGyBGQdvwqs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDi5tVmRpUq3P7miD94rSWo8mOv5HsHnFiNTc2c5BcsQ&oe=6A91667D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xAuXcd_3RIQ7kNvwEiZAxg&_nc_oc=AdpTaf_MqWNWkXqMLQgeDejb5_S3fRjvIFIpGc0Rbo3PQz9lRu-BGm00sbh9OrWGq-I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJFeohUJLQwE2UJMGWPIsYwNDumVVzj_qKkQ7fi68IGg&oe=6A91814F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeBqf5KOpQAQ7kNvwG2bWFf&_nc_oc=AdoyebHTpJZzb-6lZqmIt6_ULTIXnp5G3iEkHEwtdQKdVLkYUnPn5qNzUpjmE3_665w&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY8vXQdDLGT-H9EL14twinycAFdHWt98bUeIGs6U9J5Q&oe=6A917D01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6_aW5q4M5cQ7kNvwFTM311&_
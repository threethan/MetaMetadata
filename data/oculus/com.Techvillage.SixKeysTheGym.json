?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3pGJ-mfQ1wQ7kNvwGHmBUM&_nc_oc=AdpQTrGTl1ULVVE83VRhgB_NOp6Q3ztpuwdXFJv7XA6JEoB8Dn34w28yFh5XWyXsjyg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OsxuW2ZhyoOcY3aHb_utScbVXvMTlim-lJwvlkGcPUQ&oe=6A32A40D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMj0wHq0h0cQ7kNvwHrrQBY&_nc_oc=AdqKWT69C7WrZd7qcTySm5scl-_nJILbBnjs9gna1FHHRCKlvpv6dgU0YDDzXmB4Y1U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8noreZgboY1szjPTNa0ZAVOl4rNnKZLGAJAEc8p3_C0g&oe=6A32B503"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1YpkNNkXo8Q7kNvwFiLzzi&_nc_oc=AdqQ8fI7ICAckavc5oH-GLJzuXseA7vxDSa1suGUHzUHqjmxEr4SCxKHEcFAx2l17t4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5NsVzPi8HLpSbTl2c1_CoTACPjUEePGW3aIl-PUXfiQ&oe=6A32B2BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZw2Dte8odgQ7kNvwHk6gSL&_nc_oc=Adp9onPJ-uj3PGpyfwniBin1IL_ZxwYBGsdPxp4b-1iadv6hLC_F87HL6HfXjq5snjg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h2bPppNaZU8O3KLM4NvsvN5f8WmaYZ-iXItwKP0WCsg&oe=6A32954F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZXbDWlQT5YQ7kNvwGejFuO&_nc_oc=Adq9WpSnmqwBM5AAJRfi0Yer_Um2haJ1WEcsmA3zPRMeH2P6d_R3lsLWMXRu8Tqpl24&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EaQUkpb2tkSocc0pkGjkQqWVrVRokE5tiKITfgDTvdQ&oe=6A329101"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36uAmm4BP4wQ7kNvwEurMay&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97BCeUfPJmsQ7kNvwGYMp6u&_nc_oc=Adooayvgk9iY0i3XAgCTfahSNT9fe0ig8gvs32H_kQtpccdBay9xbupw2ryNG3kZeZ8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyKv4qA1sEO5VqGFfeevh2bRIikeiCKMQk2y9OiF356Q&oe=6A4E538D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX-L1HzBOrEQ7kNvwFGfN2u&_nc_oc=Ado8_yc2Xv4_NT9cP3aFV3Mlk1H64tAi_XNl-SHGTK24vwBux0ah7BPv-NNDN7kHZIM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGdaCqyWlmh0q3rV5SI_0d5yI66vgYH9oMQLm8zVtEww&oe=6A4E6483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU9oWd125ZUQ7kNvwGyeYH2&_nc_oc=AdquiQCMzhweYVMhkk496w0Gl7_hadFOIhbPrfAHdhDkda7fHCwmYglYIcDlL7r3BwQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXWOXP1uM3nV18PsGCyigVbktmqJQ-uq8tm0Uj4IfgXw&oe=6A4E623D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlnW-FUhAQUQ7kNvwFeuSu9&_nc_oc=AdoAe1q3FtTkgzMGGCELtXDM_B-TLwSDGm9Vsb7xFP3I6dQkMWnhAyeE8c32Vd7SRw8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAW7Fj2yv0Vwe_S8uVIRFuRaoAxzsAS4fzMkAVUPYhRrA&oe=6A4E44CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvQ6rS5HqEMQ7kNvwE2NHmW&_nc_oc=Adoh4Ucxlef109UIFNdaao5Y5aVQ_HDZZSLh6bHp5MebxzGcf-5UTTJZQe-MoUX9LD0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEf5TjcD7BA3haewclNkInMKflvuMufovswg6ElQLYaA&oe=6A4E4081"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=994YpmBCa-MQ7kNvwFY2jvu&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLDE_ARqkmgQ7kNvwGh-Wyj&_nc_oc=AdqwYjzRh6oJIDKofdtGy-PTjN98ZnSGHYVo_-0H4mgEm-QX20gWpoigBZWnklqWVBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsUdiHZa3-o3W33fBrd5UVpFhFlRjSkTigOyiKY_0etQ&oe=6A79D50D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1QZlpp9jYMQ7kNvwEAET6M&_nc_oc=AdpPvEznrx70GDSXvJZ6QicDjRBZn2LxpwGfkaz059cpl1x48EJY5FCrgKI8Rwui6EQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdLsvPYzAbd5c9E0-ZeNyz0DQfyP9Sj4f6Cx2wiB9sfA&oe=6A79E603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TL8_xkuWLZgQ7kNvwH3RzXp&_nc_oc=AdreiSulTngpe9-dMrGYAhsaCzCRsgz5otgiaPX_wAxPj5lvo_yT67cwjlwHUWCKaPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHKAmnQ9VQilxzK5VFrgVPHTFIkUw_NGKIVX6BcGNm2Q&oe=6A79E3BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE75Djq7LwgQ7kNvwGQdzqI&_nc_oc=AdpNWgkaU0-GvN284ACPFp8-cCBSgHwgkftGLfTcdegsVL_nUI0EiWLL15ShLgaTtXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp9SG0fIpU-E0Y-B2bjMvBbDlxuPnZpiVZhINSEdJb3A&oe=6A79C64F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wykmqGJq-u0Q7kNvwF_GfS6&_nc_oc=Adp-EbZQFav3wdEz9cvod7qVZjXE-SR_O_m-lLiQ1AmL-Hl6FKRVqSeuyVCDgUM681c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs-iu8f5-37e0C_9CtqxIAkuWE-PGDLyP_ep3IB2V4pA&oe=6A79C201"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBWTl5uTMNAQ7kNvwFITOgF&_
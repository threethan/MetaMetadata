?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97BCeUfPJmsQ7kNvwFo9UvV&_nc_oc=Adp_k_ikq9Yeqf3HSnTlEBLnEHqqPQquhq2mCjdcEcJOGacV_ImCH5dcXteb0pbMmHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM2pJXaYylZFxDZqcn06ZIjypdZzX6kxs7ENXXWiQubg&oe=6A4D020D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hC_3eYAWE4Q7kNvwF0xpzV&_nc_oc=Adp9KZ90sIX_9pCUH_jSn9EjXMLwueUFIriEU9KL1aap6OjWjSYCwCssSCz6dX3BGQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyWdmSXcYWbW-qRScQUItTBAx9qDhvXHRXvFaeqUrsog&oe=6A4D1303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU9oWd125ZUQ7kNvwG4CESx&_nc_oc=AdrOOhepusYYDhoD1idND-DUCswk_CNn_OcczV0fHTiC9-MBpQOic0dahw-a5WXPMMA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDk2jMBSmtWGU2slK4Y41yoZodctwBbaR0gGaZC-40KkQ&oe=6A4D10BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlnW-FUhAQUQ7kNvwH1KUd5&_nc_oc=AdrPGAnCTGlKcgC-WEVqEqmVDTGd0eMl8huWHoUqmvfk5U2yIiu88-m0xgKLgMv7h0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxhQwHS4CWAWuZm19Xc35Q1ab5IP9yNovLJzMaT3qR5Q&oe=6A4CF34F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvQ6rS5HqEMQ7kNvwEJLBT7&_nc_oc=AdoQL2Qg19GRuA_CeB91uxPgyRMrKOvS_J5jHVdq0Tcx0k_eh7TJM7eKUazEBsCxFlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR9mfPFGQ4gh9aUxmNEwifVoVrdBRDLjoE0mcww9qEMA&oe=6A4CEF01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbeT_5xsn14Q7kNvwGF3H4U&_
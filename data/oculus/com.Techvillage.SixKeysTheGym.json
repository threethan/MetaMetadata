?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7KN1rfvfFEQ7kNvwEdXMFi&_nc_oc=AdqpgDWkf2ncsPbnBnTZ7CZ4dPjQyaKBi2LLxzY0P9qPl-NeSkrZmm530VDlHepqRFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRWB2Fmpccu5Tloot-T0wfSdiY-4d9VJMtobkyf4_S6g&oe=6A64BD0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERUSM-4qtdAQ7kNvwHI0ZTg&_nc_oc=AdoQsXKcoYrbRn21u7e2AlUvDlEGLhnzStZ1Tu4C-px-j-QlgZdKSZ8ANGCeHKrQxoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM5KFfE3hzKcvzziVVcVUn78zSJ6RS_XfyaCi2H7JbsA&oe=6A64CE03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3E6_AW-Zd8Q7kNvwH7d_Oj&_nc_oc=Ado6PDxxmXxrAtpl4Cg-IwRmjwFfrt9uYWEK6irsFqIfo58buQTdbBGT83UFw4C8pB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDSDKula3ibzfMoZWw5Q3fiETKxf1aGEQcLadcOlFv1w&oe=6A64CBBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKAdxD1xOJwQ7kNvwGz91y9&_nc_oc=AdrbnACoxK1C33jEsJYKsOvnRxQ4y-nhuohnTEVfP0vFkBAfgx6fW0_hgP7RkRdMlXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRJre7fkCjoqDX3-zLDC5dj8LC2MoFhihNMvtWGn4odQ&oe=6A64AE4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FqE8ax4s89oQ7kNvwEBjOTn&_nc_oc=AdrajvkTZ_Fxqmd2cu8HswLdLx6kE6Ie5ADfDS5RhrlI1UbZHyuB3gtyp_mWCmObRmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9zD2WoiMSj9V8QoXrCy2-KurGlapN-GDzv5DZGD13Kg&oe=6A64AA01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_chsNQSxGwQ7kNvwHg_ngB&_
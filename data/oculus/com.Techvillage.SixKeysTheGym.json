?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADhyV5SqKTgQ7kNvwGmPfKn&_nc_oc=AdqN9IOUKPfGvnxdL4m0lQZ192zhJxHWRX2cojTWD9clSIP451oUH36_ooh5WSMbT9E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z5djpRzSfSm_vusN3ElB5zv43OaXqbIZcxSC8Wvd0LA&oe=69D65B0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hi5a7bqZc3QQ7kNvwGdxTP6&_nc_oc=AdrzS3NO25pVQeR0JN1agB1zW9CWWV8FgCXidshr3YZe4wAJZAGoWxm3VO6fRziK__M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af106kNzwwDcIzBZNUyXBInmMLWv-3hEY3J0VKSGr4UeuQ&oe=69D633C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vD1lAhBZSsAQ7kNvwE50UMw&_nc_oc=Adp7MHKec-HfRntdk09xu1DDCbvvFpByFGPw4MPBNxP4eLFOAvPQhmsBNnAGLfDF3L0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22Mc2ZFyAXrYTVm7rCqLrOmJh8Jqw1fJ8vsyaRmmyPsw&oe=69D6317D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0EFP2ELJWAQ7kNvwHblu4U&_nc_oc=AdoEUi0lyuke5-W-4jM8THw-Hdx2TBAf867vbL6VOBYEf1h-kit28SeIMtqN5jkrJaM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MswEg-bBCKWIRlg8kpnHC7xxptI1G1QgpY1Ehe8nbuw&oe=69D64C4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HlV4PoAXPAQ7kNvwH3zGaN&_nc_oc=AdryzFmzdk3O2Hp51flU11Kt2t0511t_5CfqOO35DXoHSa3NwPu-1VHP1iZKxTEbNfw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mSF7eTpR-Nt58rjy5FdDtu_--yT5J7UBXcbd-wfWc3w&oe=69D64801"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fozhda70e0wQ7kNvwF4SjQ7&_
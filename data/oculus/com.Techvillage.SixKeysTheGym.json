?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM-lNLNHuJQQ7kNvwFw1WZ0&_nc_oc=Adp3O9W0wtwDRCGLNHOGD08S7xDfdVfJlWkMXDOSnwL-ISfJFf_xPTxsOm5HzJlYliQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EHUSs0uXxPet4yuqV0rnOQvXuBMkSiL7uuCPto9AaRA&oe=6A2D5E0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCLxPoU5SrgQ7kNvwGZY6HB&_nc_oc=Adr6ekwWzQbqPuJkPhJPejsvwO9Sjc1yCsap4btX3U5dZlmfHilUPW8B2uDZmJk5UmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CPKnHqWpWq0lh-zzFGXvw7tqvVxv-snOEz4MqaLYxQw&oe=6A2D6F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emBfl1Smg8AQ7kNvwG2DRfn&_nc_oc=AdoKUA3a9j8b_Y4c4P1FDQvsgsqHHqTsk5qg0glGa63EpifclDMTAnwTHYudtWSGLQQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FSFNsWv0YwPXpQb-f6CbPKQGBVuTQ28FfakXPfEYHhA&oe=6A2D6CBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBrKC5Q9meYQ7kNvwF2JPmN&_nc_oc=AdoO0e7cLEmg_7lQdS0BuC5abq2FMCRy9ETzylFwAhbkJfxpboXia5j-mLm820phbk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8asf5a4GAQJufk3IM017c-leGMRC8AtVWKLVAED6a7nw&oe=6A2D4F4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVYL1-0QlDEQ7kNvwHFitba&_nc_oc=Adrryf3PcAaYNjACRtL_-MFvEHGfHGAQn5xbGBrOJ6yrz3ImqplRzmvFdQFAF9XNaJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K5WAnzpcLAR7argzTajCz-RqQKBBpEGNUYkM1jG-ehw&oe=6A2D4B01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47_e1HyVXBsQ7kNvwHSb1Pw&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M628UUqOva4Q7kNvwGeOGGJ&_nc_oc=AdqMZ1WQ9a5cpufSGTaBDQEatc0wl-OPhMdbcF4zoKuQriCX5gyazm3UpifiQxMEX7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Tfee6YlbcnMiTDSQ5838CiMOYjEEoRARUuPFgz5YHzA&oe=69EB730D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4d3JLcAmswQ7kNvwH8Ug-D&_nc_oc=AdqQMMMx0WkUGdoBbwXcrQ8e8ZZnWp3g3iGk1e9BMu1SsPSeBLDKwMqQnN1ArkyXhbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08__T3oNXN7mb9TrBcZpDElh_Bc4c4NM3tSNDU5TZNhw&oe=69EB8403"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFEKF3arN4sQ7kNvwHncbCa&_nc_oc=AdpsK1tSfEEmN1rp89rAKzEVd6Z7Mg0PBwCvcJ4UNZcYnDidQ0xN8mX1bqSVXBqSTsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_SART4JQI1pa6ZyVAwRMsL1kjxfHKnuGjfmncpAAPrA&oe=69EB81BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_oezLUtYBMQ7kNvwF84WZM&_nc_oc=AdrBy1mEJUtrUiehHdB9fTxWhHXlmj-LHjQqtXZKotcX1pvgLo_iXJb-wNrPdrDXzsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R6QH7SGmxcg-HQX7HwjbSXNI3rRsuyN_4j9gm0pNopQ&oe=69EB644F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g83-UwjQpO0Q7kNvwE95qQO&_nc_oc=AdoD3cFZq-qmVPqSY5TcrlhL8AFmhxHFb7jzlasi3WZIKiPysOaEjd4utimHoiXw8IE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XH1S1Zj1hsaExf4TxSy8WFeD_HZf1eFC7d2Wn-dCMlg&oe=69EB6001"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jmHNFJQ0LE8Q7kNvwH8Mbx6&_
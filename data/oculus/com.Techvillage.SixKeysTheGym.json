?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ck97TDSGHzQQ7kNvwFM4pBx&_nc_oc=AdpySLgbz_BW46-Poce9bmNuOj8PtROon2WelGZZdagofgQTMjRG7ohEaRSL31n1TKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBeMDU-5D3NkzeU1oOjS5roCXfvUZu-8CMr9DpZXydMQ&oe=6A6DF78D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UO8_JLruMMMQ7kNvwFuyozL&_nc_oc=Ado-SxBP39IPDTGhRaoRjoYUiLsQvRXUTXOr2bLdzrPoZFvjkUO2otaGtnmWuK4PA2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4FesDxtqfiaZF3EP_UzBZb9LfMbAdz70axzgn4kXGDg&oe=6A6E0883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZo9IksYMccQ7kNvwEw_Swp&_nc_oc=AdoAQMqoBwgoXK_fP49YqU_1fS1y-v33cSU1Z6gzZlFTMT566C3KB2i0r-ritn_pWu4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTzOauWGSSnCuWHvCAvLCfCQ1YY1DqPBz36osXxPdmuw&oe=6A6E063D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjnavhPsAAsQ7kNvwFHPOG0&_nc_oc=AdrYaK_jAbVLqpCEooTbGUPclohpgrn5BjviucHI-tHHOMwJ2r8KOfrC9buqur4mPY4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDAvLSJq3UDmEQ1TiUceDqVwF4jxDs7XidACkCNcJcbA&oe=6A6DE8CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztzFZWpPWAoQ7kNvwG-aUlY&_nc_oc=AdpOFu8BS8_MtzrBsOcnsJTfA7Lk9pbMZURWip4paJ2CVeP46GnfkDZBl4dTfHnHvBs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBm-zDun3XKgs8Gx89j45Mjku1awQh11I5HVfHJ-t7fA&oe=6A6DE481"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceDFa-uUv94Q7kNvwGOaKek&_
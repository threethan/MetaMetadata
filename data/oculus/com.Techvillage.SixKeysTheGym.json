?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWYJDh1ll1kQ7kNvwHoVujW&_nc_oc=AdoaApTXjwfxxP1q9Q0we4Me4nPNFOm1ZKElVD49iPzKiD1y1GOG4CPKyDs-RAhYX4s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCFDpJelmbV59XD_4n8ocYJL69M6fwCJ3L7zmBTAoyOg&oe=6AC8EF0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyR3mjM8XdkQ7kNvwFzSCd2&_nc_oc=AdojfM9IdMNyT8o2yhq-90RuSOz2f0tDjC2zsdInaaUMhqX-5m-EU-zPa64__9xNFmg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRa2X6DLic0wQuuk8ybfF7v9y-Wh5B0xh88L3vuINgbQ&oe=6AC90003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ad7_HDm8lMcQ7kNvwGUv4bD&_nc_oc=Ado5rq0pVpjlstRqHekBjBcRadV_VR7L1NexDYdLlFXTCROc6aRo-_QMDEeKD-YZ448&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMpVY0LJ9SQx680jeHsTpcc8DgjR2TZt0pSlTPgm22Jw&oe=6AC8FDBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOtXDBNVS4EQ7kNvwGKq5I-&_nc_oc=AdoyAb9f9UOQuyjneaK0CINPsMO8XDwzfzIkTnGAFYY0Amw-4l38COOW-bk7oFhdXLY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtdvCuLTjdYC0HhKCyO9FQkUpfro-3pZZ05Xb27SyNFQ&oe=6AC9188F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wDGgHpUOEcQ7kNvwF2q5Fv&_nc_oc=AdoSHcIcczyAAYLPn0XQydlEWEL0A3iyC_zUe1cW2FkhjCTo1mPKBCYImTPfYo_EUHc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkES7kDghvvf2QQqJpFdOeJnO3qaf4MgheKZv9plHT8g&oe=6AC91441"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLwBbO2M4BkQ7kNvwFwzhHw&_
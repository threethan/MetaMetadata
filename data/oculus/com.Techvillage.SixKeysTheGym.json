?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_0bUg_nUbwQ7kNvwHjJ3dd&_nc_oc=AdqMIf9ISSBViwsQmKnmFbzAzPHw21q5TpSf1p4igUGsjxxWzz4CepRotaNEHWKgZjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B3iQMei_L52vfDnxi1tRsX5L_QRvEUAzE7GPTrgzx5A&oe=69FC968D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRTH_bi3L7kQ7kNvwHe3T_X&_nc_oc=AdrTPY9wEIpq6s--iCU4_jc9nbzCqXD1lqYaiAm5ANrtgnKQG-PBtb3pXZUKO3T_4yA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ADXFHJ8J5ejaN0uW__VsciHPA9OWutrW7WLV-uGAaBw&oe=69FCA783"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fHVW5TJafsQ7kNvwEAIjZ_&_nc_oc=AdrN48Rl_Wfbmvv2UCW9BnSBdgx-Zp9WjOi0XmEDDInNqRLit18xPU2o9JZNvmiDnWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FEB_IdV59VynyGy0-PwhH5HqouL5M9eqg4aF84tbXTw&oe=69FCA53D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAInLKJ_Fd8Q7kNvwET4zQJ&_nc_oc=Adpbq6tUuu9TgQeQOd1j7570bRtTl3BZE1aDB1ie_aztqDRmGbnMCxMbrsL2CWDauNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lzN3Tt8aGjIPXDE8NNSopYBhZm-nppuuT7EXtO0xGvw&oe=69FC87CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXh831IgMgYQ7kNvwFmglNx&_nc_oc=AdobXb2jtt8N_uV8jyZBALJLZbA9raOQkDBkFiSDIy0uzJ7nu8KxfM9180lkZfmQ1pU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UcoE0KXXLwbO4KTPqJqnHRiCZjDSRxKaYvJYAnqfrKQ&oe=69FC8381"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLBnai6oJT8Q7kNvwEFMsiT&_
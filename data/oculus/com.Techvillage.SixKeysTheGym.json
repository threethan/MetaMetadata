?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsXSBAm938IQ7kNvwFmOQ5E&_nc_oc=Adp-6mzZnJYkkOSQx6_93u80ww3Bvj53vjEALQFjXY549gGUFDuYo_Ap7ZafternjNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkZjZga5a_0WjfA2kXAo_SlrWziHH-Iar6bBY4c00d7Q&oe=6A53998D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y571LOEyxXMQ7kNvwEs3BY3&_nc_oc=AdrBAaOLEd6t9qrnrFvCosIIk-6wv8X3ozwXjHFT3mdV5kkx1fj69PcSK4dx1NlBoyk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ5C9eDDKwv1vvj5Ltlq-baWsoRdpjO4MoXF2NwYyhIQ&oe=6A53AA83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U87ofKI_QrIQ7kNvwFTczUa&_nc_oc=AdqVrKd0FCrFS2Ih9l3Ref-yvDxqc6NwL0yeXy1GWHQSxhryTWGec7KVkp7-Qe1yAQM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHWoQvOcOHd1B3TxkCgKjMQRvPrX51RbFQYpxxqowQRA&oe=6A53A83D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrIFAhmsWaIQ7kNvwGAs_cO&_nc_oc=AdqFkGSOBsaWc6PyumelgU1aeughOIzdleE8Au2QU1GGdDNivdhQszwHQRqfkEkRpzs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeaD3myQz57mcVd1buignfpNHv3ri1ske8nVi4Bwib_w&oe=6A538ACF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5gWqJw56JQQ7kNvwFWdlMZ&_nc_oc=AdpHL1Aq6_eZ7bjF_XbzQmg1Qa77k5wuS7aJNa3OZkOAPtBWD5x1gTS0mrj1VKCMJ_E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfusW_ymfZh5-xd782TmZ7S9jdiS1WzbuTB8FSFe2Ghw&oe=6A538681"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhn3--gBnRMQ7kNvwFzWG_G&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnrtoAfII2AQ7kNvwHsW1DE&_nc_oc=AdqUhjB7zNuCKLR3IaMlAMBpdLGAeVQZJtnDVrp8XZ-z5yR37JkKFgvAv1Y-tDwnADE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aZk1nIjBxWUvrr5lpqaCSVyd64SFO1lxBf_qsbW6-NQ&oe=69E4DB8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ly-c0mk_-EQ7kNvwFPQPzV&_nc_oc=AdrOqvw3K3onWe99iKBkOB608rF8hkkrpL4HBlQQZm5aGCpRhA6Ny7IafEuQwHj1SAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ceH67GEzhYyUPRf4oB2mYvfCOE4CpQZykWmzCugK7eQ&oe=69E4EC83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OuO8wpM6qkQ7kNvwH1KgzA&_nc_oc=AdrwX2lCtAzFF5gsxKQ9x99gOAq9LQGlCD6qJMF7CdNdp4Qnkf0fvCIB3tVLpFGf2Iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p3ScCizGPPDbNoTw5ukpUBaQRo03zgEfGVWJIlxzl0g&oe=69E4EA3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnnfPrFHLP4Q7kNvwHZ9NL-&_nc_oc=AdpgrhdudUAfPmFQe6goJt1OywFcqStta5pD1kaeZ1oS7gnNVG0OFPuCtCZVD8iaWng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CVfD6KSG_PZheUbmVnwAZeOdLtfkuAfqls7XzP703Hw&oe=69E4CCCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0m8hhUUl5QQ7kNvwG0yWsi&_nc_oc=Adr8KfX76LCileEsSR-6dlBrCAQpu1MJA-YQsly29VmA78xEr7W2i2fbyb8GQ7mJhbs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ioyZokxcDtTOX0tdQ1gXHWElOGKEahSZ0IstXI-JmnQ&oe=69E4C881"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gQRa2BAVJwQ7kNvwEv6pk4&_
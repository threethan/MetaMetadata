?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADhyV5SqKTgQ7kNvwFsApdp&_nc_oc=Adr1xGa00T7aW4i6hW5dtUMkQcjUq1timptQ-7tmOtXjuF7fTHSkjTPEs7gXBRoJlEg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c8UbCC_H9i_rj8hUy0ZZZRbLikpUUDfyFrCokV87QQw&oe=69D8FE0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKBLT5N6RsgQ7kNvwGziMTu&_nc_oc=AdqGlaSljCR6f_rkl_X0VR1_7_UeaPPXBDhWqWL4b3hM1SU6uL8mw7L4U0LISWW4VJ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UTMyOQGX76Nz5meE-1w3qGN9LE-WJWyhMwuDrnHZllw&oe=69D90F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRxXNuf4DRMQ7kNvwHvAbcD&_nc_oc=AdqzthzZSM1oe0HBzMb3tRa_8ADiRScCfh_HuD9FGryhdw-ekVT90kmEhpY6XP1hzog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AaGfVvFxfBMDoDKuTxyP5awRUGO7nmbJPYdl4TAKSWw&oe=69D90CBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0EFP2ELJWAQ7kNvwGZVoyp&_nc_oc=AdoZ591cTtWkX_Zcw12A9d0ZrIXJ5pGmTgvIs97R1t0OiO94yrJYQXNFPkts9FEnM4k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LBV85FI2WvbaOGOqP2jpDrnCfdM_zVgIUJTMfxCuBHw&oe=69D8EF4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIThXnQ6n4MQ7kNvwFy4F3j&_nc_oc=AdoJYNoDF4-mUqjFinvu0hLWCY2Jh_4S1wpoLnz8PhugV6wkUpbp4MxntLYU74F-qH4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-U5CxnIxgnp6z5_AFNyqXiIyvomeEMLRSBNb2ijEqGQ&oe=69D8EB01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApWEoq4oOg4Q7kNvwHb0Od5&_
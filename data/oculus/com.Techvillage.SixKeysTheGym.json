?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAcXVmn-8IAQ7kNvwGApNSi&_nc_oc=AdqBxGm2icjIDEQQGK3hrW89eDgtMMEucCKtrj1FDPO0eQN1SSWMtU9BHqNLxavKR90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56QOaMlGTtySlK1U5DxSbFQXSval092JK5yw-a7acATQ&oe=6A047F8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFMekKu7bV0Q7kNvwGTMw3p&_nc_oc=AdrLVdAzHyl3uEnGUwfm1Sb1zslpb1uQRFr4C-Z6GNkflpnXKnXL2wv1psHc6ltyRwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lCN1NkhQyoZgjzyfvlDdWfIXxdEvHqsQJHE58M9BSRA&oe=6A049083"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxnZMARt0fIQ7kNvwFyAzbh&_nc_oc=AdoVhUYwkYFkD4-7zrONEltRHuP6poJBuGr06PG20CxmPPnj0T07XJXZMdVWv7TVshc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nNe00-5tJJfc8B5NmBfqVxDXvdWtOrOqHFeorpplLww&oe=6A048E3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTW3nq9lgDwQ7kNvwE11L_O&_nc_oc=AdriYFary4ypNLrjujqIxmd9jnHZ-0NgNJ3TLND8-a2BPMFYhcDESNDTbQYj9X3o24Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73GbTuTELO7pZ9lTDWcoV-k5oGP2w0KKPXGz8LYCADcA&oe=6A0470CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsxduMcrkIAQ7kNvwFipyAT&_nc_oc=AdpLv95KBbkrjacSclJtunK_iGVdAlPjoTSoGVNbnrwRNfa4qr7YURLVMQgtOvi_pCU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TYOm531mfY7P0MdZCl3c6aX05e_noNZRNg6mcifLrXg&oe=6A046C81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MBeoxfTh9wQ7kNvwH--UkJ&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yx_E16Q8oAQ7kNvwFDxg8y&_nc_oc=Adrmh2AraY3wgfsq3He9l23pIHpxEztXzNQKcpa-tnfbPFlBx7KCO1LCN6_pjAqKCto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOxpaCMXsvYrVCpowt0r_ZU_sLh2mLW1A9TLJLPebhIw&oe=6AB91D0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bRvnL_siQsQ7kNvwEeyyX7&_nc_oc=AdpmxylMJbt7WoTqo8LViM-ctEHG8mE-XM8cc7R5S1NwQ9D2swTMq1BjAkoUOU0Op3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPGTDiQOC89k-we9Crif04_toqxYbYWJAGB6reHc8Ytw&oe=6AB92E03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQC4vAEhQbEQ7kNvwF11P40&_nc_oc=AdpsPpC7vKFuf_eH51F0dlmSu7pzWLiDqLrmqV2dlVbfgSA2ubjBirmBtQSylgpcn3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0HWRxbxrDPmX5_w_t1ooTLZtIDt8Akmue3wqjQKWNkA&oe=6AB92BBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9drgqVLnCAQ7kNvwGIg9Xf&_nc_oc=Adq7mw8b5YCC_9h_TENjyCpeB4HZpliT6upGIE7yJkTXhY1ZRiiqwPtV0Ac_67Da4Bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsnLYBYjE7MNW3vhciKMqhRlWnzhmxcJNap6XRWd48tQ&oe=6AB90E4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVDH-ub-aL8Q7kNvwHL0W2j&_nc_oc=Adrw0IzyKYMMF7_Y_agfUEGPpQpQd1xDh1Ls5YqZxe5zkiydy6eL2hCR5VkR2ns94Go&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhDMJfb-DmArEh3NqT9_Ab_t_IhZQCcbbKfOmwqhtxGQ&oe=6AB90A01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDaWenWiXTcQ7kNvwF__rd2&_
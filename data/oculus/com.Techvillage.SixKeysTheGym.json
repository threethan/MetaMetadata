?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H61LoG8cRfAQ7kNvwFLUpiw&_nc_oc=Adr6n_VdatyeyBSVbAFTVFveuGCm5JXXJk1Hc_i9DtIVP7E0GFLhVEwrPqXnF8g-ozA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK__oBYf5RF4XXBv4nA3L26OkCpMWWM3oSevhB-ZYcTnw&oe=6A9EBF0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-Ql2Cz-e08Q7kNvwFcXDxf&_nc_oc=AdrnmXPUaRO3D0ba4GbeJUdSWG7-opu6gPUD5vFfkTcWtJp--H5ffqRN8Di-hA5hjyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRazxEwojakPdvebGQzOvQs8Uh_aO-qY6CQy5uqdQB_w&oe=6A9ED003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y38PPwbtURcQ7kNvwHVGFE0&_nc_oc=Adr7M8Yl3Nl1_YKvkieW56w--XIkis_gn0LcFt78lY8aUo-gVkBXNIIsupHOUFupQK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBuS_68d3fxaKR3qWA7gRi2dtRU9Ysf2ILaC-6_4PS5A&oe=6A9ECDBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xDW29WSWvaEQ7kNvwErgZPp&_nc_oc=Adq7cYFhBKTL6Uccc1CNEHUKkWT08Y7rygZmUEFcKsDz2eWeWk_03fchd9pG8lJeWIc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE_aJswdoTVWH-dHVtPrBrYudto_7KEQtaYrXGzGQlwg&oe=6A9EB04F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZnQ1G2JVfAQ7kNvwFU83xZ&_nc_oc=Adqp4S5DhKZUi9SIXCGGkPfFYgDQaQC77mhBfr2P6JD47Dv4Z8rkDF4VntSchyRjDoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj2o8KF0gQHtAq7DQhQlEutnnc-7FXuR5Da6KbgcY9DA&oe=6A9EAC01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKnEOJ-iJtAQ7kNvwHhoURX&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_0bUg_nUbwQ7kNvwFDCbth&_nc_oc=Adr8EJ4S4yoOE3u7S6HqtIpbi77WYIxseOo0HHE2snvq159H4gGAFyLLo3fVeqIvR1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Esj0IDHZ7x2tutiIbmAiTaA_K_--0SGo7qFPyEHOqHw&oe=69F9F38D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vx2vCfw6RwQ7kNvwH-GDIK&_nc_oc=AdrG3R9kSjRCQOUxQquK_HxMHEb_2oqbujg8IxJsqYfATrvZ4UO3C6udVhXHlNGG-dM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sEV3XDQFAevDYJOvU8ddu_B8Qgp6LR58qbMYB8fBu_w&oe=69FA0483"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAn5t54nON4Q7kNvwECaGet&_nc_oc=AdrNrbmmJr2KPyKTO5SObuBbubWDW543z9TbEhTxuDTtWaAFhU_dWOZyzquWuKCWgPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uMbFClJ9d_R0HjRIsqxEXjkcZ6mvyUijljWL8agC8zA&oe=69FA023D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZqa4YHtw04Q7kNvwFj4uXy&_nc_oc=AdqGIob3u869jZhylOzqWpW249n0BILJPSqbub8Xr4LF7nLeqnCJC4_dvZNe0jXoEbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4goJw1VIJBRYjRH9TFf9gLkYVSRf8N470dR58j3mxgLQ&oe=69F9E4CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVO8mQkUnnYQ7kNvwHdCwsA&_nc_oc=Ado-A2tSsLsTEvUHIWDKJlelhbqfxaBzklvuaIIkbGngp-j27i2RVR2yRdTNrNs6_aQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TVbpoNA_pHt5BLWV1EBosHmY8_rpEunTAOFyNV9jCXw&oe=69F9E081"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrhAvJwTlJ4Q7kNvwHS0jVK&_
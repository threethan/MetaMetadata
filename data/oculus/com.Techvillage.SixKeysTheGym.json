84343_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3TgEb5jeJMQ7kNvwHYbfvz&_nc_oc=Adrp7L_MxLnrgL8V8VsToQFibkfVE5kvnR4QdnuINZ7BHGnfa2HdDEt35G5GD4q5Hk8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzji9kLAiVMZzKIpcbIgYLOJqZffs88vJHMuo7IIHeOw&oe=6A8D9B8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AisrWFh-rjAQ7kNvwFfujKJ&_nc_oc=AdqYpQSXpMs0Y2d7YCKzIeY_QUUDOzdpLYc9HVDCt9Od-PxLZbBBYNGZkPj54w9TS2g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZmM1ydJhIjKv_vFKP4EUzYE9mZ4q8jQZrFp6WWuow8w&oe=6A8D7443"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpIY7tgKMFYQ7kNvwE2Bv09&_nc_oc=AdrPvXVfxaCF7L_aBUsvTQPXFEU7Al7Wfr_Y8y7V1bOkZvGoc51FaxMvJntcLy2Igqw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHL38lyqqy72J2ZHHMIIKxrX89AGthVzm3IQsDkvMNz5w&oe=6A8D71FD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yDr3cUmq5wQ7kNvwGJ9LLE&_nc_oc=AdpvcellQlmSWKmmf6mGLiOOKDqUf-WUpsP86SQlJO36OpRJgFunSojF_oZN1QyUEfM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0yttNY1zyAECLiwQiHd3xHfZZMSBSP6NZWBA7cwgCBA&oe=6A8D8CCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7UvQ-bDhCEQ7kNvwHo1Pgk&_nc_oc=AdrnRvGIteMcMZEeQW7DJMPXnSJtCVMP-lQueDkZ2nR9XhcFJcJ2Xs_qACb5i06LKHs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFntPG8KcA5ll25llIysBm8bM29ZGpw9kaEiGs0tNlpYA&oe=6A8D8881"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXKr73fEq
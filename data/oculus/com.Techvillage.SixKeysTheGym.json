?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3CUH1mjZ18Q7kNvwG9xFOX&_nc_oc=Adr-jN7YkgRBvSXRdsHXcm9Zaz6rMqVuNW2neLSlEVpWzcUlDWBn4MUSaLsCnWIxhlo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMwP4e9I-seVHxzbvMGi2zrZZKnY9WXrzCe1Ow7mVXgw&oe=6AE34D0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLdlAnccRt4Q7kNvwFt_DYp&_nc_oc=AdoYFClINm8TUjE37GSrx6hpCAohrogpBkyZlV7n1L9vmL1n68jpmjvwdzho2Q4YKuM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTnhWJhjV-mJqOY2sQzYoCshnePUTxbSE_hp0KE0Lxrw&oe=6AE35E03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0YkQi6ca54Q7kNvwFpUnB0&_nc_oc=Ado_CEvKWhrWw65NlYyvRqfpCKtRYkGlxR4t-u7-vEbaGBVlIRvrQsmhLUoPQID-5a0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9vJ6MCM4aXs5g62qpnfD5aYFBwwACU0rdtWGelY2hog&oe=6AE35BBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvjLZN8kPz4Q7kNvwGUi1CX&_nc_oc=AdqG8EXFBL8q3LmJVu7-CL5yxtGSP7Q31Zo7cMrYA_u_qFHUqHdqLGbe6UWQ0fOZLFQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhmDvzDo1l-57PGVSLecrlsiBmmJtHjlPWPt5sIkHCyQ&oe=6AE33E4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=820692cNOCMQ7kNvwHMNy8_&_nc_oc=AdoxwA9CL_1xGby8Ido078YXmHSVivgFQpWu4beibt-ZbKWw_15m7-rrWlY0w1Dz6E4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMr-zx4PJqbPd8YcveYHB_6HcmSPxBGwiRqmvB_Yfs3Lg&oe=6AE33A01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMK-QZaAQjoQ7kNvwEseO7j&_
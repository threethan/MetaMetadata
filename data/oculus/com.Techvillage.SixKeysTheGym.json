?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MmVQTIlP5UQ7kNvwELmMdR&_nc_oc=Adp7BLcPyNKA0wUOayRbIC5l7Bi6THEhC51DyG_mvuzDcHPkGK3_fEq88Uu8vC4byRo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxqXa-nWOY9jPfzircTkyOWdg_7kOGNEejTb-knOxMbA&oe=6AEB360D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD9IlBqErXQQ7kNvwH7W9oT&_nc_oc=AdowM2ReuFZpSO_a3GBR5gltOQPAroyGsSJ6b7hnrRkIiB8xTq7t-hbRBC8CM3pZGWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqJOLxusoWpwhxi_SF0bkgzkAJSBydmBtH_IWXXWfglw&oe=6AEB4703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPMhlsXJOIwQ7kNvwFhkdEM&_nc_oc=AdqH4ACSDdUy7lqZAZ4u-czoLjunk87N0m8SNFOu9HGS6bKRpc5RLl2shpHJgizmGas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhq69jIhXOGqWDhmTVf5IGIEFzEbdqcpCyeN2RPGm5LA&oe=6AEB44BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7sbtsMFf9UQ7kNvwGLq9ex&_nc_oc=Adr-A2icHaq2BxkCKvHdDSKtkmf0jR4ezd29rzvOh5mXAavfmjScHre7KuI-uUYjih8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6HlNn6UqGcImJc60BVWVroKbsnDDflU5E05RSigwVhw&oe=6AEB5F8F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TMRpjPfQ4cQ7kNvwFulye5&_nc_oc=AdoLtue_kULlkNO-JGFvqLTjBJ_DhSVF6JKcmp_TR6x9E2qe5ZiRFB1EgUMT5oCOfVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStBmGxlyKEr2WNBkgb6KQDgEEA_ODZ0GFrwRdlQU2MDQ&oe=6AEB5B41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKRPouKAa7UQ7kNvwEo0EZ3&_
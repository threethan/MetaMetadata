?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-ZBL_LE48QQ7kNvwFZBTlY&_nc_oc=AdreZ3bzpWJdfOJGQ-oeqlDiQ_cXWHo3q7TUuIQuTUEaBFRS2ghzRV6eI2GeW07jKhg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcOsvVLivTcqlmA_eqfHWcQRXJSUK-oE1FZgJWMfEU9Q&oe=6AB67A0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uepR8i4thjoQ7kNvwF0nH0W&_nc_oc=AdoLxAYV2AtKeyvxeAuAr4o7pUVnsBWA6H1bW6MA67OPh8Xnc8CAuL2RAnvvJZmmE7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4L2fWtYUNbiIFczciN9cU3YQ4y5o7fiVgAk6PW3pepg&oe=6AB68B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQC4vAEhQbEQ7kNvwGOAJth&_nc_oc=AdoFDatEy6VKatkN2_ak22VDXZCzTWVtJB9U-OiYA5nZ6P213av-ONcMs8Jhq7zk1m8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKghSTraqGTdk0TNRwPiUrf4k6b26HaXqkKaTrfL_Qonw&oe=6AB688BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9drgqVLnCAQ7kNvwFmlLhv&_nc_oc=AdprKoY40AWFjvbjlde6OI9Vi27fBgS1HG6oJOMaJ_vbVSh9iiza3syQZ4eiYzmj9Nw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEqTKOz2LC9-nMAl5ecf_anx2AtHwqVf82I5XBAvsNzQ&oe=6AB66B4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVDH-ub-aL8Q7kNvwHsYq10&_nc_oc=Adr_V16IIuFwvHr3ZWGV0oRpuIp6Vo8-iRUzpRmQfctG723bMGaDLvkEvULZh89qpAo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxa950BqU4MnrWyQrB6v7yV6jbrNnhqo5mLP4G96WkUA&oe=6AB66701"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD-WR2D-NSoQ7kNvwFToQwa&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzbuRDwrZ54Q7kNvwGrOue_&_nc_oc=AdpBRq_X0LmBHapS8MazjTKdp0KgT1tnrc9C0g65CTIjbdKkSJoz9gORzFr1Iz73X8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LPPPdGpQQbe4tRLyjYFDCnD-_ym3XxjUS0PR41wBgMw&oe=6A25750D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4MFx3zc5_PcQ7kNvwGWYVhA&_nc_oc=AdoFKHbLZQVy0bDOR-stp_UYDTdyYRQtJYOnGesCdDfWKPIA0TIrGzkKzXkbX7IWqbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uQGC21geIXBuAOZoWhHStIIhe4knFctTEdhOo84_IGg&oe=6A258603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NROoEQ0A-U8Q7kNvwF0LrZr&_nc_oc=Adq42pSBWJoZXEOeFQrsxh6t0CxLwslslb39l4Z_yzI5-oLiz1ymWqQnHmzmE-5mysM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YA7Adw_pQwZl4-w0-GkieZH1OtfPhSEHBPZWhgeKHSw&oe=6A2583BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fk8J73ADcEgQ7kNvwG3eVY7&_nc_oc=AdpjFJ08a0pfYlcmIUjx9m41JnrdE24APa3SFvG8Wz7yFuBqEN9xtPjy3BGbkfPIpEA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c6YOKgRFSRzywuZkOr24XdSuXy_uwslrHJcG3DlRZvg&oe=6A259E8F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFW3Tg5PLN0Q7kNvwG_G1ts&_nc_oc=Adra-F4fJ2sWKp6Xw3wIJHiZkXYx_5EL88RELP6qpsACHtpoajcMJnbJVrObVlhNCu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nrECRRPoiZBNSAFocvcJ53wGyqEd48nsmmvk0pUA3Rw&oe=6A259A41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EKWS9HG0RgQ7kNvwGt_-em&_
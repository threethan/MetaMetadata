?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzRZpRKrFn8Q7kNvwEdSvef&_nc_oc=Adoj2AHOpoCEE2Yg1zotlJjCnRBc_LsylAQBUytWoq64A_0pRMiZY0hm14rkNnAnsaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lkGeSyDBPnVKmYH11--JZmppcK8T4oO31zHxn8Kn3AA&oe=69DBA10D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKBLT5N6RsgQ7kNvwEEuCOA&_nc_oc=AdrTAT6gDHeCUcJJVyybUHyC_5tP8DjPPrfcCZK9JThfgk-BOgr4kK4Cb336GgWdS2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KiQm19cgaiM08ozOQcm_MFnKdQdqg581QfhPhHwPZGg&oe=69DB79C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRxXNuf4DRMQ7kNvwHe92BE&_nc_oc=AdoNhMms7Hfpn47sd-S8gz-nA4duKnpu0D1_SBBPBe_lzzbZcx23HVedp_7YMd8yxF8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PmeQ8Apt7yUg8yM6dxxdnkzfolyyxi2e5WGnJvEToIQ&oe=69DBAFBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZOUT5Usu90Q7kNvwFPyGju&_nc_oc=AdpEs1WXDfm6QogyC9xv5u07nioN59NUbQgz3zk1NYKLlx7upyYZIRAoskNuvSYd7Yc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ttAC21qVbldEGi0OL5amb5Qmp_s171aWlhgSaiIMl7w&oe=69DB924F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIThXnQ6n4MQ7kNvwGzVOBH&_nc_oc=AdoOK3ewbL1jpEkivz2rA9SwtBz5K2XagSvmMvMmylokFD1leRumhgQ_UzR3mWQo4VE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2swv9IYLhDJHR8EOrVizxCr3jOv1HcmH5V4kswZh73-w&oe=69DB8E01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGYUQzmdyVUQ7kNvwEKq1Qe&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnoIsbzASdwQ7kNvwGO4jso&_nc_oc=AdqLo3eGsYQoCaYveiEO5oYSLYYfTioDuPb2BE48veFGKHnP1eG587KDn6Ai-NIkcEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXKdNrRP99uSki9095W6M66NTLaZ5IxikMIKc3geMkbw&oe=6AF89D4D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQkzPEjszqMQ7kNvwHaL_5D&_nc_oc=Adq2_R0zoTDy1RYSOHnMx5YQgCO3RnzstW-1_MFLhdOaQmH17WuuzUvVGNrA08DSISk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEfIuvnDrheZMmv_Bl8cjswqOL2uNsf9cf3rvPyAO7ZA&oe=6AF87603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mE1we-n3zx0Q7kNvwET-5qr&_nc_oc=Adr_OtZeVYcsxABjkmOB80Uy5pscPuYmPRvrkfJscMrsPNARYIK7cflZeFw4etA6tJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_UAooZiEwWDKDVU0MBo2DUkHO1BtnKmMd70E8rSJiaw&oe=6AF8ABFD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0u-1J6JVBxEQ7kNvwHxLGUr&_nc_oc=AdoYW4HfhKYrIzfD4BZxSoowhcmeNy4wV1aquv1nzWqufLORz_YFtVP5yObKcbiPdjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_JOXnRETVUF7VDKyKDvc34c1Z9fX6m0XH2bpKs66E5g&oe=6AF88E8F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBMLvASxyxQQ7kNvwGtGAXM&_nc_oc=AdpDKWxqs7yPasEEc9D_z_BVKk8VmRtzXK32d2DnaX_1B9H23mI9FAexSVqAS7dsKmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTc-a6fYsjgTbBTXksLtno50iRlQDtENqto4cETKL-BQ&oe=6AF88A41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WIlAezXFahwQ7kNvwGgbI7Z&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MmVQTIlP5UQ7kNvwFSWXWG&_nc_oc=AdrKKZbLBBwuzaubAUk3xdpgi5PfBKtSF-OB9ab-l9g0_qnl5giiWaAeRAr8Qvz6kLQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmqn2W1AHxYA2P2nNIB665RvrblK8HfEmSCAalqYS3vw&oe=6AEC878D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR6P8vgJfGQQ7kNvwFDrxB1&_nc_oc=AdoY5aBtYXzEYZXeZJU-Nrdu_DzLNgfS6vGzZMPmJm1N9GTdX2ZzVT161bVLjqm0I6c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROqSGOhnqxLQjF56Tnlv5ZHwpbkxmiekGDC8-ctDzVVA&oe=6AEC9883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPMhlsXJOIwQ7kNvwHJ8kjH&_nc_oc=AdrruOorJAR0GJh71hamBTbCtoHrgMoK-0ZVeld4dpVA1YQPg_1CFxHqvojMFKyy0x8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5M6LJkZq3b1MQ604tcXL-UFIkNAn17fb8VTTeGKVK7w&oe=6AEC963D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7sbtsMFf9UQ7kNvwHtzOsb&_nc_oc=AdoeK0j0Dp_3rScRTCQ71efmVBGzIbqd9fBLf9QHpPLnrlCP_DOKZkMR2h-Bxb7wzFo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4Uz6WTGL9Ue1EERlJouRP1J4-3bkNnLpd4xkUrpqCkA&oe=6AECB10F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TMRpjPfQ4cQ7kNvwG4XNn2&_nc_oc=Adq8Bh2EMHKJEd7ohxUHwQ0nTgfKv8YVPx7RPc8Y5jpirBEI_7ro6SF-2-h_WBAMiYo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxJCOAmYEY4WgZEy7cIhwh60nPPbBEmon1p-HVr8jm4w&oe=6AECACC1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbVmuYQlgTsQ7kNvwETFccj&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-ZBL_LE48QQ7kNvwHbthqr&_nc_oc=AdrGlnOXT1AwzsmMpn4yB3gzRg7pAofqPO792n9xN_vqCDLqgEH77pVd0E_paL9jlyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkPid3V9g4pwDb12eei0inRgxY0ibsuclbz3OoZouPgQ&oe=6AB3D70D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylruCKeEd0QQ7kNvwEHQWw8&_nc_oc=AdojyyqqOMGCVr7-p3bo_EJwQsJtT8jft0a5fKrHc2WiBM8loMsVpt0xa8FjAnCQTO4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJW8nIy9fLt0xuTAmyM4GdCc2K721-5t6z1z8SGctlJA&oe=6AB3E803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9QkYsg8iKQQ7kNvwFL48WS&_nc_oc=AdqbGWQoO527hvcZlzGZ1UforFw-8SHtun1vxCLIacJ1AHOn3LLpTe6Idv48dyi6uH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwVdZtI_sfXjAUsx_BcwfdGfzkZv-iAcZfT9STcmvzug&oe=6AB3E5BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kHd17gqltoQ7kNvwGlf8vG&_nc_oc=AdqbfT1gYMQvNv1IsPqDwtovAsk1nGWe1hAPenSSr6_LDAH9smglAuWeFLP1o5txbCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKcrTAn3e-ZOPDqelZIGoIvQdWA6KttrdpX6vO6qYCJQ&oe=6AB3C84F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2JL4xHUQGUQ7kNvwGv5W0k&_nc_oc=AdrBT_gJ_NDCq4pzlYOv6MehU7kcsxmHK-Vmeuy7diR_kEC5fImOsgx0w9TXiiRaII0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImlqwuVuctz7Bs5zu68lXOwSU8c9PZzFecT8SjOa7UIw&oe=6AB3C401"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYri1WDkGXcQ7kNvwE5CxHN&_
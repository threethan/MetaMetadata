?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWYJDh1ll1kQ7kNvwGXBO7j&_nc_oc=AdqQLK0F733-AWaowNvk6f-hNWDLyLFvQI4rKOSX7aAvjBVj16PDx7lH6W9otMGK63g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAjklfkIpPLO_uSMSlL_h89Gv678wFBwpXGjuqoXXcBQ&oe=6ACA78CD"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyR3mjM8XdkQ7kNvwEPbvht&_nc_oc=Adr4-UIlWtL4S2GBexImC1tQN9YAWEOi7z_T0Os-3gm7X4TNx1ZA0MuDcDgy55ksyMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjz-kK6QScoAYnjiE_KnwfR3TApbj6QODr0bU4nN1nYQ&oe=6ACA5183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG2UxzRNJKUQ7kNvwHujBkC&_nc_oc=AdrJWbIhBOdIiyEyUI3EdBYCNa36tWNB-seg7Zp6XwYi6tp2VFLhLgkRGPY1WCx9UDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-2HSAFXaNd80QK3MHH1AAjzjbBK7ADSMgqgNUwWLrcg&oe=6ACA4F3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJr7fbNmcEkQ7kNvwFGfcC5&_nc_oc=AdqEq2BDqnVPLvAphnLLsM6qq06guh70Sg959PDNo66ccGwCO_RvuvEhbyisxSFu2fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6JdPplwzodHbSrvCvCMbOXTFMRSywoRhsg-ktgj86hg&oe=6ACA6A0F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZM7MAdHQJ0Q7kNvwGk7cqQ&_nc_oc=Ado1uGI_yhbLiyKXuNegidh_Q7IIAEe0FwgCoELi3S2SjFj7R7Lo4uAIIKSLR3bCFZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNZplXVhKxSCRU9XEICA--b5EZd_pVmruYvcPZ1bOrrA&oe=6ACA65C1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLwBbO2M4BkQ7kNvwGyRuj-&_
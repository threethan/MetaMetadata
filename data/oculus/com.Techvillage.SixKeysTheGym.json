?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaoTAGd9uxUQ7kNvwF4KKIF&_nc_oc=AdrBZrzmHKtYwlt2m36scHzCq6IeL9J0NKqiRbM-AImblxp2ZqOuK3GtmAJvtlPBidQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG71ZKHnkZYFo6drLTjWuf_Zn_dlXJDhRADc5cNvCrTkw&oe=6A75E08D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F07CcP7wrsQ7kNvwH5zyvW&_nc_oc=Adr6PsnamPUbnysl9I_B7w4_ACvd4DGYN_2MQXNVPXUcBS7wb1vYKzr4dmqyOssJV1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5AI2gSSHQAkZedZVzOvr_CJtBwR_KOtmk_jqGAcSlVQ&oe=6A75F183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZeOTy6XXb0Q7kNvwGvNCSu&_nc_oc=AdoyNQ9agXlr1czKfFrIfLeR3AwUmli8wIGUKKzZiEa2YSc_tN8zcR_CeYNfBWgDYBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwkQg7rJYPII0xMAUfqZ3RWgHscOhT7s8x2VePDKDrwQ&oe=6A75EF3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv-Qdw_gJXsQ7kNvwHMVuHJ&_nc_oc=AdpvuAEtZV9D6KLC-S4bZ2KrWboIcetM99orL9oM2bUTcBixQWOSXgrdInCZ62JVp98&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDne5wQO0x9t2bN_aMevFazEHFEyVPaa5TUZ-yGXMyRQ&oe=6A75D1CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tf2Gd9ssjsQ7kNvwHo575k&_nc_oc=AdqQnAv-y2hBJw1Le4kHECwbckh5o5aPaMmAk3I5affDDhrvKdSYKZ1hj396eZE7NRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIWGHie-oQbK8VIIyOenMFuuo-AeqkXxkt2TL-jh4lYw&oe=6A75CD81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-mr6iRtyosQ7kNvwEyVz3t&_
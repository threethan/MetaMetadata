?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGrORyMLEeAQ7kNvwGg96XV&_nc_oc=Adp2IwZDKbKY0itM8-cYJVqAQdlr_e0ipRl508QUCFRL3k_H4PCv-VQcwXk81Nyejxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdmFN6HCiAHEgjm-XeKy8rZDPuE-gkCiXkiccyiaP0Pw&oe=6AC2578D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMuW_7E3AzEQ7kNvwGEccd7&_nc_oc=Adrqu0qjUNSZf6GX6gWhZX2rh3Op366kZU19VOMQqLyQrv1kgLom4BUhibj-CkN4U6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb9LzubE66IM5OoGwk0y3BmQBkNM5MeeUgoCJuJ6vELA&oe=6AC26883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKvyq5y6S0QQ7kNvwGV_llO&_nc_oc=AdpysvEVxObRNTt2x6jAiD-KNPfzlO4fVN8-DPJvJG8NMBKqQ0L8AhmxswdCLvEi0_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEH1meYA6GL0BtImhJa5vFT1SK5LRyxzve5z-Ro4houg&oe=6AC2663D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JOSmA4UlCsQ7kNvwG4SqVY&_nc_oc=Adp90w9cYD_n52UChO4VYhp4_D70Y2K5HZmfmDHYPLifc0_DR-LNAXxp0oNCqVQsMqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfMMt9suSHS1aPO0yHyNPvkxMam8aq1SIVCwi7ARnAiw&oe=6AC2810F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3ypyW7NY5wQ7kNvwHQ1JOm&_nc_oc=AdqliX2NOBGqCKhCdmO8mbThJZcSiV0VBBSLMgXNlXgm3hU_BHE3sGLR_nCY2FMUnPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkkzPUWXOpxk6j0r2H5-wZmc49fThIQ48AhFP5jHYNmg&oe=6AC27CC1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2mWLe73sjmcQ7kNvwGqL2Ay&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nndnUXPCqEEQ7kNvwGcvysp&_nc_oc=Adrqo91_4J6dCefmCCfZbf2RR8DbzI51shGp95U4zcReHOE1WOIQaPQypmJvyEbUy0A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6pajA3ICefqmoSzwJbS0zW8idJ-gJowH0i7rdwIZ_NQ&oe=6ACE350D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdT9aVJO7oMQ7kNvwFDnDuu&_nc_oc=Adq43kaRBA7cMZxHTftgrMj6s033_nMXTIUpH_YEjou38UP2CN4CS5-6ocpplThHYxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYVfgUyEGATP9NHOsK23ArG-9r44qMBzvdUdi5MIN9yA&oe=6ACE4603"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cXxSlFX2QUQ7kNvwFrbs0Q&_nc_oc=AdrJGEIFO0dF5Zrdh3BO1obQthV-mXxkPDp48SQH23IyOxpUmUuHZ2cDQtdUfXVcTZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCqQDqVvrI_yNGGXcV-1WdWag4qJskU7v6cKD0Uxm_Hg&oe=6ACE43BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRvGllRk3GUQ7kNvwF8mkHE&_nc_oc=AdrFjgTEfQVIVnyMoqBLHMG2GfW8gWDYTJ8SGy4pt_leKcQaJ7XwbSpNvUD4DJ9ydCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn-4wqA_hAFPx-6zIWNr8Bzd7v2_-ATYOdLij71JYhww&oe=6ACE5E8F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD0xRMYeDWEQ7kNvwEi04r0&_nc_oc=AdrSW0D_YunzliwF0YxLrdWQqZPUKd2d3RKVvV-tKhunUhgviEGR0Ey5UEaZxaFZ8Po&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7uGEGyC2dngJBclkfPD13eORowvPgc6TGbaiV1wI6Ug&oe=6ACE5A41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rMdSkhhq1YQ7kNvwFPpim3&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxAVUBz9rpEQ7kNvwF7HioE&_nc_oc=AdriJz6alrvRqo-j6UwYmaQ1LGQ4qX721cJlbU2aVUxu4I6VVl8Od2QuTAIyWBUzjFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WX6bQU1hWeybHjldHobW1iPfq4tyYBLuJsFv6TNA_Gg&oe=6A37EA0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjCoXQk9SX8Q7kNvwEGcpIM&_nc_oc=AdrJZoBZOInR4C9RM4vp0JhUCcQihGA18MtMwKyRV5xlDuXGq9npsv824QWbzeuObcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DxhhFm-acWi1QXB_jVBjMWuSf_wyVYGs8T1rZxQ23Wg&oe=6A37FB03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12vhV6bITtoQ7kNvwH01n-_&_nc_oc=Adrlxj4k-0p9BUJp80miCofiuadMFgVLCvgZmRsZh738WTuvuOLKVDQAfNopBTSx2R4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g5tbXp5ZyQ3V9qCrN-xck0wlnKeoqSKAEQ_XIHu2s6w&oe=6A37F8BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fI-zt9Aa0G4Q7kNvwHYAb-s&_nc_oc=AdpZynWE9st79cCOhOrm0fzkY2ZiAObde-4HkISU9UjGXY7wvGaxAu8M3HR9_fNKydQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jf6-Lvi7gQYST4cISJzAJnBCVgnSD9FNox8FKw9gqhg&oe=6A38138F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nU8BRvFUTCMQ7kNvwEnq-RA&_nc_oc=AdqnJWXA5qSr-D2uT7Nb9tQnw1peu4lJzV8LY2XdEh-MHvjhUwgokRxRzMTCaPBus9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4uZ_q5kK-QQM-vp9Ll9CLOVRKB-F3MDp7dRrz8dlwZw&oe=6A380F41"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayGHN06OA9EQ7kNvwGWuP_c&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnrtoAfII2AQ7kNvwF_DAVm&_nc_oc=AdqIXEPVC--xiYsXPyTS3EYi-0qxEuVIbeYW-4RV_hNvXG5MwWdt0CXP0YUAgbHmCvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mzJGKy-OicIFHWiewxSG8-OBT-q0hIAdMUbRi7Y0cCA&oe=69E38A0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDMjl-ieuFsQ7kNvwEQ9h1Q&_nc_oc=Adr3mcKrgtqNumzX7ulkzhdT0Op8T65LOHA6Ef6_V-sc2QmQnHjQKYiSXN3X40MQjsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3myMUxdgVuv5jcr342_JQMI4KFuBjbsWbkmH5tA2AQdg&oe=69E39B03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7_uFRW_pN4Q7kNvwGyf53G&_nc_oc=Adr6CxrSE1fJcXrvS12HShHqkj9uZuIu7OiXmPN7euTQTXeerRSzzifTiUzd4Ng4EHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PzS6i-N_y_QvWYjYoHDTiy5RVEowqbfEDxwc2_7eRtw&oe=69E398BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrU0kSqv8bYQ7kNvwHpn8ky&_nc_oc=AdpnNKxQYoeL6hQoAn1rLOSK5idBb6IFziirIMe6TOoys7smDH9EYgMqI_Bjj0fkcY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11jUEO8cL0mc8ShWdvtn0jDIDIZ_ZQ8URLlA5p2SGMcw&oe=69E37B4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wvt2_KwKC-UQ7kNvwHRbS6x&_nc_oc=AdpZTvFZHKr9D28MgzIJ4674cSJhTCT1B3VLM_h0PoJlyosX3PXBCLduUSHUV7IWBS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1c8Vke-UxQ-z0jPqMecX2NPPiygSnQQzsDaRIUihHIKQ&oe=69E37701"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0gQRa2BAVJwQ7kNvwEekPPV&_
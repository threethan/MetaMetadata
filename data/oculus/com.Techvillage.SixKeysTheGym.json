?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY7wrGgj9usQ7kNvwGOIsjW&_nc_oc=AdrYsfUUW9B2DYSxLQ-bIX9pKUv7JPU-AzoRziPyWSjk_IvF0IkDUA2LRVkpypw41Qk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvVQMHRU1RbmJb4GbE4OEZQ7v2ruwHJHw8IdEfOfnvOA&oe=6A4A5F0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hC_3eYAWE4Q7kNvwE9K1hF&_nc_oc=Adr8WWwn0CXvDYc88eaYpe_3DdGZG6NuNHoPmzrGRtdUmx2yIoX8fAhwjH3_AxWE32I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAayOpXVrwlXkNFuN4TCWTQQN9Wh5Z2VYETXY778NVbzw&oe=6A4A7003"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19agfgXfQDoQ7kNvwEa0Ig0&_nc_oc=AdpFzIwa_37BgmOAwBvzUHcPEQgSlEojMdzm_yLU-jcyhHfbhRcSV0EQ65wf29xgjJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8jH4x5EUO9-SlXNr-UABfTOAlItoyux8jJeH2fLu4mA&oe=6A4A6DBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgA1Y_9swwsQ7kNvwFAl3Bg&_nc_oc=AdoTTv5NyNLidD20hulqwanfIhhWlgPJJxuhSd6Skfqd0Fe9JUj72995ZH_XekqlXkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAnoqq-CEvjnJyIpRZy4zTCVoEA8fzr9TRI9aOMTj0KQ&oe=6A4A504F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaDkf9oVCeEQ7kNvwFJsc6B&_nc_oc=AdrPnjhzg3HaGB9xUBFe3wf2v-dhKoVE60zSGexS0xfxGuQtykrFYDyP5vC1Q7nMA4A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD8QxM73ciDsCUO06VQeFI9dDrxwAohSeh9ezYc8Df0g&oe=6A4A8441"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbeT_5xsn14Q7kNvwEGNxzj&_
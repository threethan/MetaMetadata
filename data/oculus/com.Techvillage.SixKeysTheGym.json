?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sY6nTcPIcYQ7kNvwFpuvZa&_nc_oc=AdrJ7Hhvi935DzRMZ512gEuSc5aaKJK82zotCrFNuQLoFrkXBeNPD7W7y8c4KxaKM0Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOQrYEeq1huyLsQOoHHelxYVfAQIXBUaX3tngCotbntw&oe=69C2948D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EyM_ebfiZg0Q7kNvwGy7pZH&_nc_oc=Ado_M8YFtrG86CsSHbNy5_onOxhJGJATKZY116IbyTu6fHhBj03KW2f9MP0BlwFFFsI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7ceLflLb2XuE6aGT6h3YUeTwomVh6GQU70O3Cl2en2Q&oe=69C26D43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTvgrpxUzpAQ7kNvwE8mSez&_nc_oc=Adptl1bReK4nMfy4aNtpqOQX5jNGFCys31Fbqh3iAwMbBIVkDuGPz2jjS9PxY51HBvQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkAgetHASZ7pMJKC2u2wOSHP0c2x8NOuR_PVLKepXlHQ&oe=69C26AFD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzPWZCNPDDwQ7kNvwFg2YEL&_nc_oc=AdqkoSK9t3DikYrqJoP4oOQdxd3LBhddmaIUpKujH85vK2BAlNkx5FWApFJcM80mLd4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhMhimVWg-UQnjHoj5IwWQP0VcA8Mby4RuA_kX-cXO4A&oe=69C285CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZRgPpGwOKUQ7kNvwFPI3KJ&_nc_oc=AdpfyQvwDF48McNT_vpK5JiNNbDsFPzjkC0m8gmNaz4acKubkY9MVntuaCHuDQrrd8s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylCbVOHvvhzmpRUDjWFd4jv-HIxXnIWnIakezRsWZG_Q&oe=69C28181"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y87_OC5EmF0Q7kNvwEpW3S_&_
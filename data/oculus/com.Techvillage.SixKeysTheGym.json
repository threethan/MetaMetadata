?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRIduwJUw70Q7kNvwGqPAfZ&_nc_oc=Ado4P2slZa2_-KPAie3hifPwV_Fy4w21AHEP_QTQKlu9AmmCI02PoM3fjOpquTZ3MHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPhBLn1kvT2UfJmp_-xi0eCSXg7Y2x0rj2WuofeXryUg&oe=6AE9E48D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD9IlBqErXQQ7kNvwFH-RN_&_nc_oc=AdoFi3VsCB7a98gKgcxKrLla0AWA953iWVlVr0-wN-qbjdGHLaMQDXIveaSIbAAX8Zk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0XMh0O18HOBhaerJ7Rn8plwwU9r23kooHKoocBZXS0Q&oe=6AE9F583"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPMhlsXJOIwQ7kNvwGHpJt9&_nc_oc=AdqfDZS4JgSKgHMn2l_b4B94hxoQtr6NZ2j9rZX4ur4SeJpkCI0h9u0JUKw4D07lAos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxmM2apXphED4Z5qD_WdmWJTEVs5yK6SWyG_aZ-gsCAg&oe=6AE9F33D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7sbtsMFf9UQ7kNvwFos4zd&_nc_oc=Adr0ukc2VLKAAl-4aFMZe2HcF_xwTMap6vNYbNE7tpc5fM0Av2OS6h1OYAWC17qfUMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0HblId7_zaX1AzXRGdaA51qNqh-feV-b4aFe-lDSvqA&oe=6AEA0E0F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TMRpjPfQ4cQ7kNvwFvyK5S&_nc_oc=AdofM9g6tvRcUXNal2bEsd4k1YPsAuFdAXEajmpRDkIS4GgV7jHD_FJDsbS4NLvqyvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6LfXlgUN8DlKpH9kP2tsFqixXZpIw4anVpET1hAooAw&oe=6AEA09C1"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKRPouKAa7UQ7kNvwHEwj8B&_
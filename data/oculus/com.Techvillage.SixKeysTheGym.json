?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFVjI1ycoZQQ7kNvwHhKj--&_nc_oc=AdoF4X6peoERRciE41Cac-OhgsTCm4GvPe8FH_Oxrv9yKf8QdKuvDCl-wNicDpG-7sM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ndV3aeWtprL319botR1H3YwwyUOkB_-hH4lhqsiNveQ&oe=6A42760D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldwniLb8YUgQ7kNvwGoUNHd&_nc_oc=AdpfYbsjvzEL8DZcZdvpVNYfxYbDSXxAJbnAuJz_Zon1AC9axF4dkfIOLzTqmj1saec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98C_lh1b0x_W0H5jolQE0AX6uPOYas2BxXXdB8vN6BFg&oe=6A428703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od6hPZT7iGIQ7kNvwEdDJ-S&_nc_oc=AdoO39yJ-zb_iJ5yfZB2KPZelS6OslgS110J4dKCZXxAIkMR3RPwFbs0uN88fsicX_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F4sqjWxWqTDdEBqN07DBPPuVmnGsRlag_jON4JW8HJw&oe=6A4284BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxNh1Cwy1yQQ7kNvwHBTJws&_nc_oc=Ado4xQz-Xs3V9UNgVOmDo4g1T6gQpxhlAJKmybSbH5F-q2rBLLBSvXYWGHuk3v5Q_zU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GjTKKeC16hor4Je4BAOMqZTu8PQIUuPrOUeTacqKG7g&oe=6A42674F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfrHNu96yR8Q7kNvwGgov4i&_nc_oc=Ado4ZvncpXT7PmJqS4RIUCeeOyghnNubCB4s6fVdxTCHz-Ia8vUucfI2vJqlNi_Atno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-zA4VoMg_zSRkciRgxaDxep2UfdbE-SEWMO3_Al8d_g&oe=6A426301"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGroZ0iMJYIQ7kNvwGMavPk&_
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhxAZNsWPq8Q7kNvwHL1XlH&_nc_oc=AdpP0kq9NttYHX-PSGyU0f2L1alTqOpaOlEmjshsuIGWIpQ6qtW89E8k-lL3HwsJnjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-6L6ywLiKrQG6EFgf26tQd1g6t0PjuxYcacQFzXqoxA&oe=6A68B18D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nBn4e-eZD8Q7kNvwHihNg-&_nc_oc=AdrreiRIhKM-DabMk1n25uEJsErogTooZXx1p1n3zYVym3en2sa0lhNCYEzDV5AXF6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn8gnwknysqHTXYXYTDbNZDq40DBuxUjLV80RImsQ8qQ&oe=6A68C283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz98OBm5ne0Q7kNvwFC7W9q&_nc_oc=AdpHItl7xlsaCXON3V0xzFS2hor7DcF2BoMWY1CPHvc3XqdBKyCRF8h-h5fIf5E2z4Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFOJ33JhT9aqLCqy9hy6C-65g1CRryRx9j9rdPnstgbQ&oe=6A68C03D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hiry6oR_uMQ7kNvwHKWka8&_nc_oc=AdqDpgOiZAXkjB-XI--hmgpSQ0_IIlvFtoMieFui9ciJse1Oj-WkcAdiuMByskVYyJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGWK2IrJLRGsraT21HZmBpxVm2rXA6LvwyIhJfSaytig&oe=6A68A2CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czheDcNXeAEQ7kNvwHXdLL_&_nc_oc=AdoVz5vm7BmocY7HAMNG5X0aNu5PjKK6Ogs71eiTZUzBcdUEv2mr4EACQkA1RtMvpsM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsMTpWxJq4NprkSrOAoQJLKjgiWzygAl3TA3kUvwzl-A&oe=6A689E81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQyFwOWhgeoQ7kNvwEck0Ko&_
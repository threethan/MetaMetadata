?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8FfhIWk-hIQ7kNvwEpaStG&_nc_oc=AdqNPVT-rjkdcnIb7ycTEsXF0Uh0cAVlfZ9Ul_8Q8DIYQ6gEmxaELjEYoZYwLL3nntU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUMJ6UAcxZIkR0fWn8dD_3kXUWiIgBgKMMeaf0GBjzcg&oe=6AABEE0D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bp5oI74A-9kQ7kNvwHSDDxy&_nc_oc=Adpaz6WW6_muKZ627d6rJFDoeouFDHCK9BLPvAklF8zA7rsxo7oxoZaTQJqu5TKaSHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDhw7HGopTeXzGM_EuNSCatmfcqVU-ifiyuNHJIyVh2g&oe=6AABFF03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=614DKmcugdEQ7kNvwF_oVQt&_nc_oc=AdqEjvD5ylH8224BNJ8D-whNpG78lAEZN6lAlZ5J5mUFq7oTcOqHU0W1V0gSdYV-DDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFPvNfCVtabLPgY-lF2vXBZKaw_s8179KhNe-PIUnLYA&oe=6AABFCBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj-dU6eOMzoQ7kNvwFp7b22&_nc_oc=Adr7GlbvdD-6RG6hgzX8SjPqOfqoo1oEiyX7JF1kLfD9Dti_Wryza6VALwnAwuWQfek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISp62Vimf05vCi7TVmP8d7H2k6MFJUwGO6eDLmess9pw&oe=6AABDF4F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHi_-0SbGBwQ7kNvwG1NSfU&_nc_oc=AdqqmHv5QTPC7LlSnVPEFiWe7McTAsZR3lF1fEfvk48pa6iYAL0YB1wPo5r3RckZFGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFs9pW18LFRr81RV3FDz6i7wQ2vSDaod9FBT_jMBHEww&oe=6AABDB01"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USk6qb47JTgQ7kNvwGiTUqv&_
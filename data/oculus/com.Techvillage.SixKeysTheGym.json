?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM-lNLNHuJQQ7kNvwGepKKg&_nc_oc=AdqYTMx3QGT046sbq8TjZBdCITqXxydY42ddkYTrwVUVKFZKxmIrIBztJjnTDx1aymU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wo9F4O0PIou2WnD1w5SsfiXKLqORZC_A7RCA4s-Ocyg&oe=6A30010D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BknpWZVQE_4Q7kNvwE6dnRr&_nc_oc=AdoIaH47ox8g0ewjdk_7JVemCn_PgR7ZXhiJdVNKvg-7CD1rbNb4FmFBAc87BDUXAws&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-de10fNGcG_aIqpQUVSKHylZKPrMS8pciAfGH53IOHsQ&oe=6A301203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1YpkNNkXo8Q7kNvwHwNA_j&_nc_oc=AdqDjBcEp1QEfmuNu3f8R6iOWRoyHYTZRasvgEeFMYTXktI3UTEkQGfLxvucNZEvsys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8thr3VCx6tEhmWgnOWNfPAAT3nu2wAul9Dtk1bzUHqvw&oe=6A300FBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZw2Dte8odgQ7kNvwGapOpg&_nc_oc=AdqplXJ1yURbBTLrkoo-NBlM9DPfZbmHf99F-R2ji2yeVRjxELhaGhYJZCzRcLgEISM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8skQiufQ0WZ153Izlt87wea2pTYOyFolxqn5UUxub3Ig&oe=6A2FF24F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZXbDWlQT5YQ7kNvwH4BINO&_nc_oc=Adp_De9Jrt9L5cqWJa4A9auN2lW3px3SDgEFrjwwjFfsm_r9h43SAl1pS0jdWhLPq8Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jTfrN8eRg2NFQ7SWsWkiy4wQK93sHg-IjLqk-ZROQkw&oe=6A302641"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JaWJCKHXGMQ7kNvwGKqwJg&_
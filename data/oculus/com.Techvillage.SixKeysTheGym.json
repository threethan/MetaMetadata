?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3CUH1mjZ18Q7kNvwHmq3DB&_nc_oc=AdpxZ5O1pIlrLZczDH8Asvy_6jjSGcw2vr9wG8oj8WC2k5QQRD-aSGsMv_-UKw_jHKk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlbPMhy7rMGSftYV5QqI1-jSh3gHYvdWHXRalpjUpxKw&oe=6AE5F00D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hg9WlD7gjhwQ7kNvwFJ8uC-&_nc_oc=AdpzkWlwbCKvcq5FudS5FGTCEv9UufgdevWDnPt1hNBOTe-YerfnKdOIl_wwsv6mm0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlxKsiWQl7Mjcli82dcSuK0wuZ3QJv6RbuAPMiEUBkKg&oe=6AE60103"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNitje99gy8Q7kNvwHMqCTU&_nc_oc=AdoDgjXbAiHukpPyMhjq4HABZJweHy6Sbv-KUhXpUAy1xq8cUYOhaszYVOJpeuRQ6Uo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbdmARdZOqondHjJlRQBY-2nmn73qe2EW3ZJfVrB4P4w&oe=6AE5FEBD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pztp6i8OOngQ7kNvwHF_39D&_nc_oc=AdqmvpGaIJDUQk6D_ogOiFgJX8dSJK_9uSL9cSq7vOoHiHMixRm-jEHqODyOt_kAVWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdVduzaZ-9pp2ZdFsCogepEh9aRqVDo_xBqA47MARIoA&oe=6AE6198F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVrlZw5A-24Q7kNvwGkn4t9&_nc_oc=Adp6aRtRfGM8LDd8ycYF92OSynlcdcOf6P5aTjl_yvqbDUHB9cKyyMpgK00t3CXETUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPerc3Mr2s8jWhfCWYdYHw6ywNHSmrrwAQrp6mX2efFpQ&oe=6AE61541"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZfhkhoPDPAQ7kNvwEH5Lxh&_
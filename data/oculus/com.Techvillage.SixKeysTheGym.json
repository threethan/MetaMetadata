?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3TgEb5jeJMQ7kNvwF2vuMW&_nc_oc=Adr01BahAZCis_1pl6KVOyGvms_NVFvnBlKZS-FwtfjCsRvKxrOSSNfeIzYHkKsWBMk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI-OkQSkd6nNTmf7lc1YD5TSAuX_ObeZDe9BOyMvn7qw&oe=6A903E8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zarXCN3SIssQ7kNvwHNWzq_&_nc_oc=Ado5KfbXvMFFPPgAwyMyBa-_gZFnipyfhne7VL0isdukpi8FsuMeTGaA431e-L1oLCQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzknEmzPwIxSiWIiDGLwk1VTnC-D32O0cmosohn-Iwlg&oe=6A901743"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQJtrBCkrzEQ7kNvwGEPc4Y&_nc_oc=Ado4U8Fu9Isfi45vnSyAE5XzsOWPKs-GTzANS6BZIh9fbOyCEIKKqZ69xW13lPQIIRw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHOPo8QluolPmIFVvL-OVUaXfSJYou0wLyUvElsBqNyg&oe=6A9014FD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xAuXcd_3RIQ7kNvwF2s5IV&_nc_oc=Adpspa0x2Phoqs8lgs9wO213h9hkpBSqLupQR6zcZ1mVvCa6OKPPrSmtVEzlv8rjiB0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhB9KyarvEZXufZTVPQwo0gpwqXx_cSOJIYG3pQzpIxA&oe=6A902FCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeBqf5KOpQAQ7kNvwFau6vo&_nc_oc=AdpSz019aIQD5mL-QLo_HaHs480AO-e08H0fP3IMzLGrthDWTdPXUGuvV0x3Qcltw-8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfyO48vlUqvZzIF67kEbmQ0fXZKex7rqq_Icvdf00ITA&oe=6A902B81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXKr73fEqiEQ7kNvwFwxNsy&_
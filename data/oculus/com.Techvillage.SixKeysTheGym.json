?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRIduwJUw70Q7kNvwGILlOt&_nc_oc=AdpssaNmHnWS4sSQTy-ENpF5LCrNGH91tzp-1I4XL8OwQWl_swQHhM5sxz5fyB1GOP8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPPaRVz5U-Kg81kY74LjKpagJhwX6wXAvIUEXYCKHpsw&oe=6AE8930D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD9IlBqErXQQ7kNvwEkyhzi&_nc_oc=AdoZe4qG8mSnVD61wSrFzNVeezgqHSJe5mpopysDL2R00ctd4ZLuAes6p3sCaGgESiY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp2pKQdfQom37xA7KCGW5xCcXP7vnCkS5h09wLbiQhWw&oe=6AE8A403"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNitje99gy8Q7kNvwEjSmVS&_nc_oc=AdqERsE4b_XEu1lFHfhWbetSE6w9STatudt2jRjIH8XLb4CEVZzovJLuzNLvbHvi_1Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSngG0CSerS0uR6Jx6ub8n8BTmEZAOP3dy3K4fKEO7MaQ&oe=6AE8A1BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pztp6i8OOngQ7kNvwHUx6Ms&_nc_oc=Adpz7qk1CJG91bnUbKtbblDSe5PAv-BI2Bj92QoPXxv25mQUC2cAC4Bz_9nu8vDg08g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREeBLBCKjT591Rs0oEQaggKZgMPFasTkVSW0ED90Y6Vg&oe=6AE8BC8F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVrlZw5A-24Q7kNvwFy9Hn3&_nc_oc=Adrpz_jpQYM4OwXbY8CRXEK6jxd69dGJFUGBsjd2v6DcUD78aodCkmLw40lubEHptIU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCiQ8cloIaASvBmAImvLYvQH51gbp7__Z0HoxNJKosDA&oe=6AE8B841"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKRPouKAa7UQ7kNvwH2OtIt&_
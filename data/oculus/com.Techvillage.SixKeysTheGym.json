?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIlP4R9ctn0Q7kNvwGwh4lg&_nc_oc=Adq6I4pL4mBARz7m5sWX4R3dAuksxDHfSvGUgza8idB4uzqg86dLl69GYjcYaYkCGnY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCRvmXF_RbqGhjTYEwskbx1JcaRBU798UZ_fUCufM3hQ&oe=6A92A94D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJpdLQ6eRMcQ7kNvwEjXvHP&_nc_oc=Adp-MXNYUpyODSsofi-nHHLUTPEiBlg2fBbv2ujH3YEzmfoaJTDd76pp7pHEcQFFZms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHahK7duf-uYvgfQwhVAXxvtsP5HMU5Ua_-GxcQsk6O7g&oe=6A92BA43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcBJKJ6ar5kQ7kNvwGfFdGa&_nc_oc=Adoaj-e05jV7CmfV4UD8FMML6ySJruRTHJH7XUJm3RN2hXXPyAXSjSzFervE1-oH5xU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh_BB5ns4c73P6DZIl5g_KONJmnKY6y7UfEC7UUdTjeQ&oe=6A92B7FD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xAuXcd_3RIQ7kNvwEpSpZo&_nc_oc=Adozd4OLrsb9jabfhRKeKk4EatLWeE9kOu-BbMlKGZShLgTR_HFyXkG9ghXoxTF-cAM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8boWh7tDmbqDdk38FJn6EHp8DSGZ9T6kp1yCARIL8vQ&oe=6A92D2CF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgyjzPiludkQ7kNvwH7Zt-d&_nc_oc=AdpDKo-x2svn00LSKkaiekr6Yt8Do0rCtSh_rMCyRvZ7omqoJIwLlQFKMKbCkIO1Ngw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzlSdvmvvKlgyNqc0JySNYq9yh4BXwm-uHnIQgQYkXNg&oe=6A92CE81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6_aW5q4M5cQ7kNvwGmxMkh&_
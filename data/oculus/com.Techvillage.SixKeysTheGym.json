?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-VystXskDcQ7kNvwE2Q3lk&_nc_oc=Adr7QNpWIRkhOqJnxaq4FZGEboHvDkdO-e22wi6bPpyAzNSfo_CE_b1icgAGe48o4PI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mcmL1pFnUfLrjK5iTOxM2IDZVQFkIZuSKy_kdE7fsXA&oe=6A08740D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCxipC5bLGMQ7kNvwGGzHX_&_nc_oc=AdqkEobRFoDCi34bJC9NQPjpjrITJNWmLLd423y3KdaSuf20bjRFs_3qyL0pqh-7PQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Zh1vv04EYzhUGCRUjiMivFORVlygjLT5MIZlE34lB7Q&oe=6A088503"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w66Y0Yxs0Y4Q7kNvwHSuyOf&_nc_oc=AdpfxQa6oaFnXRdwSRiE4kXCo-Jz8rHxAgzCuDACF9GxQKeZFOkhYUc7QDovw9Yr6XI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AzwTfsYAQ97MyTK5KbN1xMC8l-SQUdvS7Af8BHRWjBw&oe=6A0882BD"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0M1HLz-o-4Q7kNvwEye51V&_nc_oc=AdpqFhXOjICeZkRgSq1Nt_oeFkqIa7u0zK-gmDOdZMOs6VI_EeucU8i9KhgKpE18xk4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i00qJWfu2A10S5TvynPe4a9sSRDDA3Io7TF4FRKnHwQ&oe=6A08654F"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfVL62ha3NYQ7kNvwEn7X2T&_nc_oc=AdqTKnYIxDvR94x23szsD6EZr8-dafglV2teTdoPoEct5UNpwMet3k9LuDNqLdgtlU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yS-gZ2TCJcOB6hFzBHaYYspMZFWTF-Nr8hfiMm05Ong&oe=6A086101"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1xwwa1wTQ8Q7kNvwFMlwpJ&_
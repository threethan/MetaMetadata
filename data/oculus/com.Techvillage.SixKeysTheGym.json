?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtKVKf4VJmUQ7kNvwHHRq-B&_nc_oc=AdrHwjQcZJRbyUyYG7xag7-K304qa6mcdzNVeJ9QshspD1zND0nF1IkkPO26yJaRTB4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35dk5UyiOXun6aGGTVcMiGKMaQeTSIFjWerXjUoewnIg&oe=69E77E8D"}, {"file_name": "5.png", "id": "852983959672391", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75245823_852983963005724_8308404716592818287_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ly-c0mk_-EQ7kNvwGwwrGv&_nc_oc=AdoezoKTFpsIiE0xl4Iqkkw5LEWTvq0nQiKm3AGvg4TdptJLEyUipsLZP3qYOoVhVq0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XYRMGkE7fxFSzUTyJTmBsw9gZ89-IOOWK9NAGVFadRQ&oe=69E78F83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "3508644969437176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_3508644972770509_6975163928662230328_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OuO8wpM6qkQ7kNvwEyqDaC&_nc_oc=Adrei2A5CJnhpaVyKLkXC1AB_G7ilpHLT-zIawx4P7C_a3KodiqvY0e_rL9Bh-O4TzA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13KJtMKLEtEkyEt9VeVbqyS7O1IMpUVoqAajm14aL5vA&oe=69E78D3D"}, "display_name": "6 Keys: The Gym", "keywords": [], "long_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\n1. When playing with Oculus, I recommend setting the volume to 5-6.\n2. I recommend setting the play boundary wide at room scale for immersion.\n\n\n\nDirector's Note\n\nCurrently, up to eight abnormalities are implemented in early access.\nWe plan to release 20 official versions.\n\nSubsequent or DLC plan after full version\n1. 6 Keys: The Hall - Chapter 2\n2. 6 Keys: The ClassRoom - Chapter 3", "short_description": "Recommended: Oculus Quest 3\nMinimum: Oculus Quest 2 (frame drop may occur)\n\nPlease obey the school rules\n\nYou're on key duty in charge of the gym.\nFind and organize the keys scattered in the gym and leave school.\n\nOrganize your keys and organize the phenomena around you together.\n\nListen to it with your ears if you can't see it and look for it with your eyes if you can't hear it.\n\nPlaytime\n15 to 30 minutes\n\nRecommendation setting\nWhen playing with Oculus, We recommend setting the volume to 5-6."}, {"images": {"nodes": [{"file_name": "\ucee4\ubc84 \uc544\ud2b8(1440_1440).png", "id": "1908765469621965", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001714_1908765472955298_8759772823803218131_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnnfPrFHLP4Q7kNvwGDJUQZ&_nc_oc=Adpzr8Ve8IK0adrayN_uFqsSuL9A5Vcy8B2e9L8v7c_Iio9MGNPBcp5Jh8m3BSkysDY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bLFlqyTYkMhw1HylUOIc3o3su3Y57msppO7rWwQp7fw&oe=69E76FCF"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(2560_1440).png", "id": "1795288660878546", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75262742_1795288664211879_7990270388284924546_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0m8hhUUl5QQ7kNvwEf3y4P&_nc_oc=AdpUUKvV_hQKSWc_iyiiviXtxdcN2WXAIpQvUKAzdXvJCyhXd1h2vFZynu9sc8Rc53M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T265uAUQh6plLhkTfLenL4MXpBOcsRg9ty1oV_UXSCA&oe=69E76B81"}, {"file_name": "\ucee4\ubc84 \uc544\ud2b8(3000_900).png", "id": "1418892549066904", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75422387_1418892552400237_994368770006308224_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1gEzbHsxzkQ7kNvwGuMCnr&_
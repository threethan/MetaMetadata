2.oculuscdn.com/v/t64.5771-25/12139502_146639259181873_7792163194365018112_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3v8gvlW9EbwQ7kNvwEdLX5U&_nc_oc=Adp1dfgg7_8zoL5BzspApV6dpixpVV9a2wYCiiH6MDEXiqAfTgJry434CdQIWQqORh4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9dOqE9hFoarH7_gpC_PgzCF6rMuO0k5b6zzUFfVqFlw&oe=6A7DC2CD"}, {"file_name": "migrated_image.png", "id": "2569204743335984", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162823_1827851240761167_2350036968559083520_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmtKckLrTa4Q7kNvwEKqyDZ&_nc_oc=AdoFWgZrLnhGDStiSEMx5CaToEsAyyOCFe-g0JepzfxO6Q54lTnj6q2D0eFxoGhibaw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFz-4g5-9N2d4_CV1NkgDG-Y58lirxjtSl4hGqM2VX1wg&oe=6A7D98DA"}, {"file_name": "migrated_image.png", "id": "570958396840779", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12427537_175173572974206_4389054000637411328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJEu_wgnVkwQ7kNvwGymt6q&_nc_oc=Adryw3PXAw6aZmazhe4swRhBwNot-hV3ixnesYBuC6IiMr__Lr9zNcIYg1PWIbnhjW8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrZV6vTzTZY3hGYcUinoYr7CTLPLzOEPrcAkd5Hb5vhA&oe=6A7DB94C"}, {"file_name": "migrated_image.png", "id": "612217192953195", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12139289_1736157940031344_6249888855537745920_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVfWShTTw6AQ7kNvwExE5ZC&_nc_oc=AdpiiVdg8pI2uCdJBb1HEO1MFoOptojvPxDMU1_zKkdFOvqmEuFLa1Cm2X287P1seTU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxKTeSODhhJ0R-dvD_n9o-U8_4SOz1HRQd6-4Nbui08Q&oe=6A7DC9A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hit the Rabbit", "keywords": ["cartoon", "shooter", "rabbit"], "long_description": "Fight against the most vicious game AI ever created!\nA crazy rabbit has broken into the manor and stolen all the gold. Luckily you, the security guard, managed to lock him up inside. Now all you have to do is locate him, and recover the gold. But be careful; the rabbit is smart and quick, and he becomes ever angrier - and smarter - as time goes by.\n\nMove along the curtains of the manor, using the security cams to locate the rabbit, and use the shotgun to knock him out. Collect as much gold as you can, before the rabbit kills you.\nBe careful! The more you play, the faster and smarter the rabbit becomes.\n\nHow long can you hold against the first AI powered cartoon rabbit?", "short_description": "A crazy rabbit has broken into the manor and stolen all the gold! Luckily you, the security guard, managed to lock him up inside. Now all you have to do is locate him, and recover the gold. But be careful; the rabbit is smart and quick, and he becomes ever angrier - and smarter - as time goes by.\nHow long will you hold against the first AI powered cartoon rabbit?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hittherabbit.com/", "developer_terms_of_service_url": "http://www.hittherabbit.com/", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://www.hittherabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "672407943784675"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12427452_136269586884558_2535193476841078784_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLAo
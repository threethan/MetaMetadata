H7eOspK6y2uMx-Y5fatT7mAaK5p8qSNnfVFwd1ZjNa4Q&oe=6A85A24C"}, {"file_name": "migrated_image.png", "id": "612217192953195", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12139289_1736157940031344_6249888855537745920_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soLcQXo_Wt4Q7kNvwGmosnk&_nc_oc=AdrC2TfosnSXfENbIfpwtdw2Z6sLO_N5qrL8Fl1tlWg8kItlL51eRwqHZOaro2xgI1s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWOL5zPJPSwmhVHcMBmbWhrH5QA8NdSjb5ZDX1Y8iXGA&oe=6A857A68"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hit the Rabbit", "keywords": ["cartoon", "shooter", "rabbit"], "long_description": "Fight against the most vicious game AI ever created!\nA crazy rabbit has broken into the manor and stolen all the gold. Luckily you, the security guard, managed to lock him up inside. Now all you have to do is locate him, and recover the gold. But be careful; the rabbit is smart and quick, and he becomes ever angrier - and smarter - as time goes by.\n\nMove along the curtains of the manor, using the security cams to locate the rabbit, and use the shotgun to knock him out. Collect as much gold as you can, before the rabbit kills you.\nBe careful! The more you play, the faster and smarter the rabbit becomes.\n\nHow long can you hold against the first AI powered cartoon rabbit?", "short_description": "A crazy rabbit has broken into the manor and stolen all the gold! Luckily you, the security guard, managed to lock him up inside. Now all you have to do is locate him, and recover the gold. But be careful; the rabbit is smart and quick, and he becomes ever angrier - and smarter - as time goes by.\nHow long will you hold against the first AI powered cartoon rabbit?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hittherabbit.com/", "developer_terms_of_service_url": "http://www.hittherabbit.com/", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://www.hittherabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "672407943784675"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1409228075774707", "version": "1.3.6"}, "id": "367133590346215", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1391020130928835", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1409228075774707"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1489336152, "id": "1431926060171575", "version": "1.3.7", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1391020130928835", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1409228075774707"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "
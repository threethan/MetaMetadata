": null, "video_trailer_thumbnail": null, "display_name": "Hit the Rabbit", "keywords": ["cartoon", "shooter", "rabbit"], "long_description": "Fight against the most vicious game AI ever created!\nA crazy rabbit has broken into the manor and stolen all the gold. Luckily you, the security guard, managed to lock him up inside. Now all you have to do is locate him, and recover the gold. But be careful; the rabbit is smart and quick, and he becomes ever angrier - and smarter - as time goes by.\n\nMove along the curtains of the manor, using the security cams to locate the rabbit, and use the shotgun to knock him out. Collect as much gold as you can, before the rabbit kills you.\nBe careful! The more you play, the faster and smarter the rabbit becomes.\n\nHow long can you hold against the first AI powered cartoon rabbit?", "short_description": "A crazy rabbit has broken into the manor and stolen all the gold! Luckily you, the security guard, managed to lock him up inside. Now all you have to do is locate him, and recover the gold. But be careful; the rabbit is smart and quick, and he becomes ever angrier - and smarter - as time goes by.\nHow long will you hold against the first AI powered cartoon rabbit?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.hittherabbit.com/", "developer_terms_of_service_url": "http://www.hittherabbit.com/", "publisher_name": "InterUniversal Games", "support_website_url": null, "website_url": "http://www.hittherabbit.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_mo
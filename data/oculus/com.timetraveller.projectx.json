g", "id": "2796354340563363", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_2796354347230029_2502954533365023245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw67zNuTm0MQ7kNvwFJ11DR&_nc_oc=AdqT0RV0iy6_f_3p8mtcTx48mq7kIdGeZNxgBqtrhmrW9ad_oS7QKBjUdA2d1mnjx-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuXdO1BEi8NiB2T9QEfU1R9eqnDeAgqfdrLoq2dgkM9g&oe=6AC12263"}, {"file_name": "3.png", "id": "742659078135537", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820648_742659081468870_6629818489595448037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCu2HO6rv1sQ7kNvwFE-8Dg&_nc_oc=AdqEko58ewC0kYNCulz2OwpMIWjXAiHVxHp9lwr2VT6WF9jV5wf2PpaUUD9S4rFzKtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPCnf_RMx3qQcr73uAhSDQ1ShGp5tj2KRD7ZqG6iSpbA&oe=6AC10E8F"}, {"file_name": "4.png", "id": "754780010413451", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823431_754780013746784_5842422266605109284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjg_w6of8hYQ7kNvwHhJT-Q&_nc_oc=AdoI3L4vzaaKURGpmlROjlp8agkApx1b-fYlotdsGdBbrrefPjcVBe0QVVwo0Zc_F_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPGlt9k7DwuIZ_1H9K0OD3F6lxzFxRK0sjxMd-heeTzA&oe=6AC133B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1856284531904846", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507845837_1856284535238179_3390133055111273766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nLgA-Ey9s4Q7kNvwGAi0p1&_nc_oc=AdrTKbIkNEMLM4g185t7F7O7WvT2hk3qdrNoH1xMrWJR6snx53tIHRIEawVPCFfoVTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGRGUvmLVWUZrGFsE52Ae2XHzkcIZIEr9Sc4n70p8tXQ&oe=6AC1235A"}, "display_name": "Bearly Escape", "keywords": ["action", "shooting", "simulation", "compete", "interactive"], "long_description": "# Ready to break out?\nBearly Escape is a fast-paced VR action adventure where you play as a brave little bear on the run from a not-so-nice scientist. Use your wits, speed, and special abilities to overcome traps and make your great escape!\n\n{1533187364326848}\n\ud83e\uddea **Face off against the mad scientist** \u2013 Watch chaos unfold as a giant gorilla storms the lab, smashing the villain's machines in an epic showdown.\n\n{1251899819777276}\n\ud83d\udc3e  **Stealth and speed matter** \u2013 Caught in the wild? Run, duck, and escape before the scientist\u2019s minions grab you!\n\n{1295287925486591}\n\ud83c\udf81 **Claw your way to freedom** \u2013 Outsmart the twisted claw machine and free your fellow animals from captivity.\n\n{1032878228916662}\n\ud83c\udf32 **Dash through the forest** \u2013 Leap over obstacles, slide under branches, and survive a series of wild chase sequences in lush environments.\n{1072825941021392}\n\n\ud83d\udca5 **Unlock special powers** \u2013 Slam, dash, and claw your way through challenges using unique bear abilities.\n\nBearly Escape combines humor, tension, and creativity in a one-of-a-kind VR experience. It\u2019s cute, chaotic, and completely immersive. Are you bear enough to escape?\n", "short_description": "Bearly Escape is a fast-paced VR action adventure where you play as a brave little bear on the run from a not-so-nice scientist. Use your wits, speed, and special abilities to overcome traps and make your great escape!"}]}, "developer_name": "Time Traveller", "developer_privacy_policy_url": "https://www.timetraveller.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "Time Traveller", "support_website_url": null, "website_url": "https://www.timetraveller.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "STRATEGY"], "has_in_app
scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOC94U1CKKh5iU6QjoYkk9f-9LZrP8lRTgaU1gQ4TQhQ&oe=69C530D1"}, {"file_name": "\u5ba3\u4f20\u56fe5.png", "id": "1176064210854982", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393901_1176064214188315_5791055776969345898_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB5WkcYb-Y0Q7kNvwGi1btW&_nc_oc=AdoLjpTmwSVlfV1OveD71innb4EJvv2jGFonPt0bK59UiFA8TpCABhH0mvRgChW-d7A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyszdDfyVhE1Uikq4My90stwdtnEd3q9P7BZmq22oWAtw&oe=69C51479"}, {"file_name": "\u5ba3\u4f20\u56fe3.png", "id": "1287903762319465", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393450_1287903765652798_3313975889312284138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qPOy42akE8Q7kNvwEbh76L&_nc_oc=Adp6NSrbLR9xwHUeC9kEEi5zc43NfFoPVKzPlywwmdCrhqBfuEe5hosfYbpXJ7iL_i4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_o-R8hu07LXe_MMfxny_YmuaY49LxjTgBnkwla5-E0w&oe=69C53B67"}, {"file_name": "\u5ba3\u4f20\u56fe1.png", "id": "551538804081128", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392010_551538807414461_9150926764574295790_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb9jR1z8Z_sQ7kNvwHR3nIT&_nc_oc=AdqQLDOO5EpWmHuXRCSUyLMStIxaACW3O9O1NsLh9V6dfZaQGPUz_bLnJVDka8rLELU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxA6y2aE_Xpiz6bQPM4w5mnr0OBHMNOaBAEVefDA1o-fw&oe=69C535E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u4e3b\u89c6\u89c92560x1440.png", "id": "1026152272694074", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393491_1026152279360740_983069621863544605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuLX9LUXsy4Q7kNvwEv2d6A&_nc_oc=AdpAdugMeEopZ962EMneWm0WUVaEbXjjAj_ru_iM-kdwQYhapqzERIaDavVdtZ-dF_8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxciZ3ICA0BtDJuxOllwWeancxWjumXNfcGZx7ZLZfUWw&oe=69C53726"}, "display_name": "Bearly Escape", "keywords": [], "long_description": "\ud83d\udc3b **Explore the Dreamlike World of Everwood**\n\nYour loyal dog, Robin, has vanished! Embark on a thrilling journey to track him down through Everwood\u2014a dreamlike world teeming with mystery, danger, and secrets.\n{1811049976105148}\n\n\ud83c\udf32 **Escape Evil\u2019s Clutches, Save the Wilderness**\n\nThe animals have been kidnapped, transformed into stuffed toys, and trapped in claw machines. Can you outsmart their captor and bring them home?\n{630825093440681}\n\n\ud83e\udde9 **Solve Puzzles & Outsmart the Wicked Dr. Kidd**\n\nCrack tricky puzzles to sneak into Dr. Kidd\u2019s secret labs and foil his dark experiments.\n{515737491356413}\n\n\ud83d\ude81 **Master the Claw in VR**\n\nTake control of a high-tech drone claw to rescue animals trapped in claw machines. Precision is key!\n{662933953101831}\n\n\ud83c\udfae **Escape in Platforming Challenges**\n\nGuide rescued animals to safety through platforming levels with branching paths, dangerous obstacles, and sneaky dodging traps while collecting rewards.\n{2111832012564145}\n\n\ud83c\udf31 **Restore Nature**\n\nEvery animal brings life back to Everwood, transforming the barren wilderness back into a thriving ecosystem!\n\n{966180982164367}\n\ud83c\udfc6 **Compete, Collect & Conquer**\n\nRescue more than 40 animals, climb the global leaderboard.\n\n\n\n**Key Features:**\n\n\u2714 **Immersive VR Adventure** \u2013 Solve puzzles, rescue animals, and take down Dr. Kidd.\n\n\u2714 **Cinematic Storytelling** \u2013 Unravel a gripping mystery while exploring an imaginative world.\n\n\u2714 **Dynamic Claw Machine Mechanics** \u2013 Test your skills in virtual claw machine gameplay \u2013 with extra twists!\n\n\u2714 **Puzzle Platforming** \u2013 Outsmart enemies and traps, discover secret escape routes, and find hidden rewards.\n\n \ud83d\udc3bAre you ready to claw your way to freedom?\ud83d\udc3b\n\n", "short_description": "Bearly Escape is a VR adventure puzzle game where kidnapped animals are transformed into stuffed toys and trapped in claw machines. Can you outsmart the sinister scientist Dr. Kidd and bring them home?"}]}, "developer_name": "Time Traveller", "developer_privacy_policy_url": "https://www.timetraveller.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "Time Traveller", "support_website_url": null, "website_url": "https://www.timetraveller.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9822887614411771"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1520186352332436"}, {"status": "PUBLISHED", "id": "1135112361838954"}, {"status": "PUBLISHED", "id": "1825152998096600"}, {"status": "PUBLISHED", "id": "1882717219237142"}, {"status": "PUBLISHED", "id": "551513844672920"}, {"status": "PENDING", "id": "1197432241939005"}, {"status": "PENDING", "id": "1278423399865097"}]}, "baseline_offer": {"id": "1882717219237142"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1520186352332436"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24718755927731695", "version": "0.19.0.61"}, "id": "2322000834865660", "channel_name": "LIVE"}]}, "is_for_oculus_
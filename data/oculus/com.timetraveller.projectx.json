g", "id": "2796354340563363", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499313063_2796354347230029_2502954533365023245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qn0uXadb8wAQ7kNvwFlazcu&_nc_oc=AdoyN_OYcotSVjJj0tN0nhu3zGqvVHT8ob1oR8pjYaeVfizqfROKzwnmnaHNMOvyNcE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxCXWlLsuPTf7MfpsMZryEgUPPSqJWhS226Rp-Wz-6hw&oe=6AE8AF63"}, {"file_name": "3.png", "id": "742659078135537", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820648_742659081468870_6629818489595448037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeEmL6Iti8cQ7kNvwFQqLUR&_nc_oc=AdpUu_sVKcCOML2vCzSUYjERgO_8RLyboXhv58ANd0-ev__m00r1c10tuoi51KQKNfo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjpbVznI-2z1jvcADrr3V3Y-rYS8x-KA2ww6qgItyqqw&oe=6AE89B8F"}, {"file_name": "4.png", "id": "754780010413451", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823431_754780013746784_5842422266605109284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MisUipC576IQ7kNvwFUjwyy&_nc_oc=Adq0ihjPn_B2uoa4V_Dn0lwOGwEqnealxx_e-GWqBNpY6dGUe6Sp9InkrBu8eyu2tHw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4MJxBUJYnkHfT5o9myDu7-dwfDNBxYHu5FEBzgzLr9g&oe=6AE8C0B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1856284531904846", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507845837_1856284535238179_3390133055111273766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQTVSU19TAIQ7kNvwEQs1e7&_nc_oc=AdpbFne-k8NK-43cVK6VOAxYfMtwEqPbcSEqB4OCEPmkn3n-ua_kdGwCWpCmsujJDTE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQungQ-BVFKkJo0iGS6W6LX_XzMOgXD02zeKslL7UZvg&oe=6AE8B05A"}, "display_name": "Bearly Escape", "keywords": ["action", "shooting", "simulation", "compete", "interactive"], "long_description": "# Ready to break out?\nBearly Escape is a fast-paced VR action adventure where you play as a brave little bear on the run from a not-so-nice scientist. Use your wits, speed, and special abilities to overcome traps and make your great escape!\n\n{1533187364326848}\n\ud83e\uddea **Face off against the mad scientist** \u2013 Watch chaos unfold as a giant gorilla storms the lab, smashing the villain's machines in an epic showdown.\n\n{1251899819777276}\n\ud83d\udc3e  **Stealth and speed matter** \u2013 Caught in the wild? Run, duck, and escape before the scientist\u2019s minions grab you!\n\n{1295287925486591}\n\ud83c\udf81 **Claw your way to freedom** \u2013 Outsmart the twisted claw machine and free your fellow animals from captivity.\n\n{1032878228916662}\n\ud83c\udf32 **Dash through the forest** \u2013 Leap over obstacles, slide under branches, and survive a series of wild chase sequences in lush environments.\n{1072825941021392}\n\n\ud83d\udca5 **Unlock special powers** \u2013 Slam, dash, and claw your way through challenges using unique bear abilities.\n\nBearly Escape combines humor, tension, and creativity in a one-of-a-kind VR experience. It\u2019s cute, chaotic, and completely immersive. Are you bear enough to escape?\n", "short_description": "Bearly Escape is a fast-paced VR action adventure where you play as a brave little bear on the run from a not-so-nice scientist. Use your wits, speed, and special abilities to overcome traps and make your great escape!"}]}, "developer_name": "Time Traveller", "developer_privacy_policy_url": "https://www.timetraveller.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "Time Traveller", "support_website_url": null, "website_url": "https://www.timetraveller.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "STRATEGY"], "has_in_app
g", "id": "2796354340563363", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499313063_2796354347230029_2502954533365023245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhnTEVxH030Q7kNvwHZ48zn&_nc_oc=AdqunmbHqBJvWd7Tpta0Kvh-jHyd7j-sAK9F70iTiJsP1Ukhs1D2p6_Ypa0Il_jcgF0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0qjOb2z4jwN63v_U58zwTGf-9IWf63EvUXvgr9rEgbg&oe=6AB69663"}, {"file_name": "3.png", "id": "742659078135537", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820648_742659081468870_6629818489595448037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDtDdsJrM3MQ7kNvwEDa-U1&_nc_oc=AdqfjCOPBveoE-uhl0f7vp1X8ouGRsUF-j4c1bhe49Ca8KfbpMNEKXk_J2nBVFPmqdw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiDK4yeW_KzQG1KLB1r7Bsfk_5qinUqKKjWqkoFCf6eA&oe=6AB6828F"}, {"file_name": "4.png", "id": "754780010413451", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823431_754780013746784_5842422266605109284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck4Hp4pRY7oQ7kNvwFajDiR&_nc_oc=AdpyTcmptB0HodNPVB0S-FsYPYyYnhx32XTvW04DqmtNU6cAbh7HCRo5MhjaQIpR_Qc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJod_Vh0wQaffp-srJKUiF2uDDERW4JgYYvRUicZJiVCw&oe=6AB66F73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1856284531904846", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507845837_1856284535238179_3390133055111273766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOqMm5KI4kkQ7kNvwFHlEAn&_nc_oc=AdpI2oLoJBP4D6WJMqg5G56P9hk96vzzBQmhj9qrHfCbPOpVesQXYWnNs3HdbaCYEI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX1B0QvtL6-NqKzxfXGuHBtleKzf2YpNyOMXrCNgZRMg&oe=6AB6975A"}, "display_name": "Bearly Escape", "keywords": ["action", "shooting", "simulation", "compete", "interactive"], "long_description": "# Ready to break out?\nBearly Escape is a fast-paced VR action adventure where you play as a brave little bear on the run from a not-so-nice scientist. Use your wits, speed, and special abilities to overcome traps and make your great escape!\n\n{1533187364326848}\n\ud83e\uddea **Face off against the mad scientist** \u2013 Watch chaos unfold as a giant gorilla storms the lab, smashing the villain's machines in an epic showdown.\n\n{1251899819777276}\n\ud83d\udc3e  **Stealth and speed matter** \u2013 Caught in the wild? Run, duck, and escape before the scientist\u2019s minions grab you!\n\n{1295287925486591}\n\ud83c\udf81 **Claw your way to freedom** \u2013 Outsmart the twisted claw machine and free your fellow animals from captivity.\n\n{1032878228916662}\n\ud83c\udf32 **Dash through the forest** \u2013 Leap over obstacles, slide under branches, and survive a series of wild chase sequences in lush environments.\n{1072825941021392}\n\n\ud83d\udca5 **Unlock special powers** \u2013 Slam, dash, and claw your way through challenges using unique bear abilities.\n\nBearly Escape combines humor, tension, and creativity in a one-of-a-kind VR experience. It\u2019s cute, chaotic, and completely immersive. Are you bear enough to escape?\n", "short_description": "Bearly Escape is a fast-paced VR action adventure where you play as a brave little bear on the run from a not-so-nice scientist. Use your wits, speed, and special abilities to overcome traps and make your great escape!"}]}, "developer_name": "Time Traveller", "developer_privacy_policy_url": "https://www.timetraveller.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "Time Traveller", "support_website_url": null, "website_url": "https://www.timetraveller.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "STRATEGY"], "has_in_app
me": "2.png", "id": "2796354340563363", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499313063_2796354347230029_2502954533365023245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqdi0I-4ZnYQ7kNvwE3GLER&_nc_oc=Ado1oy6i2R_or_xRA6_cxWhRYOCVLfjzsWCZaWgn9O2YnsrsmM8Ab_RSqMyLTadEDVo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFfeV-63KkA0s5HPvKaScsZ7dcRzmSM4czHG4-D2F-KA&oe=6AA42163"}, {"file_name": "3.png", "id": "742659078135537", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491820648_742659081468870_6629818489595448037_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYFQM0gVom8Q7kNvwEkvHl9&_nc_oc=Adqz6-UiAkvwDSOdJDbJ1q7Y0VlrXEpNWhzaeb9m8NB6Pj9PD-j6Fx_MzcsTKHLeBq4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_AciMkVxhnFRMiUR4mQHOiu-0xOjr8iopeTP6Xv7HuQ&oe=6AA40D8F"}, {"file_name": "4.png", "id": "754780010413451", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823431_754780013746784_5842422266605109284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJDpNF7Cnx4Q7kNvwE0x9i1&_nc_oc=AdoAXbJGCGVkAdh0uyGhi-hH2HGwCb4rM9Pbs2MpoH7w5TctxXtmIHyPwSkborVsn3g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA65Dg-t1zN0EBR96yf5xk4OUvRGH6d7RK_C2Xpd9rlA&oe=6AA3FA73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 1440.png", "id": "1856284531904846", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/507845837_1856284535238179_3390133055111273766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOyqLbOcuPIQ7kNvwHHlxlQ&_nc_oc=AdpbZtEnhogPjqCo7-w50l3kU9xwWf6tj2R6X3VBAgekRcJUb9II1YtMLhMkT3Wr77I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW08uNSW8LE2MTpp_IxvW0BNlenIj75S0PhvrRNwB6qw&oe=6AA4225A"}, "display_name": "Bearly Escape", "keywords": ["action", "shooting", "simulation", "compete", "interactive"], "long_description": "# Ready to break out?\nBearly Escape is a fast-paced VR action adventure where you play as a brave little bear on the run from a not-so-nice scientist. Use your wits, speed, and special abilities to overcome traps and make your great escape!\n\n{1533187364326848}\n\ud83e\uddea **Face off against the mad scientist** \u2013 Watch chaos unfold as a giant gorilla storms the lab, smashing the villain's machines in an epic showdown.\n\n{1251899819777276}\n\ud83d\udc3e  **Stealth and speed matter** \u2013 Caught in the wild? Run, duck, and escape before the scientist\u2019s minions grab you!\n\n{1295287925486591}\n\ud83c\udf81 **Claw your way to freedom** \u2013 Outsmart the twisted claw machine and free your fellow animals from captivity.\n\n{1032878228916662}\n\ud83c\udf32 **Dash through the forest** \u2013 Leap over obstacles, slide under branches, and survive a series of wild chase sequences in lush environments.\n{1072825941021392}\n\n\ud83d\udca5 **Unlock special powers** \u2013 Slam, dash, and claw your way through challenges using unique bear abilities.\n\nBearly Escape combines humor, tension, and creativity in a one-of-a-kind VR experience. It\u2019s cute, chaotic, and completely immersive. Are you bear enough to escape?\n", "short_description": "Bearly Escape is a fast-paced VR action adventure where you play as a brave little bear on the run from a not-so-nice scientist. Use your wits, speed, and special abilities to overcome traps and make your great escape!"}]}, "developer_name": "Time Traveller", "developer_privacy_policy_url": "https://www.timetraveller.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name": "Time Traveller", "support_website_url": null, "website_url": "https://www.timetraveller.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "STRAT
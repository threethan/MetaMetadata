.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qvu8EhWacYQ7kNvwGXpVRm&_nc_oc=AdkVlkbkwhJzajKUaWpHgqbzVTkcOJtYDR9kiOwQkztMkn-mGGv6XmoMTTWoH7NL4xc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsRw-Fc0vPCKYbj7D8ZX6Smjd6Jes5bszdUmPQuccwtrg&oe=69A41EF9"}, {"file_name": "\u5ba3\u4f20\u56fe3.png", "id": "1287903762319465", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393450_1287903765652798_3313975889312284138_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Hq5-AjRpwwQ7kNvwGAhbNx&_nc_oc=AdmEWE0GZzcLxltd5eGCQ8oBk6-deCwnCkfdiGiXUzlcsBBZP3CAHzCbeGsW9eEKm0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs5_ubBGRSmj2PTdJexsShkJm40UQgTXGp27oJxXNOjLw&oe=69A445E7"}, {"file_name": "\u5ba3\u4f20\u56fe1.png", "id": "551538804081128", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392010_551538807414461_9150926764574295790_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBqlxPWWyvwQ7kNvwFWi2_G&_nc_oc=AdngFDrRZ-tDetmH9vrXe7tH1jDb4BHc-IIVt_oR2p0BPGhm2u2q4fkoCUKFfwZ0LSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftCpPZtkvtIcPsox5BHUd36n9h4QP0lRPV8pbS93jmyDg&oe=69A44061"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u4e3b\u89c6\u89c92560x1440.png", "id": "1026152272694074", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393491_1026152279360740_983069621863544605_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vLg4zN2BOAQ7kNvwHDECK8&_nc_oc=Adm_LBj3aohGtztZAyKGtTnMC64479p54-cFPieVzRP3T4-zLMrGbAiraltZpFkTJ6c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftQlXAa1KYEjNazvqdv0zGK3LqDETX-ICq-EhgdfYn5UQ&oe=69A441A6"}, "display_name": "Bearly Escape", "keywords": [], "long_description": "\ud83d\udc3b **Explore the Dreamlike World of Everwood**\n\nYour loyal dog, Robin, has vanished! Embark on a thrilling journey to track him down through Everwood\u2014a dreamlike world teeming with mystery, danger, and secrets.\n{1811049976105148}\n\n\ud83c\udf32 **Escape Evil\u2019s Clutches, Save the Wilderness**\n\nThe animals have been kidnapped, transformed into stuffed toys, and trapped in claw machines. Can you outsmart their captor and bring them home?\n{630825093440681}\n\n\ud83e\udde9 **Solve Puzzles & Outsmart the Wicked Dr. Kidd**\n\nCrack tricky puzzles to sneak into Dr. Kidd\u2019s secret labs and foil his dark experiments.\n{515737491356413}\n\n\ud83d\ude81 **Master the Claw in VR**\n\nTake control of a high-tech drone claw to rescue animals trapped in claw machines. Precision is key!\n{662933953101831}\n\n\ud83c\udfae **Escape in Platforming Challenges**\n\nGuide rescued animals to safety through platforming levels with branching paths, dangerous obstacles, and sneaky dodging traps while collecting rewards.\n{2111832012564145}\n\n\ud83c\udf31 **Restore Nature**\n\nEvery animal brings life back to Everwood, transforming the barren wilderness back into a thriving ecosystem!\n\n{966180982164367}\n\ud83c\udfc6 **Compete, Collect & Conquer**\n\nRescue more than 40 animals, climb the global leaderboard.\n\n\n\n**Key Features:**\n\n\u2714 **Immersive VR Adventure** \u2013 Solve puzzles, rescue animals, and take down Dr. Kidd.\n\n\u2714 **Cinematic Storytelling** \u2013 Unravel a gripping mystery while exploring an imaginative world.\n\n\u2714 **Dynamic Claw Machine Mechanics** \u2013 Test your skills in virtual claw machine gameplay \u2013 with extra twists!\n\n\u2714 **Puzzle Platforming** \u2013 Outsmart enemies and traps, discover secret escape routes, and find hidden rewards.\n\n \ud83d\udc3bAre you ready to claw your way to freedom?\ud83d\udc3b\n\n", "short_description": "Bearly Escape is a VR adventure puzzle game where kidnapped animals are transformed into stuffed toys and trapped in claw machines. Can you outsmart the sinister scientist Dr. Kidd and bring them home?"}]}, "developer_name": "Time Traveller", "developer_privacy_policy_url": "https://www.timetraveller.com/PrivacyAgreement.html", "developer_terms_of_service_url": null, "publisher_name"
2_6877779894100993397_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfwK5C-A7KEQ7kNvwFK87VN&_nc_oc=AdoG7DAU9YMvJd5_omJkRJCycc1P71VQ4Kbfd_VQ3fJZKEjDasvEeKN5oIynilH9ksw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m_KkPlopVO2w4rsaRdzILQZqwiXB1ugd8y0DJ2KXN4A&oe=6A0DACFC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "dd_landscape.png", "id": "486695943301841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974581_486695946635174_1371188690737188724_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZqV3g8itUAQ7kNvwEi6-YO&_nc_oc=Adqksr4RvdixbpxInLJthxO_u63AeoBuJEhDgscEnIGddONjl5TEmVNAp-vdOTOaGrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wLvPRyP0HFaLVon3b8NTkacLq5bJl1mMsvIf8CrxtoQ&oe=6A0DA091"}, "display_name": "Discovery Deck", "keywords": [], "long_description": "The Discovery Deck is a space for new users to go into and enjoy a curated experience while practicing basic controls in virtual reality. Users will have the opportunity to practice movement by teleporting to hotspots, grabbing and manipulating objects, and interacting with a virtual world. While inside the Discovery Deck users will also have the opportunity to view video clips with the latest news from Jenson8 as well as trailers of other products and services offered. \n\nDiscovery Deck is a licensed product from Jenson8 and requires an account and prior authorization to access.", "short_description": "The Discovery Deck is a virtual space for users to become acclimated to virtual reality before immersing themselves in other Jenson8 products. It is a licensed product from Jenson8 and requires an account and prior authorization to access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.jenson8.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Jenson8 Ltd", "support_website_url": null, "website_url": "https://jenson8.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "c
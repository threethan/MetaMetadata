er": null, "video_trailer_thumbnail": {"file_name": "AppLab\u52d5\u753b\u30b5\u30e0\u30cd_en.png", "id": "541552983510062", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348034_541552986843395_6414908525109761637_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGou2yZq8TcQ7kNvwGnMxNp&_nc_oc=Adog20w_RHERKWYHsHJsWkT6vRb7aCSzwHjffKvxL4M_9hg0uMXpzgGY82rp6WuAshE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BU7hvKF5-lGyD9at2LLSOhgHZbD8TkM7enRwUZQW4AA&oe=69DCEE6B"}, "display_name": "VR Mummy Girl", "keywords": [], "long_description": "A mummy girl who has been asleep deep inside a pyramid for more than 1000 years wakes up.\nShe doesn\u2019t know what era is it is, who she is, or the reason she's there.\nShe keeps walking, trying to find the exit.\n\nSwing your arms down to stretch the bandage, grab the gimmick with the bandage and jump.\nThe realistic VR and high-speed movement are exhilarating and it feels good.\nOnce you get the hang of it, you will come to know the fun of the game.\n\n* Stretching bandage\n* High speed jump movement\n* Climbing the wall / Trapeze\n* Trap that blocks the way\n* Various game stages\n* The rank of clearing the stage\n\nThe video and screenshots were taken with Quest2.", "short_description": "A mummy girl who has been asleep deep inside a pyramid for more than 1000 years wakes up.\nShe doesn\u2019t know what era is it is, who she is, or the reason she's there.\nShe keeps walking, trying to find the exit."}]}, "developer_name": "\u307e\u3053\u3061\u3083\u3093\u3068\u3044\u3063\u3057\u3087", "developer_privacy_policy_url": "https://www.withmako.com/VRMummyGirl_PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "\u307e\u3053\u3061\u3083\u3093\u3068\u3044\u3063\u3057\u3087", "support_website_url": null, "website_url": "http://www.withmako.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_catego
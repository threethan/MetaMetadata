rXk6lMIqIm2bGI4VPpUOs1XKZJBEWJbO-ve4CZ_qM5gVmzwcE9hM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJmgwQ8yNWZXlklDCH4mz2ldiXclnflGEMWTynowoTrg&oe=6AFB1A47"}, {"file_name": "05.png", "id": "5139698046042789", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982710_5139698049376122_5799490327689094540_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3jrCk5SLmUQ7kNvwF_tmeb&_nc_oc=AdpGD_c2c0fdHYVf7PMf4iSvCD8sD2Bgmq9zBhp1xYcqWK4pOMbEocKK2pfoqK8STCY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2W5Q9t4QCTE-srMkG0KVnDVtRugTjadeqOYtg4_1kow&oe=6AFB29D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab\u52d5\u753b\u30b5\u30e0\u30cd_en.png", "id": "541552983510062", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348034_541552986843395_6414908525109761637_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6em5cbktE64Q7kNvwHLlsMy&_nc_oc=AdoeVjfxv9BNUSpRxOirCglOHetko2UYqwcx2oUzf-WSFcbDVJkkQJ5L0aJ9uyoCFVE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKaAk_Vbahk1J3Pu1mCjuM22bR21IXkS6PRHv0K--Rig&oe=6AFB3C2B"}, "display_name": "VR Mummy Girl", "keywords": [], "long_description": "A mummy girl who has been asleep deep inside a pyramid for more than 1000 years wakes up.\nShe doesn\u2019t know what era is it is, who she is, or the reason she's there.\nShe keeps walking, trying to find the exit.\n\nSwing your arms down to stretch the bandage, grab the gimmick with the bandage and jump.\nThe realistic VR and high-speed movement are exhilarating and it feels good.\nOnce you get the hang of it, you will come to know the fun of the game.\n\n* Stretching bandage\n* High speed jump movement\n* Climbing the wall / Trapeze\n* Trap that blocks the way\n* Various game stages\n* The rank of clearing the stage\n\nThe video and screenshots were taken with Quest2.", "short_description": "A mummy girl who has been asleep deep inside a pyramid for more than 1000 years wakes up.\nShe doesn\u2019t know what era is it is, who she is, or the reason she's there.\nShe keeps walking, trying to find the exit."}]}, "developer_name": "\u307e\u3053\u3061\u3083\u3093\u3068\u3044\u3063\u3057\u3087", "developer_privacy_policy_url": "https://www.withmako.com/VRMummyGirl_PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "\u307e\u3053\u3061\u3083\u3093\u3068\u3044\u3063\u3057\u3087", "support_website_url": null, "website_url": "http://www.withmako.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5263033140376304"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57569432_701884537646309_5980074897263199812_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_uDgFaZco0Q7kNvwGMRyus&_nc_oc=AdrJHndtFXbqrN5tO7PpOEi_9ucXjblCvqEa8K7i000YZ4buG4GCZ2g1pSWV36S9uZ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbblNJjbNPeoVdiDqim5NABVCMo7eNxhM5GlqkqdNEDw&oe=6AFB1DCB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Mummy Girl", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781
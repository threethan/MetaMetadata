PAL31gRWHyVQuu6yF4Rx31haYMeeVGPlg&oe=6AC7BD86"}]}, "id": "1369113951167403", "locale": "en_US", "screenshots": [{"file_name": "7.png", "id": "1545627756521939", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619672_1545627759855272_8693797764724207336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1BnPR3pUgYQ7kNvwHRcpWl&_nc_oc=Adp3hRW6txjXha-zjP4w7AgYbWolCUFStNCbcDPuSEfkm4ep4FsAzTXArJXuN27r8z0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0gXPaE3TwGFujvECHJXh1opBgGOvGlQ56_L8uwzLeWA&oe=6AC7A25A"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8\u4f5c\u6210_\u30af\u30e9\u30a4\u30df\u30f3\u30b0 (2).png", "id": "1825448384782055", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619012_1825448388115388_3251210753112159657_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_GZGG_-hKwQ7kNvwHbYyJw&_nc_oc=Adr920ZRyWdm58IdVyd5yww-eK5gd4-LnxcXdKk4aEIPqAkk9RXiDm0ziI_EcP4se14&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH88MTC0cQZiMnZurycxR50RFcXcONGbZookYbgw7_4A&oe=6AC7C4E9"}, {"file_name": "9.png", "id": "1717023646345675", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618264_1717023649679008_7002563979189543108_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksR4Rs9TnVcQ7kNvwHPPXca&_nc_oc=AdpzaNMbyfl_xvcbvKDC1KSzMcp0rUsiZ5fhomVdvmKkvQEHihBGV1TvhZRuqHngpSI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPdsZI7C7E6_IsdNJjqjG8mHKHslIiuxYl4lfBOsA2LA&oe=6AC7C0ED"}, {"file_name": "8.png", "id": "1607132690305651", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619668_1607132693638984_4886504381390102706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yD6YfC5YTMIQ7kNvwEfZsln&_nc_oc=AdplwbU5u6V_NliiGWTbAAqfFcO0x8r1PG16PWiMrCtvM-LqlCHboTPOIJPXnSEPPfE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNREJq2L-xeKJiTrHt-pRwE8Y3RnHv8vpY2SvuzFd44EQ&oe=6AC7B506"}, {"file_name": "6.png", "id": "841098118978121", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617762_841098122311454_3880344824598499783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmleoK5WWgUQ7kNvwG78fPU&_nc_oc=AdoWCogYJTOaQMrll4hvkB1TcUQZHerEj6HKD2hvPhx-1ndtE030Yf6eHIyRGWF2Vwo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyKVS60I112dG_KNy8ACrxrp6xA_tZf_UCsHZnGzF99Q&oe=6AC7B3DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "878887251444396", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619681_878887254777729_7151487680480058804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFvAVqKggOAQ7kNvwE34StD&_nc_oc=AdoM7xtPrLbFDrJ6zGXH-LmtsNoCU7CU3hvh0nsW2zxYWHs2XJARZcXWiEw1v-vMlYc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7LV76LyPUsqVMUn4dZJgs3RZvegDQDgyep8lV0KguSw&oe=6AC7C0BA"}, "display_name": "Climb Fit XR : Climbing Fitness Cardio", "keywords": ["Workout", "Nature", "Exercise", "Meditation", "Travel"], "long_description": "# Reach New Heights. Climb Fit XR: Turn Every Climb into Your Best Workout\n\n**\"Burn calories while you play, without even noticing the effort.\"** Defy gravity and scale the world\u2019s most breathtaking cliffs. Climb Fit XR is an immersive fitness experience that focuses on your natural movement\u2014no forced rhythms, just you and the vertical challenge.\n\n\u25cf **Your Workout, Your Pace:** Set the difficulty to match your fitness goals.\n\n\u3000\u25cb Easy: Gentle slopes for a mindful stretch and scenic views.\n\n\u3000\u25cb Normal: Balanced routes to find your rhythm and a steady burn.\n\n\u3000\u25cb Hard: Extreme heights designed for a true core workout.\n\n\u25cf **Atmospheric Immersion:** Choose your environment and time of day.\n\n\u3000 \u25cb Oasis Valley: The serene beauty of nature.\n\n\u3000\u25cb City Heights: A modern, vertical challenge among the skyscrapers.\n\n\u3000\u25cb Time of Day: Experience morning light, golden sunsets, and moonlit nights.\n\n\u25cf **The Natural Feel of Climbing:** No controllers needed. With **Hand Tracking**, use your own hands to grab the holds and make your way up. Moving with your own hands creates an **intuitive sense of immersion**.\n\n\u25cf **Real Results:** Engage your entire upper body and core. Track your effort in real-time with your integrated wrist device, showing **calories burned**. With our Checkpoint System, you can instantly recover from any fall and keep moving toward your goal.\n\n**Grab the holds. Conquer the summit today with Climb Fit XR.**", "short_description": "Climb Fit XR: Turn Every Climb into Your Best Workout\n\n\"Burn calories while you play, without even noticing the effort.\" Defy gravity and reach the summit on your own terms. Experience a new way to get fit while surrounded by breathtaking views.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33440431742270403"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1965201577713011"}]}, "baseline_offer": {"id": "1965201577713011"}, "is_approved
=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvIVBd7yutQ8f_Qx5BP-POdceokM8cI1b2WJcpeN1K0Q&oe=69BA9AA9"}, {"file_name": "9.png", "id": "1717023646345675", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618264_1717023649679008_7002563979189543108_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q12I9HQZ9v4Q7kNvwEr26By&_nc_oc=AdkVw6y4RhORBoV6NdrVS0Gh9HG6r-BVp_lnoTcLj-eF5Oaoxo0Stb_3yS2XbhSdTTU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxV0VOEOo_cZtftVKUnve1pc2I9vZCFbB8baA4tNcDc8w&oe=69BA96AD"}, {"file_name": "8.png", "id": "1607132690305651", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619668_1607132693638984_4886504381390102706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ99CdmkRDYQ7kNvwEwRo_C&_nc_oc=AdlRm_Tv4e6nvZv98OaifIC_UNxjKYIZ7RltrQdqK7DdTNZLyOnPkvyFvNM22DaZfQM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJWunt6UQZOr8_g-qMsCvT122mxX-_FD1RkP2v-gVqpw&oe=69BA8AC6"}, {"file_name": "6.png", "id": "841098118978121", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617762_841098122311454_3880344824598499783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2Lhzy6BN4UQ7kNvwFI-2XY&_nc_oc=Admyue1MIEFMb9yiwyUVO4rS4xoChOb138GNrwRNsrrDzMOkXo4gJ4K9FC4CKEuxKKY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDq1veRQWBHpEart2viCpf0WCD9wXiFfzCtrAtzyLSrg&oe=69BA899E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "878887251444396", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619681_878887254777729_7151487680480058804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9mOP5mEdc0Q7kNvwEpZiRP&_nc_oc=Adkzs1QwcpCMZa0TJKjyoG-k9koKTYNXyXstFW_P6wlT2oBdJ3HQKV5c6uVSDHmP0Fc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3nJfUST3VGSaHhp68dZpL62rxZWT8kaCcHiQgGQY5Xw&oe=69BA967A"}, "display_name": "Climb Fit XR : Climbing Fitness Cardio", "keywords": ["Workout", "Nature", "Exercise", "Meditation", "Travel"], "long_description": "# Reach New Heights. Climb Fit XR: Turn Every Climb into Your Best Workout\n\n**\"Burn calories while you play, without even noticing the effort.\"** Defy gravity and scale the world\u2019s most breathtaking cliffs. Climb Fit XR is an immersive fitness experience that focuses on your natural movement\u2014no forced rhythms, just you and the vertical challenge.\n\n\u25cf **Your Workout, Your Pace:** Set the difficulty to match your fitness goals.\n\n\u3000\u25cb Easy: Gentle slopes for a mindful stretch and scenic views.\n\n\u3000\u25cb Normal: Balanced routes to find your rhythm and a steady burn.\n\n\u3000\u25cb Hard: Extreme heights designed for a true core workout.\n\n\u25cf **Atmospheric Immersion:** Choose your environment and time of day.\n\n\u3000 \u25cb Oasis Valley: The serene beauty of nature.\n\n\u3000\u25cb City Heights: A modern, vertical challenge among the skyscrapers.\n\n\u3000\u25cb Time of Day: Experience morning light, golden sunsets, and moonlit nights.\n\n\u25cf **The Natural Feel of Climbing:** No controllers needed. With **Hand Tracking**, use your own hands to grab the holds and make your way up. Moving with your own hands creates an **intuitive sense of immersion**.\n\n\u25cf **Real Results:** Engage your entire upper body and core. Track your effort in real-time with your integrated wrist device, showing **calories burned**. With our Checkpoint System, you can instantly recover from any fall and keep moving toward your goal.\n\n**Grab the holds. Conquer the summit today with Climb Fit XR.**", "short_description": "Climb Fit XR: Turn Every Climb into Your Best Workout\n\n\"Burn calories while you play, without even noticing the effort.\" Defy gravity and reach the summit on your own terms. Experience a new way to get fit while surrounded by breathtaking views.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Sto
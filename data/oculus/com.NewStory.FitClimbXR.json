cb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jGL92WqMuYQ7kNvwE4gN6p&_nc_oc=AdqxWDQf9SA1gBUhRA-MNuFlSU2AsIBCKYcImf5bmnqGtgKfSMV40ED55QsFs_sI2UE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCctKc73OLvmC_9uRWG6tNKfhtyqS31EByr6P0J5HQp9w&oe=6A58CEA9"}, {"file_name": "9.png", "id": "1717023646345675", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499618264_1717023649679008_7002563979189543108_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-09nKei2pUMQ7kNvwFroP-h&_nc_oc=Adqtz8AaOSsaLypHP9i6IoPcPGBdDlFrbUmdp9MknXC9ipZmyNZTrAt83nvxrxGhExE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiGCHtz_E4EUh2f5Ye8Bk_nQDBRaILUycuvkAPwkZTqw&oe=6A58CAAD"}, {"file_name": "8.png", "id": "1607132690305651", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619668_1607132693638984_4886504381390102706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHSjeKvA4rUQ7kNvwHNAafZ&_nc_oc=Adrl4vQ69JrKSgQ9VoTR_0HqCG9IJZOAov5HI8qTOOf5GHjxUHimVGIMvCFvyaqWevI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQA9iGJMWsLwXkd0BotGY5pnYk0ShmFx2B6T9QfgBwVw&oe=6A58F706"}, {"file_name": "6.png", "id": "841098118978121", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617762_841098122311454_3880344824598499783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9JWhdF4_OkQ7kNvwGtWWdY&_nc_oc=AdrlZZV7aZ6Zmdi-2LBRPcXGRwRSOlOL1fN2cUHSfZlPxIvdZcG_PzskmHuBg5g2Adg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNKrMdXVdfefLL6Mt7v2KKrhJGMR_P_AJdjvNn6-agwQ&oe=6A58F5DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "878887251444396", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619681_878887254777729_7151487680480058804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuZbwhif1xIQ7kNvwFGMP2F&_nc_oc=AdpMT1V7xErnUU-O5xDKKH2wkUc1QxG7RFuICoCwBdnLcJbZYa-oXEsb9b_E4tRjW0U&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-GNFPbJj5cMtgxX_jVVL8wOULnlqlEwrnaw5H01hAMg&oe=6A58CA7A"}, "display_name": "Climb Fit XR : Climbing Fitness Cardio", "keywords": ["Workout", "Nature", "Exercise", "Meditation", "Travel"], "long_description": "# Reach New Heights. Climb Fit XR: Turn Every Climb into Your Best Workout\n\n**\"Burn calories while you play, without even noticing the effort.\"** Defy gravity and scale the world\u2019s most breathtaking cliffs. Climb Fit XR is an immersive fitness experience that focuses on your natural movement\u2014no forced rhythms, just you and the vertical challenge.\n\n\u25cf **Your Workout, Your Pace:** Set the difficulty to match your fitness goals.\n\n\u3000\u25cb Easy: Gentle slopes for a mindful stretch and scenic views.\n\n\u3000\u25cb Normal: Balanced routes to find your rhythm and a steady burn.\n\n\u3000\u25cb Hard: Extreme heights designed for a true core workout.\n\n\u25cf **Atmospheric Immersion:** Choose your environment and time of day.\n\n\u3000 \u25cb Oasis Valley: The serene beauty of nature.\n\n\u3000\u25cb City Heights: A modern, vertical challenge among the skyscrapers.\n\n\u3000\u25cb Time of Day: Experience morning light, golden sunsets, and moonlit nights.\n\n\u25cf **The Natural Feel of Climbing:** No controllers needed. With **Hand Tracking**, use your own hands to grab the holds and make your way up. Moving with your own hands creates an **intuitive sense of immersion**.\n\n\u25cf **Real Results:** Engage your entire upper body and core. Track your effort in real-time with your integrated wrist device, showing **calories burned**. With our Checkpoint System, you can instantly recover from any fall and keep moving toward your goal.\n\n**Grab the holds. Conquer the summit today with Climb Fit XR.**", "short_description": "Climb Fit XR: Turn Every Climb into Your Best Workout\n\n\"Burn calories while you play, without even noticing the effort.\" Defy gravity and reach the summit on your own terms. Experience a new way to get fit while surrounded by breathtaking views.\n"}]}, 
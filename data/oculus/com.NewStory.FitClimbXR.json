=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWvH-coNHXprRRttVLSBdbyGhgmWII874q2cdF6GeMrQ&oe=69BBEC29"}, {"file_name": "9.png", "id": "1717023646345675", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618264_1717023649679008_7002563979189543108_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q12I9HQZ9v4Q7kNvwGCmrLs&_nc_oc=AdmZvc8lACvSoKlvw3ofVPcdteMZ0cnqMk7K3WsYk14P5TcjAixKxLVWI3SJ41bB9pk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz2Xuoy4YektCsmdEzoq3gSTtxbAktC_R8NbgXaXAzOUQ&oe=69BBE82D"}, {"file_name": "8.png", "id": "1607132690305651", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619668_1607132693638984_4886504381390102706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ99CdmkRDYQ7kNvwGb9Bn5&_nc_oc=AdliQORDudF8XD9_69n83c3sqorxv6Aeo4jyL668_GfR4dFJHD9CeSB1vgSzui46sVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxVceGEtIzx4zEDIN7C2ZBM_QpDdeY_EdmaB8DOnRWAow&oe=69BBDC46"}, {"file_name": "6.png", "id": "841098118978121", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617762_841098122311454_3880344824598499783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHCq26qeekwQ7kNvwH8DLgv&_nc_oc=Adluncnu5rr0Pg2KCOz8G2aBYfxf3FP6iMnMEF69b3TG_8Sb69LnJx2rdsM66BNpaPw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfynuVqRZKPPm-0TSbdvlnT_y6SltXAaaL4M1d8ljmewsQ&oe=69BBDB1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "878887251444396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619681_878887254777729_7151487680480058804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9mOP5mEdc0Q7kNvwEa2YRJ&_nc_oc=AdkAycm41n1Tr6EOUpkjY3Qgfv71V6UuaQRL9bxrjmj7MO8jgvGWmDvVqLDCuaE-fgc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0Ws8MrVrhJZVXbCyG1ObL47mrSFkn1Qj57yowCW7mLw&oe=69BBE7FA"}, "display_name": "Climb Fit XR : Climbing Fitness Cardio", "keywords": ["Workout", "Nature", "Exercise", "Meditation", "Travel"], "long_description": "# Reach New Heights. Climb Fit XR: Turn Every Climb into Your Best Workout\n\n**\"Burn calories while you play, without even noticing the effort.\"** Defy gravity and scale the world\u2019s most breathtaking cliffs. Climb Fit XR is an immersive fitness experience that focuses on your natural movement\u2014no forced rhythms, just you and the vertical challenge.\n\n\u25cf **Your Workout, Your Pace:** Set the difficulty to match your fitness goals.\n\n\u3000\u25cb Easy: Gentle slopes for a mindful stretch and scenic views.\n\n\u3000\u25cb Normal: Balanced routes to find your rhythm and a steady burn.\n\n\u3000\u25cb Hard: Extreme heights designed for a true core workout.\n\n\u25cf **Atmospheric Immersion:** Choose your environment and time of day.\n\n\u3000 \u25cb Oasis Valley: The serene beauty of nature.\n\n\u3000\u25cb City Heights: A modern, vertical challenge among the skyscrapers.\n\n\u3000\u25cb Time of Day: Experience morning light, golden sunsets, and moonlit nights.\n\n\u25cf **The Natural Feel of Climbing:** No controllers needed. With **Hand Tracking**, use your own hands to grab the holds and make your way up. Moving with your own hands creates an **intuitive sense of immersion**.\n\n\u25cf **Real Results:** Engage your entire upper body and core. Track your effort in real-time with your integrated wrist device, showing **calories burned**. With our Checkpoint System, you can instantly recover from any fall and keep moving toward your goal.\n\n**Grab the holds. Conquer the summit today with Climb Fit XR.**", "short_description": "Climb Fit XR: Turn Every Climb into Your Best Workout\n\n\"Burn calories while you play, without even noticing the effort.\" Defy gravity and reach the summit on your own terms. Experience a new way to get fit while surrounded by breathtaking views.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Sto
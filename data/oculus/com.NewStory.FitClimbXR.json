90_5018967949561654796_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fG-I1_dYbt8Q7kNvwF3sA1c&_nc_oc=AdqesJG3MOBx_5du0ugFPrZbvRMegd-ZQslMEv-R53s7BUHgeMfzQpzHzFqmkOplLeo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IlFrpqyBfqoaEKdyxKMUVLcPezMiwt73VpyJ6XA7aQA&oe=6A0B01B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1331629598849809", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_1331629602183142_1074844944193064614_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEtlY3vDFvcQ7kNvwFFEELV&_nc_oc=Adpj3G3LNOQZXMFg7mA7r9Oq7M_gFVJAJ6Uu1oCD7CJNWUDXvQ0DBINH8vVQcL9TBH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XmqigqJ3a5LwvPn5xGnftIByMHZ9j45I-v-wBgtzGsw&oe=6A0B3287"}, "display_name": "Climb Fit XR : Climbing Fitness Cardio", "keywords": ["Workout", "Nature", "Exercise", "Meditation", "Travel"], "long_description": "# \u2728\ud83e\uddd7 Reach New Heights. Climb Fit XR\ud83e\uddd7\u2728 \n**- Turn Every Climb into Your Best Workout -**\n\n**\"Burn calories while you play, without even noticing the effort.\"**\n\nDefy gravity and scale the world\u2019s most breathtaking cliffs. \n**Climb Fit XR** is an immersive fitness experience that focuses on your natural movement\n\n\u2014no forced rhythms, just you and the vertical challenge.\n\n**\ud83c\udfaf Your Workout, Your Pace:** Set the difficulty to match your fitness goals.\n\n- Easy: Gentle slopes for a mindful stretch and scenic views.\n- Normal: Balanced routes to find your rhythm and a steady burn.\n- Hard: Extreme heights designed for a true core workout.\n\n**\ud83c\udf0d Atmospheric Immersion:** Choose your environment and time of day.\n- Oasis Valley: The serene beauty of nature.\n- City Heights: A modern, vertical challenge among the skyscrapers.\n- Time of Day: Experience morning light, golden sunsets, and moonlit nights.\n\n**\ud83d\ude4cThe Natural Feel of Climbing:** No controllers needed. \nWith Hand Tracking, use your own hands to grab the holds and make your way up. \nMoving with your own hands creates an intuitive sense of immersion.\n\n**\ud83d\udcc8 Real Results:** Engage your entire upper body and core.\nTrack your effort in real-time with your integrated wrist device, showing calories burned. \nWith our Checkpoint System, you can instantly recover from any fall and keep moving toward your goal.\n\n**Grab the holds. Conquer the summit today with Climb Fit XR.\ud83c\udfd4\ufe0f\ud83d\udc51**", "short_description": "Climb Fit XR: Turn Every Climb into Your Best Workout\n\n\"Burn calories while you play, without even noticing the effort.\"\nDefy gravity and reach the summit on your own terms. Experience a new way to get fit while surrounded by breathtaking views.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}, {"id": "2776542286000603"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35553165904330299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618499_1659148638764268_1481630069984877171_n.png?stp=dst-png_s360x360&_nc_cat=109&c
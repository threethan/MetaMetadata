ocale": "en_US", "screenshots": [{"file_name": "7.png", "id": "1545627756521939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619672_1545627759855272_8693797764724207336_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_fvIm17yX4Q7kNvwHOq10s&_nc_oc=AdoA9-9EbIreB54yQMRb1c4OMertOWU-I_toETyi61ZlELfCy9xSkB3xBEimNpUVoVI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48JtqdW7pQGHx-0myDHfjL5Wm9HUjd-AHCUEWZeDduMg&oe=6A0B1BDA"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8\u4f5c\u6210_\u30af\u30e9\u30a4\u30df\u30f3\u30b0 (2).png", "id": "1825448384782055", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619012_1825448388115388_3251210753112159657_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj-ipccSA6YQ7kNvwG0I6iP&_nc_oc=AdqziWhdJ_E1APK7CPzTOnekTg3_YocRr5DsBE44gsKhRpwKsw-CtSpQQKGtYBojyVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68dddOMZPPF5Vt_oQNQfDd8pznUchAMzKGW9-1qiqwQQ&oe=6A0B0629"}, {"file_name": "9.png", "id": "1717023646345675", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618264_1717023649679008_7002563979189543108_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8Piti1aL1YQ7kNvwHtww5x&_nc_oc=AdprRXH3dvqhuZUE2_O-ufh347X5hMY3pWgjWdjdjweOcBAS_ZbhXMJdHebrIPFupDY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y6FIv517Wpz-Q1A6rfK4JgF1NUPLrdATfdVTt-FHing&oe=6A0B022D"}, {"file_name": "8.png", "id": "1607132690305651", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619668_1607132693638984_4886504381390102706_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jiMDXDohk8Q7kNvwG9634a&_nc_oc=Ado6wjvALCgxvKkT7N1GcTxjj-xrQ7JmZBulQPaFcDQ9hNOkTcTHI9jZKbPYRtvYtRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gGNpF6uyxFqp3HArz-DLIMPMr0S7tZZ3DGbwMLX1oIA&oe=6A0B2E86"}, {"file_name": "6.png", "id": "841098118978121", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617762_841098122311454_3880344824598499783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmIsKniCg30Q7kNvwH4pFLO&_nc_oc=Adrk1cf5KqlC_ewkqn3ieFLuJMfmwkJIoSE1ohn2FqUNn5eZ-GMEE_5hFd7rrOB-lts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71Z6plBDJysaKXRtqZp6KM9C1fs_wsJd8XazCDstI1FQ&oe=6A0B2D5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "878887251444396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619681_878887254777729_7151487680480058804_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h8Yb2exyqgQ7kNvwEXI4Pa&_nc_oc=Adpx8UE3ezSaVaG4QbZynXDk0YFYTaiWGHfYg1fg-6w11CJhvVeDY6Myy1xeszWpNog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Pgm_eCvZEmjaaWwB0guV70O0nwc73a3Zi69k9Uii7DQ&oe=6A0B01FA"}, "display_name": "Climb Fit XR : Climbing Fitness Cardio", "keywords": ["Workout", "Nature", "Exercise", "Meditation", "Travel"], "long_description": "# Reach New Heights. Climb Fit XR: Turn Every Climb into Your Best Workout\n\n**\"Burn calories while you play, without even noticing the effort.\"** Defy gravity and scale the world\u2019s most breathtaking cliffs. Climb Fit XR is an immersive fitness experience that focuses on your natural movement\u2014no forced rhythms, just you and the vertical challenge.\n\n\u25cf **Your Workout, Your Pace:** Set the difficulty to match your fitness goals.\n\n\u3000\u25cb Easy: Gentle slopes for a mindful stretch and scenic views.\n\n\u3000\u25cb Normal: Balanced routes to find your rhythm and a steady burn.\n\n\u3000\u25cb Hard: Extreme heights designed for a true core workout.\n\n\u25cf **Atmospheric Immersion:** Choose your environment and time of day.\n\n\u3000 \u25cb Oasis Valley: The serene beauty of nature.\n\n\u3000\u25cb City Heights: A modern, vertical challenge among the skyscrapers.\n\n\u3000\u25cb Time of Day: Experience morning light, golden sunsets, and moonlit nights.\n\n\u25cf **The Natural Feel of Climbing:** No controllers needed. With **Hand Tracking**, use your own hands to grab the holds and make your way up. Moving with your own hands creates an **intuitive sense of immersion**.\n\n\u25cf **Real Results:** Engage your entire upper body and core. Track your effort in real-time with your integrated wrist device, showing **calories burned**. With our Checkpoint System, you can instantly recover from any fall and keep moving toward your goal.\n\n**Grab the holds. Conquer the summit today with Climb Fit XR.**", "short_description": "Climb Fit XR: Turn Every Climb into Your Best Workout\n\n\"Burn calories while you play, without even noticing the effort.\" Defy gravity and reach the summit on your own terms. Experience a new way to get fit while surrounded by breathtaking views.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33440431742270403"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1965201577713011"}]}, "baseline_offer": {"id": "1965201577713011"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770337920, "status": "PUBLISH
CZc1QG9NShGN9IEPrwv9MI4tzMc3J3QicfD9o3eHlRVC44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG0usHsAfQQFv7KdEd2dAH8r-qeFZncwhqrBFxlreEqQ&oe=6ACFB3E7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n7DnuzYW1GIQ7kNvwFCgWq9&_nc_oc=Ado-xRQmpfH7VoxNiozpcCzf-MROgl4yBsUGkLSe0sj_pV1CSki5kv_nEWaGfbMaDDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNot_7BsFb9W4vTl5JNUP81pf7_628ZAQX6kz1RYH07Wg&oe=6ACF9203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZPCOIJie9kQ7kNvwFPz167&_nc_oc=Ado7Ce2Q0ekUzUc6ILJrQOby4eViNc2aEvEmMdZrzrfN_iM-gm9i9KJQHqQIW8DKyvc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaUk96WI4GfjE85-S11UFGkJKnHNGx8qY9B8tu01cDYw&oe=6ACFA86B"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPgRUFJcAWAQ7kNvwENJq6v&_nc_oc=AdoX2mb_vQmi_Ibw-Vyhl9e2ALSvqkeNJULtivu9qXVUpvuVfAN9bo53IwHdMWoOVek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJoYqjloocds5EigZxEoMxmkfT4ge6EUsKkymm6gSFVA&oe=6ACF9E07"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUXs_D3k9S4Q7kNvwGiOSfj&_nc_oc=AdoJMKiD2qiJooDrs5NPgvQ2IxISAfnvpleXYqmehodbxPe5cQsE6Bhg6gzfEJ5zWak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOb_O-3ZQQj1YPCFbd2eEMWTgc_AeUVWD0dOYufs5jIUA&oe=6ACFA4BB"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
xM2Gl4v0sPo_2L67gWcE4B3znMAUhyA3IgecwoH5h6c_cE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFZjrzsoIyxWSoXctG98EhgfZsPoRW9qy_ETC6NEjPog&oe=6AE8C067"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSyxgcwwd_EQ7kNvwEf0XQS&_nc_oc=AdpWs0wiOKRF0v68y_wnh0fsgl4FndMLFyI_x5a6XTc2zWVgcuq26kVrrw9g7CX-mrg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzvdVtNH06H9C5Kflqyf50urX8Ixaesfd-2IiqHCjUHw&oe=6AE89E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04_zYOOW22YQ7kNvwHk6ebV&_nc_oc=AdqC8FtL7bcATQpeXeLtCC8-Q_hJyPkmW75BB_gC9ygVSUpaOEiTs7uZVnV5oVdlzrQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxeFeDeb8f0zi2EZqSd72WgybWIIZaUCbt03QQpkzJAw&oe=6AE8B4EB"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlahpYUvLfAQ7kNvwESgFL2&_nc_oc=Adraqj8gNDHNOECrLw3MaWm9zyPgjLerGrPk0Du4Fgdk1Cc4VJ3LN8p6jfNas2oIG4A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK1HP_PBpfe-24Wozno0QBY7Lhf620z1rOqc4RBkwJbw&oe=6AE8AA87"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jymJyFe_CfEQ7kNvwGyUFSe&_nc_oc=Adpo3XqUkDeixQ7270-onp8vHeLtKaOipbSTNDhGEUst4MECj8gG2FIRt6RVYQEgQqk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2-hLZfgxBkEtmGHUCnSckbxIGWA5ZQ7gool6fTGdJKw&oe=6AE8B13B"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
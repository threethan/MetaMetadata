WF2PPFWEgOj5iCpnDh8b-nJgh9EHCfBPJgnjz1SFCxbcWM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQME-JQxIXMHZwDrxUaO4-oaLdrMu4qeBwQKBUYxAQczjg&oe=6AE34227"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCVNuCI1LtMQ7kNvwE1EMGc&_nc_oc=AdoNv9Kx28DI6ils-X1CzEXoj4xNCF9aQWV0zRd_CxC-N0839cO1pDywpjojEZ7dTXc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHpB9cP8EBTx535ZvOVAjS3bEmZfyLHaNNRxF24JFfng&oe=6AE35883"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4K2ZohEGqsQ7kNvwEnudf8&_nc_oc=AdpTBDAAF7_-E4e_R1aQmiL1buDhgNvFu83F39x3xoPMbjwUySRoBdfeaxExRmK7OiM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYlBIxjdxFfylLoF9cTd5ZAaIcNsu-ikUQBAV_J2dcUg&oe=6AE36EEB"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKphDnpIptIQ7kNvwGL6oQL&_nc_oc=AdrPKdcZmp2Y1IupionSI85W7Uisp9ywa3oCeOcauCMwh0CsrLlqrCLLhEJh2e8uPZ8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOSOt0ADUcTg2PdPwzo2nw8aXc5hsDIBj7ZAplk7vPzA&oe=6AE36487"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe03ZjU-sg4Q7kNvwFGMNQz&_nc_oc=AdoQPdzVM7CxLhgnooAo1U7wYow7JDzi-N-4Dqj2h5zb7-WpJefABokhHtjygkltZJs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQGYot9KdJ8DCCDS0vlsUF39fVfzFEcRKgliZJLtoWuA&oe=6AE36B3B"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
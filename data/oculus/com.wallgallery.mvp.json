OYX8oclQL1n2qACHiuyq0YqtrysbVKcDgpsQyeJRaFgWmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa_rO_ZDk7U-QkT7hLZaoV7NOOnXsojXvFfvgqZgmABg&oe=6AE1F0A7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCVNuCI1LtMQ7kNvwG_hmXq&_nc_oc=AdoUvISnpodD4zZY7g2GljgNHaK8qUnIDxlzPp8f3CsNtmhg2zp1slLTUSoPq4pbaLI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0SV8NgKJgM044rP8BZKVJ19hbQitQt-2P1ICEXWggYQ&oe=6AE20703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24fFM2emQrgQ7kNvwEQP2FF&_nc_oc=Ado-z6Zgz139nn8lm1UbyH7U9YYzyt4k-ZV9W5zZTcRdhP1P_jNcboUAPcZsbY-dQBs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4kWXd11Oq7U1MlfIUDCZfkkArux9vEMKQrq7WTjgWow&oe=6AE21D6B"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HC6XPumIMIQ7kNvwFbFbMw&_nc_oc=Adoe3IUD2bnZOPI_LxYUvaO0yKb_j743flVt6R15yzwdHi3OApt9Ry7msjCIDJnC2lI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJEfP1jlCOzYPAWK1KFVNo_Q7-_eX1kJSRt6Go7p1WkA&oe=6AE21307"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe03ZjU-sg4Q7kNvwFdMZfH&_nc_oc=AdpSDVKwmtJassidczG7U6_DzUDe07AFItn0vgxC_ERZiI_CFt00VCgGtn9HryS19oo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeVy-VSKwuYSrqbEDu21wIi8MN59fSDuEsG6HSt9dQXA&oe=6AE219BB"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
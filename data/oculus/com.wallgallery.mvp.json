U-IQXyNfcSeNxWU0lpuIK_jE9iAFGtWjz44i8IE0l561Fo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRAK1Fl3SrYmI8riKtzMMaWMgwL7LWAPnIn4f0kHbAgg&oe=6AF9E3E7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSZP3Ahw_AIQ7kNvwFMl7EH&_nc_oc=AdphRIUfXmC_O-bqa-sjRTlJMQRnX7TQ6_Z8QBc91xv4mP_zOJkMlXO3xow_h5XneW4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKS_BRYP2xXTKDSyHcF0dBmgyEyIxb--BcDxsz88_Mhg&oe=6AF9C203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myP7tnRivw0Q7kNvwF8PAHF&_nc_oc=AdoP4NAWB6x3iw3fcesiyb5kjvxFcPPlQOrPkjRgf-bgLAMCO_x6r3oaEET8OXgl94E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHnKdLHoAJRO13Hw2g5kt1fjePOY-p16uOVOf4I6dVRA&oe=6AF9D86B"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCAY1_Ua9tMQ7kNvwEh3ovV&_nc_oc=AdovUyFIyZHw2Arvz4R5u8Ae-SECpM2f0QoM7QVRkbv4pAWC36HkS716QsDXsKKcVzU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiKlYMgQuZ2n2lMEqmexrs-s2brevk_XgMlZE3NsDgOw&oe=6AF9CE07"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYJ5iavZwF0Q7kNvwECTyYW&_nc_oc=AdrpWVuUYIdK_y_F0DbeHqsW2Prvw1nOeRTmN9f2qzfVy9QnvbW-dUKZcE8xamVFUOc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlyizvNmyzicyZm3hOWY_QikQeTV3wQig7e8xxPJC9-A&oe=6AF9D4BB"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
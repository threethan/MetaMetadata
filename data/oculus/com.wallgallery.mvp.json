5u2z1v1nYXvOiIkmSpYmyI-s65LEIuU8tu0qZ97i96jdMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSexBHq-TXVghBR6SbquY2kLgxwhumCqkTGXGXi9gQU2Q&oe=6AF740E7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0esbd1hf7DcQ7kNvwE9Mfwc&_nc_oc=Ado2k4XWjkFaXWwV80MLNagjVgughI20Q-iq1-z2_F8HRjQmAdWmohpZC4mYmMx6mBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2gCzC3-rtqjrrtjoXHnFURSMCrO3sPQdYM4BMx724xQ&oe=6AF71F03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myP7tnRivw0Q7kNvwHSHeOg&_nc_oc=AdrBYiVMELnlUqSVDDHGzmINsPlGveSsmdE95yy-wf_GyX4vgvZFAmX4waLCoyyrvhQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrAgPyRk66sY5e1SJUBkrYLHJB9Q8qlkLqqxRbg_Ksiw&oe=6AF7356B"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCAY1_Ua9tMQ7kNvwHZReUP&_nc_oc=Adpa7Nl5f8DULN1sIGGZ16vmpJ1QolZTOj4Se1z4Q8zmWXOpUyGGDdPXRuBX_Fc6jbI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReTVO4-lxF28LLrbTqEaM2ATLf1xyNbhFbar7YTjShSQ&oe=6AF72B07"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZHo0WDjrjsQ7kNvwHeCROp&_nc_oc=AdqrN-mx_Zfqn3il7NgSeqQR-jeXyIwMCeAy6c3GTEN8F7YPZqxUSoJ1XkOzX0qL_CM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTHnXX2a2_7zroP0Ge2RX_d4BiE2nU4HB8zzXsaDJrew&oe=6AF731BB"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
ifIEkzHIADKYkCxbcDMrZlQTdbb9C6gTDtYj0CU2dY_zao&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy6nZ2dZdt2sv8bguyPx3hTkhH4AX5V2QP3o75cMZ5GQ&oe=6AD256E7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zuQQ5QpzlBMQ7kNvwH2Bfz-&_nc_oc=AdoQtRQwcMXh66Q0UQEHTvNJn0P9D3ZEscAAgGJ-oaKvRQa3758Z2aM-jy21APL9_7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeS8SGhRwRaTNjOx6pLb7BlrNtiHHwR_Cj8dQj4DHGXw&oe=6AD23503"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZPCOIJie9kQ7kNvwEWLwd3&_nc_oc=Ado8YiQI14o-CSFkIZCJ1eG9y57Khe5U1v8jcAemvQrNb4ZYixetgsUZopIeMr08Rvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwwvwfXMK19dJG_WSVvwgVaQLOx2rUfqHT-W2mGgmsLA&oe=6AD24B6B"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPgRUFJcAWAQ7kNvwELkIZv&_nc_oc=AdpXn65UimdpEy3tRwqllyAjQC9MzVJAJC1KwhY6LUuwlYtQ2JsHh5UodOVV6k_l0JI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyMIXtY-mYPGsh9kwR32Vagn71E7AGdaF_lg5sHIaQ2Q&oe=6AD24107"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ddjUt_PizEQ7kNvwEbqFqC&_nc_oc=AdrIuLd7BTkFoV7S72SNj0lAe3AFbodp-HGkE-T72kvTpXagDk4Zidxg2efL6plGMIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAApyfaQmr8Z2Tj572AZjVjP1O9FwhrZzCz3OSt4go-w&oe=6AD247BB"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
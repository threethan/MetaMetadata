8UdkeQy9lHXsgkUEwjKhsoWCY0sxfMvAVPRb8VdW7Y4Hp0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHg1ntqWDNFnHR9MDtDvShtz_t57mVApiUGzkaB09xeA&oe=6ADDFC27"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUNKYROc9iAQ7kNvwFYjxsl&_nc_oc=AdpQrz82C3yY2OUC5FQiSDRBqRdgMiClrx__g9TyRKR8SGX2nzL815EvehMBr_cpJ5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJiWzQBVud_GlpJNhC0UK3sajRJsGOhDQ1ESRMq7MTww&oe=6ADE1283"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WArWCDjZyMQ7kNvwEdyXu3&_nc_oc=Adq1mvwykmwUx1-bIz_Ln0xGcTYoXz41txysY4HJB0PvhhoqhOTDFP3ZJxV7rASkPlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFg8S2FObbKocXPSQFX-NYc6z7h2vCWv0rD_zx6OQCHg&oe=6ADDF0AB"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC6Y3BnSer0Q7kNvwHNuxkE&_nc_oc=AdruYOHie69LkMp4IkK-iHhhmiPfQ9f4G5vYcVraP9FD64l2PeEQCWiul58bYjY0qhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvCpS1tyl2sZCLtwVcSXdHSatNybqsY_WuMJcfkhx7Kg&oe=6ADE1E87"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAyCbGyVerMQ7kNvwFeszCQ&_nc_oc=AdrqqMfJWPXuTtkhsvv-QDQFoskRtZGhrEnT7dqwfwhuHor_H4mctJzQMw3z7uoBYwg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYbiqV9ReWW2f_p__NFwfqBMJ3R_w1WWs7RrYTVktN6Q&oe=6ADE253B"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
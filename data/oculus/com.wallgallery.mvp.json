WrV1LZ3Ndj6H9Mp-6IB9IqM8aNF7hsbviYEF1NsArw_Mbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsg6fZuRTQW8b5k1Vq1Ur3cQbEhYclzLg11wCO4etmUw&oe=6AE76EE7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2ewhcWo-wYQ7kNvwEYcqfC&_nc_oc=Adq3ruscxxURvaS9RQAeFbfCOrQMMuqBdYlaXn6s_wFaWwcz-lRwRR2a46FeWUz2N8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLou7jLJe7y3XsNQ4Enc6oynAI-w7sxxrjLUBc71iIKg&oe=6AE74D03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04_zYOOW22YQ7kNvwEHelxF&_nc_oc=AdqTiIaWSKMxRGfkKsgCMzfcRg9Zk7SU12mAbx252Eo0s6eECzMicfUa3lQL_zczV-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQgE2oPX8-KoDTK2ymyswPU-AZ_wvIqUZr54dy_rQ-pA&oe=6AE7636B"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlahpYUvLfAQ7kNvwHttB4W&_nc_oc=AdrAG4HVwAF4Z0p_R53fyNL4ngakG-a-Bp0Pm92xvBpCis7tVEdKhb1LPpUoc0mzmbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_3cTJCT7m4pwQgr686aZ1YZbujHj6OC-ygtaKXawfTw&oe=6AE75907"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=225ypAC-uekQ7kNvwHE1n6D&_nc_oc=Adp-BR_C00mg7n_mAA0Ot6zUP0e0AegofA16__upPPilQZRLVhBmEwr0_6FPLpSNp84&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh6WguaoiEVSb5WMnsaPwHT74ZQLOlBqjr9eSyrOAHqw&oe=6AE75FBB"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
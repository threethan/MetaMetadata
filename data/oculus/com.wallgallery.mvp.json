QLrwpKM2E3HKrbWrzDGExq60pDfhlBnvw_jftUeMZUx2jg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3WL-hA7yZ_x4aIouU8d6HrOBaBXwixY5M6SaiVxjYrQ&oe=6AE493A7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCVNuCI1LtMQ7kNvwEbbe3b&_nc_oc=AdotwdG1-bf6EdklHZTXqv-c3ova5H1we5l6ZV6kS3x3bDHM0TJ5H1lmjks2BSXfTWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2fnO1UPD8eijfre4v1AsRK8cJF45IccgKV_IH42rDIw&oe=6AE4AA03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4K2ZohEGqsQ7kNvwFtQAMF&_nc_oc=Ado6OC7sJTQ4E4C3e0NFHhjQYwYztCn4TiI_tHcrPx60Qxk-Fdn5RaKpPTvWjCAjcTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIJG3U0UvxRXGmibJ_hFYm0-91vRFsTWhuxr4TOfYqSw&oe=6AE4C06B"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKphDnpIptIQ7kNvwGufawG&_nc_oc=AdpdJYL-FQ_blNp784CSae6KYPT7THmWFALonav7goY4L_yu2wex61TKaYBGipvBX5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWXt_lE9KqelVm7QQ2xK3p82vJtB8bfveDhC4P3WVjqw&oe=6AE4B607"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=225ypAC-uekQ7kNvwHboUcY&_nc_oc=AdqfsTyMxhAg4EamfWbqjoas_cCYbT3RU5Y1F-hnMc_Kage1ZS6BFIoqsYB8TUc1B14&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlZlFyiV7tbyadUcPuD9p94yTr6rr11cbgnWLvRn_nAw&oe=6AE4BCBB"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
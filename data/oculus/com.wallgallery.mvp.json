d-O4_-jF4FFwUZiQInE4cUcqHqrvDam6HmJMYdGFV3dRKo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxPCAV5iqQNR3w0YAD5WqH1e08JQln1R1Z8dkM4c0yYA&oe=6AECB4E7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-cCULzikwkQ7kNvwEiyB_6&_nc_oc=AdrmM6etifkp-W3ZD92dH_PP4wt-uGZ9UbQAOYMGXV5SkhueklWbAReGGMCoNjvP1-A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvVxDb33V98uXRc0ZYj-PFAWnkeLmdxD6txUe-9-UnDw&oe=6AEC9303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-en.png", "id": "1439152265075750", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620384_1439152268409083_4371573523600941675_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuEKPh7ZKnQQ7kNvwEbcOYp&_nc_oc=AdoCKB8JpflJQcpSkNcLIDk6-MhBLf-8lvLuC9Yzj00ieGd9xb-sIijQzpa7tw1Rxcg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcjvemSe-4NJpf8O-4i9hYKSSRfONocG1MQkMYXu_wIg&oe=6AECA96B"}, "display_name": "Wall Gallery", "keywords": [], "long_description": "Make a private museum from your own photos, illustrations and videos.\n\nFolder Gallery arranges media automatically. Curated Gallery lets you choose artwork and place it by hand. MR places artwork on recognized walls in your room.\n\nUse Quest files, Chrome/Edge on Windows or Mac, Chrome on Android, or the free Windows companion. Scan a QR, then confirm the source on Quest; manual pairing is also available. Keep both devices on the same home network and the sharing page visible. Android folder selection depends on browser/device support; keep the screen on. See our website for information on getting the dedicated iPhone/iPad companion.\n\nCurated Gallery and MR save copies of imported external images and supported videos on Quest, so you can view them after sharing stops or the app restarts. Each newly imported video must be 200 MiB or less. External Folder Gallery media requires the source. Originals are unchanged.\n\nFree: the first three Folder Gallery rooms, one Curated Gallery museum/room, and MR. Gallery Plus is a one-time unlock for Folder Gallery from room 4 and additional Curated Gallery rooms/museums.\n\nScenery Pack: Garden, Space & Aquarium is a separate one-time purchase: seasonal gardens, simulated space and living aquariums. No Gallery Plus needed; use purchased scenery within free room limits. It does not add MR interiors.\n\nNo developer-cloud media storage. Optional analytics is off by default. Japanese/English UI.\nhttps://wallgalleryvr.web.app/", "short_description": "Build a private museum for your photos, illustrations and videos on Meta Quest. Arrange a folder, curate artwork by hand, or place it on real walls in MR. Pair PC/Android sharing with QR, and add Garden, Space & Aquarium scenery (sold separately)."}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2619599065209384", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623115_2619599068542717_7352383380500856888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQYGDd1RUfIQ7kNvwGf8bAy&_nc_oc=AdohaH_CIaB_Wr4k7I2csspoC4cOUGmXPOhqrjepAMhyOPeU3G-PAlGAIpllgEi4by4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmMo7U_dNTjuAJ5hb1ZyacpYuGVyL0ubMuqimeWG7EIw&oe=6AEC9F07"}, {"file_name": "hero-ja.png", "id": "2014343642618395", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628411_2014343645951728_4562829356690172004_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CYWli3cc7sQ7kNvwFF95OQ&_nc_oc=AdptTBg_GH_LAGWI1sXtMGgVABbF80dGuZcyKRBA1GrlLT0s9FA4uurMfZzgzEgm0X8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2WYQHykS3U36wuHQa5lZwIWqyie8huUdWG0tp9vjPsQ&oe=6AECA5BB"}, {"file_name": "cover-landscape-ja.png", "id": "1644585963747257", "image_type": "APP_IMG_COVER_L
IUh7-M4P6yvP7t6fNwjo-eWnG7ist5r8_8FRkuYqo2tbsJoIoZTDpVyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNiU-piy42KEivVRKywGWyIO5HCRnWYeYaKH0_Mhp9uw&oe=6ACA6DE7"}, {"file_name": "screenshot-5.png", "id": "38860828796897016", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_38860828810230348_1103194535780539056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzK8u7eCyPMQ7kNvwEoBses&_nc_oc=AdoDo-hx5opq3a3HFf-tx89438CssLBrtHBTYh3CkDSVBEzUuIqCWHNYwpAQUuhNYZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMamTQf2SmZYmR-jV8DOztWyosAdV9nGU195dvdLcsoyg&oe=6ACA4C03"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wall Gallery", "keywords": [], "long_description": "Turn a folder of photos, illustrations and videos into your own walk-through museum. Adjust artwork size and spacing, or jump to a piece from its thumbnail.\n\nTHREE WAYS TO DISPLAY\n\u2022 Folder Gallery: Choose a folder for automatic exhibition.\n\u2022 Curated Gallery: Name a museum and arrange artwork and frames yourself.\n\u2022 Display in Your Room: Place artwork on real walls using mixed reality.\n\nFREE & GALLERY PLUS\nFree includes the first room in Folder Gallery, one museum with one room in Curated Gallery, and mixed reality display. The one-time Gallery Plus purchase unlocks all Folder Gallery rooms and additional Curated Gallery museums and rooms. No subscription. Device limits still apply. Future scenery packs are sold separately.\n\nPlay, pause and seek videos with your controller. One video at a time. Japanese, English and offline help included.\n\nUse Quest files, or open this page\u2019s website link ON YOUR COMPUTER. Choose Web app (Chrome/Edge on Windows/Mac; no install) for Folder Gallery, or Windows app for older-video conversion and experimental AI upscaling. Keep sharing open on the same network. Transfers are encrypted.\n\nTouch controllers required; VR walking uses thumbsticks. Select subfolders separately. Keep originals available. Video support depends on codecs. MR needs room setup and spatial permissions. Bring your own media.", "short_description": "Turn a media folder into your own walk-through gallery. Enjoy photos, illustrations and videos from Quest, Windows or Mac."}]}, "developer_name": "Miura Create", "developer_privacy_policy_url": "https://wallgalleryvr.web.app/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Miura Create", "support_website_url": "https://wallgalleryvr.web.app/", "website_url": "https://wallgalleryvr.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1400046653184444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620384_1140936231826167_1330529702039063788_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2g812KTLQwQ7kNvwE-SJqp&_nc_oc=AdoCS8Ucc6w69jK8qEfIp7c-66UE2VogbmqxxnKIslWXfAYLONm2jgOXRmYWrospRa0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVfQzLIOJeP0gofG56EHdqAU8Tsk68KYqFBR3ORTL5Pw&oe=6ACA4E85"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wall Gallery", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date"
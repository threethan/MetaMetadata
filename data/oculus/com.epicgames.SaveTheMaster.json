": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473392016_562345762792884_5624705697246977299_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AYKSsdJPvgQ7kNvwHjmgG_&_nc_oc=Adl0etflSYXQ3F8jfG3DQvaDSFHxfldoDXNEvdk0ghDSIPZaJzpkvXwlvm0U7MnjXEs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aft_z6xHXi33Xr7bexAR4eYNyUoJ1FxN6Ltk2mCVw2praQ&oe=69A1A434"}, {"file_name": "P1.png", "id": "2968775426617302", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473392010_2968775429950635_2418395031575134852_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wkr3wDoz0AEQ7kNvwHy2nQh&_nc_oc=AdnAqCXtRk-4X96F7s3GiqsBN5838jQ6PLchV7d14l74RXdNsRrANR1mxR09qGHXQhU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvzzAL1geg55dYFp1ud9bNzLQ6B1KjwIvtcxRapy8uv-A&oe=69A1A4AB"}, {"file_name": "P2.png", "id": "1635574790397347", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391959_1635574793730680_184528494410836065_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKlaJMTwhbgQ7kNvwGi1tBn&_nc_oc=AdlKwO6ut1qsWNXMti-jUEz9ETDKrX8zjnWSa3woeTdgLVxsQno5iso4sOgaZRZaHt0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftODgbSzL-InzGhGtUKgP3KDBj-iF-CUmzZlBAhHwx-MA&oe=69A198A1"}, {"file_name": "P5.png", "id": "1605156610197303", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/473392298_1605156613530636_2432481374586448896_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNWE3KWHQ0AQ7kNvwEU_NMu&_nc_oc=AdnLBAoQ9LJGRoqU4EXdEnRJ9wgN5thSn3tZazaqLcwFTNgAPKgFCJ5l7Y5FpICP-eg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs9K9bNUl9APO_Lu1BO0Otc0aGM_k0Yt4KaDRGCgra5RQ&oe=69A19BC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capa2560x1440-1.png", "id": "3880240432240203", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393328_3880240435573536_5535053881360562455_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_eut_mL4YAQ7kNvwGlLbRk&_nc_oc=Adm5Zk7EuSJgXnfghad0jf1CrKD3Ze7HoWZdJ0JmkaX2HAdDN8ZFtGRAoxGpgQR72vY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Aft_S1r-1cL2VtywmZi0Mm69fgT2os-SG7MfNdExhNi8Bg&oe=69A1778B"}, "display_name": "Vampire\u2019s Factory", "keywords": ["Horror", "Survival", "Puzzle", "Vampire", "Scary"], "long_description": "\ud83e\ude78 Welcome to Vampire\u2019s Factory \u2013 Where One Mistake Could Be Your Last! \ud83e\udd87\nYou've just been hired at the most unusual blood distribution factory in the world. Your job is simple: sort the blood containers correctly as they pass through the conveyor belt. But there\u2019s a catch\u2026\n\n\u26a0\ufe0f Do NOT trust the labels! The only thing that matters is the color of the sign. Make a mistake, and your boss might take more than just your paycheck...\n\n\ud83d\udc80 Can you survive the job?\n\nTest your reaction time and focus in an increasingly fast-paced challenge.\nExperience a mix of dark humor and horror in a thrilling VR experience.\nWork under pressure as the conveyor speeds up and the boss keeps a close eye on you.\nPlay it safe, or your time in Vampire\u2019s Factory will be very short\u2026", "short_description": "\ud83d\udd25 Work for a vampire... or become his next meal! You've been hired to sort blood in this eerie factory. But be careful\u2014one mistake might cost you much more than your job... \ud83e\ude78\ud83e\udd87"}]}, "developer_name": null, "developer_privacy_policy_url": "https://khargooshstudios.weebly.com/privacypolicyvf.html", "developer_terms_of_service_url": null, "publisher_name": "JRad Games", "support_website_url": null, "website_url": "https://khargooshstudios.weebly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
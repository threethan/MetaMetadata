": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392016_562345762792884_5624705697246977299_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ShMpol3FBwQ7kNvwEK3EcC&_nc_oc=Adkp5FewREJnA0n8sOZpOkBqia-1nYtRr-XHE__2O4u4xrJcnAvUo9_Q88_lUizwGmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftmXEfwUQV-uomZW9KE7CVm9lIAmX2Q7lSHjYJFew9WLw&oe=6999BB34"}, {"file_name": "P1.png", "id": "2968775426617302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_2968775429950635_2418395031575134852_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7Csa-cVsngQ7kNvwF2XK_Y&_nc_oc=AdkjIoBa5P_shfu5Hjx1RqtMu5tbmSbvxlyJBY7HjqlIi5MrGiLjRzLxzad97L-gVj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZRt3JewzQwLbjkoOJFmTTzLOhsA5gjd6ggdZzF0AFXQ&oe=6999BBAB"}, {"file_name": "P2.png", "id": "1635574790397347", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391959_1635574793730680_184528494410836065_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GC_qtKGa6hIQ7kNvwFt0wPN&_nc_oc=AdkbPTa7ytm55D1b7BVLY4ydfLMCXhaUfRwhXfNPlBSTIfgKxoMRIPR3s6lrtsv_pB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEfBaKl4L00UQo9DkOI1-ApO8eZGpu2A__69abJuASZQ&oe=6999AFA1"}, {"file_name": "P5.png", "id": "1605156610197303", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392298_1605156613530636_2432481374586448896_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLeFSTdACGgQ7kNvwF3IXlv&_nc_oc=Adn2OOWMcbBw5E3EcDJZ6e4M6ew2VzRqXYtniIXPJHfMCPr1CDM24FtN5yfHHzwnWLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuqNEc3uncoZ08Qujc07oMRZ79KYrAD6Kv7pLBPhuMIhw&oe=6999B2C2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Capa2560x1440-1.png", "id": "3880240432240203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_3880240435573536_5535053881360562455_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0YCmPkatplwQ7kNvwHD3DoE&_nc_oc=Adk4I1ke7sc-kvvkF1NHUDqLbfu9z9fwrE0Me63gGZxWH9hqT_tQn-bRrpEUtZqLwig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs2nsI3iEIyPTqP5Lw3RbeKV_JtNC2x1g7fAzYh0JRJYA&oe=69998E8B"}, "display_name": "Vampire\u2019s Factory", "keywords": ["Horror", "Survival", "Puzzle", "Vampire", "Scary"], "long_description": "\ud83e\ude78 Welcome to Vampire\u2019s Factory \u2013 Where One Mistake Could Be Your Last! \ud83e\udd87\nYou've just been hired at the most unusual blood distribution factory in the world. Your job is simple: sort the blood containers correctly as they pass through the conveyor belt. But there\u2019s a catch\u2026\n\n\u26a0\ufe0f Do NOT trust the labels! The only thing that matters is the color of the sign. Make a mistake, and your boss might take more than just your paycheck...\n\n\ud83d\udc80 Can you survive the job?\n\nTest your reaction time and focus in an increasingly fast-paced challenge.\nExperience a mix of dark humor and horror in a thrilling VR experience.\nWork under pressure as the conveyor speeds up and the boss keeps a close eye on you.\nPlay it safe, or your time in Vampire\u2019s Factory will be very short\u2026", "short_description": "\ud83d\udd25 Work for a vampire... or become his next meal! You've been hired to sort blood in this eerie factory. But be careful\u2014one mistake might cost you much more than your job... \ud83e\ude78\ud83e\udd87"}]}, "developer_name": null, "developer_privacy_policy_url": "https://khargooshstudios.weebly.com/privacypolicyvf.html", "developer_terms_of_service_url": null, "publisher_name": "JRad Games", "support_website_url": null, "website_url": "https://khargooshstudios.weebly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
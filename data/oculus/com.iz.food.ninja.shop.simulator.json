Zoh-2nZD5Vwv8giyqLBeduIzHKzQuBKm4HerynEUoTqMdtafsZCL4gG0dJoGpRE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pcphff2Nn0yF00kAseT45ajTnrdrWol_6Jzaz-cbFxg&oe=6A26DAF3"}, {"file_name": "New_Dish (1).png", "id": "2069333793797750", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617729_2069333797131083_5314184660514945346_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2N3lTR9PnIQ7kNvwE1AGZE&_nc_oc=Adq02T4yEr4n0O7WbsyTbY7NTc--LbW6oV3og45pCUhbVnrC7Zqvo66cox794nqtJmo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1pa3Gb9jEPtd1RqXV0Xkk9XN94jJJWlx7gwWcCha3jQ&oe=6A26E0C3"}, {"file_name": "Final_Lobby.png", "id": "984518754046167", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618102_984518757379500_7628526375062783032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=of4RiSzLntEQ7kNvwFmi0sh&_nc_oc=AdpUcNzkZ8xGpNpLuxZ_kJ5F28KMK8uUxs856EEi2YzG-2ZZdfPGGdpm6B1tggL1Jqo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kWmv3AA40AGsegdK3eJ8-rM21WYxX43oj9y_igLNIDA&oe=6A26E1A1"}, {"file_name": "Weapon.png", "id": "1348166553321380", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830146_1348166556654713_286825441741443697_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcYg5lR1mFsQ7kNvwHU6T5k&_nc_oc=AdpLtHNhmqy_iFy-QI0PLTX_eB10bri_ulNAOS1V3-WJ7MhJYURRRezRHP1qq4XFMPo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vDOpOHJreDb9Qp2sVT9c6WwRzYSoxjNYPf5bb1Os0wQ&oe=6A26D0D9"}, {"file_name": "Food_Serving.png", "id": "1846673312725781", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831964_1846673316059114_831992244305948436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY6myGnb9BsQ7kNvwGS5xE3&_nc_oc=AdodaanQ7Xzp4_3lhTl2-3gZPe96fAwcPB71C49rEGdqazdsEk3XIK90HoGq4qC3ElE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c961lh7l0sgbirLfZZtnRJ6IU5tLXSldsZ1T6_SYD9Q&oe=6A26D86A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "3128695984001851", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825470_3128695987335184_3440123624498065229_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NsEH4ZEgH74Q7kNvwFhoW0j&_nc_oc=AdovMQKKyIC8qUaog2SCcFdPOC7qJxy7-5kVYUFg6KwvJ-elIuPZ2ll398WcjQfvPt0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bZGWpb4kDlFiH2iaUqp9HT1P3HZUlwulCa9ATRYzYYQ&oe=6A26ED25"}, "display_name": "Be A Chef - Cooking Simulator", "keywords": ["food", "cook", "fruit", "i", "am"], "long_description": "# Welcome to Be A Chef \u2013 Cooking Simulator, where every dish is an adventure!\n\n**Blast, Toast, and Serve!**\n\nTake on food prep with high energy fun as you use the \"bread blaster\" to launch slices into a toaster. Catch the toasted bread mid-air and deliver it to your waiting customer. Get ready for a chaotic and skillful food truck adventure!\n{1645096993361876}\n\n**Master the Art of Waffles!**\n\nDive into the food truck and take charge as you prepare a mouth-watering waffle dish. Use a batter dispenser, slice fresh ingredients, and arrange everything to perfection for your customer\u2019s order. Get ready for the fun, interactive chaos of cooking!\n{1467031911582805}\n\n**Unlock Breakfast Fun with Every Slice:**\n\nGrab your katana and slice through the bread to unlock new levels in the Breakfast shop! Each precise cut takes you one step closer to serving up some serious breakfast fun. Let the culinary chaos begin!\n{1476120907301225}\n\n**Cutting Fruit:** \n\nSlice through various fruits in the VR world with sharp precision. Master your skills in this immersive fruit-slicing experience!\n{708254775617881}\n\n\n**Cutting with Axe:**\n\nSwing the axe and cut through large fruits in this action-packed VR experience. Use your strength and accuracy to become a slicing master!\n{1169096235408829}\n\n\n", "short_description": "In this immersive VR game, players can slice and dice fruits in a variety of fun and exciting ways, unlocking new cutting tools and challenges as they progress. Experience the thrill of cutting fruits with an axe and unlocking new fruits to keep the action going!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27544192345167208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820887_1474431340761835_7493170275249797645_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzoFg90aAcsQ7kNvwEr0yFN&_nc_oc=AdoLcIu5SM1FdX4eQoNopS-KOa2PjtQK_6d13Gb_rP9Uwbfzk2lqIFSn_Eg9cMLNxlE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JzRMQw66rVMmP1i6nLC_ZT3l_jtqIx9RlpBkJXsHWjQ&oe=6A26DA51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Be A Chef - Cooking Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "i
z3LFuzT4fXJOb15JBzhW2eMfN-h5KtPP7PbPK8Ps2aJwbIW_2W0-KhmwMGHM9A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YXCbr-j4I-RQCr4an90TR-79MmA0KJSfQ9d9m3zG_Ig&oe=6A1465F3"}, {"file_name": "New_Dish (1).png", "id": "2069333793797750", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617729_2069333797131083_5314184660514945346_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3do9GaQT7pIQ7kNvwEjIEdr&_nc_oc=Ado4UYJVvXm-ej6vaEshJsWp9CJU39H4G54vjFeXElqgfVTAs-D7_Nokhyyn0BCNiDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zvPYJWY1X4Pdd9T93VblRjw1jLDHWXw9diMcl_Q5HXQ&oe=6A146BC3"}, {"file_name": "Final_Lobby.png", "id": "984518754046167", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618102_984518757379500_7628526375062783032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLbcgMBcdgUQ7kNvwGy5vpG&_nc_oc=Ado3zF7NHCAmZlgEgWRMuY0DIm7pyYSa-EjRxGDFE5qRBdmURQvo_KYskSPpSpeTzFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59rPiDnT5qCDdel19xZVVwQLnMR9X293m34OwFR0i6Qg&oe=6A146CA1"}, {"file_name": "Weapon.png", "id": "1348166553321380", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830146_1348166556654713_286825441741443697_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CspxwAmttXsQ7kNvwGBUwY-&_nc_oc=Adoa1hcaw2kIpQ6ngHQqZGdmIiMSMjUcKZj3DT79Af-tPJFTui3qT5bUaFnPC3jcvXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ld5rAkJyaGXPYoZFljyvrnqU83YJLc-wrAlK1te6hBw&oe=6A145BD9"}, {"file_name": "Food_Serving.png", "id": "1846673312725781", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831964_1846673316059114_831992244305948436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aB1aHxIihMQ7kNvwGtT4bX&_nc_oc=AdpK1LfizMKvudU1MmmJpw6XCQQIi0SClFX5-Kl_Hq62DMloqotiPj_1lNAHQ7pswXU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nB6Wv1oEucgY5E_vmDr-d85Nlz7p5FYsTB7HKhRdMbg&oe=6A14636A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "3128695984001851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825470_3128695987335184_3440123624498065229_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9ff7nr5Ro0Q7kNvwF4CSna&_nc_oc=AdocChqRomttUBhFtYRKk5e_T9ncpPON2o468MEu6ncb8STvJc9IJsBiyDTkMMt-FwM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CrZVvRwwYVjZ0z1epOyeRMEoQ10i_pwm0b_TN1mFQ7w&oe=6A147825"}, "display_name": "Be A Chef - Cooking Simulator", "keywords": ["food", "cook", "fruit", "i", "am"], "long_description": "# Welcome to Be A Chef \u2013 Cooking Simulator, where every dish is an adventure!\n\n**Blast, Toast, and Serve!**\n\nTake on food prep with high energy fun as you use the \"bread blaster\" to launch slices into a toaster. Catch the toasted bread mid-air and deliver it to your waiting customer. Get ready for a chaotic and skillful food truck adventure!\n{1645096993361876}\n\n**Master the Art of Waffles!**\n\nDive into the food truck and take charge as you prepare a mouth-watering waffle dish. Use a batter dispenser, slice fresh ingredients, and arrange everything to perfection for your customer\u2019s order. Get ready for the fun, interactive chaos of cooking!\n{1467031911582805}\n\n**Unlock Breakfast Fun with Every Slice:**\n\nGrab your katana and slice through the bread to unlock new levels in the Breakfast shop! Each precise cut takes you one step closer to serving up some serious breakfast fun. Let the culinary chaos begin!\n{1476120907301225}\n\n**Cutting Fruit:** \n\nSlice through various fruits in the VR world with sharp precision. Master your skills in this immersive fruit-slicing experience!\n{708254775617881}\n\n\n**Cutting with Axe:**\n\nSwing the axe and cut through large fruits in this action-packed VR experience. Use your strength and accuracy to become a slicing master!\n{1169096235408829}\n\n\n", "short_description": "In this immersive VR game, players can slice and dice fruits in a variety of fun and exciting ways, unlocking new cutting tools and challenges as they progress. Experience the thrill of cutting fruits with an axe and unlocking new fruits to keep the action going!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27167286559524457"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_1474431340761835_7493170275249797645_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRI5bDNMTkcQ7kNvwFKwcVl&_nc_oc=AdoYv1AH0i7-tsVbNFbB-KNJPxakuxqvpkLKlmgxHN0Yf6LNkhML6ViNLBrMWEXLvQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ppml7YOm0bBBdgOnthnUlZfqnLFFu4FQMMgqZl-2MPg&oe=6A146551"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Be A Chef - Cooking Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1760588220, "lastRevision": {"nodes": [{"id": "25185006717752461", "release_type": "SCHEDULED", "administration_statu
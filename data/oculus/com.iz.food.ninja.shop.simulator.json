=6e7a0a&_nc_ohc=VxsCbGef9h4Q7kNvwEXYXnC&_nc_oc=AdpXcPs46l7EMQr4Ag_0BkHisel5eHi2ETzWZKrzqkAWrF7nQyNDCfVDpfQRaWQDjL0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5wWra4JJ0zSiB6Adqs-gvM-6-lyNZfA7l3UCRUdn3Vg&oe=6A2FF793"}, {"file_name": "Food_Serving.png", "id": "1846673312725781", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831964_1846673316059114_831992244305948436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TkrLsRR9AgQ7kNvwHo8SCn&_nc_oc=AdrhMkIbMB0GRuFXKogMXyj_GEdfZCHhpENeQUSMwWl8YPWfU2fBu4Z4vB_-c2rGdbU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7wPxo9MMsxLkV81eL7l2dz5SMPXwGntYPdtHLmKKY4Q&oe=6A3012EA"}, {"file_name": "Shop.png", "id": "1226870236131683", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619074_1226870239465016_4184252460972799649_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6Vp5FPCmAcQ7kNvwFVsYbE&_nc_oc=Adpk47uTIhDI_B0Ehs5OlqPoaZ6fbHfHC3y94hMQr7k0vpAtJmHfiSQKwCO_PvebJm8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o6oftpFfpGi8FlCV9w2tjhsx4P68ahAA_jaQFDeADng&oe=6A302253"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Food Ninja Shop Simulator", "keywords": ["cooking", "slice", "food", "recipes", "cook"], "long_description": "# Step into the World of Food Ninja Shop Simulator!\nUnleash your inner ninja in this immersive VR game. Slice fruits, upgrade your tools, and unlock exciting new challenges in Food Ninja Shop Simulator on VR!\n\n**Cutting Fruit:**\n\nSlice through various fruits in the VR world with sharp precision. Master your skills in this immersive fruit-slicing experience!\n{708254775617881}\n\n\n**Cutting with Axe:**\n\nSwing the axe and cut through large fruits in this action-packed VR experience. Use your strength and accuracy to become a slicing master!\n{1169096235408829}\n\n**Unlocking Fruit:**\n\nUnlock new fruits and increase the excitement as you progress in the game. Discover and slice a wide variety of fruits!\n{1509469300368651}", "short_description": "In this immersive VR game, players can slice and dice fruits in a variety of fun and exciting ways, unlocking new cutting tools and challenges as they progress. Experience the thrill of cutting fruits with an axe and unlocking new fruits to keep the action going!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25185006654419134"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "976857631716018"}, {"status": "PUBLISHED", "id": "1310735650871535"}, {"status": "PUBLISHED", "id": "1393463945822067"}, {"status": "PUBLISHED", "id": "1583773119301385"}, {"status": "PUBLISHED", "id": "1187920706027882"}, {"status": "PUBLISHED", "id": "1182598943745562"}]}, "baseline_offer": {"id": "976857631716018"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780034880, "status": "PUBLISHED", "id": "976857631716018"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27425273280392449", "version": "0.1.8"}, "id": "24889372600688409", "channel_name
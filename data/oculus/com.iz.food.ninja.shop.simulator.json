v_m_HG1l4_7cXVPv0-Tnpme66_Y9CH1NJeq9xEcFlkl7Xg509_6hLOZePUYB16k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nBopaFZSkJ32M6Ni44-jvbJJP8IZq_KjNTFkzyJ5vaQ&oe=6A2EC3F3"}, {"file_name": "New_Dish (1).png", "id": "2069333793797750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_2069333797131083_5314184660514945346_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDgUg-96KCsQ7kNvwFJOtG6&_nc_oc=Adrhu4gX2H6smUk8um2rDDbYrvhYBiwcwag6K9XWwF6vk-XeS-Y_Yd72co3YrPtH33c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UcOsTYEaAinQARek3xIPzy7c_qgs3Y28tUm0LgeLvzQ&oe=6A2EC9C3"}, {"file_name": "Final_Lobby.png", "id": "984518754046167", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_984518757379500_7628526375062783032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjZuYKym7IsQ7kNvwF9ZL9N&_nc_oc=Adqg10wLbrpknXSRkv6pFFHR_bQNxhV8CD-OR-wR4eQh1FoD2-O9Srmul8JA2wCnmpc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UDGU5t-YvKnv7gwGMj96-UHH2YpQbiPlF0ZRmFYYQeg&oe=6A2ECAA1"}, {"file_name": "Weapon.png", "id": "1348166553321380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830146_1348166556654713_286825441741443697_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpPvnpXfnUYQ7kNvwExYozF&_nc_oc=Adr_VwBAhYxI9NQ3m_wN6y8IxNUwHvCp5O8p6-JqmNj4dDlfEkiPm0yMyCb2KgzqYSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AU6A4v7dGWguyrF6jnikyn4Eg62CcfOPgv0bi9DWaog&oe=6A2EB9D9"}, {"file_name": "Food_Serving.png", "id": "1846673312725781", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831964_1846673316059114_831992244305948436_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3CBHlm5_K8Q7kNvwFR_ql3&_nc_oc=Adra1ISTxXE7vJcGaDsuwT4qyvqDJxRPu0rmbyLYmR8Azxt3Ysgozn4nSvVdm0K9BRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vvUrwUsyIMTJUCZii6FgqdvTD0i8TjqXXg_97W-wKog&oe=6A2EC16A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "3128695984001851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_3128695987335184_3440123624498065229_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTzomllL32EQ7kNvwFunkpQ&_nc_oc=AdrtVSsi6eTjwxnDKnuU44fkWsJgJch7m6hHpX9ZjphbbkOcxezz50RlXXTYDyl60sY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2WGM3aXRhAFzqgA7WS1r8vTv2cTK-tGc4JX_pIBV5xw&oe=6A2E9DE5"}, "display_name": "Be A Chef - Cooking Simulator", "keywords": ["food", "cook", "fruit", "i", "am"], "long_description": "# Welcome to Be A Chef \u2013 Cooking Simulator, where every dish is an adventure!\n\n**Blast, Toast, and Serve!**\n\nTake on food prep with high energy fun as you use the \"bread blaster\" to launch slices into a toaster. Catch the toasted bread mid-air and deliver it to your waiting customer. Get ready for a chaotic and skillful food truck adventure!\n{1645096993361876}\n\n**Master the Art of Waffles!**\n\nDive into the food truck and take charge as you prepare a mouth-watering waffle dish. Use a batter dispenser, slice fresh ingredients, and arrange everything to perfection for your customer\u2019s order. Get ready for the fun, interactive chaos of cooking!\n{1467031911582805}\n\n**Unlock Breakfast Fun with Every Slice:**\n\nGrab your katana and slice through the bread to unlock new levels in the Breakfast shop! Each precise cut takes you one step closer to serving up some serious breakfast fun. Let the culinary chaos begin!\n{1476120907301225}\n\n**Cutting Fruit:** \n\nSlice through various fruits in the VR world with sharp precision. Master your skills in this immersive fruit-slicing experience!\n{708254775617881}\n\n\n**Cutting with Axe:**\n\nSwing the axe and cut through large fruits in this action-packed VR experience. Use your strength and accuracy to become a slicing master!\n{1169096235408829}\n\n\n", "short_description": "In this immersive VR game, players can slice and dice fruits in a variety of fun and exciting ways, unlocking new cutting tools and challenges as they progress. Experience the thrill of cutting fruits with an axe and unlocking new fruits to keep the action going!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27544192345167208"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_1474431340761835_7493170275249797645_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srGDNK5g5SwQ7kNvwG3cdZ0&_nc_oc=AdpTSkyLqJZhr2JzyPIv6lrJw1u05yP8WermJ-qJH2R5sERlCwH4a-_jN-zGNMj5kVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g8aEJSofKnlo21Y-WzYxnTCtmKo-qoQfr9_aIjPeGIw&oe=6A2EC351"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Be A Chef - Cooking Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "i
file_name": "2560 x 1440.png", "id": "3128695984001851", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825470_3128695987335184_3440123624498065229_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nx755MmjOFEQ7kNvwEKWwgO&_nc_oc=AdpEZW2o_rbi4DCbg0aO2_T8oP13RcrjZMsZ3Us1RxA-61pg1dEbDhqCHn_xVjuPfEc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y1kFW_Irul5tefAX7eFn2cFgX1LhjUgI_kKNi_QDGsA&oe=6A1C28E5"}, "display_name": "Be A Chef - Cooking Simulator", "keywords": ["food", "cook", "fruit", "i", "am"], "long_description": "# Welcome to Be A Chef \u2013 Cooking Simulator, where every dish is an adventure!\n\n**Blast, Toast, and Serve!**\n\nTake on food prep with high energy fun as you use the \"bread blaster\" to launch slices into a toaster. Catch the toasted bread mid-air and deliver it to your waiting customer. Get ready for a chaotic and skillful food truck adventure!\n{1645096993361876}\n\n**Master the Art of Waffles!**\n\nDive into the food truck and take charge as you prepare a mouth-watering waffle dish. Use a batter dispenser, slice fresh ingredients, and arrange everything to perfection for your customer\u2019s order. Get ready for the fun, interactive chaos of cooking!\n{1467031911582805}\n\n**Unlock Breakfast Fun with Every Slice:**\n\nGrab your katana and slice through the bread to unlock new levels in the Breakfast shop! Each precise cut takes you one step closer to serving up some serious breakfast fun. Let the culinary chaos begin!\n{1476120907301225}\n\n**Cutting Fruit:** \n\nSlice through various fruits in the VR world with sharp precision. Master your skills in this immersive fruit-slicing experience!\n{708254775617881}\n\n\n**Cutting with Axe:**\n\nSwing the axe and cut through large fruits in this action-packed VR experience. Use your strength and accuracy to become a slicing master!\n{1169096235408829}\n\n\n", "short_description": "In this immersive VR game, players can slice and dice fruits in a variety of fun and exciting ways, unlocking new cutting tools and challenges as they progress. Experience the thrill of cutting fruits with an axe and unlocking new fruits to keep the action going!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27167286559524457"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820887_1474431340761835_7493170275249797645_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieV_AqkVvykQ7kNvwGMEmVS&_nc_oc=Ado5ovKUfHQKBaXvy685EJLgZX2Pz7zK6zFcT8DrH-gCS1tZOmbnCKMdMEYBswsc940&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GlYSA0fX83FgVCuQ54Q4w2mPWKIHl9WTFLwFiC6XlTA&oe=6A1C4E51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Be A Chef - Cooking Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1760588220, "lastRevision": {"nodes": [{"id": "25185006717752461", "release_type": "SCHEDULED", "administration_statu
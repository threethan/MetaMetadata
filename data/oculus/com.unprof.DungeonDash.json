EqA&oe=69A836DF"}, "display_name": "Dungeon Dash", "keywords": [], "long_description": "Step into the Dungeon where every second counts! In this high-octane virtual reality experience, embark on a timed dungeon run filled with fierce enemies and cunning traps. each requiring a specific pattern that you have to memorize if you want to get to the end before the timer runs out\n40 levels of increasing difficulty and over 12 different monster and obstacle to overcome!(and many more to come) plus an infinite mode where you can keep challenging yourself\n", "short_description": "Dash through a randomly generated dungeon , defeat enemies and avoid traps before the timer runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dashdashdundun/accueil", "developer_terms_of_service_url": null, "publisher_name": "Kwinwin Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/dashdashdundun/accueil", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9586052854822694"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391974_1169391574623084_4406695460735670502_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTcPAKa7K3QQ7kNvwFJbtlp&_nc_oc=Adn7UuDkYWugnnKkKoDk6912v4okk
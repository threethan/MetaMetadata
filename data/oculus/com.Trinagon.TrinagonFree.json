oO9gioifqJyHWwGTVCjtd-3JzJbcwdw&oe=6AA422D6"}, {"file_name": "Screenshots_VR_2560x1440_5.png", "id": "26106743968982247", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827987_26106743985648912_4255555926828310878_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZYlstUqXQgQ7kNvwHoU3dN&_nc_oc=Adpz-vOYiR1gI7Bon8cWHs3zu4R9rUVbaYA0e2I7IZabHYgYXUtdhIAqd5IgXle5300&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAnB0r9dnc4r2eSqVRKLB5nxQWh5XleE0EHSs2s1_K4Q&oe=6AA3FBE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaTrailerTitleShot.png", "id": "951061647456288", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824182_951061650789621_1216583622337101362_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2X885_o-wp0Q7kNvwGZZjQb&_nc_oc=Adp-yMTu2R1T06_yUkn2MrO6MwrXB09sKTPwG6MfsX2DVGue4YelqBRrjsFukyjE7Xw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxvxVnRC0Ws25dtslzqtFAbYT3Zut4h_s5RmTswfXMmg&oe=6AA4116C"}, "display_name": "Trinagon - Spatial Puzzle", "keywords": ["puzzle", "spatial", "logic", "geometry", "twisty"], "long_description": "**Trinagon** is a spatial puzzle built from simple geometric rules.\n\nAcross surfaces made entirely of equilateral triangles, triangular pieces move between neighbouring positions by rotating around their common nodes.\n\nBy observing how these movements interact, you gradually uncover the logic and symmetries that shape each puzzle.\n\nThe puzzle surfaces may be **flat or folded around polyhedral forms**, yet the underlying structure remains the same: a **continuous triangular grid** where every move follows clear geometric rules. \n\nAs pieces travel across the surface, new situations emerge that reward careful observation and spatial reasoning.\n\nAt first the challenge is simply understanding how the system behaves. Over time, more intricate configurations appear as different nodes interact and the puzzle unfolds across increasingly complex surfaces. What begins as a simple geometric puzzle gradually becomes a deeper**logic puzzle of spatial relationships and symmetry.**\n\n**There is no timer and no pressure.**\n\nTrinagon is designed as a quiet environment for focused thinking. Some puzzles resolve in seconds, while others may invite exploration over hours or even days.\n\n**Solutions are not judged by speed, but by elegance.** \nDiscovering a clearer and more refined sequence of moves is part of the experience \u2014 and often the most satisfying.", "short_description": "Rotate triangular pieces around shared nodes to restore order across geometric surfaces. \nTrinagon is a calm spatial logic puzzle where elegant solutions emerge from simple geometric rules."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trinagon.com/impressions/reality-check", "developer_terms_of_service_url": null, "publisher_name": "Trinagon Studio", "support_website_url": null, "website_url": "https://trinagon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26013105971692445"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2759733034377599"}, {"status": "PUBLISHED", "id": "932727859129091"}]}, "baseline_offer": {"id": "932727859129091"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "275
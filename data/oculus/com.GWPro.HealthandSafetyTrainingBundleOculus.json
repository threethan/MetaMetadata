_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLdFK-uP2pfwHvFk79CLCtpUg_-Km8RQ1LSijYdIYfdA&oe=69AC2511"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ET_meta_2560x1440.png", "id": "334719156393952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75340710_334719159727285_2662614486446128346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTDYC57ouzUQ7kNvwHNek_Q&_nc_oc=AdnW2W8fxUfTKOrytGrkuQmeCKfQQFZfRmLs6dtfM5Zd-YqlD5GC8lrHOcDUll2NnXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoBKS5WaoJp5OONLEOZ7Xj8Brp2K444MnUxl_t5vYNwg&oe=69AC1760"}, "display_name": "Health and Safety Training Bundle", "keywords": [], "long_description": "Train your professional skills in GWPro VR Training safely and in correspondence with international standards! (OSHA, NEBOSH, ISO).\nThis VR Training Bundle includes:\n\n1. Electrical safety\n2. Work at height\n3. Fire Safety (WORKSHOP)\n4. Fire Safety (OFFICE)\n5. Lockout Tagout (LOTO)\n6. Confined Space Entry\n7. Hot Work\n8. Load Slinging\n9. Maintenance Safety (Pipes and Acids)\n10. Underground roof fall hazard assessment\n11. Truck preparation for driving\n12. Road accident with dangerous goods\n13. Workplace safety\n14. Scaffolding (Wedge Lock Scaffolding Assembly Training)\n15. Arc Flash (Flashover) Training\n16. Personal Protective Equipment\n17. First Aid\n\nAll VR training consists of 3 modes: Study, Training, Exam, providing step-by-step control of all VR activities.\nLanguage support: English, Portugu\u00eas, Arabic, Espanol, Dutch, \u666e\u901a\u8bdd (\u4e2d\u56fd\u5927\u9646), \u0939\u093f\u0928\u094d\u0926\u0940 (\u092d\u093e\u0930\u0924), \u0c95\u0ca8\u0ccd\u0ca8\u0ca1 (\u0cad\u0cbe\u0cb0\u0ca4), \u09ac\u09be\u0982\u09b2\u09be (\u09ad\u09be\u09b0\u09a4), \u65e5\u672c\u8a9e\uff08\u65e5\u672c), \u092e\u0930\u093e\u0920\u0940 (\u092d\u093e\u0930\u0924), Bahasa Melayu, T\u00fcrk\u00e7e, \ud55c\uad6d\uc5b4, Fran\u00e7ais, Deutsch, Ti\u1ebfng Vi\u1ec7t, Italiano, Farsi, \u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4\u0ac0 (\u0aad\u0abe\u0ab0\u0aa4)\n", "short_description": "Train your professional skills in GWPro VR Training safely and in correspondence with international standards! (OSHA, NEBOSH, ISO).\nThis VR Training Bundle includes 15 ready-made VR modules covering wide variety of professional topics.\nAll VR training consists of 3 modes: Study, Training, Exam, providing step-by-step control of all VR activities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1r7fPASKr-4XFrvk21IGtZ-w_H0dYz9jk/edit?usp=sharing&ouid=111001160316405883703&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "GWPro VR Training", "support_website_url": null, "website_url": "https://gwpro.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "pt_BR", "es", "hi", "bn", "ja", "tr", "ko", "fr", "de", "vi", "it", "gu", "nl_BE", "sv", "cs", "ms", "pa", "kn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25747952148153392"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1586547172056392"}, {"status": "PUBLISHED", "id": "867687852034070"}]}, "baseline_offer": {"id": "1586547172056392"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737976260, "status": "PUBLISHED", "id": "1586547172056392"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "
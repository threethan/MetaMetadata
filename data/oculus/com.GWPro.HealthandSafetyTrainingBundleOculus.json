6_A9A5if4mC2Sk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs3Umu5tqnGxNmEpS0nzDjfa4q80b88T13RSd5GRXsfTA&oe=699C329A"}, {"file_name": "08.png", "id": "401824872497162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982470_401824875830495_6886804828124866932_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnZXumvI7I4Q7kNvwEenRDI&_nc_oc=AdlNcv0pqcNESYN-qLTKaGovwnXOAuucPsQN01GYC2E-JMzYVADQBd9JQGZwbU_-b0E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv3S65oWF5vtJTvqoJCnCUs6Cd-gpkMtT0f61hgvwMspw&oe=699C4989"}, {"file_name": "13.png", "id": "316272631457017", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_316272634790350_3064227896207871112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRQjExRuOcAQ7kNvwEe5Hld&_nc_oc=AdloYOBVRypbBVfZ5leK_JD35t1Jf-XLePuYZUXi7Go5DdWM2t9t4bChq9Q24knNlig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftCN4-Q06saa6348vFuVp3vbym736pevBDU-H5_MuCVVQ&oe=699C5311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ET_meta_2560x1440.png", "id": "334719156393952", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75340710_334719159727285_2662614486446128346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQskIfayvIUQ7kNvwEE2ABq&_nc_oc=AdnNJjsbAiISQR-s5TPUaGKFsPHgQIR4w0Mtday1akLhJN-d1ZtejgNv--QshMV3XSs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuPtQhfTZwsE2Ohu2FGB5Axp96-yiaVH9J17QdtbNJYhw&oe=699C4560"}, "display_name": "Health and Safety VR Training Bundle", "keywords": ["vr", "training", "safety", "career", "vocational"], "long_description": "Train your professional skills with GWPro VR Training safely and according to international standards! (OSHA, NEBOSH, ISO).\nThis VR Training Bundle includes:\n\n1. Arc Flash (Office)\n2.  Arc Flash (Pump Station)\n3.  Confined Space Entry\n4.  Electrical Safety (Type 1 Switchgear)\n5.  Electrical Safety (Type 2 Switchgear)\n6.  Fire Safety (Office)\n7.  Fire Safety (Workshop)\n8.  First Aid\n9.  Forklift Hazard Recognition\n10.  Forklift Pre-operational Inspection\n11.  Hot Work\n12.  Load Slinging\n13.  Lockout Tagout (LOTO)\n14.  Maintenance Safety (Pipes and Acids)\n15.  Personal Protective Equipment\n16.  Risk Assessment\n17.  Road accident with dangerous goods\n18.  Scaffolding (Bakers Scaffolding Assembly)\n19.  Scaffolding (Wedge Lock Scaffolding Assembly Training)\n20.  Trenching and Excavation (Field Work)\n21.  Trenching and Excavation (Road Construction)\n22.  Truck preparation for driving\n23.  Underground roof fall hazard assessment\n24.  Work at height\n25.  Workplace safety\n\nAll VR Training consists of 3 modes: Study, Training, Exam, providing step-by-step control of all VR activities.\n\nThese modules are suitable for corporate and vocational training.\n\nLanguage support: English, Bahasa Melayu (\u0628\u0647\u0627\u0633 \u0645\u0644\u0627\u064a\u0648), \u010ce\u0161tina, Deutsch, Espa\u00f1ol, Fran\u00e7ais, Italiano, Latvie\u0161u, Nederlands, Polski, Portugu\u00eas, Sloven\u010dina, Svenska, Ti\u1ebfng Vi\u1ec7t, T\u00fcrk\u00e7e, \u0627\u064e\u0644\u0652\u0639\u064e\u0631\u064e\u0628\u0650\u064a\u064e\u0651\u0629\u064f, \u0641\u0627\u0631\u0633\u06cc, \u666e\u901a\u8bdd (\u4e2d\u56fd\u5927\u9646), \u65e5\u672c\u8a9e, \ud55c\uad6d\uc5b4, \u09ac\u09be\u0982\u09b2\u09be (\u09ad\u09be\u09b0\u09a4), \u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4\u0ac0 (\u0aad\u0abe\u0ab0\u0aa4), \u0939\u093f\u0928\u094d\u0926\u0940 (\u092d\u093e\u0930\u0924), \u0c95\u0ca8\u0ccd\u0ca8\u0ca1 (\u0cad\u0cbe\u0cb0\u0ca4), \u092e\u0930\u093e\u0920\u0940 (\u092d\u093e\u0930\u0924) and more. ", "short_description": "Train your professional skills with GWPro VR Training safely and according to international standards! (OSHA, NEBOSH, ISO).\nThis VR Training Bundle includes 25 ready-made VR modules covering wide variety of topics suitable for corporate and vocational training.\nAll VR training consists of 3 modes: Study, Training, Exam, providing step-by-step control of all VR activities."}]
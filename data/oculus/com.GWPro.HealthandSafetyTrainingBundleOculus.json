6oLnlmYbWWO2GP-OdgVPD7g&oe=6AFC93C4"}, {"file_name": "002.png", "id": "1155070373536244", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1155070376869577_2828587026076853413_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7qAcslsLb0Q7kNvwEcAKWi&_nc_oc=AdqL4SaJrs16cwcbi5X6wHfS3I6HUh-dL2fmbSV0YFbr9YEQKAzSitUsHpYgTAeoCoQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwCDst4DBYB3BDDfMzPlFFjNCbty9z4FywR6xt6qW-Kg&oe=6AFC704C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ET_meta_2560x1440.png", "id": "334719156393952", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75340710_334719159727285_2662614486446128346_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bfiWfyZ2EdAQ7kNvwEtA_Z4&_nc_oc=AdpJpJ2-HajmJlmXpKd0a3hR4Mg-GDRk7_8VFXqO2ySfcLtyCv8OKOqpB9cKr2TtLes&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFTXbV8mXQJebPTntc9nVO_kgLrwbUbSUQVdQH3P8xxA&oe=6AFC7E20"}, "display_name": "Global Workforce VR Career Training", "keywords": ["career", "vocational", "cte", "workforce", "training"], "long_description": "Practice high-risk work in VR before you do it for real. GWPro puts learners on realistic job sites to follow real procedures, make mistakes safely and see what each would cost. For colleges, vocational schools, employers and HSE consultancies.\n\n{1861464874870688}\n# **34 MODULES**\n\n**Oil & gas**\n\nGas Detection & H2S, Well Control (10 scenarios), Hot Work, Confined Space \nEntry, Maintenance Safety (Pipes & Acids)\n\n**Electrical & energy**\n\nElectrical Safety, Electrical Safety (Type 2 Switchgear), Arc Flash (Pump Station, Office), Lockout/Tagout (LOTO), Solar Panels Maintenance (Rooftop)\n\n**Construction & trades**\n\nWork at Height, Scaffolding (Wedge, Baker), Trenching & Excavation (Road, Field), Load Slinging, Asbestos Handling, Welding (SMAW)\n\n**Logistics & driving**\n\nForklift Inspection, Forklift Hazard Recognition, Truck Pre-Drive Inspection, Dangerous Goods Road Incident, Risk Acknowledgement (Delivery Safety), Van Driver: Distractions & Hazard Awareness (City, Rural)\n\n**Mining**\n\nRock Scaling (Underground)\n\n**Core safety & emergencies**\n\nWorkplace Safety, Risk Assessment, Personal Protective Equipment (PPE), First Aid & CPR, Fire Safety (Workshop, Office), Emergency Response\n{1835374400987491}\n# **HOW IT WORKS**\n\n- Learning, Training and Exam modes\n- Single-player or instructor-led multiplayer\n- Scores, certificates and SCORM/xAPI reporting to your LMS\n- New hazards every session in inspection modules\n- Built with NEBOSH-certified HSE experts to OSHA, NEBOSH and ISO 45001 practice\n- 30+ languages; no VR experience needed\n\n\n{29401454949491149}", "short_description": "Immersive VR training for Careers and the Workforce.GWPro helps students safely practice job-ready skills, bridge theory and practice, and prepare for real careers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gwpro.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "GWPro VR Training", "support_website_url": null, "website_url": "https://gwpro.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "pt_BR", "es", "hi", "bn", "ja", "tr", "ko", "fr", "de", "vi", "it", "gu", "nl_BE", "sv", "cs", "ms", "pa", "kn", "lv", "sk", "pl", "sw"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_m
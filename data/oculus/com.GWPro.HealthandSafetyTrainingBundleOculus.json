6&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wFDTJq-EsoQ7kNvwGD5SKZ&_nc_oc=Adpb8V8pOGdvdiVlJOX5jOX3CrWLP85P_EHdohD4MehyX7ujKY9bAM1g8uFMR6H2E7Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jCk7fqXzU_04Z9Mk0QA0Ip9xVjK-WSKllIYE5-Gjwjw&oe=6A21925A"}, {"file_name": "08.png", "id": "401824872497162", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982470_401824875830495_6886804828124866932_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mYKdZEFqggQ7kNvwE7P5Qf&_nc_oc=Ado7NqbUABMuKOR04BZPAnYxBIzviB30XKhKfiZvPi0ws9QJBX3w017aqdJGvAzQoG8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dECGRakmOgQtx5i3xhOpEfrk7Y32cGGKUIK0tyBCVxw&oe=6A217109"}, {"file_name": "13.png", "id": "316272631457017", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031454_316272634790350_3064227896207871112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D410ChV3OvAQ7kNvwE6W1rl&_nc_oc=AdoXGdPfdLiNlIGyb3uCwqxZFKcle2MEgRxMZxFQp0jJj-aWKVhzAJm23P-WyJvtGvY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qcELwmoEeLfxa3ymZUbBpAHDUuAyvrJayEeLKV9QJMQ&oe=6A217A91"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ET_meta_2560x1440.png", "id": "334719156393952", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75340710_334719159727285_2662614486446128346_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4czFOQIDekQ7kNvwGsT-6M&_nc_oc=AdoGb4cjgOmqZ80mez8nD6W_i0eA-EntrUHlABng8HqfMoSsyZDJFPBmBUb512SpKWw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BW5_2hlIJXVSPIXE2eqGWUwRjA6jpJSrId2FNjcSf6w&oe=6A21A520"}, "display_name": "Health and Safety VR Training Bundle", "keywords": ["vr", "training", "safety", "career", "vocational"], "long_description": "Train your professional skills with GWPro VR Training safely and according to international standards! (OSHA, NEBOSH, ISO).\nThis VR Training Bundle includes:\n\n1. Arc Flash (Office)\n2.  Arc Flash (Pump Station)\n3.  Confined Space Entry\n4.  Electrical Safety (Type 1 Switchgear)\n5.  Electrical Safety (Type 2 Switchgear)\n6.  Fire Safety (Office)\n7.  Fire Safety (Workshop)\n8.  First Aid\n9.  Forklift Hazard Recognition\n10.  Forklift Pre-operational Inspection\n11.  Hot Work\n12.  Load Slinging\n13.  Lockout Tagout (LOTO)\n14.  Maintenance Safety (Pipes and Acids)\n15.  Personal Protective Equipment\n16.  Risk Assessment\n17.  Road accident with dangerous goods\n18.  Scaffolding (Bakers Scaffolding Assembly)\n19.  Scaffolding (Wedge Lock Scaffolding Assembly Training)\n20.  Trenching and Excavation (Field Work)\n21.  Trenching and Excavation (Road Construction)\n22.  Truck preparation for driving\n23.  Underground roof fall hazard assessment\n24.  Work at height\n25.  Workplace safety\n\nAll VR Training consists of 3 modes: Study, Training, Exam, providing step-by-step control of all VR activities.\n\nThese modules are suitable for corporate and vocational training.\n\nLanguage support: English, Bahasa Melayu (\u0628\u0647\u0627\u0633 \u0645\u0644\u0627\u064a\u0648), \u010ce\u0161tina, Deutsch, Espa\u00f1ol, Fran\u00e7ais, Italiano, Latvie\u0161u, Nederlands, Polski, Portugu\u00eas, Sloven\u010dina, Svenska, Ti\u1ebfng Vi\u1ec7t, T\u00fcrk\u00e7e, \u0627\u064e\u0644\u0652\u0639\u064e\u0631\u064e\u0628\u0650\u064a\u064e\u0651\u0629\u064f, \u0641\u0627\u0631\u0633\u06cc, \u666e\u901a\u8bdd (\u4e2d\u56fd\u5927\u9646), \u65e5\u672c\u8a9e, \ud55c\uad6d\uc5b4, \u09ac\u09be\u0982\u09b2\u09be (\u09ad\u09be\u09b0\u09a4), \u0a97\u0ac1\u0a9c\u0ab0\u0abe\u0aa4\u0ac0 (\u0aad\u0abe\u0ab0\u0aa4), \u0939\u093f\u0928\u094d\u0926\u0940 (\u092d\u093e\u0930\u0924), \u0c95\u0ca8\u0ccd\u0ca8\u0ca1 (\u0cad\u0cbe\u0cb0\u0ca4), \u092e\u0930\u093e\u0920\u0940 (\u092d\u093e\u0930\u0924) and more. ", "short_description": "Train your professional skills with GWPro VR Training safely and according to international standards! (OSHA, NEBOSH, ISO).\nThis VR Training Bundle includes 25 ready-made VR modules covering wide variety of topics suitable for corporate and vocational training.\nAll VR training consists of 3 modes: Study, Training, Exam, providing step-by-step control of all VR activities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1r7fPASKr-4XFrvk21IGtZ-w_H0dYz9jk/edit?usp=sharing&ouid=111001160316405883703&rtpof=true&sd=true", "developer_terms_of_service_url": null, "publisher_name": "GWPro VR Training", "support_website_url": null, "website_url": "https://gwpro.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "pt_BR", "es", "hi", "bn", "ja", "tr", "ko", "fr", "de", "vi", "it", "gu", "nl_BE", "sv", "cs", "ms", "pa", "kn", "lv", "sk", "pl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30097652406516656"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823492_1436218897550047_8567200220239671601_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMV0E-dQ8SkQ7kNvwGahHA2&_nc_oc=AdqWUY_kvvEsRjpOtFVR67INaKDD5qaZmwhLiL7cvQvUuijOh4iJnizIyHhCJW8qDxg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iB5i9ux89VKYBB51SA-ePUkeQrjLrIQMk0IdhhvLatQ&oe=6A21A0D4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Health and Safety VR Training Bundle", "platform": "ANDROID_6DOF", "context_category": {"context_category"
enshot-05_2560x1440.png", "id": "1215770573538594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301375_1215770576871927_8390750158089108073_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Opwh8LMK2FwQ7kNvwEd329c&_nc_oc=AdpICuTv3F4mF97YFa-jo45z4JepAOqDNdgFXm0dE5JS2u-v3pSom-C1HVBS1OcItXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpdc3Jg6DehbMo1ocxIQ1fU9lGplUyAuuff6U_pvXppQ&oe=6B030244"}, {"file_name": "floorparx-screenshot-03_2560x1440.png", "id": "1232507088596091", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300547_1232507091929424_8710783044832712905_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgNlYoOgdxMQ7kNvwFwTf6R&_nc_oc=Adqnoy2vRqeEFzadL7O07qCdyrT7Ka6bcuAesFs6W4IQ3-wzXJS7c-2qN8OKqIyOQ6k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIbod9zzsk3jwhJ2Vii6sWVMqssQtb5Qg3l_XGVkreEw&oe=6B030CEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "floorparx", "keywords": ["architecture", "home", "estate", "floorplan", "housing"], "long_description": "You can walk freely across the plan, place furniture, and even display walls with cutouts for doors and windows. Upload your own plan to floorparks.com and explore your building project before construction even begins. This gives you a true sense of space and proportion, helps you plan more effectively, and allows you to spot and avoid costly design mistakes early on.", "short_description": "Floorparx offers a completely new way to present and experience floor plans. Imagine laying out any floor plan right in front of you on the ground\u2014scaled to life-size, with every dimension matching reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/plan2d/info/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/plan2d/info/terms-of-use", "publisher_name": "byteAgenten gmbh", "support_website_url": null, "
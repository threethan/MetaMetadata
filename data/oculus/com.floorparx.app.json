Jg&oe=6AB54BE8"}, {"file_name": "floorparx-screenshot-02.png", "id": "2224974735119956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824700_2224974738453289_2138144348482482163_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujjdHegTjVEQ7kNvwF_h6RJ&_nc_oc=AdpJi_gcZhGbMe3gQMoqeeS4CZBbl8I6D-lTs-Mr_8kM9qeanKcvhrqxFDEU87XT0CA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_5E-r9B3LsIzmc4mJS5a2ZFCcOLaRHNkg0bkVPhkahg&oe=6AB5451E"}, {"file_name": "floorparx-screenshot-03.png", "id": "1703554134205402", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827601_1703554137538735_1392408500952323664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2danHymfSAQ7kNvwGUGJld&_nc_oc=AdrjBcVg1i8ac0U-XwyxrKNUpFQjfm8UXVtBq9NMFKDjnGz5119PPdQ-PaJ_Y-muSPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv8WoibA_jcqt7kJfCEQnvO79yyloTHteDDLQWmMmP_Q&oe=6AB51CE0"}, {"file_name": "floorparx-screenshot-05.png", "id": "1004925252363835", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1004925255697168_7490180609674205606_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6wIZ0-RZyAQ7kNvwFFHv3v&_nc_oc=Adq42fjOMsFowTrvrtloFASk3r1GCaJtsuxrvQ7fBTiroQnZKikQkwPMbRPjlsVArfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY6-98EyT__d2NW55U8sMiyU5MbVe9c02hY2ZIOnjCGw&oe=6AB5431C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "floorparx_trailer_preview_image.png", "id": "1231887472363116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673799750_1231887475696449_3906624255222324958_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spPvkLOJDBwQ7kNvwHB6Vpd&_nc_oc=Adrx45fZz9UN75Q4a2eKghsnll5wDqVH-nOsVZ0qA2AiVrd_11Wo4hTPCjUqXYCCr-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN-KYTgpktCMz4LJEzoi23rJuRL4mY8XjVc-ZlWnUy3A&oe=6AB51D1D"}, "display_name": "floorparx", "keywords": ["architecture", "home", "estate", "floorplan", "housing"], "long_description": "With Floorparx, a 2D floor plan becomes a full-scale virtual walkthrough.\nInstead of interpreting abstract lines on paper, room layouts, dimensions, and walking paths become tangible and realistic.\n\nYour customers can freely move through the floor plan and evaluate and discuss the design together with family, friends, site managers, or architects.\n\nFurniture can be placed, walls can be moved, and doors and windows can be adjusted flexibly.", "short_description": "Walk your plan\nGive your customers an unmatched experience and leverage the power of VR technology to avoid planning mistakes and identify change requests at an early stage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/terms-of-use", "publisher_name": "byteAgenten gmbh", "support_website_url": null, "website_url": "https://floorparx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27766136713070671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_2133693117558662_9113446634866323619_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vX6F6MIDIAQ7kNvwFztLK9&_nc_oc=Adot87Ihs4hkZzYaSJM4Fv-fhm0ttbAzwVmvw9I0w
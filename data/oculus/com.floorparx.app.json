ription": "With Floorparx, a 2D floor plan becomes a full-scale virtual walkthrough.\nInstead of interpreting abstract lines on paper, room layouts, dimensions, and walking paths become tangible and realistic.\n\nYour customers can freely move through the floor plan and evaluate and discuss the design together with family, friends, site managers, or architects.\n\nFurniture can be placed, walls can be moved, and doors and windows can be adjusted flexibly.", "short_description": "Walk your plan\nGive your customers an unmatched experience and leverage the power of VR technology to avoid planning mistakes and identify change requests at an early stage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/terms-of-use", "publisher_name": "byteAgenten gmbh", "support_website_url": null, "website_url": "https://floorparx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27766136713070671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_2133693117558662_9113446634866323619_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouiR1JhNtAAQ7kNvwGmmpHK&_nc_oc=Adq5N0-RsfxquZrHcyuaR4ZnXz2YHjwva5O9mZqf6
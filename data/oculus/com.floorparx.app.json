n.com&_nc_ss=8&oh=00_AfyARyIVIvDdRIqefc5Icox_PmmYTn3VkuK-DikK6P7GZg&oe=69B54D0F"}, {"file_name": "floorparx-screenshot-05_2560x1440.png", "id": "1215770573538594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301375_1215770576871927_8390750158089108073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5fVzhwRamcQ7kNvwG0jLgP&_nc_oc=Adk9v0JGDd9J-iH5F0B4zJLfCuhJoukwh2MXBAK6xleAYwAf2IuRmr9ZfmhNXVgClds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyRtQH-hhxlmH59fQOc5Jxtb5ZeskN_Yy8zKFUrkyG5Xw&oe=69B53E84"}, {"file_name": "floorparx-screenshot-03_2560x1440.png", "id": "1232507088596091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300547_1232507091929424_8710783044832712905_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HdFK1TO9OrQQ7kNvwFF3RnB&_nc_oc=Adm_fw133ji65xc3P5nblbQiFEAKLHU1dIikSdB9PWFXqbhlGVZECMKcKWlWxVSZcGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIyb-WUZmauNfMSTFgLLzzSO_9MHKd3X6ANtu0vZ0ocQ&oe=69B5492E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "floorparx", "keywords": ["architecture", "home", "estate", "floorplan", "housing"], "long_description": "You can walk freely across the plan, place furniture, and even display walls with cutouts for doors and windows. Upload your own plan to floorparx.com and explore your building project before construction even begins. This gives you a true sense of space and proportion, helps you plan more effectively, and allows you to spot and avoid costly design mistakes early on.", "short_description": "Floorparx offers a completely new way to present and experience floor plans. Imagine laying out any floor plan right in front of you on the ground\u2014scaled to life-size, with every dimension matching reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/plan2d/info/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/plan2d/info/terms-of-use", "publisher_name":
n.com&_nc_ss=8&oh=00_AfzqaTLf5qzZ9Szab75RVOJqeAZHzOi3EuMHniENpb93HQ&oe=69BE878F"}, {"file_name": "floorparx-screenshot-05_2560x1440.png", "id": "1215770573538594", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301375_1215770576871927_8390750158089108073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R87e54KzNBUQ7kNvwGIYgob&_nc_oc=AdnGxK9x4NA6iwIbbu40KPY0Dy9S7cHN0_QwkDqs9NjkJc-HwQyl94iKziR5cC4XZsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1bi7rlEGFr6bsIGI2VXmQu39107ZbRluevdjkaV_53A&oe=69BE7904"}, {"file_name": "floorparx-screenshot-03_2560x1440.png", "id": "1232507088596091", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300547_1232507091929424_8710783044832712905_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOgV-y4GY38Q7kNvwHkHmvV&_nc_oc=Adn6YKAH4sqbUh8125H6zVyqWiyStk0yYtXzYiYeBRzO64XF9UGM4bJ-w5RN0ePBy-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhaUl9KuTWyI0G_E_PBcpWBLatL0mCdosojzI-HEl3Ng&oe=69BE83AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "floorparx", "keywords": ["architecture", "home", "estate", "floorplan", "housing"], "long_description": "You can walk freely across the plan, place furniture, and even display walls with cutouts for doors and windows. Upload your own plan to floorparx.com and explore your building project before construction even begins. This gives you a true sense of space and proportion, helps you plan more effectively, and allows you to spot and avoid costly design mistakes early on.", "short_description": "Floorparx offers a completely new way to present and experience floor plans. Imagine laying out any floor plan right in front of you on the ground\u2014scaled to life-size, with every dimension matching reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/plan2d/info/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/plan2d/info/terms-of-use", "publisher_name":
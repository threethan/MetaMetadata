n.com&_nc_ss=8&oh=00_AfwEZd4Bh1JqWWH37ZymG3oQW7OaFHJBySch0JBZf30AvQ&oe=69BA930F"}, {"file_name": "floorparx-screenshot-05_2560x1440.png", "id": "1215770573538594", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499301375_1215770576871927_8390750158089108073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDrz7siRgukQ7kNvwEtrJ28&_nc_oc=Adm5SFTncz5gq-QTpmY562Kl8j8ywnvxBTmU7q247oh-wJMYH0CDOY9clpH6Xew9El4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzAMDpULSGB6hj2N_hla4gHRhxOIo_bkCdhr_lqUwu4A&oe=69BA8484"}, {"file_name": "floorparx-screenshot-03_2560x1440.png", "id": "1232507088596091", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300547_1232507091929424_8710783044832712905_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjD2_VZUkjoQ7kNvwHvvWvq&_nc_oc=AdnEMu7ergYXvEonMMDCjoJGQqMVC776oeqAhFWZ-4rm5o2hiDkASyynTrW6ViXELvQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7jeLJWT5Kk0v5sf5pMSiAAdy38RjuCdAVKl-6F6Y3UQ&oe=69BA8F2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "floorparx", "keywords": ["architecture", "home", "estate", "floorplan", "housing"], "long_description": "You can walk freely across the plan, place furniture, and even display walls with cutouts for doors and windows. Upload your own plan to floorparx.com and explore your building project before construction even begins. This gives you a true sense of space and proportion, helps you plan more effectively, and allows you to spot and avoid costly design mistakes early on.", "short_description": "Floorparx offers a completely new way to present and experience floor plans. Imagine laying out any floor plan right in front of you on the ground\u2014scaled to life-size, with every dimension matching reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/plan2d/info/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/plan2d/info/terms-of-use", "publisher_name":
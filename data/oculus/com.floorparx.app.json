n.com&_nc_ss=8&oh=00_Afvl-cXo9BgyiPzdEAJvKgY522vmyclupVrwdw5qAM_n4g&oe=69A96F8F"}, {"file_name": "floorparx-screenshot-05_2560x1440.png", "id": "1215770573538594", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499301375_1215770576871927_8390750158089108073_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NL19ntp5JcQ7kNvwGKm3qJ&_nc_oc=AdlDSOBIntTeNgXXo82CjVoL340cZv8r1q3CQsN-4-2hqfptEvlFQYokFwe2FzLDz5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afty5zKMN-0hNFE3tVqNoF1ErBsU23zGp2JVcL6bFqG-IA&oe=69A99944"}, {"file_name": "floorparx-screenshot-03_2560x1440.png", "id": "1232507088596091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300547_1232507091929424_8710783044832712905_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxGVinwDjOQQ7kNvwFyDFkU&_nc_oc=AdnUQYVzUWti7GQFaAZz-XGHrL3jncaL7jfM4geDxJA-FysetfT1Byf8NOI4c23rfZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsgWhLR24v7497eqAkMcc_Uxuo7xaZtqKE4LXgOBAL4WA&oe=69A96BAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "floorparx", "keywords": ["architecture", "home", "estate", "floorplan", "housing"], "long_description": "You can walk freely across the plan, place furniture, and even display walls with cutouts for doors and windows. Upload your own plan to floorparx.com and explore your building project before construction even begins. This gives you a true sense of space and proportion, helps you plan more effectively, and allows you to spot and avoid costly design mistakes early on.", "short_description": "Floorparx offers a completely new way to present and experience floor plans. Imagine laying out any floor plan right in front of you on the ground\u2014scaled to life-size, with every dimension matching reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/plan2d/info/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/plan2d/info/terms-of-use", "publisher_name":
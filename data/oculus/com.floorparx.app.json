Zg&oe=6ABA59A8"}, {"file_name": "floorparx-screenshot-02.png", "id": "2224974735119956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824700_2224974738453289_2138144348482482163_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J79O0hn_-lQQ7kNvwH590Il&_nc_oc=AdpxiCIZieqo1_a6uS3K084_t4mcJayFJCZ2J-e2MWJwKM1OhUiKbJO8zMArCemYQI4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfa7o11unZArYjxlMUw08fKFNG3pqYuQoRyYmByMC9nQ&oe=6ABA8B1E"}, {"file_name": "floorparx-screenshot-03.png", "id": "1703554134205402", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827601_1703554137538735_1392408500952323664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA1Ks7upbpAQ7kNvwH5o27b&_nc_oc=AdoYxv6JpPMgGKnlq4PCLfP98hEb0oD9QfuMapikREWT_GVJrAh587BwYuR7b4zasmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKD8jOYEuC_9KLs91Yboio2l_yrWvvozH5sAGHwZGAZIw&oe=6ABA62E0"}, {"file_name": "floorparx-screenshot-05.png", "id": "1004925252363835", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1004925255697168_7490180609674205606_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHOTVmYKHSQQ7kNvwFYC9RG&_nc_oc=Adot2z2uLCPdwuKpVe1loVM0G9pyxiqJVqjIMR2G8vnCbaoJ99yb3vOdlDLN8NXthT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWdU2f2JtQ5ULLp9hPvrkc0xy8i6RLWl7u8ohUKbmYNA&oe=6ABA891C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "floorparx_trailer_preview_image.png", "id": "1231887472363116", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673799750_1231887475696449_3906624255222324958_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4PPrzZI7JKQQ7kNvwHOKSz6&_nc_oc=AdqpGE1qiBNv-hu-9xmHXHO6EvvEkg9cCjCXO-bujV2og8ynJwPBG45PKzaJMY8eyKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_HmW9g2_sT6OKdjyAd44FzNZsJMdfEokmyEzxf-xsWQ&oe=6ABA631D"}, "display_name": "floorparx", "keywords": ["architecture", "home", "estate", "floorplan", "housing"], "long_description": "With Floorparx, a 2D floor plan becomes a full-scale virtual walkthrough.\nInstead of interpreting abstract lines on paper, room layouts, dimensions, and walking paths become tangible and realistic.\n\nYour customers can freely move through the floor plan and evaluate and discuss the design together with family, friends, site managers, or architects.\n\nFurniture can be placed, walls can be moved, and doors and windows can be adjusted flexibly.", "short_description": "Walk your plan\nGive your customers an unmatched experience and leverage the power of VR technology to avoid planning mistakes and identify change requests at an early stage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/terms-of-use", "publisher_name": "byteAgenten gmbh", "support_website_url": null, "website_url": "https://floorparx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27766136713070671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823940_2133693117558662_9113446634866323619_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tah7-OcKhnQQ7kNvwGin_jM&_nc_oc=AdpflUi2iW2Er1GgDo_kWs75uDFjcKasa-9LO6ODr
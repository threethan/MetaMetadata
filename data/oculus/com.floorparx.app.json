25/499300547_1232507091929424_8710783044832712905_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj_pGhET1F0Q7kNvwHmJ2lV&_nc_oc=AdoA6wMNVgq6F762vlXMVRyW8BnGLrwSAJ6kEExq0o1ALS1z-J_awP8rOF4ZLkjG8MA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSVr3V8dwVo45hU8GrywEkc9E8clBdbPqo_1cY2SXN5w&oe=6A98436E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "floorparx", "keywords": ["architecture", "home", "estate", "floorplan", "housing"], "long_description": "You can walk freely across the plan, place furniture, and even display walls with cutouts for doors and windows. Upload your own plan to floorparks.com and explore your building project before construction even begins. This gives you a true sense of space and proportion, helps you plan more effectively, and allows you to spot and avoid costly design mistakes early on.", "short_description": "Floorparx offers a completely new way to present and experience floor plans. Imagine laying out any floor plan right in front of you on the ground\u2014scaled to life-size, with every dimension matching reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floorparx.com/plan2d/info/privacy-policy", "developer_terms_of_service_url": "https://floorparx.com/plan2d/info/terms-of-use", "publisher_name": "byteAgenten gmbh", "support_website_url": null, "website_url": "https://floorparx.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "es", "it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TR
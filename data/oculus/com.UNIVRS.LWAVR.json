c8\u30ca\u30fc\u3068\u5354\u529b\u3057\u3066\u30b4\u30fc\u30b9\u30c8\u3092\u6d44\u5316\u3059\u308b\u300c\u30b4\u30fc\u30b9\u30c8\u30cf\u30f3\u30c8\u300d\u3082\u3042\u308a\u3001\u30ec\u30fc\u30b9\u3068\u30cf\u30f3\u30c8\u3067\u7a3c\u3044\u3060\u30dd\u30a4\u30f3\u30c8\u3084\u30c1\u30b1\u30c3\u30c8\u3092\u4f7f\u3063\u3066\u30a2\u30a4\u30c6\u30e0\u3092\u96c6\u3081\u81ea\u5206\u306e\u30db\u30a6\u30ad\u3092\u30ab\u30b9\u30bf\u30de\u30a4\u30ba\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\n\n\u30df\u30c3\u30b7\u30e7\u30f3\u306e\u524d\u5f8c\u306b\u306f\u30aa\u30ea\u30b8\u30ca\u30eb\u306e\u30b9\u30c8\u30fc\u30ea\u30fc\u30d1\u30fc\u30c8\u3082\u5c55\u958b\u3002\u4f53\u9a13\u5165\u5b66\u306e\u6700\u7d42\u65e5\u306b\u958b\u50ac\u3055\u308c\u308b\u300e\u30b9\u30c6\u30e9\u676f\u300f\u3092\u76ee\u6307\u3057\u3066\u30df\u30c3\u30b7\u30e7\u30f3\u3092\u30af\u30ea\u30a2\u3057\u3088\u3046\uff01\n\n\u203b\u30aa\u30f3\u30e9\u30a4\u30f3\u3067\u4ed6\u30d7\u30ec\u30a4\u30e4\u30fc\u3068\u4e00\u7dd2\u306b\u81ea\u7531\u306b\u30b9\u30c6\u30fc\u30b8\u306e\u4e2d\u3092\u98db\u3076\u3053\u3068\u304c\u3067\u304d\u308b\u300c\u30d5\u30ea\u30fc\u30d5\u30e9\u30a4\u30c8\u30e2\u30fc\u30c9\u300d\u304c11\u6708\u306e\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u8ffd\u52a0\u4e88\u5b9a\u3067\u3059\u3002\n\n\uff1c\u3042\u3089\u3059\u3058\uff1e\n\u9b54\u6cd5\u796d\u304c\u7d42\u308f\u308a11\u6708\u306b\u5165\u3063\u305f\u3042\u308b\u65e5\u3001\u30eb\u30fc\u30ca\u30ce\u30f4\u30a1\u9b54\u6cd5\u5b66\u6821\u3067\u306f\u3068\u3042\u308b\u7570\u5909\u304c!? \u306a\u3093\u3068\u672c\u6765\u306f\u8cb4\u91cd\u306a\u306f\u305a\u306e\u9b54\u529b\u304c\u6ea2\u308c\u304b\u3048\u3063\u3066\u3044\u305f\uff01 \u6ea2\u308c\u305f\u9b54\u529b\u3092\u6d88\u8cbb\u3059\u308b\u305f\u3081\u3001\u6025\u907d\u96c6\u3081\u3089\u308c\u305f\u4f53\u9a13\u5165\u5b66\u751f\u305f\u3061\u3002\u6700\u7d42\u65e5\u306b\u958b\u50ac\u3055\u308c\u308b\u4e8c\u4eba\u7d44\u306e\u30db\u30a6\u30ad\u30ec\u30fc\u30b9\u300e\u30b9\u30c6\u30e9\u676f\u300f\u306b\u5411\u3051\u3066\u3001\u30a2\u30c3\u30b3\u305f\u3061\u30eb\u30fc\u30ca\u30ce\u30f4\u30a1\u306e\u9b54\u5973\u3068\u306e\u9b54\u6cd5\u8a13\u7df4\u304c\u59cb\u307e\u308b\uff01 \n\n\"\u98db\u307c\u3046\u3001\u4e00\u7dd2\u306b\uff01\u201d\n\n\n\uff1c\u30ad\u30e3\u30b9\u30c8\uff1e\n\u30a2\u30c3\u30b3\uff1a\u6f58 \u3081\u3050\u307f\n\u30ed\u30c3\u30c6\uff1a\u6298\u7b20 \u5bcc\u7f8e\u5b50\n\u30b9\u30fc\u30b7\u30a3 \uff1a\u6751\u702c \u8fea\u4e0e\n\u30c0\u30a4\u30a2\u30ca\uff1a\u65e5\u7b20 \u967d\u5b50\n\u30a2\u30de\u30f3\u30c0\uff1a\u5fd7\u7530 \u6709\u5f69\n\u30b3\u30f3\u30b9\u30bf\u30f3\u30c4\u30a7\uff1a\u6751\u5ddd \u68a8\u8863\n\u30e4\u30b9\u30df\u30f3\u30ab \uff1a\u4e0a\u7530 \u9e97\u5948\n\u30cd\u30d3\u30a3\uff1a\u82b9\u6fa4 \u512a\n\n\u4e3b\u984c\u6b4c \u300cDream Flight\u300d\n\u4f5c\u8a5e/\u4f5c\u66f2\uff1a\u5927\u539f\u3086\u3044\u5b50\n\u7de8\u66f2\uff1a      \u5409\u7530\u7a63\n\u6b4c\uff1a       YURiKA\n\n\u539f\u4f5c\uff1aTRIGGER /\u3000\u5409\u6210\u66dc\n\u76e3\u4fee\uff1a\u300c\u30ea\u30c8\u30eb\u30a6\u30a3\u30c3\u30c1\u30a2\u30ab\u30c7\u30df\u30a2\u300d\u88fd\u4f5c\u59d4\u54e1\u4f1a\n\u76e3\u7763\uff1a\u5c71\u5143\u96bc\u4e00\n\u5236\u4f5c\uff1a\u682a\u5f0f\u4f1a\u793eUNIVRS\n\n\u00a9 2017 TRIGGER\uff0f\u5409\u6210\u66dc\uff0f\u300c\u30ea\u30c8\u30eb\u30a6\u30a3\u30c3\u30c1\u30a2\u30ab\u30c7\u30df\u30a2\u300d\u88fd\u4f5c\u59d4\u54e1\u4f1a  \u00a9 UNIVRS, Inc. ", "short_description": "\u9b54\u6cd5\u306e\u30db\u30a6\u30ad\u3067\u5927\u7a7a\u3078\uff01\u9b54\u6cd5\u5b66\u6821\u3067\u4e8c\u4eba\u7d44\u306e\u30db\u30a6\u30ad\u30ec\u30fc\u30b9\u306b\u6311\u6226\u3057\u3088\u3046\uff01\n\n\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u30eb\u30fc\u30ca\u30ce\u30f4\u30a1\u9b54\u6cd5\u5b66\u6821\u306e\u4f53\u9a13\u5165\u5b66\u751f\u3068\u306a\u308a\u3001\u30a2\u30c3\u30b3\u305f\u3061\u300c\u30ea\u30c8\u30eb\u30a6\u30a3\u30c3\u30c1\u30a2\u30ab\u30c7\u30df\u30a2\u300d\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u30bf\u30c3\u30b0\u3092\u7d44\u3093\u3067\u69d8\u3
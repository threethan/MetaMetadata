7245_769445383870217_6613395509624315954_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0xoV6WKAMMQ7kNvwER4rMj&_nc_oc=Adr8i2l_pzBAMkPtzlCny6vvjIWsC41sDFCzKLo_6SNHy2UBkQGWv5EEQkVyjQkoef4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3wPso3K43-2XERCVnBDDAZX0chEQVyZzywLjT7fXtRQ&oe=6A8D8F89"}, "display_name": "Little Witch Academia: VR Broom Racing", "keywords": ["racing", "magic", "flying", "witch", "anime"], "long_description": "Take to the skies on a magical broom in the VR racing game based on the Little Witch Academia anime!\n\nJoin the ranks of students at prestigious Luna Nova Witchcraft Academy to race through the skies and purify ghosts on a custom broom in more than a dozen missions, and experience original story sequences featuring voice actors from the hit anime series!\n\nCollect items, points, and tickets, and customize your broomstick to your heart\u2019s content. Can you take first place in the ultimate challenge of the Stella Cup?\n\n\u201cTogether, we can fly!\"\n\n*\"Free Flight Mode\" in which you can join together with friends in online multiplayer and take in the sights of the world of Little Witch Academia will be added with the November Update.\n\n\u00a9 2017 TRIGGER / Yoh Yoshinari / \"Little Witch Academia\" Committee \u00a9 UNIVRS, Inc.", "short_description": "Take to the skies on a magical broom in the VR racing game based on the Little Witch Academia anime! Enjoy an original Little Witch Academia story with Akko and her friends. "}]}, "developer_name": "UNIVRS, Inc.", "developer_privacy_policy_url": "https://lwa-vr.com/privacy-policy/", "developer_terms_of_service_url": "https://lwa-vr.com/terms-of-use/", "publisher_name": "UNIVRS, Inc.", "support_website_url": "https://lwa-vr.com/", "website_url": "https://lwa-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "67338518328
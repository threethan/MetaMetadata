b=1-7&_nc_sid=6e7a0a&_nc_ohc=viFTgMsnTqsQ7kNvwE80Xpw&_nc_oc=AdoJTsi7ENwIhXsUq3NysACJKsVVwA05331YTI97qV67xrt8v6egRHHvu-GGpiWIV74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMAPMiLGdCL2IkSAR8Csf21J6wqrXRpbW8YCCJ2Z3yhw&oe=6A7F0F09"}, "display_name": "Little Witch Academia: VR Broom Racing", "keywords": ["racing", "magic", "flying", "witch", "anime"], "long_description": "Take to the skies on a magical broom in the VR racing game based on the Little Witch Academia anime!\n\nJoin the ranks of students at prestigious Luna Nova Witchcraft Academy to race through the skies and purify ghosts on a custom broom in more than a dozen missions, and experience original story sequences featuring voice actors from the hit anime series!\n\nCollect items, points, and tickets, and customize your broomstick to your heart\u2019s content. Can you take first place in the ultimate challenge of the Stella Cup?\n\n\u201cTogether, we can fly!\"\n\n*\"Free Flight Mode\" in which you can join together with friends in online multiplayer and take in the sights of the world of Little Witch Academia will be added with the November Update.\n\n\u00a9 2017 TRIGGER / Yoh Yoshinari / \"Little Witch Academia\" Committee \u00a9 UNIVRS, Inc.", "short_description": "Take to the skies on a magical broom in the VR racing game based on the Little Witch Academia anime! Enjoy an original Little Witch Academia story with Akko and her friends. "}]}, "developer_name": "UNIVRS, Inc.", "developer_privacy_policy_url": "https://lwa-vr.com/privacy-policy/", "developer_terms_of_service_url": "https://lwa-vr.com/terms-of-use/", "publisher_name": "UNIVRS, Inc.", "support_website_url": "https://lwa-vr.com/", "website_url": "https://lwa-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2691890164460465"}], "external_subscription_ty
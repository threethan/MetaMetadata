71-25/75272215_1072765251050922_4758062684767070629_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP6mqoLhWwsQ7kNvwEYHh9Z&_nc_oc=AdmBHVjDMCPKB_aVAv3xqgiqrYesd4HmsZXHFHC452rgP-7C28nliuJAO5ujRl68UFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9-NjjyLoZ_sSXdU5IEVKyBb6zMu1DCeTGxOwl3bLzYg&oe=69AC374E"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klUd5FIyLAMQ7kNvwGKTyKp&_nc_oc=AdmwwoX-XPiAb5YzJo8jutwSrmUzzU3sAaxaa4ThCZ4jg0lEG0hW11lh0HOALUaxWrU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxi1hX6z5C42p7jeyRyW6AEbnQUKNhvOOGlVBPqBT-fSw&oe=69AC2A7F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z2F7Qk9LIcQ7kNvwE0badz&_nc_oc=AdnWaZBsJ0a9_8bopLNKEtk2rGRaDmW-Ydb1AbedjOC0s91mY5MYo1QRTcTNU2tnxAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEesNY_a9XKmoUAxk_JqpR01cJ6rqv7ovkJz0-SAnohw&oe=69AC1452"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTqml1b9bzgQ7kNvwGcfPTK&_nc_oc=Adl7Bt1BUb3NBjroP_WXVUjI_7VUmOzAoQqjP4rSTeyJ4qPvAk4LsirXHeg_Mt3eq04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvMHZX67hr6FJanWeyJIKOf9WxkHRW3NMgDcN_fjWXHA&oe=69AC3855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEwdM1CD2sAQ7kNvwHKo37w&_nc_oc=AdmqxDF3sHzCjW4L-WnctAawZuDGK3h5PpOu3hUDgBqEFBCFedMNZgOQco3qFgg6R-c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6hi-6cJZO6Fw0ug4RoF4u5haEaBlsXlYjrMbKV8YzSQ&oe=69AC2CB9"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_su
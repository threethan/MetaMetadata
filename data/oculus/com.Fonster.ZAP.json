om/v/t64.5771-25/75272215_1072765251050922_4758062684767070629_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP6mqoLhWwsQ7kNvwESpjNE&_nc_oc=AdkVOrPCxorplZq9NWfIdKnSPTwD20UfmsH41ogRKqA_70HrVYSVDQ02PE-sHxw7vB4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOWRaO85ikDvYCy3_aFS69EGJcgElZ8E-2b93F-Q3AIw&oe=69AAE5CE"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klUd5FIyLAMQ7kNvwHVN76k&_nc_oc=AdncSljPcsUnpyIg2iE2JM_nZ6L-oqrgJWSH0M-I9CiC0yDHoheAnEL00LFq6_MoTaw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afzi9fAvQzGKuNBCUSAWp4ePtt0jUTaWeZs5E2Qjdls6NA&oe=69AAD8FF"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Z2F7Qk9LIcQ7kNvwHQlOcf&_nc_oc=AdmqkQd3O_WctB0iFQcjNrjTOBvZfdplhcgGfSHQl3uzrTeDivVHEV4OcdrKoKcKs8c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2dMIBcTQBAKlTGBGKsKAm7z7cKTHt3c3EVXO-ykdHWw&oe=69AAC2D2"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaLYqXNDb30Q7kNvwHD1lkx&_nc_oc=AdnfJjsMdqK3NXDpIO93GTvLBWUTHuR-aQH6mU3CGpIPSkLD_nCs5WNJCgRXTPSGgg0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_GGb8MZVSCajXsEOg7ia1WiBs4LpYN5yWJuOYllO2Zg&oe=69AAAE95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEwdM1CD2sAQ7kNvwEwKWFp&_nc_oc=Adn-vixKWGva6PQ_rkwNP4HAkn3j1_2VQXEnW3jPc6rAEZ4vM1DMAsrZlZeA9CHwDJc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzI36sjoBQiY77FIoeJ4cDc2YDLrY_sgsgKofjaB0lLUg&oe=69AADB39"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"
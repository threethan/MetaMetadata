71-25/75272215_1072765251050922_4758062684767070629_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TAikzJzJy4Q7kNvwEnHkGB&_nc_oc=Adnki2OWL_OpcdrtddxpzvBYjO4VjYJTYszx0IialCyySxeQYmKzgiFc_jEaEOOfppI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyG1XNXaUDd7sYsiR4r_wK9uDbklDbVoLOwq6pRMT-n4g&oe=69AEDA4E"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iorRiUVDWJsQ7kNvwGgOy86&_nc_oc=AdmzgtWNQxsIu6LYvOnp_AfXNsUAy2Ha566WynckxxhKAhKbh7DkttRQEPZrwH-cWn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGyAjsvt1n2rK5aqPu9Oy99ibe8cm-D4PO31Uo8R28UQ&oe=69AECD7F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftVFHxRTPCYQ7kNvwETCFVZ&_nc_oc=Adn3VCQS3lETuoFhzIFfwP4oKj2N3pqk59xkAUwVqRLPaPaKJQWTzjzDc8-F_IKSJD4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz-UGBRF9_8hSkZkGgoEXLhJvU2U_iVUQYpJ5Y2yMetg&oe=69AEB752"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTqml1b9bzgQ7kNvwEjeRYw&_nc_oc=Adlhzpud2OCL7oDoa0Ix-x4Ll10WBwjdTXgpNJoV_ieA-kFTXBbGt2vGlz8eVbhd_EQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtjLEkwc3WKV-10TmRLDLXNP74qnqP0cu8rCkxQ4DJcw&oe=69AEDB55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnnrMZm21BgQ7kNvwHkl6N2&_nc_oc=AdnXkQVgSB5CHd7n19vpUQPP8bkYTnhUxYmYGjr3hsgKyf3CwLVjhmf5vejkLe27DIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFtYD1TKEE8azW5RKYNoHThGzNRQMvsGdSDsPiuY7EfQ&oe=69AECFB9"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_su
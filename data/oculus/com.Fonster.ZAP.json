54426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nth04EeqrSMQ7kNvwFxoerp&_nc_oc=AdoCQMRUJtZXsSuyQ0qz2ZrW9Z7XaXEQtd2Lko6sZr_DY1_czflSOqENre0u1evoE2A&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvo88XmAyYsoq1l9WBMOyDutIa1dOK20nJCPS_8BP2Vw&oe=6AA94A7F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6g0W3GkLcOAQ7kNvwEkNJaN&_nc_oc=AdqY2JiliKbED9qVd5Ab4kYN8GC1u_5kJdktDCyiUR27L7VaUqyLU3T71JBHzjvGass&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrCTGEtfB9xZrUkDmMUApCdIXALtgA3iXt6DwKqT1m5A&oe=6AA93452"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fiizpm8HzWgQ7kNvwEAn-W0&_nc_oc=Adr9nAubgCEdDjEY3Yth7UCZCw3XkkLtb-J-IIOnJtq6hdp-r-pE1O_kjYNZ5sv6IMI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ59qKQQs6VUuILLUuOQRcqXqZi7U7o03H2jd279LE4Bw&oe=6AA95855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVv4h5YNNOkQ7kNvwHFa62E&_nc_oc=AdpF4XEDOo8LkZrU9U4eHl_V1-jQr8rsWzDJE21bFx7PnIPTXGS0xgDhVy1aDraDbYQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8XdSi-wy7VU9bi3LUWyQAepUPLq2HjpwiQWGbuynevA&oe=6AA94CB9"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": 
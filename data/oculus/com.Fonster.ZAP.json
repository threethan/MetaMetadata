.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEmpokUmlXSFNU4O6Qsavgwbsuoho-XRllGL7w0jWvRg&oe=6AFF08CE"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViXkxct-KPwQ7kNvwF6FVcS&_nc_oc=AdrMsfQLxoTg3O2xj7Eagd5dTny-KpTfvO_WI5xH4fr70ShaRCZyJa7GO8NpVG5Ky14&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkRaZKNJS5ku-YS1Od5UOaABYlySofs3J2AEUpWDKB3A&oe=6AFF343F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0YVGvyZ9WkQ7kNvwF-66ka&_nc_oc=AdrCSCQvBFmV2umsMTY8t1TB_g3mhTRXZ-mjYxDv-brfaNPu1003xDufqyylX2zCTkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsBaY336sc1HURvcVru4tyWmkV1KovpBv_LI2z0XZGxQ&oe=6AFF1E12"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX6ZwP6ELJQQ7kNvwGGClMF&_nc_oc=AdqtZLczmovaldfzIPvAeWq_bgbiyduJWXRjlNIYXccAGD7KNnJK0B_Ht2Kd-JUFmU0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPnVDntR9rnMInO10Ml1TgLObu6u9_oinxeTvtREqRiA&oe=6AFF09D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOYqtF6769MQ7kNvwGx6tjZ&_nc_oc=Adpqxy7qprTIIenrrTC-JBKnMoRlK9vs2MCt4HFmowYwDku5T8H1NuhO5ez8bsInGzQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm-U-QvN9IMMvG4bRU8S0L14lWzjL_PrPJ5fC3P8ts2g&oe=6AFF3679"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
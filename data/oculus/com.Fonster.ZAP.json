_sid=6e7a0a&_nc_ohc=mvvSopfc1O8Q7kNvwFpMryL&_nc_oc=Adn2NrgeWxga17m481Cu_p1BYXm4x9I1nUuMEMJmloagouT-Z13ZBUNjOhdLpozG-vE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftRgC_9O0xOgETtoKZLCPe8I0AHLufTUay3n2zy1nz1sw&oe=69A1AB4E"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bd-IXt-FVZ8Q7kNvwF_ANM9&_nc_oc=AdnD1uYKN37XRxOP23Ys4rNneGJc6yrFSFob7TWVbl1bQk3hYBQfD3y1oy1ofQY4utI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvjL1cdA3pyc1LRnVWFl6aqbf0GyQrF4yhKr758wHpu9A&oe=69A19E7F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5pogmL1XqcQ7kNvwFJOZvi&_nc_oc=AdmxofwtlhWOIcxtM79QrQR2btbs--q0QDRxiV2MW2ZOcH7FphmZJkDRkqt1sjNLXhA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftnk8MxH7nAtmZNFzDx_dgG31wCfLyav_YhTbg8iVrOxA&oe=69A18852"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjPPFRBKWwoQ7kNvwEx5tA3&_nc_oc=Adk9LLH1kQ01iiX8JCorIpydYZjG3BNocdW4WrVs-WZ7hTwjVNRykEvys1c2PLsXBbE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftMJbfiFCiRAinhmUL_avHKbVQmRrxdjo_AW3PMQAdniw&oe=69A1AC55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lMzCEFcMXwQ7kNvwHmw4VW&_nc_oc=Adn1XudXdD_1mawdo1exCqchWxfv4BPOMQwN22piKGj5stoXbOoXNXbZkXPchhoO6Bc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvpEaJpoEnedYokYh0KB6IK7hW9S-HfL9tTD-XYx1ie5A&oe=69A1A0B9"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "M
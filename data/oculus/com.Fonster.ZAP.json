_sid=6e7a0a&_nc_ohc=p9Z81LIDo4EQ7kNvwE6Hw-s&_nc_oc=AdngVX3FDZBE1IoS1t2I_87Z5jAk4Ir5HMYZRYQbQyic3dmYpWRZKXiKkjxipaZLMW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft-s62_Kp-0_2PJlyT_Me-hALA2OwSNBuNPgnsAecX3Ig&oe=699C654E"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72DAHRBAW1EQ7kNvwFmLVJi&_nc_oc=Adkv9L3RiED2hPV4H0JwLKL6FLGDS751a7iK0JOV4lOGwkWDN6yOOYGJSwpbDkuK9dg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvUs834FncychiDqTsu0BZcC8IopFwQTqSrOHQ04Ait-A&oe=699C587F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE5Xt-9nN0oQ7kNvwGVKVuL&_nc_oc=Adm4mpNaM9bEJgzWj_1ODMDPWoclhE6QBnV0D33kdlM90VaAwi4oPEHw66G4P7sFNmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuFv6P7PW3fuZpdNZ5nV7M4OBLvatC9JWYBjlsInRU-FQ&oe=699C4252"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tY_T1ShbocQ7kNvwHyQRZh&_nc_oc=AdkUsSzuHNr3hqymxbuOqyoPpkEZDsTLQt390K2NyWvBzHnhX3fq93F6NSK9kXoijXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvNAB1lJck7BX_Mj4-7drX5BK3OT2NTIriTlUbMWP71DQ&oe=699C6655"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv9_f08OwXcQ7kNvwFtGvMf&_nc_oc=AdmQH8uMTNQL9PFQw_5LQJ5F3K-4ZyfmDTTM5E-uuTjYFp9v74v3cCFIiae8Vv24cps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftYvHeKD0iWgefvP4UAWFOGElBkFx-x5oYxK8eagIN6Sg&oe=699C5AB9"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "M
_sid=6e7a0a&_nc_ohc=p9Z81LIDo4EQ7kNvwEdrBjb&_nc_oc=AdkO5H5v7qT7OqkUiLZgpk2IDRMwwD9jlOyIKsXh4ChckJvdB21oB1sGLxrFYplvCtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsx7hTg1ZjzEpgOAebmG_i4_F-Ij-VNfcYc_W4IgFZCNA&oe=699B13CE"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72DAHRBAW1EQ7kNvwELAJrS&_nc_oc=AdlZeNslZfyLwqHuMDrbD-tKxqFFfQRK3wST85OTLktG_P7yDpBPaqoSH8Oe1Ti46Qk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsF03RhYZHFu1yZZHXlORS3FwMlDwz_GODLiwbt-6FeVg&oe=699B06FF"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iE5Xt-9nN0oQ7kNvwGLcCmd&_nc_oc=Adls1P9Wqo7-6gs_hgDCmNHym63uQ_5mjiM-SVun5NtGIVFU8DwYxTaFOgAqifu6n9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu_fcG7tqp7aW4GWblFNDp2lj8gR370Zjo5qdE7_OLB2A&oe=699AF0D2"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKcIsR7xLVsQ7kNvwHZLTnm&_nc_oc=AdmGCKycAaX55SIP43JYWsuwaAfPl4JwamTV7HwmCiOHTCm7ZEKISrchib4VJy_11_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvrrvUMxQfF2Y7syYd6YBAvTwoL-W8hjnje-fYTRdCf1Q&oe=699B14D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uv9_f08OwXcQ7kNvwH4nB1H&_nc_oc=AdnoAL86Vs8VGLGqyQQ-11Yzqv6JIh6FA7D9PBmIWdLhPgwikUs_DVp2i2eNZnfWY74&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKIou0gYUCNe7dxa5fO_lV1x2f9O3szoyzLcAq_NUrow&oe=699B0939"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "M
_sid=6e7a0a&_nc_ohc=c6sY83Ir9DMQ7kNvwH4QFWf&_nc_oc=Adl9IVtjbn6omJSSNe4mBKVS_KnCNjEkjkwzs5Lcz-mqu8bOnN2Z5nUT7GcSiLOucPA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvz3-jrXFciT0OEx0rrPgBuRj_EjDGbBV8n9r419yJ0VQ&oe=699870CE"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3D6S0uIOFoQ7kNvwF0Wm5B&_nc_oc=AdnGHmb6QuphBPwZf1W9EcjDJZzTboYBJ2HXWsz2JZki1p2Tv10RoTa_mQWlsJobGcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvtufcguyXiu3N4BgOs5ZZASqLFJtX1xbTr22iw7W2Jyw&oe=699863FF"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TenKd-whTGAQ7kNvwEeqsiW&_nc_oc=Adk-lvf5a73U03CUmlT0S-qU1x4KG1mZjjecH9TM2fpCybGSbdTHj-B0NZlJXlmwyD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu_NBJtDZNqWzIpB5yrYhhxX8z2tcsKnuIF5lIvQcmX3A&oe=69984DD2"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKcIsR7xLVsQ7kNvwExlDAe&_nc_oc=Adm0mECNrwHGRD2GleZtHugWHJ-YODUDTINIrxd75TMSoBAgXm-rKPEyLo6R--fvLX0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftf9vFT7GxeUih6jpnTgKB5HyJri5XPGNdVD2kSyiiZWw&oe=699871D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3VpwkqZP7QQ7kNvwHR_2g7&_nc_oc=AdmPUweqiCL1mDT1BQg56EY80U2WQeiFF4KQbqOUsRCyHa9kZZe4hpf-ejcFSW2OC1c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs4GTMIBtVvPrbCNuOKeMuODw5ycsHZF052cOZl3UKVpQ&oe=69986639"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "M
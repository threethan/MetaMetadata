_sid=6e7a0a&_nc_ohc=mvvSopfc1O8Q7kNvwFh6rMb&_nc_oc=AdkjA23M_OSkdQxXhdJRxE_67aW7hKQoXYlLayE0hdZM3ZVdj9APnlIibBk9aXbVPvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswM5JfE2hNEVlzdY4C9S6QQYwiTxbE6RUCOljMm1jKOQ&oe=69A059CE"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bd-IXt-FVZ8Q7kNvwEKFGxD&_nc_oc=AdmM0vCkFWUkOivfIFa3LqR2Vn14IBpCb4ley4C4qfC-Lx8XFck_qHohptv5cLQ0jK8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEDBqVveXb-gvAdaWbtJ13yXuTqP1bdf3akL1UQb5-mQ&oe=69A04CFF"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5pogmL1XqcQ7kNvwEv4Dk6&_nc_oc=AdlM2JWJQbBJMd1WZ9pLUREmkqeamFvvE8KZaElIs0Usw1cDMvCDkExXMPO-RBwx0GA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuxR2rdtz6flPz9wDmQhnEpWww9MdVd6xUN1AZS60Ky3Q&oe=69A036D2"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjPPFRBKWwoQ7kNvwGypGH7&_nc_oc=AdnibMtXE_w70yPDQ7I6zMsPU3UApSPCNUrYZEAwvOj5zN_WOFC38u24pOfwyxIYzx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvS5XuDPtGepZVBfPU4qMp-quNrdOIuRZtjOFQ_l4otqA&oe=69A05AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zS31hWVSWjMQ7kNvwE75l7K&_nc_oc=AdlPidMoq9CtO4kPtdPxrL6PGvgqsptmekyAYcqGoi_fJFiJXJpf_Rdqx_jS2e83-i0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftw-Sd2mm1gY0XQC6uXLinWtyMGNRLGH5sAKBr_mM0nqA&oe=69A04F39"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "M
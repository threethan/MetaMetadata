09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lAbm4JYIMoQ7kNvwGA4kyG&_nc_oc=Adqpa1lqY11K5jJaRd0VYY6lJ5eXpYasHzPRte8YJqlYrCVNWupm_THGtIYkCELZyuU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af31Q_4Rjyj0gOquk552NEMwfP3ZJBPRUwW4dVTW0o8CEA&oe=69F209FF"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucju0yyQs1gQ7kNvwEQ2-_A&_nc_oc=AdpKrUS-9K1bhHgNdlTMjdaQtUGf-ZwvWt2abdkuUW1NOkXdA08c8nlruoCjxoxVlb0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1MR0shYjEyR9pmPxkGoMt_qmt2reJTmNty8FqUnTGg4A&oe=69F1F3D2"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lp7FXWdzevoQ7kNvwFyFzzW&_nc_oc=AdqqGO64iBmuZfCwdW_rtR5zyxBA2NyLS4tNHavhGE6UCSaYwaqJMaOnKDc_bprSmiU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1f88awYZX953ZEvx-9hIM_R0t59iNIJIjHhHVoDBEijA&oe=69F217D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXIk30FF1GUQ7kNvwG4sBYI&_nc_oc=Adr5vmZzx_vG7NiLjTtMo_C3T97xW-34k4sUfemIAcbN82XBO7L-xeRbepk0OU7Npl0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0DxhoTIPmyAgxvfLfYsrcEOwnBx_q0UXESDoW8DwPRJw&oe=69F20C39"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "26486017407659771"}, "review_
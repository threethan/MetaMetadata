.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCv138fTK5XZZj9fp0ILRMJHVfMenA6mH1wQztZqZEcw&oe=6B09CD0E"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PVvXDlKVXkQ7kNvwHyZLHX&_nc_oc=AdqjR4fq7mZA6O2kcC1W4faPExKz-HJ99RvHT9ir9iePWIfYKyBwZ7aAX8PZwIP2c0E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuupyur5cLRkA4KVB9oPxK0zsCBfdq0XAU-Xm8U-RU1w&oe=6B09C03F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-RP6FhkL9AQ7kNvwGpBZyB&_nc_oc=AdqY6-73waJbuN6TXsXmo51OkhUKxeJOju5ueMlkajCPiuNerkae8nMZ4VW0JLUjnLM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLYGawmgarLQb-owxk3rAjorpTD9qW3FidJHbcpkO7mQ&oe=6B09AA12"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE8Cpocow9QQ7kNvwEWsUxA&_nc_oc=Adp9DFjkD_4oMHIYo0FL3J-efI42N6M9YWhhF42ctdD3LytVADw4La5U_IzFcM3WoHY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTatw-YB9Rn9xBmNyT2ct8R-rHA7CGCgqC7QRdTucuB1g&oe=6B09CE15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSMKf1JLMAYQ7kNvwGjBOtk&_nc_oc=Ado0Zv-yUcmzCyUOO4ZiQos8fy4W8fgHDtaeB5q5OCQpdVm2swzXMStlsT4uXSQZ5aM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-O1d1UGyfQ2v0vZqG8tz8wMmNWN3o9g2W-0JOpijUqw&oe=6B09C279"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScjbSq4wCAJsBuCKT86KWhmN6MgtrJbJZ2LFtW0dpL_g&oe=6B0B1E8E"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOPV0aGJb8kQ7kNvwG0NHRM&_nc_oc=AdpV-taruuqyFhoMf--2B5JgpQAGSPBv2QER-D2GQYJ1lnxDpTXeWVnnhJyMXp3Q0Qo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYLuoN75uM596ou-3eNdLJKuKWwZMFeGU90giuLsP18w&oe=6B0B11BF"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-RP6FhkL9AQ7kNvwETt-oK&_nc_oc=AdqRTNc_tPr4c2wem-exfFf6MUfJvvWtjOEHzhrff57z9qfAQAQWX2elkmzMgE7rj1Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvCgYF7h3vw9gIKUkcZc0IrQHiZokafwJ8CrBEzpMPLg&oe=6B0B33D2"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE8Cpocow9QQ7kNvwHFvNYD&_nc_oc=Adr2JBKvabO9BQynU0LkeBGV06fcuWv-0FLooe38CNiQhoGm2IIaY0OuocY-wpDMSdc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2Lqte6dW-cOkg4JGYzv1eCRNlQZNE-D-wG5Hu8Q2Ang&oe=6B0B1F95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSMKf1JLMAYQ7kNvwGvsBKk&_nc_oc=AdrelsDX6E19wU9VFHBshhRT7Yx4To0ghHubKhdv0H8sK1fnHNcvYcpJS1tlV5g_0fs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQt-SsIc_D-DkMddLUYRi_v_g5EPdK8lsXZx23oPF5SnQ&oe=6B0B13F9"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
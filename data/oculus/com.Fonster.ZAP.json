_sid=6e7a0a&_nc_ohc=TOIm6vipXVUQ7kNvwHaM6WJ&_nc_oc=Adk5JZWCHXUayMD0ltcpaF4zGy1lgsinIB1S7pl57UyN59LY2VCDJ1pQi0T5k9aKtss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsJ4-ay2AHKk4SMDL9VevKMP7OoLCl38UzgVG6fwWOChg&oe=69A59FCE"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piiLwypZMeQQ7kNvwHjHrXQ&_nc_oc=Adk_uib8De_HIN59pvVMiSC4_O4s7CZPnxtLBMhtV7xQIp1lYIOi43czJn4KXh_wZts&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvcJxJCUUoOgEwRQL60Fz6xZyg-QO6XDanSc9A4xwSQ7g&oe=69A592FF"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqDEpuoLoHoQ7kNvwF4gQdn&_nc_oc=Adm7YI8-zxO_lg2yRxztR6q8XYuiA6mZ3Lm05sLSuT8W6tDp5edfnNxSgLgLfzgLjrs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuHnosGaJpmurMbzcPP9g6o9hldBsDkt2DvXy-DTmRfkQ&oe=69A57CD2"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_tgM_7ew6MQ7kNvwFHe49i&_nc_oc=AdlrRKO3DOJK_ajqncq4j-IKadVCoqZqJNATPBxSfxYdyL69E8k1RB8nSxl-FTQwAoc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuGOIlvr4PC38PACZDu2ylPx6EsARin8H9g_JEOYQ7i6Q&oe=69A5A0D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzSvhLVj3c0Q7kNvwHkWddX&_nc_oc=AdlxIOSq-JCvvKSeG5s4gfwGHk122aP6t1XNMF0gMHdTqS_GWasj80PhnGanE9QxetA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afvc7OMZB0B9ksgLsk6fvYqcFwodsifI9WQ1dnidi0TIyg&oe=69A59539"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "M
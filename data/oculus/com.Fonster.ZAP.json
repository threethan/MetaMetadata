71-25/75272215_1072765251050922_4758062684767070629_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkmhWlMpjd4Q7kNvwGRb63n&_nc_oc=AdkXbw_pZInGD4D2nGdJXOo_fOrkYpe9zBYp7OMsrePzZVoKwM7R3ebN5ZAUmroCHps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhKr_ZtckphcyrQSi-KZsepPzCl6rOPTlXAsbjn0p8qA&oe=69BEAC4E"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=488h_Opj8sgQ7kNvwE5NMtL&_nc_oc=AdkaE380-PnQudR9QycO77t1V_-jErNhPGz2wP-4l-SIY2g0zTDANO36nF_BqU27lAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfySILncgZW8qCpxz-fNF31rH0foAGfdaDLRcEsN-Z1xIg&oe=69BE9F7F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1etsdlJbFyYQ7kNvwEgc1cc&_nc_oc=AdmiBklbcgt7vQq7O5fyno5ht8ShIhB9n2MjKUPEMJc-airELbXTrRkh9cChrNJfKfw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmUjbwCGLXNKt8QWjdWdtQbbNdcNPnOh9wMXJSQxhXEQ&oe=69BE8952"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qhsTiVXPZ8Q7kNvwGk0pXQ&_nc_oc=AdmHYMlIK6gqXMDrD8IzgL4AkCJJG2DVb9zrrSGsGkGjDO2uE1ASnivLp3zfkcF4T2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyCwTl0ZRDGFLs6i1DJssDKac_QecYWAIDsB_XVpJfKPg&oe=69BEAD55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDN-SSCB2GUQ7kNvwFmpmsr&_nc_oc=AdkmP6VZ8k7rZ5Idjl6S95ccUb9fnrZUgoX0B19m61KkqtaIS5_ueuaFIiJvwtxnNjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzkj-Lm3igkoY1Qdzar7KqPVr02nwAOelPQ_uRcTu5wKw&oe=69BEA1B9"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_su
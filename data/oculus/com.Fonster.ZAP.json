.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxvg-U8qISVUp46hrW5hjM055JeAc6zIE5SJ9MFShF9Q&oe=6B06F1CE"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PVvXDlKVXkQ7kNvwH6EO27&_nc_oc=AdqJGdr9OhkAPyHLsVLQDXLpAD0dDftzmgVr4E8tG66Mqm32TxUUzx1-Me1tKT_RoGk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLupXLiZxIQS7MpaVLyNBgxdtN98FVb1DUjwXAcL8zwg&oe=6B071D3F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvzlJ3Lg4i0Q7kNvwGKwKCP&_nc_oc=AdoQUSD2sX-I1nVygKQ0LXNrB3Fo_1Ei34w4l7hmoKi1zUhuat6z0SyxT1TohWX4X48&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQARwS8JJr46bw8EZ9nTG-rxLcnp6aEndZKqlHJ5oofg&oe=6B070712"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nyp6j16prgwQ7kNvwHoyPPH&_nc_oc=AdrFL6CzKWWhNsS2MIbdNuBkAiEwTOXLsdO2CzQEmqEKbkfJQBdC67Ka30lWtpX9CN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFgpWXh50ZnpxcW0CR2rC6p21RTUA7uLXaNmv1N05alw&oe=6B06F2D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtIwXmZcTqQQ7kNvwERUSCI&_nc_oc=AdodeyYIsb65UeagUdmr7mY_DyWsQerS4N1rneCHMTystQe5rLZTgsSIBJv6gdsCPx8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_ythN47likXJzFeh6PIElNBiC_JVwVdFtcEPaAmgxfA&oe=6B071F79"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
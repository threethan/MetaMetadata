00_Af0pxmG-fHic0mtqtUjktRzeAtXFrNJ86cqobpYCKPzQMQ&oe=69D271CA"}, {"file_name": "Shearpleasure.png", "id": "233081856187432", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_233081859520765_6131975739920930185_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7p3v040fA4Q7kNvwGpyCYu&_nc_oc=AdpHZmMXW19lg370GGUMlcy7xbc_zkayLs9kSq2XZScJ4BXuxKSgLOlwb9Th46UXaVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rh7x3ngJrNX9cmVi-doz7Z6kPO8egSjSsUA6PPEIILA&oe=69D24D9E"}, {"file_name": "PicklePackingCompany.png", "id": "1242741823047564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75520119_1242741826380897_8231855154482961425_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywaa37rDpFYQ7kNvwFsDSiq&_nc_oc=Adpz5rQ7BSYpYQ2Pfv5DnyRCeWowq5xmhtT5UQcZUl9wddOLe9amrr3LTOKRn65joSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RX6m4iD3l6DsOsfE9k-RmN5DZsCUSjvPrdyvKkWkffQ&oe=69D25826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zap_video_cover.png", "id": "682117720421726", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984448_682117723755059_1132448842383316809_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxQCH0RPi7oQ7kNvwGPP_t1&_nc_oc=Ado8nUC38xB8fpuMl9j8wPqdx02nBtBn_GOvIaA4TH-gbfv3gaQt2m6k4fmVhjmyrVo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2O6olPtwcqIhN4ePj9qBnNY5RdGrgseK7LT4YruEM0-A&oe=69D256FD"}, "display_name": "ZAP", "keywords": [], "long_description": "Behold, a new action packed situation shooter has arrived! Play solo or co-op with a friend, ZAP offers you 32 levels set in 20 unique stages that will test your reflexes, aiming and situational awereness. The game is straight to the point and gives you a proper challenge in levels that are trimmed to give you the most exhilarating experience every time.\n\nWe are dedicated in making continuous updates to the game with new things to shoot in new stages, game modes and other fun events. This is just the start. We would love to hear your feedback and ideas on what kind of scenarios you would love to see in the game in the future. \n\nThis game is a letter of love to the VR gaming community by a small Finnish indie studio F\u00f6nster.", "short_description": "A co-op puzzle-shooter with classic arcade vibes <3"}]}, "developer_name": null, "developer_privacy_policy_url": "http://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "2590358747770977"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1272770554949320"}, {"status": "PUBLISHED", "id": "524240077149371"}, {"status": "PUBLISHED", "id": "1275858846348795"}]}, "baseline_offer": {"id": "1272770554949320"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773952560, "status": "PUBLISHED", "id": "1272770554949320"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9438965066124938", "version": "1.10"}, "id": "537122071969734", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andro
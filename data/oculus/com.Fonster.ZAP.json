71-25/75272215_1072765251050922_4758062684767070629_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkmhWlMpjd4Q7kNvwGUTGVI&_nc_oc=AdrjNKNNLriM1Oi0Tan1uAQQoNTn-nXG24LHuau_gSfd6gET9JRyf4YogmM_2UHl64A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwfutSvw_0lRszi9bH_KtW1P5F7wKHBvydNo7Y-nadGQw&oe=69C14F4E"}, {"file_name": "StoreShot_3.png", "id": "754426583496315", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974758_754426586829648_261525823422325319_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=488h_Opj8sgQ7kNvwHIrT2c&_nc_oc=Ado9HQTbB_WVMK7Ys3KiCld_or72z6uVo2p97A7t9aFd0TwM4fcNHcxHDBgDtfQuEjQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzoRnjdi9SOF3Z_88QUexSU0PwO3-bKvS-9lu2i3dOsw&oe=69C1427F"}, {"file_name": "StoreShot_5.png", "id": "1060579662530481", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035405_1060579665863814_3026570350454008856_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1etsdlJbFyYQ7kNvwHvG0JE&_nc_oc=AdoCxgrMo_URZ3uuKfqiTw_0tRT6yP8owhSXnP-zeHSHlJzTVf9uW0hDDwXpvZvawMo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCy8wBqMxkLlE9ks7BoT5gAnkXSdtoNvHwEhicGH-W_w&oe=69C12C52"}, {"file_name": "StoreShot_4.png", "id": "406101072548397", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982476_406101079215063_8421779914901899528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTVYRvL7YdMQ7kNvwFuo3tq&_nc_oc=AdpyFo3iqZjsrHUSxJhdgcXawlENtuFdRwuwRM2Brghb5YR64hdAVKQMBbM6nMqQhDQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx55O9HgKSTMDYVg4ZyAEL6haAY5A3-8ypuegS6YcgPIQ&oe=69C15055"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Keyart_Guns_2560_Baked.png", "id": "1097110581857687", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974562_1097110585191020_7452520209657660678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkYivAMognAQ7kNvwGjuFOP&_nc_oc=AdoGuOg9Ga7pCdJ9VCF4ko1iGm8geSvGlklGeV8bqe9fkUMXPsMeV-6THRtvCE8pZQA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfmDo1M9sznqOGGKYZL41zRZwumKnNqSrzNSTR0D2WhA&oe=69C144B9"}, "display_name": "ZAP", "keywords": ["puzzle", "shooter", "coop", "cooperative", "2player"], "long_description": "# Get ready to dive into ZAP\n\nWhether you're flying solo or teaming up in co-op with a friend, ZAP offers **23** thrilling stages designed to push your aim, reflexes and situational awareness to their limits.\n\nFrom competitive to laid-back levels, there\u2019s something for everyone. Whether you're chasing the global leaderboard or simply soaking in the stunning visuals, we got you covered.\n\n{839344524831082}\n\n# No motion sickness\nWe designed this experience  to run always smoothly and with limited artificial movement. It's the game you should play with the friend that's new to VR.\n\n# Zapper UI\nThe back of your gun tells you lots the vital information about your current situation. Your ammo, time left and the strikes. Tree strikes will fail a level. Strikes can be caused by failing to avoid projectiles, shooting protected targets etc.\n\n# Secret bonuses\nEvery level has some hidden bonuses that can be unlocked for more points. If you found any they will be visible in your victory stats.\n\n{493455766460001}\n\n# 2 Player mode\nWe have all the good stuff you'd expect like voice chat, animated avatars and detailed stats to see who's excelling in what.\n\n\n\n\n\n\n\n\n", "short_description": "Stimulating arcade shooter with online 2 player co-op"}]}, "developer_name": null, "developer_privacy_policy_url": "https://f0nster.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Fonster", "support_website_url": null, "website_url": "http://f0nster.com/zap.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_su
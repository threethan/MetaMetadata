98026496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqHoMW8blhEQ7kNvwEed1zN&_nc_oc=Ado2KWA6qIUTMbb1KgMD-50RTqQXHuXbzcEFcvD8Bg-TuTG_LiIE1CR5Hv5f04Ig-Qc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm0cPzIHmyBLjYf1pcgDsbkmzgm9HBRzBC9xghaKljDQ&oe=6A85A40B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rocket Carz Racing", "keywords": ["racing", "cars", "classic", "rocket", "flying"], "long_description": "Rocket Carz Racing - Future in Past! You have chance to race on Classic Old Cars using rocket engines and no wheels, following futuristic trends of 50-60th.\n\nFly further. Rank higher. Keep going. \n\nFeatures and Game Play:\nExperience  Rocket Carz Racing fast tracks with a 360\u00b0 field of view. \nUse the gyroscopic sensor of your smartphone\nUse bluetooth controller\nAccelerate the car by tilt head forward (or joystick on controller)\nSlow down to tilt head back (or joystick on controller)\nChange camera by double tap on Gear VR touchpad\nNavigate menu to put marker on a button for a while\n\n\n\nEnjoyable Rocket Carz Racing will be updated constantly. Please rate and give your feedback for further improvement of the game.\nFound a bug? Please email, we will fix it.", "short_description": "Rocket Carz Racing - Future in Past! You have chance to race on Classic Old Cars using rocket engines and no wheels, following futuristic trends of 50-60th."}]}, "developer_name": null, "developer_privacy_policy_url": "http://okigames.com/policy.html", "developer_terms_of_service_url": "http://okigames.com/terms.html", "publisher_name": "OKIGAMES", "support_website_url": null, "website_url": "http://okigames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommen
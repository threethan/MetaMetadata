lying"], "long_description": "Rocket Carz Racing - Future in Past! You have chance to race on Classic Old Cars using rocket engines and no wheels, following futuristic trends of 50-60th.\n\nFly further. Rank higher. Keep going. \n\nFeatures and Game Play:\nExperience  Rocket Carz Racing fast tracks with a 360\u00b0 field of view. \nUse the gyroscopic sensor of your smartphone\nUse bluetooth controller\nAccelerate the car by tilt head forward (or joystick on controller)\nSlow down to tilt head back (or joystick on controller)\nChange camera by double tap on Gear VR touchpad\nNavigate menu to put marker on a button for a while\n\n\n\nEnjoyable Rocket Carz Racing will be updated constantly. Please rate and give your feedback for further improvement of the game.\nFound a bug? Please email, we will fix it.", "short_description": "Rocket Carz Racing - Future in Past! You have chance to race on Classic Old Cars using rocket engines and no wheels, following futuristic trends of 50-60th."}]}, "developer_name": null, "developer_privacy_policy_url": "http://okigames.com/policy.html", "developer_terms_of_service_url": "http://okigames.com/terms.html", "publisher_name": "OKIGAMES", "support_website_url": null, "website_url": "http://okigames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "491176319109792"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162679_274222596371902_84135033312546652
73392019_620902300813328_6257618104503830576_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSAjoNls48AQ7kNvwGognsy&_nc_oc=Adoy4QMEUij1ByzQddtBnzM7pPjpkFjWbN4GC7QqAyGE2Vd97dmLp_tjyaN1UnZfG_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUAYHhGQoPMmHxhFNP45CuF30XW4nnGjPZZWbo6vakpsw&oe=6B105DDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "portadavideo.png", "id": "1090622539492820", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393491_1090622542826153_3082859957601475711_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGwH_XwSr4MQ7kNvwE4OX-U&_nc_oc=AdrKGpjZ5EKKrlsriVNRbAU5lmo4TuKrRx8jOrhEbom7xwPtuC9CctjwxTce-FQfj_0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXher2RymVwY2vZDAw-hcMdTCoHCkj5Ryx7EbVKV5sr1w&oe=6B1048B7"}, "display_name": "DropStick Simulator", "keywords": ["reflex", "MixedReality", "DropStick", "Coordination", "Training"], "long_description": "DropStick Simulator faithfully recreates the physical DropStick training experience \u2014 designed to enhance reflexes and hand-eye coordination.\n\nWith realistic falling physics, precise detection, and full mixed reality support, every stick behaves just like the real thing, challenging your reaction time in your own space.\n\nThis is not an arcade game or competitive experience.\nIt\u2019s focused training \u2014 pure and distraction-free.\n\nFalling physics based on the original DropStick.\n\n5 difficulty levels, from beginner to expert.\n\nFull mixed reality support.\n\nIdeal for those who want to improve their coordination and reflexes.\n", "short_description": "Realistic DropStick simulation in mixed reality. Train your reflexes with falling sticks in your real environment. Based on the original physical experience."}]}, "developer_name": "overwave", "developer_privacy_policy_url": "https://overwave.cl/#privacypolicy", "developer_terms_of_service_url": null, "publisher_na
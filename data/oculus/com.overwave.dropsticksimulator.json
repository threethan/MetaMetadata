4.5771-25/473393491_1090622542826153_3082859957601475711_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9IOh4exL8QQ7kNvwH0HQZt&_nc_oc=AdqsuJSKN1HejDWebv_jshiEbNVKMjz4m9R1B1eqqp5w3k6UDJxS0nlb2P4sJherTjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3jGGARhwJwYmw0kRVMVziixcYetmFC6I9TVy26ljEOZg&oe=69F0A977"}, "display_name": "DropStick Simulator", "keywords": ["reflex", "MixedReality", "DropStick", "Coordination", "Training"], "long_description": "DropStick Simulator faithfully recreates the physical DropStick training experience \u2014 designed to enhance reflexes and hand-eye coordination.\n\nWith realistic falling physics, precise detection, and full mixed reality support, every stick behaves just like the real thing, challenging your reaction time in your own space.\n\nThis is not an arcade game or competitive experience.\nIt\u2019s focused training \u2014 pure and distraction-free.\n\nFalling physics based on the original DropStick.\n\n5 difficulty levels, from beginner to expert.\n\nFull mixed reality support.\n\nIdeal for those who want to improve their coordination and reflexes.\n", "short_description": "Realistic DropStick simulation in mixed reality. Train your reflexes with falling sticks in your real environment. Based on the original physical experience."}]}, "developer_name": "overwave", "developer_privacy_policy_url": "https://overwave.cl/#privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Andy_xr", "support_website_url": null, "website_url": "https://overwave.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_a
AXZNc7FbG4JTJiVVrw_cqcuemmg&oe=69BD5CAF"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fw1CfiC7l_kQ7kNvwE6A4sh&_nc_oc=AdlPamx8yzm-uQClEl5PXGURfivwv9kKp3IeiEEMZj8uNMf0FS7Rv9Ri9p_v_7A0Kgg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3Pa01-YQ3nfUypnDhA6zN80fSoH5IExLUS0rBShib1w&oe=69BD45DF"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-J8g9T0zSEQ7kNvwGAL5EU&_nc_oc=AdnQRuTR6fe_nqMqN6K5OS9aUT7Fy3R6D3_YAK_JHkBs6PCHBgrojmzTQiZ4EeO9uhU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfymAc238v_jfA7leYUy3MAbaHiUeNLtyIwIhUovQCDo0w&oe=69BD3A11"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im3vkpB0SdEQ7kNvwHj8rtU&_nc_oc=AdljffvFmttqHg3c6LbqrqQsz2LMgGtMQFUx3RJN42l2mCw-l3WIf2m-rxwKSzPgPUE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc7234udn2R5rlF_tEYDKd86RMeFAqwbe_igw-TKTq8A&oe=69BD2AA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5FyGkHC-BIQ7kNvwHA83OF&_nc_oc=AdktH7nh8IGhro4b9_gXI6GVeHIIdo39RV71weAUQOVBiSAHdg14uxIkNkf3BSTIvVg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmUumkFa_JqDeItC058v4r57irgODAvEJpb4jCd6849Q&oe=69BD54AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Domino VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1269311016487965", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata":
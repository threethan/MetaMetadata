ice, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y-8jTgsjRsQ7kNvwHaw082&_nc_oc=Adqh7QZFe7n4MGZxtyk_X-0FdZ74mJhvwQw0W9F1VIoeOQU0WiW6HPeNpdwR2rAX4l0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiscy80vnAqG8jytbgm7fvyP2i3UXrBk6Pyy9kkttkWA&oe=6A6DFDAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Domino VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1269311016487965", "release_type": "SCHEDULED", 
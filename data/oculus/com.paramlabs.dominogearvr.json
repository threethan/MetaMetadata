m&_nc_ss=7f20f&oh=00_Af9PyM5lvq-SQjTETeQCpFO0MA0gwblWp4XIt23F1-32Tw&oe=6A3949AF"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5MMq6B9yhMQ7kNvwG9g2Ln&_nc_oc=AdqKM9CnxdyJ_kJMNi7iPTBWCynDLZ99uo3xLSgco5WnWubsh4d4N3J28atJtlCfAVo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UiF9s8reM7DmfcQbA9ucZICdTZXMyXVboRXCWfvMvHw&oe=6A3932DF"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z84DU_dacDYQ7kNvwFOhRpq&_nc_oc=AdoleN-vOOo2iZgtPeXZl-5iZrXob2vWcoVy3PjAiFGfV-LoYb_4PdFEscxSYtngg7k&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GbsL571AsbSWEe3whaQ_HiMbnVBwtTDo_kNZ_vA14Kg&oe=6A395F51"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qW6JHzz-sEQQ7kNvwEQkJcW&_nc_oc=AdrwfpD_oBwV0BKINSl0k1zm72GnNY9kaZSvR6UuOmVMUyTPbYL7EoBULTU0Aq2jh88&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9silhQc6TXKZU7BFhFBTQpmfcHbtek40HjKy5nePBnSQ&oe=6A394FE4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9Gz3Dv6k3QQ7kNvwETzIgt&_nc_oc=Adp_vTTnUKpOhdMnDWjm2Ia-X3JF0TE1bOyCoW4zv075p5HTZ49QKi4Zygk5YyUIb74&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l8EMj4p5qOh26L704Snj2cPei9SZO0iWaTpDNHjwuVA&oe=6A3941AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Domino VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1269311016487965", "release_type": "SCHEDULE
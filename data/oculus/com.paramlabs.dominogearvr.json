17319657472_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UFmVMnpvocQ7kNvwF5JGEk&_nc_oc=Adq-vxLtlmcfgBe7V11QeSXGbpED1M88wsPG4RWaAUoAO3Z4JP1CdCbU6jSeugTaRI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXd3LWmT3g2bGS6PHhoQyMn030nad_Q2EbNr_mc2IXL3Q&oe=6B0F14EF"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqlQt1uslKcQ7kNvwFq2ZyU&_nc_oc=AdpeaW2UZbLBTar2U8tQ5Xasao_YceaBRuUl0Wnbi1gq6S1kx9xcmKCD-OsF-3UWsnQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVABQGRXrZ-D-CSAOqmodDSb_bkgII4iF2wtKsKfSkuIw&oe=6B0EFE1F"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0vfKmiy6PsQ7kNvwFywOPC&_nc_oc=AdqQSdcbi7prbQvOtC7SVd3P3A3loxTwjFvXndtJdDnz525TiVlDwgGv1ulj5Nvg6Lw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUib-7xHBNGdjijvnU_s-67GcOQeOVAok_1Y16AYOo8yg&oe=6B0EF251"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1qakLHZe6cQ7kNvwHwOiAq&_nc_oc=AdqTSy5xFun7tQx6cpvpoDb_IpEAOK76q2sQglAQLV1BGH4uVmsP2MuKCUzyWiYIZaw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrO93urjg-RdH0OyZx2UPxlK9b2tDhLWvWh-ao8Cc24Q&oe=6B0F1B24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHcW1cW73xYQ7kNvwF5JkG1&_nc_oc=AdrP_Rxl8a4W4_8PL2nSoMaVa5rJTN4xVVP4KHpt7UJcLOpEyghBsyiEMqLCVfQT2NE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU42
17319657472_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2ta6NRTiyEQ7kNvwH7rkVq&_nc_oc=AdqdsPV5fJqWHRiwMabkBTbe7162aCPo_g-AxX0DZ4zpksjg7sqj_AqNjhkci_4A6KA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCAlggV185gIHpnK63Tgn6UN0BYQ5z2W3VdaltnVr8xg&oe=6B0C71EF"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqlQt1uslKcQ7kNvwFTpTH1&_nc_oc=AdpBOn0kEzz3tq9iLLi7WwvyRU0a8U3ccqL3nuk-76kuPpThvNXOyINHMBJdFjH8r1c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1tQ1qSH2GXtJjhVedruYseF4QC6jwzww2WnCADN3R_A&oe=6B0C5B1F"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFuVtMRVZAwQ7kNvwEitW3_&_nc_oc=Adp0Gw6tFFK7EeB4audOi8VOWJYiamJiVRd91Dt3LwbysWE4_QvfPSCMUP-GBUVwmH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkbWnC-4AB1ANdoVITR-WOtqndGLEQN9mjupbZdSlyCQ&oe=6B0C4F51"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTXGSqJHaIgQ7kNvwHdGfoG&_nc_oc=AdpQgU9u7jmQKphoDHA_O_VfIGuM-FlGbD2B7kIa89ZBfhgctsESMPT-G-KU1kwQh5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRIceFYMz_aYgaxo5J3fmIu1AIOAKHugFpQTLuxHPn5Q&oe=6B0C7824"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZbD4KRCQekQ7kNvwFb5_An&_nc_oc=AdqXz_N7J7PgOkr4htD_mZZ8Gk6yy-B6LYngPmkMwNOFdpxR6GaiQLT85fabkZJQp6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4C
17319657472_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xU6oae3qrwQ7kNvwFUG7nQ&_nc_oc=AdpA3lIxfuktmSoInFi0pkiS9T80fMeMz4TXVdO9HTEU4kRUTE_RdT8kQmQ7kDWzl94&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8MefvpUg1PtLQhzFYkcFN-IQqrW5MQFjUP0QKF2eChg&oe=6AFF0AAF"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6W4WrJZnFqEQ7kNvwGGCB4u&_nc_oc=Adr58xT9fbMNhx3UZbr1Qe8dfy6ChIBQ68pjovlXFdGNUtkXTckFtmdqrpueFvv3l5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwfuvFG6aQP2q7u8XXf_N1-2OOK2VEMFOmZEbEhpv_Yg&oe=6AFF2C1F"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymiFgEjldH0Q7kNvwHTZaht&_nc_oc=Adp9E9_ws3Ql80lpkMu0MUnSkWaAVhpMDTWEH2hux1nSpAj94nOd8tHHl7sya15pjec&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkrEPO5fF2q5iivnnMUSAKZ8IIjM01PPAajFhctmANeA&oe=6AFF2051"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snQPCChJ0jgQ7kNvwFcb90v&_nc_oc=AdoHhhr5bikZLt9Q7-8JWuWb0M9xnwyNDy91k07IhEJ6fwgKU--U5g8ESW0ZQ_gTM8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMuJ1VYKvX26-X6aKkc9ZRkaYxsudJdCzX1UQVhTff-Q&oe=6AFF10E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfKVGGdEfa0Q7kNvwF7tA7S&_nc_oc=AdqUqOLMISWAdFBv9WBmK26HQ-ZeXQXWWzQKWX5fCS5EpLosqj-YPB-d12_5g5vNx_c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-C
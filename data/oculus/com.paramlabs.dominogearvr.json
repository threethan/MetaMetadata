uluscdn.com&_nc_ss=7f20f&oh=00_AQFZ2Ue6JE8jQ3JkgtCkmuGfzoNMluaTPuLTaHWVxaTyOw&oe=6A8D716F"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LeVvw2CBFYQ7kNvwGGHZlR&_nc_oc=Ado_xVcTOk24IRoHrNGHFjfLn4YnVFFYy-2nPfKBXvJbLSDhRPuN6mNvx9UrBwbBgdo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGu1WjQ1R46Z_zi-nMJtwBLjQ4hXYlLHke73IEcUUM2TA&oe=6A8D92DF"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFggcwPt-48Q7kNvwH8UMgQ&_nc_oc=AdoDitqLyl-nWDkn85T_3tWaTpbG-hgb6oEAZC5IExpSMrZoHqskG38octTmMA0PaVg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7EHVl4f9MxaXJhAW5r-GsC8Lu2fXDAgbgrPvm94cgtw&oe=6A8D8711"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I41Hx4xlnf8Q7kNvwHJYXPs&_nc_oc=AdoHDgi9reJ-nTl-VHtDlOptAlVdJ5nVVU4inOesN_gJzLUmb3CSt9RQWiXfUynU6PY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELMnv8Rd336acwTQE6Kb5Vnb3dLQxc1BlwkBvajij6-g&oe=6A8D77A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsKAyeknuGwQ7kNvwGMGw2U&_nc_oc=Adq0niGbsNLkoTDrL-H5SLnL8eDrGN3FsLqeam9JR4zGsmLbmavCo-vFMVj136j1oC8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL3S_qCKQqp8ETB9hkaSUN3FO5hGMUshtouKosYQLAVw&oe=6A8D696D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Domino VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1269311016487965", "release_
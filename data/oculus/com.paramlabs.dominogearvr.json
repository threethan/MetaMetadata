17319657472_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF56UcUU84cQ7kNvwHhGLEQ&_nc_oc=AdqsBsQ3OXy6sZe4YXyaUbT2XIZAPrv6fofRvuEy_CE44q5sioGHPiCpwyaJLohMrNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqFQTz8VdzB10jFdYRn7H4k_4dCDA-ctJ0of_k0wafpg&oe=6B0488EF"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOaf3BU9DLwQ7kNvwHgChrY&_nc_oc=Adq9MotSJJUDw-X-8x3IhT370UhR-iyMsm2WwMxiGmMp-PyppGHjFAXtt2jr2-nRTLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1osdIddSU_NhgZo3MeBiPy8xFVZeWp-MH5A7g1v5TyQ&oe=6B04721F"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4me1ntpxvAQ7kNvwHo9_N-&_nc_oc=AdrPsGyLEeQkrIMbbQBQTOPL_yZF8VeptlLiEdk4BHbUOMpmnCmwVnG2oqB6ZP_0RnY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXt2onYIkZW54HbkdfKg8YKaHde4eE2E0OZ1Af10WlgA&oe=6B046651"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r5EM1ee4_MQ7kNvwFsa0qv&_nc_oc=AdqLpdw3DLRHSE3of2c3BBUcAteEvzjG-wfbSlpHtZlmoinrNDZDIUxd1ZButOxYMJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGWcLD8HMCCs277KA5pHwJvK6qAF5IR8Ns6qBNu0ft1g&oe=6B0456E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhQBxgRSdwUQ7kNvwHzcw4f&_nc_oc=Ado09okzNHIEjD5jsutt8X9agsrAFRKTUD92RTimA_2_cfHi9qwDRbDQEDPjoJPrFPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXV
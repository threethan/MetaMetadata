17319657472_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xU6oae3qrwQ7kNvwGe1R0M&_nc_oc=Ado8YKcpFWt2-fVFTRzxpWTNhqysAZFPfksyV41Haz-yE6EjoobhBR0RmJSSJnOwTTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd_GYvqC844MCSxSikFb3REQmJKBjVey6x2NTlZNWvFA&oe=6B005C2F"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vH0WtwH42MQ7kNvwEMaghK&_nc_oc=AdoyOynjaNKEXAh1DmErdgGk3zscYJlRscd4joYTiRTOlcYUs2GEkAg2zWi6p4B-cjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaTm8GsyOZHWiWqPBRDy_q5NkOrcteZErCZVuIrIqjFQ&oe=6B007D9F"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymiFgEjldH0Q7kNvwF6kNhH&_nc_oc=AdpiGxsMKxL1LG-po2kF7oWQwDcgbj7aiyCQ2PNCMpjS0IOmNekaZ-mFlnCr3mn0i6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjigQufxlP4lHTuVTES9ghv_3jZE5w7z1kx3uKoIWqOg&oe=6B0071D1"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=snQPCChJ0jgQ7kNvwH0ImrS&_nc_oc=Ado1nz9xbHHLBBEDV7M9Mi4qWxhSV2ualIXQtuo9HC8kn9HlPe_Cvmd2uYSZ8LCP2VM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHcmYBqhLk03IAGZsJ4spWOjhc7mmkmiZIPhlVzKARig&oe=6B006264"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfKVGGdEfa0Q7kNvwE-1eyB&_nc_oc=AdpbCe7QKqtw9JBd0bBU7oM_z-YMOMZp5RGxyLtqtAKruiAcUOeb-bBZE_LNEGS4MRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnl
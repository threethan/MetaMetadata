JbsOXO5rV4pmo6ntco50gcrt6kw&oe=69BFFFAF"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQmwW8dtDzsQ7kNvwHGKDSy&_nc_oc=Adkhn471UIxRJ_2XwhHeKDS0EpgsCn_3MjoBB9zzaLoZmiVk8WmIoK5nBwIFmqLNkuo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyc_EuFgUnCO9JTr6nCpc2_z1p0o3zXy0v1NlnRd6W-7Q&oe=69BFE8DF"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mREtCpStuYUQ7kNvwG-u3HM&_nc_oc=Adl1WAAqcfJ-LwjHiFhgujlsVZee5EWIVhLS1lwOfrSjzjkTbm5WtEEKrwY0Gswns_Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOrD7HhrAozm_1uN2-QEWn8nakPQysrvocW7cZqQdFCw&oe=69BFDD11"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Im3vkpB0SdEQ7kNvwFzhBZ4&_nc_oc=AdlGP5dHPOmjIBbN8HkgPw0ulhD5U3qEWGMoLEgS98fcmC4Gr4NnYeM5wNwi57OJU3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-Af0Kux1xR0mqb3Uj5Joj-C0RSuGjzsRGY2ntrySK_A&oe=69BFCDA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5FyGkHC-BIQ7kNvwGaF_W1&_nc_oc=AdkX0aL95wNta-XSqmF7dMXWvrkcQlXhpvLmR1XkcfLa9SmfrfzgEckZo49GyLYaNWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyO_RfUhnNGK3_l_SKD5YS-VWBbDEUFMIlhmfp2OF-rBQ&oe=69BFF7AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Domino VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1269311016487965", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata":
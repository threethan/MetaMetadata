17319657472_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLR5H_0HSskQ7kNvwH1hx3a&_nc_oc=AdqvIqmqXz4s_IzBbNAxzG6eiH_aabhT-dEHnoDBeylfpAwiKzUPy-DqPn-Cx7wSimI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe1xxlIPU1pbd78nHSfkPumsw1qMDXUAmAFXAVbaKqOg&oe=6AFB162F"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNxehw6uuMcQ7kNvwHcISs0&_nc_oc=Adp_u6QSvunGgxHEu-7G8uMQcN0XUamKV3zPepd0fxpSnmpnis4Z5iL3x-ghWrRMXT8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgmYoCE2zLNmTn_z6HfOt9L_iLgZgTeMlBoK1wxDzOdg&oe=6AFB379F"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqbuIIdT_QYQ7kNvwEnk6eI&_nc_oc=AdonufcrAlQG4OEPJmF5zC9POELTMNbO4FrkpK4EnjIKhweRaiCub_SP0RXNF25o_IE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2ITtbWMTcIevFyumWbAlbC2Rp2UYb25ZufztPL6hUAA&oe=6AFB2BD1"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-9k29bQlccQ7kNvwE1MYMm&_nc_oc=AdrPFB_dzNFlFYFvcKGV8zKH-bo7aGgXr43bk8Kh8bcZBwZHBtYB12uGX2o9Z4B_qFM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZPeSzBGjozvmefWnk-BQwVLT3zsKp2ypgPEoiKBD0Sg&oe=6AFB1C64"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1lFsJSV6J4Q7kNvwEhx5PC&_nc_oc=AdpffmNhiBEfDwHRB8g4WtqK7NxxIAazCnAz_TUbpVPR8xMU3bE2tQ958oTnkAilvWg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9X
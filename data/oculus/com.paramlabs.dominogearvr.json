uluscdn.com&_nc_ss=7f20f&oh=00_AQGhUcbA7xVof-TYVsxVZ-IDhEVDWmE_4ERTj_7-IafIDQ&oe=6A8EC2EF"}, {"file_name": "migrated_image.png", "id": "1492696840897504", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162678_806134439544087_4884130547225329664_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LeVvw2CBFYQ7kNvwGvfKHn&_nc_oc=AdrdQvlXrwF8BcXpKtZfN2pEStU1LrAJQaMhS2rRtpYFuZiAZxO8usGYpayBgyGlQSg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlhIbwHNoJh8V2Di9Tb89mcjKHCTwRcNzaKAsgRCvKiA&oe=6A8EE45F"}, {"file_name": "migrated_image.png", "id": "345969199684409", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12602290_190215941492946_8305191235371401216_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFggcwPt-48Q7kNvwEHuHjt&_nc_oc=AdoDXQSjYnE8y9FNS-md42v-Q9NX2d14vsI6LjufZ-GaISJ_0cmwlxS8dJWtvoBjKJ0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn2k3rD0a-9UAwzpjHcn-0ZoEjrVxh_95OrWneGqWnYQ&oe=6A8ED891"}, {"file_name": "migrated_image.png", "id": "219286585939944", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162788_1657386201223280_2120778112584122368_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XU8Z9zT5_pwQ7kNvwH4cxkP&_nc_oc=AdoAuAYBvC-3S1CScR5kzp_dsXYcjENyj_9xLPAnxhm2W92P2ZsNiqGioX5_qfRVv2Y&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwpnWIfmKA_WIFvD7752x_N1xiBAxjfw5H7v013s--tg&oe=6A8EC924"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Domino VR", "keywords": ["DominoVR", "Domino", "Paramlabs", "VRDomino", "Dominoes"], "long_description": "Take a trip down memory lane or indulge in your favorite pastime as you play with dominoes on your phone. \nChoose to enter \u201cFree Mode\u201d and express your creativity or enter the \u201cGuided Mode\u201d and have fun building some interesting formations \u2013 all within the convenience of your phone.\nWith Domino VR you don\u2019t have to worry about your creations taking up space inside your house or office, you can simply save unfinished creations and work on them later to create awesome and complex shapes. \nRelive the experience of watching the dominoes fall without having to create the whole line again, and in case you get stuck, refer to our helpful tutorial to guide you along the way.", "short_description": "Simplistic and mesmerizing; the definitive dominoes simulation."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.paramlabs.com/privacypolicy.htm", "developer_terms_of_service_url": "http://www.paramlabs.com/privacypolicy.htm", "publisher_name": "ParamLabs Private Limited", "support_website_url": null, "website_url": "http://www.paramlabs.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979714832676809"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162683_260005351075805_5862199264582565888_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Za7mvmwSykQ7kNvwGwYiEi&_nc_oc=Adrq08XaI-Z0OK_r7Xx0RL1zvUIlxOHvDXLRYyAErpe9KrHtPmapZMxfRxhFQd5GkPg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxvrHW7tZ9fi3E8sFaz0hi351ws4XmKNaAl58XKkr07Q&oe=6A8EF32D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Domino VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493190000, "lastRevision": {"nodes": [{"id": "1269311016487965", "release_
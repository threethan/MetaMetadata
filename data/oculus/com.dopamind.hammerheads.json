Nw&oe=6AA41E0B"}, {"file_name": "3.png", "id": "448641504407146", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974919_448641507740479_4943524843252219537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKgukAcrpNcQ7kNvwEQez9x&_nc_oc=AdoJ8JtRmGHFo3YbCeZ9JqTXt0DdQ8UXmR_x2fCbWidiCPIDxdUPqDUD3xn3GWLuDD0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi5L80mbmmXEzSPDstOUzoJcnEBju3zr9mrv6itftagQ&oe=6AA41FAA"}, {"file_name": "1.png", "id": "1094226811864451", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031528_1094226815197784_7168758711047696244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ia9ouX2PMwcQ7kNvwGFwsvI&_nc_oc=AdpPsF_PMoQxCIKdYODkUkbovxgpqjufNct_FhrbkvdYpL2hnUyuDelmerZ5s1PA3f4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJshMKnmMxmoCeCvLWiIX6r2CH_Awf0ZVy10SRBz4Y22Q&oe=6AA3FF8C"}, {"file_name": "5.png", "id": "962498255879242", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974811_962498262545908_3835315499838407045_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X8K5NX1DfsYQ7kNvwF6CucH&_nc_oc=AdrsGt_AtnCyIghhqbcPC8sFAN9xG0AhvX3pC988EyRFvxTrxbGIGFXRaYk5pdPaWlo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2BKQO7dcjZqGLt-pkp6l5jT_Li0ITwhv64SFP9YjKzQ&oe=6AA41D01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape V2.png", "id": "743852067922482", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982668_743852071255815_8830255183742109230_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4a58LzdFmwQ7kNvwGb3FTJ&_nc_oc=AdrLSh4sCwWvc1GXA3nVIUXnFuEkhl7A4I9Utz7THxpIprX1Zbrkf1aBGjPa8lKkLpg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkcjyhT_bBy5AXXIUIq8LJnGRVBNOgTxT7lMT1PloW3w&oe=6AA408C5"}, "display_name": "Hammer Heads", "keywords": ["yeeps", "gorilla", "rec", "room", "grab"], "long_description": "# Hammer Heads is a VR multiplayer game with multiple game modes like escape, survive, defend, race, hangout, and unique hand movement-based locomotion.\n\nYou can enjoy games like:\n\n# Sky Park \ud83c\udf88\ud83e\uddd7\u200d\u2642\ufe0f\ud83e\ude81\n\nExplore an elevated playground for climbing, flying, racing, and blaster battles, with challenging rewards to collect.\n\n{758726772714938}\n\n# Maze Out \ud83d\udc79\ud83e\udd2f\n\nNavigate a monster-filled maze, either finding keys for escape or causing mischief for others, all while hunting for loot.\n\n{452608070564989}\n\n# Flag of Honour \ud83c\udff3\ufe0f \ud83d\udca3\n\nDefend the flag from relentless bomb attacks in this intense game requiring teamwork to succeed, with competitive scoring against friends.\n\n{1106201633989177}\n\nAnd more games are coming soon!\n\n# Flex Your Looks \ud83e\udd20\u2620\ufe0f\ud83e\udd21\ud83d\ude0e\ud83c\udfa9\ud83d\udc51\n\n Plus, customize your avatar with over 70 animated cosmetics, offering 500+ combinations to showcase your style. \n\n# Join Hammer Heads community - \nhttps://discord.gg/YYba9rb9n4\n\nStay sharp, and always watch your head!\n\n", "short_description": "Hammer Heads is a VR multiplayer game with multiple game modes like escape, survive, defend, race, hangout, and unique hand movement-based locomotion.\n\nYou can enjoy games like:\n- Sky Park\n- Maze Out\n- Flag Of Honour\n\nAnd more games are coming soon! \n\nPlus, customize your avatar with over 70 animated cosmetics, offering 500+ combinations to showcase your style. Stay sharp, and always watch your he\n\nStay sharp, and always watch your head!\nDiscord -  https://discord.gg/YYba9rb9n4\n\n"}]}, "developer_name": "DopaMind Games", "developer_privacy_policy_url": "https://dopamindgames.com/index.php/privacy-policy-hammer-heads/", "developer_terms_of_service_url": null, "publisher_name": "DopaMind Games", "support_website_url": null, "website_url": "https://dopamindgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260
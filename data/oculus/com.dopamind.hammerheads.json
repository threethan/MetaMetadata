Gw&oe=6A7DAA4B"}, {"file_name": "3.png", "id": "448641504407146", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974919_448641507740479_4943524843252219537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6i1nsAQHEU4Q7kNvwF8orCj&_nc_oc=AdrYCKp6ftVyHxzg1SRmEIz8jt1yPL2P11YBRtRZImkToz0HXzsrlE3-hEIperfFMdo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFhlyDwYkt0LKXoxy6svGiPCWBu3CgNJBc4jL6wXfjOg&oe=6A7DABEA"}, {"file_name": "1.png", "id": "1094226811864451", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031528_1094226815197784_7168758711047696244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8g5nspIDKIQ7kNvwGWna08&_nc_oc=AdqExKzVnqoTTlw72osis0aOXrhwgwNolrrvOhV-kqW9WBoSK8bz-m3Y97CoZwn5JeM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUt3sBpZbiaDcwXsyxs3P714D0A5oHv_fME29mPTMPlA&oe=6A7DC40C"}, {"file_name": "5.png", "id": "962498255879242", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974811_962498262545908_3835315499838407045_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9NfVNDz-QAQ7kNvwFr8Vw1&_nc_oc=Adrg_xzzarHVn08CDysMX5ADbRLVcqlEcMn8OWPymEgv-r7jzvCNRhaOp4YH4t6rfNk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWJwO8pYr5KL0ORfOfpASc9ZIlcycXPtHcknZARUnAZQ&oe=6A7DA941"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape V2.png", "id": "743852067922482", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982668_743852071255815_8830255183742109230_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4cBCVrZLHcQ7kNvwEwEJov&_nc_oc=Ado_r6pQ69vTFBkTgYjw5mcX10Y7U6walKCwJWWPhoc3H4_encuynMJlCznTYTWpI9o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFudAC8kFcxBu3e8J7GCZagNW4JwWx62CJv8ou7RZv91Q&oe=6A7DCD45"}, "display_name": "Hammer Heads", "keywords": ["yeeps", "gorilla", "rec", "room", "grab"], "long_description": "# Hammer Heads is a VR multiplayer game with multiple game modes like escape, survive, defend, race, hangout, and unique hand movement-based locomotion.\n\nYou can enjoy games like:\n\n# Sky Park \ud83c\udf88\ud83e\uddd7\u200d\u2642\ufe0f\ud83e\ude81\n\nExplore an elevated playground for climbing, flying, racing, and blaster battles, with challenging rewards to collect.\n\n{758726772714938}\n\n# Maze Out \ud83d\udc79\ud83e\udd2f\n\nNavigate a monster-filled maze, either finding keys for escape or causing mischief for others, all while hunting for loot.\n\n{452608070564989}\n\n# Flag of Honour \ud83c\udff3\ufe0f \ud83d\udca3\n\nDefend the flag from relentless bomb attacks in this intense game requiring teamwork to succeed, with competitive scoring against friends.\n\n{1106201633989177}\n\nAnd more games are coming soon!\n\n# Flex Your Looks \ud83e\udd20\u2620\ufe0f\ud83e\udd21\ud83d\ude0e\ud83c\udfa9\ud83d\udc51\n\n Plus, customize your avatar with over 70 animated cosmetics, offering 500+ combinations to showcase your style. \n\n# Join Hammer Heads community - \nhttps://discord.gg/YYba9rb9n4\n\nStay sharp, and always watch your head!\n\n", "short_description": "Hammer Heads is a VR multiplayer game with multiple game modes like escape, survive, defend, race, hangout, and unique hand movement-based locomotion.\n\nYou can enjoy games like:\n- Sky Park\n- Maze Out\n- Flag Of Honour\n\nAnd more games are coming soon! \n\nPlus, customize your avatar with over 70 animated cosmetics, offering 500+ combinations to showcase your style. Stay sharp, and always watch your he\n\nStay sharp, and always watch your head!\nDiscord -  https://discord.gg/YYba9rb9n4\n\n"}]}, "developer_name": "DopaMind Games", "developer_privacy_policy_url": "https://dopamindgames.com/index.php/privacy-policy-hammer-heads/", "developer_terms_of_service_url": null, "publisher_name": "DopaMind Games", "support_website_url": null, "website_url": "https://dopamindgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260
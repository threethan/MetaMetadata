id": "448641504407146", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974919_448641507740479_4943524843252219537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpdTulXbSm4Q7kNvwG4OuKL&_nc_oc=Adn2w0iSdfn3W7AEfQAiIb2_79vIhHkzi0ov29XnTdKoKN69QwSKUHefL3h9gxb3kv4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy2r5wnlBjUxh164kvmO2kfP77bich59Z8WitvFQghcBw&oe=69BA8DEA"}, {"file_name": "1.png", "id": "1094226811864451", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031528_1094226815197784_7168758711047696244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzIjQCH8_hkQ7kNvwHpqoXz&_nc_oc=AdkykX8_S063-7rzXyWw1VfjrBNR6y0QPcJwVt88imG3xoPpFCexbEz57rf5R-TB1R0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZQuHZLRDl4-pRXbr3RCA3LZF2F9tmzT5dMcJhn4kDAw&oe=69BAA60C"}, {"file_name": "5.png", "id": "962498255879242", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_962498262545908_3835315499838407045_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCF2wuCPsmUQ7kNvwFZ01f7&_nc_oc=AdmJg9JVTfmEK2Geq1Dm-qA9DPEHIO1nF6EgHP6svaAbarM-elzgsxBeRwWdLCccqRA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxpTr9V0PugvP9boYg7qc-QALj1M07oRnT75XYdeN4kHg&oe=69BA8B41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape V2.png", "id": "743852067922482", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982668_743852071255815_8830255183742109230_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OFJrRCTTEcQ7kNvwH8RpJQ&_nc_oc=AdnMMAPfG3mRaOg85E7vMpHaVJu90l7izi9WFM7BJCIzOU9_w8RgTxick--tnN_zF38&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy0RUA09O1ZCmxtegbP27mReus_Aq7nwjgYn_wfonI9ng&oe=69BAAF45"}, "display_name": "Hammer Heads", "keywords": ["yeeps", "gorilla", "rec", "room", "grab"], "long_description": "# Hammer Heads is a VR multiplayer game with multiple game modes like escape, survive, defend, race, hangout, and unique hand movement-based locomotion.\n\nYou can enjoy games like:\n\n# Sky Park \ud83c\udf88\ud83e\uddd7\u200d\u2642\ufe0f\ud83e\ude81\n\nExplore an elevated playground for climbing, flying, racing, and blaster battles, with challenging rewards to collect.\n\n{758726772714938}\n\n# Maze Out \ud83d\udc79\ud83e\udd2f\n\nNavigate a monster-filled maze, either finding keys for escape or causing mischief for others, all while hunting for loot.\n\n{452608070564989}\n\n# Flag of Honour \ud83c\udff3\ufe0f \ud83d\udca3\n\nDefend the flag from relentless bomb attacks in this intense game requiring teamwork to succeed, with competitive scoring against friends.\n\n{1106201633989177}\n\nAnd more games are coming soon!\n\n# Flex Your Looks \ud83e\udd20\u2620\ufe0f\ud83e\udd21\ud83d\ude0e\ud83c\udfa9\ud83d\udc51\n\n Plus, customize your avatar with over 70 animated cosmetics, offering 500+ combinations to showcase your style. \n\n# Join Hammer Heads community - \nhttps://discord.gg/YYba9rb9n4\n\nStay sharp, and always watch your head!\n\n", "short_description": "Hammer Heads is a VR multiplayer game with multiple game modes like escape, survive, defend, race, hangout, and unique hand movement-based locomotion.\n\nYou can enjoy games like:\n- Sky Park\n- Maze Out\n- Flag Of Honour\n\nAnd more games are coming soon! \n\nPlus, customize your avatar with over 70 animated cosmetics, offering 500+ combinations to showcase your style. Stay sharp, and always watch your he\n\nStay sharp, and always watch your head!\nDiscord -  https://discord.gg/YYba9rb9n4\n\n"}]}, "developer_name": "DopaMind Games", "developer_privacy_policy_url": "https://dopamindgames.com/index.php/privacy-policy-hammer-heads/", "developer_terms_of_service_url": null, "publisher_name": "DopaMind Games", "support_website_url": null, "website_url": "https://dopamindgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"
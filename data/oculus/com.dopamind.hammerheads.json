X8QvkCeBBCfy9dECkQ9MQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfvS0b2HyW3LsEeC2mQdK6g8feYtlyYN_F1Fs3SGkWrw&oe=6AFB4801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "666231228954240", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75443236_666231232287573_5739604952955842655_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSDmpZlllFoQ7kNvwGJNQ1Y&_nc_oc=AdqBqQW9Gq81luAnGq4d0C_sSAUzw68P2GtewIouW0YPBBzn9io1VF1EG3Vv9D6899c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQujRj2Ij3NYFjneSy2YUehLHyk9SkR6J6vA6H8fhjgnw&oe=6AFB3A53"}, "display_name": "Hammer Heads", "keywords": [], "long_description": "Hammer Heads is a FUN & CRAZY multiplayer game. \ud83d\udd28\ud83e\udd2f\nRace, Escape, Defend, Battle Royale, Co-Op with / or against friends or random players online.\n\nWalk, Jog or Run around as a human using hand movements but NOT USING JOYSTICKS\nNEW - You move forward in direction of your body not HEAD and your head is free to look around.\n\nYou got hammers in a game for more fun. \ud83d\udd28\n\nIn first version you play Maze Out. \nTry to exit from a compact maze full of monsters. Use hammers to hit monsters and other players. \nLoot Hoins from air drops or other players. \n\nFind a key and exit the maze to earn rewards. This maze out is chaotic with your friends. ", "short_description": "Hammer Heads is a FUN & CRAZY multiplayer game. \nRace, Escape, Defend, Battle Royale, Co-Op with / or against friends or random players online.\n\nWalk, Jog or Run around as a human using hand movements but NOT USING JOYSTICKS\nNEW - You move forward in direction of your body not HEAD and your head is free to look around\n\nYou got hammers in a game for more fun. \n\nIn first version you play Maze Out. You try to find key while running from monster. This maze out is chaotic with your friends. "}]}, "developer_name": null, "developer_privacy_policy_
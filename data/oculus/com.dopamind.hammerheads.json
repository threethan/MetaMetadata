id": "448641504407146", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974919_448641507740479_4943524843252219537_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbowtAuue58Q7kNvwGPFAZ4&_nc_oc=Adr3KPWDJ1dNbRPSIRbZrYmaYmWBAyZ_L2ks7eODbafAXl_sUV_NzT2NYznky-aZrNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTI0_nHKBVkpqKAho92Ui3wV21IHLJaXHhHD9rBThSrQ&oe=69C1256A"}, {"file_name": "1.png", "id": "1094226811864451", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031528_1094226815197784_7168758711047696244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt9LXVwn9Y0Q7kNvwEJlIfK&_nc_oc=AdodIi-DpF_kYuZCwB7aDShTAxkIRY_8_nQZ-bf_0wzwOh5AB5oeBQG_ZPAo4dGZPME&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy--XcKD-_plJ6FuXTgRZilV4FRQSNRtqiLQS-0Fx-1gw&oe=69C13D8C"}, {"file_name": "5.png", "id": "962498255879242", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974811_962498262545908_3835315499838407045_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcjTpd96f_YQ7kNvwEyIygE&_nc_oc=Adqak92Op803pNgYU-ou6V3Hna7scTzQPQPutKeRU86epu7XNYWO8eSqFEWHUxUU2cc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfsD9CTluRWiKc4pS80Q6pyn0dD0Oqm-p-SDO7y5nCwA&oe=69C122C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape V2.png", "id": "743852067922482", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982668_743852071255815_8830255183742109230_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhBgwxIi7PgQ7kNvwHNz91C&_nc_oc=Ado9-gGbxMz9aUOMNJlmeW3st41-4QeUIDEKubL-7eZeeNzticyW4c2SshDw2hAFDJU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbCk1Sxhi95yeBFBGM_wOeOpFdb4GCurHPkU6HY14R8Q&oe=69C146C5"}, "display_name": "Hammer Heads", "keywords": ["yeeps", "gorilla", "rec", "room", "grab"], "long_description": "# Hammer Heads is a VR multiplayer game with multiple game modes like escape, survive, defend, race, hangout, and unique hand movement-based locomotion.\n\nYou can enjoy games like:\n\n# Sky Park \ud83c\udf88\ud83e\uddd7\u200d\u2642\ufe0f\ud83e\ude81\n\nExplore an elevated playground for climbing, flying, racing, and blaster battles, with challenging rewards to collect.\n\n{758726772714938}\n\n# Maze Out \ud83d\udc79\ud83e\udd2f\n\nNavigate a monster-filled maze, either finding keys for escape or causing mischief for others, all while hunting for loot.\n\n{452608070564989}\n\n# Flag of Honour \ud83c\udff3\ufe0f \ud83d\udca3\n\nDefend the flag from relentless bomb attacks in this intense game requiring teamwork to succeed, with competitive scoring against friends.\n\n{1106201633989177}\n\nAnd more games are coming soon!\n\n# Flex Your Looks \ud83e\udd20\u2620\ufe0f\ud83e\udd21\ud83d\ude0e\ud83c\udfa9\ud83d\udc51\n\n Plus, customize your avatar with over 70 animated cosmetics, offering 500+ combinations to showcase your style. \n\n# Join Hammer Heads community - \nhttps://discord.gg/YYba9rb9n4\n\nStay sharp, and always watch your head!\n\n", "short_description": "Hammer Heads is a VR multiplayer game with multiple game modes like escape, survive, defend, race, hangout, and unique hand movement-based locomotion.\n\nYou can enjoy games like:\n- Sky Park\n- Maze Out\n- Flag Of Honour\n\nAnd more games are coming soon! \n\nPlus, customize your avatar with over 70 animated cosmetics, offering 500+ combinations to showcase your style. Stay sharp, and always watch your he\n\nStay sharp, and always watch your head!\nDiscord -  https://discord.gg/YYba9rb9n4\n\n"}]}, "developer_name": "DopaMind Games", "developer_privacy_policy_url": "https://dopamindgames.com/index.php/privacy-policy-hammer-heads/", "developer_terms_of_service_url": null, "publisher_name": "DopaMind Games", "support_website_url": null, "website_url": "https://dopamindgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"
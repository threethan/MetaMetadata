"screenshots": [{"file_name": "baileyimage1.png", "id": "2258343744943560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_2258343751610226_8921886141083627487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImLh44cjJvYQ7kNvwF_PvwX&_nc_oc=Adp73Whm0oe8n-_zpl8rOiBrptG1elAyLP81VyRePEfe1Us4wUN53HoCSeDLuzFdRJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDi9K4btb3IJ7weG3-idhWB12GhmYJgAma-eQr7BSrpw&oe=6AEB44D4"}, {"file_name": "Screensot2.png", "id": "2255931134900640", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825462_2255931138233973_8892913214414495372_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsihMTpUz2wQ7kNvwHx2lh8&_nc_oc=AdoI3M4itl-Vz-eReuM3RROYEMJFzMTgKy8NFgx97lrk67LFHHbdotcI2RJZu_feKa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpIKCT-gG02v-0JCd0yYOBFqzKV2JoKmrI5xBqmzAtSg&oe=6AEB2EC5"}, {"file_name": "Screensot1.png", "id": "1251593120190773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_1251593126857439_7048372838854347628_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hNQt1dV1-kQ7kNvwGw52Zu&_nc_oc=AdqRePQzAxYKBc8WmQmGh6S4J5uep6ht3CoqHZKfwB43AgX-K5iJirfuN3K9zHOGqEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQunIsx0TWLYgQlCtZZnaSpKmQ8Qwbv4LVi1vLTxlzmmA&oe=6AEB5A70"}, {"file_name": "Screensot3.png", "id": "4592035391023940", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_4592035394357273_4299079097772844752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUIqHwWIbtUQ7kNvwHqM3p5&_nc_oc=AdrcdXzz2tfUPTovlAFGIiBtvNkfbYduTrgNlWmt7EQN5HFOLxCekDDPX4DUXPc7bvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB_F9lxygg8TXPjoZJA1QkMdPRbtD5NO5dHFKEI5o-gw&oe=6AEB4C7E"}, {"file_name": "Screenshot6.png", "id": "1396393495894486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1396393499227819_1237731154210316775_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF798-ilMwcQ7kNvwG4IwSj&_nc_oc=Adq6xMzUN5zfvjmvPNXyo_2s-jzsg9Eu3KWBg1IDzJFfo7B-iFXY9iXxJ1jpGUDPFRE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgw6PkQEXVHGo5-LknGHlolhgxbit4pSmB0-m3Rs4L_A&oe=6AEB38DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bailey VR Blackjack Casino Poster (1).png", "id": "1694133122275209", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312231_1694133125608542_4670387824514493892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-UwaEk8sqoQ7kNvwGjMY3-&_nc_oc=AdoGorKZGYwzWjfU2-WYgNEwoj5ws5kl_gSNzChM14WpRk8okCEC5FqX-9TUN5-_glE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-eM4hvahECZYODV3vCU5mHhNWgBBO8FwUmogAqLTHLA&oe=6AEB32A1"}, "display_name": "Blackjack Bailey: VR Blackjack Dealer", "keywords": ["blackjack", "vrblackjack", "vrcasino", "casinogames", "virtualdealer"], "long_description": "MEET BAILEY. YOUR NEXT BLACKJACK CHALLENGE.\n\nStep into a stunning VR casino and take your seat across from Bailey, a sharp, confident and unpredictable dealer.\n\nMEET YOUR DEALER\nBailey reacts to the way you play. Celebrate a big win, make a risky move or lose a hand, and she will have something to say. Her expressions, personality and commentary make every game feel different.\n\nPLAY YOUR CARDS\nEnjoy classic Blackjack with smooth VR controls. Hit, stand, double down and split as you test your strategy against the house.\n\nREACH THE TOP\nClimb the global leaderboard, compete with players worldwide and prove you have what it takes.\n\nCan you beat Bailey?\n\nBlackjack Rules\n\u2022 2 decks\n\u2022 Dealer stands on soft 17\n\u2022 Blackjack pays 3:2\n\u2022 Double allowed on eligible two-card hands\n\u2022 Split identical ranks only\n\u2022 No resplitting\n\u2022 Split Aces receive one card each\n\u2022 Insurance pays 2:1\n\u2022 No surrender or even money\n\nLeaderboard\n\u2022 Rankings are based on winning payouts from the last 30 days\n\u2022 Rookie: 1\u2013100 hands\n\u2022 Pro: 101\u20131,000 hands\n\u2022 High Roller: 1,001+ hands\n\u2022 Split hands count separately\n\u2022 Top 5 players are shown in each tier\n\u2022 Tied winnings share the same rank\nFull game rules: https://www.blackjackbaileyvr.com/\n\n", "short_description": "Play VR Blackjack with Bailey, the interactive virtual dealer who reacts to every move. Experience classic Blackjack in an immersive VR casino, test your strategy, beat the house and climb the global leaderboard. Easy to learn, exciting to master, and built for Meta Quest. Can you become the ultimate Blackjack player?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.hologramsoft.com/Privacy", "developer_terms_of_service_url": null, "publisher_name": "Hologram Software LTD", "support_website_url": null, "website_url": "https://www.blackjackbaileyvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28453374311028253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820441_815539930825399_7958092446058206732_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jek3tFlPzdgQ7kNvwEV-pr5&_nc_oc=Adqyg-7vwngG83ACJOpIcEsiGLTrsoUN3Ik7QCck2d67OE9hOPankvTlAJjzEEbXBN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiKSNcA7Zkma_fZFrUgaBK7tG4FG8nrMndjrdqFKt3vA&oe=6AEB3F8F"}, "is_concept": false, "is_test": f
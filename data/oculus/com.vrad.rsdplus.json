-sea5-2.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_AIHYvMQmAQ7kNvwEMZLxQ&_nc_oc=Adqvvj3Y1IL1MWROfksJGpCJG0ITflrQUV476eBG2MWhZgTRKhMvtY6CikaQC-0rosg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6otnkfCedOqUQnfDkNI-OWbVAwwfkjo2aoWJKOScKEQ&oe=6AFF33F1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymh1b5j6_JIQ7kNvwFxESLI&_nc_oc=Adoe1jScAI525B5lVXfCRB2JbmpElUoVsV-VF4saElfHOTX8z3T5K7Cx0xr0Ou0kSYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVJecbDfrhHqSnni_tSVBBwXKko4CxU-RcOT7XVLlwqw&oe=6AFF316D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZTpegYGDEgQ7kNvwE77KrO&_nc_oc=AdrQf4TI_MvlVbKZZu1oG42wpHhyCcXKa9aMzdM3nKBnr3JZYlTw6E5lFUEMDUQ1vKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwghXssR6vJ9ZQGkmWw1ZYQdgIJCFDupEQ5R1q2g1O-w&oe=6AFF07BA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLTTewK9q9UQ7kNvwEYCU4b&_nc_oc=AdpuzYuzx8VpIQlPzfvoCE_4Sqo8MViCr48OunXtfydodR1b1UwH-xOIzMrm59vauD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREqIKi8Ax4fLmBXxZ9p01dW8GEBMWnl0FULdYrERE9ig&oe=6AFF26E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAM3stuA2ZgQ7kNvwEenVA3&_nc_oc=AdprfKv-9nWotuB82a_DMpXLc8k-uB5LbcuqjGKuYLoG-SB7k7yzmb_0T9TgPrLv5nk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx3_upn2-ta7W-eTEzvA5CUABTWEOfwhyId7e2jFne1w&oe=6AFF17C8"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48FbOk30piEQ7kNvwGz0yPN&_nc_oc=Adqpgbkb64uOULIfMiUUJJYKeXJMbRvp1gpW17Af_JBqFNlum_QVXwAwmBp818hp_Ok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy_NY2Rwrkm0BcGzef5Th8Gu4Pf6QzFBxxzcvjKQ8bsg&oe=6AFF1315"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
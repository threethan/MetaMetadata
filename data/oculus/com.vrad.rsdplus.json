.com&_nc_ss=8&oh=00_Afy2ylWxUhfFshOZ2Nsk6d3YGE7mCnUVPsYYU2F77h-Agw&oe=69AECD31"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBjm76PW9kUQ7kNvwH8-MqB&_nc_oc=AdlGF3puQXTUHTwTTNPeEVRG7n8EKKWfk2sWO-_DaVngg49ZDxDqBI5CigOULTTWDlE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyhi0GoLJQvGroK7EvrYM8FW57vxyNCPokCh_-1kk9AYw&oe=69AECAAD"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cOuAVfuka0Q7kNvwEUyZTZ&_nc_oc=Adma20LThxdUtgq9yz62haD4WCrdM0Gk-TvPa0O3vf8bHiUkMDY5cHJdepMgkAdp_pY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwN6Fdx3pbe8C0MV3Z3BoR8vJBbZAze7S5t03owxAKj6A&oe=69AED93A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1Nq8Dk2Pv4Q7kNvwG3qx6-&_nc_oc=AdkzEsOLv6ymMKfHaI7ChWyte6XfBvb--6IAdlMtIwbbifSdil1QaF-ezJ7bFwWLfB4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZnm8ZX6k95iXNLyqP0zr68Xz-xFqO0jqwpTOvfE-Qvw&oe=69AEC021"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
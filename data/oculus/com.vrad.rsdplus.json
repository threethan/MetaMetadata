.com&_nc_ss=8&oh=00_AfyJsvgjUYB23rvMoqPETvfdgg1-F5-LuG27O-SK2Jdriw&oe=69BE9F31"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa8C2SFFw58Q7kNvwEfGJAn&_nc_oc=Adn8KqFKUPavuakTUmewusmm6gYfAYmH6SfsmpeHuEMxMbJgBJ_brqaUpF_49yFT9J8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8t6YXvUZ9k4CDWc_V_GoqExN8bcDQnnGoOr6V6pDVJQ&oe=69BE9CAD"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_d61-me57cQ7kNvwGgp2JY&_nc_oc=AdmpDvc9LXzaF7B_EBE_NTnuFSXI85F2zLNzjw78wVy78ey49IGP7eulp24kXwbURW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVHdGYzHraiRiiscRl8OxFyh40saUQG5_24nc-EHBKWw&oe=69BEAB3A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7KmPJPZIikQ7kNvwEyN1n4&_nc_oc=Adl9pP2bWArEsfwW42P3NZIBIknz-fJWKIFuH50nY-3z1UyVRheS7OBWNvlF8HUA7Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMk9BBJMS_yC4YDDn61iXWHtcSow3WRXUL7fzabOKwTQ&oe=69BE9221"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
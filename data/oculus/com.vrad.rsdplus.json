-iad6-1.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQ4mWBIoWnUQ7kNvwESD_bc&_nc_oc=AdpZybwVEOs_LSAhCrdRtfsva0TX7H8Fm4E8OrObMceO8Tzqwg2cfjPb4TUxMEQUU9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUx6MYfiwL6yyWQDQBPDpHOjBlwNyb-p6fXTjfUI6-hFg&oe=6B0F05F1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofyMWqfkGzsQ7kNvwGoXHRh&_nc_oc=AdqLeJ9UDwZh3DOxe_-Mx31c-6dPEOPdxkMA2XRJ8TnJtYGhaRVFJFpfJ4bHuzj2ysc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxU7reWdFesqd6BkX9J34K9sXZtk55GbupGkiRAA_BuA&oe=6B0F036D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-18-j100PgAQ7kNvwFy7GsE&_nc_oc=AdpttCsqq96owkUlZFPUCgtp0AI6irYiBfQwo1i9kx7mQMHidwmXChDA34Co4-d_CLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUJFG-mQWfFUKiXH6ae9PNQ8SDtEGeMboMRidNte40G3w&oe=6B0F11FA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMhTr7O2MOkQ7kNvwHZHsyT&_nc_oc=AdpqYQoBDqngCt2C2YnZVD61asikWHZPGkp8-YpPMo74zODeLcPMniBiucBz6rpRDXo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXPI7efeLckX2FcJq1npZqf9as7FwnyipVaKU5iPg4Umw&oe=6B0EF8E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h6elN7Fv3oQ7kNvwEpkpES&_nc_oc=Ado9nZ5HQBt0HsbAWp1MYxErJE0f5GdPRDPpjZOCHuoK7Vf9EhdLSL71PSkyV8yMt2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8SE8rrDVG-HAIsJ6imOuJy655RJRAffRuicgpMXoaFw&oe=6B0F2208"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbsXk8ATd_8Q7kNvwFstq6S&_nc_oc=AdochDK5D2uGq62jX6qa_um20oyRixU4DyBjBugiKVlnfAdXgh4QZtu6MUeKRH7ICcY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8SpWu2RnWj9Kg1uRWPCIcpM1DgVfkKIBSnwxtStBcgQ&oe=6B0F1D55"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
-sea5-2.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-cZt4Ovyo0Q7kNvwHcw-yG&_nc_oc=AdpEkEztbcKDGgY5cC-Xru4SKT2AkPiizAVRznbQcuL-eQ1NGq8uDEop887t-d7J0vs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN5SdPxExYxHDLBtnjEgIvFisghbf65UWQQO0hj64azQ&oe=6AFC90F1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymh1b5j6_JIQ7kNvwE8lNvO&_nc_oc=AdqByEDtvwHz2Y7GoLCTu7SHQMuP6olYpIBtoLFoCiER9Xf9LEyfSS46rZIw_c6YevY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7rAazUsV4b-wg8AP5scleJZmz7npJNxoPJxvOeANnWA&oe=6AFC8E6D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZTpegYGDEgQ7kNvwESCSxz&_nc_oc=AdqSBRJ570X_bErBHVdAYrP8ObESuERgPmoUcvL1fh761xjmx9V7xGo_s4nnznb_xPs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCJGLc-43Ysj_EQjhjEWsZFVFnDfI0GQjXyjwbBoi_DQ&oe=6AFC64BA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZfSbq2ufzUQ7kNvwHrhXgJ&_nc_oc=AdrX5T7uLj5gLzk7T9VRPf8I62JpjYIIgRxL1a1QVvViozRFNLWufUTqKSDQE6yyvoM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSunMYc-VtyouMtuQLiHxxsbHzVAodZvWC3V6yzrQW_A&oe=6AFC83E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_oFsaYUy4EQ7kNvwHCm_rn&_nc_oc=AdpWiHVSZ8wzlPvIChUJlSnRzR2n4Nc4lxB7vo4Txg249B9nNQ-oxW4nYrkKJW1m7Lg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYHsNyXFJnTShWbMUTB61J78BJS17eZ3Uoz3bfnqQoCA&oe=6AFC74C8"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxqH3oLLgcAQ7kNvwFdZ9D7&_nc_oc=AdpsmH_qrUUuFFEYpmd-ybLEabc9HQwCtVtcotEa5HlfTWpX11FgHijtnNMDCk59qU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwpuFZixr14UOnh1nyik5GYS98Rg2r9QnIIjv0bOHu4A&oe=6AFC7015"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
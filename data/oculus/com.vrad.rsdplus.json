.com&_nc_ss=8&oh=00_AfztCB6eCQEoo9ynnpe1qFxmBY0uP_1GER0_XHtBEhlD8Q&oe=69B41331"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHLRt_58w_wQ7kNvwF7WQEG&_nc_oc=AdkRCe_SpQoEaeHb1pCTplpNGjRH-OKOcgoehuFFA4VzKxAjpO2Zje36rC6CDUCCf18&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afym-kDiLpweHQDNr8_cVwPDJaVZmz_5kUuV4VyPsl0onw&oe=69B410AD"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKyeb6r3x5MQ7kNvwE_Ihdd&_nc_oc=AdnWCh0EL06M3zITGrwCt4iCJjHFhOPdiTnzEzSz5IksGlmJs4KZwQW_-NxuBcfNXKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRV2cOrYAZqp-VvTDSFivSlLFFXARRPxi9Axq3872WbA&oe=69B41F3A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK-wjrEfGpcQ7kNvwGQEzSw&_nc_oc=AdloPIfDrCArjTX-bu80NT7Y8K0yJbizgmlIpA7liRX5HtGRpTdq8mTXD4TfvM3JAmE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyl2f3CIWSFx8qTMa3fqWI1hh-KkpIHMKClYKiBv2x-rg&oe=69B40621"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
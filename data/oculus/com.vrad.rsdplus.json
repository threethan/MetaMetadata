.com&_nc_ss=8&oh=00_AfxfVUAwuFMzNgpdgrONzyPF07jwt3u3O_LjL_1Anat6nA&oe=69AD7BB1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBjm76PW9kUQ7kNvwHkr1IW&_nc_oc=AdlycYhb7yT9EoWVD9uGwuoQ4_UNuV6lUXEk_lZ4RewUUdL_2Kd1eXRpqUIbJUPvNeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRT_GNtx6aEi7LllNwaoZscT90vTVSLDPiMFccwaiPHA&oe=69AD792D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cOuAVfuka0Q7kNvwFcINsN&_nc_oc=AdlFOKqpGhhzIuFDh1GQFURaTlVxCIICTsKlQ-p5c25smcAfxZEHdvHshu0APRQzhOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJUXELNzfGhvgI7cRoDNp3wbhq42gyqb-OWOHl3fqtgg&oe=69AD87BA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVKXtA0NYbIQ7kNvwHEkfEx&_nc_oc=AdmZR340Bg7fBkWtL-hGm4iesRK12NpmQgOIYy9iY63KiPbIYM1X5VMKUdmcwqUwUeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4iWZW89cJNNm7zQ0Im5Gt-uDvNiBfwlN5Be7i-_T5Rg&oe=69AD6EA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
-iad6-1.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_AIHYvMQmAQ7kNvwEEErCi&_nc_oc=AdqHGGiQm9l-HFr_NQE-ydZZe9WKWT7spO7Eoh-bnhIr9JktyRshfJel-g8cmOrst0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw2D5VB5hXYVo_p7psVa4enxnBsGboP-9gQQS3Q971ug&oe=6B01D6F1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DHl1ZQhFVcQ7kNvwEt5_v_&_nc_oc=AdoF0l4iwY-BlrD5xto8OmBSUcZLxIwVpdsoDSTob-1ep0Nr4SFIRXrtrD4bglV-LjM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBr-xFPNS1ZbdrIvkTaKFR3UUZ9TAmf2qkk0GwylhVEA&oe=6B01D46D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lcOo3oZWgUQ7kNvwHhA81w&_nc_oc=AdqPagKhxGy8cP79Sn3E2q7HcD-VtJrLF9zjWuIZAQhQYpMDnDC_TAMipmj5pOskHIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8WC32Ei1tykg_7z2uzpB-2XArYelJvB3MGFmc_Ry4Gw&oe=6B01E2FA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLTTewK9q9UQ7kNvwEWbAxv&_nc_oc=AdoKucy-4V7IleUQ2chgGa2RJcslQA2xoxbzYXPPmB0BTWziwPybh1kkoZ8qvuEmA9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgwb66CGzA-TlOSArswJOaz4MfFrDAiNgbyBH4CjLJ6Q&oe=6B01C9E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAM3stuA2ZgQ7kNvwFoCr3O&_nc_oc=Adovv_tP698F8dC7rvNKHSNmAmxl2HWLBlQ4xDk-JLXPb7g9YFEui88u1EXt8BPN554&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTN40i2SX8-BRysOcwxTVNXGpjcJX1RylUia6-rPikTQ&oe=6B01BAC8"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yW8FFaTylRIQ7kNvwFVQs1x&_nc_oc=AdoMdn8_AEPXkZ8GcAO1mgtODLNrAx1MplmUfj2UxSK3R-9yHTI5cdsh6yXYH6tSA5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStf-WFMEX-HLIpJb3EQmgzTDfX55Zi4rUQZKUyffbf4g&oe=6B01EE55"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
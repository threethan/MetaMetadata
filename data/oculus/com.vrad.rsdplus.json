-sea5-2.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BD2rwv8vXYkQ7kNvwFQe_Am&_nc_oc=Adr83weCLB8gh-ex0_GPQaYALLad1KvmvRgo3qYtRxaXElNu9oiA_eBNL96y6ponpPc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4zHv5N2hhXYtk3Bbx-gz_IDPM0rvlLYADeYUUo8_AoA&oe=6B09BFF1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbrSLg2WTbIQ7kNvwELjNdJ&_nc_oc=AdpjkeCiDa0T0xohRUwLmDDh0OTCCsngZR11730woKceRDeDASNvM0XpQki8upjGaL4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJns4EdaeecCdd7COlPndoaPRmF8010koqaShrfI1sbg&oe=6B09BD6D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbNPg90L-VQQ7kNvwEWghvz&_nc_oc=AdrcrobUWrXPRLTwG-eqzjK3aV-yRGt0SburrhPncarz8uPeW3gu2zLPOH-C6SX_6JI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD6JwsJROvulS1ShsY-P9ZXIfy4QYclRHczIJihd_D2A&oe=6B09CBFA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qomKynRaWZEQ7kNvwHrgp-q&_nc_oc=AdqS8HMJXDQ5dOIADWqPecFOapGXMmduga5JWZMAiueTww8L-4PSZR3Amg-JwYgqLpc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBxYuMc1Rg6OoUoKHLFlacaRwCcuicbN32jJvBhuIwNA&oe=6B09B2E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCrPLMLvIxgQ7kNvwGhsIKt&_nc_oc=AdoKTXtrcp5pVU04Nuce3kNeS1kCE2LccIJfAAFE17aiMmgE38H6MOJ3NqK9OGG_Zlo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxkTWs1MsEQxscGzDSjUaxVb90t4qXvUNsIqmQPelOcw&oe=6B09A3C8"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6g9GLQywlEQ7kNvwGHnuc2&_nc_oc=Adq4o6vwKgWtKJ_urwSkOH4ZhJfcCkTdYgelOJBGtp1oGIK8JeJqcu9l2BEInJmE7Ng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf1SAoUwDa6dc_6mNeBSyRtdvigTLFibcBz3DCvAF-Kw&oe=6B099F15"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
p8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0lKLcdU9Lr8DpjKRaOOTxO9pOPp2VT1n6UYGZlU-osw&oe=6AAE9031"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8Lbb8r8_P4Q7kNvwEofgED&_nc_oc=AdrO8zf1CdYEitlB42tEqHSS1yZODY9CGYGrGxkyF0dSXglOHozD9XDJACWLaPtLVms&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJE3O4mirjWVDsVJ56Z3hYxNfAaSd2JNrc8MDHhF4IrzQ&oe=6AAE8DAD"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0oeY5KHyuwQ7kNvwF7hhWp&_nc_oc=AdodzQCBzg_PchQ_zeP-DZOnWlpQOpUBH5_iHp-4Jm0pqhPGXBYOvttlWb5vs1GuxAQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtvNgxSdCGDwhgtu4dXhL3999X8JbZB7JfluExAuRo6g&oe=6AAE9C3A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTdQ7GA18VsQ7kNvwGsf29J&_nc_oc=AdoH7BYDdXUa3WXXttm25fgK9raJT-cvShoMffPbmDajl4f3plGpqT_sbVXq-Dmmt6Q&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw4nLJ84cCREoQUDDyzpineW154CVyqA9dVH4zaCfoFw&oe=6AAE8321"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_anHiv-WaAQ7kNvwF9VLvE&_nc_oc=Adryp7-kCfOJl-yhtFhz1SM8BlV0achNMPd60qTI-6x0j_RnxkbMsCn5VFBLR5V_88I&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcIAATlI3wOEfedECNa72s4wcEgHdrFjxAfZ5sDYr8wg&oe=6AAEAC48"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rre_TFaqMdMQ7kNvwEnmaIp&_nc_oc=AdqwP6ly2vIcQZ_7XJO14DopRIGM0ulDEF3e5tufYt3qhvlaDIPLwMKvrPHOiypSvRA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbn2uMehUdHO8s1uRji_7JhwLNPP4A7WNOdeM83rq4Wg&oe=6AAEA795"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psueI01cavIQ7kNvwFLBFKv&_nc_oc=Ado4PDG6QyEnPdzCrgl2zSPMJJqStX8I8kRXFBN1N2BOAA8JU3_AsyO41-AtRJJAcYg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7IMcGvM1kvkP0OmI9_0LleNnKOOB2-xnErimFRpizYQ&oe=6AAEA163"}, {"file_name": "014.RS_D+_logo.png", "id": "1029425626060606", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/
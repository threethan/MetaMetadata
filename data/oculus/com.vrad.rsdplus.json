.com&_nc_ss=8&oh=00_Afv88VObabhzCWz3DZoSpK7_4TDL0mh_zDyKKrxBFCGF_w&oe=69A835B1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qoqu66ir0UQ7kNvwFlZiYZ&_nc_oc=Adm16WN3V9zhs_tpQ4shrWWNcjhkJkC3oNExYvv0XiaXS4dark0nd0Rp1K6Vkl5VXNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afto86phQ0CJAE7Q98XzK64mVmBQP8CWDi-Yu1eLpQmnng&oe=69A8332D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNMrTRCDiTgQ7kNvwGzaRod&_nc_oc=AdmCsXVHgjBd41TyeJC_WqpmNiAqrE8e3Uri4z3AXxyg_e6AWX91YR4Tci0OG4AbYrw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsGxjNZP0zDqmLQfA2jld4HTYM-ygnebSkNWbZOUaw2Dw&oe=69A8097A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ynr6KdOu5EQ7kNvwFLN_JI&_nc_oc=AdloHNtj9IqU__Pb8a7uJ-mvUPvrpdPe6xcAMt4RiTsu3KmPRm5GHwp1am_ibAGalAs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftAeva3DvrpFfAKbUpR11RDn4j76EOdNUBPaslOEEeGFw&oe=69A828A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
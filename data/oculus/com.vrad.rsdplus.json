.com&_nc_ss=8&oh=00_Afy0KjEYhCwpn9-zrCq3UG9VsVVCOaGD9oDvJUG6asUsHA&oe=69BBFC31"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa8C2SFFw58Q7kNvwHUey5O&_nc_oc=AdnxTPAklT7JuGj7HQ8ctQ_IdbvKUR_VYU4kRomsfScCi3Lo1uKL6Ygo7DWi8-HjTMQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXFMns82KXvGYPp4u-YXCp_EYM3g745xhu7CQ3jioVdQ&oe=69BBF9AD"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_d61-me57cQ7kNvwGpO5CG&_nc_oc=Adl-QiiEcfJd0SuvWE9UAaSrYpB3DNXxpLl_SszrMuphEYttcYwRBcVmeURts2mr3Bw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSukbgkL_Ft0qsXmk-6OF67l5KdAHzaF3t28hWarOMbw&oe=69BC083A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCCzzdgrg08Q7kNvwE6w0hh&_nc_oc=AdnCKqgqTt6qCtbYQIPDSYN6JWnckE5curg4kTcz-aAQBsgpaAfhIB8FO4L88h8z1Mo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZu7mKLYDTToeY-LUjXZMe3iyJ9sueX8iCIK0pn7-xJw&oe=69BBEF21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
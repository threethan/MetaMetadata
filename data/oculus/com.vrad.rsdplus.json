.com&_nc_ss=8&oh=00_AfuoS33_L-IiV_itWXvLUBCj4Ve7ZLacbE72xj_lUodykA&oe=69A98731"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qoqu66ir0UQ7kNvwG8z9Rm&_nc_oc=AdnDCAzwhS7kzf8AM-IKg1dIVQkUL3LiJ2rOKpYGNjgCAFdm2grNUgBkwlU1EKQJuZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvhCQe55AQqiMJ1yuS1rQZZYfC2IthIYrP0ZM-yNC5x4w&oe=69A984AD"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNMrTRCDiTgQ7kNvwHX9kbp&_nc_oc=Adlef5aexwuR4n_vAr2jKd88Gm9PUflv49HVbthB-6kDbRsa7XfYj0ghAMCHDrvwyYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvd4zUw7jmSf0pVW-_UBzvNPW9iJC0afq7WGQdPVu1VIA&oe=69A9933A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ynr6KdOu5EQ7kNvwGN1-9i&_nc_oc=Adk4ophmq9zC-9Ay0g9m0enD_8a6dAY5OR3_aNnDjJRW4Kug9nVHbsHirNgujBKOWD8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfujBZEB6n42zSN_TJwew9BImt1pm95l1z23JCckm86Jcw&oe=69A97A21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
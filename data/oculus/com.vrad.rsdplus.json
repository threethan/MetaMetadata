.com&_nc_ss=8&oh=00_AfwquF1JJKmExYDyip30mBAaN3cZhVpYOWIqXi0HwqiaNQ&oe=69B2C1B1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUEtk1A-gpUQ7kNvwEAQq8v&_nc_oc=AdlshXQ_Ns0w-tcOqRGQs0vNflH4DZ3U3rtJEmdjFHY4mDdmzceLJgrsLK7JS8bcO8o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz1ZnHuB3ogSLzOSPFtTiUGpkM4YCp9H5c5xm3ABT3cIA&oe=69B2BF2D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTscTF4eymQQ7kNvwG0sU9t&_nc_oc=AdkMdU5hE3r_7uI526hlm7suozfT25n57sWfqMiYwW2X0uj91BXDlFdgO1A-LjuXMn0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXZstkXux30jH_zjRzaMgSc8ELgnkxlZaK_Duidq-cYQ&oe=69B2CDBA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK-wjrEfGpcQ7kNvwEpUsyv&_nc_oc=AdnuxhhkBg5ldI3U-tNK8eRrSgiNERhmDHvk4Qv71ADhEb5pFsihGty7MEyz9u2SRgk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzOcvBwCJfLynAQrgDb2ZlCCENpYNKo5kiLVbaXwkmoIQ&oe=69B2B4A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
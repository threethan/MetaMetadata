-atl3-1.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e54EeRRebz4Q7kNvwE2kyEz&_nc_oc=AdqD-sBrYGru_DNE_3w4vc7U1xOzeuv1spna8s4dqADztRVeDxqCEaVj5lPCvYr_lx4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTwWNycjRuU3sXOXa50o4TRBBCqiE1fUkMA-9RGNfI10w&oe=6B0B1171"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbrSLg2WTbIQ7kNvwF34uQP&_nc_oc=AdqZvu4X_HiyfCAmXpftosnhRk7jb5ps7ZWhHQmlmSdUVq3UYj-UW7-LW6nCzigC79U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSN0quDMFnTYo_vhbaOUHQjUgH5TCHlaZrkCZBgTepakQ&oe=6B0B0EED"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbNPg90L-VQQ7kNvwHKwrMP&_nc_oc=AdpRDnGYpVF6Z2dXzSwDIUPa6qDPxQEK534ZNX0VM4G9ZIzqWBLVxbOgS1qdk7poh3w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSQgZG0AKI85ahPcJNcwWphsh56-lpVZSkY5tDrdbIiOg&oe=6B0B1D7A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDjU2yCtuHgQ7kNvwHUcBkg&_nc_oc=Adp-bzX3rOi3p8E2ymzt1CiJV_vY7wF6ay5SNG7P62DmF2IiFF2njAgEgRnjdM62dXs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBeuMbskBmsznTG7cLAK_a650MA2Pr0lKzyePEOSqz_Q&oe=6B0B3CA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi5Ag2VnDbwQ7kNvwEl1014&_nc_oc=AdoUDEtvRvvq4X6yTaknJSK6p-386a8hrfXssn6s0bBq0FIdgFV6TS-3GduejjRibVY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQjJewTqV61ReIBBrOvLOv2mJFZDSTAOVBMH72U1heGw&oe=6B0B2D88"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6g9GLQywlEQ7kNvwGorq3B&_nc_oc=Adpu18YhDjW_bPuFo0xuwkmXsYUuUPCAEUUqKYySSbm3ivk5XOZZC5prbj-B9g6Hn94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTRYjuKzSxJWvzD08iO_u-zaOFXHY01bNbO0xWVP17mUA&oe=6B0B28D5"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
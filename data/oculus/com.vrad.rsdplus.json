.com&_nc_ss=8&oh=00_Afwk6EBUAwDy1spllEx1tuIZYWYnsENu5wB2vlJbCmxq_Q&oe=69BD4DB1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xa8C2SFFw58Q7kNvwFsq4gy&_nc_oc=Adm8_WLs8bwGXCteljYqYYF0az0_CPWG8Yd_NsA3OqtRToOMh96b-m9vhJl4O6gX18k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8Uesz_3Y4sR0yaAq2uHcwCoPLt1dWEcslZthFU30inQ&oe=69BD4B2D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_d61-me57cQ7kNvwHa4IkB&_nc_oc=AdngYmQP4D2faBXc0uIbiaJSv4wTxIoehe9UKT7hoV802nSANvB_Ub3Wo17xOKrbRM0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHfsLzgeZoFGN3qv4XFRn6ylfQhE24xVcVJt8MNMAXHA&oe=69BD59BA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCCzzdgrg08Q7kNvwH7nClA&_nc_oc=AdlS1nKIZjG_N0r5kmhQ3CMLtyjQDpDs2W-gLAqK0muvBGUfH3wXjbywUySEvni79Bw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqociIC7Vlb4dsg6u9rRZSoFwk0YwKxjckoNs59P7qMA&oe=69BD40A1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
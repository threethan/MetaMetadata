-iad6-1.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQ4mWBIoWnUQ7kNvwHPO_EI&_nc_oc=AdrAqEFmJaMHbpSRFA6FFypJLdyeIysCSFHEMGYJT4uB2T_tBxRUsef2jkf5ds1Zt8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUppcGPUXKeYA8fpxYnL2V30vwWE22k-GlXkkiuj_FuSg&oe=6B105771"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVbt-xrxiw4Q7kNvwErXs4a&_nc_oc=AdoNvz0a2YhYPLeJPFDWBx4sUw0-2daq2Vfi2nlD1EoaQitDKil3T723oF5esxJIYkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUndD7mf5py5uyJw2vfdKeeytcKJo8gD2zGlXqTSNchNw&oe=6B1054ED"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgQxEdFGFWYQ7kNvwH4QSzU&_nc_oc=AdoHuzccj6aTpRz4wAM0TyGUKhYEj0Yrt-WgAII8KueLlddupPoTy53OB-wTRExIUEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIRTpdk1z7bpPvGBl_WlBZOe0k2j4GqWG1e-Od3pXSgA&oe=6B10637A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMhTr7O2MOkQ7kNvwFqBieh&_nc_oc=Ado-ZWLz2oxapxFdhgfL0SENmo9S3GyQHzkIuCHGHjKpRdK0t6pfEGc6bCDiSx9BEy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXpB8xkUCv-xVIn3OViGtNkKZqh8AcYt3_7dZ0ARo_xg&oe=6B104A61"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h6elN7Fv3oQ7kNvwESn5zY&_nc_oc=AdpKLLXo91iItqrOnNqLz3CQy08EH5M8y4grYIUcrK12r5Rn91k2KOpI-LS-oULsP0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVs5DfeKctk2344WGW6fdsM00eL_1fskcCebKqQHuk9JQ&oe=6B103B48"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbsXk8ATd_8Q7kNvwFXUsY_&_nc_oc=AdoKiI4nN7EBmgBSLjUqHPTRozf2HnaRRvNyvpM_Pr6wGXegK5PJVvW-Cxevg_0LEXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0Ue6grWqOR3_t1e4rFNPtFTJVui0BVX33yYfO-gHNfg&oe=6B103695"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
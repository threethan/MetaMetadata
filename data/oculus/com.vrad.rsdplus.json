Ws&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9iYbeqG99B0yCdSoP3kt7A8ZBAweg7uNkC48nuPvilg&oe=6A7DC8B1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-js3duWKz4Q7kNvwFK5QaD&_nc_oc=AdraaKdhKb3gKPHjOIMD9I21Dwerjx3VNmsTLA49Q9N4VvJam_3nggq_qotxI-1N5ag&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmoh_XWZxXAEALw38fGHWt_an5s_08Sj8ROxrz83kagA&oe=6A7DC62D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cg9R1EU2kYQ7kNvwGldg9M&_nc_oc=AdrRQwv6JelxcZSXCpJqkN5U9tOhsLGASgq9iBFyfwypiDHqSY1L_J4RlEZJSvDMiFM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGA8D7g2cX0Wy069Ox0wNpritKxe9xGot3lSe7fEcT2kg&oe=6A7D9C7A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzCIaNf4ECoQ7kNvwHlzW-s&_nc_oc=AdpGwI-MQy-25KrGoecAqwkxyQm6Ptns_Eto5GIuI0Cs6GQ6B6lLbW8LtFas7Fl8TkI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrkL8sF9edhkOdyLpCJGn7vvM000T9zsZpO1bUlhJyRQ&oe=6A7DBBA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cngroeZM-C0Q7kNvwEkzE9n&_nc_oc=Adpf8iRrWlZXDwRbBSrH-ELtAQvo0Je9PmBHR91IDMwcd_WcnIVbkLa4v62A9J5AXUo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEUGBscheoKeadIi3OnEosEHSARxHy1P2xVQT8o73shw&oe=6A7DAC88"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EATMispvORQQ7kNvwHNz504&_nc_oc=AdrQSRgGlUhiuCykGZFPDWTP8VWL-WmLf6MwvEVtY2PhPFZfr8yOknu-RWMoMHJg7xY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq5N67m2w2s2AI12U71GBMpytvuPQ1ciBBAetDfbb2ug&oe=6A7DA7D5"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5lfYFnmub4Q7kNvwEC3wIu&_nc_oc=Adp_oRNYIQ9u9VefWL3z_I-spMnQAsrYR5pE18RMlcXZZoY78DvtD7qgjisDDWdCnqI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMwRkRTn5cLuzOWeHuPNHlQlrknofjGl2Qj47X4C4d3w&oe=6A7DA1A3"}, {"file_name": "014.RS_D+_logo.png", "id": "1029425626060606", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/
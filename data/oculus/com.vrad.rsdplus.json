.com&_nc_ss=8&oh=00_AfwjoyUWHMm9Tl7o6I50NBMxdZ_utIp6y-NAyH8d66LhqA&oe=69BAAAB1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubx8IxjjC9wQ7kNvwFKiauq&_nc_oc=Adlxsg7tTcAf1ZjeNe1JAoUKzM3dGHayE3nCOVosyo8E6MhsdGsg9q8k45St6hmh4N0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyfKySy_Ax1FKdGZIES0yG0e_OGtFfO77T27dW61-Pfew&oe=69BAA82D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6LYCPpsnTIQ7kNvwGilbq6&_nc_oc=Adnm1cvoqp287d1dQxEDBqO7JKhA6fZE4ZSh1cO8WNEsutmKKWmLFeq1bNXA_yMKmKw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCO6jz96we_I8eSYfJqrmyHv9J0Y7vKSw8gt0mSeyz3w&oe=69BAB6BA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCCzzdgrg08Q7kNvwFGPtfv&_nc_oc=AdmhT6oziEBaTpJoJ_pASU706EC9F3NIilca3K0iPc5FbM0OJ3xjkX5ENXlMF6MaL5s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzF9okMC-iNKIqtaA30OtwVFa-APe3m4JpG1KXsr8Mr2A&oe=69BA9DA1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam im
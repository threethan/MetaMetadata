-ord5-2.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e54EeRRebz4Q7kNvwEIvwrk&_nc_oc=AdoTWNGlHBjNQx7Wx2qiMTq4F2Z8F4HLAMNOtguOea2eG6GnoWYJilJAmbpbijDhkAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHGsEfGa5Nrjq1Liu2X3VOEnQb59wxINI3BezEJVOeuQ&oe=6B0DB471"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofyMWqfkGzsQ7kNvwEO3xSS&_nc_oc=Adp3dKEqFeR4G9CdU5vzU2qO58wsAj6bYxKo7CPFjzPAMgpJa48XK_VavFFbuSOH87g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWogKiuaKJSoYOP_rEYfa-vh6gxW6nU2ZiHY5VbQDzow&oe=6B0DB1ED"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-18-j100PgAQ7kNvwHS43iD&_nc_oc=AdpbSZFPY5A7c4KNVbjIqo1h5pGwwVC97EYCAcpPbJjZqF1H3VoCYOZjGuAqYO82J6g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQMECjpfMz_Dyk6YzgHJ0-IrtpwAunMsZ3MogVMNb2qcw&oe=6B0DC07A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDjU2yCtuHgQ7kNvwE0LYwH&_nc_oc=AdohXciqLoGMS9CNz12Uk4mklvMfWnTorFJW2KIJwTawQmykgvvPtn9ZK3T5kr1lXwk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPVyL_FGUl20sozK2Xf8pi92YmCDZhL01y8G68iGrjww&oe=6B0DA761"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xi5Ag2VnDbwQ7kNvwEZY8bI&_nc_oc=AdpAS1l8oz0IMUqFMZiNcrFjNQN-6C--nmVHYBz_2O1fugEm_2p4p00CCYq1cQTBoMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5a3mOmuJGpJ5cFixdjUfqyb-pQZEFc6C_YAW78EK5OA&oe=6B0DD088"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbsXk8ATd_8Q7kNvwEsClwe&_nc_oc=Adrl62yIfp9sBd0mMO2RKpag25D4PLpEDfA7gRI9TwgndPLmcweD-SfGnritc-5dSts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQJbF5I5VbWLwgB6P5zrH0iGA7hjlz5ybNODEHn4fhImQ&oe=6B0DCBD5"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
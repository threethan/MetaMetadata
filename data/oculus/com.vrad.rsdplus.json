-iad6-1.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StPNQHx4OIMQ7kNvwG-D_Uj&_nc_oc=Adq1T4HCgwRKdy8yzm7tATHdlw_Z0iiJwgwNiC-BhGYpUhWUNK_O1mfqatZR662gzoU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThGr22e67-dy_peq2KxdNFcWxzUw_07UaRO1ndt-f9_w&oe=6B0479F1"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF_fMSHDTGcQ7kNvwGBt-DH&_nc_oc=Adr8WGQnP12cDOavU7Xckd4nesuT1qJ8aeRz4xXKgz5-4OMLkTjn6pQiBUh-SFujj2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4KteD7qkTN5158ZzRwuhJqGuJdmHs6WmvXv33JjHBXA&oe=6B04776D"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FNnJDXpi9wQ7kNvwExqSds&_nc_oc=AdpHhEbI2JewLkTSiZRXBiplbqwOKHMxIp5-QB0zeIJQc8Jua4GxzAjqBLq6dBivsog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9CXZFzjCeMnxYxHGN6-eCh9n9xHD1lS27nNNvP6aeEQ&oe=6B0485FA"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIUD6mY4lScQ7kNvwHYO_XW&_nc_oc=AdremXWOJ3VElrfGQtqAsPrOYYQiYqHQMkBv7h_-Qlr8TnwarGn1Z1qCnWw7b3fZ6yU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIXXMg53DPdLHfXxa8najlWzMOxSqRUeY3YW3mZvnDbA&oe=6B046CE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr6FmuMAzYIQ7kNvwFRiCnq&_nc_oc=AdoBEtzZUBdSIkXEdRVOx9bvFOieL4vCXbJUKGXVwCWxjGvhxjPi-kQPGZeoRqr8s9M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU11aUPaNNJTP0DWna6XP_c5-Duh9YKplYfBjnQJe3ZA&oe=6B045DC8"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yW8FFaTylRIQ7kNvwH-dvoc&_nc_oc=Adr9YmXGnz-MeqHAZ4eFPyHddCKO6tZ7od4mZNRipDUZzwjry-lEPBWpmAS63QK6mUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmxPOtdu26POX3YbLUytN_bONuOMtb5jsqwj5eBdEU_g&oe=6B045915"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
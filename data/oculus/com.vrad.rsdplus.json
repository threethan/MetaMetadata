r0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWU_3Z_AV3T9OAKsP4wse0HhA9DRe5ht7Wur1mdakWkg&oe=6AA94A31"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVvukT5pYjwQ7kNvwEu1a7S&_nc_oc=Adoz7NVGw3E2eViFkjPgkia5_QM1C1QK-aMwhUUvvxM6D5pMs7Pn4jvNZZmD48co1CE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOmIWSiYRCjyiGAQeVrUe15WJdAS8Tnkf4yg-DWPbQQQ&oe=6AA947AD"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlOTJIig5D8Q7kNvwFtfABE&_nc_oc=Ado86rkQW-lNdlgad8tUrP0aM2dr5pmROYNJGCGWPJuhrfSVBWBau1OqtPQQocDSoZk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwez63PBE4nCC_uGp-B0DXDxoSQbCmlqlIXInjWLrbVw&oe=6AA9563A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkEdx_aGTLoQ7kNvwGPdUQa&_nc_oc=Adqiy-rZG-7F3rmKMYUQO-jTnYKJao0JFWOksRuFMY2NeW_r_9ZzIsOUqr8ZYbrWxZA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqAIN_kCLBatylMpz-0OBXG9cUWkTFvYAYdA8sySVgjA&oe=6AA93D21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9jlsOJmhsgQ7kNvwG5geWx&_nc_oc=AdpbrSRj-vMGzLblbi47DbhdJu5Q2MfZwbHicoEe1MJUFgvw8aCfyXtV_7UjCQRvHB4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjD6JuaGT7zJDc6ztVtBkkIA0ypNB6E1zXXf_c_P-ftA&oe=6AA96648"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLTN8sY11GYQ7kNvwGMMFJt&_nc_oc=Adr3EcL1c9J80KHPJj9fBVy2vlpjrQUhMAzPH6lrI02fhBVuuzPSTCLaNNTAVwTNtGw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJGLgX74tbaUI8SQ71J-j4e06-mIFWejbLnUubwnFOrQ&oe=6AA96195"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrtMaYaxSZcQ7kNvwFtH_IL&_nc_oc=Adoq4e-eAJlsTm7EMr2X5c0T-swGaTdSGZ6qYfiW0YZgb4Ya8gtqr26lkHSGZDusXTc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8KNG2KW1UcBHkG3SKLnikG1_3nGU3DVGZI166OJRkxg&oe=6AA95B63"}, {"file_name": "014.RS_D+_logo.png", "id": "1029425626060606", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/
-ord5-2.oculuscdn.com/v/t64.5771-25/499307954_704920882242145_5064098879567836116_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-cZt4Ovyo0Q7kNvwFmbP2O&_nc_oc=Adp7YO4bqw8xMj4SBcW3URn--BfWxQtwDkdSQkANDQEfIslynnhTKaizr3G6-bIzEX8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9t8tTY8aOi-SSbtr4c4OWt5cc0GJ9MG--e6Uu_FqWcQ&oe=6AFDE271"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymh1b5j6_JIQ7kNvwFexMML&_nc_oc=Adq5sBClbGcX1KOLGzEkGLWR9fvbfRoWk6mfJesWZSwdFk5uUohFVNDICk7Uh0fsY2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuuV84SVF6kGQYJzjtTbyUtVfThOKI-eo4a0ePOHKzUA&oe=6AFDDFED"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZTpegYGDEgQ7kNvwHzB0AD&_nc_oc=AdoXCUcNXaXLhEmytlV23lt_aSl94bOhonUzlNDC5j_5Coyryb9xGLOuTtXyxMfnAZQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxLKaPrLpGZDtGEIwEsw7JJv54H3qGFRNsYvmRr6KnNw&oe=6AFDB63A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZfSbq2ufzUQ7kNvwEuAxxD&_nc_oc=AdptJ3gW_1tWSSmNjhP79HiqFAdX8rUT4OQsEx3a81kAaCwMZhqfSmWVNu_anGtAAgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq1ao7vJrumXp97MlZNFEA6ZBoUIxY00ZVhJ6InWps_w&oe=6AFDD561"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray equipment handling, film positioning, and post-exam image review.\n\n With VRAD's patented medical image processing algorithm, X-ray images are dynamically generated based on the user's adjustments to patient posture, film placement, and camera positioning.", "short_description": "This software is an Dental diagnostic and radiography training simulator"}, {"images": {"nodes": [{"file_name": "015.RSD+_Back.png", "id": "3920518291594728", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304748_3920518294928061_5296299437423636064_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_oFsaYUy4EQ7kNvwEqnhM_&_nc_oc=AdqscSKJFOERNmAYZ7VJcCuq0dpcpTbJ8HK7FMxjD5rz7y7mtWTZ43MZGUQrhQHv2d4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1w5VRultpB5MB13RY1NC5F-dX3Mf7RUcCNIF_5d46Cg&oe=6AFDC648"}, {"file_name": "005.RS_D+_Square2.png", "id": "1261818882356764", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499295992_1261818885690097_2186594482894748290_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48FbOk30piEQ7kNvwE8ARSr&_nc_oc=AdqYGtTDV70WKw3YaxLR9Yeti5ZUitdnccPEgRPUYopUmVDiA3bcmm9IKS1pf2NgOPk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWhnme2QQDtzxgTb9My4cPjdqNqXIDKSylB89NlBrSgg&oe=6AFDC195"}, {"file_name": "006.RS_D+_Portrait2.png", "id": "1131421882131069", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1131421885464402_7822505738408755043_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
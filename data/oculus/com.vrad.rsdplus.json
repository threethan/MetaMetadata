zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLve4URPMoz7YZffAoGdTVoAcCvGRQtc9vN4TCp_pYWQ&oe=6ADE0631"}, {"file_name": "011.RS_D+_Screenshot_03.png", "id": "1062786108591961", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830890_1062786111925294_6820825958812217735_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvwkZJwp9c0Q7kNvwGuGU71&_nc_oc=AdrjRIb3lvhhkHKXKDQEYk1BRGEYDczU1aeR61utznvZz7zBHR2fQXMA7Wu4M1qGtzI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5lr3kqyy1TPprWbt8u5cvf5lf12Q8kEMULTqY_YioOQ&oe=6ADE03AD"}, {"file_name": "012.RS_D+_Screenshot_04.png", "id": "1888807391681363", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308589_1888807395014696_660138509703032651_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFzOogE6NCcQ7kNvwGvlbnR&_nc_oc=Adpk9BKlkkMa3757WUiH9vDmKOSWPyDpuTNcp0g1u8_CfL0JVqMVu22IBDxZ6WSteic&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmM0yuHuuFWduEMg6_aZr4qaKrTEA8mSHVMC6cU0HdlQ&oe=6ADE123A"}, {"file_name": "009.RS_D+_Screenshot_01.png", "id": "4068036953513638", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499292867_4068036956846971_624713770870370506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmdisFgAulgQ7kNvwFfg9bU&_nc_oc=Adowjd-Fol_fY8luOfFb__ONwjfZ90BWf-7Cgda1gK4YwM7nqk-lLOtGNFKipo5WdoU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJBa27KU-_7C6hxGkXjZfOjqeaHa09Lq7HWZf4cs0gwg&oe=6ADDF921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RS-Dental+", "keywords": [], "long_description": "Important: More content is available with institutional registration.\n\nRSD+ is a VR-based simulator for dental radiographic diagnosis and practice, providing students with a realistic environment to train in radiography procedures without exposure to radiation.\n\nThrough various scenario-based simulations, learners can train in patient interaction, chart review, clinical assessment, X-ray e
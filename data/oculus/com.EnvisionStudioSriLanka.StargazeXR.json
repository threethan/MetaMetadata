ri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823431_1436933004175877_7984214182014397677_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDYGnMZ5aZwQ7kNvwEL3O-l&_nc_oc=AdqjN5m2UczcZwfmUcaL0iRq43EI7UwmjkdS-jPSol_bOJg_8anz68_g5DY8iOY8iTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTWSxa4kgtZb2gE4UTTi69xqOCPSqAtZq5iMgvVdCClg&oe=6AEA030A"}, {"file_name": "5.png", "id": "24257790213837359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818938_24257790217170692_9087493186321319664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ddaXQw5dRoQ7kNvwFBoedM&_nc_oc=AdooDOzG4me3Km8wl7jrjaz3UUeac5nD75eakPks8NU4ctNwOQNdIy-QlUSDYVj2T7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfCztxN_hEVpcA99MpTWq3xXCvB5pI2RDdhRz9AFTCtA&oe=6AE9E5B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stargaze.png", "id": "1236237682000858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821674_1236237685334191_7630527822443766959_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmNWL9mPt8sQ7kNvwEMN9XB&_nc_oc=Adrr5oeUtZs7WekSU8Eo8-0W7AJWNE57ZnWBX6KuzPBIBULMtPBe_YOP5FDt2mzWGvw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9gp48XU_vIqAJpDmdFms8hF6oiv3QxhuaqzRlRkRnYg&oe=6AEA046E"}, "display_name": "Stargaze XR \u2013 AR Space Explorer", "keywords": ["spaceexploration", "NASA", "spacecraft", "Artemis", "spacetechnology"], "long_description": "Stargaze XR transforms your room into an interactive space exploration experience in mixed reality on Meta Quest. Place detailed 3D models in your environment and explore them up close from every angle.\n\ud83e\ude90 EXPLORE THE SOLAR SYSTEM\nDiscover a solar system overview, the Sun, and all eight planets: Mercury, Venus, Earth, Mars, Jupiter, Saturn, Uranus, and Neptune.\n\ud83d\ude80 HISTORIC SPACECRAFT & SATELLITES\nExplore Voyager 1 and 2, Cassini\u2013Huygens, the Lunar Module, New Horizons, Juno, Space Shuttle Atlantis, satellites, and the Apollo 11 Command Module.\n\ud83d\udc68\u200d\ud83d\ude80 10 ASTRONAUT PROFILES\nMeet Neil Armstrong, Yuri Gagarin, Buzz Aldrin, Valentina Tereshkova, Chris Hadfield, Mae Jemison, Sally Ride, John Glenn, Alan Shepard, and Kalpana Chawla.\n\ud83c\udf15 ARTEMIS MISSIONS\nExplore Artemis I and Artemis II through mission maps, 3D models of Orion and SLS, launch systems, and Artemis II\u2019s crew.\n\u2b50 KEY FEATURES\n\u2705 Place space models in your real environment\n\u2705 Explore spacecraft, satellites, and astronaut profiles in 3D\n\u2705 Discover Artemis I and Artemis II mission content\n\u2705 Designed for space enthusiasts and learners aged 13 and older  \nDeveloped by Envision Studio.", "short_description": "Explore the universe like never before with Stargaze XR, a mixed reality space exploration app for Meta Quest users aged 13 and older. Place photorealistic planets, iconic spacecraft, and legendary astronauts directly in your real environment. Discover all 10 planets, 10 historic spacecraft, and 7 real astronauts in stunning 3D detail, and explore the Artemis mission. Perfect for students, teachers, and space enthusiasts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionstudio.xyz/stargaze/privacy-policy-meta-xr/", "developer_terms_of_service_url": null, "publisher_name": "Envision Studio Sri Lanka", "support_website_url": null, "website_url": "https://envisionstudio.xyz/stargaze/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND
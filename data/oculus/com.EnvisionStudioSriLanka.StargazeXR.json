czcZwfmUcaL0iRq43EI7UwmjkdS-jPSol_bOJg_8anz68_g5DY8iOY8iTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTWSxa4kgtZb2gE4UTTi69xqOCPSqAtZq5iMgvVdCClg&oe=6AEA030A"}, {"file_name": "5.png", "id": "24257790213837359", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818938_24257790217170692_9087493186321319664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ddaXQw5dRoQ7kNvwFBoedM&_nc_oc=AdooDOzG4me3Km8wl7jrjaz3UUeac5nD75eakPks8NU4ctNwOQNdIy-QlUSDYVj2T7g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfCztxN_hEVpcA99MpTWq3xXCvB5pI2RDdhRz9AFTCtA&oe=6AE9E5B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stargaze XR", "keywords": ["Stargaze", "StargazeXR", "XR", "AR", "Space"], "long_description": "Your Gateway to the Stars!\n\nStargaze brings the wonders of space exploration to life with the magic of Mixed Reality (MR). Discover planets, spaceships, astronauts, and more\u2014right from your smartphone. Dive into an immersive cosmic adventure and experience the universe like never before!\n\nKey Features:\n\ud83d\ude80 10 Spacecraft Models \u2013 Explore futuristic and historical space vehicles.\n\ud83c\udf0d 10 Planet Models \u2013 Learn about the planets in our solar system.\n\ud83d\udc68\u200d\ud83d\ude80 10 Astronaut Models \u2013 See astronauts in action, floating in space.\n\nWhy Stargaze?\n\n    Interactive 3D models for an engaging experience\n    Perfect for space lovers, students, and educators\n    Fun for all ages\u2014discover, learn, and be amazed!\n\nCategories to Explore:\n\u2600\ufe0f Solar System: Explore the planets from Mercury to Neptune\n\ud83d\udef0\ufe0f Spacecrafts: View realistic models of spaceships\n\ud83d\udc68\u200d\ud83d\ude80 Astronauts: Learn about space missions and human exploration\n\nWhether you're curious about the cosmos or simply love the beauty of outer space, Stargaze offers an unforgettable journey through the universe\u2014right at your fingertips.\n\nDownload Now and Explore the Cosmos!", "short_description": "Your Gateway to the Stars."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionstudio.xyz/stargaze/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Envision Studio Sri Lanka", "support_website_url": null, "website_url": "https://envisionstudio.xyz/stargaze/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23970012779293012"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2112209462860518"}, {"status": "PUBLISHED", "id": "1770055963862400"}]}, "baseline_offer": {"id": "1770055963862400"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "2112209462860518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23961352673492356", "version": "0.1.1"}, "id": "666832079147389", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9333736950013837", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "23961352673492356"}, "release_status":
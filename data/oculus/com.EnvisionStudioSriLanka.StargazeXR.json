uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823431_1436933004175877_7984214182014397677_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTgxQuBSEz4Q7kNvwHdUJyR&_nc_oc=AdrrBxLI9dQ0-4icM1fHv0IhQXSWi8aUCyfc4RwEhoDIQfcYUzqjQrCfup8gQyBiqJM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn3doueiu5uzreoDjlvQDQF0lHFiWgq-XlQyTru6EiOA&oe=6A883BCA"}, {"file_name": "5.png", "id": "24257790213837359", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491818938_24257790217170692_9087493186321319664_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfE_VMlIowIQ7kNvwHcfmZj&_nc_oc=Adpxv0jwEXcSodjANpXIk79SXjTLtqbvwAExi3hES5ezir69v3sFZ96ubHeG3W_nKHg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9b140nzGtE8J99hGV28rF6wu_KY4mKMkiSqM1sTGG-Q&oe=6A881E78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Stargaze.png", "id": "1236237682000858", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821674_1236237685334191_7630527822443766959_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3IL5gCNzLkQ7kNvwFpkoV4&_nc_oc=AdoY2zFdqO_fXMxVhKRoLYLlkHv5KSpjOIKOWCwj4OMC6jv2J0pEqUYBuqdypeBqgd4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZfZLkQRUlBqQY8ddPzrvPp4ygTXK5pssOveaUEy4Pag&oe=6A883D2E"}, "display_name": "Stargaze XR - AR Space Explorer", "keywords": ["spaceexploration", "planets", "solarsystem", "astronomy", "education"], "long_description": "Stargaze XR transforms your room into a space exploration center through stunning mixed reality on Meta Quest.\n\nPoint your headset at any surface and watch the solar system come to life. Walk around planets, examine spacecraft up close and stand face to face with legendary astronauts - all in breathtaking 3D detail.\n\n\ud83e\ude90 10 PLANET MODELS\nMercury, Venus, Earth, Mars, Jupiter, Saturn, Uranus, Neptune, Pluto and the Sun - each in photorealistic 3D with accurate scale and surface detail.\n\n\ud83d\ude80 10 SPACECRAFT MODELS\nVoyager, Hubble Telescope, New Horizons, Cassini, Eagle Landing Module, Juno, Shuttle Atlantis, Satellite, Ground Satellite and Apollo 11 Command Module.\n\n\ud83d\udc68\u200d\ud83d\ude80 7 REAL ASTRONAUT MODELS\nNeil Armstrong, Yuri Gagarin, Buzz Aldrin, Valentina Tereshkova, Chris Hadfield, Mae Jemison and Sally Ride.\n\n\u2b50 KEY FEATURES\n\u2705 Full solar system in mixed reality\n\u2705 Iconic spacecraft from history's greatest missions\n\u2705 Real astronaut pioneers in life-size 3D\n\u2705 Perfect for home, school and science centers\n\u2705 All ages from 5 to adult\n\nDeveloped by Envision Studio - trusted by governments and global enterprises worldwide.", "short_description": "Explore the universe like never before with Stargaze XR - the ultimate mixed reality space exploration app for Meta Quest. Place photorealistic planets, iconic spacecraft and legendary astronauts directly in your real environment. Discover all 10 planets, 10 historic spacecraft and 7 real astronauts in stunning 3D detail. Perfect for space enthusiasts, students, teachers and families of all ages."}]}, "developer_name": null, "developer_privacy_policy_url": "https://envisionstudio.xyz/stargaze/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Envision Studio Sri Lanka", "support_website_url": null, "website_url": "https://envisionstudio.xyz/stargaze/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING",
tent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rIz5OaR9RiYBtrGzRqOxzON-stOwbGy_Wz6CLyLjNsg&oe=6A3E8AC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Afroroutes", "keywords": ["AFRO", "Slavery", "ritual", "ceremony", "africa"], "long_description": "AFROROUTES is an immersive VR experience retracing the three slavery legacies: the Trans-Saharian, the Trans-Atlantic, and the Trans-Pacific one. AFROROUTES transports the user on a journey from Tangier (Morocco), via Salvador, do Bahia (Brazil) to Gujarat (India), making visible a previously, invisible connection to descendants of African slavery and the cultural practice of their countries of origin.  - Where are the descendants of the millions of displaced African men and women living today? Did their original culture and language disappear? How did their heritage contribute to constructing new countries, cultures, communities? How has this memory subsisted, and how is it lived and celebrated today?\n\nAFROROUTES is designed to be a multi-sensorial experience that engages both the mind and our emotional being through sounds, music, dance, and imagery. \n\nThe user discovers their respective stories. At the center of the experience are different cultural music ceremonies originating from Africa that are still being practiced today in each of these communities. Why a ceremony? Ceremonies are the cultural core of communities, often hidden, special, and playing a major role in cultural identification. They are powerful manifestations of resilience, a glimpse at a well-conserved heritage and identity, a non-tangible form of memory that crystallizes different layers of the African diasporic journey.\n\n", "short_description": "AFROROUTES is a musical VR documentary - a journey through different Afro-communities and slave descendants around the world. A simple and intuitive designed VR experience, transporting the user to unexpected places with amazing characters and outstanding music. An immersive journey through the diverse slavery roads, documenting and exploring today's afrocultures, rites and traditions worldwide - created by  Selim Harbi and S\u00f6nke Kirchhof, produced by INVR.SPACE. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://invr.space/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "INVR.SPACE", "support_website_url": null, "website_url": "https://invr.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4775094092580276"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1611478020979431"}, {"status": "PUBLISHED", "id": "1470790818109222"}, {"status": "PUBLISHED", "id": "1602428950948771"}]}, "baseline_offer": {"id": "1602428950948771"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "1611478020979431"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23886570737644011", "version": "0.0.14"}, "id": "1661136530748473", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4201468923247485", "is_concept": false, "latest_released_bi
0_AQIFNh5mkJz4dmcdJCWEAAvwJ6BxmncUQvIY8WRqBW4uWQ&oe=6A984E4C"}, {"file_name": "4.png", "id": "1021776406880665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622211_1021776410213998_254048796833010829_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxvvTbI6U_YQ7kNvwF8ylYD&_nc_oc=AdqL6PfgR1vwlwRxdRDLhMY8bP6eGTQcluVhVy2AnM_P-DWuGausiGnyTQAhJx1Dg6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjTmCjwAQ35OMuOFttI9Ee8emqXPva5LWs66-1uJYW4g&oe=6A986891"}, {"file_name": "5.png", "id": "3660959777388924", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619704_3660959780722257_4115921756682312506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io8QyQCgH64Q7kNvwHshII-&_nc_oc=Adq0g1xZXEmrX79apV9HdDn5TI7pIKsWutBYwvk7mv7iJM1MjaLyYtBVzK2L0NOTJf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfaUUvGp2nNrC-VJwoLqWrECChdLYlieHDoLQXJcXI0g&oe=6A983CA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1745321186485976", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_1745321189819309_6001741778616098100_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2Q2GhVbEBIQ7kNvwHzH5dk&_nc_oc=AdrnLSGiu4bNfK-fb3E03ljNrTzuh4Qt5FFhxrTDTthLQnbQ47DDmlxMnW6TTIyOChw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVnnN0_n_Sd7lYYfWauYBXXTfaBpo55V3bGddj7isM1g&oe=6A98456B"}, "display_name": "FlyVRX eSports: Fighter Jet", "keywords": ["cockpit", "multiplayer", "flight", "esports", "flying"], "long_description": "# Fighter Jet Esports: Squadron Wars\n\nTake command of powerful fighter jets and enter the ultimate VR air combat arena in **Fighter Jet Esports: Squadron Wars**. Join the Squadron sand battle real players in fast-paced multiplayer dogfights where skill, teamwork, and tactical flying determine victory.\n\nMaster high-speed aerial maneuvers, evade incoming missiles, lock onto enemy aircraft, and dominate the skies in intense PvP battles. Compete in team-based squadron warfare, climb the competitive ranks, earn rewards, and prove yourself against elite fighter pilots from around the world.\n\nDesigned for virtual reality, every match delivers immersive cockpit action, thrilling missile engagements, and adrenaline-fueled aerial combat. Whether you prefer aggressive attacks, strategic teamwork, or precision flying, there is a role for every pilot on the battlefield.\n\n## Features\n\n* Online Multiplayer Air Combat\n* Competitive PvP Dogfights\n* Fighter Jets and Missile Combat\n* VR Cockpit Experience\n* Esports-Inspired Gameplay\n\n## Why You'll Love It\n\n* Battle real players in competitive online matches\n* Experience immersive VR aerial warfare\n* Coordinate with others to secure victory\n* Improve your rank and become an elite fighter pilot\n* Master advanced flying tactics and combat strategies\n\n## Take Flight\n\nThe skies are the battlefield. Join your squadron, engage the enemy, and fight for air superiority in the ultimate VR fighter jet esports experience.\n", "short_description": "Take command of advanced fighter jets and battle online pilots in intense VR squadron warfare. Engage in fast-paced multiplayer dogfights, launch missiles, perform evasive maneuvers, and dominate the skies in competitive esports battles. Join the Red or Blue Squadron, climb the ranks, earn rewards, and prove your skills in the ultimate fight for air superiority.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.skippyapps.com/meta-privacy.html", "developer_terms_of_service_url": "https://skippyapps.com/terms.html", "publisher_name": "SKIPPY APPS PTY LTD", "support_website_url": null, "website_url": "https://www.skippyapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": 
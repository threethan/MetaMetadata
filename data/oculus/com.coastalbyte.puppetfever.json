scdn.com&_nc_ss=7f20f&oh=00_Af8MCnO6lEP15l9VDd6PUXveFz-nuXDWG-APe3ARocLw1A&oe=6A451E48"}, {"file_name": "migrated_image.png", "id": "206747347226914", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031453_2182076441888432_1725992307943014400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjBuszcCWnQQ7kNvwErZPT0&_nc_oc=AdrsarHIGJ8QwN7T8HdLmzpr82ny83TMlZLkhrDbFAuSdrElVGdl3jhRJAfxEziPo9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CQEx2HONBwZEJBr0qieLeGAmx1f-fMOwkJqZHWKpJ6A&oe=6A451791"}, {"file_name": "migrated_image.png", "id": "3022575447794982", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031540_2364376483794658_7877686902445309952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwHlxLIHmCkQ7kNvwFw9I29&_nc_oc=AdrtyXGSvhCjYKm72yaEcGJmvg6ZEn4a0_JU6QcKklQYWKlII0VUyLs0O3ianI_j758&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ztAV7wOwUiASjAYCtkS-MZiritiRpdNgO9nA1A1sBoA&oe=6A451E56"}, {"file_name": "migrated_image.png", "id": "620993758738529", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031644_353500028696907_6555776314689716224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVOZgXARZXoQ7kNvwGzh437&_nc_oc=AdojJk1y5EhT1M2NP_16XoMQNbqpCjs-_H0dHJfhFKigWO0Wvl5tKCH2dUPtMWV3gK4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MafroLgGmxcwssyHNVBIGGlsDsv75_tN0F1klOmjfsw&oe=6A45389D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puppet Fever", "keywords": ["puppet", "puppetfever", "multiplayer", "party", "coop"], "long_description": "- 500+ Unique English Word Cards with acting tips \n- Hundreds of Puppets and props\n- 3 different Game modes\n- Fun and simple game play, even small kids can guess!\n- Free companion app available on Android, iOS and PC\n- Supports multiplayer for up to 4 people!\n\nYour job as the Puppet Master is simple - make the other players guess the secret Word Card and be as entertaining as possible!\n\nThis is a local multiplayer party game where you take turns acting and watching the puppet show. Connect a phone, tablet or PC using our free companion app.\n\nFind more info at puppetfever.com\n\nYou will:\n- Make up silly sound effects and voices! \n- Take giant leaps of logic!\n- Shout at your friends!\n- Get shouted at by your friends!\n- Have a lot of fun in this fun, casual, puppet party game!", "short_description": "Turn your phone into a stage, step into VR and act like a freak! Become the Puppet Master and play with your friends as they participate through the companion app!"}]}, "developer_name": "Coastalbyte Games", "developer_privacy_policy_url": "http://www.puppetfever.com/privacypolicy", "developer_terms_of_service_url": "http://www.puppetfever.com/eula", "publisher_name": "Coffeestain Publishing", "support_website_url": null, "website_url": "https://www.puppetfever.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1344937839283155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974765_416722449115208_1601116859661287424_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvyoQRQXND0Q7kNvwEFbG-0&_nc_oc=Adq_kmEHRd4tGVq4abRQGu0DXXSNFega5xnc6YoTyY3NllWNTCMXbsgqB1__B9s7Llc&_nc_zt=3&_nc_ht=scontent-sea5-1.ocul
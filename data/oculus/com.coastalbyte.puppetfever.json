-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZQy91UAyQEOqnFxCV9o4DsXlGXzGfn0jodvZnlWbtdQ&oe=6A7DCEC8"}, {"file_name": "migrated_image.png", "id": "206747347226914", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031453_2182076441888432_1725992307943014400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5tBkb5aEQUQ7kNvwFvSs1x&_nc_oc=Adp6BCHy_qi_WKgg7vR2fwlIuLNssvj5UfMtQSsLwuQW4AfWNbPyHw5EsHJmmNubhI8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFMtu6RX02Sgp43uqBEUf-EZN2iSrNOEj-d9faNjR1ng&oe=6A7DC811"}, {"file_name": "migrated_image.png", "id": "3022575447794982", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031540_2364376483794658_7877686902445309952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp5CFdbuP7QQ7kNvwHJfz0O&_nc_oc=AdoL-BwL-5UlzXhppqqCx62JL--POWsGwk5a2Vsj9bXmRFPNm8ChaQtiB2eHYnN59Ek&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy2CgGVVmI9ei4X4D_1DmdOTnnYoyrDaFNXtEYEbZv5Q&oe=6A7DCED6"}, {"file_name": "migrated_image.png", "id": "620993758738529", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031644_353500028696907_6555776314689716224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0b_eWuMaiGEQ7kNvwHS2jxw&_nc_oc=AdrL5Mm7aqO7aM3pVjTKkV7292rtBMm5LTb2exoQRCDrFITe6se5fXS5S-wKckLIQI8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGw_OSdF2bIJHGzSRodbsLv1bFn8dHJQMEXajJE9v-mpQ&oe=6A7DB0DD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puppet Fever", "keywords": ["puppet", "puppetfever", "multiplayer", "party", "coop"], "long_description": "- 500+ Unique English Word Cards with acting tips \n- Hundreds of Puppets and props\n- 3 different Game modes\n- Fun and simple game play, even small kids can guess!\n- Free companion app available on Android, iOS and PC\n- Supports multiplayer for up to 4 people!\n\nYour job as the Puppet Master is simple - make the other players guess the secret Word Card and be as entertaining as possible!\n\nThis is a local multiplayer party game where you take turns acting and watching the puppet show. Connect a phone, tablet or PC using our free companion app.\n\nFind more info at puppetfever.com\n\nYou will:\n- Make up silly sound effects and voices! \n- Take giant leaps of logic!\n- Shout at your friends!\n- Get shouted at by your friends!\n- Have a lot of fun in this fun, casual, puppet party game!", "short_description": "Turn your phone into a stage, step into VR and act like a freak! Become the Puppet Master and play with your friends as they participate through the companion app!"}]}, "developer_name": "Coastalbyte Games", "developer_privacy_policy_url": "http://www.puppetfever.com/privacypolicy", "developer_terms_of_service_url": "http://www.puppetfever.com/eula", "publisher_name": "Coffeestain Publishing", "support_website_url": null, "website_url": "https://www.puppetfever.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1344937839283155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974765_416722449115208_1601116859661287424_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldstBX1TvsYQ7kNvwHO3IYY&_nc_oc=AdpgUpL2GCQ6lpDPI9WKkz9ah76wfkUCr7RouVamcyRzx1f_0pErLCIACXlHYQlNylA&_nc_zt=3&_nc_ht=scontent-s
scdn.com&_nc_ss=7f20f&oh=00_AQHE2YJuWlu2nGlqzQk-MpVMPkqzrpAqA5sZWYtjb_XAkQ&oe=6A86D108"}, {"file_name": "migrated_image.png", "id": "206747347226914", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031453_2182076441888432_1725992307943014400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gIeg_DTqBdYQ7kNvwHQfeEp&_nc_oc=AdoGZw-zKXOPEPgmNkdV_PAo5zo34dJiDFCbaZGFTTUTJ8BHm-ClHcrNWhzTdZSPXt8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGac6Bjgztk1xLBamF5q6_WmhkZGCOs3Vvtq0hZwA-e0Q&oe=6A870291"}, {"file_name": "migrated_image.png", "id": "3022575447794982", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031540_2364376483794658_7877686902445309952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffE7mm9J9fwQ7kNvwHAgiQa&_nc_oc=AdpHAqius8wwu2eehS8E_a-KIYKsrJp6Md189VZ_qo5RJ0zaAxJOje4_img6Rxm0uiU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRweH0JLCVLdDwmqKdGMVV7630zyJOoAJIdqhWYIUvXw&oe=6A86D116"}, {"file_name": "migrated_image.png", "id": "620993758738529", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031644_353500028696907_6555776314689716224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mYRCpipwk8Q7kNvwFnYMB6&_nc_oc=AdqHDaBSrTNlntICM27ZEe0CCDx3LZidVP1GZS7QFQi88qB0cEWxYAtATWTfpMoZdq8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdm6YftAFaX0W6mFcs2DTsvmgBO6jsyvxX00clb58Onw&oe=6A86EB5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puppet Fever", "keywords": ["puppet", "puppetfever", "multiplayer", "party", "coop"], "long_description": "- 500+ Unique English Word Cards with acting tips \n- Hundreds of Puppets and props\n- 3 different Game modes\n- Fun and simple game play, even small kids can guess!\n- Free companion app available on Android, iOS and PC\n- Supports multiplayer for up to 4 people!\n\nYour job as the Puppet Master is simple - make the other players guess the secret Word Card and be as entertaining as possible!\n\nThis is a local multiplayer party game where you take turns acting and watching the puppet show. Connect a phone, tablet or PC using our free companion app.\n\nFind more info at puppetfever.com\n\nYou will:\n- Make up silly sound effects and voices! \n- Take giant leaps of logic!\n- Shout at your friends!\n- Get shouted at by your friends!\n- Have a lot of fun in this fun, casual, puppet party game!", "short_description": "Turn your phone into a stage, step into VR and act like a freak! Become the Puppet Master and play with your friends as they participate through the companion app!"}]}, "developer_name": "Coastalbyte Games", "developer_privacy_policy_url": "http://www.puppetfever.com/privacypolicy", "developer_terms_of_service_url": "http://www.puppetfever.com/eula", "publisher_name": "Coffeestain Publishing", "support_website_url": null, "website_url": "https://www.puppetfever.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1344937839283155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974765_416722449115208_1601116859661287424_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VfBrAudz8wQ7kNvwHYLnHW&_nc_oc=AdoX0jupdjpwJSqKgHN6-SEtItR6vZMFZZig507cU4omhsFHNp0GnNSMQ3FrUevm4b0&_nc_zt=3&_nc_ht=scontent-atl3-1.ocul
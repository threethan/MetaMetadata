scdn.com&_nc_ss=7f20f&oh=00_AQTe1sPIQkRpGq1_PljOwwzb19YHTLsyl14RJJ9azd4NUA&oe=6AF9BBC8"}, {"file_name": "migrated_image.png", "id": "206747347226914", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031453_2182076441888432_1725992307943014400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1a4BCqaYgAQQ7kNvwEFn3Nl&_nc_oc=AdqNKe9GfEfI0LMNYgsZHz3OdpanXLAQ7c3BdNCMmtUMx6ac9XfYY96zaqWOstbmShI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBnhAIQyDM2recNYPY3QLRGk8jW_Vlz-RPKHtaWF_SLg&oe=6AF9ED51"}, {"file_name": "migrated_image.png", "id": "3022575447794982", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031540_2364376483794658_7877686902445309952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONv2Zc0rqeIQ7kNvwF2_TKe&_nc_oc=AdpPT9_OOOqs1mZYHRWxW2uaFAipf6DPDsMWCo8N6RUhJZ0vWf83GUk_S4mJiHJi6Rw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4_QVJdv_j7AfhILnbsIqW2A-oqK5MHdwRP0TxXrPg1w&oe=6AF9BBD6"}, {"file_name": "migrated_image.png", "id": "620993758738529", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031644_353500028696907_6555776314689716224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7TrDkQboW0Q7kNvwFdnd3P&_nc_oc=Adq-QquQEusHPWXKkxbSpL1nmea9x2ZhoqgtwEdQjivVzvVDpCdFfdNftZK32jUlIjE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp9U3gZlpiZqyIWyUT3eUZ5QiqGSr0uY8aYSXtCymReg&oe=6AF9D61D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puppet Fever", "keywords": ["puppet", "puppetfever", "multiplayer", "party", "coop"], "long_description": "- 500+ Unique English Word Cards with acting tips \n- Hundreds of Puppets and props\n- 3 different Game modes\n- Fun and simple game play, even small kids can guess!\n- Free companion app available on Android, iOS and PC\n- Supports multiplayer for up to 4 people!\n\nYour job as the Puppet Master is simple - make the other players guess the secret Word Card and be as entertaining as possible!\n\nThis is a local multiplayer party game where you take turns acting and watching the puppet show. Connect a phone, tablet or PC using our free companion app.\n\nFind more info at puppetfever.com\n\nYou will:\n- Make up silly sound effects and voices! \n- Take giant leaps of logic!\n- Shout at your friends!\n- Get shouted at by your friends!\n- Have a lot of fun in this fun, casual, puppet party game!", "short_description": "Turn your phone into a stage, step into VR and act like a freak! Become the Puppet Master and play with your friends as they participate through the companion app!"}]}, "developer_name": "Coastalbyte Games", "developer_privacy_policy_url": "http://www.puppetfever.com/privacypolicy", "developer_terms_of_service_url": "http://www.puppetfever.com/eula", "publisher_name": "Coffeestain Publishing", "support_website_url": null, "website_url": "https://www.puppetfever.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1344937839283155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974765_416722449115208_1601116859661287424_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4xvmoYHHFYQ7kNvwGGzYYC&_nc_oc=AdrrxOJjqthPBHRHnSycvqDC5pwN5m4dJaHzDu-EFra8jLSuk0tW_9_tWli6utdvDDk&_nc_zt=3&_nc_ht=scontent-dfw6-1.ocul
73_6004827066829111296_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhaK9kTpmRgQ7kNvwHj3TmE&_nc_oc=Ado9DRek5toDBPWcCcGKeqAPBgvE2TPYA1uWkGev3laz0yZgLa_Q6ewpQptHDBk0sjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXSS1k-RV0RMif1-F2k9QUt6fr_moyQ7mT4GXO2VG67ew&oe=6B105D88"}, {"file_name": "migrated_image.png", "id": "206747347226914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031453_2182076441888432_1725992307943014400_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCocb1FIZBQQ7kNvwFXRt-O&_nc_oc=AdpHEsX6d85CiZyRL-gUtv50aKcseyW92yvVXODmtpwFyyuWAk6jwD75FjEd5n3zhYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmal6gnfr-Tys9sfNdUHtwT2uVv9ZBkItrsANK4V1IOQ&oe=6B1056D1"}, {"file_name": "migrated_image.png", "id": "3022575447794982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_2364376483794658_7877686902445309952_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnUN0MdD5Z0Q7kNvwF7aXyJ&_nc_oc=AdorpxVgUFFZlz9BaR8BPIIB0TUzPL4OIirn_OZx5YIy7wT5cjsk1Rd5CperUDzG_0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDCJuE_Y80V-V0AjN6AYFi3eyN-XlFxaVIopVhnSsloA&oe=6B105D96"}, {"file_name": "migrated_image.png", "id": "620993758738529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031644_353500028696907_6555776314689716224_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWgV4NgSRDIQ7kNvwGoVnGu&_nc_oc=AdpuiKyI53nWofOaTOBR2zQuzZvybjXziMzeR2XTfr9HenL5TLRJLo5FlAuOiIj7h0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUXUMxvtgSOY_4XZ88Xc7pYVGwU2o_3hIp8YH_Ztk36dA&oe=6B103F9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puppet Fever", "keywords": ["puppet", "puppetfever", "multiplayer", "party", "coop"], "long_description": "- 500+ Unique English Word Cards with acting tips \n- Hundreds of Puppets and props\n- 3 different Game modes\n- Fun and simple game play, even small kids can guess!\n- Free companion app available on Android, iOS and PC\n- Supports multiplayer for up to 4 people!\n\nYour job as the Puppet Master is simple - make the other players guess the secret Word Card and be as entertaining as possible!\n\nThis is a local multiplayer party game where you take turns acting and watching the puppet show. Connect a phone, tablet or PC using our free companion app.\n\nFind more info at puppetfever.com\n\nYou will:\n- Make up silly sound effects and voices! \n- Take giant leaps of logic!\n- Shout at your friends!\n- Get shouted at by your friends!\n- Have a lot of fun in this fun, casual, puppet party game!", "short_description": "Turn your phone into a stage, step into VR and act like a freak! Become the Puppet Master and play with your friends as they participate through the companion app!"}]}, "developer_name": "Coastalbyte Games", "developer_privacy_policy_url": "http://www.puppetfever.com/privacypolicy", "developer_terms_of_service_url": "http://www.puppetfever.com/eula", "publisher_name": "Coffeestain Publishing", "support_website_url": null, "website_url": "https://www.puppetfever.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1344937839283155"}, "review_messages": []}]}, "cover_square_image":
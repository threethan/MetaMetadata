73_6004827066829111296_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubwsJeZaeeEQ7kNvwF_o3ba&_nc_oc=AdqVJv_4KIyL8Bx8lXKOhwl63J4wByIDCzl0FUGGmuaeAcf89C9t1QLMAjnPXQXarsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2GaCGMTDOexrIfq2zy-eRcz09a16QY7zJg5G5plwOPA&oe=6B005348"}, {"file_name": "migrated_image.png", "id": "206747347226914", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031453_2182076441888432_1725992307943014400_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ge2lsv3fzToQ7kNvwG_YRKe&_nc_oc=AdrBksd37XrAA1VFJ4RzUD2cdf06aidf6NgxlmiG1ktCs9r4xkJ-6ibjkVJcpDv71ig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1S0y1gzMepT-OCXdieJscf-bOw3BvxoPr844nIYwDpw&oe=6B0084D1"}, {"file_name": "migrated_image.png", "id": "3022575447794982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031540_2364376483794658_7877686902445309952_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tASAyr6L4yUQ7kNvwGA0NMm&_nc_oc=AdocYYyjFP54FrQcYFNf33XixAa1Yz0HEX4DYuCOeEszU2j0t0tYInwnrVmRkuDbRIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQETJZP3pT16l33Ll4jXVogyQdLq8TxyL7hSFgG4mZDw&oe=6B005356"}, {"file_name": "migrated_image.png", "id": "620993758738529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031644_353500028696907_6555776314689716224_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqPL1lMy2lgQ7kNvwEf8pLk&_nc_oc=AdpgDIiudx2DUm22LDbS-nDgE22WsE3Z5X_SWb4pb3WpMd9s7tJqTi3lAk-aHKFrAGM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbLssXGCQgZaP8tdPmYOQ7cbKnOdYIqAlZt787KQZ8pg&oe=6B006D9D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puppet Fever", "keywords": ["puppet", "puppetfever", "multiplayer", "party", "coop"], "long_description": "- 500+ Unique English Word Cards with acting tips \n- Hundreds of Puppets and props\n- 3 different Game modes\n- Fun and simple game play, even small kids can guess!\n- Free companion app available on Android, iOS and PC\n- Supports multiplayer for up to 4 people!\n\nYour job as the Puppet Master is simple - make the other players guess the secret Word Card and be as entertaining as possible!\n\nThis is a local multiplayer party game where you take turns acting and watching the puppet show. Connect a phone, tablet or PC using our free companion app.\n\nFind more info at puppetfever.com\n\nYou will:\n- Make up silly sound effects and voices! \n- Take giant leaps of logic!\n- Shout at your friends!\n- Get shouted at by your friends!\n- Have a lot of fun in this fun, casual, puppet party game!", "short_description": "Turn your phone into a stage, step into VR and act like a freak! Become the Puppet Master and play with your friends as they participate through the companion app!"}]}, "developer_name": "Coastalbyte Games", "developer_privacy_policy_url": "http://www.puppetfever.com/privacypolicy", "developer_terms_of_service_url": "http://www.puppetfever.com/eula", "publisher_name": "Coffeestain Publishing", "support_website_url": null, "website_url": "https://www.puppetfever.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1344937839283155"}, "review_messages": []}]}, "cover_square_image":
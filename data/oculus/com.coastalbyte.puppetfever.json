scdn.com&_nc_ss=7f20f&oh=00_AQSqKwxHTv9EW8HOPgH1iqZRSNWOBf9q52zayfZO-MNtxQ&oe=6AE89848"}, {"file_name": "migrated_image.png", "id": "206747347226914", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031453_2182076441888432_1725992307943014400_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6OGKwLRjfMQ7kNvwHytf9F&_nc_oc=Adqu_WGAZU-GFcygE0y97WWaC79spAYaLWzmwclwgx9ONBWCEpE4fFT7-X1T77f8h2w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbyRPOeSr3i44yZMzJuZ_d1BwUQ0Cgm1cGd1ic5nvEHg&oe=6AE89191"}, {"file_name": "migrated_image.png", "id": "3022575447794982", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031540_2364376483794658_7877686902445309952_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIkX6ZvBnbIQ7kNvwHhdVg9&_nc_oc=AdqBKBZsTttKpcNvXPeQLnYrfhOadhLzuxjPV8PoUu90XpCik1DE2w0tIVEImJOYTyE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq0RsWIcXPx-Fdy3a-5jIWd2o5ZctXgcf_D_1jf4wRew&oe=6AE89856"}, {"file_name": "migrated_image.png", "id": "620993758738529", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031644_353500028696907_6555776314689716224_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVO-Sovtd3gQ7kNvwGcSMAC&_nc_oc=AdqGBllgh8VbYlSaC43tNY-g-rlSWVL0KH1G9LULYiKEZZYKKLCgkaaYm8sRus5N-2M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl0BQ4aMcB1dLoSMZF0GS-VBMgeNtFFcZAUK4gbXkS_g&oe=6AE8B29D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Puppet Fever", "keywords": ["puppet", "puppetfever", "multiplayer", "party", "coop"], "long_description": "- 500+ Unique English Word Cards with acting tips \n- Hundreds of Puppets and props\n- 3 different Game modes\n- Fun and simple game play, even small kids can guess!\n- Free companion app available on Android, iOS and PC\n- Supports multiplayer for up to 4 people!\n\nYour job as the Puppet Master is simple - make the other players guess the secret Word Card and be as entertaining as possible!\n\nThis is a local multiplayer party game where you take turns acting and watching the puppet show. Connect a phone, tablet or PC using our free companion app.\n\nFind more info at puppetfever.com\n\nYou will:\n- Make up silly sound effects and voices! \n- Take giant leaps of logic!\n- Shout at your friends!\n- Get shouted at by your friends!\n- Have a lot of fun in this fun, casual, puppet party game!", "short_description": "Turn your phone into a stage, step into VR and act like a freak! Become the Puppet Master and play with your friends as they participate through the companion app!"}]}, "developer_name": "Coastalbyte Games", "developer_privacy_policy_url": "http://www.puppetfever.com/privacypolicy", "developer_terms_of_service_url": "http://www.puppetfever.com/eula", "publisher_name": "Coffeestain Publishing", "support_website_url": null, "website_url": "https://www.puppetfever.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "1344937839283155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974765_416722449115208_1601116859661287424_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7e4il9TU64Q7kNvwGzg18o&_nc_oc=Adr_7oCIRPH1i7k4yGnF7C5y0KOVR90WOZlBDiSh8_fO_QMzAvrE5ggwlf3f--7sxtw&_nc_zt=3&_nc_ht=scontent-lga3-1.ocul
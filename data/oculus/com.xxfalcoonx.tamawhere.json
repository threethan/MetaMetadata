4_me-uy4YQ7kNvwHyg2T5&_nc_oc=Adq36LDK77cfiu6B9xpPDaa39OJPdHKWWKH6DLSSqsBrIgCFjLBcAfSal2QwMYv50Mc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWpLSdjFUOV2sM7qM4JKqszaVY_CJfKO-0wvn3BnChhg&oe=6B0C5962"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TamaWhere", "keywords": ["tamagotchi", "Retro", "pet", "simulator", "tamawhere"], "long_description": "Virtual pet nostalgia meets the future! Welcome to **TamaWhere**, your new virtual pet that goes wherever you do. Whether on your Quest, your phone screen, your PC or right on your wrist via smartwatch (Wear OS), your companion is always just a tap away.\n\n### \ud83d\udd70\ufe0f **The Classic Experience, Reimagined**\nFeed, play with, bathe, turn off the lights, and care for your pet! **TamaWhere** brings back that authentic 90s feel with all the charm of pixel art. Watch your pet grow, evolve, and react to your daily care.\n\n### \u2601\ufe0f **Seamless Cloud Sync**\nUse your Google Drive account to sync your progress! Play on your Quest while relaxing on the couch, then after syncing keep caring for the same pet on your watch or phone when you head out for a walk. Your companion travels with you seamlessly and automatically.\n\n### \ud83c\udfa8 **Infinite Expansion (TamaPacks System)**\nTamaWhere goes beyond the basics. Thanks to our innovative **\"TamaPacks\"** system, you can download, import, and equip expansions to completely change your virtual pet's look and species! The game grows right along with you.\n\n### \u2728 **Key Features**\n* **Play 100% Offline:** No internet connection needed to care for your friend.\n* **Living Routine:** Your pet sleeps, gets hungry, falls ill, and asks for your attention.\n* **Training:** Fun mini-games to spend time with your pet.\n* **Music & Sound Effects:** Nostalgic and relaxing soundtrack.\n\n> Adopt your virtual companion today. **TamaWhere: your pet with you anywhere!**", "short_description": "TamaWhere: Your virtual pet with you, wherever you go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1L6vecvDLhHIdrcVIpfXwREDzxlfBBZ7p/view", "developer_terms_of_service_url": null, "publisher_name": "David Kalil Braga", "support_website_url": null, "website_url": "https://tamawhere.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1620772429708862"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1368543208819440"}, {"status": "PUBLISHED", "id": "1580641280512246"}]}, "baseline_offer": {"id": "1580641280512246"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1368543208819440"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1649106653542106", "version": "1.0.7"}, "id": "1381477053593676", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1620772423042196", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1649106653542106"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1381477053593
-BUv1fE9qUja1VYxCh9lEUuCA&oe=6B0DC1A1"}, {"file_name": "Gilla_Screenshot_2_BeTheMonster.png", "id": "3357798414429119", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623179_3357798421095785_6060864127456058452_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myc5TkcdzdUQ7kNvwHjQKec&_nc_oc=AdqdZ6rj39J1YQwsVn1xlRtI4RtEHS6XeTObWZnVQ5Vuoj9W-k2XWwnHGev3sQYxtmI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyymBTr9RE6OFt_peEv4BDrkicE4Rpt6UCYHpUiw2BfQ&oe=6B0DC45F"}, {"file_name": "Gilla_Screenshot_3_DontSplash.png", "id": "1406142921593912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623585_1406142924927245_1258460543480498798_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDKuyAKLbRQQ7kNvwEG8VHp&_nc_oc=AdqWdt6b0AdtGiO-zxm-TxTxbD4BgO5WErXHnlS29KnjbhFF8rfw8LOz4HHDtJm8ps4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjeHjK75LkzIdh32VxeRPbgivlzJtSW8eIz4SS7eNziQ&oe=6B0DA6FD"}, {"file_name": "Gilla_Screenshot_4_VaultHole.png", "id": "1842577770502443", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623179_1842577773835776_4681462247168004788_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEN3F_O-TuoQ7kNvwFieE8q&_nc_oc=AdqyyP2kuBoOy6fZGr5Pv553c31RWckJNJU14jzdScxWCCc9qdK2Oqxc-37dpHpJA8A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQv5KgOLkPHDAaxdt6NDb3CY_7OfW9E7R6X92JoyIkr9Q&oe=6B0DA95F"}, {"file_name": "Gilla_Screenshot_5_Map.png", "id": "2141810513390008", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593922576_2141810516723341_2489279477047588738_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiFwvh-UV5MQ7kNvwFgfuSb&_nc_oc=AdpZ5emEvUOS_LRtHJeZSllF0bnAg2qDpO1XNKABYjCZCKUFMYRLserzOSqRmFUy0b4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQReRe_3hkGIWrEHRgQL4pGVx5dofc1UHw3Msg-wX0Cdmw&oe=6B0DC3CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GILLA", "keywords": ["horror", "multiplayer", "monsters", "monkey", "coop"], "long_description": "GILLA is a multiplayer VR horror game where you play as an ape. There's no walking with a stick: push off the floor and walls with your arms to run, climb and leap.\n\nTHE BASE\nExplore a huge abandoned base with other players. Hunt for gold bars and diamonds, carry them back to the recycler, and smash windows and open hazard doors on the way. Monsters roam the halls and they can hear you talking, so watch what you say on voice chat. Find the keycard to get through the locked door and down into what's underneath.\n\nBE THE MONSTER\nVote for a map, then one player becomes the monster and hunts everyone else for two minutes. Every 45 seconds a sonar ping shows everyone through the walls. Waiting or already caught? Watch the hunt on the monster cam.\n\nDON'T SPLASH\nCross a flooded hall on platforms that sink under your feet. Touch the water and the Mako comes for you, faster every round, for up to seven rounds.\n\nALSO IN THE GAME\n- Live voice chat, public rooms, and private rooms with a code\n- Daily quests and levels\n- A shop full of cosmetics, and your choice of fur colour\n- Mute or report any player\n\nAn internet connection is required. Moving with your arms is fast and intense, so give yourself room and take a break if you feel unwell.", "short_description": "You're an ape, your arms are your legs, and something in this abandoned base can hear you talking. Run, climb and leap through it with friends over live voice chat, grab what you can carry and make it back alive. Then play as the monster in BE THE MONSTER, or cross sinking platforms in DON'T SPLASH."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsQRF-mjMn1PT6hr_aHK8ZJ4YVodbW3nDoKlg9AFREzKTvL3YSEbsXC3EMl68MQOGLJXUA9KMQo7aN/pub", "developer_terms_of_service_url": null, "publisher_name": "Play Gilla", "
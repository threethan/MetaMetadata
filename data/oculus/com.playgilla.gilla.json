6hbVQbUGQFirVsiIwl0uFCcAg&oe=6B0F1321"}, {"file_name": "Gilla_Screenshot_2_BeTheMonster.png", "id": "3357798414429119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623179_3357798421095785_6060864127456058452_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO6mF_g7PYsQ7kNvwEf-KKE&_nc_oc=Adoi98q-XOgSmCXu6C27K6vmNmB7L-OlOVFfCLQkXju0HNaOFvaaa4qI1fPs3hk2U48&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVPRxglCEPkXZoWWmWP4cgS1nBRgJofjjkzOX2Cvbse3A&oe=6B0F15DF"}, {"file_name": "Gilla_Screenshot_3_DontSplash.png", "id": "1406142921593912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623585_1406142924927245_1258460543480498798_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDKuyAKLbRQQ7kNvwFyXG8p&_nc_oc=AdqOs7Quj4frC5HHx5JxCswxu_ga3_VcrLd9rPnLzXdm8nrE83smJr-I45FT6hLuWAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWi66Q0ib01mLVk6yCHRMnnN9Sgptj5_D9njJ-LWLGfOQ&oe=6B0EF87D"}, {"file_name": "Gilla_Screenshot_4_VaultHole.png", "id": "1842577770502443", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623179_1842577773835776_4681462247168004788_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEN3F_O-TuoQ7kNvwE3LS9V&_nc_oc=Adp0BbQX-hp8zekei5e6KIKYlTTQoLVUbOrUa4SUENE-XrMKK9JGgN4-zW6gVJkplZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUdhOMTlWVxNtrSmvIXC4jp56kjrLjU4bUM2m7w_3fceA&oe=6B0EFADF"}, {"file_name": "Gilla_Screenshot_5_Map.png", "id": "2141810513390008", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593922576_2141810516723341_2489279477047588738_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTkWsWpYkGQQ7kNvwEodgdv&_nc_oc=AdqaXLargJdWA4pa4HOF07DhGad6SXdNbjXs0dRBSoVYeXv8-oSp3BIUTeVqgneDTfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmYc_Qu1_r6xt4hPhfT75vhyquDGnkreqOTsEM-8FhYQ&oe=6B0F154D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GILLA", "keywords": ["horror", "multiplayer", "monsters", "monkey", "coop"], "long_description": "GILLA is a multiplayer VR horror game where you play as an ape. There's no walking with a stick: push off the floor and walls with your arms to run, climb and leap.\n\nTHE BASE\nExplore a huge abandoned base with other players. Hunt for gold bars and diamonds, carry them back to the recycler, and smash windows and open hazard doors on the way. Monsters roam the halls and they can hear you talking, so watch what you say on voice chat. Find the keycard to get through the locked door and down into what's underneath.\n\nBE THE MONSTER\nVote for a map, then one player becomes the monster and hunts everyone else for two minutes. Every 45 seconds a sonar ping shows everyone through the walls. Waiting or already caught? Watch the hunt on the monster cam.\n\nDON'T SPLASH\nCross a flooded hall on platforms that sink under your feet. Touch the water and the Mako comes for you, faster every round, for up to seven rounds.\n\nALSO IN THE GAME\n- Live voice chat, public rooms, and private rooms with a code\n- Daily quests and levels\n- A shop full of cosmetics, and your choice of fur colour\n- Mute or report any player\n\nAn internet connection is required. Moving with your arms is fast and intense, so give yourself room and take a break if you feel unwell.", "short_description": "You're an ape, your arms are your legs, and something in this abandoned base can hear you talking. Run, climb and leap through it with friends over live voice chat, grab what you can carry and make it back alive. Then play as the monster in BE THE MONSTER, or cross sinking platforms in DON'T SPLASH."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsQRF-mjMn1PT6hr_aHK8ZJ4YVodbW3nDoKlg9AFREzKTvL3YSEbsXC3EMl68MQOGLJXUA9KMQo7aN/pub", "developer_terms_of_service_url": null, "publisher_name": "Play Gilla", "
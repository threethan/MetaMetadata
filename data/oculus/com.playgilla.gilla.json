=6B0C7021"}, {"file_name": "Gilla_Screenshot_2_BeTheMonster.png", "id": "3357798414429119", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623179_3357798421095785_6060864127456058452_n.png?_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myc5TkcdzdUQ7kNvwEi3p6s&_nc_oc=Adpt0tw-n9NQx4W3LXeuvXnZG8Gbac6D12Dv-Nv6-kPJzd6yQKM0ZB1Qj3qYCT4QotY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSJiUkO3-jYPTB6nfmNDjfcQtBmzKy6k6862hWLhx64Kg&oe=6B0C72DF"}, {"file_name": "Gilla_Screenshot_3_DontSplash.png", "id": "1406142921593912", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623585_1406142924927245_1258460543480498798_n.png?_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDQWxIAxBf8Q7kNvwEL8cRb&_nc_oc=AdpYVjPL_aNsAN5tWZue3SxUwQbHaH6aVHyBZIQgFeBZ6ZoxCSgm3olljaN0G4mtmBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmDUuBlWJbI3--LMO5rJLJKk1eacA8-9qj2Uukp2jXFg&oe=6B0C557D"}, {"file_name": "Gilla_Screenshot_4_VaultHole.png", "id": "1842577770502443", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623179_1842577773835776_4681462247168004788_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEN3F_O-TuoQ7kNvwEx4EEF&_nc_oc=AdqdlVv5udBxjk3h1-_z3XchGnfvmelWfeQMDBpcW0XgegOwARJG918btNq_DVGegvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRYVKPqjV-q8EN4bZiTj522R-Eiq1bxsvL419yumOfhUQ&oe=6B0C57DF"}, {"file_name": "Gilla_Screenshot_5_Map.png", "id": "2141810513390008", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593922576_2141810516723341_2489279477047588738_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiFwvh-UV5MQ7kNvwFt7SMP&_nc_oc=Adpwusz1wLDEXB9Yd7cR0S9ZfxCVT8QJgfPdFfdXTEpQnRUNzWiGotD_at_YrclUNJY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFgdNLVmhMSsWJPgT-S117HxvfHh6DXqUXd-sKG1wQNA&oe=6B0C724D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GILLA", "keywords": ["horror", "multiplayer", "monsters", "monkey", "coop"], "long_description": "GILLA is a multiplayer VR horror game where you play as an ape. There's no walking with a stick: push off the floor and walls with your arms to run, climb and leap.\n\nTHE BASE\nExplore a huge abandoned base with other players. Hunt for gold bars and diamonds, carry them back to the recycler, and smash windows and open hazard doors on the way. Monsters roam the halls and they can hear you talking, so watch what you say on voice chat. Find the keycard to get through the locked door and down into what's underneath.\n\nBE THE MONSTER\nVote for a map, then one player becomes the monster and hunts everyone else for two minutes. Every 45 seconds a sonar ping shows everyone through the walls. Waiting or already caught? Watch the hunt on the monster cam.\n\nDON'T SPLASH\nCross a flooded hall on platforms that sink under your feet. Touch the water and the Mako comes for you, faster every round, for up to seven rounds.\n\nALSO IN THE GAME\n- Live voice chat, public rooms, and private rooms with a code\n- Daily quests and levels\n- A shop full of cosmetics, and your choice of fur colour\n- Mute or report any player\n\nAn internet connection is required. Moving with your arms is fast and intense, so give yourself room and take a break if you feel unwell.", "short_description": "You're an ape, your arms are your legs, and something in this abandoned base can hear you talking. Run, climb and leap through it with friends over live voice chat, grab what you can carry and make it back alive. Then play as the monster in BE THE MONSTER, or cross sinking platforms in DON'T SPLASH."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsQRF-mjMn1PT6hr_aHK8ZJ4YVodbW3nDoKlg9AFREzKTvL3YSEbsXC3EMl68MQOGLJXUA9KMQo7aN/pub", "developer_terms_of_service_url": null, "publisher_name": "Play Gilla", "support_website_url": null, "website_url": "https://gillavr.com/", "category": null,
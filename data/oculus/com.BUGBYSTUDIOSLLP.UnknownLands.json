uHMw9G4F5MQ7kNvwHX-oEA&_nc_oc=AdrtOt1jGD4ssqHTLflhKkhP4LAoyvqd_ah4FE8sDKOAqcGCi3ztVbGHsgPySP8QaQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNZcJR6WxbtDGZKHJ9gBAxH54cxDv8LKHlQIySlU895g&oe=6A4F8F99"}, {"file_name": "Screenshot 2026-04-19 194307.png", "id": "1051285830718365", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619805_1051285834051698_6863233708274731493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEkIPf87-vgQ7kNvwFCkxrl&_nc_oc=AdqEoAxAbKgQbp75ugDj1jSswa-7z_Oryk9h4Z6nlwQW5vgiulwMb9MuUjjknkp-4TI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-0aF_qdi8eXodUphRBCTUaj1EANru1z3TeqjUtzkeoA&oe=6A4F98BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage2.png", "id": "1602139560343291", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974814_1602139563676624_4224374955304718602_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PaS87fM6A0Q7kNvwEaMXT3&_nc_oc=AdptX3BVWQ7hUwF9fvRzkiwAmf5SvwA2vXVBnPF5Jh8Nizu_w3Zk4ZdeHSPUNdWPH9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGZgxoJ31MPoLVnvbyOTMUu7XhMO9NNovGp5q4n3THrQ&oe=6A4F9C89"}, "display_name": "Unknown Lands", "keywords": ["Unknown", "Lands", "horror", "pyramid", "egypt"], "long_description": "Update 6.0 is here!! New enemies, improved visuals and many more!\n\nUncover hidden mysteries in this story driven action-adventure game. Rooted deeply within the Egyptian mythology, buckle up for a thrilling adventure!\n\nSolve puzzles and combat the creatures of the dark, with style! Just a warning: Unknown Lands come with unprecedented dangers and dark secrets.\n\nThis game features:\n- Story campaign\n- Interesting puzzles\n- Characters in Egyptian mythology\n- Range of weapons for combat\n- Three acts set in different worlds! \n\nMay the light of RA shines upon you! ", "short_description": "Update 6.0 is here!! New enemies, improved visuals and many more!\n\nUncover hidden mysteries in this story driven action-adventure game. Rooted deeply within the Egyptian mythology, buckle up for a thrilling adventure!\n\nSolve puzzles and combat the creatures of the dark! Unknown Lands come with unprecedented dangers and dark secrets.\n\nThe game features:\n- Story campaign\n- Interesting puzzles\n- Characters in Egyptian mythology\n- Range of weapons for combat\n- Three acts set in different worlds! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bugbystudios.com/privacy.html", "developer_terms_of_service_url": "https://bugbystudios.com/terms.html", "publisher_name": "BUGBY STUDIOS LLP", "support_website_url": null, "website_url": "https://bugbystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35048532634791618"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974446_902405328496719_7758797096360440716_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gel9OC-lhqMQ7kNvwHjFnsQ&_nc_oc=AdoiZMK5XzAtwZWIK-13W3goZiL1q8Uos3sQQYACkiQGcFgbyuqiC_rakTWS3dlBnss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn_9nYyr6km7B_j7Exdc8elqcaAFDWhHV-mBtdClL4wg&oe=6A4FB99E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
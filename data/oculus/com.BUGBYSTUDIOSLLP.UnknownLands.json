jxSVaAev3MQ7kNvwHnWs6F&_nc_oc=Adob5FraJ9ebATEMynGb68xE_mVL_5iZSlTKL9BSwoovkx_YOxQSyOCsju37_FMKBso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gVgwfhvQaCCr62rGy9YXj1OYqR4CMhgJVayMKZ0Okeg&oe=6A26E959"}, {"file_name": "Screenshot 2026-04-19 194307.png", "id": "1051285830718365", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619805_1051285834051698_6863233708274731493_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-Iq6rQoEE0Q7kNvwGnPdUB&_nc_oc=AdrZTIMkI_IoxyaHizv3biFr2C47jtw5BiegSopugCQd37cHysjSnBolYjDpwstFy9s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ii46SOqoIC8AeL9twxc8pgBqrT0VHwahb6DzleP_N8g&oe=6A26BA3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage2.png", "id": "1602139560343291", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974814_1602139563676624_4224374955304718602_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APhBQ2ts3pcQ7kNvwFBiAgv&_nc_oc=AdoFjg9kFNyX_bi0v5dIAX1mUHTZvQ0A2waI4Tpzt_oCChBvHPaei3RE48-a7iy6nbE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OOqNS6WTL2NFGctGmaro2xoRt3UNEEeTVDXzbo-_iWw&oe=6A26BE09"}, "display_name": "Unknown Lands", "keywords": ["Unknown", "Lands", "horror", "pyramid", "egypt"], "long_description": "Update 6.0 is here!! New enemies, improved visuals and many more!\n\nUncover hidden mysteries in this story driven action-adventure game. Rooted deeply within the Egyptian mythology, buckle up for a thrilling adventure!\n\nSolve puzzles and combat the creatures of the dark, with style! Just a warning: Unknown Lands come with unprecedented dangers and dark secrets.\n\nThis game features:\n- Story campaign\n- Interesting puzzles\n- Characters in Egyptian mythology\n- Range of weapons for combat\n- Three acts set in different worlds! \n\nMay the light of RA shines upon you! ", "short_description": "Update 6.0 is here!! New enemies, improved visuals and many more!\n\nUncover hidden mysteries in this story driven action-adventure game. Rooted deeply within the Egyptian mythology, buckle up for a thrilling adventure!\n\nSolve puzzles and combat the creatures of the dark! Unknown Lands come with unprecedented dangers and dark secrets.\n\nThe game features:\n- Story campaign\n- Interesting puzzles\n- Characters in Egyptian mythology\n- Range of weapons for combat\n- Three acts set in different worlds! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bugbystudios.com/privacy.html", "developer_terms_of_service_url": "https://bugbystudios.com/terms.html", "publisher_name": "BUGBY STUDIOS LLP", "support_website_url": null, "website_url": "https://bugbystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35048532634791618"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974446_902405328496719_7758797096360440716_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k83Wb7trrZYQ7kNvwEVxv7k&_nc_oc=AdoXTcuUxt508HbrbL9Q5-twslpk7i49ynNUeK6SS3vjTK9jbVttXXMNtTMcclBh_b0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MWu9yTvaRf6LBj6IYpBnLYVNTVQUp9eXxUZIlEvhEgA&oe=6A26DB1E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
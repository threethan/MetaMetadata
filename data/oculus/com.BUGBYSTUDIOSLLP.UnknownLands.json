ry driven action-adventure game. Rooted deeply within the Egyptian mythology, buckle up for a thrilling adventure!\n\nSolve puzzles and combat the creatures of the dark! Unknown Lands come with unprecedented dangers and dark secrets.\n\nThe game features:\n- Story campaign\n- Interesting puzzles\n- Characters in Egyptian mythology\n- Range of weapons for combat\n- Three acts set in different worlds! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://bugbystudios.com/privacy.html", "developer_terms_of_service_url": "https://bugbystudios.com/terms.html", "publisher_name": "BUGBY STUDIOS LLP", "support_website_url": null, "website_url": "https://bugbystudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35048532634791618"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974446_902405328496719_7758797096360440716_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKTq4vcYntoQ7kNvwFTzvqO&_nc_oc=AdoaRQI9h7Q9R-8JgzNF9oJEnvI8ijHfJLxbthWkA0g72DeE_-Hj67081x7yu6gxWzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqO03Se2gEC2aFehL1MuHSgvJiLJHWIjmbZMueUZKL9g&oe=6A6CBA9E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
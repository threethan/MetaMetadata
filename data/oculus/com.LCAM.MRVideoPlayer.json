WX&_nc_oc=Adpw229qmDWe2JbAAqs_k5T1F6sfXLYjiCG_teMnPrCYTz3rwc2DqcCvPjR6BR7HyWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9qxa72Veh8GWFaLtmZTNAAoHTjfBw6PHG9J2NBk9Sxg&oe=6AE20013"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSMC3lC-sWMQ7kNvwH6qG2k&_nc_oc=AdoEVH1UzoC_g1UDQEUMzJNHUFLby9tncqMVoeVZY-2tqNGQ4MM3GxQf9AtxE0UADu4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1bpRHVJWZaIVp8lSEK_RTAP9xiVcqniOuAQhREnkh4w&oe=6AE1F272"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRdCFUo12HgQ7kNvwHcojjK&_nc_oc=AdphTX1Gjj6CFgHBZ50KhWya8w-QVTjoq1oJtfG-7gYd5hNqNVUgRnsfwvYhDybOyEQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFWkb2CX-YdPbxf1dyLU5wW30UxHdSLAbO7GFwgrJw7g&oe=6AE1E769"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yrchenworks.wixsite.com/lcam-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://yrchenworks.wixsite.com/lcam-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28694951976811334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568678_1860290017732731_9005045556428135412_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91_kI0VHx2cQ7kNvwGBeQ4d&_nc_oc=AdpUCgCgrvIn2oCJRbfkW-byt3562YR5PqG0EBVkCyvM-dUELizmlwEmYEFiAMBbLiY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn8YhZTgFg8G4p6XcVwmVBe94-8JM0siGBJhZSSKP2rA&oe=6AE1ECE4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "LCAM MR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1712249820, "lastRevision": {"nodes": [{"id": "73685234332141
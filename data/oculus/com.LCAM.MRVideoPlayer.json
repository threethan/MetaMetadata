oc=Adr7FoU7UwUV5v-aEON5J5BXnqTI1I7seHM9ffKOPqN0TdZjdFWBduqE4hFlp-5vsoY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oKSPUPAYB-qkHKH628UsK3FodDpTYQTLCWtiAuNqz_A&oe=69EF68C3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiHRox5h2PwQ7kNvwGFrdam&_nc_oc=AdrSOWJrDP-c-FyAkQ9IYqMNvAwM_8wTh3frLxP_10CPHc-Yei2R5mFRDj6xJHZC0t0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02E_N1gWq6dTZZCEOOOsQl5H6ITVqVD3m48wSsARMz9Q&oe=69EF51CB"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sU3W-d4a9oQ7kNvwH0llcn&_nc_oc=AdocLshQMP4_Ge1SQR8Bzz6YfELG_IJj_hTezO5VIKAJ4m4YlyIQ-kxl-7rz3OQWPZE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aZDJ7tpSitS9qySZMZXu5oRLIQZo4pDhIrlL1v5OFzA&oe=69EF6C13"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj44C17-AHUQ7kNvwFSwQRM&_nc_oc=AdoUuxQnl9aKewxVQxzGbXU-RPFhThTsmgPsI_nOx7EMrXMsyYpiUDfHcd6YhBoJhyE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EngfQphOFSFy5dgIm0ZXPLb7NOV2NzcSkrkDzsYxdTw&oe=69EF5E72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtgS2YXeQLIQ7kNvwFpuYDJ&_nc_oc=AdpuH3aSm9FK-K_nfBQExNjpkiY0H4X1CqUIlQVtIpGTBpiWf96NmE3TbR9dGA2X7Q0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20Q_j6tqKjw4e_lJt4kyeZP28u2APrWNnZnnp-NGsWJQ&oe=69EF5369"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
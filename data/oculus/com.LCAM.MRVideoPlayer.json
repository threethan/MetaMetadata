oc=AdrZSnzgJaH1ryZC2dfpe956VziZ1HcoyGDLeOgZhhweh-EAou7CZ5mQ6xRrLenB2ME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9U-nK_uYQaOrD-7YZ4C32Rr2uspJx5oXlxyIiwtjTC0w&oe=6A47BD43"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fP2YFBm_iYEQ7kNvwED8Ghs&_nc_oc=AdpfK7PEHXlW8HbBPTcLipMX1JoFgF6R2oA_91PuB0BznAFFcGr4f4aYofpwMJAF7eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kW1FfADJX8uI14ijrgNz9bHwGabxMUbyOMLWxW-bWOw&oe=6A47DE8B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIjUMt6QBOQQ7kNvwGEC2hC&_nc_oc=AdowTmi6YnXuArqEaS_E_njod989RBAZnG8zQRNDNfFy4U97Yc3-1Hmzp6rlCbqZTRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OT-_65JV9_Ip5V9-I8Cl8LR-b3tuGQ1l1FCmo-iPjtg&oe=6A47C093"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXrHhKYuzb8Q7kNvwF43J3F&_nc_oc=Adq1ZTBHWvzexoLrvPQyhKLOdcPfBp9TGhUcvwXveedIxWxe5SIg-rQi98KWI4TLCmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-GiqNQwRd_LC1xE7UFkZMIR_X2Kz_xtiDUY_Ir5_xkw&oe=6A47B2F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1jaGgkqfwAQ7kNvwGAF44F&_nc_oc=AdoOF_6D0pF4ig9130t5-ZUN1axfH7A8XKGNbdV8lE8oqH1q8a1xN7x_so5qUv35W2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YwiFq5US5qqbiZm4MO6w_-KpehWHZoroBSwoqFvQ1zA&oe=6A47E029"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
oc=AdphGpiT9No-e5k3n2HGT6NcLDLn-xuRAzmBL0DRM7tYnMU2uJ-4ImB3sf-5uD9WLaw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EhCvmv9S_xjRN-Inc6Sn8Cxd4ufsTqZHMtFR5A6aNrw&oe=6A37EB43"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDs_X1doa4QQ7kNvwFgrycm&_nc_oc=AdrQ90i1xRCCvpDA1jenPrNyKsK3F_RkzM7ApBpF-smVPtLMtRXB0UstT3FhVzHSKzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xeajpFtBCRBy_6nrpTAyX2jAizhvOwb12mddcxYVNCA&oe=6A380C8B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MU553_KjdAQ7kNvwHm1Ass&_nc_oc=AdpUHm7gD5ZoLKGdO2YT97BHW61fkVDsHMXxILjzSFc29ezU3jVGnBxrlGTIBCJENFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dawr4PwUrRZmg5W1Blc9_MqqgbieOMjJb4upR2JeOJQ&oe=6A37EE93"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvZwjn_pU5sQ7kNvwFMp-Nm&_nc_oc=Adp45_vGn3v4mY9dFZ7pTzQ_lgghkJpjM9QkIDTGBqOCsnUKP1XnSq3n1shr6DhZ-2k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ILJCzRrOC8Wt1rCfnT8ym7JM7DGE5jk3EAnhcffrBsw&oe=6A37E0F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DuxhFRQmwfkQ7kNvwGB9drS&_nc_oc=AdomTxA1NEeStjWX0p8A_3UWODL53fbg38jBcyHBY9SNioyXda89wIUH3QGAmygbBeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KxzwRowNJLMqZD55TR3pOUh_8X8kt4k_hl43ISwnN4g&oe=6A380E29"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
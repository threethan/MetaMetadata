oc=AdrIwFPqDn5BIVN-KdXU00taQ-INmaovAwU9_y5R07gJHYIY3yJ53xg0JttEquH0K8s&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrKlkmxHmuzf3Gfb5qyxb4kEMiZYH28lv8drD1RSvlqg&oe=6A943443"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_An4rdA63nUQ7kNvwH8VNRz&_nc_oc=AdrSlWEL-BKuPoR4k8LUYb6uq6CgyS1REx638Jak8gOA71imcFcsBbbEswl2XTzSALQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOE93ZZzbjiCA92UrTo-OHVKaA1Fg4_rxQZl3DFGspiw&oe=6A941D4B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIpe-coeRrgQ7kNvwEaTYgN&_nc_oc=Ado__Re0LkUR0dXMEUmYtVe7Au16uD-U2HI1OT-sOE8TbSPk5FvK1Fw112DX6tRbYoc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSj6XK0iZcHSNuzhQeDMYwKGqv3KPBfxm1Tn7I-H5KDg&oe=6A93FF53"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRl50-72E3MQ7kNvwGUzFgO&_nc_oc=AdqEhF1AT6yfZOOB1hKjgTXp_7LmtJE_kPaHjQ-408ypfAD8me-txg4IpAxpD3eLYdw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO928yKlDm8w3B1tQpAjz5cA-u1wWN2Cr1HqzN8paw7A&oe=6A9429F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umFBVlNMyWwQ7kNvwEZtmvE&_nc_oc=AdraE_NBoSkEWX59AoTnjBNPXBNo9mHwtTK54KMW5eFmjTiZDhxKENSfUtC2YVtzEew&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9Y8QEV1YIuK_Wgsi0P-mUJnTnxtmAMvxBiTe_vfWDAA&oe=6A941EE9"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
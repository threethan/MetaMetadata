oc=Adr18hSgOTWKqua1Tkv8p09Qk-t86-T4a-adXNcvmgfklvCKeUhXimikEc1L75IfXvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N7bCoeMIO5yn--FOxl3gLQ8kruQRCR9gItDW_EiPVsw&oe=6A032F43"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSiW4-2oH_EQ7kNvwGHitqb&_nc_oc=Adq3p5Y9PgeuuMEWpwS9nN-cGrUrOYTsNyCS4miEvJPKqIw6ajeP1J7uxhhP7_IFNl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4POSP8W80rRjnt2g9eU19R8RHK-p3TtDNqzaMsFxAaPw&oe=6A03184B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEpt2Vw4_hwQ7kNvwF_FOxl&_nc_oc=AdoRANSMFErEomd6FXrCg_dl4E3gZPqdVqzMb4xChQ8NdE2TnwSTJ8xICt0IgYRwdlw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yui7kL1IWRO9GMuFwjMiAAAep9X1IxZNk20zp8iNV_w&oe=6A033293"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1Gtp1vRMeYQ7kNvwFh-2Km&_nc_oc=Adp9RMZo9YGxCEP8vmwJdGpTTYnW2Amquz_VofK4dRuJIYvHTFEjIgn85VVBx9GFh7E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Uo6ppOgFQMHLLAmfcgO3F3GOFl_y9IVxDdtzH2hKQ1A&oe=6A0324F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg31-XoxQFkQ7kNvwEFiqv6&_nc_oc=AdrZOfydqlGILEB0Rnj0qV_qsKN9a74oqa0Fp2zZ6NqijCRoEUw-27RsxoWGkguAjgI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YHP1WueEeACDK98qnwdLY_48SUF4zeHN8YODqhGhFMw&oe=6A0319E9"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
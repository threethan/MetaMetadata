oc=Adr_lx1ZYT7ycis1FReLkwFGjkb-ps8IlJgtgXSQcS5nollN4xSvlAgqoL2sMpzsT8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIkweH5Fmo10Mv5JWd45KR-LQcD1wyLhAqs7omqulYMw&oe=6A903FC3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABY3dk4r_5MQ7kNvwG4c45S&_nc_oc=AdrHPO4FD3OkWrLzvyOM1URWgaoL99VQuZUOwER7KODBzbpqnQhO7kzP0hK60HZc2cQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJn2xZe5wxEoZLyNA3BzsYmQmaOpNYM90uTiK6U4SR0w&oe=6A9028CB"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RKj705QsAsQ7kNvwGvPo5-&_nc_oc=Adoay0Im-Y1L0ocbQ6CysVX-U3zA2CzZ_s7b18vhm_M4CAvXa9DBDHcSktLrH_3UIxw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFurFejognKBcsPNHaGwpcy4IFIW3RAjvoLuN2XNbfB6Q&oe=6A900AD3"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvykg5cZqE8Q7kNvwGN3Hor&_nc_oc=AdrQuAgVDPBOoPFul-P5xxQpU0m_JnnPRG-ec-thlKxHv_0hr3X5pS65M8h2viWhK7c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHvQ9AZyzBByNyUbfh0Dg2ljQ9-kLCvj0kFtti1gtRYg&oe=6A903572"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYa2BOWWvc4Q7kNvwFehhwW&_nc_oc=AdrQcIOoPR8L6KNQVsJ_FLf4DQ3ALBRPxSzd5PjhXzNAh4xA5tas7PVTZ7Z6h6hg10w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1EzVNo304DK7B1ltDB1hQLiF97bPvoMznl_BPVEn2UA&oe=6A902A69"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
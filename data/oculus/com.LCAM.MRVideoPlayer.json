oc=Adqh91nfPhx9w2NYEVfsCV9Z0F-_BWCSTbnK_XEE10JbHeDiC7rRwIC5AJBbDDK5SP4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99JJSDmv3wBruGaJeDs2sVAoxI1jEargkBhDg_sHbp9w&oe=6A300243"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmP9IeYuarAQ7kNvwFdgVMD&_nc_oc=AdomribVejozLRnI8Ngmz-9-JtINrb8Rdi8J1fvp_hxP45-0Q2inxdvYMtixZdt9nfU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fsIG-FDyjm8qC6S6Cv_fDcNr3_dPQpLT6yfr1bSUfjA&oe=6A30238B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eWALUENz8sQ7kNvwFXv09r&_nc_oc=AdoswsqC_imKmUSu0KBgiPerCEI8DgJY7ywu63hIrHC9DQqvtzrxqoBM26wy0Apm-U4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hkgq2jESF_9ALgCbTB6ARX-noMnOlJfZ3-QhEB2YKPg&oe=6A300593"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLqNQEHEfFwQ7kNvwEFsWeo&_nc_oc=Adou1bd13NEcd7qP9TS-vOAJ3zhYz-AhrOtEPcSp1KpRWZrkYenvMlq680J8Bsxz4Hk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pwc7REyx8LhwMoTBcvtX8y4ZpCzWQOcjFN77HgWK7-A&oe=6A2FF7F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGwhyVBqjwEQ7kNvwFmDS-z&_nc_oc=AdoDudpA9sDhfyJD-bY_p7O7oSwKDUbfveHdpCJEzKAXu_WGplM7u4a-9mUYOfgKpcw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nWjvRXXmLwjyDVA7h2xe4Nsr7NaaMqaAPxZ3DgDVkzg&oe=6A302529"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
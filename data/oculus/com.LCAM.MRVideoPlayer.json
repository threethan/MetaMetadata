oc=Adq2JL8ZvlR8E06IOE9EHcd9__IrsV_g2CesWI-zgWnIqIRodUzGExPl3vQ1gqhe8fM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qhdN8YadHm8FpPXdAegkLK-1R2HIA0jIaca-p3_xOeg&oe=6A3D3143"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqKi5dCZSWwQ7kNvwGeFg4m&_nc_oc=Adq6AI3Is6CHSnMnP8RU3tH6EPKwf56zvXw57EuW4vqXKmAHayLwrp6IAiVbVfZD4rk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I2VVz4Bah2oc_cDzuXQLcRn31-sHpDL-OzPlsqSiILA&oe=6A3D528B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPhIuzC_jScQ7kNvwHZsjHK&_nc_oc=AdrASGAQ6VJGRIbAfOu1q5JMWq1MJBZHSuSzBrUSMRyrhtwRvYS7-2Z6WbTdblspuXI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LzTG5072yrm-FNlDYE6XJKRARYQPXHZz2l-Z8jGKOQw&oe=6A3D3493"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zISWgE5NApgQ7kNvwF1vYNn&_nc_oc=AdoN_mOmzp6FlYih1rWI78XcG4B2LEpkdmrggyR-3weAREswNy9EfoFl-FPw9I4TCYs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sTjk4DDzoMLveMc9DXgt0PdQY_MnMYnh0_QBRcxn9YQ&oe=6A3D26F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To9dpE8PvNcQ7kNvwGT4VPp&_nc_oc=Adp_4Pq0bkUcMVewhNsT-a7nFiD_wfSY2p_R-W88JxmzCaI2YRPHdnRcAxIk_xGTZYY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D5RliHPYORTQFsELo8hZd9Z6B06id8QfwIZVXN1R6Jg&oe=6A3D5429"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
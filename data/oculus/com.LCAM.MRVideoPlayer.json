oc=Ado38VBof0QzyJuLTPzH4nRcyTcy1Mrrkz__H_4BUP_f7Rjkihpq2M9ib3C8Tysf34M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAl5z7ylikg_8vgzenSVCN42Yo8PG6_5rCZREwALzuRQ&oe=6A9ACBC3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXi5fPO49tcQ7kNvwEGN_eF&_nc_oc=AdqMNdTUJ8KlopybrmZPey_IHzRJLL-J_7u43dpRPvIaQ4hH8WW2qpw7BxbnAuCNGms&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIADO6T51_bJl0sIjGi2ktHbF3C88hz8OtNjvoKeNyrGg&oe=6A9AED0B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CnunO_MfaUQ7kNvwGqgDhx&_nc_oc=AdrfNggp19C_hCCH6KM_IvtGH09l_uys2N16SqyGO-CA7Ebgcc-LLRreJZUcBAVxjbA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBBf19lkJzeONmV80DVi0-zpr57QHw4ONQaNu1NU38Rw&oe=6A9ACF13"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MHptKTOf0YQ7kNvwGxrOX-&_nc_oc=AdqQl_ceSniIhN8w9-lFHGL-AN0YeaxuN0akV2Nz-BoNsPqjnHiPJjHleqrSAmt50OU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfkjRUj57vL891Gd4SnFqQXJRqZQvqOWPrRWA34rv0-w&oe=6A9AC172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrF6dw68tpoQ7kNvwHSNzPS&_nc_oc=Adok4krRh1PnRqe2TuKeclDEMzDuiKrkjpwfMlLrRYmClhByVUmll7KvXFon5nr4Lyw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbOrHgWvx-YTZwBNVuiXET86Hx7tyEI_DewU4R09kEFA&oe=6A9AEEA9"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
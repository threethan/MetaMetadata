B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYEAp2pA2nEQ7kNvwG4YyMR&_nc_oc=Adr4tS0sGF7wY441dNz9HUzlvsDFmknmTyJtZitpYkqibv738ApqQcBjCxS6ie674w4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV3NOjn5ZpmVXRvQQw8nRCS6FiLiDtLyBitiIpkqIrMVQ&oe=6B0F0B53"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ep-1MWlL10Q7kNvwHSNVzX&_nc_oc=AdoJP6dUqLrO5ULhzyAbiCH9v4JrmjqUAaigoIyB8oE5aRDh7_FobbeH3yGVXMksDXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVrYniUQTLZrpOHbi19Dxmy51ZY0iA1fvudSw55eyZneQ&oe=6B0EFDB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyXKVN_4P48Q7kNvwGFsd4B&_nc_oc=AdqyGMvnBaLivGvwidoVabxRE6T0e9TB9nMTS8pBCWSmWFbfKa1HBZmB_xmUBEyZXok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTW5vSUBbrydwkTg1zBePtD_az_KAiAHn7tC0TOInNfQ&oe=6B0EF2A9"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yrchenworks.wixsite.com/lcam-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://yrchenworks.wixsite.com/lcam-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28694951976811334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568678_1860290017732731_9005045556428135412_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0Y6YxJecs8Q7kNvwFBRAzm&_nc_oc=AdrqnyMpBIGpjzr1wwfQjNpetnZPYeHnfNNgYeR0w0Kv_0NnnMNn3ocRf1nf-om2Xi4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVK2SPKe3_EJDaMBkzjt1OBNXx09ZuetEcmdbFDqnCo0A&oe=6B0EF824"}, "is_concept": false, "
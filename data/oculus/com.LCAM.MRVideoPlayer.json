3w6xOGGnr1Quqj8eniUuLvo0HqeuIG3mlrhOxA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_N7ftqWO42uoH5VupFa5ZjPVvxn1dnLVknmb3FtNzkw&oe=69BFF2C3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2mGxXNjYg8Q7kNvwEdRrbQ&_nc_oc=AdmF7GymTnByN45L4T1WPLE1k-nKlggrkwkW0beB0EKpXZylQgh9XemyAtF-qaPTDJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyl_TWLIAtvVErCuIEVhuncAIHbzJCp89hJxpnt5pNc4A&oe=69BFDBCB"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToMLg2-mqE8Q7kNvwEwGV1m&_nc_oc=AdmCCQSfe8gEcAWMu21dBRLDeL7XB19_du0iin9K5WEiQdRiPvr8N_ZmTMFO4_O87qo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx3MbEL4GL6HhiXhKepc_0lsarIQ1UKDju7y7-DVtlGtA&oe=69BFF613"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqVJu7SgLuwQ7kNvwFzAedU&_nc_oc=AdlztB8XQL_3NbH5rYqZcoOZYSddv82Rqly4DJUAhGwBbbOG84Y2wBdq5X9zJM4YYMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZPnH3R-reN5zB_CDYneBoBgnkrGP8nKsZIG7uqDEYyg&oe=69BFE872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO0a9-VUahQQ7kNvwG2bKX-&_nc_oc=Adn55vB8OIfpVNGxDR1bSZk3hFPJ_yECEU5c09jaMPVme9sTtB7e6rLTB3ZHxC7TIgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzWRjPsnf-pJqYvU6Bz1EBnLIeTSU-exWFIq_sX4ap3CQ&oe=69BFDD69"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792706427"}, "review_messages": []}]}, "cover_square_im
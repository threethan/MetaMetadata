B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teCQ6IQa38wQ7kNvwGEtjym&_nc_oc=AdpW-y8SZJqyg_BqRh9_e2NStJ_XxydiT6nrEQgn53ry0JEF3FhUatmD0FrfujikgEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRonSSG8v-R3bdU7MPQf7aPJqEShGxO18EtKZXdrLDWRw&oe=6B005293"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siY760eGja8Q7kNvwGEJK-E&_nc_oc=AdqyHRRiYeqWhgGfUQ-SAYrWAzAg8d8f0wlrzCU9Duy7SVpqTFW_8G83suFBOSGWlpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD0-rNaV4NNnnojpwVC4xa7RstVmJaXG_n1zXJB2wOlA&oe=6B007D32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-i5A-uGGdkQ7kNvwHlsOxZ&_nc_oc=Adp7nPfNO7sF7JHYFMFd9-XrgeObeWCfSSbwa1JeH-0UHAsKJU5eIwPey_ys4nhtvVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Lsyt_WrVxWZUD9AJbIiF4ky47lCXl2AbSdToUTzNiw&oe=6B007229"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://yrchenworks.wixsite.com/lcam-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://yrchenworks.wixsite.com/lcam-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28694951976811334"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568678_1860290017732731_9005045556428135412_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9sBkjvciVsQ7kNvwFDY-9X&_nc_oc=AdrXWswqmg0ZXCWl6ShY2s9vlOR_6ylSNvdBbDlA97K-WdSVsKiW_yBQGd9pKOlAsKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY5xkFGcn6geo_Y7BJv96ScLT7a-x7sW22haOQGzXHsw&oe=6B0077A4"}, "is_concept": false, "
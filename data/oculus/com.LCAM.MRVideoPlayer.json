oc=AdqwFWDjFdx8Xp4T5gI7DA3QMpfNy4OyckSI6Y7UvaYcExAq427-W8RXXLOj7XjIsUU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9NQymnu7NyVPMbKw0eIVcl5Jfm0Qybthb_9eMGrj1lw&oe=6AB13543"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKvosYIT6zQQ7kNvwF3LTJF&_nc_oc=Adqv6208W-6QY8Ejngs7fy7ai-TfN_U31P-kwIak_3EqoPiSJwt5C91a_X3YzaMbYfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrKLPN0SUo9e3iChLIe0iAw4p2xhAzQQGeqNCrFdnOrg&oe=6AB1568B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2nF25kmQz4Q7kNvwFDPEF-&_nc_oc=AdoBwYI9SvPcv0aL-tS0PGRv2Aw1MR_reVJ3SNizsF5D4RDfIBwcLO2MkMMxSWI4n04&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzWtTEO_moSTLSGhcSHoZJJaOXSHu8QqAqTSVm9zGw-Q&oe=6AB13893"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7R7-e8oALoQ7kNvwHYKdM3&_nc_oc=Adou3RW8oz342UdEEChq2GrevX9tH1sPKXzsdyrlV5QfqEOF23ih6a5yf6_9JvJR4nk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE3m2OVKwwxMi3zYiqkmsYHNaQI5YyyAvcMb4mV2NqTQ&oe=6AB12AF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxcwdoWTFs8Q7kNvwGgwnVI&_nc_oc=AdrXjO_NKCERtpe-TYvNmPPNa1ux2fuSHZhxvryqQS4gEWp2DJgUjPqXuFxWTmvxTps&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuRMixoESmx_BY4SV7e0fQLh2X7xQEzoP8I57oIpOPDA&oe=6AB15829"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
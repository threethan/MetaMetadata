oc=AdqXzjbaO2O7UwhYEVjMOYpRUqKDA0FwE_7u-fp7D8Wypda3WSTjLTFbRJKMa-2dLFQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoV9EfakEIUpoGqXASp8wbF5TSWHaESxaE0OfxGh5KQg&oe=6A58E0C3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc0XJmfRAmcQ7kNvwF9Yo-P&_nc_oc=Adr8PysVHiw5zYMnCbV6isS4NxGOyQVVnPSW99vq8PtKLnnf44ZK5c5N04uisrR9LnM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9k_s6IsbUJ3qT_-Py2whLgBy_m2tMW6tDktkxXSB7Ug&oe=6A58C9CB"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmuCNZx9gQIQ7kNvwHQMx9j&_nc_oc=AdrEvbCLerDbMK5QEQ-nthe8u6XS6_u9E45QfCPko-JvXYDt506WIQIjkskKOL2kW2Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnqWZBgoSSRq0pW-60voTMcQxMJKU20SK-DyHmzb4z3g&oe=6A58E413"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLZDg09m-8IQ7kNvwHlodlr&_nc_oc=Adr6-34FcjZvjFkaxxYdkYxibHv6TpREKTTvqlro15qGxK7hiWrKE6heFhzhsNX33eQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqifxtywvQsHpfQkyHrI2IbB8w2Uu3e0R3N2HelOEa8w&oe=6A58D672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAPDdaQiwv0Q7kNvwEIYIEz&_nc_oc=AdqSRgWv1HCjQJRrakqkwh29Q9iU7YSAV_GsMrDcfZJJpX_1jq-ykOUlcN8QfbYUgfw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCE7HISfgTe82i9dVM5qfi447wQ1ILXYh4NRg5gg9KKRQ&oe=6A58CB69"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
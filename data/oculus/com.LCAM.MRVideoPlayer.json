oc=AdrbMRRAaEHU-p_-ekdFcfnbECJAfUQgS-JLuClWtS1wlmguKQ9YhupfC3aC7AIpKto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3obSHwEcyjrN5HLnqeEmXeZ80LtuuKiau1Rmp3U6dM5A&oe=69E38B43"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RkB3ffJxpAQ7kNvwEudCDY&_nc_oc=Adqv-jskKaFcWRzQWI--76s0DAzDnE8Rd7Mbg_WKY3DLNTsXWz0TKYVrVSfj0Nz3mRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af055dABZKvbWiST9T8ZOvZxPwoyZzic5Ywvl9yOCJVE8Q&oe=69E3744B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0byKP1un04IQ7kNvwElnkMH&_nc_oc=AdqFpZJhzPJXllkGJy_jm8nB2zwy3iU7jIi2XSiBnxOrmdQ-c9N8Bj6dHU5AkOzkwck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25yi1eZ3nyTgYteA1Nnb5Yo4bBXx9JLEvNC6FYZ2xbPA&oe=69E38E93"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGSVk_JYnNMQ7kNvwFMJePM&_nc_oc=AdqK8_QdF9VAHCHjDVJwBQu_6de3yF-7CIk4j4fnCIHV-cGGZ_hsN59M1AStUCXSm1s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lhfgWH0N4Hnb8hek0hxd6xB7J7XnpB90ZucGTuiISqg&oe=69E380F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuL0mnwiWD0Q7kNvwGbUlZS&_nc_oc=AdrRY08ewouqzB4BpP7yInrc8glFkulK4OgtQp0ANwfrnDUd-tlYUESgqzPoacB0qQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sDNMrKBj9TkO_rxQRvWpgMR7930Spku5vJidlzrf7RA&oe=69E375E9"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
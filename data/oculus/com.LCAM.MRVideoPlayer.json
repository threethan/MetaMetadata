oc=AdojQmkx7cTg2cJc6gULQ-sokbTRELTrVwrv-kliN-2iGHSAFGQLimBuBOX2_j94oDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUIJA7MpmD0YquS1aIrb-9pKmAQYnfey-v7BnDzR0AKg&oe=6A64BE43"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Azi8dcEm4o4Q7kNvwED77yZ&_nc_oc=AdrkkDZ2GOqyd38AWIpnsXKOvdM_4s3XO85PjpY0eAC83g-Zt8Rtnbjno6seFo6Ilq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7jN222VeEzsKT-PrBjl7j_r1KtMaB_soIUsxYrL-7bw&oe=6A64A74B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifWRaP-GNTsQ7kNvwHQZq30&_nc_oc=AdrROlF1NtfUl7-M7hu8ghdPEEGGE3aAYNt2_0D7jtZsuu7TPKR3lAooCHm4rpeqsPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB96-PGByfRYfOko_Z-NBbCWOD9ao2ai2-tdGh041rJ4Q&oe=6A64C193"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajKcthXNV6MQ7kNvwFQkZH4&_nc_oc=AdoGxLcuTYaQW9st68yA9JE6ZfLSt6lgUzcYgs_Zx2ctQVWLDs491OPx4nryqdKNE5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtiMu79_gOdgt3hG1abEQmnzLzB0XSKLYMdkpBKK429g&oe=6A64B3F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uy6vpu_pbsEQ7kNvwFamW0I&_nc_oc=AdpRERE7mYLq4bnZM8hTeaccTC23nzWI2O4nM0Kh950DxurnECBIYec5ABJAKN9xtV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9grCuYac2QUI255EmJdvLBKsnK6ISLHRFt6-aiA0OeA&oe=6A64A8E9"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
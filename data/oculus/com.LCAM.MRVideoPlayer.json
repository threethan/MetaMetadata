oc=AdqCYKlO09bqd7D1iI6urtddynVQyQc6lC19qjlZt8RYmvJLSo0C3WT6CHfvh-J-UWs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxU4Qsehe9rd7ewirER5w8MV3Q1WHIuWmsKexdC4z7CIg&oe=69CFC4C3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmPdTRRpPMgQ7kNvwHFsF-v&_nc_oc=AdpxAiHrZK1ksBeTn1WIFEvaZYme9TZ9ib6NoRho9xqAzFXHFazi07f68cvCgmxTGoA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3jKeW1AfAZTgWaRkc6cUjm8rx6_uZRXNtR9-j5SUYWA&oe=69CFADCB"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39rf-eLGOykQ7kNvwGrpdRl&_nc_oc=AdpkU4T8j7ulrGwfPK61hK8AoGMjNjd5XcMOHeo5LIxcC6ErlJmt0JiIHyoD0-JYg7M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYl7LMitWy675aN1O3PNOm-NbgoUWG8z-fxKAPM4PPng&oe=69CFC813"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFx8NJ3fLesQ7kNvwEuR8z3&_nc_oc=AdrPAGg5jBaUZ9MvLh9-7J-vP2wT0QVLu9_EAGV38QcNP488og4SpgS4WUTQaIG2se8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRN-Vm9Z11GeGx7uvXZSsr51YrNqZj0LPzgHIj3n8r3Q&oe=69CFBA72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH-b4pqNLmoQ7kNvwGkXWMh&_nc_oc=AdpPNx0pzYqY14OJZgNOu8yq6dViyZ-7WoyKUBv-CLu8TrqG9zmkvbVUJ6db9V0BF7c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHfi8fr3mAF7SE9_MFbjsdV5wdwkjCSVGtGy5DAaq2BA&oe=69CFAF69"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
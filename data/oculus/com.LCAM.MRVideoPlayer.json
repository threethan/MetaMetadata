oc=AdrLyh8A2lCOo9A-7M7XgqOfyBvHN6tuoCGRRflo3h2Sj1YGEYgHCsjdOznL-2Dn01Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC61MzykjEcJP3bY7gk5dqHcNH9_oD1wWPu1ium5lPZnw&oe=6A60C9C3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmMNgfMHZMMQ7kNvwG1b1bc&_nc_oc=Adpenurc44JbTEH6pTcUVTIL9xDRwljBVgOXmQzLPB6UI5FrmJmWWtehJ_TEL6Am6Gk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-fb4GdxDYK2HjM8C0m79wS0aWxKZ3bpobf7lcOUTzuw&oe=6A60B2CB"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8SkBV4I5OYQ7kNvwH1_gCE&_nc_oc=AdrjQtrVoXIrP8WMbBB9OYjTPX5yoQwkRpIUU5rvNi9MBRd0TAyxQ_8CZbuD4Cpr9YY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYpnfAok0n5lRzEZX6Siwe3vawez_Fj4P2XstMprJDBw&oe=6A60CD13"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMDCCMRN60EQ7kNvwH5s3v7&_nc_oc=AdpB2zihXsFEngCk2V1sAvTu9Z86QZwt051Qkb97L0mexl2HjrYoqmNrx9_x8WRe6-M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUAQee286OaBip4hU2cHmXn10g7WKCou7g-DYS8mdDkA&oe=6A60BF72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGKtE8R-m5gQ7kNvwFFpRfP&_nc_oc=AdoTKOYl4aG1PQNlb-FPAITqvYRdUGP2rTQlu3yThZgCSeg75bDL-QHBAddqNuFpSYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdkxN_YdH_uY-TgsD6LytZ43y7WynUeR7s9E0ghHPUrg&oe=6A60B469"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
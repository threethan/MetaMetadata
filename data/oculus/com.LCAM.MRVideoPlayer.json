oc=AdqWD9rpkBhwE13rTwq603EBskZNNYMWlkRzmkltqbFKZnTN8RZSzAL4KreHRHFgG1k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmc6M9w3O8gDCQpR7NbRFNqYBZhoc4pHspVpwzxEpSjw&oe=6AA011C3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7vZjGIFYLYQ7kNvwEsQZx5&_nc_oc=AdoQlyWtDWiYWxcsJgxvf-M9ZNPThSjVoQ9lU39FJV_CSBlqwa2Y9zF2J9fwLhc28Bg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnqnID9CAtXek6FhJP6s04ldsD84LBjLc_pLq-EmvWAA&oe=6A9FFACB"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rh7GvVuJ358Q7kNvwFzn44-&_nc_oc=AdrrbwcLa72cSVH5jFVzyXqmNgNEtQ-hOPR_USZWwHHO9EmgPWORJeeeMtaf9pAG8GA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJa8-mL5n3uI_jImYlhVRW-lnbcuJjApn2wQBY5BpaLVA&oe=6AA01513"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dco_KQ2KRr4Q7kNvwEvZ3jM&_nc_oc=AdpZ3hNAPG646ODn0Stlm3BuIqq9VS_vA_paW4pgvy3YKU_XMRfh3gprVhopRvBWn38&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4NB7aOXD94rADPslaC3_8iDRVcx1HmvNg8TbfTu8hbA&oe=6AA00772"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6DrbAelbm0Q7kNvwHSytS8&_nc_oc=Adp9wCpZr_Q6yRo5gJXTKTNY60D98OhzzL-65K5INwM2IqsMFNqVmRwRHta2pv_2OsU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1gUlaAn5OzkLscTrL9sX8Rc9OcIGqZw0jM-J082gMRQ&oe=6A9FFC69"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
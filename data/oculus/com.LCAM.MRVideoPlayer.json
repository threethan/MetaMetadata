oc=AdorCKdgvx5t_X8GYo1trugzPLvVdeWUfVqMD-q4QWBmjD1sno7oAYjy1Vlt_wDEwjc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IelLIgXlyWlccQALPy-UFAT2FKllTK0Z5kQJPC2fsrQ&oe=69F9F4C3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHsSdWaZ-lsQ7kNvwH2NBrB&_nc_oc=Adp5LL2CQnBxUreK30TgBh7dHnIDcDXWILm6mG9KWBWDxh1V8UZsp2yihQ9eUW0WFrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X-CyZOcQcAuHLpRlBp9yJYFF4fKQcBj43MWh0-17fuw&oe=69F9DDCB"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu2WU6az5ZoQ7kNvwGGstab&_nc_oc=Ado5pr6HuR6qGrxwZXo2bt5Fk2vpoF7wwG2ZG8BHYmeEzfO6IAuDNSfLAVrirtwBM44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GLoqTj5JS9GCjB8GEF7JVj2PqGpv-djzkAb3sDB-jXA&oe=69F9F813"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wExj6kXB58gQ7kNvwEhX8Gx&_nc_oc=AdpPESHhab7ScKCqBJdjEZS8V5f9VqxWcxmcfxB1iIgK9glL2ZU5w7JgMDYn3BybPyk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zWS1c5Fxv4WsOR__FBAutZbxTGXsjLUX4SdVx7En_8w&oe=69F9EA72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6TLp76rEpsQ7kNvwEKLI0e&_nc_oc=AdrhqDOm-TmFjM5-HhnmdFudKabXZ4lqe-6saqofCxmNq7mh_bMidxeFOc3eAGF9JJI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K34_8xDVneyOjJDni1Y6vRnBoynczxBaMaEFvMJRibQ&oe=69F9DF69"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
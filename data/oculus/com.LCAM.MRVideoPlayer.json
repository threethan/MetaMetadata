oc=AdrromPFJzxNzOfzmyuyQpub1o_bhklhomwedaDDGLyITF3pq5Qm_GtIo888eoMLuiY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8cvqk-koKILNsLb1ZqPJwOwWPmi03WnRxL7J14tl1bQ&oe=6AC4FBC3"}, {"file_name": "shot3.png", "id": "1810207486123877", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974458_1810207489457210_5945387990209679360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TLZGKiXq8EQ7kNvwFxkOy_&_nc_oc=AdoZ7R2fMP4xsgFgJumPCP2qIaREhn1oVEYttJPNZu3Pd1URpLga19cpqhQwYAfvZtw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4YFEpgGx7GXzF0Y07vtxKzqBZ34Hf-EUnV_D6LU7v7Q&oe=6AC51D0B"}, {"file_name": "shot4.png", "id": "3474148299396696", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75221326_3474148302730029_8529145258364693432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln_EFCP1zAAQ7kNvwHbQba_&_nc_oc=Adpn3Wfth2JPRTC0g15RPG1u7RD7ikENH6dtjg-phx4pP4o7oAjuz1gqW7rN9KFX2k8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNonFz_6BhK9zuwBXFgU814_ErGMCrJL_XzKwH3CadjLw&oe=6AC4FF13"}, {"file_name": "shot5.png", "id": "919964143195311", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982706_919964146528644_158944188084046006_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XvW70P0VVEQ7kNvwHTrY4e&_nc_oc=AdqBvIQewF0jGyOQPjD0HI_JX_vZEXdNshlFV6r7o-kfwl1EKgsS4q-wrgk1dTCEZ5w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm6w5htc2qzatzBBZC0KsXYAMYOSiOajMf8k0nS891hw&oe=6AC4F172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER2.png", "id": "764994265576553", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75269159_764994268909886_7552406079357889813_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AN4g9saA_EQ7kNvwEG-KBG&_nc_oc=AdrkpSrKXjrqCLll-TB_z9PWQn4KWWOb-6dkxUNUYy8v4f5ZqmDvQ_QTgMcb9LaKq8M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-6YjyOd6CW6QW3LP9uskU-onxUAHJTyYcCLvMEn_I6A&oe=6AC51EA9"}, "display_name": "LCAM MR Video Player", "keywords": [], "long_description": "This is a personal offline video player for 2D and VR videos. Users can put any video into quest3 and name the file according to the App's specifications, and the video player will recognize it.\n(Video move to here: Quest 3\\Android\\data\\com.LCAM.MRVideoPlayer\\files)\n\nThere are two playback modes: 2D mode and VR mode. If you use \"_2D\" at the end of the file name, the video player will use 2D mode. If you use \"_180\" \"_360\" \"_180OV\" \"_180SS\"\"_360OV\"\"_360SS\"\"_6FL\" at the end of the file name, the video player will use VR mode\n\nWhen using 2D mode, Passthrough + depth can be turned on to detect the actual position and depth of objects, and the transparency can be adjusted according to personal needs.\n\nThe video player supports video preview (jpg/png) and subtitle files (srt), as long as the names of these files are the same as the video", "short_description": "You can use USB or URL to transfer 2D videos or VR videos and combine them with real space (Mixed Reality)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://lcamstudio.weebly.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "LCAM STUDIO", "support_website_url": null, "website_url": "https://lcamstudio.weebly.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7473600792
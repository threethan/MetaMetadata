1E2"}, "display_name": "Fun Zoo_Ver.1", "keywords": [], "long_description": "FunZoo(VR/AR)\nFunZoo is a game designed for families to enjoy together. Players are zoo keepers whose mission is to feed the right kind of food to the right kind of animal. Through the action of throwing, this game will test players' hand-eye coordination. With adorable interactions from animals, everyone will sure enjoy FunZoo!", "short_description": "FunZoo(VR/AR)\nFunZoo is a game designed for families to enjoy together. Players are zoo keepers whose mission is to feed the right kind of food to the right kind of animal. Through the action of throwing, this game will test players' hand-eye coordination. With adorable interactions from animals, everyone will sure enjoy FunZoo!"}]}, "developer_name": "Fun2 Studio", "developer_privacy_policy_url": "https://fun2studio.com/info.html", "developer_terms_of_service_url": null, "publisher_name": "Fun2 Studio", "support_website_url": null, "website_url": "https://fun2studio.com/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6699905653396723"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031437_699127862235856_8866709915072254728_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QezkE6Lq2HYQ7kNvwGVQdjM&_nc_oc=Adr_vhxSnlNGR29X2DxLqYvUem1aMYv3tw2GV3w87upM4Bb
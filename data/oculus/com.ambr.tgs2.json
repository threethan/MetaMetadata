/scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75302225_1133523007266478_8935520124535184144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wp8zm_WX0dMQ7kNvwH6-FPq&_nc_oc=Adl1NCHnQZyRoI9DgoP7ARUVdSsz1ZSHOE_lUsTlHiSEJiucNE4U_zBAcG6aZ_a7m30&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsvWkuITnbfWrylDj41oscjePv3bybJiq7YRaK-VXDAqg&oe=69A58ABA"}, {"file_name": "20220829-234800.png", "id": "614289400257365", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974924_614289403590698_7228106746749522556_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwB6bhK18voQ7kNvwF3Q9nA&_nc_oc=Adkj4XLiJ3mhe-tXtKiUuWQvLnSPNik7oTaxfy0LMoZwL2kvEVpBzG6XhMbjCdGOUbs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuCetYnaO77c3GxttR3OgLdf9USpk3IelzJDlZ-Tmt2sQ&oe=69A56D24"}, {"file_name": "b_bloom.png", "id": "521486566409432", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974844_521486569742765_7179524105465731980_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kjlsn4TW5xUQ7kNvwFnB1Cd&_nc_oc=AdlEeGHXF8WTpLKuHrXhiZ1YHqq-_OKpM9wKv-iQ7ZeOC_TPbm2bwx-SAMnmLMrAqxE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvHzxew_bYXmtROp70THZXxxvmbD3L09aQLG2bJlJjYXQ&oe=69A59C9C"}, {"file_name": "20220829-235223.png", "id": "349174444000845", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035421_349174447334178_5455449181583213884_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlZp3t_KJ_oQ7kNvwF2ixF6&_nc_oc=Adn1SuNsOfclX6_jdxwfAhMkbhsgP1ITUQO5Pn7s-OA6uIzdANsJJOQcK-6z7wDZKYU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftnLcOFr3T75hNo7RHPCBsH03BKtV_JbaclZen6bjsFlg&oe=69A56D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220817-124152.png", "id": "477277443868888", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974721_477277447202221_2566098246160369602_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKjSzpWThfgQ7kNvwEd_NRZ&_nc_oc=AdntpJA6XbFpHgioOe_ZoPNuqYxiwPL9Dr6Rtx5oEHkE7Iek9M6YHHO-ayKfLN8JqRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft3rKombBoO-F2qwFnA0OEm_K08C7OlDCWO_4fI-3bdbA&oe=69A570A5"}, "display_name": "TOKYO GAME SHOW VR 2022", "keywords": [], "long_description": "This is the official VR application of TOKYO GAME SHOW VR 2022.\n\nAn evolved Tokyo Game Show's virtual site is returning this fall!\nYou will be an explorer searching \u201cGAME STOPE\u201d - the dungeon spreads in the underground of Makuhari Messe Event Hall.\nLet\u2019s enjoy visiting booths of various game companies, a special exhibition where you can look back at the history of games, and more!\n\nOnce you enter the venue, you will be greeted by famous characters and will immediately feel the drastic changes from last year.\nAdding to existing functions such as Voice Chat, HELLO, and Stamps, there will be new features that make the Game Show more enjoyable and playable.\n\u00b7 Avatar Customization: Freely customize your avatar body parts and outfits!\n\u00b7 Quest System: Advance the story and earn items by completing quests!\n\nEarn Three Sacred Treasures and check out what's at the bottom of the strata with your own eyes!\n\nEvent Period: September 15th (Thur.) 10:00 JST - September 18th (Sun.) 24:00 JST, 2022", "short_description": "This is the official VR application of TOKYO GAME SHOW VR 2022.\n\nAn evolved Tokyo Game Show's virtual site is returning this fall!\nLet\u2019s enjoy visiting various game companies' booths and a special exhibition at \u201cGAME STOPE\u201d in the underground of Makuhari Messe.\n\nOnce you enter the venue, you will be greeted by famous characters and find more enjoyable and playable elements.\nWith new features such as Avatar Customization and Quest System, the Game Show itself will be a gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ambr.co.jp/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "TOKYO GAME SHOW Studios", "support_website_url": null, "website_url": "https://t
/scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302225_1133523007266478_8935520124535184144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmrPZGiVTAIQ7kNvwGaYJN9&_nc_oc=AdkzUGlu2Vl67BRE0o4mPFoUszf0v_XEuJdskJj9u5SG2fr1qu0dBbvF6jTXQSQDpKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfveLkft5IotcZ8PuuFHkoVdgEEO8RM-3jADYhHSyfJq1Q&oe=699AFEBA"}, {"file_name": "20220829-234800.png", "id": "614289400257365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974924_614289403590698_7228106746749522556_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5E8V2-wtR2wQ7kNvwGO1ueC&_nc_oc=Adn4Oo8BHojIwMzZ4YmfhpY9xxV4Uj2qU4B7MyqDnb9jWZtOJ40OyAsxtZCgNEQxYb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvxOMuTEZG3EgW5iGedU1-g5F6GaAFvjKKqxfv2OadG6w&oe=699AE124"}, {"file_name": "b_bloom.png", "id": "521486566409432", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_521486569742765_7179524105465731980_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyYAqElDmEoQ7kNvwGQ_1dW&_nc_oc=AdlwbAa1TTAav5d9Z0w0swTyu6zKr5nXDVI4DZDo1s_o4keCuX47diANuFL2HWjvpmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfusEvQt9SlH8OYRsXL33V4GMYZcjKIWw1ZU7Pv85gwnXw&oe=699B109C"}, {"file_name": "20220829-235223.png", "id": "349174444000845", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035421_349174447334178_5455449181583213884_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YRuYWkxhD8Q7kNvwFjmQzR&_nc_oc=Adn6pBAiPbZV6ZhmTzV89QTLjB5leLrEiARmKwafiBPIzAq-eAgJvvS0bTmvI_b34dQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftRRxTeYJUTd-M3-_mdWJC0wNxnKZrdaoDUd2EIwiu6fw&oe=699AE199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220817-124152.png", "id": "477277443868888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_477277447202221_2566098246160369602_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FU3Gi5NQSXAQ7kNvwEqGrDF&_nc_oc=Adlz0UG1E5e2dxNUuiEf3AR6bICeGn9qCC1ZA6i4ZNkPzBvLyPW_GiePvNs7Wrme8i4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs9vIJj8kMEoZA7yTCf7K-5zQRBPfJ1rbGLNSquTcAe2Q&oe=699AE4A5"}, "display_name": "TOKYO GAME SHOW VR 2022", "keywords": [], "long_description": "This is the official VR application of TOKYO GAME SHOW VR 2022.\n\nAn evolved Tokyo Game Show's virtual site is returning this fall!\nYou will be an explorer searching \u201cGAME STOPE\u201d - the dungeon spreads in the underground of Makuhari Messe Event Hall.\nLet\u2019s enjoy visiting booths of various game companies, a special exhibition where you can look back at the history of games, and more!\n\nOnce you enter the venue, you will be greeted by famous characters and will immediately feel the drastic changes from last year.\nAdding to existing functions such as Voice Chat, HELLO, and Stamps, there will be new features that make the Game Show more enjoyable and playable.\n\u00b7 Avatar Customization: Freely customize your avatar body parts and outfits!\n\u00b7 Quest System: Advance the story and earn items by completing quests!\n\nEarn Three Sacred Treasures and check out what's at the bottom of the strata with your own eyes!\n\nEvent Period: September 15th (Thur.) 10:00 JST - September 18th (Sun.) 24:00 JST, 2022", "short_description": "This is the official VR application of TOKYO GAME SHOW VR 2022.\n\nAn evolved Tokyo Game Show's virtual site is returning this fall!\nLet\u2019s enjoy visiting various game companies' booths and a special exhibition at \u201cGAME STOPE\u201d in the underground of Makuhari Messe.\n\nOnce you enter the venue, you will be greeted by famous characters and find more enjoyable and playable elements.\nWith new features such as Avatar Customization and Quest System, the Game Show itself will be a gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ambr.co.jp/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "TOKYO GAME SHOW Studios", "support_website_url": null, "website_url": "https://t
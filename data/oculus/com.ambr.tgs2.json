69BBEBFF"}, {"file_name": "20220817-125326.png", "id": "1133523003933145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75302225_1133523007266478_8935520124535184144_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHlGI5ef0KsQ7kNvwEOy95S&_nc_oc=AdlKg6FLGWd_LhgmQPygiObtEHcqny2GyBtqTczWs3yQddFVoHjY1MyQSomuzaToyv0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzeb5Z1zF4jg9hM9p5WY13P652-gYFLEocii8-65oWmVw&oe=69BBF43A"}, {"file_name": "20220829-234800.png", "id": "614289400257365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974924_614289403590698_7228106746749522556_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-eL39OgzMPsQ7kNvwF3mMDq&_nc_oc=Adk57_X2azge1OFreJgf6H5ggO7TDeNLQSRxYm21epLePaCwy3KyZpvquoiu7In39-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afww9AsNLsKDBelbftny82WuIgg6zRAHsvBBwg8wu1P2iA&oe=69BBD6A4"}, {"file_name": "b_bloom.png", "id": "521486566409432", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974844_521486569742765_7179524105465731980_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jwb7tTwdIIQ7kNvwGbB9lJ&_nc_oc=AdlDitIrrcRN36io3I9BBCrmJm1t6iEDd28dYFnJo_E3gbrmxcVNNVc3vc8TCx3ADqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9IXgvfypnO489S79KRyDT1vHwRzVinzMw0AMnhB-Xcg&oe=69BC061C"}, {"file_name": "20220829-235223.png", "id": "349174444000845", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035421_349174447334178_5455449181583213884_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lE-fSwueJz4Q7kNvwEpNFEC&_nc_oc=Adlm5f-R3_i18bDS_rxQPcM4tBRJq7C2gSQOl9EwBhjJAzY1AXMuvwhRH3zLoqsbNds&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy41fBRZtkft2TDEoVp0TjgIqA1ft0IOl9fEhukik15Sg&oe=69BBD719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20220817-124152.png", "id": "477277443868888", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974721_477277447202221_2566098246160369602_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chEmN7fO5OMQ7kNvwHk8t_1&_nc_oc=AdmfFIlglUlHSDvoeCk_Gr6FY8MKJ7OxhYaHsfnN8UoXYNCwUehLUo8oqV4mmXAO6hg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyADlIYpkxQhtTy4m15UOR1FKetu3X-ThGpcLzBsSyjVg&oe=69BBDA25"}, "display_name": "TOKYO GAME SHOW VR 2022", "keywords": [], "long_description": "This is the official VR application of TOKYO GAME SHOW VR 2022.\n\nAn evolved Tokyo Game Show's virtual site is returning this fall!\nYou will be an explorer searching \u201cGAME STOPE\u201d - the dungeon spreads in the underground of Makuhari Messe Event Hall.\nLet\u2019s enjoy visiting booths of various game companies, a special exhibition where you can look back at the history of games, and more!\n\nOnce you enter the venue, you will be greeted by famous characters and will immediately feel the drastic changes from last year.\nAdding to existing functions such as Voice Chat, HELLO, and Stamps, there will be new features that make the Game Show more enjoyable and playable.\n\u00b7 Avatar Customization: Freely customize your avatar body parts and outfits!\n\u00b7 Quest System: Advance the story and earn items by completing quests!\n\nEarn Three Sacred Treasures and check out what's at the bottom of the strata with your own eyes!\n\nEvent Period: September 15th (Thur.) 10:00 JST - September 18th (Sun.) 24:00 JST, 2022", "short_description": "This is the official VR application of TOKYO GAME SHOW VR 2022.\n\nAn evolved Tokyo Game Show's virtual site is returning this fall!\nLet\u2019s enjoy visiting various game companies' booths and a special exhibition at \u201cGAME STOPE\u201d in the underground of Makuhari Messe.\n\nOnce you enter the venue, you will be greeted by famous characters and find more enjoyable and playable elements.\nWith new features such as Avatar Customization and Quest System, the Game Show itself will be a gaming experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ambr.co.jp/privacypolicy/", "dev
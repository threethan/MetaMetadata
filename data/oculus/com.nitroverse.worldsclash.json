=Adq7BBgqDc5jC1vQg4AWIeoFQzIptQNIBiIq5tGUzbj2cHzDC7USE_wGFj1imnnM58o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlxDVqWxrO7bhEJP_i0EiudSBCtBHNG1Z1L0j1HRTFWw&oe=6AFC887B"}, {"file_name": "Lava Tech Screenshot.png", "id": "1835417640960628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499293825_1835417644293961_9103085122823386216_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYjqT2-HIXEQ7kNvwHXN-oh&_nc_oc=AdoSjFa9BPp6S9FP7d9SbSM7bd5itjKY8kSJ3M0zB4xVGV322Dmhe_Wl_WXCYNARQqU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr5zMVS9Se21h8EAOjeIvpUN-tk0wkNrRr5ZsP50Qmmw&oe=6AFC673F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NitroVerse Worlds Clash Chapter 1", "keywords": ["Sandbox", "Nitro", "NitroVerse"], "long_description": "NitroVerse Worlds Clash is a multiplayer journey into a vast and unpredictable multiverse where nothing is ever quite what it seems. \ud83c\udf0c Travel between mysterious worlds known as Realities, each containing unique planets, environments, civilizations, architecture, characters, and secrets waiting to be discovered. Explore unfamiliar places, interact with NPCs, uncover hidden mysteries, and experience worlds that may change the way you see the multiverse itself. But exploration is only the beginning. \ud83d\udd2e Soon, you will have the ability to create and build your very own Realities, shaping entire worlds and deciding what lies within them. However, traveling between Realities comes with a risk. \ud83c\udf00 To cross the multiverse, you must discover or create powerful Rifts unstable gateways capable of connecting distant Realities. Choose their locations carefully, because creating a Rift in the wrong place could have consequences far beyond what you intended. A single mistake could threaten the stability of an entire Reality... or something much worse. And then there is Glitch. \ud83d\udc41\ufe0f No one truly knows what Glitch wants, where he came from, or how much he knows about the multiverse. He may offer guidance, but there is always a reason behind his actions. Do not trust Glitch. As you and your friends venture deeper into the unknown, you will encounter strange worlds, unexpected dangers, hidden stories, and mysteries that may connect everything together. NitroVerse Worlds Clash", "short_description": "NitroVerse Worlds Clash is a multiplayer journey through a mysterious multiverse of unique worlds known as Realities. \ud83c\udf0e Explore unfamiliar planets, discover hidden secrets, meet strange characters, and experience worlds unlike anything you\u2019ve seen before. Create or find Rifts \ud83c\udf00 to travel between Realities\u2014but choose their locations carefully, because one wrong move could doom them all. And whatever you do\u2026 don\u2019t trust Glitch.\ud83d\udc41\ufe0f\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/nitroverseprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "LavaMonkeVR418", "support_website_url": null, "website_url": "https://sites.google.com/view/nitroverseworldsclash/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1253858171149061"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"statu
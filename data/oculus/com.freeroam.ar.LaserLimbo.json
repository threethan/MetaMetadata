": "799333922024084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974835_799333925357417_6838248202620419814_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k290j-kzn74Q7kNvwHcTIet&_nc_oc=AdripC6jjmWb6zd7r5-wUTEY6ZUNxq2lPRayh3Jz7AaTRliHCG_bh2qMvIjSv-_Cuwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtzCKLX9U2WfFs472DpN9F4teAsv9spj_JlS6TjlCUVg&oe=6AF8801C"}, {"file_name": "Compilation 2023 oculus wide (0-00-30-08).png", "id": "416339817629205", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031553_416339820962538_6454065026989816328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpuH56Wj5XAQ7kNvwG-KHKK&_nc_oc=AdrxFhOrpfWJHCBTzr8GmpN22_PFHNhLcF57TpJTKFNG3Jjwf1rF_MufxGrSWcGahDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmiJM7hcDMF7hCE6ggAz-beUQsy9WiNa2lIjeY1jP5mg&oe=6AF8AD7E"}, {"file_name": "Compilation 2023 oculus wide (0-00-04-29).png", "id": "1544565856112534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210394_1544565859445867_4542355005518720892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ftjo67IoeUoQ7kNvwEgskg1&_nc_oc=AdrVE0atGrhiwIL_EJwR9-OZmSFyitkggWEds-tU34CG6mFUXEOXOipIe0FSKTf15Q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWD1hBpsgGAIx-DChP5zZhKniz068b-hY7iU1_ZgEhhw&oe=6AF88D6B"}, {"file_name": "Compilation 2023 oculus wide (0-00-12-07).png", "id": "827909709350946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031553_827909712684279_1375813226688130100_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eacx1UjNPvIQ7kNvwGZ4ZLG&_nc_oc=Adqt5dSwiT2wMXlLtwfhLpG0YjO6S8esMPzNyY9a6PYvAl6ND8lp4VQn-YPl8WqD6_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReH-zFVDJvCWKDP7gDYkOpfxIi8wQbPisBTUrHdSbfYw&oe=6AF87B21"}, {"file_name": "Compilation 2023 oculus wide (0-00-00-00).png", "id": "438205571894106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974521_438205575227439_1776630697263311931_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4UW_2NxNjMQ7kNvwFAxNtX&_nc_oc=AdquSe1pLeTEZdttBd5z2ZlmhA4Yi85TVaZNbZGAerUOd-0q2YRFDLG-05448TumSQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdhwYmfyAiWdxWmyt9MDEkzY3VsPToqCAH-mbrOUe-QA&oe=6AF887AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Compilation 2023 oculus wide (0-00-04-29).png", "id": "1458145795082435", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982520_1458145798415768_6343355900190619901_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apNQwYCkdMIQ7kNvwEXSr-Q&_nc_oc=AdrgSphBbgOWC4ES_K6m4Pn0VI6oBvirEMkPGEXDyvsGDBFsfBTRtkTWWVPlF0nqTMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9pQUliqCA7yaAb8guPO5WbZcTAb6GgSn6lPJM58n5Iw&oe=6AF87A92"}, "display_name": "Laser Limbo", "keywords": [], "long_description": "Laser Limbo is an augmented reality focused multiplayer game. It transforms every room into a game world through the associated level editor. The players see the real environment via video through the VR glasses, but this is enhanced by virtual game elements (Passthrough AR).\nThe art style of the game is based on 90s 3D pixel graphics and gives a rather playful impression. Martial and realistic depictions are deliberately avoided. \nThe game element that connects the different game modes are laser beam traps (as known from agent films). The players have to move carefully and skilfully through the room so as not to trigger the traps. They wear waistcoats in game colours that explode when they leave the game.\n", "short_description": "Laser Limbo is an augmented reality multiplayer game that turns any room into a gaming world with a level editor. Using VR glasses, players see their real environment enhanced with virtual elements in a 90s 3D pixel art style. The game avoids martial and realistic depictions and features laser beam traps from various game modes. Players navigate skillfully to avoid triggering traps and wear game-colored waistcoats that explode upon leaving the game.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeroam.ar/data-privacy-quest-app", "developer_terms_of_service_url": null, "publisher_name": "freeroam.ar", "support_website_url": null, "website_url": "https://www.freeroam.ar/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7852382358106757"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1480939637293723"}, {"status": "PUBLISHED", "id": "2227402898047803"}, {"status": "PUBLISHED", "id": "1315386473802535"}, {"status": "PUBLISHED", "id": "1466975508344618"}, {"status": "PUBLISHED", "id": "1260409849233819"}, {"status": "PUBLISHED", "id": "1796650154344958"}, {"status": "PUBLISHED", "id": "1758953334819522"}, {"status": "PUBLISHED", "id": "964231852406488"}, {"status": "PUBLISHED", "id": "1295526204459364"}]}, "baseline_offer": {"id": "1796650154344958"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1480939637293723"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29782157144702630", "version": "1.2.39"}, "id": "988139642566443", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6619911051353900", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29782157144702630"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "988139642566443"}]}, "change_log": "Laser Limbo 1.2: New Look, New Room Editor & Easier Play Together\n\nNEW\n- Rebuilt Core: new network and player logic for more stable matches and faster updates.\n- Glossy Materials: a new reflective look for guns, vests and drones.\n- Room Editor, completely reworked: draw walls and rocks as a line, add floating and round obstacles, grab obstacles to move, resize or turn them, and pick items from a new palette. B switches passthrough on and off.\n- Use your Meta room: the room editor can take your room from Meta's Space Setup, with your furniture as obstacles. No need to draw the walls.\n- Play together without calibrating: choose Meta Shared Anchors in the Tracking tab on every headset. The host's headset sets up the play space automatically, and everyone who joins takes it over. Re-align anytime from the menu. Needs an internet connection.\n- Marker Calibration for Quest 3: a comfortable way to counteract drifting, using printed markers.\n- Your player name is now remembered on each headset.\n- Rounds now last 10 minutes.\n\nFIXED / CHANGED\n- Fixed the game world vanishing mid-match, leaving only the menus in front of your eyes.\n- 3D sound: hits, explosions, drones and swords come from where they happen.\n- Health display on every weapon and on your wrist.\n- Smoother performance with many drones and explosions.\n- Players no longer lose their guns when someone joins.\n- Many smaller fixes and improvements.", "created_date": 1794230695, "id": "29782157144702630", "version": "1.2.39", "version_code": 52, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6619911051353900", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29782157144702630"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "988139642566443"}]}, "change_log": "\"We're excited to release a new version packed with new game modes and many improvements.\nWe believe we\u2019ve fixed nearly all existing bugs, making this our most stable version yet.\nWith the addition of new game modes that complete the Laser Limbo experience, we are now leaving the \\\"Early Access\\\" tag behind and proudly launching version 1.0.0!\n\nThis does not mean Laser Limbo is finished or that we're shifting to other projects. We will continue development more than ever, following our internal roadmap while incorporating player feedback.\n\nNew:\n\u2022 Laser Sword Solo Training \u2014 based on the existing solo training mode, you can now choose the lightsaber.\n\u2022 New Coin Clash mode (gun-free) \u2014 grab and throw coins to feed your living piggy bank.\n\u2022 Pop N Stop mode (gun-free) \u2014 inspired by Squid Game. Pop bubbles, but don\u2019t move when the stop tone plays.\n\nFixed:\n\u2022 Player state bug where players were stuck at match start or unable to change teams.\n\u2022 Fast bullets sometimes not being detected by colliders.\n\u2022 Adjusted slow bullet speed for sword fight mode.\"", "created_date": 1765211549, "id": "25938180679100315", "version": "1.0.0", "version_code": 51, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6619911051353900", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29782157144702630"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "988139642566443"}]}, "change_log": null, "created_date": 1760355521, "id": "25426065853645136", "version": "0.40.5", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6619911051353900", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29782157144702630"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "988139642566443"}]}, "change_log": null, "created_date": 1754416123, "id": "24817361811182213", "version": "0.40.5", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6619911051353900", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29782157144702630"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1754139027, "id": "24790471970537864", "version": "0.40.4", "version_code": 48, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
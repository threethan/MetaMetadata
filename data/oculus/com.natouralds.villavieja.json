56sQ7kNvwEAEjDY&_nc_oc=Adoy_PvsqGfB_gUrQIb9TtiPM8y_6qIoxWl0AMRxmRCgiVOccyf3inUbPBnX7wAWuQM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMW6FW3tXs9HZCL7im1W5iKaG9wbOH9SVOHjHaNh4wP0g&oe=6AD3BAD4"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGBGHBCJJ20Q7kNvwGKu8iq&_nc_oc=AdpcPQzZiox_SrfFGll3jsikVsS10pCLOon1Xcq4iqhV5C7-r2esWCEjEFs7hS_u9Kk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYgyK3GJTLVvBrNJb4c0P_i3nfKFeu-2MGb6k39ujRaw&oe=6AD3A540"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPBYMnufnIQQ7kNvwFCurmm&_nc_oc=AdrvL-HFgEbLZIpuDmHdLUJgKatli_oImoLjpEAEbmXbqe8baJ82vAM9pJnprcDQCRc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6z8POaPgTyrjsEhXVs9b1cKdWE1WPGXPaiHhHwzTxnw&oe=6AD3B742"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wezye5IPwUwQ7kNvwE5lX9m&_nc_oc=AdqxZu8u4I1I4e08DkYqBcOQK-YdL5X2FJWeK-UtD7qpW856Til8qHe0Qo8zRFG_o_M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7iAhjYiLT0ACO7EkPfCYlh8pRMH6VGfiBsSqSRKqBAw&oe=6AD39792"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnSfMwBmR0EQ7kNvwHWtdGG&_nc_oc=AdoyPxvxqzLsgAa1_MLRkohxJTceL2yI52MZUd9BR1l75B4ChFUesXdTGguAsm5Y3dA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPARIZZWbYdLBbrESC6hHjI2R8V_LhTDpqkXoj15ZQyYw&oe=6AD3A270"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
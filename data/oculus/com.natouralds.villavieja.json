3IAQ7kNvwECcwiG&_nc_oc=AdpBIiyE0FY1dDfErZ6qKu6hmFTz8qxGKgCWMRkitmbEMVo37y_3a3Xzr87DgAsLRDI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_3ArIeLbj4jXJnfz-RK4jRav-ImOaCxlZ_XRlvfC3cQ&oe=6ADCBD14"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDzJKlUC4W4Q7kNvwF_OpjI&_nc_oc=AdqFEtg98koSiWjtZREMc_bGqRA26FaPz5TsZHZFtHIHJgjZcKemQiosBP-09gj-vf4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqX-SCd8Rf_Y_lEfzp-n5_7M4dIe9DGofMGDHxSrwX6w&oe=6ADCA780"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywB0xTtte8wQ7kNvwEslsne&_nc_oc=Adrm4hJPqF-Dgj5DJ47kiQdGs_u8XeIie7KhJXgPwmNXaGQJTbCkvUGZVC5FLxzQYaY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgQpmVFQDyqtQvMtv6oLQbs5cNsLeN6zm2gQwwxKYPYw&oe=6ADCB982"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFB4PluW1rkQ7kNvwElxhzj&_nc_oc=Adq6Xnom286NFzSJUg4HE24Ys4v12lAoSyg1dzkYg2p8lakg-fWJQQKk3aYKZ9HIblY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBIuDQ2w3lHlgTaug0Ifwp5A6suy7S9mqRQxU4GtlEtQ&oe=6ADCD212"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc9OoNYGnNwQ7kNvwF6d6VB&_nc_oc=Adqcp2_BDUaZ4UVdgMwq9ENME6iBwIbzKVhskTt8xUOrr92kEnQ0Jmm_QL69RNucWDc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOolq139YJMXkih5e_cMT5NpwpXT9rZFUV1fk4y_uyMCw&oe=6ADCA4B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
lUoQ7kNvwGjyOpU&_nc_oc=Adpn2FyPUQQsILs4-V9jC7EzRd7r_2SX6mg81TD5CiefGqyRFsftb2zM0Ccwu2aB4PE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgYrjz-JO-M98rn4jfNJdgvwABKfj_bed0SXsSV0BbcQ&oe=6AA55E14"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF_Vv9Pxbq8Q7kNvwFWMl05&_nc_oc=AdqFkVMptXaV3BUOMOXC3gUOI4j8pTG2NYSqKHp2qG6PLNHPve-p1QEtfC5n5IxYelI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKF18QFWwfr3tykCS8qhv0X2cumM_M4t02P9sTrWMVj0g&oe=6AA54880"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGH1nNxFBegQ7kNvwGZRLut&_nc_oc=AdptgCRepWRhA9OTeMd3qJvbT3tOUtkVUrcH07Bk6iePAuBcQYibuktdw3XhL7SbuR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKb1fQm4ITtO296VoGYrkYAVB7a2-2KK5gTnv0Ts09tA&oe=6AA55A82"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ym8t9ZiOYEQ7kNvwHtcSmQ&_nc_oc=AdozuW9vfQWCi1nkPcF-P89cMjrHw-leRSiLaBDf6A-GjR43BNova40U94H9iwtomWQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBt_MVsvxq6U7AE9Cb7fSbs8CkDmvewrbyAMhipcRH2w&oe=6AA57312"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT-3HXvpycUQ7kNvwHB-szM&_nc_oc=AdqhAm7RQXcuqlXjBOvAA_5oXF0GrOZ96UMBq9rq7XAl9GDWUa6SQFVuueZ5x0nb_aE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3-arlVAnQXN2ow9Di2Yx_Apz87k5Yc41Dsh87ZN1fOQ&oe=6AA545B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
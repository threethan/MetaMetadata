6sYQ7kNvwHpu5bD&_nc_oc=AdpCheLwCPoacnRqxBhdk7U55jN4lrbDOF-AaoV5eOIFnoJdLRtNqNCj7PaF1hvYssA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNAdiu4KTpO_t_OHcfHib6u4u_Ovuk3LLn4NbsmFnmYg&oe=6A7B2E14"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOgISXtpmCIQ7kNvwF-86Lk&_nc_oc=AdoaaXl0o6h8jp220M6jiZCQrES56z3XB-dpwDsdFMvG7xTmXovRYa_SjKFoKDwpI6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUhy-sAv2ex37FaIT0o0X4aAtzd76rXIDkM0zwZZ_Nyg&oe=6A7B1880"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGgtvervUkUQ7kNvwHRRV2S&_nc_oc=AdoUzsgBU40X7cuwXqKqDMU68gwlr0EUYgO3iXN5sboelZl5KD03P4b1Q8u7VLhVHrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDu7F1yyBNQ0-ZLm06tuKtbvI3eZ_hTpQge-lbJf2BKg&oe=6A7B2A82"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex5fdgENn5QQ7kNvwGcAPUB&_nc_oc=AdqoM29s9TmFUbmh8kSKt-LymPeRdDHIl_T9rRl5Sn63mpbXLyxB7xx7HAzQx-aRc1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQo-b8oFvqDbihfOQNEePF63HEhSfv3GpFdgDiF_YuHQ&oe=6A7B0AD2"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yLsf-uQQd0Q7kNvwHmAPMy&_nc_oc=AdqFt01DHZDtL7TfSnqtOoU5ck2oIptO6GNJ-sBkNynwg9abOiOH1gwx2YUqCiE8nbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyfX_nkM3KF40b5eVEc8SRqnbAGHTiWDib6aQ0AkbAmA&oe=6A7B15B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
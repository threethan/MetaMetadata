uluscdn.com&_nc_ss=7f20f&oh=00_Af_EDmUw3XYuYu3LxqFaIvCN6BFerNC9w-F_eMM_06EF2Q&oe=6A354E94"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISVkOTScmSgQ7kNvwHvpswM&_nc_oc=Adr7Qa9ZFuR4ft7N088h6qBDz2CMuh1Pan2zPfZPJMwi0xD2BN3EmRApMvcmmz1JhKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KaXNggNEry447cI9SPU-iWto5ZFT43J1DF6ZyuP9SMA&oe=6A357140"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wz4GySL3RU0Q7kNvwE5jlpN&_nc_oc=AdobyDrsxzfoirbQrU8tl0xlDrob4RsX-BTDzbMIkyljUCt96ex0xeLy2dckNsfzHp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AUiVu6xJjjMks5IMnHhiyyz3hrZ2rbywiI7p9EzJPIA&oe=6A354B02"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSdcFCDRu_UQ7kNvwGL7FgX&_nc_oc=AdoelOf0VvBXfyZ4p5ddPAONYooNGwCg5cr86yHdIEgr_mFAMxNEyvaMKW5hY9Nzz2Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1QX8Pa1abBZPfXMv_JenveangPYBSB2ECTF4XMK_5YQ&oe=6A356392"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxFR2qkENvgQ7kNvwGnqnva&_nc_oc=AdqwqThREj-U3eicC9-de-CBuS6a8m636rrT4LPsQFwlr0kwQ90BXDyCicQPhK__OpU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y7QZQlS6df1C70Ez_R1hFPsc6E5gTe70q9fXGNhAtpA&oe=6A356E70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_
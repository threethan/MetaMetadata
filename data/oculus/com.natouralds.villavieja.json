HSoQ7kNvwF8EV0G&_nc_oc=AdorN336Fipm5GLZTdYIqyF4yCA3IidrGbCIDlwkPaCjhBonDdF51xRzcYZPCse2Mdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiO6dmmSL1gmzGd6peogcRN20ZZP9mN2sec50-gjfOHw&oe=6AA2BB14"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-39xKHitsIgQ7kNvwGSN5bF&_nc_oc=AdrZJXoVX4DhzHaTWXC6rFe-VOmJmd-8vXwSpETGNrTNNk7ruiQ4lMYKC7xafaq1Oto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy9vNqvk7BTaJXFEwzrgy7CimumJGI0dP8f74lfLDf0g&oe=6AA2A580"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvOYwzjnHsgQ7kNvwEyH9OY&_nc_oc=AdpGOFbEmcpptJwzBI-ZBDbz3IOlzUGhdzCtLrgV6mnLNF5EudMzT_EYpX2OLX-JCko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO9nWL1tsfELuyrtuYHbsS_yIAkOvNPyBfPAwZMXQgZA&oe=6AA2B782"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAXHrJUQ8aIQ7kNvwG8YrlO&_nc_oc=Adra9ZnbXKoxa7kldM3ozw_BKJiqmNnWYXf5GqMWWYz9iKn0J0joX2hFeR3Z9dbeDWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSxV_Rb9Xo9TSZOqAx12OFWgc4pHE8tHVz_XhTSb9vPw&oe=6AA2D012"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT-3HXvpycUQ7kNvwFpo6Ab&_nc_oc=Ado1hvFgYb4CNhpkyQblQ-EP2aZcazoUNVKorSfHqM5ki218T9zqxNUHI4cHoWGVkVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0AMmS68E9jl6aBxUSn1WvPJEALr9qbJhYks21ZmeAjw&oe=6AA2A2B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
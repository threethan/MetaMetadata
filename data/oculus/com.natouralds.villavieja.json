uluscdn.com&_nc_ss=7f20f&oh=00_Af-kHlZXzZTXQmNQTogpkqvwMABBCpn6yU3UfUEUDU0FBg&oe=6A3FDA94"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COLilEBNDcUQ7kNvwGEosvj&_nc_oc=AdrGo50C6c0scLp0V7Vu18AfuAegOU0LHjfURk0_1VqFZxxLd9mOvUBDaZGqEJazH70&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lc9vLIBKnTCFd_DXyOcxvWCGiuGNBqi_Spb3SD1rcoQ&oe=6A3FC500"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI2nz04k4g0Q7kNvwHLaoE-&_nc_oc=AdoNU-H7BSOLkiXGuWl1nYgZTVhXU1_JgAgnBqxbrfPaID3gJPgSQ13cnKX4rWZre4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RaIp8Kl7Dmh-okeYPQHrgL5UTlY0tV6USmZBZy5Fe2g&oe=6A3FD702"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCcwa4umybkQ7kNvwFW3iXe&_nc_oc=Adpl0Zj6Am5sSM8J2Ku23DoDs9c9UlG6A0A4BIX8k9S8C7ke-GL3p-e-ErLr6q3g3uo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wYAcj386Q6AlhMan44_w2aF_gqYj2rPIigP3ELVdpYA&oe=6A3FEF92"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3GxBdkNOHAQ7kNvwHAwAEA&_nc_oc=AdqFdzZvkutrfh3tvPXLFLrhMiJrbS5Ssj7Nme4hsfe70cGB6Ms90TJsnAz8hnLI8Fk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gt0VEHwX-u-S692Wm4PjmCyfWsuX4zbB84f9fx_rEwA&oe=6A3FC230"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_
950Q7kNvwEAwOgx&_nc_oc=Adp3huUtB_dEIGcmXGUWozwceFDGlh1BFfQLJfGeTX2jP-cJ1JH4sv6i-jGfo5t7lPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsFJ1j0xaxOTMTuuhkN4rKvigLLJaW1-0SWI9bAb8ByQ&oe=6A524F94"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woTmi1IgUdAQ7kNvwF1GPqv&_nc_oc=AdovMKuN4xmI40KoicsRxYNy-FrMqz4qVIxkAHjF2PprYFydwBKSWUQooUUpZqllo6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhnQZDKXyeVdlr5p2a6jAWUwEFYHGqpb2o8vnA0Kb-AA&oe=6A523A00"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfIelRrAoqEQ7kNvwGn4tm_&_nc_oc=AdqTkoQMicNE5HYL1MwlxjeBp8PGkBf32ePpG4ynGoDT4YdhlDbieZk8EyRUtDzsdNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVDLBsfPZ0Pb2fou6bc52-gFQDArpk3nnRxPbfkd70pQ&oe=6A524C02"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_FFd_SQmr0Q7kNvwF2I7OR&_nc_oc=Adp-Gg6T7BaVJiQVK3NGjK0jI6DiAC_rBBHyYUGHBsMoMk4YMI5Er8ws_AmrzTCY24I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvHJJ4xpMQ0IdhrA6pb18eiewMa21iVG_9_bkgnhWfHQ&oe=6A526492"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNitlgj_dTQQ7kNvwEDWwig&_nc_oc=AdpvmwTLmC2QHVp5OwxyFqCWduvie6gKlqkE9tsPEbZaUQonkoyOq4KCEYZ5Y4BOUew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXGFSaEoRfIyhmde9r9syyXqOt7DlqhGy8ZhDtTZjP1g&oe=6A523730"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
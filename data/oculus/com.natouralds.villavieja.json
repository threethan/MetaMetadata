5oAQ7kNvwGOsJVV&_nc_oc=AdqfOo4KdUHOAj7i0xzNX61mGe1exN0oFlL3qqGQvFdYKGr3u7_X_fe2U7-BVFI3eEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMtNRJZIfS9e1vm_enMVwUpUMeT_kpIdYpsOpfPisJWQ&oe=6A622194"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eeF9cYS6U4Q7kNvwF6KZSg&_nc_oc=Adq5UuXWuEnNZdNzCU68L9AV6ggwMJvIe3v5QkxsfE1Nr-t_khzEHpodpPffrZFrE1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBknFsb9Su0utL0oUoojJW_Ytm33K3LlAPjp3yYSdcvfA&oe=6A620C00"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqzNpSm8Z-EQ7kNvwEGsucL&_nc_oc=AdphH8PBri6fFYh8KZiZ7uYfie3ZQc8iDgnuTXSFghfLRMj62mFmuAhuwFUhPMyjpqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH6cZVMhteW3w0moCh61hPkjmSCej0gOOCNH8m3w9LzA&oe=6A621E02"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMr1j8j0nrQQ7kNvwFM_WES&_nc_oc=AdozZQ3PiShw2IKuOvkciNcILMU1cL_N43yIcOjUyODnMVgDXohQ4Wo6Eao5gGOAXyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLuqpi4GIABpguk9lff3bbWTp7Bjn33jyZOYIvEqn5Pw&oe=6A61FE52"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHu0U4tJj9AQ7kNvwGtNH7F&_nc_oc=AdoTAmh9DHpco0CbxkhVdFHNhyWaV4tuzEGVHX4rO6P-1TKAEhtR-rHBLZVilRVoDu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNlsawqU02gblLIV2oTH2B9CtgQnTwm_WaU5PDEPwmEg&oe=6A620930"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
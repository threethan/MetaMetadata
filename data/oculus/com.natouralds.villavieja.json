FQgQ7kNvwGsLxBz&_nc_oc=Ado18w1QvUStXlUFzLthD8TxR6U1UN6JTbYGKFwHA27IIYQc5wBHz83lIoehEiDsyjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6EYP6BFLY5ReHuCIoOCWbQCuIaxell5-7wAsRHCvPbg&oe=6A54F294"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woTmi1IgUdAQ7kNvwE-ZgXF&_nc_oc=AdrAPlWSjGQNHlzr78Uany3gdRzwZ_S_YwKuTYltW2gsdvS7Wb_fRnVQNjHj7lIBjQY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9vn5VdYdwQGaS1lSFA7Ntt3cHRFac8AMJE2qKdJZ5jA&oe=6A54DD00"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRgN4bCy0boQ7kNvwHj2w6b&_nc_oc=Adr5f792Zv-vXvvbT5VbG9P7JJ2hkSzsKmpAMcYtl5KWZIha-jivJFVVuIRNnJzZfoc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHt09KXvwrv0qvn3dpvgbcS-MWQRCt8tZkPEDqTeK7hA&oe=6A54EF02"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Zi4BpgTrhUQ7kNvwGRv_mP&_nc_oc=Adp3x0pNuhehEaD6uyzDeOnS-yMuGse3F4rv7KESObEl4xQJQYlbwEGOlsBwgIzH2XE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJwxSnQqgincekLaQmfs7RtaxwqC85r_PiJtZn7nAeLA&oe=6A550792"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnEpTg5DywsQ7kNvwHjS-Zy&_nc_oc=Adq9zcJwI0r9Ob_7N9WGYbd0XyAtXboo-BMvufQKaazGsNrAmXnCOWRnmqcvjNEDolY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBuNkfexgwlbiv2yGYg8dmNDqAC1r_voq1Wtf6P-nMzQ&oe=6A54DA30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
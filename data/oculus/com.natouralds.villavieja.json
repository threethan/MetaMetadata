4VQQ7kNvwHyCs36&_nc_oc=Adr1vkB5YhGppUhodvsdzR_rJC48ZCrKh59aeQQH9J-tLuitQdsgi-TP8LsWmBA7xFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzoWTJR8-ua3rvw7CLTzsTDdhKArfXvw9ui9jek3Z2Jg&oe=6AE4A614"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIpyHi2PRpcQ7kNvwEHKv0A&_nc_oc=Adq93unllCToumZMmfHOjsWWASPVTbpZrtFh8rWPHeU-HKWs3LJ_NTV_Op9I033A7sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH2BWoMSS4fUfRWTlmScE-IvZtyelEUfSAfy1kKkUjFQ&oe=6AE49080"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlXbrALMMaQQ7kNvwFMzNZI&_nc_oc=AdrKYV983bXonIz8kAiZVfNAzh7SuUq48wDX1IKOCVR4UaJrDCEsYHUbRmaafNPFHB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn3-z0Xka0BEsmPztujjw1bJB0ei5XNaBd2H2Quze9QQ&oe=6AE4A282"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQRBhvOzdRQQ7kNvwHZdHaE&_nc_oc=AdoMmaVxBzvnRhRwejpyzeLP-1PGKzb8NGSu4dr6uU3lN4eVlC-9adqFMrQaIHoqZjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBfs0pLiAu2y2shJ403yRyXlJpXl7765rynnIfAKyV_Q&oe=6AE4BB12"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzEU_7h3bhsQ7kNvwFdzwdI&_nc_oc=AdpWkOolCRNyt0Gesmta9DpIwWvhEWxr1njia-SKiPjsLcx4UCMYQnnON80f_77Uzq8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaLJCXKx99_DHWmFunaIAzWYwoNW_bH59Wt_7Fkx975Q&oe=6AE48DB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
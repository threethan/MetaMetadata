3IAQ7kNvwEIouRW&_nc_oc=AdrJhCAHJM8DGLuX_id3NDZhQLwNHXqMiX6VLMgl8N9Ob4VM9ZlOxErTObsuqaVGG9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVhxxJYIzM8uSgNtYFyG7mLIAZd2Izub7bgaREGaxyXg&oe=6ADE0E94"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDzJKlUC4W4Q7kNvwF1ZSsH&_nc_oc=AdoMrO2FLx0pqTomr9-kQqPzDX-y9-9-gNmz7vmwf9wvYm6ha7zCDlDbCIgTveuL-uI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtXucKGyv3xLGS43RnZScaSTVvgF3SSty5fcZkqQfc5Q&oe=6ADDF900"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywB0xTtte8wQ7kNvwFLHzgg&_nc_oc=Ado-AGp5jBO4MdJkOsWiZ6OsTTov6zPO4vpLwPnItFZOORlnMR5V-I_d_afjPm3AgBM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyiIcnzm6iftpufLV5AVhyg5J2Sj9obcXYF3QobMHjZA&oe=6ADE0B02"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFB4PluW1rkQ7kNvwG4h11O&_nc_oc=AdoA8Rhd_n4ddjAuXiNxLIJ4IMxHDWnv26x-Mcbbb_nMbladdf4efCbi9xWqIQr_CEM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbdjjZWBm3DVjZB78yusQHTp-eBJc6CBC5P2cKmSiC5Q&oe=6ADE2392"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHoaufrFRz0Q7kNvwGmVn9e&_nc_oc=AdqvP1sGWCzUQwBQ-io5C-FlAlIEigRljOiG08gSPY7Prmbfi0WB6Bk_DBiTVimJcRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQibSPPPZEED2aYgC57LqMFioVn0DwwbS_e4JzIY_Jdw&oe=6ADDF630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
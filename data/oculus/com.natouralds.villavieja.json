FQlUoQ7kNvwEu_TfT&_nc_oc=Adq4UD35W54AVpl-DaOT_r268WV6VrFhsfQf0t1VrtR1xBcXdLlNqa5I4ndXpJ-GBgo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5kCOeim8tPhUUcn7ceco9uvtU17bu_WHun_0lCQ9Cyg&oe=6AA40C94"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-39xKHitsIgQ7kNvwHwQSEl&_nc_oc=AdpL7iFzxslWii_U01NN7yK9_gvhdAUAFqqUxwQ85edQK6IYVrhVOIYB8m0oMx8QUE4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfZh_t-MW1wi5b4839gziQRQv7yz3fKW2ZtYBHw2WhTQ&oe=6AA3F700"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGH1nNxFBegQ7kNvwF9mvOG&_nc_oc=AdpEutfFVeMlfF_GeqDpcZdsB6hIUWpvBw3Xg6ZwBrbH3_947A7MH7T1eRMG0Hbw10g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrthYDbPuDD9XkLYfs3fMjNk43g1FHNFAzUbhMCS0l-w&oe=6AA40902"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ym8t9ZiOYEQ7kNvwFapo8p&_nc_oc=Adr6Kg1Ss6Fo8KuSM5Prb2GUEqWo6PE1h5-cXmWDRjMQ1gd2j0-atalgntt6b1gfbl8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiM6mjFyfQ8a_baRGsmPx0coGxFIXj6a7s-X9u9WXrAQ&oe=6AA42192"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT-3HXvpycUQ7kNvwFeohBS&_nc_oc=AdompzvLQ1ifAROONGuuXE73y8uiliwGGy5lt3JTUtD5j0a8P9VIalpliu8MokcouBw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINQ9I_jz1-AErdLBc1YWkr33ai63GlquhI1aaLOsYiaQ&oe=6AA3F430"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1507908104449159"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1336784868320755"}]}, "baseline_offer": {"id": "1336784868320755"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780931340, "status": "PUBLISHED", "id": "1336784868320755"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1512878620618774", "version": "1.2"}, "id": "2067815104085225", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1497831502123486", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1512878620618774"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2067815104085225"}]}, "change_log": null, "created_date": 1781181171, "id": "1512878620618774", "version": "1.2", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__
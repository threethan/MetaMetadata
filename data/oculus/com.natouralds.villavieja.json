S7sQ7kNvwF3Flr0&_nc_oc=AdoRH0NBncPAJ9M4U0DURUB4l50yN9zBG8IhZCUK-p5JgUdcQv_vbneHNO9mgVEE4PI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf64ZlE26fvalQOXxD637jCF9qN8QD_Hk79IzlcI8F3g&oe=6AB3DE94"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agY0TTxWik8Q7kNvwH4DGjP&_nc_oc=AdozaaqBDWlRizINw45jevUbuWfG4cExakDWOWJzITafqqdFBKjjlv7vijPSLA5aFTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDgfMW8yooGF1PjFuvIuymR5Z5FJcQq14VhAXorq5bUA&oe=6AB3C900"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbPhVGJfvUEQ7kNvwEtUOOo&_nc_oc=Adq19BN9evQrEukcKCMGLPg8SD2TBG6f64CsC2lVRlutJA1KYiZ3A1qbKMqpoi3U8ro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOGv1emarzgvFIjPYmvWkdMl11Fg47EB79PdTcp8nrQA&oe=6AB3DB02"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giX5wTgY5jAQ7kNvwGvY28v&_nc_oc=Adozmct1j-PyB75Ja5CoSDYrxl5h3y-RqspO83Tf-8scau2YqeKT5yuRPJF60kC6UYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPfcMhgBnsn8SNt8tBqyns00B9KQ_M3jMIuFnoKijDdw&oe=6AB3F392"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUpw-Zc-C-0Q7kNvwFNmKuK&_nc_oc=AdojrG1dcIzURpDnEIpMU_I6kSn-bsjswCXij7ryV2Fp9cBZp2NvktS0FzgIP3BF35I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID2-MxKNuv3V9yv877m9e8_JLroA6zJPXSk8qcycZFNw&oe=6AB3C630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
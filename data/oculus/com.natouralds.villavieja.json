uluscdn.com&_nc_ss=7f20f&oh=00_Af8SYCNYoFXfwvIjeq-MHEVi4AEaJrqFxire1D9wSz6Grw&oe=6A3E8914"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COLilEBNDcUQ7kNvwGYv9vF&_nc_oc=AdoQvLdN_T1RRPMqWpCBamPiE39K2Ul1zTAHd3puW_1PaFx_AQH26PhG3spg8SzmKIM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96d1ODi9AS6W5JiEQXmQJ374Kj-4PvUrtaJzQw7Zxr8g&oe=6A3EABC0"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BI2nz04k4g0Q7kNvwHuHoMg&_nc_oc=Adrt06P2j4buYvTjrwe6m0G1T8pk2WJqyuu3jl4VCvQDay2nrqoOW-kTrV2E2iWdaH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VldJy3yl2i3WD4JPeZGhNxLIV41l5cqf6sw-Qq5zEsQ&oe=6A3E8582"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCcwa4umybkQ7kNvwHA_scH&_nc_oc=AdreZlNoKMyhBdSK8CaYa0TyqCwITYA7yBKQy_RcsujI8yDzcMRipBlLGYawTuwr1Kk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82enq7_vsukkpErTMRx2rXVP-o1YexRZGt868B8MDrYg&oe=6A3E9E12"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApAtj74QHPwQ7kNvwHo4cZS&_nc_oc=AdpyaWJ1rJoiOAlmAn2B_QO6bFbrQGX3CvKcq_yR1tbftuiPKaJ03u9qd_woaHvC_ZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yHv1T1JUePOdWmwCN-3FRJHS_EHk3CCvj-6e1t3sKDA&oe=6A3EA8F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_
89EQ7kNvwEwKqw8&_nc_oc=Adp78nId4WopgM0Zh49wA2uX79l1Ci3_GMBVFN1BTl04vCQmynemsRqvfVQJKDDY_48&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpiOaZV1T3g-Elplp8zPgIbWvJ0_PXfyhpRrVZxv4rKg&oe=6A9AD214"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBhCgTvCRjcQ7kNvwHPygFK&_nc_oc=AdqnelUF-DQ2MHj-avhdFISvCda1KGUoC3VLKDZcPtXpM4T10ZTh8gjxO-pB7pHqXeU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2tx9BBQfG9nCa4eFrOv5miGISCF2QzV75T9_CYXTlRg&oe=6A9AF4C0"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3FjVUxzBBQQ7kNvwFWxTzz&_nc_oc=Adomv7AbLpa2JuEIhVST1tC-faZzN0unN6wRpvxm_hivzY95GubvtPvKfvj4MQ0fphY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWm7jFWShdF2wJgHexiDelQ6FO1r6VN0rjCsLTczbrkA&oe=6A9ACE82"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIp1MUMVbcEQ7kNvwEnRm1D&_nc_oc=AdqANS742hMTPPis2Aut0To4Ixy7mviHVzbbRw81137qXw7MnRfqanD-yTTF5jdd-N0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsfRGlidwuP0_bDXZUHSdUNGTTYnnQq53F7oZ8Bjbu2g&oe=6A9AE712"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAmnhA3csCwQ7kNvwEDMN3D&_nc_oc=Adq19KqKIXjyHDZHzqSHyzQVMixX_RuGh0W8Oe4aVyXrnX8lvdSDtboPcxqEoOSxu8s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2gt4syxZ4QfRCgXAWS5SvYAz01KlRZL1hhbhqQW2umw&oe=6A9AF1F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
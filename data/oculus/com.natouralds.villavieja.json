LPEQ7kNvwHvfWGQ&_nc_oc=AdpMCxvf9EIQ9xbLC4hu8SFeMhl-qNyFTsm56jkmiKN9wNDxDBcuJycqLdJvrhHowf0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELhFTHS5g7cQJcH1pFbZsmxPT_LxpMcOBo89MH4BFA1g&oe=6A915F54"}, {"file_name": "screen2.png", "id": "1477144200225604", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491825481_1477144203558937_7529408213947229136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3bmUPFP9UkQ7kNvwEBn_cK&_nc_oc=AdoNac4if5Gh28RJifopMX9noug89gMYgBU5MLREEwPJNzbD9agx5aVHS5awZk9Oeb8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEhESvQnyCrjwgJ0tSr4UBIPh7lXsQPaV3BJ9A85-5FQ&oe=6A918200"}, {"file_name": "screen3.png", "id": "2059675691337960", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499313390_2059675694671293_5136455952694963438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-kIhzyClvYQ7kNvwHoNxr9&_nc_oc=AdqJ-E16UHd7cnI51g1gAuZcKMO6UU213m3_R1WcYrlEtdDbqcZVigJ5uEqoKKYSXrc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ5v8Lzm5qhlu7lHLVNb9vyu5saDlq6wlg4HDcBmP8ag&oe=6A915BC2"}, {"file_name": "screen4.png", "id": "1333558258700225", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823351_1333558262033558_2977867196446260442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOQJkJhJHSgQ7kNvwGQT9AW&_nc_oc=AdpoXZ5qG-nftfktgNRjc-yHIa2U9SC6GiXJ82Ex_c2CNJFkBSjhJwWo0lshxqri4a8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEhVo9-TzsU38mj-1jPKT9Bu5-OEtMEyFVudimUM7LdA&oe=6A917452"}, {"file_name": "screen5.png", "id": "4059192277548357", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825481_4059192280881690_2569860999626092238_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxA6b315JdgQ7kNvwGEyClB&_nc_oc=Adqbf5LZ6FLw57EWSFSHrYeIwRFhUtbFx6J2t7-bkjEMwLjLJBEI31f_DhehgYxVpQs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRnyxbFJddE_wVOTOpMSL0upAtTNd3iN51UPK_XNo6zA&oe=6A917F30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Villa Vieja", "keywords": [], "long_description": "Ad\u00e9ntrate en la historia de Villa Vieja con una experiencia de realidad virtual dise\u00f1ada para acercarte al patrimonio arqueol\u00f3gico de una forma innovadora e inmersiva.\n\nEsta aplicaci\u00f3n VR te permite recorrer el yacimiento como nunca antes: explora sus estructuras, descubre recreaciones hist\u00f3ricas y conoce el contexto cultural y social de este enclave hist\u00f3rico situado en Calasparra, Murcia. Gracias a la recreaci\u00f3n virtual, podr\u00e1s visualizar c\u00f3mo era el asentamiento en su \u00e9poca de esplendor y comprender mejor la importancia hist\u00f3rica del lugar.\n\nLa experiencia est\u00e1 pensada tanto para visitantes y turistas como para estudiantes, investigadores y amantes de la historia. A trav\u00e9s de entornos detallados, narraci\u00f3n interactiva y exploraci\u00f3n libre, la app convierte el aprendizaje en una aventura envolvente.\n\nCaracter\u00edsticas principales:\n-Exploraci\u00f3n inmersiva en realidad virtual.\n-Recreaci\u00f3n hist\u00f3rica del yacimiento arqueol\u00f3gico.\n-Informaci\u00f3n cultural y educativa integrada.\n-Experiencia interactiva y accesible.\n-Ideal para turismo cultural y educaci\u00f3n patrimonial.\n\nDescubre el pasado, camina entre la historia y vive Villa Vieja como si estuvieras all\u00ed.", "short_description": "Explora el yacimiento arqueol\u00f3gico de Villa Vieja en realidad virtual y viaja al pasado para descubrir c\u00f3mo era la vida en uno de los enclaves hist\u00f3ricos m\u00e1s importantes de la regi\u00f3n. Recorre sus espacios, conoce su historia y vive una experiencia inmersiva \u00fanica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tierrasdelaveracruz.com/app/politica_privacidad_VillaVieja.html", "developer_terms_of_service_url": null, "publisher_name": "natouralds", "support_website_url": null, "website_url": "https://tierrasdelaveracruz.com/", "category"
STYUV63ai8--g2G8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUiMBleq_GzzprR62tiV5swwmDduyLQpuePa1fGeLrGA&oe=69CE52B5"}, {"file_name": "com.tinywing44.monkeyfun-20251204-182601.png", "id": "1144591747842105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308131_1144591751175438_6945522524455545534_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpA1IY4lpI8Q7kNvwG1k6c_&_nc_oc=AdpTdZgMg6L6xpVaeX1f1qyYLySRHU2n88DgyayvqmTm3AMq24mbPirGM24O2R6CyqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyivhnPSGGsirdiQiBiJbwZQxIgM7o0eoNP5MIweSXVXQ&oe=69CE63FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Fun", "keywords": ["gorilla", "tag", "monkey", "infection", "free"], "long_description": "Monkey Fun\n\nStep into the jungle and unleash your inner primate in Monkey Fun, a fast\u2011paced VR playground built for pure movement and laughter. Inspired by the viral energy of Gorilla Tag, this game puts you in control of your arms \u2014 climb, swing, and vault your way through the environment with nothing but physical skill.\n\nInfection Mode is the star: one monkey starts infected, and every tag spreads the chaos. Stay uninfected as long as you can, or flip sides and hunt down the rest. Every round is unpredictable, frantic, and hilarious.\n\nAt launch, Monkey Fun features a single handcrafted jungle map packed with vertical routes, hidden corners, and wide\u2011open spaces for daring escapes. It\u2019s simple, it\u2019s sweaty, and it\u2019s endlessly replayable with friends.\n\nKey Features:\n\n    Arm\u2011powered locomotion \u2014 no joysticks, just pure movement\n\n    Classic Infection Mode for fast, social rounds\n\n    One detailed jungle map designed for climbing, chasing, and improvising\n\n    Perfect for parties, hangouts, or competitive tag sessions\n\nGrab your headset, gather your troop, and see how long you can survive the jungle.", "short_description": "Monkey Fun is a fast\u2011paced VR tag game where you move like a monkey\u2014climbing, swinging, and scrambling through a jungle playground using only your arms. Inspired by the viral sensation Gorilla Tag, it delivers the same raw, physical energy with its own twist."}]}, "developer_name": null, "developer_privacy_policy_url": "https://monkeyfunvr.com/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Tinywing44 Studio", "support_website_url": null, "website_url": "https://monkeyfunvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25605947492440046"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827567_1412666060869739_8326998529056891693_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rppqPClCZMsQ7kNvwHeUuQP&_nc_oc=AdoyQuihHySktXRodKSOS73k9VE5a4H4KOVfp2cFHcgyNVb9IuG56pORRoY47kswJyU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxj9FYSDwulTLjxs7df73Uaw46qqdyL1MvIMdSxJKoMdg&oe=69CE6166"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Fun", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topi
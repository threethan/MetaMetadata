lMm9js-kwAMFIttr4i9n8g8BMU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXaqC0iLSTZAxTvcaqq_aQRO-Ayceojq05GKDGIO1h0w&oe=6A81A8FE"}, {"file_name": "rs.png", "id": "4518052901762254", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819511_4518052905095587_4649207073703777853_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_W0LoN70uBAQ7kNvwHjUryk&_nc_oc=AdoRQIa0C7ykel3W-Jc9epVQG-qzEm35kjNN4-YMRmugAzIQ4DrUSFvVkib32G83JSY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYFnaW04XvZSAzeXk_M6ySne9pUOg0BLfzlJ-IaAntmQ&oe=6A81B8A4"}, {"file_name": "dfb2.png", "id": "1686857975997876", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821782_1686857979331209_1710770511152608691_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m4_DhEx170Q7kNvwFES-tQ&_nc_oc=AdpZQSp9PAGQDiD5N6x9S8MPsgMyN3yvufrXA-1iWGRZRdar-V6_YNrBCoVdpcwvxVQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtyKkmL1OtB701Y3BrkQ8sTZy2S6rw-0iOZsDhAe2GeA&oe=6A8194F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Just_Hoop_Nano_2560x1440.png", "id": "1912725702723350", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822327_1912725706056683_6618642067486938641_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f81J27Fzl1YQ7kNvwFux5Q9&_nc_oc=Adqh12qqoPfOcsU6oWTACPTG2ZQ0O3yzCndiqM5YNoyCi_9zHJXUoGfLf4wmq2A_O0M&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRHyp3bchrNxhFzmShq1HnQPFS0NHgTYkTCsqo6fpetQ&oe=6A81995D"}, "display_name": "Just Hoops Nano", "keywords": ["arcade", "tiny", "mini", "handtracking", "mixedreality"], "long_description": "# Turn Your Room Into a Basketball Arcade\n\n**Just Hoops Nano** is a fast mixed reality basketball game built for quick, satisfying play. Sit back, look to aim, charge your shot, and release at the perfect moment.\n\nPlay with **hand tracking or controllers**. Pinch to shoot with your fingers, or use buttons for a classic control feel.\n\nMaster **20+ dynamic levels** across **First Shots, Summer, and Pop-A-Shot** themes. Hit moving hoops, nail long satisfying shots, and take on iconic challenges like **Around the World**, arcade cabinet shots, tricky angles, and full-court-style swishes.\n\nThen relax in **Zen Mode**, an endless shooting flow made for clean swishes and no pressure.\n\nWith a **fresh soundtrack**, more content planned after launch, and **online scores** to chase, Just Hoops Nano is built for instant fun and endless comeback sessions.\n\n# Look. Charge. Shoot. Score.\n\nJoin our Discord : **https://discord.gg/gR5SPAKKX6**", "short_description": "Play basketball with your fingertips in mixed reality.\nAim, pinch, and shoot hoops using only your hands in fast, satisfying sessions made for instant couch play."}, {"images": {"nodes": []}, "id": "1679373333091028", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just Hoops Nano", "keywords": ["\u62f1\u5eca", "\u5fae\u5c0f\u7684", "\u5c0f\u578b\u7684", "\u7136\u540e\u662f\u53cc\u624b", "\u968f\u610f\u7684"], "long_description": "# \u77ac\u95f4\u5c06\u5ba2\u5385\u53d8\u6210\u8857\u673a\u5385\u3002\n\nJust Hoops Nano \u662f\u4e00\u6b3e\u5feb\u8282\u594f\u3001\u6613\u5b66\u6613\u4e0a\u624b\u7684\u6df7\u5408\u73b0\u5b9e\u7bee\u7403\u6e38\u620f\uff0c\u5b8c\u5168\u57fa\u4e8e\u624b\u90e8\u8ffd\u8e2a\u6280\u672f\u3002\u65e0\u9700\u63a7\u5236\u5668\uff0c\u65e0\u9700\u8bbe\u7f6e\u3002\u53ea\u9700\u770b\u3001\u7784\u51c6\u3001\u6295\u7bee\u3002\n\n> **\u81ea\u7136\u6d41\u7545\u7684\u73a9\u6cd5\uff1a**\n\n- \u7528\u773c\u775b\u7784\u51c6\n\n- \u634f\u6307\u51c6\u5907\u6295\u7bee\n\n- \u5728\u6700\u4f73\u65f6\u673a\u51fa\u624b\n\n> # \u4f60\u4f1a\u7231\u4e0a\u5b83\u7684\u7406\u7531\n\n**\u634f\u6307\u6295\u7bee**\n\n- \u76f4\u89c2\u7684\u624b\u52bf\u8ba9\u6295\u7bee\u611f\u89c9\u81ea\u7136\u6d41\u7545\uff0c\u8f7b\u677e\u6613\u4e0a\u624b\uff0c\u77ac\u95f4\u6ee1\u8db3\u4f60\u7684\u6295\u7bee\u6b32\u671b\u3002\n\n> **\u6c99\u53d1\u6e38\u620f\u7684\u5b8c\u7f8e\u4e4b\u9009**\n\n- \u4e13\u4e3a\u5750\u59ff\u6e38\u620f\u4f18\u5316\uff0c\u8ba9\u4f60\u968f\u65f6\u968f\u5730\u90fd\u80fd\u8212\u9002\u7545\u73a9\u3002\n\n> **\u77ed\u65f6\u9163\u7545\uff0c\u9163\u7545\u6dcb\u6f13**\n\n- \u4e13\u4e3a\u5feb\u901f\u6e38\u620f\u800c\u8bbe\u8ba1\uff0c\u8f7b\u677e\u878d\u5165\u4f60\u7684\u65e5\u5e38\u6e38\u620f\u8282\u594f\u3002\n\n>\n\n**\u52a8\u6001\u6311\u6218**\n\n- \u6311\u6218\u8d85\u8fc7 20 \u4e2a\u5173\u5361\uff0c\u7bee\u7b50\u79fb\u52a8\uff0c\u89d2\u5ea6\u5201\u94bb\uff0c\u96be\u5ea6\u9012\u589e\u3002\n\n>\n\n**\u5b8c\u7f8e\u6295\u7bee\u7684\u6ee1\u8db3\u611f**\n\n- \u78e8\u7ec3\u4f60\u7684\u6295\u7bee\u65f6\u673a\uff0c\u7cbe\u51c6\u51fa\u624b\uff0c\u529b\u4e89\u7f5a\u8fdb\u5b8c\u7f8e\u4e00\u7403\u3002\n\n>\n# **\u89c2\u770b\u3002\u7784\u51c6\u3002\u6295\u7bee\u3002\u5f97\u5206\u3002**\n\n\u4e0d\u65ad\u56de\u6765\u7ec3\u4e60\uff0c\u4e89\u53d6\u6295\u8fdb\u5b8c\u7f8e\u4e00\u7403\u3002\n\n> \u52a0\u5165\u6211\u4eec\u7684 Discord\uff1a**https://discord.gg/gR5SPAKKX6**", "short_description": "\u53ea\u9700\u6307\u5c16\u8f7b\u89e6\uff0c\u5373\u53ef\u501f\u52a9\u624b\u52bf\u8bc6\u522b\u529f\u80fd\u7545\u73a9\u7bee\u7403\u3002\n\n\u65e0\u9700\u4efb\u4f55\u64cd\u4f5c\uff0c\u53ea\u9700\u53cc\u624b\u8f7b\u8f7b\u634f\u5408\uff0c\u5373\u53ef\u8f7b\u677e\u5f97\u5206\u3002\u6d41\u7545\u6d41\u7545\u7684\u6df7\u5408\u73b0\u5b9e\u4f53\u9a8c\uff0c\u8ba9\u60a8\u5728\u6c99\u53d1\u4e0a\u4e5f\u80fd\u8f7b\u677e\u7545\u73a9\u3002"}, {"images": {"nodes": []}, "id": "1346543030777222", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just Hoops Nano", "keywords": ["\uc544\ucf00\uc774\ub4dc", "\ubbf8\ub2c8", "\ud3c9\uc0c1\ubcf5"], "long_description": "# \uc21c\uc2dd\uac04\uc5d0 \uac70\uc2e4\uc744 \uc544\ucf00\uc774\ub4dc\ub85c \ubcc0\uc2e0\uc2dc\ucf1c \ubcf4\uc138\uc694.\nJust Hoops Nano\ub294 \uc190\ub3d9\uc791 \ucd94\uc801 \uae30\uc220\uc744 \uae30\ubc18\uc73c\ub85c \ud558\ub294 \ube60\ub974\uace0 \ubc30\uc6b0\uae30 \uc26c\uc6b4 \ud63c\ud569 \ud604\uc2e4 \ub18d\uad6c \uac8c\uc784\uc785\ub2c8\ub2e4. \ucee8\ud2b8\ub864\ub7ec\ub3c4, \uc124\uc815\ub3c4 \ud544\uc694 \uc5c6\uc2b5\ub2c8\ub2e4. \ubcf4\uace0, \uc870\uc900\ud558\uace0, \uc29b\ud558\uc138\uc694.\n\n> **\uc790\uc5f0\uc2a4\ub7ec\uc6b4 \ud50c\ub808\uc774:**\n\n- \ub208\uc73c\ub85c \uc870\uc900\n- \uc190\uac00\ub77d\uc73c\ub85c \uc29b \uc900\ube44\n- \uc644\ubcbd\ud55c \uc21c\uac04\uc5d0 \uc29b\ud558\uae30\n>\n# \uc65c \uc88b\uc544\ud560\uae4c\uc694?\n\n**\ud540\uce58 \ud22c \uc29b**\n- \uc9c1\uad00\uc801\uc778 \uc81c\uc2a4\ucc98\ub85c \uc790\uc5f0\uc2a4\ub7fd\uace0 \uac04\ud3b8\ud558\uba70 \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \uc29b\uc744 \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n> **\uc18c\ud30c \uac8c\uc784\uc5d0 \ucd5c\uc801\ud654**\n- \uc549\uc544\uc11c \ud50c\ub808\uc774\ud558\ub294 \uac83\uc5d0 \ucd5c\uc801\ud654\ub418\uc5b4 \uc788\uc5b4 \uc5b8\uc81c\ub4e0 \ud3b8\uc548\ud558\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n> **\uc9e7\uc9c0\ub9cc \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \ud50c\ub808\uc774**\n- \uc9e7\uc740 \uc2dc\uac04 \ub3d9\uc548 \uc990\uae30\uae30 \uc88b\uc740 \uac8c\uc784\uc73c\ub85c, \uc77c\uc0c1\uc801\uc778 \uac8c\uc784 \ub8e8\ud2f4\uc758 \uc77c\ubd80\uac00 \ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n>\n**\ub2e4\uc774\ub0b4\ubbf9\ud55c \ub3c4\uc804**\n\n- \uc6c0\uc9c1\uc774\ub294 \uace8\ub300, \uae4c\ub2e4\ub85c\uc6b4 \uac01\ub3c4, \uc810\uc810 \uc5b4\ub824\uc6cc\uc9c0\ub294 \ub09c\uc774\ub3c4\uc758 20\uac1c \uc774\uc0c1\uc758 \ub808\ubca8\uc5d0 \ub3c4\uc804\ud574 \ubcf4\uc138\uc694.\n\n>\n**\uc644\ubcbd\ud55c \uc29b\uc758 \ub9cc\uc871\uac10**\n\n- \ud0c0\uc774\ubc0d\uc744 \uc5f0\ub9c8\ud558\uace0, \uc644\ubcbd\ud55c \uc29b\uc744 \uad6c\uc0ac\ud558\uba70, \uc644\ubcbd\ud55c \uc790\uc720\ud22c\ub97c \ub178\ub824\ubcf4\uc138\uc694.\n\n>\n# **\ubcf4\uace0, \uc870\uc900\ud558\uace0, \uc29b\uc744 \uc3d8\uace0, \ub4dd\uc810\ud558\uc138\uc694.**\n\uc644\ubcbd\ud55c \uc29b\uc744 \uc704\ud574 \uacc4\uc18d\ud574\uc11c \uc5f0\uc2b5\ud558\uc138\uc694.\n\n> \ub514\uc2a4\ucf54\ub4dc \uc11c\ubc84\uc5d0 \ucc38\uc5ec\ud558\uc138\uc694: **https://discord.gg/gR5SPAKKX6**", "short_description": "\uc190\ub3d9\uc791 \uc778\uc2dd \uae30\uc220 \ub355\ubd84\uc5d0 \uc190\uac00\ub77d\ub9cc\uc73c\ub85c \ub18d\uad6c\ub97c \uc990\uaca8\ubcf4\uc138\uc694.\n\n\uc190\uac00\ub77d\uc73c\ub85c \uac04\ub2e8\ud558\uac8c \ud540\uce58 \uc81c\uc2a4\ucc98\ub97c \ucde8\ud558\uba70 \uace8\uc744 \ub123\uc5b4\ubcf4\uc138\uc694. \uc18c\ud30c\uc5d0 \uc549\uc544\uc11c\ub3c4 \ud3b8\uc548\ud558\uac8c \uc990\uae38 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub41c \ubd80\ub4dc\ub7fd\uace0 \ub9cc\uc871\uc2a4\ub7ec\uc6b4 \ud63c\ud569 \ud604\uc2e4 \uacbd\ud5d8\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4."}, {"images": {"nodes": []}, "id": "963900506357989", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just Hoops Nano", "keywords": ["arkade", "winzig"], "long_description": "Verwandle dein Wohnzimmer im Handumdrehen in eine Spielhalle.\nJust Hoops Nano ist ein rasantes, leicht zu erlernendes Mixed-Reality-Basketballspiel, das vollst\u00e4ndig auf Hand-Tracking basiert. Keine Controller. Kein Aufbau. Einfach schauen, zielen und werfen.\n\n> **Nat\u00fcrliches Spielgef\u00fchl:**\n\n- Mit den Augen zielen\n- Den Wurf vorbereiten, indem du deine Finger zusammenziehst\n\nIm perfekten Moment loslassen\n>\n# Warum du es lieben wirst\n\n**Zum Werfen zusammenziehen**\n\n- Eine intuitive Geste macht das Werfen nat\u00fcrlich, einfach und sorgt f\u00fcr sofortiges Erfolgserlebnis.\n\n> **Perfekt f\u00fcrs Couch-Gaming**\n- Vollst\u00e4ndig optimiert f\u00fcr bequemes Spielen im Sitzen, damit du jederzeit entspannt spielen kannst.\n\n> **Kurze, knackige Sessions**\n\n- Entwickelt f\u00fcr schnelle Runden, die zu einem festen Bestandteil deines Gaming-Alltags werden.\n\n> **Dynamische Herausforderungen**\n\n- Stelle dich \u00fcber 20 Leveln mit beweglichen K\u00f6rben, kniffligen Winkeln und steigendem Schwierigkeitsgrad.\n\n>\n**Die Befriedigung eines perfekten Wurfs**\n\n\u2013 Verbessere dein Timing, f\u00fchre fehlerfreie W\u00fcrfe aus und ziele auf den perfekten Freiwurf.\n\n>\n# **Zuschauen. Zielen. Zupacken. Treffen.** Komm immer wieder vorbei, um den perfekten Wurf zu \u00fcben.\n\n> Tritt unserem Discord-Server bei: **https://discord.gg/gR5SPAKKX6**", "short_description": "Spiele Basketball mit nur deinen Fingerspitzen dank Gestensteuerung.\n\nErziele K\u00f6rbe allein mit deinen H\u00e4nden \u2013 mit einer einfachen Pinch-Geste. Dank eines fl\u00fcssigen und \u00fcberzeugenden Mixed-Reality-Erlebnisses, perfekt f\u00fcr entspanntes Spielen vom Sofa aus."}, {"images": {"nodes": []}, "id": "769793839456755", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just Hoops Nano", "keywords": ["arcada", "diminuto"], "long_description": "# Transforma tu sala en una sala de juegos en un instante.\n\nJust Hoops Nano es un juego de baloncesto de realidad mixta, r\u00e1pido y f\u00e1cil de aprender, basado completamente en el seguimiento de las manos. Sin mandos. Sin configuraci\u00f3n. Solo mira, apunta y dispara.\n\n> **Juega de forma natural:**\n\n- Apunta con los ojos\n- Prepara tu tiro pellizcando con los dedos\n- Suelta en el momento perfecto\n>\n# Por qu\u00e9 te encantar\u00e1\n\n**Pellizca para disparar**\n- Un gesto intuitivo hace que disparar se sienta natural, accesible y gratificante al instante.\n\n> **Perfecto para jugar en el sof\u00e1**\n- Totalmente optimizado para jugar sentado, para que puedas jugar c\u00f3modamente en cualquier momento.\n\n> **Sesiones cortas y satisfactorias**\n- Dise\u00f1ado para partidas r\u00e1pidas que se convertir\u00e1n en parte de tu rutina de juego diaria.\n>\n**Desaf\u00edos din\u00e1micos**\n\n- Supera m\u00e1s de 20 niveles con canastas m\u00f3viles, \u00e1ngulos complicados y dificultad creciente.\n\n**La satisfacci\u00f3n de un tiro perfecto**\n\n- Perfecciona tu sincronizaci\u00f3n, ejecuta tiros impecables y apunta al tiro libre perfecto.\n\n# **Observa. Apunta. Presiona. Anota.**\nSigue intent\u00e1ndolo para lograr el tiro perfecto.\n\n\u00danete a nuestro Discord: **https://discord.gg/gR5SPAKKX6**", "short_description": "Juega al baloncesto con solo la punta de los dedos gracias al reconocimiento de gestos.\n\nAnota canastas con solo usar las manos, con un simple pellizco, gracias a una experiencia de realidad mixta fluida y satisfactoria, dise\u00f1ada para que juegues f\u00e1cilmente desde el sof\u00e1."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.realcast.io/legal/privacy-policy-2", "developer_terms_of_service_url": null, "publisher_name": "Realcast Inc", "support_website_url": null, "website_url": "https://www.realcast.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "zh_CN", "es", "ko", "ja"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26161748243498996"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824307_1329644865896479_2621996966005570826_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKsE7RS1JFIQ7kNvwHKNLcR&_nc_oc=AdoPvl1ia9pfIps
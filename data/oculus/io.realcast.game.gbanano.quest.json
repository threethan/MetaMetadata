"screenshots": [{"file_name": "screen 1a.png", "id": "2008653663341089", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827585_2008653666674422_6556200403686510266_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7QXun6F0B8Q7kNvwE50PUK&_nc_oc=AdolG6K5Rt9vj7QnQ5SuLexJ3vKNqj2EwNkIk0rXhMSXwlWhmhULFiawQRsy3YkavOA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiJ3GXfEWj6FCtRjqRZW45JTFp-au3u5npuduQOKwKGg&oe=6A81A16E"}, {"file_name": "screen 3.png", "id": "805806682175718", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308575_805806685509051_3925800846769874906_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5b1ZbuOgm8Q7kNvwHcuT5X&_nc_oc=Adr3EHJB57Hwkj4ixCY5kR9IXl_oD7ziN8nMWWFH6AlSkyBN21Y4dOg6Mcwmp5811a8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZk1GKVNXVUj5zoLyJORm8Hcz2IwrDRQiUxr0NEjhJuQ&oe=6A81B810"}, {"file_name": "screen 4.png", "id": "1107079921615599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821081_1107079924948932_2053231518824140628_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJoLoWbPvl0Q7kNvwExcwQe&_nc_oc=AdqdrOB-NRVW74bXJ0MuGXWNlvLh9OX_yNbnxMPwcf5DaVRiBmP98bOlxsF-IVNlPA4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVY3aKrMyNgqdKcLyw9KAX0ofOKHEqbaBDaBcgV7Ldsw&oe=6A81A5F4"}, {"file_name": "screen 2.png", "id": "2390857781415338", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825497_2390857784748671_4382877637298308149_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZhPYPMQHpQQ7kNvwEvzRxl&_nc_oc=Adpv6ab8IvfsM-d_xG8p_-np_UUfkNE4dVclivGNOvvp9G3FvzwoiOamgtChpmkVgNE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsghZRQbjDLeXu_JHS1PbGY2HeqVOFPhNcGVtnNM0eyg&oe=6A81C60D"}, {"file_name": "screen 5.png", "id": "932681439586665", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819982_932681446253331_5380966341171594253_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oG6PooQYa4Q7kNvwHV3kHJ&_nc_oc=AdoTB7jZAYCZSOxY3TR8E82h8fM58OFnst2mqNLSgxxCW30v1LxWQED6MfXHGfdjQjU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEBpNLINY5DWeJQdAVuX5xQlXFWcsM_JKr0T4Ip9jOww&oe=6A81B24C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "JUST HOOPS nano", "keywords": ["arcade", "tiny", "mini", "handtracking", "casual"], "long_description": "# Turn your living room into an instant arcade.\nJust Hoops Nano is a fast, easy-to-pick-up mixed reality basketball game built entirely around hand tracking. No controllers. No setup. Just look, aim, and shoot.\n>\n**Play the way it feels natural:**\n- Aim with your eyes\n- Charge your shot by pinching your fingers\n- Release at the perfect moment\n>\n# Why You\u2019ll Love It\n\n**Just Pinch to Shoot**\n- An intuitive gesture makes shooting feel natural, accessible, and instantly satisfying.\n>\n**Perfect for Couch Play**\n- Fully optimized for seated gameplay so you can play comfortably anytime.\n>\n**Short, Satisfying Sessions**\n- Designed for quick play bursts that fit into your day.\n>\n**Dynamic Challenges**\n\n- Take on 20+ levels with moving hoops, tricky angles, and evolving difficulty.\n>\n**Pure Shot Satisfaction**\n- Dial in your timing, hit clean swishes, and chase that perfect release.\n>\n# **Look. Aim. Pinch. Score.**\nKeep coming back for the perfect shot.\n>\nJoin our Discord : **https://discord.gg/gR5SPAKKX6**\n", "short_description": "Basketball at your fingertips. No controllers required.\n\nShoot hoops using only your hands with a simple pinch gesture in a fast, satisfying mixed reality experience designed for quick play from your couch.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://realcast.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Realcast Inc", "support_website_url": null, "website_url": "https://www.realcast.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_catego
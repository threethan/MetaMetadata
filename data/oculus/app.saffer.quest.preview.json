8FED"}, {"file_name": "1000001010.png", "id": "1670353207958973", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1670353211292306_8131016316885355068_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pcTrz2RQc4Q7kNvwHUG2z7&_nc_oc=AdrGk-22yhutDYaUj2oCFd7q6iRPjFhGv7PxdWR12obfOmBBKN-JGpq5ker4rjEUtOU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1_zZtXOgxtBmPhrk7ODFMP7P5rmH3SrhzESYhIlZFzw&oe=6AFC892E"}, {"file_name": "1000001022.png", "id": "1686576559788658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1686576566455324_6769173517360911717_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X7_uSHAhLIQ7kNvwGKcB1A&_nc_oc=AdpxX001H-xf28EYFUSDNuL2Y3Ab36DjtjnLXii5TPGrD-N6XhCkCgf3OwscJji11vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpzMrIWbDl1vkVio2ADT4UecqOFQcfBcOiida5gleEEA&oe=6AFC6EFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Saffer", "keywords": ["VoiceChat", "VRgames", "GameDiscovery", "VRCommunity", "IndieVR"], "long_description": "SAFFER was born from a simple idea: discovering great VR experiences and finding people to enjoy them with should be easier.\n\nAfter years of exploring virtual reality, our founder faced two recurring challenges: discovering new and lesser-known VR games, and finding players who shared the same interests.\n\nConversations with VR players and developers helped shape SAFFER into a platform built around discovery, connection, and community.\n\nDISCOVER VR EXPERIENCES\n\nExplore VR games and apps, including independent titles and hidden gems. Browse categories, discover game details, and find experiences that match your interests.\n\nCONNECT WITH PLAYERS\n\nJoin a community of VR enthusiasts. Share posts, discuss your favorite experiences, and connect with players who love virtual reality.\n\nVOICE CHAT\n\nJoin voice chat rooms and communicate with other players in real time. Meet new people, discuss games, and build connections.\n\nDEVELOPERS AND STUDIOS\n\nFollow developer and studio channels to discover game announcements, updates, and new experiences.\n\nBUILT FOR EVERYONE WHO LOVES VR\n\nSAFFER brings players, developers, and creators closer together.\n\nOur mission is to make the VR community more connected, help independent experiences reach more players, and create a place where everyone can discover something new.\n\nSAFFER - Discover More. Find Your People.\n\nAn internet connection is required. An account is needed for interactive features.", "short_description": "SAFFER is a VR discovery and community platform built to bring players, developers, and creators together.\n\nExplore VR games and apps, discover independent titles, connect with other players, join voice chat rooms, share community posts, and follow updates from developers and studios.\n\nDiscover More. Find Your People."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saffervr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SafferStudio", "support_website_url": "Https://saffervr.com/support/", "website_url": "https://saffervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1345703905295612"}, "review_messages": []}]}, "cover_square_image": {"u
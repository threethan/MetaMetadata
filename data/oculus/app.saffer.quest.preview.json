Q7kNvwGKcB1A&_nc_oc=AdpxX001H-xf28EYFUSDNuL2Y3Ab36DjtjnLXii5TPGrD-N6XhCkCgf3OwscJji11vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpzMrIWbDl1vkVio2ADT4UecqOFQcfBcOiida5gleEEA&oe=6AFC6EFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Saffer", "keywords": ["VoiceChat", "VRgames", "GameDiscovery", "VRCommunity", "IndieVR"], "long_description": "SAFFER was born from a simple idea: discovering great VR experiences and finding people to enjoy them with should be easier.\n\nAfter years of exploring virtual reality, our founder faced two recurring challenges: discovering new and lesser-known VR games, and finding players who shared the same interests.\n\nConversations with VR players and developers helped shape SAFFER into a platform built around discovery, connection, and community.\n\nDISCOVER VR EXPERIENCES\n\nExplore VR games and apps, including independent titles and hidden gems. Browse categories, discover game details, and find experiences that match your interests.\n\nCONNECT WITH PLAYERS\n\nJoin a community of VR enthusiasts. Share posts, discuss your favorite experiences, and connect with players who love virtual reality.\n\nVOICE CHAT\n\nJoin voice chat rooms and communicate with other players in real time. Meet new people, discuss games, and build connections.\n\nDEVELOPERS AND STUDIOS\n\nFollow developer and studio channels to discover game announcements, updates, and new experiences.\n\nBUILT FOR EVERYONE WHO LOVES VR\n\nSAFFER brings players, developers, and creators closer together.\n\nOur mission is to make the VR community more connected, help independent experiences reach more players, and create a place where everyone can discover something new.\n\nSAFFER - Discover More. Find Your People.\n\nAn internet connection is required. An account is needed for interactive features.", "short_description": "SAFFER is a VR discovery and community platform built to bring players, developers, and creators together.\n\nExplore VR games and apps, discover independent titles, connect with other players, join voice chat rooms, share community posts, and follow updates from developers and studios.\n\nDiscover More. Find Your People."}]}, "developer_name": null, "developer_privacy_policy_url": "https://saffervr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SafferStudio", "support_website_url": "Https://saffervr.com/support/", "website_url": "https://saffervr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1345703905295612"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1585735192756360"}]}, "baseline_offer": {"id": "1585735192756360"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793950140, "status": "PUBLISHED", "id": "1585735192756360"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1385334597999209", "version": "3.4.22"}, "id": "1084929927779569", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1345336798665656", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBi
pg5uVFB6-FkvQniq0fdXShykhW_jWxqtnbFwVK_2MpMBPQA7pEdHGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRydJp9Fe-GQ44NCBlsYNhUeO9cf7THi3SK5yHTql4dFA&oe=6AEDF19D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4cyJyG3398Q7kNvwHX75un&_nc_oc=AdovM1ZDJC_-gDwiEzK5X98XDJKN8_nksIoygAfyhcXLEGmuIkLMp4dxIFjkKzXVUf8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqoCzYMvp4_pFZOTKr9lIYQGmmOjnjg_CXdZtuoowNEw&oe=6AEDE23F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25899896409691720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830147_1437795637985282_6673900107429206536_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8PqDYT_54EQ7kNvwGv5xE0&_nc_oc=AdoAL1lyW212VCIQJvvMj62y5LjELEFUO_M9NEb8g958mB_w1emI8Kndq4-cYo0C_n0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2Rkni_FLyGmX0JZvdyRdGGCWPdPCwPo1C8XeSPaZCEA&oe=6AEDF270"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Turtle Hangout", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1772660640, "lastRevision": {"nodes": [{"id": "2588046179
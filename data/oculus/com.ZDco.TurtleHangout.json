nt-atl3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5STdmUL3H2UQ7kNvwFdDfuP&_nc_oc=Adqyg5EL-RO8x96b_aJiBf9N-HJsinExPLuRlJyK9e_OXqEORroJjBxAUZ3mzw4lTgs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qGVwow-SoFng-B0JlUcJyVvklzQfu7iRelnhxIG63dw&oe=6A219D4D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y339Lot0rsEQ7kNvwHlrS6c&_nc_oc=AdqnvNXlg6-ToW18IxqmCuC7pF8692f9FKXUmLLbKEbij1_jhGklQkKdwvGijYhmI5s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HYMUkkK3SLyuPWwAg_mOa6a4wmIilttobKYqHd7w7WA&oe=6A219D5E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Fv83teWNWcQ7kNvwFSTPin&_nc_oc=Adpe95edLCdigsd4GsgnW14uKqsqyb7ywXBI6yLXw0InjcbSiJ1-EcCPQ3AxXoNsUkk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PfllpBRBlCUrq96KKWDK8jESijgdRntQioDTGK2fD8g&oe=6A217BC3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9UOHwWfYpgQ7kNvwFYONcH&_nc_oc=Ado23SbQBtc1NmAH52C1NCYRhS5DOKk6c01AHoGMrKnQ7k1QaleyJF1RMkJr5qekO6c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y3bZqjDOAD1OVo62SpF-JRLgW45O33fBD7I_nGD09YQ&oe=6A21991D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVlVv05eUb8Q7kNvwE90tyV&_nc_oc=Adoch46fUAGEPjuDOGRJpbMED3hd8FPaniO034Y4blGD7vg3R5_keJ1Yu9swHgF6BaQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-efVTlGUyFYfiQvWAmtkE1ZCpoAN1RYff1DJznfgt8hQ&oe=6A2189BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
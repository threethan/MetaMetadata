OsRG6KalKPJJ3GOQ9gkm8wMHy1ObUyU5hMbke6g4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af020PbL4G-Hmrj_0HFG-ijEGk0-NTvzVqV-npWYAEijgQ&oe=69F1EF0D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmQU8QMGGBQQ7kNvwHCKaXE&_nc_oc=AdqlRwjXGOY0cUmTRZ_QUCqJax8aW2H-pkWbpTV79Xm0RSlP2xglte4i-1yfuB4YYQ0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3Ei9mAui4p7zdI-fkHxeo22zYNs5zEO0o7-gLgMuXZzg&oe=69F1EF1E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BimfZN0pxbYQ7kNvwEuDFIf&_nc_oc=Adr3ErjRTmqjC-YIKd1Vvrl68_E7iN9jDiEAVbBqXa58x6tK9jydUm6iekeEDTk9rzc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0vL_JQSGkIKxX3cCxUJYgqsbS5OfSfNE7Xq6pA3BRDhw&oe=69F205C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4opWv0xgUXAQ7kNvwG7cX1g&_nc_oc=Adq9hCsIiZ2hpuXBp2NXd1-f0WYtIiv2i-zfUEw7Thu-5qWBt7cR5h2JRkSvofe2Nok&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2y_y8Pp_XFVXbj6PxFRbBBbkY3YciH4sSvRr7N__4j-g&oe=69F1EADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGx5Ev2XWT0Q7kNvwGS9fUP&_nc_oc=Adp6MiySAqFp0RfQZzRpnJVU57cYbafZTOL-IgGZKpy3wwH1YzyJFuyLKi7UeOIECNs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2Ueq0AQJ3k6YJGuvZr6092dTieHUhVPZQQ3mERsy689Q&oe=69F213BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "
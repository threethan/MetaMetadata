ntent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CfL4CqMXZPrRbRoHOuWOWQFw7Gp9uLPFVl2enKElmkQ&oe=69E8B48D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3p8g2T4D3jsQ7kNvwEXpygw&_nc_oc=AdpRDGJPNQPxz0LH0Bk5Qv0duC_pKlSmeHGZ8v9Xc6mAqOdVGWUZ35opE1vQ6Fsz5F8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08f1d1vdwuAyGZSDEuqQ3OEHgd34clJ8_DR2YSIZqaPA&oe=69E8B49E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_8SY-bcFJ8Q7kNvwGHNCob&_nc_oc=AdpHE4g3aHUPLVfdIILvdTIM40NDi3pbdCH2SzNB0mzFl46VZ0TwiZuwOB2F_fUFxug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LUCrGMM-sd9TVnWUlLLrPIMNCXDmxRRQtKJuDa-djdA&oe=69E8CB43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXbb4YFCl-MQ7kNvwG6wMZc&_nc_oc=Ado7YU4IH4C1H_m5ULfougee9_WJtNdyB_r7UZ93OkY9JXLtiGeqrW8jm_5kGsguj_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15j45TaBHU-WQawWbr89_cTtHA7Koj7u8c1M1DB2MwJg&oe=69E8B05D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8C1F99WwH0Q7kNvwETZH3I&_nc_oc=AdoDcn__GuABl12bvy7Z5SvTmKvUIIDqq_fkhm-O098mnU7raZBCKNhUjtetwCQ--Zw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BWbCeItj6FJbxrhq0rUgtGt2ba7Wbrw8BQyKN9L8vjA&oe=69E8D93F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_are
nt-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bpMOKX42wIQ7kNvwG5x8x9&_nc_oc=AdpYAPhwY8X5gAGQ6aYOg0nrjoVpQYbb5HPdPX2Wu9K0Wa1aDcWMPYeJdbtvgD7mhAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93Wlg8b7nQNgIjA9i1Or74daa7NYNKY5n1DWnhniCiEQ&oe=6A2834CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1urxjKCqe2sQ7kNvwFe_OI2&_nc_oc=AdqCr65XnC6rqD3pvsksfAKOOSiosEGeV_AogdVnA67u78EIArTRqf0HsJE1PRwdO_k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JK4NRrVYQ_JLkqxl4d83ACYd35SNfyuPiDawrL7N74g&oe=6A2834DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5y61n1SQT0Q7kNvwF1Zcti&_nc_oc=AdqkOu8szsU6Qwrj1EBPsngb5UeYahWu7nBLCRATdyz5xkwA2HvoVnUcGTfU3GNefPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tq-N8F7_7R1BY8ffZ6ukcI3WfZmN4HlXBA1ZxccQpDA&oe=6A281343"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-gYE1OkXnAQ7kNvwEPYPdc&_nc_oc=Adp4tzenEOYkgyxvJHAD6OZ9S3kvw34wlOss2I-5TrMR66WcGEZo3QrvfV9hYkhR3LM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S3DQexJBZUbWIF2SKv9qGUmv6CqXCnTLMQRkFWvVv3A&oe=6A28309D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPdtEMwTMdQQ7kNvwFiFZXn&_nc_oc=AdrBpoYbEEs7Mvs__smpRqCOlK7rcWSJgy2nVPn2qvV4kRrkORFRzH7IBxQhF-m0DFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5k2d7-_DgV4ekOtgFa5bQp7p2sctSDOAybTrIN_Ppdw&oe=6A28213F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
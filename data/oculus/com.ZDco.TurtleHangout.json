ntent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C94xhSOo3kcQ7kNvwGMOMjC&_nc_oc=AdpdrkP3Hw7TM7_CN1oL9EwYgHhjRcM6C_OlsC1nW_sx2ZYNIh9xPz3QE6zrj-yLL4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjKW4mbVodxt7dC5HKLslh706W1V091JCYA9QHACR9tg&oe=6ADE23DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnsMvU3xLGQQ7kNvwFRHt27&_nc_oc=AdoHonDr43XRNHp7N6Ulxd7gK_rkNQmzEwZkNB8-ENs7TN7Z62Mt4NLpk7mbA65Ly24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk5Axu7k1Gr4ZGcNGgDlzJZ_TVL2FkWrGpA1RUdmRtNQ&oe=6ADE0243"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMQcWqf4fkYQ7kNvwG0m8wP&_nc_oc=AdrKAui-O91eXubrAJSz5lTyT4ulC2SrJpekZKU4pcOznIW5NEHzBG-D2QAm_ggMwgs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1ZqBBrjiO8_UBPs-0NV9SxS5PcLT5hPWWQp0HJVcGyg&oe=6ADE1F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkP313N_BdgQ7kNvwHgRZ_i&_nc_oc=AdraN781ODCpFrS_lErS0pskDooprLZ1QlgH1T0Zkk1YJ0Qu1cFFJpfQ9CXTZwuBbYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWVPzWnoowv8E-6ofz9kG02VEeMrPgGW0ShVd9cGDVxg&oe=6ADE103F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUC
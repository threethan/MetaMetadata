nt-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1XFEUGAXE8Q7kNvwEwPK4t&_nc_oc=AdpS8gnPZoS8gDdPJP55I0Q8MvdJT-MLQ6oQ15H-khnFkq8axhWozbHmz3ZBSc_m4Ik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_t2Zi0DWjO99rMJYQ1LPqUwjviD3UkJuf21bh8DuWiw&oe=6A5CB88D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uxj5eLz4dK8Q7kNvwGRfPrw&_nc_oc=AdqAROSw985eSgqZpJ35R89F_s6Yz1Nv5mO5Rc_tZ6zGtLyMoCJx4BgOwB3P-fNlbww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZq0_DPohcwh344rqg6ib_sOzIg4e4_tYRxSoYxxNg4g&oe=6A5CB89E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rie1LZ_9YYAQ7kNvwHBAk6_&_nc_oc=AdqpUm2NCpH8DQlYBs27TdKuZdFHE4M3dZWuyU8ipXC91MPz6-bPfcE4x0gwPT1mCmk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVQQQoBwzdpGBaKmXCcR-M9OTqVOJgeZ0JRyU6U3wtbw&oe=6A5CCF43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQvPWRxq-9kQ7kNvwGiDUm0&_nc_oc=Adr2tMRukWbQ9YSJ8TAQPS7vV3qzgPnVP_MH6vtDW7ivP5RLqGV6XL2Werp8sg4qboU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcxYK3dhkoz7CWza50n70bGKCqNOevP5o2LWnRvW_pug&oe=6A5CB45D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3VPGTFtQkMQ7kNvwFxDIN-&_nc_oc=Ador5_Cj9X4zuy_Az2QMzJthEERRbqRs5WsbZYugK9qD69VPrNLKrNFjwChvbEj1Xvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWyowT28X2R8KLg-qOu_XDVtP6MzcGWKwwKaJlCzpW_A&oe=6A5CDD3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
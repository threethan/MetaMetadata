nt-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLm3Oi8ETf0Q7kNvwEJFIfE&_nc_oc=Adp_65vY9Jkw7A6sazaSNudRcHnhj9OZOboqBi9Jh_KYRoq7ZxKm6f9gWqbA688UdYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHOa9CTW1FoANhLMILaojZR_mcf2uUvxTQyVMQ1tZjQQ&oe=6A69E78D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkJCWdBc5eUQ7kNvwEI4yfn&_nc_oc=Adpd4kQFxuyRR9J6JVAjtIFDZAuoOWEQlN2X--rE_DvFN93UzlxLXM12rtcA6yolejQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2nM56i_Rlc0_f_ErhFptckkA5k7lP6UKVdG9T2a8MVA&oe=6A69E79E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uMWEIjKMR7cQ7kNvwE_37wq&_nc_oc=Adr_Jxnr6XOjqQbrAhHfYRG1CFja5IeGCx_mga_NkN2BSMRerunyVyCGcpW26Of7V_k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxiAMbIRNbxD6qT6lCMyzQk_G6-LxGFTqwNykuaakMZQ&oe=6A69FE43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeBPBncYmDgQ7kNvwGqfeTj&_nc_oc=Adp5xwWylqM1lb1HOrYnLA6_aJXxqvZ-kNob0TXIZXut6RslLah1JODkl0o44vMJjdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk0qWfzyFwAN73mpYeQ0mBfmMAgK2QRCKr2bBdnCFGAA&oe=6A69E35D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDbEunEW-iQQ7kNvwHHRNFA&_nc_oc=AdoDvHH_gDd-HIhQnOtt1hul5PTVmTNg61O2mUj5-DDabuEFeWzu6uvWM49U6RWz20Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD6u1usfnzoajNppnDR5gnRXjvieyKtK3SBzAoF07vCA&oe=6A6A0C3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
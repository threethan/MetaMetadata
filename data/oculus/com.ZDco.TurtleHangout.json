=1-7&_nc_sid=6e7a0a&_nc_ohc=VbNOsOBAA_oQ7kNvwGAi0mL&_nc_oc=AdpDSywOIQcJ-v1yQeq6-4iM_pf6XDfHkZ1i8zuhKldpsZGlLQO8UfsiTZUE8LsMQX0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpSH4khYpA4IwVP6TtA1dXcStur35ACXSk0jZkq-GVhQ&oe=6AAEADDE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiVJD2hZ7EkQ7kNvwGV4rwk&_nc_oc=Adr9JN725ogtLDcSFSLDetqyuEl7jRnoQJL7vN0g_xpjnA596VzyXXWDFUSiHFNnJrk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyAKymfGIVv1vsA2nTX_i4qz_9auYsd7AO5fycOuxlUw&oe=6AAE8C43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_jqolXK3lAQ7kNvwEcS-zF&_nc_oc=AdoxLFXG7H3B6FJVPsyKZOxIAe-dOG0U2tpusbkMFjmComQV1LJ6-cke3vKTOylCmTE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwmFy3KFoai1gGVAEG4y42NognOw4tdHqNtJTFe-oL5A&oe=6AAEA99D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ya85nYfIpwQ7kNvwH7d6JX&_nc_oc=AdqrRA0Aay7-OUL1IJrFyy345HvLA13uBFq11hXEBwq9I1gIx3e7LRMzrhEWiyj5ErU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpI2YZnlRHs7_q2EoCKlVFssKTOGoWevOhJPA-D7gSTA&oe=6AAE9A3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SI
nt-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTmRM8BVJkIQ7kNvwHscKZU&_nc_oc=AdqHDRnhK4sJuyk2hpDG2XUf2oJRDLU5Sa8KVdsmb9N93xYweUwIMjSGRGvTBFxrCD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAukL0v7xoH3WHAq0kkkjj0W8qwQWSUMi6ygeOOt2BZA&oe=6A707F0D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzGGbJu3HBwQ7kNvwHGiyy2&_nc_oc=Adp_QwLknmU3yxQyYeNwNpLgY8YCZuTIFb4SpE-pMlluesgoqOvzjy5LE4tp2KOyqao&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnDXeaTU2Q-V6n6NBCyWbKLDPcmBO5QbtqOqDJKK_prg&oe=6A707F1E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcz3wdwAktEQ7kNvwENZ_XJ&_nc_oc=AdrTUc0v7lv2Cg65rKl_MypWRgYrI51CUqT415idlI0ENyJ4Xpj1I6I9WfRdRonFGas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6v5bii6bXcCljiHvtnD6Pm3e3EDLla0l0tXhIt807gw&oe=6A7095C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XubErgpAqDkQ7kNvwEDsmdI&_nc_oc=AdqWBqwya_0xOZJEGIsr3ICX1F3OIvpaVTGWiB-_WrTKddITJwbM-dIAWCF9oyPCNug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn9W_Wsu2y5FjdE26R-GGGekrf4Ldt_ZXE-f316FOX6g&oe=6A707ADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYV2UA6VYP4Q7kNvwFVDYDS&_nc_oc=AdoTa4QPfX40OQu-qVlkVmFDYIXt4oN9pzRMQ7CcuwLcC1UPFvg9pxlRZPY8yiaCcDc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCTrj4zC-a4Wk8ODrHZV7F_Nh4WHJYFMJ9e_OGeDfYPQ&oe=6A70A3BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
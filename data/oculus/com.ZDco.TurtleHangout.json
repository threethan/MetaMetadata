nt-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hm1j1rnA-o0Q7kNvwEopgU6&_nc_oc=AdpOw8OGSj-IT8e4FvRTLJtFvgw1t_OEzm0ylL3Nm8rngVzqki9jSVjq2ieUWJ0y18c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_LKYhe53bhhN4jbc1y-KpMaMKRlmfPW2FnhHvM4nDnA&oe=6A61FE8D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF4kkdvstrkQ7kNvwHkN81W&_nc_oc=Adq2PEcQIi3Dbb3wqI3QfRLnzIO9eM_h-STQBt1N9idHpdlF0flIWyH_aMUBwMUQczE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwHADWeMOr00QcTLRI5ium8DWN081WHKlrrMD_ZaCIiw&oe=6A61FE9E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gwLyOdu6mYQ7kNvwFMmpI6&_nc_oc=Adol06krlPl9yP4UABCkJdjJaN_Ypfv3iBCuZw0zXvRj8AMkBUcGkx3uE6Uk2QwD9X0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp59YjvhQZA_FG5cGwEGkYWlppXYS-bu979O-kJkNR0w&oe=6A621543"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmnNgRBkP_4Q7kNvwHxLKLM&_nc_oc=AdrDe64CCKq1nkSjsZDe515Rf9TvG0akhujXEIlqLWmOwE4iyi2wTrej5i8G_jqYEuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGFzL16UVcXa-bUgjxlqi-w1PXif8vbp5ORGNSWxcsxw&oe=6A62329D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfQckhoG7_UQ7kNvwF-UsYV&_nc_oc=AdrRTLkD_UinR4MufIojqAGszMa_rG8K21pBoRoSabqJtDiANqGNWD8qPXw7Mzk-hOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEKvI4t09XOVUihQInM4fW3Dur2PGo8mAh3M_rPXUYpg&oe=6A62233F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
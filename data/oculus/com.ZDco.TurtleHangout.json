nt-dfw5-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1XFEUGAXE8Q7kNvwHhUdLf&_nc_oc=Ador7QFD6NeqyQvqf8Sa8Kiw1YDblfOlVFoyolt3QFa8mKX64Jl3kSJ4NBUo66_inNE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZe3IF0UhZtoiTO7cBFeGVUArEezDHvcMp6ebyqA98GQ&oe=6A5A158D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uxj5eLz4dK8Q7kNvwFcI_7F&_nc_oc=Adrz2Ktb8ObXlNDO0eulsfXfbfJHJ8SS3u28on6NxEOZ_exikFO08aVw5ttORc7P3Z0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAH5NtYsVoaUBU_m9QNbyNhzHJIVLGOIILsAZU7LCtneA&oe=6A5A159E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvxfQd1SHN0Q7kNvwHeWlDy&_nc_oc=AdotxGbN9vOJkWQ51ciVgxDulDtUqSuQkh4umSh3_PUlGiUqRmPsVRwJ8ZRzptk6EqY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChRmNyRWNw7Q7psJpEwoYY7N0Sgctbal6QR0VIuS-_9A&oe=6A5A2C43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQvPWRxq-9kQ7kNvwGCq7IG&_nc_oc=AdowZZcArw6icWIGmPKOgVQ8DZt3VaVv5_zn4upF-V1hNixoCqQKTn2h9jwN_Y41HiY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDuxgNDiK1AyoL8qBtles84gga8Xbh3hAIpRglAcDaIw&oe=6A5A499D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvXRDEmDwlYQ7kNvwFwVG-m&_nc_oc=AdrJfSJ3u0pyrZO_v7Fnj4Su8688s5ePH-DSnUE5c8VaMj3URWOR3nuFA8fTcpuVxWU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4wk6z4VDSOTQva7xNEHCgl8LV-zuQ1l3QKz1J1BowGQ&oe=6A5A3A3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
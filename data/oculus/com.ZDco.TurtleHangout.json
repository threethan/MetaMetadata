nt-iad3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avHRkilsjqgQ7kNvwGV2WLM&_nc_oc=Adq50dJdcoxytGvm6VHMEupiSezeXPnrOvYRP2WHRsWjBaeO_HFTmiULrQ96Fz-GD3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y5IR-_wvHeHv7apdLr_RP9NRQx7TFO78MqLaE7AMm2g&oe=6A2591CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bL7vM--S-c0Q7kNvwFfKlga&_nc_oc=AdpDBRKkxaeuRSk3eZdVA2D9ZSHYq4S035PTkW6FF1FjNTm137rJvSwXr3E6i1fnphc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IvR4Nv9uqB4boI1cALrCD_sSGmYdBZH8z2BESgyVddQ&oe=6A2591DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5y61n1SQT0Q7kNvwFXAdtm&_nc_oc=AdqYjzxBzgl95k1NRRV-W4IkhCFtKnrRPEwTRxLEsQalvi8OuODsQpkgVeJtAGPWJ3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af982BGGFKJkQg0y4Z479zCYleSwtQnchA0CvxfEbKqf_g&oe=6A257043"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-C7KiWvQhwQ7kNvwHyfd7W&_nc_oc=AdpkoFmpncQ2VMYU4t5R2RCaE5GyPvvjVV3PNON-LmVNU3B_UArNMJwOXHpgj1KOWBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XffFDGrmm98LqSBxjlMYPlrCH0xhWZCI4gG5qH8cyYQ&oe=6A258D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPdtEMwTMdQQ7kNvwG5FMD2&_nc_oc=Adq7m2Hs8gZ3Fkki6xPEh3cwkUaegFpElpNCebQL1P5Ddz5yvEaQKylOrxU2mavoLHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-dWIYArbUmov1gK1O25cjMChTblfmUwsfx-_p6Uf1UA&oe=6A257E3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
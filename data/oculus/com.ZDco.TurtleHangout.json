nt-fra3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f82JFBysND8Q7kNvwHSa-_2&_nc_oc=Adp1pcYJ100RpT_iDGl0b8hY_RaAgeMNjDGb8pxjV3V8I8Ylv0DT03PYFlG9BdCJza4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUaSC14Tes6ZkKDjmJ0RWz3i5YnCfW-S1eV5G1-nqHJA&oe=6A58C40D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PciezwvorjoQ7kNvwEesYsK&_nc_oc=Adp-lfzd_DSFQA2Sr7CraIaVvA7PTHYRWxYOM7soQooi7KqQDUOgyGG7n4seneDguUw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1v5sy_zDGAgDMwx-dx366zzgF5hq-SI21DnzYtT6bJg&oe=6A58C41E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvxfQd1SHN0Q7kNvwGOo-xI&_nc_oc=Ado_JG4Zkjde9k7h1bMOQtWmMauHftSBvwXVrlURSKKlJjEC7CUxPpomhJLj0fhOeeU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC8D5IanyYBcgJXGdmi6UBK0YA4-Kff3--yEDPqcm6xQ&oe=6A58DAC3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjsU39Vvh1sQ7kNvwEko8-L&_nc_oc=AdpwSwtnfBTmi1_KmAFlrk5JJsscE0e6xwwkhM8Ynb02gnr32-jTCJFo9IaUiUMhcv0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqwA-dSyYTOC3yykdn4SBsOluBVqBR_AwNFt4d06NNJQ&oe=6A58F81D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvXRDEmDwlYQ7kNvwFZJ1F9&_nc_oc=AdpkpJQEwV6DhxpRRocQKIBZ7LI3wYG17a1X9l7gg23c7i9kBhKyiXCI6ah0pbrcdDY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhSCs4gQoi9IW7655Vxg4ivfGV_-Fq6Vb8Gn-8-ImNXA&oe=6A58E8BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
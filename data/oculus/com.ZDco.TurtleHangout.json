nt-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKE-oykO8LkQ7kNvwEZJ2Iv&_nc_oc=AdoxOokZbOzjORzLB8W_lSEbVq49V6Hc76ww80NrnavM_VIN3KXdy5nldwFrR2BAMn4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sTrHf_G-D3lxzjKRZLBN9teNzLV6vxB6gpYZanD0-Wg&oe=6A0C854D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2iF9mYz1ngQ7kNvwFt6iKE&_nc_oc=AdrN18f7BiSCPBXeaBzL0JBOClgyPMajKHiBgXTWmGQX5SsQKyjtDcWFhWxGIcZRFwI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wCR4tShZI5bFwnySvlvYWLu1pc_eBd6FGhMMyyGco9g&oe=6A0C855E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keI3LBYMtn8Q7kNvwH2Tfzp&_nc_oc=Adr7x50BGDpVlTqOdlEID9KyhYd3bI-n0bcbXimvqSBqKxVS49jwol4qAp9g0XOns8Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w6Z-qlYo0jbP3nIYnyCXKAYsLKkQDuJS3M6eN-rpq_A&oe=6A0C63C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azdScO1c2FoQ7kNvwFqqIKT&_nc_oc=Adp5A6o3n7o22HIR3hw8HlUxb-nFcPpMysewQ67_2_TSTQ3R8fexqs6IMgnnc2YGtog&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yKHZcdnD0iX4fBZ2nviinMLRewEXKroKJEtkd8G7cew&oe=6A0C811D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqLh-UkOYPkQ7kNvwGMq9KN&_nc_oc=Adp1w9SFnrT8vMaCMu5FOnOqI6RPjZvyC7u9tkiUte2dZzmmmVFys7QxXHeqMxwcS_s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-USFWZgHmINlNN5R3ckEmRI5qbFH6aUTyFHLtDsLcSg&oe=6A0C71BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
nt-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZmtHiktvJcQ7kNvwG1AI64&_nc_oc=AdrYpIRGNL7uFcLLyuQZcE5hi8kZA2imLnahBmTPBcAJLxbVevapDCFXSgmuks2d_ss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YC2fIy_yFp97UvYxYtdoI_i2L-wj_mxI2rkSqUE24Og&oe=6A47D8CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12B5e3v7DpEQ7kNvwGs_Hlq&_nc_oc=AdpJG0B84FdPrkBd7pPjZSQtndh7V5qr32npkvTCYyGIr6Axqc-7N2tVqw4V7BuOzz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vfJVmMAyBipOGIhsm8FubRuAyu1b5E94xzWPov-UYZA&oe=6A47D8DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eIkpknLap8Q7kNvwGXOATv&_nc_oc=AdrUecFsZv-u4Jv3joF1CcfqS-G-Z9OiU91JuQf42FFzVW0KctHpxXtBLiMjQA3yj4s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RVpDm00bUh_UQmT6oVW9-skSemYAetFv59V7PZEhj5g&oe=6A47B743"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZaEHulirYwQ7kNvwGuHI08&_nc_oc=AdpP4dGVARQPlAmkqJq_0KvlL37T1VgPVLqEDbZN_v4nwJ6c4RES5UPIy9u-6RofFKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kAMoDSdiRtax8b1uWghyeMpS20gRyoR0FzGl0ztruyw&oe=6A47D49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJiR-Q7KlzUQ7kNvwGjh6fo&_nc_oc=Adohz1nowLs8DKM3EclgaK1r-l3q0mIHJkt9oX0tfRHytWonWy6GVprp7ojVaYAmAPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wlowSdmYgZnTMm8vxr80C1c0yzom-dCkQ_oOQx0usCA&oe=6A47C53F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
nt-atl3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8NlPmiShw8Q7kNvwHzyv0S&_nc_oc=AdpZe5aKymHtCVBo_HDQSWh04Y64zb5T04obJ5uFX58LAJ9ZB7XiIoPRdbHEzggKwv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEfYA0aqrIqijvicAuECxJOQLt_CcVbBNU7FkS6IAbHQ&oe=6A71D08D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJl7uOH0d6EQ7kNvwHTuks-&_nc_oc=AdorrIXmcEiV8xQ-aOwULI_sVLC6FGIMk-tm8S8gkEmyGTwyxaao5X6mH6NCyxiwEqE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKwfs2La0sC2ywn_0ajAZN0Yb6PDHUSXkkMg9HCHsKRQ&oe=6A71D09E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tcz3wdwAktEQ7kNvwFZgf5W&_nc_oc=AdrFBZzR1AYhQdmCX4pm_TnhXZcDVJfs4nqMHjydDQYDeLRHReTjUy5XhQEJIpRv2AQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCYZdQGE8CL1VxdDeV-Gywwce6EmE0JJuo9-4I6Y3FiQ&oe=6A71E743"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NamImgBwG4MQ7kNvwHnQEW4&_nc_oc=AdphNa-nEhP2AHHUtD1wxxjG8dQWKim9bf0d-rOu-dMG0XHZV2xlHiXwzFtJ_gm2rhw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEe0bhZIANMZ4d0Np02yYEAw87GDx05xyH6rRX8VoG7sw&oe=6A72049D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYV2UA6VYP4Q7kNvwE89VLd&_nc_oc=Adr7YlKc_89CY-NwGswYa5VADlz7r5pb93ozfwqNiwTMMDFmIDTwYuGxlFlyJvBy8v4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUIs4NKRKn-pkw3LOxaqpTPFdqsGkwPGFwGxheg1EiyQ&oe=6A71F53F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
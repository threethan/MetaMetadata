nt-atl3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTmRM8BVJkIQ7kNvwF1sKgd&_nc_oc=AdpoCFgff3nMjnopMHAdYiHjSvu7J1Ez_6H--glIkdZiN_j7LehulBAOH7m12hQtH6w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_hLroSleKodKX7fHnLkxvKF9vABIQsourBCl4U5GT2Q&oe=6A6F2D8D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzGGbJu3HBwQ7kNvwHxx0SO&_nc_oc=Adr_z6r3DZCn91tsb7qiypkrNDG2bOlkb5L65Zpk_qy8V1iG9SFSWHSo8SfTBLH1QCg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuUkXhFTRbRJBrO5ID6awC5mUwUx_BN_SQfAIXbnTiYQ&oe=6A6F2D9E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6vb6RVhJVIQ7kNvwFC8WWc&_nc_oc=Adr3xQVfHO3LE4OSOsRQpn4QCvxTS3fJ1uK3HbwxyvObH06la9WvfjaGGiwFHHZ9OFs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-fsJK3zZFlsQR3igh20x8KJ5fA0TbXwvwaAaeT_co-w&oe=6A6F4443"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XubErgpAqDkQ7kNvwHSU6_t&_nc_oc=AdoSDyYCPi53am2sL2_4hqbceYY2w_DrTywUenCeUSzSaIEjcr2Jb5qK6fEh7AcPrsI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3vlNJSjoHW-nsdeJsOFazld6uduohKDtRPIQgV2Cp5g&oe=6A6F295D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aMZi3PDjU4Q7kNvwEzeLL2&_nc_oc=AdoaiEVWJuU7IkKmgiyNef9NGnrhkfG5N3zU3bAuN-jUce95Ti3BMi1wWx5mI7tvF38&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCyfMmVPTtEcITgCs_ltPg44YXTy9JpCnMSogV_wxq5Q&oe=6A6F523F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
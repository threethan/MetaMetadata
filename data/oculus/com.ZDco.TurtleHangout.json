4_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi8kldLWQHEQ7kNvwE07w-6&_nc_oc=Adr8DYuRR4J1_eRRT7tneZYdEpn7CTBzzI-fLespJRSfPCA7C4nlcLwfostd4VT7FXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFxRaRIBsic7f9bNDofLQZasjQcz8aX_nl4HF2J24_XQ&oe=6AF1EA4D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7wWy-384eQQ7kNvwESSRp9&_nc_oc=AdorU4PfkJ6JXM6rWOlO4tXKi-UxCV3UtSQI9LdyM-xZg1FyrFMqK6kkmBOFajn6Lok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwt0k5wz9xgEFdSe-PUOpyugW0I6TY8hDEP5ZBrDqc4Q&oe=6AF1EA5E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt1lCRzubZAQ7kNvwGSITFr&_nc_oc=AdqwlR2XdSStk214gSljqiJPXSMlmtCClqPCCKaPCs44RsvEr_EWD6wEpwjRNyZAXXM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwwIj0lGIzNW4PcB5D-5SDTTvbVyZRuKEMhkqUCIkv1Q&oe=6AF20103"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-kKN4gObQ0Q7kNvwEWd7Wn&_nc_oc=AdqvWQv7zBq0RGfYs4pgiPZoqpNyYTmgOAuvt4Cc4jkOt8QvsRmA7MQHBMy8dyTqEHE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPREhyozPYPyw6hToJcIXJh6Iy1lvh67TyY0D0Qy3BtA&oe=6AF1E61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3Bftprs_tgQ7kNvwGUmm6_&_nc_oc=Adp2nUEEeOyuwK0hTHougCWEa-51W456xOJKMIbQHKvPg24eIsPInknDJmct9LT4dgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpH-Ibz5Chl_ioTRwJ8x98tPTAJoZDIsTJanFqCGk_tg&oe=6AF1D6BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
nt-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZgMiHWLHzgQ7kNvwGMLrFa&_nc_oc=Adr5GH9m3-91SlsGf1bHZS-0OLPmClNqnf_JXlDA4wzKH_pEISA4LzRq9xvhRgIOIGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VYw8mFqvecs7Xr9Szs2k4T6907Op7m_sSLC5b9mGW5w&oe=69F8868D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JI5nRlHMg1AQ7kNvwEfzXQx&_nc_oc=AdohtRib3_6PzMz0GI08L4bSlRK6ANKjjvxvZtJH4SOFh5x-UzRz_QGYBLjtu6R-g14&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2N7_5vU9gKyOJRCA0urgHN90s-0FoH8QptNIHJchap7A&oe=69F8869E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6v23dIGVUUQ7kNvwEJhnNr&_nc_oc=AdqjdPzMOqjx6IJizWYAcHHhcNQY7jFfkqXax46uG0Tt6ZbrFJcExr3R0FhuEPSHM1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ycEET_VdSF6kYEuEk0m8DA6Bf24Dw0RkH2lcgRXAf9g&oe=69F89D43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f2A_B5sCmcQ7kNvwFDJp-z&_nc_oc=AdrAzQoFf93CeRhuZ007csixhPLeYfrAE9Nl63mg39YAACb-YA9KiwCdJzo1Y6XY7Ps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24uWg-B6xR0qqO0fnCAuIWNsWRSVICSod-EJGRqiE4Fg&oe=69F8BA9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhxKxICtcKUQ7kNvwEcoX7t&_nc_oc=Adr0eK6vpohf_NGeRnQllD_qGMh8mggZtvDExZZ_ndHoymMjcbY-tZnoZ-xzwiDdS1c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1w4KThWIK19-D6qSiiAQaS-zQNf3f_myJ-QKd9eqXTaQ&oe=69F8AB3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
nt-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmVrRrjr2IEQ7kNvwHsHJPD&_nc_oc=AdqgBoQXVbsBFkuJMlLHbx0V6G79H-A2o5DfKCigrvUycnQLOkr6AIZN3dD5S059EO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YSbgmwB_21GvgrEajbHbhKQmgM1SK7F0Viy4SSt4jCQ&oe=6A3FEFCD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7oulcASGhgQ7kNvwEaYvCu&_nc_oc=AdqPfWAlbC-LOVsd2LpNT48MbNzC7EsE2J3Yd-zudqqBCmqXBIGWr2k-1_AvB0T0ZqI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97NdrmB8JoUCMkUpMqLqU8_BNzXEMf4eUNaEBtHjAj7w&oe=6A3FEFDE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax6e8iC7imEQ7kNvwG1-QnR&_nc_oc=AdpsyRlAdubedcUZyOl_DoqXmgj_kaALz9nsaZU3kL2XReWiqdLk7l-k2vdNW_AUQaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Trrgq_It12I5-tHrA7ocwbpcdPs-4M7fT8S4usXMW8g&oe=6A3FCE43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph8DgWxojSsQ7kNvwG97eLz&_nc_oc=AdqaB3ddJc6uICCw43zFhw31Dum8ohXGayk9q36QDp0_y5raV8PgCCGhjR7tFRVUsUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_zMVgXm52qW6vp9l_d4Js3DSPrzsEKRTy2X8WJULZhg&oe=6A3FEB9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8MRD72KruYQ7kNvwG52FbX&_nc_oc=AdqDRtLFAIgahV3VKs2UPy1K2pCV-70G6u_Maj6RvUkTvpQ-AOzw3JKq7rWQpS5tJ-s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R9zl7-iBjwtzpZrJcPsZjC-feieBOYfBu_2-Xlk0xnQ&oe=6A3FDC3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
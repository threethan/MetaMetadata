nt-dfw5-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avHRkilsjqgQ7kNvwH69bbp&_nc_oc=AdrNWi2ibq9PRwPz5HNh0JQKCWjkCux_5236nP4j0I_G9Z3URKaUfJYlmum1FOaP5SY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BToFUOrsrKND9ogvnPMovKeHdzDZj9PisUzfRJJyLzA&oe=6A24404D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bL7vM--S-c0Q7kNvwGgRi_v&_nc_oc=AdqX4hyzdurBgxaPa4L0Ov6O6wttLgML4fTtsdwYBJ-RJNbivhA9eG4pEvq10FDStZ0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80YChrGugVV92DvInTxDPxNEyjlrP_liNPFpRx_SGCYA&oe=6A24405E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Fv83teWNWcQ7kNvwFcZci_&_nc_oc=AdqusDvOD7FbrT-_h2-M7-4oXv8wOyqfMVfoV18cy59ePhd81rJNK9OeFh9GlkAE9Ak&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Vko3khOn4cr0E2dHAXuQSfEEBMJx9uYS7wbu_QpLVOQ&oe=6A241EC3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-C7KiWvQhwQ7kNvwHCfNQu&_nc_oc=Adp057SJYGpyvmUTwfXWpenom325y7_cCwyxXU7ILR07--dJdUK4QKdKGIWsJLoHJ8w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AskUP6HLnUzXpLcVe20i0vk4Q8qTUVz3al2lwzQ-rYw&oe=6A243C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVlVv05eUb8Q7kNvwH4sudS&_nc_oc=AdrI3eTw3oOTpm0lAgaEMsWppWzkccGx7Z41Upnpz2uvcBBCxLCpm5_yOwU-ZfgBYho&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mzjk1UbKftMMIxyG_o7DkDg4dwD0PgrkYPSvhN4WLSw&oe=6A242CBF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
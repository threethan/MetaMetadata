nt-fra3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAv7znfj_cYQ7kNvwFjOFeA&_nc_oc=AdrIbDAk499MN2L7VehQlkSEnQ3swIhp9SZju8c4mtuEY4s1z6RCls9-SXY6NugTlu0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bDjXhzjLjZvVDtG9GHEBcoraWpeA19s-bIr9CWU300Q&oe=6A2C294D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3Hrilv4VcoQ7kNvwEvyBkQ&_nc_oc=AdpwhhjWJ2uJoskdvG3cSNMra_MVhozeRYUclccABKeUcro0PP1LB6nJ7uQoW5qs96Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ooE1xeReqcHeNtDUz9T2UzZaZDvknURvzCbiGt3jXEg&oe=6A2C295E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSmUCz-GlI8Q7kNvwHNu13B&_nc_oc=AdoWEd23jP8VjQ7466l9hRI8UpzNAGGYwA4K3gxxJ1fpwjbv0W1cYKIDIrvKFlFv8Fc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TIHTf5hy7nECOdsmdJK0B8yc2N0W2iUN71SoHLHyjbQ&oe=6A2C07C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n6doiQ1QhAQ7kNvwHk5nKD&_nc_oc=AdqUwBAqg3pTfRJopsuhdh_lVQyeaMeDmLsAXorIAhtonuD2WKMTj503fskiIB-OeOE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-L0DTiNzDiUSzTkdUGQ7Dxa4Wd4YLEPZQQSkah8--TQ&oe=6A2C251D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3zAZetEvVEQ7kNvwEtjdtz&_nc_oc=AdoUQHdHemLqsbgyYnN0gmc5-1HkY2iEksMZVBlx0DufiyBB6LulwE77sMea2GKENzg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-TYGUIAUj6FUh3KQ1lfkz8tr6gc0-P8GK849LvLYzyQ&oe=6A2C15BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
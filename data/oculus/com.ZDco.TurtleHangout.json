ontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZWfXeeBCg8Q7kNvwEZ0Tpi&_nc_oc=Adp39MTJkcaKWzrKSfxS_ZzWzIs4P1x65Wx0dMesgjN9ojXMIRTSc-4e3JPoMgsp9wY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LqWUlP7vPwDZs_Pi9RPDX4NhO05L_Xe3PBbacbUmuWg&oe=6A36B54D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54_MX9eP74gQ7kNvwHXQikB&_nc_oc=AdrO7zyH0cS0t2C9u7s74cwNA5Bca5RCrzMP5B_Z9RymRWCaoURTBAduHgytviQpX2s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_z_t8IucNSaEaBSjSrFwI3bQk3iCWX1Q1mpcg7ci4e_A&oe=6A36B55E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UtRMQ-KIF4Q7kNvwGOi2bY&_nc_oc=AdoKlvp7AVFMnCacU3GEPYtC_pPjuO95yXDtLgAEt25_gycuU9LBFim_qY2XeBsUgYc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dwPzlldq66heXGFJAP4TjO6a7-R_rhbXOtWY3SEshzQ&oe=6A3693C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjkI4IftlWIQ7kNvwECEQG9&_nc_oc=Adq1E4-95Ot0zqqQIoROPj00RZytCSGpICb_1ger87H7B1Z42Vvp9btw3lWku3tNljs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af911q6Opq2BimJ8n_4Sy88WqKacPsfsTuufadIAo7qLDw&oe=6A36B11D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM1LCZVkqwYQ7kNvwHUhaAz&_nc_oc=AdpHQHmUttjP6H7ti3vIo-Qbbzx8iZAyfryUNRgbBV35shb6ms3CHWtP1Kgv6GmBlas&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LOh_8pcwQklVp-PbBlOYKsAr5j1EZgzB8pAmnctr-ZA&oe=6A36A1BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_categ
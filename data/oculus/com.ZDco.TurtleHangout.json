=1-7&_nc_sid=6e7a0a&_nc_ohc=Yq9m34xyT1IQ7kNvwG-ndZ3&_nc_oc=Ado5gidSOqHfWEb1_V-ZbM6X22RoD5wGhk5vE47wbCpk1HOOwDLwzWkQydiOLqYjV-A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4IkcDJBDxd3pQRKte3QpfJJSqNIQ8bPd47-E88roUvQ&oe=6AA421DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vb1ow--kOUQ7kNvwEfb6fG&_nc_oc=Adq279E8vqqDPdmHe1vARBYLOE-BD9LHfcefhqf2C2BQEt6-CmC7Ght0EOVwGvReZ40&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpUQYi-VsawuvlZt0UCAb3kA7J4YYWpFq-lcLLn5p3_Q&oe=6AA40043"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPj3lyUDO2MQ7kNvwHrjS3q&_nc_oc=Ados0EHauFdjtWGedrlvWEgkJ9LAZzGYs4xv8qL1MxzZKRjja9hEK1PGNHlPdJ98AtY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPwIjDlgwBO3Ymmys-17Yu2b1VZJ0VwjoopriMtjxOjw&oe=6AA41D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkWufZKHp1oQ7kNvwHhxuK9&_nc_oc=AdoiPaaN6Vk4rtN4BiR8zJTzAY0TvMc3WKLQp0EL8TDLXNb3zFh_92ZQ6H954quRqeg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOdb-5kCNNtWVmHiGiYcPPWQqKD-5AfjTzV37ZdohfSA&oe=6AA40E3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SI
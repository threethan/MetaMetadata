nt-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H8JftU6L3oQ7kNvwHJ3btc&_nc_oc=AdpXwwdg3gqavqUMQ9TwF01l_FWVCYTZo5DwrpjmaOhFwzg2aXqdy8auHebY_RoDu9I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IN7nSbnGrr8MLK7MebpoD1lnedmDXBaJ_UFI7zksgOA&oe=6A1862CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Coq2ywklidAQ7kNvwHfx7HQ&_nc_oc=AdoIa62cGoEozMp-OLBSbEqsqK8Lv39xFNsmWcLQ5LLNn2XahN8K5Jw8IotAkRuGAnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X6X19XaRvR8Ywn8r9eFrguEzkwreOkntxDmnL02AgUA&oe=6A1862DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-0dIiQ4Y_kQ7kNvwHjnzNR&_nc_oc=AdpP-_eMC1oXVgGr2oKLBufcmvr6HOAEhC2kdyKCb2uOMC5vmh1FHov2Qh-WrXisqgU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57tgkgM_bmy1taeqwg8aCmFB1u5zAhbaT-a4mZnllpoQ&oe=6A184143"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2DGc25_BlcQ7kNvwE-PwD-&_nc_oc=AdqNiEsdESmVpyUC5x7xKb4FQCqhJcJNnUoyQJPnAfWCFuPSWYtXjVkkNG9NUJPIN-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69ejyj3nwFdg2ZRSTII2bb5cDFjDQxwF8waR1d6HJhpQ&oe=6A185E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7r6fwNN4uQQ7kNvwGzZ4bW&_nc_oc=AdoswoV2RNDCHMt_7ofwkSVycm80O3eqejmpt45FSnWzpRnKUaT5zX8eHeuhdFsx5Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YfDW5QyExceJQKV9thtDiR3j80PSSBV95oyFwcu4Mkg&oe=6A184F3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
nt-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uddh3dBHcOQQ7kNvwFYVia0&_nc_oc=AdpTUbhgZhmyadYTVRhaw8QXwES4fBB79V3c3Pio1lr-L5h9n_Mkrkeh9ZW7xylMPdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASSNfMZowyt69nwplsrA_qSsU_UU9sv92KQRzWkfE__A&oe=6A4A7BCD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cX35dulyPqMQ7kNvwFAnjeY&_nc_oc=AdoSWTG1p2zlZp2d9iyyy0WhQtCFS-vxjHN_pKuQ_6g0a5vEQuj-74eFZS3aGeCNM_0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtJ-gAp2_U1gqzamLaLzQpjMa4kb6TlMFqSbouC4AVfg&oe=6A4A7BDE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Cqw1bkl-1QQ7kNvwEnEGVO&_nc_oc=AdqaX3xUhTl0vKxT-86j7WsOF08mKnJ_vUPWxkZjqZx9EJZ7yJDuF6TP4I3ox_5uusk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDH8Nisey_Yjx1GAMxJ4FlJ6kXw6XrU8fftT7UYM0VPYw&oe=6A4A5A43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbMTaHpGU6UQ7kNvwGVDjWO&_nc_oc=AdpLG2y7pHnp8ZtQUd80Qcw55Xl2NAjKjvdX21-3ZJ-PbRt5S1nKZ9P9WqGTmnabZGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARwQPVU8Le3A3Pj9oYG3e4C6wCNZxT4vnXNRbBbeX9Kw&oe=6A4A779D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2V7eMGMy6KkQ7kNvwFI4LT8&_nc_oc=Adpji63SBXjtl6eUk3c6WmR6UvyHTzjAqlbDPZBuqPnIzC2tEMcKogVyugf05trz9vY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARox_V3zb0Bb8qAcWxc_OK2cRTfl1jIizVp5ie9oinSw&oe=6A4A683F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
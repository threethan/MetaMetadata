st7J1sIDIRlo7vI51_0VQYQytSIugNA&oe=6AE0C6CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpp_8Kd4dRsQ7kNvwESAq3X&_nc_oc=Adp70BkOCxD693R_MMiZ6kfMOzSV_mjVEa9Aisqude7zsyOBc6bUejEZmZCHoa_371o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYF2F7__Wf3U5hFePLti7RdxJeTTObchWcg6nzGV10gw&oe=6AE0C6DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OobudWUjdPgQ7kNvwFldIQj&_nc_oc=AdqyYwzv8QZHxG9rVW8U_ZwXa7w0FpeBo-kVrxcGh8WbXSy-XTOlDM9IK9SX4ezq-oY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl_dYvd4SBLSpFc8PUfyhZLj3YOxuNIeUyfdt1Ad_W6Q&oe=6AE0A543"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcVoR2T75AIQ7kNvwGT35_n&_nc_oc=AdrRddvblcNq0IsiktDH69E9SrjhKbXhtusCs2Yyployxupd8KGWdA-u_phQqiwyO5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKSGhhs5r_ylg_uHm6DQS9Ua4S_1iDzfMhwtJf9LmKWQ&oe=6AE0C29D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MDBSrFH7nsQ7kNvwH1FUxh&_nc_oc=Ado96y9EjRD1533p5_EeqGGuPuSf07ASVr04XRmCsWZ8G29RZkPkISRlur8o3BlAqtk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwOg_rPumY0txxDshc_E77S9B07-Bt5Pq9glAlOFu_rw&oe=6AE0B33F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_me
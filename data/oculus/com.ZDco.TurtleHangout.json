nt-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6iL45gQaFgQ7kNvwHP5VJj&_nc_oc=Adq5QrMQpwchyyzw6QysBgAG-N5bY6x8IrynH4oDozniHq1jgFPPpq0uTIbRzhefEL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ml_rT2bdtQh4ixvHqpuCxSLg2vsk0TXUdSMyU6tPiDw&oe=6A43E44D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lN8UfQvrWukQ7kNvwG49jtp&_nc_oc=Adrpl4rDSK3YECr031DPgl21EAtklzoGZiSF2ZTCamxRapfRt_vquQyv1gLgDchjECg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93MrF9n7XBDboMWe1ICtTLAD-wGWr1NO05lq8PLGZLyg&oe=6A43E45E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JXzLtp4STgQ7kNvwFRcmA8&_nc_oc=Adpv8_iiIAoL3m1bUmKymMU8icygfBhtf8ismiFWo8ybeK8O2nIlU9ZJlSwIMA02AM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cK5ig1ZWeLZovtlHtN7MRWnkALxfeY5j2n_Ej3U1Axw&oe=6A43C2C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti_B5a9vEJgQ7kNvwHgfJh0&_nc_oc=Adp0VeWQdFSiwczstPLPby4JKmHeHKnrXf6eUbe-TlTGOrz76hz97_aOHZ0pgYU-Jos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pFck4WVQQMW7P5NaZf_IT5gUGppRtPvkJWibLdbuQnQ&oe=6A43E01D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPJCyN5EquQQ7kNvwHc2WAE&_nc_oc=AdpwWiNXE8O9N247oJztRr4sSKYl3AliD72ElOgiJDIF7X3nhSl06sf-rMu_McLHJBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aoGhHFhWUoSuWdMKt2LVXciW_KlJsawBTstoiZ2A__A&oe=6A43D0BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
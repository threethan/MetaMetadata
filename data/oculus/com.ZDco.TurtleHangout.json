nt-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUDGgV81T8kQ7kNvwHntmli&_nc_oc=AdrmuPdw2KDOmrfYtJOB4sW0rDQH9b9NamkSgzbhczJGuPqUU3-bt3Pzwdjbx7lcqZs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS9PWm-VgUfBFCGNZjp9bY2wt-Mz-aM79AASwfORfQ9w&oe=6A4E380D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azluS0picngQ7kNvwFSHxPI&_nc_oc=AdqkTDWhHGSrcPwDkJ9TbmxuHla_6eqb85RfEGAsgyQ-SLojPm0JdxImYkh1V_zWeNk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSTqRrNbhveNIdkpdocpC5MKkVpE39xjjTI1Nsvd_lPw&oe=6A4E381E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6L1j6BWAggQ7kNvwGXdJkf&_nc_oc=AdoJchLTlX283PVBK4VYWqhbUfDJDvTIcfeFnrWPm4PDPZxSu0gNSj16i24q_I254wA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvLjzuDl-DAj4YoO35GfPjy8ijN8iDPUVarWh9fTgA6w&oe=6A4E4EC3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dGUgGeX0aEQ7kNvwGLWuDP&_nc_oc=AdocerH95ZKFw4QwaxiwsuwyiX2imUEMoxoO5FcfxI3b1CZ7YFBXWI5shqE9k5kqSB0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRlNXHT2WDJaVxZCYwp0iIiIYBeVt9my589HY1A5rV6w&oe=6A4E6C1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkT-uE6pfl8Q7kNvwEuqFdr&_nc_oc=Ado0cKZepODVLPKZnekscBpNDY0xJGtMErnq8j7AiFRuvFTFMLniDa2uWmLqnDWt9YQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmrYn3WW-enqsXNmpuQUNzvPNHlpIXeibO2aYzkdVV5A&oe=6A4E5CBF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
nt-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKE-oykO8LkQ7kNvwGBZJvV&_nc_oc=AdrAMenPSS3sLB8EneTefNJDhB_sL5NzuqjrrE3cFFXFDKMvGP5yZRSyh1caWOavC3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A7AO2ewcFxFEVeC4a7i1178GSAU9Dju4WQOcm_9Z0AA&oe=6A0B33CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2iF9mYz1ngQ7kNvwG1Tpps&_nc_oc=AdrNNLHztPhAXkO7mth8tRcwliZEUTJ_NkNB30H5BekCCJ_pyPKs1CBCMEG4_ApEhq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O-S4di48Ayz1c2awPKCZvogp8BbQb4lACATwmTVgWyA&oe=6A0B33DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keI3LBYMtn8Q7kNvwGZzI1F&_nc_oc=AdqkuhMoDimHMAXpnxkfH7vTINXePd6N9QCvfz_aOeb9Vs3kcQSigxUmZq7r6-BRVng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7x22lvkynwyBF6x8rqJyqAtkUiLKgJEDqIrHPyjNki2A&oe=6A0B1243"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azdScO1c2FoQ7kNvwGwEeXr&_nc_oc=Adq1ALJ4Y0rLqvRvEyXuNV4bZM3d7cEdZLjRzkMcEXHz2FxwfIvv-clPu4RPOFThMMA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gPgQUYWNCHr-ZlOvpPGRu9-1Y3RLbcX6NU7s0bVOMSQ&oe=6A0B2F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqLh-UkOYPkQ7kNvwEFd2dD&_nc_oc=AdpbQft7DZyhmbrIHCIHI-JJtwZK4eQO05ynnp_2mDvYr7gEoT5DUB2CdXL4v_-X8tA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7feHrrTdzx-oEQnRD6T7ljNOP-cJ3FhbfvcEWEOlR5pg&oe=6A0B203F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
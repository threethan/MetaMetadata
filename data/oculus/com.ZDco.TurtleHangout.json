nt-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmZ6SKicy3oQ7kNvwFH7CJ6&_nc_oc=AdoH6utOWYR04PpAAPWYitRkqEsbK-gks8KcNsXuRJObmmz7RNfP-K_QfW4yxTTJyIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HzUYkBdOpRsmOHgtoIjznzbh3x-98HJaLqYRoBw_1HA&oe=6A01C10D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW-60Pss89EQ7kNvwHrD1ul&_nc_oc=Adp6Y-bo1elcDoT7AeweQgTTofxdtKO77lBeaNKY8r0cbVfNLDiRhvzq1HNTYPv-SdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QPYWWDHjjbbd2K8idW49tOsCWIy3esYu9mDBxARjVQQ&oe=6A01C11E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBdIHu9Uh0gQ7kNvwHtDrU3&_nc_oc=AdoGYylVOeqLPMNYTJJt0unys7RYd7pmt2H5CC-GF_N7wmtWzyfTN_wciKuREW__H7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af569yb16bphnAQ5P5FKR_6d9u8WjQ88rrPmUaqbMbt0GQ&oe=6A01D7C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqqexOiEchAQ7kNvwErwvM2&_nc_oc=AdomIaLNnej-62smQSN5g-dH-1hHMVo17vGb5EKGyo7aZzPjtNxXQZcGJ_89mxQLBNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-uzg4C5MpwIh7UkJliCyPCexr-pNEmjgzKHybifSNOg&oe=6A01F51D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njD3XRjn_HAQ7kNvwGYbGaX&_nc_oc=Adq6B_KhHeV52FUFCAa_PCBkGxfcmpcRdrk7a5HgulLUDcJm3ICScz3twRhTNpn7m_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vy04bMJ956EgCpltjlFC0TW3tQEyc_rt6UkSOZ-juow&oe=6A01E5BF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
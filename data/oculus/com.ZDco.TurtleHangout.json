nt-fra3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxiCap-wK2oQ7kNvwEH-HLT&_nc_oc=AdquBOzovFpdi5tjfvIcA1hzsutgcnudn1Dt9sWWQm95VKKMmv-HhSvxA8HsVknvAMo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h3OQRVNYX2oZRjfp8dnA-kQx473bKpmaWg7wkPDuyQw&oe=6A1B05CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m33lLmjw8dIQ7kNvwGEOMaF&_nc_oc=Ado4WP3N8PJdIgv6LeQ2kkGNK5OK5oVcfjOPTct0UDaPrC5lgHfE5EysWVo7mKsSrAQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-7IfFF_Nk4pYO1exGTjrHZQz5RHGpjS0fsuVfkaFxTw&oe=6A1B05DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGGv5NgORScQ7kNvwGyoYwz&_nc_oc=AdojMSlYatG0_1NfRGGMhVkD3GxFy-n7itk4XQWvpGix5lBTmPYfKmf-n8a_-ciQpB0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZUyK76xxm2ksII5-yYaBZwS9YKPE0MEdV-7-lcIU1sQ&oe=6A1AE443"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4foAxtT8oEQ7kNvwFH-7-T&_nc_oc=AdpcXeOybGIw4CYx09yUP4-mdZOfJGhv8QvwGH1eIe1vCgigtyDkhZcPYyrnGbBNCMw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HHuXKgvlHI3xGDEgrUqo2CLP-Zo5_5EnlWgW3GiVuPg&oe=6A1B019D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAm7PJC0ynEQ7kNvwHxHupJ&_nc_oc=Adpzfu2RcSoldVxN0HT7TM1lfEPuzpJx6HwWDgzv3jRwlkPXsvGYnWjdKOs6UQj_RKY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WLOuAoulaXukEjuHU_i875YCngbL2j-Eyz5X8vO_lCg&oe=6A1AF23F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
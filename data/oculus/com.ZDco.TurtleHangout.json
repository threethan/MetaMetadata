nt-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6iL45gQaFgQ7kNvwH2_MlO&_nc_oc=AdqVxya7H9r4eXQr6ZH28odFnY-m36-uN3tDn1eChCzOHQqfQu132Kl43wX2pHboU38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8cQ-JD07Hv04I4lbQ_L3XYlSUpkglMx8qEAaIFXrbQQ&oe=6A4292CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lN8UfQvrWukQ7kNvwEjad3c&_nc_oc=AdpupZGh3NNrmod_HYTZ4ngZZTLDCP2eD-5TWAjm_VrDSwLdvlgbE-8ueLzZiMC1FeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hhvPjezFROWBgCtP6Di0xWyZ0rbBGdEdqG6sL0t58QA&oe=6A4292DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JXzLtp4STgQ7kNvwF1rOoT&_nc_oc=AdpwVjiEcUwi1WKO_eVhqKi2QNUZ4kN-hYw0w2a5F5C879I9dzu2kW5HUE7QI8H-5Lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N2RsKluqHsQ8DvdGp4zM9pzpkKpx9iq6tA5_o_LKqYg&oe=6A427143"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti_B5a9vEJgQ7kNvwGRACTQ&_nc_oc=Adrm4IRm4yYBVQYxmdkmEabc1L8wECPjUYc1MfVBpGEWw4JQzNzq4lQvEVsgQAkvB-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VighVCqcZ-_uLyLfAy7N59Qx1GPgVbsc3xmgmcwhOdQ&oe=6A428E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPJCyN5EquQQ7kNvwHb_wtk&_nc_oc=AdqPoS076aVVoe3fkcWQk1mF4hWKynOzCC516fM2KgNC4DySgfx5iAiyVShVfpr4yC4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QbbxjblLUo40aNgQwP-V0xe3uB_gT2Voml5qNgCemqA&oe=6A427F3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
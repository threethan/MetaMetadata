nt-qro1-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgpgh7TehukQ7kNvwF8zSYX&_nc_oc=AdoZKdsh99cbLk0yeNWta9Hn6Au7oKlXDz2wiWTJUSaMNg1vS2vJ-88Op9QtVtd7NdU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c5b3kw8GiRfLI1j_MjI29DHLACbHFvk3asYr4oJTN7Q&oe=6A09E24D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_8o56sWrMwQ7kNvwHj_4pV&_nc_oc=AdrPGgYw_4qVBnenzabXlKQgN8B0FIkzEbdP6xLm1tRDfFTuQBtTrzGC80H8MN__FfM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nNarlRgt7ocxYb3eopgLBNA7P2Wb2jSplX3GB9uxQnQ&oe=6A09E25E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keI3LBYMtn8Q7kNvwGfZWXA&_nc_oc=Adrs-595J_eboSmPo1XAQjino0GOT1AZws5vmmxXyW4tpyKTxS6Mn2LpRO0sC420jwg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nQYYCTuI1rrVIjJ5tCh5Cjf64Rl3-UuCVn9OU_xQRWg&oe=6A09C0C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXBzaEhN1mkQ7kNvwESOHP7&_nc_oc=AdoZ_MEl2ywFs8SWFQ73DNDs2ur1J8MHzuEHLnkCd9N3_wsd6vAyqGmGwLeAdD9pMW8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JhprEm3yIVO7HsvLoXv8d7kbROTUE7BSFS6I6GdY4sw&oe=6A09DE1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqLh-UkOYPkQ7kNvwG2pcWC&_nc_oc=AdqCM3fD-s30VKT-TiKvMVLMeXa5HaeNLk80zYBFRq1LbWncnp1BwU80CZ_lAb1PJN4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6umOjHf0atkB6rrYE5LIzgEnbJBwjlPmY_SRmumnkn5A&oe=6A09CEBF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
ntent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gtyjBk7QHnJ3i8FHNrtKLKQYNibQ_nI3u-w1DIFAqgA&oe=69E6118D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaHWwJQ-x7AQ7kNvwHzW7LU&_nc_oc=AdpXUf1tS2A2HV2wqh11zvFnuWIyCAW-cfiUbfrsBagA9c076weAUghIE6x3UafYkWI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0k3VJ6hNwMadd4mO_F0AliEulwTseHMn02SKX1PuZaRw&oe=69E6119E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_8SY-bcFJ8Q7kNvwFh2v1u&_nc_oc=AdoPEXIkQQeX-1F1VxOcHRBKkue5jkeLuRT_dOVfUTzp6-i2ogYxA7NSKkO35pMzfus&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QtIN69nrfyLQ7aDXlzTSvesK3IwEQXSGtqRZAvfglEA&oe=69E62843"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hNYcO5cvaEQ7kNvwHhYVTn&_nc_oc=AdoFjGnV3kHORqImHjwQkRra7gOVeEO6xxVQ7ttW2_sVKNqfdulhe01_er4_yTIy4w4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qrmFceKvhbsExJ0gV3CBgnNgihg15bERg43LiONh5Lg&oe=69E6459D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8C1F99WwH0Q7kNvwFNK9EA&_nc_oc=AdrmEyc7gJJiwjdjR4bmmmH2mlC4scYr6eFLoByA3Rne_SkGCSLLT1RpkBfUZKKAE6o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-pqSm-pC1Bas74oEWRked9QPjaXqiA-ZDU1QsX8h7Zw&oe=69E6363F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_are
nt-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmVrRrjr2IEQ7kNvwFYC9V1&_nc_oc=AdrHEXWixKFvJjszSkLl0-7e_q9UtQPDfuiEzOg2aDgTe21AYzVX9LceoS_2MZrVNh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dk2_zZt6pbgTJSEwtMwECRgQ-82iG0MnZYHehjAXa5g&oe=6A3E9E4D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7oulcASGhgQ7kNvwFaT2yA&_nc_oc=Adq7Zes_f3RBUq9QDzWGHN8-UY6iGmgQb0uoRIUuyaSu8L1SPzJchOfzqffdDmpecCY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SjoQtMGWSth0ETmKnqVS_-zRrIwv9p7wTLA49IpPf4A&oe=6A3E9E5E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax6e8iC7imEQ7kNvwEzYpDJ&_nc_oc=AdptOOeU9u8b5vIWdCJxlMaeaaOdLs3e3_wWkMOK8bM_4ArkTPY4ZwNERJ40w1yaUxU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pjdQ6-k3jPsO5YyCCRSbcDnHst8MNW41lLsh8q2qvRA&oe=6A3E7CC3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ph8DgWxojSsQ7kNvwEzga-R&_nc_oc=AdoznnTcLi9XjHdUlJJR2RR_bXMXWxpzzqDGbEo1JX5Bzy6ZQGYS6e-cK89UVjfwccc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LVmNvVk7aQ1IMDjm1sXo2-63Lqpqplspff15IwmsuVg&oe=6A3E9A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8MRD72KruYQ7kNvwGu1Y10&_nc_oc=AdrGdckfymFJSPykWl6bSGAp_yq3f4mL_bxcwfQFNo4EY_r4PUac2-XpVNLC97YW6cs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aY7v9gRdb2F4ktZo0yFtPwrmusXjF5zFKj_7vkqNVJw&oe=6A3E8ABF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
4_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi8kldLWQHEQ7kNvwFIvlT5&_nc_oc=AdpenpCs6uPqb50RQR3y4bOOZEHFzzWK2-mES5VkaW8QJ4-ltrP_Ykyh9fdAnIYCEFA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp39pfOUW7iGB39_QywMp80vBDIQjtUFNC6rurT9Yp4g&oe=6AF098CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7wWy-384eQQ7kNvwEa5Olg&_nc_oc=Adqn4F8G3Fs-Wp_usbj91yafrVmpnwTR1dZud3tJgEIabEtB19z1sgBPnpvatOJivGk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi7DGOgdshRxomMUk5qFR_oLqidT9qr_RnYgaDB-mQmg&oe=6AF098DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt1lCRzubZAQ7kNvwEYkpIN&_nc_oc=AdpQ7hLAKepibCzlrS9aLvMIbneIs1hUlLNkbwDH5f5o79mxk52i6OMdLua8cQzK9nY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5eiPCQfuNK_SQM2oSZ78Ed-Qys8qBecqezVAoFmQlxg&oe=6AF0AF83"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-kKN4gObQ0Q7kNvwFBsfpF&_nc_oc=AdoRRu7o9j3sahYpDKm6rJfMi1Q3pd5i_A42Ud_xRsIxbdfmJJK2D4vxHhwMiJQVSdk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp2gP3mN1xT0GCtJi124_hhie6uL8TEJJAI666JqUnZA&oe=6AF0949D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3Bftprs_tgQ7kNvwExua83&_nc_oc=AdqOIr7x475Axco_rcZm_bt5Wkyj49RnOf7SSM0RwLVKP8XwDix9PJop_rQLp0_h4EA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJkSAraf0A6ihAFFVB-82pADMYiPOOJrlDrTO1u8gfiA&oe=6AF0853F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "
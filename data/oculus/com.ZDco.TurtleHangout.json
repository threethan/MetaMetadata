nt-atl3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APBB5SRmQwwQ7kNvwGli3l3&_nc_oc=AdpUlFaoDOgYgW_8OEsRtrudha3qI4nohnY8sYLrrOGkPvyd8qC9lRG-fZnG8uAx8Uw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X4tg_jUFwuKqRsucK2eXgX7H1yASpD0afxF1QbPvUdA&oe=6A34124D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhoM_8mu4gQQ7kNvwG-Tc4q&_nc_oc=AdqLvUZSEyjJsKkF1Z1OT4d7Q_EZUGJCzskDQXyhl3FZ7AKLIcdzjMQJrfj6FvlYXUY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p0p4BkP89fC_-tyFZ-_pnRN5D_WKbQY2vg3qQdHX2uw&oe=6A34125E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xXWamYpzO4Q7kNvwH2EZpI&_nc_oc=Adrj5UNhgCBP2qdQ8CAW_RDwxt6RvdGmAHzwmhzji7gMbxPnOcLPmB9S_POqDoSlSMc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d7f3K1RSYab5BhYdNC5Yv_srA48SuDnlhI-nmTF9UIg&oe=6A33F0C3"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2UQxiKtfVHcQ7kNvwFyyVR8&_nc_oc=Adp51wzPvXQobC5MySqOW2cOyTO7aIazUIACzr0MooRXDaluBE5EcqlaH93-HZEkjXQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sadr411qdsdCQkK-f7oh9sXCDdx_DHrAx7hFZEZ3K0A&oe=6A340E1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4gOwM3yB1sQ7kNvwEE7wuV&_nc_oc=AdpcprGCaHMpdWlpUU54wsjmtQUtVGqyXS4hdp8r3MDg7ZYzfO4oMqW7rqn8sHJX9vU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DZJyQeLHWRXIj_yugKMAHogeh6EoiEej0YkoT_aGa3Q&oe=6A33FEBF"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
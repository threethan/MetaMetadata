nt-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxiCap-wK2oQ7kNvwGdxrV7&_nc_oc=Adof1I6YLSyqLoXzmmOEfxMoab28-6s0wJWZx4cB04oiCSYfREmXax-ZcyMxv2oKguM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BsuwpV609OE4lCyBrrxkiLH5SSpNb8KXDyTE1ePRx0Q&oe=6A1DA8CD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m33lLmjw8dIQ7kNvwGm6B2V&_nc_oc=AdpFfxhuCRFre5eJ8CzArUNC3ffUtL0H1IuQOKe-a_Jf6IFq72aVzXg3B9b4RZvNorE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TgdWfgISVDHSM5RX58odDjDIP2gmmUy-7QeHFoXUJ7g&oe=6A1DA8DE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaATWs-v4tMQ7kNvwHACloc&_nc_oc=Adr3yvS8gLICTgpyTsReZv0qAgyd_BKxQm1ixMU2b4DRB1ocJLJBbs-QGipUrdoiKgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VCTZkxGPdcB0ow2Mg2mYT5a0Rf0CEMTKys7hs3v96yw&oe=6A1D8743"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4foAxtT8oEQ7kNvwGtCLG0&_nc_oc=AdpsjHE32gF71VAqKsFjjQ5og0hayo9LiMXzv-nh6f-YkzmgPiJv6fppp0bqdu0ohUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_hfajKsKPxDMpb7ODISJwYqm-id5bhlOEpHR04Ghqtg&oe=6A1DA49D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APpT6VrF538Q7kNvwHjCscX&_nc_oc=AdqLsoaHfjzYBu6epuSFKEz-fTOxXSEcDWWx0jw-y1kOV6z7PLsKIF-S3sT7dzoyFjE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_ne45fx4YvZojcp0gJmMmROtUh-tAWr4Ng67IUbrraA&oe=6A1D953F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
nt-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwTlY1EKFhYQ7kNvwE2CeLD&_nc_oc=Adp9o-Akdp5cnv4dzfCqsCU7wshYQAvnY9PP_7Kn5d6EajXMJQgmdy8uXYKfb3U4wnI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQ27GFXz708Zdp8wo6PfbLD1mU6lcs9fjvkMoawDrXaA&oe=6A5F5B8D"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-R55o1XaHBgQ7kNvwE3OjNQ&_nc_oc=Adot9L2WHnvh8G7ZdbFeG1y9TCI-EF9IadUwKk4xvjGuTJOMqCMEWufTvBkuH10xCXY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4az-yURp6QADi4spJbk3JY86PsKintf2LB7fO8tnCSg&oe=6A5F5B9E"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rie1LZ_9YYAQ7kNvwGbgziy&_nc_oc=Adqc1R7jZPq6DejHDGUkJoxzrYTo_raBpSlAd51yz-BGRzefgRsqfOZ1ZEJpCZ9O2bA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0Gnoc-2w9OjlTT5yysI7RzfDxPqVPny8qSYyvirFMYw&oe=6A5F7243"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihC2b09lTGIQ7kNvwF2Nwt6&_nc_oc=AdoZaluPk4caBRjj-Sv0MSRVZCdqhSHLzNn7dhoQceJOFZ6FN25MK9k5MVEO4imLjxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9fLpZhSmcr8iNvQ7TMM-Hg7R4s_ure6YGTV08rPcsIA&oe=6A5F575D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3VPGTFtQkMQ7kNvwFW19FL&_nc_oc=AdqPSO3Fv1l5Olh3OiC8ap50ngBHxxNM_4OE8ksa3fKJVkdPBxWzbGkBpY4VmgldTi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN-KPUGkNNxMGE4kMQLmwewZCHqdLXHoVh0wsVru2Zwg&oe=6A5F803F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
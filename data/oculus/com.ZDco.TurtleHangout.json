nt-atl3-2.oculuscdn.com/v/t64.5771-25/491823837_972464862120934_6225518283936290909_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCMGC73bZEgQ7kNvwEdCR6W&_nc_oc=Ado63x3CtYlLb4VVesf-BSlFDl5ISBg44BbvYZoEXYQIKQhx5XAMT3pLVPx7WJgI798&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fNKcZPvPWafKBIT8OqnjHPFNvfG8XaG01JhDxjXM9ug&oe=6A301DCD"}, {"file_name": "Screenshot2.png", "id": "1570211954201298", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819854_1570211957534631_8743531108655673553_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzjXpMrlYCAQ7kNvwFW5-wY&_nc_oc=Ado1W-RUAEcPmAhi3sdAyuk_w4BoeaZJ_QxIZslajOy4-N1E4Pu3maBKrw7mUqPJttM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BkD4AecWDHdHt7iwlGlfcg2vCoKTBJl8L1ZlRSeZcZg&oe=6A301DDE"}, {"file_name": "Screenshot3.png", "id": "1610420210088658", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824665_1610420213421991_5846921766679393543_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQxUc6NytZ0Q7kNvwFjd7EM&_nc_oc=Adqub6SmhLK6am9Vy7u9M3b3tn7rJlxOr4yE8mxx1yirrrgZTczfM_V3y2nyTiBLmhA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tm2IjZc0iPo0eloqnRR8wUF7f19MQduvon43e2-FD7A&oe=6A2FFC43"}, {"file_name": "Screenshot1.png", "id": "1901861587363380", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820855_1901861590696713_5393842308189105311_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnUJLfI-JsUQ7kNvwFe-_P4&_nc_oc=AdqdVswlO2BnV6pAfHkZNEZfEecphR4-u7XkYJ1IONQ_puc0DcNz9XkFmbkJ-SNy8wM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kVWD8853wOE_vkFEVtRo4kpQ0eG0NBCoNHyCukhxl2g&oe=6A30199D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "26152865464341146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822327_26152865484341144_6575097675277809962_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcGu2FSxSdcQ7kNvwGvSzpG&_nc_oc=Adqu86pADRGLhsTzbUxDXBcb_b1SO6OyFLZe8fFVD9dOuSG3TeA5LtMFKWAw_bxMEcI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93yd9KAYfaAkKaGY9KBoK75SQj5P_gtcUxkO0dcOlmdg&oe=6A300A3F"}, "display_name": "Turtle Hangout", "keywords": ["Turtles", "TurtleHangout", "Hangout", "chill", "fun"], "long_description": "Turtle Hangout is a relaxed multiplayer VR experience built around exploration, movement, and social interaction.\n\nStep into a large open environment featuring rolling hills, climbable terrain, stylized trees, and a cozy treehouse spawn. Wander through the map, discover different areas like the small ground pool, and enjoy the freedom to move, jump, and climb in a simple, open space designed for hanging out.\n\nPlay as a custom plush-inspired turtle character with a clean, colorful design that fits the game\u2019s lighthearted atmosphere. Turtle Hangout focuses on comfort, readability, and classic VR fangame energy \u2014 prioritizing fun and player interaction over complex mechanics.\n\nWhether you're exploring the landscape, meeting friends, or just relaxing in the treehouse, Turtle Hangout offers a social VR space designed to feel open, approachable, and easy to jump into.\n\nThe project continues to grow with future updates, improvements, and additional content planned as development progresses.", "short_description": "Turtle Hangout is a social VR experience where you play as a stylized turtle and explore an open world built for climbing and hanging out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1W5QKB1F8jUrosQhdqLuzaxCJ-RN3Wz4mP8s9roLNTzI/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Zgmonk", "support_website_url": null, "website_url": "https://docs.google.com/document/d/19zeB3g1FGlE3z6a8bOmSquXe_xrOo2dVeKG6klD-TK0/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "G
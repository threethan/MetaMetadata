ri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825503_1411361007681347_8267194762645084683_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUNSr9plPpwQ7kNvwEKuLnO&_nc_oc=AdpW8vwbnaPLpcrfCr3jQk990i0V39kauxJT_IBaIemJUTxMb3kip0kwzTWYf3KyO-4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTclBpknRjWMa7C1rHLbsWC62OneuekAAvTH1KwhjGv5w&oe=6B0B2EEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Landscape.png", "id": "1940076817397101", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823259_1940076820730434_4057811962674097196_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgbC5uOaoxsQ7kNvwFFoUOj&_nc_oc=AdpLjFwWRx1sNlY3RTBvTUr2dsBm5nME97pL-uSzkwSap-HPAXnmJ5vHjRpxXEvXESU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqUZarHZnqy7Od1qtr5a5Nf1dEnfqHz1AjODnGDp9w5A&oe=6B0B3A93"}, "display_name": "FSV App", "keywords": [], "long_description": "An application for: \n- Enhancing situational awareness\n- Tactical planning\n- Personnel training\n- UGV / UAV control.\n\nFSV App:\n- Utilizes 3D models generated on the FSV Platform.\n- Enables precise shooting range calculations, UAV flight path calculations, fire card development, and strategic assessments.\n- Helps identify blind spots, determine optimal target points, assess high-risk routes, and plan the safest evacuation paths. \n- Integrates with ATAK for real-time object tracking.", "short_description": "An immersive simulation and mission-planning tool that leverages 3D data for tactical analysis, mission simulation, route planning, and UGV/UAV navigation in contested environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fsv.global/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FarsightVision", "support_website_url": null, "website_url": "https://fsv.global/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_
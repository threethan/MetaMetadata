=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwFIaxVwJ0hgH_tQLDtg0kGxWgZjMFeED7fZIdebbryA&oe=6AC91753"}, "display_name": "FSV App", "keywords": [], "long_description": "An application for: \n- Enhancing situational awareness\n- Tactical planning\n- Personnel training\n- UGV / UAV control.\n\nFSV App:\n- Utilizes 3D models generated on the FSV Platform.\n- Enables precise shooting range calculations, UAV flight path calculations, fire card development, and strategic assessments.\n- Helps identify blind spots, determine optimal target points, assess high-risk routes, and plan the safest evacuation paths. \n- Integrates with ATAK for real-time object tracking.", "short_description": "An immersive simulation and mission-planning tool that leverages 3D data for tactical analysis, mission simulation, route planning, and UGV/UAV navigation in contested environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fsv.global/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FarsightVision", "support_website_url": null, "website_url": "https://fsv.global/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "uk"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1289350200923180"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1663500251413856"}]}, "baseline_offer": {"id": "1663500251413856"}, "is_approved": true,
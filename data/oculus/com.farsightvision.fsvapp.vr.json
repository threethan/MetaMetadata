ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825503_1411361007681347_8267194762645084683_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Meh5yOe2eTQQ7kNvwGWzcaK&_nc_oc=AdqDJd5gEw8vIj6LzwjY3g22ZctwqK_UtG5clv4PJnSJxAVuIQimfAkz1PJk_H5IQuI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwQ7HWUX4IECqglbY1nbhCaJHvsYm0Qx0mS3sE_ruSfg&oe=6B01BC2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image Landscape.png", "id": "1940076817397101", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823259_1940076820730434_4057811962674097196_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTdg8wovRigQ7kNvwEPxhiZ&_nc_oc=AdoEyw6Es3Jc7fC8wulFRXns35OqT9dnLOQ20k11tzv5a5rDdfjDs7OL2dBf9Jqzmbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUZtiZlYlN3RZj6gxPNsZC3Lrwv1eBd4SnSjK6tZJ84w&oe=6B01C7D3"}, "display_name": "FSV App", "keywords": [], "long_description": "An application for: \n- Enhancing situational awareness\n- Tactical planning\n- Personnel training\n- UGV / UAV control.\n\nFSV App:\n- Utilizes 3D models generated on the FSV Platform.\n- Enables precise shooting range calculations, UAV flight path calculations, fire card development, and strategic assessments.\n- Helps identify blind spots, determine optimal target points, assess high-risk routes, and plan the safest evacuation paths. \n- Integrates with ATAK for real-time object tracking.", "short_description": "An immersive simulation and mission-planning tool that leverages 3D data for tactical analysis, mission simulation, route planning, and UGV/UAV navigation in contested environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fsv.global/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FarsightVision", "support_website_url": null, "website_url": "https://fsv.global/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_
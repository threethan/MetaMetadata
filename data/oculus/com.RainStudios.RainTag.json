vwH3HocG&_nc_oc=Adr_OnLWPbJq2HNU70Nr1phjc8ypHBg4FA4P8OxdCZ_1rfAUIJag2O2VG77CqCpfevE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3LWOewQVyM7VuW8w-bo50tVFyHwx7zGTYIJ-IX3wsqxg&oe=69F0C13D"}, {"file_name": "gorillalife5_resized.png", "id": "1844608756106596", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392298_1844608759439929_9127043574356507450_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRyBvof3WFwQ7kNvwGBaWUo&_nc_oc=AdrBm5GxvBiAkHEJxzdYnc5ycfT9gcPHibvff463Pmk9h7YAz6Dzp73HBTnMcdqzq5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af14ydvevKkPw4tc2rFB5Vl2oxwoEQP3caa04R5QSRA5SA&oe=69F0B9E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rain Tag", "keywords": [], "long_description": "Welcome to Rain Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Rain Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SU-8iyMvMFF0HKOFN7kJNvZaIW2zgx2vvTYTm7JXK78/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Rai
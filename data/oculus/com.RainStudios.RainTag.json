aOtEwvaaOGPROWhzs2bQWN6-13paJjw&oe=6A5B6DA1"}, {"file_name": "gorillalife4_resized.png", "id": "1253332916207723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391961_1253332919541056_4387431475164570818_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4btWCB4ziA0Q7kNvwFPctFl&_nc_oc=AdqiTDL9zzsQ0p9XPTyz_L9c6L1Snja6Z7XqgsEm2VtKTKYkBmwQFhTo00U7ug15M7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmd9e2Y3wUXvfXjYA-CZD5M9d-2VwmPDXllzw4xhn2hw&oe=6A5B8ABD"}, {"file_name": "gorillalife5_resized.png", "id": "1844608756106596", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392298_1844608759439929_9127043574356507450_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5lnknIWQRcQ7kNvwHdYN4m&_nc_oc=AdpXDoorHLLTnSBfYaIGwh3Wv5kkZtjXDAXGuHBhWgr9PKa3sKscDOaQBAghJTOU8oA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQTU6oP8H1EZUHkmasBmzhSxAc-k1ZiGkW8sON0Le_6A&oe=6A5B8367"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rain Tag", "keywords": [], "long_description": "Welcome to Rain Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Rain Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an exper
vwFxig7Q&_nc_oc=Adnsc0B1HxYOSlcAA-WV3GdKbghbuyWE0TpJx__2JOs-yMb-YwV5DMpzbk-7d8dGE2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuPrt_lWFvjU2XsMCKpnJwjWdbAA_-M9duyGxfFQsPtBQ&oe=69A6ED3D"}, {"file_name": "gorillalife5_resized.png", "id": "1844608756106596", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392298_1844608759439929_9127043574356507450_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeSeIctNIb4Q7kNvwGDRKAB&_nc_oc=AdkFfzozBr7tw_vtyRO_3vSm5rPqE0RRQV_TVaMegl16Enwe0bQztla9ubwG-8KiUY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsqaHw1Ib9SBHzJtXK6L8A2BKadePmbpSXGHez23h95ww&oe=69A6E5E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rain Tag", "keywords": [], "long_description": "Welcome to Rain Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement.", "short_description": "Welcome to Rain Tag! We're delighted to have you embrace this unique, heart-pounding game where tranquility meets action, and your hands become your only mode of movement. Forget traditional locomotion\u2014utilizing the Gorilla Movement System, you'll glide, climb, and race through serene landscapes with the grace and agility of a tag master. Whether you're chasing or finding inner peace, this is an experience like no other, combining mindful tag gameplay with an immersive style of movement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SU-8iyMvMFF0HKOFN7kJNvZaIW2zgx2vvTYTm7JXK78/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Rai
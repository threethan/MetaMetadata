, "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312380_1488705936651906_4761129156600459408_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b5S5NWP9O0Q7kNvwEUgqe5&_nc_oc=AdpMwIGCnkMYMbCPRVoCmscAaBSe_6KxdUybmx_9aK2RZDpwSahL6_hs4c9UoXPiHRI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSva0-yWyRN01WaJAA_80_LshBR-AvTDxTGbHZQmdHQqw&oe=6B0DC327"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BattleBrain", "keywords": ["memory", "brain", "matching", "puzzle", "concentration"], "long_description": "Extremely fun and terrifically addictive with unlimited hours of game play. Improve memory and concentration while having fun!\n\nBATTLEBRAIN is the perfect game to help improve brain power and learning ability. With bright and fun graphics, enjoy Single Player and Battle the Brain game modes.\n\nSimply match the cards, earning extra bonus points for each match you get in a row. Unlock bonus features for more fun!\n\nFeatures:\n* Completely random shuffles, never play the same game twice\n* Play single player mode with saved high scoring\n* Play against the Brain in BRAIN BATTLE mode\n* Just pick up and play with clear on-screen instructions\n* High quality music and sound effects put you into the game\n* Improves memory and concentration while entertaining at the same time\n* Unlock-able bonus themes", "short_description": "Extremely fun and terrifically addictive with unlimited hours of game play. Improve memory and concentration while having fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dvidearts.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "DVide Arts Incorporated", "support_website_url": null, "website_url": "https://www.dvidearts.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id
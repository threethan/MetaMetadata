1.oculuscdn.com/v/t64.5771-25/38982481_904125164111361_5505838504028165185_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8LkVE5cx5wQ7kNvwEXhmBn&_nc_oc=AdpvXENQWgllXrsfI_zoSHaqs_NAtgW_NvME_5hVdrs6PGRixpGYXj8-E2P_Es52oL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyxky-olGIUKFHj83qGLft6A9089XOnWh0o2XMw2uGFg&oe=6ACCF46F"}, {"file_name": "\u76ae\u5212\u8247.png", "id": "890575738726846", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75485573_890575742060179_668355258342867649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuLd94opG3QQ7kNvwEdjQK-&_nc_oc=AdovaQbif7H3wXkmWwTvYkg7qSrRb8qJRyz3N1z4e_KinEzNWFiIjqKkTjAqus4TZWA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKIJEpxaoA31iYQUC-_MoQQ4kxa0bv6h8QO_UuFLDUZQ&oe=6ACD10C9"}, {"file_name": "\u5c0f\u9ec4\u9e2d\u53f0\u7403.png", "id": "1405805216903127", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75307248_1405805220236460_2593520130587912023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IJKDey6QOwQ7kNvwElo9h9&_nc_oc=AdqjBGDJ_Df5BLgPpdw_JY0NrXrv6sZPmKiQGA6Luh_-09sftc67KoGJJQoQVP4BWi8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtXQZFkjhX1Wg2OW-rprptNwIz43kCSfq0IcLktdhB3Q&oe=6ACD0E0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "508887348111425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572932_508887351444758_9123281015761121496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJ2casItkGIQ7kNvwFobkox&_nc_oc=Adqjw5nMFbgd0FLYesIIRriVUCZ6lLAvGzSKLkOUxFOpTRJn_DD0UgbzNix813K9fjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnKaUXIkrovt7tU_vA3M7LWojUkEHHjPBX7lJ4LpKP-Q&oe=6ACD013F"}, "display_name": "Pressure Washer", "keywords": [], "long_description": "Pressure Washer is a VR cleaning simulation game. If you facing any stress, anxiety, tension, and worried, why not try it out? You just need to grab your pressure washer and get on with it. Your goal is very straightforward, wash out all the dirty little things from the surface.\n\nThe modes you will love\uff1a\n\u00b7 Career: As a professional cleaner, the city needs your help to maintain cleanliness and tidiness. Level up your tools through the reward from each stage and be the savior of the city. \n\u00b7 Free play: Relax, unwind, and chill. Use different nozzles to spread your creativity on the surface and cleanse your mind, find your inner peace, and balance them.\nFeatures:\n\u00b7 Fifteen different places to clean up\n\u00b7 Three types of tools to get the job done.\n\u00b7 Chill and Relaxation\n\nEnjoy the game and wash all the stress away!!!\n\nFeel free to join our official discord for more news: https://discord.gg/sYGjd4zxQs ", "short_description": "A mental cleanse game with a high-pressure washer!!"}]}, "developer_name": "Fountain Game Studio", "developer_privacy_policy_url": "http://meetingres.meta.fangte.com/wash.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "808792983939705"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221326_3047320412241411_5100727770682450145_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_
1.oculuscdn.com/v/t64.5771-25/38982481_904125164111361_5505838504028165185_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtTBqmVeTYQQ7kNvwEAFPmb&_nc_oc=AdoU6QXZiESjDVWTsNdNfdvnJ5ig_a1f_KxHOpSU12pF58FH6zGLN3hTnkG3M-Vc6vg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaWbFPhvWGJABI4vYelOHx8N99AkInkQ6bo-ZNezShRQ&oe=6A8AD12F"}, {"file_name": "\u76ae\u5212\u8247.png", "id": "890575738726846", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75485573_890575742060179_668355258342867649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8Co8cIXbMAQ7kNvwHY3fOy&_nc_oc=AdobNySNiQ9Gn9IAAhuxZPskY_SDhL1Yw_ruXkJcakeKGiblAZbmxFLjQR4BZydhKAc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLr2dt4LBkWXwFipgzobQaf3ntVpX65PFhiW-Wi84vfA&oe=6A8AED89"}, {"file_name": "\u5c0f\u9ec4\u9e2d\u53f0\u7403.png", "id": "1405805216903127", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75307248_1405805220236460_2593520130587912023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0nbp9BLzicQ7kNvwGoN7a_&_nc_oc=AdohJGz6FdX5lHLs6tbQAlak4Xqnjp9t0-QU-kg9WxXWFUnAvWDMVXlWOehtEKBgqLY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQfm--wT9Ye2VdynDDrMmAuOvW6CCjGAhmJ6SkYnlckQ&oe=6A8AEACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "508887348111425", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572932_508887351444758_9123281015761121496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPRMofd6g-kQ7kNvwH0UqcV&_nc_oc=AdpGvRZFcWISBzKCmCZvkuRFNsfki24R0GgIdFSw3HKAqxq4ZexUzq0a6vyHjme267U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpJ-1eZZ2JxT7LWoDlPwWC1qFOe3kglsPtMmiM07uZaw&oe=6A8ADDFF"}, "display_name": "Pressure Washer", "keywords": [], "long_description": "Pressure Washer is a VR cleaning simulation game. If you facing any stress, anxiety, tension, and worried, why not try it out? You just need to grab your pressure washer and get on with it. Your goal is very straightforward, wash out all the dirty little things from the surface.\n\nThe modes you will love\uff1a\n\u00b7 Career: As a professional cleaner, the city needs your help to maintain cleanliness and tidiness. Level up your tools through the reward from each stage and be the savior of the city. \n\u00b7 Free play: Relax, unwind, and chill. Use different nozzles to spread your creativity on the surface and cleanse your mind, find your inner peace, and balance them.\nFeatures:\n\u00b7 Fifteen different places to clean up\n\u00b7 Three types of tools to get the job done.\n\u00b7 Chill and Relaxation\n\nEnjoy the game and wash all the stress away!!!\n\nFeel free to join our official discord for more news: https://discord.gg/sYGjd4zxQs ", "short_description": "A mental cleanse game with a high-pressure washer!!"}]}, "developer_name": "Fountain Game Studio", "developer_privacy_policy_url": "http://meetingres.meta.fangte.com/wash.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "808792983939705"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221326_3047320412241411_5100727770682450145_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_
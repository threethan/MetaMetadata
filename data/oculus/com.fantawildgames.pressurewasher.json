1.oculuscdn.com/v/t64.5771-25/38982481_904125164111361_5505838504028165185_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9wyLuFmCycQ7kNvwGjeje_&_nc_oc=AdoyvCraWhEDetFiOso0oci2FThorYzKe9-AG1RM15NItCqUsAFbqTIksBMeawSldA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p2xotCbbAeZzfbzBmkoNNyoZIQAOdirxav56j82DJVA&oe=6A297A6F"}, {"file_name": "\u76ae\u5212\u8247.png", "id": "890575738726846", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75485573_890575742060179_668355258342867649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qi2W6eqlggcQ7kNvwEmxMRI&_nc_oc=Adpde-htCag-H53DAX9iWWpiZuhfGJr2RIvN_prXlzMm6u-y7UIhUaamJy5vq2-wT2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rpWcqqxM7LI9w64BpDrEVceCaBJNc5aRR_S6Jo8qnsQ&oe=6A295E89"}, {"file_name": "\u5c0f\u9ec4\u9e2d\u53f0\u7403.png", "id": "1405805216903127", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307248_1405805220236460_2593520130587912023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OhGAflG_zgQ7kNvwFyg8ss&_nc_oc=AdqORJlYnkJJL0S_Dr3aIi9nZJo6rYthEq4kmrZ_PGU0pfr0L0NxXkjgeyn6NN5EsmU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CZCqLAJynJgW1OyjzOKle6TcGZb3yZgq8mvY4GSvS-g&oe=6A295BCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "508887348111425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572932_508887351444758_9123281015761121496_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGoCj9vZBvAQ7kNvwGaz9tI&_nc_oc=AdozXxAP8oSRZDIf98hvo9lIYtXabqyoLDjWlf8IyBSaajfeH95LjPWZi3sUocoW5DQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g5Bu4Lbp2rYJ6JHJb7hsP-H3Pj6LP-CugQ9GWCR9CfQ&oe=6A29873F"}, "display_name": "Pressure Washer", "keywords": [], "long_description": "Pressure Washer is a VR cleaning simulation game. If you facing any stress, anxiety, tension, and worried, why not try it out? You just need to grab your pressure washer and get on with it. Your goal is very straightforward, wash out all the dirty little things from the surface.\n\nThe modes you will love\uff1a\n\u00b7 Career: As a professional cleaner, the city needs your help to maintain cleanliness and tidiness. Level up your tools through the reward from each stage and be the savior of the city. \n\u00b7 Free play: Relax, unwind, and chill. Use different nozzles to spread your creativity on the surface and cleanse your mind, find your inner peace, and balance them.\nFeatures:\n\u00b7 Fifteen different places to clean up\n\u00b7 Three types of tools to get the job done.\n\u00b7 Chill and Relaxation\n\nEnjoy the game and wash all the stress away!!!\n\nFeel free to join our official discord for more news: https://discord.gg/sYGjd4zxQs ", "short_description": "A mental cleanse game with a high-pressure washer!!"}]}, "developer_name": "Fountain Game Studio", "developer_privacy_policy_url": "http://meetingres.meta.fangte.com/wash.html", "developer_terms_of_service_url": null, "publisher_name": "Fountain Game Studio", "support_website_url": null, "website_url": "https://www.fountainmeta.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "808792983939705"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221326_3047320412241411_5100727770682450145_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_
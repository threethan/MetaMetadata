your phone or computer and enter the code the headset shows.\n\nYou need an IDColab account. Create one for free at idcolab.com.", "short_description": "Walk through your design projects at true scale with your whole team. IDColab on Quest opens the same projects, files, 3D models, panoramas and drawings as idcolab.com and the IDColab mobile app, with comments, pins and decisions that stay in sync everywhere. Sign in with a code from your phone or computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.idcolab.com/PrivacyPolicy", "developer_terms_of_service_url": "https://www.idcolab.com/TermsofService", "publisher_name": "Idcolab INC", "support_website_url": "https://www.idcolab.com/contactUs", "website_url": "https://www.idcolab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1500222656505455"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771240_1131473033131970_6103526810061791455_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTFGMXNNb04Q7kNvwGdwV9V&_nc_oc=Adp6t88IIE29Hy9pDtZ4TSqBck7NJ-v1R88w4YdVKMZVp_DEIaRCXLKFbwiTpNwCrBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV1BvqUfgEQMzijbUKGILT0EL99YzBCpwkrxj3w9P-01A&oe=6B0F1026"}, "is_conce
": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982674_2020875045014219_3662929134451352019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3Dbhn6NsTwQ7kNvwFteVQi&_nc_oc=AdmIxNZPBbIGajW5epWBR1Xi8AVS8HB-ZjQaLSV_l2dftWVzq_fSAz9RKZHM-DygZMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuuT4vKnFgrLY76OHPLLnAKfrh9QY5KFPA2mnvXauG9Xg&oe=69A9881A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px.png", "id": "1309931813357430", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982550_1309931816690763_3845961028061352401_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icKC-nG4XG0Q7kNvwHUKJKi&_nc_oc=AdkIafSHtTiHJJLS07JgdxH7R8rte5Fdcr6LZu21wv6ZHFvBTckIKYO6PDTrZ8PwjXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv6AtS5EReXcfCk-khIWfJIEh6amz_a82jw9hAHHSZfAw&oe=69A981B1"}, "display_name": "XR Head Tracker Pro", "keywords": [], "long_description": "XR Head Tracker Pro is a professional research tool developed at the Vodafone Chair for Mobile Communications Systems at TU Dresden. This Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information while allowing users to maintain awareness of their physical surroundings through the Quest's Passthrough technology. The application stores motion data as a CSV file directly on the device, providing researchers and developers with easy access to movement analysis while maintaining visual context of the real-world environment\n\nKey Features:\nReal-time head tracking \nPassthrough visualization \nCSV data export\nVoice Annotation\n\nFor technical support or inquiries:\nmohammad.elahi@mailbox.tu-dresden.de\n\n{447729548432244}", "short_description": "XR Head Tracker Pro is an Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information and stores it as a CSV file directly on the device, providing researchers and developers with easy access to motion data for analysis or further processing.\n\nKey Features: Real-time head tracking, Passthrough visualization, CSV data export, Voice Annotation"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1m-4DhHA3xvvWmQ0gni4HSpaIoda-Cw-tQoir53pcf5M/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1NubrLolVBsrrnbVxEFhJ1ILVDG76sjac3I6y4Va51Wo/edit?usp=sharing", "publisher_name": "Mohammad Elahi", "support_website_url": null, "website_url": "https://github.com/Mohammad-Elahi", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28239480385639051"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2561611460842853"}, {"status": "PUBLISHED", "id": "1737873633529122"}, {"status": "PUBLISHED", "id": "1331322255179655"}, {"status": "PUBLISHED", "id": "1102177677955983"}, {"status": "PUBLISHED", "id": "737175489147965"}, {"status": "PUBLISHED", "id": "915396363279105"}]}, "baseline_offer": {"id": "737175489147965"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755194760, "status": "PUBLISHED",
=7f20f&oh=00_AQL8vGocA1x8vpCeqGyjITL7-9grXVlsXa4RqYuQtEavQQ&oe=6ABA6235"}, {"file_name": "3.png", "id": "2020875041680886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982674_2020875045014219_3662929134451352019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IULnSMvt7DUQ7kNvwHMTezm&_nc_oc=AdqKnEnkWPHNQ_xcMZl-JORYGm0Vx16HSVSbv8reaiyKJ4Id7tBTP2QHSsflcr8xhzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ683TjHpcrSmKEC9hBQvmt8Oy4chnaNUHc2MFSvOVsNg&oe=6ABA6E9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px.png", "id": "1309931813357430", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982550_1309931816690763_3845961028061352401_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjAnoEzK_kYQ7kNvwE8ePNa&_nc_oc=AdrYnIs-zurbPulRF8kD4lFQBVlFt8f1-4LoVpWn7qFQ69KAlKMACL0UCUQiRGF_aRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5Nnjk0b7pzJ1cP6hUSRTerLI1S0ki9Yi75IR1LtHi-A&oe=6ABA6831"}, "display_name": "XR Head Tracker Pro", "keywords": [], "long_description": "XR Head Tracker Pro is a professional research tool developed at the Vodafone Chair for Mobile Communications Systems at TU Dresden. This Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information while allowing users to maintain awareness of their physical surroundings through the Quest's Passthrough technology. The application stores motion data as a CSV file directly on the device, providing researchers and developers with easy access to movement analysis while maintaining visual context of the real-world environment\n\nKey Features:\nReal-time head tracking \nPassthrough visualization \nCSV data export\nVoice Annotation\n\nFor technical support or inquiries:\nmohammad.elahi@mailbox.tu-dresden.de\n\n{447729548432244}", "short_description": "XR Head Tracker P
ile_name": "4.png", "id": "523787710458705", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982562_523787713792038_6207345297599817982_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUDR2Dfww6kQ7kNvwGa7FHO&_nc_oc=AdrQ2Enva5akiptW1iYrypUyvt6xuXeQQnvN5eeCCpyOzUpvBBAfnQxo65XWNPviFhs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHTOIsyRDYm2IvaxLMVp25ueWuJ4dTVNwkK2Pacy2jSA&oe=6B031009"}, {"file_name": "2.png", "id": "1204802417861656", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240109_1204802421194989_6097745051168194742_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_p9EmCBuiQQ7kNvwGL6EpX&_nc_oc=AdrS_aBfV-k5M7eSRWzPCrcYgMyw8369tR6YSH1X9bbzsLu9kAMRODtWwvWbvT39mzE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR14AjbzVLWKwfLfcYuWQkmWHGhe9wr4GADcqMShW7XOw&oe=6B031CF5"}, {"file_name": "3.png", "id": "2020875041680886", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982674_2020875045014219_3662929134451352019_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIRo4PpP_jgQ7kNvwE8tNzE&_nc_oc=AdrCcHBfxvfI1O7Ik3onauJZag39tyP4weXKhAKd42By4Thm31hUxndRuvf6KSAvDmU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRvAFYBK6MctGQIMoy_3nbhHyuaDjMkrAJFi-UEOfEUQ&oe=6B03295A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px.png", "id": "1309931813357430", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982550_1309931816690763_3845961028061352401_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0IXmYUBMG8Q7kNvwH1rQDa&_nc_oc=AdotGsWW7y4K24vyNPRa9-_4DvWaH7zPVELG_BE9s89vskVR7ct_DPdKBgiTW-QKmnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYgnYLVGbYjM0vKVySRF9K9XHN3O0su48J6FSymXJ5-Q&oe=6B0322F1"}, "display_name": "XR Head Tracker Pro", "keywords": [], "long_description": "XR Head Tracker Pro is a professional research tool developed at the Vodafone Chair for Mobile Communications Systems at TU Dresden. This Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information while allowing users to maintain awareness of their physical surroundings through the Quest's Passthrough technology. The application stores motion data as a CSV file directly on the device, providing researchers and developers with easy access to movement analysis while maintaining visual context of the real-world environment\n\nKey Features:\nReal-time head tracking \nPassthrough visualization \nCSV data export\nVoice Annotation\n\nFor technical support or inquiries:\nmohammad.elahi@mailbox.tu-dresden.de\n\n{447729548432244}", "short_description": "XR Head Tracker Pro is an Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information and stores it as a CSV file directly on the device, providing researchers and developers with easy access to motion data for analysis or further processing.\n\nKey Features: Real-time head tracking, Passthrough visualization, CSV data export, Voice Annotation"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1m-4DhHA3xvvWmQ0gni4HSpaIoda-Cw-tQoir53pcf5M/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1NubrLolVBsrrnbVxEFhJ1ILVDG76sjac3I6y4Va51Wo/edit?usp=sharing", "publisher_name": "Mohammad Elahi", "support_website_url": null, "website_url": "https://github.com/Mohammad-Elahi", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "10635849107
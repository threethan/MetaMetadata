s=7f20f&oh=00_Af7DBOgyzePJtRSvqncvK4nsNtBIyqug1fD5xH9RfsVN6A&oe=6A144535"}, {"file_name": "3.png", "id": "2020875041680886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982674_2020875045014219_3662929134451352019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEsvCubEFMYQ7kNvwFF5PuF&_nc_oc=AdpSuoo2iQh2uMlt7ZOedzcrq5MJh4tPWb16T_IGn7H7uB_J60fl3L1ebF3iEea8buY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sk4nl-8mYqNE94Im2_NYZ-X6ZZwrJu0SOvJewqurYBA&oe=6A14519A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px.png", "id": "1309931813357430", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982550_1309931816690763_3845961028061352401_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kho7Y1f-awQ7kNvwEAegwb&_nc_oc=Adph_L3sJfxq6CCFQCWv4hwITIkzJkRl3OzzPP88uUUhHh6GHfCytUEjvuDHbmZtaQg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y6EQOAw-Mjb6taCUwpXHQknrvxSPkjO-M55cKefVPbg&oe=6A144B31"}, "display_name": "XR Head Tracker Pro", "keywords": [], "long_description": "XR Head Tracker Pro is a professional research tool developed by Mohammad Elahi at the Vodafone Chair for Mobile Communications Systems at TU Dresden. This Android NDK C++ application leverages the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information while allowing users to maintain awareness of their physical surroundings through the Quest's Passthrough technology. The application stores motion data as a CSV file directly on the device, providing researchers and developers with easy access to movement analysis while maintaining visual context of the real-world environment.\n\nKey Features:\nReal-time head tracking,\nPassthrough visualization, \nCSV data export\n\nFor technical support or inquiries:\nmohammad.elahi@mailbox.tu-dresden.de\n\nNote: After exiting the app, you must restart the headset. Once restarted, you can find the CSV file in the Download folder.\n\n{447729548432244}", "short_description": "XR Head Tracker Pro is an Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information and stores it as a CSV file directly on the device, providing researchers and developers with easy access to motion data for analysis or further processing.\n\nKey Features: Real-time head tracking, Passthrough visualization, CSV data export"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1m-4DhHA3xvvWmQ0gni4HSpaIoda-Cw-tQoir53pcf5M/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1NubrLolVBsrrnbVxEFhJ1ILVDG76sjac3I6y4Va51Wo/edit?usp=sharing", "publisher_name": "Mohammad Elahi", "support_website_url": null, "website_url": "http://www.linkedin.com/in/elahi7", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31797237939863260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031487_3579525382338582_3328064419469625156_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAuD-4B0wEAQ7kNvwE4
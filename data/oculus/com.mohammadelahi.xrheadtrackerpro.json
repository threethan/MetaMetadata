=7f20f&oh=00_AQAeHBulUhMtNofO_U_ngDOZfXRnzzZ8dS4-qbr88HCNPg&oe=6A5CC7B5"}, {"file_name": "3.png", "id": "2020875041680886", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_2020875045014219_3662929134451352019_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8J56SeseP80Q7kNvwHbWsD1&_nc_oc=Adry7nUub3cUjMxUouG5FTkKsYlb-cxzQNRx9xgU4pPZ1vLsMdJkBq_g5t8h6ahGHuk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMUk9ZGHT3_p0QHF8wngOMq557oukU395tbVL0k8qKhw&oe=6A5CD41A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px.png", "id": "1309931813357430", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982550_1309931816690763_3845961028061352401_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCrxaVtHotMQ7kNvwFmxWC9&_nc_oc=Adqjm3m7Z4n40SzvxjUEPuNhVtrkfZiQu_HYxsu1Evte8atzrMu12EIFkhl4JXjfyns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuQT5na6eM0SpFdLL_lcFR_iWlNV6guI05W7efMHxb7w&oe=6A5CCDB1"}, "display_name": "XR Head Tracker Pro", "keywords": [], "long_description": "XR Head Tracker Pro is a professional research tool developed at the Vodafone Chair for Mobile Communications Systems at TU Dresden. This Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information while allowing users to maintain awareness of their physical surroundings through the Quest's Passthrough technology. The application stores motion data as a CSV file directly on the device, providing researchers and developers with easy access to movement analysis while maintaining visual context of the real-world environment\n\nKey Features:\nReal-time head tracking \nPassthrough visualization \nCSV data export\nVoice Annotation\n\nFor technical support or inquiries:\nmohammad.elahi@mailbox.tu-dresden.de\n\n{447729548432244}", "short_description": "XR Head Tracker P
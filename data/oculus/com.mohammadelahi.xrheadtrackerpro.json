ile_name": "4.png", "id": "523787710458705", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982562_523787713792038_6207345297599817982_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PcmDckMIQ8Q7kNvwGsnyzp&_nc_oc=Adq4mEDT-y5LOVF4h-TLhUUTgaGWXoVmcl-b8-T43TeBwsEQa4p1CqKz_bvkf_J4MmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsZFU3tpFUkBsX7u7W_HMJRosQSuv2jEoC3CmJX760RQ&oe=6AFDCA09"}, {"file_name": "2.png", "id": "1204802417861656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75240109_1204802421194989_6097745051168194742_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNR4z5XpRjoQ7kNvwEoShzd&_nc_oc=AdqXfzfY1lmP5QCrRZZ1oV5b0xzLHW7IyhDQQMzHjfSzSwWeyvwQCj3XOXVjOb-BQ9U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1eSBDw5QcFQyuOtEUtddxn6S8ArdAFLwy7__ta7UksQ&oe=6AFDD6F5"}, {"file_name": "3.png", "id": "2020875041680886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982674_2020875045014219_3662929134451352019_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZlOQ94WCXQQ7kNvwH5QXl0&_nc_oc=Ado6FCePFWpEyKQJIJw9kSZGsQAAij9LJz5lWmBf_FufvFfiXd62LZGOM8JF-ATBwXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeUZ2fGyW_eRBpQV6OcQ3psxMRVXFZ4R2NSVALB4MbLg&oe=6AFDE35A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440px.png", "id": "1309931813357430", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982550_1309931816690763_3845961028061352401_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af8BV4aUOCAQ7kNvwG_3b-L&_nc_oc=AdqojNKvHZMau3d96VtOHTX4WEzaSBdR0eiifytjH0Zlqj6wJ0gz9zwUatTIVRtR6hI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTb9Ifo-Dk3OV7CTAWDuteMvwyGvTVg6i8Xmb1mX2cAg&oe=6AFDDCF1"}, "display_name": "XR Head Tracker Pro", "keywords": [], "long_description": "XR Head Tracker Pro is a professional research tool developed at the Vodafone Chair for Mobile Communications Systems at TU Dresden. This Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information while allowing users to maintain awareness of their physical surroundings through the Quest's Passthrough technology. The application stores motion data as a CSV file directly on the device, providing researchers and developers with easy access to movement analysis while maintaining visual context of the real-world environment\n\nKey Features:\nReal-time head tracking \nPassthrough visualization \nCSV data export\nVoice Annotation\n\nFor technical support or inquiries:\nmohammad.elahi@mailbox.tu-dresden.de\n\n{447729548432244}", "short_description": "XR Head Tracker Pro is an Android NDK C++ application leveraging the Meta OpenXR SDK to capture and log head-tracking data from Meta Quest headsets, featuring real-time Passthrough visualization. This app collects head tracking information and stores it as a CSV file directly on the device, providing researchers and developers with easy access to motion data for analysis or further processing.\n\nKey Features: Real-time head tracking, Passthrough visualization, CSV data export, Voice Annotation"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1m-4DhHA3xvvWmQ0gni4HSpaIoda-Cw-tQoir53pcf5M/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1NubrLolVBsrrnbVxEFhJ1ILVDG76sjac3I6y4Va51Wo/edit?usp=sharing", "publisher_name": "Mohammad Elahi", "support_website_url": null, "website_url": "https://github.com/Mohammad-Elahi", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "10635849107
.oculuscdn.com/v/t64.5771-25/38982560_352258522323219_7659787113981804544_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Jv6L5W4DA4Q7kNvwEHoCHi&_nc_oc=Adp4ipZpD3l8hx2ITwxSxv2mnvZsCaO5JfZhN7JqR1w8w-ElTgjSFKWiLk---aJtzHk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-6IAl8tT5nUoUvv7HAihHFbvo3eAE_FsGw278-0ArUA&oe=69EE25B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Contraverse EXPO", "keywords": ["cinema", "360video", "playback", "synchronize", "kiosk"], "long_description": "EXPO is designed for frictionless VR content playback. Login at https://expo.contraverse.co, upload your 360 videos and assets and use your unique 6 digit pin code on your dashboard. Enter your pin code in this app and it will automatically sync all of your content, granting you immediate access to all of your files for direct content review in VR. \n\n- 6 digit pin code log-in\n- Frictionless 360 content playback\n- Easy to share and use for non technical users/clients\n- All-in-one interface\n- Automatically syncs with Contraverse EXPO Dashboard\n- No sideloading required \n- Kiosk, Cinema and Grid modes\n- No set-up time\n- Easy logo placement\n- Easy 360 environment replacement", "short_description": "Seamlessly exhibit VR to large groups of people."}]}, "developer_name": "Contraverse", "developer_privacy_policy_url": "https://expo.contraverse.co/legal/privacy-policy", "developer_terms_of_service_url": "https://expo.contraverse.co/legal/terms-of-service", "publisher_name": "Contraverse", "support_website_url": "https://expo.contraverse.co/contact", "website_url": "https://expo.contraverse.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "MEDIA_PLAYER", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_gra
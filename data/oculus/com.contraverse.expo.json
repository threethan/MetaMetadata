s to all of your files for direct content review in VR. \n\n- 6 digit pin code log-in\n- Frictionless 360 content playback\n- Easy to share and use for non technical users/clients\n- All-in-one interface\n- Automatically syncs with Contraverse EXPO Dashboard\n- No sideloading required \n- Kiosk, Cinema and Grid modes\n- No set-up time\n- Easy logo placement\n- Easy 360 environment replacement", "short_description": "Seamlessly exhibit VR to large groups of people."}]}, "developer_name": "Contraverse", "developer_privacy_policy_url": "https://expo.contraverse.co/legal/privacy-policy", "developer_terms_of_service_url": "https://expo.contraverse.co/legal/terms-of-service", "publisher_name": "Contraverse", "support_website_url": "https://expo.contraverse.co/contact", "website_url": "https://expo.contraverse.co/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "MEDIA_PLAYER", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "687400742297682"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974807_917987775225860_7292793359813312512_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ib5AQZ_BDcQ7kNvwFl8xNW&_nc_oc=Adm-0vhRSHR0XLXczv-HRcO3rtWXpf_tHn1jA8QGyzub66t8aRyTHn-eOeYOBN1cia0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzilYebtTt4BkaT7wzA8Kkq55gKDfWAckKmC5_Zs9eUA&oe=69A6D09A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
tent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDd5Wi14kK0a4V71A62Dj2muO7DZ-pRZPutfaFXC7jJQ&oe=6A68C6BD"}, {"file_name": "MAIN SCENE_Custom..._06.07.2026_16-43-07.png", "id": "1229679732540378", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_1229679735873711_784546325196011152_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmLiF4yfE-AQ7kNvwG1DA0j&_nc_oc=AdpCkesGjdwybodpvcuEICd-JDiiVCcR3FVkWUTs3JDux-lXe4w6H0uSTWDMUg7soDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCugj5Uw0h6dqAjsUaTbnsQ1mu4kPjM08qip0kiFTHYYw&oe=6A689F20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LuLL", "keywords": ["vr", "horror", "dreamcore", "backrooms", "lull"], "long_description": "LuLL is a surreal multiplayer virtual reality experience where you and your friends explore the strange, shifting world of dreams while trying to find a way to escape. Built entirely around arm-based locomotion, players physically move through the environment using natural swinging and climbing motions, making every step forward feel immersive and intense.\n\nThe game takes place inside a dreamscape that feels both beautiful and unsettling. Soft glowing lights float in the distance, endless corridors twist in impossible directions, and familiar locations slowly transform into something distorted and unfamiliar. One moment you might be walking through a peaceful pastel meadow under a purple sky, and the next you are crawling through an endless hallway where doors lead to places that do not follow normal rules. The environment constantly shifts, reflecting the unpredictable nature of dreams.\n\nPlayers spawn together in a shared dream world, encouraging teamwork and communication. The main objective is simple: escape the dream. However, nothing in LuLL is ever straightforward. Puzzles change every time you play, rooms rearrange themselves, and hidden clues are scattered throughout the world. Some puzzles require careful observation, while others demand coordination between players. You may need to split up to activate distant switches, climb towering structures to reach hidden paths, or solve environmental riddles based on patterns in the sky or surrounding archit", "short_description": "LuLL is a multiplayer VR game where you explore a shifting, surreal dream world using full arm-based movement. Solve ever-changing puzzles, work with friends, and navigate strange, twisting environments. With its dream-core visuals, ambient sounds, and unpredictable layouts, every session is a new immersive adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lull-vr/home", "developer_terms_of_service_url": null, "publisher_name": "ScuffedBanana", "support_website_url": null, "website_url": "https://sites.google.com/view/lull-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27531123699860265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823905_1039234438461954_5097678602252811920_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9SK_xGocasQ7kNvwHvJ9YG&_nc_oc=AdqtxnARHiXje0DMnBv_LhfpjQ6DvsQZGSGlGl4CoMGY-ngd1qjOGSC6ivWeyywrAN8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwdXAYXNJv4Y34T-zBc8jj2zGuJmitfShu8Qrd
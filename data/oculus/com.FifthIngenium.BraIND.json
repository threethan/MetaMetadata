99DA51E"}, {"file_name": "Screen_3.png", "id": "5774738042572692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003229_5774738052572691_8121136783797212497_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNXj2NMtJ7UQ7kNvwE21Sg-&_nc_oc=AdkxHD0Xps2FZHycVaAQ7sIdSy8RAzmBtSGYWu_iFxFOOIJyaI6boqD_bEYrGKzH0Z0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvSI432EYTPhjeCBDMzy02sQr6bvlCNDdOdwOOCRo_NNQ&oe=699DB50F"}, {"file_name": "Screen_4.png", "id": "837955124124901", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035330_837955127458234_4299095307554421786_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liV0KdaHM-0Q7kNvwFURGBa&_nc_oc=AdlEDih-5ucCXIW7lQZSGHQhCeBYOcd-LD1kbk1oM-aZKIdgFbVjkyt1Nk1XNzCrBDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvV-hx8SpdNEZhz1KKcqXMLvr-XhqjWeMPLEU6IA4sN7Q&oe=699DB3C2"}, {"file_name": "Screen_5.png", "id": "718866739187603", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031458_718866745854269_1935557594074422485_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4H8J0GqzYAQ7kNvwGzekuX&_nc_oc=Adm-Y0QQlM14CNoRPYH-sF6hEJohC-epGVOWIq9oiwdppMzhkLE43ncqawpfG7MGLJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHJ-Mf5jU058IZIsHngZ3xtN0GocliMLSN9oZiDHJFnA&oe=699DB26F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BraIND 4.0", "keywords": [], "long_description": "Braind 4.0 is the definitive training application for smart factory and smarter workers, designed by FifthIngenium to support the industrial sector.\n\n This Mixed Reality & Augmented Intelligence app provides a comprehensive suite of tools for maintenance, assembly, and training. \n\nWorkers can access interactive checklists and manuals, receive live 3D remote assistance from experts, and participate in virtual training simulations.\n\nBy providing a digital twin and visualizing IoT data, Braind 4.0 helps identify safety risks and ensures compliance with industrial standards, making it a valuable tool for Industry 4.0.\n\nKey Features:\n\u2022\tImmersive Training: A virtual platform for training single or multiple workers.\n\u2022\tRemote Assistance: Live, fully 3D support for troubleshooting and maintenance.\n\u2022\tChecklists & Manuals: Digital guides for assembly, disassembly, and maintenance.\n\u2022\tIoT Data Visualization: Visualize real-time data on a digital twin of your factory.\n\u2022\tSafety Compliance: Identify risks and ensure standards are met.\n\u2022\tShared Experiences: Collaborate with colleagues in real-time on complex tasks.\n\nPower your industrial workforce with intelligence and precision. Download Braind 4.0 and step into the next generation of smart manufacturing.\n", "short_description": "Braind 4.0, a Mixed Reality and Augmented Intelligence app designed by FifthIngenium, is built for smart factories. \n\nIt helps industrial workers with maintenance checklists, troubleshooting, and provides 3D remote assistance for improved efficiency and safety. \n\nThe future of industrial work is here."}]}, "developer_name": null, "developer_privacy_policy_url": "https://braind40.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fifth Ingenium", "support_website_url": null, "website_url": "https://braind40.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["S
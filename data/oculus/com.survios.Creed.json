g?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb0_-KhCIVcQ7kNvwFlp_-v&_nc_oc=Adqvb42SqFg71DBAabdnANijSDkzNo0Z4JGu0zufqF98aVBTACf2ixhgJxHQ7Y62KgQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE0Qm3UHA88s6lADHP_W6GSyGfzcBPBMMa8nPGVzMMMQ&oe=6A8EDC88"}, {"file_name": "migrated_image.png", "id": "511964106052254", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974873_1148859985293009_4690500678353682432_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0b5tCH5TfAQ7kNvwEn2_d5&_nc_oc=AdoORUXmLQSQRGlrB6FsobZFBGthQwp0-odMRtP-bpXaJpu2jXKv6B8aKBZOqTqXHnQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGK6oYA4A8kxxJNrN4hQyRrJkpV8Mk7WUz_mI6bGNNIeg&oe=6A8EDFA6"}, {"file_name": "migrated_image.png", "id": "208281876930930", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974597_320398482009698_5384264057027035136_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xc9UlgNXu8AQ7kNvwGDrq6G&_nc_oc=Adqln0GQvMvY6bYGzx5Z3JYfONxMsYaZrK-MkUwQrP0v11XyWh2pExZPHz7tyFTzVUQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPr7bwWVD_KeawlYHf6qK4qT3dibMxPauG9Lw13xlYxg&oe=6A8ED688"}, {"file_name": "migrated_image.png", "id": "261285824890156", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982718_436856057084290_3070167207297155072_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TyUMxhOU_4Q7kNvwHPN_jg&_nc_oc=AdoeRknQUmxpgTjGkWcI3jknEoQIu4_ZLS4GMwP3JwmqfPKjRguaNjKtLzpwavcrwKE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhb1_3hofdJBjfXQbuJoJlX9-6X9ES46Mws7kCaRVKcg&oe=6A8ED1B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creed: Rise to Glory Quest", "keywords": ["Creed", "Risetoglory", "Boxing", "Rocky", "Simulator"], "long_description": "Experience the pulse-pounding excitement of boxing with the cinematic thrill of a blockbuster movie as you become Adonis Creed, fighting to establish your legacy in the ring and beyond. \n\n\u2022 Live Your Legacy: Challenge both your body and mind as you experience the ascent of Adonis Creed from undiscovered underdog to world-class fighter, all within an immersive universe inspired by the Creed\u2122 films.\n\u2022 Multiple Game Modes: Choose your path to glory in multiple game modes: story-driven Career, customizable Freeplay, or minigame-based Training.\n\u2022 Online PvP: The fight just a lot more personal. Set up custom fights with friends or find your contenders in crossplay Quick Match.\n\u2022 Feel the Impact: Phantom Melee Technology mimics the real-life effects of throwing and taking punches in the ring, such as the out-of-body sensation of getting knocked out or the strain of fatigue during a long, frantic bout.", "short_description": "Do you have what it takes to become a champion? Follow the ascent of boxer Adonis Creed as you go toe-to-toe with the world\u2019s top opponents in this intense, cinematic boxing experience. Featuring new Phantom Melee Technology for impactful VR melee combat, you\u2019ll train, fight, and win like Creed."}]}, "developer_name": "Survios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Survios", "support_website_url": null, "website_url": "https://survios.com/creed/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_intera
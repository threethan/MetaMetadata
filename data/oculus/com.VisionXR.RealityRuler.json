c_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__Iz6xiE_Dg5lNRNg8YoKvkBdiMvp3oE9knOXFb07ODg&oe=6A2C27E3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQV5EBQJojsQ7kNvwGE1DY0&_nc_oc=AdqywVsmoFpfXpDf4QT9M7kSUF5DZ4sTt49kTjMgwBkeCWEtyFNHXVh_ZML3riN9R78&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gU9MqXxuWFl9aAlsmunI3VpxjOgnNfwP9qdaXHr7Adg&oe=6A2C0258"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsRfkMzuk2gQ7kNvwEgblHk&_nc_oc=AdqU3txndZRRpsfw3gnOaedN3WeUKKZ0T0eEV9gRh31GjM12Cd3YUQitSGImVAVVIMU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TuIns8_ffu6wclcbU8Syf6vOHTadLVnek8VBNxLBfaA&oe=6A2C2A72"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewejY6UVGPkQ7kNvwFqK8NG&_nc_oc=Adr3H9a1LBp7hA6i3f-2qb9H2P5JYMnDuuGavfviIll3RjIpyE8qV_6J9lhH1EIk0J8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sc2h5B4kJD4Bf-3zPwU28udFAJq5wrucelFoxePAvug&oe=6A2C2033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLzhsGvpbgkQ7kNvwHsP5Pf&_nc_oc=Adq7mBc-DQGPHGJZ7JB08o8edZ2JBS3lTFr5m8C-DVy_rPFSXma5qWzyfYqtqZM6T38&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RcP7ffu5dWOp_nQfRX4tvCRAJekbtZPIW0e7brsyQvQ&oe=6A2C2217"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
6530480603931", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974626_1366530483937264_1924810608918139604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6hHBAxFq5gQ7kNvwFsPaSc&_nc_oc=AdrBM9ZxzD8_pZRiej83sdU31cfL0DiPChhSeKH_qLSmYyFue_BeU8EnRmj-eSMBLWw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_56lopZTEogsW9j7xv4fpXwm1YelNxseSaArzXYN-N2g&oe=6A4537AE"}, {"file_name": "NewShot4.png", "id": "844139123700908", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031511_844139127034241_8895982602953104589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7kod_uB23AQ7kNvwFMngXF&_nc_oc=Adr3TmVmpK-aPGrT3mDj4L9m6CbIJqSOUcGQ9lFa4iXjGyuQH8JH9sUR_KxT5oy53wE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kBKR4bv7MLiZk52qfmncIygJ-ysf134QXI7cb_-s-Ng&oe=6A451290"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ks38_L8rYr0Q7kNvwEkGq2M&_nc_oc=Adq9E-feFq0BGEcZBybMynIpqccPR6pV8MR8IWUthCXR2kDupvk7cU--f3YPv5g7DXw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eIOxawbJaFDfB0gosGzRZHmDnAIsHneyxUD1WrCAKzQ&oe=6A451AE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pW_CzE6n6ZAQ7kNvwGUh-Kd&_nc_oc=Ado7m2XH-CttDSwzk_FjzDbg6g25Y8c89StCrWGpP47oyLQnvObEkfeBMvz8sbdbWA0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rRGe-d7ntJ5kITYlDYUV6HzEnd6fp8mKsdWjxqRVdiA&oe=6A45198F"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "836616164774793"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "21
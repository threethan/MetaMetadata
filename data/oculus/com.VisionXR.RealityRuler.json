c_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RNazQok3Bjwmv83ZyOZPEVKAHq51YIKnYOaVC0Xpnbw&oe=69E761A3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0T8YnZliLQQ7kNvwFr6d1g&_nc_oc=AdoAHLLsrmK98kMaqa3hm2y18aKBsaAZLa97j9DmQqA24oZUtBOlkYf0Zdw1ZDPpXGE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EKfJzblriVDuWFoeI_BdNNx1gUekHN-WWv5bDlfhJxg&oe=69E77458"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY9iarN1mrMQ7kNvwELHAbS&_nc_oc=AdpQWD6fMYyAeBXFEwJ7WV9G69EvA6dXlxTSenqjuXdqAOMYv4R1mhVyMXQ1PS8DC2s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XLbnalAL9YIcS9NTxJhdfRDnM4jB08pSAT4NstTgYOQ&oe=69E76432"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcZhZnGO20cQ7kNvwE2nVcN&_nc_oc=AdoQodnyqVdpoD3B_rKyNjXQ63L0ZoMqkpJWuwwWMiF8Eyy4m_Ah091Zvv7TaOiDPwo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X1X7uNkCFLItiHV_RTj93L_yy3fJDaXB-7bjt3VKZQQ&oe=69E759F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOhK2mdZoBoQ7kNvwEwxv7K&_nc_oc=Adqrh79fXbYXvQwQxk9RUa6C8VccczCsqSSsCYtK8isqFl-F7tOfWS1kAiGYc3pVeHs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zkpWmIRFSzEcffpSflz_f5bSn-6GUN843Ff1WVg14GQ&oe=69E75BD7"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
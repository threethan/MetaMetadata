=69F09BD2"}, {"file_name": "NewShot3.png", "id": "1366530480603931", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974626_1366530483937264_1924810608918139604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggbgxsbLXwgQ7kNvwFukkQW&_nc_oc=AdorZvnkO1ZrKVeJuc1zRDe63OMyZ0NxD5ByW3wd_kC7mLr07-erbgC16KrO52jyKOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0sMZoiaUDceSCa7eUxHZd3_Da2Bmpe8gKainl94jlidQ&oe=69F09F6E"}, {"file_name": "NewShot4.png", "id": "844139123700908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031511_844139127034241_8895982602953104589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EkJlD_BdNoQ7kNvwEtc3z0&_nc_oc=AdoIS8bPLXUxN4AAZR31b4yJY51GJ2rv3P3qFhPgkbPl_tkfkjhgY-DYCc5t1z-gF5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0pfe6_y-4LwinBxJhLEIHLSkqUACD2cPgZlnKSSLB3mQ&oe=69F0B290"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkzW7eVRECoQ7kNvwFdAzWH&_nc_oc=AdpzocPqkxdnZm-NFX_HbPuABRLOrY4l1A6_UdU8l9AgSfbHb4VgFA5DOscvRKl6QJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1-h-iqX9P5UfpOB6J5BdPSXR2Scsz8vlgNiB2HJLBGtg&oe=69F0BAE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRS53CJ844gQ7kNvwGhPwhX&_nc_oc=AdrAv68flpkM6YMwf04gtK9KbFrcB5gpAeOz-a4QlQIe9Yan9ICW3yM9BWf0urXCIfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2eM4Q9sad4VJm3Owrewc9vhWFQUFOhn8cZOEakgQASEA&oe=69F0B98F"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "836616164774793"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2
uluscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tfsY6IAEloQ7kNvwHZrB5v&_nc_oc=AdmF8cxGdjgEBLFd_cV_o_fvZnSudbYqWINrIx57JWr9lGKuPIbDKI1zvtlwily-WRk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv6ry3rtbRqkjPV4td8pWEAq6XR2bndIcqcDjIj_GlDGQ&oe=699AFD58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3U050BzNPEQQ7kNvwFtdzyE&_nc_oc=AdnPtBZdPxuRBWbH7OKVTEU8OrtduvuFggig5gqMaadgkySsx8J2dA5Qk0tFmKldf4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvoU1d9dJhmBRH0c4pxmmmxg8zs0Pulnh85y2zbPq2mZQ&oe=699AED32"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiZBVb8-cPoQ7kNvwHnqerh&_nc_oc=Adk0JgSxWnIqaL8Gb0fuaVoXulm_RlKdTj6Cm58BARbYy7CZpSStH5g5XDdRJS-SWG8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfusdmKTKKnorgppotnu9JNaU-5HQh3eHZrPzBe6iwO1bw&oe=699AE2F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 1 (2).png", "id": "1209147267463743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618277_1209147270797076_2776377696328209035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKzNbQiqKTIQ7kNvwGyrKed&_nc_oc=Adnhbytfczasxyc51y0-glJtxcYZ3bTqxlxaXGF14iPGERvP6_mDzsIUS7lYp1oIWkw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKQy2cBCQCfpS9v-RgH_9vluOL8PeJhDC_ONfjzSixYQ&oe=699B11B8"}, "display_name": "Reality Ruler", "keywords": ["TapeMeasure", "MeasureDistance", "LevelTool", "HeightMeasure", "ConstructionTool"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "e
c_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Wv7--4k6aPvfm3eSJg4QUfcpZnHFrZeApUkHwP-7u5g&oe=69E61023"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0T8YnZliLQQ7kNvwGsjeup&_nc_oc=Adrk0QIVPPJ_lszC4RB4YqUpGZZdKeNqC1GmM2jw0tq63A60PuQOirfLljk8b5OqCO4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Dxi8hmpYs171l5MJMZ6XAa6H5TDqL_agxCV-k-6LHjA&oe=69E622D8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1AB3-FVD8oQ7kNvwHFsbxn&_nc_oc=Adruk9FU0o3T9APq1qik4PnEfjC9wBAdRxWqmqGn64N2nZ7PBlJ9KdUPsuydiCU7vjM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A-w3r0cW34IZWdM8V71BWXzL-p1Du8OPr3kuHhwmNpA&oe=69E612B2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zcZhZnGO20cQ7kNvwGlkqDs&_nc_oc=AdruLW5XnQDsKjHTz2Cbv30-H_kSJ_4DAx1D8L46Wf5pUFBChgBBgj6S9nJdIzOwXjI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jQXDCcX7v9fu9kL_R_pEtj-7WNa0qO0y-_yqa2r0-OA&oe=69E640B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOhK2mdZoBoQ7kNvwH-5j2n&_nc_oc=AdoVIawPGPmaLOpZVUP2VFmRFGfj4uXFyYcNz-noQyDzxFDsTO4qS-ofk8WE6rjtGD0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M_OQlwZSIXsvRW9GEJQUmyY8l2-wy-zxAOsQyCfYXGg&oe=69E64297"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
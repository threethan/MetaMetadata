uluscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3R_TBIbuKgQ7kNvwEHgD5c&_nc_oc=AdnbWYsN4E1q7uV_rmj5K3CLy9BO0j_SpiOkIWWIJMXq26T6YcGiBXdM7vSVGuMFdBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuTveHmrwN1SzaqCsNMtFpk1KIgAAmie4KDtofPD0iyjA&oe=69A04358"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y__u0gxcIIQ7kNvwH0ldsW&_nc_oc=Admv2GH6WfeNXUYZIly-pA8znwTEZxOD7lttpWScqim4Ib4vx8GaYRKZUi9CbefWSH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuWNRhYcYJQRfZGiZNlboLWzq6y9hyAcjMOVZJP-PyWrw&oe=69A03332"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UyIvVpXnx6UQ7kNvwFT-FX2&_nc_oc=AdkSQDGT9IKRCvOl7GQGJtvy9ES0uefN8tUL2SWbB3AVD6b7w43I3vIM9k4DxwjAbjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftAHSmtBAroPaRhym-C78DLAgqfnc2TpPdpjC9BuU0RgA&oe=69A028F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 1 (2).png", "id": "1209147267463743", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618277_1209147270797076_2776377696328209035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqrwocUseLQQ7kNvwFpzST1&_nc_oc=AdmN6-6TRgar_ZitXhRTTpbg_QQUGYW41wSJ8auGx3tTTgvRKA1Tf20OL7y7TMayNVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afudrj1yiYMs5xyaMI0JXaii_3jGcEPvcp1d8AozaEnpaA&oe=69A057B8"}, "display_name": "Reality Ruler", "keywords": ["TapeMeasure", "MeasureDistance", "LevelTool", "HeightMeasure", "ConstructionTool"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "e
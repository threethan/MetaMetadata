c_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20_TdA_0NoXAJpE8269Ek_PUSZdjXrJcREmiyXaHPXkw&oe=69E21BA3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=go3mOMq7JfIQ7kNvwGRsEix&_nc_oc=AdqJBUpb6SzAz9yW0leoe7Z7v2hSYGl653oxYtncgFlOU8wJNd33Q9xzfPFTGmaOKsw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UxhEOn-LQnmpg-kPHdmzXhJxt_XwTCUiahQYRs7h5rw&oe=69E22E58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PAftTwYwRQQ7kNvwHnDTU9&_nc_oc=AdqymUVJBA_06__T5gJux5F5UF-xpSPXveViOkR4ByIbYRkPJaXsCIbCIzzTLv0ACNE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2B6ZgAuVKgxriQiX6Mj8QgMes5RhmwFn2u99Joc2T1WA&oe=69E21E32"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lkc6S9RZnQQ7kNvwHRQ9qQ&_nc_oc=AdoVxsX25gUD5hTfKbCW-Z4Q5N3ouq2u5QtSBsPlfAhvQLfnALBiYtn56IJUydJ-0tk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hXpYarloA8VS2g7COihhsGrqRdrbB0bOXUQEtXA0BnA&oe=69E24C33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ieia8kDBLHsQ7kNvwGFezEo&_nc_oc=AdpLBEfZ7raRED1l0lWq0ZprESWlryqD1z1teEhpK1nKaSZc11HJZHedDvov6cOz-GM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w9uAfBtYxGJ7FfFqC4kaT6Hb28oZBdJQpG0usNtmZdw&oe=69E24E17"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
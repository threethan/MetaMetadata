_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cq5QCPijKn90VAbigym0Kjv3k48ud5ppJZr7Ev1SxjQ&oe=6A36B3E3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A6OswlLplwQ7kNvwF2vPB1&_nc_oc=AdpjygHBjJIL37PwZNcTbAdw4Z2vQfgFFNmSyhJvuqraLAGJzPg3CJ2kJSa1UP2-wzM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qflqQBIzFOIfs9OQwn65J0VaR3ENQL5sdsVKrj933Ig&oe=6A36C698"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChtDJrr67vsQ7kNvwEb2e9y&_nc_oc=AdoibzFzzWWqaExOr4j2Z9ft2_X5Sd8sWwjPo-9Usluhh3nCfSb8POV1rr5n8VB5E3A&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r03ZN11Xs1hRraki4utB2N_dSXiXu8Lqiyl2GCDErNQ&oe=6A36B672"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bv40KalnxKEQ7kNvwFeH49A&_nc_oc=AdrsRsX6HY0F7MOPek3wO_HOLWQHdVf6ffmN9ffC_TrrSV6-E6aseDOMowYd4zniZuo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C7p61DYWX5uz1gX7tURbAuAlELsheC5_n5vbS4qMflA&oe=6A36AC33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9aObymifcyEQ7kNvwFxuMgy&_nc_oc=Adr27saNNxjE0y_2IU-9vHWj86HLifg2-ycYdSDKuk4R8hbfFSlBZ9zAOCi4NfF-ouY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Nw6_F7wPsnlnvgxytC__kAI-8MqwovSmRgIyjDndhbw&oe=6A36AE17"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "
_H7y8fz1YMzOqbHOyN9bNXbE9iKHt8h5otM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzp502e62EvrX483PcHhqTNxvjWJlVdS4qHJBJr1WS0TQ&oe=69CE54D2"}, {"file_name": "NewShot3.png", "id": "1366530480603931", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974626_1366530483937264_1924810608918139604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4Uy5ZhfWdUQ7kNvwEDDPre&_nc_oc=Ado0S1aZlW-yUSMXqK1A4w0tlzHeqs3zpZ9UVOM4O9_NIdFQaFYdIDeEkqmM9rz-nTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfeouuufsKyuetzBouzXc85uYlFTGT8BG0HhiX6ROEpw&oe=69CE586E"}, {"file_name": "NewShot4.png", "id": "844139123700908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031511_844139127034241_8895982602953104589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmg7gcPzy0sQ7kNvwF5l0qv&_nc_oc=AdrS6M2LcBukHMKVFUSS0BLsULd9lYZ_0xCgD0g_Az6Vx_PogPmVWsA3dooNHaAvU2A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-oQIRgDs0BGfhizpfPUvU6OfqbVUQ21JvbnZdSUC2RQ&oe=69CE6B90"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gW-OOy8fAsQ7kNvwF2-Ksr&_nc_oc=AdoXrej5iumP_hC9vj-bhWYnvB6petGTIbsY9NM6rqANwFBeyLpyi8OCl1FxxfgLFXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCxTpNCw6RzcDTAV2dSvsUrdaLD5abrHor9IIzI1scaw&oe=69CE73E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymdTbuPAR0AQ7kNvwEMLxvV&_nc_oc=Ado-GTShtVo2N_AwFAqh3SaeHCrJXVLiY7kUryr3BSay7vplFRbTP_iWx1neKyESwoA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1n4v6xyjYeyROSEnmQqrHhVVZapMx9_-owrjTTJ_ddA&oe=69CE728F"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_m
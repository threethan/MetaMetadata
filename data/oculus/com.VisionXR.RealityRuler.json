c_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hpH4OMJQJK9yku_wz5p7ZTIfch1s2nMivWSTzhmaCgA&oe=69EF4AA3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CdwJapuaNEQ7kNvwEchY8I&_nc_oc=AdrujYPOXztHEXPlpbzObz9IxymGg2RIWPikHAgSd-UBCL85Xa7UkKv5ksN9oYG8I2U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ml0IyRLY9u4LJ0jcRTgo3DjEBHkw4lRCUzQ7Lch_Eqg&oe=69EF5D58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr2mLuwhLx0Q7kNvwFXtJm9&_nc_oc=AdqiCGXcho64rDrY8a6tIW6HZgHFqlDgkzHOLHspfmC5zGxPED530-IyPkFlBpJk3Nk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1F_ORIoDCAtmqLLFO-cJi1uWW6fer_A-7Pthj7hbxgmg&oe=69EF4D32"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0TocrwB8LsQ7kNvwEuTgcT&_nc_oc=AdoinQS_meuxZTcBba03gt-B5vJBQPemCtESBPznLpXRgImtc76PAlvqb1-f0bG3B9w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rkm-wwfTSgMelBC-xE1Kqc5jAM64qinWwdfvq3Rgn5A&oe=69EF7B33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41rgUftWhB4Q7kNvwFSp_MH&_nc_oc=AdpPe_UibA2uwu0n3rU7smKywlaLQuQmD6A05LYElydvPbIB8klpM0bcDmjhSMkRtfw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19tA4U00a-_ouebU_SG0Sma5Tg_mLk4lK_b97VUWz47w&oe=69EF7D17"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
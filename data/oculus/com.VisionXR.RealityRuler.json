uscdn.com/v/t64.5771-25/38974626_1366530483937264_1924810608918139604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mErySHPeXeQQ7kNvwG13oIc&_nc_oc=AdlU5dOhB6rYNfPfY5yVWjPe5rdbuVGhC9xnfiA-AuD72sKUw8iGneBm24grkD6uPvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuvcfleUXUoCd_udEOEFqNd98COa4uWiYp5EHswTitLgQ&oe=699D90EE"}, {"file_name": "NewShot4.png", "id": "844139123700908", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031511_844139127034241_8895982602953104589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUWyfiGwYzkQ7kNvwH30AWv&_nc_oc=AdlvFdPNuMa812v8sE2CXxloZHGU-5I2SCA34S0EyoWSFTvLgY7zcC82ZB2_qFK8LsU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs9_pA9ptbfD97M_Xw2NqQ9yxWzTijZq26qPdVIGFwRCQ&oe=699DA410"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTDOWYwQrRcQ7kNvwH1HP4U&_nc_oc=AdkZk0fnvhWHmCl6Ic93PxXiIvKQ58jF82mcjq5Bpc01dL7o61N5pGEs7UxkVRNbUsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu1ALx0I-15jepv0DTbUT70DUT7x-h7RxeGI_ME2Exl9Q&oe=699DAC66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=439FmRKMSCAQ7kNvwHfh24Q&_nc_oc=AdlgOTUhTG08xYEDWs_hil2dWHgM5o6vHIUoDAMvMerp-WZpS7OBD3we6q0h_VokV9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftW_pesSmfM2NstnP9PH3n0soQlmxtiz_FtpWdQgJ__vg&oe=699DAB0F"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "836616164774793"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2144658002642126"}, {"status": "PUBLISHED", "id": "499269319879941"}, {"status": "PUBLISHED", "id": "16367
AX0VP-52mc1Zn8QlRQ6VxUrib8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVqn4B5VhmW5fpK0DCf-JyMOthHIzSYC61Mnx9f4yTsw&oe=6B0C7773"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cEeospbf58Q7kNvwE1xalQ&_nc_oc=Ado-fUiV79Erm2ObwtWvfun2je2h4tcI93UPTbypapArkkoPZdbAURZyEJ6cwXB5i_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAZiHrpG5vkzqZ3TC0f1TDCDPHQggnl023NsdGIvFJfg&oe=6B0C7957"}, "display_name": "Reality Ruler", "keywords": ["Area", "Volume", "Length", "Measurement", "Ruler"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28430212906615909"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619096_876241818768600_8673460511022488098_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ5vnz-QmGsQ7kNvwGFOFlj&_nc_oc=AdpQ4g1zB7uMWCQHRu0yPEQTNGGQucShjTpgXZQS3b72gvr1coh2DTnpriDv-jbk-h8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgRz37aLwKQ7bZsNahgjVttAaC2glrIVUy08oKshFXkA&oe=6B0C6AA9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
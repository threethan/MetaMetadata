c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bHB1RUj0azo5uDRf1OeE1jS7afYhcYAz75j7zg4nqIQ&oe=6A2AD663"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACCZrz0LSn4Q7kNvwFk5dop&_nc_oc=AdoUZgzZtA5OV6eTMcDY6L_NXUirs3mV8TouJpIS9wGI8j058jVuw4LsyomFUWVWQV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D6JMf3TzX8k76JxRGCtfcZZcRvT-eTQl_mjRIhjlkNg&oe=6A2AB0D8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsRfkMzuk2gQ7kNvwHxwwbT&_nc_oc=AdokfzWOQHQSmLILwC2SMt9-sDJ6AgI2sHunPAtdwHhmOCEq-d00q5EWmgpE4yWCSn4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sjh2qn8M7a3VGzRj8ihRUq5WXjPHiXLxbdb-S_CcgSA&oe=6A2AD8F2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewejY6UVGPkQ7kNvwG43qPP&_nc_oc=Adorgavu-Q9M2C0kbbeAc_L2DANRYgQCdwQMEoJzA-RZj8fhrKO41pZa_eBcpnM9uXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rgaDr5wmyuud5tgwqULsrC5QEldinM-UNbk1bOJmsSw&oe=6A2ACEB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLzhsGvpbgkQ7kNvwHmXDlH&_nc_oc=AdqFVv_xbE55Gg56Mhe8vRIVA5mmv1HaFcjpm902GkTefod1jd8joYlqwMODPkZPl_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z8fAjER96L6JdjwFk6VI9QnR6y4loDYZw0hRWKKfMIw&oe=6A2AD097"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
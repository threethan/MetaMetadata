c_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2syunsp0ddRgxg3cjQq5KjwaCRBBodkn4KrFAt2z7VA&oe=6A32BF63"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYXRwFdAXRMQ7kNvwFVDvHZ&_nc_oc=AdoUJCEe0TqnFtMcWGRBzNLDPtZpPEyX9BGisI_VXZcCSJ4uErQQpFK8eLA5SPNglVc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OMn4YSGbSpYqiQYYZW4lmapdDHk0DFNTe-6QuxW5lHg&oe=6A3299D8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I18eYG2hJg4Q7kNvwGJHToU&_nc_oc=AdqgLkxQP3btOMAXT_u0crM-jQCRlRj-6S_t7VTd2FW9LfOP7-HSzP16AGTC3ld2eRs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fPt8xGN8_k5ThdQFLFxaHz1Nt8LEA6zpdMELzhAr3xA&oe=6A32C1F2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV9A0EoHRccQ7kNvwGB__22&_nc_oc=Adp01UQBM6vpThBjP8mf6t88zQNC6J7lkcSQsgud-Z4e-5p9JJvitkLjHq68_wNDpEo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Pb4MQu340rFOY9Q8QD4fPFM5bBMX-nl76xJUfq_iq7A&oe=6A32B7B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DOtfa15ueoQ7kNvwHG-dJg&_nc_oc=AdpBa6884pyjkje5XwLDOI7OHuXy2nPQuHGJCfhkx5kn02BDSu-K_lE79avKIiooDpw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_V_kjM-8Ec1LhsL6N-JRsn0p5GW6DxdHk8pkVpd-BzQ&oe=6A32B997"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
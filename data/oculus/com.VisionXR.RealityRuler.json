c_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2V4R3Iefz-j8thIvO-oMfoVmXCSFk7bHyb0Zf5WSI5Eg&oe=69EA04A3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPzyHKsWYugQ7kNvwFFqt6k&_nc_oc=Adp0SDCDec_7jkewr2uHLpY0gneZQXXYVHR8boVBIcJ6yVeBEPQheNgP18Rty6jb9fY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3739K0tWKPxcpxaRE6s9-2ObpC7AcpnIV38xpHFQiqtw&oe=69EA1758"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eY9iarN1mrMQ7kNvwH9nBI5&_nc_oc=Adqi2VqR0zw9Q4k-hAczWTAxd3qqSm2Rk1Arja_X8sMrOsvB8NBUpnROLD78EF1EnqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31mMcE3ZB4jrwJjnqIEsAZsq2NFci5HCAQ7LS_W0JgQA&oe=69EA0732"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1PCWOm7nbgQ7kNvwFvB5Vb&_nc_oc=AdrhAsYud7z6ZjRC2wKgWHmcLfdsbGQQPyLF9Tq-q-iVXMoRiWiFoI9O5B6Ki_0w3LU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2u_N8QolOi29DDLh8lTz-IYl_eeJ9LfwHoqcpuUIIefg&oe=69EA3533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADX9G4GKWg4Q7kNvwHU-g6w&_nc_oc=Adrh65x_lOqqzKdsbUY_TlGYfJeIW0ZTHUPp24Z0kYnXSQGnJTRlSqQI-h0dLGb1KkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Peo2Z70RFJG-unVPz59xOuaZ4yerfqF5pbhfnYaqLEw&oe=69EA3717"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
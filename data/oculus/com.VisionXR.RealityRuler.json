c_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eVg346whKKX8ke2SMp1oqTQeFr7gL2UWEyiZ2DgsXzw&oe=6A243EE3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkgl7ZA6_rUQ7kNvwE8OX83&_nc_oc=AdopCwtffoexChH6B4-7APQW2OwBwo4ZSth1697qUj820lf-hmAuyVfLv08ksHyEcgs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TTbsrF7Vtzq3TXKr33eh7jcYfFS_78IPLZRr09x47mA&oe=6A241958"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RC9Ynn8giGgQ7kNvwGEIoGO&_nc_oc=AdpkYSW8LyIndLCy8BXLZkr0DiRHPcZ-JSP6rMll244arIwaPChrndo5_vyHZnviplU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iSivQTgyK3NzaZEyqvtpkIqslVQqnPWrXWFjXDuNuEA&oe=6A244172"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmVuL3My2oMQ7kNvwGFaup6&_nc_oc=AdoQol0Wae7ycT0WJfpFqcmcBu-xs-KrEz241X0KpgokBxSuwzkFZcCOi7DXUlgecc0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nsCnQ-Ed2AgZDEjc1rjLU1KomAx6WtZB40qlaxsTyUw&oe=6A243733"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn6pDF94vbgQ7kNvwEHvms9&_nc_oc=Adrwc7sma4W8wCb6lSTaLSMqL6LrEDGXeA4ZJ4W7RiN826NBACk4OKj13l3WAxG6GIA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GBH2cSZZqWUktCu7dLDI6hJtVLfvywcdqQ19Sz5_smA&oe=6A243917"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
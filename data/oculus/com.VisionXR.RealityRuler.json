drpALQ3OHpodZ1MvdEirRFZjimqCWCcwk0H0qz3X2ChtnUeBPqyR47hacPjgNGQu_I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJrk2xT3TvR6okR7ZEITQDypjJgSKl3w7ZBoiRraUv3w&oe=6AFDDCD0"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ovWy62mN1QQ7kNvwGQid3b&_nc_oc=AdoLK89HQsRS1Y_0VVV4Mk0hC5FHLM-eFdVm_Tfl3-uX5QDqJKWfTt6Ox9Iy19BHJIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxQezVjCs2cZQWVObl54bIAOjaWpkxEaRLZPz6ohKgHQ&oe=6AFDACE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sdkjBVIDUEQ7kNvwHLmHC-&_nc_oc=AdpwMs8a6m63I922e-7sTX_PjyOyv_eeqDnkYq2pztIiDh1NNfWTiAiqQJRoNqHm1m0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAiZy6VjqhRvGN89hIfdVd6eA3lcNrWYIqcbnlCtH1VA&oe=6AFDE3CF"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "836616164774793"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2144658002642126"}, {"status": "PUBLISHED", "id": "499269319879941"}, {"status": "PUBLISHED", "id": "1636777103576919"}, {"status": "PUBLISHED", "id": "2841334486024599"}, {"status": "PUBLISHED", "id": "1159209521854889"}, {"status": "PUBLISHED", "id": "373616642416317"}, {"status": "PUBLISHED", "id": "209764261873637"}]}, "baseline_offer": {"id": "2144658002642126"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743771660, "status": "PUBLISHED", "id": "2144658002642126"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binar
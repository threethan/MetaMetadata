c_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Xz-R9g742AwlCGsvJfF07f9PoDJ0y2hf7XmmIIaqPCg&oe=6A301C63"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYXRwFdAXRMQ7kNvwE_EL_o&_nc_oc=AdqVwrdoIyBhI76htuqSrKsC0zVat8PLo-zKZKcNlBl6YtQi-cgtpK74Intpa5rcDRg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_frkH_oYVuussnmZXxhcW0ilDd0u3p-Ei_JcmoBEpR7A&oe=6A2FF6D8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_opqnFbmhYQ7kNvwGyR7Bl&_nc_oc=AdoTzugpCKnOYDfsn3F04Tu-HSIu2xRcG3Nr_eIc2vq_VviRbSVHv4cnAYYxdtenSxA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wF4Z9P89tUAg5CJwu2Skrk3Cx0Rq1nVVV3wovzum6Rg&oe=6A301EF2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HD8HHjVqFNUQ7kNvwHOkKBJ&_nc_oc=AdrfD_twV4ymudVzaj3m-ytBenncchQ24NWzb96fn6z30-VcgPXbagOFX90w60FBi8s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yDIcI5dTUHY_tZxrH5M95o4BJotGcauIU5g5gVYxqkA&oe=6A3014B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSrfW2udFuIQ7kNvwFDYX_l&_nc_oc=Adra5H4ZkUXbctAHBWPm8-G72IyNiIJFVrqOQj2E5IRIfzwryMk85pOgql9iUZVjCvY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xutWmHSMuALgCtV6jnzY5SKhxGDYG60AkzrCgwTte8A&oe=6A301697"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
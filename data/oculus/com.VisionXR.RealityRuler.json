0_resized.png", "id": "1323499598940370", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvW1_tbGOvcQ7kNvwE24Mhl&_nc_oc=AdmbnUjm-RFeCqYZzzIsDpZJgLYLdzvSta4WdyKbFY8FPmqVsGSGsJAjrOOqhuBmDfY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUlwSJhri_Ab-z2WGGGwl2JS_cwZaRC1aBaQrsOeoNEA&oe=69AACF58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IPR12r8hl8Q7kNvwH_2UuY&_nc_oc=Adm4oBGNGJ16Vu-RVXUtN5ERHKybBfuE8vEB8css1hLkRdSAKIKffmri4QOYFDhuaTo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afx891_GGdaLAfA9-pidl98lc6F9nDlCICkL5eaU26vQlA&oe=69AABF32"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVairizcqawQ7kNvwHzvQ2H&_nc_oc=AdmbL9A3iph9MIw1szL5_9Kx88bsE_ukFd7UJSkBPVHlq1t4RIm5t7o6Gwet-iHv_Tg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzyqyN4bXlJgzpuyPuteCdEdMYO25bquK1AD7LpIzirWA&oe=69AAB4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 1 (2).png", "id": "1209147267463743", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618277_1209147270797076_2776377696328209035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeNTG4MvIP0Q7kNvwElHfe7&_nc_oc=AdmTr-1wRzGlhDGYwznN_Zy-gU3Ni-SxVJiPF8nrpI-EGU3aPjwavOoPce7QdKSIE60&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afx4KX5P1Ka_bLozjRPYtC2kHPQkxKoUiH5jQbxUN_Ja8A&oe=69AAE3B8"}, "display_name": "Reality Ruler", "keywords": ["TapeMeasure", "MeasureDistance", "LevelTool", "HeightMeasure", "ConstructionTool"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442
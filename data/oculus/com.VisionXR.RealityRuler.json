6530480603931", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974626_1366530483937264_1924810608918139604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yRooh3AMUMQ7kNvwHgfBPl&_nc_oc=AdoB4mGdCFADPFsNXoMwAxzCn_wXrsjdyZ2pxIBRf9QXIQk1uKegld8ap2EhkoGu8k4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OASi4e-2JQqAv5QGuqCkh067thho1yUeSQZz1IwAgXA&oe=6A4294AE"}, {"file_name": "NewShot4.png", "id": "844139123700908", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031511_844139127034241_8895982602953104589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7kod_uB23AQ7kNvwEVseTd&_nc_oc=AdpwcV8HaV5ZOHPo_yC06nXccI2KsvootdETfcFY5tyIxl4oSuJPOaAl3o23KzAyf6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8C48Jg2z3vyah3hkWE52irgDmNgdWG_1wNLYV3iuXmlQ&oe=6A426F90"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VZM8-Jtb9kQ7kNvwHoAlyp&_nc_oc=AdrjcgrqIg9aHURt3ka1Fg5WYQAcgvTTdIvrDp_3ZuMLd6B3zmVNFCxTXwP0EjnrJ0k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-zKGXdjFc7aLu2vUGU_kvMO4a9tK2VKVM-myPYW_u_A&oe=6A4277E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOQvy_e2vb4Q7kNvwHyCXvM&_nc_oc=AdqTrrZxuanatLj2PzaKS0dPFRSWOn0gR9aroiNm-Zvn5YQ7g2LTJFbsLHrPFg1d7kc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2OIaUqW8rYc-yXG--_wx0SpwJooG2fAo9UzJdndqkFA&oe=6A42768F"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "836616164774793"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "21
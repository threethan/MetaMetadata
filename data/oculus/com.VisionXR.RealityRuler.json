c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bSiVO0rN9V9sJOB5akVAeIDIEAP_kujReP8HBUy09yA&oe=6A3AA863"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZTvqtaFuVIQ7kNvwEUF_-U&_nc_oc=AdqfslCcK8ZfuHQubKKE5uup-5OcCQV5y24SbpdvDSPt5IpZ2aHV_A2yo9YtOgqgZnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QjBZtSZPN7-ZLpnJH4Qd2RXzMboSa5lmirkXMlknhdg&oe=6A3A82D8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjm4UJivcOAQ7kNvwFhfDQ4&_nc_oc=AdrLBS75krp8oXRnit05wfupMgEadhX4CBMXtG_f7d-0vDakv6nCqqdDSJ6H2DyezkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bGmRqD3XWW5YHyYotwjuSqgNsNpc3LGApR7BPVjh0NA&oe=6A3AAAF2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdCT7MlqeeAQ7kNvwGAnRVy&_nc_oc=AdrPue6GCCuJ2QHzjqB0dqa8cKjsETViqbCTTZZzutJD8l-guuILWVTYIgILiqiPxgc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VItA_leXmsai8NtrTBhYoECyIUJy1PovXSbjUmb9fBw&oe=6A3AA0B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ATmW9smkrkQ7kNvwF149vk&_nc_oc=Adphrs0863TOjA5c40HuRk2GOpS_jvdd9yE1pg0bwnk7vQ2LKCatJqeUNMy9q6wNAy8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fBlQNWsjfZAS2o37adqwVwXRl0w65OvXAgtmNGbCmGA&oe=6A3AA297"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
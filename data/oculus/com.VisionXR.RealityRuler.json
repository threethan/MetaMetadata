c_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vcN4_s1exmbo4v-w3Wv3jUk83IPq8OMWLnpOYaFwbLg&oe=6A0F26E3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MMOaS59y1wQ7kNvwEp_C8A&_nc_oc=Adp5ukERX6Rz2SsMjt4CkDmA4ubgWufZ_ztRlyT56514_LndZmajC2z1nxPM-2BbY6I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sDs25SVwpa9FYgJC7uyLCVRto1UNJIxBuYcRxvDx5pQ&oe=6A0F0158"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOHqCXC58ZAQ7kNvwHmLTlt&_nc_oc=AdrJg_3FZTOZdg_Bh03Rbnj7RR0x9Oj5oGhHoQYtkY871kDb-BXVv66uvSgeVtUnPQA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Nj3-cdGuvTJBiTk_SO1lEFAm2w73zvPG538ys_fKqAg&oe=6A0F2972"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3CuG83DXk4Q7kNvwGUKBDt&_nc_oc=Ado1zd8YL54TZC1pr3yH67lrY6wsUxiB98z4lRQdyaUDPhzoQuMN1D8GwNlTtVKHzVw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ddYZxSWDYwqiwNG5jLDpKdOpANcuyVK9xmmXSMyKhyw&oe=6A0F1F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I26IaKKeO00Q7kNvwECqaRu&_nc_oc=AdqO-5rVvbOiVJmhsCqvtD9oxVv8WD1yfgeqXiw68yOR_JjsNfUzCOSgpxrgP3Q-myo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ojvrhVoTVTXnn6dgcTO4Q9m8VUMA1djmMifWTBfeWZA&oe=6A0F2117"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
-1twHPmO9lqYLooc4h25DSzj-4Mqqs0SoOwdS-8U3ATAHYnPWxv6NA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2ZvMvYJYzbNKQ4G3g8qXbJXVvOWxxRwZi8O7qCQzLwaw&oe=69F1ED52"}, {"file_name": "NewShot3.png", "id": "1366530480603931", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974626_1366530483937264_1924810608918139604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwitzQgGCqkQ7kNvwHq_ibZ&_nc_oc=AdpOoVl5rilYKZ6NQR9RJFaGKpOPhzrABsaHfRtCuxdEDHr5jPOr5hRTbakRRno7_G0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2qXIuIBHDPy6ATqk_9JT6kb4IGcEDUxNWsID-uvlF5ug&oe=69F1F0EE"}, {"file_name": "NewShot4.png", "id": "844139123700908", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031511_844139127034241_8895982602953104589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EkJlD_BdNoQ7kNvwGEVLVy&_nc_oc=Adpn4H640MjdfR5bG9BF2esPz2cCVRtO2YVRlLGEtwSEgvOpG9GsxnZmRrbEFqIijhs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1HiLNNIF4BCY54ZsLg4x-4St2lK6tbjEiqcV-jjZj9Gg&oe=69F20410"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBHYh85G_WMQ7kNvwHbldps&_nc_oc=AdqJtJk8yVHPHxfcxVqDcfz2nBZ4ROo_zw-VfBK2zvATgA4rZNOhvm5HZaKtX9w7FbM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2CXZSnREy3NLT4CNkOoM39z3RZm0R4NCEZWNXGVE9Vww&oe=69F20C66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRS53CJ844gQ7kNvwHvhL_M&_nc_oc=AdogqpUikCzYZF8a6RFdDZXsDgWrz5o-O2KXAqNyMyY6QLSniTlTHhT2ujcXPbDZ4AE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af08QdjVB8psvMWyike4csUXxt0u6Der_8yFxmaYn1E7Vw&oe=69F20B0F"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"
sized.png", "id": "1323499598940370", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QvW1_tbGOvcQ7kNvwGCWypo&_nc_oc=AdlgJff7_iAd7BtZ1tj9wHR-KuOFIiOmXKUFhhAOTJ-yMas-qZtSpse0hWF15rQdstE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfygmjCGkgoO-wAad24yTQzk73T6w0rOB7GVng3b4HbbIw&oe=69AC20D8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hnrPGdW9fcQ7kNvwF_MfOV&_nc_oc=Adk_QNyl4ZMsaLg7Px7NN7NGgLRXWvkE5_pT_Qupv2eHm6tgqYGtHd5bL9h27Ozvzgs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLeSfFxnfl-w-qiQvht7x0PYvxMYcicmkekWLIXH43qA&oe=69AC10B2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVairizcqawQ7kNvwFLxVAf&_nc_oc=Adlspiofhxpr9fYuLlU6iZ4uWHo9rdIAGPM03jTVzsUaauqdqqEpyPb2iZyITjfVwi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaM_CK3WKWojzGKdbSDPGYQK0Fq_a-4DdWp1lTzx2Oqw&oe=69AC0673"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 1 (2).png", "id": "1209147267463743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618277_1209147270797076_2776377696328209035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EeNTG4MvIP0Q7kNvwGyJtjg&_nc_oc=AdmfmUX8f0Yx6Cu6oLhqSp-PE7vwKY0Vg0NMPyS7tU6BlQPPtc4mgLSbyE7K23sxfn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwDWdnc1TPDBOZeFadZDLjSQvgQWqr_27TAz5OKU23tEw&oe=69AC3538"}, "display_name": "Reality Ruler", "keywords": ["TapeMeasure", "MeasureDistance", "LevelTool", "HeightMeasure", "ConstructionTool"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873"
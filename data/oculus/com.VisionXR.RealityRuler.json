dqsZ8cdmd-OZucW55Nno6A6sLvH3ZZEcuNIy2sDE6dkGU-lGXOWat0lVybjeq3Uzeg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-F1cqG6mK0BkNeEwO9BxLgqBQ1j4aaTfFbuocAkmQkg&oe=6AFF2E50"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8hiicnuuj0Q7kNvwGYb6gZ&_nc_oc=Adrdt7F8TT90_7Wffror1mlZBeypTII2wnJLiBc6XKpPmgzbAzS6OmOn5WYghBsMId8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTbYw5kVev2YswTs-vOSvUBEPPCl1BMByBsIHPZX6E0g&oe=6AFEFE66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sdkjBVIDUEQ7kNvwGUhLPS&_nc_oc=AdoDKHSfmDql55Uu5SJr9U7izeCpBOLop95xCqv-lCKnEE04w5WzQSxHq9T36N8Lrek&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPMGokJ1PH19FP5PxA17aHBn4uw390NTO8xNhnZEsxyw&oe=6AFF354F"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "836616164774793"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2144658002642126"}, {"status": "PUBLISHED", "id": "499269319879941"}, {"status": "PUBLISHED", "id": "1636777103576919"}, {"status": "PUBLISHED", "id": "2841334486024599"}, {"status": "PUBLISHED", "id": "1159209521854889"}, {"status": "PUBLISHED", "id": "373616642416317"}, {"status": "PUBLISHED", "id": "209764261873637"}]}, "baseline_offer": {"id": "2144658002642126"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743771660, "status": "PUBLISHED", "id": "2144658002642126"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binar
_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h-BOWOdxyoXrgNKriI99A9goX8ZS4N_YIiqb59GIbpg&oe=69D4ECA3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B36Dxr38IgAQ7kNvwH_1g33&_nc_oc=Adp4PY-8_mqoUk3e842oxM-R5rB-t18KEcKoaUj7k5WS9-tN-epbgd4_Jxvb2FtcP9g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16pzqfBflETaObiR5HtMUSvqgMJOLWNCbfj9snJcFxHg&oe=69D4FF58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynHZB8t31cEQ7kNvwGtIHw4&_nc_oc=Adq2Bkz3BmwwY5-bRfipGk0qrCanke2G8KwBp0ArrZqYpJ_JLWzFeDcJccRF-j0SAik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TfrpofpqTp0pOnxmpS44nGrgUJun2N5Sm2UQovlbYDg&oe=69D4EF32"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FSETsEmp9EQ7kNvwFHM-VM&_nc_oc=Adokv5WnHK4gryuSb-OEPo6IzG5wDk5FYlvuBVlggvVddFjgggoPB1D54WJriSxgxJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PLDe9AZeDI85hlZeBybyQ7ubnc50xxSiqYFlO_lChPg&oe=69D4E4F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 1 (2).png", "id": "1209147267463743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618277_1209147270797076_2776377696328209035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCoHhXxAyVEQ7kNvwH1Mpre&_nc_oc=AdoacRZFnpACWB0nsQaF4ooh74hko83uXINe6hnTTaQz2Ec7sRrJpQKksfkbgzmtCkQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mSvt34osHhWrxtV1FjYSQUM_5zUTP9iF3sNZj5TM1sQ&oe=69D513B8"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26496614233309129"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620965_1334737095336434_4702420955788064333_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JmikGvgKstYQ7kNvwFLvPqm&_nc_oc=AdrmNchwK_JslJPvUCDEoarYYzJL-3CBL7PwN5UfFkJxGhA-a8-xcdZoARnT-yfWMak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WfxBVuhnahfyTyZBs5sXP2Ahx_I7lerIURvGhclj9oA&oe=69D51402"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Reality Ruler", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1695327336, "lastRevision": {"nodes": [{"id": "6709992632397916", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "6709992609064585", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3692475207649078"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "HER
c_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-saVVMfCsyM6u715Y_WZwcLhGZeeFx2JvWVke4euzLTg&oe=6A3BF9E3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgrfmzD-DJ0Q7kNvwEzKSIW&_nc_oc=Adrd8dviX61F9UtWjjflCcxcDB_ns2iXYxprprW4RaegnBpdUKmC9OL0GZwq1LboTwo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sK87FcpTS3jeUulQin5XPYEO1CO3ADhsMmvIPD9imHw&oe=6A3BD458"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sjm4UJivcOAQ7kNvwHMm1ff&_nc_oc=Adr7-YybM3YgpyUcEXv9LlcNomLPn3o4LQ-hhbOiwdzhcrEMy7IgrLUpW5COYWidFTk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E8qsdU45KShtmS8N_ia6uoEpu50Q9GnHXS-Islv4b7A&oe=6A3BFC72"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdCT7MlqeeAQ7kNvwG4PV5B&_nc_oc=AdoR8H0oEiJPhUiZNCnXDzjoyLYOn8Y2EUfJHgDQDLY8EkOGlLSEpnIndvIUfDBa-58&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U8cT7tV2HWsB_cWVU4cXhlpbmpf3bSlf7VKTdrWOzWg&oe=6A3BF233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ATmW9smkrkQ7kNvwHEiAyI&_nc_oc=AdqmGfI31fjEo8Y3vPIIJ8_uUgqd1yNpHui1JehT_nZVlYMHdzQDOd6WzI64K-etWME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U9FItt4X6aE8jBcr_vuv498HvI-vX0M_pHfjHzYeP2g&oe=6A3BF417"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
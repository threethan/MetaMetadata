iad3-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYoRgc2fTqsQ7kNvwE6NMzd&_nc_oc=AdmMk-R6mobFPsMXWXUkAa6R9YhWP5fsvfyKPaqhDSWqcuTdmkYD0GiROJuBS2OrJuE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfumSMHMdg4qvTba8YZDw5BDEgNYipStKQ9SF5krdw4MOQ&oe=69A6DAD8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAVooE9jO-wQ7kNvwE9Moa-&_nc_oc=AdkehNngSXKdd34yC8ZnbyTB_vMKD7RycBxVuCMKyP0MXLo5b8CTBny1GsBuONDXgVA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afutx5LfITEQtpfJq7utoZeHAKn9dtUs6-nWwXvddE4sJw&oe=69A6CAB2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZhswkBhJIMQ7kNvwHm-Ggw&_nc_oc=Adlkgxm7A6WsV_zmepY1NsK3HaBi84AR0R0EWGJiFrYYz68YHI6mLBTBG8lrAi2MQw8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuGi2veudIgXOgdob4zF9eNNPfA8YUbdXL18ZoINBE2ug&oe=69A6C073"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 1 (2).png", "id": "1209147267463743", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618277_1209147270797076_2776377696328209035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MgBsnuQU3YQ7kNvwHLMAoh&_nc_oc=Adkd8b-UMbG6ZdAVEAXn80x_uf7GDk1O57RgmeOabOlSSfhG491FIzMSNtrU59-8_Ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuWKbMrGQX1E8pf4AjE3wx0rbH5FtfY0lzBI4nQP4DRWQ&oe=69A6EF38"}, "display_name": "Reality Ruler", "keywords": ["TapeMeasure", "MeasureDistance", "LevelTool", "HeightMeasure", "ConstructionTool"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "10635849107667
_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44Qm45hrojfKUUDvyqf-KookiXyHc-lEv6tf3nEIex7Q&oe=6A11C9E3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq_F4YIEingQ7kNvwF18z5Z&_nc_oc=AdowM-uj_8g9WabkHVjMKKMq_fd8ejZS_K5yw4Gw7hGT9LRd7BJ4-CGmg9ywwkbaZFA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WeisKvf5TINEJVEK4GJWKrxS5A_BTfWO6lb70wivzxw&oe=6A11A458"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOHqCXC58ZAQ7kNvwHumDcx&_nc_oc=AdruanjqlUVKXuB5oz8GrnJ1OeUuGyK90PhgsMkhqqeNA034kouCQj5MHAwX_Rz41h8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CCgpYxo15paSUQ6hMDYhBOb64NtV2404DL4oQCN9PjA&oe=6A11CC72"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDT5J7F7sJQQ7kNvwGAATw9&_nc_oc=Adon_9G0BULRVr9wutB7RqA4ntNAnkTefXNrp_VPgeSK_MnNtueH2nOq8YI5p9A8v3c&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4D7as9h2b2CRTgnGYRSM3zWJNzZpoUjazbizcvRv7Iuw&oe=6A11C233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ypNhjA8y6YQ7kNvwEL3a1x&_nc_oc=Adox1bNeJnFy5ZhvAAk9Zh1cESNPA5Rd7P4Ni6NAutX-S2QneJO5B9aiPCD_4BD5FgQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SEqiosLU7m3jcRuLkrFhQwaFfu-qVamwMXMbr8tNLFA&oe=6A11C417"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "
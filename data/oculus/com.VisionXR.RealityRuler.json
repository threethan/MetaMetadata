c_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qQ8vaX1kx9PMn0tlFIZTmrliT2E36vXirzuCOKC3l4g&oe=6A131B63"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cq_F4YIEingQ7kNvwEDso5Z&_nc_oc=AdqZACcupss7UWQVj5d7KBwzNv38UwNLhBroPmHbBngKOoptAJYh_bxpeix3CM79XLs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WvbySPban6-lmV6XQ2BGvokprqru5Tkf_VCqDW4Kt2w&oe=6A12F5D8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w88iItAVPxUQ7kNvwFQX8TT&_nc_oc=AdphRWeZkxCq5w0-fhYu8UdmM2UBpoNq2U6thqDukwZoIRdfNyaiD_MN0kMu9ru2JVU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ct8GUBBQWSdV-06KxjYoVZUxRmEvHsMNJ7a0bTcS1nw&oe=6A131DF2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDT5J7F7sJQQ7kNvwHqHUeF&_nc_oc=Ado9DDmql_QQYlLd_ZIn87Im20iruRH-bYULsmSNzNyzeIsdGWmZnwJ8pkzMNcM9aiY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BiBIDsCSdMcIvHMeXsKdKmElDSVcx8Tqw2NQNXerujQ&oe=6A1313B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ypNhjA8y6YQ7kNvwHAGrCZ&_nc_oc=AdpnLgCltRx_siVh3bHG3_wrkWJyTSR66mc2_K8nb24RNh_WSTQsb8y9Z832dClf3_Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FeUvrBN8rPACbA3Y4Ju9Qm5QK91CQm0PWWCx-tnhhyw&oe=6A131597"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
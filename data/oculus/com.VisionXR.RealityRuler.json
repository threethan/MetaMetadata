c_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7o5FAcAZ8A3jq-IRBtGRwDmZegAwArVa6Eyt1Cxo8mvQ&oe=6A146CE3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKxcu7P6wvIQ7kNvwFtSYZE&_nc_oc=Adr6p0YM1ew2cbQQKxGg5w1AwpchxmtgjWnoBfTBHClh8BW8W1XhA_iR1A9PLz3nJk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GFRTBlfFOYK1EMk2ebAYmfz-BolVPa7GnIZLCHogH5A&oe=6A144758"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w88iItAVPxUQ7kNvwEEryrZ&_nc_oc=AdrOhVbTfp5tlVRZ3NHXj5nWnJB2h1R_0w2cAXSzFNCjdIJq3UAMtCs36jeWV5Zyh2g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68VIBQo3oyVp-IMMRFS6D0FG_4jKeI87yO5tHvux0AXg&oe=6A146F72"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDT5J7F7sJQQ7kNvwH4INpN&_nc_oc=AdqLI2alAhj1Ftdk2-bhjmzB4TM5Z1YpBgXS4SThpOZWMTI4oS-Iqu7XQi_SebbYWds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4T2SHd4vY9-NgFEbi3My7duNxHC3SlhXyP9RcNrZkt8A&oe=6A146533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ypNhjA8y6YQ7kNvwGZv_Dq&_nc_oc=AdoYYHX8vxioN8W-eQ1VUg4stt6bhTmX36-4VN3ms1KOwjJbV88M37GECqK2RKu-xS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QqMzPy9tSydLbETLmrYeUq2cMTkOvMaelPAXUFENEng&oe=6A146717"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7epAy2sQaOgTHnB6ujJkhcU5EDA3Mc29nd3-72vJvN_w&oe=6A186163"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b9D6StIbHEQ7kNvwFjQpma&_nc_oc=AdqGRpien_3W6KVtlM_DfjcddeNH-CEaJA7F8c7l12Y38t7mW5XmhDfpSN1-BzRr-Xk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CgQ1Qb684nIaf4MzmDGOTvmVqBGQUNyB5sYuES2p73Q&oe=6A183BD8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66oUD68-peEQ7kNvwHDzdlD&_nc_oc=Adreu8KHnFoNJMa0ab2MnrfC3WNmgANe1KCi7S4JhTm_qySAkm9iQoWb3JRQTzgAMDM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wnY2ukcK8z3Pi65IGdUM2p8NK5wveEJ_5vssZtHWX9A&oe=6A1863F2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uyupgz_7jgQ7kNvwE7mGiH&_nc_oc=AdpAPwXhl1bNr5DSkrJAGUwMuevd8MeMChGqb5Jx-3T3vgd-YZEA87jzZwhn1_XVgLE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rQs0aF-GpyHJGYthYuy_xgs5jopgNHpHQXQiKECvplA&oe=6A1859B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbuqsD-vO_8Q7kNvwHzutHY&_nc_oc=AdqnE47vs0k6A31W0d8vrMljj-wEOzQ3xVWkLiuTfeJV02XQJNK49JUyKs-gjNq2gZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45ApXIrzoB295v_-P2LN2yqdebSEnSY_ZD1AMBMWQp6g&oe=6A185B97"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
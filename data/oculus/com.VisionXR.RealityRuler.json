c_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PDm01Wqv4OPc-JI8ezZGoN-EKJJn2xPJODLGnRqlnJg&oe=69ECA7A3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CdwJapuaNEQ7kNvwE3Sw5A&_nc_oc=Ado_WySC_0veL0_ISM0l7UCIQolHY-cdzZhvOXDUcXmTnb-2Hbb76BNp6c1WwbDGpsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gKscYKGE5So7SEvZIGtvX-pWFQmkdWi9JRiDyypuyOQ&oe=69ECBA58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hONMBa7WDoUQ7kNvwGMYO0m&_nc_oc=Adqt8tqwYG8CW5RAlCBNcfsLIZH3ugBEzsbuXL3pLo0UdlcD2Qwe8uBz67H86u53gdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ywiXoKcCfsc7z77cNK4eulu5Xdd3a38VdMLeSLAEAZA&oe=69ECAA32"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1PCWOm7nbgQ7kNvwHfr-Fd&_nc_oc=AdooICc6fO8I9NKASwdwzaoixf3j7Q3l2u6SkNJf-gaHk0LtKwGhKr5_ijDQTCkEx24&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27NDXpYLRPL91uyDarnXEfST5KSegLFIzBT1ScHKkAXA&oe=69ECD833"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADX9G4GKWg4Q7kNvwGwItp3&_nc_oc=Adr4Kxc5PTsIJ8aOqF0ubvG3lhuNsbxgFT5XdrRcUASKdXBcwLi34WnByo3lyWx7Vb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af208gwOrt2xRtlZhdfZ2IDWpC5TEPaOctEVx6PcUIZrfg&oe=69ECA1D7"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
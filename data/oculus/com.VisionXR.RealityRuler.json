c_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lv1Z8YxPOrBMHrtmow5_tOteQ-wjDgXSEK5ZL65NPQw&oe=6A3410E3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A6OswlLplwQ7kNvwGvLHbw&_nc_oc=AdrXHFDCI7DhvMEliYkMsiESThyPJhj4b7pM9AIydtI9XuIr_YVaTHUXk36eEAePdVo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oDARmsvYqt2nZ5zCF-aS079gvW1LG3EQyYgBIhrtdzw&oe=6A33EB58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I18eYG2hJg4Q7kNvwE3nh2t&_nc_oc=AdomPi5P1-OTLToaF_bdkVKYRhNhN-snt9LZvfxPqoWWZu2xEgK86Z2wyu887sJP1NU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E_lFuCuNLdmBsM1TPyaNHtxQNbj8G2OLppYTyWf_DmQ&oe=6A341372"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jV9A0EoHRccQ7kNvwFvwXdb&_nc_oc=AdpZtJ8F7f00XaQTuA6sReHObMJjtzBOCOH-WKCXN2KXm8-4Egqxo1hEZ0P2nVuWg8A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88tlku_MTFwYg5WYbiFUhsKWuFY8Vxw1lvo5l7oPS0VQ&oe=6A340933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DOtfa15ueoQ7kNvwHm0ONK&_nc_oc=AdoJXyMeqEKC4aG_UaeN7e6J13zgitVGiVErtWH-OMoSgEDfa69NHDkOJRIp7U2RM-g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-P-ELZfYXaBp2hKPnC_0RKX2ULtwkJ00gNK6trZM-9HQ&oe=6A340B17"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
c_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MMJ69glcQkFJPoFIOkyP75SbmoG3feEzlNzAOhsYTJw&oe=6A283363"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACCZrz0LSn4Q7kNvwEQPXHj&_nc_oc=AdqxhpbWiIYYgdXSnk8_hmQNQ_Mp26zSbEdEcRERkFXd2XLWPOked-jYnjLWucIPe-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zsmrsJEraB1dZC3AQfQ_hzIQDuu_D5m6wtkK5yGZZVg&oe=6A280DD8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4jF9OGRjPkQ7kNvwHsBsnH&_nc_oc=Adp13yxdoQg2HPY9AbAOodrQLtJCTmCbECJkzZXzuhPWWI9e_KfQRE7xI7fiUNLeI7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w5Dkcr7DUU4eqOt2Pavih8wiw-7Q2ughVaVw_5gbnaA&oe=6A2835F2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJmeoWj6I_cQ7kNvwFIyrx8&_nc_oc=AdqnvikBtopf_fFkfYU7eko1Zja6WX6y20lWDgjUWcN1VCVbOm3SaAvr8vc0_WBnN7o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u1GTA-Qxb1Fn8zNm3-shx__san-CF2-YDWgkOy12P8A&oe=6A282BB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2q9reHKuvTYQ7kNvwEXkOuU&_nc_oc=AdqS5QBpaNYQln16iH2WksgaTIHVk7sg0VC5T_7u2DODfEQCV-7IgOFfaUWFXxBwoFY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NfV9xEXtTNzamLPLs2GbQhNLyzr-EQ92ifhKgSrJ2ew&oe=6A282D97"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
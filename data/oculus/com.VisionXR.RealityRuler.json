tMHww&oe=69F09C23"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg4ag7SejfUQ7kNvwGtXgOt&_nc_oc=AdrTfYWy2vQebxj-SdCNcwLQCWmRzvAHV--lsL0L0ux8gh252escD5T2dSuchoftSKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af237DvBnH9szq_eXg6AcbBpvs_LQRtTBWDpOP1uVWLb_Q&oe=69F0AED8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hr2mLuwhLx0Q7kNvwFgXDEu&_nc_oc=Adq0eUz5B_WqgRaNDJU22LjsXI9qLbIY3IWF-AF4skUU_Vz1Xgv5odk8AjBPaV7WgaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0gPO9NM2Owvb6yGRWMWsfNYOFQF1Gtx441JEzOudx4qw&oe=69F09EB2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0TocrwB8LsQ7kNvwGBoyCh&_nc_oc=AdpnTQ-vXuolQeowufSkuBCszGTIi2GfgYd8AcUfxFxtc356wZqNzox7fbh-p9NfiVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1Kq4erOxyUzmbqKamrH4nxGr8mJYkca1rIhw30KnMxAg&oe=69F0CCB3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41rgUftWhB4Q7kNvwEDVhBl&_nc_oc=AdoDAu2E5_dRcIqQaAnOUr5t9YYNKPG5DZooltWVr5l2Qjh1dGdcYi1AYJcLpB_GMZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1E2BHmIDCO0kwg33Xyd4tvj_8hwFcWmtbIG9hgt1piEQ&oe=69F0CE97"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "con
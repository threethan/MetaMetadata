c_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53wpmRTefcgyrp9qfDz18eR4xLFVOG-zGauljuGIaQYQ&oe=6A0C83E3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MMOaS59y1wQ7kNvwFF3qda&_nc_oc=AdpDSYQKZpzMHMEkuqIicO93WV-XdCj3Xv2imq-dVbHybq5iqsnio01Xr5qwRXOL8tY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74fxpRo9SKj8-HfXhQAZPNbw47l0bq_yOK0OBHYMzcyg&oe=6A0C5E58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQRnIbvqWI4Q7kNvwGGyZH_&_nc_oc=Adrm51xOp6Zx-MYl20g2hsQlS2OBHikaESWtZXELplkgfk35ug4LV39l5wXwGrAfX30&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tdL_bIUr1X_an7dHGyyaRabqOMnqiwEqNwsxe9HR58A&oe=6A0C8672"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRAyHkfTp6YQ7kNvwHRRga7&_nc_oc=AdqgHmv9-Ztxhx5tugY7cpmkt5mZgdung7PPo_mcUkNIL2feUqql2WANcxNscFkjYZo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Nm_jMYveNdwRjWJ7GKh9KpJF-Pif4hGPznrtQOEPbQQ&oe=6A0C7C33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFm5TE1PL4cQ7kNvwFz3S8_&_nc_oc=AdquCz1LnJSDUgx2obSXQaTNXhCYPfDWX6k5Xma8D94hE0ynVp4U1WF01my6M-J_THU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zfm4QZv-bsv5dmobJyIWUp5rEz2FzljVP6jd_7y-ZJA&oe=6A0C7E17"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLAwD8xVKNMQ7kNvwHWGVdz&_nc_oc=AdqBvHvfbDisNZbVHWCpzSL3nOjZwl0Tkv2dh-UGo1N6flIsjCprZk2HVe3PxdpDxj4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyohZGL0NtQz9J0ZlbrxrHqteLzPX9BoKvFDLCdOvmLmA&oe=69CA7358"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMtQlyJBvQIQ7kNvwGf5lLI&_nc_oc=AdpZboOucIqFltTo3nBzTp_FNp5Esg3MMot3cJbC6VyjLyN96OzX4alusPnmjY6KpEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYj3iym3AOkeqKmG0OscKkvmqu71JRzRwD8Hvwi7bCRA&oe=69CA6332"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8oNT30ShWIQ7kNvwHPNsU1&_nc_oc=AdpR9otcZ44dPn9ECxVSA83ExGdr_qHhM9rl0U5hzaQ_NLdE-_RZEfPMKHTLetJWy6w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEM46TeekaKkF8IFYGFLULmc6Up8b8g1nOUYs6y5udmA&oe=69CA58F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 1 (2).png", "id": "1209147267463743", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618277_1209147270797076_2776377696328209035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPW9_3gQmCUQ7kNvwEQD5Jm&_nc_oc=AdpSuPvJjW7V5106_67yu1oadifcu_UgDmexwX9NlCazPV-Fc1hmZhTWzL3fF2OQ0ZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwiUleQnxEAldHQrXwfwyuJjFgsZYqMaRaASOvaGAbx0A&oe=69CA87B8"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362
uluscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tfsY6IAEloQ7kNvwE-B0AP&_nc_oc=Adno-vM_zwlUQqkETxrvZIlVINhL7wSilFJGVsIE5b9UftYWir3zwdtSPUO_J0kq1Z0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftriP8k4C0fVi_TFq73mAnpB2fCWSNbl-K4QqsXnltRDw&oe=699C4ED8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiglkBnCSL4Q7kNvwHHI1O4&_nc_oc=Admg0w1FdmA3OkbzF6TThBSlJ9mpbaooKyk6_l3DcVe_0Sr4NhR5sKYC6OeihePbLLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfscvVoiOXi9eqrg2r_AY1vCHUmu6WfFQr2betDhIfxG8Q&oe=699C3EB2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiZBVb8-cPoQ7kNvwGX3Dff&_nc_oc=AdmfXjkpP9_cKjmdg3fTaRaTbs9A0XC6LZU2upxTwzUy_faxTkJTcMy7apBMO6vP8M4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsUAyFw1kK7jUMLQV7xKJREcuWHhG3G9i_MjtTJKzDnGQ&oe=699C3473"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 1 (2).png", "id": "1209147267463743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618277_1209147270797076_2776377696328209035_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKzNbQiqKTIQ7kNvwHpJ9n7&_nc_oc=Adn9oAfrrmVqs0OJAxDTjCrKuRX1lhBmjzH_bSiQWMvqKmwAT6zMz5M_ndLCFf8M83Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu4d7K4LBvBw5D26v6HRRnSzVh3YypaUqO2rFAx3BtqvA&oe=699C6338"}, "display_name": "Reality Ruler", "keywords": ["TapeMeasure", "MeasureDistance", "LevelTool", "HeightMeasure", "ConstructionTool"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "e
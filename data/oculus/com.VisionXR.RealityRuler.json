c_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ly80loQR4gvFWRQA8mNm4NWuu_WCbssDmgYanXU34nA&oe=6A09E0E3"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRIgAY2f1dwQ7kNvwHvjqUK&_nc_oc=AdqAwoMxa4vDMN0hkP0qLikGP0p1wGjHcwwdVdv63QWsbl7blHi3F7zn5aaioVMQHgk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Pkj_zWVzX0z8-Ji1abThY1w9o4WMAzG1736xMsmhAww&oe=6A09BB58"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pa94EDD1P8Q7kNvwH2cKGk&_nc_oc=AdoskAEzOZ-klRkdMRQKBq0e-_qNKTc3GEOTG6iN_N1aLKimzNpw8xV6oJ-4mQIPHCM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EAM9MbqghsdYlelQ9DlhwmjFvsKODbq1umdxv_g2tPQ&oe=6A09E372"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRAyHkfTp6YQ7kNvwFD4but&_nc_oc=AdqIV4GFBr4GpwYqE9pdR7xSJrBB7wuUcXC62PipspPieSlNrcX9XPvZx8618do5eag&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cENwuESLqB8GHXQG57rcX0h-mzQkO_Uje2lmoSE6kpQ&oe=6A09D933"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFm5TE1PL4cQ7kNvwFWpUTw&_nc_oc=Adojtba7skQbrW8WBTsdd-Qzl9AegfYNqpEj0tv6MjKm7JTSkIPWkg7GoIqX3PdodYI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UgCHvpilLrJchiBPC7nkyVOoUJDw5hauy0pg64dkynw&oe=6A09DB17"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
c_sid=6e7a0a&_nc_ohc=c7bk7_N5r30Q7kNvwGunkya&_nc_oc=AdoQe_JN904hEWiHspnBro3Zx_3SPoE55wDRq7j9Hin4rn3rL3potKdYuLtc_1cgD8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4eWgEodCGTG94NSQnKSWUEJKq9c77DB9Sg7zvEaflTg&oe=69CA6052"}, {"file_name": "NewShot3.png", "id": "1366530480603931", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974626_1366530483937264_1924810608918139604_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orVERubXdIsQ7kNvwFM1YPa&_nc_oc=Adpottg1n2fWJG8a8vLGlV-vcMFHFti1sjxKZ08qvv_R75sk0PBTrej5673-uBTABB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzubAw2glzR5u8ksrH8MI8_hB9k65YHqnyE8cZvGP4dA&oe=69CA63EE"}, {"file_name": "NewShot4.png", "id": "844139123700908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031511_844139127034241_8895982602953104589_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGY8M--6dQ0Q7kNvwF8xpg0&_nc_oc=AdqzRNdUZPjy9yK2UsktBQWN9K0hM9YZgQQl5MnHL5J8WZh8zs2oC2DlH8X6dfBDEbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9bscDG6ETCqnVbFxTJkNtaIF8AF0oRkAGHwFAPGTKhA&oe=69CA7710"}, {"file_name": "Shot6.png", "id": "859119038903659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75441578_859119042236992_2407781003869184537_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMxH7RRFBKYQ7kNvwE9B9Ek&_nc_oc=AdogAcT3TiGo8-gw-KscO6WIQDzMC3x45ccqH0ZEZGaH-vBJw-Z2XERiof1z3ogOwfs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMfCX-ZZSo7s7_Ky5c5uesdRq0UnRyxOxrVF0kIavkIg&oe=69CA7F66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2560x1440.png", "id": "3446365605583986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974482_3446365608917319_4837108019305750600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGqIYCtnjL4Q7kNvwEsJD5D&_nc_oc=Adqdzoa2XoVWzzoVifKyAT9iKba_37Bnw7qwFbl3qkPVXyC8EFU8a0bpTBDvLYTxrGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwfWzCw3rXIlTNaJms_qDIDARjI41og8rnbdcyTw24c2Q&oe=69CA7E0F"}, "display_name": "Reality Ruler", "keywords": [], "long_description": "Unlock the power of spatial understanding with Reality Ruler: 3D Measurement in MR! Our app utilizes the device's pass-through mode to turn your environment into a digital workspace for measurement.\n\nFeatures:\n\nMeasure Line Lengths: Draw lines in real space and get their lengths instantly.\nArea Calculations: Evaluate the area of polygons, rectangles, and circles with simple gestures.\nAngles: Get precise angles between intersecting lines in 3D space.\nVolumetrics: Estimate the volume of 3D shapes like cuboids, cylinders, cones, and spheres.\nReality Ruler offers an intuitive interface and simple controls, making it easy for anyone to get started. Whether you're a student learning geometry, a carpenter planning a project, or simply someone who wants to better understand the space around them, Reality Ruler provides an accurate and interactive way to measure the world.\n\nTurn your Headset into a powerful measurement tool with Reality Ruler: 3D Measurement in MR.", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "https://www.visionxr.co.in/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
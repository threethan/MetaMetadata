c_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t5YqelR6gKcHZzKVmwFfoR6RvxmHAFemGDMUg6jCKUw&oe=69DB8423"}, {"file_name": "Rectangle_25601440_resized.png", "id": "1323499598940370", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393518_1323499605607036_2437021613896538716_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcS6Mlo6OS0Q7kNvwFgOIvN&_nc_oc=Adp_yh20t-jxq9CKFoneNQqhOODvc7a3DDOTy8iahqdyLJYfGW8rYgxJ3vGUtMM2MY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3noBt1gAOIks8UDQ6flZe88z5J-wzmIBtglk7HyoKqtw&oe=69DB96D8"}, {"file_name": "Circle_25601440_resized.png", "id": "687420117178366", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_687420120511699_6818722450017424599_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjUwKByqgcAQ7kNvwEDkZr0&_nc_oc=Adqz9yAHEy7rEtXW4rkMpGR5m7iBq11kdfA4820SEgO_NC2ESYEWAOjIGvpjuLwArmk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KPRkD_rEq8WPxU-uzEEUzMP-XBiPaUNBj-ceU0DSZ2Q&oe=69DB86B2"}, {"file_name": "Cuboid_25501440.png", "id": "636624725908821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392057_636624729242154_200520119975287540_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QVl9y-7ee8Q7kNvwGeGvYN&_nc_oc=AdqnxUIxUyG4CZXlbWMo0gnV7wATSQVsDCGu6hwSbfD-YnjCheo2XWIbyva72Loq0dE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kEcLeMwrYRPJcwPJqfqjvqHrl3tgGWarLsmSNpjd02A&oe=69DB7C73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RR2560x1440TrailerCover.png", "id": "929114553236867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_929114556570200_3862557792234253016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VW0jNlg0gIEQ7kNvwFAXRiS&_nc_oc=AdrOtp5leQtq1d4Cv5LaM79CDZe3Jkju0TGoWOAQngHkCrUFknheNViVHAZU34VfaX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N_1-q3R27cR0iaOZxvMtI40d3-UX15ANeBf7Qn36-EQ&oe=69DB7E57"}, "display_name": "Reality Ruler", "keywords": ["Tools", "Area", "Volume", "Length", "Height"], "long_description": "Unlock the potential of spatial comprehension with Reality Ruler: 3D Measurement in Mixed Reality (MR)! Our app harnesses the pass-through mode of your device, transforming your surroundings into a digital workspace for precise measurement.\n\nKey Features:\nMeasure Line Lengths: Sketch lines in real-world space and instantly obtain their lengths.\nArea Calculations: Assess the area of polygons, rectangles, and circles with intuitive gestures.\nAngles: Obtain accurate angles between intersecting lines in three-dimensional space.\nVolumetrics: Estimate the volume of 3D shapes such as cuboids, cylinders, cones, and spheres.\nReality Ruler boasts an intuitive interface and streamlined controls, ensuring accessibility for users of all backgrounds. Whether you're a student mastering geometry, a craftsman planning a project, or simply intrigued by spatial awareness, Reality Ruler offers a precise and interactive means to measure the world around you.\n\nTransform your headset into a sophisticated measurement tool with Reality Ruler: 3D Measurement in MR.\nEnhanced Features:\nSave and Load Measurements: Preserve and retrieve your measurements effortlessly.\nHeight Estimation: Determine the height of objects or rooms with ease.\nCustomization: Personalize line colors and widths to suit your preferences.\nRoom Layout Visualization: Gain insight into room layouts based on measured dimensions.\nImage Upload: \"Import and anchor your own reference images directly into your space.\"\nClock Placement", "short_description": "Measure real-world objects in 3D using your Headset's pass-through mode. Calculate length, area, angles, and volume effortlessly with Reality Ruler."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.visionxr.co.in/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "VisionXR", "support_website_url": null, "website_url": "http
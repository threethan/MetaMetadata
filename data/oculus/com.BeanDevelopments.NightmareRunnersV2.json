20f&oh=00_Af0e8PSUozi6BBsr7nANfQaSHf1MGfnHgtKG0y-idiMYag&oe=69F361B5"}, {"file_name": "Screenshot 2025-04-18 022818.png", "id": "1536509457322266", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499318029_1536509460655599_99549830296692299_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzbkNlU3ObQQ7kNvwEwrD47&_nc_oc=Adrk7IZpplGND6ulPGp0GWnzejRR_b02Tel3dIF5ec3nkLRmEOv1PlK_lYLDxhCIAno&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0iEFGXd3Rcq4lg51GywEcva_zCpZ8t2UG40LUthKQqMg&oe=69F346EF"}, {"file_name": "Screenshot 2025-04-28 032431.png", "id": "610973331959649", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499332239_610973335292982_1222089144372092630_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1DHjG8oJRIQ7kNvwG5LRYf&_nc_oc=Adrh59KGmnbTLer5OYSpZROjjot-Yaz2vjsRT8JUP5IX-eH1fjIr-IlyvZ5aF07Cq-o&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vSVNEi5eGtKrly2Ihs-MxdkC7NS4UOD-2B9BB4Q9LFQ&oe=69F341F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Runners V2", "keywords": [], "long_description": "Nightmare Runners is an immersive VR horror experience that blends fast-paced survival gameplay with spine-chilling psychological horror. Players take on the role of test subjects trapped inside a series of shifting nightmare realms\u2014each one uniquely terrifying, unpredictable, and laced with mind-bending challenges. The goal is simple: run, survive, and escape. But in this world, nothing stays the same for long.\n\nAs you race through grotesque corridors, haunted forests, decaying hospitals, and surreal dreamscapes, you'll encounter horrifying entities that adapt to your fears and behavior. Every level is procedurally generated, ensuring no two runs are ever the same. With a mix of environmental puzzles, reflex-based obstacles, and time-limited sprints, Nightmare Runners keeps your heart pounding and your instincts sharp.\n\nThe VR environment places you directly in the middle of the terror, with immersive audio, reactive visuals, and intense physical movement that blurs the line between game and reality. Whether you're running solo or with others in a multiplayer co-op mode, Nightmare Runners is a relentless test of courage, speed, and sanity. Can you outrun the nightmare\u2026 or will it consume you?", "short_description": "Nightmare Runners is a fast-paced VR horror game where players race through twisted, ever-changing nightmare realms filled with deadly traps, terrifying creatures, and psychological thrills. Outrun your fears, solve cryptic puzzles, and survive the madness\u2014before the nightmare catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nrwtest.netlify.app/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "PastorJeff", "support_website_url": null, "website_url": "https://nrwtest.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23897030709903413"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "653430724144778"}]}, "baseline_offer": {"id": "653430724144778"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1747767600, "status": "PUBLISHED", "id": "653430724144778"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBin
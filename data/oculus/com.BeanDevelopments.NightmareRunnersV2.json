64.5771-25/491827720_692946993658138_5250431617820668720_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czrSj1Mo_7gQ7kNvwGpJm-i&_nc_oc=Adq6z9C2s8gspSxDX_ueYfZf-CeDPDRIoWWcDMqI3hMY4BdJvCXJLPZBVzdlC_ouOuY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs7RvcRei-m0LGNuU8UbsdgHKiLlU-xy5hlBwolqZnQA&oe=6AFC5F35"}, {"file_name": "Screenshot 2025-04-18 022818.png", "id": "1536509457322266", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499318029_1536509460655599_99549830296692299_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMP1iBQWAd8Q7kNvwHRxuvb&_nc_oc=AdogCNDGAILNyww5COhdEGaH42ZK69aMlZoxNf2SRfWmBIFJiHg_spRU2jOO_nYuDMs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxEe3Ld64ZnTF1jlfu45aIwpaBgBd4mWw7yz1zC0edrg&oe=6AFC7CAF"}, {"file_name": "Screenshot 2025-04-28 032431.png", "id": "610973331959649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499332239_610973335292982_1222089144372092630_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RnE3KXvWFc0Q7kNvwEgTNit&_nc_oc=Adq1u_jYxkybJrmzYZtYLQdk4RKis71FiaYIcFkhka3HPgt8SvlcqfTK1lUEoJ-9UE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTvfnHJNxxOkmFT9xXb_ISErq6JC64xYCpQjQhArFzdg&oe=6AFC77B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Runners V2", "keywords": [], "long_description": "Nightmare Runners is an immersive VR horror experience that blends fast-paced survival gameplay with spine-chilling psychological horror. Players take on the role of test subjects trapped inside a series of shifting nightmare realms\u2014each one uniquely terrifying, unpredictable, and laced with mind-bending challenges. The goal is simple: run, survive, and escape. But in this world, nothing stays the same for long.\n\nAs you race through grotesque corridors, haunted forests, decaying hospitals, and surreal dreamscapes, you'll encounter horrifying entities that adapt to your fears and behavior. Every level is procedurally generated, ensuring no two runs are ever the same. With a mix of environmental puzzles, reflex-based obstacles, and time-limited sprints, Nightmare Runners keeps your heart pounding and your instincts sharp.\n\nThe VR environment places you directly in the middle of the terror, with immersive audio, reactive visuals, and intense physical movement that blurs the line between game and reality. Whether you're running solo or with others in a multiplayer co-op mode, Nightmare Runners is a relentless test of courage, speed, and sanity. Can you outrun the nightmare\u2026 or will it consume you?", "short_description": "Nightmare Runners is a fast-paced VR horror game where players race through twisted, ever-changing nightmare realms filled with deadly traps, terrifying creatures, and psychological thrills. Outrun your fears, solve cryptic puzzles, and survive the madness\u2014before the nightmare catches you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nrwtest.netlify.app/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "PastorJeff", "support_website_url": null, "website_url": "https://nrwtest.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23897030709903413"}}]}, "sched
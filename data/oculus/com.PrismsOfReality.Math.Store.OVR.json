7379957138_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0FTTUQcFgIQ7kNvwHkPemx&_nc_oc=AdmUNLlpBjLWRNXWpKLZ0TML-u2PAKpZucD0TpZQS7tfFL2nX2O5rflDL6-x678ETVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSGjAoe464lqYKU0AZ_5vYW-t8dWNp8NzICmfBAwm16w&oe=69999CFB"}, {"file_name": "Screenshot_111_0112.png", "id": "1555039864978646", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575345_1555039868311979_8068287438231022586_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSN3_l46nf0Q7kNvwHnYDJR&_nc_oc=AdkjHW40BN_QBFsriOj1djcCF1N7CU6-GQ3ezECBOyaHBGl1I_3WE__TM3wAmQkKUF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuQl_BvV4_V_K1J8GOv0Y4jrbiZYiI89l7nMG05oRSZxQ&oe=6999AA08"}, {"file_name": "Screenshot_115_0004.png", "id": "527239276013953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982646_527239279347286_2694137245070852123_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQn6QhIlXaEQ7kNvwGbV7uO&_nc_oc=AdmdUyTCQXu0wGzY47mYVKTyWIFgc5ALRZb3H-X7-qLVjw5AAxvEEPMlCgjclmxOGFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviXR7iy_MylGAXHn9QD2FOotRuYO6VM0H6RnhjjNLoZw&oe=6999BA7A"}, {"file_name": "Screenshot_122_0031.png", "id": "740462383654032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031552_740462386987365_1301336221184347163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GazL_Gjwu0sQ7kNvwGxWXJm&_nc_oc=AdlDzyDn8tdSVh-URQs8CQCk8WSD9uvwGm8h3Kb5PvGni91hui-Z2dqH3P52MGYs2t8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsc-qQ3Ud2-A0cOKXekxn1LbVa5KxK1R2BUBs0EQmiUxA&oe=699993F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "834576684239190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_834576687572523_7298418642927853590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSx86dJPQL0Q7kNvwHxKzOU&_nc_oc=AdmiDzkm7K_X6Yj30gpLHaQCH0lJ-DbgDStdSC1ZP9Z4WYu0mCwSwsIl8Hftl9Ftukw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfurK4meNrhHpiGPZhCGhoGS8n3cofW8fb79jf_VJ4aS2g&oe=69998E0D"}, "display_name": "Prisms Math", "keywords": ["Education", "Math", "STEM", "Learning", "Science"], "long_description": "Prisms launched to schools around the US in 2021 to bring problem-driven, tactile and visual learning to the Math classroom. Our teachers and students were the first to learn math in a whole new way, and now anyone in the world can too! In Prisms, users gain math skills through:\n\nExperiencing and solving an important real-world problem \nUsing hands-on models to visualize and interact with structure \nConnecting 3D experiences to abstract representations like graphs, tables (2D) and equations / vocabulary (1D) \n\nPrisms has 3 key components:\n\nVR content modules for students to deepen their understanding of core concepts\nA multiplayer sandbox where tutors and students collaborate on additional practice problems to gain fluency\nTeaching materials and a web-based dashboard to support efficacious learning. If you\u2019re a tutor, parent, or district leader, contact us at partnerships@prismsvr.com to gain access to these resources. \n\nTopics:\n\nMiddle School - Fractions; Ratios; Rate of Change; Probability; Surface Area\n\nAlgebra I- Linear Functions; System of Equations; Quadratics; Linear Regression; Exponential Functions\n\nGeometry - Transformations; Distance Formula; Trig Ratios; Equations of Circles; Solids of Rotation\n\nAdvanced Algebra- Periodic Functions; Complex Numbers; Polar Coordinates; Vector Addition; Ellipses; Matrices\n\nAfter completing our modules, you can jump into our multiplayer sandbox for practice. We\u2019ve started with Middle School and Algebra for now!", "short_description": "Prisms is a new world spatial learning platform that enables learners to grasp abstract math concepts in a delightful, meaningful, and efficacious way. In Prisms\u2019 learning modules, students gain a deeper understanding of important (and fun!) problems in our world today, while accelerating proficiencies in core concepts across Middle School Math, Geometry, and Algebra I/II courses. Your students will never ask the question again: how is math applicable to my life?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.prismsvr.com/privacy", "developer_terms_of_service_url": "https://www.prismsvr.com/terms-of-service", "publisher_name": "Prisms of Reality", "support_website_url": null, "website_url": "http://www.prismsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "723404805889981"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9296679667012597", "version": "2023.0206.2010#751"}, "id": "2339462372870328", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8875714305775804", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9296679667012597"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date"
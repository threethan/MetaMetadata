d": "834576684239190", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036641_834576687572523_7298418642927853590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXznQdz0w-AQ7kNvwE6h1hc&_nc_oc=AdqRrUrCA_cx_4UdY09MlKn1iJuAVxg7d5VwGcoJ_tz3dEzUw39pGV8oC_ElzcFIe24&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wXcNB3iKKnr_VCN0cZvuHuo2kRnaB9Zhn-HbvsizLag&oe=6A033E4D"}, "display_name": "Prisms Math", "keywords": ["Education", "Math", "STEM", "Learning", "Science"], "long_description": "Prisms launched to schools around the US in 2021 to bring problem-driven, tactile and visual learning to the Math classroom. Our teachers and students were the first to learn math in a whole new way, and now anyone in the world can too! In Prisms, users gain math skills through:\n\nExperiencing and solving an important real-world problem \nUsing hands-on models to visualize and interact with structure \nConnecting 3D experiences to abstract representations like graphs, tables (2D) and equations / vocabulary (1D) \n\nPrisms has 3 key components:\n\nVR content modules for students to deepen their understanding of core concepts\nA multiplayer sandbox where tutors and students collaborate on additional practice problems to gain fluency\nTeaching materials and a web-based dashboard to support efficacious learning. If you\u2019re a tutor, parent, or district leader, contact us at partnerships@prismsvr.com to gain access to these resources. \n\nTopics:\n\nMiddle School - Fractions; Ratios; Rate of Change; Probability; Surface Area\n\nAlgebra I- Linear Functions; System of Equations; Quadratics; Linear Regression; Exponential Functions\n\nGeometry - Transformations; Distance Formula; Trig Ratios; Equations of Circles; Solids of Rotation\n\nAdvanced Algebra- Periodic Functions; Complex Numbers; Polar Coordinates; Vector Addition; Ellipses; Matrices\n\nAfter completing our modules, you can jump into our multiplayer sandbox for practice. We\u2019ve started with Middle School and Algebra for now!", "short_description": "Prisms is a new world spatial learning platform that enables learners to grasp abstract math concepts in a delightful, meaningful, and efficacious way. In Prisms\u2019 learning modules, students gain a deeper understanding of important (and fun!) problems in our world today, while accelerating proficiencies in core concepts across Middle School Math, Geometry, and Algebra I/II courses. Your students will never ask the question again: how is math applicable to my life?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.prismsvr.com/privacy", "developer_terms_of_service_url": "https://www.prismsvr.com/terms-of-service", "publisher_name": "Prisms of Reality", "support_website_url": null, "website_url": "http://www.prismsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "723404805889981"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9296679667012597", "version": "2023.0206.2010#751"}, "id": "2339462372870328", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__ty
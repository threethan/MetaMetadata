624_3224002517379957138_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNksU0hBJlMQ7kNvwFMQKDK&_nc_oc=AdqkubzBTciTNQizkEkwK500Q3ul198Eey9XbFZUp_tepkCURwrvLtErarhKqXB_z1k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjZ8Rae1TjH2Qr-NQLg75k2DpiRTHzCnsBnIHuoMPVdA&oe=6B0B317B"}, {"file_name": "Screenshot_111_0112.png", "id": "1555039864978646", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575345_1555039868311979_8068287438231022586_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSC28GFz2psQ7kNvwFXxzcx&_nc_oc=AdoOARtvjNWBcC5LaYBW6c-F4IcJazvLgLXk4zrkD1k2izemlLu2wxtodhqxWbXiirU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSfsAkhMGCcZG_Yc2eYCUaghqP8RBGrNN9oPQT1uY-zgQ&oe=6B0B3E88"}, {"file_name": "Screenshot_115_0004.png", "id": "527239276013953", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982646_527239279347286_2694137245070852123_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSGL7bTjA2gQ7kNvwFRzwza&_nc_oc=AdpjATZnNgllsx3NtdTo2Ck81GD3W1p7dRaNbJ0kdtKC_A88i4jfN-TdJfQZ4CbSMTI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcdJ9nCkGFORoBBDSJXXSp1IA7RMA5TKypVWWI2v0rWw&oe=6B0B16BA"}, {"file_name": "Screenshot_122_0031.png", "id": "740462383654032", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031552_740462386987365_1301336221184347163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptqzgg0HCfUQ7kNvwHeV77e&_nc_oc=AdpJeZCCQNlfXDog7oisplqTF16KySLRrj_ia2BlrmMWsBT3F8R5hYvu26e_Dib6aqg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSOs4zKzEy07ZcbSFp-eA9EC3L234sOWncIsxoPEjIdOw&oe=6B0B2873"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "834576684239190", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036641_834576687572523_7298418642927853590_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aF98fFsoqgQ7kNvwFr4a6w&_nc_oc=Adp4ccrbWfNDMXN7-_JkV_iEnaeBBz9sTBk5Bj_NQ-63Dqs7OKA09cqGs91x1hY32fQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTQNP5J8t-6fezI9xcRkb1p0NEy7Fo7pP5iA8tOO7owSQ&oe=6B0B228D"}, "display_name": "Prisms Math", "keywords": ["Education", "Math", "STEM", "Learning", "Science"], "long_description": "** SUBSCRIPTION REQUIRED (US $23.99/year)**\n\nPrisms launched to schools around the US in 2021 to bring problem-driven, tactile, and visual learning to the Math classroom. Our teachers and students were the first to learn math in a whole new way, and now anyone in the world can too! In Prisms, users gain math skills through:\n\n- Experiencing and solving important real-world problems\n- Using hands-on models to visualize and interact with structure\n- Connecting 3D experiences to abstract representations like graphs, tables (2D), and equations / vocabulary (1D)\n\nPrisms has 3 key components:\n\n- VR content modules for students to deepen their understanding of core concepts\n- A multiplayer sandbox for additional practice problems\n- Teaching materials to support efficacious learning. Contact us at partnerships@prismsvr.com to gain access to these resources. A web-based dashboard is also available for our school district partners.\n\nTopics:\n\nMiddle School- Fractions; Ratios; Rate of Change; Probability; Surface Area\n\nAlgebra I- Linear Functions; Systems of Equations; Quadratics; Linear Regression; Exponential Functions\n\nGeometry- Transformations; Distance Formula; Trig Ratios; Circles; Solids of Rotation\n\nAdvanced Algebra- Periodic Functions; Complex Numbers; Polar Coordinates; Vector Addition; Ellipses; Matrices\n\nAfter completing modules, you can jump into our multiplayer sandbox for practice. We\u2019ve started with Middle School and Algebra for now!\n\n*For ages 13 and up", "short_description": "Prisms is a new world spatial learning platform that enables learners to grasp abstract math concepts in a delightful, meaningful, and efficacious way. In Prisms\u2019 learning modules, students gain a deeper understanding of important (and fun!) problems in our world today, while accelerating proficiencies in core concepts across Middle School Math, Geometry, and Algebra I/II courses. Your students will never ask the question again: how is math applicable to my life? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.prismsvr.com/privacy", "developer_terms_of_service_url": "https://www.prismsvr.com/terms-of-service", "publisher_name": "Prisms of Reality", "support_website_url": null, "website_url": "http://www.prismsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1054780821987681"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572930_695553005558615_5763086723276920487_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-pMLQevKt8Q7kNvwHx5ref&_nc_oc=AdrseBxzJC8et04EueT06JS11UxDrBKWxkgnsreceGp8AIYHx1nxF3IdgVbHlFznekU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ__CPdKRVsRyBrETEaC9FzRlpo9MjlJof2DMI_ca17Gw&oe=6B0B286F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Prisms Math
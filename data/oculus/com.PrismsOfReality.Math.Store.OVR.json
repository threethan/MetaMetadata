uscdn.com&_nc_ss=7f20f&oh=00_AQB2S9R4MrV4fedpFLJGQZMSAc0h3oRBCMF6N_UNUfwfcQ&oe=6A6746FB"}, {"file_name": "Screenshot_111_0112.png", "id": "1555039864978646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575345_1555039868311979_8068287438231022586_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPHNjyBQsxgQ7kNvwF712GR&_nc_oc=AdqM3qB5LwaRW2tKj55TvevVvgaCSduTGV3uOp7P9K8lzLQc9ydUnTcJLZ94lYJDO8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7t5ytyHyloYU9q9D6kwZ_fEffRtlkKvV8QzavfkjgMg&oe=6A675408"}, {"file_name": "Screenshot_115_0004.png", "id": "527239276013953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982646_527239279347286_2694137245070852123_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fkArYvVFOIQ7kNvwEmLtYV&_nc_oc=Adrp5xX5Mf8b2tFWDhUBA6TS3gOaL22ecUWSiU3onEe4vqNt1uGo2UHdahe0Epwv3SM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKFnM5b8hB_rywdawFOC1EvL_pPrF7ESNxvfNR08mLOg&oe=6A67647A"}, {"file_name": "Screenshot_122_0031.png", "id": "740462383654032", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031552_740462386987365_1301336221184347163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTcNua5OldgQ7kNvwEMm-MW&_nc_oc=Adqv0VVku_pBCbH4yx6E7HYVk-cYRksvjl_7o6Mxb-okDsbrH96NIcU34GTFlY6NuHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM0ByS7Uvi0dTwtQNCOKOp4zpASZwnVGvfS4dHQYDqyQ&oe=6A677633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "834576684239190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_834576687572523_7298418642927853590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4Q_Iqu_k54Q7kNvwGS6vAF&_nc_oc=Adp9z96ZWBH_3N20ghro_BtAK3bZ2766OOFPcOJ4h-m4wS6vuuk6TSZNd230AbZxM-w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzWjjFjJgC0glbDIoVY2ZdUpJvtdTi60HV64ZSlW5A0g&oe=6A67704D"}, "display_name": "Prisms Math", "keywords": ["Education", "Math", "STEM", "Learning", "Science"], "long_description": "** SUBSCRIPTION REQUIRED (US $23.99/year)**\n\nPrisms launched to schools around the US in 2021 to bring problem-driven, tactile, and visual learning to the Math classroom. Our teachers and students were the first to learn math in a whole new way, and now anyone in the world can too! In Prisms, users gain math skills through:\n\n- Experiencing and solving important real-world problems\n- Using hands-on models to visualize and interact with structure\n- Connecting 3D experiences to abstract representations like graphs, tables (2D), and equations / vocabulary (1D)\n\nPrisms has 3 key components:\n\n- VR content modules for students to deepen their understanding of core concepts\n- A multiplayer sandbox for additional practice problems\n- Teaching materials to support efficacious learning. Contact us at partnerships@prismsvr.com to gain access to these resources. A web-based dashboard is also available for our school district partners.\n\nTopics:\n\nMiddle School- Fractions; Ratios; Rate of Change; Probability; Surface Area\n\nAlgebra I- Linear Functions; Systems of Equations; Quadratics; Linear Regression; Exponential Functions\n\nGeometry- Transformations; Distance Formula; Trig Ratios; Circles; Solids of Rotation\n\nAdvanced Algebra- Periodic Functions; Complex Numbers; Polar Coordinates; Vector Addition; Ellipses; Matrices\n\nAfter completing modules, you can jump into our multiplayer sandbox for practice. We\u2019ve started with Middle School and Algebra for now!\n\n*For ages 13 and up", "short_description": "Prisms is a new world spatial learning platform that enables learners to grasp abstract math concepts in a delightful, meaningful, and efficacious way. In Prisms\u2019 learning modules, students gain a deeper understanding of important (and fun!) problems in our world today, while accelerating proficiencies in core concepts across Middle School Math, Geometry, and Algebra I/II courses. Your students will never ask the question again: how is math applicable to my life? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.prismsvr.com/privacy", "developer_terms_of_service_url": "https://www.prismsvr.com/terms-of-service", "publisher_name": "Prisms of Reality", "support_website_url": null, "website_url": "http://www.prismsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1054780821987681"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572930_695553005558615_5763086723276920487_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9xJx5DBDnIQ7kNvwF6roo3&_nc_oc=AdohZycInudxdVWBaCMdPygX2fk8dX3nUkTNH6Pq8CG9vNLu3virxrh8rAlgrQwkACM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaMYbdArGS-I4-DGhCz3ds-dFQTLxP06n9i5Hph3Cq9A&oe=6A67762F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Prisms Math", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1674151142, "lastRevision": {"nodes": [{"id": "8875714399109128", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defa
c_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlWFb_3WcYMlDMq7D-y2jGyepXWVjH90daklA1ZHRr8A&oe=6B01DC3A"}, {"file_name": "Screenshot_122_0031.png", "id": "740462383654032", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031552_740462386987365_1301336221184347163_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZUQOizZOigQ7kNvwEYm5sw&_nc_oc=AdqroKQGiX9Z5TXb0boGryGoJ--4cieWyuYPOpUpiXWQ1NWBTOtJAr0HYkk0zciF4P4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxXUXciYhQQNuvT1aujKKIKR_NwY6Ap5IilupE2W8Wyw&oe=6B01EDF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "834576684239190", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036641_834576687572523_7298418642927853590_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rI2vm2xWiacQ7kNvwHh4lbo&_nc_oc=Adqy7w5QQuzN8C0nACu6oxZlmMUXdO69GbUA-TfkCIeObMtX_kQhfTe9tVvqdeYWuR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAzAfH-jgrgERzxxHywik0l1H53RfTfHv-iS43Z_ic2w&oe=6B01E80D"}, "display_name": "Prisms Math", "keywords": ["Education", "Math", "STEM", "Learning", "Science"], "long_description": "Prisms launched to schools around the US in 2021 to bring problem-driven, tactile and visual learning to the Math classroom. Our teachers and students were the first to learn math in a whole new way, and now anyone in the world can too! In Prisms, users gain math skills through:\n\nExperiencing and solving an important real-world problem \nUsing hands-on models to visualize and interact with structure \nConnecting 3D experiences to abstract representations like graphs, tables (2D) and equations / vocabulary (1D) \n\nPrisms has 3 key components:\n\nVR content modules for students to deepen their understanding of core concepts\nA multiplayer sandbox where tutors and students collaborate on additional practice problems to gain fluency\nTeaching materials and a web-based dashboard to support efficacious learning. If you\u2019re a tutor, parent, or district leader, contact us at partnerships@prismsvr.com to gain access to these resources. \n\nTopics:\n\nMiddle School - Fractions; Ratios; Rate of Change; Probability; Surface Area\n\nAlgebra I- Linear Functions; System of Equations; Quadratics; Linear Regression; Exponential Functions\n\nGeometry - Transformations; Distance Formula; Trig Ratios; Equations of Circles; Solids of Rotation\n\nAdvanced Algebra- Periodic Functions; Complex Numbers; Polar Coordinates; Vector Addition; Ellipses; Matrices\n\nAfter completing our modules, you can jump into our multiplayer sandbox for practice. We\u2019ve started with Middle School and Algebra for now!", "short_description": "Prisms is a new world spatial learning platform that enables learners to grasp abstract math concepts in a delightful, meaningful, and efficacious way. In Prisms\u2019 learning modules, students gain a deeper understanding of important (and fun!) problems in our world today, while accelerating proficiencies in core concepts across Middle School Math, Geometry, and Algebra I/II courses. Your students will never ask the question again: how is math applicable to my life?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.prismsvr.com/privacy", "developer_terms_of_service_url": "https://www.prismsvr.com/terms-of-service", "publisher_name": "Prisms of Reality", "support_website_url": null, "website_url": "http://www.prismsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
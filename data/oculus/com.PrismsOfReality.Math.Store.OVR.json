uscdn.com&_nc_ss=7f20f&oh=00_AQHD91b5nc9V8ucdTQtWlHsdy87NgwLj6Fx-Fc5JGZ8EWw&oe=6A73247B"}, {"file_name": "Screenshot_111_0112.png", "id": "1555039864978646", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575345_1555039868311979_8068287438231022586_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTg7x3k0--cQ7kNvwE9pX2G&_nc_oc=AdoWESuSgOMIggQHyACIAuqvO9Zw9kaSQjuHDLphRCp_Qdt_vsqTK4G8It8C6jsdce4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnkcmfFpcIpg8_1HAOc2r7SZrO8zZ0XIiIphCymk7PDw&oe=6A733188"}, {"file_name": "Screenshot_115_0004.png", "id": "527239276013953", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982646_527239279347286_2694137245070852123_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6EkPCC9QdEQ7kNvwHCjxL0&_nc_oc=AdpfIarynDTmW46ObdP46-i8QQeGAqn0tcCZlCDJO7Bo9HPha7Xj-zzQuY_yf-oEun8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgPPs-QtsPVm9-Dazje-82Pil9Vjh7990ZgcC1VTKw_A&oe=6A7341FA"}, {"file_name": "Screenshot_122_0031.png", "id": "740462383654032", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031552_740462386987365_1301336221184347163_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdiGSNYjfj8Q7kNvwHPZW26&_nc_oc=AdqiA3cnN_7pzyfT1taRnYPRld0dbaDHIrH7w5MkDuq34zTW54zbrVwmP-RGlNGgJwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa8RnBw-o_Av6tcQzA7j7va57uqqarqldeUiYoCx9skg&oe=6A7353B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "834576684239190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036641_834576687572523_7298418642927853590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ur9QlEfnK70Q7kNvwGrgPha&_nc_oc=AdqpgyEgEsTzE9KA3jSHHuh72mqn_EHXbEq4vlDywRoNTlJ6W7wxK_gJrRYQD1rtAq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHujQH7AG1OZqvaozCP_q4KF2VlYYDn6QQGluW4CTz2dw&oe=6A734DCD"}, "display_name": "Prisms Math", "keywords": ["Education", "Math", "STEM", "Learning", "Science"], "long_description": "** SUBSCRIPTION REQUIRED (US $23.99/year)**\n\nPrisms launched to schools around the US in 2021 to bring problem-driven, tactile, and visual learning to the Math classroom. Our teachers and students were the first to learn math in a whole new way, and now anyone in the world can too! In Prisms, users gain math skills through:\n\n- Experiencing and solving important real-world problems\n- Using hands-on models to visualize and interact with structure\n- Connecting 3D experiences to abstract representations like graphs, tables (2D), and equations / vocabulary (1D)\n\nPrisms has 3 key components:\n\n- VR content modules for students to deepen their understanding of core concepts\n- A multiplayer sandbox for additional practice problems\n- Teaching materials to support efficacious learning. Contact us at partnerships@prismsvr.com to gain access to these resources. A web-based dashboard is also available for our school district partners.\n\nTopics:\n\nMiddle School- Fractions; Ratios; Rate of Change; Probability; Surface Area\n\nAlgebra I- Linear Functions; Systems of Equations; Quadratics; Linear Regression; Exponential Functions\n\nGeometry- Transformations; Distance Formula; Trig Ratios; Circles; Solids of Rotation\n\nAdvanced Algebra- Periodic Functions; Complex Numbers; Polar Coordinates; Vector Addition; Ellipses; Matrices\n\nAfter completing modules, you can jump into our multiplayer sandbox for practice. We\u2019ve started with Middle School and Algebra for now!\n\n*For ages 13 and up", "short_description": "Prisms is a new world spatial learning platform that enables learners to grasp abstract math concepts in a delightful, meaningful, and efficacious way. In Prisms\u2019 learning modules, students gain a deeper understanding of important (and fun!) problems in our world today, while accelerating proficiencies in core concepts across Middle School Math, Geometry, and Algebra I/II courses. Your students will never ask the question again: how is math applicable to my life? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.prismsvr.com/privacy", "developer_terms_of_service_url": "https://www.prismsvr.com/terms-of-service", "publisher_name": "Prisms of Reality", "support_website_url": null, "website_url": "http://www.prismsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1054780821987681"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572930_695553005558615_5763086723276920487_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10Gi7gHcvCcQ7kNvwETvzKp&_nc_oc=Adqv1RTwnU-xNa2D5B8kh9t0SAEVJ1QIlXgC150xc7NqU5HsW_bWJoenfpM3JKXgjf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpa4P3fOicEN_qwl9zcvPID1pwXbf5_y0H4nrHUqi0OQ&oe=6A7353AF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Prisms Math", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1674151142, "lastRevision": {"nodes": [{"id": "8875714399109128", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"defa
_914752524378148_7113479436552449688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm1EExKRCXAQ7kNvwEwdl5L&_nc_oc=AdoW281NnBWh_kVFMsPRGQAffhvg13OeyHlJ9Mb_gAFT13M-wOL8qo6ZyNIUO1dgJP4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGpZXe35Ksqp0_12J8SMV2QHtaSadIwemV6vpCmTWWUg&oe=6AE36A78"}]}, "id": "2193424544394363", "locale": "en_US", "screenshots": [{"file_name": "zen.png", "id": "26096293876726899", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499293669_26096293880060232_2361243161159682092_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dqLklJsuG0Q7kNvwFrsM5R&_nc_oc=AdoRcS6cNeS6YGi-uyQJByEoXEGBiCMv2vmEuZZaiOl00Kh7cHv2KqHspaBE3xMQk3E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Gwen3CQiG8QYNTTgoU00Iq9HFGq7H6Y49UjEzmzVfQ&oe=6AE36577"}, {"file_name": "ink.png", "id": "1415136229502387", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499293690_1415136232835720_6795066242585606352_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uvH0UH9Of0Q7kNvwHe14GK&_nc_oc=Adppt4Y0idI-xb-00yeqzYN-VRI09qJcWHWk9jM-acDkwYHHjiAEaHGR3RnWCXB5lsY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcDFYvY21nIwfjuc-pwl1-PYohDBl6ncq49H1fWnW3Mg&oe=6AE340A3"}, {"file_name": "wormhole.png", "id": "1217836003390295", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830812_1217836006723628_8626801305537571803_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzpLl0vVSdkQ7kNvwEzC0t9&_nc_oc=AdqY_iJd57zJn2AAMesJfddDkEMiQAf3kTTQplcb7crrxcqh3-KqDEFATLIJRDtC924&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEeqOWLxnYc9fh-Ib4BjWNwOeZ6IgBGfb4aT2NmbI62w&oe=6AE35125"}, {"file_name": "waterfall.png", "id": "770648862319935", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620666_770648865653268_7397735649664337625_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TjebwfY6Z8Q7kNvwGv7yAB&_nc_oc=Adr0n9STeGWDDT8HSLBPy-0JYX3qwW6sCYSlk7WdoKZF7ryHBt9349gOUqScRmxEIrM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqj_gShYYghVxy8czphI8Srml67bZKfY6_26dX_aj3cw&oe=6AE34F78"}, {"file_name": "clouds.png", "id": "1286192620044933", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830911_1286192623378266_8246118084239723488_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YK7liGBRC1cQ7kNvwF5JDzP&_nc_oc=AdpfocqHMbGRFU0nUQnaCuB-3CVWcscgYCCkcoaz0n289MTgn4DKkstULWWMcgWY6LA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdEUn4m0MytKAxcwNETYvBAZy0HMZPTVxzq7AKdu0G7Q&oe=6AE360E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "920228753925075", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296127_920228757258408_1104305278611662178_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42BJ9whJwdEQ7kNvwHaVV6G&_nc_oc=AdpAmT0yZB9RuPLcevkAOjiUOPWL-EpZnzJ2vAB0ikzE6fk4ne6s1CWWdaz64rnFxc0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxXlBjmqy9UdCAeACWi9jZ9uHi-3SGHaP6dGpaZP-lHQ&oe=6AE35392"}, "display_name": "Energies: Meditative Motions", "keywords": ["meditation", "particles", "relaxing", "art", "abstract"], "long_description": "Inundate your senses, immersed in the mesmerizing movement of energetic flows. Dive into millions of particles, trails, and volumetric forms, art-directed to abstract the natural motion of energy in our universe. \n\nA visual album featuring 12 meditative seated experiences, totaling over an hour of content, paired with original music and rendered in stereoscopic 3D, up to 8K resolution and 90fps.\n\nTracks:\nGolden Gust \u2013 Swirling golden winds undulate in gentle, turbulent flows.\nRainbow Clouds \u2013 Billowing volumetric clouds drift and swell in radiant cycles of color.\nShimmering Shoal \u2013 A vast shoal of particles flocks, ripples, and shimmers with motion.\nZen Garden \u2013 Explosive fractals resonate through a tranquil field of sand.\nGeyser Burst \u2013 Surging trails erupt upward, bursting and spraying droplets of water.\nInk Drop \u2013 Plumes of diffusive ink unspool and stratify as they dissolve around you.\nMagic Fountain \u2013 Whimsical surges of energy transmute into beautiful forms and detonate.\nPulsar Orb \u2013 A pulsing orb of abstract energy oscillates with hypnotic resonance.\nDust Storm \u2013 Roaring dust fields blast toward you in calming waves.\nSwirling Vortex \u2013 A towering helix of wind evolves with twists and whirls.\nWaterfall \u2013 Streaming sheets of particles cascade and splash off rocks toward you.\nWormhole \u2013 Travel through dimensions as a breathing portal of energetic flux expands and contracts.\n\nExperience the afterglow of Energies, as if the motion continues around you.", "short_description": "Immerse your senses in the mesmerizing movement of energy. Dive into millions of particles, trails, and volumetric forms that abstract the motion of the universe. This visual album features 12 seated, meditative experiences set to original music, rendered in stereoscopic 3D, up to 8K at 90fps. From swirling golden winds and radiant clouds to pulsing orbs, cascading waterfalls, and dimensional wormholes, each track surrounds you in evolving motion that lingers beyond the final frame."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.energiesvr.com/", "developer_terms_of_service_url": null, "publisher_name": "4D Music LLC", "support_website_url": null, "website_url": "http://www.energiesvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
4_4080352460138902555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJZCPcmCcTgQ7kNvwEG5Z_W&_nc_oc=AdrlAaCOZPC8TEOnRD4vzfAIEGeQq7RuBDf73yU7JnuKHHUHECCZj9Zaieexxggz7e8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQklV7cwYGjpMcqoZlOm-oNk7NvS5y__ShQXuF40ARZdQ&oe=6AECBA0F"}, {"file_name": "2e7e50adedc04e1b8d2be243f27b5ea2 2.png", "id": "2001691153871505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314351_2001691157204838_6283789838724126810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ommorpvp0E8Q7kNvwF17I9c&_nc_oc=AdpOiAXV_UpXlBb26YnLySvMvthJicYO_oeMtqzCXvg1HZZmqAPzo2nqZ7yywqm1ojs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiimgaopRX7TRMQ4_9v3lrP-Pc6U2t7O9MSCKtCznKeQ&oe=6AEC8ACC"}, {"file_name": "07e2b9ac604b4a5dadb4e9ad90c48593.png", "id": "2272827096883499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_2272827100216832_5505278682049706960_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7YIzSd0LssQ7kNvwEcYp6l&_nc_oc=AdqAxWVHIQ5eJe57m33vta1jznuZm2QkUNXTUt1VNJ45ZfhMTxI5IcFsWbZH0uj8Sws&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTriZXAJ1iWYzrIYy-DI_SaCOD0edKFJ6TC5v5XkqCYqQ&oe=6AEC873B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just mop VR", "keywords": [], "long_description": "Just Mop VR is a simple VR game about one thing: keeping the flood under control.\n\nGrab the mop, soak up water from the floor, wring it out into the bucket, and keep working before the water level gets too high.\n\nEach level puts you in a different environment with its own source of flooding. Your goal is to keep mopping and reduce the water level before the situation gets out of control.\n\nJust Mop VR is built around straightforward physical VR interaction \u2014 grab the mop, clean up the water, empty it into the bucket, and try to save the level before it floods.", "short_description": "Just Mop VR is a fast-paced VR cleanup game where y
4_4080352460138902555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP5e-5BOgXUQ7kNvwFr_KhW&_nc_oc=Adq9AGmoRB3LUw6KjugrMCYEIvZuCW9dLikPgOocu-r69MC3rQ8WphCMh2mpSpxUaKA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGhFwL1_QbmIPwIUV09Whp11H5J7Z3naogZyWaognLsw&oe=6AE88D4F"}, {"file_name": "2e7e50adedc04e1b8d2be243f27b5ea2 2.png", "id": "2001691153871505", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499314351_2001691157204838_6283789838724126810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgL8_oAJuxcQ7kNvwGN6TYV&_nc_oc=AdqEpf215ddfHQ3wFH4gVXwOqZ2nXAluKNKhAb-bV3kh75zt5kuXKjY6kwKuhLQ5Hu4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ634-3gGo8bj9HzRpCZ7jRUZXTvEFYgQm7cnhk74wZ3A&oe=6AE8964C"}, {"file_name": "07e2b9ac604b4a5dadb4e9ad90c48593.png", "id": "2272827096883499", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499314641_2272827100216832_5505278682049706960_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=se0LxpnF4_kQ7kNvwG5EAKa&_nc_oc=AdoBIj9c5N34q1BKOBg_5szF6Qh9LH_-0bnamu66xvMIq4rmuDbUjJnT5Nc_yzv9BdI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr7fyVvLWPuW1k343qnzIW65_tJBtxodRRuEm9EU_sfQ&oe=6AE892BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just mop VR", "keywords": [], "long_description": "Just Mop VR is a simple VR game about one thing: keeping the flood under control.\n\nGrab the mop, soak up water from the floor, wring it out into the bucket, and keep working before the water level gets too high.\n\nEach level puts you in a different environment with its own source of flooding. Your goal is to keep mopping and reduce the water level before the situation gets out of control.\n\nJust Mop VR is built around straightforward physical VR interaction \u2014 grab the mop, clean up the water, empty it into the bucket, and try to save the level before it floods.", "short_description": "Just Mop VR is a fast-paced VR cleanup game where you race to control rising floods before time runs out. Grab your mop, soak up the water, wring it into your bucket, and keep leaks under control as the pressure builds. Stay ahead of the flood, manage the chaos, and save each level from disaster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.titlesunknownstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Title Unknown Studios", "support_website_url": null, "website_url": "https://www.titlesunknownstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1501354591759925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507823984_2237391193749392_6405763314750795766_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6GpV40qH_4Q7kNvwH_rasq&_nc_oc=AdqjCGTGhgxkDnS9M0f_NvvHHFVwY0F88Q38dxLrhArRgYJLEOuz5o98Go-O7QzNs90&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdVb9z8Beabqiam7FxdGJKhIJyKwLRl9QgEn_444O76Q&oe=6AE89417"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Just mop VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331
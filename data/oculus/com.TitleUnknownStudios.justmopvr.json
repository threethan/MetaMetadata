4_4080352460138902555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hz6CUvsqQ0MQ7kNvwFOQRoc&_nc_oc=AdqQ9NfSJpW1MuoOtaLKkOuIWzllhJ_P32t5_zfp1plU3Xm4vb-z41jvYOWg5u0yK7k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyeArv_wL79pFrWA7JdAg2YadujDaM-ot-ZY4p83KvGA&oe=6AEF5D0F"}, {"file_name": "2e7e50adedc04e1b8d2be243f27b5ea2 2.png", "id": "2001691153871505", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314351_2001691157204838_6283789838724126810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ommorpvp0E8Q7kNvwF-etIC&_nc_oc=AdpLMK2UaXNrnNSGhkFn-WIHZOtBEUuYdGmMdtS9lH-sHfIwUz9hW9SFCSOBN4hr0Ic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXct1dlH-ckNEllMHP-c8Og4378EjLMOGLsVf5KDw79g&oe=6AEF660C"}, {"file_name": "07e2b9ac604b4a5dadb4e9ad90c48593.png", "id": "2272827096883499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314641_2272827100216832_5505278682049706960_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wvh6A9rUIecQ7kNvwFFltUh&_nc_oc=AdqnehWqBS2G_gfx6YMxQ57RQAf6yDPQ9gXVFBAiKw9qYbj0gQeikxNzDiTDwWZwPwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSA7P-uD_4CO9di0lv7AI0c21PR-1zZ-_t0JfCqJrucvg&oe=6AEF627B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just mop VR", "keywords": [], "long_description": "Just Mop VR is a simple VR game about one thing: keeping the flood under control.\n\nGrab the mop, soak up water from the floor, wring it out into the bucket, and keep working before the water level gets too high.\n\nEach level puts you in a different environment with its own source of flooding. Your goal is to keep mopping and reduce the water level before the situation gets out of control.\n\nJust Mop VR is built around straightforward physical VR interaction \u2014 grab the mop, clean up the water, empty it into the bucket, and try to save the level before it floods.", "short_description": "Just Mop VR is a fast-paced VR cleanup game where y
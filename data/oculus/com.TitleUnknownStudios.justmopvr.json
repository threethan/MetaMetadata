Q&oe=6B05D945"}, {"file_name": "76ecbf23e62a4cb18972107bc8c4a091.png", "id": "1547030767199211", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1547030770532544_4080352460138902555_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfePEFvWAo4Q7kNvwE8-pJZ&_nc_oc=Ado5QPydcPKF8K6vCtenV8kK587LqIBVLx3L4CBmbbCBz7hGvYVlZdVUrb02FhBykQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShcGbzXueSWIZ1W2lVAAkiOk69o_qLMjl7smLuy8KKTQ&oe=6B05C68F"}, {"file_name": "2e7e50adedc04e1b8d2be243f27b5ea2 2.png", "id": "2001691153871505", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499314351_2001691157204838_6283789838724126810_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYc7bhnZNT0Q7kNvwH1yzY3&_nc_oc=AdoC_lPMWQBG863XQISUXd6tmmBfwlBKZehrdNmjUi6viKxEQ76nVU1vO_tVZ1ejwzE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBEABi6ylTI9douNvOK6WWz9PnFsYoyGSDLeDUPZvH1A&oe=6B05CF8C"}, {"file_name": "07e2b9ac604b4a5dadb4e9ad90c48593.png", "id": "2272827096883499", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314641_2272827100216832_5505278682049706960_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj2fULTg9KUQ7kNvwE6l5aV&_nc_oc=AdpTcRf-kkRLLyOBUbiW3oOtLpWa7pG5tYxoshDiUdb9JQDKvoArnqU8sJn608ukSl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0HHhivZTUC5PhBjB6Pr8nSbGrKEvYZ3m4I9TaaMOSXQ&oe=6B05CBFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just mop VR", "keywords": [], "long_description": "Just Mop VR is a simple VR game about one thing: keeping the flood under control.\n\nGrab the mop, soak up water from the floor, wring it out into the bucket, and keep working before the water level gets too high.\n\nEach level puts you in a different environment with its own source of flooding. Your goal is to keep mopping and reduce the water level before the situation gets out of control.\n\nJust Mop VR is built around straightforward physical VR interaction \u2014 grab the mop, clean up the water, empty it into the bucket, and try to save the level before it floods.", "short_description": "Just Mop VR is a fast-paced VR cleanup game where you race to control rising floods before time runs out. Grab your mop, soak up the water, wring it into your bucket, and keep leaks under control as the pressure builds. Stay ahead of the flood, manage the chaos, and save each level from disaster."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.titlesunknownstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Title Unknown Studios", "support_website_url": null, "website_url": "https://www.titlesunknownstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1501354591759925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507823984_2237391193749392_6405763314750795766_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfmlLDGdSvoQ7kNvwG5KYSz&_nc_oc=Adr8KtB7tZDuXykjqM51ar1le7qIcjZFyraSTahTglsuXD0iFLzlh_qyjwA5Pu_8NSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPX1ddv9tYAdmY2TI437LsP13f3wNUBQFyN2lh
4_4080352460138902555_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pNsoLk0IpIQ7kNvwEiySLc&_nc_oc=AdrXFnqEfSO9fB0datmT4JJNPMA1QeGlJroZZreoQMSPBgBnPNp1nZywtvhT8Kk6vQY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwMwAnOKfUrjKChmX0UVwzFITxC6tDimmJ5XqfNMLYKQ&oe=6ADCAFCF"}, {"file_name": "2e7e50adedc04e1b8d2be243f27b5ea2 2.png", "id": "2001691153871505", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314351_2001691157204838_6283789838724126810_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tkzpq-Hc8AQ7kNvwF24uSS&_nc_oc=AdoSUH0iDbhLFKjjo1bwJyr4TEP235OlCx4Za6wgnCAOXRwYMM-v5zT2YgztwNxiwIY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYEgv6QN7QB6WQ4sT5yJHF3DL1HhpPJ89lSF1rox86Tw&oe=6ADCB8CC"}, {"file_name": "07e2b9ac604b4a5dadb4e9ad90c48593.png", "id": "2272827096883499", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314641_2272827100216832_5505278682049706960_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMOpYzpRK0AQ7kNvwHGmxt5&_nc_oc=AdqnuOGXIXG8of_RSVNjbkgXwxnFjUIu3dyel67JWvk4vW78iH1t6tDFYPlkcATPr-I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj0PpdlZLeF7eRsfKgCJa4ivdVZEr9KoWo77wFdfwTsg&oe=6ADCB53B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Just mop VR", "keywords": [], "long_description": "Just Mop VR is a simple VR game about one thing: keeping the flood under control.\n\nGrab the mop, soak up water from the floor, wring it out into the bucket, and keep working before the water level gets too high.\n\nEach level puts you in a different environment with its own source of flooding. Your goal is to keep mopping and reduce the water level before the situation gets out of control.\n\nJust Mop VR is built around straightforward physical VR interaction \u2014 grab the mop, clean up the water, empty it into the bucket, and try to save the level before it floods.", "short_description": "Just Mop VR is a fast-paced VR cleanup game where y
6_7566054043622187086_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCVBJrd_WeoQ7kNvwHT4JA-&_nc_oc=AdoJ-_DmAPLCD6Ftd4JEn4z7IAKIxexwKqSSyDKQv1cCa3uy2SGEZwjJRKYm1TkoQ_4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0xnG2ZZAniBuWTI14Sx83qYSa21IAT5DuWOYX6SRkdw&oe=6AE0AA7B"}, {"file_name": "lab6_compare.png", "id": "927606670348397", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310667_927606673681730_1571476682933664849_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9Yo-30zufoQ7kNvwE_AwfC&_nc_oc=AdpK2w81BO6W2CdLWLyQBTg_SLYps-7O6IvULHnA65RRBPn1A9pCqtmi2T4bCx_rpC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvMtlpDsrM1681GmW_ULgpJONbiBs8NCplcLsEJ7oiow&oe=6AE0A112"}, {"file_name": "lab6_resist.png", "id": "26753233571021485", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312470_26753233574354818_3480358762467238774_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNuWTgntpekQ7kNvwG3oxcr&_nc_oc=AdrYn0bj1mQhZL0EskgXdtvdRphHFpoAyP_765SPGhD9EC4rO0exqqPTYGmlf49zW7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyVwFPlJPLFLrbFBdMVQp1sqvFUKgYkZ2nSa-vHoCG2g&oe=6AE0B630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Immersive Labs: DC Circuits", "keywords": [], "long_description": "**Dunwoody Immersive's XR Labs: DC Circuits** is the immersive lab companion to **ELTT1101: Fundamentals of DC Circuits**, one of the first courses offered through Dunwoody College of Technology's **Dunwoody Immersive** initiative.\n\nDesigned for high school dual enrollment students and lifelong learners, the application delivers realistic, hands-on XR lab experiences that reinforce classroom instruction through active learning and problem solving.\n\nInside the labs, learners build electrical circuits from schematics, translate diagrams into panel layouts, perform voltage, current, and resistance measurements with a virtual multimeter, diagnose circuit faults using structured troubleshooting techniques, and practice safe electrical work in a risk-free environment.\n\n**Lab activities reinforce:**\n- Ohm's Law and the PIRE wheel\n- Kirchhoff's Voltage and Current Laws\n- Series, parallel, and combination circuits\n- Schematic interpretation\n- Measurement techniques\n- Electrical troubleshooting\n- Safe low-voltage DC practices\n\n**Dunwoody Immersive** combines online coursework with immersive virtual reality labs to expand access to high-quality skilled trades education. Students build confidence and technical skills through authentic XR learning experiences.\n\n**Note:** This application is intended for students enrolled in participating Dunwoody Immersive programs. Access requires a course-issued pairing code.", "short_description": "Experience hands-on electrical training in virtual reality as part of Dunwoody College of Technology's Immersive dual enrollment program. XR Labs: DC Circuits develops circuit analysis, troubleshooting, measurement, and safe work practices through interactive lab experiences that complement college-level coursework."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dunwoody.edu/academics/immersive/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Dunwoody Immersive", "support_website_url": "https://dunwoody.edu/immersive", "website_url": "https://dunwoody.edu/immersive", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_mode
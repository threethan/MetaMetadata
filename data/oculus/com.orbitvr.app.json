e=6AFDB22D"}, {"file_name": "04_moon.png", "id": "874076441867324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620860_874076445200657_5357996438117477064_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBmBYeBKImAQ7kNvwEV3qGR&_nc_oc=AdocF4uuxN2B0wvnzd4jsJPEVP63ZFFzHYYDSnkmTdCm7PcNDrIh4dLdg6o5S7stz08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTilLD2eJZeZBj_1SFR5WjbtB2Pu1jaE65j9Yt615Ep2w&oe=6AFDCF8E"}, {"file_name": "06_moon_debris.png", "id": "1745704250190900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596068480_1745704253524233_3163650158381795308_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I624nwBSoD0Q7kNvwHHYSzr&_nc_oc=Adr0PDmE5EIB1izMFFVfFw5auGsbXXXcjg8p48H50KWL4fDOKf3EYn0cuFjsHyHVylk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwsKcP0Ma7KS1-meSNHh94jYdRhtuB53rqFI7MsZOT0g&oe=6AFDB110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "space_junk_view_outro_final_epic_from_scratch_4k.png", "id": "2902190596617861", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623601_2902190599951194_4278783171980149298_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcMQjEboHmIQ7kNvwHBIBV4&_nc_oc=AdoU3tGHRCnV-KbcXwiR7tm8rjr2ar6FgHHC0zvQLBHgcw7f6VCQpQuu1_QqRVu_jD8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBASJ7Jith-ofGVX1q1FmI8ncgqDGTmc4xI6w6LGw1lA&oe=6AFDD856"}, "display_name": "Space Junk View VR", "keywords": ["orbit", "debris", "astronomy", "space", "starlink"], "long_description": "You're floating in space. Around you, the real junk.\n\nSpace Junk View VR drops you inside the live, real catalog of 31,000+ tracked objects orbiting Earth right now: active satellites, dead satellites, spent rocket bodies, and a vast cloud of debris. Every object is propagated with real SGP4 orbital mechanics to its true current position, streaming past you at a smooth 72 FPS. This isn't an artist's impression; it's the actual sky, computed from public tracking data, with the right things in the right places.\n\nSee the real space junk. Then go find out what it is.\n\n- Gaze to identify. Look at any object and a deep info card tells you what it is, with real trivia and history.\n- Color-coded by type. Instantly tell active satellites from dead ones, rocket bodies, and debris.\n- The lore of the mess. Visit the debris clouds left by history's big breakup events (Cosmos 1408, Fengyun-1C, and the Iridium 33 / Cosmos 2251 collision) and read what happened.\n- Notable Objects tour with fly-to. One tap flies you to the ISS, the Hubble Space Telescope, Vanguard 1 (the oldest human object still in orbit), a Starlink, or a GPS satellite.\n- \"What's up there now.\" A live census counts exactly how many objects, and how much junk, is overhead this very moment.\n\nData comes from CelesTrak, NASA, and NOAA. It's the kind of view normally reserved for mission-control screens, except you're standing inside it.", "short_description": "Fly through 31,000+ real tracked objects in orbit: live satellites, dead ones, rocket bodies and debris, propagated with real orbital math. Gaze at any one to ID it."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spacejunkview.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Third Space LLC", "support_website_url": null, "website_url": "https://spacejunkview.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1229927386863218"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622315_1026934826452411_4086209955264497625_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsXeqARklUsQ7kNvwGgg7wV&_nc_oc=AdpdCHi-vJsT2E03fxu9kQZHM2oCbMD_JntOvf75LSiiatRVia1PIacX4AQs5tHmSm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMtrt6hsaRLEc1Rv55cEgd1yiIpF9Di0ARM9bx31DdbQ&oe=6AFDE2F2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Junk View VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1782313320, "lastRevision": {"nodes": [{"id": "1229927396863217", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1229927380196552", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1349707683789390"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "icon-512x512.png", "id": "4296467033927768", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673638530_4296467037261101_9216445392644066023_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6fbFedDW8wQ7kNvwFtbb-k&_nc_oc=Ado1CMJ8KRQH4r57yyuU8ZTho7QIS1J3FROYyvI92-6-lqbcQRUaiKiMeJnxQX11IC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4pAc4Ko7d8nYEMV8IUBKBqVl8Am40v3wSpjChlNn4qw&oe=6AFDC5C0"}, {"fil
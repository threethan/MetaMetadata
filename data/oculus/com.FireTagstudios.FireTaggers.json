un to do. If you love Gorilla Tag, you\u2019ll definitely enjoy this!", "short_description": "A fun gorilla tag fan game where you can have fun with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1MwUaKEqh1xd_kHOCtYeYqug-qPQgasg_-0TlRTj3EEk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Marco", "support_website_url": null, "website_url": "https://sites.google.com/view/project-fire/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9443047919077787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392019_632430199555550_5934803645951845531_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFMFmNPhJQkQ7kNvwGXdwAJ&_nc_oc=AdnV1HATOQkTK34LCplFuib20p7rn6awtYvzuF_x9zJN7Fhd0hav8hXAFR4rIfGq0hQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1sa9OUuxnIIVBaGt2is4-Ci_ShdeT-QHybkDkLYniOA&oe=69AD798A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project Fire", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1744045380, "lastRevision": {"nodes": [{"id": "9405501289499117", "release_type": "SCHEDULED",
ords": [], "long_description": "This is a fun and exciting Gorilla Tag fan game where you and your friends can run, jump, and climb your way through all kinds of crazy environments! With intuitive movement mechanics, you\u2019ll feel like a real gorilla as you swing through the world, play different game modes, and just have a great time with others. Whether you're chasing your friends in a fast-paced game of tag or just exploring and messing around, there\u2019s always something fun to do. If you love Gorilla Tag, you\u2019ll definitely enjoy this!", "short_description": "A fun gorilla tag fan game where you can have fun with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1MwUaKEqh1xd_kHOCtYeYqug-qPQgasg_-0TlRTj3EEk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Marco", "support_website_url": null, "website_url": "https://sites.google.com/view/project-fire/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9443047919077787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392019_632430199555550_5934803645951845531_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJeep5B5XRwQ7kNvwFQKtHw&_nc_oc=AdppBhIRYcX886haY9bkVIPaxGiDefuveFemUrs_OMOpMizE-gvZ9_2SBoqbwKK49-A
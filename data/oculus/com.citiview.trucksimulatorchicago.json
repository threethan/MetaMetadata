oc=Adp-RC3sk4uQbWNUaA4an9HmcldMge6bIWSJ-W8hXxDCE-lNPrJaRfuQKDN9JB3zudI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwEXDd44nTLi3ftpxk_yhUpXZFiK46pqSgHwUJRAc7uQ&oe=6AFB274F"}, {"file_name": "screenshot_5.png", "id": "2182093572742829", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831964_2182093576076162_2158308469330732389_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcJtep_-5H8Q7kNvwGkibSL&_nc_oc=AdpwCBoAO_ewoRb7N-04dsSxcrN8O-8V0fyekuMkK_taO3G6pNM2X7Pppcm4VMPQ8Fs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJRKswRrVc4GQWp25sBU7Q1GQmFAF5O1KkAsD5UO9UWw&oe=6AFB1F85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3896482330531206", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831279_3896482333864539_8900500021938567654_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcvLj-xb580Q7kNvwE7-3Vr&_nc_oc=Adpo2IBYctjN18M4jfN4iCQ4fqAGDQ5nMvGrNRGs4nzb07NHUoJjO1MwQXYKoc7_BtM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGeuJd7WnXPQIxi734I2B3gMrppKnGxkZB6-E361d22w&oe=6AFB3BE7"}, "display_name": "Truck Simulator Chicago", "keywords": ["truck", "trucking", "driving", "simulator", "chicago"], "long_description": "The open road, from the driver's seat - in Chicago.\n\nCHICAGO'S EXPRESSWAYS\nA 38-mile loop of real Chicago expressway built from real map data: the Eisenhower east past the United Center into the Jane Byrne Interchange right under the Willis Tower, the Kennedy north-west past the skyline and Wrigleyville out to O'Hare, then the Tri-State Tollway south along the airport cargo ramps back to Hillside. Real ramps, real overpasses, the Loop's towers and Lake Michigan on the horizon.\n\nA SHOW TRUCK TO CALL HOME\nWalnut dash, cognac tufting, fourteen working gauges and a starlight headliner. Grip the wheel with your own hands, pull the air horn, set the parking brake - or drive with the joysticks.\n\nA REAL 10-SPEED\nPick AUTOMATIC and just drive, or switch to MANUAL and float a 10-speed through the H-pattern with a LO/HI range. Match the revs and it drops in. Miss it and it grinds.\n\nHAUL REAL CHICAGO LOADS\nSix depots in real Chicago places - Cicero, Fulton Market, Jefferson Park, O'Hare Cargo, Elmhurst and Hillside. Back under your trailer, take the load from dispatch and deliver it through Chicago traffic.\n\nDAY AND NIGHT\nDrive at noon or after dark with the skyline lit up and the Hancock antennas blinking over the lake. Night runs pay extra.\n\nON THE RADIO\nA real dispatcher and five truckers on the CB with Chicago road talk.\n\nTHE SLEEPER\nLeave the seat, walk back into the sleeper and sleep through to morning.\n\nPlus 17 achievements, 9 paints, a live map and Chicago flags at every yard.", "short_description": "Grab the wheel of a long-nose show truck and haul freight around Chicago's real expressways. Run the Eisenhower past the United Center into the Jane Byrne Interchange under the Willis Tower, the Kennedy north-west with the skyline in your mirrors out to O'Hare, and the Tri-State Tollway back south, by day and by night. Shift a real 10-speed manual or let the automatic do it, take loads from dispatch, chat on the CB, then walk back and rest in your sleeper."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/trucksimulatorchicago/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trucksimulatorchicago/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT
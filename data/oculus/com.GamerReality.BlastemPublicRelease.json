7kNvwEEnYO6&_nc_oc=Adn7AzbrPfVNItjAaxBKPJc84hpZicAZolxjHBx3KrcS8YjUi69ihCdXExSPfe6Zmzk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEG9QUmNjZz0rPPjcoHOE6ZzNwT5ogCqQldAhDzsX2pg&oe=69B162C4"}, {"file_name": "thumbnail 3 free for all.png", "id": "1027932225194069", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_1027932228527402_3154145990640641483_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SmBfLcpUjo8Q7kNvwE7QNgN&_nc_oc=Adm9P2JPIPHTfAkYYw2bGC1X7RWnOgrhITDEZZzoPQs2qLDpWCE8TTjjovA9LicE8xs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxLIHFuiPgIlysfs9BCCKKJC7OAyfefprJT2zFxacMWQ&oe=69B172CC"}, {"file_name": "thumbnail 4 social.png", "id": "1144812016502355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031567_1144812019835688_2228234335877336832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fIX2ppFVQkQ7kNvwFCTfU3&_nc_oc=Adl79YjqyZxw1dJIk2XKV9H6agsTxVuweb4vbX8v96a-jqYTYnhJO-zz9hUWQoP8r-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxC-QIucL6wZDIirPI1zg1NB3tkTTnFsaDuPYx9a8fsQ&oe=69B17D71"}, {"file_name": "thumbnail 5 jumbo.png", "id": "206414519102457", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75356793_206414522435790_4588496168591853990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C8_XdTmMEcQ7kNvwEuWPEg&_nc_oc=AdlKoeoFRenkZ-dg3_VCunLWw9LcFQh_SkmWx5pONjrgsEWBc8K4IWfl9QxDE6ZjK1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy04caW5Z4-qZiUYultOw_N6X6pkrtzhUKRpNMlHQgnLA&oe=69B14F4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image thumbnail for Meta.png", "id": "669643615238767", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210400_669643618572100_6358332256817965062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGbKED2OlJQQ7kNvwE0OmKc&_nc_oc=Admmd2BxOS8-f_q-FWr3ge8wEYG7-NzDvgxcRKXCkxBCHhxpXpHDWGTpyiMUsNwWqoE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBDm6firgyNXT_-Ag0N9W81Y68QzaPoyUXHmrhyslzTA&oe=69B153BC"}, "display_name": "Blast'em", "keywords": [], "long_description": "Blast'em is a fan-made game developed by one person, me, @GamerReality on YouTube!\n\nDuel players with the weapons that spawn around you. Move your whole body to dodge the slow-motion bullets from your opponents.\n\n\ud83d\udca5FREE - Completely free with no in-app purchases.\n\ud83d\udca5 1-2 VS BOT - Can you and a friend defeat Bobert the Bot in \"Bot Go Hard\" mode?\n\ud83d\udca5 2 VS 2 - Also works for 1 VS 1 duels.\n\ud83d\udca54 PLAYER FREE FOR ALL - Who will be left standing?\n\ud83d\udca53 VS 3 JUMBO - Everything's bigger!\n\ud83d\udca5REFLECTION SWORD - Block all incoming bullets and speed them up!\n\ud83d\udca5SECRET MODIFIERS - The \"Secrets\" will be clear to people who pay attention.", "short_description": "Get together with your friends, or find players online, and duel your hearts out! With 4 GAME MODES + secret game modifiers, you'll want to play this game over and over. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2b566eb9-e7ce-4cd5-aed5-dea1e1684a46", "developer_terms_of_service_url": null, "publisher_name": "GAMER REALITIES LLC", "support_website_url": null, "website_url": "https://www.youtube.com/@GamerReality", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "661061
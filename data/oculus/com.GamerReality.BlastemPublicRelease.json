XUKClZan2oepO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsUseYLjPa38dXoHzln4yzCgIIeW39XW0HzezsAI474fQ&oe=69A433C4"}, {"file_name": "thumbnail 3 free for all.png", "id": "1027932225194069", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982602_1027932228527402_3154145990640641483_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvs4d-99SSUQ7kNvwG1ciNs&_nc_oc=Adl-gjyylGok_8lqvYgn8xldozTNwydQnrbVpWYW9bT-CT3iX-Hz28QSraOIQbEMsc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvLUgROXnhFKkYwGn3W5RlzDfRkH_ZuXPxkbRB45xkLQQ&oe=69A443CC"}, {"file_name": "thumbnail 4 social.png", "id": "1144812016502355", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031567_1144812019835688_2228234335877336832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d81Uv8dUMjYQ7kNvwFVLvNa&_nc_oc=AdkmwpCPEcyR-hzflGFgoGU9KjRHTx0I81l5NKbwiaZfST9AoBV2GD0AZYP2WnkDny0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsmhTr_Jv9KkBRP3ym_-Bdg9SQnzllTwiXYxWZaoyb_rA&oe=69A44E71"}, {"file_name": "thumbnail 5 jumbo.png", "id": "206414519102457", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75356793_206414522435790_4588496168591853990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNDbCZjFSNUQ7kNvwHDHaTH&_nc_oc=Admm824DNifYM8k5yxhrM8DBncX1OXE08qraTNMv7HqyM7vaBu_z4Ull3QRqiGeZg_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftOgDlnMbzRPOoVCMGn9NLNH-6WLyMApOj-9aXkfru9-w&oe=69A4204F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image thumbnail for Meta.png", "id": "669643615238767", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210400_669643618572100_6358332256817965062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IklFIz3rFmwQ7kNvwFwVDR9&_nc_oc=AdmKNj6DY73GX_-ZMCi_68WI7tm-7O-8NTSuxuPt_EQqKzb0N955mNQGpNRHisjXRi4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvCMe6YNiHfamLcPLNlKCIMei_jw9DKTUTCImWaERBdvQ&oe=69A424BC"}, "display_name": "Blast'em", "keywords": [], "long_description": "Blast'em is a fan-made game developed by one person, me, @GamerReality on YouTube!\n\nDuel players with the weapons that spawn around you. Move your whole body to dodge the slow-motion bullets from your opponents.\n\n\ud83d\udca5FREE - Completely free with no in-app purchases.\n\ud83d\udca5 1-2 VS BOT - Can you and a friend defeat Bobert the Bot in \"Bot Go Hard\" mode?\n\ud83d\udca5 2 VS 2 - Also works for 1 VS 1 duels.\n\ud83d\udca54 PLAYER FREE FOR ALL - Who will be left standing?\n\ud83d\udca53 VS 3 JUMBO - Everything's bigger!\n\ud83d\udca5REFLECTION SWORD - Block all incoming bullets and speed them up!\n\ud83d\udca5SECRET MODIFIERS - The \"Secrets\" will be clear to people who pay attention.", "short_description": "Get together with your friends, or find players online, and duel your hearts out! With 4 GAME MODES + secret game modifiers, you'll want to play this game over and over. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2b566eb9-e7ce-4cd5-aed5-dea1e1684a46", "developer_terms_of_service_url": null, "publisher_name": "GAMER REALITIES LLC", "support_website_url": null, "website_url": "https://www.youtube.com/@GamerReality", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "661061159269649"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.577
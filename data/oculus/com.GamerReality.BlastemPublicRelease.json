L0ZpT38IxQMoyqodw9ZeAuNZvvwn0A&oe=69BFD43C"}, "display_name": "Blast'em", "keywords": [], "long_description": "Blast'em is a fan-made game developed by one person, me, @GamerReality on YouTube!\n\nDuel players with the weapons that spawn around you. Move your whole body to dodge the slow-motion bullets from your opponents.\n\n\ud83d\udca5FREE - Completely free with no in-app purchases.\n\ud83d\udca5 1-2 VS BOT - Can you and a friend defeat Bobert the Bot in \"Bot Go Hard\" mode?\n\ud83d\udca5 2 VS 2 - Also works for 1 VS 1 duels.\n\ud83d\udca54 PLAYER FREE FOR ALL - Who will be left standing?\n\ud83d\udca53 VS 3 JUMBO - Everything's bigger!\n\ud83d\udca5REFLECTION SWORD - Block all incoming bullets and speed them up!\n\ud83d\udca5SECRET MODIFIERS - The \"Secrets\" will be clear to people who pay attention.", "short_description": "Get together with your friends, or find players online, and duel your hearts out! With 4 GAME MODES + secret game modifiers, you'll want to play this game over and over. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2b566eb9-e7ce-4cd5-aed5-dea1e1684a46", "developer_terms_of_service_url": null, "publisher_name": "GAMER REALITIES LLC", "support_website_url": null, "website_url": "https://www.youtube.com/@GamerReality", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "661061
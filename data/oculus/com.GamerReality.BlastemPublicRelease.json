4Q4GVii6d9SQgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftgCBxxEjUt3Q4OwAU1iVazudcjh0JVTciPuieW0cgliw&oe=69A2E244"}, {"file_name": "thumbnail 3 free for all.png", "id": "1027932225194069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982602_1027932228527402_3154145990640641483_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4inVBRRnNoQ7kNvwG1EtjL&_nc_oc=AdnnzsIje0hGk9YNvzxht3khq-lGXnxDBtskcgGwivmH8CC5NekbOp3xCd4RNKqGCis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDDaVfuPnQPDcPbzE8gfVkRp-0X710zfrhKlAgo6HwRw&oe=69A2F24C"}, {"file_name": "thumbnail 4 social.png", "id": "1144812016502355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031567_1144812019835688_2228234335877336832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d81Uv8dUMjYQ7kNvwE4hcOo&_nc_oc=Adm8V-L3f7qpieLuHA0iYnACZWyIvIpMJzRYkra7a-n3bbEZC1k6NDLC4seqSYlQYJ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftaZ95v2-Md2QvVys6bKPbHm8-e_HfYZHmuiWqGV0q_wQ&oe=69A2FCF1"}, {"file_name": "thumbnail 5 jumbo.png", "id": "206414519102457", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356793_206414522435790_4588496168591853990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1RLS2ShhioQ7kNvwGwkr0m&_nc_oc=Adm3-vr4yA7l9krf0cETMDWQWLWZd99zH1V5oI-QSoQ9UgNdMepwGUQ5JqaZ-Jr5FYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyBvjdAKzTfPNRqNfryUBQ_1hu7iVeO1L3azSDwgskTA&oe=69A2CECF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image thumbnail for Meta.png", "id": "669643615238767", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210400_669643618572100_6358332256817965062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IklFIz3rFmwQ7kNvwFaWnSs&_nc_oc=Adn7n8Ytbj_bxItW5BSddcONWU_tqOYZgkKDm2oBnckhH-G4K07H9Sh3znlORLL9Hp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvHP3gLjJbPNPpfs4hqfKIwpL1iOmBtPg27aun_ptmTCw&oe=69A2D33C"}, "display_name": "Blast'em", "keywords": [], "long_description": "Blast'em is a fan-made game developed by one person, me, @GamerReality on YouTube!\n\nDuel players with the weapons that spawn around you. Move your whole body to dodge the slow-motion bullets from your opponents.\n\n\ud83d\udca5FREE - Completely free with no in-app purchases.\n\ud83d\udca5 1-2 VS BOT - Can you and a friend defeat Bobert the Bot in \"Bot Go Hard\" mode?\n\ud83d\udca5 2 VS 2 - Also works for 1 VS 1 duels.\n\ud83d\udca54 PLAYER FREE FOR ALL - Who will be left standing?\n\ud83d\udca53 VS 3 JUMBO - Everything's bigger!\n\ud83d\udca5REFLECTION SWORD - Block all incoming bullets and speed them up!\n\ud83d\udca5SECRET MODIFIERS - The \"Secrets\" will be clear to people who pay attention.", "short_description": "Get together with your friends, or find players online, and duel your hearts out! With 4 GAME MODES + secret game modifiers, you'll want to play this game over and over. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2b566eb9-e7ce-4cd5-aed5-dea1e1684a46", "developer_terms_of_service_url": null, "publisher_name": "GAMER REALITIES LLC", "support_website_url": null, "website_url": "https://www.youtube.com/@GamerReality", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "661061159269649"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.577
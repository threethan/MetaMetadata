f&oh=00_AQGFOaBMx03mBxbdWxYijMz1J6JpQVpK48MW3Rj9afysrg&oe=6A91598C"}, {"file_name": "thumbnail 4 social.png", "id": "1144812016502355", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031567_1144812019835688_2228234335877336832_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO8L8QSe8FgQ7kNvwHiB2Hz&_nc_oc=AdrNWNX0RGFp-ePClJiPA-EMT6Nrbxep0IPvRiMg1nnaXpPDarmdQKb4EuW5KMbNGvM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3A8gLT4fLwcsTyxgsxFo4pE9khApf0farYXKAPEQ9fw&oe=6A916431"}, {"file_name": "thumbnail 5 jumbo.png", "id": "206414519102457", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75356793_206414522435790_4588496168591853990_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QWhzWGM8CQQ7kNvwFlF-vB&_nc_oc=AdphY65irdq1uNxCP3ou0bDedpomdUe06n6ZvH0irQrQh41DkT0Y5R4m5JaB0iLpj8E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3O4K96SC_wW9Ld9xrmDMaE1p13P7P88Cn0Tipr3s4ow&oe=6A916E4F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover image thumbnail for Meta.png", "id": "669643615238767", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75210400_669643618572100_6358332256817965062_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKS24JT-nFAQ7kNvwErX3O8&_nc_oc=AdqYsunAbC7Yg5YIDnwCi5bWwzTa4QcW_71r4XcGqxQpt0vU65b6GlxrSFoSTt24DhM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ3ISFVDv7xVMIFeDc5JtaPRONOTQtnirU6raJAGDu5w&oe=6A9172BC"}, "display_name": "Blast'em", "keywords": [], "long_description": "Blast'em is a fan-made game developed by one person, me, @GamerReality on YouTube!\n\nDuel players with the weapons that spawn around you. Move your whole body to dodge the slow-motion bullets from your opponents.\n\n\ud83d\udca5FREE - Completely free with no in-app purchases.\n\ud83d\udca5 1-2 VS BOT - Can you and a friend defeat Bobert the Bot in \"Bot Go Hard\" mode?\n\ud83d\udca5 2 VS 2 - Also works for 1 VS 1 duels.\n\ud83d\udca54 PLAYER FREE FOR ALL - Who will be left standing?\n\ud83d\udca53 VS 3 JUMBO - Everything's bigger!\n\ud83d\udca5REFLECTION SWORD - Block all incoming bullets and speed them up!\n\ud83d\udca5SECRET MODIFIERS - The \"Secrets\" will be clear to people who pay attention.", "short_description": "Get together with your friends, or find players online, and duel your hearts out! With 4 GAME MODES + secret game modifiers, you'll want to play this game over and over. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/2b566eb9-e7ce-4cd5-aed5-dea1e1684a46", "developer_terms_of_service_url": null, "publisher_name": "GAMER REALITIES LLC", "support_website_url": null, "website_url": "https://www.youtube.com/@GamerReality", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "661061159269649"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7410167632334870", "version": "4.0.1"}, "id": "215818271091229", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6931988333486138", "is_conc
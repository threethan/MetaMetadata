h=00_AQDRsi0Rdu3qCKAcmTTxQbytFJYx0gri3W4tdIP_GqHjgQ&oe=6A58DF21"}, {"file_name": "ScreenShot5.png", "id": "1724886268923725", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827611_1724886275590391_5994428573920819042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIcCoSBZM_QQ7kNvwHNeklC&_nc_oc=AdpHoowFjDFi0s7_yhPuuMe8FsQ6znfwNBMokFAJ-akGLrTUE8LT4abvHxqfixr8ax4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnyyqt1EapB2aMgprZuXGWl99meXW64pSoxfSU-DULEQ&oe=6A58DFBE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7usOd2VxwcUQ7kNvwEJNxQh&_nc_oc=AdqQtYNtEfENp6wHvsOWniSePD1R0HIDec0wbSdbebDBOiwRWMAcgeIli29WejnO6aQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcIuvKRwfKW-XxvJJyI8RkdgLD0OA0A1Kae2U97TF56g&oe=6A58D9FE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPxYcJ1izwYQ7kNvwHXljZz&_nc_oc=AdrXsE3Wesxzy6olj8Jh9LnvRYOtQM1ADOyBR-LX8d8svLImcoMT_M5WBd2x3gcNGmM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIjUo6oi42K8S5G1RLvix43_6JJZYlIzJgUkyOyrocbQ&oe=6A58E63D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QR5oy54ijJUQ7kNvwEOkXOy&_nc_oc=AdrSGwY42_TOGv48HboU7QdNO7__LnNsu8X6nPZ2AePRJJAUba_Tns8-nlTi_6V5X2M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIZ6hpRol5cH_Ae1TTLy5nVKt2cdcuYwYBO3OHOSFU2g&oe=6A58F5AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjdgd7t8tsMQ7kNvwF1KO7e&_nc_oc=AdpO_DPu2Zgr-27vimlniUvJk246nj43VM8anz813tS1cdbONQKATS-GP0vZkR-tHco&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr197Ky21OELXdlxXiei9ADabhmN3Hty9H61UDPhLiXw&oe=6A58EE22"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-thi
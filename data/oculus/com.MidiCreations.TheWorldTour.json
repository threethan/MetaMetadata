at=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWjGLj6-mV4Q7kNvwHYu-me&_nc_oc=AdqCNISSN85rKfEWv0HLHYpCo45kboNLBTZihkYqt9siV4RWpsJ6Ch53XGi3zaiS3Wk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y5TQ1zBcVwstVQmS8cFNPs1cZxTc-a8OQ8XlbKEx8Zw&oe=6A393BBE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo5xkZhkVJQQ7kNvwEjCSKh&_nc_oc=Adrl9_kwUV9BmL9NBjg4zoJfJWmmPMJJTN-aoRdU17IB8uHrY_m1GngUsROsPAhHMoM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FdOhCgQ4jWv7TP49atlyrbqg5_-n7pEJyKDG0OnR-5A&oe=6A3935FE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_amSBdHCjUQ7kNvwF17q6e&_nc_oc=AdqHNWbPwRvmdJsswyvkLzXrtlsyC8YHeW9lPXuBJePiTXMr2HbzIYpN6UbQEJIRg1k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ounvNMT-PNzPvAvr-mr5YJFZjBNJ-ZIpphVlKLe90gw&oe=6A39423D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYlJi-QxRVYQ7kNvwHPq3Gi&_nc_oc=AdrPGioaBK4qmm6rrRBxnvIXhy9EGCVprfmbln7oJbozB9saqW-gmiulr9Jek7IW_2M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oRCJC7MdKZSphcy3FAlWCQhQg-nmzwAy1Ytev1MV1Ew&oe=6A3951AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mSz4Hx9I24Q7kNvwHIXzLn&_nc_oc=AdpNSWSXEPY91D42EiSrfjt3r6n3-SIchvHP1SZoCzMUgs5_Wf-s5jWxXY9wk1N7nE8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XiJ5QCBEswQSTJvnfBQ2v_U2hNd0DMkD5k_9-m8eurA&oe=6A394A22"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-this.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfo
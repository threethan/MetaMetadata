qrWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1hH-XAF7IoMtq0sop05JSz_r3JqOXxXKMKj96nJ3k-w&oe=6A2ABB3E"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cTdULLjr4AQ7kNvwGb_KTf&_nc_oc=Adoh0ta5U7sDfw6yrexLW9e3QeFJ8wwYLoQDhNWMgiIDJuLU_Ice5WWp2S-2-szdGxI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LryDBLwesVqZnK1zNmVFwH2skXQkPuluOuyUzsgwevQ&oe=6A2AB57E"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbLuheFBWFUQ7kNvwFOVgrg&_nc_oc=Adq6DCGX8iQecjnHN0Jeg1osSKEomuy3sxP1m6SjRYK_GO4UQkKbogG5-92tjVJ8f30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lZTGCX1pcsQA01HeUtVXTMSUI4p-t2jcFQAh5FPZKpw&oe=6A2AC1BD"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7DVQdK1BTkQ7kNvwHVUvf2&_nc_oc=AdorVjKdqExQ7GUIb6VV_SvB5iGe1zvtEfA-0ZWw-5eyxBJmr480ehV3XiBMfjUe76E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IPskaiPzvei1ZzlIMrIbUFnPzCDJUxeolBMb3xUzLnA&oe=6A2AD12B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l511BUgxi9UQ7kNvwGsIDWB&_nc_oc=Ado_PxAgmhSmxZp5EYrPEsSLt3onf3gsQHalVvQIFB0S7RqV5chnoTyx0Joq4z0e8zU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AVss8-ytt863cVnBsUXGv_810mrVv9j8m6pm9__3t5w&oe=6A2AC9A2"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-this.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "conte
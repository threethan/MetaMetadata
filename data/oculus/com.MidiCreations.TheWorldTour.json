h=00_AQD2SGbgamTDQ7BGnNp14VM12ly-Zu7dvZ_Qr_T4bZbikA&oe=6A6A02A1"}, {"file_name": "ScreenShot5.png", "id": "1724886268923725", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_1724886275590391_5994428573920819042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY7ejydGpnEQ7kNvwFRhI_h&_nc_oc=AdqCjvFn5gaSKSz01o_5cI6-q2DLMYOxAaPyIQfqmSYYaBqr5MvqWxXOOTLitJ6UcLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXIw6lJCth-jYfz3dW4fS-qZiUyqzbkfIzRuKqbsM53g&oe=6A6A033E"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot4lHiDY9iYQ7kNvwEu-2xh&_nc_oc=Adq5oEocnjchjNJZ6uWTbihWbOXqJu5X43RKr5vHmkv0TUwNnuqqplMRSsg3_JJvipk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxmWtvYBcW7Jdu3v0OSgWkbSEFTvkuZmRzDBI7BgVhfQ&oe=6A69FD7E"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGe8MWlzic8Q7kNvwFwQODt&_nc_oc=AdoMfa0ve0lzb-wxsOtDAnJ1rUnIu_BDKb5ybj7MMW5JpcXnuV6zxhFXV7Suemm4dWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXYc4cmybTczqflM5TluBYBuNHAp3ke3KBHynkAx0-Ww&oe=6A6A09BD"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQV8uwEzpb8Q7kNvwEEmYcc&_nc_oc=AdpMMrI_S_jYy-JqPVf5w26Qa8QsgstYs43Kicozra0vo7tG3cO6ut2XQMQu2IfuqCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI3L24273sTyVUwcnGRa27pAgsQFUNR1tXowQk1AknoA&oe=6A69E0EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT9epAN91SIQ7kNvwFfUP7B&_nc_oc=AdpQ3Zdjz0tbnP1ZUZlv_2mSscshfdJQ1pnN-v1pWI8635h8uZd17HykJ_GEaTP-UsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARJmq8qTnOpqXBaNyg552z0x3n_bp3UsYgqa52HForfA&oe=6A6A11A2"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-thi
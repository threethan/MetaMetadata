h=00_AQGj_3bTp03jMONgVOqHT6Mh-r9v5HdnDSmAZ0giWJGRPw&oe=6A709A21"}, {"file_name": "ScreenShot5.png", "id": "1724886268923725", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_1724886275590391_5994428573920819042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQDqc1TBQJ4Q7kNvwGA8jX9&_nc_oc=Adrx8FypFW4If1wAyyXyuCzbkloNaIkTa6DNLuUo1PK2Qewm7ZHASbpzm8nYY0CNadc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZSu3lxkQESQ843wwYOtKqcpYRBm8kgk9HGI6go4LBRQ&oe=6A709ABE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pnmi-VtxvEcQ7kNvwF2nQQb&_nc_oc=AdooOxrcgG79YntI2Q6DlPxjignDfzAZ9esNVDPRWTEqdGJfMjkt5biIz-HwVnZys80&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8g4EEGv_RMZmnicspAw4GE_3yW05nb9bBXeiKSfUpjA&oe=6A7094FE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNl4jgYDkmgQ7kNvwGmWGRU&_nc_oc=AdokCN6Vce9WdgC3-25YdKyMwUfTqawwCDd2zWzt-PKw9nqi35shE8jRXTOAJtbrpyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFReQnLLLl5NPpiP7bWjLN4XOo6IfqirwM0g6gi-_6Ug&oe=6A70A13D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7jcWCiOZCMQ7kNvwFUGwwP&_nc_oc=AdqeiB19zazUsEovjwKzfQmseRaycdTb1bI-qsMAyIKKWsZSRBFJc3Mm9E4sH5fJQlw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpAEQ51L_OzzSTlA5ZM6VKbHeahf0dOaejJoPCZTEIvQ&oe=6A70786B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRwj_SsqSmMQ7kNvwHx-Csa&_nc_oc=AdqkMJ8diYLL2ujiN8NKTlTaHtWrTBqHd_edGJbI4mOedKyraKIJT_pQkPJoKiBOLm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN8UO3KBHV-6v95OrCFf0nJ_0ZIp4VzCzdy1j2LswbdA&oe=6A70A922"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-thi
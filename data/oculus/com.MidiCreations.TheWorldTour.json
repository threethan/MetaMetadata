300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaiQqlaToDsQ7kNvwEFOKPw&_nc_oc=Adr03dbhxlGslbfl8qgt4Ef5cS2CaHq6zCgLiX5FrHi_pz_tMlmOB3ta9vikBa92kl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp6KrMNA4h5gk7qU5CLa8JzD5Tx82NpWRaTt-Qxxhmnw&oe=6A63723D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TwvEHfxuhIQ7kNvwE8N9HQ&_nc_oc=AdrEBsjAQOKTeiSzc-mP93cHHFFQt7K8OHDE_YXfBbSeU-Oo9R8jP7w_5kKG3X55_To&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEPp8__ShXcAEYOpk4gB3wv6pE1sL49mvOvPkv8ZaJIA&oe=6A6381AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoZyFoxUVcEQ7kNvwHex85z&_nc_oc=AdoCr52ceHIMx54QJTnvB2TS5K7z5kzFqx8BT2WhFclrZfJOz6JKEnvTJDWUzlxeBb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZWPKJcJexsAGmmyZB6O-daCN8jtDWXJWoK4SqDiwSkg&oe=6A637A22"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-this.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3250450308471817"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1274131964481966"}]}, "baseline_offer": {"id": "1274131964481966"}, "is_approved": true, "fi
dc6xIHeRZbpCms2CXwKITgydw3CyZp2w&oe=6B03297E"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVnZxZnwuGMQ7kNvwFhBI0f&_nc_oc=AdrzBopfF1-BSJfKkKlQBiQ_xHjYLiWCV7otR2aSrZGsphjNbvmnGoqass8Hqxgahr4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTshZvf91xdYRjSQ4HVNSUfDyxljwZVRD8hOr7vTpEquw&oe=6B0323BE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SquSXeSUogcQ7kNvwH_iVUr&_nc_oc=AdqO_EtqS1YzRN7AeYTr7LzNuqfH4kq_oHd8ytMRcNSP-ZFkuO15Bfo78atdr9l0oVE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST9uamU7SFkN-QKgJn8xTmX9IilD8KVN9P4UTBompCGg&oe=6B032FFD"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NdspNFYEfoQ7kNvwHS6p0P&_nc_oc=AdrECW4JkEmdwl2PT8K2Rx_-IdfiY7mtgTNO-22y1gAKsnlXpc-kcC6aKm6R8CYZiKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbASf7KmJKbfMXV_ylD7FzvXWPA25zfPnBhbli1xwJAQ&oe=6B03072B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6OSal8Dms8Q7kNvwFKb9kC&_nc_oc=AdpoFAjetuVoJHxD0n_3tX83BMzDJ6ajdUIQRn6PHTYGtg_Jer3DNnkSdsSHErWaL2E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe_e-nvRpAT9SX3Im_WQ_4tVatIyzTCA5idt97VDDl8g&oe=6B0337E2"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-this.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_catego
zyhvx6qlyWZEBd7zzjt3IxX03fJMq0rA&oe=6B09C0FE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-27j6TOf0UQ7kNvwHZL5jz&_nc_oc=AdodJ89FKFYlDlRqcs3KQjG6Nn96LF5gwekMAmM_qrXfOHDO6YefqAKeN7mAdS6MQDo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSO3yVS3CjM4cDvbjK3bpNfq9igSXtsgKAIQ5O-slZ4Q&oe=6B09BB3E"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGsQlirHEHwQ7kNvwGHrnzv&_nc_oc=AdrpURA-kUwmANkyU_voEeA1517rbjdhDpf0bwsnyCg0TrsFNrCcUkwxzrEL3OeXYTM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbl69QTkPB3FT6lqKMbrjisoEpCXcM4VBDYaU12FCblg&oe=6B09C77D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmZQqEYVFJgQ7kNvwH5m16Q&_nc_oc=AdqYceYikCjsmm8cncHKJOrOGDzfNmRWZKM_7BaaKGqJRk146Arh_WyZ5MGlOFUHmhU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStmm6BVcJnN8R3BbLTuqr2779xdJHSgASxH62giYCNsw&oe=6B099EAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5qcswoRgfsQ7kNvwHM2fOE&_nc_oc=AdrLHJr08U7AWubBxWaX0xOxuCIMUVszMKbOlM5cF_TyQ9Jf1Toz1P6GtW9DeHy3_us&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbAhlFNsXnNxMs5PNgAXz-uD-avjDouUp6OufGHN5ztw&oe=6B09CF62"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-this.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_catego
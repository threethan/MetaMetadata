at=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o49h1DiR5dcQ7kNvwGGiXxj&_nc_oc=AdpBu1E2l2gHaraadgSz4Z3z3MfygQ4yvMi2vq39ouz8hI9Jq6cef5DXHnMu_BUlC6A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98KXojpxvA9Ql-fIWLvefyedU87ucjBCVCelqaIsGWxA&oe=6A3698BE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JykXiiIzNT8Q7kNvwHyyBsV&_nc_oc=Adqc82HpeGeSqVTrA1wRhknTFG-Kt5Gj0n4feJt1Xu2W_8-CFkudcnv-IdF_Cb74gmQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A8HTpvpRrwcqPR-u-xm67-HazfLmWQSFUQ70IuQctmA&oe=6A3692FE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Khue5EDASSMQ7kNvwEqw20v&_nc_oc=Adq6TCi5eLYmUSjU20sGcWe5qpssu24Xx5t8qFXSeRHjG26aZXQhwAf8OxV9dPtgyOQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-42IrxO5DIM7eF1Vfdch4t88X9wUXFnKyiR5rvo5wLng&oe=6A369F3D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYlJi-QxRVYQ7kNvwF3LZkT&_nc_oc=Adp2kdtM8ZtRWQJOFExsk3egE_HzjyJYqt2mgECxuW7i_zPW4QkyocmN9tpv3a1UkoI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ip4O1OGE4L-mkh-sE4T2EZaxHPjHcwetVei7ScoQD1A&oe=6A36AEAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTw0umxuKK8Q7kNvwEUmaLg&_nc_oc=Adqrfy_lvr107UE7EpRqhpXieFwjxZX5uePK7b2PQVa8K43RyRK72u-LSrkO3JLN-RE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MIuisRzNxAicpWg1Qj9je1ej7sf5T0QIMPRxD251ESw&oe=6A36A722"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-this.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfo
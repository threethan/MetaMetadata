h=00_AQDbiZNyiq5WKQf00jfWpCVIVDuxTZ7rkGwswt--OOYjVg&oe=6A636B21"}, {"file_name": "ScreenShot5.png", "id": "1724886268923725", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827611_1724886275590391_5994428573920819042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YJFVUaS8UAQ7kNvwGsRG7w&_nc_oc=Adr8nmj-CAkkEZPfQSPjI3diRahD2fK6LE67elSZWD1UJHv93ZjxG-1Dqdd1ou4ET_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqpX0Cq2g0zDezGXAx7NCNhgMd2qe7DncwOE_RAWU-zQ&oe=6A636BBE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDOHLM1YPawQ7kNvwEe7qrc&_nc_oc=AdrTowtS04gGUl-SDLFDpjldyRyfdmgUPaxShpP1m99meBgEm-PSjaWuoH7mRC5-AiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDc5uCSUpN1kNVONcKQVaSqA4cqybNNky0xeaXWdR3tTw&oe=6A6365FE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RaiQqlaToDsQ7kNvwEFOKPw&_nc_oc=Adr03dbhxlGslbfl8qgt4Ef5cS2CaHq6zCgLiX5FrHi_pz_tMlmOB3ta9vikBa92kl4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDp6KrMNA4h5gk7qU5CLa8JzD5Tx82NpWRaTt-Qxxhmnw&oe=6A63723D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TwvEHfxuhIQ7kNvwE8N9HQ&_nc_oc=AdrEBsjAQOKTeiSzc-mP93cHHFFQt7K8OHDE_YXfBbSeU-Oo9R8jP7w_5kKG3X55_To&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEPp8__ShXcAEYOpk4gB3wv6pE1sL49mvOvPkv8ZaJIA&oe=6A6381AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoZyFoxUVcEQ7kNvwHex85z&_nc_oc=AdoCr52ceHIMx54QJTnvB2TS5K7z5kzFqx8BT2WhFclrZfJOz6JKEnvTJDWUzlxeBb8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZWPKJcJexsAGmmyZB6O-daCN8jtDWXJWoK4SqDiwSkg&oe=6A637A22"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-thi
h=00_AQFJq27MEwAdfiBtDVN1hvzSKU6BwqNAvqxDiLVlsrwIWQ&oe=6A806C21"}, {"file_name": "ScreenShot5.png", "id": "1724886268923725", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827611_1724886275590391_5994428573920819042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg-mIj9_8oEQ7kNvwF8_3ze&_nc_oc=Adqbel0Bng0bjBjIGocHVNrsMoNz07ot94mvsOyurLe55gqxhw--AuMI0AWCrFI7Rc4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdTP6FZ9P_QB4IrrpKxpKsFo1Wzq0ns4KQfAbaPy5GKA&oe=6A806CBE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akWrwrnqilkQ7kNvwGK6sh6&_nc_oc=AdqiZlwY6DllJ8Ebl0rrIgAHiISVJ-vrx_QYVJBP8LUcXHz9hSrZiZ2YZX5MuQmsLoA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRWH5cJQC98K0BSY1XTDJoXviAK-_UC1PXU6YoGqmGdw&oe=6A8066FE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N4dHbgq_1wQ7kNvwGQKEXz&_nc_oc=Ado9Min5dRthCAwoeTVXvWTSpfsr-3rQ66zUS8Ad2c5-IfwC3DZTLnVt7RdG7PGdxuQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjYCCtJIr8vPf4cJoxLVo5cLJypqcQOpy-4CVGRqo1PA&oe=6A80733D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eNz91EZS6IQ7kNvwEPLJEl&_nc_oc=AdrmtpmkaR7jEPrxi4vy0DaIc6jhDBVzAOZYflDwr4mVjZU-BfP3AlnAMWWiV1KgORU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR4rQatIYQt6chXW1OFRJ7bO0JCt32FnpLlS6TfCavXA&oe=6A804A6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YMhsIt7odQQ7kNvwEkOyq7&_nc_oc=AdrQCU7GIClhnKMdRmBMS-VGP0zIxZU5F_jnZlsRC_59TEw4rkVcA02RY1fMbATFopA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvpnBN2Z3vCMiEUwOn5YaHq3ksMAqXpTFPmI3CVHakXA&oe=6A8042E2"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-thi
h=00_AQBHuH5WYpW43oChxxHZn-l_89d2VMN-MXy-FOoLj-lwKw&oe=6A6DF721"}, {"file_name": "ScreenShot5.png", "id": "1724886268923725", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827611_1724886275590391_5994428573920819042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_qydM_0O-oQ7kNvwEP7ylH&_nc_oc=Adqi-Q0QaSbZHXWIooOkV3mx8CjX-ecSCnsHUu1-SD5cO3fUFtsFNpkiNAhMk-tBthU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyJyo8nu0i0DwufZhAvneCzASmgnJwc8g0cGGbpQsAXw&oe=6A6DF7BE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DqqOtgm988Q7kNvwEvk0vs&_nc_oc=AdqW8UREuJ4a-pMHVlJHtNr0cfdBkl8jlN3c9RFZtqaUCROOX_Ob-s_vPqphDfDo0FM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLfaID62sJ_-lw8zFokJwMPHhSRXpSBjrUFsiZrOsLlg&oe=6A6DF1FE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZCHUe_fUuwQ7kNvwEJC6aP&_nc_oc=AdpJ3xisK20RFZuPgB4uLfvdo2spS7cHIv-55s6cMKApnzGNhMR6m0t9V1YbEXQ5b8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFENIdz05QxMSWmW5c9XD0STYANDgJaUWiU1zAZEbO3w&oe=6A6DFE3D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7jcWCiOZCMQ7kNvwEssKiN&_nc_oc=AdrapIUKXLfuKaym8qpTc6fYAcAlzDz2VSIK6UUtiWpJFDldPNLAiAxU0KeUbykuVXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoFxw85QDXsCpOlUqrKCdY8LHDrnqaXn62Lz7enXpd1g&oe=6A6DD56B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL-yi5Wp78gQ7kNvwFiGWrW&_nc_oc=AdogtXzbWj8Qgo3I7JWO9fkSr4mjgMaOsLokZvVd2fIoPU7fFYuGQV1cekTmgC4USow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6X1TGDCSjcvYuMDLP2htxkz0JENlIEEvjkn1d4ztvRQ&oe=6A6E0622"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-thi
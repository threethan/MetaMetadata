pAaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-fjm5831fyY3H8bp4lhSks2sf3N_nMQ9vle8k9pVkgQ&oe=6A3152BE"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK_YrXrRErYQ7kNvwFs1nVW&_nc_oc=Adppz56ndAjBCzlZicRIHA6qOFpK1zP2tDsiiZWU2ZrftPlbhgA860MijZoRaf_RndQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HhoGwYV_53birovoACDOS6Q9LhYpCC-ogEI2aPQNJyA&oe=6A314CFE"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KG_1wrV3LwAQ7kNvwHnZNmQ&_nc_oc=AdpbA4GzOCV_BQlmKei3AociJCybX7RrM5LOxhqecjtkHAob6oeXA3cMsov6zOL2RV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DeypI2AY7BMhKajGKmmkiEBaJD_YwQ8A_TBgMWNMvAw&oe=6A31593D"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooG5vOI_9-sQ7kNvwGNU6jN&_nc_oc=AdoiE6CGa8hmwMpDpWflcX_jwRYvH1IxzzJ-KqQOZDT9XCCyudU9aMjuOKZUCw_jajY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s0zJ6-BYdUY6aL5LC1FP2rbwgttcls4bYrOiW6CjVhQ&oe=6A3168AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njR7OVjQ1FQQ7kNvwG5ey04&_nc_oc=Adom4gtHzL4iafnZOf-jF3T04Nwbpy4-PjHqOE1OaDdK_bwhceJN8KQnIJmDKASUGLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AFNnm4GPiq1QdST1HoZowJjsYRLpw2_kRLLLRJIavVw&oe=6A316122"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-this.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "conte
h=00_AQDzLXz8SCV7hG_0JupSqiZRL1RuMtF_yYkar0NgDRCeQw&oe=6A675FA1"}, {"file_name": "ScreenShot5.png", "id": "1724886268923725", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827611_1724886275590391_5994428573920819042_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY7ejydGpnEQ7kNvwEj0ofQ&_nc_oc=Adpk7q_1fTAIPft0b4M3t5qsP_vJtnhzHOjdwhXWQ3uP81vWfFRX4uE-pyRHFcavI3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc2-jB48nsQABjbQXHuBoCrVPBqMOmYD2e7dy_94goBA&oe=6A67603E"}, {"file_name": "ScreenShot1.png", "id": "979982444642069", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_979982447975402_916243057432898927_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ot4lHiDY9iYQ7kNvwHAOzMg&_nc_oc=AdoELgHDF5uPUujsfbelXnY81Q5uexdb6rqTv2Af_zVV184y7lsik5UWfhnV2A1-yqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB12ggaywmwhMVPr-85Cgx-qFbXB6jI9PuyRhLZrlxJA&oe=6A675A7E"}, {"file_name": "ScreenShot2.png", "id": "1006300138622967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1006300141956300_1880121200173132832_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqeLArv7vosQ7kNvwHBKKtl&_nc_oc=AdqDQ0_T8diF9eyFs1R4YrxcQ-xDHmci9FYmrUz1u5FvOulA4pt6UMRU00VCENFKvio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA82Ez1X-iRkk8JCG7kWZIV4gxCkLj8S_CNELPXN6RtsA&oe=6A6766BD"}, {"file_name": "ScreenShot4.png", "id": "991886110147089", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620940_991886113480422_3054393367071892557_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRpgrOkLGS8Q7kNvwHn2I8Z&_nc_oc=AdpCbDeos0RcBc6IIL50ClTiMarXEPlE6qGoMoE5DFzc9CVHrmOhD-HrEKZR090lgvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyv75N73amjhbXkyTB6Bl-ncKyvNe0Rb5742VR0wvkrg&oe=6A67762B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1290955722780427", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1290955726113760_5263913140919656770_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQj4VeXGtUQQ7kNvwE-3nlc&_nc_oc=Adqz8-rSACgy7UqDTtGl2TURWGouA1WqVTFsrXQN3z3quqgGfjkGq0jZ8BJPD4dxoN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9W5mFr6mmoxOf3-MmTSYdBXG5YeHwHbe4beLoQ2cGAA&oe=6A676EA2"}, "display_name": "The World Tour", "keywords": ["Travel", "Tour", "Tourism", "Fly", "World"], "long_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world.\n\nThis experience present you 12 famous touristic places to visit and explore, the places are not simply 360 videos, instead the places are recreated using 3D models which create a more realistic experience and sense of presence, here is the list of the places contained on this experience:\n\n- Statue of Liberty (New York City - United States)\n- Eiffel Tower (Paris - France)\n- Christ the Redeemer (Rio de Janeiro - Brazil)\n- Dragon Statue at The Forbidden City (Beijing - China)\n- Kamakura (Kanagawa Prefecture - Japan)\n- Rothenburg ob der Tauber (Bavaria - Germany)\n- Chich\u00e9n Itz\u00e1 (Yucat\u00e1n - Mexico)\n- Colosseum (Rome - Italy)\n- Egyptian pyramids (Giza - Egypt)\n- Taj Mahal (Agra - India)\n- Statue of Carlos Manuel de Cespedes (La Habana - Cuba)\n- Tower of London (London - England)\n\nThis experience do not recreate entire cities that can be quite heavy to do for VR, instead, it presents only the touristic place you want to visit, and it doesn't focus in presenting the place exactly as it is on real life (exact streets or buildings), instead it focus more on presenting the tipical architecture of that place and the touristic attraction you want to see.", "short_description": "The World Tour is a VR experience that lets you visit and explore touristic places from all around the world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-policy-effective-date-thi
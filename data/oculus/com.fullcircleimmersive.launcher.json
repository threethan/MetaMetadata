n_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsu_TbVaVLYQ7kNvwF7VCGj&_nc_oc=AdrtrFD79XKI26wcCp9uHGAB2TfbQ8_I_5XkRGjCu4CsurzZl_OiTmAUqqvicFHdSgg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWbgklYI1LBAlb0jIW7c3o1xZOQHKTHb3AXPgTwfwjZuw&oe=6B0EF7BD"}, {"file_name": "Screenshot 4 - markers and laser.png", "id": "2821669544929294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771231_2821669548262627_4201821782967821139_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxPcpWoN8WgQ7kNvwGwRYns&_nc_oc=Adrb2ovN1X0qn5gjDeG5CTk0yqlnltszLwJL6W5gZXlc0_jsybazd-9rw28O2Anwutk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0ikdScbAFLxKlyN8T0V8GUkS1r9HMG4Ayelcw0O0BHQ&oe=6B0F1D82"}, {"file_name": "Screenshot 5 - finds the Director.png", "id": "1129995409950125", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908771268_1129995413283458_8369417608402857997_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_rJze5pMdIQ7kNvwE3KU54&_nc_oc=AdpZZN-72l12bpPuDRhb-QPz3MBrv3of9isQSdTWJmsPUzKJU7EpjDEQF_uCUsk3BuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLCmOc5W5QoicpzbqYhZgiF_qDErPrbH-AZtRVZxUMVw&oe=6B0EEC58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer cover (2560x1440).png", "id": "1839505577370482", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908771290_1839505584037148_4394136993101675923_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd96uGzqnr8Q7kNvwGgW2HB&_nc_oc=Adpc9ddQTZYBNgVCa9V0HEcPWWGyaYMCvlg-OG8sCtOv9e4nu6y25EMfzNBcHTtkh_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXMMU3i1GGAr9arYi2cN9LIMCqZziKNOPlxCI1KvK7ayA&oe=6B0EFEFF"}, "display_name": "Full Circle Player", "keywords": ["education", "training", "classroom", "360", "immersive"], "long_description": "Full Circle Player is the headset half of Full Circle Director, a free system that lets one person guide a whole room of Meta Quest headsets through 360\u00b0, 180\u00b0 and 3D video and images, all in sync.\n\nOpen Full Circle Player and it finds Full Circle Director running on a Windows PC on the same Wi-Fi, then opens the player for you. Nobody has to type an address. If your network blocks automatic discovery, type the address once and the app remembers it.\n\nOnce connected, the person running the session can:\n\u2022 Play, pause and skip for everyone at the same moment\n\u2022 Recentre the whole group so everyone faces the same point\n\u2022 Point at anything with a laser pointer that every headset sees\n\u2022 Place numbered, coloured markers in the scene\n\u2022 See what each person is looking at, from the PC\n\nBuilt for teaching, training and shared experiences: clinical skills, moot courts, field trips, site visits and more. It works offline on your own router, with no accounts and no cloud. Your content stays on your PC and your headsets.\n\nRequires Full Circle Director (free, from the Microsoft Store) on a Windows PC on the same Wi-Fi network.\n\nFree for personal, education and corporate use.", "short_description": "Join a guided 360\u00b0 session in one tap. Full Circle Player finds Full Circle Director on your Wi-Fi and opens the shared 360\u00b0 video and images for your group."}]}, "developer_name": "Full Circle Immersive", "developer_privacy_policy_url": "https://brucelockie.com/fullcircleimmersive/#privacy", "developer_terms_of_service_url": "https://brucelockie.com/fullcircleimmersive/#licence", "publisher_name": "Full Circle Immersive", "support_website_url": "https://brucelockie.com/fullcircleimmersive/#contact", "website_url": "https://brucelockie.com/fullcircleimmersive/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "e
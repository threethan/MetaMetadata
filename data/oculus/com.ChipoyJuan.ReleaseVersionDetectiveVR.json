y and Minority report: \nAn innovative way to tell a story in Mixed Reality. \n\n\n5 hours of gameplay \n1 story /  6 characters / 13 sequences to explore\n\nDeveloped by Studio Chipo y Juan\nwww.detective-vr.com\n\n{394098327049411}\n{3558589084442203}\n{2577012802499097}\n{958256526118169}\n{1091011716039284}\n{948509294043337}\n{1787907908415999}", "short_description": "A narrative Detective game, where you control time and interview witnesses in Mixed Reality.\n"}]}, "developer_name": "Studio CHIPO Y JUAN & VALEM Studio", "developer_privacy_policy_url": "https://detective-vr.com/privacy-policy-meta-quest/", "developer_terms_of_service_url": null, "publisher_name": "Studio CHIPO Y JUAN", "support_website_url": null, "website_url": "https://detective-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9176528929044612"}}]}, "scheduled_offers": {"count": 34, "nodes": [{"status": "PUBLISHED", "id": "1347708092903053"}, {"status": "PUBLISHED", "id": "1173183440894395"}, {"status": "PUBLISHED", "id": "1060328119692345"}, {"status": "PUBLISHED", "id": "980688904960629"}, {"status": "PUBLISHED", "id": "2734641700235208"}, {"status": "PUBLISHED", "id": "1502447331486207"}, {"status": "PUBLISHED", "id": "1411400761002144"}, {"status": "PUBLISHED", "id": "1209227914665655"}, {"status": "PUBLI
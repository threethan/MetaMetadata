ntent-iad3-1.oculuscdn.com&oh=00_AfvVM_dcFYWmrCeYldN5WWd5leZEiSoGcndwoc3khjLlpw&oe=699DA2B8"}, {"file_name": "Marketing_Image_DetectiveVR_Clue2.png", "id": "4542805432675934", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618817_4542805436009267_8517342833125406042_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Yn0kC8qe3IQ7kNvwG90s49&_nc_oc=AdnUJDJUQMlO1bi3cUxOcFUOw3uF40kBcVquseJIA30mScZp_T4VJWLmJkRTPZ80GHQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftbojWFq1Kc_kfTX6K3dOwFro4PVHAQVjX1YuWd8uKGLw&oe=699DA40C"}, {"file_name": "Marketing_Image_DetectiveVR_Karl_Laura.png", "id": "1887894875108231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618220_1887894878441564_5478101935332394420_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILyMFcQga8UQ7kNvwEoeubw&_nc_oc=AdkN5OeYqN55PD0osIEK7noSSdhqX6u87bONG2CotpujjnPxOsXULRD7Z9_wadMDQCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZzXVfsOLAjksGY-BTl1mLUCYCWAWItdSxIu36ort_5Q&oe=699DA38B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DETECTIVE-VR-couverture.png", "id": "651805304361365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827058_651805307694698_303768030805717222_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gJSQus0wWoQ7kNvwE2ffnG&_nc_oc=AdlRL8X9Z5JsRvt6vWvX9EjcE4EOVhwIU2s3p47MIxWf0KY-eWek1Rkun7fOl4VRCMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvllrhpIsqqocVUwHRuJquLCxRB2RVqKO5QE_YXBNizow&oe=699DA5AC"}, "display_name": "Detective VR", "keywords": ["investigation", "handtracking", "mystery", "puzzle", "story"], "long_description": "**DETECTIVE VR is a narrative investigation in Mixed-Reality** : You can control time, collect clues and interview witnesses in Passthrough.\n\n The investigation takes place in your living room. Explore unreliable testimonies and confront suspects to find out what happened ! \n\n{2615449535307015}\n\n\n\nDETECTIVE VR is designed for **Hand Tracking**\n\n\n\nA mix between ObraDinn/Immortality and Minority report, **an innovative way to tell a story in Mixed Reality.**\n\n{958256526118169}\n\n\n\n**Features**\n- 5 hours of story-driven gameplay\n\n- 1 story /  6 characters / 11 sequences to explore\n- Timecontrol : You can rewind, pause and play the scenes to find the hidden clue in the timeline.\n- Full hand tracking support (for the best immersive experience, we recommend playing this way)\n\n\n\n\n\nMore info and behind the scenes footage :\nwww.detective-vr.com\n\nDeveloped by Studio Chipo y Juan & Valem Studio \n\n{597462166430646}\n\n{1787907908415999}\n\n\n\n\n{3558589084442203}\n\n\n{394098327049411}\n{948509294043337}\n{2577012802499097}\n{1091011716039284}", "short_description": "A narrative Detective game, where you control time & collect clues in VR and interview witnesses in Mixed Reality.\n"}]}, "developer_name": "Studio CHIPO Y JUAN & VALEM Studio", "developer_privacy_policy_url": "https://detective-vr.com/privacy-policy-meta-quest/", "developer_terms_of_service_url": null, "publisher_name": "Studio CHIPO Y JUAN", "support_website_url": null, "website_url": "https://detective-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es", "it", "ar", "nl", "ja", "ko", "fr_CA", "fr_BE"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25603219422615636"}, "review_messages": [
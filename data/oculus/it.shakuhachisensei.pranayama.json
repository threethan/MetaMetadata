.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZFl-ESJPYn7rslTQ4Q7IzfZ980sb_4-3NI7ZTGspLug&oe=6B105381"}, {"file_name": "screenshot-3-giardino-2560x1440.png", "id": "1370603544986396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303445_1370603548319729_2290784137946948605_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C041Db40k0Q7kNvwE3OOZr&_nc_oc=AdpYOvfF1nXydLxc-QZx-Ii2NHavEdygHBdLxFmWc0QW9gyGXsQBgU8245qaxz8ybt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUne8_i-Onjxve8NYr-ZWpJJMEM-HeeDRQxUeTXhA-ukw&oe=6B10631C"}, {"file_name": "screenshot-5-campana-2560x1440.png", "id": "1482917590467673", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673751957_1482917597134339_2023614766594388084_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIRoU64T8hYQ7kNvwGrW5fV&_nc_oc=Adq8aAB3Wosypn0T8zd8BArulCp0YwdhyOq20HV7GW7UMO4U-5hT6Cw87rjQkmHF9gk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUym8_kQ_8wyj0uZehZ4IGuwyZHgCv4zIIgVCE-YE3xdA&oe=6B1039E4"}, {"file_name": "screenshot-2-suizen-2560x1440.png", "id": "1771969287427317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312422_1771969290760650_1462322805610594658_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMH6F1FOVTsQ7kNvwEIkuiP&_nc_oc=AdpjCeVZdOLeZTRCl3unoWT0enckns1IJknTaqHz0w86Ar0rHeYTMtP7U2jXVEwYGhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV2K6tYsXy8AMQrYNaaVnw-cfCmK78M83dAEty52ac1_g&oe=6B105236"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pranayama", "keywords": ["pranayama", "breathwork", "meditation", "relaxation", "shakuhachi"], "long_description": "Pranayama is a guided breathing experience for Meta Quest. Follow a gentle visual guide that grows and shrinks with your breath, in three calm virtual worlds.\n\nGarden (free): a flower garden with butterflies and snails that breathes along with you.\nSuizen: a bamboo forest at sunrise. The sound is a real Japanese shakuhachi flute, played by master Jacopo Saporetti.\nIce and Mountains: a sunset over the snow, with stars and aurora.\n\nWhat you get:\n- Several breathing patterns, from the simple square pattern to a slow 4-7-8 pattern\n- Beginner and expert levels, with a gradual progression\n- Visual guidance, soft sounds and gentle vibration on the controllers\n- Settings that change with each world: volumes, number of elements, language, duration\n- Italian and English, no account, no ads\n\nThe Garden is free. One purchase unlocks the full version: all three worlds, all levels and all breathing patterns. No subscription.\n\nPranayama is a relaxation experience. It is not a medical device, therapy or medical advice.", "short_description": "Guided breathing in three calm virtual worlds, with the sound of a real bamboo shakuhachi flute played by master Jacopo Saporetti. Follow a gentle visual guide that grows and shrinks with your breath."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shakuhachisensei.it/pranayama-app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Shakuhachisensei", "support_website_url": null, "website_url": "https://www.shakuhachisensei.it/pranayama", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1343799732160412"}}]}, "sch
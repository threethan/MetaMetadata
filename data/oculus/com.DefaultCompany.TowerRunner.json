ntent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQv7dOh3fpnwLjFTar6nW98G166KxYWcZI_c-Zeo7iOA&oe=6B104A77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WorldTreeClimber", "keywords": [], "long_description": "Game Rules\nTry not to fall off the path.\nMake the hero jump while moving forward.\n\nThere are enemies standing in the way, but the hero is very strong, so there is no problem even if you hit them.\n\nDefeat the dragon at the top to clear the game!\n\nOperation explanation\nRight hand side Oculus Touch A button (Decision, Jump)\nLeft hand side Oculus Touch stick (left/right) (change perspective mode)\n\nGame Play Time\nAbout 5 minutes", "short_description": "Aim for the sky with the touch of a button! Casual VR game!\n\nUse the A button to make your hero jump.\nJump with the A button and aim for the top of the world tree!"}, {"images": {"nodes": []}, "id": "202727748079833", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WorldTreeClimber", "keywords": [], "long_description": "\u30b2\u30fc\u30e0\u30eb\u30fc\u30eb\n\u9053\u304b\u3089\u843d\u3061\u306a\u3044\u3088\u3046\u30bf\u30a4\u30df\u30f3\u30b0\u3092\u307f\u3066\n\u52c7\u8005\u3092\u30b8\u30e3\u30f3\u30d7\u3055\u305b\u306a\u304c\u3089\u9032\u3093\u3067\u304f\u3060\u3055\u3044\u3002\n\n\u9802\u4e0a\u306b\u3044\u308b\u30c9\u30e9\u30b4\u30f3\u3092\u5012\u3059\u3068\u30af\u30ea\u30a2\u3067\u3059\u3002\n\n\u203b\u9053\u4e2d\u306b\u306f\u6575\u304c\u7acb\u3061\u3075\u3055\u304c\u3063\u3066\u3044\u307e\u3059\u304c\u3001\n\u52c7\u8005\u304c\u3068\u3066\u3082\u5f37\u3044\u305f\u3081\u5f53\u305f\u3063\u3066\u3082\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u3002\n\n\u64cd\u4f5c\u8aac\u660e\n\u53f3\u624b\u5074Oculus Touch \u3000A\u30dc\u30bf\u30f3\u3000(\u6c7a\u5b9a\u3001\u30b8\u30e3\u30f3\u30d7)\n\u5de6\u624b\u5074Oculus Touch \u3000\u30b9\u30c6\u30a3\u30c3\u30af(\u5de6\u53f3)\u3000(\u8996\u70b9\u306e\u30e2\u30fc\u30c9\u5909\u66f4)\n\n\u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\u6642\u9593\n5\u5206\u7a0b\u5ea6", "short_description": "\u7c21\u5358\u64cd\u4f5c\u3067\u697d\u3057\u3081\u308b\u30ab\u30b8\u30e5\u30a2\u30ebVR\u30b2\u30fc\u30e0\u767b\u5834\uff01\n\nA\u30dc\u30bf\u30f3\u306b\u3088\u308b\u30b8\u30e3\u30f3\u30d7\u3092\u99c6\u4f7f\u3057\u3066\u6728\u3092\u99c6\u3051\u4e0a\u304c\u308a\n\u6728\u306e\u9802\u4e0a\u306b\u4f4f\u307e\u3046\u60aa\u3057\u304d\u30c9\u30e9\u30b4\u30f3\u3092\u5012\u3059\u306e\u3067\u3059\uff01"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2021/04/worldtreeclimber.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2021/06/about-world-tree-climer.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "462234722125648"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "482327119527694"}]}, "baseline_offer": {"id": "482327119527694"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1623426360, "status": "PUBLISHED", "id": "482327119527694"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4059667994054847", "version": "0.2"}, "id": "9477569
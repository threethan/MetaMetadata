_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJIYXULJFvpsLDSYL26DPa4w3xafQ3EbOclQHtsJayIQ&oe=6AE9F754"}, {"file_name": "1.png", "id": "1758390982026059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_1758390985359392_7082423130695696972_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_Et1fLGCQkQ7kNvwHoauoq&_nc_oc=AdqNNqC4FXAlZhTQnAJAmh6GTQEsfSGmUYENO0BQW4vH2uLMvqdtUHXsx59nH1IKVw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVtDvrLUH-l-BdAB7ma-Uw4rfV3OAKHhF1HBcasoY4bg&oe=6AEA148E"}, {"file_name": "4.png", "id": "1027067316719921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313072_1027067323386587_2686965807760497586_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GIA78J4QxTkQ7kNvwHiVkFM&_nc_oc=AdrYnDAqUQn7dR9R-73avBlvux7on-9-uD2FfkMGYxTTYAooINkIjlxivaEeE_bI1nQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFUB6IQ7TdEo-OSPJrDUmhZ9Ad38kx7_FK0ftH0Qy2xA&oe=6AE9E5D2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truck VR: Driving Simulator", "keywords": ["truck", "city", "driving", "parking", "simulator"], "long_description": "The most complete truck driving simulator on Meta Quest \u2014 built from the ground up for VR.\n\nTruck VR drops you into the cab of a real truck in a massive open world spanning city streets, open highways, countryside roads, and off-road terrain. Multiple trucks to unlock and drive. Dynamic weather. Full day/night cycle. One seamless world with no loading screens.\n\nSIX MODES. ONE OPEN WORLD.\n\n\ud83d\ude9b Cargo Delivery \u2014 load up and haul freight across the full map. Real routes, real pressure, real satisfaction when you deliver.\n\n\ud83c\udfd9\ufe0f City Driving \u2014 navigate dense city streets with traffic, intersections, and urban chaos. The most immersive city truck experience in VR.\n\n\ud83c\udd7f\ufe0f Truck Parking \u2014 precision challenges in tight real-world environments. Nail the angle, stick the reverse, beat the clock.\n\n\ud83d\udee3\ufe0f Highway Long Haul \u2014 open road, big rig, full throttle. Long intercity routes with real traffic and changing weather conditions.\n\n\ud83c\udf0d Free Roam \u2014 take any truck, go anywhere, drive for as long as you want. No objectives. No limits.\n\n\ud83e\udea8 Off-Road \u2014 leave the road behind. Rough terrain, steep inclines, and conditions that push every truck to its limit.\n\nWHY TRUCK VR STANDS OUT\n\n\u2714 Multiple trucks \u2014 each with unique handling and realistic physics\n\u2714 Full open world \u2014 city, highway, countryside, and off-road in one map\n\u2714 Dynamic weather \u2014 rain, fog, clear skies that change as you drive\n\u2714 Day/night cycle \u2014 dawn, dusk, and everything in between\n\u2714 Built natively for Quest 2, Quest 3, and Quest 3S\n\u2714 No loadi", "short_description": "The ultimate truck driving simulator for Meta Quest VR. Haul cargo, conquer city routes, park with precision, and explore a massive open world \u2014 day, night, and every weather."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gravitylabs1.wixsite.com/website-1", "developer_terms_of_service_url": null, "publisher_name": "Gravity Labs", "support_website_url": null, "website_url": "https://gravitylabs1.wixsite.com/website-1", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1389496707585924"},
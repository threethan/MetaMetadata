40-7fEV2x9NN6Q3jBTMA9nyi8bQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV4saVC37LelD_QxLM86kRcBDM0bCGz_-3D3ut1KoOhGQ&oe=6B103EB1"}, {"file_name": "screenshot_4_type_a_line_2560x1440.png", "id": "1943140833737554", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622162_1943140837070887_7629814476826464088_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhZDnJr56tMQ7kNvwFCmgwp&_nc_oc=AdpZWgLvEqb36a9-vh9NZ7_zhxmN7vV39bHFxy-0kc9DQC6wbTlHD5S94gRQmAwVD9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUz3JfIGew1CB9bfGsPXa0UwJo8SzG9RuwnRuKbbWoHhw&oe=6B10384E"}, {"file_name": "screenshot_5_bot_panel_2560x1440.png", "id": "3271701456355802", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593734382_3271701459689135_1889671939106230208_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh2G1ZCB64EQ7kNvwE7zAmA&_nc_oc=AdoE433a32p7KOc590N3kh3nCUWbDI5Y8CDIsb6uBNwYOto0u0ovNRrKwnifbnX-9XY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXwcCQAF1vNvrLkjmfTpzVMfsU0FvKYl-Td821Znz41ew&oe=6B105757"}, {"file_name": "screenshot_2_singing_closeup_2560x1440.png", "id": "1493393679385270", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620532_1493393682718603_5103176837449858821_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt36b9zkqHsQ7kNvwFlJG7Q&_nc_oc=Adrm0JZwUkPOh-nkI2z915tUQGdUTnnHcGSkffUumRxX9W9VPny5XIGZRhr6y1cMq9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWewT0jmAmbou9xyIUrzrQEMf51XQJQo_BTnE86hSHT-Q&oe=6B106B2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soothing Bots", "keywords": [], "long_description": "Soothing Bots is a mixed-reality music experience for Meta Quest. A choir of kind little robot heads moves into your room and sings you story songs. Wake them, hush them and arrange them with your hands or your controllers.\n\n**Sixteen robots, one neighbourhood.** Every song is sung by the same cast: a family, their grandparents, aunties and neighbours. Meet Teddy, who knows every dinosaur; Grandma Pearl, who can't say no; Grandpa Lou, who runs the diner; and Murphy, the unluckiest delivery driver in town. Each robot has its own voice, face and sparkles.\n\n**Twelve story songs.** Tap Random for an episode such as Free Refills or Murphy's Lucky Day, and the robots act it out as they sing. Or type your own words and the choir sings them back.\n\n**Hands only.** Look at a robot and pinch to wake it. Poke to hush it, or pick it up and carry it. With hand tracking, wave or make a heart and the robots answer.\n\n**Arrange the music.** Choose who sings the tune, change the chords, key and tempo, and edit a robot's line.\n\n**Share a song with one QR code.** A Quest 3 or 3S scans it with the headset camera; on any headset you can type the text code instead.\n\n**Free to download.** A free diamond about once a day makes one new random song. Extra diamonds are optional in-app purchases.\n\nFor Meta Quest 2, Quest Pro, Quest 3 and Quest 3S. No accounts, no ads, and your songs stay on your headset.", "short_description": "A choir of kind little robots moves into your room and sings you story songs. Wake them with a pinch or a trigger pull, choose who sings what, and share a song with one QR code. A free diamond about once a day makes a new random song."}]}, "developer_name": "Clarke Plumo", "developer_privacy_policy_url": "https://clrke.github.io/soothingbots/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Clarke Plumo", "support_website_url": null, "website_url": "https://clrke.github.io/soothingbots/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inte
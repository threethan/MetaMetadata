9125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqEpjYis2xsQ7kNvwHOk8eM&_nc_oc=AdpbITMGJObhPzRRgaYZYDQ99NBlWebNn2SCeYdQurJED3oBg5X_n_nL3Tlth9DOD84&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiCosZOGb7DNE_zcwDu4k6iO60Nn_3XgtaK1M2WPIoRA&oe=6AB128D1"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
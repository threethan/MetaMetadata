nt-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qM0kPh4dkwQ7kNvwGoQQPB&_nc_oc=AdqmLAnFDF3dVtT0Okh5ydlf4DVBZUeSM0qNlvmWQjxyN6Q_wpob3Qjn_NtO1dlzhVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2x21fO9UBaDpGMbakl8B7WcfLvNSEJZIe8n9MwdjT5Yg&oe=69D260A1"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F18ARbh-9aYQ7kNvwHxXTxi&_nc_oc=AdriJcVtAt-Lpy7WymWWwUTFxI-TTxVDahFSN4nHz4PXPVWv7LOa9Mznab6tjEcqwTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0T_dI8SUnjtIY8qt69Mb0olmfsI5KmC6YZnD5RGpQPyQ&oe=69D24EA5"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I28VCPJ1W4Q7kNvwFIlXbD&_nc_oc=AdqNeBVcoub8rJPcdkvTc8oALeo_hATEkZWWTLmI_0J1F-76iwX4XWUg3q02lFLsnhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10fXmqdjPkWqh3T5FLHWfN0EBAC4guBMoSCz4lyFIoEA&oe=69D26991"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lyk7mo0bll0Q7kNvwEt1GvS&_nc_oc=AdoVkUSBRNtc_e33kXtRZ3uXjnVRHbpScRmKrgnZ2nU_zyL1Ca2yC3xRodkJd1Y-gTk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LcGphzXpQ_Jjd9dwPv4UgvbOhv3kOjB8_QH7vcOJ7Og&oe=69D26974"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCXCyc4nQe8Q7kNvwEgcMQh&_nc_oc=Ado-mid0JYTTa3r5CpI-IeLsJ4Z0pjjB-RG0y-2bJMmUWNXYWhmfXSYgygsqnMSNWFw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KCmQODEc5iChav4XmCw4YsOco2TPROrQr0o2TILacwg&oe=69D25B51"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SIT
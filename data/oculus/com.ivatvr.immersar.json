R-lH7jQw&oe=6A297976"}, {"file_name": "screen 3-01.png", "id": "1153496583017249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7-jMsOHweQQ7kNvwEzY_Y3&_nc_oc=AdoT8AwnyAQs2MBgVpilwZySFLur1OSXz_5Nrwnk0DUYNGbGFWMWsc2jW92avW4qnTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I_w4zYYBK-VDxdXEP3uISxvS9wG1RIaGMNeggnEfOMA&oe=6A2963A1"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1K0BHMqfUg0Q7kNvwEXXBFa&_nc_oc=Adr8rPdoWWukkHXGVCmLB0sotIOIcCq1SkCNcJ4Bjzfv4yY_uFlgfCUpwDUY-Tl1wm0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o1NxTozcVZIM3IfT7CRO-qIKtALMTBfFDy7nXMEdu9Q&oe=6A2989E5"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aZSMWpysBKQQ7kNvwEHkg39&_nc_oc=AdoBYXxOIns80H5DW7ce2bICBdj1BMUAh6Ww3sElBh18SkBq60ZzXY2DITpTpostWdM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4xF7MX33m0EWLd9m2KXozYwrx20vKVwLsOxU2c7n_QA&oe=6A296C91"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbtLH1i_1S0Q7kNvwHU6YEd&_nc_oc=AdqRj3LTWitlZO9DovZWnxd9O0QWIweilv7mMWr-8Vcbyf4n31YAIP6fthwB3oqbADs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ndu5aKbbeRQvqW2ezvySrveyucqIA56-wczeJWmwbKg&oe=6A296C74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqzqhkC5zVsQ7kNvwESuFPn&_nc_oc=AdoMgzlfv_Ya-4wN5ZDwfHY-n5b7ttXRHnC8Tdbrd9mwvb8HFoIcrWiWZVH2vOB4SiY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UNf5uu7YjM32lhHCJ4d7FS6FyR9EGcNFc98jI8dLRFw&oe=6A295E51"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
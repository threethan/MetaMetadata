nt-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gegOTNYsw6EQ7kNvwF1MRJD&_nc_oc=AdpfwNohJBSYhSLnPytLpVX4A0-47R9oLLlnTVLAy7h1MfPgMK7dsx-OVNSCxT3fQlc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjOoDa8KqPt294KI4v1-FZK6Fc1aPGyKb-C-LNY7esHg&oe=6ACB8C21"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3bzN8vAvX0Q7kNvwFUPLjr&_nc_oc=AdoRaYLJbGdW32WODbUMXek_g_T6Sj4Qt3HGzs3KN47r0YQ6t6DqoBxWBsrk7LR_lCk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBvzZTRcKN1eaYbrEVvhTv1H-7lnbMBjZR0QkblkAl7g&oe=6ACBB265"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRbLRZChJZUQ7kNvwGzSmsT&_nc_oc=AdovmJ88NsXfLqT5RELFsOEAOeKr6qZucK9ASLQ6pxj-O1EaLIL4OAcO8GYN1azut3Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMhp_SSVeb_r92uAIzmV9j7EPnOhGlFD4GXNLBrjkwkw&oe=6ACB9511"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyhTQ3WwKXgQ7kNvwF3cAsX&_nc_oc=AdpiLyckug4guQLHNpGlWM7WmYUhlg9jgPw9AZxZN9UTpPNaI9LFvyio-JjZ5aTxMac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoEm33SkBHGnJIoGr6n51c16k_bsiiOdMzPyLS8ulacg&oe=6ACB94F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G91puJ3LGOYQ7kNvwF6B9cW&_nc_oc=AdqUsq_Vb-GSfFifPyiRAFx8VGoaN1VxZ376QbB5WHAXGM8vqbuvYdRlmbh06zZFb-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGWV5fZxgEEvFoiVajxZERfGz7WOhy60inUDIHvtW0dQ&oe=6ACBBF11"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SIT
153496583017249", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fexkvxh4GlEQ7kNvwHWnWBL&_nc_oc=Ado9W2SYgZ_ZYw6SbAH_oHPEsagI6jfGtsceGEqlgvIGRvOafBlwFvi7Qz0ZzP1suCs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Y6pLfZtjs84CkGOOEF6slQjbuhHbYGVgHfNjg2Rif1Q&oe=69F204A1"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibBBoDVv8DYQ7kNvwFkgq2E&_nc_oc=AdqLlS5TM7liUMFYL6ApXxHLfrwJihr8ec4iT8C835vFNexp-NQaLzOC_1BOFHbTT3M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3sQaEXrz8Zfd3m3lCCoRi8LRClsH0Cf69_UAPW6dmnhw&oe=69F1F2A5"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2cF0jfhK40Q7kNvwEDU-ZZ&_nc_oc=AdqGpfQ2m1VB9jwTDrr08EOKshXKu5Z4GBTiMbgqHoeG-ai3kHgMFbWCfijXamtpfBg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gumx0qNHc6o4zSI0BkKmpK5yiiaRdC9thBYvXcKIR7g&oe=69F20D91"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c414R-pG7AMQ7kNvwGqogL0&_nc_oc=AdpVLGEVPBtbMEcsL6_Gd_IlPvt525e8mDXW5WeEUtLuSGo3KIMeWvUi70-3dfyv1e4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38xB8pFHUtNNnTDRdm0jpA6DVOFpngyBRY2VEKy44SmQ&oe=69F20D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3GZPgOqjZAQ7kNvwFP8dDV&_nc_oc=AdrHIGVRjpJA-ZGkv3m1MA-FT90GoL8vJTJMmvYDNzT9xaOOALiABrjIlM1xvuoNpGo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2pnz64QYsZJCYQVrxRULO3BIFjOOzTnQgnImVUXQljYQ&oe=69F1FF51"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
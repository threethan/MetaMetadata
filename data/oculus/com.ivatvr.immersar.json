uluscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E11NYUP4XpQQ7kNvwFGEoZs&_nc_oc=AdlCoSNlIUWenDmrFAcTzvdYuy9nycRM32TY03OM2ClWbEF3Hp7vx7eO3LhR4XvBaSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu3oEq0OZHYXCg9CpIsvi5N-lDNJ0Ul8bDn36-Ee_I-7Q&oe=69A6DF21"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qflOgkOQR7sQ7kNvwHWmBb2&_nc_oc=Adn0sM-1G6CHVVxS_1JwWhMThwaeFUbDJrBUcoO98BV84j980t9Nb4FDiJ9OEIICDBc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAV6kKpwHjAUjWCsha6ZxZ8AouSlyCM-az7XJxxkgAHQ&oe=69A6CD25"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vykRtT4_PDUQ7kNvwG7TIig&_nc_oc=AdmD5Na-sYWDRPveoryeYXjG-nHYqX6feNlg7oKVHXq28EAwT0Jd3Rys14xbKKb35wY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftA8XoBaUKjDxcc7L9Yr3Qt_wVFHMTQl_wOJBFKGfOI_g&oe=69A6E811"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXrHl8N1_TcQ7kNvwG-1-dN&_nc_oc=AdmrBnuPe56cRiTkAJfKbLiqf7NGihqqgEpt9HG9xVklaAakPUOHmVm8135Blfhe8R8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftu6Gr4yYJNA4cX1Pc3oDDFDSUx4okPKpKnHBRoPFyjsA&oe=69A6E7F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl9inkNhU7oQ7kNvwHo6go5&_nc_oc=AdkN160CcoZMyxO87Mp_dwkBS2nLI_ijcI0aruvplZGl0cbqN5IUvSJTqo7mRm1W8Rc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvU-zMJZdBVfDIsSCDS0L6R7OQtrHVBG08n0M9m2CpgrA&oe=69A6D9D1"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
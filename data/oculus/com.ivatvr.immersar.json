: "screen 3-01.png", "id": "1153496583017249", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJyQ6-hHJNIQ7kNvwH3zxu2&_nc_oc=AdrBsRtueBEQeIOYQSOdoHIKiZrAJSI7moqDSdbEM7vzabBrnum36wj51aB4LKrUyAs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5N3eghKjO0ahXMYoBfeRiZtL0D3b0VVJpPhbG_HwnHA&oe=69C13D21"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkBPelAKpfEQ7kNvwH6qSQb&_nc_oc=AdqtGQSeatAs0GWXr0Vs8NRV4ROoPbbt3eR7xpBSwEQ4Eb29HafU6cSH_3yM3v6_u0c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxy5juLKgaZCpBlHiKNvQccIpXzlMFfQTgHZjls0srU6A&oe=69C12B25"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRo2sOh_eF8Q7kNvwFiy07k&_nc_oc=AdpVenFigEZBqmnjEfBpNCY2HTk_QHRahDaaTZQaaa8oWGDwai7IcnAT0sptpnrCYks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxdyKdcypHGJhV33Ne1Gtqn9FZI9jpTJbcKtJG8iTah0g&oe=69C14611"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edKFc4pXJFUQ7kNvwHSF4jX&_nc_oc=AdoQmyYIeXmITeOeq0Z6jyBbMPfq7qbkLGqIgXVUT6a6vm7m-m6LPmPjLhOS6xWS-s0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8ubLLFm0sn8UWnQBkgNZLgdu1g_zj9dUdt0s90UZFHw&oe=69C145F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40qUGr2AWUwQ7kNvwE5nivS&_nc_oc=Adq9fM9aKSxOAdjPQz1R55zfvjUMH4FvCz2AYYTi0yfWGHTdJ-BX35Lr31DRlLoNwt8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwmw7ZWw1Rq3j-53lK1abH-NUuPRRhT70RXptO4Jl4wYQ&oe=69C137D1"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": 
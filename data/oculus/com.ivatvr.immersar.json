DjbKPrsg&oe=6A9C2BF6"}, {"file_name": "screen 3-01.png", "id": "1153496583017249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zhOxWeSzxEQ7kNvwGaOev3&_nc_oc=Adr_328O2Inm4h-VGuTnyStaPPuaah1xj62UTvYWzoh0zWdUSGqwo-0KHsLBFcSLg0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBM9vQzy507dremLomHUi1606uIBM93padjspk7TysJg&oe=6A9C1621"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkvQr8vgfNQQ7kNvwHrv6qf&_nc_oc=AdoYeghDXLq-6Y6wrq-20So0ewxByIhlOZaYHoPjqZgu7_u8P_8nLHCW_hLKzGMF7AI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBFVO29fm02Z34s81tQrMARyMVEElbEF2rJo20vcbxfw&oe=6A9C3C65"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyHB4kly1YYQ7kNvwGgD6hZ&_nc_oc=AdrMSCFatDNssl_pxyePoq9WcO9BOV8oMajXsG4DKASWCoa0xRPf7SKuL5A-ieQXQlk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDZNSA9LbVow8Shvlk-FyyExVofNOC_zeYhW6UmAQwBA&oe=6A9C1F11"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FdigHkRR3AQ7kNvwGzj4k4&_nc_oc=AdqHWMMsbG7pFVMA_FiGUKWrMPx-zmozCryPDUmN598wjr-X9OO-MM9q_nvp2obCQ7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzvBffXYPFRZ9N7ymuMrm-XhgDogGacZ3uFH3uRPvSxg&oe=6A9C1EF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XhgWdAAA8doQ7kNvwF9I0az&_nc_oc=AdpsLLMoxH-ciUIMGC6via3pyJqTZDm3dXrupTbSWNRu5iWceETjmAQKD4q3u77yLVE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgBQQheyCCvKCoiig3xvU5XFIHUF6Xapjby1Q64_Hzbw&oe=6A9C10D1"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
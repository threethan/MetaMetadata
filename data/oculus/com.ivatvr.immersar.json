nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWGsQ0SapIuK3tnN8EddcyuDu5LLZJ25mzmN3vc2M4RfA&oe=6B0F09B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bnGFsqXG0oQ7kNvwHxacw_&_nc_oc=AdoYi_NRcMYwTx8UONhqoTLVnsblsLS0Ad85TkOe1im1U0bdHl1DKLsV4Y3QDPUyr_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX7RLt0OJrbwgHjyTCeHpIpJDk66jrqLcOBkhKN4Mk3cQ&oe=6B0EFB91"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114
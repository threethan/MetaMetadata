D_2eZqxA&oe=6ACE44F6"}, {"file_name": "screen 3-01.png", "id": "1153496583017249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gegOTNYsw6EQ7kNvwGAyk9U&_nc_oc=Adp4Obt5UaNiTW-8kmb4GAkS1C43Wr3Xy_8L5IBqkzihBGLwvs_jc4a5yaX7jmbd0uQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1ncMy2FQkmIeBJkkMqlvkUk5hpLvDvRLzem-3py-XQA&oe=6ACE6761"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3bzN8vAvX0Q7kNvwFdq9Ig&_nc_oc=AdpibNdxFd3TRLVehh9TAXu8lHfmqxWTZ7KvfkROJ_jBxulmRRlnn2XrsdSWBRp70xE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0xNOWAZQpxLPrGlt2_AsbUysCyvWN02byGbBdKDDMTQ&oe=6ACE5565"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVRVZ35B7HQQ7kNvwEP2yuL&_nc_oc=AdrLeYvraKDE23WvMUIly9pbGRNqd6Zi0MN6VXY4Ju9lxwQbRST2D_GR7NfRXI2j8_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJcn7HFYVX4MlIqG3apzloSdFTqu-1MfeJsEnngs0QhQ&oe=6ACE3811"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzK_zQwYwHAQ7kNvwGNy7Zd&_nc_oc=Adr0PA6fuzwjAIIZ8HchGqwK0igu4hQULgNtiOUZMhlyKbkm1B6MJhRRi-waD6tJ9eA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8uennvHQdxVxsuNaU3lVyzQnQn5ijCJ3fA_trz4Ypqw&oe=6ACE37F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IlyioHrVsQQ7kNvwFYJgCP&_nc_oc=AdpiFZThUXnOFkuXOKIw2glv8D4rTs93Bgkh49k2qvTL4KMaNxztA5DZWokWkWc422U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzdcCJ5HGA7fHxH3hyDaq6d6M9TJ5_3KDY8ol_QwglQA&oe=6ACE6211"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
jiHAuw3w&oe=69D90DF6"}, {"file_name": "screen 3-01.png", "id": "1153496583017249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rgl8beSz6YQ7kNvwGu4C-s&_nc_oc=AdoheL2vFDFbhrd9NLBP5qnCitd7Djbs0szr_jL3oKJ1WgT1AFdw121qIXwQMzFV4Zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26bVSTYWQGYUf_y_1rjezYbcilPHkI54oMNvRyf39ncw&oe=69D8F821"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYkj7D1-A4AQ7kNvwEagvcD&_nc_oc=AdpM45YIb77jzjRuE58QVE1ncVGLM07CKt4HVtJC48XrXsewLOcPZebb-nHw18ICRI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0avXZN3gmxSN-xJuuooJcPtN8L8A1LzNqWP3vuzYUdHQ&oe=69D8E625"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8ZAHfE1h6gQ7kNvwEDtMBO&_nc_oc=Ado3NZZkMGFtq488LdfwKceiVg28CN1M89DN-70dx4jkn82aRgLHbXu2JaEDOyUVig4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l9yTJXPT2H3SNukjiL0ZJTkgTobj2e6srEb9NJSNaAA&oe=69D90111"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZqfBRjWr4YQ7kNvwEtiNdb&_nc_oc=Adq4kCgsqG1F5MTQ4wuO1JdROZxnovKxzYHlNmgxEdmBIS77EU8qihSpe5GniDOUpiU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HRPpQYuY4MIW9mIZqcO7g0LEWCxVPBcINPD6u8Vd_5Q&oe=69D900F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJbHna7U3iUQ7kNvwEpOYXJ&_nc_oc=Ado4nMBYPTi1T9UAjFl4TxETNkIlKgbqORQpSvnr0WSRNxQuhV5ZJtL8OwF9l1Nvb2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Nq9Uxm29t_oIMlI1Bp40hCJPmRWmuNLvDHjQrM_pfOQ&oe=69D8F2D1"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
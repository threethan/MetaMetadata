: "screen 3-01.png", "id": "1153496583017249", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yak51SdBeJIQ7kNvwHxbSzY&_nc_oc=AdkhkAtmS8ya5avSKmheIav1STCguLBnay7tQ5HipZeBpP8YEqMv8m-IUghJdlOiqto&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afze9f7O-5TKttv0SCJFP3PtuSS6KQM63f2tRPWNNy_Zzg&oe=69AC2521"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amApN53x5z8Q7kNvwEKma4j&_nc_oc=AdmJTsaJGvMUEQbhgC4O2UZ8eve_ituSmgblpc85g6kcm8br9RFMLxBTJRUO6BCS8mA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfztrofTIxVEUKbYfGohN0Q_0gJyAbB6tLuMwWCtditPsA&oe=69AC1325"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ng6M_rQLcQ7kNvwGUeVcv&_nc_oc=AdkqYhVvyiEwi1KycVM8naMmDFsRAdq9whyFfUBdMNoj4WLoxsidkAKWOjOJzWejPUQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyzsZTooEA28v7gzY-8alLdeNJ8k0-7likVJ8ADzjjJfw&oe=69AC2E11"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGu_xdv79GoQ7kNvwFaa6Vj&_nc_oc=AdlqbvPp2sRVAPwXLaGbW82hr2aIXNaGq6UagT4vU1pYBaETyEjdaDDjzqGLUaZbrTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyiwI0whxwx1w9hk0SHXkshZoU5eONxHPVCV9X7XbCqXg&oe=69AC2DF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0V_qPLbGi3UQ7kNvwH037gn&_nc_oc=Adk9CMsVWXnuwbO6crBSn4dC4EHU5PJc6SVX345JYyRSk9nUywkq_o9Pd6nlsVzq_qk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzv-qk6zl--ynY7nQ7TM6oIKpQDymhfGr8-3ETesb7aAw&oe=69AC1FD1"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": 
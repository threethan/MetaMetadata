nt-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2cFSeue7mkQ7kNvwFibxvN&_nc_oc=AdqZZ_3K6igEXN_tCZytPQTcbKqk7oNvv8b2ab5r7ph4-XY7UqouijbKeWXp-ivatPI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mtXOfXDujWdwaSMBe8GoZN5FYn4JsSPfu3gCa_ecq_Q&oe=6A314CA1"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svAu5FThGFEQ7kNvwFnUmar&_nc_oc=AdqqmrPaMTwbGYYBU8avPvgcFW9fh8K4sKFNq5Mqq2O2GNPjooGj2LxUHzinxR6HsNo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O1kN0xIvtVm6Dl6yObzAy-G3d6vOMkdTFmewpMTdFyA&oe=6A3172E5"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YO8Q1VKaV5AQ7kNvwEYQc6u&_nc_oc=AdoEo2O7WMARiEUOjSSbLGJpAq3dn17MhORaF2Wi5d59yK04e85w_y1bW3rc-30L79k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tBninWSOoB8tFIcSXMewugS3r6iG2RSQatPRiqHVBrw&oe=6A315591"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdjyHDkJ7ZQQ7kNvwFDvSvO&_nc_oc=AdrfbTEc0KbEeO5d8FOsd8ZrZov-btvTQwt6IVDnf1L16Tp6z80Mrh1qzYJIDGhPOY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8V1ClcZjvhB-bTOCRK6AGGw6GCf5lcLEv2-Aip7jI36g&oe=6A315574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du4sO835qqgQ7kNvwHC_y1c&_nc_oc=AdouWavjx46izJxYHwrO_jNEjgNRn3NznnS2MDxIDddBBeuJtHQlBPgOy0XwurGDH68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WuWvT9x9zNFfrA6gksuKYma6WCog952YZFzYwVq9rkw&oe=6A314751"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SIT
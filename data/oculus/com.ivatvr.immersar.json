le_name": "screen 3-01.png", "id": "1153496583017249", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yak51SdBeJIQ7kNvwEF0VFn&_nc_oc=Admi9HCOff8sZTi1dV0yIXtvAmjdHGAHnzBdzyGSB4OCvLCptghoBRlYpwfncUDbeZU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJqVck9a2gn-VIqSfq5PjMWy7QlEWow0zDQxD5YLGIag&oe=69AAD3A1"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=amApN53x5z8Q7kNvwEW27A3&_nc_oc=AdkacyZfTptxcBY0KT76CDNt492h28DjzNZtS2A-bQfPGr7zRjxrdfvoml-Q2K1NcQc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkLERh6xJ1eBl7niiO6PVoioM0y2it3Kvb6CkVX0buLg&oe=69AAC1A5"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_ng6M_rQLcQ7kNvwG1ckZV&_nc_oc=Adkv6lpBLtWAAG8WiqkdLwgS7qocb4LHgm5Nsu7vHNpUJs7PR8r71qZbKIq5GR9ZwKk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afyj2to60qH19tJ-R1n2VM_mF0h2Ud9cXWfT1Sk1K0rhBg&oe=69AADC91"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvHUcSgaQnwQ7kNvwGGtU7G&_nc_oc=AdkNy3u05RNajEoJUw9eFvIPaMSR2Ic19cXJYMsvOs7E9nhNs48fOqWm6iv3cfe0uPg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQvE62CsbarNnloOfb_53GJ9W4JT6M9G-hsRf9E46S5A&oe=69AADC74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0pT1dSj62YQ7kNvwF0KHdj&_nc_oc=AdmHpVbTw8nMWyUXNOWPEh3yRVrE50NfZ2yfe7uqPxfN2rmokrFgaDTqgvPQ0vgByWc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtTaKWjMaL5QY2wgL8l-otJfgAh8q1rFqbuQBDi96KOw&oe=69AACE51"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
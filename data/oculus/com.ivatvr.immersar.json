nt-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1153496586350582_7963846537190217401_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIX5kvELzR4Q7kNvwFCSV70&_nc_oc=AdqVhKKFnJeODBVGGhri3g0g1q8R76SB2UvxPncPn7VO0wTEPfo2TSiubw2FAwtqgfQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iRCfCPPy4tXZd-HrrPurOqk4ieIjPNE9mfUgZ-BLWEg&oe=6A47B621"}, {"file_name": "screen 2-01.png", "id": "2332629607136308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392005_2332629610469641_5254077260485528759_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIgH93kJGt8Q7kNvwG4kxRj&_nc_oc=AdoWO5-0V-AQBlZXiNsPmDfF6O8yDCn8lPXPTqpKnBWAfIWQVxzis2Z_CXWZHE2Eqj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QiMbBRqmXj0AIMGrOjl4b5Yt7o_E0w783mU8OBxbgaQ&oe=6A47DC65"}, {"file_name": "screen 1-01.png", "id": "1146074530573938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391958_1146074537240604_7273154211139967875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBAlx04ubtYQ7kNvwEc2FYm&_nc_oc=AdoJw5HxkNnRYXwtjJvtfci9Kk9TpDrVF1sM0WO6jRQ4UrtjKd8_GgFCHpdvBFyGxew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VUhlwZXuregg7wTXc6vOX5zCIfzWhaZm-rIPqkUm9uw&oe=6A47BF11"}, {"file_name": "screen 5-01.png", "id": "1456705855289883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_1456705858623216_5973714354445762501_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aICCdGpsgOQQ7kNvwGFe788&_nc_oc=AdpTk7p1yI10B_aGRI0cxIJbO0WkHU7g0KqYwtXX9PraMHrOTt9hT1peQ3C7ae7pyj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y5B3y4EzoN3ZGY1KiHcBpz8oyPx7w3GoacQ_nHhLI0w&oe=6A47BEF4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen 4-01.png", "id": "2454512651583094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392025_2454512654916427_7667750465215829125_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ITCg1PQsErcQ7kNvwHmq-KG&_nc_oc=AdqCbs48pE1DfHNpSsYuhyv_4cVF7JcRBVySonAyZZvQZvAq4tJPKSMZnXtLYRPWlT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yCiZJEV8rfPLS4Df-0grHxW3FWUA43bK_BVRiIjYC1A&oe=6A47B0D1"}, "display_name": "Immersar", "keywords": ["immersar", "tade", "music", "vrmusic", "cyberpunk"], "long_description": "This game-like experience invites users to explore intricate cyberpunk cityscapes and ethereal space scenes, each environment synchronized with the album\u2019s dynamic soundscapes. Through the seamless integration of interactive VR features, Immersar pushes the boundaries of how music is experienced, transforming sound into a fully immersive 3D world, breaking free from traditional formats and redefining the way we connect with music in the digital age.", "short_description": "Immersar is a VR platform enabling musicians to create immersive, interactive 3D music experiences. Transforming traditional music videos into dynamic VR journeys, the platform debuts with Tade's new album, Beyond. Available on Oculus Quest, Beyond combines ambient electronic music with cinematic, cyberpunk-inspired visuals, offering an unparalleled audio-visual adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex immersive", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SIT
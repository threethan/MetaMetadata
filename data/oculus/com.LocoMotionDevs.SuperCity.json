.com/v/t64.5771-25/499618288_1936151183939613_8278193705800201390_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg0OpFM9WrkQ7kNvwHEMah-&_nc_oc=AdrUVD60epnnHLNoJnva0QG3N2xLE-Bv8wSYoGCrNVfFXkU_O_9SvZRuHUhfWy3avgc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgJzD15xtRKxC0MSa2VIW6V7hXQDald5ib30VDLncvjQ&oe=6A53A502"}, {"file_name": "6.png", "id": "1862450057756143", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620414_1862450061089476_2274866762566953170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8B9EF_EOY1MQ7kNvwG3bxdf&_nc_oc=AdoYqEviXmS4gzMOyC_B7ABLYp5AQ-cLvuha5nw9LJyH-P-o4RFn66RtTA_3WP8as3k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcnb3v2_-FiENMk48LSyCFWMFCAq-21tm_AI69B8h75Q&oe=6A53A95D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "iron-zeroes-landscape.png", "id": "1752899205904744", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622211_1752899209238077_6038602367442909967_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyVRaXckuBoQ7kNvwGRrDlt&_nc_oc=AdqdiA_70gkxZSAOjMxOSi81OIxVqYFJU2akt06n9owtn2KEVWy5IXG6GW7Gj-HgGPQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOrcVMj0mmwfAi94opOZCmdGOvx9q-4ITiTmn_7A8W8w&oe=6A53843B"}, "display_name": "Super City", "keywords": ["Gorilla", "Villain", "Superpower", "Webs", "Hero"], "long_description": "                                                                                                                                                                                                                                 \n\n\n{26525840317008409}\n\n# Become a supervillain.\nPlay as a biological experiment released by the nefarious Dr. Suffer to wreak havoc across the city. Fly around the city using superpowers to do anything you want - see the sights, race your friends, destroy the world!\n\n# Tons of powers.\nPick any superpower you want! There\u2019s currently 23 unique superpowers in the game, with more being added constantly.\n\n{962573926331036}\n\n# Create havoc, get rich.\nUse your powers to smash any object in the city, from cars and pedestrians to ginormous bosses threatening to be even evilier than you!\n\n# Upgrade your powers.\nSpend your hard earned cash to upgrade your powers. Each power has a unique upgrade tree, pick different paths to customize your build!\n\n{900881772796736}\n\n# Team up with friends.\nHang out with your friends, race each other with superpowers, or team up to fight giant bosses. Show everyone all your cool cosmetics!\n\n# Join our Discord.\nSuper City is in Early Access, so there\u2019s a lot of new content coming soon. Tell us what you\u2019d like us to add next! https://discord.gg/tqPj7xvdRP\n", "short_description": "Master superpowers and fly through the city! Team up with your friends in online multiplayer, and work together to destroy the city, fight enemies, and collect cash. Prove you\u2019re the strongest supervillain in Super City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.locomotiondevs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Loco Motion Devs", "support_website_url": null, "website_url": "https://www.locomotiondevs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "u
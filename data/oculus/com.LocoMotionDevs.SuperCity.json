uscdn.com/v/t64.5771-25/499619677_1262544258539469_7206867018906437656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zURmnaHTyVMQ7kNvwFCpsFj&_nc_oc=AdrQgzep6cyqxuqVDTv78iBPzabLFk7aibar-GzHlWmKrtVxDqhdUo5uDr1NNdoBzIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jplS3dNI9gLr6F-uab_MW4Fg_9bqUYk_W03Swc7kAJQ&oe=69EA11F9"}, {"file_name": "1.png", "id": "1618308246469581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618264_1618308249802914_5122269551872061522_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BcvtQ8qc-4Q7kNvwGXG6V_&_nc_oc=AdpkR9tfpSHM25cmCwiKVLLjjeGbyLpF5xSsYddUSTN7uK_wDZQtmSBHnzLsF0fKgz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0befs4c1TCeqpRE9NG4HXHQ1wQeOP-UyhoTitBYTpRuQ&oe=69EA39B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape-png.png", "id": "1586632699093883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618432_1586632702427216_3626305590758992741_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxvFm5A6trkQ7kNvwF1C40R&_nc_oc=AdrarP2t2jjF_7gngvOaTLyZo-6Yrq6_-fsenDbxMKvUMrFX-lIyGE-Lq8coWEpp00Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GyqUzE3rYH843DAz2gVLcJIFFtrCb9CxHJKW6kzfiyw&oe=69EA1D21"}, "display_name": "Super City", "keywords": ["Superhero", "Gorilla", "Villain", "Superpower", "Webs"], "long_description": "                                                                                                                                                                                                                                 \n\n\n{26525840317008409}\n\n# Become a supervillain.\nPlay as a biological experiment released by the nefarious Dr. Suffer to wreak havoc across the city. Fly around the city using superpowers to do anything you want - see the sights, race your friends, destroy the world!\n\n# Tons of powers.\nPick any superpower you want! There\u2019s currently 12 unique superpowers in the game, with more being added constantly.\n\n{962573926331036}\n\n# Create havoc, get rich.\nUse your powers to smash any object in the city, from cars and pedestrians to ginormous bosses threatening to be even evilier than you!\n\n# Upgrade your powers.\nSpend your hard earned cash to upgrade your powers. Each power has a unique upgrade tree, pick different paths to customize your build!\n\n{900881772796736}\n\n# Team up with friends.\nHang out with your friends, race each other with superpowers, or team up to fight giant bosses. Show everyone all your cool cosmetics!\n\n# Join our Discord.\nSuper City is launching in Early Access this Spring, so there\u2019s a lot of new content coming soon. Tell us what you\u2019d like us to add next! https://discord.gg/tqPj7xvdRP\n", "short_description": "Master superpowers and fly through the city! Team up with your friends in online multiplayer, and work together to destroy the city, fight enemies, and collect cash. Prove you\u2019re the strongest supervillain in Super City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.locomotiondevs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Locomotion Devs", "support_website_url": null, "website_url": "https://locomotiondevs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supporte
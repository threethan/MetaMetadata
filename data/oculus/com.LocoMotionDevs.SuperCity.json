nvFbCSyfaXZBlEThQLY5-wA-XjF8e-dUMTuYA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzNWDh5jCzoaX-2WdXB2QinWACkDcJt2ML0sArkYe-lQ&oe=6A85A2F9"}, {"file_name": "1.png", "id": "1618308246469581", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618264_1618308249802914_5122269551872061522_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDqdYuTtPrcQ7kNvwHaZulj&_nc_oc=Adoh2doJwHvJ3QX0vs2cRo5KhbZajxN3wLexs_KOHsIMlo1W99SvYrLZAOgXEcGxjqE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmGux_8D69W_ZKsUjeMy8zd-vxRhmiRb3b8XozoGKU3Q&oe=6A859278"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumbnail.png", "id": "910269598290412", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620965_910269601623745_5742337069317646159_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zpnpxK2A6YQ7kNvwE9OstB&_nc_oc=AdoNXzW0cpDUvnSxMCWuxZZNzKYNWAvO7fORC7eiAv47vC0UAk4A_cMzOKyWSXXRKCM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHuWwebSXTCy8v3CsG6OB4SevW5GAac25shytSi2gZUQ&oe=6A85A0DD"}, "display_name": "Super City", "keywords": ["Superhero", "Gorilla", "Villain", "Superpower", "Webs"], "long_description": "                                                                                                                                                                                                                                 \n\n\n{26525840317008409}\n\n# Become a supervillain.\nPlay as a biological experiment released by the nefarious Dr. Suffer to wreak havoc across the city. Fly around the city using superpowers to do anything you want - see the sights, race your friends, destroy the world!\n\n# Tons of powers.\nPick any superpower you want! There\u2019s currently 16 unique superpowers in the game, with more being added constantly.\n\n{962573926331036}\n\n# Create havoc, get rich.\nUse your powers to smash any object in the city, from cars and pedestrians to ginormous bosses threatening to be even evilier than you!\n\n# Upgrade your powers.\nSpend your hard earned cash to upgrade your powers. Each power has a unique upgrade tree, pick different paths to customize your build!\n\n{900881772796736}\n\n# Team up with friends.\nHang out with your friends, race each other with superpowers, or team up to fight giant bosses. Show everyone all your cool cosmetics!\n\n# Join our Discord.\nSuper City is just getting started, there\u2019s a lot of new content coming soon. Tell us what you\u2019d like us to add next! https://discord.gg/tqPj7xvdRP\n", "short_description": "Master superpowers and fly through the city! Team up with your friends in online multiplayer, and work together to destroy the city, fight enemies, and collect cash. Prove you\u2019re the strongest supervillain in Super City! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.locomotiondevs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Locomotion Devs", "support_website_url": null, "website_url": "https://locomotiondevs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "2710427532541308"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER"], "id": "25404867029199135"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1291196882875150"}, {"sta
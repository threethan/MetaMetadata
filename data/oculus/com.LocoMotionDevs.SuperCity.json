iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNtIGdO4LOzAtxxq3tQLnk06UqemhXrdhCeExXc13iTA&oe=6B007EB6"}, {"file_name": "5.png", "id": "1737889310851718", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620965_1737889314185051_8738522319828446785_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7M9hE9sQAhwQ7kNvwGIkW3a&_nc_oc=AdpyZqkJQenFhwHsaj_v_5rItkxWxum4NVIrYF3O7vEB1gzRS3Xl-F9EqWTF5Umpc-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5Zr6I92Z4FFKydt3SfK8V5kH2YA0y3jytHalZ5dgVMQ&oe=6B0085D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "1507852201393729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620630_1507852204727062_8080169357601859515_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo9jrZk8r_kQ7kNvwHsNnUg&_nc_oc=Adqdc0K41xtMC-MRdkdkSM4AhukWNkdm8x6id6HA4qF5W-KPknr1UiYrBCwq4R-K8AI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlkEUjx6Z9zQVvZyr9-JkcLQytOE4s_cHohSO4egalXQ&oe=6B0067B6"}, "display_name": "Super City", "keywords": ["Gorilla", "Villain", "Superpower", "Webs", "Hero"], "long_description": "                                                                                                                                                                                                                                 \n# Join our Discord.\nSuper City is in Early Access, so there\u2019s a lot of new content coming soon. Tell us what you\u2019d like us to add next! https://discord.gg/tqPj7xvdRP\n\n{1555585783025288}\n\n# Become a supervillain.\nPlay as a biological experiment released by the nefarious Dr. Suffer to wreak havoc across the city. Fly around the city using superpowers to do anything you want - see the sights, race your friends, destroy the world!\n\n# Tons of powers.\nPick any superpower you want! There\u2019s currently 36 unique superpowers in the game, with more being added constantly.\n\n{2300377874121256}\n\n# Create havoc, get rich.\nUse your powers to smash any object in the city, from cars and pedestrians to ginormous bosses threatening to be even evilier than you!\n\n# Upgrade your powers.\nSpend your hard earned cash to upgrade your powers. Each power has a unique upgrade tree, pick different paths to customize your build!\n\n{1376867871042180}\n\n# Team up with friends.\nHang out with your friends, race each other with superpowers, or team up to fight giant bosses. Show everyone all your cool cosmetics!\n", "short_description": "Master superpowers and fly through the city! Team up with your friends in online multiplayer, and work together to destroy the city, fight enemies, and collect cash. Prove you\u2019re the strongest supervillain in Super City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.locomotiondevs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Loco Motion Devs", "support_website_url": null, "website_url": "https://www.locomotiondevs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "29395286140157184"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-
scdn.com/v/t64.5771-25/499618288_1936151183939613_8278193705800201390_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR9KrphRu60Q7kNvwHIhEpL&_nc_oc=AdqVe-HhFgw_9IvpycgXbSLbv0Rzd0WGoZXmZ26v_tdwDI4hBe93Nhz_LZ7LTG0sWME&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_S86Ftjm821pw1OnasHrjfVOOt0Ch7diKgrngb_ISKYw&oe=6A22DD82"}, {"file_name": "6.png", "id": "1862450057756143", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499620414_1862450061089476_2274866762566953170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKSyQ2A0viYQ7kNvwGU_2S5&_nc_oc=AdpBlZ2-zUpHJVKddkDULobbgHJICRBmn6kCvpU_5eFbmp8Ss8z3a1AlO7QdOOxoGiM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ShydUfGP8FWde4X5qBkoM2Rs4koIBKXOMuLFsy0ZS4Q&oe=6A22E1DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "space-forces-landscape.png", "id": "1698325281376441", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623384_1698325284709774_2639412394995974500_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLiE68dKJnAQ7kNvwGhAknX&_nc_oc=AdrwyD0alIubYQHKcC8BCLW23byDunXRSzhHWi4mIIGtFiO2oBpF7Ap5J56NVw6d7B8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wPKMS2ojmBl5zaOlFiv4vHh7zeHSOsGbYxAPXLKpaIA&oe=6A22EA08"}, "display_name": "Super City", "keywords": ["Gorilla", "Villain", "Superpower", "Webs", "Hero"], "long_description": "                                                                                                                                                                                                                                 \n\n\n{26525840317008409}\n\n# Become a supervillain.\nPlay as a biological experiment released by the nefarious Dr. Suffer to wreak havoc across the city. Fly around the city using superpowers to do anything you want - see the sights, race your friends, destroy the world!\n\n# Tons of powers.\nPick any superpower you want! There\u2019s currently 18 unique superpowers in the game, with more being added constantly.\n\n{962573926331036}\n\n# Create havoc, get rich.\nUse your powers to smash any object in the city, from cars and pedestrians to ginormous bosses threatening to be even evilier than you!\n\n# Upgrade your powers.\nSpend your hard earned cash to upgrade your powers. Each power has a unique upgrade tree, pick different paths to customize your build!\n\n{900881772796736}\n\n# Team up with friends.\nHang out with your friends, race each other with superpowers, or team up to fight giant bosses. Show everyone all your cool cosmetics!\n\n# Join our Discord.\nSuper City is launching in Early Access this Spring, so there\u2019s a lot of new content coming soon. Tell us what you\u2019d like us to add next! https://discord.gg/tqPj7xvdRP\n", "short_description": "Master superpowers and fly through the city! Team up with your friends in online multiplayer, and work together to destroy the city, fight enemies, and collect cash. Prove you\u2019re the strongest supervillain in Super City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.locomotiondevs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Loco Motion Devs", "support_website_url": null, "website_url": "https://www.locomotiondevs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "suppor
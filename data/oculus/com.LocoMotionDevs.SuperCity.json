tent-ord5-3.oculuscdn.com/v/t64.5771-25/499618288_1936151183939613_8278193705800201390_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNwdOSne0lQQ7kNvwFu4CUZ&_nc_oc=Adr515MmmhdlBhWWRCo2DKolSfw5VYHg48F5oEzQYvTW4CpK3vknI11caoBiOV4cLqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zhtnrl1WBR6O5dE_OEHw1BCbI9jGNJ4viFvtUOWe2Ug&oe=6A3FDE82"}, {"file_name": "6.png", "id": "1862450057756143", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620414_1862450061089476_2274866762566953170_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUsJVrNchCMQ7kNvwF3ySto&_nc_oc=AdromYY7h96PbmE2yySLarnvwA3g5YgqAUOE8Oow3A9b_hzSJQEb0rJoKUZhMS8HgdY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O1HC9kpsjjr_nGXfe2uFLm5ZYm-sOh9mQ3-BAw4KjNA&oe=6A3FE2DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "indestructible-2-landscape.png", "id": "1378168114126907", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623601_1378168117460240_8288868949472605119_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWBI3xf1Zb0Q7kNvwFfrMfT&_nc_oc=Adobvfgd_4aLeRg0vf5enW4Ze74LFLpblCQTlHosqwN7XqIXAGbiopdsDV7MD6KtTd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n1ML-YrwjT7nfVpDStQZ7HUTfKTUvzCH6KNZ9PFKY_w&oe=6A3FF1E0"}, "display_name": "Super City", "keywords": ["Gorilla", "Villain", "Superpower", "Webs", "Hero"], "long_description": "                                                                                                                                                                                                                                 \n\n\n{26525840317008409}\n\n# Become a supervillain.\nPlay as a biological experiment released by the nefarious Dr. Suffer to wreak havoc across the city. Fly around the city using superpowers to do anything you want - see the sights, race your friends, destroy the world!\n\n# Tons of powers.\nPick any superpower you want! There\u2019s currently 21 unique superpowers in the game, with more being added constantly.\n\n{962573926331036}\n\n# Create havoc, get rich.\nUse your powers to smash any object in the city, from cars and pedestrians to ginormous bosses threatening to be even evilier than you!\n\n# Upgrade your powers.\nSpend your hard earned cash to upgrade your powers. Each power has a unique upgrade tree, pick different paths to customize your build!\n\n{900881772796736}\n\n# Team up with friends.\nHang out with your friends, race each other with superpowers, or team up to fight giant bosses. Show everyone all your cool cosmetics!\n\n# Join our Discord.\nSuper City is launching in Early Access this Spring, so there\u2019s a lot of new content coming soon. Tell us what you\u2019d like us to add next! https://discord.gg/tqPj7xvdRP\n", "short_description": "Master superpowers and fly through the city! Team up with your friends in online multiplayer, and work together to destroy the city, fight enemies, and collect cash. Prove you\u2019re the strongest supervillain in Super City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.locomotiondevs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Loco Motion Devs", "support_website_url": null, "website_url": "https://www.locomotiondevs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"
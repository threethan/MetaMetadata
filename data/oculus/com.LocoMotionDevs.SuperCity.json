99619113_2050361545688766_6142627562992658474_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Njg4-3mStdMQ7kNvwGHwp3n&_nc_oc=Adq1NKzluekSPW1AMjd6FH-X55_SZWurg2md65adVR7ljP_88tKAi2eynT9D1TM8WS8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp83r7MHk7mAomamc1LRIy1PPsvp4pnX8EK3v6Ebw_qQ&oe=6A86FC76"}, {"file_name": "5.png", "id": "1737889310851718", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620965_1737889314185051_8738522319828446785_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOU-AU8B2JgQ7kNvwEAWgKB&_nc_oc=Adpx9HKJpw-ccwKXwFFWN0m75Qxb6SOoGN8d3PtCosTtj4T-FkNvqcWcN7T9aCl-39M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEE9lkGLljHiHCeUTkOYaJhs4IsijxcXJqD9I_A-uDA6w&oe=6A870390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "4018113024989170", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499313107_4018113028322503_2813510570345597520_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auIKUBA9OuoQ7kNvwHLogdb&_nc_oc=AdqG59uFx5dHdGfXLClglkxm0tgJWfKjm4cLKRLnthVlwc2CUQyfj9NdaJTtsnVQV-o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvE_ZDODk0tgWH94jMDP2Ge7cxvOliBfAr2DU_W608vg&oe=6A86D674"}, "display_name": "Super City", "keywords": ["Gorilla", "Villain", "Superpower", "Webs", "Hero"], "long_description": "                                                                                                                                                                                                                                 \n# Join our Discord.\nSuper City is in Early Access, so there\u2019s a lot of new content coming soon. Tell us what you\u2019d like us to add next! https://discord.gg/tqPj7xvdRP\n\n{1555585783025288}\n\n# Become a supervillain.\nPlay as a biological experiment released by the nefarious Dr. Suffer to wreak havoc across the city. Fly around the city using superpowers to do anything you want - see the sights, race your friends, destroy the world!\n\n# Tons of powers.\nPick any superpower you want! There\u2019s currently 26 unique superpowers in the game, with more being added constantly.\n\n{2300377874121256}\n\n# Create havoc, get rich.\nUse your powers to smash any object in the city, from cars and pedestrians to ginormous bosses threatening to be even evilier than you!\n\n# Upgrade your powers.\nSpend your hard earned cash to upgrade your powers. Each power has a unique upgrade tree, pick different paths to customize your build!\n\n{1376867871042180}\n\n# Team up with friends.\nHang out with your friends, race each other with superpowers, or team up to fight giant bosses. Show everyone all your cool cosmetics!\n", "short_description": "Master superpowers and fly through the city! Team up with your friends in online multiplayer, and work together to destroy the city, fight enemies, and collect cash. Prove you\u2019re the strongest supervillain in Super City!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.locomotiondevs.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Loco Motion Devs", "support_website_url": null, "website_url": "https://www.locomotiondevs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULT
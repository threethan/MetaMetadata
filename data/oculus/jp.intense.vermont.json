IwBYNTO8jrj_UimmDo5aZVFKthwwcXP6i4Q&oe=6A857EB2"}, {"file_name": "7.png", "id": "216208481346806", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974535_216208484680139_5562691175683597091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXtDheNlQPgQ7kNvwEl86h0&_nc_oc=AdqAQOgZrN_pIxwf1UEp72UDfl0c14X9JERCMXTRcE9ryskZFoEe9CrzkekMiH8ZRBA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnrF25x7cilKygv-5uDoWg1wPr8J1ObY09dwtU-0es_g&oe=6A8589FA"}, {"file_name": "5.png", "id": "918833819221529", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982722_918833822554862_6415469740659612743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfpNgcMtmWEQ7kNvwGrVvLy&_nc_oc=AdoCnAY4re3Jj3v9jCPHi_OLwTe00uEJ6lZeIN_rOICKzZhP1JYgCgpCPxeUecHDaVU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgF9vdyyqQln06pxRZJS6c-kKAJpTwk0ySr8MlTT6y8w&oe=6A85AA36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc_2560x1440.png", "id": "256040350450641", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75322597_256040357117307_6214061246411602701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9XZLx_4h4sQ7kNvwG1njjB&_nc_oc=AdpJ8fbBAzsnf1Y0lICBCn6sobuWekPceVPEmpCTxyelq4Eo82p_O3BrQxXXvoYKUyk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwJxySURjkHhy2GoXh57Ipa1F4l_GUW3BCWMalbBceuw&oe=6A85A082"}, "display_name": "Home Run Derby: vs Fairy Tales", "keywords": [], "long_description": "Intense VR Home Run Derby Game Begins Here!\nThe pitchers you'll face are famous characters from fairy tales. They'll throw absurd and unpredictable magic pitches. Stay in the ultimate state of concentration, the \"Zone,\" and hit home runs with precision!\n\n<Features>\nOnly Home Runs Matter:\nYou should aim for nothing but home runs. Anything else is just a mistake.\nUnreasonable Magic Pitches:\nThe fairy tale characters show no mercy. Challenge yourself with extreme difficulty.\nEnter the Zone:\nBy focusing your concentration to the extreme, time will feel slower. Enter the Zone and face the magic pitches.\nVaried Bats and Growth Elements:\nBy using the money earned in the Home Run Derby, you can buy bats and items that will greatly enhance your hitting abilities.\n\n<Notes>\nIf you enjoy the challenge of unreasonable difficulties, try clearing the game without using the Zone.\n\n<Synopsis>\nOnce upon a time, in a certain place...", "short_description": "Intense VR Home Run Derby Game Begins Here!\nThe pitchers you'll face are famous characters from fairy tales. They'll throw absurd and unpredictable magic pitches. Stay in the ultimate state of concentration, the \"Zone,\" and hit home runs with precision!"}, {"images": {"nodes": []}, "id": "5969940213110108", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Home Run Derby: vs Fairy Tales", "keywords": [], "long_description": "\u8d85\u9ad8\u96be\u5ea6\u7684VR\u5168\u5792\u6253\u6bd4\u8d5b\u5728\u6b64\u5f00\u5e55\uff01\n\u4f60\u5c06\u4e0e\u77e5\u540d\u7684\u7ae5\u8bdd\u89d2\u8272\u6240\u5145\u5f53\u7684\u6295\u624b\u4eec\u8fdb\u884c\u5bf9\u51b3\u3002\u9762\u5bf9\u7740\u8352\u8bde\u4e0d\u7ecf\u7684\u4e0d\u5408\u7406\u9b54\u7403\uff0c\u5728\u6781\u81f4\u7684\u4e13\u6ce8\u72b6\u6001\u4e0b\u8fdb\u5165\u201cZone\u201d\uff0c\u6355\u83b7\u4f4f\u7403\u5e76\u4e0d\u65ad\u51fb\u51fa\u5168\u5792\u6253\uff01\n\n\u3010\u7279\u70b9\u3011\n\u53ea\u9700\u5168\u5792\u6253\uff1a\u4f60\u5e94\u53ea\u8ffd\u6c42\u5168\u5792\u6253\uff0c\u5176\u4ed6\u7684\u90fd\u662f\u5931\u8bef\u3002\n\u4e0d\u5408\u7406\u7684\u9b54\u7403\uff1a\u7ae5\u8bdd\u89d2\u8272\u4eec\u6beb\u4e0d\u7559\u60c5\u3002\u6311\u6218\u8d85\u9ad8\u96be\u5ea6\u5427\u3002\n\u8fdb\u5165Zone\uff1a\u96c6\u4e2d\u529b\u8fbe\u5230\u6781\u9650\u65f6\uff0c\u65f6\u95f4\u4f1a\u611f\u89c9\u53d8\u6162\u3002\u8fdb\u5165Zone\uff0c\u8fce\u51fb\u9b54\u7403\u3002\n\u591a\u6837\u7684\u7403\u68d2\u548c\u6210\
ile_name": "4.png", "id": "6524772350913752", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566697_6524772354247085_7555027688092707545_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAd1GXAkPIYQ7kNvwHKQgJS&_nc_oc=AdqufZGbF_fpn5a80ZqmZ4XTwr6nhCcB1MixPTXayWxaWuu1a7ZXKgwQYRgf2EAMSQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiGH7WrN0OPzQ1nrtT8Nt4qPRl3Ni6Pfql1GklcjDBmA&oe=6A9EC372"}, {"file_name": "7.png", "id": "216208481346806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974535_216208484680139_5562691175683597091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMPOiZYRuOIQ7kNvwEztzL0&_nc_oc=AdrosilxYkrLC_dwgit8-ZtU6QvoL1jU1uSCDSO2ZM0ER0YQGpjbfxHGLDLjbutsuV4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8yWKmbz78AywE0OwgHXvazjY3M029DOnP6XLCFrlu2A&oe=6A9ECEBA"}, {"file_name": "5.png", "id": "918833819221529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982722_918833822554862_6415469740659612743_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qE4HiARAnmoQ7kNvwEkoOdH&_nc_oc=AdrNauVwoEG-OjG_tbVBWuaNSV3b24Um46vZgD1nt3YJbVbixwuZG-XQzjVG5YiPfkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwU2Ajo4I6Q7EarKgzqIHFl_IkEqTF6h_-Sa7on8WKlA&oe=6A9EB6B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u6a2a\u9577\u30ab\u30d0\u30fc_2560x1440.png", "id": "241131325486836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75429290_241131328820169_5306262175444097206_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rTeZZQwCf6QQ7kNvwEf0vqh&_nc_oc=AdpYsSsIYg9k5_EvVy0szeHrntDdkrCsy2K5jUQXjRh21TR70nVCtPKNt3wEKImz1Wc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlrxLuSSbLCusBty4eGZ1ziFTXswvhDeqjCclipLOnFw&oe=6A9EB590"}, "display_name": "Home Run Batter: vs Fairy Tales", "keywords": [], "long_description": "Intense VR Home Run Batter Game Begins Here!\nThe pitchers you'll face are famous characters from fairy tales. They'll throw absurd and unpredictable magic pitches. Stay in the ultimate state of concentration, the \"Zone,\" and hit home runs with precision!\n\n<Features>\nOnly Home Runs Matter:\nYou should aim for nothing but home runs. Anything else is just a mistake.\nUnreasonable Magic Pitches:\nThe fairy tale characters show no mercy. Challenge yourself with extreme difficulty.\nEnter the Zone:\nBy focusing your concentration to the extreme, time will feel slower. Enter the Zone and face the magic pitches.\nVaried Bats and Growth Elements:\nBy using the money earned in the Home Run Batter, you can buy bats and items that will greatly enhance your hitting abilities.\n\n<Notes>\nIf you enjoy the challenge of unreasonable difficulties, try clearing the game without using the Zone.\n\n<Synopsis>\nOnce upon a time, in a certain place...", "short_description": "Intense VR Home Run Batter Game Begins Here!\nThe pitchers you'll face are famous characters from fairy tales. They'll throw absurd and unpredictable magic pitches. Stay in the ultimate state of concentration, the \"Zone,\" and hit home runs with precision!"}, {"images": {"nodes": []}, "id": "1008946986860306", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Home Run Batter: vs Fairy Tales", "keywords": [], "long_description": "\u8d85\u9ad8\u96e3\u5ea6\u7684VR\u5168\u58d8\u6253\u624b\u5728\u6b64\u958b\u5e55\uff01\n\u4f60\u5c07\u8207\u77e5\u540d\u7684\u7ae5\u8a71\u89d2\u8272\u6240\u626e\u6f14\u7684\u6295\u624b\u5011\u9032\u884c\u5c0d\u6c7a\u3002\u9762\u5c0d\u8352\u8a95\u4e0d\u7d93\u7684\u4e0d\u5408\u7406\u9b54\u7403\uff0c\u5728\u6975\u81f4\u7684\u5c08\u6ce8\u72c0\u614b\u4e0b\u9032\u5165\u300cZone\u300d\uff0c\u6355\u7372\u7403\u4e26\u4e0d\u65b7\u64ca\u51fa\u5168\u58d8\u6253\uff01\n\n\u3010\u7279\u9ede\u3011\n\u53ea\u9700\u5168\u58d8\u6253\uff1a\u4f60\u61c9\u53ea\u8ffd\u6c42\u5168\u58d8\u6253\uff0c\u5176\u4ed6\u7684\u90fd\u662f\u5931\u8aa4\u3002\n\u4e0d\u5408\u
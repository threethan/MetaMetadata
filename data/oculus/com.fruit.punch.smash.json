ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOErAxqnbHjUP9iIr9C_McRE6f56tHSU75JfUyMtmXqTQ&oe=6ACF8039"}, {"file_name": "3.png", "id": "952300591199193", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499310817_952300594532526_9003428034645149265_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gyn8rhejgW0Q7kNvwGrvSov&_nc_oc=AdqSaXq-jrpq3zk9GGkOu-aGo7SHlFgNTzS2muy-USzr9cFlEOhH_POp3JlyeduFwyM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI-ubG7Zm70cQ3OekiYNeoPg80aMoYRui-nvOblEY21A&oe=6ACFA1CE"}, {"file_name": "5.png", "id": "1995493937771815", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311582_1995493941105148_6289548018060476109_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBFUdJUg07oQ7kNvwF5hb_S&_nc_oc=Adqelj1xDM-8fbp397AG25VYerDByZh3-GiIP1LNHMC1l0uBCH7cLAABZcqFSS0zmiU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJurW9TUi1_KtTZafR8o73pNrdDAQtF0UJk75Pz0Dabg&oe=6ACF95EF"}, {"file_name": "1.png", "id": "1686563742636910", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308050_1686563745970243_4644573412086623896_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7ow58NWyzgQ7kNvwEPjgwh&_nc_oc=Adrg3HoadhfHWmGA7cQd2Ecx9o3Mm28yFBgmPPwxReQ-qVMyzsr519PtqyCZ4DVTut0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0S3g-u4AyjgCZc5J3JVhY0Fx3e-pzVcyVd3rJBTKQrA&oe=6ACFA6DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fruit Punch Smash", "keywords": ["Fitness", "Punch", "Boxing", "Smash", "Fight"], "long_description": "Fruit Punch Smash is a high-energy VR arcade boxing experience built for Meta Quest. Strap on your gauntlets and step into a colorful arena as fruits, bottles, and obstacles fly at you from all directions. With just your fists (no swords or guns needed), punch, smash and juggle targets to earn combos and rack up points. The game is designed for quick 1\u20132 minute rounds that are easy to pick up but hard to master \u2013 perfect for casual players and score chasers alike.\n\nKey features include:\n\n\ud83e\udd4a Physical Punching Combat: Use your real hands (controllers) to hit fruits and objects. The responsive physics make every smash feel impactful.\n\ud83d\udd22 Combo Chains & Scoring: Keep up a rhythm of punches to build combo multipliers. Miss a fruit or hit a bomb and your combo resets, adding tension to each bout.\n\ud83d\udca3 Hazards & Bombs: Not everything is safe \u2013 dodge or deflect explosive objects as they zoom toward you. Punishments for mistakes keep the gameplay challenging.\n\u26a1 Frenzy Mode: Pull off a big combo and unleash a slow-motion frenzy. In this temporary mode, fruit spawn in a blur, giving you a chance to extend combos and double your score.\n\ud83c\udfa8 Vibrant Cartoon Style: Colorful, stylized visuals and a lively soundtrack keep the mood light and fun. The bright UI and fruit effects make the experience pop on the Quest\u2019s display.\n\ud83c\udfc6 Leaderboards & Replayability: Compete in short sessions to climb global leaderboards. Quick restart and scoring make you want to run \u201cjust one more round.\u201d", "short_description": "Punch, smash, and combo your way through waves of flying fruit and objects in this vibrant VR arcade game. Sharpen your reflexes, dodge bombs, and chase high scores in quick, energetic rounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
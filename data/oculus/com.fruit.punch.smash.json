M6&_nc_oc=Ador3-GKIkNhkWKhehJ3BpE7vYvQ9CAK4my3i6Rd1Vc30-mhNFgusW7MebeV_7emIt0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmaSZp7zitDhVZFkjCMHvuCTLPy_MblL5lStOalUukOg&oe=6A902E24"}, {"file_name": "4.png", "id": "1751826992676336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308050_1751826996009669_8093263893966169442_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqD68z-kqn0Q7kNvwHtTssf&_nc_oc=Adozo4zYWfhvqOmXMEO2ukecO2yEnFPzhtRAG8mN-4br7gXWAijKZXdzJ3g5ouj_-yE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEmDcsV0Q2J_YExUbsmoJcC1yGcCjb2RW2-8fD289tkQ&oe=6A901205"}, {"file_name": "3.png", "id": "847380421644489", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311582_847380424977822_1441722969032581217_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nM6Lofhmxf8Q7kNvwHWmKA9&_nc_oc=AdrCiR3T2ZfWLCEskBLs_S8beqn1h-f0CSlt54ATU-RMCvsRyPcjDObYerXfVaJJSMM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgFsyB7dawzlBMGMFK-LuE76H-oMHk-cU_3TjeWuUYIw&oe=6A903B17"}, {"file_name": "2.png", "id": "2135138110680105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313072_2135138114013438_753975689770509409_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrE37OYnZNkQ7kNvwEMv2T6&_nc_oc=AdrfJsUzCXmJByOobohB_JNXFweXpAJJ0BNsx1pLWB2c0SMvjlh6Vkko9jhSC75FP0Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYkHgAbD8zkoyRBd5p6KJosrEbsDCyXPPs7mxx7biHBg&oe=6A902C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fruit Punch Smash", "keywords": ["Fitness", "Punch", "Boxing", "Smash", "Fight"], "long_description": "Fruit Punch Smash is a high-energy VR arcade boxing experience built for Meta Quest. Strap on your gauntlets and step into a colorful arena as fruits, bottles, and obstacles fly at you from all directions. With just your fists (no swords or guns needed), punch, smash and juggle targets to earn combos and rack up points. The game is designed for quick 1\u20132 minute rounds that are easy to pick up but hard to master \u2013 perfect for casual players and score chasers alike.\n\nKey features include:\n\n\ud83e\udd4a Physical Punching Combat: Use your real hands (controllers) to hit fruits and objects. The responsive physics make every smash feel impactful.\n\ud83d\udd22 Combo Chains & Scoring: Keep up a rhythm of punches to build combo multipliers. Miss a fruit or hit a bomb and your combo resets, adding tension to each bout.\n\ud83d\udca3 Hazards & Bombs: Not everything is safe \u2013 dodge or deflect explosive objects as they zoom toward you. Punishments for mistakes keep the gameplay challenging.\n\u26a1 Frenzy Mode: Pull off a big combo and unleash a slow-motion frenzy. In this temporary mode, fruit spawn in a blur, giving you a chance to extend combos and double your score.\n\ud83c\udfa8 Vibrant Cartoon Style: Colorful, stylized visuals and a lively soundtrack keep the mood light and fun. The bright UI and fruit effects make the experience pop on the Quest\u2019s display.\n\ud83c\udfc6 Leaderboards & Replayability: Compete in short sessions to climb global leaderboards. Quick restart and scoring make you want to run \u201cjust one more round.\u201d", "short_description": "Punch, smash, and combo your way through waves of flying fruit and objects in this vibrant VR arcade game. Sharpen your reflexes, dodge bombs, and chase high scores in quick, energetic rounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1238041046064932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_2014165329989116_3922278586088324551_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZHYk_TX7hIQ7kNvwGarZWE&_nc_oc=AdrlHBaZ7Epo6b1ESsanXiDZH1ne9gzo5iqWTatkmIt5F8pM94eATd3Cer0Hlz-zrzg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAjrQwn3JSNIfQznn2ll989EOuSF65aoUyzbVLhZvD6w&oe=6A903292"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fruit Punch Smash", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1784217480, "lastRevision": {"nodes": [{"id": "1178799975322373", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1178799958655708", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1004324915754308"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "Portrait.png", "id": "27536436962655267", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313107_27536436979321932_3412152903679675738_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5M8TgGJtqcAQ7kNvwGL6pVv&_nc_oc=Adrb-U9NjVyFNGZyid75UDjpHvZ
HzPOPRbyOJ4HuKiSpTqm6cOQ&oe=6ACF8317"}, {"file_name": "2.png", "id": "2135138110680105", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313072_2135138114013438_753975689770509409_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPp5Q3lszTYQ7kNvwFDh-a2&_nc_oc=AdowfQMxlqzDpv6t84Cc0sAVMzCI0xdPNaaeNFfNpNTovoEdFNqHG3v_XJ1fWUr1cY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRouyfQYptDeeDRM1Z3sUeF5DsFEOAq5YToe_uEBFCGQ&oe=6ACFAC58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fruit Smash: Punch Challenge", "keywords": ["Punch", "Fruit", "Arcade", "Reflex", "Smash"], "long_description": "PUNCH. SMASH. SCORE. REPEAT.\nStep into a colorful arcade arena where fruit comes flying and your fists are the only weapons you need.\nFruit Smash: Punch Challenge is a fast-paced VR arcade game built around reflexes, satisfying punches, combos and high-score chasing. Punch incoming fruit, smash targets, avoid dangerous bombs and keep your combo alive for as long as possible.\n\ud83e\udd4a SATISFYING PUNCHING\nUse both hands to punch, smash and juggle flying fruit with responsive physics and colorful impact effects.\n\ud83c\udf49 FRUIT-SMASHING ARCADE ACTION\nTargets arrive quickly from different directions. React fast, choose your punches and don't let fruit escape.\n\ud83d\udca3 DODGE THE BOMBS\nNot everything should be punched. Spot dangerous objects, react quickly and protect your combo.\n\u26a1 FRENZY MODE\nBuild a powerful combo to activate Frenzy Mode and unleash a rush of fruit for massive scoring opportunities.\n\ud83c\udfc6 CHASE HIGH SCORES\nChain hits, build multipliers and compete for better scores with quick rounds designed for repeat play.\nSimple controls. Fast reactions. Big combos.\nHow high can you score?", "short_description": "Punch and smash waves of flying fruit in a fast-paced arcade challenge! Build huge combos, test your reflexes, dodge dangerous bombs and trigger Frenzy Mode as you chase higher scores across quick, energetic rounds. Easy to play, challenging to master, and built for satisfying VR punching action.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1302751399593896"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491831279_1294272622665253_257735585291375020_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGlChErBSmkQ7kNvwFa0hMr&_nc_oc=Adp2bFxIeFQGpArXPs_5rfB4qjLNQEgWFPgvVmNAwM8MKNX6qDdrUgUeSw-8JzYZXZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkm2qwyi5x1RGesqeOPBsoF1secqHLyX5meAmd1PDflQ&oe=6ACFA006"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fruit Smash: Punch Challenge", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1784217480, "lastRevision": {"nodes": [{"id": "1178799975322373", "release_type": "SCHEDULE
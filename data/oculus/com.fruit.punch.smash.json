93941105148_6289548018060476109_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aihyJZusPf8Q7kNvwFlCGt9&_nc_oc=AdrqhTgnDFytifyJlAXTbE2ry3VR4r9ghgln--wcinDm5GtDH0LwOh4gEltw3ksVzTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNbN7HAzgYqoIPOXvNTtPZ1e_1R6DBWLi6v89aR7U9ig&oe=6A9015AF"}, {"file_name": "1.png", "id": "1686563742636910", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308050_1686563745970243_4644573412086623896_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2x8f_Zw4BjsQ7kNvwHGdcdA&_nc_oc=Adq_0-p0DZS5UCmIELCRvNNiiZsgv42xy9IXiwTe41K5s3ZybzvaE8hcXpCWE3zzvfQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjU6iby_1NMVV5mEB68dj3ntKqVDFgDBBy22awk5AkGw&oe=6A90269B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fruit Punch Smash", "keywords": ["Fitness", "Punch", "Boxing", "Smash", "Fight"], "long_description": "Fruit Punch Smash is a high-energy VR arcade boxing experience built for Meta Quest. Strap on your gauntlets and step into a colorful arena as fruits, bottles, and obstacles fly at you from all directions. With just your fists (no swords or guns needed), punch, smash and juggle targets to earn combos and rack up points. The game is designed for quick 1\u20132 minute rounds that are easy to pick up but hard to master \u2013 perfect for casual players and score chasers alike.\n\nKey features include:\n\n\ud83e\udd4a Physical Punching Combat: Use your real hands (controllers) to hit fruits and objects. The responsive physics make every smash feel impactful.\n\ud83d\udd22 Combo Chains & Scoring: Keep up a rhythm of punches to build combo multipliers. Miss a fruit or hit a bomb and your combo resets, adding tension to each bout.\n\ud83d\udca3 Hazards & Bombs: Not everything is safe \u2013 dodge or deflect explosive objects as they zoom toward you. Punishments for mistakes keep the gameplay challenging.\n\u26a1 Frenzy Mode: Pull off a big combo and unleash a slow-motion frenzy. In this temporary mode, fruit spawn in a blur, giving you a chance to extend combos and double your score.\n\ud83c\udfa8 Vibrant Cartoon Style: Colorful, stylized visuals and a lively soundtrack keep the mood light and fun. The bright UI and fruit effects make the experience pop on the Quest\u2019s display.\n\ud83c\udfc6 Leaderboards & Replayability: Compete in short sessions to climb global leaderboards. Quick restart and scoring make you want to run \u201cjust one more round.\u201d", "short_description": "Punch, smash, and combo your way through waves of flying fruit and objects in this vibrant VR arcade game. Sharpen your reflexes, dodge bombs, and chase high scores in quick, energetic rounds!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://hasanswy.wixsite.com/emberpeak", "developer_terms_of_service_url": null, "publisher_name": "Ember Peak", "support_website_url": null, "website_url": "https://hasanswy.wixsite.com/emberpeak", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1211501752052195"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554031542738992"}]}, "baseline_offer": {"id": "1554031542738992"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784217480, "status": "PUBLISHED", "id": "1554031542738992"}]}, "liveChannel": {"nodes": [{"latest_supported_bin
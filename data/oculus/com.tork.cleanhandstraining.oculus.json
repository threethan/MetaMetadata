3219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbhZfCI5at4Q7kNvwF8FW49&_nc_oc=Adpc6_tfcwJzCPscgqGac9-L192X9JxMeAq1ROOCFCEBpA-KemS6s--47d0qK0Fo-_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ5rVp68VWu-8wWWiwRUasZi2hxx03EGX-pwxZa3doVg&oe=6AB93D4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt.png", "id": "1607212086297659", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75334061_1607212089630992_8433115398256235124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YWYvh1B2IgQ7kNvwHvGcjR&_nc_oc=Adr-_E66gCX5uF1tgsQPNWVyryPWGTL2qRYY8XYPTpwGdA2TMrZDCoaH47Nh-mQjlYk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhxinNb4PcBYrykZP8IOM4sbVrm2t5CsLd2QXdbt8GNg&oe=6AB919C9"}, "display_name": "Tork VR Clean Hands Training for Hospitals", "keywords": [], "long_description": "Proper hand hygiene is considered the single most important method of preventing and controlling infections in healthcare facilities. The Tork VR Clean Hands Training for hospitals offers a hands-on training for healthcare staff to improve their hand hygiene compliance according to WHO's 5 moments of hand hygiene. \n\nPutting on the VR headset, you get ready to start a new shift. In the training you can choose to be a nurse or a physician. Although you are in a virtual world, you\u2019ll face a series of real-life situations and practice hand hygiene using your own hands. \n\nA study shows that 8 out of 10 healthcare professionals would like to improve their hand hygiene compliance. But traditional forms of hand hygiene training are often perceived as uninspiring. The award winning, Tork Clean Hands Training for hospitals, invites users into a digital world where they can interact and train on the World Health Organization's My 5 Moments For Hand Hygiene. ", "short_description": "Tork VR Clean Hands Training for hospitals is an engaging and interactive training, specifically designed to make hand hygiene training more inspiring than ever before. Take on the role of a nurse or physician, put on your VR-headset and get ready to start a new shift in the virtual hospital.  Tork VR Clean Hands Training for hospitals offers a hands-on training for healthcare staff to improve their hand hygiene compliance according to WHO's 5 moments of hand hygiene. "}]}, "developer_name": "Hello There Games", "developer_privacy_policy_url": "https://www.tork.co.uk/legal-information#paragraph-2", "developer_terms_of_service_url": null, "publisher_name": "Essity AB", "support_website_url": null, "website_url": "https://www.essity.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "300140672148248"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26762949696667303", "version": "1.2"}, "id": "469154514915894", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4743779739010948", "is_concept": false, "latest_released_binary": {"__typename": "Android
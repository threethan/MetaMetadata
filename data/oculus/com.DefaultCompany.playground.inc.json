CanF5gF81fGFzL815s-_ght9NRd3Ro08w&oe=6AFF1251"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Munky Mates VR", "keywords": ["adventure", "monkey", "friends", "enjoyable", "explore"], "long_description": "This is Munky Mates VR\n\nA fun, immersive game with an amazing community I made just for u to adventure and get involved with our amazing community.\nthis game is made to put a smile on ur face and for u to enjoy and have a blast playing with all ur friends! Our game has all the essentials u would need to have for a good/fun to play game, and more making it even more fun for u and ur friends to enjoy.\nI hope u enjoy my game and make sure to join the discord and give us ideas to add to our game making it more personalized and fun for u and a community of other people to enjoy to!\nHave fun everyone.", "short_description": "This is Munky Mates VR\n\nA fun, immersive game with an amazing community.\nMade to put a smile on ur face and for u to enjoy! Our game has all the essentials u would need to have for a good/fun to play game and more making it even more fun for u and ur friends to enjoy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/munkymatesvr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Ssleepy", "support_website_url": null, "website_url": "https://sites.google.com/view/munkymatesvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STAN
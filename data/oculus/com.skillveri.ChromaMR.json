c=qRg6YDygs3cQ7kNvwG2PQtJ&_nc_oc=AdoK0Se3tX56B05j1G3EXzGw8LFjtMLZjmSFeMAYm8b0Oq-x6vCm78QaWoql2Ludfgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUl8n6QT8w4iXc-iyFzEpsO8ACQ5HUWakFeV6OjTqxCA&oe=6ACF96B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "529315416436191", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031443_529315419769524_167951691925299120_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggzmgoGhkacQ7kNvwHb_o5j&_nc_oc=AdqkKtYXYR8MTXkr9rkAI7ZNyvtZqLiqziFTuoOYcfQx1TcIwKE0SM2zGGBSpDiGdwI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxhiaMGJF4TnGUK3CdiQA4hUASBh0-gj2YEIMcVGNJtw&oe=6ACFB134"}, "display_name": "Skillveri Chroma MR Painting Simulator", "keywords": [], "long_description": "Skillveri Chroma MR simulator is a Virtual/Mixed Reality simulation tool to train students on spray painting. The painting training is split into four different modules based on the application type namely Automotive OEM, Collision Repair, Protective coating & Decorative painting. Upon logging-in you can choose the appropriate painting application for training. You can choose any of the application specific spray guns to be assigned to your controller. The training is designed with realistic workpieces with a guide to perform the task along with a scorecard and detailed analysis of what was correct and what was wrong during the training, to help you learn better. Latest mixed reality mode allows training with the virtual setup in the real world. Mixed reality mode is a combination of the real world and the virtual reality world. This simulator also features optional Bluetooth spray gun feature through which real painting guns can be used to practise the painting process.\n\nThe lessons are planned in increasing order of difficulty and have increasingly complex shapes ranging from flat to curved. You can access your performance reports from the cloud through the microsite assigned to you.\nPlease note that you need a licence to use this product. Request a trial licence by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours", "short_description": "Skillveri Chroma MR simulator is a Virtual/Mixed Reality simulation tool to train students on spray painting. The latest mixed reality mode allows training with the virtual setup in the real world. It also features the Bluetooth gun feature through which real painting guns can be used for training. Please note that you need a licence to use this product. Request a trial licence by clicking on the \"request for trial\" button after launching the app. Approvals are manual and may take up to 48 hours"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/chroma-mr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7784080945037242"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "544281581262045"}]}, "baseline_offer": {"id": "544281581262045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1730782620, "status": "PUBLISHED", "id": "544281581262045"}]}, "liveChannel":
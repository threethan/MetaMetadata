626587114", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_1847904629920447_2739041177715279671_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wg8Kgxc3ImsQ7kNvwFKijTs&_nc_oc=AdrVSM6c2N12ka2qAcizE59VccSukouOix8zDA4b_zKRC9dk4KfioDGBrCSnpFYYe34&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIDaAqqMFWOvtgXqQF3mIEuZtAiiBwZUTKaXKnSvjxIw&oe=6ACF8848"}, {"file_name": "chroma ent 3.png", "id": "28514578421512421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604317775_28514578428179087_5482813332804611148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEW99PbaPfMQ7kNvwEZtF9E&_nc_oc=AdpHyx95FKkLrv6-QxYUO7mtCH7EZUBgqc1eOXOJjPV-p4tIJkq4WrK_GZ-UVCUm8Go&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYuJLSz61dXklo-fesW39V3yf5-ld0jWuOli3RbC2Nhg&oe=6ACFAA6A"}, {"file_name": "chroma ent 4.png", "id": "2162816984446301", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/585799753_2162816987779634_2304070694241008011_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXU_k0RJS3cQ7kNvwEbHTjH&_nc_oc=AdqDZXgimbQcpmBprM96P8ZIwqQL-QerQuBOICjjl8Vi-Pt93zconbBUE6X-8dkDpmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9mTIhfzwXZQFVD9hM1jxnRR0pLXXqUuzx5crKstoJjw&oe=6ACFA64E"}, {"file_name": "chroma ent 5.png", "id": "1792657511933708", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830822_1792657515267041_8898254014224951027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKJkvnm4uggQ7kNvwFNN9Ru&_nc_oc=AdqZ_XboA4EetHD3UzO9hXFXPyvcU2R3anynpCzuIhA5IvK79fR1BTlWhFkOgFPWaXk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC9v58SDVkT0yv82Uwcgp83jUnciTP8uqeBKGtLpU4XQ&oe=6ACFB8A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "529315416436191", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031443_529315419769524_167951691925299120_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggzmgoGhkacQ7kNvwHb_o5j&_nc_oc=AdqkKtYXYR8MTXkr9rkAI7ZNyvtZqLiqziFTuoOYcfQx1TcIwKE0SM2zGGBSpDiGdwI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxhiaMGJF4TnGUK3CdiQA4hUASBh0-gj2YEIMcVGNJtw&oe=6ACFB134"}, "display_name": "Skillveri Spray Painting Sim.-Enterprise", "keywords": [], "long_description": "Make your spray painting training step into the future, with the Skillveri Spray Painting Simulator Enterprise edition.\n\nA fully immersive training experience in advanced Mixed Reality which seamlessly blends virtual workpieces with your real surroundings. Enable your learners to practice repeatedly with no paint waste. \n\nThe Skillveri Spray Painting simulator Enterprise edition includes - \nChoice of Airspray, Airless and Electrostatic painting processes.\nReal spray gun integration for each process. \nChoose from different industry modules - automotive OEM, auto refinish, construction and protective coatings.\nPrimer, base, and top coats just as in real life.,\nAdjust fan size and nozzle\nProgressive learning from easy to complex workpieces\nEach workpiece with lessons for speed, distance, and angle \nFeedback & no feedback modes. Practice with guidance while learning and choose the no feedback mode to assess yourself.\nScore cards, movement graphs,and thickness maps for performance analysis.\nCasting app to monitor and guide multiple learners.\nDetailed reporting dashboard for trainers.\n\nTo enable our painting simulator for your institution\u2019s CTE or workforce training, write to us at usa@skillveri.com. Skillveri simulators are used by global industries and across 100+ schools and colleges across the USA in their CTE programs. Check out www.skillveri.com for more details. \nFor personal usage, check out our Automotive SprayPainting Sim-Personal and Home SprayPainting Simulator-Personal", "short_description": "Spray painting training with no paint waste. Choice of Airspray, Airless and Electrostatic painting, with real spray guns.\nChoice of different industry modules.\nProgressive learning from easy to complex workpieces. \nTrigger, Overlap, Distance, Angle and Speed lessons \nLive onscreen feedback for guidance \nScore cards, movement graphs,and thickness maps.\nReporting dashboard and streaming app for trainers\n\nTo enable our welding simulator for your institution\u2019s training, write to us at usa@skillveri"}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/chroma-mr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28235704376114932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673652249_1396906768573828_7736456063341987777_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCB31EZHKP0Q7kNvwFzML2E&_nc_oc=AdphC-1SsN50NFi1nxJpqCw8JIdyzLl6V_eLucnLCRp_ylb-9EAMxZ2b4RjEfeyCgac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIa2mM_o3Yt2axc8nNod8itVspwNExsed5k4wWKF_DZw&oe=6ACF9015"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Skillveri Spray Painting Sim.-Enterprise", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "
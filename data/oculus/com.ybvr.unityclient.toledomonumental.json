Q5d1udf-I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CVdZDuU05l2hJWT4TI2i-TC9yuAxkxqU4g3rtW6TGgQ&oe=6A36B43A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMBgiTwEkoEQ7kNvwFYam0H&_nc_oc=AdqUa55tqXG6eP93ihEjpC_5bM3b6xB1T8r9SzijeHk200Z50xzbLH_3DkZtkYFHqQ4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af925ZJBqyvqN6uDZYF-n0vYjmcM25JuF0D0T_3IEGrsvA&oe=6A369785"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY6S8tsd_xgQ7kNvwGMPu0X&_nc_oc=AdrG9spOnfaaN7vRO1ZF23hVznPVEq9vtltfpEPz8GFlnLg_yDZ4Zmu5SpqFxGd6LOQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ThLGaAW0orvvcUDeotMZva7Q3fNOBcss2XAoFYeJSyQ&oe=6A3699B9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR
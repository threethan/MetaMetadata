_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTyVzkdiHVZzhGoZCLIir-9de-VjzLgBCnCKoybAdj-A&oe=6A58C2FA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYJAfXevUkwQ7kNvwGW-oXy&_nc_oc=AdplllwKmcur9olbJPXbpjomUz_stSau9ICRZvjvpVD2qg_lGHj0z4kVadrrpT31fh0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBoxSzvBrXzWWrZDtk6--YdeY-mJhwP7uLvAgmZSnWIg&oe=6A58DE85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gzrf3udUBJQQ7kNvwHB_22s&_nc_oc=AdoWiYMrr6RQBIqpCVI6leJWdQ-RfvnOqYGvf_obFPmkSCt7KDBPblCAQOJhUFj4mfI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyEo10FFIUQVLBzuRqlNO4Krv8BEyzu3Vly3uOE9ekkA&oe=6A58E0B9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
yBhYqtJrs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PZi_3Q_i2fvQfqcCbj5LP_kxCYs2bzibgyDZSqouU2A&oe=6A39573A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMBgiTwEkoEQ7kNvwFWNhlv&_nc_oc=Adp3ecgjw60HmKPaiJ7jM9HV2OkEIEPwnwoQ8ZySWIX6a971h2DkNm1AezuC88Cwtk0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1PjyzVWTPM84mWkjWyPTTrTpwywFA2m8hjROhrZGwsw&oe=6A393A85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdISi9NdOQEQ7kNvwFJg4Sw&_nc_oc=AdpzFLdySqfX2RvT-vawrkEB26FPM3XGcW-1WO30PxWCjMVsDDIPfH_jvrqltcNQGvw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0vzaYOKW-Sjp9fA2_jjlEs4d4O6rG4MjlHqK9nU9NVQ&oe=6A393CB9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR
_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47owc4ComAibUEjp76evCA4lMx7uj8WX48uHMmfNVNSQ&oe=6A0349BA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3HLZyh3SVcQ7kNvwGrRG2b&_nc_oc=Adoc2XXv4x2kgRVf4S54JnICwd4qtQIZ4c1qoZXsxqvnpbE1CEruwMYzDCyje773PiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JrzXDUFMl34ZJFrSbVJku2wvrwlImmK8o3BwxRetd4Q&oe=6A032D05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGHYhj2P0VcQ7kNvwGJympX&_nc_oc=AdqOrmnYKkP_cDKWYzGqNZCGEbUum7VgxVXKHKjVpdmEW3XZq_2bEsFfqdbPaoRrgFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7teoIRqEcivhFRvTZX3OQ4EOpJwP1KdACN9HUMwFPXYw&oe=6A032F39"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
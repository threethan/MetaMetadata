_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0U46uB9DAgvm40gUqdmWMjx6oNJa3Hi434N0E5Wi3drw&oe=69DB847A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEVhiCYPzcUQ7kNvwHepJuI&_nc_oc=AdpESdNk7Xt6GkuAeHwe0mbsOoqvejvWUNTHpTQdPKO41VETmbzrIrEOeCty0K3L-i4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zBilmTGuv-sZsiIRQskFbj2JpbfD5wY0PSbEyD8ZQNA&oe=69DBA005"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsTYJUtOcOYQ7kNvwEyzd8t&_nc_oc=Adouq2I_od7NMq2uKRaLYUK7HceDY6nIIuUHj4aL-0-3hLgmsQOIogBK3T1PA5SKTJA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R-h8nj68Gf-aHQ-8VkIvAjh7vgjOrE-T2Hhg8R9JUJg&oe=69DBA239"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
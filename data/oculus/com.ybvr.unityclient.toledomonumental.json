VDKhWtMMo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK75KomZXogqIA2dkmkmjhu_vTDwqnchGgXsFIn_Bihyg&oe=6AAEACBA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lrvl85v8QcQ7kNvwHU8orb&_nc_oc=Adq2zA-lSUA0NKRpyvxdSiZ9zT1AYbzwePy3Qcnq9A7iFANre7_UpUl-87UoxvMg-nU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG37bQ4WTl0gpJaTdEBAHG-5Rpau7vBzU0hkUSTKGsnw&oe=6AAE9005"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtH0r0pA-4AQ7kNvwGCO7tp&_nc_oc=AdrbX01uGGzUwUHdcGmFb9uja-lmWP7UvTzkLTfBvlCfyT_Y1BXVmF1HM7TAAVFjph4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlGrNOOCO2G8XmDSBeSgvS6m0lvGua8dBip_VdW-f1_Q&oe=6AAE9239"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR
uluscdn.com&_nc_ss=8&oh=00_AfzrnREJIFaf3t9dkz2mDr8EAcNXNi19TFi3UD3Vz-qONA&oe=69AABCFA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPit-HCEQzUQ7kNvwEhpAcB&_nc_oc=AdlyfMvBZSL4fLXQsBY6_ncaGMeq69UiIgmCOoTTI4Rz2aB81e3Eqw8i39tOTF7pY9k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhQNtps5TOza21zz4kKZ9x2yvkfv3hbpNVIGTQ3FnNfA&oe=69AAD885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzT3eBGtZuUQ7kNvwFfUqtO&_nc_oc=AdmDD4FjDsPT9FEknznd2lvhBDJn6o7115hYMNNqIeaabzt4O1CydCYPH4JsHdJmMZM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQA2-7EbZUO4ODT7Wm8PR67pKShJLv-vKFsZ9RQQDWFA&oe=69AADAB9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "support_website_url": null, "website_url": "ht
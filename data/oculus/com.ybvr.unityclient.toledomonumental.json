m&_nc_ss=8&oh=00_Afwp5gfJ3yvReDZcSbTced0PI5Z30Dlq6VkU8AtvWCJTwA&oe=69B2A5FA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVbq2NRXkg0Q7kNvwH-Kca8&_nc_oc=AdljMmmT3GUaON0v74j0wsqOblM7yEkqiTaYnE0FGGISplWsVYMsv1Z8oXUHguXnzbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzso4V8Ua3dmQNVbfZNsvFM1v6U-E18uncsocdSqXFjgw&oe=69B2C185"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHwY45Hmks4Q7kNvwG31RVU&_nc_oc=AdneotwlyzQwIitP7nOXVH0OoOLFSfDewfBKgOhw08gdO-VgvPwwRuv16tOY2Ra6bgg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxiP5FYPBy-c0kqm-INkblW4M6nIF2lQ-w37TtEve_2w&oe=69B2C3B9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "support_website_url": null, "website_url": "http://www.y
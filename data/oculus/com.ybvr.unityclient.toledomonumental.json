m&_nc_ss=8&oh=00_Afyo9WhtvHLvTZ13_vWx7f5hSmE03eyZW6RTECFIqFxu8g&oe=69BE837A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex2XebQOXnIQ7kNvwFl-ROH&_nc_oc=AdlHTtCafhJthL4nghS4MSJIHH3ngV6_ymKEuw6zLVf-_NGiUmxOo7LPdDxqv4kK2jk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvXnKIA1mtnHFAmqhvrIxsc5gjHioZl9cCGTlhP4YcXA&oe=69BE9F05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SiLWPdPbPcAQ7kNvwEsB_sC&_nc_oc=AdmuH5eQGbGZP537Czco5IOUP77LcUYV1yG4tBHS7bu37EhVbxWR_qa84LK-_8xfEvo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1zKpdUQAUahJgd6U9u90GFgYkmJtl8O_eG4N-NxMwRg&oe=69BEA139"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "support_website_url": null, "website_url": "http://www.y
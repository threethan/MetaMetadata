_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8l0dQ7EmEds_fS2GL6Tn6idskogVS1W4YLmYX3LLCbg&oe=69C277FA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-l_BRBPpE4Q7kNvwGFJ0OY&_nc_oc=Adq-hUWZNgp_cWZ4MJL2BV5pLkMF8scgjIGYUJPgZkqeNTqLB8j_rE3MkqNk6wHmXaM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCn65j3I7AUTlKOS9kgWLotfgqgjl3tmM8IyXO0mtR2g&oe=69C29385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qunAZpnHC5YQ7kNvwHv31Du&_nc_oc=Adqou7zFbHtcR-4be8OAlsq50VEpEzBcC9SOiw8dfpqJ7tro8RFt6vVOSsKetsF_l74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afymw7V4vDMkzqpEjRu5RBVwHle12zLuDCXJfydY86iWZA&oe=69C295B9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
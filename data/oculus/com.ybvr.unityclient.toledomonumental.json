m&_nc_ss=8&oh=00_AfzjlGeC04WXIbRaNig7pYYdNogpt1vi0A99IfXzIh2UnQ&oe=69AD5FFA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Slq3pVw0_YIQ7kNvwGAeEBR&_nc_oc=AdkN0h-dyjyO2-4G0IQ9lgX498UcjEjpb2nD_6hpWCYE9f3CJWWIrnFCNVdZeLNOr2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhlYo9CRpiyCkx5PbxnKbOdYU8DlAjxUMLU4SfM9Ue_Q&oe=69AD7B85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-sL-9BggusQ7kNvwH_HPMV&_nc_oc=AdmZDYLWRymzVfnoJXMbMnmKjB7eMDZTpAJ6bsJEu-k5izxtYznQ3P1pqW8MhrxyjGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzT59nf_88hvLzs3TE6pbRo0C6Eetw41-pCZ6o9DhZ55w&oe=69AD7DB9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "support_website_url": null, "website_url": "http://www.y
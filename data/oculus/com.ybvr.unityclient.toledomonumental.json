_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kvRbwYY4KumXaIUIq8A-NmJCQh6xJPvpH9MoZOdCAZw&oe=6A29853A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i797XE70ziEQ7kNvwECW4-M&_nc_oc=Adr7FsnxmrZfa5Uay2H5Ctthv9WR9YOi9zGDMgHzO3j_uQixigkMhsInSBPdaFZ4s4U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AyUhJZxWEnzInhGzMeAtvjJb0hHwehDRVHzbP7t5Hkw&oe=6A296885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T37_C-6AkaAQ7kNvwFn-YUm&_nc_oc=AdqelhvIp5wkfD9x6PwP1yEoSla9h2q1gg08rcgd5BFogkgM0QWBudm8_d6li1zTa-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YZuLPMDNvkFG8mhXhTY8_6MdZot7sGZ6Y-C53WejgkA&oe=6A296AB9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
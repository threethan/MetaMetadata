_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsL9sSiQvyvXd-D3Ya2SB0pG4PUUKni5SIxVvcHexDoA&oe=6A707DFA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWMCnhE6-dcQ7kNvwETYokV&_nc_oc=AdoeWWI1sp4i8MyH1-LtJ4IUIEXPrLdK2nqB9DCXp35jVIWgmcWre_b0r5Z4VVodHRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFsqpMHYEcloruxb8M_KIq_Xo9V2CKcK7bYEFzXotsOQ&oe=6A709985"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18O1Z4dKA9QQ7kNvwFTOCZQ&_nc_oc=Adr0zuZveFucacFcPUkGEDTMQCOuAQUi06f3mVAXhj2-OlDFNNjg8j40u1szLb163kI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6VmBIIdUtxWHH0vdTHzylFX_XkI9xdM3OU8MWZ9a0Tg&oe=6A709BB9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
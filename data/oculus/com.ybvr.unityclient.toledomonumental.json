_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1cAcbFLwzfZhaqbqaZgt1ea0Jz0xUEe0pcZVmrO_VxA&oe=6ACA5C3A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YiC0vXVelcQ7kNvwGvtWDC&_nc_oc=AdrbY2iIgZ76NhuSnkhivD5w5bwQWNgF9Ydwb7znmO7r4WHBE_tWSjUtYFFzb5NPsHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmznABzwxw8czJI5lbY_Vz4ZEkIgu-FyK5rywp6N58cA&oe=6ACA77C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9c3nVddFXkMQ7kNvwFdbbTD&_nc_oc=AdoSAXMEYl7n6mK-9Wfx_TeizMRkNoFJt5IgbG16oropQloyuSsh3tsQqlyK0dynMZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMamD-_RvdFojHbwkdplHvYXuUzuZg8zWcMAi-NF5QKVw&oe=6ACA41B9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
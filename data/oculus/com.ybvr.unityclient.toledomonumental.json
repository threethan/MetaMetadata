_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Dwnn9JrZgpSlRdn9KU52KEmILhFONWSQGkSkPPWsZsw&oe=69D39B7A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0dMKo-xDWIQ7kNvwFo_5_2&_nc_oc=Adrg1BVrZYQrllGgEaG998f_t40dIuc4avoyrglX3AqzGCVgUu00H4VmdU7Xd6jo3GU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2q_rqdpXRWDIJR0PN5A4kZBLpzq6f53H-HdfZH-2mQ0w&oe=69D3B705"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysOGEc5AQxsQ7kNvwG4WTx4&_nc_oc=AdrluDseNnvpc-jMuSA5I0AZOs2Qxz9peQkCtz6R75Fc4ApGYn5aA0v8ScgjujYGeQg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02WL-dgl122HIu0_eicxfYNs0RoTFpD1bUA8LUODsz8A&oe=69D3B939"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
m&_nc_ss=8&oh=00_AfxnhvUiAh1equnVuPuUz46Xm6S27vK1Ta06HoPqGbQ3ig&oe=69BA8EFA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xukm5FUQ3pkQ7kNvwG1gzPZ&_nc_oc=Adk5QJ3_n522P9rOil2s_NBLlGcs1sykGINmv4sQ5nw-yLMAI2Mx5CWkh5AfvHJ8a0g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPoY1ONGU2ma_IOUqh82b80sB2dSbaVHToUIuKGrHa-g&oe=69BAAA85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HSEIir_BkIQ7kNvwGsH_2P&_nc_oc=Adkx9092Ff4GcgGNSmigAI0hg9iFzUigt7apCsRWhGfztDcIkgJywkoEtPSD4Djbta8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwxxw7T04czV9pGBsjAzbOKQ3cvOwDHr6Q3oE0nnFXPLA&oe=69BAACB9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "support_website_url": null, "website_url": "http://www.y
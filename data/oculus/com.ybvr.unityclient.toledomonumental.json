_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoPYBOLLTTXLlMqbot75X9p_gRbJ6kQZk7XuGEGsc5PA&oe=6AF33ABA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTuVk9V_jasQ7kNvwGJRX7b&_nc_oc=AdpMxRMnX8IH-T94A8g1438F0jh-MXj_zlGgeGL0Yjun7VXmhepLoX_Rvnv1tG8XyyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO93aaDX49eUzIsKyX1mcFKS-JDo937crzxEEVHjU1ig&oe=6AF35645"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xklcn41LYcQ7kNvwGPblzr&_nc_oc=AdrN6-DPMxjVoqFuPUX0BLJv9RoNVRqfPFqdUTkNzmiDxH5sz4RBfZWiDjMsNgzA0aw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkNyibc47EMrtKWNJng-Oyn4AdoGz7R24JiXN9R5qU7g&oe=6AF35879"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
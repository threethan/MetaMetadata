m&_nc_ss=8&oh=00_AfxEeFvRilSmKAErQ-NADFGuh_F_OcOYZeuraetGE4wvpg&oe=69BBE07A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ex2XebQOXnIQ7kNvwHLfv7m&_nc_oc=AdkmHdq-rceTQ_IwkOWrgUgZB5TRCQH0wWVe_WHcYEdJJVnK34cZ5UAwQ3kT8ogxDQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwAMuj75NcJ7XJ2ByqDgTqXKiWNHkIuYAerW0Em59SMqA&oe=69BBFC05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HSEIir_BkIQ7kNvwGrZ_S_&_nc_oc=AdnDFLo4GRCo6h6X5_wkv9TnASta7KVW1PDPbinQpxAUYJQGmxIgSJzs1tnIshIhTGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzU3OWUgeShYcTqKgT2tX_aafkcBmvM0qFZQM0sRu8i8A&oe=69BBFE39"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "support_website_url": null, "website_url": "http://www.y
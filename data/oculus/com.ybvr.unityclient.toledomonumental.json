_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI34vzCDw6gJORGK1tb8TNY4RcKv9fjAMtkYIVwmZbBrg&oe=6AAD5B3A"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lrvl85v8QcQ7kNvwEg-f_y&_nc_oc=Adq2LrXlxafrvajQBaeycSuzLt4u9e3RXcfAIg-mCbUT4pplCtRDAgY2KqDM_KCK4ng&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbLQNIiUbIgFD32cMlWHSurtEWv8fZ8QUXIcWxCMSRkw&oe=6AAD3E85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sdobAfXS2dYQ7kNvwFiPjy2&_nc_oc=AdpWSjLE0aOoDy88_3CU8TlTNUmStCjoIoQZeGqSzXTqHPK-id-AoIEMgcPZ1Ebcu5M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg1rCXSPI74fxNP_hoDqY2pkEkdJcwIdbVMA9sNHaDcw&oe=6AAD40B9"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR, Inc.", "
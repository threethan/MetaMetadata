GzYCUYPIM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlNk0km2A-GeNI7mOmTXcsxGrm_0muAhxNop7NXhpQBQ&oe=6AA966BA"}, {"file_name": "screenshot 1 quest.png", "id": "767731868488086", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031643_767731871821419_4145033319110779608_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmMkjPVRPIYQ7kNvwEr0nwD&_nc_oc=Adrok50m6Isrl3fthCX3ugUEqYh4qudoWcjFFm8iu8gGZvqlRL-eUhWW3wva9qX0XF4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXHX2TcdWJ7ofNwz9SL6Ff0fnur3JW0U_I9Zrztzj0tw&oe=6AA94A05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail 2560x1440 copy.png", "id": "821304832922978", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974717_821304836256311_7459961732424396717_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZycEdeRF_4Q7kNvwFGs5bb&_nc_oc=AdqRnmUVtSzQHDiuIJ8SnqVF-5xKkVuTD2A67m4zrr0rPnR0Emymj1MwLSFTQdNMYLc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ3cdUOpH5UY8UiRp8GU55oO1f-C-HVfcDeqeYmD_ZbQ&oe=6AA94C39"}, "display_name": "Toledo Monumental", "keywords": [], "long_description": "Realism Redefined! Toledo Monumental sets a new standard for realism in VR travel. Feel the warm Mediterranean breeze against your skin, hear the amazing choir echoing in your ears inside the famous cathedral, and marvel at the intricate details of famous landmarks\u2014all within an astonishingly lifelike virtual environment.\n", "short_description": "Embark on an extraordinary adventure through the captivating \nbeauty and rich cultural heritage of Spain with Toledo Monumental, \nyour ultimate VR companion for Spanish tourism! Prepare to immerse yourself in a groundbreaking meta-quest, where virtual reality and travel merge into an unforgettable experience. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ybvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Yerba Buena VR
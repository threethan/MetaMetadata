rror game inspired by games in the Sit And Survive Genre that takes the concept provided in the game and flips it on its head several times, throwing the trailer into tense situations where they will need to act on their feet to avoid bloodthirsty mascots in a winter-themed resort. \n\nHide under a desk from a massive mechanical bear, throw objects, or even the mascots themselves, close doors, vents, and keep your barring until the clock strikes six. \n", "short_description": "A mechanical nightmare in multitasking. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://cogwaregames.com/polardread/privacypolicy/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MVRKY", "support_website_url": null, "website_url": "https://gamejolt.com/games/POLARDREAD/618442", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7635619009805227"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451788_462575132131153_5288498798879718676_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41sJXSwDs0IQ7kNvwF2z3fq&_nc_oc=AdonoVfQ2JSCkW1QS-R8gCilux7yN1aPA_7uM_vmFALeX_Vf4Uvx452G0RBCC2d7N74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9PN6usH1BxJqhpiV3pP0QA5Pj2LIWBw--e7IKxJnjTA&oe=6B01C9E1"}, "is_concept": false, "is_test": false,
25/38982466_614222213264657_3693713750303318876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rDSfRmXHnsQ7kNvwGZQ6hK&_nc_oc=AdkF787gZCoFE-KuncM9qgQRwHmKPcElENA7QNxUzGi72o6DC-DlXS5SoQIN8YdPKvA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4NigEHvVlb1tX8qmixS6bavByxLg4JtSt98s1PFI1mw&oe=69AADC4F"}, "display_name": "PolarDread", "keywords": [], "long_description": "PolarDread is a horror game inspired by games in the Sit And Survive Genre that takes the concept provided in the game and flips it on its head several times. You will be force-pulling, throwing, crouching under the table in the Nightshift, rummaging around for batteries in the basement, and getting up close and personal with Slush and the gang. This demo has 3 levels.\n\nThis is for nonprofit; Fun\n\n Discord: https://discord.gg/Xcbdb8DBwR\n\n", "short_description": "A new take on the Sit And Survive horror genre, with scares at the forefront."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squeaksdcorgeh.gamejolt.io/POLARDREAD/privacypolicy/default.html", "developer_terms_of_service_url": null, "publisher_name": "MVRKY", "support_website_url": null, "website_url": "https://gamejolt.com/games/POLARDREAD/618442", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "318026133599014"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4270120649766677"}]
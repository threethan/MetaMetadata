 multitasking. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://cogwaregames.com/polardread/privacypolicy/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MVRKY", "support_website_url": null, "website_url": "https://gamejolt.com/games/POLARDREAD/618442", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7635619009805227"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75451788_462575132131153_5288498798879718676_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHB8DHyHKKMQ7kNvwEKyok5&_nc_oc=AdkaZXyfBXvwUnmOUi4B8Fmy-K9Vy6W3GPeU1dCKwGRX52Nw93XdICK4yvmPIISYta4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftDa6el72wP38DtN_1HhLjapzmRMikU9A-sQLTUQeDoQw&oe=69A2E2A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PolarDread", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1639717200, "lastRevision": {"nodes": [{"id": "859903738005250", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4703946549639169", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false
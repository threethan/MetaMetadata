 a port, all of that classic 2022 jank will still be here, BUT I will fix it in due time, it's been long enough LMAO \n\nLet me know of any issues. This is JUST a port so bugfixes have not happened yet, but will in time! Thanks! :)", "created_date": 1738061393, "id": "9524395424260900", "version": "162", "version_code": 162, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4703946549639169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9524395424260900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1737606473, "id": "9495870943780015", "version": "161", "version_code": 161, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4703946549639169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9524395424260900"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1707617247, "id": "7535005789866550", "version": "160", "version_code": 160, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4703946549639169", "is_con
il the clock strikes six. \n", "short_description": "A mechanical nightmare in multitasking. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://cogwaregames.com/polardread/privacypolicy/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "MVRKY", "support_website_url": null, "website_url": "https://gamejolt.com/games/POLARDREAD/618442", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7635619009805227"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75451788_462575132131153_5288498798879718676_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVaYpbg0qLUQ7kNvwG7ETr7&_nc_oc=AdrTAol9yLh5pSq44BgHFU773RjvRZoZweTLegxCYkde2vtwCj1VXZqLc6TGFMwSOB8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ljIipZ3LVJlyKZucaN_T5BGpt7PZYLrWOnSg9d3v1rA&oe=69F1FCA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PolarDread", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1639717200, "lastRevision": {"nodes": [{"id": "859903738005250", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4
g", "id": "614222209931324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982466_614222213264657_3693713750303318876_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0NMS-fQ7sUQ7kNvwGXcWc8&_nc_oc=AdpwfHXU8jcRXSCX1YMwRgwyOOdjjQeFrJixQNfl5EqRHGZ2u9kYpl1Y9ifePH2D8Hk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmfhqn11BgK3Tco4MgmomeTao4togan6T-svOlkaBTXg&oe=6A5F79CF"}, "display_name": "PolarDread", "keywords": [], "long_description": "PolarDread is a horror game inspired by games in the Sit And Survive Genre that takes the concept provided in the game and flips it on its head several times. You will be force-pulling, throwing, crouching under the table in the Nightshift, rummaging around for batteries in the basement, and getting up close and personal with Slush and the gang. This demo has 3 levels.\n\nThis is for nonprofit; Fun\n\n Discord: https://discord.gg/Xcbdb8DBwR\n\n", "short_description": "A new take on the Sit And Survive horror genre, with scares at the forefront."}]}, "developer_name": null, "developer_privacy_policy_url": "https://squeaksdcorgeh.gamejolt.io/POLARDREAD/privacypolicy/default.html", "developer_terms_of_service_url": null, "publisher_name": "MVRKY", "support_website_url": null, "website_url": "https://gamejolt.com/games/POLARDREAD/618442", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "318026133599014"}}]}, "sc
7466_2421154743540928214_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=talzUxUD47QQ7kNvwH_w-8L&_nc_oc=AdoOIsSY-V4jzZAIYO3twYH7ahT51JgNMMF4-TsP33I19j-hFl4WqL3aSkZXZ3qOOXM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuGsSIp2vTuhYaXtPmOw_xRa85bJSZgSlill2Q09Lo0Q&oe=69C3EFE4"}, {"file_name": "cropped-Screenshot 2025-07-24 at 1.24.50\u202fPM.png", "id": "586869467777028", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308230_586869471110361_2580219777663398731_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gzTTn0HOgkQ7kNvwESC4Ke&_nc_oc=AdrhgENU_7svGGpDL89EIw39GY3TFDesxKARhgbhm6w7SKA263v_fB8zLDxKZXcI44Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyz64FC2TYEr3TRb2us8ltRYZXmROvgw0BkLIfyO7D22g&oe=69C3C4F3"}, {"file_name": "Untitled design.png", "id": "1855242215175858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619078_1855242221842524_4643126930986537093_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOsBEbVRYEgQ7kNvwGcINCt&_nc_oc=AdrbtsfdO8mWQLNU4LiyzmV2WDHQdrOeYeASH5SM-fYBmF2bXBVOkQygD3qpTHVJHcI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSjh01EzPMEXtAedlqV5S2d26vHJaeoVyyq2NJt0b4PQ&oe=69C3CE42"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000012340-2.png", "id": "509287875596324", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491830147_509287878929657_1817401943467971091_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dMc99AN5LkQ7kNvwE3sWX7&_nc_oc=Adp1fWS69zlsEYHYQy_qdKgKP7bMZWvw2e16J47nOW78vTsXqw7kgMvkHf6kZhb6QsQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIIKz60-fpBCHMM4U77OhV6MfcLlx9oBtF-SdZ30_3sw&oe=69C3E8E8"}, "display_name": "Anatomy Cloud Viewer", "keywords": ["Medical", "Education", "Anatomy", "3D"], "long_description": "Anatomy Cloud Viewer is a mixed reality visualization tool that lets users explore detailed 3D anatomical models derived from real medical scans.\nFirst, upload the DICOM files of CT or MRI scans to the IntelliGen Technology website, where advanced AI automatically segments and generates 3D anatomical models. Afterwards, these models can be explored immersively within the Anatomy Cloud Viewer.\n\nInteractive Anatomy Viewer\nExplore and manipulate your own scan-based 3D models in mixed reality.\n\nVolume Rendering\nDirectly display the original DICOM files as a complete volume or as individual slices.\n\nTransform Tools \nEasily move, rotate, and scale the 3D models with intuitive hand tracking.\n\nVisibility and Transparency Control\nAdjust anatomical visibility and transparency to easily reveal and study internal structures.\n\nMeasurements\nUse the ruler and protractor tools to perform measurements directly on the 3D models.\n\nAnnotations\nMark key regions and add in-scene notes.\n\nMultilingual Interface\nSupports English and Traditional Chinese interfaces, with more languages coming soon.\n\nImportant Notes:\n* Anatomy Cloud Viewer is not classified as a medical device and is not intended for diagnostic or clinical decision-making.\n* Requires internet connection to access the cloud server.\n* Requires an Anatomy Cloud account to log into the cloud server.", "short_description": "Anatomy Cloud Viewer is a mixed reality visualization tool that lets users explore detailed 3D anatomical models derived from real medical scans.\n\nFirst, upload the DICOM files of CT or MRI scans to the IntelliGen Technology website, where advanced AI automatically segments and generates 3D anatomical models. Afterwards, these models can be explored immersively within the Anatomy Cloud Viewer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.anatomy-cloud.com/term/privacy-policy.html?v=1.9.9", "developer_terms_of_service_url": "https://app.anatomy-cloud.com/term/end-user-license-agreement.html", "publisher_name": "IntelliGen Technology", "support_website_url": null, "website_url": "https://www.igt-ai.com/", "category": null, "c
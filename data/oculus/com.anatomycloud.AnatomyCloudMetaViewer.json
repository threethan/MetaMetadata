-07-24 at 1.24.50\u202fPM.png", "id": "586869467777028", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308230_586869471110361_2580219777663398731_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvsgL7tvTU0Q7kNvwHkV_7t&_nc_oc=Adr8FE17zW623d9Qd5LejuRufS4Qf9z_GkIysNiMrhHIAasNikBTyenXTE3xG4mY178&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4IWNffkt2K-5xSOUkJiK0x9MON2u6jgdz4Ke_ohHe9Q&oe=6B01EEF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1000012340-2.png", "id": "509287875596324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830147_509287878929657_1817401943467971091_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kqi1iOnQFUQ7kNvwHLrsBP&_nc_oc=AdqW0C9_-dNVkk3y3alf4UwVuql06TLonvuhnIkg5-jq-dzMI12ZuHjn8Xo5FgpmaDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoBWpFlgsQzACFWTrrJs9gXbs3JI1BfyNExKACkqA70A&oe=6B01DAA8"}, "display_name": "Anatomy Cloud Viewer", "keywords": ["Medical", "Education", "Anatomy", "3D"], "long_description": "Anatomy Cloud Viewer is an XR app that lets you explore 3D anatomy from your own CT or MRI scans. Upload your medical images to the Anatomy Cloud website, then view and interact with personalized models in virtual or mixed reality on Meta Quest.\n\nWhether you're a medical student, educator, or healthcare professional, Anatomy Cloud Viewer turns your imaging data into an immersive experience.\n\n\nInteractive XR Anatomy Viewer\nExplore and manipulate your own scan-based 3D models in VR or mixed reality using passthrough.\n\nTransparency & Layer Control\nAdjust anatomical transparency to reveal and study internal structures.\n\nAnnotations & Navigation\nMark key regions and add in-scene notes to support learning and communication.\n\n3D Model Transform Tools\nEasily move, rotate, and scale models with hand tracking or controllers.\n\nMultilingual Interface\nSupports English and Chinese; more languages coming soon.", "short_description": "Anatomy Cloud Viewer is an XR app that lets you explore 3D anatomy from your own CT or MRI scans. Upload your medical images to the Anatomy Cloud website, then view and interact with personalized models in virtual or mixed reality on Meta Quest.\n\nWhether you're a medical student, educator, or healthcare professional, Anatomy Cloud Viewer turns your imaging data into an immersive learning experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.anatomy-cloud.com/term/privacy-policy.html?v=1.9.8", "developer_terms_of_service_url": "https://www.anatomy-cloud.com/terms-and-conditions/", "publisher_name": "IntelliGen Technology", "support_website_url": "https://www.anatomy-cloud.com/product/#3d-color-image-operation-guide-for-mr-headsets", "website_url": "https://www.anatomy-cloud.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24345756241766260"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "722920430439993"}]}, "baseline_offer": {"id": "722920430439993"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763348700, "status": "PUBLISHED", "id": "722920430439993"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26421278397547357", "version":
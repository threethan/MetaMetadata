&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RyGcUHNJ64k52MmS-pXuev25fO_XJwxPSHfYgY1WGNA&oe=6A09D8AC"}, {"file_name": "ForeVR_12-06-2022_01-05-47.png", "id": "1238690533369797", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75299157_1238690540036463_8448195239025955931_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cucAwYMWY_4Q7kNvwFAKFLz&_nc_oc=Ado9sU9qfVjn8hqqFK7UooT12CY7Kwm5sg4xRHu3N8H7qELaQwKQrUjHALU3ukgIfys&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KeKsK1EAVI-OCEDWfYhpxH1pOywLl4owUznnzJyNHGw&oe=6A09D95B"}, {"file_name": "Untitled design (45).png", "id": "789321638904764", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86597263_789321642238097_4677386320491320816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPxmzqrUQ-MQ7kNvwGkbyOn&_nc_oc=AdphdOz8AZG_wC2YCXlq4Vo19NPhbIW5hKkRL-vRfswBuyLS4NFHmUmBdJzHLJZy4mY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vnHP4F_RFYobFZ1eDI11-UU0ttdSIxssylHV9kFcWSQ&oe=6A09B212"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "391924583001074", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031593_391924589667740_1026518800518932938_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72oAHsrDcisQ7kNvwEvwayg&_nc_oc=AdqY1tXroKzAL2Fus4-Q0dFnYZmWOWI_jxcSPPfL73uKa6Nliha-wvdPWmzsjnLOpYI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aH3RSAZN1GDzH5jFCeZ4vChbWuPHqW4KCu5RKX-KGVw&oe=6A09B6AC"}, "display_name": "ForeVR Cornhole", "keywords": ["cornhole", "bags", "multiplayer", "sports", "games"], "long_description": "This year.... summer lasts ForeVR!\n\nPick from 50+ unique bags and boards, with classic and creative designs to suit each cornholer! \n\nExperience our custom beanbag physics, tailored for all throws and strategies, and optimized for realism. \n\nImmerse yourself in five stunning halls, with more to come!\n\nRock out to your favorite music and playlists using our YouTube-powered media player, with full multiplayer sync coming soon! \n\n\ud83c\udf3d 50+ unique bags & boards to cornhole your way\n\ud83c\udf3d 5 Halls\n\ud83c\udf3d Challengeable NPC Pros in each Hall\n\ud83c\udf3d YouTube-powered jukebox\n\ud83c\udf3d Private & quick match multiplayer\n\ud83c\udf3d 1v1 or 2v2 team battles\n\nBags, sack toss, dummy boards, doghouse, beanbag toss\u2026 no matter what you call it, it\u2019s surely the world\u2019s greatest lawn game. ForeVR Cornhole is the best (and first!) cornhole game for VR!", "short_description": "This year, summer lasts ForeVR!\n\nExperience custom beanbag physics, tailored for all throws and strategies, and optimized for realism. \n\n\ud83c\udf3d 50+ unique bags & boards\n\ud83c\udf3d 5 Halls\n\ud83c\udf3d Challengeable NPC Pros in each Hall\n\ud83c\udf3d YouTube-powered jukebox\n\ud83c\udf3d Private & public multiplayer\n\ud83c\udf3d 1v1 or 2v2 team battles\n\nBags, sack toss, dummy boards, doghouse, beanbag toss\u2026 no matter what you call it, it\u2019s surely the world\u2019s greatest lawn game. ForeVR Cornhole is the best (and first!) cornhole game in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forevrgames.com/privacy", "developer_terms_of_service_url": "http://forevrgames.com/tos", "publisher_name": "ForeVR Games Inc", "support_website_url": "http://help.forevrgames.com/", "website_url": "http://forevrgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
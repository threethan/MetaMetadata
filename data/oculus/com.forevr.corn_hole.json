&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZID4jzTJTEMw995mUQIElt38QQ2BW6nrJ1hK4PUeG0Q&oe=6AE3602C"}, {"file_name": "ForeVR_12-06-2022_01-05-47.png", "id": "1238690533369797", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75299157_1238690540036463_8448195239025955931_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZE_G1thEPQ4Q7kNvwEIy6BN&_nc_oc=AdoPNI6j7iON03vMBVUBKHWLafArL1A3Xz1F3b7QwKGoWTscBwpmWs3xKrmecTs3hds&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSFGmsMeSpKavSdL3M2bkrF0sLKD5uiZN04uLUkXNp-w&oe=6AE360DB"}, {"file_name": "Untitled design (45).png", "id": "789321638904764", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/86597263_789321642238097_4677386320491320816_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwtix2Dd5uUQ7kNvwGgIJJI&_nc_oc=AdrILsbqVDEul5kIMyDxZ3NZWsvEn5ic3OkUfwiypUmGPEpOawgUnooGycSXN4Thw-k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPz4yVuXKAu7UVpuczdEn_camYyTzOD1rS3qICMXDBUzQ&oe=6AE33992"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "391924583001074", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031593_391924589667740_1026518800518932938_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StZFyteia4EQ7kNvwG9m55A&_nc_oc=Adqpsn9M5NbMm9lxw0cCReUO8WOn3P9IflUur-MzWbGdGLFszbFCO9QyBpCb0L1GdZg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTafgZKFi3q86Z_s4tRbkU8-U5r7D-Uvx6Zx0bPYthyA&oe=6AE33E2C"}, "display_name": "ForeVR Cornhole", "keywords": ["cornhole", "bags", "multiplayer", "sports", "games"], "long_description": "This year.... summer lasts ForeVR!\n\nPick from 50+ unique bags and boards, with classic and creative designs to suit each cornholer! \n\nExperience our custom beanbag physics, tailored for all throws and strategies, and optimized for realism. \n\nImmerse yourself in five stunning halls, with more to come!\n\nRock out to your favorite music and playlists using our YouTube-powered media player, with full multiplayer sync coming soon! \n\n\ud83c\udf3d 50+ unique bags & boards to cornhole your way\n\ud83c\udf3d 5 Halls\n\ud83c\udf3d Challengeable NPC Pros in each Hall\n\ud83c\udf3d YouTube-powered jukebox\n\ud83c\udf3d Private & quick match multiplayer\n\ud83c\udf3d 1v1 or 2v2 team battles\n\nBags, sack toss, dummy boards, doghouse, beanbag toss\u2026 no matter what you call it, it\u2019s surely the world\u2019s greatest lawn game. ForeVR Cornhole is the best (and first!) cornhole game for VR!", "short_description": "This year, summer lasts ForeVR!\n\nExperience custom beanbag physics, tailored for all throws and strategies, and optimized for realism. \n\n\ud83c\udf3d 50+ unique bags & boards\n\ud83c\udf3d 5 Halls\n\ud83c\udf3d Challengeable NPC Pros in each Hall\n\ud83c\udf3d YouTube-powered jukebox\n\ud83c\udf3d Private & public multiplayer\n\ud83c\udf3d 1v1 or 2v2 team battles\n\nBags, sack toss, dummy boards, doghouse, beanbag toss\u2026 no matter what you call it, it\u2019s surely the world\u2019s greatest lawn game. ForeVR Cornhole is the best (and first!) cornhole game in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.forevrgames.com/privacy", "developer_terms_of_service_url": "http://forevrgames.com/tos", "publisher_name": "ForeVR Games Inc", "support_website_url": "http://help.forevrgames.com/", "website_url": "http://forevrgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
91316671966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkWhjhV3l9oQ7kNvwGf2Ryf&_nc_oc=AdrbhffqrVndC9pZi84o5sEBPrk1iBKO048G2P5lkESKGcYCDXFuxnrm0K-H-fd-rf8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQjBct6w5awkskUCW4deVYNOSLtGJ492HL50u2vJ6agA&oe=6B0454B3"}, {"file_name": "Image4.png", "id": "1084700594173900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620666_1084700597507233_2642564481615805770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDpfXrLIIcgQ7kNvwESAzVi&_nc_oc=AdoZ1b8WeZiKMjaAxpmwlTbkYm4_1H6i_Bx5G6Ct4K3nTXRp0WTFJzLvS78Uilmvuzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9ukjlfHt06Vz-wE9Z99zwfuLOG1JwfkSDgO8LsyYpVQ&oe=6B046C7A"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkXBsF9rL04Q7kNvwEcL1T4&_nc_oc=AdrmLn2aQY6ZHLW2y99aEmwb8OkEWBtvtafkuzL0O9gnOkJaiMYk69Yrmn85tOMr_3Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLUH8xlzAYuA2Zq5OMAbUrNQ7eY9mnZaeOc7vWdiEoKw&oe=6B045420"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "sh
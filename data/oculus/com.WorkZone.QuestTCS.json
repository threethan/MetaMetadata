91316671966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOmRlrcAeDYQ7kNvwELW9Zv&_nc_oc=Adr1E5F83E0H99vvIyjfwSMlBYeFegequoGguScUYFZz_CHxzB1-eq32GDiekmGcF9M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPOXzrWqWeL62gHi-ZGyjV5AIRytOPaUPV9JEd4PwrZQ&oe=6AFB1A33"}, {"file_name": "Image4.png", "id": "1084700594173900", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620666_1084700597507233_2642564481615805770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGtQ8XwKFwwQ7kNvwE1ca5I&_nc_oc=AdrbsOy0j5CGveG22mF1Iu2OQ1do98FRmzk230nj_vpuMyonRFg7vYNqBU3jUj5stBA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLLK_G2-1k9WIem11pPSBW9hpvFgV3IZwWa42J3WkubQ&oe=6AFB31FA"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUkpq5rsWQEQ7kNvwGVMRNu&_nc_oc=AdpxjeawQNDE_0c571a_xTrkeR6BXTh9jm5CCcJSVduvXbK_9iVLStUyRSOBYlBA8XE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpIYYKBuETzSkA_SmGeBH-6kI4CtQ5NAxdqY5U6jWfwQ&oe=6AFB19A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "sh
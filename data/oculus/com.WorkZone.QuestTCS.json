564481615805770_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlndzFwphfcQ7kNvwHzTkR-&_nc_oc=AdpDFVoESfZFt1sSC6MxurGjelyVAaKKiMAA5faNskZKlnBlAWsODOOtO6p57OkyMaU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMANpgZkUD_qJ-X-qW_Bxv8lLV5uAoym2KURIYCH60sag&oe=6ADF4A3A"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qn0LjCa7GoYQ7kNvwFBo7sA&_nc_oc=AdomBHn0o1tn8svHtarjhSBoY9XDZvNdaTAfHEC-urnyl-rg4D7zWoI5cjVkUwRHx2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrMmyttTbC2AhazfaNpzPQ3C0T-VumWp0pdD4_ftlS4Q&oe=6ADF6A20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "short_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course, providing trainees with an immersive drive-through simulation to evaluate work zone setups and identify critical safety deficiencies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/umsystem.edu/privacypolicyforitraintcsvr/home", "developer_terms_of_service_url": null, "publisher_name": "MU Transportation", "support_website_url": null, "website_url": "https://
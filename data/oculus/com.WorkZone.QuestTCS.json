ment issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "short_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course, providing trainees with an immersive drive-through simulation to evaluate work zone setups and identify critical safety deficiencies."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/umsystem.edu/privacypolicyforitraintcsvr/home", "developer_terms_of_service_url": null, "publisher_name": "MU Transportation", "support_website_url": null, "website_url": "https://mcti.missouri.edu/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1313467898526385"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1087118310619484"}]}, "baseline_offer": {"id": "1087118310619484"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792438680, "status": "PUBLISHED", "id": "1087118310619484"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1319960601210448", "version": "1.0.2"}, "id": "1760227115117561", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": 
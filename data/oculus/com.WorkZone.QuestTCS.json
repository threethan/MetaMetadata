91316671966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkWhjhV3l9oQ7kNvwHp4lzv&_nc_oc=Adq1dcuke-A3Bjoq49x8E1jQVHU4HsFbZuwcRNkizFiTw8wf5m2cW6sGBNl_IqIkz4k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_fpZ2X5jllKieL4LvD9ExfnAKrCSKI4SaGs4pMzz3ew&oe=6B05A633"}, {"file_name": "Image4.png", "id": "1084700594173900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620666_1084700597507233_2642564481615805770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDpfXrLIIcgQ7kNvwFELKNE&_nc_oc=AdpcxjtC81jPcq-fDPr3Aoa0_Gx7rxqfPM1QpNUprBaQm_mibyDGkvbcIx-3nrtkD0I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpb61DtGBoOoWUVIh5xMRew19Bguca2IV--zE1Q--Bfg&oe=6B05BDFA"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkXBsF9rL04Q7kNvwF7iy96&_nc_oc=Adp0JlXdXeN0T2pJlAVslH4pb68ZFgIqGyACNRrD5vCB6imIqTHUsOnu9etnu_ILUNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPCoxjVtC1h0dZtzaI5oVDC7MDbgOrNs_a1rlxPToLuA&oe=6B05A5A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "sh
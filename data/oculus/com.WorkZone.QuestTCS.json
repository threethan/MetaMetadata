91316671966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOmRlrcAeDYQ7kNvwFa-KHb&_nc_oc=Adq5GIzdrVf7KzreEM_8Z4FapF3T2f6TBdNkP9urZbj67nYq_YjalWZa5yicrhOb9po&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv-fGF6xb67leaHbHecipon0JuQyQ6os5Jw66EnE8DoA&oe=6AFDBD33"}, {"file_name": "Image4.png", "id": "1084700594173900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620666_1084700597507233_2642564481615805770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGtQ8XwKFwwQ7kNvwGqG-pi&_nc_oc=Adr0KAk6oQfJ6TGihC7VJrGcGWpOVB1Euh6nRQd94JNmImQQ_-us4-oJEsD6purfIPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJC4_Eww2oAYK_bMgKbWZQE5ZwGK9aJ6WyaU7vB-ewsQ&oe=6AFDD4FA"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soeOV3e8WLQQ7kNvwH0WNZv&_nc_oc=AdqxsbDyhlbH8C1Be1AkPhRLFCWpe1SJWNRlDVC9vg5yIIu5n04aJUOi8gDpPCOGbHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5VlUx1O61UsimlQ029WYdRidOzsSKmv47L2h_SoPMWA&oe=6AFDBCA0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "sh
91316671966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODVBUqxK2fUQ7kNvwHigVOD&_nc_oc=AdpObYrRWpF06djK349QXWSKbvjoP-oozGN1Tb1Bshzy5KTTnrnAOlTU2n_PXvq0KM0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTn1RlFp2ej0u5wXIsV3p005git7dF_Bl18TQsJQbPw0g&oe=6B0DC773"}, {"file_name": "Image4.png", "id": "1084700594173900", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620666_1084700597507233_2642564481615805770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8rqCQvTpS8Q7kNvwENFr6y&_nc_oc=AdoFRlC79oLFByXC41mhR-Qf1RgnEAUNZFL_M392UoX5vJ_RaPsB59z7u_RN0bbnU0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSkKkjzh4eZ7WWT5SFZukKX4AH3rUu4YHL508LsmQnVQ&oe=6B0DA6FA"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F820ryMxjVgQ7kNvwFEJehe&_nc_oc=AdrQ41L8DLrkNeq5qpyBXVdlCnqnOl4R2ZVHO1A4URduv5Sa5M-fGd72iifMDu_HKpM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSUz8nR7pqD9YgN_m6QpKHIcPOL7famS_MWY7wV7YBrTw&oe=6B0DC6E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "sh
91316671966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkWhjhV3l9oQ7kNvwE-dWEL&_nc_oc=AdreB7LgGSw0JYEOC-R3AfcSYZ4GC_ocGYs45n4V3CYyTrd-_1YBDZ5B3Pvf6J9Sczo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhq0ixvhPkpJg7L4QlfNpxWeUZwdkHMq1d1WA5E7ERag&oe=6B030333"}, {"file_name": "Image4.png", "id": "1084700594173900", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620666_1084700597507233_2642564481615805770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDpfXrLIIcgQ7kNvwEVwcqw&_nc_oc=Adq-dXTk2w5WRmKMVj3BV8N02-0Z0mbPy1clPgy6KLnWHDuEyTCBnB_FnjG2yQD7IpI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1P26bXJDpSz_clWCQjN7suIW4hQF8Fguw0vayVMMtug&oe=6B031AFA"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkXBsF9rL04Q7kNvwGjm0c3&_nc_oc=Adp55ySx563ihKbD8S_4LVV_2fTsjkpTKLVRB_XwJUJm4ocjKyd3afzVWbDXkljKc_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWKxoqhifvLhMcnOsFPgWTbplF52T3AoZweOAHIxw0Vw&oe=6B0302A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "sh
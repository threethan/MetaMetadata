91316671966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1inVHpfHj50Q7kNvwHqs0RJ&_nc_oc=AdrJbw5qsgSh03KE6yCoeEHSWmp1KWXWoZ56XDxKVWWBM_NBrC50vN4JK-Fdh-So7Jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6tK7KuLL8mRbm6nRjzQLbTBtp9qsfwBQTiToD1yjyuA&oe=6B106A73"}, {"file_name": "Image4.png", "id": "1084700594173900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620666_1084700597507233_2642564481615805770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjEX7LfDCyoQ7kNvwH0hFJ_&_nc_oc=AdpCxGJ3CwjUxV2XO12h-k4Cr_tf8Ky5lQC8UUQYKQWnDpLb_Ao0HWS6pCS6tsff8xU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVCeq9ivxftyHIAMVtArLGrR05CBO3EJbgAiCzpyAfYXg&oe=6B1049FA"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thnJnFQHkygQ7kNvwEpGb26&_nc_oc=AdrbQIT3A66Aj1sv5LNXT6OJ8xNhZxdwviC5shQuBFm1lj1dhe9hc-YgVnBVFBOWUh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVaWmL-xgh3kkPzAr3SzaEiLu6SU_eoyZNcWJ3Mt9DxTQ&oe=6B1069E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "sh
91316671966_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1-azRJKowoQ7kNvwFzRvf1&_nc_oc=AdofJ-eavCynCOQsjpAcU197WQt1DvEb2jSzUnsPMI4X9bEbXQIPoQwlZwfm5f1YbD4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuJJXxNufBhr-BlLqGDOswSSpX74wPqmgErYVB2itNNQ&oe=6AFF0EB3"}, {"file_name": "Image4.png", "id": "1084700594173900", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620666_1084700597507233_2642564481615805770_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3q0ZGJ-TfjgQ7kNvwEFstrC&_nc_oc=Adp7RBoLmtPzGAN-2gWrs5fImh4xkGKtwcgUvt7XQjWrSBNOpY5xD583ISujj3WC-JQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQ-S4qqJZkpUrJad_uhz-84S-mIzMj6lVO-qg7VJscAw&oe=6AFF267A"}, {"file_name": "ControllerMap.png", "id": "2490376324706262", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624851_2490376328039595_8768085236967045028_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soeOV3e8WLQQ7kNvwFo8li-&_nc_oc=Adp7N8rC7PPG0WByX3kVIY-lba3TjbxAsPhWHVstXVYqz6S9zkP7tfJi5lgCK6lfY2k&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-BuF_dri8WUer97k409gZ_XXwu7YECeXDQDIRCyivFA&oe=6AFF0E20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iTrain TCS VR", "keywords": [], "long_description": "iTrain TCS VR was developed to support the ATSSA Traffic Control Supervisor (TCS) course. It provides trainees with an immersive virtual environment to practice work zone inspection, hazard identification, and quality assurance.\n\nIn this simulated drive-through scenario, trainees navigate through active highway work zone setups containing realistic operational errors and layout deficiencies. Users learn to evaluate temporary traffic control plans, assess proper channelizing devices, identify signage placement issues, and verify compliance with work zone standards\u2014all within a safe, interactive VR environment.", "sh
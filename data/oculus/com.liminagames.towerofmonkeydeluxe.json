35_130566383796574167_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0a-iNo6kBMgQ7kNvwE8ivdM&_nc_oc=AdoybtgikqIS9UuI6G9t27oABnLzNubTU0zCS-5CLnFVTDn05gM7NtynV2X9SLewGJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQLYjMB2NdIRofHXoYqCK3-SnL_D1dIei3WV9_QG-WrOA&oe=6B0DA62B"}]}, "id": "1730758328122839", "locale": "en_US", "screenshots": [{"file_name": "Screenshot.png", "id": "1351315826950315", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825345_1351315833616981_5912148708018366339_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSVNrAjijngQ7kNvwFMCvVh&_nc_oc=AdrHDdQBMk-5jGU-irqkcDye0tm6aT6o8AaHCFoyZEnbbcEOqwuGMMvHWtn0cclhWwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRWtp0uRpKWYUi0c0BFOdetF1pFlbOUuibtXUo3upXwQ&oe=6B0DC4E8"}, {"file_name": "Screenshot (1).png", "id": "998937913121621", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_998937916454954_6352470869705092483_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voJikzDNpTMQ7kNvwHy_JT_&_nc_oc=Adr3BZke_xNQhkT83jxACI3WcsrJA7mITWf7hPaIaj5hoAYBEQJ_KcKQPgglHxgetTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEO2_vjjzcM2Aec0LSYd4oqAeyqmkyqilOpjsqA798UA&oe=6B0DAE8D"}, {"file_name": "Screenshot (2).png", "id": "2393738371117445", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_2393738374450778_4119162792330333706_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eabHixg2FNsQ7kNvwHxugKX&_nc_oc=AdpCVfl1iPnEjgQPv6_4ZwXwwhHmmkhYVBiycwGmAcuG0AO8ibXztq8zaFZfJwp4I9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSR81V9qjp3YwDcbaZk1Hap9fg8aKVjie8P5HK5drOE7Q&oe=6B0DB534"}, {"file_name": "Screenshot (4).png", "id": "2662249244177399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823341_2662249247510732_5236556003300383129_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCHOWRmAYvIQ7kNvwGE3bwK&_nc_oc=AdoAH3pJUCTNzNi4L8L83Gd1c5VPngKtmcrYZiApUAASJ36F5DOxdseEnkGVGmyL0Rc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSK-U2n9PxptsL8K0x2Ko7mXN6mvGxQmEDwTCR17H7vkw&oe=6B0DABFC"}, {"file_name": "Screenshot (3).png", "id": "2126802408177659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824665_2126802411510992_7898977170968002783_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvJKnmJJ9e8Q7kNvwFLX3Sh&_nc_oc=Adrqv1W0bNw_eD115MiEVsLpFor9NuY_pCJAZR6ZUGNx39jR9bWJO0esPAsM_TWtvCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQToG9zJnQ3ctgYbdpoXW8lmTo03WKpkIDEXyevdiXGuvA&oe=6B0DB79B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey DELUXE", "keywords": ["gorilla", "animal", "free", "platform", "parkour"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? YES. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n# Avoid the Ouchies\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n# Climb with the Tribe\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n# The Tower Never Ends\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "977398288682606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823310_1674340890290421_6789047670500502276_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XUDmgiaTCgQ7kNvwFF5Awh&_nc_oc=AdpOOUNUjVSqPmRMHxzBo2U-aNL064aRUeqp42klztL39rTbNGNHzdyNhiMy3gekkoY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQCewVd3EcIQW4yRujZqBiQ4ouYhSt-0lZ7M7iSkSOHPA&oe=6B0DCB98"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tower of Monkey DELUXE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name
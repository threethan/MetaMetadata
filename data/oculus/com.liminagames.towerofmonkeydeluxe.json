35_130566383796574167_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UU822bIK4ycQ7kNvwF3SNxB&_nc_oc=AdrRh7YfJ6AVCQFAr6Bc9sG4_jIYXr3LKC0Q8z6UeyUNagST1gYN6WK42sykAe4YP4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWR-zlAiddKtAGfJgaa7qwVwk_aPt1USjF9A2Ro264IQ&oe=6B10492B"}]}, "id": "1730758328122839", "locale": "en_US", "screenshots": [{"file_name": "Screenshot.png", "id": "1351315826950315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825345_1351315833616981_5912148708018366339_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSVNrAjijngQ7kNvwEDZh2Z&_nc_oc=AdrDv1SM1abnTndqFzSULh0Hxadm91-1iX_Vg8NGfc1Bmydk4TrWu_XGKbFzL4TUQzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWsLfo9d60emYnjsGiEUnnW5i6Ou_pxB4jkuuJpYWtouQ&oe=6B1067E8"}, {"file_name": "Screenshot (1).png", "id": "998937913121621", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499313063_998937916454954_6352470869705092483_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voJikzDNpTMQ7kNvwE2fKV7&_nc_oc=AdoxRgO66ddefCoBTAKmbmInPbwfVSeqYTLLHO6rzA3eTPweeCMLL4l4pIaTUxRwheo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8cZAAYpTWe5gQMtgk9fXSD6wFki0pBk-toq9G0OR5bQ&oe=6B10518D"}, {"file_name": "Screenshot (2).png", "id": "2393738371117445", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823949_2393738374450778_4119162792330333706_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eabHixg2FNsQ7kNvwHtPJ4N&_nc_oc=Adqwq0j8COsL5tK43LmWAd40AsH7xZAdIyL3O9uba0vOh_IQLGn1ToEMX9kXCSiuyus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0FCvSJQJOEU7p6D_AvBDc2jd0csoQgKJu4-m_M4t_kw&oe=6B105834"}, {"file_name": "Screenshot (4).png", "id": "2662249244177399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_2662249247510732_5236556003300383129_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONFuMuQ8h8UQ7kNvwHL49GV&_nc_oc=AdoYVfdSfkhb5m9NkqD28bLgkx5RPB0eFl_GVT_O09CXasoKJiMkft34Qd936bkBpKc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV_wJStMHA8CMki6EPZLYNv5OKiHHBROikiI_IcxL1hIA&oe=6B104EFC"}, {"file_name": "Screenshot (3).png", "id": "2126802408177659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824665_2126802411510992_7898977170968002783_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jb9GghU644wQ7kNvwGIGRbE&_nc_oc=AdpNiogZ_natLY9PNCQRoYmREbpHUrTpZJWhjdKlPf-d8Xl-iEgXz00Dc0i_RV7FgPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUkLXmNYvbHWUm16Aox_k3IakSvReWM4K9HW2WJB40U0g&oe=6B105A9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey DELUXE", "keywords": ["gorilla", "animal", "free", "platform", "parkour"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? YES. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n# Avoid the Ouchies\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n# Climb with the Tribe\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n# The Tower Never Ends\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "977398288682606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1674340890290421_6789047670500502276_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=us62VJid5y0Q7kNvwF2NHXG&_nc_oc=AdpnJBWNg3G1qrwJpoQSUVBvCXDIlxOegDpCiXp1uKh1YjXfYgkxiCCDuPPw-qnk48o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV5pKLVa8RE9RaM66kEArY3ONkR8-LbjajBxYwAPhKSSA&oe=6B103658"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tower of Monkey DELUXE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name
A70qQO7-hDRa9nwgOkfwj5BxxTSlmDKMrtWUKxQg&oe=6AEB2F4D"}, {"file_name": "Screenshot (2).png", "id": "2393738371117445", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823949_2393738374450778_4119162792330333706_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7X4e4NZNLr0Q7kNvwGVsH-i&_nc_oc=AdpiXylzT6nrFLVyleiPOv3gEeqvSuXw4E4E39HUth_-66woBo9aDFZdf7z9VAESxiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJx0JpFivDDnM50ogxdmTOcb4FLOK8HosUOhvIy-Hrrw&oe=6AEB35F4"}, {"file_name": "Screenshot (4).png", "id": "2662249244177399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_2662249247510732_5236556003300383129_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKaf8ghuuJsQ7kNvwHjLx5Z&_nc_oc=AdrF7DOkDjh0rWfBRO-Pwh-TQUHN4VdrKkyXN9xJs_N1dEJ36cPd3E-5J25fHrRSusM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtIsIiG2pFDk7dry9spxo0IcQcxx1h_e9pxLyP-UTH7g&oe=6AEB2CBC"}, {"file_name": "Screenshot (3).png", "id": "2126802408177659", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_2126802411510992_7898977170968002783_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eiu61O_YGBAQ7kNvwEgzjyT&_nc_oc=AdoKuwNIxW2xurVcNbKHavzyxEY-0SUm4deFtms2dXtUktN_RkVhFTzNjVXsVIMhe4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI61-pp8muDXPtgBerQo1q-pgDCkqrdWjPH1Bzx9s3LA&oe=6AEB385B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey DELUXE", "keywords": ["gorilla", "animal", "free", "platform", "parkour"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? YES. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n# Avoid the Ouchies\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n# Climb with the Tribe\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n# The Tower Never Ends\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "977398288682606"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1007099075709459"}, {"status": "PUBLISHED", "i
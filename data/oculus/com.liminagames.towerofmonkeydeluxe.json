eU6ALHifQ6f_jEZmxUbI1m99jrKnYc5eRW0p4u-g&oe=6AE3464D"}, {"file_name": "Screenshot (2).png", "id": "2393738371117445", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823949_2393738374450778_4119162792330333706_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXk7FoK2It4Q7kNvwFhPBem&_nc_oc=AdogV8zs89whXeVa4HmyaWrIsCN9fGUnDUn6lLclNYRZP7oJOPxCeWXp7RfGe1dcNLw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORKS3-n4o4CPA5iX1K6xuqJb-EoYQivQpyAHFmzPRF_A&oe=6AE34CF4"}, {"file_name": "Screenshot (4).png", "id": "2662249244177399", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823341_2662249247510732_5236556003300383129_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_K6H3Wnl9n0Q7kNvwFQ2B40&_nc_oc=Adp1yZ1G47ccXPV1QJV4iwq4qfPJshagGXp1A7_RB5wxWOyazbNCpAk0nZYmzVq36tg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsOVRH3fhM0fS9Yh3m5XhZAuqh5A9Sv7cpnqQ17Tdjow&oe=6AE343BC"}, {"file_name": "Screenshot (3).png", "id": "2126802408177659", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824665_2126802411510992_7898977170968002783_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4qGEF9J3YtEQ7kNvwHYzgQV&_nc_oc=AdpPIV-JZOlNBpRRxwqWWoRslkB70DNrQ45ErCw-mYOoDh2N2J23KtEj6PnqD5n_Jf4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIFbF18GAsIHoM97Qp4sU5mynVmyQxU3suDO0aRhGvCQ&oe=6AE34F5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey DELUXE", "keywords": ["gorilla", "animal", "free", "platform", "parkour"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? YES. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n# Avoid the Ouchies\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n# Climb with the Tribe\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n# The Tower Never Ends\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "977398288682606"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1007099075709459"}, {"status": "PUBLISHED", "i
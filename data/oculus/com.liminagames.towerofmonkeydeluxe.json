35_130566383796574167_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zXxiWWXJHcQ7kNvwGE9PQV&_nc_oc=AdpVl1ld1vbK_oaJyYAUusTX6E7UfEyBJ3cZL2xeqY5P-ajbozTdY_2miQXEo4387mQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQC-x1Vfy0mxgZdX1a2lbtA2RqtKimAlB50JZZHeanfgg&oe=6B0B3B6B"}]}, "id": "1730758328122839", "locale": "en_US", "screenshots": [{"file_name": "Screenshot.png", "id": "1351315826950315", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825345_1351315833616981_5912148708018366339_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXMJ8b6NguUQ7kNvwEmdG6b&_nc_oc=Adr4iC7RisaWrCh1S7N1H9hN5iufWrEl2bK1TLh5XgIRJzYM2NawPhEyFLBkJc2J1XM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnOnBjgmVR4Q3ReYGYYR8BFs1oyets-TrHXf_ybjXLsg&oe=6B0B21E8"}, {"file_name": "Screenshot (1).png", "id": "998937913121621", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313063_998937916454954_6352470869705092483_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPJTUHk6QOsQ7kNvwEw49Co&_nc_oc=AdrTwtT2y4X2MpLsIcjT7NXK8Gv8_TbvdyvfAanWzHa7SHOZ6VI_PRBo6Ao4Jyr1hfk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2ZamP4OT2oqEYS2nt4EofWT5i35arf4dMHeVB1mmDFA&oe=6B0B43CD"}, {"file_name": "Screenshot (2).png", "id": "2393738371117445", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823949_2393738374450778_4119162792330333706_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ6LIVy7S2IQ7kNvwHuNrm7&_nc_oc=Adr6PCpXrXoZ8n6y6-KKu-YNhpgxSo2GzUJ60yQN5A6AOxRek-xaXbGA1NGl_Qpjq0E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZ1Q_4Os211YXJ7AQsz_McHSbBU51LGqOmWyP3EplEZQ&oe=6B0B1234"}, {"file_name": "Screenshot (4).png", "id": "2662249244177399", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823341_2662249247510732_5236556003300383129_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCHOWRmAYvIQ7kNvwErpxI4&_nc_oc=AdqNikaPP4MdsZkdlAWC6InExcXiZd9drDdSs3Edyegglk3uqh66F1sQ8c6NPAEii3U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9IReRrykIXibGxS8ykJ5NLPRIZ9oNkbqAyL5bTtOQOQ&oe=6B0B413C"}, {"file_name": "Screenshot (3).png", "id": "2126802408177659", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824665_2126802411510992_7898977170968002783_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvJKnmJJ9e8Q7kNvwFT_vvW&_nc_oc=Adoa3HlYbAGObEHne67XgMnRGo96yFDR-Mbf4POu8gq5zrhDBQj0HU6iyE59cF7BIx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT1P-j5bozvcDtuITT0xvwy3Ho505u-JPVPRHNfhv__Ng&oe=6B0B149B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey DELUXE", "keywords": ["gorilla", "animal", "free", "platform", "parkour"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? YES. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n# Avoid the Ouchies\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n# Climb with the Tribe\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n# The Tower Never Ends\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "977398288682606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823310_1674340890290421_6789047670500502276_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCUcJ8gsxQ4Q7kNvwG1GnB4&_nc_oc=AdqXBKpCKXV1SYAD30_XBPabneOnI_UatqOE-l1uI3jiCZZiWEn7zBUUNFdxz3KOlYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4r3TVa-PyU7uyG0JWLEx7yx-faITpi_cihS9HgFU8cA&oe=6B0B2898"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tower of Monkey DELUXE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name
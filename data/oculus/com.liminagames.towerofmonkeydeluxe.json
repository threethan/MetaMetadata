ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCHOWRmAYvIQ7kNvwGHwb21&_nc_oc=AdrJazj5Ga58p-jkRUonZzM5K5ZNov0FzFb3k6XycjV7bJl51ochELuPDdbc3WVv4zc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdGb6WUc-LlMvSKpAv3mLKug6eq9Tgf5FUTrA0-zkJFQ&oe=6B0C5A7C"}, {"file_name": "Screenshot (3).png", "id": "2126802408177659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824665_2126802411510992_7898977170968002783_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvJKnmJJ9e8Q7kNvwFWAMyW&_nc_oc=AdoPb2U_szrMWHHHxkdaO4l_2Cmd-NtRqmeTPSY0zckebbHNaVDfBASFrI_NSFHAjS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhxLt3qh0OWCFegHZJ-NFa6ZleIxpRWUTZE3DKRnR-3g&oe=6B0C661B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tower of Monkey DELUXE", "keywords": ["gorilla", "animal", "free", "platform", "parkour"], "long_description": "# Monke Climb. Monke Fall. Monke Mad?\n\nThe Tower is tall. Very tall. Why? To climb! Use your arms. Swing. Grab. Reach the top. Don't look down. Scary? Yes. Fun? YES. One slip... big fall. OOPS. Back to start. You angry? Don't be mad, just be monke.\n\n# Avoid the Ouchies\n\nSpinning glowing thing? Don't touch. Lasers? Very spicy. Disappearing floor? Quick, jump! The Tower changes. New colors, new traps, new pain. It is never the same. Every floor is a new puzzle for your monke brain.\n\n# Climb with the Tribe\n\nSee another monke? Say hello! Wave your hands. You are not alone in the big tower. Race your friends to the top. Who is the fastest climber? Who has the strongest arms?\n\nFriend slipped? **OOPS!** Friend is falling... down, down, down. Don't laugh! Okay, maybe laugh a little. It is funny. Wait for them at the top or keep going? You decide. Monke leader stays at the top!\n\n# The Tower Never Ends\n\nNew updates. New towers. New ways to fall. Found a bug? Don't cry. Monke love bugs. Monke hug the bug. We fix it together. Join the tribe, talk to other monkeys, tell us your dreams.", "short_description": "Climb to the top with monkey agility! Overcome the toughest obstacles, race your friends, and be the first to reach the summit of Tower of Monkey. Don't fall!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://liminagames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Limina Games", "support_website_url": "https://liminagames.com/discord", "website_url": "https://liminagames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "977398288682606"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_1674340890290421_6789047670500502276_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XUDmgiaTCgQ7kNvwHqYfNK&_nc_oc=Adq20kI1jxZsaLkDEI3tPqHF6E3ncslGuw0y_ls8qDD1Pd8ObIeasAg5-kaDquFpOsQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoGamRxCmNMVPDCQhyFVGYcbcbpZaMlFP--zUhCAzhPg&oe=6B0C7A18"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tower of Monkey DELUXE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name
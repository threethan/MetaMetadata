mtac.VirtualTrainingLab-20260205-141026.png", "id": "1514300987082265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_1514300990415598_174111561458042638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4JZnvfzMsMQ7kNvwGftkYQ&_nc_oc=AdrpxwcoCImu1FJ_a7AIzQ58kd2X6ytRpfvhjbLJjEBGZVICyuPJ_l6aK8-cMWo-LG4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZAOEXeXbg4XN26ZG9Roc__7MYYBaj8JXS9tXTcv3gQA&oe=6A67694A"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-140052.png", "id": "27025384917101371", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307470_27025384920434704_2967946187523142169_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdElpKgZUjYQ7kNvwFy7o7f&_nc_oc=Ado9fL523dydi8IvEUXtbwMUxoTkfd6UzxlP88VmjfEeZ4dblcs19Ffbih44cGkXcto&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWa4FKbVduGAxRhFtlb9glMQa0HYtKNjbhPPzIaM1zxw&oe=6A674756"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140224.png", "id": "1724564118685420", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307422_1724564122018753_204209555506671126_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMaGz7UrTP4Q7kNvwHPgEya&_nc_oc=AdqvKXdor7BExTmZlQ9aWn943UERz1xT_vc30GC6bdNyC7hF_kiotMno_psiQLCk8oA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2CPtVaFTl24HgMWp5yZvhbIDjBJHIngIn-WnjELZ6KA&oe=6A6773F4"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140319.png", "id": "1647620526442725", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295658_1647620529776058_7492130122584658994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xjtZb5bvccQ7kNvwFaXR69&_nc_oc=AdpLmejIw0r3TFrck1iHZoAnMBvELXqxDFuswD-7nDyrLKHXOD8I-L3VH7m5uzZr9_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8ZE0dC3qyQVHHsPGGE19nYm0VSV-gYd2zhyeGrF8ZGQ&oe=6A675A48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Foundations of Energy Storage Safety", "keywords": ["Energy", "Datacenter", "Training", "Electrical", "Microgrid"], "long_description": "# Foundations of Energy Storage Safety\n\nTurn any physical room into a fully equipped, high-voltage lab with **Foundations of Energy Storage Safety**, an immersive Mixed Reality (MR) training experience.\n\nMaster electrical fundamentals and top-tier Energy Storage Solutions with hands-on practice. Learn critical safety protocols and troubleshooting techniques without the physical dangers of live voltage. \n\nUsing full-color passthrough technology, deploy industrial battery racks directly into your space. Grab your virtual tools, wire systems end-to-end, and experiment in a high-fidelity simulation that responds to your every action.\n\n### Key Features:\n* **True Mixed Reality:** Blend high-fidelity electrical equipment seamlessly into your own room using advanced passthrough.\n* **Zero-Risk Environment:** Practice complex wiring and safety precautions without real-world hazards.\n* **Hands-On Interactivity:** Build and troubleshoot interactive components that behave exactly like their physical counterparts.\n* **Maximized Retention:** Active MR exploration leads to deeper understanding and higher knowledge retention.\n\nStep into the lab and master the foundations of energy storage today!", "short_description": "Turn your room into a completely safe, high-voltage training lab. Master energy storage systems, practice complex electrical wiring, and learn critical safety protocols in immersive Mixed Reality."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://www.protogen.com/fess-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://www.protogen.com/contact/", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
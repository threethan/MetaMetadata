e": "com.esamtac.VirtualTrainingLab-20260205-141026.png", "id": "1514300987082265", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499304938_1514300990415598_174111561458042638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a99kdsDa88Q7kNvwEafEis&_nc_oc=AdruEIH-ZicaJ8yNHEENTmGUacIQa5fvIYQ83cJ09xKoQeIz0kZq9RhNI4Y2apENpto&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bIZn4J0hwgUNxj543UjCL8JqFDn_1_fGZYvjOKCwu9Q&oe=6A22DB4A"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-140052.png", "id": "27025384917101371", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307470_27025384920434704_2967946187523142169_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oK10ntU0UIMQ7kNvwEaaYmT&_nc_oc=AdoG6JDMiMnE0PsmocmJFRqEDWmbm4vG9MWtPUlJgWIFeuHXHUDV3Tx1hvD1VldDJoQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4CasF69PUy12xdTvQMciHk3krm5pkUY9Nn4sqGQYUIw&oe=6A22F196"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140224.png", "id": "1724564118685420", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499307422_1724564122018753_204209555506671126_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlpEG1gvlUgQ7kNvwGmO8n2&_nc_oc=Adp7u7atLts0d88hjRuBVeVeOBz8VXy5ZPkMZ2ppWD9bfFZTzbylgurK0nnSXWymj2I&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-05t9E2QZdYJayIEMsHFFmswaLIokX6W7GEWZez72Vew&oe=6A22E5F4"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140319.png", "id": "1647620526442725", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295658_1647620529776058_7492130122584658994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iw1HuqQozowQ7kNvwG1Hc9G&_nc_oc=AdqFk56z36Jw2-CJhN1TetVG5eP5tDhblAYQuTfSin9ghWcbbWtM5Ne0mq2WPdTVdQM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vgDjBWeKDXUcXgYzpQn_WSWZx_74FpOrr3h7Zy5MVFA&oe=6A22CC48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Foundations of Energy Storage Safety", "keywords": ["Energy", "Datacenter", "Training", "Electrical", "Microgrid"], "long_description": "# Foundations of Energy Storage Safety\n\nTurn any physical room into a fully equipped, high-voltage lab with **Foundations of Energy Storage Safety**, an immersive Mixed Reality (MR) training experience.\n\nMaster electrical fundamentals and top-tier Energy Storage Solutions with hands-on practice. Learn critical safety protocols and troubleshooting techniques without the physical dangers of live voltage. \n\nUsing full-color passthrough technology, deploy industrial battery racks directly into your space. Grab your virtual tools, wire systems end-to-end, and experiment in a high-fidelity simulation that responds to your every action.\n\n### Key Features:\n* **True Mixed Reality:** Blend high-fidelity electrical equipment seamlessly into your own room using advanced passthrough.\n* **Zero-Risk Environment:** Practice complex wiring and safety precautions without real-world hazards.\n* **Hands-On Interactivity:** Build and troubleshoot interactive components that behave exactly like their physical counterparts.\n* **Maximized Retention:** Active MR exploration leads to deeper understanding and higher knowledge retention.\n\nStep into the lab and master the foundations of energy storage today!", "short_description": "Turn your room into a completely safe, high-voltage training lab. Master energy storage systems, practice complex electrical wiring, and learn critical safety protocols in immersive Mixed Reality."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://www.protogen.com/fess-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://www.protogen.com/contact/", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "contex
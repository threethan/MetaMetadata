mtac.VirtualTrainingLab-20260205-141026.png", "id": "1514300987082265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304938_1514300990415598_174111561458042638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YRRN66SN_MQ7kNvwEL2Kul&_nc_oc=AdrBCcZg1yM0x23FuZMBVmvyoqwHs7O-05MnUoNcRqyiFah_emYrePg15OPe0TN0doM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NNeo-zM5wMDR-LxYZUtJNOssGjaibxGGji4yZRH289Q&oe=6A15AC4A"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-140052.png", "id": "27025384917101371", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307470_27025384920434704_2967946187523142169_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=972nb1f1ZusQ7kNvwHD0rh8&_nc_oc=AdpeWGegHAsMjpuuf10R5WF70D9NMVuEZcXqlc9YBMlmbLufz51fidG5ncLuH4vQZqs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76f-Ar3Rl-zlNSDl0jUWwZ7fPDYKUYCcxiUoa6keW6Wg&oe=6A15C296"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140224.png", "id": "1724564118685420", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307422_1724564122018753_204209555506671126_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoxbjXQPbVkQ7kNvwG1E-bo&_nc_oc=Adq44JaKC-eee6lTNk8vJ5OIlCxt5-3OPbxpV0z5MSVJWuC-QsuGb9sHS2mxdxb9aC0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DerSNWE28oJG9XnFt2LFvDovndWvSkmqEO4-8-XlnSA&oe=6A15B6F4"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140319.png", "id": "1647620526442725", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295658_1647620529776058_7492130122584658994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWGEMu7sTqkQ7kNvwHk1Oom&_nc_oc=AdqxrjSKsrdGm98EHYZf8Z4wfjLi8v-ZnD6T0_WkuFAETHUjXl-p62VV4MA5Mjx85Xg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ijqNrvKasHFZdCd8s_3V-o_gkJBRyniY2gun6TOgGmA&oe=6A159D48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Foundations of Energy Storage Safety", "keywords": ["Energy", "Datacenter", "Training", "Electrical", "Microgrid"], "long_description": "# Foundations of Energy Storage Safety\n\nTurn any physical room into a fully equipped, high-voltage lab with **Foundations of Energy Storage Safety**, an immersive Mixed Reality (MR) training experience.\n\nMaster electrical fundamentals and top-tier Energy Storage Solutions with hands-on practice. Learn critical safety protocols and troubleshooting techniques without the physical dangers of live voltage. \n\nUsing full-color passthrough technology, deploy industrial battery racks directly into your space. Grab your virtual tools, wire systems end-to-end, and experiment in a high-fidelity simulation that responds to your every action.\n\n### Key Features:\n* **True Mixed Reality:** Blend high-fidelity electrical equipment seamlessly into your own room using advanced passthrough.\n* **Zero-Risk Environment:** Practice complex wiring and safety precautions without real-world hazards.\n* **Hands-On Interactivity:** Build and troubleshoot interactive components that behave exactly like their physical counterparts.\n* **Maximized Retention:** Active MR exploration leads to deeper understanding and higher knowledge retention.\n\nStep into the lab and master the foundations of energy storage today!", "short_description": "Turn your room into a completely safe, high-voltage training lab. Master energy storage systems, practice complex electrical wiring, and learn critical safety protocols in immersive Mixed Reality."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://www.protogen.com/fess-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://www.protogen.com/contact/", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
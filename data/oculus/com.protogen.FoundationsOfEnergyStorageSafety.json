647620526442725", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499295658_1647620529776058_7492130122584658994_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cj2XBGI9x48Q7kNvwFCxtNa&_nc_oc=AdpFKeEkHuaKTAc-zz1io57eBoWwXuwPBZitGjGCyi3LBTuOgPzGdooTwjDV7kMf4y8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9n4P6ahtMVdHtPjecskT6biaYKeNdmzBs64NTAw2a6A&oe=6AFC8C08"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Foundations of Energy Storage Safety", "keywords": ["Energy", "Datacenter", "Training", "Electrical", "Microgrid"], "long_description": "# Foundations of Energy Storage Safety\n\nTurn any physical room into a fully equipped, high-voltage lab with **Foundations of Energy Storage Safety**, an immersive Mixed Reality (MR) training experience.\n\nMaster electrical fundamentals and top-tier Energy Storage Solutions with hands-on practice. Learn critical safety protocols and troubleshooting techniques without the physical dangers of live voltage. \n\nUsing full-color passthrough technology, deploy industrial battery racks directly into your space. Grab your virtual tools, wire systems end-to-end, and experiment in a high-fidelity simulation that responds to your every action.\n\n### Key Features:\n* **True Mixed Reality:** Blend high-fidelity electrical equipment seamlessly into your own room using advanced passthrough.\n* **Zero-Risk Environment:** Practice complex wiring and safety precautions without real-world hazards.\n* **Hands-On Interactivity:** Build and troubleshoot interactive components that behave exactly like their physical counterparts.\n* **Maximized Retention:** Active MR exploration leads to deeper understanding and higher knowledge retention.\n\nStep into the lab and master the foundations of energy storage today!", "short_description": "Turn your room into a completely safe, high-voltage training lab. Master energy storage systems, practice complex electrical wiring, and learn critical safety protocols in immersive Mixed Reality."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://www.protogen.com/fess-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://www.protogen.com/contact/", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33858095267107281"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2873138546376158"}]}, "baseline_offer": {"id": "2873138546376158"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779136980, "status": "PUBLISHED", "id": "2873138546376158"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36376401721943277", "version": "0.0.0.4"}, "id": "846886754775645", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33858095157107292", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "36376401721943277"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "846886754775645
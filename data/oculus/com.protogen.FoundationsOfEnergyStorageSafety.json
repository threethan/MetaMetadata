e": "com.esamtac.VirtualTrainingLab-20260205-141026.png", "id": "1514300987082265", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499304938_1514300990415598_174111561458042638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhLMLQVp1oIQ7kNvwG2Kd_2&_nc_oc=AdrnZw7dwylgQcR27RGXTspG-W3kGqujzZQereN8wVrflKYs1eqiaBH2NfxT_pMGIIw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qjtDeFLJhdkoytpll1aU8FcI9n2gM4Ox4v0nH7w0GqQ&oe=6A3944CA"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-140052.png", "id": "27025384917101371", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307470_27025384920434704_2967946187523142169_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfU64m8nrdkQ7kNvwEEx-_w&_nc_oc=Adrq5ni5I_1RcsTHXDPvQfLdJCDrp9cQIixCwOp0gM4DSnGNMXrP_PzegxW7RiET9eQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x-I5_e-wvLRPay7Y99PWwcxlmwavdeX_I-ahNLZEZZw&oe=6A395B16"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140224.png", "id": "1724564118685420", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499307422_1724564122018753_204209555506671126_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOFGAgKYKGsQ7kNvwEhnbs1&_nc_oc=Adprs9OOLSohvbBI10g0zIuBrCw9MjMver8sgefg7aUZfCM0G8Lh-UQ4AA3br9v7m24&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7gBc3Yi528YDJtcFcmad5p2Lv_aBZEwXEzKO1ZiHNxQ&oe=6A394F74"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140319.png", "id": "1647620526442725", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295658_1647620529776058_7492130122584658994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkFh7S9CGqkQ7kNvwENUffu&_nc_oc=Adoj-n5C1HRyT1m8FidRI4AGEVqM6pBGnUH6Sw_B6d7c_k6lXoDYpDCZZL1zfZv3cII&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gsbfZ8wcCl92CP0Sg_A09tGCZ83-pA5Q6xkrZ_9Xl0Q&oe=6A3935C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Foundations of Energy Storage Safety", "keywords": ["Energy", "Datacenter", "Training", "Electrical", "Microgrid"], "long_description": "# Foundations of Energy Storage Safety\n\nTurn any physical room into a fully equipped, high-voltage lab with **Foundations of Energy Storage Safety**, an immersive Mixed Reality (MR) training experience.\n\nMaster electrical fundamentals and top-tier Energy Storage Solutions with hands-on practice. Learn critical safety protocols and troubleshooting techniques without the physical dangers of live voltage. \n\nUsing full-color passthrough technology, deploy industrial battery racks directly into your space. Grab your virtual tools, wire systems end-to-end, and experiment in a high-fidelity simulation that responds to your every action.\n\n### Key Features:\n* **True Mixed Reality:** Blend high-fidelity electrical equipment seamlessly into your own room using advanced passthrough.\n* **Zero-Risk Environment:** Practice complex wiring and safety precautions without real-world hazards.\n* **Hands-On Interactivity:** Build and troubleshoot interactive components that behave exactly like their physical counterparts.\n* **Maximized Retention:** Active MR exploration leads to deeper understanding and higher knowledge retention.\n\nStep into the lab and master the foundations of energy storage today!", "short_description": "Turn your room into a completely safe, high-voltage training lab. Master energy storage systems, practice complex electrical wiring, and learn critical safety protocols in immersive Mixed Reality."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://www.protogen.com/fess-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://www.protogen.com/contact/", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "contex
e": "com.esamtac.VirtualTrainingLab-20260205-141026.png", "id": "1514300987082265", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499304938_1514300990415598_174111561458042638_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AC9Mho_oPV4Q7kNvwHD-Hbf&_nc_oc=Adok7v2h1q-jod3lmDMHur-EdsH4ngNvCqEKFDmJg1GSyS3WaiCPL7rsv28sPJTKhes&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KstrE-y4ENuE45NpbWfOPEXwKlsR6e4lU00ltMZM67w&oe=6A4673CA"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-140052.png", "id": "27025384917101371", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499307470_27025384920434704_2967946187523142169_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t5vI-HttJgQ7kNvwGqc95W&_nc_oc=Adq7Z1qzrLJghA7GQdQLdk8tVmfpPjdb_HMFZuCIOzr9wi__f7ql5kd7Z0PJ7OokjWU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eQQHjf1TKFUVDIwjxWCkgVNoPfdAmw9XrjqY4owG9bQ&oe=6A468A16"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140224.png", "id": "1724564118685420", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499307422_1724564122018753_204209555506671126_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAADYHq77J0Q7kNvwHARTPY&_nc_oc=Adp3NDzwOU9ybj1DCCNzOzKg4zXWpOA0UFU34tJF70-TrP7wjkHFGtohUD0h_ryEVMw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FSim-NY0NFH9PGuHrBpnJZkJlHfi7P6Vt5qQRBAiacg&oe=6A467E74"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140319.png", "id": "1647620526442725", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499295658_1647620529776058_7492130122584658994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqyNsDxmkasQ7kNvwHw4AvX&_nc_oc=AdpDoHvIsf7o-wjlVOh3W2LRddURbKGHJJT0RV4hhi41Kw5kFD3pgaraXOwdb31hX5M&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V6DWUdSFgKVc-11G-syeoisp7WYtc6RNaVWGFgbdnzA&oe=6A4664C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Foundations of Energy Storage Safety", "keywords": ["Energy", "Datacenter", "Training", "Electrical", "Microgrid"], "long_description": "# Foundations of Energy Storage Safety\n\nTurn any physical room into a fully equipped, high-voltage lab with **Foundations of Energy Storage Safety**, an immersive Mixed Reality (MR) training experience.\n\nMaster electrical fundamentals and top-tier Energy Storage Solutions with hands-on practice. Learn critical safety protocols and troubleshooting techniques without the physical dangers of live voltage. \n\nUsing full-color passthrough technology, deploy industrial battery racks directly into your space. Grab your virtual tools, wire systems end-to-end, and experiment in a high-fidelity simulation that responds to your every action.\n\n### Key Features:\n* **True Mixed Reality:** Blend high-fidelity electrical equipment seamlessly into your own room using advanced passthrough.\n* **Zero-Risk Environment:** Practice complex wiring and safety precautions without real-world hazards.\n* **Hands-On Interactivity:** Build and troubleshoot interactive components that behave exactly like their physical counterparts.\n* **Maximized Retention:** Active MR exploration leads to deeper understanding and higher knowledge retention.\n\nStep into the lab and master the foundations of energy storage today!", "short_description": "Turn your room into a completely safe, high-voltage training lab. Master energy storage systems, practice complex electrical wiring, and learn critical safety protocols in immersive Mixed Reality."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://www.protogen.com/fess-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://www.protogen.com/contact/", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "contex
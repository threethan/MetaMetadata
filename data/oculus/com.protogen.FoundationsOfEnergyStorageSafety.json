&_nc_ohc=5YRRN66SN_MQ7kNvwErg71j&_nc_oc=AdpO3o3_YD4aFYstWcSa-sk4WwoPJVZ3w-hpwzeeT3Ji7ZEwdK3AR9nfIjx38S36y-E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5YXID1nSnQajo1XFAMVBDRJjURYQmwkbVMEkTtZOdjxg&oe=6A13094A"}, {"file_name": "com.esamtac.VirtualTrainingLab-20260205-140052.png", "id": "27025384917101371", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499307470_27025384920434704_2967946187523142169_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRkFyDn4SGAQ7kNvwF89_3x&_nc_oc=AdrLh5jkAQC5st7EsADngwW-WqBzu4orQOTl7IuJebvXR2C0C6wA7j50tRdzoeRMZa0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l0CK4nk-Fq3aYFFH9lrSe7_EXXhxtJKltl_9w-rSjfA&oe=6A131F96"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140224.png", "id": "1724564118685420", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307422_1724564122018753_204209555506671126_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzC5KK6DY6oQ7kNvwHPI97K&_nc_oc=Adpr7-lOgOrmsh7yKQskXlycZtGbFqLB5njd2ziGjZfvRhVuiDkb42TnBJjjDJkWTcw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fnOhp2vFwStfaYqkYqHhJKuwSzJehi4b88aI_7oMMpg&oe=6A1313F4"}, {"file_name": "com.protogen.FoundationsOfEnergyStorageSafety-20260205-140319.png", "id": "1647620526442725", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499295658_1647620529776058_7492130122584658994_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zckwEqpNOYcQ7kNvwFkYX-q&_nc_oc=AdopQ7CupmCDt2JXIUEwHWSzRUBiqWFPvXwing1z47hBPupE4Vo-6dGqz4H1CfOmk24&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49DObHK-XBLJHoTFx9onKN1veS7rijstPynXt_2ZAY8Q&oe=6A12FA48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Foundations of Energy Storage Safety", "keywords": ["Energy", "Datacenter", "Training", "Electrical", "Microgrid"], "long_description": "# Foundations of Energy Storage Safety\n\nTurn any physical room into a fully equipped, high-voltage lab with **Foundations of Energy Storage Safety**, an immersive Mixed Reality (MR) training experience.\n\nMaster electrical fundamentals and top-tier Energy Storage Solutions with hands-on practice. Learn critical safety protocols and troubleshooting techniques without the physical dangers of live voltage. \n\nUsing full-color passthrough technology, deploy industrial battery racks directly into your space. Grab your virtual tools, wire systems end-to-end, and experiment in a high-fidelity simulation that responds to your every action.\n\n### Key Features:\n* **True Mixed Reality:** Blend high-fidelity electrical equipment seamlessly into your own room using advanced passthrough.\n* **Zero-Risk Environment:** Practice complex wiring and safety precautions without real-world hazards.\n* **Hands-On Interactivity:** Build and troubleshoot interactive components that behave exactly like their physical counterparts.\n* **Maximized Retention:** Active MR exploration leads to deeper understanding and higher knowledge retention.\n\nStep into the lab and master the foundations of energy storage today!", "short_description": "Turn your room into a completely safe, high-voltage training lab. Master energy storage systems, practice complex electrical wiring, and learn critical safety protocols in immersive Mixed Reality."}]}, "developer_name": "ProtoGen", "developer_privacy_policy_url": "https://www.protogen.com/fess-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ProtoGen Inc.", "support_website_url": "https://www.protogen.com/contact/", "website_url": "https://www.protogen.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVE
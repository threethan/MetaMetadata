0a&_nc_ohc=x4e3PsOcuXkQ7kNvwHjAofV&_nc_oc=Adq4JE_U24xb_G9s2tTzeVX_uhuzsxg-5Gn-Ig3-FUigNBbVD_9kMqyoi8tvWukguko&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JsvIjd8nXDGO8p3osy57BRyemsnmH5rv_NW4fdU4EYw&oe=69D64EAC"}, "display_name": "Cup Strike VR", "keywords": [], "long_description": "Cup Strike VR is a fast-paced VR target game designed to test your precision and focus.\n\nPlayers shoot at towers of stacked cups placed at different distances. Every hit collapses the tower realistically using physics, rewarding accuracy and strategy.\n\nCustomize the environment by changing sky colors and cup patterns, adjust the tower distance for difficulty, and reset the tower instantly to keep playing.\n\nWhether you want a relaxing aiming challenge or a competitive score chase, Cup Strike VR offers a simple yet addictive gameplay experience.", "short_description": "Cup Strike VR is a fun physics-based shooting game where players fire at stacked cup towers from different distances. Test your aim, knock down cups, and compete for the highest score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupstrike/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_m
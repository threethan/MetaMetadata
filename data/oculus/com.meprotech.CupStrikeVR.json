culuscdn.com&_nc_ss=7f20f&oh=00_AQGv-yk1nnmEeNPgqf2A9qwQNwXFSUjSvf8bBt63MYVEFg&oe=6A8AE5FD"}, {"file_name": "ss7.png", "id": "1464719998540466", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618103_1464720001873799_8215814623911770602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgGrJ6VlRfcQ7kNvwEmriZi&_nc_oc=Adp_eNA75W9gv2GvJTbeHyOJWPQFUeLsXuxBihDW4IZpJoQzWEZhXGOWha6rUEmUPY4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtfmYwguv8cTDSemti0SzD0zymQE8l29mWnWzrfm8DvQ&oe=6A8ADEB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2171717220261696", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618064_2171717223595029_5490674640020306279_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL0XGvDGPM0Q7kNvwFbnxct&_nc_oc=Ado2G9ghPVoW3ugdQX--6WSlAncLDid70yj6vFcpQSav569Y6L1k82eWYKKX-enVxMo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdp4FpztC4yplTYKtmDSf4uiJZCJrBXtY8DM3cp4WiiQ&oe=6A8AEA1C"}, "display_name": "Cup Strike", "keywords": ["cup", "table", "gun", "shooter", "clash"], "long_description": "Cup Strike is an engaging physics-based shooting game built for immersive play. Aim at towers of stacked cups placed at different distances and test your precision and focus.\n\nThe new update now introduces the addition of an AK  47-style weapon, bringing a more intense and satisfying shooting experience to the game.\n\n{1141237354847271}\n\n- Change cup designs to match your preferred style\n- Instantly refresh towers to restart and try again quickly\n- Turn table movement on or off for a stable or dynamic challenge\n- Adjust sky colors to create the environment you like\n- Switch between different scenes for a fresh experience.\n\n{25989506950751729}\n\nThis flexibility makes Cup Strike VR easy to enjoy at your own pace\u2014whether you want a calm, relaxing session or a more engaging challenge.\n\nEach shot delivers realistic physics\u2014cups fall, scatter, and react based on your accuracy, making every hit satisfying and every miss a chance to improve. Instant tower reset keeps gameplay fast and uninterrupted.\n\nWith multiple environments and scenes, the game stays visually fresh. Simple mechanics, responsive controls, and smooth gameplay make it easy to start and hard to stop\u2014perfect for both relaxation and competitive play.\n", "short_description": "Cup Strike is a fast-paced physics-based shooting game where you aim at stacked cup towers from varying distances. Test your precision, knock down cups with realistic physics, and chase high scores. Customize environments, adjust difficulty, and instantly reset to keep the action going."}, {"images": {"nodes": [{"file_name": "ss12.png", "id": "2175774379917399", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618103_2175774383250732_8076768027270501944_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBLikqvjJwAQ7kNvwG3fG5L&_nc_oc=AdrM5I4fmJdiM-DGhDDnXN2d6h4G62TQacEzUz-elpFqqpX4NRFcEXzyCGE8G0ep51c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3ZECr_h8yqmjbzFT3jOdErcyHpRnjpYkchSenUH-QiQ&oe=6A8AE148"}, {"file_name": "ss11.png", "id": "2137699910339220", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618288_2137699913672553_7423868979154946533_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRajR_xqYo0Q7kNvwE4tmc9&_nc_oc=AdrYsouxYBa50vwB-ZeOBKhrzpmwJs1zhRI2dBROu5y9XdLC4uRmS6C4bAUCUP9eSb8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET-eZ38_OAzCg4iUfIRkjeoO6eVkgwPhQRMoqRnFnTcA&oe=6A8AC0CC"}, {"file_name": "ss20.png", "id": "2026270254590937", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823366_2026270257924270_6876216673136844395_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfdAu93wD2gQ7kNvwEbdZgX&_nc_oc=Adog65TMiScGCY90CzBiVZHiW4BCDJnlqOZpmZe30tHSB9snKYVxhHZWDc0kqQKqtTQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7_MA88Pt12PilyqQzfEJcKNiC7oNCM7X1yPjcUeJODA&oe=6A8AD70E"}, {"file_name": "ss20.png", "id": "1687894862545288", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827601_1687894865878621_3103823809529815111_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjvIhOOvM_AQ7kNvwEiGJR4&_nc_oc=AdpQLzwlvJxuqvtxKoAbVCEiW5weR_4Z5DoEI0Z7NQL15SxN2lm1PixwWU1qr2_uoGA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQB4AKaYIedI5rD0NueYKJ0RcRfaeQVoflX7imxSoDjA&oe=6A8AE134"}, {"file_name": "ss10.png", "id": "1616871636189416", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499309561_1616871639522749_3073266000227229010_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKLQEh0lewAQ7kNvwGZgiBt&_nc_oc=AdrJHqmxy3Tn3n2vM_glgHN1tyriYPpd1O0xtyBEZTxEgda2t29RlygF0bkeeM3scc0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjX6Umx0iPewLXoW4MrdEcnOR2jm2oW-MnArfhGT8dWA&oe=6A8AD1D6"}, {"file_name": "499617850_2219903915212734_8826469387072428556_n.png", "id": "1310525854314591", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828038_1310525857647924_3775834342589674906_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_UGJ9BNXewQ7kNvwGD3hUY&_nc_oc=AdpKB2PzPFbLwjiMZZdvx1wVBbLmY5g4eDojHI2wmu3vlRwUvK7vDBq4DYzJxOQ14Dw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRJgRNQ-gDvrCLLohTstgFYdC6QXdBt4aPoKomCsFmAw&oe=6A8ACA03"}, {"file_name": "499619805_892340833760895_3223583406558202226_n.png", "id": "980353391206311", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821704_980353401206310_1750651195155501886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7c7ZhURhyQQ7kNvwHiBTCm&_nc_oc=Adoh984vTj0bEtoRArCrSFDVDvbmqmDzc62g131laWVCM7P1gG-KD0Y2U8huQXGtnvE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-YWGyAHoze8WR_CtYudNNhthqDLqbqJLDcd3EEFSWUw&oe=6A8AEC2A"}, {"file_name": "Image Sequence_048_0050 (1).png", "id": "923481090738775", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825546_923481094072108_7140013932072263624_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_n_VRvWwIUQ7kNvwHMj-KL&_nc_oc=Adp5CiEY-OFokDfA2cuRCwit1GS93ubGy_pc7xL7hxrqHwoip2V1unoQ37wwEUUFTmc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpwU2lhg0zjloAgUhT42Nx6Z0EtqR51qMy380XzYnsDQ&oe=6A8AE8A6"}]}, "id": "1302114584761030", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Strike", "keywords": [], "long_description": "Cup Strike es un emocionante juego de disparos basado en f\u00edsica, dise\u00f1ado para ofrecer una experiencia inmersiva. Apunta a torres de vasos apilados colocadas a diferentes distancias y pon a prueba tu precisi\u00f3n y concentraci\u00f3n.\n\nLa nueva actualizaci\u00f3n ahora introduce un arma estilo AK47, brindando una experiencia de disparo m\u00e1s intensa y satisfactoria.\n\n{923481090738775}\n\n* Cambia los dise\u00f1os de los vasos para que coincidan con tu estilo preferido\n* Reinicia instant\u00e1neamente las torres para volver a intentarlo r\u00e1pidamente\n* Activa o desactiva el movimiento de la mesa para un desaf\u00edo estable o din\u00e1mico\n* Ajusta los colores del cielo para crear el entorno que m\u00e1s te guste\n* Cambia entre diferentes escenarios para disfrutar de una experiencia renovada\n\n{1687894862545288}\n\nEsta flexibilidad hace que Cup Strike VR sea f\u00e1cil de disfrutar a tu propio ritmo, ya sea que quieras una sesi\u00f3n tranquila y relajante o un desaf\u00edo m\u00e1s emocionante.\n\nCada disparo ofrece una f\u00edsica realista: los vasos caen, se dispersan y reaccionan seg\u00fan tu precisi\u00f3n, haciendo que cada acierto sea satisfactorio y cada fallo una oportunidad para mejorar. El reinicio instant\u00e1neo de las torres mantiene la jugabilidad r\u00e1pida y sin interrupciones.\n\nCon m\u00faltiples entornos y escenarios, el juego se mantiene visualmente fresco. Sus mec\u00e1nicas simples, controles responsivos y una jugabilidad fluida hacen que sea f\u00e1cil de empezar y dif\u00edcil de dejar, perfecto tanto para relajarse como para jugar de manera competitiva.\n", "short_description": "Cup Strike es un juego de disparos r\u00e1pido basado en f\u00edsica donde apuntas a torres de vasos apilados desde diferentes distancias. Pon a prueba tu precisi\u00f3n, derriba los vasos con f\u00edsica realista y compite por las puntuaciones m\u00e1s altas. Personaliza los entornos, ajusta la dificultad y reinicia al instante para seguir jugando."}, {"images": {"nodes": [{"file_name": "ss11.png", "id": "2564854617242481", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620817_2564854620575814_6480617183322368310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTE9jG7hNj0Q7kNvwE3IlJF&_nc_oc=AdpwhdxDSzptBShChju5C2DHkLNfUeygY2aNMKsjLRrmLb6ptHhQgq1klRWLO0MLaNA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsSiutpeCuEd9qd34NVut7Jqh0jRa3BYTkOb87m_7k5w&oe=6A8AF403"}, {"file_name": "ss20.png", "id": "1962632087669404", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819845_1962632091002737_8129632245548559257_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DU-awm--CdYQ7kNvwEbp8BD&_nc_oc=AdqFdSuTi8sSHWQ-uAl43gN6v4Al4ChbLvOUMUf2hbhT_-rRLThIacg_JUmYW1eOE2U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn0aAN9D2uvIu7_L4SZzipVNW9X235Shb4lwPpAHNCVA&oe=6A8AD250"}, {"file_name": "499617850_2219903915212734_8826469387072428556_n.png", "id": "1601771817756768", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.577
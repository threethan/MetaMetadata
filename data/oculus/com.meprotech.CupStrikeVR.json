y_2mrWWHg&oe=69D2579B"}, {"file_name": "ss5.png", "id": "789752777526374", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827567_789752780859707_279328550106910350_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02ay3tyg9XQQ7kNvwGavLPt&_nc_oc=AdoLyIEzxLpHZ_pzokzY-13NXfsbzdFv-e_OjdjbWa2ysZR4EQsOySjEjpggFgHEvko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lflmc1P3Tkka81bAZ0iYoqIw0Gi1NtiNW8zGhzl6QPA&oe=69D2650D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Strike VR", "keywords": [], "long_description": "Cup Strike VR is a fast-paced VR target game designed to test your precision and focus.\n\nPlayers shoot at towers of stacked cups placed at different distances. Every hit collapses the tower realistically using physics, rewarding accuracy and strategy.\n\nCustomize the environment by changing sky colors and cup patterns, adjust the tower distance for difficulty, and reset the tower instantly to keep playing.\n\nWhether you want a relaxing aiming challenge or a competitive score chase, Cup Strike VR offers a simple yet addictive gameplay experience.", "short_description": "Cup Strike VR is a fun physics-based shooting game where players fire at stacked cup towers from different distances. Test your aim, knock down cups, and compete for the highest score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupstrike/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
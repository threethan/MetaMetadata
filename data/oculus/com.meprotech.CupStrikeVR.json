rMnOu5Zc-ywRrvWM4CbdBb9tuFv2bGotIM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VaLExo4h5EyOpxsypTqOE8yq321YPl3B2-G1vBJdf1Q&oe=69FF1DCE"}, {"file_name": "ss8.png", "id": "964059209431914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618472_964059212765247_7019363487711533833_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuvBpCdZiQgQ7kNvwHmd9Rb&_nc_oc=AdqvdXKYAOirTUBio9eYjrbIoRSUCuESGdRdPYJ_3C1GHvrUnUWpKteTYkRLU4fImrk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mt-04Ee6BE1Go2mCqOxekIqiHr-AjXy3nVxPPtUKxGQ&oe=69FF26FD"}, {"file_name": "ss3.png", "id": "860474863506987", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819323_860474866840320_2702354553754536560_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-uv63tGx-EQ7kNvwFZg52d&_nc_oc=AdpECvBhJFOY2BW03o21shwj-UpFGqKRK7sc1SOFeuyFRR_5YANDy9BEUi55VbeQVRE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Rr_mGHvcKQmuvqaqm6FCfP2dtfJLfPLDU029NvJIeJQ&oe=69FF2ED0"}, {"file_name": "ss7.png", "id": "1464719998540466", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618103_1464720001873799_8215814623911770602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcrL4nIfVvgQ7kNvwEzUVfO&_nc_oc=AdrxxvuZKVAdCv9ntHbr0UF5itsJnrNjm3JIcUZM0jqFcfFEXJHU8n1BpLD9oNqCQ5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cYiV0muCKgydO4mY8kUK8QbNul-wB2efuiB4EB2a04w&oe=69FF1FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2171717220261696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_2171717223595029_5490674640020306279_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdXEmr4xxjsQ7kNvwFsCOY4&_nc_oc=AdqNVfiBJgxnjAZ9SZqBB1zoH-BoQDvJy0diy3qJsqB1Rd18rKj0TQGNlzeI0H_Htxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6z2W-1WeGPh3DWdaEtsYDmVeVU_uEzTGdsr_SKt1E8wQ&oe=69FF2B1C"}, "display_name": "Cup Strike", "keywords": ["cup", "table", "gun", "shooter", "clash"], "long_description": "Cup Strike is an engaging physics-based shooting game built for immersive play. Aim at towers of stacked cups placed at different distances and test your precision and focus.\n\nThe game now features a new settings panel that gives you full control over your experience in a simple and intuitive way. You can easily customize how the game looks and feels without interrupting gameplay.\n\n{25989506950751729}\n\n\n- Change cup designs to match your preferred style\n- Instantly refresh towers to restart and try again quickly\n- Turn table movement on or off for a stable or dynamic challenge\n- Adjust sky colors to create the environment you like\n- Switch between different scenes for a fresh experience.\n\nWith smooth controls and a quick reset option, everything is designed to be fast and hassle-free. This flexibility makes Cup Strike VR easy to enjoy at your own pace\u2014whether you want a calm, relaxing session or a more engaging challenge.\n\n{892340830427562}\n\nEach shot delivers realistic physics\u2014cups fall, scatter, and react based on your accuracy, making every hit satisfying and every miss a chance to improve. Instant tower reset keeps gameplay fast and uninterrupted.\n\n{2219903911879401}\n\nWith multiple environments and scenes, the game stays visually fresh. Simple mechanics, responsive controls, and smooth gameplay make it easy to start and hard to stop\u2014perfect for both relaxation and competitive play.\n", "short_description": "Cup Strike is a fast-paced physics-based shooting game where you aim at stacked cup towers from varying distances. Test your precision, knock down cups with realistic physics, and chase high scores. Customize environments, adjust difficulty, and instantly reset to keep the action going."}, {"images": {"nodes": [{"file_name": "ss20.png", "id": "27014910791460917", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_27014910808127582_354050377406341739_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBMu5TcmrJkQ7kNvwHZ81HB&_nc_oc=Adoueq6DTe8m1myTlNJvV4gb_kgA29NGoQUttBckKIsyv0-NmLY6S1oyavO61wygavI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ibO1C6SxcLrwTOToleOS_BRpwPD5skoiJMUPQhJ5tuQ&oe=69FF1E00"}, {"file_name": "499617850_2219903915212734_8826469387072428556_n.png", "id": "3496958223798063", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_3496958227131396_1804231793445713392_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPOP5uKHvLkQ7kNvwG44Fcu&_nc_oc=AdoiaPvw3XQ4C6XjttAGz96TP3MZ6uSte6Q-4qT12ZR0AqmJwxJHGzXoEZm9tHcF0Cw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GakJwDBfJiWGVV4ry19YFmrpZrpcybdY4ayaw6keEzQ&oe=69FF3BC9"}, {"file_name": "ss12.png", "id": "1627138795270764", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_1627138798604097_2749878719314162201_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oO5MrAe9pcQ7kNvwH1ChIC&_nc_oc=Adpoy_v1oNIXznfp-sYL9BSn8YrZO91ybb6xzA51TfrG7ZV0pk2Fn0RP7UCfyW-zOMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61AhDMH2PQYiIVBat9Fq0azZFEaeGjXiG1b5eYdT4sxw&oe=69FF40B7"}, {"file_name": "ss10.png", "id": "1308542097797728", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623534_1308542104464394_3036847124162317759_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rxFWQ5TCPKkQ7kNvwGiMyt6&_nc_oc=AdoexYqYiv89Gdpt4DdfU2AZ5T9-eRI2aW82WQFetDGgF62JkN12ushvmf2XS7rDLHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5I_MBi9kHKj9OCSO9dYX13cc7yrCqR5GGA910B6MovBg&oe=69FF20A0"}, {"file_name": "499619805_892340833760895_3223583406558202226_n.png", "id": "1290783493021990", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821674_1290783496355323_4072917353330672714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejjmDBn8jJkQ7kNvwFCGX1i&_nc_oc=Adobg8jhA-X3cD4eEusKgVC7sXmoRrdiJgTWYf4aZ7XAZ1_GZH_nt_lK-onnCt9Pev4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EpPvfAQTRN-g4BB48GGIIllbTXHT4e7ok_xlf4noREg&oe=69FF485A"}, {"file_name": "ss11.png", "id": "937457849213474", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619145_937457855880140_4901934366269077737_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-P_NTC1GR8Q7kNvwGZvBvM&_nc_oc=AdrBa8_FvxUpHIKubJGhenFF3WGZHlt72degJamlF2WJaMirUZxK6k-Ozgk2OaPo-gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eO_NUDYgNmnYfZ-FsY6G4eyFCSZmbuQNLJNX9tGvOVA&oe=69FF213B"}]}, "id": "834917029648255", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Strike", "keywords": [], "long_description": "Cup Strike \u662f\u4e00\u6b3e\u57fa\u4e8e\u7269\u7406\u7684\u6c89\u6d78\u5f0f\u5c04\u51fb\u6e38\u620f\u3002\u7784\u51c6\u653e\u7f6e\u5728\u4e0d\u540c\u8ddd\u79bb\u7684\u53e0\u676f\u5854\uff0c\u6d4b\u8bd5\u4f60\u7684\u7cbe\u51c6\u5ea6\u548c\u4e13\u6ce8\u529b\u3002\n\n\u6e38\u620f\u73b0\u5df2\u52a0\u5165\u5168\u65b0\u7684\u8bbe\u7f6e\u9762\u677f\uff0c\u8ba9\u4f60\u4ee5\u7b80\u5355\u76f4\u89c2\u7684\u65b9\u5f0f\u5b8c\u5168\u638c\u63a7\u6e38\u620f\u4f53\u9a8c\u3002\u4f60\u53ef\u4ee5\u5728\u4e0d\u4e2d\u65ad\u6e38\u620f\u7684\u60c5\u51b5\u4e0b\uff0c\u81ea\u7531\u8c03\u6574\u753b\u9762\u548c\u73a9\u6cd5\u3002\n\n{27014910791460917}\n\n- \u66f4\u6362\u676f\u5b50\u7684\u5916\u89c2\uff0c\u6253\u9020\u4f60\u559c\u6b22\u7684\u98ce\u683c\n- \u4e00\u952e\u5237\u65b0\u676f\u5854\uff0c\u5feb\u901f\u91cd\u65b0\u5f00\u59cb\n- \u5f00\u542f\u6216\u5173\u95ed\u684c\u9762\u79fb\u52a8\uff0c\u4f53\u9a8c\u7a33\u5b9a\u6216\u52a8\u6001\u6311\u6218\n- \u8c03\u6574\u5929\u7a7a\u989c\u8272\uff0c\u8425\u9020\u4e0d\u540c\u6c1b\u56f4\n- \u5207\u6362\u4e0d\u540c\u573a\u666f\uff0c\u4fdd\u6301\u65b0\u9c9c\u611f\n\n\u6d41\u7545\u7684\u64cd\u4f5c\u548c\u5feb\u901f\u91cd\u7f6e\u529f\u80fd\uff0c\u8ba9\u6e38\u620f\u4f53\u9a8c\u8f7b\u677e\u987a\u7545\u3002\u65e0\u8bba\u662f\u653e\u677e\u4f11\u95f2\uff0c\u8fd8\u662f\u8ffd\u6c42\u6311\u6218\uff0c\u4f60\u90fd\u53ef\u4ee5\u6309\u7167\u81ea\u5df1\u7684\u8282\u594f\u6e38\u73a9 Cup Strike VR\u3002\n\n{1290783493021990}\n\n\u6bcf\u4e00\u6b21\u5c04\u51fb\u90fd\u5177\u5907\u771f\u5b9e\u7269\u7406\u6548\u679c\u2014\u2014\u676f\u5b50\u4f1a\u6839\u636e\u4f60\u7684\u7cbe\u51c6\u5ea6\u5012\u4e0b\u3001\u6563\u843d\u5e76\u4ea7\u751f\u53cd\u5e94\uff0c\u8ba9\u6bcf\u4e00\u6b21\u547d\u4e2d\u90fd\u5145\u6ee1\u6210\u5c31\u611f\uff0c\u6bcf\u4e00\u6b21\u5931\u8bef\u90fd\u662f\u8fdb\u6b65\u7684\u673a\u4f1a\u3002\u5373\u65f6\u91cd\u7f6e\u8ba9\u6e38\u620f\u8282\u594f\u59cb\u7ec8\u4fdd\u6301\u6d41\u7545\u4e0d\u4e2d\u65ad\u3002\n\n\n{3496958223798063}\n\n\u591a\u6837\u7684\u73af\u5883\u548c\u573a\u666f\u8ba9\u6e38\u620f\u59cb\u7ec8\u4fdd\u6301\u89c6\u89c9\u65b0\u9c9c\u611f\u3002\u7b80\u5355\u7684\u673a\u5236\u3001\u7075\u654f\u7684\u64cd\u4f5c\u548c\u987a\u7545\u7684\u4f53\u9a8c\uff0c\u4f7f\u6e38\u620f\u6613\u4e0a\u624b\u5374\u96be\u4ee5\u653e\u4e0b\u2014\u2014\u975e\u5e38\u9002\u5408\u653e\u677e\u5a31\u4e50\u6216\u7ade\u6280\u6311\u6218\u3002\n\n", "short_description": "Cup Strike \u662f\u4e00\u6b3e\u5feb\u8282\u594f\u7684\u57fa\u4e8e\u7269\u7406\u7684\u5c04\u51fb\u6e38\u620f\uff0c\u73a9\u5bb6\u9700\u8981\u4ece\u4e0d\u540c\u8ddd\u79bb\u7784\u51c6\u5806\u53e0\u7684\u676f\u5b50\u5854\u3002\u6d4b\u8bd5\u4f60\u7684\u7cbe\u51c6\u5ea6\uff0c\u7528\u771f\u5b9e\u7684\u7269\u7406\u6548\u679c\u51fb\u5012\u676f\u5b50\uff0c\u5e76\u6311\u6218\u66f4\u9ad8\u5206\u6570\u3002\u81ea\u5b9a\u4e49\u73af\u5883\uff0c\u8c03\u6574\u96be\u5ea6\uff0c\u5e76\u53ef\u5373\u65f6\u91cd\u7f6e\uff0c\u6301\u7eed\u7545\u73a9\u3002"}]}, "developer_name": "MEPROTECH", "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupstrike/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26694381693488912"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620444_1660357444988637_7574376383093960449_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSOQzKg58b0Q7kNvwGmJe-f&_nc_oc=AdrjIMSXFKhv2en1iwWhr8t94jC2-Knk4cj2PrkS5-n6JBJqXEREC39uveaW8I8DyDA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mZXj0A4ocT1sTxCaLMEijyUobhtNNrL5I4LvNV4USYQ&oe=69FF3BC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cup Strike", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1773747120, "lastRevision": {"nodes": [{"id": "26386754730918278", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicati
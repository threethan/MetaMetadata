_clwMO0z30THonFDJopjoRvkweNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gk1abXTm1I9HFZvDXCKCIrxiseI-RAO-g2IJSEhirxQ&oe=69DCDFFD"}, {"file_name": "ss9.png", "id": "1437439584145763", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619832_1437439587479096_4944662878500437916_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5dgsbxGbJ50Q7kNvwFqKS6Q&_nc_oc=AdqX--n2aHmpXnwRq73tMZu9FtZwdXQL6DEOrvonV_NLpwL3-rsaFjPcEQlU9YllECM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t2MEgitxXCslbYaUIv9w9MWsnG-Q2saLX9YTpgj2faw&oe=69DCEC77"}, {"file_name": "ss7.png", "id": "1464719998540466", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618103_1464720001873799_8215814623911770602_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjZLxG4QBjgQ7kNvwGb3RhO&_nc_oc=Adr4A28nn9e8PEnPMxwUp9hxAxKFGCdSC8YZUCfHiw-KnO88lwxeoEjF7qp2AO43pRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xZ_obGX4Y3maZkH6fs1ilxAOReUAjmcnLCqzKPr4A0A&oe=69DCD8B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2171717220261696", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618064_2171717223595029_5490674640020306279_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDjhFoyXK0MQ7kNvwF-y_5f&_nc_oc=AdrsMiQ_9Orw3oZpVWjqpMjXxmG611resGkzKtRESXIXX-PxgyEK5-jXykdqdMZwWqE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mEyxjzlhofzSXoG5bYkXH9BGNO3wTseFapw7ZosSOvg&oe=69DCE41C"}, "display_name": "Cup Strike", "keywords": ["cup", "table", "gun", "shooter", "clash"], "long_description": "Cup Strike is an engaging physics-based shooting experience built for immersive play. Step into a dynamic virtual environment where your aim and focus are put to the test as you target towers of stacked cups placed at different distances.\n\n{892340830427562}\n\nEach shot delivers satisfying, realistic physics\u2014watch cups tumble, scatter, and collapse based on your accuracy and angle. The game rewards precision and strategy, making every hit feel impactful and every miss a chance to improve.\n\n{2219903911879401}\n\nPlayers can personalize their experience by adjusting sky colors, changing cup patterns, and modifying tower distances to control difficulty. Whether you want a relaxed aiming session or a more challenging setup, the game adapts to your play style.\n{1412675584235243}\n\nInstant tower reset keeps gameplay smooth and uninterrupted, allowing continuous practice or competitive score chasing without delays.\n\n\nWith multiple environments and newly added scenes, Cup Strike VR offers variety and visual freshness across gameplay sessions. The combination of simple mechanics, responsive controls, and immersive physics creates an experience that is easy to pick up yet hard to put down.\n\nWhether you're looking to unwind or compete for the highest score, Cup Strike VR delivers a satisfying and addictive VR gameplay loop.", "short_description": "Cup Strike is a fast-paced physics-based shooting game where you aim at stacked cup towers from varying distances. Test your precision, knock down cups with realistic physics, and chase high scores. Customize environments, adjust difficulty, and instantly reset to keep the action going."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupstrike/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics"
6_810268882129178_4734447565715801617_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2CSbTv1TkMQ7kNvwGaJ7lG&_nc_oc=Adpdz3ytSXmw0uo78EcsYaCoM0sPxI7OPeTmaETtftKY7Gxz9P5LESRfGTWP1CFYeq0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JCIyBmTTnvO-xSJaAyVDpUJ3ClZeFBPchn9jxKcinjA&oe=69DCE39B"}, {"file_name": "ss5.png", "id": "789752777526374", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_789752780859707_279328550106910350_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cg5EB5jx3AcQ7kNvwFfxf7W&_nc_oc=AdoxoniI0jNGSFxYL5WUI2xWwMrGFEMWcEYLOJe3w6R8atGJzIc0bWcdFIpMr_IhXF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28U88QTbiAcN1_mjFbR3FjMtGu7DnbTkfIQgrFhVypcA&oe=69DCF10D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cup Strike VR", "keywords": [], "long_description": "Cup Strike VR is a fast-paced VR target game designed to test your precision and focus.\n\nPlayers shoot at towers of stacked cups placed at different distances. Every hit collapses the tower realistically using physics, rewarding accuracy and strategy.\n\nCustomize the environment by changing sky colors and cup patterns, adjust the tower distance for difficulty, and reset the tower instantly to keep playing.\n\nWhether you want a relaxing aiming challenge or a competitive score chase, Cup Strike VR offers a simple yet addictive gameplay experience.", "short_description": "Cup Strike VR is a fun physics-based shooting game where players fire at stacked cup towers from different distances. Test your aim, knock down cups, and compete for the highest score."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/meprotech.in/cupstrike/home", "developer_terms_of_service_url": null, "publisher_name": "MEPROTECH", "support_website_url": null, "website_url": "https://meprotech.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "
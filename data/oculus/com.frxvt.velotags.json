ld filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Game Name is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "This is the by far BEST Gorilla Tag Fangame, it uses Gorilla Locomotion like the hit game Gorilla Tag! Download this game today and share it with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/velotagsv1/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FRX", "support_website_url": null, "website_url": "https://sites.google.com/view/velotagsv1/startseite", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8868228526611206"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391863_660474203508778_350298691807838674_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K-noAP8qSkQ7kNvwElQVhm&_nc_oc=Adrs9O46OR5damI-uESS3uNIr2A64xMExJOGHN-xnFQ0JIGIuagAbj-1QMu-Kt3EoV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r4WvU58ex_IOQm8vlN5-BUxzArUjY_8A1YdClFZ4Ll
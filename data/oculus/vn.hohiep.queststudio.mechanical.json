057", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499628436_1403923928515390_1610242737966712927_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFFingK6BuAQ7kNvwGAqS-r&_nc_oc=AdrDoiJ0gbOtgsNkzsVKmyXvA26zwdR7_Jkc7QhqXpubZyoZeDLZ7Eo6uPSrogCT2AQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAxjtTYfPQlSlhpglI7Vkr_XAU6Vq7DPcp8KL7DYtbEw&oe=6AF9DEA1"}, {"file_name": "05-the-patient-locksmith.png", "id": "1948887515789120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499628446_1948887519122453_548995932613980642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNPOnA8OLnMQ7kNvwHKV65v&_nc_oc=Adohrz0dyXjXc54iQzE06WALZTkum8CtfIgZjq-xVvquTHfBkYAdJhGAZzCdec3Ldc4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkHRuV6XyY7mSmlgP6KGb8dVmxftYhqidEbugwejXdlQ&oe=6AF9B73A"}, {"file_name": "03-the-brass-garden.png", "id": "2352306265600605", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499627379_2352306268933938_3382503988041256252_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2VmxehhABcQ7kNvwGgp0w1&_nc_oc=AdoZ6rpZagUmkDZqfDgvOVQVniuqfmsBxJXxgrHz5iDZnot0IIbLjjPQwxVtu59-syo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpD0fyaN86fn5v6jxAcxzqDi-sMcxEjH2LSDkurlftDQ&oe=6AF9C921"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mechanical Secrets", "keywords": ["puzzle", "mechanical", "logic", "mystery", "brass"], "long_description": "Every box holds a story.\n\nStep into The Brass Archive, a quiet puzzle collection of walnut, brass and forgotten promises. Read the keeper's letters, study the numbered rings and work out how each mechanism moves. Release the seals, turn the key and discover the keepsake inside.\n\nTEN CHAPTERS, ONE PROMISE\nExplore ten authored chapters and sixteen seals. Begin with independent rings, then discover reversed motion, linked gears, counterweights and multi-stage locks. Each chapter has its own finish, letter and collectible memory.\n\nA LITTLE HELP, WHEN YOU WANT IT\nUse three levels of hints, from a gentle clue to the next moves. Play without a timer, return to saved progress and revisit unlocked chapters in the memory archive.\n\nMAKE ROOM FOR CURIOSITY\nBring the box into your room in mixed reality, or use the in-app window view. In MR, manually adjust its height, reach and size to suit your table. Use your hands to grip the recessed wells and turn the rings. Touch controllers are also supported.\n\nSingle player. English by default, with Vietnamese available. Progress stays on your device. No ads or in-app purchases. Meta platform ownership verification applies.", "short_description": "Turn curious mechanisms. Read forgotten letters. Unlock ten memories."}]}, "developer_name": null, "developer_privacy_policy_url": "https://srv1117516.hstgr.cloud/mechanical-secrets/privacy/", "developer_terms_of_service_url": null, "publisher_name": "hohiep102", "support_website_url": "https://srv1117516.hstgr.cloud/mechanical-secrets/support/", "website_url": "https://srv1117516.hstgr.cloud/mechanical-secrets/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "vi"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2301328047268946"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593784242_1395560882645009_3558148104614886459_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=
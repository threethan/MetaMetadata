033325822751_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FDQ50R9G5cQ7kNvwEuEWh6&_nc_oc=Adl67nJTkHLObGMd_JHxhOEa23_n7CHvRy3K4MbHGVSg8MiHyKDIxKlT97AmwiZ3i5w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu9Hvdv7JRChfpgmzNFGAmOoGSz1BiYoZcndoOIaxT_6Q&oe=699AE5FB"}, "display_name": "JaiwiWorlds", "keywords": [], "long_description": "This game is like a dream, inspired in Half Life Alyx, the most amazing game I have ever played with my quest 2 and 3, so the idea of JaiwiWorlds is to create as many VR experiences as possible. Let us learn, let us study, and keep our eyes open with these new technologies that will set us free, that will immerse us in time and space, across the past, the present and the future. Please help me improve this game more and more. I want to enjoy just as much as each one of you do!", "short_description": "An educational world of VR experiences with lots of surprises"}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1PEZQvCDOJTD9ZGsQZAEL6paYPAaFhq4Y/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Jaiwi", "support_website_url": null, "website_url": "https://jaiwiworlds.wixsite.com/jaiwi-worlds", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7364033180319237"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "546593478089614"}, {"status": "PUBLI
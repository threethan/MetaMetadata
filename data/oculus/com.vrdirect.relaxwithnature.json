", "360", "meditation", "relax", "nature"], "long_description": "Relax at any time, wherever you are and teleport yourself to the location of your dreams. Six selected unique locations, such as the beach, mountains, waterfalls and many more are waiting for you. Enjoy relaxing, quiet music or simply turn the volume down and listen to the pure sounds of untouched\nnature.\n\nDownload Relax with nature now and forget the hustle and bustle of your everyday life.", "short_description": "Pick your favorite nature scene, sit back and relax. Take a break wherever you are. Relax with nature teleports you to six unique 360\u00b0 sceneries."}]}, "developer_name": "Viond GmbH", "developer_privacy_policy_url": "https://www.vrdirect.com/imprint-privacy", "developer_terms_of_service_url": "https://auth.vrdirect.com/legal/terms-and-conditions", "publisher_name": "Viond GmbH", "support_website_url": "https://www.vrdirect.com/support", "website_url": "https://www.vrdirect.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "RELAXATION_MEDITATION", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "460182355590899"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974815_458636108278272_1349908788068483072_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qlYM6URq7cQ7kNvwH5xHA9&_nc_oc=AdnueEq0DsymLrgIObyJ3O-CvPCv1Oe83S159UgVbXRd5jt2-6ltK4JUDlI_dd3rBa0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=
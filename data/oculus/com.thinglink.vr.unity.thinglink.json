a&_nc_ohc=9HtQxgpXzsgQ7kNvwFEPLXu&_nc_oc=Adp1ocT1HGlhDpYhbVzUPZyHLuLc8L-BoTjVJOHd2CxQir9eLW4QFwNt20pnqxsJ5Kc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mgJQCvaw8yUJwlG3L7xX7SdUli_4VSdDxV5S31mhcaQ&oe=69EA1D24"}, {"file_name": "Screenshot 4.png", "id": "533239906175468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974685_533239909508801_6084173459485438734_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSjYy1xT4uUQ7kNvwEbxh5p&_nc_oc=AdqDDuw_tBtyd6rtQ4DhVpWvlDsZg0yc5sgCSDz2v1TGBKqLf6is98dywpaOdO47vhc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04Qh_3twmZKUq9XFum9u23kn8l9HCc7MGIt39y2OHuXw&oe=69EA0632"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ThingLink", "keywords": ["immersive", "learning", "interactive", "training", "thinglink"], "long_description": "ThingLink XR offers an easy way to access your immersive learning content on XR headsets. Create dedicated content channels for employee onboarding, product and safety training, customer education, and more. Share conveniently using customizable landing pages on ThingLink XR. Combined with ThingLink\u2019s AI-Assisted content creation flow, ThingLink helps you modernize learning with flexible viewing across headsets, mobile, desktop, and immersive meeting spaces.\n \nThingLink XR is ideal for customizing the experience for various types of learners and interest groups; students, employees, subcontractors, or customers. ThingLink content modules can be used as a standalone immersive learning solution on XR headsets. ThingLink is also cross-device compatible and can be shared and experienced across other platforms and devices. Individual learning analytics can be shared via xAPI.", "short_description": "ThingLink XR offers an easy way to access your own immersive learning content on XR headsets. Create dedicated channels for employee onboarding, product and safety training, customer education, and more \u2013 then share conveniently using customizable landing pages on ThingLink XR. Combined with ThingLink\u2019s AI-Assisted content creation flow, ThingLink helps you modernize learning with flexible viewing across headsets, mobile, desktop and immersive meeting spaces."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thinglink.com/privacy", "developer_terms_of_service_url": "https://www.thinglink.com/terms", "publisher_name": "ThingLink", "support_website_url": "https://support.thinglink.com/", "website_url": "https://www.thinglink.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25793167243648232"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001728_3901099046838812_6867009475640358619_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0HZ26Ks7RcQ7kNvwH4ON9W&_nc_oc=AdosuyrNNf_6jesaPwRR9QICCq1ycdTNnyldLbes9L-FEl0IAV9sDc9GHJCprv1y3Oc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GppUxoYshczN3Sgw5kNZtVK9fKn08-hs506d7GzfcUA&oe=69EA32ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ThingLink", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1731662640, "
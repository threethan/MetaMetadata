zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzycWUxcpC05hF2FM67ddtU2N0DCoESMm5mNdEEmLuyA&oe=6A636479"}, {"file_name": "5(1).png", "id": "344762655041835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_344762658375168_3237421131314125082_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwT35xg-tXUQ7kNvwHQfTTM&_nc_oc=AdpWEt9BQ1hAtHnEMB3sfv0ipZ5sl2SJUmW2PD1N3X-IjJUC-M69Je1mHaqrE3iXRf8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1ytaP1BGm93DMy9VHsJF_N78_6_5qI8luGX56zPwLnA&oe=6A6378B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Poster new - \u526f\u672c(1).png", "id": "340346948818028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982519_340346952151361_4955088359404759572_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79sejze4O6wQ7kNvwFnItiz&_nc_oc=AdrWDgm2k9PyG3oD8OPGX-jBEHwoelk-k1gXUrvaHnqvbWFFEra5IxaAm45flSMMjl0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1ncw2ICpA4nPGh3oQSVRq8ziBNOUFFCgxJeRcVBC03w&oe=6A635D38"}, "display_name": "Animal Dash", "keywords": [], "long_description": "Get ready to run, jump, and roll through our meticulously designed stages with unparalleled excitement!\nJoin our vibrant cast of characters, including Bullseye the Bull, Daisy the Cow, Garry the Goat, Marty the Horse-Pig, and Clucky the Chicken. Each animal possesses unique abilities and personalities that will make your racing experience unforgettable.\nImmerse yourself in the stunning landscapes of \"Animal Dash.\" From the picturesque countryside farm to the enchanting Greek seaside town and the awe-inspiring pirate island perched on a cliff, every scene will leave you breathless. \nPrepare to be blown away by the innovative and hilarious controls we've incorporated into \"Animal Dash.\" Swing your arms to sprint at lightning speed, raise both arms for epic jumps, and swing arms to execute gravity-defying somersaults. Be prepared for the wildest parkour race and facing the different challenges in the map. You can also punch NPC out of the road if you wanna and experiment the laughing moment!", "short_description": "Welcome to the wild and whimsical world of \"Animal Dash\"! Are you ready to embark on an adrenaline-fueled parkour race like no other?\nIn \"Animal Dash,\" you'll play some adorable animals and navigate through thrilling courses in breathtaking environments.Unleash the wild within and join us for the parkour race of a lifetime!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.atombits.cn/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "UE", "support_website_url": null, "website_url": "http://www.atombits.cn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6994163650663984"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1038158179150310"}, {"status": "PUBLISHED", "id": "1477613246985145"}, {"status": "PUBLISHED", "id": "930106802813615"}, {"status": "PUBLISHED", "id": "737931115568754"}, {"status": "PUBLISHED", "id": "1348928313206272"}, {"status": "PUBLISHED", "id": "1493817335242977"}, {"status": "PUBLISHED", "id": "9859775107415088"}, {"status": "CANCELLED", "id": "1391778142169667"}, {"status": "PUBLISHED", "id": "3999862617004761"}, {"status": "PUBLISHED", "id": "794333249340789"}, {"status": "PUBLISHED", "id
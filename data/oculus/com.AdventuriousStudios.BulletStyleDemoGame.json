file_name": "update2_2_0img7.png", "id": "1420251872404694", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619704_1420251875738027_4038762034106214881_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujOdy2s_w4cQ7kNvwFf19Wj&_nc_oc=AdrYfZzIcdLMvZqlkVbFVTHR3wQ4purHaHv_4ZR38WqFQsTPAGJVA0vWVCtKbV_6ZBU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIUQrns5Y7Mo0FQJXZvb86oeiiM1HJLIRnT_jWyJVNVA&oe=6A64C26C"}, {"file_name": "update2_2_0img2.png", "id": "1224970559656324", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308873_1224970562989657_6159377200056744437_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm246LPmnAMQ7kNvwEdsAhJ&_nc_oc=AdrTyi21uuXpwkvPblaFt8qanVnhCAOT4nav0HVDxpiUw9lrdhTdSUun7yLgv3OBVBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEnDndG24rs5vnGy_J8t0QwtcTqA40NfDH2R-4unyMoQ&oe=6A64BB26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MainImage_Edited.png", "id": "1686140355383920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303432_1686140362050586_715584994997762985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dTgbqGJDzsQ7kNvwFPHnrM&_nc_oc=AdpouAWnJqjF5f0Ie2w3KV3Gy5k5K117ilRSLXGy1_iOlBPfMMg8ZaKGw7y5cqLkPGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD87p4yyW-v9OsIwbWNuUPcuIXHRMMC0sNOzTUg4I_Ebw&oe=6A64C39E"}, "display_name": "Bullet Style Demo", "keywords": ["Action", "Shooter", "Fighting", "FPS", "Walking"], "long_description": "This is a demo with limited content and functionality. Please purchase the full version of the game to gain access to all current and future content.\n\nWelcome to Bullet Style! An all-new roomscale virtual reality shooter that immerses players in action-packed gunfights using real movement. Become the action hero of your dreams and experience intense combat by navigating seemingly endless levels with your own two feet. Blast bad guys with an extensive arsenal of weaponry, fend off hordes of zombies, and play through a variety of different game modes that keep the adrenaline pumping!\n\nBullet Style requires a minimum of 6.5 feet by 6.5 feet to be played with real movement. A larger play area will improve the game experience. Thumbstick controls can be enabled for stationary play, but this is not recommended.\n\nBullet Style is currently in early access and may contain bugs or other issues. Please report any bugs to contact@adventurousstudios.com. ", "short_description": "Welcome to Bullet Style! An all-new roomscale virtual reality shooter that immerses players in action-packed gunfights using real movement. Become the action hero of your dreams and experience intense combat by navigating seemingly endless levels with your own two feet. Blast bad guys with an extensive arsenal of weaponry, fend off hordes of zombies, and play through a variety of different game modes that keep the adrenaline pumping!"}]}, "developer_name": "Adventurous Studios", "developer_privacy_policy_url": "https://www.adventurousstudios.com/privacy-policy", "developer_terms_of_service_url": "https://www.adventurousstudios.com/terms-of-service", "publisher_name": "Adventurous Studios", "support_website_url": "https://www.adventurousstudios.com/contact", "website_url": "https://www.adventurousstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "245332
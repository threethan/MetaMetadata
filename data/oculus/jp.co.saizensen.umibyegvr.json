le_name": "migrated_image.png", "id": "2999993196920529", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602284_1826826800862753_385098432890535936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5GILZnX6HgEQ7kNvwE3_2A6&_nc_oc=Adr_cb0guExaooufR44Mb9VbxWr5CL2KC0fMQfYYhE1lT9HYk-Ewh--ZrlAp4KriHUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL34N5zWh4eM0Vb5b1t2ufuw5Q5hBpJZmL4YyD_Vt8grQ&oe=6AA6B5BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "537702206620263", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162716_537702209953596_7309402616822235136_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_PV2YfP3uUwQ7kNvwEwdf5d&_nc_oc=Adq13r4XXoFgdmqzaKk3YR9UKRyfGftTiTzJ1hvINhHHsey5SjN9Z1dnl8nNFmJdREA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEnmUE1N-levV1JGqgNDLDyLLHrlokcw9WyIqFR0SA8g&oe=6AA6C7F9"}, "display_name": "Sayonara Umihara Kawase VR", "keywords": ["puzzle", "action"], "long_description": "Umihara Kawase is the name of our backpacking, Japanese cuisine chef heroine armed with a fishing rod, elastic fishing line, and a fishing hook. Face fish-like enemies, conveyor belts, spikes, watery pits and more. Collect items, and find your way to the end of each level. The deeper into this dream-like world that you venture, the more challenging the solutions and the greater the time pressure becomes. Along the way, look out for shortcuts and secret exits, and unlock next stages!\n\nThe elasticity of Umihara\u2019s fishing line sets the apart from other games, giving unprecedented levels of mobility and discovery. Tightening the line or giving lots of slack can be the difference between success or failure. The elastic nature of the fishing line allows the player to stretch down to otherwise unreachable areas or be catapulted upwards.", "short_description": "Umihara Kawase is a girl who uses a fishing hook as a grappling hook. You\u2019ll need quick reflexes to swing your way through the branching surreal environments. Use your brains to figure out the best way through. Along the way, look out for shortcuts and secret exits, and unlock next stages!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "developer_terms_of_service_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "publisher_name": "Studio Saizensen Co.,Ltd.", "support_website_url": null, "website_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "en_GB", "fr", "de", "it", "pt_BR", "ru"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998957347498161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410455_1135934583190668_1166611012783177728_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnUjJUeZyQ4Q7kNvwG9cHBO&_nc_oc=Adr-o015YlCwJq3A6KqiwWWYZG7rrvTv-9pzQM6WHOdP408JUnj2Ng-kne7I88pPNlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKHlutlG8shvAOaA0prG-YmlDwwo3vIVCJr1GCAVxd-g&oe=6AA6A7A7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sayonara Umihara Kawase VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1494392548, "lastRevision": {"nodes": [{"id": "1117995184965537", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_me
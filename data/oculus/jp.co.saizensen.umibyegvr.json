 "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139431_573834552822232_4372664014593851392_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=303M79eErkEQ7kNvwEox48n&_nc_oc=AdqclDS1_G1QEYjvYswa6E__HG6hLP22RgZjWTRcOpS-FcZUPU5nYvw-NrPc6zQUTR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzeXOiNClTRs2_7Qfte8OcwyJVifAOGKs767tN2k7EWQ&oe=6AAFDB1A"}, {"file_name": "migrated_image.png", "id": "191760845601400", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12602284_1826826800862753_385098432890535936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9Muka9h_LAQ7kNvwG3OlSp&_nc_oc=AdorBL6qwXMDbc-yAGq1-5lyoXiu7z7rRCvcKrUBfVsdbV5ydGuVbtwB_h478NEayZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW1b8FAlCOBoq2VMFn7ac8iwv6CHUD7eZfloYgtIOgHQ&oe=6AAFF03C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sayonara Umihara Kawase VR", "keywords": ["puzzle", "action"], "long_description": "Umihara Kawase is the name of our backpacking, Japanese cuisine chef heroine armed with a fishing rod, elastic fishing line, and a fishing hook. Face fish-like enemies, conveyor belts, spikes, watery pits and more. Collect items, and find your way to the end of each level. The deeper into this dream-like world that you venture, the more challenging the solutions and the greater the time pressure becomes. Along the way, look out for shortcuts and secret exits, and unlock next stages!\n\nThe elasticity of Umihara\u2019s fishing line sets the apart from other games, giving unprecedented levels of mobility and discovery. Tightening the line or giving lots of slack can be the difference between success or failure. The elastic nature of the fishing line allows the player to stretch down to otherwise unreachable areas or be catapulted upwards.", "short_description": "Umihara Kawase is a girl who uses a fishing hook as a grappling hook. You\u2019ll need quick reflexes to swing your way through the branching surreal environments. Use your brains to figure out the best way through. Along the way, look out for shortcuts and secret exits, and unlock next stages!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "developer_terms_of_service_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "publisher_name": "Studio Saizensen Co.,Ltd.", "support_website_url": null, "website_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "en_GB", "fr", "de", "it", "pt_BR", "ru"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "417926303453049"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1214903121951395"}, {"status": "PUBLISHED", "id": "322446511524966"}, {"status": "PUBLISHED", "id": "588079508348872"}, {"status": "PUBLISHED", "id": "445983065936579"}]}, "baseline_offer": {"id": "1214903121951395"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1494435600, "status": "PUBLISHED", "id": "1214903121951395"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1060634407371661", "version": "1.1"}, "id": "787136851424126", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "93004186043091
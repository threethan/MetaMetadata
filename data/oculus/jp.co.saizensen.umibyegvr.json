93196920529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12602284_1826826800862753_385098432890535936_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVbBXiDEd2kQ7kNvwE4NpUd&_nc_oc=AdmisKDYfvjhkYDqdr7kxNTabU3Iq0dfStHMQ2bTHKdthNhmni2cNgqUKwpPCZztvo8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzhA_w9B85O6n1Ai7V_1pJB-sWbXf0M14e5rhyA2p74jw&oe=69BA80FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "537702206620263", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162716_537702209953596_7309402616822235136_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzOjbrCwMoAQ7kNvwEqAvJG&_nc_oc=AdkVsq5YXLEDaIcQrIplMWwKG-F6-txvjdQ1s3B60IC3C1F7XBLjjcOizUm0v2oU0uc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw8UkbFCO7QNWDSDwApJvmWN1w7F1dl2NBQCBxaw6J7OA&oe=69BA9339"}, "display_name": "Sayonara Umihara Kawase VR", "keywords": ["puzzle", "action"], "long_description": "Umihara Kawase is the name of our backpacking, Japanese cuisine chef heroine armed with a fishing rod, elastic fishing line, and a fishing hook. Face fish-like enemies, conveyor belts, spikes, watery pits and more. Collect items, and find your way to the end of each level. The deeper into this dream-like world that you venture, the more challenging the solutions and the greater the time pressure becomes. Along the way, look out for shortcuts and secret exits, and unlock next stages!\n\nThe elasticity of Umihara\u2019s fishing line sets the apart from other games, giving unprecedented levels of mobility and discovery. Tightening the line or giving lots of slack can be the difference between success or failure. The elastic nature of the fishing line allows the player to stretch down to otherwise unreachable areas or be catapulted upwards.", "short_description": "Umihara Kawase is a girl who uses a fishing hook as a grappling hook. You\u2019ll need quick reflexes to swing your way through the branching surreal environments. Use your brains to figure out the best way through. Along the way, look out for shortcuts and secret exits, and unlock next stages!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "developer_terms_of_service_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "publisher_name": "Studio Saizensen Co.,Ltd.", "support_website_url": null, "website_url": "http://www.saizensen.co.jp/kawase/sayonara_gear_vr01.pdf", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "en_GB", "fr", "de", "it", "pt_BR", "ru"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "998957347498161"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410455_1135934583190668_1166611012783177728_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAY_7zP07ckQ7kNvwHhH0Iu&_nc_oc=AdlFVs8WcqFqE2g9c5nm4AEah4oWviZPrOGlKVQ4dqol2H92XIRDGXy4bLDkZm4VBJw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw62z396UvD7B8L8D3W0w_2x-BhTuOF9je8PYaD71i3bg&oe=69BAAB27"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sayonara Umihara Kawase VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1494392548, "lastRevision": {"nodes": [{"id": "1117995184965537", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id
588_1576468600357977_963030132674722656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pizdOOPjugIQ7kNvwEWXp5g&_nc_oc=AdlrTVOSxpNm6FBd65PrPXgtmqAhfWYJkKa52UIATIj2fxMxGA1D4rSCMpNGXSLeBug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEIckHLBUJCzbDG_Itg_AfUxWLuPgKVEe4nTzN6e5hJQ&oe=69B56838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscap32_2560x1440_shoko.png", "id": "1450279846165373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618065_1450279849498706_5641516501206576537_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdQy02DyFjYQ7kNvwEmW0i9&_nc_oc=AdnmSLofrQ9pF390RT2wZxnpjNbAiQxoO9iXHAXGcet4TnBoGnDMKjBmPC1yTgMBy2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP-Il-zA63lYOUMLz9f8XQi5LyjDzgeSo5LQwrFAYHIg&oe=69B54B9F"}, "display_name": "Street Simulator Z: Multiplayer", "keywords": ["Survival", "Cooking", "Fight", "Gun", "Playground"], "long_description": "Street Simulator Z: Multiplayer is an addictive VR sandbox where you can get rich through legally questionable means, spend your money on new weapons and vehicles, and avoid the cops while battling the local gang. Take on the streets solo or team up with others in multiplayer (up to 4 players).\n\n{1105387631512705}\n\nMake money your way: grow exotic \u201ctomatoes\u201d,sell them to locals, and reinvest to expand your business. Become a bounty hunter and take down criminals for cash, or just rob the local bank.\n\n\nSpend your wealth on new weapons and a wide variety of vehicles\u2014from a tractor to even a tank.\n\nKey Features:\n\n\ud83e\udd1d Co-op multiplayer (up to 4 players)\n\n\u2694\ufe0f Interact with any NPC, go to war with gangs, and evade the police\n\n\ud83c\udf45 Grow and sell \u201ctomatoes\u201d for cash, then reinvest to expand your business and increase profits\n\n\ud83d\udcb0 Spend your money on a variety of weapons and vehicles\n", "short_description": "Life in this town can be a drag, especially with all these annoying jerks causing trouble! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25970970015820500"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618251_1763788214507740_5115794147582669860_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mJA1q9p_OUQ7kNvwETHytf&_nc_oc=Adml6GQHzOm0uHGusKgkB8H5XVRUyj9f19IfDilj3sJdYAxAvsBkPbfK3EF1_NmMDVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwrnIdEr9WqlXQCs-220AhVD2yOOyRILcppPXQuzRQbfA&oe=69B56896"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Street Simulator Z: Multiplayer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1753840800, "lastRevision": {"nodes": [{"id": "23962356283348
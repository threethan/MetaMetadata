34342829567925464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTFVGi22ursQ7kNvwEqjfCL&_nc_oc=AdqqumsNOCK-pSs75MwjitEdjxz7WGNBGDhd6--AI4if6Za5yTil1RNjDIEhqdiJsI0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACVJXrSU0FEb0CwF9XfKhoYVeOblBynb5gGAfkukAg5w&oe=6A54E772"}, {"file_name": "screenshot5.png", "id": "1576468597024644", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619588_1576468600357977_963030132674722656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVWnVTxz0h4Q7kNvwGczPs6&_nc_oc=AdrjhnqP1lf13S4i1LmTljY4pOaYnrpTkIFUeoBY4EvPtoFetmPaIUhhoTJ_htsfD-o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3mFGBcwZ_hik5TX4aKVtNhOox9LPahMk7hcF9dF3kiA&oe=6A54EDB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscap32_2560x1440_shoko.png", "id": "1450279846165373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618065_1450279849498706_5641516501206576537_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xja977lH9AQ7kNvwGFVMNd&_nc_oc=Adqn15kpkOHiCXsqXj3st7cMXEobjS5VtYuMkMGxJLDihnH7LtkOAQbhs8hFlr44GHg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA0LzOjBJI-t7m_zxvS4gVLmPkc82hV01LfP3ZTg5cAA&oe=6A54D11F"}, "display_name": "Street Simulator Z: Multiplayer", "keywords": ["Survival", "Cooking", "Fight", "Gun", "Playground"], "long_description": "Street Simulator Z: Multiplayer is an addictive VR sandbox where you can get rich through legally questionable means, spend your money on new weapons and vehicles, and avoid the cops while battling the local gang. Take on the streets solo or team up with others in multiplayer (up to 4 players).\n\n{1105387631512705}\n\nMake money your way: grow exotic \u201ctomatoes\u201d,sell them to locals, and reinvest to expand your business. Become a bounty hunter and take down criminals for cash, or just rob the local bank.\n\n\nSpend your wealth on new weapons and a wide variety of vehicles\u2014from a tractor to even a tank.\n\nKey Features:\n\n\ud83e\udd1d Co-op multiplayer (up to 4 players)\n\n\u2694\ufe0f Interact with any NPC, go to war with gangs, and evade the police\n\n\ud83c\udf45 Grow and sell \u201ctomatoes\u201d for cash, then reinvest to expand your business and increase profits\n\n\ud83d\udcb0 Spend your money on a variety of weapons and vehicles\n", "short_description": "Life in this town can be a drag, especially with all these annoying jerks causing trouble! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25970970015820500"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618251_1763788214507740_5115794147582669860_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeYY5B9LftAQ7kNvwHaA3b1&_nc_oc=Adolra6GFvTUTD5BNm_rm5jbf-N75qGg9NOySexGJTSdUNoJUdUgH_KBv0VuTWl-1Pw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaWQd8S4Dpdy93KCwHYSBnZ0BPcIFmSCJw0_DEH1r9cQ&oe=6A54EE16"}, "is_concept": false, "is_test": false, "is_trial_off
dxnvUM0KIaTcq1RiWdcma0rRQ&oe=6A09C1F2"}, {"file_name": "screenshot5.png", "id": "1576468597024644", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619588_1576468600357977_963030132674722656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HHrDL2q-3UQ7kNvwEQJCOp&_nc_oc=AdrwgHd-v_CXrt7ZRNY9__pVgedkeM27xX8M8NUHEt5Msg_MRs_4Dlkykuzc3wCibEU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TEWOJEdhgOv6J1dxueAXygjo4DT7FG9pg8fVi0HMA3A&oe=6A09C838"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscap32_2560x1440_shoko.png", "id": "1450279846165373", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618065_1450279849498706_5641516501206576537_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch-pePLNc-kQ7kNvwG9liEx&_nc_oc=AdrRzCZUUiyqXqgwohF2t0lG1uofSpKoaxtnO0Jc45prw-SApgne72ZKeB8ufRaYOAo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gic8THPd3THQ-7uMrcYyyoJvx-qV3EVN86-0wHi5Mgw&oe=6A09E3DF"}, "display_name": "Street Simulator Z: Multiplayer", "keywords": ["Survival", "Cooking", "Fight", "Gun", "Playground"], "long_description": "Street Simulator Z: Multiplayer is an addictive VR sandbox where you can get rich through legally questionable means, spend your money on new weapons and vehicles, and avoid the cops while battling the local gang. Take on the streets solo or team up with others in multiplayer (up to 4 players).\n\n{1105387631512705}\n\nMake money your way: grow exotic \u201ctomatoes\u201d,sell them to locals, and reinvest to expand your business. Become a bounty hunter and take down criminals for cash, or just rob the local bank.\n\n\nSpend your wealth on new weapons and a wide variety of vehicles\u2014from a tractor to even a tank.\n\nKey Features:\n\n\ud83e\udd1d Co-op multiplayer (up to 4 players)\n\n\u2694\ufe0f Interact with any NPC, go to war with gangs, and evade the police\n\n\ud83c\udf45 Grow and sell \u201ctomatoes\u201d for cash, then reinvest to expand your business and increase profits\n\n\ud83d\udcb0 Spend your money on a variety of weapons and vehicles\n", "short_description": "Life in this town can be a drag, especially with all these annoying jerks causing trouble! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "25970970015820500"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499618251_1763788214507740_5115794147582669860_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF03xCjViJQQ7kNvwG2kesq&_nc_oc=Adoi1EyCwRZRc2Hw14lpnR6gG38Ewgip1LHorgGiUfUljMU2Uuflp7u4vDF1eVDJ7aQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FOeg69MR3KSlsqleZl-uwZTufzajMr_yoLCurG7gznQ&oe=6A09C896"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Street Simulator Z: Multiplayer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topi
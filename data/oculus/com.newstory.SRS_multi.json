dn.com&_nc_ss=7f20f&oh=00_AQBz3lpaVuIxxw3xPgsOsUB5g0HZF4wueR4IZmsD1RaHOg&oe=6A5B8538"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscap32_2560x1440_shoko.png", "id": "1450279846165373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618065_1450279849498706_5641516501206576537_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udKnZU_h-owQ7kNvwGso5si&_nc_oc=Adr5G2XeIRIxLjef6FKmP_3nFgh1qFd9oj864oEH8qx-gwiFe0fWTrmB9bCU50jW7NM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo-rBRC0SiOBg3t9EOY1KH_CGf2L2RObkBLydry-fNew&oe=6A5B689F"}, "display_name": "Street Simulator Z: Multiplayer", "keywords": ["Gang", "Survival", "Cooking", "Fight", "Gun"], "long_description": "\n Street Simulator Z: Multiplayer is the laugh-out-loud VR adventure where you and your friends (up to 4 players \u2013 insert player count) team up to flip your fortunes.\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\n{1105387631512705}\n\n\n Grow exotic herbs, cook up amazing (and maybe bizarre) dishes, take down any troublemakers who get in your way, and hustle your way from zero to hero.\n{1401990557573965}\n Earn serious cash, upgrade your gear, and show everyone who's truly running things! All in immersive Meta Quest VR.\n\nKEY FEATURES:\n\n\ud83e\udd1d SQUAD GOALS! HILARIOUS CO-OP MULTIPLAYER\n\n\u2694\ufe0f PAYBACK TIME! TAKE DOWN THOSE ANNOYING FOES\n\n\ud83c\udf3f\ud83c\udf72 FROM HERB GARDEN TO GOURMET (OR NOT)! GROW, COOK, PROFIT!!!\n\n\ud83d\udcb0 RISE FROM RAGS TO RICHES! EARN BIG & LIVE LARGE\n\n   \n\nREADY TO STIR UP SOME TROUBLE (AND GET PAID FOR IT)?\n\nJump into Street Simulator Z: Multiplayer, call your squad, and start your wild journey from nobody to a notorious (and wealthy) legend!\n\n\n", "short_description": "Life in this town can be a drag, especially with all these annoying jerks causing trouble! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24672534068997441"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "844777871307793"}, {"status": "PUBLISHED", "id": "4088308128048881"}, {"status": "PUBLISHED", "id": "1786076068675899"}, {"status": "PENDING", "id": "715132860909084"}]}, "baseline_offer": {"id": "1786076068675899"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "844777871307793"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25946144688303033", "version": "0.0.8"}, "id": "2230816237349189", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries"
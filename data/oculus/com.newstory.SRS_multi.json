scdn.com&_nc_ss=7f20f&oh=00_AQKMNigKUUHLENKMcdr8mYKGsUcPvzn400bcXem2IjeH1Q&oe=6ABE8911"}, {"file_name": "screenshot.png", "id": "1087082782807722", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618920_1087082789474388_6834342829567925464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2T4dkKDS_IQ7kNvwGUL62C&_nc_oc=AdpeyBDrVFOC4Aj8LsOlVxCuXfv-36wwc165ilSIrdxvAZSguC50sQttXHS-7PgwfZM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwjNwsDSFV50e94pEFIii5eNEv44ZOoawxiKW4V3sKOQ&oe=6ABE5F72"}, {"file_name": "screenshot5.png", "id": "1576468597024644", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_1576468600357977_963030132674722656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a28pTNMTtVwQ7kNvwEL9-2K&_nc_oc=AdqpVS9hO94AmMZaaaqRP5LY8gKF2wlSU0iIrHzeBsWTVDA8I-bsHV0UdeX6AmApfXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVw9PQI2oLIyoXHqDESiD1PkcapEjVlCdG_Rh2VTT3Mg&oe=6ABE65B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscap32_2560x1440_shoko.png", "id": "1450279846165373", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618065_1450279849498706_5641516501206576537_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UvZ3qKVVyQQ7kNvwExmBiz&_nc_oc=Adp71rT1K9lMp1AvqB-FVlV5fl_4HnzK_KeE1lyLYtgbnwbpQi4SDp2njz1dFrYKDEM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbh5c9eR2ZZmbHdfw7_JZGUz1q2PN8lbdTvXpneXjFJQ&oe=6ABE815F"}, "display_name": "Street Simulator Z: Multiplayer", "keywords": ["Gang", "Survival", "Cooking", "Fight", "Gun"], "long_description": "\n Street Simulator Z: Multiplayer is the laugh-out-loud VR adventure where you and your friends (up to 4 players \u2013 insert player count) team up to flip your fortunes.\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\n{1105387631512705}\n\n\n Grow exotic herbs, cook up amazing (and maybe bizarre) dishes, take down any troublemakers who get in your way, and hustle your way from zero to hero.\n{1401990557573965}\n Earn serious cash, upgrade your gear, and show everyone who's truly running things! All in immersive Meta Quest VR.\n\nKEY FEATURES:\n\n\ud83e\udd1d SQUAD GOALS! HILARIOUS CO-OP MULTIPLAYER\n\n\u2694\ufe0f PAYBACK TIME! TAKE DOWN THOSE ANNOYING FOES\n\n\ud83c\udf3f\ud83c\udf72 FROM HERB GARDEN TO GOURMET (OR NOT)! GROW, COOK, PROFIT!!!\n\n\ud83d\udcb0 RISE FROM RAGS TO RICHES! EARN BIG & LIVE LARGE\n\n   \n\nREADY TO STIR UP SOME TROUBLE (AND GET PAID FOR IT)?\n\nJump into Street Simulator Z: Multiplayer, call your squad, and start your wild journey from nobody to a notorious (and wealthy) legend!\n\n\n", "short_description": "Life in this town can be a drag, especially with all these annoying jerks causing trouble! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
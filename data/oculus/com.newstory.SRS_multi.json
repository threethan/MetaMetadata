scdn.com&_nc_ss=7f20f&oh=00_AQK-g-FSG3mZ7P6D2Sz93yzFY143Zltjf-XUS19oUuJI3Q&oe=6AB7B951"}, {"file_name": "screenshot.png", "id": "1087082782807722", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618920_1087082789474388_6834342829567925464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTlCz8aNTcAQ7kNvwG-8e53&_nc_oc=AdpoFTDMNENZe4XFyyw_KKcs1rWgfdQUJzFPy_prp8w-pY8h2HV3po1D5lZfwQkEn64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9kC6A5pIRpIGlvsurZPvXzalNWhF_WJka9jEY84u03A&oe=6AB7C7F2"}, {"file_name": "screenshot5.png", "id": "1576468597024644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_1576468600357977_963030132674722656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc3A_XLhHGEQ7kNvwFK_B_U&_nc_oc=AdpcPxYsD6Z8SSbHG5BW5X5ebWQiIun91UpO-p7_4SlDljIetbMLjYy_Ob9GltAJauY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq6-FzQRF_F5PEDTyFLIIcgZFgcdbr6pNe9aB5NgKRSw&oe=6AB7CE38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscap32_2560x1440_shoko.png", "id": "1450279846165373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618065_1450279849498706_5641516501206576537_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrXZB5ibnWkQ7kNvwEV6ArQ&_nc_oc=AdrdMtV3NuFiIsyUQNomcYrSc0HSiXNqlbMpDYcui6WJcc1jSLB0BRyA7M-VUpjssAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2cVuUM8yJhSbluQXVpTxhkNXW_-0ef2C1K_0nPFvDeA&oe=6AB7E9DF"}, "display_name": "Street Simulator Z: Multiplayer", "keywords": ["Gang", "Survival", "Cooking", "Fight", "Gun"], "long_description": "\n Street Simulator Z: Multiplayer is the laugh-out-loud VR adventure where you and your friends (up to 4 players \u2013 insert player count) team up to flip your fortunes.\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\n{1105387631512705}\n\n\n Grow exotic herbs, cook up amazing (and maybe bizarre) dishes, take down any troublemakers who get in your way, and hustle your way from zero to hero.\n{1401990557573965}\n Earn serious cash, upgrade your gear, and show everyone who's truly running things! All in immersive Meta Quest VR.\n\nKEY FEATURES:\n\n\ud83e\udd1d SQUAD GOALS! HILARIOUS CO-OP MULTIPLAYER\n\n\u2694\ufe0f PAYBACK TIME! TAKE DOWN THOSE ANNOYING FOES\n\n\ud83c\udf3f\ud83c\udf72 FROM HERB GARDEN TO GOURMET (OR NOT)! GROW, COOK, PROFIT!!!\n\n\ud83d\udcb0 RISE FROM RAGS TO RICHES! EARN BIG & LIVE LARGE\n\n   \n\nREADY TO STIR UP SOME TROUBLE (AND GET PAID FOR IT)?\n\nJump into Street Simulator Z: Multiplayer, call your squad, and start your wild journey from nobody to a notorious (and wealthy) legend!\n\n\n", "short_description": "Life in this town can be a drag, especially with all these annoying jerks causing trouble! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
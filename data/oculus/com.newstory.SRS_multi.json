9_04caPS353ZSIx-3Ty1lY-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPR-hESaRU_i3hhL69wkcYJ3rw7qo7Yx84zMmPsKX-6A&oe=6A7F1772"}, {"file_name": "screenshot5.png", "id": "1576468597024644", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619588_1576468600357977_963030132674722656_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzD2a0i0YoUQ7kNvwHgdSKH&_nc_oc=AdraQIKsAd8ja9OZBuXTf-_7-hSjILMrZFInVUiHfzBkh9i9p2hnpMjZGjWQw7f0N90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4X8FDDSM0r2qQLFseG4M5RprFTADd8qs8j_lApEkzQw&oe=6A7F1DB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscap32_2560x1440_shoko.png", "id": "1450279846165373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618065_1450279849498706_5641516501206576537_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31UFOhESNBIQ7kNvwEMOFjB&_nc_oc=Adpy9OegnwS7i6ufJNRVkvJQiAT7nRFXDW-zHNCt5Lp-Dk6ZXp3wI7FVfKr33vTovNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAKDvM1y4M5OPWJvBQtiIC7gyQNlIkSmaHNk7rRoSP4Q&oe=6A7F011F"}, "display_name": "Street Simulator Z: Multiplayer", "keywords": ["Gang", "Survival", "Cooking", "Fight", "Gun"], "long_description": "\n Street Simulator Z: Multiplayer is the laugh-out-loud VR adventure where you and your friends (up to 4 players \u2013 insert player count) team up to flip your fortunes.\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\u3000\n{1105387631512705}\n\n\n Grow exotic herbs, cook up amazing (and maybe bizarre) dishes, take down any troublemakers who get in your way, and hustle your way from zero to hero.\n{1401990557573965}\n Earn serious cash, upgrade your gear, and show everyone who's truly running things! All in immersive Meta Quest VR.\n\nKEY FEATURES:\n\n\ud83e\udd1d SQUAD GOALS! HILARIOUS CO-OP MULTIPLAYER\n\n\u2694\ufe0f PAYBACK TIME! TAKE DOWN THOSE ANNOYING FOES\n\n\ud83c\udf3f\ud83c\udf72 FROM HERB GARDEN TO GOURMET (OR NOT)! GROW, COOK, PROFIT!!!\n\n\ud83d\udcb0 RISE FROM RAGS TO RICHES! EARN BIG & LIVE LARGE\n\n   \n\nREADY TO STIR UP SOME TROUBLE (AND GET PAID FOR IT)?\n\nJump into Street Simulator Z: Multiplayer, call your squad, and start your wild journey from nobody to a notorious (and wealthy) legend!\n\n\n", "short_description": "Life in this town can be a drag, especially with all these annoying jerks causing trouble! "}]}, "developer_name": "Storay Studio", "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24672534068997441"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "844777871307793"}, {"status": "PUBLISHED", "id": "4088308128048881"}, {"status": "PUBLISHED", "id": "1786076068675
GTkiqp&_nc_oc=AdoLsCmHWMA1_wTiTSAxQwYzaWTMveZ1op-rEcOI6n8VsvLPZEMPlHYX3g2ZMscpxfQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TIv8YEygWrQFO96pCb2V3CILCLT0oHY_E0yotkSM9Ew&oe=6A1712D5"}, {"file_name": "GorillaTagSJR_2026-03-10_16-12-42.png", "id": "4311414442456510", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307435_4311414445789843_4827159474588869459_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtRMYre2I94Q7kNvwH84mhF&_nc_oc=AdqOVXSlOwYIjgLawq8ewo9OkmO7vByLLMgVOZdyjL4KI64OkSrUCPqLS10jR2zGsfk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QE07a-QOlVJ9rrTNiqEOuwHLZdFSKc3uMZA_QQoQO1g&oe=6A17038F"}, {"file_name": "GorillaTagSJR_2026-03-10_16-12-22.png", "id": "26289090907417407", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499301053_26289090910750740_7333158236254163759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVB404B1770Q7kNvwH8jGVz&_nc_oc=AdqG5qT5YbcBE-1QYm-gLMouiGj2rOp4ifVRE42oqI2jsLmJS0tUacSYn4eifSUNEr8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VrOwf2yrvtjvjwUl46zNDpcOKdK7ed5rSIyDbhc7hMA&oe=6A17012E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project University", "keywords": [], "long_description": "Deep inside the forgotten corners of the Gorilla Tag universe lies a place that was never meant to be explored. A place where the maps you once knew have rotted into something unrecognizable \u2014 twisted tunnels, hollow forests, abandoned structures, and echoing chambers that feel alive. In this fan\u2011made horror reimagining, movement isn\u2019t just your way of getting around\u2026 it\u2019s your only chance at survival.\n\nYou awaken in a silent, corrupted world where every surface feels colder than it should. The air is heavy, thick with the sense that something is watching from just beyond the darkness. There are no weapons, no tools, no safe rooms. Only your hands, your instincts, and the constant pressure of something stalking you through the shadows.", "short_description": "A twisted echo of the familiar forests and caves you once knew. In this fan\u2011made Gorilla Tag horror experience, you\u2019re dropped into abandoned maps where something hunts with perfect hearing and inhuman speed. Every footstep, every breath, every slip of your hand on the walls could give you away. Explore dark, corrupted environments, uncover hidden triggers, and survive creatures that stalk, mimic, and ambush when you least expect it. Movement is your only weapon \u2014 run, climb, and escape before t"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/13_Hwz3fkcgp_MnZ2yGL2m057TDXdIpGADIj80SkmzzY/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Eddy", "support_website_url": null, "website_url": "https://docs.google.com/document/d/13_Hwz3fkcgp_MnZ2yGL2m057TDXdIpGADIj80SkmzzY/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26621750027422573"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499304162_1915962652613581_4831402368652100391_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NNffKPp6lcQ7kNvwFmSgq5&_nc_oc=Adr7hgYpdSr2k-RUsttE6QQW5wnov-M832MoyZwWZyE7A14W_LBvfvLhUuV-AVPLYSo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.c
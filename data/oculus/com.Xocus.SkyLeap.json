cdn.com&_nc_ss=7f20f&oh=00_AQAtsvzWabgIMk0LjGyD0VUz8paloD_1Rh6j9WRlrb2sVQ&oe=6A539C1E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=upYFo6KyDKQQ7kNvwE6CnOT&_nc_oc=Ado-_1-I1HqcE_1-bts7LC6oYDkPT0wu3ob-VSHhW_wJcSWV8a7NRetFjFD70PnnO9o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLPB0nl57RBHzC_tJa0HpeIjtx4zARTnWFPnrrAm3w4g&oe=6A538903"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nMUuzKLCd0Q7kNvwFQ6ojs&_nc_oc=AdrDbQyoRJQ37hAPxlY0fzYjDEc0O0wZd5d0EWSgi50P9iNA9Tsu0_z-Vno7ED-sqDs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMfSS1ZWnm-q0J4CotR97F6N4sCAfLX34KUKZaGxnEVA&oe=6A539816"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
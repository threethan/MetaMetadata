wSdveiAQ7kNvwH1SkAO&_nc_oc=Adpzqa28caImjbduHAJg9PKsKuh_zZJdl5Y7E4UMZTUMtD9P7kn8aFIaP0itgyzd7mI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOB1QDV0yGroRfRhg3kG4JQadaoCBs1JbbrJRLX5HWkfg&oe=6AE34F9E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ckmQds0BZoQ7kNvwH__uSC&_nc_oc=AdrcEKOJueJYoqXsfAkwvaZB50W9kGX7QPO80TIqnj5v4Z7ez6BE0ez-7oNd7iRlZNo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMysDrvfDb8GLo7U1LsAeex60nXj7CAVofNYWwLyfUipg&oe=6AE33C83"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhRGVjZn8pUQ7kNvwEZg6IO&_nc_oc=AdquGs0Aqo9ojcymfnlo7W5xh6qeTKGDU06kolhuhNt98n2AP7t_ZAcgBV4g4OnCZJY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdihlC9rq_zRm9mi9B6CjhNNiQLsAkjKMRwJWhDVZNhA&oe=6AE34B96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynami
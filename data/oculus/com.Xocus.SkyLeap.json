cdn.com&_nc_ss=7f20f&oh=00_Af-EWOBaHDWCBzYi-8S7xumF2I6JP-jLMT3P4lj-xeTl9A&oe=6A35499E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt8vw4JMwGsQ7kNvwHxtEP2&_nc_oc=AdondM1rqQlqPhP_P0kcALhlpK8op6mabwAetzE5mSH22EFpMemMqAPNJNQpU6osQrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9crVJK6r-cNMLrg7GsuK10XmA_qsWgik3W-GlZVcTz3Q&oe=6A356EC3"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6HMSuvh1iUQ7kNvwFn19om&_nc_oc=AdrZHputksT9kvs6HeIrbAccUm3-mHJIsd8PCDA3VQ4E618_ObKpgyzoEBf8AgfTZ-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bNQtumO2UidkHk_87Keyq6qr29th26XfkyFDKlQy_dg&oe=6A354596"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
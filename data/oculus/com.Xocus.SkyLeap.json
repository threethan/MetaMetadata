cdn.com&_nc_ss=7f20f&oh=00_Af0L4JwOYKSoICdtbgA-37aH_K1mCPxD005c_x3vt2QtOw&oe=69F4B01E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTdFG-ykQvUQ7kNvwEAxwxS&_nc_oc=AdqAOQr1hyecGmXuIAHiLUKuYItzPTQDrFplqI8JSPlEae0Q8SVgqJiUFlNxDQtJjjg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af378gQnRYquKK00-9bo2e0HoM3ekClV1w3LoDGIBO2lIg&oe=69F49D03"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FF56LfjExKMQ7kNvwGkH1XM&_nc_oc=AdrBNR-z2QV6PON7EFZrMk7i9dyoDh7uOlht9MWMwD-qxKC9GWCVFBoJqvw8jbDwoIo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bIvdSixa3W657vEpr_U-tRvnrq7xSrQeHn7BTNeHd8g&oe=69F4AC16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
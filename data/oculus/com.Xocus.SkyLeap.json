cdn.com&_nc_ss=7f20f&oh=00_AQB01QwbPQe5zjafjv5Juf93cl84pTup2HxFldV57T_YuQ&oe=6A5CD69E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKW98Jg5FDQQ7kNvwFuPUNe&_nc_oc=AdoYGsmNtKosw7wivwLwUNrLud-4IXkEayQ6q6bfV9DDIzMrbworeCIHRJy36NQwjSg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXO-lOaVPit9GRYiddKa8yBCKzoLXj8WThTLi05QSu3Q&oe=6A5CC383"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEd7uHxcuscQ7kNvwGVXJhj&_nc_oc=AdqEn9se86ePD7WhlWXj_lp-jNrF6S84-PI0elPFU_O7FC9jZ37end77gCOeyXcb6zE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1Cg2SfCvmukTIHtj1OzfDXoEL3WJbU4KxWsel9IeSLg&oe=6A5CD296"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
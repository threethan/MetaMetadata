cdn.com&_nc_ss=7f20f&oh=00_Af_xQY3NX2E_yXMSKQlbTAGC8ZCyoawdVyTLyJNNO6QnwA&oe=6A42789E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEbFajlkzpwQ7kNvwHbYGqn&_nc_oc=Adr-vFB784bZSGc-SUXJe1X6uh2BqTax5zoGnyzh1V8Rp5Mf5DAyLdElumRaiDDiAqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J_hfvNd_hyu0pygTMuJ_4M3yMV8rhFsOATz20TE3w0w&oe=6A426583"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NzW0Xk41H2IQ7kNvwFEpacP&_nc_oc=AdqWlZE_gxm6lQ95N68G3XZqasYjrwuVJA6WO5U7CGd-FcdELVMALp3b5XsN4EpKLEA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EjwTyv-m8D32GbQn06KaOCr5FQfiD6rs4RP4tHo0ikg&oe=6A427496"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
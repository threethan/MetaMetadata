wSdveiAQ7kNvwEHSVCQ&_nc_oc=Adq86AuazEUitF4x62-PFZuoD7RtBVzBa2y2_oscv7jeQ1kmgIOMEgQJY0jpjTmLL7o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfIOS4zI--2Px10TcML1M48rXT_mC5vmLhWTtfRCEmCg&oe=6AE4A11E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ckmQds0BZoQ7kNvwFqOYKq&_nc_oc=AdoyIxSniTiawkkzV0VuUFoyTFf0gi8I-8kScPjlz057_TEgTEHYL5RFnIj6KXVcljU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqAc2JdqrXeBzoqFp3cYRIhjW00DATTHY5rt46ySDsLQ&oe=6AE48E03"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yd-Y6j56V4Q7kNvwEuuVU3&_nc_oc=AdoFMH5qsfF7ve3GvXR_89Gfut04G22mQ2syHrzaw59jGrSzdnh9Uc18MAMAAfo3EdA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi7SfTcwhhyZ7EA3KFshFDDEB5aplogdDeJwCqMXy3Og&oe=6AE49D16"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynami
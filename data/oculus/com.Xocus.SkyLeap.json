cdn.com&_nc_ss=7f20f&oh=00_AQCT4SzSn3U-gZSvymIbCKPJ-eR8Nq6fs72hcfN0jSrftw&oe=6A6DFA1E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiIqIlzqQs4Q7kNvwGOy3Lj&_nc_oc=AdrtS7D6ajZDtwu8FWGL-vlaehD3qe9uFm66VV5ZsGVipWuBV8bQblnC87ghs8GP29s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5FyafPCJQVaU8EU1sMAZ_Ni0v8SC_CzcNK5ucnUeMiQ&oe=6A6DE703"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQ3WT8ICjKUQ7kNvwGUUtxM&_nc_oc=Adrj9GSVdXMimT3ir-rleqPCkKRHUkYYxCqil3cA_ZMMvO8w6M2Q1Orahv3jWK7mn6s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtvQ4zcvB8DVSzFZXNjU9oXAp-exYD8RVxGGofL9G5CA&oe=6A6DF616"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
cdn.com&_nc_ss=7a30f&oh=00_Af1Urvmbc-IinBwaOGyevWVyxpelQgk5_k4IKOx1rzCTLA&oe=69DBA39E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsd1fdNBJoMQ7kNvwGnPZHY&_nc_oc=AdpNUBzXDog-DaQc-_qTwkDk7RQGTpxhanD6LpKckJVBJ7P0xNjxfHRkuz4h_lCuICM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LBbgYWurI2Ui05FqB7AoyhBVwrIREtLFJwd3835tt9w&oe=69DB9083"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-HjBMYJ3GMQ7kNvwHqaRbx&_nc_oc=AdrepdQAhvrwTGrhBK-71EU2GCJehbXoLMUImtH1LJ1Uo66nJFivkzm43kKWe6ZP3Hk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GUJ5lmsAId5reaId5g9O0agf8ik7SHTaCMXH9K9dTHQ&oe=69DB9F96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
cdn.com&_nc_ss=7f20f&oh=00_AQGyS2l_QZ7tA8CmO6BJjltqjkqRYZwxpTbIsZqzd9Gc5A&oe=6A74919E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RU18wcSdaAcQ7kNvwEXpafa&_nc_oc=Adplj2vYuoigcFr7aCR4efMobq0AKmRQXnMizaz2U1XW13jcVymwXA6OIY9XhSFCLys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5q6wdbrQdcxsHbpTKnTbz6nwVN9b8Ct219qmXRPq1MA&oe=6A747E83"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ESUj-3R7YEQ7kNvwFQkJP1&_nc_oc=AdqQlhiLlWi_j5D6pxjLD2VHilKJTkDvNmFQyXyxUs6vVR0lHbLmRorCpfymchFdipk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8zcGXfO6_tpzM-IS3mfaoNKje2MKO_WPiT0x8dK_j8g&oe=6A748D96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
cdn.com&_nc_ss=7f20f&oh=00_Af5xs7VaMHbsWb53P_GM8oSq5ZPf5YrCOXZCoDCbOFvZoA&oe=6A09C81E"}, {"file_name": "4.png", "id": "24969599659369902", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821081_24969599676036567_2142303813908042332_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr7mkvQK81YQ7kNvwEitkSQ&_nc_oc=Adr5-9OvQ3mKrwRTDAbdxcL6DeG4voUgIjO4aK0JdC1yNvNKnSiLpwMbkPvbZeuIylg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KorYdl4G-oSpdXl1z7FtFEfieRMijoAmpFt8MDZIXxw&oe=6A09B503"}, {"file_name": "6.png", "id": "1351185706420218", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491831056_1351185709753551_6261425430485877118_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzAeUVFz_7sQ7kNvwHDZZnN&_nc_oc=Ado74P6tWhGGQa7e9TsAy-kSIMB5BYPZcR02j92wtIgJzAnOUFwIMzqsy0Ic2oM6M5k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DCcRi6-Q3gNNLlOK_6gBLY9bgfkl-qTPZTQz00zJavw&oe=6A09C416"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyLeap", "keywords": [], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\nRun, climb, and fight:\n\u26a1 Dodge turrets and tricky obstacles\n\ud83d\udd2b Use your weapons mid-air\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\u2b06\ufe0f Keep climbing and push your limits\nOnly speed, reflexes, and the flow of movement will keep you in the race.\nUpgrades, customization, and an energetic soundtrack await.\nAre you ready to make your leap into the sky?", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xo
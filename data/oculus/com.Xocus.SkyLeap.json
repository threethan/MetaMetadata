5-2.oculuscdn.com/v/t64.5771-25/491823259_1326995329182334_8355890638329200326_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PUKD6-kfT0Q7kNvwHYPAoB&_nc_oc=Adloz2r3QEAuE-lV5EXPogXuluuPvTsezAwIxAKeSv1f5ucKpq7sVZGGei0qWNyQ9W4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwzJkGFc-tpMz_4k-lfEYeME0OkJzrI1RqW5cJsrvQNow&oe=69B4073D"}, "display_name": "SkyLeap", "keywords": ["parkour", "climbing", "action", "platformer", "shooter"], "long_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to flow through a vertical world built for speed and movement.\n\n{1813006879397225}\n\nRun, climb, and fight:\n\n\u26a1 Dodge turrets and tricky obstacles\n\n\ud83d\udd2b Use your weapons mid-air\n\n\ud83c\udf00 Chain jumps and telekinesis into fluid combos\n\n\u2b06\ufe0f Keep climbing and push your limits\n\n{792032636563437}\n\nOnly speed, reflexes, and the flow of movement will keep you in the race.\n\n{1516906566071378}\n\nUpgrades, customization, and an energetic soundtrack await.\n\n{836591216091404}\n\nAre you ready to make your leap into the sky?\n\n\n\n\n", "short_description": "SkyLeap is a non-stop VR parkour action game where your only goal is to climb higher and higher. Use jumps, a grappling hook, and telekinesis to move through a dynamic vertical world designed to keep your momentum flowing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://www.xocus.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_a
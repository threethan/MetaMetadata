477415301325353_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqTyz_rg1ukQ7kNvwGSHIvK&_nc_oc=Adp5SW48hqBNDWbMxpZzia2Lb_g-x2kGQCJCv7eHsf_3rfz-PIG8kv4IsvWGUIyaZnQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP7SQM_7r5meeWatmijMyreS_s1SqdFSn5RdLtQTZ9Pw&oe=6AF1EE57"}, {"file_name": "com.voissllc.voiss-20260122-161949.png", "id": "2048918679282245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305194_2048918682615578_4092657542026682873_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jwakwg2B83AQ7kNvwEsJzkI&_nc_oc=AdqwY7HFTeafKyAGLSCjelvM9kIqfzdQTkRulSQkRZX-5dFcB9Z9f0j9xRO82Ya2uy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6zQf0sN1lZTTHi1BrJM_1aIMsLBpU88KAjv3ZhZErqw&oe=6AF1EF37"}, {"file_name": "com.voissllc.voiss-20260122-161704.png", "id": "879878421358818", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300897_879878424692151_6419731173160058794_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-K7qw0xHL34Q7kNvwFd4m10&_nc_oc=AdoZ23uv_rlwv88eVBz2GWZfl7KEIthG1J-tmQBq20l-qsvJu2rvQ8VcvLIAVHUG9cY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSznqUITEq580j2Ezdaf8HE0oed-WG7nKat4pQDZrpsIQ&oe=6AF1DC81"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VOISS", "keywords": ["Autism", "ASD", "SPED", "VOISS", "socialskills"], "long_description": "Welcome to VOISS, the revolutionary application for teaching essential social skills to youth, ages 8-18, using immersive virtual reality (VR) scenarios. Developed by VOISS, LLC, our platform is backed by years of research conducted by the University of Kansas, which has been ranked #1 among Special Education graduate programs for 27 years in a row. VOISS allows users to practice critical social skills in a safe environment while allowing educators to monitor progress and access resources that help students extend social skill learning into the real-world. VOISS provides users with a solution that combines cutting edge technology, journal-published research, and experiential education domain knowledge that will help progress and excel in life.", "short_description": "Teach and check progress for essential social skills with immersive VR scenarios"}]}, "developer_name": null, "developer_privacy_policy_url": "https://voiss.org/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VOISS, LLC", "support_website_url": null, "website_url": "https://voiss.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25135389706079829"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1512120437210644"}, {"status": "PUBLISHED", "id": "2301918416986786"}]}, "baseline_offer": {"id": "1512120437210644"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1777665120, "status": "PUBLISHED", "id": "1512120437210644"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28444378475180919", "version": "2.40"}, "id": "1311076230484681", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25135389686079831", "is_concept": false, "latest_released_binary": {"__typena
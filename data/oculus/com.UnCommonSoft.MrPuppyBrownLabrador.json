content-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pChg-J0ALff6Qu29a1J9Ja68euss6zt6YcJmt37SAEQ&oe=6A0739A6"}, {"file_name": "Screenshot 2025-10-08 111757.png", "id": "1482992896320096", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302848_1482992899653429_6113334247617258180_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceRb0rh1gOcQ7kNvwHzoeJk&_nc_oc=Adq6vizW7Vb-wL0eGxPmQ8ltSwlYKLKsacpkOTTjijgp98gnyzKqX6y64NcCNCf_wn0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BpirgFT-P3wdPuCYhdCG6v6UQmJdP_yC5nwtxPEeAhw&oe=6A073E48"}, {"file_name": "Screenshot 2025-10-08 111734.png", "id": "1189239709688471", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821886_1189239713021804_4223428013596727702_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb5NmUjBztYQ7kNvwExBD6T&_nc_oc=AdpGv-glXvn2B8gNrpbCZGwxa1_r4p0_XF6yoE-ChW09Li92htf6qP1rTLFI89EuRuA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ouBEO4NoBo33IjApW0oJd14LEa0ht3UOWQlE4g0fPbA&oe=6A0723DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My puppy: Brown Labrador", "keywords": ["dog", "pet", "pup", "puppy", "Labrador"], "long_description": "Step into your mixed reality world and meet your cheerful Brown Labrador! This friendly pup loves treats, toys, and attention. Feed it crunchy biscuits and juicy chicken legs to keep its tail wagging. Toss a ball or toy bone to play together and watch its excitement burst into life. When it calms down, reach out to gently pet its head or give a belly rub\u2014it\u2019ll lean in with pure happiness. Every touch, every snack, and every game strengthens your bond. Bring this warm-hearted Labrador into your space and experience the joy of true companionship!", "short_description": "Play, feed, and cuddle your cheerful Brown Labrador\u2014pure warmth in mixed reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/eb8115ab-f129-4bc3-b08c
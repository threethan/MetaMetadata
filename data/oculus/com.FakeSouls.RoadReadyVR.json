0a&_nc_ohc=d8DEQCNQ-hIQ7kNvwH0ff8H&_nc_oc=Adpzr1ScpTuRIZbvObQF5wYjhvhvkzF5TaAsaqiK5LE9k_xk8aEn-kkpHGDqieJxp5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oc1ib6PLEPAUjPfui5YZzoJT7h3zVaufVvzNXMysDLg&oe=6A0DAE94"}, {"file_name": "SS_1.png", "id": "2010926202812643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822968_2010926206145976_8266380978177505109_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlCNkJig5zsQ7kNvwGJtoUp&_nc_oc=AdqFu-3CouSvvyV3OhqjmdAQGY-ebRlvsP4taxkqsVQce7kh0Po7tiSTdOYouDnUnvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ireVb4hSd4W1yODcBTsTNbrMq4KMs_wvWSpV8gVSpzQ&oe=6A0DCC79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Road Ready VR", "keywords": ["Driving", "Simulator", "Practice", "Training", "RoadTest"], "long_description": "Road Ready VR is an educational yet engaging VR driving experience built to help new, beginner, and anxious drivers feel confident behind the wheel.\n\nDesigned as a safe and judgment-free environment, Road Ready VR allows players to learn essential driving skills\u2014such as steering, braking, acceleration, reversing, turning, and parking\u2014through structured lessons and realistic driving scenarios. Players can practice at their own pace, repeat lessons as needed, and gradually build muscle memory without the stress or risk of real-world traffic.\n\n{877732101463625}\n\nWhile Road Ready VR is grounded in education and driver preparedness, it is also designed as an enjoyable and immersive game. Realistic vehicle physics, interactive environments, and scenario-based challenges make learning feel natural and rewarding rather than intimidating.\n\n{1184179947255492}\n\n\ud83d\udea7 Early Access Notice\nRoad Ready VR is currently in Early Access and under active development. You may encounter unintended glitches, incomplete features, or performance issues as we continue improving stability, expanding content, and refining the experience. Player feedback plays a key role in shaping future updates.\n\nOur goal is to bridge the gap between theory and real-world driving by offering a practical, confidence-building VR experience that prepares players to become smarter, calmer, and more capable drivers.\n\n", "short_description": "Road Ready VR is an immersive driving simulator designed to help beginner and anxious drivers build real-world confidence. Learn core driving skills, practice realistic scenarios, and explore safely in VR. This Early Access release is actively evolving, with ongoing improvements, new features, and occasional glitches as we continue development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-road-ready-vr", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25840292648907694"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1846513469337430"}]}, "baseline_offer": {"id": "1846513469337430"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767157200, "status": "PUBLISHED", "id": "1846513469337430"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27228833813386897", "version": "2.0"}, "id": "1383203160018607", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25840292615574364", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27228833813386897"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1383203160018607"}]}, "change_log": "\ud83d\ude97 Road Ready VR \u2014 Major Garage Update Now Live\n\nThis update brings one of the biggest customization expansions yet to Road Ready VR.\n\n\u2728 New Features:\n\u2022 Added the all-new My Garage system, allowing players to choose and manage their vehicles more easily\n\u2022 Added a brand-new Customization Shop to personalize your car\u2019s appearance and performance\n\u2022 Added interior cabin lighting for a more immersive and premium driving experience\n\u2022 Added new cars with different driving styles and handling feels\n\n\ud83d\udd27 Improvements & Fixes:\n\u2022 Improved overall optimization and stability\n\u2022 Fixed mirror brightness issues for a more realistic driving experience\n\u2022 General polish and quality-of-life improvements across the game\n\nThis update is focused on giving players more freedom, immersion, and personality behind the wheel while continuing to improve performance across supported Meta Quest devices.\n\nMore updates are on the way.", "created_date": 1778618374, "id": "27228833813386897", "version": "2.0", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25840292615574364", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27228833813386897"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1383203160018607"}]}, "change_log": "v1.9 is here\u2014smarter, smoother, and more immersive than ever.\n\n- Major Fixes & Performance Boosts\nRear-view mirror distortion resolved, improved hand grab animations, plus multiple bug fixes and overall optimization for smoother gameplay.\n- New Feature: Honk System\nYou can now honk your horn using \u2018A\u2019\u2014because sometimes the road needs to hear you.\n- Improved Sound Experience\nRefined SFX across the board for better realism and performance.\n- Enhanced Road Test Evaluation\nSmarter and more accurate assessment system to better reflect real driving standards.\n- Road Test Fixes\nAddressed multiple issues affecting test flow and consistency.\n- New: Speed Camera FX\nGet real-time feedback with immersive speed camera effects\u2014watch your speed!\n- New Advanced Lessons\nTake your driving skills further with newly added advanced lessons. (More coming soon.)", "created_date": 1775935839, "id": "26871853825751566", "version": "1.9", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25840292615574364", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27228833813386897"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1383203160018607"}]}, "change_log": "\u2022 Improved lesson structure for better flow\n\u2022 New lessons added (more coming soon)\n\u2022 Updated Parking Mode with new options panel\n\u2022 New: Parking Mode without traffic\n\u2022 Reworked Road Test UI\n\u2022 Bug fixes and performance improvements", "created_date": 1775166340, "id": "26775565558713727", "version": "1.8", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25840292615574364", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27228833813386897"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1383203160018607"}]}, "change_log": null, "created_date": 1774650604, "id": "26710085275261756", "version": "1.7", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25840292615574364", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27228833813386897"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1383203160018607"}]}, "change_log": "\ud83d\ude97 Road Ready VR \u2013 New Update\n\nWe\u2019ve focused on making your driving experience feel more immersive, structured, and realistic than ever.\n\nWhat\u2019s New:\n\n\ud83c\udfa7 Radio System Added\nEnjoy ambient driving audio that makes every session feel alive and less robotic.\n\n\ud83e\ude9e Mirror System Overhaul\nRear and side mirrors have been redesigned for better realism, clarity, and performance.\n\n\ud83d\udcc8 License Progression System\nProgress like a real driver \u2014 build your skills step-by-step toward mastery.\n\n\ud83d\udcca Driver Dashboard (Stats Panel)\nTrack your habits, performance, and improvement over time.\n\n\ud83d\udee0\ufe0f Fixes & Improvements\nGeneral polish, stability improvements, and performance optimizations across the experience.\n\nGoal with this update:\nMake Road Ready VR feel less like a simulator\u2026 and more like real driving practice.", "created_date": 1773957232, "id": "26621133947490223", "version": "1.6", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
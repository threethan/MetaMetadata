=6AE8B2F2"}, {"file_name": "ReportCard_SS_2K.png", "id": "1837631943616204", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499304019_1837631946949537_3922230705153563816_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkPbYgy1akIQ7kNvwEGetbO&_nc_oc=AdpWX3LARmNMIfavduZBaJbY-n6a8-cbR7Er967XQggcBMlS2A8InKImHDBs6KTG3_g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTbofcIVms0SJIGxMPirdEw67kvUMNFqlTmf_bqI3Jxg&oe=6AE8B6AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RoadReadyVR_New_Landscape.png", "id": "3261733797547620", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618297_3261733800880953_4391357301986743978_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzJiJYrO9t4Q7kNvwFvUPD_&_nc_oc=AdqtKnvArfeBOPDtRCcUKwqqXc3j4d1piPEjU64rL5hx0NVEc95lGQMsSlAsmVGAl6M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv6UAAVyb7zu27zUWce7SPXSU5Y3IqjV316osgWN87xQ&oe=6AE89B9E"}, "display_name": "Road Ready VR", "keywords": ["Driving", "Simulator", "RoadTest", "Parking", "Highway"], "long_description": "Road Ready VR is an immersive VR driving simulator built for beginners, nervous drivers, learners, and anyone who wants to build real confidence behind the wheel.\n\nPractice real-world driving at your own pace with traffic, intersections, parking, highways, automatic and manual driving, and everyday road situations. Learn without the pressure of a real car, instructor, or busy road.\n\n{2929280087442790}\n\nTake your skills further with **Road Test Academy**, designed to help you practice road-test scenarios, observation, control, decision-making, and road awareness. Advanced Driving Lessons let you train on highway merging, lane changes, intersections, roundabouts, stop signs, manual driving and more.\n\n{1419605966784425}\n\nPut your skills to work in driving careers. Become a **Bus Driver, Delivery Driver, Taxi Driver, or Carpool Driver**, transporting passengers and completing jobs across the city.\n\n{1693869365024209}\n\nExpand your garage with **premium cars**, manual transmission driving, and vehicle accessories to personalize your experience.\n\nWhether you're preparing for your first drive, nervous about getting on the road, practicing for a road test, learning manual, or simply looking for a realistic driving simulator, Road Ready VR gives you a safe place to practice, improve, and enjoy driving.\n\n\n**Start your engine. Build confidence. Master the road.**\n\n\n\n\n\n{4453967901586145}", "short_description": "Learn. Drive. Master the road. Road Ready VR is a realistic driving simulator for beginners, nervous drivers and sim fans. Practice parking, traffic, highways, manual driving and Road Test Academy lessons. Take on taxi, bus, delivery and carpool jobs, unlock premium cars, customize with accessories, and build real confidence behind the wheel."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fakesouls.com/privacy-policy-road-ready-vr", "developer_terms_of_service_url": null, "publisher_name": "Fake Souls", "support_website_url": null, "website_url": "https://fakesouls.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28818035831133346"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673780696_1038428052532515_8419097619498643
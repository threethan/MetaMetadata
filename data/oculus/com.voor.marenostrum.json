kNvwFETVlx&_nc_oc=AdqymB34H1AF0fUxC7BoJwCDfaS77WuUmjRqqla-phj8kGo5g-lJjNjlp8EWsS7GibA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeb2spBHpqdidra1PVo_TZkNgWUaVvSdIXUmerHukkIg&oe=6A677ABB"}, {"file_name": "migrated_image.png", "id": "862753654195846", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162694_142333069723005_4518638803249790976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COFQHKKH4qEQ7kNvwHuw1CK&_nc_oc=AdobP3RWP_apTofr-GmOaBftgkRMbYr7auRuoUHwW2vBWDs0GE6O7Gzfb6VQosqbQFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzP3nvFAtZ6h6FLp1qi8CPGm6aimYOSaCkLt6queEVuQ&oe=6A676CF4"}, {"file_name": "migrated_image.png", "id": "211138506613625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162696_1092271920909877_4131624471347855360_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5sYhsc-3vYQ7kNvwFw-24s&_nc_oc=AdopFrNfcuQe29z14R-OK9vztHDLcU0fKb3QZ4ESzCorHbtXqf1fBmEj11snFegrYEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQxD-wp5FkdJAMHbN18LVDdT4Lc5wZXGc1VABIZ_ypxA&oe=6A67777B"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU6IWC9FJWkQ7kNvwHPTlgZ&_nc_oc=AdqOZZhWc8eeeqEeyAEfwqC0yKlXTSrDRCLiRYS2noCAw-UgCdx_YelBX1hso97JbMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYmesMz8D2wsT6BoQUZka0ivjXpBKJ1Tn6e0vQvUDRjw&oe=6A6762C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "473983360981225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162696_1854899914
kNvwHsSQv7&_nc_oc=AdobJPOrZxj8dBseAqtyJV7G1Ahtue7n3L808zqet3Z_KFQIQwj9WGvnNwMCOI2kLHA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sR5cemZa2WTbQ32yk9sre93FeJect-VnsLUNG6vCtTw&oe=69D248FB"}, {"file_name": "migrated_image.png", "id": "862753654195846", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162694_142333069723005_4518638803249790976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5-N9FKAvc4Q7kNvwFPW7So&_nc_oc=AdpXOh4-d0CQv3DE3MC4BJfxZ7p1pqlHXWkQIoVy9EJ_Tp4fzcnal6j87cXbi1huEpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qJkO31MZRmtojTmTGJZrG0ilmWgdk0zqsCPpDCQ22iQ&oe=69D27374"}, {"file_name": "migrated_image.png", "id": "211138506613625", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_1092271920909877_4131624471347855360_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMUeQ8KmAFAQ7kNvwE2uk06&_nc_oc=Ado9AYs-_VacM4rSr-oQdlnDCwd9gcjRF1ECZWquIkI1uLhh3RW43htb3Tx5nPnHmuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SYv2Gq0A9ftgk4mi9XzQ0Kw7XtHgudqitD2w7d9qgVA&oe=69D27DFB"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6N2dMCevEH4Q7kNvwHQBRd4&_nc_oc=AdqkSaYuHl6XeB1CFnVXwPCZnoFgLtXbAQ_5ay3EO20qNRTyoGkImIAwPmmhUxZUYro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13Fvj2h52KfiADdVVSvBX6SfshEIfFR4scNh9mqn2pOg&oe=69D26944"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "473983360981225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162696_1854899914
ed_image.png", "id": "2640218199636121", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162731_183616302200023_6573894273450639360_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXRuqTTUySYQ7kNvwEl6sSz&_nc_oc=AdqbAWLSfq_IEb3UgG-Ax8lUiJPcTHJn4E1daCAKTQER4nYvtjjvSt1fr5eqE0jQf8E&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJJSWWr1c9ECFdHLtIH2gN7MOCkbDlSxrD_Pu8bU-dMA&oe=6B0851BB"}, {"file_name": "migrated_image.png", "id": "862753654195846", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162694_142333069723005_4518638803249790976_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xyxKEQRPDgQ7kNvwEL7Cdq&_nc_oc=Adr5ewbR6PI_XUyfQjxmgimqptwiRYWg8hB--ryd-D7YpaZwZPQuFKV6btpbWAwYEsM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl1w6rpm-sr9OVf8RKJqa62yV5YCmd7YODJyyUcbQa4w&oe=6B0843F4"}, {"file_name": "migrated_image.png", "id": "211138506613625", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162696_1092271920909877_4131624471347855360_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBU4YPiVS0kQ7kNvwEChN2L&_nc_oc=Adro9pydmQPcK6gz925ZaDZ4JM_SW-vjxkuET4YKj7uHSW2zYcM2zEY_skZ1W1EC37Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqry0rT18oSPYtNZ6RjrDX5A-ZY024ikaSxKy9w57x6A&oe=6B084E7B"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgLjJHwfPlwQ7kNvwHcNejZ&_nc_oc=AdrDl8RwChHViqvFzw6mRGra4gy7rK4sj87bGM4iVoa-0rYMnRr3KbGNHg9JnK8uEWo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOG2uOAZB24nil5IkReuJLhfB4_nlvjUJL1QTPVDqsdQ&oe=6B087204"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
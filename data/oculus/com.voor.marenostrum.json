b42Yq0iZ16IBmG2VB_n6hGTIlICjQkgwnNmFF8WiUw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXzChlqj5Uq8H5WaK1VFcdiwjoAeYg9mp_5nds0g_f9g&oe=6A8ECC3B"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8Irpa0VmdoQ7kNvwErsxQU&_nc_oc=AdpFuIpaDKzt8hLZSwvlxKqPFV-89hGDX5bO9gpYhzBN8FbQAAItq4TyICuTzzTipuU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBt5kya9GhAMjNoE7bYQjubN6ohUg1FyehfKSAypg0Ow&oe=6A8EEFC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "473983360981225"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "212820082825395"}]}, "baseline_offer": {"id": "212820082825395"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1523466000, "status": "PUBLISHED", "id": "212820082825395"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "833564290101054", "version": "1.85"}, "id": "952011801604629", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "654321418025343", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "833564290101054"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "952011801604629"}]}, "change_log": null, "created_date": 1521911575, "id": "833564290101054", "version": "1.85", "version_code": 85, "release_status": 
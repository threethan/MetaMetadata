ed_image.png", "id": "2640218199636121", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162731_183616302200023_6573894273450639360_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXRuqTTUySYQ7kNvwEfxn9c&_nc_oc=Adry7sHrHC1Mj1NAVcmhL1wVpLxxqVygtSP0-JyxuADFV5AA-xuqUq2S_4jfGslhIrM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS-yUOILyn_1m819HBnNGIIFrXc0QtC7fPfdvfa9LX_dA&oe=6B0B2CFB"}, {"file_name": "migrated_image.png", "id": "862753654195846", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162694_142333069723005_4518638803249790976_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_ZGE5H5qmgQ7kNvwHkm8M1&_nc_oc=Adpoub1PpQVVZnfzno4xgWyIDMLz6zbuH_9ONz0161tqy-AIkg38jxZqYf19sY8uk68&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYKL3tIWv8-U864fhU-jt3krkZyE9zckFJDflziMu4vw&oe=6B0B1F34"}, {"file_name": "migrated_image.png", "id": "211138506613625", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162696_1092271920909877_4131624471347855360_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBU4YPiVS0kQ7kNvwG3kMHa&_nc_oc=AdrV9NadqBO6s2ZAJBpI6pE_OfTbELzTd7_Z1razo-y2uqciQGBROdMlAHpGayblT3Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhAmYzeEnLOVQ6TJHBiIl22A9gOwPGqPFy_tCg6fQCTA&oe=6B0B29BB"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgLjJHwfPlwQ7kNvwGSGuYB&_nc_oc=Ado5UXJDXx6cj0lS5uRon9UoVVSTdGgtU_L7B_tewMrZ_6PR_qX6m7RyCl3go1wNQr0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREXpWsgru5jfuygvtsA48tonTwmQcabhreNoNA2sNmbA&oe=6B0B1504"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
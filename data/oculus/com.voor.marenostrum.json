EQ7kNvwELBt9A&_nc_oc=AdqNlhmgU3hWAWQ9B2PPw2T672U29sMdQL-EXfGAyZC18EK3hitf8QpUt5PL82pUzno&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qTl0QF_IdARoD4hyT8pO81wOgjX0gzY4chM6pk66V_g&oe=6A22ECBB"}, {"file_name": "migrated_image.png", "id": "862753654195846", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162694_142333069723005_4518638803249790976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVjwvB7jED4Q7kNvwE9omgy&_nc_oc=AdplTamIgh7gIS0ssIZvWw15W3c_21_42SxhkzGtZQH-48w68KS7fNbJS_ooj6by7jc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3S9da-OkV7cXbHdPGPPnt_X1ONidi2vdECD8ap7A_cQ&oe=6A22DEF4"}, {"file_name": "migrated_image.png", "id": "211138506613625", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162696_1092271920909877_4131624471347855360_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcO567hwFPYQ7kNvwFt2Xh5&_nc_oc=Adpo2BIKqVr1AzuPK1ViyRKW2pyE9Oj3Qd0qiG7MvLYu6hKvohgKEx01VrDiT4raZRc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-57Tk_Ro5TrOKbHLqFFsjkrdJ9I1GFVjc3OZJP77dXAQ&oe=6A22E97B"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QN-ESEoKwekQ7kNvwFmfNWk&_nc_oc=Adrmx0Xm8cu_TsNn0QLabNAZL6jWCkBf_3y5qmFbo5gknsiQgTDr-fB7L7rs3BgmlXA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z4BCXOMUXw3-MmGLbuZx2wyHHSuRGD3GYMl0jFRu8Cg&oe=6A22D4C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "473983360981225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162696_1854
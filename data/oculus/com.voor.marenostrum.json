ed_image.png", "id": "2640218199636121", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162731_183616302200023_6573894273450639360_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TU_95bym5_MQ7kNvwEHiskd&_nc_oc=AdoXEFDoo6_1nI2whF76BVaLd0xcKB1_UpFpc7bKq6vNlwYCnDdRTKeSmyYXcLOUPkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCTmdv32h-P9y3tD3GI5mZRE4XCI4txlcU-5iJxMstZA&oe=6B07003B"}, {"file_name": "migrated_image.png", "id": "862753654195846", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162694_142333069723005_4518638803249790976_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xyxKEQRPDgQ7kNvwG8x9u-&_nc_oc=AdpeygcL4LVlB2ABmsR2m3bhD5gamoRoyJyV_e8nVkhjqOs6Im58sObPbGuCvMbWphU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAMSAvXPIACNqdw6yWCd8jjpfNUup-W-xDpWa2C8g9mg&oe=6B072AB4"}, {"file_name": "migrated_image.png", "id": "211138506613625", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162696_1092271920909877_4131624471347855360_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KD0Nv8pL18MQ7kNvwHbKRQv&_nc_oc=AdopqpzkdpLXAobvHLMqWoLqW1ZDHklCvIEITlq1LFHAD3wQheGTUVQ_EXKAu3vip7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkuqKWg-C-IsfvhWjIYypqk4s-Zxn6vgZf_EmyQvCYhA&oe=6B06FCFB"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxfsV3sdBtMQ7kNvwHntVhx&_nc_oc=AdrNxhM1khZvvmqkEbwLlvAq17lxRG8SOvIVjBb4XGaISjzwCXYmYUbB1OZYXJW5C8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDoDktOMec2VVsPual8-rv18Vpr32CsGxp-N2jIGyWaA&oe=6B072084"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
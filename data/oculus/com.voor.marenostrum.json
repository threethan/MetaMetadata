ontent-iad3-2.oculuscdn.com&oh=00_AfuH7sIRVltZm4rXjVR-dwuWsJxOgH_X_X3qVOn_uw1QHQ&oe=69A6C77B"}, {"file_name": "migrated_image.png", "id": "862753654195846", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162694_142333069723005_4518638803249790976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGcSUgGtQ5wQ7kNvwEWSbKe&_nc_oc=Adlm40W_YKR7lt_pKJ6sl0m3l2OFbzklL09UzJgLqjZ9DSbftsVlZiyjEVSFBIcTr1w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4DlVp-Np8q6kbuh1KkEF8bhDkpRZI4cQk8nOhb7g_Pw&oe=69A6B9B4"}, {"file_name": "migrated_image.png", "id": "211138506613625", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162696_1092271920909877_4131624471347855360_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-4BQTajsT4Q7kNvwE55kt7&_nc_oc=Adl4RakvcKcOdF1N2460hI-3DMLGr9s2jN9Eva7r50BZ7bKht5Nu1e074ASpE76G5F4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqKMp4DOAOLYnOhM5XbAIIsl3TP4gBBvdlWsD_DJT62g&oe=69A6C43B"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG6U8i_LIOUQ7kNvwGrPpGw&_nc_oc=Adl9pdUuKW-XhNtDsu1WywXux9yvR-XBUF6NkFxzN9cuxu39eJuaMP0RrFfEXM0YZQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsfnSU-IrXrCoC7Ont1_N-I9qeRobww8_wqyAcU5J90yg&oe=69A6E7C4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "473983360981225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162696_1854899914523482_2481839752412659712_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYwS8Kvu3BkQ7kNvwFt7-C-&_nc_oc=AdkEMWDnOzU2CI-B6TXL0ebFam9E
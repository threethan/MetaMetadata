oQ7kNvwEagr0w&_nc_oc=AdpPJxzqIZfWzhCN2QuHjuqZaHa-ToGvsITeImor3OX069C_SZF4edkfjwdnYMDqWV4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGShwXO7bHWaMCq4J9_4xJLxTOA2A8_3Sb_VESokaP9qw&oe=6A7DABFB"}, {"file_name": "migrated_image.png", "id": "862753654195846", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162694_142333069723005_4518638803249790976_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ClY94IZbDisQ7kNvwHrbFBk&_nc_oc=Adox8P7_nOlT_4mg9m2Gp4QngfqjFCuGN26HzL6KY-V6Z2u7uvFwg3zdzruBHtiQZKg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExvXrIaP2M3m15azx36zaCCd_aqa71O-hB07Lmcy2pFg&oe=6A7D9E34"}, {"file_name": "migrated_image.png", "id": "211138506613625", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162696_1092271920909877_4131624471347855360_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KELpm07n5W4Q7kNvwETic7b&_nc_oc=AdqNBf9eK4bLbGSBji7TPCeXckqBb7VbnQm0z_oroi91sNt9CNlwIti6hMoolgzN8IA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKQYRhy09NHbdV-hT9M5LwRsRg-mL02yRsXntbO2JIyw&oe=6A7DA8BB"}, {"file_name": "migrated_image.png", "id": "206292154039907", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162700_493900727654101_3480673812012335104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SUQ5pWxDt8Q7kNvwFb7rP5&_nc_oc=Adp8xCqbMFO0Iy8q56Y_ENmFktvJ-DjCV_UZjZ2pjZFB7BPEpR9Dn1JCh2tcDppffyk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjZQiaVPpR-zZwzuSVu2ucKsVaVjkPfSs7j14yRKw5lA&oe=6A7DCC44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mare Nostrum - Lost Memories", "keywords": ["Migrant", "Crisis", "Mediterrean", "Sea"], "long_description": "At the beginning the viewer is experiencing a diving journey starting with an idyllic marine scene surrounded by small silver fishes swimming around. Suddenly a strange noise comes from above, a sort of engine is getting close trudging through the waves. Is getting dark, looking above we see a keel\u2019s shape. The engine stops, human voices now are screaming.\nA plop: a bag is falling down; we look up and few objects start floating around.\nAn old and worn baby\u2019s sneaker and we hear the voice of a child memorizing a Koran. A snack falls down matching a child voice.\nA woman\u2019s veil twirls while a mail voice is calling her\nSome pages of a primer come with a child voice syllabifying\nAt the end an old and worn teddy bear is falling very near the viewer\u2019s body while the mother\u2019s voice is singing a lullaby.\nThe teddy bear disappears in the depth of the sea while it appears a \u201ccount down \u201cconnected with IOM displaying figures of lost people.", "short_description": "Lost Memories aims to produce a poetic and emotional immersive experience focusing the lost of migrants in the Mediterranean Sea while they attempt to reach the European shores. The lost objects loaded of memories are a metaphor of the lost lives."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.voor.io/vr/marenostrum/", "developer_terms_of_service_url": "http://www.voor.io/vr/marenostrum/", "publisher_name": "voor.io", "support_website_url": null, "website_url": "http://www.voor.io/vr/marenostrum/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "EXPLORATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "473983360981225"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162696_1854
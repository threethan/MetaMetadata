et tapaamaan Kalervon virtuaalisessa ymp\u00e4rist\u00f6ss\u00e4 ja tutustumaan Kalervon kampanjan p\u00e4\u00e4teemoihin. Ajoittain Kalervo on tavattavissa itse henkil\u00f6kohtaisesti yhdess\u00e4 muiden vieraiden kanssa virtuaalisessa ymp\u00e4rist\u00f6ss\u00e4. Virtuaalisessa ymp\u00e4rist\u00f6ss\u00e4 on yhteens\u00e4 yhdeks\u00e4n esittelytilaa ja olet tervetullut tutustumaan tilojen teemoihin ja aiheisiin.", "short_description": "Kale 2.0 esittelee tampereen tulevaisuuden uudessa valossa Kalervo Kummolan n\u00e4kemysten pohjalta."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kale2.live/privacy/", "developer_terms_of_service_url": "https://kale2.live/terms/", "publisher_name": "JR Production", "support_website_url": null, "website_url": "https://kale2.live/app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fi"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "3201402996850752"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57569471_724020694969413_3428895291988540672_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDAmgaLp7C8Q7kNvwG9CH_p&_nc_oc=AdpW3xfWUi7i6tkSmOnGUBduC__LkXabkeuGKRkHWneo0zYyPhCdbPxyteQtNJTTifE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbtwudmqeKTQ2ipETkXgOKW0sOyZAsBMHbCirEM9TMCQ&oe=6A8ED9D9"}, "is_
CukYuEbkoiLcZNQXVr194VmCW8OTQLvoplL8rJPvVPIrm1C6ryuy0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvL42WXUXe7F_OsyKB7rlCIDgleFjMZaFoMN_01BEqcA&oe=6A92BD0E"}, "display_name": "QalamMR", "keywords": ["education", "mxink", "calligraphy", "art", "drawing"], "long_description": "QalamMR is the first mixed reality Arabic calligraphy application for Meta Quest, built around the **Logitech MX Ink** stylus. The MX Ink becomes a virtual reed pen (qalam) with authentic ink behavior: pressure controls opacity and ink consumption, pen roll transitions between wide and narrow nib edges, and haptic feedback guides your strokes through carved letter grooves.\n\n## Four Modes to Explore\n\n**Learning Mode** \u2014 Step-by-step guided lessons for 20 Arabic letters. An animated reference board shows stroke order while grooved exercise paper provides haptic boundary feedback as you trace. Info videos tell the story behind each letter. A voice guide walks you through every step.\n\n**Free Practice** \u2014 Open canvas on your real desk. Write freely with pressure-sensitive ink, multiple colors, ink depletion, and paper templates. Switch to 3D Relief Mode to create raised golden calligraphy using the middle button's analog pressure, with joystick-controlled lighting to reveal sculptural depth. Enter an immersive 360\u00b0 desert camp with lantern lighting and ambient sound.\n\n**Flux Mode** \u2014 Draw calligraphy ribbons in mid-air. Control ribbon width with pressure, start a flowing animation, and sculpt the ribbon into kinetic calligraphy sculptures. Combine with 3D relief to tile raised letterforms along the ribbon surface.\n\n**Gallery of Wisdom** \u2014 An immersive 360\u00b0 exhibition of historic calligraphy masterworks with gaze-based interaction, audio guides, and detail panels.\n", "short_description": "Your desk becomes a calligraphy master's studio. QalamMR transforms the Logitech MX Ink into a traditional reed pen \u2014 with 16-bit pressure-driven ink, roll-based nib width, and haptic groove feedback that teaches through touch. Learn Arabic calligraphy stroke by stroke, write with authentic ink physics in 3D relief, sculpt kinetic calligraphy in mid-air, and explore historic masterworks inside a 600-year-old sanctuary."}]}, "developer_name": null, "developer_privacy_policy_url": "https://qalammr.com/#privacy", "developer_terms_of_service_url": "https://qalammr.com/#terms", "publisher_name": "Mehmet Akif Acar", "support_website_url": "https://qalammr.com/#support", "website_url": "https://qalammr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27225876203747291"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2235681817185040"}]}, "baseline_offer": {"id": "2235681817185040"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783788120, "status": "PUBLISHED", "id": "2235681817185040"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27811703688497870", "version": "1.2.1"}, "id": "2010651642870430", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26619612291040355", "is_c
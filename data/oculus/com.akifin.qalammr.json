hots": [{"file_name": "screenshot_1.png", "id": "2147356495833330", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593945819_2147356502499996_236825161791213049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJB6iHSHmb4Q7kNvwFRKoQg&_nc_oc=AdqQ5Yb71VazYztqMm2DUShA0yC2cm2_uei6vo3IS8yuB1t4rJQMYrwgcjd3yzk_xTo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVPYyTJ1tYk2jTCzqB4fD2DH2QVayO7siyCHlkYRjinA&oe=6A92E199"}, {"file_name": "screenshot_2.png", "id": "2050439872223866", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618509_2050439875557199_7438900765857273508_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVjHvi8TddgQ7kNvwHlULqE&_nc_oc=Adp2DUkwRu079JxIgvVU2cMy74V8FIfqVK5r56HiB5Wp4pULyAn6f9St0HSypAW06Zc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYcdrbshFiwOrcdUxRBnl7088jP5fSw8bXy7T4xvsiEA&oe=6A92C291"}, {"file_name": "screenshot_5.png", "id": "1338159470981837", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304952_1338159474315170_1392949936044769719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3OAfiE3EdsQ7kNvwFGLge7&_nc_oc=AdqwgRIrUmdNBaz2pk5rDJlCih2UCVZj-JKq6w3q9jyLsHZxy6ojYpS63r0_baC46Io&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfYFy1rrH8c7VCzfpE45xkdrwniWFEo3RV832mSqVYGw&oe=6A92C827"}, {"file_name": "new.png", "id": "1045427831384249", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312332_1045427834717582_7911202163381480737_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOhN4RLDHxYQ7kNvwGKtico&_nc_oc=AdoYuK0uGrWVU9rWQmmh8rXqkqMNZ4ekmhxOlv6tRo2cD5V840wsh8O_mBxO77Nztqk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOqlFzgsEB8QdbsMQCceeb6Ni35OTMBiVOLnwaL_oh1A&oe=6A92B815"}, {"file_name": "screen_asda.png", "id": "1526113502302391", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619185_1526113512302390_3071696187611116682_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1kvbTgIt78Q7kNvwF90xyG&_nc_oc=AdoVYU0cxfXisdvAZeQ95ixmcp5NBBybzyXAbYSbEaXkNqaeIk6l0_cKdt37X12SWP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXL9A3_GZ3sDQXNqhH5GuINJZlXGX7_ygGlgk6XeRoDg&oe=6A92AAD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_n.png", "id": "1391363973054511", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1391363976387844_7246257337794897886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEU_JbAEezkQ7kNvwHuLmvM&_nc_oc=AdqDX-4zRckg7YYIrIDoe1IEwdO10cTc-EHpFoMF7WV6bpHqXgOoe_x0fuPf62GgkXA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRBH2xkV4Fq09mk5_snHyH9gl5NVdUFoRuA7wcWRySww&oe=6A92B9F1"}, "display_name": "QalamMR", "keywords": ["calligraphy", "handwriting", "arabic", "stylus", "lettering"], "long_description": "QalamMR is the first mixed reality calligraphy application for Meta Quest, built around the **Logi MX Ink** stylus. The MX Ink becomes a virtual reed pen (qalam) with authentic ink behavior: pressure controls opacity and ink consumption, pen roll transitions between wide and narrow nib edges, and haptic feedback guides your strokes through carved letter grooves.\n\n## Four Modes to Explore\n\n**Learning Mode** \u2014 Step-by-step guided lessons for all Arabic letters. An animated reference board shows stroke order while grooved exercise paper provides haptic boundary feedback as you trace. Info videos tell the story behind each letter. A voice guide walks you through every step.\n\n**Free Practice** \u2014 Open canvas on your real desk. Write freely with pressure-sensitive ink, multiple colors, ink depletion, and paper templates. Switch to 3D Relief Mode to create raised golden calligraphy using the middle button's analog pressure, with joystick-controlled lighting to reveal sculptural depth. Enter an immersive 360\u00b0 desert camp with lantern lighting and ambient sound.\n\n**Flux Mode** \u2014 Draw calligraphy ribbons in mid-air. Control ribbon width with pressure, start a flowing animation, and sculpt the ribbon into kinetic calligraphy sculptures.\n\n**Gallery of Wisdom** \u2014 An immersive 360\u00b0 exhibition of historic calligraphy masterworks with gaze-based interaction, audio guides, and detail panels.\n", "short_description": "Your desk becomes a calligraphy master's studio. QalamMR transforms the Logi MX Ink into a traditional reed pen \u2014 with 16-bit pressure-driven ink, roll-based nib width, and haptic groove feedback that teaches through touch. Learn Arabic calligraphy stroke by stroke, write with authentic ink physics in 3D relief, sculpt kinetic calligraphy in mid-air, and explore historic masterworks inside a 600-year-old sanctuary."}]}, "developer_name": null, "developer_privacy_policy_url": "https://qalammr.com/#privacy", "developer_terms_of_service_url": "https://qalammr.com/#terms", "publisher_name": "Mehmet Akif Acar", "support_website_url": "https://qalammr.com/#support", "website_url": "https://qalammr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27812068688461370"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824741_1545814600426100_6473112340309252757_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUhbXbSG1tcQ7kNvwEFib4o&_nc_oc=AdqDhey36E3R8xnyW
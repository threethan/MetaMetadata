_name": "new.png", "id": "1045427831384249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312332_1045427834717582_7911202163381480737_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lT_WAC8JCYQ7kNvwHit8TQ&_nc_oc=AdrP3a2iE1VWsvYOiRwGx3DrMPgzFj3o4vl_PlpdHuXujmHFFo75a_ZvZQV8NT5KrkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiKXexxk8XN_GBQPUkHoLZuTLasRz7iEKSHiEh61pG4Q&oe=6AAFF155"}, {"file_name": "screen_asda.png", "id": "1526113502302391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619185_1526113512302390_3071696187611116682_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VazqoxmXiJYQ7kNvwHs55bE&_nc_oc=AdqTPMzzZLvJQ2dZNQ-XNhlZ204JHb5IyLSZGy6J7kEu4180yZu5JMiXXupgmWrikfA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwWGSlhd1matGIsnnHRfqzkHY72sRzqfIZKvBZ6nj4yw&oe=6AAFE417"}, {"file_name": "screenshot_2.png", "id": "2050439872223866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618509_2050439875557199_7438900765857273508_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQc64O0xv3QQ7kNvwGnkRG1&_nc_oc=Ado4otALxgAE8hHjkTrjjVriQEoZQlr9AJXlvxWnz50FqaJtRKA3aMs4dk2IxxyKG3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxjwIeiZ5BsdOQt09PMKMKRRv1pb67ZIgqj6U84jGEjA&oe=6AAFFBD1"}, {"file_name": "screenshot_1.png", "id": "2147356495833330", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593945819_2147356502499996_236825161791213049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFV2FTdNd4kQ7kNvwEI585G&_nc_oc=Adqo6bw-lTsTUfEqvsVFmHMAaEM1OYYIKJWdxk3_n8V7gQwzJS5eka6aMHjE9AkOlkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTwNaBa-At8pKG6FjsH41yWQL_LjpakP_C3krLhHGyvw&oe=6AAFE299"}, {"file_name": "screenshot_5.png", "id": "1338159470981837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304952_1338159474315170_1392949936044769719_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fWMDAEo9QQQ7kNvwFeju4v&_nc_oc=AdpJ-2ap1BYBMgDWLCRWuE2WX5Ti25Ap0Z31jkIdunXikSsvAFeJGYGfSzoqTPL6_-U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE98ozVwxOm60P0pxQCOgTKEfsVZiZ4YxMZUI4EiaLqQ&oe=6AB00167"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape_n.png", "id": "1391363973054511", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1391363976387844_7246257337794897886_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klEjjUawBFsQ7kNvwGHiddM&_nc_oc=Ado812QIA8pfW7zeER5WYzNBXKMvN910pYI4KJ138Fy6ADPQiylIJy-L2XJcRZe0ufE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7o0Fvy_it2v2VNQngwCX-alQ7ZZq-jY4XRywKltRbaw&oe=6AAFF331"}, "display_name": "QalamMR", "keywords": ["stylus", "drawing", "calligraphy", "creative", "meditation"], "long_description": "## A Mindful Calligraphy Experience\n\nThe world is loud. QalamMR is where it goes quiet.\n\nQalamMR brings Arabic calligraphy, mindfulness, and creative learning together in mixed reality for Meta Quest. With MX Ink in hand, your desk becomes a peaceful art studio where deliberate movement, focused attention, and repetition create a meditative rhythm. No experience needed.\n\n## Four Ways to Enter Flow\n\n**Learning Mode** \u2014 Learn 20 foundational Arabic letter forms with animated stroke guidance, carved exercise paper, and haptic feedback you can feel.\n\n**Free Practice** \u2014 Choose paper templates and colors, write with pressure-sensitive ink, create raised golden art in 3D Relief Mode, or enter an immersive desert sanctuary with lantern light, ambient wind, and music.\n\n**Flux Mode** \u2014 Lift your calligraphy from the page. Draw a path through the air, turn your writing into a flowing ribbon, and sculpt it with the pen as the world fades and sound carries you deeper into creative flow.\n\n**Gallery of Wisdom** \u2014 Explore historic calligraphies inside a 360\u00b0 sanctuary through artwork, stories, video, and audio guidance.\n\nMX Ink becomes your virtual reed pen: shape ink with pressure, turn it for broad or delicate strokes, and feel carved letter paths beneath your hand.\n\n**MX Ink is required for writing experiences.**", "short_description": "The world is loud. QalamMR is where it goes quiet. Discover an active form of meditation through Arabic calligraphy\u2014shape pressure-sensitive ink, feel haptic guidance, and learn 20 foundational letter forms. In Flux Mode, lift your creation from the page and sculpt it into a flowing ribbon in the air. Explore historic calligraphy in a 360\u00b0 sanctuary gallery. No experience needed. Writing requires Logi MX Ink\u2014the pen that takes you there."}]}, "developer_name": null, "developer_privacy_policy_url": "https://qalammr.com/#privacy", "developer_terms_of_service_url": "https://qalammr.com/#terms", "publisher_name": "Mehmet Akif Acar", "support_website_url": "https://qalammr.com/#support", "website_url": "https://qalammr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28176799048654997"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312263_1099148415953928_2860639130978144383_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pn0ViJZJzysQ7kNvwEbq8xp&_nc_oc=AdpMuNsFBjP1vYLTOwmBW1QfsNTFF9ysFuvjF1OAzc6Afu7CLX_sWBwZaNkA0gsaR5I&_nc_zt=3&_nc_ht=scontent-ord5-1.
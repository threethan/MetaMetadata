_Tzp1hBJqKreYXLO-_u7EwPYvhcj9Ob_044KWKQXrjXOLd6ws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvELd-o37dBbdalYrkJ8Z0a7tAXiXuD-zGxkEaJc50gQ&oe=6AB7C888"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WretchedCoverLandscape.png", "id": "1173636774038352", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001732_1173636777371685_7578872859972632507_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOZIMpBMqeIQ7kNvwEnkOf_&_nc_oc=AdrksO731W3s0vBu0V5f0S1r_9l6EmAwOFjva5OPhZmpzFJiibJzRqfHj0Fm3rcD7_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-b_nVKIyU1AZnoxxYperjm7bmfMq3fagcFRfMc0xsxQ&oe=6AB7E7D5"}, "display_name": "Wretched", "keywords": [], "long_description": "Get the first version of this Horror Game. Immerse yourself in the chilling depths of Wretched, a virtual reality game that combines the intense suspense of horror with the action-packed thrill of a shooter. As you step into the twisted realm of this blood-soaked, shattered hospital, you find yourself confined to a platform, unable to escape the encroaching nightmare. Armed with a trusty flashlight and a pistol, it's up to you to survive.", "short_description": "Step into the heart-pounding darkness, survive relentless waves of nightmarish creatures in the blood-soaked halls of a shattered hospital and its depths."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NomadMonkey", "support_website_url": null, "website_url": "https://www.nomadmonkey.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "rec
 horror with the action-packed thrill of a shooter. As you step into the twisted realm of this blood-soaked, shattered hospital, you find yourself confined to a platform, unable to escape the encroaching nightmare. Armed with a trusty flashlight and a pistol, it's up to you to survive.", "short_description": "Step into the heart-pounding darkness, and survive relentless waves of nightmarish creatures in the blood-soaked halls of a shattered hospital and its depths."}]}, "developer_name": "Nomad Monkey Yaz\u0131l\u0131m Oyun Ticaret A. \u015e.", "developer_privacy_policy_url": "https://nomadmonkey.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nomad Monkey Yaz\u0131l\u0131m Oyun Ticaret A. \u015e.", "support_website_url": null, "website_url": "https://nomadmonkey.xyz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33324047600575436"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031649_595250439397725_5134643171956989427_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZTGrvy4irYQ7kNvwFJKcci&_nc_oc=AdoogQrSvEnNgDGyA5TAIAxHXqbKjjMK2jesSboCNoSq7j8plD2Tdhwrkdgp3xPkOi4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAOz-1ihmk99mD8hnu_8jKMcj1FJYZJktk71gfqdVmN
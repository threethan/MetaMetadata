485_1597239620884496384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_TyrBvjR_YQ7kNvwEJhl69&_nc_oc=AdqYyKIeUvgr6t5EN6Xuy2ZuaA_ipz2IRZOaNUYGKnPUqTHp1ySX1P2VjuqF7a79G7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIwFONxwf0GyLRIBc1asXXUOer9jBATgXnMmRj3En-RQ&oe=6AF5F4C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere Toon - VR Comic", "keywords": ["Comic", "SphereToon", "\uc2a4\ud53c\uc5b4\ud230", "\ub9cc\ud654", "\uc6f9\ud230"], "long_description": "Spheretoon is a VR comic platform.\nNow enjoy reading comics in virtual reality.\nDive into a variety of well-made VR comics to amuse yourself - you won't be disappointed!\n\n* If you choose Korean in the language settings within the app, you can see more comics.\n\n[Comics list]\nSUPERNATURAL GIRL | HORANG\nOK-SU STATION GHOST | HORANG\nBUNKER MAN PART1 | Seongdae Oh\nBUNKER MAN PART2 | Seongdae Oh\nSAMPLE | SINI&HYUNO\nBONGCHEON-DONG GHOST | HORANG\nM\nGHOST IN MASUNG TUNNEL | HORANG", "short_description": "The Best VR Comic App"}, {"images": {"nodes": []}, "id": "235578827579559", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sphere Toon - VR\u6f2b\u753b", "keywords": ["\u6f2b\u753b", "Manga"], "long_description": "VR\u3067\u6f2b\u753b\u3092\u8aad\u3081\u308b\u306e\u3063\u3066\u77e5\u3063\u3066\u3044\u307e\u3059\u304b\uff1f\n\u6f2b\u753b\u306e\u4e2d\u306e\u4e16\u754c\u3092360\u5ea6\u3067\u4f53\u9a13\u51fa\u6765\u3066\n\u7acb\u4f53\u7684\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u3042\u306a\u305f\u3092\u304a\u5f85\u3061\u3057\u3066\u3044\u307e\u3059\uff01\n\u65b0\u3057\u3044VR\u6f2b\u753b\u30fb\u30b9\u30d4\u30a2TOON\u3092\u4f53\u9a13\u3057\u3066\u307f\u3066\u306f\u3044\u304b\u304b\u3067\u3057\u3087\u3046\u304b\uff1f\n\n*\u30a2\u30d7\u30ea\u5185\u8a00\u8a9e\u8a2d\u5b9a\u3067Korean\u3092\u9078\u629e\u3059\u308b\u3068,\u3055\u3089\u306b\u591a\u304f\u306e\u30b3\u30df\u30c3\u30af\u30b9\u304c\u
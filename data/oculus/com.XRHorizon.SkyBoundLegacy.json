t-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gp-HOQPEU6ggIvW7v22LbxNILRicndgNFk6k9_vbzrQ&oe=6A11A6F1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESQSoxDRZ-AQ7kNvwEuwVoi&_nc_oc=AdoXXcJNNm-lU_UBoTIUG9MUCeDd3vkc8orS-vlNBAW5IBllDwYLzHrKgWDl57QeWNs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NCO-s2xf3W0__5ozxde41_Ym1Hc0N3M8x8dgCoKwasQ&oe=6A119917"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyFqxwlu_GAQ7kNvwEeXeVj&_nc_oc=AdoloTRlfhmDaKZQUqMrkrwR0gSxF5noq7qtgJfWUY-IlKV3EDvnvmBo5a-LT3ZMuZE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wWgOz3S4k5kZTTNXheRykfB0p0TqOzm5sVbQpaG8NaQ&oe=6A11B260"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZE9gR3Tc3MQ7kNvwGhXRQu&_nc_oc=AdqK88UKs79CUaxyEW1fRyJBTs0xMRQ4V55--m2k4N1cFpzsAjzb3MfYaG9zYB2Ppps&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d46SWbx14_tB9-4DvWfmVUZ22WiUo15U-qWz1itEumA&oe=6A11BDDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33dgZMqBd90Q7kNvwGL02Kv&_nc_oc=AdoSCjgptpcLP_FeCZQ8LTjVWA02xuBAzi9MAklq3-y5Lpp39wZiiXkyKuX9g3O4iZA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fhAFG_ddJdSC2fhs1osKK2AcXjVqNuyYK1ZzO3GzRQw&oe=6A1198D1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_8
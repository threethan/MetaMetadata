.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7nmiU-IbVcKyaDFRWQ-uzARy7sUar7ur1pKerVhuCww&oe=69CD18F1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk4CQw9C9mgQ7kNvwF5jasm&_nc_oc=AdqcXqmJlaK0UPaZqSR2JRwNR3yOe03qapwNYACtb7QqY20SfdvCYr3T37w7AS_AxiI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7gwgmdVhrbA6YZM5zI-gI5l3z2bR7d4pvdSQ3Qeti8w&oe=69CD0B17"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxUJPo_AXakQ7kNvwGG47Y4&_nc_oc=AdoD-S4LmKV4zFrfdR6B1I7qF12U9PYMVK7VLsSfFGXt_y_2vsQ5xwPl3smagR4-cZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9Dnxy4pEfmtcV9pe5c30GdnmbQ-lA0WyoUbUzb4NcAg&oe=69CD2460"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tevgnaDM1DAQ7kNvwEoEiel&_nc_oc=Adrx0z-lP1jDuoCa0-2cw80FvZ3NAvQ4Ouiw59cfzmxnlj9ltUl-0VleM7bBEmaf0kQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzP3f2GfLzaX7zGm_6bIEAfb8FuH75XmvIG7MZVZP_cFg&oe=69CD2FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxQ7bbABKeYQ7kNvwFUbe7J&_nc_oc=AdpeyFlj7S42GaU91BSRtKHIG4snPcFAnEMftDjLmn8MylvP_HJeuq-alWwsbSvdpw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhjLDyXvsc7RkEYTGqpwCxFdHBU7QMvBp12EAp76OFgg&oe=69CD0AD1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u3YiojwY9rTS7lg1R6UC2jprK2WSbHMsKZvAjXseNCA&oe=6A159B71"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hiYC9PiqykQ7kNvwHv1zr7&_nc_oc=AdpoaS-1g1AeDK1rdDrKEGfH6cdFAXo_uV23v0vLDOgIjMD0qfi75bZ2QdrmpIObq8s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kStTZ8U4TMJrSmXQ0LePlyFMoDAIx7fhk8FRxdnAGFQ&oe=6A15C5D7"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnTSbUPVYYkQ7kNvwGoGBE3&_nc_oc=Adq0dndkSmLoBtO5creE8ArXid7j3CeFO68riDkkXN8MMtznKQ798JnTbkBw0mLvBxc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jorXUpDiT97fIXTTeuUm-BmBjKMe4bUHhF2ccYbChfA&oe=6A15A6E0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0kwP3F-yGAQ7kNvwH-b6MB&_nc_oc=Adq8P5iBAej-sW2gscL9Q-aRwRW91icZnOy4n4AvMsddzzt_-BKqY1_MMWEPAX8shQI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YxX4qa6SWFElbJXIHXUDa-xX5CGhAvbr73F1bu32PNA&oe=6A15B25B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMjFLW_CDnIQ7kNvwHVbRmZ&_nc_oc=AdpiJYUrtae3CmU8NnBjcNExJAsDag3wgJzANr2WF2J9CvtQzObtIkt-KPA0lynoJoY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A-xOrkOYpi0nQvuGahg5tFqgo4dHI-Az0ptiU_Lkciw&oe=6A15C591"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
_sid=6e7a0a&_nc_ohc=QvIvhQUYv2kQ7kNvwFiWxf-&_nc_oc=AdoKFz4lZx_UaAdegh2nEM73m4i-Za_QLJqkKUW-DUEkKoQeyTyOwxsm6_loxv62kVM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xlZWPd2E-MlUwqkvtsW5k_BSL3Yybo6afnkvAFiPybg&oe=6A2C1BDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u4nvpRkQUoQ7kNvwE6nSQy&_nc_oc=Adp-suLvQ2SjP3OS2AGVVGaxEXpABncJmaWJFYsHHir1y0RBxXUgcMbVdyezhnLd8ug&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Vcsu-MUyyJ7I5nHKstzbeKcyZjfEKNmYJfVu7pI1r7A&oe=6A2C2F11"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "ht
.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwMqtFb2vox5W8PWwxkQjnXNF-05qm2PKJ5Wh7VLgAJ_w&oe=69C68171"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJw_bPt2aucQ7kNvwEut3Ur&_nc_oc=Ado9OF5HWN2-C0s3R-_9nWujzpqLDSupqIklS6iU6GTlJyCZaS0nckf-16fZZAuvOn4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD7tKDoUxG1SkpUhPJbkLlJmhdaTk6d0KZ0RdkBtqWUw&oe=69C67397"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd4-2wUDHZoQ7kNvwF25cDs&_nc_oc=Adqiz5rQ5xENH1YCPba_3s3wDErJ0p9NBR0FV5UQr-dbTJzM5qKBYCpuEKPLQa9aExA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3Ik-WrrUQJWmoR2ca4EIsoQCUr6qX2QjWI2TYrx6lBw&oe=69C68CE0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbVQJCODhcMQ7kNvwFub1WG&_nc_oc=AdrOQ16erie193HrCuPeEQF-_K4GDU84_ux73cf1amm5NFKrHOSgkc7ONownVAjukZ4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVF5XBZV2yfEgRmAmiroqW0NVaT24NJQDOO79g1uvvmQ&oe=69C6985B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlLhWNVWcUAQ7kNvwEFNWqv&_nc_oc=Adqh4eVXzZAGJ8QxeYMQLGMNBepV3jcXt4YG4jRk8s2hHjjll45ZViwnSj4TLtHjq4w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYIjULKU0iL6UOUqMM4e_f0KLCGfLC4ZgSsyc7IXXwOA&oe=69C67351"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
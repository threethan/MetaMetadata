.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28Xbz_1dOsN5JN4aFfNxEdCPCu2vM2pZhrv9fq75mM7Q&oe=69D8F671"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfkSH6ja6_kQ7kNvwFooYgJ&_nc_oc=AdpntO5YSAZPOS9CbdqK96Vs9ZyBpzg_eTa-sT6lheg6Y1H-SH1R10kJSqNHgET5U7k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sugUutPOUXdkGnPbtEQ5eMwkK7QWZehzAqZLdA6dqEw&oe=69D8E897"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZygrkrcZRSYQ7kNvwEm0Qiv&_nc_oc=AdoRrCyBYB8nOkJ2n2uCNGM4wBZvR_D96wryVQOxLx4iN1apv8zwFbWhpf0IPJzszqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05ZhfkkrU-g__ODjQU0Ug-TWPs4zpfde64Y_XW-qVINw&oe=69D901E0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vi1yHATG0BoQ7kNvwFCtMYo&_nc_oc=Ado4QPGxhTsQ_D0zICU6Sm2_lAej5merwd_b078ijoTEqvPW1AsxrTwjJmL_CqLLNHY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tVasF6Dkp9H4P93DVqPE67M8xK-cHQhI_607MfIypgg&oe=69D90D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOGzaAF8O6IQ7kNvwE9x_Tq&_nc_oc=AdpVULuT2MIVe4MbwWBEPBGal1IxcsYF64nlRVMvLu9qoFkraiF6chfLgW72ver_eso&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HbJQRcZ-xU8KtEu6lSHXV4rdHfE-wz79GaUqikLHMjw&oe=69D8E851"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
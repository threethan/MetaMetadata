nX-PYSMQ7kNvwGaMlDu&_nc_oc=Adqv2A7Q9jKD1Lxa8Ewpxogv6NzU_B2MGuChZTiHPvWKewXry8favcH_qKDv6Z-ot64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcbOFmNkVJSYJSpK7VHXDaA1t5MZ-R4LmRrifBMERGzg&oe=6A8307F1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nbzEX2dhUAQ7kNvwE-1iIl&_nc_oc=AdqNBEGk3BlGN1qevcgFNuapkIpiQV_jtZCoF8-3zrNMlN7NFMscYji8v-63xl1pTrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtBJAK3KcC5oRG7m6ZBemzimngIZfxr4CbkMAS-x7MOw&oe=6A82FA17"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGypywPPYHQQ7kNvwFdNOkL&_nc_oc=Adr1P5ei0zygd6_ps47Kjz95Idehgrc5rCrKUPAkYZK21neHQx_7ta7V5Ervjyqjv7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF28d8OaxmLhxcI7vnpVM85FuCAuyNiQoTW13-83bcxAQ&oe=6A831360"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuB4qHwrr-0Q7kNvwHAE7a5&_nc_oc=AdqtKhuynOz-rqM6UcG7zQgyHBhAoCWBibNTHiANUHB6dm-gK-pu6byYZ9tGOJCfTHY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvqxMtEfIgAYg_LX74GYMlOFQl_afzOaGebphoSYoeYQ&oe=6A82E69B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GW85K6k1bOwQ7kNvwF7bifj&_nc_oc=AdpaigHfD1vxiHOafieuNVXAQH0z_lXTI1glsguAwtfDXj4b5VaZvZ4MM-w3Yih3x-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeIXaFri4_bStojdMNCyTnzxrZJoVo0SGLZnsyytqr5A&oe=6A82F9D1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}
cqyIbwwQ7kNvwEdraXf&_nc_oc=Adotc6q_stzKJONMlALNa5nerbssVdJmHoS_OZu0AxBAWb4LCQ5fDWCXbPhXS58eUV8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vU60tykFEHCo3U2l-3xBrbqSHPH8JbbZBMCIATiNF0g&oe=6A411CF1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2HPiV4WJJgQ7kNvwFlS2gj&_nc_oc=Adr6H47Mdd_QjTz8kquyIcGQgSdGKXyyHiHBfdZu6RbrkG2_KVxhPjGWtgVuEcGM0rg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zdXDWYN57iMz1jM6LzS4XAVvLnSziiL5Dco3JYTw0jw&oe=6A410F17"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=celkeJU1EioQ7kNvwHU4p21&_nc_oc=AdovdhUZykqBxCsnKdsLsaj61HkCNAEAdbg_7N9K353WL349J2cyZW5waBXPwwRBufw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RCUJidn2vzq7Wyds-E4S7dQPycvjHwmUzcPvbkvjNWg&oe=6A412860"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWV9Sm3HCh8Q7kNvwHQPeVo&_nc_oc=Adph4Ysyae5V_2mG5ediqAZJW3lIAcobdMyNanJXv7ztfXHyto2FqZOjurfpZv3d4P4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ATWkfCh0W6W_ikr7H7fcSlBEFOmHYgCD4bY1DH6Dt-g&oe=6A4133DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55Scnx7L3LIQ7kNvwES6Xxv&_nc_oc=AdoY3QgCVJkYEiV8p4-L37mbJnmMVxWcbiCzpoEqL8wj79Ym6CHjcz7nDkFnojmSN9M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7Qip5U8-hRHirjxvTJYUmYlD8LvHP0F8BUZkLIUaIqg&oe=6A410ED1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}
cqyIbwwQ7kNvwEnteiW&_nc_oc=AdoyU-NLT-HVQPUcOB4nHHOXhSLY5PLszpfkh8spXUhlTccOa5qF60pzg9TfuM6aC74&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kGHIFPA7pa8NabccbOzqMFot9kSX-mhFBUreWbDBBzQ&oe=6A43BFF1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UckO-NM3RogQ7kNvwHdw6d1&_nc_oc=Ado5vvTzhkIJ9ulg6zt03IfKKG7Z2v_h81XDzZXufqteD1_085sMfSF1jWUgydZbEgo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qC82HtuJUlAyVB4wVJPrsD2bZj5S2qIqxAzKIcoCL-g&oe=6A43EA57"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=celkeJU1EioQ7kNvwHiUuMk&_nc_oc=Adoaal9n3auzjBs9ZkL5uaR_5tmY6bHPzTTvGtN5k3K8bGArvKyiKeFxdeaFsF5RLhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8_r0JJ3EtylD4RMdNI7uVXgphRc_oBE8bqp7BaSSzuQ&oe=6A43CB60"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwfT4eDVlZwQ7kNvwGLDTBX&_nc_oc=AdrQmYaIJr0-Jdc_LHLeqWlRkzbLgWrILZoP9wIaVMMmTrvlNOkX7i63wvtm8RU_uhI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GdC2YwZEmwqM8APXaqcpBOBJ-lAv-f1yuFfoi6z284Q&oe=6A43D6DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcAKi3E44gUQ7kNvwFdU9rf&_nc_oc=AdoUX3p1zPgBPeO0pcg_vzr93ULTagTTd4MUGjFmqFo5F-49MAV6ASxEvNR4Asw7OtI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6SzfKJDvuEsBB_hPSCUl8O9xi04OuYX7GSM5GQuoe1g&oe=6A43EA11"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}
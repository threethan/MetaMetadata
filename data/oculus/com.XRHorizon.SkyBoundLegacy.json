y_kG1gwQ7kNvwG5KoPm&_nc_oc=AdrMxlh0Dg7v0FIJ8V_3dpiCY9Tfq3kzxF7-yJygAtm0NpyQFfXuWG6lD123B3aqLwc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCZ3w8bdlq797nkApf1hDQ21oY-f4eEydCQXHIaI7LXg&oe=6A7335F1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU1a2hA-AOAQ7kNvwEBXclG&_nc_oc=AdpKUabZdgAAgA8DGRRJEWKphlZf9e6JOTWsA9IozfyfFv8tu_js43VV_mrxFuhfJWQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz9phY61fZxNqaQTpesc5EaCtuISBnvPuI0Fk6OkeAHQ&oe=6A732817"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDqAKp5lNT8Q7kNvwE00rtD&_nc_oc=AdoTjfqCtWNP8MgpIu4GwXn6V-O-osX-SSsOI0pdG2yAu2ArQ7nsOfz9ADKuEH47FV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdDz4HA8ER4wpFQ2rTLiR1zF5c0UlgaDtq4Zeyc2RGhQ&oe=6A734160"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=El2tcSE1Il4Q7kNvwEYRmDq&_nc_oc=Adobt488YNtDpvNanolLC9j4fyPozZp0iGvqerAuBbHzStmkCoGF0427HUMEjUxVNeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH60W-TERxpdEg5fTmJ9_vPcEWo4GLwbjLKAUx66ccb9g&oe=6A734CDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOzoL1JYyeAQ7kNvwG99x8K&_nc_oc=AdpA-dNwb1ZQJ2EHJinXCb38OEOiBTEeilvMCj43YOVhIULpP1cpXs_6VIFn_BGFZ88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5dGJpslASoqPi1KMuDXfVudy5IhYkTWIiJClVnxrGDQ&oe=6A7327D1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}
.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hxco3a_1-oY-F66rGy4HzU5rxMr86UMnVdD1WY3b-xg&oe=6A086C71"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kz7IvQwpf9AQ7kNvwEHYqkW&_nc_oc=Adpnauk7nKIsIZdPWYHuO1R4A0nBIgVSwMtvZlpCFVEGWLexjk3oUeR02yOUYIO4G2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wzo1DIKGyrV_ktLyVXX4VQ2Jf7LvuZwufLdGrBZlClA&oe=6A085E97"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq2Zxqyk-igQ7kNvwGWsIL9&_nc_oc=AdpfaQW-thF6Azvn7pWR8RIyV9fz8cGbDRyJvY10CogWpIWOl1dWJ-pXscb6ckoSluY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P6VyhKzreB3eotzPA2rVtOM255klnxqUG_M0a_58m6g&oe=6A0877E0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OzPvMbkkOh4Q7kNvwEQF-q1&_nc_oc=Adoq7Ozmhxc3Z8niUn_tSuCTPnT_VR37EDl5GZ_D-kuiLjKtgXLpqQ0Yn-5mSQ74FFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WwA8EpGKWit3NqCYAEpc_WgZUbuNvrzC6Kkxyt3Kslw&oe=6A08835B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQOS9D4RGGEQ7kNvwFArTk_&_nc_oc=Adpl08w-weezP9qLrfmJGcXH2NlGjTaoBZlYdFm6s1n4hgCQtfy8knj7n4M01ijVUqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zAX78P3C1y4F731k68shsPzGV_IDIkwwD1TK_Rc7g-Q&oe=6A085E51"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
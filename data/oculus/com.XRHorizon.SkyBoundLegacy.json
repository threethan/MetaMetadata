3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO9UbsjkP379bH_X1Gkr1DvMMAZoLXQ-b8wM37MQBdvw&oe=69C7B19B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlLhWNVWcUAQ7kNvwGYBXLg&_nc_oc=AdrBqHmFtKKHg3cjQNDfELPTjAg6Nzc7yWQcKHnyGZvwqfehIR2RhUGhZY1pXSN0i0o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwB0Ke61_xuHVaYW37q9lyt_4MtSoJuB4b6id_vMoaCYQ&oe=69C7C4D1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id"
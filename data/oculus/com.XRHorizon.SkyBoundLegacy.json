.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zE1_POErV2N7O45gYnB1y5RMr__U9gmVR3XtsFdoY_w&oe=6A05C971"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L735q8SCJYQ7kNvwE3zEc2&_nc_oc=AdqsnSKyygVc9eSbmfAcejGfTVBgYouBACCaFcBD7jYUkYuFBJ-vyltGFZQ_TweLCcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6G9nPU-BjF6ezjbQC-zsfgOp1_iEbmNG83CsZVc9jZ9g&oe=6A05BB97"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq2Zxqyk-igQ7kNvwE4_NOU&_nc_oc=Adp2ecM5vS5wnAfHLOj3m0Fk0J5t-U-a_DgJPgPwLCnR76v3mhf8PJK5-wA_orHi-QM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K0DFBY29sazT2m75ibHB4XrTn53beUhr4CXQxjHmPHg&oe=6A05D4E0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNx9aEw1SooQ7kNvwGhU5h7&_nc_oc=AdrBLWmgJ5le-ssizjdAWQfN0nQPdvWUT0tkGD3dr2HZIpMVcvt_XGqEgFYOXH1xJbE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_LH7cggMsl2hw04CVSA_w1z96yziPBNsLsScbOk_TqQ&oe=6A05E05B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhEd0eDZFw0Q7kNvwGQZr5P&_nc_oc=AdqocZSa3nyhOzdOe2vuHSZ5I_IXz9f_w2CTtL5EJe8GiEhip4y3xcvqtu4aXKdOTW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nZndDXbgEGos4wMexpql3FRGUMMxim_mXLW-B5M0mhw&oe=6A05BB51"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
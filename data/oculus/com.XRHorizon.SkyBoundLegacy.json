.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QP1AN14ugB8poFdo6RHPpSDAO0G5X9tNnO8GnS3j63w&oe=69EA19F1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFzzGiT2OocQ7kNvwGjpmSD&_nc_oc=Adpm7hcMOIc8BTQioOUpCvIrMMRO6StmqOmPDZOYCvI5J6yjZbPiLy93DV-VPHo-o8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39tWlmvB_MicPXLwuCZIGIrZF5sxUECfnSiSWlKB9vnA&oe=69EA0C17"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBNmpZTWwbYQ7kNvwEEAo0G&_nc_oc=AdqNoOkCIUuPRJ5o0Ij8E3nbQ03VurtUUIuVxCQMB4CSx9CVeE8rmyZz6PqaSEPNyjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N4i8PA0nW2ma23fQWQOn0BG91iq5qZfFnTTyyfmj3YA&oe=69EA2560"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpF-S7kDRD4Q7kNvwGg_OaY&_nc_oc=AdqoYbwLoSGoZcW6n7cxLVUPYFgxYd8K9GMdV0jlJsKy7zJJpCm-Miswi_IY8rENSL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GrXbIiIR4AC2hPl3H11Z1ON4MI6c7eQvEHhpVzZrNAQ&oe=69EA30DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2LuM8VYTwwQ7kNvwGe6kws&_nc_oc=AdpfBOGN7Gepk6FKpIM4sFLxjE4TYHUCXf2XPv8_sOrCjrTEXo6amggmzs4ewi0E2ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wz2LNbrzcoBaLdNpptzydwiQR4LhJJ_ZwTyY3wpCL5g&oe=69EA0BD1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34IaqcZYZ2wrajip0sFTMVtgwy0IQw7xvETa56w4OK6w&oe=69E8C871"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFzzGiT2OocQ7kNvwFJW9I6&_nc_oc=AdrtVIznn-HcJc77egDvju_sB7G5W7z2eoX8C_Ehi_I2ZSFOdAp8C9i03Szz2ISacPg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MN5h_OJeubtvRhBrofsdx7WLPPrO5KO_xpePqJlmKcw&oe=69E8BA97"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSQgW-SiZRcQ7kNvwFeQW2P&_nc_oc=AdrUQLDx4FN7ft-koewif3Ko9LwqqqoVpVT4yl-gPCRZuhdn1GkhBdWiimTcFoYzLC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YqPDyNM80-q0wAYSgw_gt_4LThVCIqZQIQMUr8O3i1g&oe=69E8D3E0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpF-S7kDRD4Q7kNvwH3IO8Q&_nc_oc=AdpMsm5BpDcXNbrpft8r8IY_wrYEbtRrNozBa9MdveaMLr8wdMNZWNIB09XleAT5iXg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O52TkdiqGF_vyrU2GgFLQ3uoJjubNnTZ82yTDWfEp9A&oe=69E8DF5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2LuM8VYTwwQ7kNvwGJcsjl&_nc_oc=AdpC5tn-xRhkyl0cfEO2a5z60raeWproBhRoS5CujwsBnhE3PGfLMf74l_S-xQoY5GY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bQFzZlVVzjoXlMI5GkIYo0jryRxH1A5C6dKjzjqr6Ig&oe=69E8BA51"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
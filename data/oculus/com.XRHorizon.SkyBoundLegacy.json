.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QrsH3W5E6kylfVMxCj-qHLyWfGy9HCTmeon80JSzTqg&oe=69F4A5F1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC_J_UfWC9kQ7kNvwFUyhc-&_nc_oc=AdpY4k-KYiVsUaqd1QqPFFcHGjI2b3uP15a3wsXcZLmnPgW4HPFmk9amqLMyG88AoHE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gAEi-0bbN4YAkCk_5L1PvAF-_5AP7PNO4fLzGgFTN5A&oe=69F49817"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6FjQvIi2dMQ7kNvwEPYVHR&_nc_oc=Ado1148fgeqhbpeZ046euADqYwutPZpey4LGkK_OCj_SWrUQpht42qeQFW3bZ2YFhg8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2r5huf9PLMZGmp0s4SGIcprYL1fnmwAy0maR2XVNLxjg&oe=69F4B160"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eM7zAIWcfEUQ7kNvwGjQDHE&_nc_oc=AdpT_lujMdaJoj_9udWQ0fIJlW9qUk7OOVZxWJkhdFrng4k0MtcO2daYiN4m7nGi7n4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09aFVYcaVj5CLBTIBFm9awdlhnPJQD1lQ7jCV3FG8LHQ&oe=69F4BCDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpTLPu4525kQ7kNvwFrbVwQ&_nc_oc=AdrCekqgaikutEdJKPZqJ3IIUSXcsNgrPx-j41l9drOh00cvUDyzwpC_F4bML08v6Fo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1iQGEkOpUfFbpWv0wsxaP_3Eu35vdMJeE_VgwrMfBKsQ&oe=69F497D1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
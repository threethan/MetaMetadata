_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpG7a8tiBCcQ7kNvwGNJfYg&_nc_oc=AdoEMs7Kt1ZA2EReoHIsqJn7-ddxxe9pT0zyzsTom-b_Vjc60Etv3q5FmtLqKkSUjLs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bKv2-eOffzU5JEm8Sm6P3lms5tNEVUw_3TroSfuHaeg&oe=6A394ADB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbfVND2l4NMQ7kNvwEE9usP&_nc_oc=AdpoE3v1513o78vNx4_sf9IY7OgMxKgoH5siCzxunmkQNafczjEJH79ZgT5GuB5jZJQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0akEK78JrTRSC9ShAMKhy1jtcRakrWxw8XrUip1YI0Q&oe=6A395E11"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": nu
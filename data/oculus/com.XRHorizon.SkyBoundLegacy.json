.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ao-_7c7aanz9Uu6Qpck2IyzDFUpITKhGwnVXBYz8v1w&oe=69E230F1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DET6PvodXeEQ7kNvwEERCgr&_nc_oc=Adp8VF-Nja4lE_SaSVvbAaotRtxsjy2jVgP0M24J0js_-AF6arSXi-GIo2iki0FbBfY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_uLgyP5WRqrp-_MKdlroVVG2YcM0X4lxs-STchstQOA&oe=69E22317"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piF2hVBRF34Q7kNvwGb6oW_&_nc_oc=Ados784muS0JD8hR4mYl3tHXVQQDlAs6YCKDt4PFpGBKKjfGlr7eJTA4sJZV7Q3-7_o&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38TdAkpmB2GcOPri750UaYQqkhNVMgXBmhJNTCHvh5Dg&oe=69E23C60"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAGWlOfDTRMQ7kNvwGJx2TH&_nc_oc=Adql3UGzDkC2ylUt4GfVgwoO-NJqKHZybqKa8lFkftoC6BAr5vcNXRprzoxIzJjbUx4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yInwlpP1xCC79hi-Yt8Fu4s41hhH6v71A3-hgdNf6bg&oe=69E247DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1oUyxdLM7UwQ7kNvwHh4uZw&_nc_oc=AdqkTHfsZ3-nYvKg6gPdoSNwEqQbVJNBQxVdzh7th0QSFyLRqQRRADmWwUEzO9dxpRk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24XR1SqLGOxAZXy6CqMdmUQfJqJLANyp2y6yfbbAwdRw&oe=69E222D1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
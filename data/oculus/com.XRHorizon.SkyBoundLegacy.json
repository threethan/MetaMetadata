.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hs1pudEETBqKctBFCf65MWTHLyJKQAT4Y2OsNgGsMUg&oe=6A105571"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESQSoxDRZ-AQ7kNvwHw3oZU&_nc_oc=Adp5Alk8pOs8c5APwII4Nk-nSCofHxuJmsoKuBUzN6B97W8hRtTFs0GgpGGmHa5QBRI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YDgoEDRuRPBwvxd88mqOrlOXkyOrXHany9H6qFJ0O-w&oe=6A107FD7"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw7LlW-DhAwQ7kNvwE0qfM9&_nc_oc=AdoYbaYINxDXg-5HXv9dVL22O6pUcLokxFB1haEMSig7LsilRP9WYYTcGJueZwcAbjM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hHDh81TVSaSvvzusjpQFrLkmSSEbmYdGYUBxY6CEHag&oe=6A1060E0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZE9gR3Tc3MQ7kNvwFy-3mO&_nc_oc=AdpNhtb09tCDfEwcEUMO61NmPz0DFN8L-XOUOVUwgOIHEh67yBe4Pc1UNoLJyaNmAr4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76Ij3KZWZPGOqRI055IuBp_jeSjZ0dQKuQM5LAaZSQrA&oe=6A106C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33dgZMqBd90Q7kNvwGuSJfk&_nc_oc=AdrI3StNJDmvAKv7lyC3uZW5xjPosX6uvX_TL11tNWQazelV0Qn_jY-2tj5My_nHV1Q&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6q4_KRQsjWy0YGEH3vT6pnJ6QiVAOZ0HO_B2QaibWKcA&oe=6A107F91"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
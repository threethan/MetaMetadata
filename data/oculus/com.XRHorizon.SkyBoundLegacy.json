.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30wzHUYJC5NXJeE7BNgmAZwO4aCHylAMKwV51R70L9fA&oe=69D25EF1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5uRY2hkVfgQ7kNvwF0yxQd&_nc_oc=Adp_8ZVD7UUTPnIaJ5lgMOPuFNhY-L-oesK4Myq_rSR3tT9pbCxLg2ZxBaUfNAlnYps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ebqCNFtDp7ijgNA07GA6YAEpdD-D2bByAOmIzWWlPWg&oe=69D25117"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ofQI88I3RdcQ7kNvwGjya0x&_nc_oc=Adqh7xJDfwfLir4-ors3rwiDNvCEY90efN0v2Vr4us-Q2De1ga41aXDwBqpDyIntFLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gYcIep5ZV9bjU32W7wFv9qf7uqeQnvlI-yNIYv4Y-5A&oe=69D26A60"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GZ1XPvfUn4Q7kNvwHYfnEe&_nc_oc=AdqeWb3jEme7k_qHpOixQnbN1Rceng3f-uuKgq_UFkDZQY5xW5XYuHnRi_0SKxHhPeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ThTu5PJeapzxpy8Kl6IRSGhU0SQUnlafZBmu5z5s1jg&oe=69D275DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usvxjAMEOzIQ7kNvwEK8ZPh&_nc_oc=Adrmtb3Jl8IhYb49sVuvZW3SKyunCxeb8dTg4u4DhoPjaRKQjIieesVUwzuykpdqpEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o0zJ4Mu5eHTyi5nLmt6K2t4hMbQflk7wtGQGmlas4Aw&oe=69D250D1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
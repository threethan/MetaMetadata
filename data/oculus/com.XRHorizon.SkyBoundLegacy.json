gJnNg8oQ7kNvwFHl2KT&_nc_oc=AdoTWisEkQ-LznDHU8s3JPa7jPIIUTztkBHv5eEqyk02sN91glwmwaFF4-fwUjya0EM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuvwVjcuLXU2De-Q7eO-c-nveOazKAh891P6Q8SmLFYw&oe=6A6C9E71"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EanaiwkT-EkQ7kNvwHAv109&_nc_oc=AdquU9O0KDG1iR5p6xNkC66ZreJ8mlVP7MPAvzKzKVEvg7iF0TnXusVf5gtFV_he-dA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdnVxncPkSx0GxXmAOyr6pxO72aeM2f9m-l09K4DoYAQ&oe=6A6C9097"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFfpITa3yjcQ7kNvwEsj8oP&_nc_oc=AdpxULM5dbiuGV1abbufOSg88CJ2dchr2mXA48dCiBWKqD6K7R9IkEtJNi6I9xfjIZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATYuap77fME0lGhGDGofCbkiHr_toEmr1oKbEQ1cyhPQ&oe=6A6CA9E0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXxwCU1c3hUQ7kNvwF2JVz6&_nc_oc=Adqb8vfhxiHnhPAfTyfDhYwYoXIBpf2e8g8UslRXjIbAVLTEmKepSfJOudOd6UhunB4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXTOPifW2wUj_xIpsP3zISO4Kj3JLxOB-5OjX4CUqjPA&oe=6A6CB55B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oscuYdwZ8rIQ7kNvwHIf1Bb&_nc_oc=AdpiqFCI4KA12TD4ODTqCu0k5S_Erb9md3OpZrhubRPvzKwLauP1wHtcagHckNKcSqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi9J51zTKjzAwJ0PKovW1qBhIQsbQbEq6RdsaH8fpXzw&oe=6A6C9051"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}
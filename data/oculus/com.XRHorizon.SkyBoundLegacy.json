ame": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yviLsjLTqPgQ7kNvwHWx5l-&_nc_oc=AdoUZuhoThjD013EPWE40lthdZBP-hi-Ramf9EfR-N9GGXOu28wCbCzOxfaxuS_lxRo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1xmyZzrYvQ6VnQyy6RpNFSMkFVsor9x1dnpd-IMX1Rcw&oe=69F0A397"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ACA_ab-sklgQ7kNvwGgqhCc&_nc_oc=AdqIX_YS2hWkANhQDc8b19R1ZS6R4Ybmoy-BiPTe1yUFquKouyLNrjPsC5kUlVB1c6k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1VMCjSnfkAVh5pX1q1c00xhfqVS64n_iRlNBPKBeIEyg&oe=69F0BCE0"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3dWW2gRHrMQ7kNvwFXse_f&_nc_oc=AdpkgvWdtNnYFrZpnQf3sDrcTVzConBARU0QG4BMnBfbvmGeaTCvSPdOug95D7X_nUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0YvHrsOOoC23Xr2JkuswGt0BfjcrdNgMwPzCKNjXIHFw&oe=69F0C85B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUDeQWo9G14Q7kNvwFRy0Xq&_nc_oc=AdoZOKlBaVziE_E82jMU2t6MqVACUaRWq_xXTLzHgEEzpHUSH4oIC0E99Q0tYFyaCj4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2dVGF3UtZLj3tzEU70ErKp7wfnP6CpzOMOQjHZwK00Hw&oe=69F0A351"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_8004420075817418424_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zi_Z4asy78Q7kNvwEEMc7z&_nc_oc=Adrav0yXOLfTChiGcgIcje9EuGmQg4bsNj4xiLFSsPAyk5f
.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVO-tVlRboHV4-17Pza04C9tsOFkcqwx5_tJ72tQwcIw&oe=69C7D2F1"}, {"file_name": "SS5.png", "id": "1178580470875106", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619174_1178580474208439_3761421565389671281_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9MuNDA8YXkQ7kNvwESEnZJ&_nc_oc=Adpixm4mpAeoHxLexMKFFzrP0kvB-wheGuUJChdgnkjj_zRvDZXXPa6Om5G5AYTvuZI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKo58qL2WDyISZ2vj5NbO3b8K4BUTLRnGBn6lHt2yO6Q&oe=69C7C517"}, {"file_name": "SS3.png", "id": "1152090513711106", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619588_1152090517044439_3779235257384592263_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cd4-2wUDHZoQ7kNvwGjb6-c&_nc_oc=Ado3ZOrCU6sAMZ5nd-RrXUOYuvnvdZs1MzsSLDHoorIv-DA7V24vWlJNhW6GQIfOfuE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxm0BYVyfhJVhA707v-Ev9TilRBCWVWkBSh2aJ66IQ-nA&oe=69C7DE60"}, {"file_name": "SS2.png", "id": "620033414455035", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619174_620033421121701_1237260395774015338_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqE4ckJO6vQQ7kNvwG-4WV_&_nc_oc=AdpJvF2aN8t0RwjUB599yyUgOzyBoMj2k7HXV7namk6sL4kTPRVHjWqsQ8w5wAFEaF4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO9UbsjkP379bH_X1Gkr1DvMMAZoLXQ-b8wM37MQBdvw&oe=69C7B19B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "1412451040495807", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499618288_1412451043829140_3172190558726510506_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlLhWNVWcUAQ7kNvwGYBXLg&_nc_oc=AdrBqHmFtKKHg3cjQNDfELPTjAg6Nzc7yWQcKHnyGZvwqfehIR2RhUGhZY1pXSN0i0o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwB0Ke61_xuHVaYW37q9lyt_4MtSoJuB4b6id_vMoaCYQ&oe=69C7C4D1"}, "display_name": "Skybound Legacy", "keywords": ["Rollercoaster", "ImmersiveVRride", "Virtualrollercoaster", "ThemeparkVR", "FantasycoasterVR"], "long_description": "Welcome to Skybound Legacy! Prepare for a high-speed, heart-pounding rollercoaster experience through a meticulously crafted, classic old village.\n\nStrap in for a visually stunning journey that whips past quaint half-timbered houses, over cobblestone bridges, and through the vibrant town square. The village is teeming with life: friendly birds flutter past your head, and curious animals watch you zip by.\n\nThis isn't just about speed; it's about pure, engaging visual charm. Every twist, turn, and drop is synchronized to reveal breathtaking scenes of the peaceful countryside. Skybound Legacy: Village Run offers a fluid, captivating ride that is both intensely thrilling and wonderfully immersive, making it the perfect blend of speed and enchantment.", "short_description": "Experience a thrilling VR rollercoaster through a magical kingdom."}]}, "developer_name": null, "developer_privacy_policy_url": "https://xrexarplay-cloud.github.io/SkyboundLegacy-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "exarplay", "support_website_url": null, "website_url": "https://exarplay.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25533705302949777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619832_3772638506201426_800442007581
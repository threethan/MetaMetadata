ional first-person mode for additional fun!\n\nSome reviews by VR press:\n* Tyco Tech Reviews: https://youtu.be/dWVfPO6RPDU\n* Marcus Valles: https://youtu.be/ziZ7wHEK_tk\n* Erik Hartley: https://youtu.be/S2tM9b1wZ9U\n* RaMarcus: https://youtu.be/cf6JSFQnpSo\n* Go Getters: https://youtu.be/cMAnZNmAtdY", "short_description": "A simple game, nothing too deep. But designed to be fast and fun. For people who like challenging their reflexes and driving really fast. Deliver pizzas on a rocket-powered surfboard through challenging obstacles! 72Hz mode available for Oculus Go."}]}, "developer_name": "cmdr2", "developer_privacy_policy_url": "http://me.cmdr2.org/policy/privacy-speedsurfer.html", "developer_terms_of_service_url": null, "publisher_name": "cmdr2", "support_website_url": null, "website_url": "http://cmdr2.org/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "452809083223156"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974839_477528372736834_4550673989353078784_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZey3DqWbDoQ7kNvwEYDD_k&_nc_oc=Adnbn-U6Bn_GGFrTQ1phPdbJjFt4_N0zV8D4QgEBFZkFXc_EoooC3wXN3n2rZMoqlRg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuifRwN2TAHbu_DwwEROoQaaos4tqKCnuaw_6MZlu3O6g&oe=69A1927D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Speed Surfer"
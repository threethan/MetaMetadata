3391840_1277699090467453_6476242957164131400_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EP4f7hEcg4kQ7kNvwF1l6Ij&_nc_oc=AdruUByK08yg9Driw3CQGiDVPAXiwsGWNuvSbcWOs_fZEmPwHbwp9l3Bwej4zb0V_pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiHYzhbluf8AJ08SXUNj9TvBFFNjgl8cJP5KKMMEerUA&oe=6A491183"}, "display_name": "MelbaVR", "keywords": [], "long_description": "MelbaVR invites you into a stunning virtual jungle where you embody a powerful gorilla fighting against human threats. With captivating VR graphics and intuitive controls, swing through trees, roar defiantly, and navigate perilous challenges. Explore a rich narrative, forge alliances, and confront moral dilemmas. Whether a VR enthusiast or novice, experience adrenaline-pumping gameplay and endless adventure. Answer the call of the wild and become the jungle's hero in MelbaVR.", "short_description": "Immerse yourself in the world of MelbaVR, a thrilling virtual reality adventure where you become a mighty gorilla fighting to save your jungle home from human encroachment. Unleash your primal power in this epic VR experience."}]}, "developer_name": "mmo0nVR", "developer_privacy_policy_url": "https://sites.google.com/view/privacy-policymelbavr?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "mmo0nVR", "support_website_url": null, "website_url": "https://sites.google.com/view/melbavr?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
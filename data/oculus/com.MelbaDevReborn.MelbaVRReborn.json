ess adventure. Answer the call of the wild and become the jungle's hero in MelbaVR Reborn.", "short_description": "Immerse yourself in the world of MelbaVR Reborn, a thrilling virtual reality adventure where you become a mighty gorilla fighting to save your jungle home from human encroachment. Unleash your primal power in this epic VR experience"}]}, "developer_name": "mmo0nVR", "developer_privacy_policy_url": "https://sites.google.com/view/melbavrrebornpolicy/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0nVR", "support_website_url": "https://sites.google.com/view/melbavrrebornpolicy?usp=sharing", "website_url": "https://sites.google.com/view/melbareborn?usp=sharing", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7955521687794055"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3870101576609817"}]}, "baseline_offer": {"id": "3870101576609817"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715625600, "status": "PUBLISHED", "id": "3870101576609817"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9915009438511927", "version": "511"}, "id": "1111105956862847", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__is
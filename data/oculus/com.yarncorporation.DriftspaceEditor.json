humbnail": {"file_name": "DriftspaceCoverImage.png", "id": "178273404177945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984471_178273407511278_5257950742567606376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UR8JxQk6GqwQ7kNvwEtsjqj&_nc_oc=Adr-htWCNJwojvigGEoeEvRzTn9XyiMFGN10btgZ4V4QjirePqZ1xc09UZ08EJlBFzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQoQ4YYr7xvBB4HDObaYHqQHpaIvnLcDKw4-hQRiSYqA&oe=6AC126AD"}, "display_name": "Driftspace", "keywords": [], "long_description": "Welcome to Driftspace! Driftspace is a platform for creating immersive VR stories by combining 360 video, text, images, links, and other media. Driftspace allows you to create interactive video stories in VR and to share them with others, as well as to browse the drifts made by others. Driftspace also support a real-time social VR experience, letting you experience your content with anyone in the world!\n\nCombine, create, and share using Driftspace's intuitive headset design interface and seamless web dashboard integration\u2014then invite your friends to join and experience your creations together! With a few simple clicks you'll be ready to create your own incredible VR spaces. Then connect them together with our linking feature and hit \"Publish\" to share your experiences with your friends and family or with potential customers or clients. Anything is possible with Driftspace!", "short_description": "Welcome to Driftspace! Driftspace is a platform for creating immersive VR stories by combining 360 video, text, images, links, and other media. Driftspace allows you to create interactive video stories in VR and to share them with others, as well as to browse the drifts made by others. Driftspace also support a real-time social VR experience, letting you experience your content with anyone in the world! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1AAChQHnjiBj9LU7lmfVd8n1sO097asLc/view?usp=sharing", "
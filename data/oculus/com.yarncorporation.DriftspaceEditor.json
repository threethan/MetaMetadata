gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T57-MeRqUE4Q7kNvwE4DA95&_nc_oc=AdqWuNE3k-IqiBsnpSOllueBI3tqEiMjLQk0XRpf4iT2C3PxPfiAazKeHDHkJqa5Soc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvS4KOLz8eK83gNekC4-SJlsG1utW9SvSTE0SwrCNK1A&oe=6AFC8B54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriftspaceCoverImage.png", "id": "178273404177945", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984471_178273407511278_5257950742567606376_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdK9s52d3H4Q7kNvwESbmOD&_nc_oc=AdqlsT2b-8xNKF3h86E6j-iT2xGh-lUWFU7HHme_YGxASPHyFRvUwnd6dAl9g97ODrU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiqP5VHGw5uTKjst4OnM1GP4IDEQ3BNYqVCnO0eDtWDA&oe=6AFC7A2D"}, "display_name": "Driftspace", "keywords": [], "long_description": "Welcome to Driftspace! Driftspace is a platform for creating immersive VR stories by combining 360 video, text, images, links, and other media. Driftspace allows you to create interactive video stories in VR and to share them with others, as well as to browse the drifts made by others. Driftspace also support a real-time social VR experience, letting you experience your content with anyone in the world!\n\nCombine, create, and share using Driftspace's intuitive headset design interface and seamless web dashboard integration\u2014then invite your friends to join and experience your creations together! With a few simple clicks you'll be ready to create your own incredible VR spaces. Then connect them together with our linking feature and hit \"Publish\" to share your experiences with your friends and family or with potential customers or clients. Anything is possible with Driftspace!", "short_description": "Welcome to Driftspace! Driftspace is a platform for creating immersive VR stories by combining 360 video, text, images, links, and other media. Driftspace allows you to create interactive video stories in VR and to share them with others, as well as to browse the drifts made by others. Driftspace also support a real-time social VR experience, letting you experience your content with anyone in the world! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1AAChQHnjiBj9LU7lmfVd8n1sO097asLc/view?usp=sharing", "developer_terms_of_service_url": "https://drive.google.com/file/d/13L1qPdRgaQ0nb7UGnJ-EmNExW4dRyc2W/view?usp=sharing", "publisher_name": "The Yarn Corporation", "support_website_url": "https://dashboard.driftspace.com/", "website_url": "https://driftspace.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "SOCIAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "466823181579509"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001711_229183612307309_4928803130411089850_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVJIKXPOlhEQ7kNvwGw1J8k&_nc_oc=AdprcIGIU6ecgzszB41BicR7CfxMaYViop9H7ZmcRpC05X7F1e6e8HcLoe0kH5NivdY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHFG1FYvZL9U_hHKiy55WT4TprQsTuThLEvNh3_AcLFw&oe=6AFC6CBF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Driftspace", "platform": "ANDROID_6DOF", "context_categ
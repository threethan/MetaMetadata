gen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaVWq3kE0GAQ7kNvwGC5ABH&_nc_oc=AdqxIRUrJiKIc6qJGe7N7WTg1hLnLWB34esnxIdv18BACDDdLZf6wC4mnZkfVTpbWz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsBRFsqCruGouspmOTD9VKIBhYRmMVnLFlov6sNpXXBg&oe=6B0322D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DriftspaceCoverImage.png", "id": "178273404177945", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38984471_178273407511278_5257950742567606376_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ah6A2h6Lkt0Q7kNvwGWlr1U&_nc_oc=Ado0eejbS-PuVFT46VDArjx_K9ZOlqWlGErJI_rdOYSZUqFmoNxXwi9mvay9ip4o0oE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgAu68ru8mr6E8dMMTryJPWHSoQo_hamNGGcX4e8bmTw&oe=6B0311AD"}, "display_name": "Driftspace", "keywords": [], "long_description": "Welcome to Driftspace! Driftspace is a platform for creating immersive VR stories by combining 360 video, text, images, links, and other media. Driftspace allows you to create interactive video stories in VR and to share them with others, as well as to browse the drifts made by others. Driftspace also support a real-time social VR experience, letting you experience your content with anyone in the world!\n\nCombine, create, and share using Driftspace's intuitive headset design interface and seamless web dashboard integration\u2014then invite your friends to join and experience your creations together! With a few simple clicks you'll be ready to create your own incredible VR spaces. Then connect them together with our linking feature and hit \"Publish\" to share your experiences with your friends and family or with potential customers or clients. Anything is possible with Driftspace!", "short_description": "Welcome to Driftspace! Driftspace is a platform for creating immersive VR stories by combining 360 video, text, images, links, and other media. Driftspace allows you to create interactive video stories in VR and to share them with others, as well as to browse the drifts made by others. Driftspace also support a real-time social VR experience, letting you experience your content with anyone in the world! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1AAChQHnjiBj9LU7lmfVd8n1sO097asLc/view?usp=sharing", "developer_terms_of_service_url": "https://drive.google.com/file/d/13L1qPdRgaQ0nb7UGnJ-EmNExW4dRyc2W/view?usp=sharing", "publisher_name": "The Yarn Corporation", "support_website_url": "https://dashboard.driftspace.com/", "website_url": "https://driftspace.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EXPERIENCE_360_NON_GAME", "SOCIAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "466823181579509"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001711_229183612307309_4928803130411089850_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gucrr8ML_QsQ7kNvwFSO42S&_nc_oc=AdooNfDUmeJ9nGYUWmlGFCLr22LAe6_esjkli67pEBZVh0zBQyZzQ8ByJi1mm7RD8is&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9N4SmosYfaYuDwCE1yXkdKOegb1rg-TxLAGigVIAC2w&oe=6B03043F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Driftspace", "platform": "ANDROID_6DOF", "context_categ
i9XC2HyMR7GSXrBInlmpSzCdVTTZV_OHypQ&oe=699ED8AE"}, {"file_name": "75302219_1089123061448083_6872039061914124288_n.png", "id": "1415425015455905", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982478_1415425018789238_8587611967391371570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dxFiDptLJaIQ7kNvwEfwOHR&_nc_oc=Adm58MK16z2o4cBSQ-vb595lwiIeBZZjU2QgdNyf8Q_XO95oW4pOlpb9LKOE0QYMGog&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft7Ub7EoACYHL6iXBEZcOC1c1-LpRUs99mCqlJkIgqDRg&oe=699EDB12"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video Cover Art.png", "id": "768347673798087", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003239_768347677131420_8476754123177296243_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTRRZ7e6es0Q7kNvwE31K1x&_nc_oc=Adl7d7V9V66MlL08Ew1az-TMSU8AoYU8JuK9kY9kSEyhBIKPXCD9aMdAbomFhYqVyUo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvpjJXGOvafpuO2f3wVsvlxMOEL0zjeWBl_mZrHa-pPAw&oe=699ED283"}, "display_name": "Art Gate VR", "keywords": [], "long_description": "Art Gate is an art market in virtual reality. Exhibitors from North America, South America, Africa, Europe, Asia, and Australia actively curate and host social art events in Art Gate. Erin Loree and Alex McLeod are among the contemporary artists on exhibition. Masters such as Pablo Picasso, Robert Indiana, Cindy Sherman, Louise Nevelson, and many other artists in between can be found in Art Gate as well. All the exhibitions are open to the public for free. \n\n-Join social art events\n-Buy and sell artwork\n-Connect with international artists, collectors, and galleries\n\nFor our programming schedule visit: www.artgatevr.com/programming", "short_description": "Art Gate is your destination for social art events. Join an art fair, opening reception, artist talk or exhibition tour with other art lovers from around the world. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.artgatevr.com/app/privacy.php
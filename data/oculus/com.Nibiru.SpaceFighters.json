4167992567660544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AU29v9LKTM4Q7kNvwEUqcD6&_nc_oc=AdoEzRrl3yrCwmudVPdlBJUGicagPKHCuChgyZSJkMvZEc3F8NKmTJIFbEQkRkCWUKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJZyzpo70P0T0vElDF9dcglgFlpdrBWZGyifwSZLWwyw&oe=6A4A67A3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Fighters", "keywords": ["game", "vr", "fighter", "shooting"], "long_description": "Kerry family always want to destroy this universe hero in the outer space. This is an air combat shooting game, players can move the horizontal direction of airplanes by moving viewing angle and click the OK button to shoot automatically. During the game, players can also pick up the bullet to upgrade the props and strengthen the fire, but the enemy's attack can also make the bullet level down. So that you need to move the fighters to avoid bullets to keep their fire output. Let\u2019s fight with Arthur and give the enemy a critical strike!", "short_description": "Arthur, warrior of time and space, drove the space fighter from the air base to the space station and was blocked by the Kerry alien aircraft through the journey."}]}, "developer_name": "Box VR Studio", "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "Box VR Studio", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "FIGHTING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "u
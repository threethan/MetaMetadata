0_gho9k8AV8XyRAJCJmcTm0tMn54RcaM9K-jWtUPE22fJXryhAGAEQIyrtrGoJ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iNfxtDRaZZwivJ5vv5BApJiYPQxFhHfQEP0wRz4QIBg&oe=69E8AF66"}, {"file_name": "Screen_6_Boss.png", "id": "993535671801293", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031370_993535675134626_6528253582307461366_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wgh9jq4EeN0Q7kNvwEoeLVp&_nc_oc=Adpiqz6CTD9HsdCjby7MMRZzcopjgwMgRakCiE-nQsgXB8je4YhwnjMOPIO-Jhay7wA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DpYKpQezusH56ZrGX1ibALL2493EFY0c32H-kQNzXPQ&oe=69E8D884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Render Raw v2.png", "id": "419794194156495", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974507_419794197489828_2951621016193546620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXtKo7JRJWwQ7kNvwFpuRZ1&_nc_oc=Adri_KLIzsxcT6hA9jeHq_i9SaBituzuDZJuS-dSFY6IPwMOtvgmgflEV2Ed4hc16IU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z33ppA5TsnCuqsnJnG_IEp13wz49u_7Ph-Za7eWtTTA&oe=69E8C96E"}, "display_name": "Retronika", "keywords": [], "long_description": "Dive into the Retro-Futuristic World of Retronika!\n\nExperience the ultimate fusion of high-speed racing and dynamic combat in Retronika. This story-driven single-player game lets you navigate vibrant cityscapes on your flying bike, facing thrilling challenges that push your skills to the limit.\n\n\nSeamless Racing and Intense Shooting:\n\nControl your bike with unique, intuitive handlebar mechanics for smooth 3D movement. Glide through the skies, dodge obstacles, and outmaneuver enemies with ease. Engage in dynamic battles against enemy drones and weaponized vehicles. Combine weapons for strategic combat and adapt to various scenarios, enhancing your gameplay experience.\n\n\nJoin the Community:\n\nBecome part of the Retronika community and share your experiences with fellow players. Compete on leaderboards, participate in events, and stay updated with the latest game developments. Dive into Retronika on Meta Quest and join a world filled with action and excitement. Get Retronika now and begin your adventure!\n\nDiscord Community:   https://discord.gg/krw4PnkXeT\nReddit:                           https://www.reddit.com/r/RetronikaOfficial/\nTwitter (X):                    https://twitter.com/Retronika2024\n ", "short_description": "Dive into the retrofuturistic world of Retronika, where high-speed flying bikes and dynamic combat collide. Navigate vibrant cityscapes, engage enemy drones, and complete challenging missions. Master the intuitive handlebar controls for seamless 3D movement and strategic shooting. Combine weapons for varied combat strategies. Experience the adrenaline-pumping thrill of Retronika, offering an unparalleled VR adventure on Meta Quest. Race and explore!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.4players-studio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "4Players-Studio", "support_website_url": "https://www.4players-studio.com/contact#contact-message", "website_url": "https://www.4players-studio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26079740828341020"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1486991859
S0WbqhCvrBnc1-5i5ibzoRizQ88aQsW831Yc_XPSCiQ&oe=6AFB35F8"}, {"file_name": "Screen_3_DayFight.png", "id": "436411449143524", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031441_436411452476857_6912955252871556053_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bU-HObs3MSwQ7kNvwH0pjVF&_nc_oc=AdqmeIpGCW0oy-SSYcXmIM-Ir5DF5aUO2ljtZaM6cuQsEdgDQORvu6cRMn7is5YbkOE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg0zk8-On7-ncK4oU2wI7_rfmKhk3fGAmS9rcx3K9yBw&oe=6AFB1FA6"}, {"file_name": "Screen_6_Boss.png", "id": "993535671801293", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031370_993535675134626_6528253582307461366_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VGq6fG6s3IQ7kNvwGWbZox&_nc_oc=Adp16gprqr1PrOsudHxxR2yImOljLb8ZRnixXfv9YT8anKZqWywZDJLRh4t-lFmDlrU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlKHIvmlilrZL68rP8vrLvv9Qh0lTKAvQ9WIr-QoKkDw&oe=6AFB48C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Render Raw v2.png", "id": "419794194156495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974507_419794197489828_2951621016193546620_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_5Iexl8TBEQ7kNvwGvAQUC&_nc_oc=AdqiDg0A6yVZ1Y25ZHFJy6TQN5ayARS4IJzbfjf3BUVuKmQJrfeOXaZ-OM-Rd-OoBfs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNkvOyIWoeySOmgvsIZGMV5cHlQ12GGtmc4M0Wb6rSdA&oe=6AFB39AE"}, "display_name": "Retronika", "keywords": [], "long_description": "Dive into the Retro-Futuristic World of Retronika!\n\nExperience the ultimate fusion of high-speed racing and dynamic combat in Retronika. This story-driven single-player game lets you navigate vibrant cityscapes on your flying bike, facing thrilling challenges that push your skills to the limit.\n\n\nSeamless Racing and Intense Shooting:\n\nControl your bike with unique, intuitive handlebar mechanics for smooth 3D movement. Glide through the skies, dodge obstacles, and outmaneuver enemies with ease. Engage in dynamic battles against enemy drones and weaponized vehicles. Combine weapons for strategic combat and adapt to various scenarios, enhancing your gameplay experience.\n\n\nJoin the Community:\n\nBecome part of the Retronika community and share your experiences with fellow players. Compete on leaderboards, participate in events, and stay updated with the latest game developments. Dive into Retronika on Meta Quest and join a world filled with action and excitement. Get Retronika now and begin your adventure!\n\nDiscord Community:   https://discord.gg/krw4PnkXeT\nReddit:                           https://www.reddit.com/r/RetronikaOfficial/\nTwitter (X):                    https://twitter.com/Retronika2024\n ", "short_description": "Dive into the retrofuturistic world of Retronika, where high-speed flying bikes and dynamic combat collide. Navigate vibrant cityscapes, engage enemy drones, and complete challenging missions. Master the intuitive handlebar controls for seamless 3D movement and strategic shooting. Combine weapons for varied combat strategies. Experience the adrenaline-pumping thrill of Retronika, offering an unparalleled VR adventure on Meta Quest. Race and explore!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.4players-studio.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "4Players-Studio", "support_website_url": "https://www.4players-studio.com/contact#contact-message", "website_url": "https://www.4players-studio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nul
dn.com&_nc_ss=7f20f&oh=00_AQACtFS61jZx3k8GXfEu7IdQgeHNOjaToaFzKbeMMA4MvQ&oe=6A64B821"}, {"file_name": "Surgineer_Screenshot_11_2560_1400.png", "id": "5525412070872928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75324645_5525412087539593_8209786052626508571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX4aKQ9p_LEQ7kNvwESswMx&_nc_oc=AdpfhIzGJU-cea_P9pThYVmIkDZhKCg_BCOuk4sgPsJda9AApZKMpo_FdEDay2s-LGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEoSGzHnAtoLvDbpXtCfmOy-5GQXjQbHBKIt8EWb5XRg&oe=6A64A9E9"}, {"file_name": "Surgineer_Screenshot_3_2560_1400.png", "id": "462757105804908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375748_462757109138241_4479486634400330080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E80ZmOPs4OUQ7kNvwEA0Hp8&_nc_oc=Adr2KztYcVRCcSWpHvXDiILlk8f29dWx1NHclNiA3WPAZ2Rfo5pxCXAmX87yAgnwJL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDstN0PWPM1A7tG-_GfS_Btpm-7OHqeUIhD4wsH22P3lQ&oe=6A64A73C"}, {"file_name": "Surgineer_Screenshot_9_2560_1400.png", "id": "635014078033212", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75439593_635014081366545_2429816696528755233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhAmx9ioB7oQ7kNvwH1IXri&_nc_oc=Adq2D18RF-X-LZlbkeJZKfbCRykcRH3D09roz3UDnCXj8A9LV4eCRJaD3SPDGvbLpcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQXt1n_SDS_webveGC0y_ZlSjWzAo7zfFKqhGzfYdpqA&oe=6A64CE28"}, {"file_name": "Surgineer_Screenshot_10_2560_1400.png", "id": "805770460545373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481471_805770463878706_6927189540328422811_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaY9_ghTSQ0Q7kNvwF2rsPY&_nc_oc=AdrHd0K8Ehnb_9zK7ptyhiu7kZFDet4SMD-36oDESgo49S9C4WssTeDFg1j0aFUEhn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTj6Dp6Aj-eIRIvBkZdd1LVBr-UxocA9XjEH6S91kupg&oe=6A64A11A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surgineer_2560_1440.png", "id": "973125724088981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_973125730755647_4446282231363403451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVjnwhWx994Q7kNvwFN3d6Y&_nc_oc=AdriA30pk449YU5gR4WoJ9Hehk8SfGswbsjWQXVWRGfpafDVXaX3MIKlDxNY6XaFSd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjx-eE-4kAgJ-kA1AOYMt9Y1TpsokULz1uUzcpFC7Syw&oe=6A64C9A3"}, "display_name": "Surgineer", "keywords": ["surgeon", "surgery", "doctor", "simulator", "gore"], "long_description": "Have you ever dreamed of being a real surgeon? Well\u2026 you are not gonna learn that here. \n\nWelcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor.  \n\nYou will have to solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nYou always thought you had that surgeon in you? You better have a bulletproof malpractice insurance before getting your virtual hands on a patient!\n\n\nKey Surgineering Tools & Abilities:\n\n\u25cf Use your hands with physics to dig in that flesh\n\u25cf Huge arsenal: scalpels, knives, syringes, drills, saws, rubber ducks and much more!\n\u25cf Defib the hell out of that patient's body.\n\u25cf Slap the patient's face with a fish, because why not?\n\u25cf Use an axe and hammer to crack down that chest and skull!\n\u25cf Transplant organs and limbs (even heads).\n\u25cf Futuristic lasers and telekinetic forceps!\n\u25cf Surgical Robotic Arm for very high precision procedures. Maybe.\n\n\n", "short_description": "Welcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor. \n\nYou will solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nSurgineer packs a combination of fun and challenging procedures.  \nYou will have fun cutting legs, removing foreign bodies and transplanting organs or limbs, but never forget that the goal is to keep your patient alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "HORROR", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27452877557661432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_3164308107162577_536450320189810064_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5N9NlkUPt5wQ7kNvwGkYCG5&_nc_oc=Adrjp9vz9fAEYdgXwyauWaYucXlw8v4lqqjjic5D2EiYIWC5yvNxO2Xol2XnEOQ6OWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFIRoFKXZ7qU_IpDP7PMCMkzTqCIjzL15B3TIz52WeYQ&oe=6A64CE8A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surgineer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1666890021, "lastRevision": {"nodes": [{"id": "782300505823391", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_me
PR7scmZYBo6G4XrAssWFXfS4eqN3Rf-yDxJw&oe=6AEF46DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surgineer_2560_1440.png", "id": "973125724088981", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031339_973125730755647_4446282231363403451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzmGKBGB_cIQ7kNvwE4gFoz&_nc_oc=AdoaIf96a2JukdwqAxTVeeNveYOmRIoE2RwyF6pNZYLvKUWEYZ-RBCraTJOpqrux_QA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoAThKm0imQwQF78h0WZZ1cet_BtXl1BbuS_BfMRa74w&oe=6AEF3723"}, "display_name": "Surgineer", "keywords": ["surgeon", "surgery", "doctor", "simulator", "gore"], "long_description": "Have you ever dreamed of being a real surgeon? Well\u2026 you are not gonna learn that here. \n\nWelcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor.  \n\nYou will have to solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nYou always thought you had that surgeon in you? You better have a bulletproof malpractice insurance before getting your virtual hands on a patient!\n\n\nKey Surgineering Tools & Abilities:\n\n\u25cf Use your hands with physics to dig in that flesh\n\u25cf Huge arsenal: scalpels, knives, syringes, drills, saws, rubber ducks and much more!\n\u25cf Defib the hell out of that patient's body.\n\u25cf Slap the patient's face with a fish, because why not?\n\u25cf Use an axe and hammer to crack down that chest and skull!\n\u25cf Transplant organs and limbs (even heads).\n\u25cf Futuristic lasers and telekinetic forceps!\n\u25cf Surgical Robotic Arm for very high precision procedures. Maybe.\n\n\n", "short_description": "Welcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor. \n\nYou will solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nSurgineer packs a combination of fun and challenging procedures.  \nYou will have fun cutting legs, removing foreign bodies and transplanting organs or limbs, but never forget that the goal is to keep your patient alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "HORROR", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27452877557661432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031532_3164308107162577_536450320189810064_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=588TXlxTFQ8Q7kNvwE05kHE&_nc_oc=AdoL7cI9P0B12ld91Qjd_41Gav3sbpYavwKOYvLGUZjxM_fKwpRIG-7xU0TxUMHFaEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd5oU6ct0cJ-qLM2F8cqC_Teddk1c65Sx0EOnmlwsm1Q&oe=6AEF3C0A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surgineer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1666890021, 
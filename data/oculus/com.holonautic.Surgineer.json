dn.com&_nc_ss=7f20f&oh=00_AQIkyRZHRdD--Gbpar2mu5tufJFs0jOjo46lmXmIVRHlCQ&oe=6A9AC5A1"}, {"file_name": "Surgineer_Screenshot_11_2560_1400.png", "id": "5525412070872928", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75324645_5525412087539593_8209786052626508571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhaYGsmd8CkQ7kNvwGboF1S&_nc_oc=AdoN3UFkCTJArA3CZW5QvA5x8h3y4FLPGtaccYRcKyy0y0VTzLXDwey4hC6qwAiP-sM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEgdFwkmHeFSc4_HQZFtEAveeQOUsJLRDyQUKrlE0GbA&oe=6A9AEFA9"}, {"file_name": "Surgineer_Screenshot_3_2560_1400.png", "id": "462757105804908", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75375748_462757109138241_4479486634400330080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnF3fnkNAYUQ7kNvwFf08S8&_nc_oc=AdoiEavO2QFmafIpoUbmMmZ5UuZ4kXoZlHs1ql3EByX3Zth1xiLwOhvVY7P7UVQRvNQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-aWCkdhqbmipst4HyV8oeniJZHjFhQT7g8Vl36cubfA&oe=6A9AECFC"}, {"file_name": "Surgineer_Screenshot_9_2560_1400.png", "id": "635014078033212", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75439593_635014081366545_2429816696528755233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRJp7yKjZMEQ7kNvwF1L5FJ&_nc_oc=AdrN-V9U5eXtWi_X57jwiQnZ3EppT7gD4Ud7GrBxhLqAyb5_Rwc-03_6LGy7wMpcu8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWP64NNmVmyjdXWnFXT61J5nJ5lzxPF2wdLBTkPF5PEw&oe=6A9ADBA8"}, {"file_name": "Surgineer_Screenshot_10_2560_1400.png", "id": "805770460545373", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75481471_805770463878706_6927189540328422811_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwnzER0TZUkQ7kNvwHShOEH&_nc_oc=AdqjvLT7RxQ58R6gOjW55CEhdC1o2JXfouzDf1iaDMTYawTjqf0roMklO1bhTPFjTx8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0K5iOzXswZgexHByhDv9-qKsNaj1h9IwMJkkTGd5lcQ&oe=6A9AE6DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surgineer_2560_1440.png", "id": "973125724088981", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031339_973125730755647_4446282231363403451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7wgRo0t26oQ7kNvwHmdwlE&_nc_oc=AdpnVlZ4QuOJV5SJxrVEW37XkdQz_X9VDX9G2k1eBOGN-l0hHQcu7WULwCqnNjSh0Wc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhoCICsWsNYcff2TozrTJPnNbSzTlyIgYzPbTQ0WRRbw&oe=6A9AD723"}, "display_name": "Surgineer", "keywords": ["surgeon", "surgery", "doctor", "simulator", "gore"], "long_description": "Have you ever dreamed of being a real surgeon? Well\u2026 you are not gonna learn that here. \n\nWelcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor.  \n\nYou will have to solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nYou always thought you had that surgeon in you? You better have a bulletproof malpractice insurance before getting your virtual hands on a patient!\n\n\nKey Surgineering Tools & Abilities:\n\n\u25cf Use your hands with physics to dig in that flesh\n\u25cf Huge arsenal: scalpels, knives, syringes, drills, saws, rubber ducks and much more!\n\u25cf Defib the hell out of that patient's body.\n\u25cf Slap the patient's face with a fish, because why not?\n\u25cf Use an axe and hammer to crack down that chest and skull!\n\u25cf Transplant organs and limbs (even heads).\n\u25cf Futuristic lasers and telekinetic forceps!\n\u25cf Surgical Robotic Arm for very high precision procedures. Maybe.\n\n\n", "short_description": "Welcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor. \n\nYou will solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nSurgineer packs a combination of fun and challenging procedures.  \nYou will have fun cutting legs, removing foreign bodies and transplanting organs or limbs, but never forget that the goal is to keep your patient alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "HORROR", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27452877557661432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031532_3164308107162577_536450320189810064_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfIu2Kbmo7gQ7kNvwFTOC1S&_nc_oc=AdroUHXaLwSTvTwMNENgghnfHaCt9H4PSx4K35gJ9bBSosLz0CXSGLB94xd2CtYFLBs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-gOfhDUbj65OlCUuuvMP1uLaKROWPzvUyCv2DzCvyCg&oe=6A9ADC0A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surgineer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1666890021, "lastRevision": {"nodes": [{"id": "782300505823391", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_me
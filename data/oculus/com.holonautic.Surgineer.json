dn.com&_nc_ss=7f20f&oh=00_Af4y02Gcq3j9EpVvPZMcEbuoMuZdcJdVstwhE70oyhcrZQ&oe=69FB4021"}, {"file_name": "Surgineer_Screenshot_11_2560_1400.png", "id": "5525412070872928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75324645_5525412087539593_8209786052626508571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr3xVLoNg74Q7kNvwEPCBRY&_nc_oc=AdqnNLIGpln4M_gVg4TqMWQBvqd_ZsaBeOlrHXeF8MBmLHkYptmjSsEtBvyWqev-NdU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SkgGyqpnRCPlfxBwuwQnCWO0xg8effDHUMQJh3FeO7A&oe=69FB31E9"}, {"file_name": "Surgineer_Screenshot_3_2560_1400.png", "id": "462757105804908", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375748_462757109138241_4479486634400330080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8ZaZR5dWE0Q7kNvwHvy_xN&_nc_oc=AdqBdxp6DSuka4D9GDUw7dZ-gaudPWX4-QWXWxi6zGBkvdCPOcq8ldYvs66czql-3Ms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r3i0uzUvzNn0nmiwOkG7W-y24JuwOPFYtzck-qFYZUg&oe=69FB2F3C"}, {"file_name": "Surgineer_Screenshot_9_2560_1400.png", "id": "635014078033212", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75439593_635014081366545_2429816696528755233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp-JQodPySoQ7kNvwEXDISB&_nc_oc=AdqihOx82HaOUNxYrH6qj6r6NjHx-RX-sWenrV6lGbYj-f6qXUwTFYZDwQzSWcCWaOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yIM8r6pqlX3KkDUwgQgvl8AzznYW7cgjZ51C4Ol2EKw&oe=69FB5628"}, {"file_name": "Surgineer_Screenshot_10_2560_1400.png", "id": "805770460545373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75481471_805770463878706_6927189540328422811_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBPy1yE6qmoQ7kNvwFzQYy5&_nc_oc=Adqz9mYHIOAkX0qQATI6YYgyrD0GO6XtukpjgCE9x71v65HkzFUTzRoYvC2uoz5__n0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CuIJsnJ1DWYQWMVTRfkAibFAPDWXmwpHDbARfhW9sng&oe=69FB291A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surgineer_2560_1440.png", "id": "973125724088981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031339_973125730755647_4446282231363403451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U65VPhoCtygQ7kNvwFxjbhv&_nc_oc=AdoGjhP0Wfj52phjBbiP7pnRDCEUmOMHqKRA9HDGpTUxmVHBIl6zWeTA50NYuWlGC-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UjfB6qOpGTPDJ178XnpcJar6djQfdG5lj46fL-fuPkQ&oe=69FB51A3"}, "display_name": "Surgineer", "keywords": ["surgeon", "surgery", "doctor", "simulator", "gore"], "long_description": "Have you ever dreamed of being a real surgeon? Well\u2026 you are not gonna learn that here. \n\nWelcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor.  \n\nYou will have to solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nYou always thought you had that surgeon in you? You better have a bulletproof malpractice insurance before getting your virtual hands on a patient!\n\n\nKey Surgineering Tools & Abilities:\n\n\u25cf Use your hands with physics to dig in that flesh\n\u25cf Huge arsenal: scalpels, knives, syringes, drills, saws, rubber ducks and much more!\n\u25cf Defib the hell out of that patient's body.\n\u25cf Slap the patient's face with a fish, because why not?\n\u25cf Use an axe and hammer to crack down that chest and skull!\n\u25cf Transplant organs and limbs (even heads).\n\u25cf Futuristic lasers and telekinetic forceps!\n\u25cf Surgical Robotic Arm for very high precision procedures. Maybe.\n\n\n", "short_description": "Welcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor. \n\nYou will solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nSurgineer packs a combination of fun and challenging procedures.  \nYou will have fun cutting legs, removing foreign bodies and transplanting organs or limbs, but never forget that the goal is to keep your patient alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "HORROR", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27452877557661432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031532_3164308107162577_536450320189810064_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmMThzLxSVwQ7kNvwHhbUGQ&_nc_oc=AdorEzAJLVTVnMz_R6IYovTtZorJHEaT4hQdO1ZnnvKGRMX1DngxRaJJXJ4-DNfu4Cw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RE0j33Lk7pSE3y-rl5ltxhkc6TGT6HQmHQjHX80-K1Q&oe=69FB568A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surgineer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1666890021, "lastRevision": {"nodes": [{"id": "782300505823391", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_me
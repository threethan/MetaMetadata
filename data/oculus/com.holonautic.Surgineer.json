dn.com&_nc_ss=7f20f&oh=00_Af-1H-M2KRNHF9tmQYNyH_Ij9XUS0hkvbgUve1O3gWGoZA&oe=6A2D5921"}, {"file_name": "Surgineer_Screenshot_11_2560_1400.png", "id": "5525412070872928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75324645_5525412087539593_8209786052626508571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrYy3oiCJfMQ7kNvwG9Hfq9&_nc_oc=AdplW_qQ7rRiLeetztd4VYh91uyVZkg-aXOBFw8IjjzVO7HETiqVKTDXs9F7K3ixABE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nlVdyp_W156c23loF7-cYb7h2QzogYDBkYTUSsj4SsQ&oe=6A2D4AE9"}, {"file_name": "Surgineer_Screenshot_3_2560_1400.png", "id": "462757105804908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375748_462757109138241_4479486634400330080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guL-m-JGclEQ7kNvwERzMo2&_nc_oc=Adpl88NNYIDCxKScIlwDjaIZwzGrqFKJfQL30k6p-d1Ky_NEMg1r2qQilixViKE7Xzw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rebxuNwPZB1QnfVcL1Nh0xc46Ek9aBCjW9Lbjti7_3g&oe=6A2D483C"}, {"file_name": "Surgineer_Screenshot_9_2560_1400.png", "id": "635014078033212", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75439593_635014081366545_2429816696528755233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KAydnvfudw0Q7kNvwGDq2fv&_nc_oc=Adq5E8TTw98XwBEHAe1y3bjyEPjMOtru5uG8-YiQ1Mg8IDCKwzYclhUXSes-_ETpxS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90viqs28QaAlLnOIwoHAJaoSJlO0wmjd7OBDm5SCMzwg&oe=6A2D6F28"}, {"file_name": "Surgineer_Screenshot_10_2560_1400.png", "id": "805770460545373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481471_805770463878706_6927189540328422811_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb0OINbOuigQ7kNvwHpcA_y&_nc_oc=AdoG9VYlcYIhdlFpSnccEPZizCf22_laGXgbv2dJ0puHSdsQLLi6eK8Ms2RuERHyIuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LkWdkm6X31VSTImiu1tpPWk1nXRRtnI9D-PjRyINbPQ&oe=6A2D7A5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surgineer_2560_1440.png", "id": "973125724088981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_973125730755647_4446282231363403451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4H7oFmv2WUQ7kNvwFBWrQX&_nc_oc=AdrPWc8NgJauRXIcb0Wrv65rJo1G42Wu6peQ2vy7icAHrZud0nbxYo6p713Lu35QxGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ibdSXyiq8UoowcUKXqru9gWhdGFsERpMQM8_lLa4zLg&oe=6A2D6AA3"}, "display_name": "Surgineer", "keywords": ["surgeon", "surgery", "doctor", "simulator", "gore"], "long_description": "Have you ever dreamed of being a real surgeon? Well\u2026 you are not gonna learn that here. \n\nWelcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor.  \n\nYou will have to solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nYou always thought you had that surgeon in you? You better have a bulletproof malpractice insurance before getting your virtual hands on a patient!\n\n\nKey Surgineering Tools & Abilities:\n\n\u25cf Use your hands with physics to dig in that flesh\n\u25cf Huge arsenal: scalpels, knives, syringes, drills, saws, rubber ducks and much more!\n\u25cf Defib the hell out of that patient's body.\n\u25cf Slap the patient's face with a fish, because why not?\n\u25cf Use an axe and hammer to crack down that chest and skull!\n\u25cf Transplant organs and limbs (even heads).\n\u25cf Futuristic lasers and telekinetic forceps!\n\u25cf Surgical Robotic Arm for very high precision procedures. Maybe.\n\n\n", "short_description": "Welcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor. \n\nYou will solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nSurgineer packs a combination of fun and challenging procedures.  \nYou will have fun cutting legs, remo
dn.com&_nc_ss=7f20f&oh=00_AQE83y-Oqn_swOMXEM82CVB0HKr7E66xil5VwvmjjpLzuQ&oe=6A7C7321"}, {"file_name": "Surgineer_Screenshot_11_2560_1400.png", "id": "5525412070872928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75324645_5525412087539593_8209786052626508571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX1rFwbSFzoQ7kNvwFsfUSz&_nc_oc=AdoKhNXnXqEHPtF0e_fTbOrGwqH6EG1pN8yH6YDKc2BW02W_X0ozlm4yHI2rzCptH0o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrjcM5YY_27ZqUNY3iqKFaNtuOra6keY4WtvS0HKGkmQ&oe=6A7C64E9"}, {"file_name": "Surgineer_Screenshot_3_2560_1400.png", "id": "462757105804908", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375748_462757109138241_4479486634400330080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Au9YBQQTqd8Q7kNvwHUtclX&_nc_oc=Adr2Cu5Yps2GGMaAx03j-pQOTIyUQtxY4r-7OnezIYxyQKuPFNj59-e3AUSEJky2Mes&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETikX3hhv630v-1zYNQJbWMV4gaF4Re_DyfInKnFcthg&oe=6A7C623C"}, {"file_name": "Surgineer_Screenshot_9_2560_1400.png", "id": "635014078033212", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75439593_635014081366545_2429816696528755233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKCtNEhBeDgQ7kNvwEFSTLD&_nc_oc=AdqY1JHDwRNaSOGnNZ8cwVWImxT91KkpY5DP9wx69DlSDCGCdHWMNlOhhNWX9glfMSo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvBXYBvxZbjwsA-V8xId92K_fGWR8gXxG2BrMnXc0KSQ&oe=6A7C50E8"}, {"file_name": "Surgineer_Screenshot_10_2560_1400.png", "id": "805770460545373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75481471_805770463878706_6927189540328422811_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4WIr_t0wJoQ7kNvwGhfl8j&_nc_oc=AdozYLfKJMtoGbMJ1Vk6xlP3NIvzP-BrvXfyXDVgOLx5qmPNEc9JeL9_nQq0l77WSwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTNHrzFxVXt38AvB6i6A2DY7_4Pcr5uXzmeJaBWQB6nw&oe=6A7C5C1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surgineer_2560_1440.png", "id": "973125724088981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031339_973125730755647_4446282231363403451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mz-8dOel-fYQ7kNvwF5bmCl&_nc_oc=AdqvDVVKJxYf5-kwQ2jet8ld4EbY4VeCdsqWEmGeblRjhFmS8qQfbbRYyTbpl9HksSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7aFoonmt6CUncpP06b7UfmEf46PyfgAahUO963xJc8Q&oe=6A7C4C63"}, "display_name": "Surgineer", "keywords": ["surgeon", "surgery", "doctor", "simulator", "gore"], "long_description": "Have you ever dreamed of being a real surgeon? Well\u2026 you are not gonna learn that here. \n\nWelcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor.  \n\nYou will have to solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nYou always thought you had that surgeon in you? You better have a bulletproof malpractice insurance before getting your virtual hands on a patient!\n\n\nKey Surgineering Tools & Abilities:\n\n\u25cf Use your hands with physics to dig in that flesh\n\u25cf Huge arsenal: scalpels, knives, syringes, drills, saws, rubber ducks and much more!\n\u25cf Defib the hell out of that patient's body.\n\u25cf Slap the patient's face with a fish, because why not?\n\u25cf Use an axe and hammer to crack down that chest and skull!\n\u25cf Transplant organs and limbs (even heads).\n\u25cf Futuristic lasers and telekinetic forceps!\n\u25cf Surgical Robotic Arm for very high precision procedures. Maybe.\n\n\n", "short_description": "Welcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor. \n\nYou will solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nSurgineer packs a combination of fun and challenging procedures.  \nYou will have fun cutting legs, removing foreign bodies and transplanting organs or limbs, but never forget that the goal is to keep your patient alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "HORROR", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27452877557661432"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031532_3164308107162577_536450320189810064_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IhmHy1yGxYQ7kNvwFyp9WH&_nc_oc=AdrK6ovHCoB3l9gysOTI5OQq084Y01ypZUBN9gLVapKRBoRT1GhsQMVyXWzJ-8_AUZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN5FbIFGK1FIhwvCYllNuAukM-avbJh-bgifGDL-uuJg&oe=6A7C514A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Surgineer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1666890021, "lastRevision": {"nodes": [{"id": "782300505823391", "release_type": "MANAGED", "administration_status": "APPROVED", "pdp_me
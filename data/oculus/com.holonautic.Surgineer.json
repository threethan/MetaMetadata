uQtEQ7kNvwGNjrh6&_nc_oc=AdrLjDek9pFEWxYiUcBDhZy2N394aQMdalATjz5aUh4sDwHmBuv8Z_s7HSuz0hRZArQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MMcYG5QMiannElpJ0lMlM4LlaxCKbjjsitGadbiaoTA&oe=6A3A8821"}, {"file_name": "Surgineer_Screenshot_11_2560_1400.png", "id": "5525412070872928", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75324645_5525412087539593_8209786052626508571_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPnxHHqAAhgQ7kNvwH46GMn&_nc_oc=Adq5svNG09McsDJ9GefAMtu-GP3yFNUQZDTZT2xWWa8tZ7uqn8qVz2JFFXe6LTxIWLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CqbiDU5c5MsC0BRtNiq_JolP3iMDVwzpwM7wAnTZUsg&oe=6A3AB229"}, {"file_name": "Surgineer_Screenshot_3_2560_1400.png", "id": "462757105804908", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375748_462757109138241_4479486634400330080_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2qxG-yRVVUQ7kNvwEchzj9&_nc_oc=Adr9ZohxaN98gsIum67K5IQqLCONBLHFoCIR_0ajpeHE8jggY382MR_vjuozMwl3XqM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t5RJfDkNMJmkMrSOeD4L8HsqeRIlbzvMC3Kg5UMf0Lg&oe=6A3AAF7C"}, {"file_name": "Surgineer_Screenshot_9_2560_1400.png", "id": "635014078033212", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75439593_635014081366545_2429816696528755233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iclk-tHsvdQQ7kNvwG2p1gU&_nc_oc=Adqhrr4rS_DNelHSEOEb1y2_QRnyLA1w2gCSvr5mudMp0lEcuCMBi18x3S0hO1Z8Wqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6Xumev4YzB448eNIm7GGCAxquivInjwHLrSI1mGmT9A&oe=6A3A9E28"}, {"file_name": "Surgineer_Screenshot_10_2560_1400.png", "id": "805770460545373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75481471_805770463878706_6927189540328422811_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-cKMLgbgbUQ7kNvwFgSG4s&_nc_oc=Adqg3-rV22QUA7xiGffCeZQ6eImLoAgmQsjxWLZEaQNgrwAwJfLVMzPAnE10uQ9pH14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nCu8y-v4V5yKkeGb_Vqqa-Bg3zuo6BpfO42VpAH87Rg&oe=6A3AA95A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Surgineer_2560_1440.png", "id": "973125724088981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031339_973125730755647_4446282231363403451_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wo4yWKY90gQ7kNvwEUCSYa&_nc_oc=AdqbCjdqJHl7nUfJVhl6KmErtdGIqCJvOYLxMs7qTgBsdn2F_jcDQV4raJPlfuU2Q7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u6Pchq22FGSDLfOC7zhDtl05pdMidCsBpWH-g-1h3Mw&oe=6A3A99A3"}, "display_name": "Surgineer", "keywords": ["surgeon", "surgery", "doctor", "simulator", "gore"], "long_description": "Have you ever dreamed of being a real surgeon? Well\u2026 you are not gonna learn that here. \n\nWelcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor. \n\nYou will have to solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nYou always thought you had that surgeon in you? You better have a bulletproof malpractice insurance before getting your virtual hands on a patient!\n\n\nKey Surgineering Tools & Abilities:\n\n\u25cf Use your hands with physics to dig in that flesh\n\u25cf Huge arsenal: scalpels, knives, syringes, drills, saws, rubber ducks and much more!\n\u25cf Defib the hell out of that patient's body.\n\u25cf Slap the patient's face with a fish, because why not?\n\u25cf Use an axe and hammer to crack down that chest and skull!\n\u25cf Transplant organs and limbs (even heads).\n\u25cf Futuristic lasers and telekinetic forceps!\n\u25cf Surgical Robotic Arm for very high precision procedures. Maybe.\n\n\n", "short_description": "Welcome to the most unrealistic surgery simulator where everyone can instantly become a terrible doctor. \n\nYou will solve hilarious surgical procedures ranging from CPR to brain transplant or even removing alien eggs from a poor patient using a robotic arm!\n\nSurgineer packs a combination of fun and challenging procedures.  \nYou will have fun cutting legs, removing foreign bodies and transplanting organs or limbs, but never forget that the goal is to keep your patient alive!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holonautic.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "HORROR", "MEDICINE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "439297564935740"}}]}, "scheduled_offers": {"count": 54, "nodes": [{"status": "PUBLISHED", "id": "1215893563591163"}, {"status": "PUBLISHED", "id": "759063913922699"}, {"status": "PUBLISHED", "id": "1163267022680286"}, {"status": "PUBLISHED", "id": "1267088028641232"}, {"status": "PUBLISHED", "id": "1427133798340409"}, {"status": "PUBLISHED", "id": "1811064729783607"}, {"status": "PUBLISHED", "id": "29267305752915156"}, {"status": "PUBLISHED", "id": "993697862121411"}, {"status": "PUBLISHED", "id": "947081587041428"}, {"status": "PUBLISHED", "id": "860741485903720"}, {"status": "PUBLISHED", "id": "855065053383585"}, {"status": "PUBLISHED", "id": "470381545512056"}, {"status": "PUBLISHED", "id": "708231974013841"}, {"status": "PUBLISHED", "id": "1378699112995225"}
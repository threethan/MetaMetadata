20f&oh=00_AQFKQtbJW7Jr0n30H6_kEnFCX-NCQ3x21IVhcKcOnJoUYA&oe=6A8D661A"}, {"file_name": "2.png", "id": "745832256099501", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75441578_745832259432834_6149206886171614054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSjcuVH5o6EQ7kNvwEzg3rO&_nc_oc=Adqdh7SYYe92u-TgrFJgMKwGzDttcEA5EJFxxF4pbyUEbWiwOCiwgvHlnO9s_0BdfR4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYXxssaLsUSTP-qhUB13kU0Fkwqd_68XTJmOjxd2k2Vg&oe=6A8D821A"}, {"file_name": "3.png", "id": "767418097481388", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75289720_767418100814721_1225050728314151888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUYONHmqURwQ7kNvwF-0SW4&_nc_oc=AdqTnb-FvxtU255uKIQ9ScG7semnUt1dmoLWLdWMDCdEStXi0nTSbtD9xp3nYiJZMV4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn9ZY8JonoKki9p42er75_7CtiffsH3BaQFhvHy2JoDQ&oe=6A8D83C1"}, {"file_name": "5.png", "id": "772838470285351", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75572752_772838473618684_7515280295499380483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6XTWdWxUyYQ7kNvwFYK7KS&_nc_oc=AdqLqwis0G6lIj8ZZUmmAyJAGxEqw4TI56pHwU0TtNFmww8QuyHQJNw3d63RzPzlT_o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuL5r1fyFwN3WNeLG1_JmzxVksLahGVf_t2khKxZwOjA&oe=6A8D7C5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc11.png", "id": "947269839428464", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75443242_947269842761797_6904528688601451475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnSUIjXCl60Q7kNvwEHuSzu&_nc_oc=AdopTSbO7M2M029MnXKEhAhzZZ0WrxbX6JFDPMXuq2pvZY2xg1Im4iBLz90HelFz3Kw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFv-8Eo8sSEd9DcZavTF3NF3-7qLgGMid12YoOiD-1c-w&oe=6A8D7874"}, "display_name": "Golf Pool VR", "keywords": ["Golf", "pool", "sport", "moon", "mini"], "long_description": "Experience a unique game that combines the challenge of Golf with the rules of Pool! Set in various beautiful and physically realistic environments, Golf Pool VR is a competitive and fun game you can play solo or with friends.\n\nKey Features:\n\n- Player vs AI.\n- Two player MP competitive mode. \n- Arcade mode with 10 SP mini levels.\n- Detailed and immersive environments. Experience the solitude of the moon or the adrenaline - rush of a game or two on top of a skyscraper! (To gain access to all the 5 maps, player must purchase the full game DLC).\n- Accurate physics based gameplay mechanics.\n- 8-Ball Pool (Blackball) rules currently implemented.\n- Additional bonus game modes.\n- Binaural 3d sound system.\n\n*(feel free to join the Community Discord channel to find other players and schedule MP match with them https://discord.gg/ZGAHEuA )", "short_description": "Experience a unique game that combines the challenge of Golf with the rules of 8-ball Pool (Blackball)! Set in various beautiful and physically realistic environments, Golf Pool VR is a competitive and fun game you can play by yourself vs AI or MP with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
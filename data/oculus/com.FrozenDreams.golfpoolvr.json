20f&oh=00_AQH6IPgN5h_ahJD2UJJKUhlg3zd_oWTbE0O8z-g6K8kGlg&oe=6A857D1A"}, {"file_name": "2.png", "id": "745832256099501", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75441578_745832259432834_6149206886171614054_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a926KhZR6hAQ7kNvwFqLASK&_nc_oc=Adp023BP_GMyUuNldhkwh-ZiP7V1ywRT9d3mCfvGqUCRlzVihu-VisBgB-n1BXYSD14&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7R94LJoupWHa4wYKyF0gADHdcjcOG8miNVwXZgwtnuw&oe=6A85991A"}, {"file_name": "3.png", "id": "767418097481388", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75289720_767418100814721_1225050728314151888_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2A61iPJHAoQ7kNvwHIe3ZZ&_nc_oc=AdrDM_6WI3T0yPRlCGl7RgcaSF8ZJ3uIYFtsEAzlSOjh2bgGVTJpVffTAibeRP-kNOQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGzKcZxvbnhp_Sf1azMjXgbCArv9eviiqpLrh3BrKd0Q&oe=6A859AC1"}, {"file_name": "5.png", "id": "772838470285351", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75572752_772838473618684_7515280295499380483_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf6SlNpQSi0Q7kNvwFGpRAP&_nc_oc=AdpbtaAdSWM4ZIyAa67ibGHxHQ_z_-Z3QRRKu8GdirGk19WCYBNd7c71uromf8nn9E8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5Uw4iUowEz6M2pPy0vA6cZtJfQw2PWX6Vv95FsXmBqw&oe=6A85935E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "sc11.png", "id": "947269839428464", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75443242_947269842761797_6904528688601451475_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqhzQ4d3GPsQ7kNvwFyey_k&_nc_oc=AdrfBNWpBdgtJiAlFBF8A2Q4ZgDOs1kRUEgaajVzFfVfZswekH8xuGOLDfCxdeJ9QME&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNK1vRtsps1z40x5zx2aoPxmCvVAhulbYTztymzux5Xg&oe=6A858F74"}, "display_name": "Golf Pool VR", "keywords": ["Golf", "pool", "sport", "moon", "mini"], "long_description": "Experience a unique game that combines the challenge of Golf with the rules of Pool! Set in various beautiful and physically realistic environments, Golf Pool VR is a competitive and fun game you can play solo or with friends.\n\nKey Features:\n\n- Player vs AI.\n- Two player MP competitive mode. \n- Arcade mode with 10 SP mini levels.\n- Detailed and immersive environments. Experience the solitude of the moon or the adrenaline - rush of a game or two on top of a skyscraper! (To gain access to all the 5 maps, player must purchase the full game DLC).\n- Accurate physics based gameplay mechanics.\n- 8-Ball Pool (Blackball) rules currently implemented.\n- Additional bonus game modes.\n- Binaural 3d sound system.\n\n*(feel free to join the Community Discord channel to find other players and schedule MP match with them https://discord.gg/ZGAHEuA )", "short_description": "Experience a unique game that combines the challenge of Golf with the rules of 8-ball Pool (Blackball)! Set in various beautiful and physically realistic environments, Golf Pool VR is a competitive and fun game you can play by yourself vs AI or MP with friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://frozen-dreams.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Frozen Dreams", "support_website_url": "https://frozen-dreams.com/contact/", "website_url": "https://frozen-dreams.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "SPORTS", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices"
/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y-ZI5l0iqxwQ7kNvwHj5nF2&_nc_oc=AdpDEMBVpe0NdRxx07370ZIP9Jxc5fAwjDPlkvQwAbCAromZNEWCAFLHu55N0a0Tcaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGDl4Mw4r4D8kHu-qwzXxW8opw21dLtV9T3IVrvAXyrA&oe=6AF1DDFA"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR8Hdv6kH6YQ7kNvwE-NmRc&_nc_oc=AdqTjXtGyMWuTSavQZQMFSueuiar9sAiEW32fJ8-qWbaAF3ZygA_3am-Su5CnAM_wVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrHGCHmON-I3jaMqDYF_raS3v38dpK0z-vGccSrJmmAQ&oe=6AF1D50D"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TECS03egFxEQ7kNvwFqn2q9&_nc_oc=AdqQYFIpAcPjvN7D8ZotflVCkfS8XnABvR-7WhG1FieZyTY-3yd2FuClL0UVAeVySO8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgMdf71D9wt08GZSL9AiqVICE3y65-oY1He_z0mBAYMA&oe=6AF1FC9F"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGXmalldZTAQ7kNvwEoDsQY&_nc_oc=AdrD9VawkuKXke0SABr55P1pbOOqF_QSqoAKls4DTEe3CjculrRdJcLp4IHfMCEF9cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg3gydJkndsnKE8SYXFir3BDPPu2K1Ztpt6QnHpLBYhQ&oe=6AF1FCE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZTANClM-9wQ7kNvwGBCQnz&_nc_oc=Adog9JIh1899jygvk3eo4jbOOPRfZ2KW1qYpNr9k9gorNyQe4Oobisu_I8Z6kuHFqGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG-lRGPJFYJfMhtHoTPEppBuESPd8hL4pwRi1qCztLKQ&oe=6AF20652"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
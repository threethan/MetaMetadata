htZwMS-lzQ&oe=6B005548"}, {"file_name": "scr4.png", "id": "1597214845280743", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1597214848614076_6095690427683379877_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmEMFfmQfaAQ7kNvwFXeMMR&_nc_oc=AdpCE9uMbWuTNAwDkJRGb3WAH7VSOvJhtko92vKzQ4gbppR07RFDPVlu21PBGd5-hUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDDZBwYK9anun52l7Bw0gK99tcNaRDaxvVcfBLDtqpZA&oe=6B005FC9"}, {"file_name": "scr5.png", "id": "1893488471988249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1893488475321582_1618616798082691446_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r5hvyZspbgQ7kNvwFmmU9g&_nc_oc=AdpCAlZqYG-TvtVFxh-aEedN7sKUv7agHN5kTYwpyk_dLmZx8anpmrSfzQDwxdlsLT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNiktavWqPb6q6c8Mt4suR-ou_gE9Me287RF4VQ2qruw&oe=6B005429"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "2554305748382321", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491829120_2554305751715654_2190212065413587792_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSGAvYWIKz0Q7kNvwGJAwA7&_nc_oc=AdqG2uBgT55U88s5S7n4aacJtSRs1udtp9nwCmS1yokPm7JRlWPMWd6FPQ_Q0IMZ3EQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2tz_xyIUfdTRO-uG_fIcVjGt0xdK-en1MgW79ut7MPg&oe=6B005875"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter VAMP, Video Archive Mosaic Player.\n\n# Massive mosaic wall\n- Surf entire folders instead of one video at a time\n- 240 videos @ 720p / 100 @ 1080p in instant mode\n- 320 videos @ 720p / 140 @ 1080p in overdrive mode\n- 8000 tabs autosaved per session, up to 8 sessions\n- Quest 2 runs just as fast with slightly lower video count\n\n# Built for flow state\n- Hover to play instantly, seamless audio transitions\n- Effortless browsing, instant everything\n- Intuitive single-handed controls\n- Undemanding hand-carried UI\n- Up to 3 hours of continuous use\n\n# Attention to detail\n- Pixel-perfect curved vector UI\n- Spatialized 2.0/5.1/7.1 audio\n- Fully encrypted streaming\n- Custom C99 Vulkan engine, 200 FPS on Quest 3\n\n# Soon\n- Streamer for Windows/Mac/Linux with autoconnect\n- 90 FPS 3D playback for any 2D video on a Quest 3\n- Room-scale and surround multi-mosaic\n- Controller-free handtracking mode\n- USB OTG\n\n2D-only by design, 4K max. VR formats are too heavy.  \nLocal-only. No login. No tracking. No entitlement checks.", "short_description": "Enter VAMP, Video Archive Mosaic Player.\nTurn your archive into a living video wall."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29107136218904339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_886063821106673_69983372182348499_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-xbp42rFzwQ7kNvwHxZsTc&_nc_oc=AdrpL1zH4ZGvsmWbbGnDFaAWZo-4qZGrplEsvaC1bI319UyX3jb4kq2ss3I4Majkbao&_nc
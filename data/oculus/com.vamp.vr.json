vwEgBJ51&_nc_oc=AdqIvHc5Od8615k0_nbUUSOQ7obYAX53Tn27hc3577EMzd_DBvDneQuQrDQREooap3Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiuqg-Zh80vUceP4I_akcev_PpzPy2ATqg3GBGwSaykA&oe=6ABE74C9"}, {"file_name": "scr5.png", "id": "1893488471988249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823837_1893488475321582_1618616798082691446_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_pN0SlD5ikQ7kNvwEKiK2Z&_nc_oc=Ado4wvK7n0wMUDt3sDuq28-GY0PhGUs45eP5qguDMT6qqDK887DiiYYtsXYTd72KSMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzdSZn_0fpgyYeXP0ZmEdpSGfiqZ6GtfYp4QRaGjI_CQ&oe=6ABE6929"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vampland.png", "id": "2059982851315751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823310_2059982854649084_2805052456947975701_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-HN1tpk0dAQ7kNvwFTrB-i&_nc_oc=Adq9iGr20RBrks_Luouj4jditzUuNYOdpTIYChzxxXyWHL0XYfae5Hhc_Kmmi9eCrvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWbEg_W8DJazOGIfMoMvF8V4mEiqacaYDuOMqK2MFbXA&oe=6ABE6A81"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter VAMP, Video Archive Mosaic Player.\n\n# Massive mosaic wall\n- Surf entire folders instead of one video at a time\n- Hover to play instantly, seamless audio transitions\n- 240 videos @ 720p / 100 @ 1080p in instant mode\n- 320 videos @ 720p / 140 @ 1080p in overdrive mode\n- 8000 tabs autosaved per session, up to 8 sessions\n- Quest 2 runs just as fast with slightly lower video count\n\n# Built for flow state\n- Effortless browsing, instant everything\n- Intuitive single-handed controls\n- Undemanding hand-carried UI\n- Up to 3 hours of continuous use\n\n# Attention to detail\n- Pixel-perfect curved vector UI\n- Spatialized 2.0/5.1/7.1 audio\n- Fully encrypted streaming\n- Custom C99 Vulkan engine, 200 FPS on Quest 3\n\n# Soon\n- Streamer for Windows/Mac/Linux with autoconnect\n- 90 FPS 3D playback for any 2D video on a Quest 3\n- Room-scale and surround multi-mosaic\n- Controller-free handtracking mode\n- USB OTG\n\n2D-only by design, 4K max. VR formats are too heavy.  \nLocal-only. No login. No tracking. No entitlement checks.", "short_description": "Enter VAMP, Video Archive Mosaic Player.\nTurn your archive into a living video wall."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29088267487457879"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823812_886063821106673_69983372182348499_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fM0SxhKZyHMQ7kNvwEmBpmP&_nc_oc=AdriISX7Q5-8XEEDrlW38QhNs71j0vt8uZBumZRUNUXOifRTNtxGWs0LUte0Q7N_R6c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO-MxjVTYSCu_zl3D-ky_ziQTLudEK5osBt5eSurHuew&oe=6ABE6407"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VAMP", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media",
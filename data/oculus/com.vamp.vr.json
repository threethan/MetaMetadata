ess&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_KmvcerqxoQ7kNvwGHvJqB&_nc_oc=AdqfcsvZ8RbndDW-Er07KwpA-hgMUMVGDjRd57jFNYHuWXWGpKylnwrWrhXYBjV9R1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8q4t3nZmZnd4bP_kfq4cvknvPpfHXQIIH6U6PGxE8PA&oe=6B032064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WF0_tg5Ul14Q7kNvwHWrGpC&_nc_oc=AdoSGR4jhH2qNzQ6wrUPBVtgT5O41VJW9uomHrtNUihmKhsp-U7MYn9TcRyGRaCyP9c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOBWdwTUDE0LbZg72U8m8drnZa6YRZC13DjpHh5s2cgw&oe=6B0329D2"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28967588942859068"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2945165849169977"}, {"status": "PUBLISHED", "id": "1080360008350156"}]}, "baseline_offer": {"id": "2945165849169977"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790342100, "status": "PUBLISHED", "id": "2945165849169977"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29090742107210417", "version": "1.0"}, "id": "1008263538898936", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28967588892859073", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29090742107210417"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794945896, "id": "29843465865271367", "version": "1.0", "version_code": 11, "release_status":
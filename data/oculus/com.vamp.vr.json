/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGfK1eXjzWIQ7kNvwHYSh0H&_nc_oc=AdoP4r31BJ6kWMdomAp9EG3ofskUKX1cQ2EQyx6bV7PBes5omhX4R3BGDHK1_JKmwnA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzmiIunqH5CM0UR-nVA9yRUcCOqiSzQBojQYEq5mVlTw&oe=6AC8FF7A"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-QwtYdHZw4Q7kNvwHlZif6&_nc_oc=AdoYosy3iSHcKrMcWYAureDy_vD2mcriV-qE9hfPm66_aaY7hkPObjGtCMKRFBlwF9E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiu9BeAhhm5a2zLCXpfHZfKHcWam3tEPBQa_f9rfTVqg&oe=6AC8F68D"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeoFaUB8Ih8Q7kNvwEEZxYY&_nc_oc=AdrOWZBrj28XBMFUHWw3P7dYdkwIXBebUajNo4vRnHcGZUnyMu2_MQAJb8AbBKWE4XM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTMn1iC56CdBHo9TwMzW_GP47wmdKC5Q30m2Xd11We3A&oe=6AC8E5DF"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dzU4ftQ4g0Q7kNvwFjXKtN&_nc_oc=AdrEcLmsmyWBegzkH6OIcGp-cjMskQtXYmHqnktceg_Eig72jhop6__4ifvc5ggc80s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgTTpNE1ov9kVA6zhSsQaj_6jWWAV07sofw1F1z8ouRw&oe=6AC8E624"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ez2xPnKAEwwQ7kNvwFKpDX1&_nc_oc=AdrVSVqRwGoA7COgj4CaKOyC38345eWvfFgJrvKx18xFvw5sMatKIQXI7IbbZeM9zyg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXM54uRlKltcmg3Rksj_T4qKQXZzKeIDnvsCrX08jrNg&oe=6AC8EF92"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
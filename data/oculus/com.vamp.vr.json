/491824671_1426114649470077_2881832346439172562_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWkMGuKMMrcQ7kNvwGkwXtD&_nc_oc=AdrKHUypwlYPASYF37yH_w1UtRlNwoZUuovwYNNbaVSfjQ07mw6O_j01h-I3hUVkCNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCydChMOuvz2c0tjz5OlhoRjRE468YBh3TXA4m_1HRkA&oe=6AB7DE65"}, {"file_name": "com.vamp.vr-20260921-030522.png", "id": "1791609982262004", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_1791609985595337_882418224292724220_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwTw6hQUyugQ7kNvwF_z3W1&_nc_oc=AdoY__YA-HyY02_lB2tdIsssq7GIgTFyQFmlC05PX514nryW8WwRPl--RGsK5FSTl14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTFU9kWsBdtekNGZ0M1ipe1NIjdOXEJFu0Zv97Xnu0dw&oe=6AB7E4FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "shot.png", "id": "1377753144147508", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824665_1377753150814174_4447182158532185371_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9AUaHZYjc0Q7kNvwGIcwua&_nc_oc=AdoAHEQvVQ_ESrAv8YGBcgwUCkoNe3oaoCKneSDTk6lsJ6Mksn4pnBiifwe0Mo6ez4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXyj5VsEa2_OXnDZE4Nf_aqXMC6VYMcFYCUQNRMeJA-Q&oe=6AB7CCA2"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Find out how many videos your Quest can play.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Simultaneous video playback with adaptive rate control\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Find out how many videos your Quest can play.\nTurn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29014738288144133"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_886063821106673_69983372182348499_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoJr16kcr8sQ7kNvwHPW9sn&_nc_oc=AdoSLYf5J4379H8bAWs76R1ZH-Na3fBOv69HY_CJFV-Pc9bcwOtAUEblPz6jeu2_oi8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY2aqo4rg92wQ_jcprRZQ9DKEqxIP7ji4BtniyECkoMQ&oe=6AB7CC87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VAMP", "platform": "ANDROID_6DOF", "conte
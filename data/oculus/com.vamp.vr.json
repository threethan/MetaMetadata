/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Je86D6rctsQ7kNvwG_PmGg&_nc_oc=AdoOzeJPqtwlQe6UPqDm_rIIR5-ceIlccpIjFVVKFn0WcM2kw3W2SnpFsVGbesO8bzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsKGjvEhEbnEMvvliitZRzHkEL3I_SehHZVFUokNuv3Q&oe=6AF8ADBA"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyZvSj038tQQ7kNvwE7G6P6&_nc_oc=AdqVy597KB3hHi-R4wP7zeUIjIMGNR3rUWFaHzRd0k9GNExV14faNiTf4GXzUVvCHA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzLPmM_wEexA4oeB9N_X2pYOPHowVCcNw8i0RZYzR1nw&oe=6AF8A4CD"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBviSI1e1vAQ7kNvwH7FhKo&_nc_oc=AdoQanTgEanJvobyZBJVgPHszlThuAUrBcKzoRJ3zaZPp5GMMy-8Y9MOHPepBObJOSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3ZkM1r-zIB8AcfoKa3OUCObiFS0AYjGLGndS9K1Ty1w&oe=6AF8941F"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKRonTC5FmQQ7kNvwGF_Weq&_nc_oc=AdoN4sH2fNghwQSKXiNW0j2nxZ_TjHto-rJakw29gyYn5Punz9J4d0pFls6OPq9uN3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQap8glgs5OUhwT2fK-ribZoLiho6zuwNMSgA_o6FoQlA&oe=6AF89464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HmSUdcAQYkQ7kNvwE_KUht&_nc_oc=AdrTtj4u-Ux9jRm9eRpf6isNRQ1-TnW1Ss2EHWM0SaFRvUEXtKmk_KoLIZaP-h5nEHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbpr4xaDo4wLhHabJU0mNnyMR8fnch8-FSVCneZE9Zug&oe=6AF89DD2"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
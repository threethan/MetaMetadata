/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uGfK1eXjzWIQ7kNvwEK1B5U&_nc_oc=Adpb2HU9SZUWCDfx4xsmyThyOm_ajQ-Cl-_nabOX39QsCrWssq-gS66ylcd0lM-tWvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLDzUj94p0dp8Fhg_u-MUR_ZxRyN6FMx8JsrEIXaZV0Q&oe=6ACBA27A"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmYTzV2ZpdwQ7kNvwGrLAmm&_nc_oc=Adr0o83ySr6ggs0UHHTs-iuMK_2pXV8hisn4zLqBNLvdtmV0L_vwXUq3fi07TV5Haow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrjpl3W4s_BD75U37wZZggvjekS1FXzhMPFjWM-sMceA&oe=6ACB998D"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPDyDlP8P8UQ7kNvwGOa3oE&_nc_oc=AdrGpt4SPvh61ryvI-empg0aOqOMgMssaBHh0Tpvm8jlAuH1xgi7yDxzD1S945WOq_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWTtCdmN3a9ukS_p_9ResFi-D7Sx41jf1vyq8icBnSwg&oe=6ACBC11F"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dzU4ftQ4g0Q7kNvwEbKY-a&_nc_oc=Adqf3MeUtRTmap8aCug9cA5c-MKjqrHGtIXnaR1p7bO1IsSS1fhf5gnxCHL8KdJopW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHhYUP-rjIYpS-7jP_GYGOnGnButWJPq2n2b2tTsQSmA&oe=6ACBC164"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ez2xPnKAEwwQ7kNvwEe1nqT&_nc_oc=Adqpw96BTi0GdRP0vxLe3cFnOay11EMB_w-4K2OB8NV4L7x_uRsEfyCaQZQC1CruPw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiEb9AXOQd_4QrPCuf4ODALnCGw-VMvnPaG9xoFcMzKQ&oe=6ACB9292"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
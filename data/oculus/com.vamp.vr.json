mNq1QsTZcA&oe=6B083E48"}, {"file_name": "scr4.png", "id": "1597214845280743", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823310_1597214848614076_6095690427683379877_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbGGPU4dYAwQ7kNvwH301Ux&_nc_oc=Adon99NJzYN1cBP9PZUn6zPP9sLmcyJfuIB9z_wDNB0g-uxADeO74XPHUVXL_IoWfKw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj63TGTIxyA5JbGi76cAgxSz3EzZ_TXTHPwsyjCioz2A&oe=6B0848C9"}, {"file_name": "scr5.png", "id": "1893488471988249", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823837_1893488475321582_1618616798082691446_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjWUCZ3jNwUQ7kNvwHCMoPz&_nc_oc=AdqvxdDuFSQ2HfTS0OM4-gFlyqll7cAau-yoYXVamawYJR266tBGBSpilSAl5xN6UxE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0Jpuxzl6w0d8R77BtYb5PHm6fBLEwmDIERhMN4i6Nvw&oe=6B083D29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "2554305748382321", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491829120_2554305751715654_2190212065413587792_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-F6d3tlhwEQ7kNvwGQ4g9C&_nc_oc=AdqISuxOp6UK7Sj2rsXkEgR4QgBfEJ7LleKsFOZgmEUENNq-DEuFqlqek86y3xQxvI0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx7MFfo_z2kzaglJ2sNYuZ-NsG6ojf1kT7S0J9-VoOdg&oe=6B084175"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter VAMP, Video Archive Mosaic Player.\n\n# Massive mosaic wall\n- Surf entire folders instead of one video at a time\n- 240 videos @ 720p / 100 @ 1080p in instant mode\n- 320 videos @ 720p / 140 @ 1080p in overdrive mode\n- 8000 tabs autosaved per session, up to 8 sessions\n- Quest 2 runs just as fast with slightly lower video count\n\n# Built for flow state\n- Hover to play instantly, seamless audio transitions\n- Effortless browsing, instant everything\n- Intuitive single-handed controls\n- Undemanding hand-carried UI\n- Up to 3 hours of continuous use\n\n# Attention to detail\n- Pixel-perfect curved vector UI\n- Spatialized 2.0/5.1/7.1 audio\n- Fully encrypted streaming\n- Custom C99 Vulkan engine, 200 FPS on Quest 3\n\n# Soon\n- Streamer for Windows/Mac/Linux with autoconnect\n- 90 FPS 3D playback for any 2D video on a Quest 3\n- Room-scale and surround multi-mosaic\n- Controller-free handtracking mode\n- USB OTG\n\n2D-only by design, 4K max. VR formats are too heavy.  \nLocal-only. No login. No tracking. No entitlement checks.", "short_description": "Enter VAMP, Video Archive Mosaic Player.\nTurn your archive into a living video wall."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29107136218904339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823812_886063821106673_69983372182348499_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvS2KrcOKBEQ7kNvwGvd_-Z&_nc_oc=AdrFdo1BpMMLb2iVU9JvopvRpLibva6eArHNZojso4NVLoYX7AjFprgKU9tRTyTyucs&_nc
/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IlnFvXk--wQ7kNvwHjqSZ8&_nc_oc=AdrQHPlcbYNYoXhd7EQhYRTXdc-MHu92Hlew-cL875F6kevs8CmtvPF-cM03tCtXCQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMntHRmNf23l5Edy7WA00UWQwH9uc28rDKrX-jZVufsSA&oe=6AC65C7A"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7KErmvGwXYQ7kNvwHlt6Jt&_nc_oc=AdpwDvzktCRZDx60e0GMKM8NBP8HZ6GLEY1PeZ1RtPNaouKdd37u7Z4au9IJd1uEfDE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqECwA-rDyF54zn8kiGiDs-ZM1zObvATdz5iLeYc6tKg&oe=6AC6538D"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRDJ4IrF2oEQ7kNvwHSD7v-&_nc_oc=AdoYR3_IyAIW91IpIxFnccHw30NEiibrfUpU3OA2T1jy3k7I04pN8CW9W7yWA1gYH5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBRk3eiNDGUpq8d_-jl3ppwBk_6VRwmHznJzSaHVr5cQ&oe=6AC642DF"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aAOjbGoas1AQ7kNvwE4AHpv&_nc_oc=AdrwOsVNmpqqZt6mojTC2UIIUrBTbWVuqVW3KzPEbDG3LPfgxhno3yn8FkT4nzoEvGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkpN-Rhb1bh8LwNIm4_c63dXVoVBGBUXBkRAqK9MGUXQ&oe=6AC64324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9MJVjlWnKwQ7kNvwFVRUfq&_nc_oc=AdrCCGhW7olUNLjypxjKVh_dNQ1fTb9zz6BBTwl7IF-98986VazIB1fmb2gohc0tlG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0lHwjClwPXOcAY1DVmdKc_4Q3tRMoeJbvIBGYHmgs4w&oe=6AC64C92"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdlUzea9fzoQ7kNvwExrp_Y&_nc_oc=AdqZigVA8tcsCKg0MIZLTqR5ysPeGx52wyyCzSb0M8sBug2YrXJ89Afb9KxRPANxBLo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8mO0AusNoi8SLbgJP-x1BsmLQdTni16LTo5cgTD3JIg&oe=6AE35D7A"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-abrq8rtuZUQ7kNvwHCB_nb&_nc_oc=AdoTXXCdQndjY2Z1y9JiV25_9wGCitjdSk7iJfbI0bscJU3Ewy3ceYRXbNCHz7n9rg8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_3EH0xubQNE7UR5CN89PVLIKjDRT232lwvpNzhP2-nQ&oe=6AE3548D"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwxzEis5CikQ7kNvwHSmf5O&_nc_oc=Adrwdb-RAf3V84kts4LUCuN8OwnGf6fWCoVP7GyUqpaZ5cokqM5mBl3Li3TG8khTpuQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGbonr6L-goM2PzWXgYghjxatLZ2c-L1pKFFgzLXfKMQ&oe=6AE343DF"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyUNPZOVSEQQ7kNvwHFHHmp&_nc_oc=Adp7i9LJBXjQ6ejTHlRxtx9kY_fnyaHjrqVJpIDqDjY6muQ4PR8BtQTeC24E1hvMHro&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkQMZd6mV1Gf-C6fQDX3dzq1l6Nc5oUWuH_3msU8GJqQ&oe=6AE34424"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QIDKjLjc_MQ7kNvwE6CGC0&_nc_oc=Adrtaxk3JZ03r6-hfiHYs0YfswwyaU7h983JGvnG3RzF4MiUgnFz7xjCqH_VNP8juLs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVwYdCle3MzhoSstMCgsX2FksKYMp_T1NNOJW4G5gkmg&oe=6AE34D92"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
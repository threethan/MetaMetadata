/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NekU42kQLycQ7kNvwFW7Tvl&_nc_oc=AdpSx-1IJEYNCv7FtFQWvj28teZ4fn0ZYbcM2xECoIX2-08b3OwvMBN81LQRBjdyYEo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZLA3sg4ZRNVhZiL088ZM3KskRKQk8ZZf4TguwCmQF0w&oe=6AEC97FA"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hA91-KRjLJUQ7kNvwG2PLTC&_nc_oc=Ado_HX40ynmBrQj3gSVuvp7qw4jdEStsdq9qxkVgh8N3sPW1spafj2c038KroDSKCV0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrWzVCwZU1buOvGd6GWztl56JFxMMyFQqskSBu2DIEZQ&oe=6AEC8F0D"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U146Udf0C7IQ7kNvwGzGkuk&_nc_oc=AdqN75yDNOjwRmG4UV43S1lHvLHr5rByMcZwPJer-YX3bb-Ylochr17WOAgwDo75mGI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK1hECnp-BRnVNaZ12hmZZ2ZXfxqE5YufhJD4EQ7EiMA&oe=6AECB69F"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxV1aQ_y330Q7kNvwHUDM4A&_nc_oc=AdpZY2pH8ovj-xIZ1ROcqKDmKT3rioKCbNhx-7FlydCB200zf6q4F52C0dmkpYdq2rU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh4veZif0Wi6DIhFfPDjfkZi_VwGNGWq0eW8asF_ig0Q&oe=6AECB6E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikTdmXTfD40Q7kNvwGyqFdg&_nc_oc=AdoexnJZMPB8wj6VoYHL55tZi33yO8VZWtxnn-xS3q5MBHKavfme8XtbjkgjLsZr_gU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6MVHF-sB0kk4fWfjgBUQOiG8c6Jl7N-LNdkLGkFUayw&oe=6AEC8812"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
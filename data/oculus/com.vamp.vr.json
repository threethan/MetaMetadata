30d2TEnNow&oe=6AFB4788"}, {"file_name": "scr4.png", "id": "1597214845280743", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823310_1597214848614076_6095690427683379877_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFlSUJhRdwcQ7kNvwGyPHYZ&_nc_oc=AdphLaorrVi2bVaAV9YlRZazX0hZSTHeodbNV3t6abkuk3fNJ91lY7JGd9MQz9MqNJs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8iZZwRj8_ke0ieD0ou_EFAG9qTQe43VdGiHmY6NizQQ&oe=6AFB19C9"}, {"file_name": "scr5.png", "id": "1893488471988249", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823837_1893488475321582_1618616798082691446_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NalVgNKmJvoQ7kNvwFuec53&_nc_oc=AdrR7gru6WQY32EwGH0IlA6B0Q-AZX0a6q1Ks52nDrlDG-LtR4va_2D5btF4Rpw7zs8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMPuZMryEixgDqp2fysmsIzTCaTnbQpgXj8SD1t_pLlg&oe=6AFB4669"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "2554305748382321", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491829120_2554305751715654_2190212065413587792_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVM9v9camX8Q7kNvwGn8yN2&_nc_oc=AdryKWjXAryoXUhvvLEq2dE8bQTkFp3xL8RtQXqcy1cXbdABfsaAtxatySIGy0jfENc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqyLc3mhOY6KZwQOdb_ZLNmULNPi6NT5VnjJ7RvkY5Mg&oe=6AFB4AB5"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter VAMP, Video Archive Mosaic Player.\n\n# Massive mosaic wall\n- Surf entire folders instead of one video at a time\n- 240 videos @ 720p / 100 @ 1080p in instant mode\n- 320 videos @ 720p / 140 @ 1080p in overdrive mode\n- 8000 tabs autosaved per session, up to 8 sessions\n- Quest 2 runs just as fast with slightly lower video count\n\n# Built for flow state\n- Hover to play instantly, seamless audio transitions\n- Effortless browsing, instant everything\n- Intuitive single-handed controls\n- Undemanding hand-carried UI\n- Up to 3 hours of continuous use\n\n# Attention to detail\n- Pixel-perfect curved vector UI\n- Spatialized 2.0/5.1/7.1 audio\n- Fully encrypted streaming\n- Custom C99 Vulkan engine, 200 FPS on Quest 3\n\n# Soon\n- Streamer for Windows/Mac/Linux with autoconnect\n- 90 FPS 3D playback for any 2D video on a Quest 3\n- Room-scale and surround multi-mosaic\n- Controller-free handtracking mode\n- USB OTG\n\n2D-only by design, 4K max. VR formats are too heavy.  \nLocal-only. No login. No tracking. No entitlement checks.", "short_description": "Enter VAMP, Video Archive Mosaic Player.\nTurn your archive into a living video wall."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29107136218904339"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823812_886063821106673_69983372182348499_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDXCQC3q4e8Q7kNvwERaPqp&_nc_oc=Ado5AEBzY5Y-AgUhHYUraIkaC8eKhbJ6C1gSgg2Qe2lMjI-PbecuBdU5LR-MDhOF2bs&_nc
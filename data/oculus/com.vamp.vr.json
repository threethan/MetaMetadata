/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdlUzea9fzoQ7kNvwE_TFkh&_nc_oc=AdrH-DX3dnUU51epCY6-_xd0uJNK8772zyun0Ok-YPjQz3_68L9E4LmWd966XO0uqcw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcBz2aF8XHDtfrXacnw_bZWDYp294fFQmy7TQAh96l_g&oe=6AE20BFA"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-abrq8rtuZUQ7kNvwFCYla1&_nc_oc=AdoxIfstsYD-AyAFfIbYgnbEWKnN9YKxHDqwmzdoJsXC11yDWe7lGZM3uxCowxbEKjo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2CIRKGfmFjX8bWprZ_X9VPICibiB11MZAwV51FNDuCQ&oe=6AE2030D"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycvsLE_WPOAQ7kNvwEqtdTk&_nc_oc=Adp-qGicj2H3w2yPbg6GIbCo83LbvyhmlVcSyTY3uLawGxIVlVlZ22S0uAUyCTRtLHk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOi8pP4VeS5XYeNtcbymgRIl8uZJLC7rzE-aFo7Sja4aQ&oe=6AE1F25F"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyUNPZOVSEQQ7kNvwFTGGid&_nc_oc=AdoLODJE73hrxPL06avhxp73f26x1Nh4sfZiLyRVrmgYbpqnAWn9xRlyP1e3-3C2Gs4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAzGgtyo7XWvCNKrPF06QAA4mJnDEaPECIrF7XwK1v8g&oe=6AE1F2A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QIDKjLjc_MQ7kNvwEojPoA&_nc_oc=AdrjX0IONjn0ak2bKfrszg35I1JrJ25lssrgDd3Z50zBl8HcdZTJqguRWjaxEz4ZfBg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO59fvvLXovR4NQW_GFbJfilEflfV7e9q33bW3aGz8xzA&oe=6AE1FC12"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
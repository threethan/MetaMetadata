c_ohc=9GCtKaGVDbsQ7kNvwHUbFPR&_nc_oc=AdpHjzMLa_nBVcZ5lUcUzJ9HJLUe4CSW2W7S2QZZGyzsU7PfIzcJ75O-Tatbe95b4wo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtCXjRcAlVJDWgf5wqxiuI0TCRDbHKbYtY3IxdW7XZ5w&oe=6AB51F5F"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCBIEW6Y8eQQ7kNvwEEUh4A&_nc_oc=Adqu7rc44Pv_U1k8_vwKq22OkTiUv1CB2XfvNM0D-n9dWxo_J869TQ12dGuWmwR739c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL32F0Of9SSiszhSMlWH_sjYqZ_6GDnOCUpTMgWt5hBsg&oe=6AB51FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Ofk01zyxjAQ7kNvwHha902&_nc_oc=Adr4VLctXaQudgzmS8ZiXnCOeeMCCele0lIilHYKPR8SRQ--T2A9C-PRbL60hzSfglw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInicJIhsdQiDwi1y-XHVbjKvlQTS01HhQ7SY7MLQ_jRg&oe=6AB52912"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Find out how many videos your Quest can play.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Find out how many videos your Quest can play.\nTurn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29002182126066416"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_886063821106673_69983372182348499_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ulgi6zGP3Z4Q7kNvwG6KUMk&_nc_oc=AdqHodRVWbyB9podliYfY6v1iKgtv3mi0cEIvSHzL88kKJkpG2sjFW3iaVRwKJUPdFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJydOhzs5YVwAV4kR6DCjTKZMwgdw_Z_ER_06RHow7HzQ&oe=6AB52987"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VAMP", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": 
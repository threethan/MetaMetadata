4755372_47248972299762761_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Eh9VCJy05cQ7kNvwEBjwwc&_nc_oc=Adpjdnk-rILU-umoUbGbz5q7YlIeYQFlhaQWuXarxGZ1aQ-4BKGJW1KbjyMQNUx6ljM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlXmcmh1dig7l_qF-MVLKpF2sIiCvj3HxbjIAuUS6AbQ&oe=6AB90C55"}, {"file_name": "com.vamp.vr-20260922-131814.png", "id": "1084244297544601", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1084244304211267_3231030667612266466_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMGJGDt7l7gQ7kNvwEkS_EF&_nc_oc=AdrgbbMxY0E8uS0Nigk9l4t030PIQbukEw3APPIkPakmLh0ZK_gklj5bXR8ewTs2EDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJanDFwCGGBCSr_-ZvKVBNx6TwlIFowzZs_XCttR24BKw&oe=6AB91730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1118328217201105", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823259_1118328227201104_7522177076173174846_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IrYcdA5feEQ7kNvwGGEFOk&_nc_oc=AdoF9oOqTNz2x1L8MjkK4nKuoN-xHEVYk8joRY1h8NzKa_QMJxuve88v_3RwB2sfRpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQKWgCTJ5vTO-6yTY8D_SmBFrOX8ZQUAMQCzqC4uMx4g&oe=6AB93E5D"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter VAMP, Video Archive Mosaic Player.\n\n# Massive mosaic wall\n- Surf entire folders instead of one video at a time\n- Hover to play instantly, seamless audio transitions\n- 300 videos @ 720p / 150 @ 1080p on Meta Quest 3\n- 220 videos @ 720p / 110 @ 1080p on Meta Quest 2\n- 8000 tabs autosaved per session, up to 8 sessions\n\n# Built for flow state\n- Effortless browsing, instant everything\n- Intuitive single-handed controls\n- Undemanding UI, forget it's there\n- ~3 hours continuous on a Quest 3\n\n# Attention to detail\n- Pixel-perfect curved vector UI\n- Spatialized 2.0/5.1/7.1 audio\n- Fully encrypted streaming\n- Custom C99 Vulkan engine, 200 FPS on Quest 3\n\n# Soon\n- Streamer for Win/Mac/Linux with autoconnect\n- 90 FPS 3D playback for any 2D video on a Quest 3\n- Room-scale and surround multi-mosaic\n- USB OTG\n\n2D-only by design, 4K max. VR formats are too heavy.  \nLocal-only. No login. No tracking. No entitlement checks.", "short_description": "Enter VAMP, Video Archive Mosaic Player.\nTurn your archive into a living video wall."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29049374741347154"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823812_886063821106673_69983372182348499_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoJr16kcr8sQ7kNvwEzsqte&_nc_oc=Adrfr-ZznSo4elWTj077QXEzWFcXYdUZPMUNXk7tfsR-e32OoREwfNlj8iS-N4TWZq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyUp6_DlVVwwPMLgQFwgRxLgdSCH9OAHaobg-U-3kgRQ&oe=6AB91E07"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VAMP", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_na
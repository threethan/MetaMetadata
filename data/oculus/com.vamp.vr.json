/v/t64.5771-25/491828583_1616484640069087_1366610883415199988_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2rKEZBfJjAQ7kNvwGqqTQI&_nc_oc=AdpyWtikFfM8NNAipjGBeumlomXJaq0FPwrNyzTI1QhurD5saqpZepPUZOpNq10uNOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjtMb4G36aAHYACi8R3X94g5mJrp2eoVJNjKgfiiagbw&oe=6AF480FA"}, {"file_name": "scr3.png", "id": "4561915367470604", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_4561915370803937_896150987988315646_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imYN4TVu5sQQ7kNvwFyWYjC&_nc_oc=AdpJYPh-EFJxVkg9-EOg0Mfy_OgcRpFof2o2qJ1z6WJM64muAOCJytYSXD54bRSW3UU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ964DO_ELmq_Ecj02X2hAE6vtNXyE7_hg9Le6-P3Ufxg&oe=6AF4780D"}, {"file_name": "scr4.png", "id": "1019349514481676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_1019349517815009_2839332189634321851_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYyShWabWjEQ7kNvwGw0uxU&_nc_oc=AdpmJyCozN10Nrwqf675jsRepiXYNTwPSYQvTOfjSiR3WTrrCKSkj54DjHaoK7WCHWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7-I4pYzmTUKu7F2qaj5qTUeRogdb7qrOYxisIr1nxxA&oe=6AF49F9F"}, {"file_name": "scr5.png", "id": "1056371863942166", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1056371867275499_901103097543061613_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOyfwlso6VYQ7kNvwHXv4Yt&_nc_oc=Adri-E-OQVW0qs0i6ax_TQpb8-KSliI0lBXPtRyv3p-WznsDHc5Kueka9Gr-Zi9WFBw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuQnYrvGl_Au6BKSCCInkjIBXMmnluakrM06PD_T0emQ&oe=6AF49FE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vamp landscape-son.png", "id": "1046986714636809", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823310_1046986724636808_245342418546449416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0CK5sI04FUQ7kNvwGkc2XW&_nc_oc=AdrpfLc5fZeQ35U_QdAlRPRUMpUkaJ1kUKDqHschWM2D3H7-oE29ezu_HSLq8svZ0e4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-k6hRYDnre2X6P1ihPQK8lHboWlar8aCixQmQBOl1bQ&oe=6AF47112"}, "display_name": "VAMP", "keywords": ["vamp", "video", "player", "media", "archive"], "long_description": "Enter **VAMP**, Video Archive Mosaic Player.\n\n# Features\n- Massive mosaic wall, up to **300 videos (300@720p, 150@1080p)**\n- Hover to play **instantly** with seamless audio transitions\n- **8000 tabs** per session\n- Intuitive controls optimized for **effortless flow state**\n- Hand-carried **pixel-perfect** curved vector UI\n- Fast-access XR passthrough\n- **2.0/5.1/7.1** surround audio with HRTF\n- Custom C99 Vulkan engine optimized for Quest hardware\n- Low battery draw (~**3 hours playback**)\n\n# What's Next\n- **90 FPS 3D playback for any 2D video** locally on Quest 3 \n- Multi-wall setup (up to **5 surround walls**)\n- Streamer for Windows, macOS, and Linux\n- USB OTG support for external drives\n- Subtitles, bookmarks, and video looping\n- 180\u00b0, 360\u00b0, EAC, 3D (SBS, TTB) and 8K video support\n- Image and music support with background playback\n- Ambisonic spatial audio with custom speaker placement\n- Headset audio streaming to PC speakers", "short_description": "Turn your archive into a living video wall.\nTile up to 300 videos, hover to play instantly.\nEnter VAMP, Video Archive Mosaic Player."}]}, "developer_name": "BAZED", "developer_privacy_policy_url": "https://vamp.video/#privacy", "developer_terms_of_service_url": null, "publisher_name": "BAZED", "support_website_url": null, "website_url": "https://vamp.video/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_
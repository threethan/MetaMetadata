etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVSnBPnnT1sQ7kNvwFfNCNV&_nc_oc=Adqdt7fwa-Ogg0lTos5ppy3VA-yjaNX43u-e30XXCe_JQXpDteduAiFzarzw0c5VO2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc0yfTZdxTADwsbWOUSRx5ufPAtQJpmCihBVh_jnjpMQ&oe=6AFDD246"}]}, "id": "1595866875277193", "locale": "en_US", "screenshots": [{"file_name": "VRCPR_Screenshot_1.png", "id": "3559912607479531", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619718_3559912614146197_8513385910282271560_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_xhU3Rr_EwQ7kNvwGk8Hr1&_nc_oc=AdpzC72HD7AQ6e4VdxYyqiHktxB2Zj6ZOEeRWG8Eick3bMAhIGOSy9ZbF1tcKIquYMI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpcqTFNnkff46NYS30sjkgSVqr21CokmDQjdj7JCw9ug&oe=6AFDE18D"}, {"file_name": "VRCPR_Screenshot_4.png", "id": "1336349304494156", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622195_1336349307827489_6195377804226398508_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFynYi9s74EQ7kNvwH2mx7X&_nc_oc=AdqaasvuM8EfxgbO-WLCfBNAdvLVOejPY2YAO9lK6kfMVat7EkYmDlTctiM9-mTGQaY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYfP5iCReCTp3v426vEzVyJVATbdzl3DuP5m3q3Mohsg&oe=6AFDD0CC"}, {"file_name": "VRCPR_Screenshot_10.png", "id": "1272181674279312", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618038_1272181677612645_7844741463771351115_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Twh0NBPz_K8Q7kNvwG9Q4-c&_nc_oc=AdrIUWfy0T___UVkdTOpEhPMiIwZxvhExzgLeCSdVH3gYBH-2u4m4USVTr8mwReN2ZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLQmXN0a9NHExOUQRnywtKyeTIUZ1TUKVu97Oh3Ghh2A&oe=6AFDDE6A"}, {"file_name": "VRCPR_Screenshot_6.png", "id": "605143765562903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618361_605143768896236_5018074210652933878_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IjTXenIeAaEQ7kNvwFhkDDq&_nc_oc=AdpCOsfll2w3BlYa3uMsflYtwrUETEXjIXuPnWWnHUl12UrQffcbLtrHH053sPcZ3U4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl9nXFYCTyEr-j5p0Nq2FLW6hEWGFE4hg45pS-PeHgBQ&oe=6AFDD2DE"}, {"file_name": "VRCPR_Screenshot_8.png", "id": "754937146936295", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831964_754937150269628_7146354273238768755_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RONtlE1u1T0Q7kNvwGIz4gB&_nc_oc=AdprVB8MqeGYjfhmVSEuA5T-XkLje2KxrqhaPYHFrzVWloyxqyhwkAuPOLi6QCZoIKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHFTDQ-a4SwXLwA9Vj9PRM6bC5HQQ8-GDchpY0hMoTCQ&oe=6AFDD626"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR CPR", "keywords": ["CPR", "first", "aid", "ALS"], "long_description": "**Resuscitation training you actually remember.**\n\nVR CPR moves CPR practice out of the classroom and into the moment that counts. For the general public and for professionals.\n\n# Three training tracks\n\n- **Public.** Bystander CPR: recognising cardiac arrest, calling for help, compressions, rescue breaths, AED.\n- **Rescuer.** Professional BLS with correct technique, timing and handover.\n- **ALS (new).** Advanced Life Support per the ERC 2025 Guidelines: rhythm, defibrillation, airway, drugs, team roles, reversible causes.\n\n# Three patient age groups\n\nInfant, child and adult. Compression depth, hand placement and ventilation all change with age, and VR CPR trains those differences.\n\n# 10 environments\n\nCPR in an ICU room is nothing like CPR at a poolside or on a street corner. You learn to adapt to space, bystanders and noise.\n\n# Train on any manikin\n\nReal chest compressions on whatever CPR manikin you already own. No proprietary hardware required.\n\n# Optional SimCPR\u00ae sensor\n\nConnect the sensor for precise measurement of compression depth, rate and full chest recoil, with real-time feedback and objective scoring.\n\n# Results and certificates\n\nEverything is saved to our web platform: detailed scoring, progress over time, live screen sharing with an instructor, and a certificate of completion.\n\nFor schools, hospitals, emergency services, corporate first-aid training and anyone who wants to be ready.", "short_description": "Train CPR in virtual reality, from bystander basics to full ALS per the ERC 2025 Guidelines. Infant, child and adult patients across 10 environments. Optional SimCPR\u00ae sensor."}, {"images": {"nodes": []}, "id": "1007209648786046", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR CPR", "keywords": ["CPR", "ALS", "Erste", "Hilfe"], "long_description": "**Reanimationstraining, das wirklich sitzt.**\n\nVR CPR holt das HLW-Training aus dem Seminarraum in den Moment, auf den es ankommt. F\u00fcr Laien und f\u00fcr Profis.\n\n# Drei Trainingspfade\n\n- **\u00d6ffentlichkeit.** Laienreanimation: Kreislaufstillstand erkennen, Hilfe rufen, Kompressionen, Beatmung, AED.\n- **Rettungskr\u00e4fte.** Professionelles BLS mit korrekter Technik, Timing und \u00dcbergabe.\n- **ALS (neu).** Erweiterte Ma\u00dfnahmen nach ERC-Leitlinien 2025: Rhythmus, Defibrillation, Atemweg, Medikamente, Teamrollen, reversible Ursachen.\n\n# Drei Altersgruppen\n\nS\u00e4ugling, Kind und Erwachsener. Drucktiefe, Handposition und Beatmung unterscheiden sich je nach Alter, und VR CPR trainiert das.\n\n# 10 Umgebungen\n\nEine Reanimation im Intensivzimmer l\u00e4uft anders ab als am Beckenrand oder auf der Stra\u00dfe. Sie lernen, sich an Platz, Umstehende und L\u00e4rm anzupassen.\n\n# Training an jeder \u00dcbungspuppe\n\nEchte Thoraxkompressionen an jeder Reanimationspuppe, die Sie besitzen. Keine spezielle Hardware erforderlich.\n\n# Optionaler SimCPR\u00ae-Sensor\n\nMisst Drucktiefe, Frequenz und vollst\u00e4ndige Entlastung des Brustkorbs, mit Echtzeit-Feedback und objektiver Bewertung.\n\n# Ergebnisse und Best\u00e4tigungen\n\nAlles wird auf unserer Webplattform gespeichert: detaillierte Auswertung, Fortschritt \u00fcber Zeit, Live-Bildschirmfreigabe f\u00fcr Ausbilder und Teilnahmebest\u00e4tigung.\n\nF\u00fcr Schulen, Kliniken, Rettungsdienste, betriebliche Schulungen und alle, die vorbereitet sein wollen.", "short_description": "Reanimation trainieren in Virtual Reality, von der Laienreanimation bis zum vollst\u00e4ndigen ALS nach ERC-Leitlinien 2025. S\u00e4ugling, Kind und Erwachsener in 10 Umgebungen. Optionaler SimCPR\u00ae-Sensor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vldevelopment.cz/privacy-policy-vr-cpr/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Lab s.r.o", "support_website_url": null, "website_url": "https://virtual-lab.cz/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "de", "hu"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27865230126461988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619074_1826645201583846_5839313556517450406_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kQjqYJP7q8Q7kNvwEw5rjO&_nc_oc=AdqacC5Qs0JC2u0pQPEJAXtyWA32ndxbMGU6k53Km7vVbFwgH92UE2Z6AAVDcW4lem8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00
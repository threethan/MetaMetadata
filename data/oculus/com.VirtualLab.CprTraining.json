&_nc_ss=7f20f&oh=00_AQLyDOkKEVU441DR_YI6OQ-xcdh81StXMMxl3Hc6iOJwKA&oe=6AB3C606"}]}, "id": "1595866875277193", "locale": "en_US", "screenshots": [{"file_name": "VRCPR_Screenshot_1.png", "id": "3559912607479531", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619718_3559912614146197_8513385910282271560_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoR_OXSbQ2IQ7kNvwGMxm8r&_nc_oc=Adrdj_11iOc9L9DbjHxmoMmjw5aXjJ2UuP0hVPmfSaUaMKyCRYzOMrTMtQt4BTtUlRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKluLAo-TNg00E8kHY9iJlFN6jeCtu-clvs5EnPJBD2OQ&oe=6AB3D54D"}, {"file_name": "VRCPR_Screenshot_4.png", "id": "1336349304494156", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622195_1336349307827489_6195377804226398508_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jeki_J_wbGUQ7kNvwEJt0Xt&_nc_oc=AdpoZEjSvmRHYzMYH9l_IkuCk6lPtQl2-yidYshfMSKmjkSfDurdwOUCGlMN8x0UWik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5c2bE8IQfMk42tFmdnu2U71zvBNekiZ3grjnFa_bSJw&oe=6AB3C48C"}, {"file_name": "VRCPR_Screenshot_10.png", "id": "1272181674279312", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618038_1272181677612645_7844741463771351115_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybCD8inCGzAQ7kNvwGYDf5w&_nc_oc=Adou9VcC-fSArBH6mAsvKNhMIufimEJNi2xo-O5e4Kx5QFGQ9NIIasJFNSbjCxo4E50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKFGVDgSiGH9T69HNMm509iimJykdddb9-1uVJbljabQ&oe=6AB3D22A"}, {"file_name": "VRCPR_Screenshot_6.png", "id": "605143765562903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618361_605143768896236_5018074210652933878_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1sKYfv_pcsQ7kNvwHqdItJ&_nc_oc=AdqyFZa0EziDZI5sr0hJeCYZrnLOl_sYwQGVGIFKJt-soUC_wQ0b5IDzK_5w9lUDHJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoPNKUoaAvzbhYJDMwPHrHUIBCmow8pqN4EHgFjIIV7w&oe=6AB3C69E"}, {"file_name": "VRCPR_Screenshot_8.png", "id": "754937146936295", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831964_754937150269628_7146354273238768755_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8G7G_ZDt2kQ7kNvwHXuxMa&_nc_oc=AdqxaB3ue1YDpx3Lis_a5EgaqTEgY-hkwCC84e_LDhrRSXow55EO9YcFW3sCB1Dr_U8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdkMALIBb-cyp4zYcb2DVPep3y36weUXSxw2mUG-EYsA&oe=6AB3C9E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR CPR", "keywords": ["CPR", "first", "aid", "ALS"], "long_description": "**Resuscitation training you actually remember.**\n\nVR CPR moves CPR practice out of the classroom and into the moment that counts. For the general public and for professionals.\n\n# Three training tracks\n\n- **Public.** Bystander CPR: recognising cardiac arrest, calling for help, compressions, rescue breaths, AED.\n- **Rescuer.** Professional BLS with correct technique, timing and handover.\n- **ALS (new).** Advanced Life Support per the ERC 2025 Guidelines: rhythm, defibrillation, airway, drugs, team roles, reversible causes.\n\n# Three patient age groups\n\nInfant, child and adult. Compression depth, hand placement and ventilation all change with age, and VR CPR trains those differences.\n\n# 10 environments\n\nCPR in an ICU room is nothing like CPR at a poolside or on a street corner. You learn to adapt to space, bystanders and noise.\n\n# Train on any manikin\n\nReal chest compressions on whatever CPR manikin you already own. No proprietary hardware required.\n\n# Optional SimCPR\u00ae sensor\n\nConnect the sensor for precise measurement of compression depth, rate and full chest recoil, with real-time feedback and objective scoring.\n\n# Results and certificates\n\nEverything is saved to our web platform: detailed scoring, progress over time, live screen sharing with an instructor, and a certificate of completion.\n\nFor schools, hospitals, emergency services, corporate first-aid training and anyone who wants to be ready.", "short_description": "Train CPR in virtual reality, from bystander basics to full ALS per the ERC 2025 Guidelines. Infant, child and adult patients across 10 environments. Optional SimCPR\u00ae sensor."}, {"images": {"nodes": []}, "id": "1007209648786046", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR CPR", "keywords": ["CPR", "ALS", "Erste", "Hilfe"], "long_description": "**Reanimationstraining, das wirklich sitzt.**\n\nVR CPR holt das HLW-Training aus dem Seminarraum in den Moment, auf den es ankommt. F\u00fcr Laien und f\u00fcr Profis.\n\n# Drei Trainingspfade\n\n- **\u00d6ffentlichkeit.** Laienreanimation: Kreislaufstillstand erkennen, Hilfe rufen, Kompressionen, Beatmung, AED.\n- **Rettungskr\u00e4fte.** Professionelles BLS mit korrekter Technik, Timing und \u00dcbergabe.\n- **ALS (neu).** Erweiterte Ma\u00dfnahmen nach ERC-Leitlinien 2025: Rhythmus, Defibrillation, Atemweg, Medikamente, Teamrollen, reversible Ursachen.\n\n# Drei Altersgruppen\n\nS\u00e4ugling, Kind und Erwachsener. Drucktiefe, Handposition und Beatmung unterscheiden sich je nach Alter, und VR CPR trainiert das.\n\n# 10 Umgebungen\n\nEine Reanimation im Intensivzimmer l\u00e4uft anders ab als am Beckenrand oder auf der Stra\u00dfe. Sie lernen, sich an Platz, Umstehende und L\u00e4rm anzupassen.\n\n# Training an jeder \u00dcbungspuppe\n\nEchte Thoraxkompressionen an jeder Reanimationspuppe, die Sie besitzen. Keine spezielle Hardware erforderlich.\n\n# Optionaler SimCPR\u00ae-Sensor\n\nMisst Drucktiefe, Frequenz und vollst\u00e4ndige Entlastung des Brustkorbs, mit Echtzeit-Feedback und objektiver Bewertung.\n\n# Ergebnisse und Best\u00e4tigungen\n\nAlles wird auf unserer Webplattform gespeichert: detaillierte Auswertung, Fortschritt \u00fcber Zeit, Live-Bildschirmfreigabe f\u00fcr Ausbilder und Teilnahmebest\u00e4tigung.\n\nF\u00fcr Schulen, Kliniken, Rettungsdienste, betriebliche Schulungen und alle, die vorbereitet sein wollen.", "short_description": "Reanimation trainieren in Virtual Reality, von der Laienreanimation bis zum vollst\u00e4ndigen ALS nach ERC-Leitlinien 2025. S\u00e4ugling, Kind und Erwachsener in 10 Umgebungen. Optionaler SimCPR\u00ae-Sensor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vldevelopment.cz/privacy-policy-vr-cpr/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Lab s.r.o", "support_website_url": null, "website_url": "https://virtual-lab.cz/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "de", "hu"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27865230126461988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619074_1826645201583846_5839313556517450406_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ihAi6N_jbEQ7kNvwHWF9s9&_nc_oc=AdrxyjuDPbeTFCMZpco6QxhB6cob1Knyf5M-ldn2oiQjEHbIhYgybYb4YUoWJlq2JIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeDXNP1klXc04OXUCjRLB8R_RmHSXZoLVpCKi9tyM_qg&oe=6AB3DDA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR CPR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "51408770786878
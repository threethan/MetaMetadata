etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsVay4wlKYMQ7kNvwG1pdBm&_nc_oc=AdqTu1DuEG7Em46AJBBzi9GLIMQeNxFO1bF7CXFWFnLPREsErqzs2o8uNMn1xgLS_ak&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm8OkzDtBSoWI6FBE23tJYb21g5eztwTZCwZBTS0khhQ&oe=6B085E46"}]}, "id": "1595866875277193", "locale": "en_US", "screenshots": [{"file_name": "VRCPR_Screenshot_1.png", "id": "3559912607479531", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619718_3559912614146197_8513385910282271560_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xgg3JBSznj4Q7kNvwF6XoWi&_nc_oc=AdpYZntuafWYq39yjTNECO3UII6Q3ArN5mW1w8L_r9hJEJgotxnCBTklIS9c9IiY4Fg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUWGnE3QQ9IZtBB7pvmGETkQ6OlDDFopjm1PmKF1FRUA&oe=6B086D8D"}, {"file_name": "VRCPR_Screenshot_4.png", "id": "1336349304494156", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499622195_1336349307827489_6195377804226398508_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qcrh2CKfyloQ7kNvwFg5HF2&_nc_oc=AdpyKqxmrdsW3pqHyYn8Y5cFkttKC5_cx8zpZW2fivp5k-aguZ2cfGg5qE4s5B1dzXE&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZa3QCjV9MDeuIzpXHeU7SbhnP2oCSbjbYHtQrrypFJw&oe=6B085CCC"}, {"file_name": "VRCPR_Screenshot_10.png", "id": "1272181674279312", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618038_1272181677612645_7844741463771351115_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rqFKxj-5RMQ7kNvwGUmjp9&_nc_oc=AdoxWkpuN6WQ2E9MIKBD19mkMBkzF02qKhZT7Pglx5zlCmZ2WAhEvWYX36lIuKTSm7Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREoyZuIym4SX0SecbXmwLab_mDC92PFrWIlvd3ukuT8w&oe=6B086A6A"}, {"file_name": "VRCPR_Screenshot_6.png", "id": "605143765562903", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618361_605143768896236_5018074210652933878_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZt0IUShG8QQ7kNvwGe5YMq&_nc_oc=AdrIHzWHigNNE40gLdaWQq-bDjtcmWQ1MfmlVlRuZXtfETPRdZZNytdOYqtfFDyWEqs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-Z-1c4WrXgBOMrYlxA631-_gJlY3co1eRc_Z7j7N_hw&oe=6B085EDE"}, {"file_name": "VRCPR_Screenshot_8.png", "id": "754937146936295", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831964_754937150269628_7146354273238768755_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5YO_EUEHsqsQ7kNvwGIkwva&_nc_oc=AdqS93aY11NkA5KqkNxXQzGveHpTHIBdHqZ7AVAftFH3t0FMz035I9vIBVE3-7VbjZM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDJpFgsnaYQUUl6JQUpy_c0Fst8957XUUz17UDWw4iKQ&oe=6B086226"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR CPR", "keywords": ["CPR", "first", "aid", "ALS"], "long_description": "**Resuscitation training you actually remember.**\n\nVR CPR moves CPR practice out of the classroom and into the moment that counts. For the general public and for professionals.\n\n# Three training tracks\n\n- **Public.** Bystander CPR: recognising cardiac arrest, calling for help, compressions, rescue breaths, AED.\n- **Rescuer.** Professional BLS with correct technique, timing and handover.\n- **ALS (new).** Advanced Life Support per the ERC 2025 Guidelines: rhythm, defibrillation, airway, drugs, team roles, reversible causes.\n\n# Three patient age groups\n\nInfant, child and adult. Compression depth, hand placement and ventilation all change with age, and VR CPR trains those differences.\n\n# 10 environments\n\nCPR in an ICU room is nothing like CPR at a poolside or on a street corner. You learn to adapt to space, bystanders and noise.\n\n# Train on any manikin\n\nReal chest compressions on whatever CPR manikin you already own. No proprietary hardware required.\n\n# Optional SimCPR\u00ae sensor\n\nConnect the sensor for precise measurement of compression depth, rate and full chest recoil, with real-time feedback and objective scoring.\n\n# Results and certificates\n\nEverything is saved to our web platform: detailed scoring, progress over time, live screen sharing with an instructor, and a certificate of completion.\n\nFor schools, hospitals, emergency services, corporate first-aid training and anyone who wants to be ready.", "short_description": "Train CPR in virtual reality, from bystander basics to full ALS per the ERC 2025 Guidelines. Infant, child and adult patients across 10 environments. Optional SimCPR\u00ae sensor."}, {"images": {"nodes": []}, "id": "1007209648786046", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR CPR", "keywords": ["CPR", "ALS", "Erste", "Hilfe"], "long_description": "**Reanimationstraining, das wirklich sitzt.**\n\nVR CPR holt das HLW-Training aus dem Seminarraum in den Moment, auf den es ankommt. F\u00fcr Laien und f\u00fcr Profis.\n\n# Drei Trainingspfade\n\n- **\u00d6ffentlichkeit.** Laienreanimation: Kreislaufstillstand erkennen, Hilfe rufen, Kompressionen, Beatmung, AED.\n- **Rettungskr\u00e4fte.** Professionelles BLS mit korrekter Technik, Timing und \u00dcbergabe.\n- **ALS (neu).** Erweiterte Ma\u00dfnahmen nach ERC-Leitlinien 2025: Rhythmus, Defibrillation, Atemweg, Medikamente, Teamrollen, reversible Ursachen.\n\n# Drei Altersgruppen\n\nS\u00e4ugling, Kind und Erwachsener. Drucktiefe, Handposition und Beatmung unterscheiden sich je nach Alter, und VR CPR trainiert das.\n\n# 10 Umgebungen\n\nEine Reanimation im Intensivzimmer l\u00e4uft anders ab als am Beckenrand oder auf der Stra\u00dfe. Sie lernen, sich an Platz, Umstehende und L\u00e4rm anzupassen.\n\n# Training an jeder \u00dcbungspuppe\n\nEchte Thoraxkompressionen an jeder Reanimationspuppe, die Sie besitzen. Keine spezielle Hardware erforderlich.\n\n# Optionaler SimCPR\u00ae-Sensor\n\nMisst Drucktiefe, Frequenz und vollst\u00e4ndige Entlastung des Brustkorbs, mit Echtzeit-Feedback und objektiver Bewertung.\n\n# Ergebnisse und Best\u00e4tigungen\n\nAlles wird auf unserer Webplattform gespeichert: detaillierte Auswertung, Fortschritt \u00fcber Zeit, Live-Bildschirmfreigabe f\u00fcr Ausbilder und Teilnahmebest\u00e4tigung.\n\nF\u00fcr Schulen, Kliniken, Rettungsdienste, betriebliche Schulungen und alle, die vorbereitet sein wollen.", "short_description": "Reanimation trainieren in Virtual Reality, von der Laienreanimation bis zum vollst\u00e4ndigen ALS nach ERC-Leitlinien 2025. S\u00e4ugling, Kind und Erwachsener in 10 Umgebungen. Optionaler SimCPR\u00ae-Sensor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vldevelopment.cz/privacy-policy-vr-cpr/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Lab s.r.o", "support_website_url": null, "website_url": "https://virtual-lab.cz/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "de", "hu"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27865230126461988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619074_1826645201583846_5839313556517450406_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdxNQ8MH3F0Q7kNvwGdi-U1&_nc_oc=AdpmkVQ1XcnZ5cEFrpynlay3C25AJQspLU4wz5whGNznNNbx1u9sRmdbT73WapT8cA8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00
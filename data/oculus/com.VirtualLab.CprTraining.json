etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dokD1uLIZZgQ7kNvwHQ-a3R&_nc_oc=AdpSRJ5_HwsMQJQJnBQKR42W_3CUiJs0YdLwP4GaH4lLrLIrJlF8iJNkbRzIPEwkQ2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRGu6JFG9c6BxgtqVX6bu5SzKuHTRaeZz-miBz8UNp0CQ&oe=6B0C52C6"}]}, "id": "1595866875277193", "locale": "en_US", "screenshots": [{"file_name": "VRCPR_Screenshot_1.png", "id": "3559912607479531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619718_3559912614146197_8513385910282271560_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b74EJTbtGBcQ7kNvwHnCsC1&_nc_oc=Adq8TsUYKoByrDOi1aNj2asr8kBKbjTxSgKUUy1F-0IKR7rtasfGHIUnxUlqQGA3Hhk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTyrJg_oxpvDbbQwehz1nyDz_iiD1RTDE3pPCS3bxmQJA&oe=6B0C620D"}, {"file_name": "VRCPR_Screenshot_4.png", "id": "1336349304494156", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622195_1336349307827489_6195377804226398508_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmywFCfWz6sQ7kNvwGNBPvU&_nc_oc=Adr-kc3MTXhrCBSHOdgf9zi_XvlbaLDGnT4wAFj3oYJ6ccecHnOlKBJqMcZOdWQNhrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTorxu_DoNJ5hNIuc0R8mEGe6BL6HNHkgjmuhBlVZ6czg&oe=6B0C514C"}, {"file_name": "VRCPR_Screenshot_10.png", "id": "1272181674279312", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618038_1272181677612645_7844741463771351115_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2TwOVdfOVgQ7kNvwH6dTro&_nc_oc=AdopzTcR36hkdXIwE7dPbGEgC0nl8osuQLsiYUiQyVLMx9zGI49fzUAL-svrlG9HPo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR5dS0viRPs61U3D8qB1WlNYlPzfjKCXFSumZfv-LInIA&oe=6B0C5EEA"}, {"file_name": "VRCPR_Screenshot_6.png", "id": "605143765562903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618361_605143768896236_5018074210652933878_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtAJIegER88Q7kNvwECHECT&_nc_oc=AdqEWjv6EWgqVtUjB_HmkRI5ThLwnOfI75SCWrlIhFhWo9RGlIUW_gHQOlcr8kyJppI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBWHu60Uk-Ud9nCHtge_7XdlclF7HlbvkTBaKyBdM1VA&oe=6B0C535E"}, {"file_name": "VRCPR_Screenshot_8.png", "id": "754937146936295", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831964_754937150269628_7146354273238768755_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjKUUvssgS0Q7kNvwGzRNkq&_nc_oc=AdpRHPyRFgX9tuWrFwsuEQTgVIZQdsCwwZNMZJwyMvwAXOOx6vObBITjlFbCH5OJY0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcZXgLz7xCOg2W5J2ospQSvPjZXktJm0SknCfeeWXOKw&oe=6B0C56A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR CPR", "keywords": ["CPR", "first", "aid", "ALS"], "long_description": "**Resuscitation training you actually remember.**\n\nVR CPR moves CPR practice out of the classroom and into the moment that counts. For the general public and for professionals.\n\n# Three training tracks\n\n- **Public.** Bystander CPR: recognising cardiac arrest, calling for help, compressions, rescue breaths, AED.\n- **Rescuer.** Professional BLS with correct technique, timing and handover.\n- **ALS (new).** Advanced Life Support per the ERC 2025 Guidelines: rhythm, defibrillation, airway, drugs, team roles, reversible causes.\n\n# Three patient age groups\n\nInfant, child and adult. Compression depth, hand placement and ventilation all change with age, and VR CPR trains those differences.\n\n# 10 environments\n\nCPR in an ICU room is nothing like CPR at a poolside or on a street corner. You learn to adapt to space, bystanders and noise.\n\n# Train on any manikin\n\nReal chest compressions on whatever CPR manikin you already own. No proprietary hardware required.\n\n# Optional SimCPR\u00ae sensor\n\nConnect the sensor for precise measurement of compression depth, rate and full chest recoil, with real-time feedback and objective scoring.\n\n# Results and certificates\n\nEverything is saved to our web platform: detailed scoring, progress over time, live screen sharing with an instructor, and a certificate of completion.\n\nFor schools, hospitals, emergency services, corporate first-aid training and anyone who wants to be ready.", "short_description": "Train CPR in virtual reality, from bystander basics to full ALS per the ERC 2025 Guidelines. Infant, child and adult patients across 10 environments. Optional SimCPR\u00ae sensor."}, {"images": {"nodes": []}, "id": "1007209648786046", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR CPR", "keywords": ["CPR", "ALS", "Erste", "Hilfe"], "long_description": "**Reanimationstraining, das wirklich sitzt.**\n\nVR CPR holt das HLW-Training aus dem Seminarraum in den Moment, auf den es ankommt. F\u00fcr Laien und f\u00fcr Profis.\n\n# Drei Trainingspfade\n\n- **\u00d6ffentlichkeit.** Laienreanimation: Kreislaufstillstand erkennen, Hilfe rufen, Kompressionen, Beatmung, AED.\n- **Rettungskr\u00e4fte.** Professionelles BLS mit korrekter Technik, Timing und \u00dcbergabe.\n- **ALS (neu).** Erweiterte Ma\u00dfnahmen nach ERC-Leitlinien 2025: Rhythmus, Defibrillation, Atemweg, Medikamente, Teamrollen, reversible Ursachen.\n\n# Drei Altersgruppen\n\nS\u00e4ugling, Kind und Erwachsener. Drucktiefe, Handposition und Beatmung unterscheiden sich je nach Alter, und VR CPR trainiert das.\n\n# 10 Umgebungen\n\nEine Reanimation im Intensivzimmer l\u00e4uft anders ab als am Beckenrand oder auf der Stra\u00dfe. Sie lernen, sich an Platz, Umstehende und L\u00e4rm anzupassen.\n\n# Training an jeder \u00dcbungspuppe\n\nEchte Thoraxkompressionen an jeder Reanimationspuppe, die Sie besitzen. Keine spezielle Hardware erforderlich.\n\n# Optionaler SimCPR\u00ae-Sensor\n\nMisst Drucktiefe, Frequenz und vollst\u00e4ndige Entlastung des Brustkorbs, mit Echtzeit-Feedback und objektiver Bewertung.\n\n# Ergebnisse und Best\u00e4tigungen\n\nAlles wird auf unserer Webplattform gespeichert: detaillierte Auswertung, Fortschritt \u00fcber Zeit, Live-Bildschirmfreigabe f\u00fcr Ausbilder und Teilnahmebest\u00e4tigung.\n\nF\u00fcr Schulen, Kliniken, Rettungsdienste, betriebliche Schulungen und alle, die vorbereitet sein wollen.", "short_description": "Reanimation trainieren in Virtual Reality, von der Laienreanimation bis zum vollst\u00e4ndigen ALS nach ERC-Leitlinien 2025. S\u00e4ugling, Kind und Erwachsener in 10 Umgebungen. Optionaler SimCPR\u00ae-Sensor."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vldevelopment.cz/privacy-policy-vr-cpr/", "developer_terms_of_service_url": null, "publisher_name": "Virtual Lab s.r.o", "support_website_url": null, "website_url": "https://virtual-lab.cz/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "de", "hu"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27865230126461988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619074_1826645201583846_5839313556517450406_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLodiTMLymIQ7kNvwHu6VF1&_nc_oc=AdrNGxe6LnhOLOxJsGeAav-G7rPFOJrYnNsiDxiFD75dqtNWVd8XbK_1Su-QCP7Sy6I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00
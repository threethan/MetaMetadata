uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk-ktrtZ5RcQ7kNvwGO_SEG&_nc_oc=Adov0x7fEOxoKf4UoFo2QavnLUSp1Hc_h-UfWE6ktdDJ04m2Qgb_Z1IqWb6kYC8utJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlzsYLYBOlp1iPZCtfdaBoRKHmlntOs-0tK4Nw2nhIjQ&oe=6AF8A5C5"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysa5DfpGxNoQ7kNvwE14GTw&_nc_oc=Adq5Mqvo0VPnzGW7mXxDfaAa1eI8nROrkOdOGXSCrHs19D5UOIRFKLeEqe7IwjdJobc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzCP1lN_4ls-K8GrPtH7FssQ_AUui0AQywJ3-S_RoIbQ&oe=6AF88179"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZYuuwmF7ZcQ7kNvwEBfKq1&_nc_oc=AdrGeqDkgXcXx-2lVMme4uUY-o0kgG1SrYxtSIy8qcRV_muMs6iIweXCM3QeOjPH6xQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj5bcp09JDiUGpPzPyBG-V9yJyFmkmsc9uM4E_Jys83g&oe=6AF8807D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
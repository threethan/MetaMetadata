uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sk-ktrtZ5RcQ7kNvwEtxMUF&_nc_oc=Adq3h9vRhjM6MXcxLgDAQGFD9BAUK_xL7ykmSkS7ODYoydKUKgRofqnWBgcsafcs1As&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR911No5-tH7GyT_c2LDtf17xqnyk-BS9HtBrk_DB8tfg&oe=6AF5CA85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSp0E2nbL4wQ7kNvwHnPzoe&_nc_oc=Adof44Elc9DXnk2LYK9pkd2TiiuL4_Jrj0r6PApoC5Q-CCqzOwJoBhJmLyqykDLutGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2g2iUqeryIrXxyKvWsdQ4804skCdyJjqxwE9UrM3NKw&oe=6AF5DE79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIrSzMISg7sQ7kNvwESoIyX&_nc_oc=AdqWzU5k0X3f_nNVUxsnqiZ20rUV2p0hKKmTZ-d6tWNdTu-NaTKz4-Q_DIU0NnjuwNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYaJfPOz1GV4dbpWloUyNcPicw7-Dn4CzbFj7z46JR9g&oe=6AF5DD7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
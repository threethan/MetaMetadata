scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqgho8CLX8T4_98hqUVz09zqxdxX9OFZEhLhhPSdhwJg&oe=6A773A85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOHWcV1UkrgQ7kNvwEJeoI1&_nc_oc=AdrI-IJqK2EC7RJd13R6h-0sA4c-Fj2ceCDoankOyZzXwHYj_n3fwbNImk2KMi-wpng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGobsp92tOKJvgu-Cc9OZdPKQDADqh7gMf2LOVnG30x_Q&oe=6A771639"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrwGGvC3JZEQ7kNvwFumC8H&_nc_oc=AdrRlwR1Jl29OgUuR8s-CnkUlTAMLdgfg_Hcz0Yrj0P0RdIh5Zj3NpFKtbAN-5Vaodg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJKaMqY17rMLRgB1u8C4AZz0H0NiF0TWkFNSiPZgAAmw&oe=6A77153D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
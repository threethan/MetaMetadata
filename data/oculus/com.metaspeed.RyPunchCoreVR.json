uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2wLtU2zs0wQ7kNvwFME79A&_nc_oc=Adp8FbgLZD0i4_ioC2YVjvm65Zi32yOvwKLx_yERe7-mqdMNzuydyfZ3w2s3s24di74&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgSZuk1_qrlRuJeQVIRdy8bJcfS_IeSbhSrF1IfUhgiw&oe=6A661705"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdFoXWvGV6cQ7kNvwGpNM0Q&_nc_oc=AdrsLb1e8oUzokUOpq_zEPM3W9QJ7UQNjHv2LnK4KTLwmJ-kkFxN4FKQQ_Jko6KBioE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlpYxxixrHu3jIJ4uyG1ShHoOW-0mtkUcfQOrwkFG6Qw&oe=6A65F2B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VdZ4uFcddkQ7kNvwHbnuVG&_nc_oc=AdrCpyWe-2QLmvuYl-T6NHGSSngPcqVuUdQTDHBUH6KIZnI-5BcAkf9bkpiI-Ck0wFk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw7InbKwxxa4fuJdHmzVJnFoTZKH5oYASzaSKuQ46LKQ&oe=6A65F1BD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
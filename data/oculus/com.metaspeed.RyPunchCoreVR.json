uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B9m5zbeoX7kQ7kNvwEnTB4-&_nc_oc=AdrK-7iAKHhalrc7aZVagNplXh3JXiuBDnGdB-NM6RISrUyK2J7meW_Js0R65ZUoBM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6si26zOWpGf4xV9eChOLMM4Me0HuyhIGqXifBPdhwPSg&oe=6A033685"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G3ZGL5EcV4Q7kNvwElMEub&_nc_oc=Adr-e6KCHCnosdwss2CRp1AadxrRiwKLWX0nPfvkkN1CyPRjI3cZFbOgDzXRtlG3FCk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rcbuo8ddS6RxtUL45RCtgGU50XC7O_hFWRfhUo38e7A&oe=6A031239"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJNgpExlvhQQ7kNvwGwumQA&_nc_oc=Adod85gBGYUchMGD8Z7jE1t5s-P0vLSl-anjemHSgAHx89Hr8PsH1yrUBGbC7oLERpg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QGQ4lFp-RLGM-kkYs2sSt-Qil4CXbg-mgYXUxnCrx0A&oe=6A03497D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
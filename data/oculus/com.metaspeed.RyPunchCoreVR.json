scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXoZOqCnY-QrOq3Q5XQy5sUo7LSnwJEAHi0I-qoPUHJA&oe=6ADCBE05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztgeSzzWXXoQ7kNvwFFQEAf&_nc_oc=AdqF1E4TO4GebgeqYvfOzuHrp6MeqkAO8RUQVSLSX6pc9ASDxdENTB1-pzL8aXeXo68&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXUlSeNPj6KKhivlN_JVqlsHLfO-pxXXQOcJUWuSXrlw&oe=6ADCD1F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48EDbN14X8EQ7kNvwHPl2aJ&_nc_oc=AdrmCDM5PSW6wBX11emx_qHb46RiI_FJREVY_2CICgfKLjMXOQQA9FrWrpHVJOK5ZpE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMc3NyLnZQNulspQIZRmbH7_hk01u-0s0X92X-UfmUfsA&oe=6ADCD0FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
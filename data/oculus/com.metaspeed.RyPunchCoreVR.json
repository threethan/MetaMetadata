uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdHlhTpQ36cQ7kNvwH2i8GW&_nc_oc=AdoAtLdUNe2SzwKV1OiW4--Ms4UzZJsIiGhQYfEC0WZPu9jDEUp0h9bBjACXOGQuin8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJok89ilmFqF8qR0Sc7Otz6jitKkLunRj87gUdvZ1o2w&oe=6A831805"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6scAnjnnFcQ7kNvwGd_2ia&_nc_oc=AdpaHMLIKGisr54dHubv5-DZ--qEhkp_k5ytCU2ypKQ4FYAwpcsgfRrXgFcXIoSeJYw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-8_uYksJUqDoepwW5MIOmwFU1iwaVaYJTbaAOivyQRg&oe=6A82F3B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stjCkixyRS0Q7kNvwHJjOdo&_nc_oc=AdpRWFjCaMsUMt6JHVhF9Vo9fHbHD3X9fcgHIfczlFHzhVVMacbugxWbfpje7vqY_8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoHDhcVs0YwaCy9vlzGnwC4D0THuAOCIAhIODPDsGNrw&oe=6A82F2BD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBJnxQmE629m0htsXLrIjYM9tUaLN4TPU4_yiJj6s1Ww&oe=6A6E0005"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0CLJfaQDyUQ7kNvwETCeBt&_nc_oc=Adoss3Vf1OLnYEYyekSR-qAWfqyR0b83iOfcogXW2Usl-kvuJSnFKp9zGYAvrtroE5c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDh6NYUsRILNt4UysgsmKy3-Iz2WEx8NFvtmMUJmUCbJg&oe=6A6DDBB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YnJvzQSP54Q7kNvwFWInd1&_nc_oc=AdoqOs32z5DjOPuYtkUg3ahdLEfyACb6vhs07NVoMmVEJBvByRXzJGZ0S5zMNceYpVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqwQdS6MckO8kEXfFxq92nz9ydUauk67kn8CQfm81R8Q&oe=6A6DDABD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
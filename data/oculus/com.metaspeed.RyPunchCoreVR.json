uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_a7NhN_tt0kQ7kNvwEa7kMW&_nc_oc=AdpSL_rNR1PVwaR3X7dUl4Rj1IwacAmfWXY5p_h1xzu14sd4PXmqTAdKZzq3imS117I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES3yzgk0eY9aasAmicMIF84aSVFMHlrtwGjmlDqb5oTQ&oe=6A749785"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOHWcV1UkrgQ7kNvwFCSpgm&_nc_oc=AdogjVmyHSU7yBtC1jtFKOdtYsVFPePvf8it9dIqGMPRaeXhMNuEtd05GhPESMhgqzg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFygWlQ6NnceOFBW5VIVuM2DXd_UKrOGzyvK8M-ahqXpQ&oe=6A747339"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrwGGvC3JZEQ7kNvwGQV1RE&_nc_oc=AdqyXivP8igiWl_bATBM26CQx6Nuk24V_F8iHU0SdMCqOPtOylpdi3ZEtn3GJTZrY8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZz5G3qghUkIRbQjgI9kfsB-Oy_i_OmQ7RtY9QT9f9IA&oe=6A74723D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScxLHAm10QbH8Yhz0k30rECSh7Fvhg6W8aJS1EkivU4w&oe=6AF1D605"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJIcuiU8bzEQ7kNvwF7Zxh1&_nc_oc=AdqIQChMG1MWZpv03LxpZPQVhIV4WSa4GwULE_Xodl61csx0v50GnXqEyKG-wW7q2m4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStE3toJ-NnkCxiClUFDxe53mJj2E_ZpN71lO_pvr2YwQ&oe=6AF1E9F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clD1KdXzPBoQ7kNvwH3mPwL&_nc_oc=Adpatu4WZtPDxaLiF5hwYqJegD_RfSOorzf43qz0yZTfiNuB4I1_Q2vWP2heK_tWrtU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjZkugAshBOTBhSi3O5wKVUnUWGmIDPQByCNT97oXeow&oe=6AF1E8FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
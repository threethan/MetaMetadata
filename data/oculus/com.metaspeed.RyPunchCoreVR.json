scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aoasew4DjnqEZXXrJ22b81eUU6-mSHkqzNndXfWI-Nw&oe=6A427E85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDHVCRL7pz0Q7kNvwGNuX-c&_nc_oc=AdpSCgFQWrkUCzlEgQlAvVnKxZ4Hys9pzUhpx5IooVVDtpGoaZkVSHIKuqX5QutYLww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KZYyYsW2rU1uU7nkolENwRR6zkTnQXOgR7-ICl8fhfw&oe=6A429279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybKTUznZbcAQ7kNvwFOtZ8W&_nc_oc=AdpfOujbbPJDH5s8MhrdzbxKDgKg3j2orjPM-fAN29pEWgFB4ue1QG7A7SwUiE-VJTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a1BOZaEzHZ8BiWeE7Q-OvCnc40GY1QGvb7_ynF9_6ow&oe=6A42917D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
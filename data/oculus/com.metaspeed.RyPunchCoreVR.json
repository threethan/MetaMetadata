scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdyH5U0DUPkBuY5UiykMUjKTilSHz7NpKKIu9wv9oLnQ&oe=6AD0E085"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lugflppCCPwQ7kNvwGu7Q9X&_nc_oc=AdoEUTPNXa2y4jdF3MeI7ZUh7dEhMO1aEllQRxppicRtdXr2iRwTgIj8czziMvB66Us&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk_N57kRy-7c7paQCUSqymqoqAKcFI4EJ2cpFcMZdNsQ&oe=6AD0F479"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58L9k_wF5sUQ7kNvwHRKiST&_nc_oc=Ado5ymy7KTrCl9YoSYeuElqCT11qDAcZ9k2uDBSvXr92QJlQxKdfvAvcNYSqoqoTIJE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlts1z8vvn6enLKBYAIX1e4Pj1m1AAt1E43qTCXy-uXg&oe=6AD0F37D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
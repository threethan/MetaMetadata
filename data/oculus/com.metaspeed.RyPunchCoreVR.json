scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFijMv36NTLJaDUkTNZPL_wpOuQXXTA6lP-iTmCopEm9Q&oe=6A75E905"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOHWcV1UkrgQ7kNvwHmMYGg&_nc_oc=Ado2JMchYiLu03uERo4MnLkDhjOrGWdkbCUQc8YRBMvPML1vJGdQ97dKtv18aGJRtRk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAuQAb-Omp9tn9Q7aZ6v9rLkdppv31qm2GKinrug0DAQ&oe=6A75C4B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrwGGvC3JZEQ7kNvwEi454i&_nc_oc=AdqyKdoM8-vMHSoIbMCii7E65MsGVCZqZf32p0Z_BibCK3f6WqFvsPQ6lut8kduz2Vg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHANf6NW2UW-v9gfwf--PZV3N1_4yHVsB6okUvuEAXZfA&oe=6A75C3BD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
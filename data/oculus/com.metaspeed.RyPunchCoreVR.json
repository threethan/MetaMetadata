scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFInlHRNQjqzu1aGaBuPCAhn3A_CQ7OCRBIC6pNn08hwg&oe=6A86D445"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTiL1tT63OAQ7kNvwGRefgA&_nc_oc=AdpqmBgP_6C-W0M_eBgNAwrXF8xbrrC4tlcyyghTSahsPrOuJGz4Hy9mTWvlIzI5IFs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9VYnGFeLmn-L_CokMiVHS_2l_LRMNvKsSLgVLVJDaOw&oe=6A86E839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM9pjDjq1SMQ7kNvwEuL2OK&_nc_oc=Adry5CWFdtzxEMdWcBUaEgZvbBwSDw1oAS80YsWA_I6-9HgCuF2URFK7gpzxOD3sT38&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmARXMLHMrAI6Lx0pPq7oXcoZ6IAh3ZG-VB3ZOHcEqWA&oe=6A86E73D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
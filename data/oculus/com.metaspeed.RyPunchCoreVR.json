uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJTrQXHKxFUQ7kNvwGdTnVK&_nc_oc=AdrO4ci8JjlbDMLdJB-1HvjfTZ4CSI--EWT6NFW-ksFEXDuriymQZpx1TH9plzlIjT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzCcXeA92MwFCR-CdTMEl3cztWB-VI0weytoYA2UY7qQ&oe=6A4FAD85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzozIArVZWQQ7kNvwFlrw_Z&_nc_oc=AdqWh4beD-NWqmIms6eJ6nqrfqQCf7wffdYDQAaQP45-HJrZ_DCxsFn2VNDlT1jILVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5G36uMiGnViNBqHbd-eREdJcP38X5LTL6_s3FUPZWQg&oe=6A4FC179"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nus6H3mPFH8Q7kNvwE6_PG9&_nc_oc=Ado5rhY3YLAip2TM1ECsjPWBLfAqQTWNSMpx9PVArUTytqXa7XlkX05lDzvDRCMRueg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBod7SwXKHgb__cUjcp9EZ3c60eTaRpBa1U_5RUfkOkGA&oe=6A4FC07D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9eXVfgS-UsQ7kNvwHJw2Vp&_nc_oc=AdrD-AIDArFuNW9OeSRduadSBiWWpoOA0WC8wMAJzgqrad86xIPICmz5fvWJweZiUGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-SJ3OeAOBErkEfPJz21dAc8EHj5Q-r77lrk0YocEZ3Q&oe=6A897745"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NLaInjuE88Q7kNvwGFJVpu&_nc_oc=Adp4r40u0VyiQz03ILgYgvIWhsI2iuUSdaMYzhLp9ViQICeDIj0x73du0ttW9KZVHS0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbkHgVVerwUDmgmD8OQVL6QxiH-GP3SmSW2q70GB4U3g&oe=6A898B39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44XOD4Opc90Q7kNvwF2d7Gb&_nc_oc=Adrnjp9Sm8UD0B2nleT_cOYPK-nCQM0BUB__86i6XWPDozzstmsR8V0QgpPizrztAXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgDVAgldcy4jni7NxXPqlAcrA7v6XA5p_SMgA7z3EgUA&oe=6A898A3D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MetaSpeed", "support_website_url": null, "website_url": "https://rhypunch.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24834366279596743"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1302960437660213"}]}, "baseline_offer": {"id": "1302960437660213"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762780800, "status": "PUBLISHED", "id": "1302960437660213"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25193824090317625", "version": "1.0.1"}, "id": "26572658982378677", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8079404885519479", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25193824090317625"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channe
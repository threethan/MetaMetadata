uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq9-PtAXB0IQ7kNvwFtvQW4&_nc_oc=AdqyG3YUncq3dcpDXIk4nK7JZkhxyyCaqIyzt5l9n9bJ62Yv9zVbTiRtuk3H6gOYmrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bsU53N5EX5vv0iOWEZMaF-gVlTz2DwqfDIXFDCNytyQ&oe=69FC9F05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ie9Q8GvnzkAQ7kNvwErwOjz&_nc_oc=AdqxlatqxuLVFAH0bVkm_L0pUGpe0unwqxuvoRRwyV6gm6Xhvu4Xz2Zr9PUJ6dPmGYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U0Z3k1T7zQNfYLmNYOE0BbyUVYvAWe-CEKvIWDhw1Dg&oe=69FCB2F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuHyJDJ4wzoQ7kNvwESEiUq&_nc_oc=AdooG6SpLpgGWKfpglz5iIlaXXsuMzNvonzPkfwZh_H6IDmr766rOeUcxuZrocz864k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cWOiJQBPkHFHIP2PVeb5ICDf93PQNZolfVhNdrXYN2g&oe=69FCB1FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
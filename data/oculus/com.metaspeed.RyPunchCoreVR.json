c_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VJYaPBh9L9DhVbN_jMQGfZ_NcH923Z9yJXedyJyINVA&oe=6A22DA85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4iRAVsmdZMQ7kNvwFbNHXm&_nc_oc=AdoEnuqmyJAKP52i2IM7R2UcvGgUB89LVrC3VJfJzqj-rYxWjNzyYqn_DFQ7fh3ju9I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ziyAzw9PvJZWKpa165qmfOg6F91B48UzqWhydJGKr_g&oe=6A22EE79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQL1vD1FQEAQ7kNvwF5jPZ7&_nc_oc=AdpKxmvqGdqM5BbMTH9A8nHf6562-FRkG26gp5oU4uxKigyIoAoRx3Y9sWc_Iv0Ada0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m18aNlTuHIK15csr-byLVsTlOOBzbONUt5iG9ixqUBw&oe=6A22ED7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_term
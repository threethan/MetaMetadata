scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzf55a6D7crA-3ca17jD9o2LP5VgLfzUM5SepDuwzLPA&oe=6A986845"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfjiUADdbPUQ7kNvwGTuoWw&_nc_oc=Ado1lhFtPAcoBIMj0HJObjNba0nefZTrJD49xmbCieXGWrQgD-TJcC1k4VXUSvOOf2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6n5UmEf7r9l2Oec-Qxh5z7siB315iHx2gdNuD2t_b8Q&oe=6A9843F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBSvstokBgsQ7kNvwFVgmB2&_nc_oc=AdqVmUhDqJcvvHly5kuqzFDB5McWRrXSaeWBgeKYph0qc0Sibny4oTUyZjxDmYWAZCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWgjEuwJZNgfvB5k-kWAZRmd7Mf_4Yj3t0acf_imbQWg&oe=6A9842FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
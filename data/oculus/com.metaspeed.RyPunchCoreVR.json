uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsRyjm6LBI4Q7kNvwG_r6Ta&_nc_oc=AdqgXZHKNkOwr7zr2FeIUzWwwyNX1aK1qGdzjLhGzfLedc588b2Ei1Tp44RVnsEfDZ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7mLxHpqqjG-YEfcXR7ae5PMULVQg1YJiZVgcf4eeVYA&oe=6A6B5D05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjEjbXX4XKAQ7kNvwH6x_4p&_nc_oc=AdrdZXmBdQHGTU-sbotdajYYuthVEQv7fB9STSLttpV3WvkcRCD3FzSG7P8J40X7OkA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA18lASUltJdnHpXnWSs8RUsrBb4Cr3r2yGX9oSvdv97A&oe=6A6B38B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql9rNwPPPJkQ7kNvwGf-60O&_nc_oc=Adp-pNNizhKLFv04KAeT6wptt_q3yLuw0UUEsQjBg4GN-D9nMucg6h0Om4wO_YJ-qbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOT08TQQIK896jHyayu01i16sxIg6it1X7aEnV0UZlXw&oe=6A6B37BD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af789A3lJgq_ZW2Jtalw0T2bPMFwWgWeGE6bGDG8v6Ztpw&oe=6A01E505"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G3ZGL5EcV4Q7kNvwHCk349&_nc_oc=AdoUseE3b5LUjkvnP1_Gsst4QkRIMpiJCLjFhOzDdGr0namJ5RSiPetwc-7KNxBAb7U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hgh0oETFFlL36C_JLXSUerVj3xn1NyJ2ck9nc8RVTSQ&oe=6A01C0B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJNgpExlvhQQ7kNvwEdiO_B&_nc_oc=AdpZ2Sh3ykE-ZU-OOpfJUsdLJk0ajvhcJX2ehF6G1de49HQiZ2XblmR9_EAK-C9X298&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7liQHcQiM8eg2WcyNGm-SSuTm4jpAvN1vWm5rA9ZzZCw&oe=6A01F7FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2wBmf3dpJ0Q7kNvwEVvcDp&_nc_oc=AdpbbEOp0OBgFkO74pa8aJRsXrnh82dCgX20uQZxEySpcxNZC4eJ0fRyl7eZsbg5kns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wVHVROg3g0oPxb4y-4g5O-tfmGQ4PsFFbLdAI09UJBw&oe=6A2D6685"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIkWCsVu8nsQ7kNvwGyFvTn&_nc_oc=Adqk0yZIoFtstP_GbUJ38XRZ37ZOLjZvTE93i0aUPM1Xg1UoBEcThd2_BuDmxA2Y0P0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Go7OtHUO18q04SN8AClF4bbcuq7EasOzvPat2csKp4w&oe=6A2D7A79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTbjjFsuSboQ7kNvwFBTpuD&_nc_oc=Adqdr5HDe1sSYwJq5lqqIwBWAAgiAKlXuHUO6iy7NufepX20YfD1W-nAD3ujyRWxAb8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lMDVZJRwan15-aDn7OnbraltEJHmNTXfLE_9pcv3GKg&oe=6A2D797D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
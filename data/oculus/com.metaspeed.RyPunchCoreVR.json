uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_PsZvimpacQ7kNvwF5Amj8&_nc_oc=AdqbKuS1FDUOeGEEOigZb0fOH-zP1M7UNplfx7b_Ar2cqCtlmU2-K1Ukj4N0pGKsRUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXVuSFinj9WvnP7ATkgp_GI9YAuYlHXPmIWl18IYnUIg&oe=6A79DD85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJ-WzLfIOSoQ7kNvwHOyVAN&_nc_oc=Adp4jw0Hxz7sfkFBvGmccAJGLfIpol3sdCO1MM9JU-g7Wb6voZuaxLQ9ssrgW4ZVLpA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJjbFYAlTFYpSykGQKu5uYonObNwolcHP4XkNCXlnoWA&oe=6A79B939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Z2zKtn7_EQ7kNvwGi7-iF&_nc_oc=Adre_XGloBXHklfe97diTasSDZP1USZ1q_RS6rbYfSYv19zb-gzj7FT9h0nx_OFr8LM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR5ZIBAK8IaJ2VhN-Vto3Le2QrE97hyWs-_P6uY2tCKg&oe=6A79B83D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
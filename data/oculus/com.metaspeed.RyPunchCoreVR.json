scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-cKdG3OWiz6SOYZwJx1_AZ7kBPfmo6OD5Zgf9eNJ4Yw&oe=6AB68285"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl-vciPIjAkQ7kNvwEA2D-B&_nc_oc=AdphYvR2uZqudifB704JLs9Wm1N-QgveINo-G-7i-_OzGbPK8wznOzCROkEzNIvyyN8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcL8ch4FZB5fjNz7ltFnNj61YWPVS-6fe2EOw1Yinbgg&oe=6AB69679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CR3buLUO590Q7kNvwGi0gQq&_nc_oc=AdrkEibQPDgPFJZwg0tK1O8GHdZMlFm8degFRkZ9q5fQf2uZBq8rKcavUpkmfaY6ino&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYMFp_xvwTjzVmXriwnyea-EoGv6LY5s7fQm-D5I4xdQ&oe=6AB6957D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCdjmk5kFNIQ7kNvwHjHOKP&_nc_oc=AdqPyf5AANsJwGp-u5i6JUhKsa6IUkEZINgigMPSkp9GvvtR02PDQnn5O0MiYGBQ_7M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4y95osWi4EjlqPPHdLiJ95Q4YwScTnQvM7rr7r-aLdQ&oe=6A257D85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axr9u98t9EIQ7kNvwHape__&_nc_oc=Adqkbjn569ShaN_DWhVZxJQdXusJTONxGo5da4hx1SNPGdgCG1JcWN0cm0GsKrEQvYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zvtuKlio78vtOt0XT-aI3ZOZ-dxSnEz6_OV_cEsqsYQ&oe=6A259179"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hay5MeBU-5cQ7kNvwFFj31q&_nc_oc=AdrdKg-E8eMA7j9qdxPK5egL8gvtI3OHtu7D5UPtLPX00adwl0uAF1QecBuLfaSIK8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Es9vwfRObjXXp0UTN1Xqe358ayXne0t4QBH15mZPBvQ&oe=6A25907D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
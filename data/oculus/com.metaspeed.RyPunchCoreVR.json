uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_aRA2QbGuQQ7kNvwGykYxP&_nc_oc=AdqafA35nXpp1z6_2tERCng5HnU7i3Y3WUt_qo4lQdXeJhFEyFFz2_yZuesEMwJdlHQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xxGzqvKyiuuVL7JAJJyU9L6gY6esVGfo7EuiVB35TwQ&oe=6A2AC385"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVA8YJopEAIQ7kNvwE13S72&_nc_oc=Ado83pbFS0f4zxXIV6TqMJgNgXaQQUVTEqqfgnXlyTT_XzAgh0vJ8YAyjjEvvjZ7HKQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cZBxaVwwjS3fleBeLLgEhYn32orL-dM0aTfpPsnGmjA&oe=6A2AD779"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n67asWWXVSMQ7kNvwHbedM-&_nc_oc=AdrSmqsY7xgpQat8ekM_Iynxf9cViz0ZiAhL0BQXDNWqGTZKG3YvjwH3vuBTIMZeU-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l8CXPqlSoUBBG6xUoFvhUn-itroDBr0K5K1gzgrNgCw&oe=6A2AD67D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
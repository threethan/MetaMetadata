scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VOfXbRHVT-CEV5fsebozkcvGan5OxA7t5LzlwRGXViA&oe=6A19A005"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbs0j6lVvmoQ7kNvwH1uA0I&_nc_oc=AdqvCi-on-aQjbh5Ef7APX1c3NzAuxveUAPFNr5iovUoIiJfwgJ3fQilFfBHQ7YLlgI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sqT_0qt_Sr2KyZ0IptwhdUlWoDpWLxt0YqIDK6_f9eg&oe=6A19B3F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44CmTl7tQBEQ7kNvwFt4GQN&_nc_oc=Ado7j-N8jzmGLUFa8tehke2_vMkYWV3qO2JVBSlAHrb-qujdn5b0i9E4wRVfJsq3de0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PXshfCEFQ9iNj4pOfUZPomfDbdh586Eu71Wbgghb38g&oe=6A19B2FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
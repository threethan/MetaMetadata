scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFYbd7_a0hc3rPaP3Aw_mOt_qsP-xVKx0gyU7xbNkf1g&oe=6AB92585"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rplb3qCXXhQQ7kNvwFwqj5S&_nc_oc=AdoGtRW3SClflonLDVjJo_saSa0qNMIb2QuhICYz0wXNH5C3LhqlZSjkWb9lcx7Kt_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDQVgK_H50hc008d-EZVFuGpZsbvhk9YwomgEmfKS2DA&oe=6AB93979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBdNLv9ciCYQ7kNvwGDJSAL&_nc_oc=AdrRQX2znS4m2NUwLU4N1lMx6xUWNdqKXn0MyLcG1Wc1IzdctuME65Lhb0ZkMu8v3Xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTorK3cScN0lC6Csuc5RygxliEgZfAYYMz8VyNv9i8JA&oe=6AB9387D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
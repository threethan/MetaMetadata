uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTzL916fWvcQ7kNvwHsUbeX&_nc_oc=Adp6mo0AJl7t24aWMMpa6s0a9XXS03Sh5ANjP_vnaS3sVxgIf88FCi1Vpm0e70yu-Ss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sDfzmdpL4Z4VqnUxXfuPdC44H4eXnKGhXYcg_sLTCAA&oe=6A087C85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKZFdyNbgb4Q7kNvwH9YJMD&_nc_oc=AdrwH231LgswJvo3Xb3ntN8oyamBKrukGMuVLI2N9vQMz1bibI3Jbx9eeFI5Tqap1P4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CxZ9HF_-PHmyxe-eJJMfrdCaEa57HS3aCkIvPpi6fBg&oe=6A089079"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eas6OKZBoOsQ7kNvwEw_YTN&_nc_oc=AdpWeFw7ZoSUPTcuUSM58MTzuHw02l-EoXTsOUH7hK0613snfRd-dvYOhPCRGwrlExw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4obx4flOrGpgbYJ2ACbTt-X1XffU3Hzx3MMJEpxhERCA&oe=6A088F7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
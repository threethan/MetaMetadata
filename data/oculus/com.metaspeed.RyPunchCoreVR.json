uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac2yYCUPlb4Q7kNvwHNf_5g&_nc_oc=AdreZP3G2qpB5ma-FAFM2jHexolMw3BFq8tDHn4HCDWyXbjuVG1GywhP-WnNEV7Mjjw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfoi0QnJ27axwIZuCBjeWdulOaZ4Q8dRmzOF4KGXEqNg&oe=6AE35585"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB-egyku3xEQ7kNvwHnMcns&_nc_oc=Adow5TuaMM4pVAmLyyQdHX37raiYZDDbQJw0UBZIRR8oEDi89IR1ggRyoDh-6EPoO0I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx-IphsISUPFiv-BEG4FleQC0boTBHyS6Po4-uzwYOfw&oe=6AE36979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1pZrffS8-QQ7kNvwHNa3Y7&_nc_oc=AdruNZL6rKvppLF7MFLsFggtJzJ4YFdXWPehB0tE4OAzZQFM2o4OyD0R8khxVdUsXEE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_pfJfdK8EKfyrDRXgiqETtKFs0J-51z-FlJmcuSlVkQ&oe=6AE3687D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
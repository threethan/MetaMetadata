uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2wLtU2zs0wQ7kNvwH00sR5&_nc_oc=AdpAXgAGZ-CbtcmhfjcwagNdnVQ9So9SJnk_2HZnXFYcHsUYLFNgyICYJYM9TAjI7XM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbcGSbPMNXKrU8qoEq-lkYUUGURX7yqY98nHs6PAOcHQ&oe=6A64C585"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdFoXWvGV6cQ7kNvwEirw7M&_nc_oc=AdqSaUX_Uc56SC9mWh9lR6tR1yhpdX06Wr9pkk-o4KrMvQn6YL_i2K17BRs750g92No&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7sUoyhzMhSipJ-22P4QiFajzmrzRtgHAEFnKGPQUdyQ&oe=6A64A139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VdZ4uFcddkQ7kNvwGp3tQS&_nc_oc=AdrmBNrPBd9BPMVEMTbZdJhOd6wTmx6OpXntFkMPNuHYk9Tf2VZ1vdggQBXmch5rSbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2suoV_L-eO4Sg8akT4lEsd2YOjWq5ElGMkjTg_ed5sg&oe=6A64A03D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
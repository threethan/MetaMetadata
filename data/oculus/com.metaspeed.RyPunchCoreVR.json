uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgq0rAYvGN8Q7kNvwHSFGY7&_nc_oc=AdoOA8PulSbFs3vUyJbrYegFb1iOB69faUEuLsTcRp2xnZjAUJwb39Q-8XStwzLqXvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyr6fb1mTpPE6-nqmVeAeT8lcW8TpnLtyy7voFNS2qbw&oe=6AE0B285"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntOVzN9RNZkQ7kNvwECH0Du&_nc_oc=AdrQkNkRym_o6Dd0Qe2sRYH6xSgRbAaTtKNDl1QoSpd0y_-sGcI2QaH2VLoAp_Yga2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1V9LGZGFcJSEmhPujfldMyxqKRpsW0z4PJVz6VQGiag&oe=6AE0C679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOt263CyMb0Q7kNvwHZA0a7&_nc_oc=Adq8i54fHQDGt3YpC7QxTYhookkdeonpEdA2EJVuyWAygU3jvP5xvBFuCxSJ5mvXMNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYz35COU6OPBuBGxDMRU-U4xUxingeSGompogu-GQawA&oe=6AE0C57D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
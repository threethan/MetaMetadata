scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9AjBVPMmjJ1c5n8B6OBRhL7aWPbOqEjlODAvAf5avcA&oe=6A95C545"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwLSRhnais4Q7kNvwFu-DNR&_nc_oc=AdoDMuh3u1cVxWp8LMH2XDSnjV_CljTjvwAvQjg3njBTLOaHfLQGJplkJ3Psp8P4mhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwAF4oG2_QhlZzdwa2N64IU8SXYVjOLrn_z-ZEmJZdjQ&oe=6A95D939"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNCEPwxlSs0Q7kNvwEzlF9c&_nc_oc=AdqhJt3lHDWsr988clgfSyRv8lW9XxmolDPkeuO4gH4RZyqxviaJYqTgiFQ6_FllChM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ8Z_ob3EY766CHHBQFQjLce3HzHFNw_XLSobxkRDQNQ&oe=6A95D83D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
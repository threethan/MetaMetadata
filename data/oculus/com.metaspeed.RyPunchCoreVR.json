scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIelcf9TTGua7571BMFyDEIHjG0hWnJXBXvkqMqy9vxwA&oe=6A9C2485"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu2I-Lgd6xsQ7kNvwEcCTVq&_nc_oc=AdotDPXHv1ujbhqTIBdHCz_4Jz6Q9Ms-hlTi9VeHeUszdypA3KYYeXv9QMHnkXuT34E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrG5Q97544wEIbL4cAp0566PI-IhgbsOV44sDZevDu0Q&oe=6A9C3879"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KOL1jmsqMEQ7kNvwFwJIo1&_nc_oc=AdozGT5grLorTfmRQRuU6mVBMQYzYeg4SEjojliWwNdgf3NyGe2N0GRL6qaEED1zlIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_NllPEWXxj2rvptvU1M15aD7hYl8aEhvCjnqgF_3WLQ&oe=6A9C377D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
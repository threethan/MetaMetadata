uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7Ww4Blse-AQ7kNvwEvcjRw&_nc_oc=AdrF_alcr1oCbtaewot0dmcqEJHT4SuVA4v96xgTNagb8zhONZ2PJlPyHAep1rrPKZM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbOP__zH1Hfi3DmubCeOMGfKiListBHjECt5UPKVJM6g&oe=6A4BB905"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP0v8i2_T_EQ7kNvwE_26Sl&_nc_oc=AdrSccdgSvR7S5VzL6EJgZuceRWQgb2epnxO8FW3rY9VXuhwjIzVaXWL-z6mDevNLQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC69MPTJHMiZ4ZZcO3XyYqqlWZqqocHcBcOxisdLpIUrg&oe=6A4BCCF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woBasQDAIFQQ7kNvwEAEg8g&_nc_oc=AdqEOYTDnhmdd84jAclZ952h8FwM9WSLRTkHVu9ddfUmudXR30wbqAAeBNkID7jLThI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDytkfzCySsyfQ9xZRz1J6D-DPKwCsEc3apvtxKzGBBg&oe=6A4BCBFD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
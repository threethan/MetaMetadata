uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3Y4Ttq134IQ7kNvwGeKr4k&_nc_oc=AdqRyANCMSFQgqg_HDULQATUzQFTFFh5jTqRIyQSoKcgBAjEmoC6gjfilTLZBxZepc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGC-vGhHogWVBIoEHvLRq8SRn0pFjH08IHybuxTP0S3Q&oe=6A9EC785"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu2I-Lgd6xsQ7kNvwGaVeLi&_nc_oc=AdoPOiUpvm6FNe5yRSKDcUCuqZ4KqlXK0J8VkGhK5kjyVAvSKFgqf03GxeO63IyaiYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMyjVRj0H30WPpK7HSFAwAU1SXC4q3Sa9bQdBsj3rd1Q&oe=6A9EDB79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KOL1jmsqMEQ7kNvwFhqYq3&_nc_oc=Adp_4Wo42Cy0enf-Z396D8j0E868rRszv1xKQxGnBKC9yGZcBOhKkfAh6sJvny9Vhqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYKXcCwky37dxsqiiVGMAa1_qZoU1oJXbPFMeU-Pv75g&oe=6A9EDA7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
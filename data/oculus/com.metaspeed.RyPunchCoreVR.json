scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcmdMDpmpLrBR3YnXDYfC5u0F7BZmgHPqeDv9vLHNtmQ&oe=6AA2BC05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1jX4cDs0YUQ7kNvwGI8HyS&_nc_oc=AdpP9IjCKvT3MY1O3ALvqV7EsjCOdAiLf4fmqYcX4JSRJkTdzEfztKql26mizZQ_OHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6juIsruvoW0hseYoKeUDr-Eh5H-1wGOpaeP6hHEHwNQ&oe=6AA2CFF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eigg8cR75hIQ7kNvwGCZq3l&_nc_oc=AdoBOezn2QjPoR0_EbzWUa_emg0buCNLt2Goev01IFQ88oVxyxkvtG-P_Nid9iiNDOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX2ITAOGae_rPd6qCllNaETM1nt7LdDldhV9hhMJbm8g&oe=6AA2CEFD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
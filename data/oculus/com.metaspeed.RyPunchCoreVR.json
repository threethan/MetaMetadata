uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtYgyQIYiE4Q7kNvwEol3Rw&_nc_oc=AdrcqWG5yheX8zJtkuLySUKK-kQOnFbHy5WUoFm6PKEjZLeyptWtxMBp1XX91gkIPuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvwCMZu5s9D0zSqYLITPI0JJRzMrPh2QZj1Jv1t6n3rg&oe=6ABFBD05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cryIQRBDr0Q7kNvwHLaHBP&_nc_oc=AdouWg49EGUC7g-fQPYOlii0eIZuK5exz3yTnCMysxHAPCxhkhQmAHatO58RDig4PIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxds_EQUH53lOmIAdb-r0H_8CHUraK73zP1JhOhsHuYQ&oe=6ABFD0F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAR8L1Ma0jIQ7kNvwGvOV4d&_nc_oc=AdqxiGjwhNwfCbKdaXAAxJeoS8lQYtTVzMtvIn8Wv7L_mVcQcWnTE1JMDw85KxVw4v4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSHbQDR5IfQHoZ9GpHGDQrx_eFlAx-xdqsQr68H444Ew&oe=6ABFCFFD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
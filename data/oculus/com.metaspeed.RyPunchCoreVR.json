nt-sin11-1.oculuscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fYX4b2LsKoQ7kNvwHz8q-L&_nc_oc=Adqs2oTqA6UX7tkDycfKwFR-EOwpOvijstv7eCokfKdQtwPGrd2EntTvBqNXbBe_590&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76YKzbmRo5-obQ3L_YOrhBYGtcJh5Vv-EjmHHezVDsEQ&oe=6A11B705"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuff0VfwgGsQ7kNvwFmRqw-&_nc_oc=AdpJuaLamxt6Pw7Ek14YPreZFbjKs9ZBsPruBfxtjPovbqdZ8pAA2Vh5O08APayTIh4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ON_EaxyQll_i4xI9L-Hv1NP8mNXpzLOFqOqC0oPaaqA&oe=6A11CAF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7XB7CM2Vw0Q7kNvwEJXbBZ&_nc_oc=Adp7m-awzaTRF9zfnjSt4mvWjEdS6md8q26I1Qi_jxomC-hPfr25af-ke-5_6uqiPgo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iG-cxGRoOPwu_9AKUFWgbFFfglEBBMfClKGZ1qAzsMQ&oe=6A11C9FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_descripti
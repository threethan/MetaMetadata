uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdHlhTpQ36cQ7kNvwFZLb1o&_nc_oc=AdpXd-_jIpQfryfWpZQD3qbJlfL_ytJm5JzfI8xPyx8y5Y4j5xIL32zfEGI2JzVYCNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGteivWftY9njJgSlsJaql7PMvenU0gatroqm-XohetZw&oe=6A846985"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTiL1tT63OAQ7kNvwF2ZkND&_nc_oc=AdqfsPTc1EU9OEqOJzKZjyQOwwzwx6Ct8EmfQgpWfmoGL9VOkhVKh_uh8u1mNEtJ3H8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8wvgAa7onsEPnOpfYhJaOMxydlS4I_KhTLYdk_dI8Ig&oe=6A844539"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM9pjDjq1SMQ7kNvwGcjymn&_nc_oc=AdrDaAuKPAPHIKeD_Pvs8wMmgGpvRpbF6KWQuHb4Al_tEmJQwzgPhdUO1rduMHNYAp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9NQ5Zql0X4ff93S0mzbEydrxZ68oinrt6P1H3YhX6EQ&oe=6A84443D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
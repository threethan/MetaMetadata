scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2kupPl9lWgJth0-S0WoxsQz3J3MW4XaRVrQLaCO7eYQ&oe=6AF47905"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSp0E2nbL4wQ7kNvwGug9sq&_nc_oc=AdoYqllbIenM5O6teU8L_4oJb5-mROLqBIXo27KW5sbJLFNxvZV9m-UapKEn-a5xv6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMLPEWI5m7inbqjPX5unX9pMOvxxawzyAG1CS3n7U-Hg&oe=6AF48CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIrSzMISg7sQ7kNvwEyY7sQ&_nc_oc=AdqHIgRvrEJem30-n6v35Nm4cM4hFb1W2qTOZors0flg7mp7B1ZWd5z_eD1jRxhx7dE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvrlwLFdw_fSV_PBxut1jstR5W8XEFY9Ml8A8ujIyJMw&oe=6AF48BFD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
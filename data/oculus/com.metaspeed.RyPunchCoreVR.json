scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYt5Tp14uQUmk8gK3JtgpcJYxNOyWnt5U0er465G1Jug&oe=6A998185"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfjiUADdbPUQ7kNvwGI9dis&_nc_oc=AdoOQOptoIB1IgZ_Uws3F-WpETKXVQcg5L_aP-w31R60AgSRJOzppNvMn-Hq6lHO0pA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLURsE7ieLq8je0X5PdhgPXBO402D5o6KWmcAm7MyHLAQ&oe=6A999579"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBSvstokBgsQ7kNvwFdKbC-&_nc_oc=Adq9jsNe2Xt6HyFPAWl0NMPX_D5h0qUUOXfeBwkELMMD7Y5ZEiiOHncCtLQpA8N0hMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLZw9fDLNh0q4YNv9SMaxRB_r4y9qMNUnkLfmR1REwSg&oe=6A99947D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
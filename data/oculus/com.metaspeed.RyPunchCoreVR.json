scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hTOCxAPiQz8MYWoCExR_jpYKnYWx6b12NANm38tJkLA&oe=6A3A9585"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eucj04SI3ssQ7kNvwF4D-KU&_nc_oc=AdqoIggawXsdAVLVENPnKX_Lq4FeiDGmHd1cJXsQu71sdx2IYEa6O8opfBAoL33SqWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--3Gkj9NDcaB7mbaqnOx9DjlNqDyMbuq8OtRt3x_f5Yw&oe=6A3AA979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ed--HGDbtkUQ7kNvwGcIy-R&_nc_oc=AdpGUvnupgxdCZ_SbZFlikD4NOXZeHYmPhPP2mCKHpgp1b9SBXTJu0mqxsBtCvxIrrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CfiXWwY7tKSwmCT2e2Yj3YuTLbP3dcSMfJyPWu2YB7Q&oe=6A3AA87D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
ontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paseslHtLTgQ7kNvwH3_D-C&_nc_oc=Adp74B6xEbXiQXhplC3c4jdsRHpYMWcB-tbz-2pnKXGiqQhgfy5KBmeN2uff5j5Diy8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPNAGTwOrYBEvUQyOPoUoyXUv5OdiCXY3UBFpF4ZLS2A&oe=6A8D6BC5"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R322F_MnuDgQ7kNvwEXlsRA&_nc_oc=AdrY0DOcZPj9Xl1CFNUL6KWbkO0kJHT-27hSkK-6Lp6fbUpkzFIQDrvIGeP-YDpost8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPUWoN9pkOIqG9O89kOvG0kgU98xRD4H60up0ogzXZRQ&oe=6A8D7FB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywrRKWv4RcEQ7kNvwHV4p0n&_nc_oc=AdoaUBYI7wsiwM2xc2q-BBAEro6zH63-tWpq63e6taN6aN06msIAKH_-nAa6Bxbl-x8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExJMvqcSxEMC_VrZyC4FgjlPMUEsfKSTGXjAi04Uox2Q&oe=6A8D7EBD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_descr
823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4j-TLc5ZD4Q7kNvwHu0FuM&_nc_oc=AdqLW5LR4iQDo8HScp3i8A6vPHJy00LAE6yUh1x551A__PltS9_6ZkFXcEnzT7c0nd0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8tIwoHUI3L_2oCVix62zfsgv5behZPz3YXEOCC-QiAg&oe=6B0331C5"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dx7m6Nvt6dgQ7kNvwHrdR8d&_nc_oc=AdrjEk7OdhNxBB4nJ2644RV_HWs0wg20mQ-jW7F8k-Z-luJTIq7-UiN2trBARYcHovg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSwEPA7pqqOxhOdupgljAgFQNPrF6Q-QVZGSNSZiH7lg&oe=6B030D79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcUd9_gpre8Q7kNvwEOsGLk&_nc_oc=AdqboM6kHhzsf9pzH4aET_lfr4A-iBCTLKl3VM8Tle8hu4nOH0k5E6Rwy8BJODywKhI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFKRs2IpOCf_sI7D9FNRt92qsWkAET66oA37cXUdEpnQ&oe=6B030C7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MetaSpeed", "support_website_url": null, "website_url": "https://rhypunch.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24834366279596743"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824665_2237128866794822_1234838594726735426_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lg0W7gf9Cs8Q7kNvwHGD8iD&_nc_oc=Adq1qxdOkyK24-EKt9K18S_qVdalKSE2O2sMV16zutxkUzpG6CmuYIoEnHUC3wb5PRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6jyXsiODbuRB_SvGHoypGoXFiHmRGXxmfAslDUOcFEw&oe=6B032478"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhypunch - Rhythm Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade"
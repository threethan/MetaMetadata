scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnTM1-FjN0hj8L1MSpKk2ch4dOPl7_nX337vHeQmXpKQ&oe=6A525085"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28FYVb9HCXAQ7kNvwH9eEBr&_nc_oc=AdqVYYE0OVit0DV1xpHcyfvfKZR5mOAaGIMQjDJDOZhNvIkosOGEuVpiGCQxYE_NDGo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcjbe407KBlkXMIEAM_oLNe0vjQkPTqGaDT6KXxL8yQA&oe=6A526479"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbEpsrtR5nMQ7kNvwF7MSYu&_nc_oc=AdoZC0hhA_Juf0FLpEpzVGf2eKZqcOMkpnFMwgH0P184XGxrTxNMF-Fh67W3iQkYw3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBp7RtbHiBUYpHlK2iMIA1H0i03Smt-4OGM3UHIsFbCA&oe=6A52637D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
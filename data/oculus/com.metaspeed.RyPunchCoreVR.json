scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQXPjHZMHW_iLpoutg1FGdMmzeD-3v8bLZbT22Ztm5NQ&oe=6A70A305"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqC_E6UigEQQ7kNvwHv5xlL&_nc_oc=Adr94gvX6eH82KFEGsx23451PSWXwOjoBn9oZ3J65xkW6FAZMvAT3urOnsjD7G4w4_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6YRRarS-pei19H4GkaHGsSsSB5tEZuj2aLi4-gkI0mw&oe=6A707EB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t22F278uPpsQ7kNvwFf87ra&_nc_oc=AdorP6ycOn-o_SuC8QTvmw0X_Nu1FSGqmifNpUzNlhNnMR2W3CKPahUPOMSnHaFX1Pw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErhJ7qZkehZi1UFPNd0w8PZI5wbhwdhDHp24L8ldoFww&oe=6A707DBD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
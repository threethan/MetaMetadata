uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3Y4Ttq134IQ7kNvwFZu5mR&_nc_oc=AdpVX38tpBb7yTREBxJ6qMmplU2ZIetDZEzqAOFG6fZIDQVV7RA8CrgrSwA-qM_0zb8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwjCDtheFXU64YOxJCYpwZei7y7O4hRuFak_1AhG7xtg&oe=6AA16A85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1jX4cDs0YUQ7kNvwEKTGxg&_nc_oc=AdqYm0anzfv7Oy2zmotlUedAUYnty5FtIlfM35c67rbqtUe2XGRXyDyoeUxnRSHUqrw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGRqwX28kyxKw027U35eO0yLi9sDN8AJbQPt7V-oE0Xw&oe=6AA17E79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eigg8cR75hIQ7kNvwGwY0d9&_nc_oc=AdqK6hztc3i-Za_Jq8ed2CYJd2uGtEmC1jLGAUN8PMYWw5PZFpiZje3siErATdO-Szk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrfkEk-mSdmlWae-PMCPn50WW8DQO8Q_qLiKCYesuZEQ&oe=6AA17D7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
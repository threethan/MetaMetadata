scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkn_WLPv8pKZ2EqndlzBLNWo-mSa15wSl1x0UBi4cJbg&oe=6AE89B85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKerc1VkiEMQ7kNvwHedDaA&_nc_oc=AdqO-2bz8kwJoahHFWg0X1ztJXxTmazg4tj9dsEgkiCl6JJBGURoa7y-eeoS3L-YdNE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYsfNL1HP4wXbz8-De2XZU-xN-rmVB3R2aVbwQoaU_6g&oe=6AE8AF79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9kKIZlQe28Q7kNvwG4PPnX&_nc_oc=Adr097PndSvyc-3vqd2imAnmR02y0mkkTBdSKz97-Oh4s2xnfqK0eHuhUEBXBXccYFk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8iZM93gW3rBRDncjoE1TCzVhjJ2LqD30nHIi-h1l6Ew&oe=6AE8AE7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
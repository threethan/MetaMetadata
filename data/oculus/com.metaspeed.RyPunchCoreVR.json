scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1y11c7-I4ni23FJFiGQ3-0nFyY08DLiJEnPd222nA1w&oe=6A7C4845"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8Zt06vnA48Q7kNvwHIYGcH&_nc_oc=AdpU24HO2-ORmMa7kVguNhoZxZ2MAIaETgJdINIuSmTV9oBnpagnxo_xEKwXfaD3c1A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdYZv-UczVRHd1gvFzibIKJ_ZkQtsrbjaE60mbGlB_Ig&oe=6A7C5C39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNA-s_r1x0sQ7kNvwFhZ-iU&_nc_oc=AdrZqLA8ywFJMCGWoZuOX0fKv1qg-mEM0NooVS5nc-W5DVMWrZb-LX05zj-OChnVYx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkwut1aYbtApD2OOG0rOaQKb0uA2VZmNx2Hv2IAyaxtw&oe=6A7C5B3D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bItBzYEDMn8Q7kNvwHHbT5K&_nc_oc=AdpK7yRVy5P0wgLJMR3A543bRtYHQksrr3-j5ih4_pW1o-NoCtoHLVRRGLBBhjnBbNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1TTkpj2R2vgBP4Js9SO6_gegkH7FLW8fPmFABCwHgALA&oe=69F09D39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86HYnFjDg9QQ7kNvwHl1v06&_nc_oc=Adp5KyWOTFgTPtMgodSU0X6QqBnLtDHnCWbEQXaUtzrKIdMiueIlp9XnifGPKvTr7sY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3IzUO5h1K-BCWZCUkglXQsQqAOuy2a-JG9rqPgF3UJxA&oe=69F09C3D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "MetaSpeed", "support_website_url": null, "website_url": "https://rhypunch.com/", "category": null, "comfort
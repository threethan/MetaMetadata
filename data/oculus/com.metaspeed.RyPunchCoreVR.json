uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6KDwyR-WhwQQ7kNvwEpGbKo&_nc_oc=Adq-vxlnMZThEnA9XXoRnfyO8e-RpX9aNGLvi4p259m86LpCMmsxP6tLLSkIKOuJF9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y3TZhgrniLE6sq4JbELJKjWWQiijKs5oHMnlNfZgd-g&oe=6A452185"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiHXB6kxyZgQ7kNvwEJ32-0&_nc_oc=AdoTaXWgOY94UzQRsndnTyPvkgdssmkVdnsvnaIuZgGyaPQIEOide4E7JxpZdcJOs6s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VjHEkiiQsUBpeIMC_wQhjyjqYhXSa7CsOgtjXO5OR9w&oe=6A453579"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGr-qg8r_ogQ7kNvwFDhD8Z&_nc_oc=AdokX5lKo3d638plZf_bU8dbKVR1OFJTg9lalIj28NDW0XA6pvSglYeBTGzJfaR9Yns&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96_7DJdcl753ovZnmVd-Lkpt-cA4fVCvENN4XfpsDorA&oe=6A45347D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
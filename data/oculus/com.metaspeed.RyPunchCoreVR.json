scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qc_47nZqXnrcmwi6BbYLrOXDdhr4-8NzsAbRuVcs6IQ&oe=6A315B05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2rg5rhWdVwQ7kNvwFVPsuG&_nc_oc=AdqTHboEuFzlppEV8hsSmGBvdtmpvk3o81DjiM5Vsgjao5IBuvvXFsQMyyBwhSd2Mzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9rWuC-uDkQgvVHe_rxKv435ZdBiO8oCFSowGzGZ4Wkg&oe=6A316EF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYw9IDT6WSUQ7kNvwFknk0h&_nc_oc=Adqi1yP9CIrX4YM9KMdtaMHjdqyXnT7tK92lcfPCedPu8PZ28mZObzuPHJwGbD074zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Tu8kucNuL6o4SmnI1KC2JgwNrIZthU35JFlIIyalFuQ&oe=6A316DFD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTiFtjLlRE4Q7kNvwG-RpD1&_nc_oc=AdqF9O9RqLA3SvkWKYXGC-Pi9ZjKN6ouPQyLSb1fgU6N2SjdkxoUdYNm-slROhyX4cI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPH2qNX7xICrYlIxNsfUtgfC8V7XnlGq0A84Eus-goyKg&oe=6AC50305"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnebfyNTc80Q7kNvwHRxlQP&_nc_oc=Ado4QVUdPpxtct9brEwbh9G28Y1mM45G2ShJiaPAwXGZOXqHIKRTrwkv6WirLrmEhv0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxZxFDkYhwanE2kqaTAfV9bbEpg70MPum9cQWJEznTSw&oe=6AC516F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldI9hhLzaLUQ7kNvwEniwU5&_nc_oc=AdrB70UN6xyWOCBSDh92hgETWMlCW2yS0boEW3YZ3w-o7pCrsTtQp5fqeirma1V6Xrc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH_TfQZEZB3nmaxeJSz7ITWE6CLTS7WzrrXoL_WggZ6A&oe=6AC515FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
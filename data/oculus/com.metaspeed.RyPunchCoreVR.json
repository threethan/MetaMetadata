c_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V01juNcGgs7GehEzKwFAHToFLBQt0nSwaaIqjKdKNUQ&oe=6A394405"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eucj04SI3ssQ7kNvwGlli9Q&_nc_oc=Adoz1cS-NjlFSq8T55XwjRBgDgxG5LXW-U-N4CELbNFt6xXT4eV0tlrU6LGjzo2Gl20&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iiVx2DOKmC60G55Dsqa5HJQy5G4wdTm-GcokNfMX6Lg&oe=6A3957F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ed--HGDbtkUQ7kNvwFO4UU9&_nc_oc=Adqd1Q_LVx6AJlsDKAXJPTrDX0RAJfdQOjzXKiGYoENkl9cINL2Gyve2P3GkMvVrbz8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vrYKwZqb8_Novh94QqE1wr4e2GqjGlpugMqWgN2a5og&oe=6A3956FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_term
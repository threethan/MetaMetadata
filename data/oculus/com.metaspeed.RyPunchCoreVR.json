uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf90L1JbxjAQ7kNvwGHKvaI&_nc_oc=Adr6P_2apLnv69Mw8HXiGZLxsxD694-B0xscz-xHtciIpy67jduEeVmGkTO5FBXM7ow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G2BedCYdACUkcbpEIlQxuvAenZQoiHGkjGUIihj6kgA&oe=6A0C7105"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4uLLQL47bEQ7kNvwEzIXsE&_nc_oc=Adpdbo5GnXSjWxhMFiFtyzrVICgKoRDHc0R8IwncwqMiQX3yLesx3Jo3oMmJsn4cmwE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62ojuYcEs9Ye4zhZcVHnlhDSOchh_-dYOrxU4zjO2bYg&oe=6A0C84F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPpeW2PTLjsQ7kNvwFBIvhU&_nc_oc=AdqDOY7ejU0aEyFb5HrnNCS5vRA5dHdhW2y7QB6G58-tpG-boKZjph3WwnDHaK09RCc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t4oEAVygGG5ZFyTO7-dVuYgs4MH_LqQG2j3nO0PHI_A&oe=6A0C83FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
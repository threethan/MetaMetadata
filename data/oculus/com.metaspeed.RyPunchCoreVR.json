scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLJxAzg2Ek5wkaP0c8M0-A2_ssp0PmfqnTcK09bZdfvA&oe=6A8AC8C5"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NLaInjuE88Q7kNvwEKVCNn&_nc_oc=Adp07RJyzddDGtzDSWsPGZRjc3QqOWf6d3fqg-RnJa0an0zAv_8GvvHQFuBTkPLwd5s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY2Mg1H6oIQmf9fb_RGXbQgRlGwlolCAYgdxrBDorv3Q&oe=6A8ADCB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44XOD4Opc90Q7kNvwGqgFmN&_nc_oc=AdpVwYkXutv9CvdyIIwVmf5-sw8_EzYS9kWvDsdGzmv3xLVnXD0CtqfSH7mrKdlKikU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmkwJ5uJYtB7R8WMILzYyXvng0OBAuzz6s_AlwwAmDoQ&oe=6A8ADBBD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdbL7THobgILsooKOtN-39HEkwQVShSYQwyZyj2SVJ6g&oe=6AEDE185"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRqdrZNfpTwQ7kNvwGw2UvG&_nc_oc=AdqWUz_vul_IHLnMhEmOLEyxc3a0DXAYRDYB9wQio1rSX4l6vzgyovC2D3FK4jse2lw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqBcgBzNJV_X2dJ1akmDi4J7sPxSmRuouMsoxjPedCtQ&oe=6AEDF579"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ho99-aJY1gIQ7kNvwEY7Dd8&_nc_oc=Adp-WIIEZklU6seJUxBorO5V4bR8OMXw8n4PXlyZS9ZpFLzDk9p4mYLJ6dnmW5Lz5IU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc94yexzHpPWtgm9Q5TcqQZAQrrRjxBiuc2b1fTmXEgA&oe=6AEDF47D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx855IStqTJ3aAGpO2x5sML9K8D6PHhXjf4b8x09BXUA&oe=6AC8F785"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x2gWg7WOdokQ7kNvwHq-VkU&_nc_oc=Ado6m7vvzRN3ontO6IwPFeZJEM-mUt5H6kJVZRW-0vrs6hKXh6VEUGbIKeV9dPiX3Ik&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfC9i_1D_YVrnGzBExhNxedc2BBnBlycIyz-sBvu8isQ&oe=6AC90B79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHZAs5rRcxEQ7kNvwGdHO3E&_nc_oc=AdqxVgH7PsMrumRQ-setwVkxk38LxoSVio2ugzoa2aVsWIPQalD6O26adkT5jZxgCQQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFTr4N3tCp_Bz7yxIwbP0GsZeLyw0Q5cAdni2vAzKkQQ&oe=6AC90A7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
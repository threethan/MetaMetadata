c_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hpkRkackG861k9N8OGukqPNCGvYgH5RhBPW_Brei4ZQ&oe=6A36A105"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hjYMFOxcxwQ7kNvwHe3XBQ&_nc_oc=Adq33V2IVuk0ngwOLa7W4jIT7OeJegqkC37sZnPge4hFpIFfDT8K2KB1MDptUjbHOEA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IsU8yQKpDmY1OZHr77OgDw39iCuLwWLv9XmFKiAlIzg&oe=6A36B4F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaD78njhxSAQ7kNvwEwgK1Q&_nc_oc=AdpPP3Emj7QqXw-v3N5_Be8ApRqwJ7WXlK1PrwVJ5zS-ILizUosE0qrtlUlI6wI1U98&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lYLU08tWvY5QtrrtaklAWH-0T94K7Ch9Ew7xDB9N-Hg&oe=6A36B3FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_term
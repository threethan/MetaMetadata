scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-Np1CufR5-YqxxPGy3y7idpRkn8RRGQFyzOwtM7sztg&oe=6A81C685"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6scAnjnnFcQ7kNvwEL947m&_nc_oc=Adqz3DQcp_l5-Q8OysH6h-kun0f9pLspWammKQ-GG9Uj93g79U-mZQHduoXPQyRGr_0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4Qvvnf5ea1mQXESWKoHkfiUmbRMJI97c_SpqRbcmYiw&oe=6A81A239"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stjCkixyRS0Q7kNvwGypQhd&_nc_oc=Ado64qoMvX4WADkE3KPqkMyf49Z6UGJZEu-aOaMBe-rKq3OCPLTA8Ytsv8-sq3ap3rY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYrI3e8cN5AV4S5rz3c4Blj7cJ3JUfwvYkfkYnz4-lyQ&oe=6A81A13D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbKxbWN1_gaDen5eYKl50TxcIlSCif0dB5blSAesaXHw&oe=6AB28E05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leUoiRE5RBIQ7kNvwHWP0et&_nc_oc=AdqKR40SEt37sss3pyPqEY8V6QFXEobwxEdqtGoycnJ_4aAUifVaD18tJAqxZAeqzYA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLou_Gqo7yrvW8ln2Y5MQPyyq0JVCPuBswfm-VFHdyDGQ&oe=6AB2A1F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx82JqUjdFoQ7kNvwEktyvk&_nc_oc=AdqDXOIItHdYN8jLHWy5fuhxf9kPeIKDCvuZ_qDEbnwjjgFjmQe0Ebo6N-oteaAnZjI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwRw4SdYOto9FQvtBo1JhAWLmikyn4bYeC0Wle0LxKpg&oe=6AB2A0FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
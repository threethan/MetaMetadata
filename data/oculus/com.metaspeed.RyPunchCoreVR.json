nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxF9kfPB4z9wfGXTyDtET3nHRIvBiaPAqWsdNBV8tc1A&oe=6A8582C5"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTiL1tT63OAQ7kNvwGx0zca&_nc_oc=Ado_XyeiyFbZof5RUm7rHq57ARqx7-9m_BxcYCXler-HxjoJ30cBUriVyV7LwOD8_qY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrVQGLYTk1A27FPF3QL-xBZWknn_yooGgjm9GujIjyTA&oe=6A8596B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wM9pjDjq1SMQ7kNvwGI4_pk&_nc_oc=AdpBdz8SzLL9AKbxqKMbenfjuJHUI1SMQWCHdYeDZ4CXZLPqLMVnjC5kR0NGO9t8DAQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnl_qjRm2jrgxTZgLuI7C3ozUcK8Jw4Kyg3wr02o2XKA&oe=6A8595BD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_te
scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfW17eI8Q-SB0cBLhIBla59IbUWJC0XFsDu_4RN8l5fQ&oe=6AE5F885"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB-egyku3xEQ7kNvwFm1YRb&_nc_oc=AdozmD4ApcjwYpFXpdpJUHToTDYgq_ODzKEnA5BnipBMqWf1L3DMIpKQle42B0PIYZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC3--l4WMyLKI6UOKamNTxGQ080XS6ZiW9L3Cp4D75oA&oe=6AE60C79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1pZrffS8-QQ7kNvwHOKQD7&_nc_oc=AdpxUSTDjqV_aSRxB9RL9zAvjdWXiAgQrN6cFgazdu1FYNcelKBVFwDTLpcSeCwsXG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfrJkLZDU_depuGH_YpuVAN56c3vfG5KjTA5dGlJhu0Q&oe=6AE60B7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
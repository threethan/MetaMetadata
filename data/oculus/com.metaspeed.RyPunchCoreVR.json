uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ac2yYCUPlb4Q7kNvwGa1u7R&_nc_oc=Adr5KoWUQEKoZWYo3Q6am2R4N282batXf2EKafY7tds1RUsEecBvlzzIaS5kwBLARTo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjVQ55j_PooN5kTJBiZ-OFrluYIikzCGuQ-frgfI5t1A&oe=6AE4A705"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB-egyku3xEQ7kNvwGeMgEk&_nc_oc=AdpxVp-t5q6JKkkpks2Gip1f90s3g_Nla0w11EjFXXaKm8775cDLyqzpMk5ykQ0wTy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP47YlXCH1PRFii1xh81M-O0GMc_OMiWIArgUwn-1eTGw&oe=6AE4BAF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1pZrffS8-QQ7kNvwGnisUo&_nc_oc=AdrGUI5doP_HwYbXtY_WLYeYk2nL3RyM7Gb0gB38_8GFbp40Y50akR3w2VYVvBbvn38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDpQHWzT83A0lbq3VKQdb1TM-dfBrPpo5-rWa_A0WAOQ&oe=6AE4B9FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
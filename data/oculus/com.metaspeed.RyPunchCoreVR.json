uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ettrJeLZ1YQ7kNvwGquYN4&_nc_oc=AdqIRS-YavntDtmjWVUHEqqf_qFIeZlKB7FwJggImRU9rfUltpsg17gcJVWAmIFypr8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bvL6eDRnyrEHILjtNOwosSW4o8SuSmVatbMBM_kjDZg&oe=6A184E85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tipoE3iu3AwQ7kNvwFolR3k&_nc_oc=AdqQsdvOS76p8b44bNK4zQICEF_jFpWnTu7evE5ruUUYi7MJBVc9VgUqqUwkqvB2XDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mF71EP5gbKZUFCZKuiennNz_gjz-NrLkgWSqaZAd_jQ&oe=6A186279"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjV3ylhDcgcQ7kNvwGcKJnS&_nc_oc=Adox1uCrlYaUYImlel3UeZgnWz4b5YeAhDQSrl29ciftb2p0hPDXpfAxbKBNE9_hyy0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qg2rgh8mnD4lcW3uW5xqXqyKR6tLQulI1l0BuB-EjxA&oe=6A18617D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
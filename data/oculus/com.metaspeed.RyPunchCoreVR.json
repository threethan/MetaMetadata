uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fYX4b2LsKoQ7kNvwFLEQBU&_nc_oc=Adq-FJtoEwFTm-6QVUY-lCf28uiXLjBDr7h26AlZ_PysSrwejK-zg9zYZTIFLgmNKBs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QX0caukhbt-mTFCLEMR1PgiJhmHBgtQIE7ZFinu4xeQ&oe=6A106585"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MikwQADgn0EQ7kNvwHHyIyr&_nc_oc=AdqWtb2mpWFRtBBe0AnEjL0c-1HjLpp9FT7yIegkx_CtzeOIdkqyZz1FvkEHgmDLG6I&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lX5Zc0eZgejLRLYcogsuMFXADbteGhmGpp5qu7-4AZA&oe=6A107979"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mybA27e0-osQ7kNvwGnYueY&_nc_oc=AdpNr7iBUszXQg0sqqDoS8QqTuro8CQgxkeatVxDUZ8b_9ywLsIXup_cubjJWXxqk6s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pml7DXTM4xhL0U32fMBqxlCxsVG1Puo7eP18X-6kn4Q&oe=6A10787D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq9-PtAXB0IQ7kNvwEFKPGY&_nc_oc=AdoK6xgtZdzTVXxEM1xhVAP7ORv9PpVu1Kxk1WiGVkvnRePiKEp2EVQJolXCA9nj--U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G9603b1LPZByI7NbjR61TuS46NRt6SwThzE5LRL6a9A&oe=69FF4205"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1lfkRMd_wsQ7kNvwG6zxz5&_nc_oc=AdqGVl41mkdY2kX6NtaO0om7U1ARZwjzfY1Szhd3CFM_UC8vtCmEUJUAhmEBttcdZ0s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ql4DYihE-VkfQUH7Pl_3Fr398Sa46ryxidsoItGOaiw&oe=69FF1DB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMkJBajxgtAQ7kNvwH6dUnm&_nc_oc=AdpRfZiPEW6upeWT9_tLNlEnGZF7CWs87xsCc-Z39WSgBTvLr-dfGVumQ0AybxZ9PvE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KWqfcdlfjRVhMBx6MtMdH0Lm6_q86ba7zttbQumhalg&oe=69FF1CBD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
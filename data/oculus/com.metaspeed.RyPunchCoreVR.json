scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhoZRD-rnRvZzRHGcolz-7X0R6cT2ob5qK9JDfxII9mQ&oe=6AE9ED05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKerc1VkiEMQ7kNvwFZuw9K&_nc_oc=Adr9zjWtD4lpevP2z2f71fGpEBytiiJYqw8MV_DlRfVsJcxZhMLKq_-EVY0f4d6Q74I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS81-5GoQq4rmVbhfJNDSAEVwOUoQFCV2KPvsxFfuv_SA&oe=6AEA00F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9kKIZlQe28Q7kNvwHlxg-B&_nc_oc=Adrmwfqgdf2r4_LnnbhR_Tww3Cl5IzhNWPbhicg_T8HUYeQn-vb1CCnNPaqLNkl8BWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSRxrTKi97rdhpAKUwOflfe1p8FSlPnUjBwxST4M3ErA&oe=6AE9FFFD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
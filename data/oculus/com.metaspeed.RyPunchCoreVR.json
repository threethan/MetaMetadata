scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPACmkITM2tyfB12uQa2_Xx6nEWB45BRTIMALbKCEFNaQ&oe=6ACF8F05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lugflppCCPwQ7kNvwHcAFAV&_nc_oc=AdrWtboLiru-oEpLnl-pVKw3skjuY9u0SMFDxgfKK3oqQ8zpzusbrCA-htfMRFwFri4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbYvfjYCB1euLsolSsB1rO8DXpAe9PmYJFe3tgmqTz4Q&oe=6ACFA2F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58L9k_wF5sUQ7kNvwGavLFo&_nc_oc=AdpWdF_K35Xf48gSSvTDyutkEmham2TalAzCb5wnWP1nbzR4fNoaLeS1e47q5FGg4oU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0r6QoXcSc89ezey3JvDv7NW7fBsKk5cQshMoa8pOXwQ&oe=6ACFA1FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
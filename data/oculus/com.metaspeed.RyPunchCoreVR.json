scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCjymEFs7cNqhPQ26vPrsci7Oa9OTJu_lQmf0A5Qs28w&oe=6A491605"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP0v8i2_T_EQ7kNvwEcrqDg&_nc_oc=AdrUen8u--qWSvOZboQihrctJtBJO3Gh-clcJuPlR4u-ONZ9XJ2R90SG2kiyxnwjT5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwpWDrWxTOrGkM21ZrAFQn1Wh9SpifjB7B4PDQTd6RLg&oe=6A4929F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woBasQDAIFQQ7kNvwE3LdIg&_nc_oc=AdrU27Vc1unwVaKcIecdAkVaN5bi6lRG_xB6yjaCoca8qD4idu8blNPkBoJutt15EDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0jPC1QNJLy8ULhlKqO_IrD24JmLn-xiZhRYKBFxwOIw&oe=6A4928FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCtN-GXzzyBaJps-Pf0xFP11pf92v1qMCnBWs21Aq-FA&oe=6A68BA05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjEjbXX4XKAQ7kNvwE9_qAo&_nc_oc=Adr7JSyO-5ZI9OZ_YJPAjBy4GDj4ImY9_Lr2Pi923OqjxPZytkeAmbYwloYEp1i7WO4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdRek5nT3KKuKOdl3D1P1vncPwM83LZJ5FJY1tTmxGsg&oe=6A6895B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql9rNwPPPJkQ7kNvwGQQfdM&_nc_oc=AdoF7dcHalH_bmkRVfnKoxdd-S-8gNgx2oYnF1rVptNczFmVVdvFuI3Qc9bmg0HPOto&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj33hyLtSKQMFPMDjM9OIgCNFOh60l4YHJJd_bBuHlmg&oe=6A6894BD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
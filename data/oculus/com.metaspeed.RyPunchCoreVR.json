scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLGbK9OY8R6AeF6zx-FTnOhRYTH0L9S9TwXVl6PXgEWw&oe=6A5CDC85"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2gFsjZ8STAQ7kNvwEKTQE5&_nc_oc=AdpcGYBHA7DBfUS9A6K5c9_FvGva5HIbFEbtrLto1mI3XIiMdC_AvLgRY3rqqFw7gYQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJnIidiRXewGfpPW0kIivR2yTQHzpHDTAv5P6i3jC2Yw&oe=6A5CB839"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVnBKAuYZlEQ7kNvwGwQ3Hj&_nc_oc=AdoHF0ZZgBfP976b_paBn3kVG07JCzMUg4kD7bIuB0bkJZYVEqvz_fr242o4gNTO5X8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvei0t7vUWwOY6lscqwV0hzEG5XTOTWK8ITi02UILYEA&oe=6A5CB73D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
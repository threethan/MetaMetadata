scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQvVJXrzWWSB790t7E7mmJF7qZGZcrTYcRhnrTFniCDQ&oe=6AF32785"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSp0E2nbL4wQ7kNvwGKjPbp&_nc_oc=Ado9ke5SE51uqXvr0b_LSGKwKSIdLVMFFVkbid7ftDuMi9ZNiWMXbrZzrxkTopLaW6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA6KIBACFsSEiEfB_YF0jKOnxTQvmIAPegum2_TH5vFQ&oe=6AF33B79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIrSzMISg7sQ7kNvwGZyHpk&_nc_oc=Adq0bHF62j_o5zi_LDX0bHAjNHd4_Rg9QuiEqGi8Zbo4gScPS65auZRxQ6x90cEa4ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLLADRUsmOa-4HUurrRpZd_LVLOgeNe4fdhBKYmd0TXw&oe=6AF33A7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
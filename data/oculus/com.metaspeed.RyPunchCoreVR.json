scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqEn2WMyGw1EfSC7c061-RvEGktOOr1OPLLl_2EOz2Ww&oe=6A940345"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwLSRhnais4Q7kNvwFWGjcO&_nc_oc=Adpi8ZFz_FfgvtD-P6QkoIR5VTq4e5sWqBqcxCr2mVckCCMXJ1VZkLb_SW9mgI64ZiI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhd6gftkAMdPYyJSI-l1C6F9zoCAJ_hlRhfWgmOAZRtQ&oe=6A941739"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNCEPwxlSs0Q7kNvwEZgplA&_nc_oc=AdqmISXDF3zCT06ud1k_fPcX4hxgny7UQC-GYQdGu-DGSW6FsXPsljkFXai9x6vayiA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEacCTNlqXvuA3M7jsV_c6M0onscFw2pnZfvpRGlJbYXw&oe=6A94163D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
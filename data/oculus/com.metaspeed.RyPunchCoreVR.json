uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnnqML5my6wQ7kNvwGQ-zEh&_nc_oc=AdozbJAO1mUn5q0H0lAfGZlOWEspHnV7buUen5aWRp0CQvA04TuNrBabsaz1dcEO1Zw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fz4o4n7xtGYsa8Gma3XzARhtr_tYJlkmXRg4cUn5c3g&oe=6A05D985"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKZFdyNbgb4Q7kNvwG2ydeH&_nc_oc=AdohdMhuiyhisx1jRoP0BkvudOcdnjwxH7D7BP4pgNQdH2jdEevNd-yF3DzgQVkat3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dgX9a9xrBHhigJU-itWCryixNhijprZRdUsShFfKFkA&oe=6A05ED79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eas6OKZBoOsQ7kNvwGDT-Pl&_nc_oc=Adp3r-LX801v8ZcLWGNH1yiqo981-orCyaAQ-N2lr6XYrIwCreNmOUN08WbZwU3pCiQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FCX2rOp1cMiP6DnSh8f25fetw2gSwR3G1mWjhrYYfQg&oe=6A05EC7D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ArMcuDnnfz8azANCy6CARLGJb_u_utlvhix2CbOqwlw&oe=6A09CE05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4uLLQL47bEQ7kNvwF8STxf&_nc_oc=AdoI7Mc9I17VeJT8sy9J9nrhAflM0EzP7X6pbp2HGg9L9TVX0IysdnDeplpv83Cu6kM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lrZcvZPI18Soi8CWm865TKz9gby3MyXlZLo7dw0Yrig&oe=6A09E1F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPpeW2PTLjsQ7kNvwFgTT4T&_nc_oc=AdqWUTAe3Esz8iFVxR5gAZ-BYthwZrL1DUvfzv854Ti-Qa5w4QRAGmzamh0L2g0Jb3Q&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DbW30f9YbC0yB9Wvg9V7sCeMONB6baPnmueq8-5H3BA&oe=6A09E0FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
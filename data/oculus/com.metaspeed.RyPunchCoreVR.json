scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qyhbethV_Ucxd4BIpeBD1t8zmpdeB-N0kp7Dn7cUyPw&oe=6A2C1505"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVA8YJopEAIQ7kNvwEBYd5z&_nc_oc=AdoNfAfwue8rNKmW5D0IUVF-WwL9kpwQwRr0drlxnZJ5A3xAeqx2nObQVyqoj55Iz3s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93tRspo-vcugjhUfnUnDxH9A2sdTjOSfY0PrCpF5srAA&oe=6A2C28F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n67asWWXVSMQ7kNvwFUkcSH&_nc_oc=AdoSvJBkIJ3NVX8H4Puk--ndlKzyYPC4C2YGuvYP6DkAJMuBausnS-pWuz8t0kDKCAM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8G1sMXj7f0wT5xMMX_TqldTIYi2iHv5efKQSbPaTJ63g&oe=6A2C27FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
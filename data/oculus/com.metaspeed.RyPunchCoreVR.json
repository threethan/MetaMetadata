nt-sin11-1.oculuscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9kqdcWRH3kQ7kNvwG8q5DO&_nc_oc=Adr3LN60vdCun_crQ4f1R3svM-ivtrJ1yELu26hv8qChmmuIVfGR_ZB4BJQ6w_aV8Uc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM-u7lfjU8hwh19wwTmKUbLLI7PTwNGyuLMGAMZQjZ9w&oe=6A7D99C5"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8Zt06vnA48Q7kNvwGspAL2&_nc_oc=Adqjk9mFZZ9wHWwiYhfyvKPN_D5R7FycQ5qSAxyWJ2N_HqGRRzR8AnYHZfdXfMTYL1k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSIWo1tmjK4etjr_mnOyC8H3kitD49Yy_tYUliBzKggw&oe=6A7DADB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNA-s_r1x0sQ7kNvwGH24rm&_nc_oc=AdqF1FyIqFap9jgvARnq3St83jrSHQu317MYA18jSD3JZqJYSUABKNCC8kAOMETWe7o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZh0N91eiV8qMPcIACqF-3B8U3fz91E0fGvVW74OaQpA&oe=6A7DACBD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_descripti
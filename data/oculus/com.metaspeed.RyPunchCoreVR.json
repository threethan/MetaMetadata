uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJVGON07td4Q7kNvwG5aRdu&_nc_oc=AdoZEUTBVtTrl2FgStL-2f7tmtBYzdHTXx5iJDGUDB7am2wkKwY6Zc0ur6rGwfLwqeA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3J7usKCDIS0KcUmm5b57piygItdQU6TV5P05eMGkclA&oe=6A622285"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHMhHkuzqZgQ7kNvwFoCGkp&_nc_oc=Ado-mQSedGZKfqDhMbk6WKUFZuG3f9Me0tkcbaAM5-tNrU4EbGBC31YyJnxWvk-kHhs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5wWwZZkHVk81jEZIHaL3da6TtoD6c8g-cXbSgvMBkIQ&oe=6A61FE39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcMiAth8p-wQ7kNvwERwnBn&_nc_oc=AdqB6Do88gHrfTywR0jqeuxCjXNWVJ5ReRXmxbr5efmi9tIljKj-3XpaVYA8JqJgsIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM8qcnqk4ZheWHRFUHjkUeX4g9rc9oDPo0b0IxnDkDfA&oe=6A61FD3D"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
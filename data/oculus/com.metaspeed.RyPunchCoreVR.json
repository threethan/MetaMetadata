uluscdn.com/v/t64.5771-25/491823949_1794732788072260_8950691614832688872_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4j3VmqaSTwwQ7kNvwHau4jZ&_nc_oc=AdpAv33jdT5HAoQiJTo-32hfDjwtem2gxhCwgJX9Y7m9ml_ngUR1zohoYffUIA0Y5zU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VCxpRFzm_gqVe6Sda25QlMBvXi69xOrkqTLqj-ds6Vg&oe=69F75905"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmRYoLHYozcQ7kNvwGWuBvq&_nc_oc=AdowfLxxLoMq9lshRIPfbJqqgr6rMlFx9udbTSRScm8EoLWsBvE7rfw-ojscQ3YrVFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pMmX5Z1Nv5vwKQuXtYLXu__rK0wBdid9qwFJmm7l0GQ&oe=69F76CF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aT3ll_fZOWIQ7kNvwF382IT&_nc_oc=AdrDEY3klZwBJKncP_XlLBNq5GtcOfpwrUbzBhVlqVtBY0A5XUOCQkXaFzIEouOUqZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af06teHQXLaSae-YnRm4HYKRMjyGchJXdiUc__09z0BA_g&oe=69F76BFD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch i
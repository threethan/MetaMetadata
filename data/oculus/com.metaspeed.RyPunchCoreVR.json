scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHP4lErjM5lbw0W9ghrIFMRceQ2StcHYbp2h4yCvpfcNQ&oe=6A8825C5"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NLaInjuE88Q7kNvwFGCfwj&_nc_oc=AdoF1RWlkO6rzdNlKVYamtQRkrjtSxwS70GafPN3Sc8-N8quupKHgyDOvTvBCn1b4kg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHN-HW3UYM-r6y2ccxlMvZy2N7uIj584Ml57ZrJANUKAA&oe=6A8839B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44XOD4Opc90Q7kNvwGs0J3N&_nc_oc=AdrPoiwqU7RqSmexc7JZ6AZw4kGVE5392UGilcflJAY6gRMD3yuOZ-SuJmMX5XGcu2c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxUdljxQKJjh8T7znh2YrY3X_Mt0fEmG694sd8hpkSmA&oe=6A8838BD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaii3N8JR7IgkSD3XFp6VQLIZWIkevuQSiUbVS-kgRMQ&oe=6AF9BF05"}, {"file_name": "ss5.png", "id": "1835729237043249", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1835729240376582_7630173890084067278_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysa5DfpGxNoQ7kNvwGqF_4a&_nc_oc=AdoTkgdDqdfpFroGx3wUDeaaeoogmySvZOAsxMYOQrfg7C5TkgyPD5jJ53CrVY5FdlY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYjLYe0zeFK46tPFjroR7ogZHztb8skTnBd8mry0UiMA&oe=6AF9D2F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-16x9.png", "id": "1806507559958753", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821099_1806507563292086_5322658816629664481_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZYuuwmF7ZcQ7kNvwEUr7GC&_nc_oc=Adp8MBXByPM19sxJepFAZchEsffr-4z5ywKMmxoJ_LBIlRgWNt8UQ5EtlSDjRtRTBAc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjDhMsN6kcHAMVm5x3aXh52svsBT04ufeQgvB_lYDoLA&oe=6AF9D1FD"}, "display_name": "Rhypunch - Rhythm Game", "keywords": ["punch", "beat", "fitness", "boxing", "rhythm"], "long_description": "Step into an immersive AR arena where your timing, precision, and stamina are key. Every jab, hook, and uppercut lands to the rhythm of carefully curated tracks across genres like EDM, hip-hop, and rock.\n\nDesigned for both fun and fitness, Rhypunch offers a full-body workout that keeps you moving, sweating, and improving your reflexes. With built-in performance tracking, you can monitor your progress and push your limits. Climb the global leaderboards, conquer increasingly complex beat maps, and unlock special moves as you become a rhythm-fighter legend.\n", "short_description": "Rhypunch is a pulse-pounding rhythm boxing game that merges powerful punches with the beat of adrenaline-fueled music."}]}, "developer_name": "MetaSpeed", "developer_privacy_policy_url": "https://rhypunch.com/privacy.html", "developer_terms_of_ser
, "id": "964395530026741", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/673652249_964395533360074_1656781164192587377_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LShIcbP8wDwQ7kNvwHgLoX1&_nc_oc=AdqFz89BlyV-Qr7ctN7bgixkq3p7Qb70RZyIoIGzoC2LQ9xr64Fe2raXlNaxJxdnVUw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqQE9ieZ6XHc72ugBsAeceeJ2Zv6AIShaP6ST2Hfhzgw&oe=6AAE99E6"}, {"file_name": "home pers 2.png", "id": "1110103128116047", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/673745728_1110103131449380_7677483922965729320_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7w3W1h3_kMQ7kNvwF9K-ji&_nc_oc=Ado1yYX52LiSZlqnhUJAiIEM5K8gc3MX-ZxqSCzml9zR-rNAK8oi6ihaP1b5vH1IjPg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnlXPFVYLhexFoh1n9xthIv-c-gtJEGyWOtffvlIfa-Q&oe=6AAEB3B4"}, {"file_name": "home pers 3.png", "id": "2895126840853339", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/673759338_2895126844186672_9208691508327575585_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--MzspManRcQ7kNvwEbplws&_nc_oc=AdrOCKTRVwVoOaoZKbQG3FGwqaFCQsXI3pG94vY79NMEgECmY8CRfJal17W1isWQTRU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD1HhLekLKJHoNLiHwtvpUPw7drOVcLFJ-QtHUDRrZfA&oe=6AAEB174"}, {"file_name": "home pers 1.png", "id": "1560520129184948", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491831299_1560520132518281_2241084716920616639_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yv8OYFiIm3EQ7kNvwHTae2G&_nc_oc=AdrHblpckSMGFX4bVFx0mBKgU6XZhOBBMg6u7rsYa4cbMEIlgvAIBGT3aY__JfZ9h50&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjuRcdLMVI9oYh6NmQc-AnPE6ntDVN2Z_nEAadQi0vYQ&oe=6AAEAACD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape CHROMA LITE.png", "id": "531093859894988", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974524_531093863228321_4040223428032592992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQcG7PnLsvIQ7kNvwFRnV0S&_nc_oc=AdqTQHsSBNDJyZrBiOQlptbD6azf6ZzSlT8EX097EojamiOGHMrB-BSHVPbvI4xeZ9w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf0E-SM3l7_Hf_GWxGt8YzSHHSzpyJUv_SkGhlvfKpqg&oe=6AAEB004"}, "display_name": "Home Spray Painting Simulator-Personal", "keywords": [], "long_description": "The decorative spray painting simulator trusted by global industries, schools, and colleges is now yours to try at home! \nThe Skillveri spray painting simulator lets you practice home or construction spray painting safely with zero paint wastage and a highly realistic experience. Visual on-screen feedback guides you to correct your trigger timing, speed, distance and angle. \nThis Personal Use Edition contains - \nPPE selection before starting practice\nChoice of AirSpray and Airless Spray guns\nFlat wooden wall, flight of stairs, and small room wall workpieces\nEach of the above workpieces come with lessons for practicing Trigger, Overlap, Distance, Angle and Speed.\nLive onscreen feedback for guidance. \nFeedback & no feedback modes. Practice with guidance while learning and choose the no feedback mode to assess yourself. \nPerformance analysis with Detailed scorecard.\n\nPractice painting as many times as you want till you can\u2019t get it wrong!\n\nReady to scale your training or adopt it for your institution?  Write to us at usa@skillveri.com for details of our fully-loaded Enterprise version, perfect for schools, training institutions, and industries. Skillveri VR & MR simulators are used across 100+ schools and colleges across the USA in their CTE programs.\n", "short_description": "Master Home Spray Painting in immersive VR, with no paint waste.Try the painting simulator trusted by global industries and institutions!\nThis Personal Use Edition contains\nPPE \nAirspray and Airless spray guns\nFlat wooden wall, flight of stairs, and small room wall workpieces. \nTrigger, Overlap, Distance, Angle and Speed lessons \nLive onscreen feedback for guidance \nScore card\n\nFor our fully-loaded Enterprise version, perfect for schools, training centers, and industries, write to usa@skillveri."}]}, "developer_name": "Skillveri Inc", "developer_privacy_policy_url": "https://skillveri.com/chroma-mr-lite-decorative-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skillveri Inc", "support_website_url": null, "website_url": "https://www.skillveri.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29309126418677495"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/604360590_1462557039042970_3058626404865516760_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeKDpPCtipAQ7kNvwHipqWt&_nc_oc=AdrVkN14AIVy8AIFKBfYuJTWejL2OASsqKVVqRftiLc1UMOsqbF05_Dx6N6rNsdRSvE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPqgGR1MOnaV6uy2pfD8-T03b4-qAlqTlDNyFKjnL8zQ&oe=6AAE9A4E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Home Spray Painting Simulator-Personal", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 173648382
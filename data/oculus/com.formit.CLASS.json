63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea_dL-kQaP4Q7kNvwFdfWU2&_nc_oc=AdpmdKGzx1eabHg8BOZaHTQ7KFMuG_JCN6jgbGeDcupGKkYnRpPG4IfSvG6iq68OjIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afydv7s9xNHFPIP2L1hdzvEy0LDWs07yv7KgaxQ8q05N8Q&oe=69D118D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4K5lZPQuPYQ7kNvwGXh6Mx&_nc_oc=Adr3mMq1QXCtHfy2WDR2keYPZONKk_Nu0EkkyIxKooJJlXF-W7houEezXChvaVXNw4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsXYW7nlFsAXFHWFQnPCAWRbsNnJiNNUZIBUkEzRE51A&oe=69D0F8E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1rLuM5_FhgQ7kNvwGGZFBt&_nc_oc=AdqJ4WKwZ4FB5WosBF_TmS7mbtJ5BB9i7O-lgW1KTYIoUd-0V6sVqWOITbrRJNP91Dk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE70FT2Rdmq9U9RuTJUFGuGP4rb0y5sRScCqpv03Qpng&oe=69D11398"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBl5D5Y1eMkQ7kNvwERKugv&_nc_oc=Ado1uUQILPCIAMbzssqypP9Qd_K8UvtL-i3iaWd-LvWtexM75D0BpUB6IYLuluj1gIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztWyqdMhSTuL8ykxOiTNZkXjNLTVEJYwX2X8Yne-XjhQ&oe=69D1082D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOhTEBkrbEYQ7kNvwEtbOSz&_nc_oc=AdqRsLec4vgR-MHd3xYfymtUyzV7y-Nuf8L8T78Ba2LaHFp3GgEpLvmQxxRgHwGETJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG_Apxr8-Wx2bVfeysn5LU14YfVl9pvOszYrjtfA_uOA&oe=69D10BC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d65_zy44nf8Q7kNvwEf-q7o&_nc_oc=AdqVt0BSC8AwiDuYkmaJXiJJov40pLf6JGvm5Q6UgmU6U8dbJnRrlKGRPjXcEMQkl9k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySfhXQpDeywdlMxUoeF3QokFVxtmkVA4ZfCVrlZ-rniw&oe=69D10787"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vQG-kiT2XkQ7kNvwEX6GqX&_nc_oc=Ado5Ln2vKnwAMw
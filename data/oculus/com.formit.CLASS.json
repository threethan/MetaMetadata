63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d8WJfBl7W0Q7kNvwGkoXNG&_nc_oc=Adovc1DZEpPh81U9JHeJTS5yFkBDwtSSlZgcPooTUc30RRPkhXgDQYofEZO_F74BttM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9x7Eg3R4Pk08sibnStSWdJSR_iAMVOU_kq4HciXQp_w&oe=6A2ABED6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOgNmxgslEQQ7kNvwHiQouH&_nc_oc=Adq6JOi1qyRmDEsoK_cE1_SecXmXedQqXOdSFpUF7qawLuDb4rf2cHsN9OW0vTc3IoQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YTpoCp1noCuxZ3k2oWYlIzNoknrGNQtTU73FH5Q9NmQ&oe=6A2AD722"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcBoxpVofFoQ7kNvwE8ZIEQ&_nc_oc=AdoPPoK191hp4gwBMc3N3fEyS_qdf70N4ZDHqL7jYd4JJOjJ4yp6Mhy3pTqdef_Wgcs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P7AdDIgJijOihQI5ToxXW5pC_0zEfLSTGVgmkaSDNxw&oe=6A2AB998"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qu6G-ChPq0Q7kNvwEHbEwI&_nc_oc=Adof5GlwjLqzrcvrWN9t-BVaeknc2nW1t5kdD8JSfho0jLyIA55fB4388id4zjihm-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GEMq5vxpLoy3vNHE4TfIDnSk6yV0e3AMdmyuXL618qw&oe=6A2AAE2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq1j9D4LRo0Q7kNvwHOCGds&_nc_oc=AdrBMWoLaPEEcwJ2RPIqTemEXZsWmXWX9o1mRvudBU1jZYT1tCn0otdHFSJKbvCQThA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AJsM7eSWbgnTXzF2wo5gBa55uBlazL711wJQmdYdZ0A&oe=6A2AB1C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lj9FC_Uk9gQ7kNvwFsvXxp&_nc_oc=AdqxrzUSdUL1fvRuS8ZoaGTyROPpSL9FtCUg_tsY3CwWOcejyQ_gaM7cxB2KXnfCjIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UZ7Q242TF0-r25qSvc65gr8LE-eOEssGU55J66aR-Og&oe=6A2AAD87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61cGL2o2XowQ7kNvwGZVWtF&_nc_oc=AdrjqbtiC3PEWI
/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJEu_s5W4WgQ7kNvwEBdGtT&_nc_oc=AdlL8U0kWkvSvUukQ-1jJ7bazMa1ukusd0EVOhqZr4KsQ6El4M_bOxDxYmTCl0gsNAw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfufvcoSJ3TqVeEtFTEBlrswgr6BnxF91EeSc8xcD3Pr8w&oe=69A83A56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmrMO0uaJFsQ7kNvwHTHjOO&_nc_oc=AdmClSgPzcVpmbR4lWLgHLuDJcQqeNTvG0zRVvRhh6-CgjQoBIEMgwFKO8mgsZCuYuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs22-964_VFsm1UhV6EycXAQj9wWmKH68cFk8Uj-GGH8g&oe=69A81A62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uqqtdcGqS4Q7kNvwGGSEh0&_nc_oc=Adn0SihSBy9SbZU8EE9e8NK4zxvLqA6p8scmeRUYlvL-UYylhrDbgjoIqjXLhcGUk9s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvo6xsoQZvzQH56SAaisKqDcE3Ye_MKjzBjWUj00x6iHw&oe=69A83518"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTrKTffs-CYQ7kNvwGflwVd&_nc_oc=Adnfc3BsyAKFl6iZXT1Tuba-TNaF-5-vodhIFp9MGNDvXRqg95z25VPK_bXPIWwUIJs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuMLVyTKLKy3Mj1iUoewkq4wb91LPDtsAjFcQQpLvhjDQ&oe=69A829AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRz1b7t338UQ7kNvwHi0blj&_nc_oc=Adn4WJieQYuBr5SkuG_Rue8NNuNkdOC7YVE9VnX1EBt1z4FIlFa-5LsGAnG-8udQE7Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afta-vxxTlD6JFFeNgp_W7O3EF5wMbeldXF8hu4ZX8WSPg&oe=69A82D42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep9VIuAYG9MQ7kNvwE2SZJX&_nc_oc=AdnYIEXTDb4NoaV16gh_Tfb-E5vGg8vtDgHhfpmqW2GkbaNDRJaUViC8pAC413oSGGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afvm7m1NKe0bJ2Q70WweHb2wv01PCVb9KWcLUN0ASLbOMQ&oe=69A82907"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSBgzTk4qGoQ7kNvwGw
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XM6PvxMY9rMQ7kNvwEgDrpa&_nc_oc=AdrnaIBLwKI8Oo-4eBPO9StZz0JeR9-XhA3nCtZ4wIah1wFX75fgDnRyG4FKnerwCC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaYJj2uCmsWSGsBNSey8xfpV13pLORSMrLSLS-BYLlMw&oe=6A60CC56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lo1LPn2V2cUQ7kNvwEVzgiV&_nc_oc=AdpFzfu1x2mRCe_qyUrvNFfz0h-3_XOb-PSNP80B4Mx67kLw8ETWetTgQujzl2PMl_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOKw9j1yvHaczJFqZsCuDKdcWzXIsuw26savKl5M0Wow&oe=6A60AC62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC0ZpI9WKk4Q7kNvwFRgcDN&_nc_oc=AdrwMi0fMZ5VckAC8mIOH0PM9y50RP7sYNIl0THYtG7_PysqbPU98_dxgctBeLlxyB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLQP76YrDzKfCZ1t0fnivdHyJDgWQtNW6Ty_aK3LjvIQ&oe=6A60C718"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lhS2HCLsoYQ7kNvwHkHc-H&_nc_oc=AdrNcJuAwT73sjAeo5sCrFejfFpHl1QIs2FVTdUYXNjAb_I-zOWVKAI5nof6PDxQhVc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSvY4COjX2TVbhfomKoMgERIx9k9ec4CVfwYaRqk7diw&oe=6A60BBAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjaR9htHbW4Q7kNvwGMqGAH&_nc_oc=AdpQZF9VvjYZWCdy7rRH109Z-sSsefsW4y7aGa_eZ5jJ5NvxHJYfFwpzbc_CmgePRnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzYyWiI3tVTJCvPVs6NqZITYiTQvq8hYFZXYzMNBSNWg&oe=6A60BF42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTUjfD-2ySQQ7kNvwFWAuEA&_nc_oc=AdpnpLQxUbz5e7nLyqQPowCpgsmunwpA316qHhpE1S5c9Eu8_51EKkJBAKDS3I65JUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9UA8boIxuUyOeM2b7mkg-MvKzYZ8kP9CvuRB0tEoZbg&oe=6A60BB07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaEpJUgdWj8Q7kNvwGNkGIS&_nc_oc=Adr3V2gupHVZFI
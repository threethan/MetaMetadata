63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERMgr7KhJQMQ7kNvwGinxiH&_nc_oc=AdpBbVTYWboHpq4VMmZmp8u7h-Skr3SPvW2B9R-B1rhIJb8T02iFQUGXcMz6LPumLkg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4FNVZS5RXg_D1xwmvVn25K0ALU6rtD-fYx4aNGLzVQg&oe=6AE4A256"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5x10ZASi2nYQ7kNvwGkam7J&_nc_oc=AdowJlGtBxo3J0jie5MJu7hfBFqjeIyD1r9HJBaGGQpRpoXnfgRFvNxs0KB6nxjWisU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSle7QazJEyBH8NLc-1jWxFrhOUcaTB2JYangY6fqwLw&oe=6AE4BAA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-sV4RUcX1kQ7kNvwEGMEr5&_nc_oc=AdrXefE6Mw0BDI0V7I-7HrZIgzlmLophjyckKK7Wtx7Lf4-z_jvHgwH2ezNgbshofjY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUwDADnUUKjlOwwOOwMvgCF1zF1C1HKNrjHw2SwVqTNA&oe=6AE49D18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud5-mwmnhncQ7kNvwFEtu_0&_nc_oc=Adpk-pctzBy-p1UC3vDcOSfZQ8UHNDuKwpdO8WfwMrakwS9SYOlyi1scMlCKpXGEEVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEDSFNPkcPI2D4UNQu1SU_Cvxv___FhKm-k9ZQiNKtkw&oe=6AE491AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBkJfYtbs8gQ7kNvwHz5Nyg&_nc_oc=Adorl5h9tpJw7Sh-2fK7szVR7SNzJCdzIXhA18ZBn1Q-tBAzYGINWJddVpAvmODPmLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJBQG1sn8VhfL-zadqN85j8w-sbmYhrNdK6V0iy6PsLg&oe=6AE49542"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E30UTx3OLy4Q7kNvwFeiIA9&_nc_oc=AdocgdNKEMxOnjT8yeqlo9zUGgrptBG0npUZDHynPTYdkpVuxrWlSTvfhf7O6jqWz5U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFJGKNJ0JFdmPMj-BdsnltfV68MqJM9g9Wml5R0gx8-g&oe=6AE49107"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKJtm0cgAgAQ7kNvwGOEKeN&_nc_oc=Adpj-LoomLuG0B
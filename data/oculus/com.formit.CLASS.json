63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSHwv6GT_7oQ7kNvwFnwEP0&_nc_oc=AdpfnQMdC5QPfxoC57OqatMpNCjuXEOR5cgnSrneoCJIcvj2lKdyIWoQ18mAPE5cQIU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd97GjKJaRxjWn8fw_viLw8ELMmNEYYlEFH5UtzzCrWw&oe=6A58E356"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa3PhPuXvikQ7kNvwGqIHKn&_nc_oc=AdqJAhIRRssJtcA2EXvW8Z-WN-cgmnql_XXuw2w1RZ5fHUZcwEAS3XuaurOJWMufS_0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa1Yd4ywsiIftbzDXCa0MDiYwilYYE03EcL4zB_3SN8w&oe=6A58C362"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRxaiRaBpMgQ7kNvwHnPuKT&_nc_oc=AdpiPk49VFE8unFUYuPD5NMFkb74yWG8ykZg1-ugMStMvMDEVY-J_ZJan_Rw48JLsYA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0RhSMhMBR4YwD9VRAwmHkZgkBnWMULmHDIDdNFPCQsQ&oe=6A58DE18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikc9adDwkRgQ7kNvwGA1D8C&_nc_oc=Adp_7jabVFulhjg5SObqWYR3QqDXhDr92EaBEOHuFF6lJsbXFVnXmR4P4381v2UlXXw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfvb38xIiiUXXyr6aKyIFA8C2QIsYBifBUJteyetsYnA&oe=6A58D2AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMuRaxjBr-0Q7kNvwEFKF-N&_nc_oc=AdqGqskroOQm-sbMmwKuF8nbaDYVjVe5BYZhUqJx7eSFe5PgK6nWgAS6p0TYXmZTZrY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB1B299AP3k-_NDMP3Wb_pzHfGeoy77p3D-VKcZJdeow&oe=6A58D642"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmmO3HE2rysQ7kNvwEmsovw&_nc_oc=AdqRxDrAz73KLDggavRpWIdAyULdFqMGGdMgH0nH0trEkEQOW2_OH3IjcuBdKWeaXg8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9TPIKyHWVY_bXayhwiHYM550rpBlnaAt2pTmmTcKhtg&oe=6A58D207"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKx4cIjepHYQ7kNvwEazoPC&_nc_oc=AdpS8WSz86JIC4
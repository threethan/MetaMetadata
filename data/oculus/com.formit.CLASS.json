63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoWApPc0XHAQ7kNvwHnGSc6&_nc_oc=Adoj-1ge8n7N8HmEZS6E3Ojkt1mFMPYZcKnnpXiAvFr516F1L8GmodKb2mipsrh3_f8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHHxsZC9YeAnFJMtSsMBIsc3zcPWMHjwkld3APVig_qw&oe=6AA01456"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OehV1fd64r4Q7kNvwGaanro&_nc_oc=Adr1BES_Fx0DqP_NW5S-TGeJX6aYuHUezj2w6GcN-UMZMrmafRQCacOgAKrzxBWX-G0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoIity42NBiUFv2k2YpG3HN_uO3cpq3fSoNVJoipVb1A&oe=6AA02CA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtDF-cAM56cQ7kNvwFFG-K4&_nc_oc=AdrF1Ub6aBRLfu2Nz8_Wbc27-kjuu-bmiPRcKdIdr8WtyIFSiQwx3995psQ4v0U6Lh4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNEijioVcusm66rVTYXUGdKHEqO1c2iqm0tOKZ2BL0dQ&oe=6AA00F18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPvRIdZf0jkQ7kNvwEmRG2x&_nc_oc=AdrhniiDsxB8amVCT4ZRV0-YG8xqUPjVZCi437x8ysojuIA44U5A0GbcBD-ua7UZTGw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKod6rQpVg87OHu7qwSDv31Ktrn5SYnsydCx8G3KqK_XQ&oe=6AA003AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UqZPPxtb2MQ7kNvwHMvkAf&_nc_oc=Adqbljx38RshGUmt-i_zyjU47esFHT2KGSX-zRV8skQcG8nDckgV9sAcSwRx9kfKMfg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-QbnriSOq1zfPQL16bOYQvpiYmAEDHrEh1-QY58tSYA&oe=6AA00742"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sABYVGmkGUEQ7kNvwEThzo7&_nc_oc=AdpRlrgwoPFkhHoxQczqNJZCDEtZb_Z3dHkDUS9lRCSrnJbnKRDKdwtX7bpAfA6WULE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrfQvxpJ5SV_uudtjGr22AIyADmircx53yTobYL4p9_Q&oe=6AA00307"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRPd2QwjqIsQ7kNvwEs6nRe&_nc_oc=Adr6yGqcOD49XK
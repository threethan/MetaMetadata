63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1A5iNnaRMtEQ7kNvwFrm37d&_nc_oc=AdqrIfGSjFFjrzeKJ6hMqfwQPm7ArHiRDJaOMYIOsYLBdpRDpl_8Yzvql7A4ClqYbB4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ-Y4zmQ-pDp7CFtWf-JFrZyFm1lZIYocq9ulr8BygUA&oe=6AE0ADD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMR6agnl2JwQ7kNvwHslGT2&_nc_oc=Adrb7rwNRL4guyU9LayqlHDjbbUa1GfKBaEV6P7vI3GwOALhGta_AC4CDoIqrAYBmvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4oUdBqe2OHgQsMo2Gxbnx8NFqMmQu6XuMvY9zGmJSRw&oe=6AE0C622"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiZZ30Ae8W4Q7kNvwFSw2b8&_nc_oc=AdrGKsyko0PAjCHuGxiEePdRfY2IQ11xFcVt1G7rHhQoLQS19zeSGSNlfgXtaaWB-U8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyDQzfv3UygJVG4EKO80DerxP_fTw9NQNPnUU0HE3lyg&oe=6AE0A898"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8qC_v2bhvIQ7kNvwEwGzw8&_nc_oc=AdqnNz2BQHEs9ZtZQBrU_GhtWOJLHkNYF2XE5JhnhTe4cGX9PNiIcKIiBVHnAIZYoQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr2bCHLdrIdKu3B3euIntRXCcfaUQDMos19md0QJGEyQ&oe=6AE09D2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1puVITZBsQQ7kNvwHxwtxQ&_nc_oc=AdrN2tsL5UcHwg7264LS9kRaL50UYSZ-5NbkA9tltpVCgn06oGmqmYBbytUTOxFSlGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhWaM7Wd9JKOS1edcpYUELDRnxOuOsZcw2JqJ7-_Tz0Q&oe=6AE0A0C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbAlM8k1gZUQ7kNvwEBiR96&_nc_oc=Ado6BZ4B2s7BzMcbSmg1f9QBQb5mwaYIT3K1-ixqTqVntkpu2m9u0ToY7uLipyhjRUE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkb_7w2FcmJQ3TVud0UCdPWW-veY6bKJUbKpFtDixeBg&oe=6AE09C87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3UhnouX7i8Q7kNvwEOLZEi&_nc_oc=AdoolYPmDYYREa
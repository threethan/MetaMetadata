63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIEw6EvpIrcQ7kNvwEYDe0-&_nc_oc=AdpYhsuk6NHjEzoxzlDJt7mTjFju0_X2v11dMldJZK7u8Q_9F5U-MtaLCnyr2Tihw3s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1yMBGIRxmi13rvCiRUQCV19fJjkrysoWkUDiA8twMpw&oe=6A661256"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95J7CP6wU_kQ7kNvwFvw7Gm&_nc_oc=Adr7muv0dkyyY0QUcgoVw3lSxT1SwRBvDeh6y7TwJlUGldMF0vHj00EMyyYuWA4hdZg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0D4aQCH-BxszY7QKWf4LlXAiyIRhsxZARUA-30WH2pw&oe=6A65F262"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaIsjAzN3EMQ7kNvwFUjc7r&_nc_oc=AdrEb3qzjPUx4GWZ5IGdL3gS7SC59F2ShLV6U8oEaCzXCEKFHlhxZE9g1zMd6Qb4FJg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDisfkmxsozFXlPHgSULSN-KayRD7d0SSzV0GSrpboT0g&oe=6A660D18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUtBHNdiSQUQ7kNvwGpjv3u&_nc_oc=AdpAx8V9PM2voZjj9l4JC-gpB3D1TE5W51t1ati3nJkorUyrxgb48cXrIizovZfslkg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnTe7eteXcuvzw_GHMIyLRn3Hx3xKn4Y1BfDpnudVBRQ&oe=6A6601AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js1RfVbraCIQ7kNvwHAKKAg&_nc_oc=AdoTaii4NxZJT_Npxj29diewRgif3jGl9tphiiDsOmydWqgHRD66_C--iRvXfx2_ItA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOr2WJLESaBpkUgPmxosynUb9vTWdndaLF9QfuymCuPA&oe=6A660542"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9aiaqTlMt8Q7kNvwF633R4&_nc_oc=Adp3yOMlV2rx-2J8GNC-Htl-ebziMySZAmR9DHGyPMWeG4EpMSBr38mLz4LyVDVCQlY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDq6z8e3OBScgPcpDsxPH5lq2nzW981RX_gnzIvRyWYOQ&oe=6A660107"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgknjRgsojgQ7kNvwF1pKYV&_nc_oc=AdoLeciFxgJO1R
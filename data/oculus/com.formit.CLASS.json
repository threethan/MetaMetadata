63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpAn5eYOnn4Q7kNvwEyvS8m&_nc_oc=Adqehtjo0LJPPNWuH7xZEP6XarxzlQEuT3LFLu7JP4mG9BKPxFfXsxpJ09MV6g2ZFEY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xbzwcUUMNGeioBoMxICwBndnhHJon-gkaC5oNACR9fA&oe=69FDEBD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfcW577RRwMQ7kNvwGX8HfX&_nc_oc=AdpZjK32VzdKsGE1zVC46wGDtyG6p_bwiNlPzxOv7kKg3NN2TTUmaKiFvly7KzRUWec&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eu3no_77VxhvRxxGB8Z50LTPmVY453f3wjXx7v1T62Q&oe=69FE0422"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6xnfgs2_vUQ7kNvwFdGK5F&_nc_oc=AdoY0XLhG0-qBgUADVIOPtQNg8NLNTEnX-eO_gYjDWTV3LLI9eNdKon6U98AakzRTGU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WgXo4QQqRQgnYMtnBVfP2npoLhnQxPSBNfff_jwWd6A&oe=69FDE698"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQPGlPtBmkIQ7kNvwHVPPK1&_nc_oc=AdpInDHihOPrZGBJHBdd1pby4nfG_HMk_VRbyf4_n1EIinpiG_lH4S4iLiObNdQ3bRA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mvYjmYRkgvtHcR_SDGPRrdjrW406Vwgds66ve9V0CPg&oe=69FDDB2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mq-GEwvfgsQ7kNvwFsHwcd&_nc_oc=AdpXPlDflVSeVbKtKhYl_kTJ3uCXnja92JB2uPi4QxH8Nl3ivARKzQcNt-PAd4WAeM4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Nn3UmMLsZU-3oKKyXXUerS4K_Y682Sy1dZmwxRDi52A&oe=69FDDEC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZXX1JoguU8Q7kNvwFtfLr-&_nc_oc=AdrU5CrCIyvt2lwXXhys8sJgPKp53ZhbByJbFlIdNL9q4oHPAtGG9AFdhyRlThAHp6I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nxBkhWhwFCiSQKzY1aC-zBmOvIa7dPUb_4AQy6EYiDQ&oe=69FDDA87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ5-BhQ_3m8Q7kNvwGIheTY&_nc_oc=AdpqWzo6smWrAF
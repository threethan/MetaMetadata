63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eLa2tymzz0Q7kNvwEo_HEu&_nc_oc=AdqHRQyOXF_VDVp_s_cMLDZnFv2NKkwmeu4KmSdJcgFVNC8JSfFupA5b9uYNEZMJmJU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8gWzmC0UVTOSIvy2HdzSGbAjAIgL2xG2aXGObNJLdfQ&oe=6A4E5756"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrJA81HIsvUQ7kNvwEsFJEl&_nc_oc=AdoHns0fI1NipJgMFRmFLguPevpBfYsm1Quvk0k5_cBTYBdLUdKXuDoh1zYU3CdwxZE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGRqAnnutUJ4IrI0ciE1DIaJE0EIKVGlIHYrMF_8FS0g&oe=6A4E3762"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCZGDxgCPfMQ7kNvwEXWDHR&_nc_oc=AdoUCNUrwDyZnK_pVlOVLxCMP50ydpup0c3Ug1L7H0rPjlQ-cZgVtGf4Kk0asXQasxk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNEnG-XkngM5IPZWfLIHEx0eJ0U4iBJ4TVaV9ApQhJCg&oe=6A4E5218"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbg0wzi5m8QQ7kNvwH5vZEs&_nc_oc=AdqOHfohsaWDnNU02SnXAei6Gu0YNohw0sdPkS0UGo9TposrppwnQA6BcSjBtexqE0o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiT5o0zdMv_a370pLl71Gkc5OtGDmqUMbaw-Walcdrxw&oe=6A4E46AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duS8VT3iz-gQ7kNvwF1lyDb&_nc_oc=AdoTnridOBkEKMhXhO9urNYdypriOAEUhvIGSnnYUXqhW296_58TQee1a3d6uy17H7A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANQ-58vsApdlD28OkdkXlyQXh4G0mWm8TSMHckrs3Qcg&oe=6A4E4A42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArLeY8S_2vwQ7kNvwH0rYY5&_nc_oc=Ado-GUoaU-rzz9oS4y-5aD1nh4wP1iWjN39D2-K_Ta1sNLjGCnhRniYEuarqKI_mGIg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_-k1WyKf8LW_UXcmJUAIUizpySaDzhwH8pfao-0ZQzg&oe=6A4E4607"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msG2TZkKLhEQ7kNvwEPiYSC&_nc_oc=AdqsNNBFW6nLZf
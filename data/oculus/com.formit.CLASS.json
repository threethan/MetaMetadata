63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rl7_ZtDYC6UQ7kNvwG6uy1A&_nc_oc=AdqhAyFah8z_-tEhNiDl_JrGSecwhXCqkhn2zjJ7IMWRKBj-vVhjwUjgqD6FigSPNCI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMcbfAU4a1ZlfIX6LLKdrodHpuVKN0wxvN-2Ts6MnMEg&oe=6A54EED6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC3PSDXSjOwQ7kNvwF6hY4q&_nc_oc=AdogLr_BBys3z0nCnXIKt8K6bAGWso0_4MDoR8aGU-M6w8ghdNkiJ_gdSjA1OVLmJ20&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6qd5qUdQUQDZeIOCTj8bAr39pTKmgCBZofD2Phqvnyw&oe=6A550722"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhz0tGygAMAQ7kNvwG4ZIcN&_nc_oc=AdphBziULhaZEIoqZd4WvfZpaOh_DH6faMiBTVvCEHDrJ0_zYhjHwnmTxNFpwz-9T4I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkfejfichG2usuTN994iNFcSB91l59m9c5xjveL7kXGA&oe=6A54E998"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPlnVgMPt_cQ7kNvwGQwm_8&_nc_oc=Adq1e6AgFPgZ04XgXylvWOK-RtyYtKAKPLCm0rfANnwKcuWLp7VU4aZL6BC1_NW4GsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIvKZhCS_1fGnsXp1gadFDLFXAd-hTzMooAEzzhMGvhQ&oe=6A54DE2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdAv8EKA7SwQ7kNvwGuTwIF&_nc_oc=AdplQ6a0gizk4_L71kPVuUsRBUBspMSNPdKPiiYOqc6u-jOEfSR4Kdm5aMluHAfhlaE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZeZeHIee9f-Y3lrca8lBajxDCU2fr51bKCE9LveDAig&oe=6A54E1C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55WTrHV01awQ7kNvwFz2DsV&_nc_oc=AdqN3EJH4jXYJT-6NjT13jlR1eB7IeYthBraVhAFbU8CW1f_x-VsJwAH378vKkjANzM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD80cID67OsPwqv7Rlgckx46-iTyd5Et3vTHaYPGyN6Gg&oe=6A54DD87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXTjdalMoi8Q7kNvwF_AmZV&_nc_oc=Adp2-9ioCG2qM0
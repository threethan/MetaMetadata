t-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGhE7t5SwYZAbYBWZo_PLX2e-k3WdrUKbeeOkwC6pdkA&oe=69BFF556"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KADJpICYAKUQ7kNvwEBIfvk&_nc_oc=AdnOlgSKnkfoKJjcwbMKN3Z9foncPuqXRldV5P3Ow9xzJzAdq7e89dRlapoh-PJqvNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRzu170pYxueIHNg7Z7wQkZ_PtLGdlJrPKN3DpIohQZg&oe=69BFD562"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2oDn7Z2g4MQ7kNvwH618ve&_nc_oc=AdkgNuI63ciN_2j__EWKhZzEPgrWOmEDrBGKED56OP7X_Vjpf9QuuC_v-EJdhCZZ4E4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzba2uFFTHWOoVph8zLBy8gMk-YRAPZ_3aDOJHRN3EpBA&oe=69BFF018"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHT1ulmSfTIQ7kNvwE7I8_s&_nc_oc=AdllX1LPd5XAr_jIG1OXZvT6evoAnQn8JO3aOKGVvvPVWa27XTA3PDjsCDnIyPoRGHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9o_l42Hf0qK7RI-Y3uEwK_aXvQIC2hUmjBNgIdL129Q&oe=69BFE4AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSreXjmlhTIQ7kNvwG2soNM&_nc_oc=Adkr1S_KB6ooeL2orGCWojj_Mgk9UJ9IerAjPOCzE_EcD8JcQ3XsOpU2O-3nfAhaJEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2Eu8bXX6sqgb3zjn1j4qfBrXyO4TuXyE1ot8ELqSiIw&oe=69BFE842"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zosI6Zk-cDEQ7kNvwEMN9lE&_nc_oc=Adm5gvfgXqz5TjN8EAICKaK9-e1qtY-fsxNu4CHnmNcaVEo2AIXZtlg5FXqFRBcyC7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxFSBs1oh_4-zDjtoQ77hgb2BYWJKTRmyk3FCtiC_138g&oe=69BFE407"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkMSMELILNgQ7kNvwE8nBaR&_nc_oc=AdmHJO6nbelR94nrTuRf25uwsOjgBgaFfkPgEVmDohoK9-VEHkZz70Ww9DkhjVxrSFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxG2E6a4oLbYmj7-IJ27uKLV_y7rRqvuGL-DY-otIj60w&oe=69BFF1EF"}, {"file_name": "Progetto sen
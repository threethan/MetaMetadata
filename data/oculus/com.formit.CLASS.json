63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFvWg30l3Q4Q7kNvwGL7XCS&_nc_oc=Adpqy2S3L8BbYxsW7qmeUVFmmTkv5DJaF3X5-ij3xfF2jmxAoLYlJUr8V_0U34rqDdE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAcLqkLqGyO8Egt2A3xlCLM8M_LVoAkibqEeQO02FKag&oe=6AEC8B56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2Tb2IzyugMQ7kNvwH2d3TL&_nc_oc=AdqvkeYQioPbrlmYoEtIyp_kQ6f9yeAXxVzm8PXAazLBubpHikxBweXk1WPvXPmB8a8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2wL1lKS-NuZb6MxIJUI1yU92MWc6D9p8mJTguISDkMw&oe=6AECA3A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owB02hBGzQQQ7kNvwFVZHX_&_nc_oc=AdosbTW71QLIc_oqhonN56XceLL8X2eXkYZIcniZ_UgvJp_0JFVVmz16gxOwgl6g9fg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSzJbFiQul2K7UnhDnrAgtlAwqhj20_Z8i3UfcBWApZw&oe=6AEC8618"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0E58Ck6eWsQ7kNvwGmqC42&_nc_oc=Adrti1wZlQ3HWKmP9wQfMdzwni08ma21Ss2SoUBo6G9e8BtRXfIh8ritFjmUQo_Kqp4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGJ-sVj5cxoMVaBacW5LSQmcKlOplidYsIDDBMjh4Q0w&oe=6AECB2ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ciy1eR8fkHwQ7kNvwF5b4V4&_nc_oc=AdrSY8px6MFAItEOQTWKSp4Ubc-wmmw6-3tVbhA7Kij1MWaafIJju1K_Q0o4dzXvVmQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi6mhQaocj3UsdwXBMZ5CMzjtnkd95Cie7B6Fn1vwClQ&oe=6AECB682"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5zyJTHaz8IQ7kNvwGPo6dj&_nc_oc=AdrdYBCdX0Up3oGc8jLep8L_6ei1eY3rZI8jP0x9dpFb1HNRXBBkUjg6Y_lyRKTHFa0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzy7m4oBCG_buIBIAJBy8HVeMdHGh5vWvxpOn0htNr6A&oe=6AECB247"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aJjnWbX9KYQ7kNvwH73qkT&_nc_oc=AdpyfNACW8H3Il
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4R47iv-nnaMQ7kNvwHYXV97&_nc_oc=AdpHMznaRydMyNF5yJQDlx92cbpUAm0l8C_dz9hA7WqyLDKW5QVFmbgGkEGwNgzhDqM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmbOYbtkB3JuPc_TXg0ycUo0X5FJL6LBZarxak4sAPZA&oe=6A93FE96"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNfHEBT_cDAQ7kNvwFbINV3&_nc_oc=Adqf63aAkux3m7fQ3gvflXdeFW0kIQTYFyH-O9Lbm80z1Qr1IjFMJklmTz6iRipd604&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHprdLRCJkDxuKHySLgW7oQOKklGfqd92kxpbk1RU70eg&oe=6A9416E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WWlh58W6vUQ7kNvwEd-zKK&_nc_oc=AdrSe9tnPn_IS2q1QE02B-vi5eLQRLarR15pYrH-dlos1GUGbarH_N2ha7oIBR2O8SY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG3AH03nyOGprWt8G3LBzwKfoImmWg0Wq_z0Fp65NJeg&oe=6A943198"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODORlxZidCEQ7kNvwGQhyJx&_nc_oc=AdpLbJsOFXL7aep-MyE0N5uokfcsGm-HyaNAvvnYY-RFX3g3O_M03H0TSYkjDKGi5lw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlmgl-0ohvLBQFqC6weGISh_XntbHGeu8LW5VkUs5FOw&oe=6A94262D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V09rvMAJfqQQ7kNvwEp5xjC&_nc_oc=AdpkYteX6tpGauUt3IB_M1EwPVLhFaslHx07WFrAcohC1ifV-tt-it1-w6b-hEzBNrk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQForw9CXEk1OwNx3Fy_ZbqEyV9U2aVR-LbI9AKKpZcG0g&oe=6A9429C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XE8-kFxWhhsQ7kNvwHUtgcy&_nc_oc=Adp5cn4WPIAcz78KMJ-Ei4Ro53ECYB69uerJY3crzHJEeVvgXCsVVjWlysPwSVrGZ54&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI9i3EsSJV-GvUTk5mpXQBC_qIc4cDfiTb5ph8pFtcOA&oe=6A942587"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwtlHBs5FgkQ7kNvwF2GN1o&_nc_oc=AdrSJm76pFWUAF
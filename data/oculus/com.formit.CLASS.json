63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_leeGEnhwA8Q7kNvwHOnK-5&_nc_oc=AdpiLBXFeNQEz-mzA02Ev3LCoaef4-U-D7bcqEGFMUuBECpXseIyfLRpeYg1B4CapYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvWcs656Fnqs0M4kVBBDkjbvroEgiemkLw1WHYWDNhug&oe=6A5CD7D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc9TISeWsuMQ7kNvwGII2Kt&_nc_oc=Adqa01QS8jAggrKpBhOtJiJ1h-ZLXATBVRMfmPYq6-zv0aIj9qSxMMjNdz7sCXSxAkM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPwH03GGJy0y-A3t0lCDiqg-v6f2DfJaj4hpOVv9Y3mQ&oe=6A5CB7E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJtFC71osjkQ7kNvwH4fVhA&_nc_oc=AdpX7zUpsBl1pxPcCJ_xBh55vTQGzziJdGSfKEH4EQ1yu9strOLE6JCqOkkMZ4MGKBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHKtDSiojcW9Wgyhu0iS5eYvRMzsV4NRgSsGRshHNezQ&oe=6A5CD298"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPHQ3V83QQQQ7kNvwHHA6iQ&_nc_oc=Adq4Er1uRbLJ51vOCt4Tc3sJee18P-QwE7w_je7GYNc2qq2I3dzCLmw1anXfjLA38ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6N_cFCvtvG81P2b8BIyAk1e0wROBgvS6ZjecbbMAlAA&oe=6A5CC72D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7kqpCzvbzQQ7kNvwHhhSE9&_nc_oc=AdpiGY9nuR1_GvTr-07ryCE7vv7gy0Ie2rN_I7UPoikIb77xxU4sSDUlwVclgcN-2wY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi9pLbvp08bG4_uQTa5RyQl3osaniMyrdPk-wQsKZgrA&oe=6A5CCAC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF5VLpB878kQ7kNvwGR41g-&_nc_oc=AdoPRToqeSYRQNFWMpqYy6rHhqZfp3EdCCp2PPtKZ7SO9iqvhaq1vNSuhiKStQvvPAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBn7o2XlZQwUPmmvhOHCd2FZHsQykW96rAHaN4fkpcoeg&oe=6A5CC687"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vipl_R3U0PYQ7kNvwFzlRUG&_nc_oc=Adr5VPqYuyQOIu
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yB6iSK0zY4Q7kNvwH00lud&_nc_oc=AdrYu7ldDCifj2BzSnt0aZ21CWqPFbNLu3vz6GtuhIVQESGkL9FlkuSUmiktD-dUing&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT0DrkL4VCjzV3nGBeU3DCJUSApQiOmSIxs9_f1lHcBQ&oe=6AB7CF56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWbGFJmKyP0Q7kNvwGBeZqF&_nc_oc=AdrUEX1yBpFbEp0UQbXyvm6xQLCeHFEx3qD1Q9eHWNZ2G0nqfX6ZfUx0Cspvzk6gMyQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE1jbtuPf8HaGZm4F2vliuOhem6eHmRgBCdNmPKEoTAQ&oe=6AB7E7A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scqCWU8FpBoQ7kNvwHOBTW0&_nc_oc=AdpTX2mTAbZjfUvlQ_jk2JyQ12h3KNXmjqLQsn4uuc58Z0rHNMH1lVcsJWZcxjzlLy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIadRHju2NmpxWlesCDGiHSzOevr97UR6nK_SdAkgiw1g&oe=6AB7CA18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JexsVOpHaEQ7kNvwGYzvl2&_nc_oc=AdoBgK1mHcN7Gxzka3A18MHkpwGsdt3FC_AYxQH4brFulfl4fPAT0o9L95ET7AAUHFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_HK1CJTlNAwrxHWwY6fR8HZggZ3k1WDoXlHlpCE_gGg&oe=6AB7BEAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvYZ8qFP7p8Q7kNvwH5rgGB&_nc_oc=Adq1DSZQdHZh5-232zo86jiaH3lDFSI3J5pZHjNxEhntyIe75CFg1djiPjhqMY1gVyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPIGk4k-SBFHbdZdsnalG24frk-j2CmD4vYKUHN7cYUA&oe=6AB7C242"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaU72y-4HWYQ7kNvwF2d0dr&_nc_oc=AdrGGeNF8U-LuRCSRo6uA2F3x3tOdSI9Ge9dfgc31Nh9WGQuC0nly0X1lw71oMnDxjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ22ds0V3BjL6LrNYZy5gKPpuxtM25H3OZwJ8bu6s8ipw&oe=6AB7BE07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf2uLnNVLFgQ7kNvwFR0PFW&_nc_oc=Adr0p7DczR3Ow_
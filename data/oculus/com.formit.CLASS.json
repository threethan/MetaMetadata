63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTMtXZZl0swQ7kNvwHG4y2X&_nc_oc=AdrDF22o7_C8-dySWr1mp3e173lGnSG2IqH_fs6E-VPHIHpKG5hN78rm3DTPIffbtkQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPSe-FIkw6XDP_apUwa301vL4stKkn_ZIENlafqGcMvg&oe=6AF20996"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ0G0-V4RQUQ7kNvwGkUO2J&_nc_oc=AdrkZeupqWHefvUuHu2cHiFKuYhA6tObw6tP3wMK81tMLIUfxedCoLNOimlHOib7G6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfHSvQfrxL0spUMz3sKkI5rESh8gEof8jjmVpp4x1ToQ&oe=6AF1E9A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA_g23ItFrAQ7kNvwHJPxIf&_nc_oc=Adrm6SVp-FISljwzSTtwJPw0k2M4EIof7eejnEMAxSAD4RoB49Tkzcic-VjdMwExtS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqqhlbtdf8peMWZCQyxXzUzH2QXLuoFFfWlY3a249zrg&oe=6AF20458"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxGZ1JkcDhEQ7kNvwETQ23j&_nc_oc=AdossRut-yKgLMHtlAEqoirbGuI27hv2IoJI2A9QksiJ2TnHja_eaVJ3iu4DNETMN1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjskQiKS_Kqnt6PNkd7KUY8jHAAQtXCkJCH7KDAV9JFg&oe=6AF1F8ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PKcwpS9swEQ7kNvwH_a1yl&_nc_oc=AdoPBxqKGZXIUiHxkdrNdGX6h7-NqXzV2SPKpIQrz9fI5Uee3wPKp8Urc_B32Ctj0sA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkl_t981YuJLxqE2FW_awWRWaMJTX6SgSdFSYGvjiKJw&oe=6AF1FC82"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-WSrQ-zw8sQ7kNvwE6RJgv&_nc_oc=AdoDW069HoaXPX5UTdSN8QNPTFFOT_GWibcjqNzUmgj04lZp_-_tklrxOsfVBRwaRJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTug1-o24aQ4TupAz-LGNAmAxqFzFg60mOB3MhBpwkGLg&oe=6AF1F847"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Qq6xAnEHfEQ7kNvwFie6_R&_nc_oc=Adqq-NJWoKclC_
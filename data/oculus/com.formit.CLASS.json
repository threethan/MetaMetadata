63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1QzXxHQKr4Q7kNvwFhDY4j&_nc_oc=Adq0NyM2wIUkadTUfxWwcUiR9cGLn0zGl2za4EWkJPdDhl9OznjPn63RtcFDASm5z88&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WnsOs1XVen9PEj0bhh08vuxdxdjHhZLvgusJE_CrmCA&oe=69D7B056"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwSf-CPpWacQ7kNvwEIRxRf&_nc_oc=AdoVP4NL5Ehq39bvJEsbZ_kVMuPTqtKxZfiCWSYH9Qk0ix6AETBRJ9PBdGEUbQuDZjY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13JGQHEYCkD65H1adl0ecZwj_3CttwNGrRNZu2Whicvw&oe=69D79062"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYa0QqAl3PQQ7kNvwEfwluS&_nc_oc=AdoeGoElY-CDCJK2rL4U1W-7UsgM0s2rU5sV7-ItMp3NX8CqsFeAk7DlML-b7J0VLaU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08dGmnwFKR0z-CbdyqcX1OqsdpOfRmaNCpyQoCMD0jNA&oe=69D7AB18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQH9eu_2PVIQ7kNvwGCTOp3&_nc_oc=AdoP-x5KTBhBJExz_V3ZC2ZqAIy_MIFQwDKYCbB_xdl3xFkoCnOSfP4F3eG654DAMjw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MgpzS7YYDDMzwVZMLWqct4RguR-3mDErgcxu-rVBFeA&oe=69D79FAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDwMjahvnW8Q7kNvwG1uh61&_nc_oc=Adr8tITLDdEvfZH6222CtzPH7dIdyflA029FxNGZmpBqung1z-Uxm-rbdcGOFdYihBs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FaCe-QUe5rfE0rb_fqfmoxXSTHvH78MuIu1Ah8qAnuw&oe=69D7A342"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3uSPnu5ktAQ7kNvwEM73nu&_nc_oc=AdrleQtrRfALKnmJHjmeoA72H9mpM48SXcUGJ2h_f-go1R-R1ZWEyfCjGW7PyuPDdY4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eKKSXMuThwQaYDLeXKhd_oHqdfMNqK0dgBWpVq0WZIg&oe=69D79F07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12xvD-xlxCkQ7kNvwGRMmlD&_nc_oc=AdqFelw34PopIm
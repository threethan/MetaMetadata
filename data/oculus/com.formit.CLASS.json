enza titolo (6).png", "id": "2907103559468667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391749_2907103572801999_7847158985527645159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Nv41lnaLN4Q7kNvwHDK1_i&_nc_oc=AdpwaYyO3-4CeYeKyer2M-4whnhVC9lvgz4i23pa4rSDLA0Nr3OkFQQ6RjX6JuzK1K4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn7n0JMZlMSk9_K8BOm5HuMWNDafUsdtY6yf4tOCDREg&oe=6B01D4FA"}, {"file_name": "Progetto senza titolo (9).png", "id": "1086739183249057", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391791_1086739193249056_7684267601424160891_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZcpph7sDcUQ7kNvwGzrTed&_nc_oc=AdquAVcOk_tYcT_q-sjaSIINPfDKNu4nQGWKVrt3Iro8w6K9_hEajLkWFpn6ppy1G2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn_u8iS-erhJdfzM7zUwvLohNJafqTCpPZ7kpBaEom6g&oe=6B01C708"}, {"file_name": "Progetto senza titolo (7).png", "id": "1060249132540287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393121_1060249135873620_1814107242812883552_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LCNw0-FDiYQ7kNvwFKi6xt&_nc_oc=AdotgK21eiVL14rgqH9v3SKDoAH0OjVAVz0ZxCdB1f4bpMOiOMC1wZJBYtz3DBH0WLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEGQpPXAKhS6robtCBcggCxPvXZeNro2I2Asd07KiJHg&oe=6B01E7E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["education", "school", "students", "VR", "learning"], "long_description": "REBT (Rational Emotive Behavior Therapy) is a form of cognitive-behavioral psychotherapy developed by psychologist Albert Ellis in the 1950s. It is based on the idea that dysfunctional emotions and behaviors stem from irrational thoughts and beliefs, rather than from external events.", "short_description": "The CLASS application is designed to address the educational needs that emerged and were exacerbated by the pandemic, particularly in supporting students with Special Educational Needs (SEN) from socio-culturally disadvantaged backgrounds. It is based on a metacognitive teaching approach, also leveraging new technologies such as Virtual Reality (VR), with the aim of enhancing learning outcomes and fostering school engagement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://formit.org/wp-content/uploads/2025/01/Informativa-Privacy_revBE.pdf", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://www.formit.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28693453820238880"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391814_1155705559517152_5748014505336067671_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XJne8szorFQQ7kNvwECc8sd&_nc_oc=AdpqjQCmSVEB_OiKs8f_iRXmcUN2Ch_XB5AYuAPuxealwTc-wL6CzcKeiAHVOmAboFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW6XLW9MyCF5Mv70HbSJdqymrQVSJqGg5NdY4p7rEkRw&oe=6B01EC95"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CLASS", "platform": "ANDROID_6DOF", "context_category": {"cont
/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDxcpqvwo5gQ7kNvwGfDAk1&_nc_oc=Adnxa4O9ocrxxbq0_xAZUGQ8-fQ5c7vJQXPYdgTFQhjDag_nL0QUpX1edGfjTb68maw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5kGiHz9lTAoeKllSSoRnbqxb3UOhUktai7hW61_1XBg&oe=69B80C56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQzHq6cAXSgQ7kNvwEhPOkP&_nc_oc=AdmyEDECCIhDCeLGdl5YS0kk12eS5fEqhJbJuGUEqMv7_WlGTKy14V2oic6v3cMuMmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxrztbSQVzxAERzmxceZ6o3SbCK8QZKzeue-y4dgScfA&oe=69B7EC62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsyDBxS3aAUQ7kNvwFjK4TU&_nc_oc=Adll8NW0ojCburjkTsI60mTI-S_ThhKX_jHhA0A0qd4767CqR1tv4x045wuKGxUvKG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwNlUHtV3Sc7WoVa9CpNCyPTm3f8IRpWU5qSAqFK4F3fw&oe=69B80718"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qlvtbo6ClkQ7kNvwHDrcbB&_nc_oc=Adkh2Fg7gIGPUKTO6kou7ZfVLs1p7pFOyJsE5CeLkc0Q3yV4ngOcYg-mgON_Tv27Jg8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwZj5tLa7ijaNvnfCzK9kIYxsnH4d3fCIQODnS0PFCOeQ&oe=69B7FBAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFN-7UW6MaMQ7kNvwGpaIsV&_nc_oc=Adn--5716ttpY4tiL0bVe0mj29CgwZUn77TsatfO7xQz7QjpTFPdyM9PKxB05Amonfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEKYlqn3yauvhtVli_3PKNSKzGtHIjSmxBkGhWpyo2Pw&oe=69B7FF42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejsf2cHZA3QQ7kNvwF2krkF&_nc_oc=Adm_WmbS-HVxrPJ7QCEfck_14kJgkKbXJV5lnbp_Vj2js2ttl4TLzObAmhtlC5O5CR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzyph8wfnIFvDZ3VoXlEW_DHF9vSpj9kw7eTs3y0oYdrA&oe=69B7FB07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vK0XXfFKUoQ7kNvwGb
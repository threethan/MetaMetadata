63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhUzjNBY5VQQ7kNvwFmnMBJ&_nc_oc=AdpCt5pdGrVPtGaCxpCdRxdkrlLOo1j9rdnmA8gBk-Jcc69GsED4ZdN5-OOJUcqOd6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOGjxFcwnr-_jZiybE4Od9Te4ym6GAZCJUl_OzgamuTg&oe=6A831356"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8FiEgkI9ncQ7kNvwG6cnxN&_nc_oc=AdoYQKPCT51KFr3WRSUdOE0dC4weY9p6T3uQtv-dYY2VsAv0TdfuB8HrYY12DQ5Esrs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoTfdmSfppjBJpXOqG2q2ZdVB6ilzqT6Ois1_pSN6HHA&oe=6A82F362"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlge96IMW2YQ7kNvwFFxiuI&_nc_oc=AdpGVGouLRCHTFlJ2Nk2uKTXozXvlkXZiaO65xxUMVhFHciqE6LZYevAJxkC6b0xQIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfR8JEoqVgVeS4DvR13fP94seuLnL3jQy54RNqgNv1YA&oe=6A830E18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUN5n5EkAYUQ7kNvwGTX34U&_nc_oc=AdovrMv_djGqknwMwgmuwF5WJn6AC6XuNlwuSBcj_YIevwyq34fPXX9kkdCuSgFgK0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-AC2MC3Q9G3SSiIEW2Rec6wjQrQ4WZ-1YFrPLGhzngw&oe=6A8302AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z40yAtDmNroQ7kNvwG1YKgy&_nc_oc=AdqmzuM4wy1ggKkbNk8QLyyc1jIMXc3ijgTUpbfF__9RR4oTkWjZR3J7yRZ8DKCRMEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsxnNLZYMqIML_0oRKAkOQsB8ssx3HCV1YNU3ZcCaRwg&oe=6A830642"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPZFz_Dh4j8Q7kNvwFb3Nqf&_nc_oc=AdpUreYXocS4oc68QvyTYTrRDhXpGZ8CdJt-LcwweAiOGgJjPe2rBzV1PrRNJ6qOdtg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj1QNfezeq8zn_WvPs_UZg0R0L-QRadFOw1nbxIHYkGw&oe=6A830207"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXAS0n7BeJoQ7kNvwHC-Db4&_nc_oc=AdqoO8nJOi6cvl
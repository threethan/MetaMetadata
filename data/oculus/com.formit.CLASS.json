63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EZuH_GXcaYQ7kNvwEVa3dQ&_nc_oc=AdpCQnqxXUF_dsrjjArHJEHYMItFVNQrlllx9d5vSltvPwYiZqHQ4bij3CqEcFuaLRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrl-rW1v1RUUVTmkzq8QkySPJ7YEkUX4fXgRbe-FPeVg&oe=6ACCE756"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yLuz_zCNiIQ7kNvwFnqv3G&_nc_oc=AdqTQ-E_eziNrfJRqzzQJpjkFgJHoJ9_vED5yuOuUmTJGy0ZFfYBJVKhpZamU8k-7DM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvxCa8YzmKup18v_5nSWb1XmQ_kib6R3hpBsp1a789zA&oe=6ACCFFA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPaddkZmWskQ7kNvwFt2IXv&_nc_oc=Adoq7b9GPA4BbLA9Vwovmefd6KtUGVxM2vRhYgXaAzxlIkhPAZTXnjh-1NWQWomIQ44&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVeVeK2kVHyqtOx1PTVLhcqbt-pLjue0wvNvjnkAf_3g&oe=6ACCE218"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qReysauDYQEQ7kNvwGAWmM7&_nc_oc=AdqXg8wBP-wlbEVZIU5QPDCMGjsmEU9spX0pRgkkMk7pIC52X01J15qvIPSsVS-rGMM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNE01pg_5d3DssgK0ah9-4P1AQTWN83XYn0KLE5U3JAQ&oe=6ACD0EED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CikW1LAZ0owQ7kNvwGGRSS9&_nc_oc=AdqD50c96g1i9DWJUAEAg_AXQ2B0asSnni3NU7f0E3R8uYd37xqRfB8b1phyvQCnNAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0HRlS4TbKCbkoHdK_l3wz18L6EJxHBeUV42JTszzZYg&oe=6ACD1282"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ5Vav8n-D0Q7kNvwHvvF-Y&_nc_oc=Adq84wfpUTN7-TDzHnnWXBsrEod4JjoTGwEFDGLekkntfrMwZ5qA5JA0FIFRLLPMZMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtHRrTDQjZsW8BmQGIdefCUOcb2dxn1sXrL0Qhxn6veQ&oe=6ACD0E47"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OWPYV7DYVoQ7kNvwF-uL4f&_nc_oc=AdrdQiU6klFb66
t-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9dw5z26y8GoDJY1zUhbKfFyZu92oMBa5qwOxQSuThmA&oe=69C146D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KADJpICYAKUQ7kNvwEk5IYu&_nc_oc=Adpb1giux2hV0f9gZVeuEIsA8fRv1610b0bqj8-YMF1tqUTB12MVjlYkQts1G9ozXLU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxlLFUz-1Zug8OAwNcYuWKyJtP9TA-WY8hYaTkoXFzCIA&oe=69C126E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzEtGtWT1TEQ7kNvwF7Bz88&_nc_oc=AdoKPQtY460hC9OU8ypdl1MbGRkSYewpaYBKHtprhIw6qOAkpamW28GgYzf0JgFG1kA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyhlX-MYNJ_sKkYUrpwfkg8OAW-1_f6KtH-aPHFSH0xtQ&oe=69C14198"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_dgSszUstEQ7kNvwHN8jjK&_nc_oc=AdprmbgFDOzOojIvE7fW4h89lAG5HR5Yqi-QaHhawCbusIRbK7E98lohXQO_tT1a6m0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJ4INWmn3bdoQWJPN1G6xARIs948PxKgFoAhHTB2yYtA&oe=69C1362D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSreXjmlhTIQ7kNvwErmIn7&_nc_oc=AdrtnY95xUUGTqAXMd9FzWJZD0hIHCA4xNeZuCpOsVAXipi-R5AXRDh7ji9vDBpukO8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdPKpJDXnqN_pbFi0qGWFNXlAFF1DloV7KCeRX2lE4qw&oe=69C139C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zosI6Zk-cDEQ7kNvwG3u_T-&_nc_oc=AdohvE1OA4sqQ896sBQ-LLvaivgyHa_Ev_zPHonxga3I6miE2kPf7r94l6hialLyTEM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6RYCcPuB34_NDjI-IvIUeWK8-94MhU3u8uZDGGFHbAQ&oe=69C13587"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkMSMELILNgQ7kNvwF6al0B&_nc_oc=Adpf8RDIY9lPQL0aynxTBxQ74118Iy3L61jgflRh8th0y-LBv-L0cAQrWdOwRuGqWuM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyckRzCvy6DzI-YzzGMOMgpGFJst_kbMOI3FKWlaVUw5w&oe=69C1436F"}, {"file_name": "Progetto sen
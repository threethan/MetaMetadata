63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK0XJQvFmbYQ7kNvwE3XFqp&_nc_oc=AdoDGUF97sIvafb5a0EvVwkZwRXOHlu-0A5CB5JmPoh4J6CXcNE9ulWKZkqNJ2dHLx4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkd37ChYVBlMWN704JuNONXOgXCJC8Cl0JD4nzxgKQvQ&oe=6A8AC416"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_gtVtvloWcQ7kNvwEdHM-N&_nc_oc=Adq5J-TNL1pbbYniOoB4kHdLlvFjjHymGhSuxXptKOT8uk65_qkZuTHCkj7h_AWEXHY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUFmbgd_ksCxPoJVWTADStn_LYZxzZ877XcXBoJ8b-SQ&oe=6A8ADC62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMW4trqbzAgQ7kNvwGfZL0-&_nc_oc=Adp327KSC1pvW8gUOuue8WlVaVq-DZFoio0266ZtMLNVDJVx_3IwBd-zqrMgiqCeC68&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFl6Q9_SMXhzer2jwPNxDXbdZz__JY1KFrukONElilcA&oe=6A8AF718"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PhsYPx63WgQ7kNvwFQ__w7&_nc_oc=AdrE89Pl4Uc47Zwa-jtw2c1GN8UTevq8PDIJJcKBbjgJ0vFBS_l946Eb-aJzZI3RJ1U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYjNnYUEL7VUJeVUx1AOQJTohTs0NG6kEl7CqmQ4bQVQ&oe=6A8AEBAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcvTLL7VEJsQ7kNvwGcsmrP&_nc_oc=Adq9Fxp_m_1LPyLlRAAZiM8n7stcPGhUcKYOdY7W_vs_eetfu5V7v8LfkvsIpHVdLfE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFu_pTDEfq1lVtTQPSfD-3NX6tpSSBeMbmBS08V-OvQdQ&oe=6A8AEF42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4hpiHvlYVAQ7kNvwF1lhNg&_nc_oc=Adrb5lCRFPzXbfC0Bvac5ucDbdzd3VNR3xhE7hh-HheVHZ8ZkmWUnuRXEDcdscANjh8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMxWvGNRgC15d6mHz_NFxXkf2SBf7wjyg6c9KtPv2E7w&oe=6A8AEB07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eboKaUVFnqsQ7kNvwE0UN4A&_nc_oc=AdrTH-diSlwMJg
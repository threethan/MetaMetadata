63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyeAcAjYYUQQ7kNvwGx671J&_nc_oc=AdqtLRdC9-X8qZeY3mzX5t4mpKyWGZc3f_WucSN8lbHG-hjR4LBydwJLUn2031uTq-0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcDHQ_aI9GNQcaEjX6a3UqA_nZC-IajVUcMsrJ0zYMnQ&oe=6A92AD16"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNfHEBT_cDAQ7kNvwGMcpy2&_nc_oc=AdocgAavxW-WoRc4_QggqDdwrEf_imz0X6csNkbmzXh9BOnBVnCmYs01NtFCHZFCqj0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9kL8G56BNrORYUnuVLs2wV6IQNp28qKTztEH_-1Z1yg&oe=6A92C562"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WWlh58W6vUQ7kNvwFNUq2E&_nc_oc=AdpBWtOhMssn3-lxE5pGL4rSCKpyBY8wLajCTkdA5s60HooAOpRdtCaf1R63Bexa7ak&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHveVQKIUJ7hNIOpxSfuk3S8a7hquSLWDf_-9mmbjMp6g&oe=6A92E018"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODORlxZidCEQ7kNvwELhOlf&_nc_oc=AdqZvGGpLNzYMdmNQ3cvL284VdG0YPsTfsrydxq71UrCQDl0w-2BCeXuJoS5_k-x4NE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn8N2zfZlwD3MNFWtkmj7od8pVRKJvCy1zIwSoxHKwBA&oe=6A92D4AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V09rvMAJfqQQ7kNvwEgRtRA&_nc_oc=AdoiN2c7WXt6P47FlqRSDAoYlf8m005EfnayxZlBB0Dq6NHN2q8FbhEcaYwwaaxtksc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuiWVZHUBvIYENopw4JV17gTLr_f35DP6Fn7qij6I3-Q&oe=6A92D842"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-asEBwMRiPcQ7kNvwGii0y2&_nc_oc=Adpn0rR3lzOlvPnCF71SMX7tcDmfIgqtpKf2yaBOE3NJL2XeXZCUVLubdlfPGTWdEGc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHhdyJDML226Jsx_IX6-gBtkEH5KGiTFRqsPNCgXFBWw&oe=6A92D407"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwtlHBs5FgkQ7kNvwHdN8Y0&_nc_oc=AdryMXK3FZ6TKW
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAsSVj-eifYQ7kNvwEyfT6r&_nc_oc=AdpB4KuykRpqx80h_RYiDlUbHHWeC3BsUeOJJ6HEXES9lI3Vc2QLK7FzPKAdRtkp_t4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToKC6OR3ZSxUKhWhU4EpujfjRA3J7g09nLOHYFVqBfYA&oe=6AF5C5D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLf5_Ne2hGwQ7kNvwEHgCKS&_nc_oc=Ado8n0ADyaDfVev3NvyCYT-AA4ETY8KFFLhPN-_LE0eUmp9VTkIQQz4bfH86Dxw1lUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREjuGZOmXxO3Mq48lU-vJ15IOs1aqJyvvJQwOeISN4zA&oe=6AF5DE22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_1n0YdwhkMQ7kNvwE7EXYU&_nc_oc=AdoJi7ANQG9j36O2K7wQmCvCDghk0VWkxEPZlW-1wFruGcld8-CYv1KDZn5y3R2yNPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTirNGRM-lWvwRVGz8y6H8rT2XvADyBQgCDZTDi8b1pXQ&oe=6AF5C098"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-htc0qnOQVcQ7kNvwHErUQd&_nc_oc=Adq-CFpRVbgofzU-agtodl9FAa4PSloLqh4S9xch_XJYIdoyqRpeZIfBScN4uTQm-Lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2UL_XG-gWUYeHXc8HRQfsRj_y8Ff-7jT4hJmYS9w1zA&oe=6AF5ED6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaauZYR1fTAQ7kNvwE_kPAU&_nc_oc=AdpX7ZL7bDPBKAccVZUyCejPan-3eqe4y3b7zw8tQQhM0ZC97Y6aw4NVAF4nkU-HMkU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtUGtGegAfjnRG2aHfjeb-tdwdpZjckkz4sf2COb44DQ&oe=6AF5F102"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-WSrQ-zw8sQ7kNvwEbwfU-&_nc_oc=Adp34GxPYPSbBxmcp75T252HGCH_UPJuYd1yeHp8Cpv_MZ3w4z0p8l9RXWpsWNGUdFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_i4mmLVbaD6x9OWenhFzla_o70E-qZgAp9OHqE4N8jw&oe=6AF5ECC7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEu72kAeLVMQ7kNvwF7C6Yn&_nc_oc=Ado7fKGsQTApR1
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHdaf6BB9RUQ7kNvwHSybw2&_nc_oc=AdpykK0S-J70c2p4e-wBdVCHXhrIwFtJweZg65kZSQ4l5sIu8OlNvWX1GBaLJOHFBgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTA6Dof1Ks9iNe8yIrO8JqwpTklePTH4JPNyQOQLr8EA&oe=6A50FA56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrJA81HIsvUQ7kNvwFbtxro&_nc_oc=AdoZHTPj9PRcIjGozsWyHnz7cMe-B_9b9fLK5LDEpiITyrdSggqBsy5oU0WLJI7wq5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk0HFZgNaHsQDXiaKdI6WxJ_Xnf1h1j-IQ1u3xePYLEA&oe=6A5112A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hhx0VLfF49cQ7kNvwEEjcSO&_nc_oc=AdrNwoYO5IG9aZS4hzLlTIMiBTmc_wtGQ7XjAx-8_P7xIkRjTN7v6bXejiSqNqPjLms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyFBVVrOdNPlhBCJ_sCHDbvAUAJFD4SM14ugo8DM_I1g&oe=6A50F518"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfyXwRzdQt0Q7kNvwG40J79&_nc_oc=Adp6ye2-rlw-Seuz0jNrxJ_SjzcZj-VIMKqWnVhkAFP3UcVjAjHK40gNwTgCmQlMMAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgj6d38VtzJ8of0TVQ7ahUXjCyROo2ubVVA9DWVU3bWA&oe=6A50E9AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duS8VT3iz-gQ7kNvwE_nKpk&_nc_oc=AdqqmPyEA-DBQe9jTxnDQX2-ThCnmUgRko4mAgZ4X1ziiSrcm1Uz1_F8lCJ1aMf8xTY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaNyJDBfXFck61fTdpetSIU4iu6BV_tMtQ3xDRumLjEQ&oe=6A50ED42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN4zoEc-gj4Q7kNvwGNQL-J&_nc_oc=AdoBsPQvZYvqw1MaY5Ezz1aXYi52SUAkl-wL0m1zKH45wBJ6d-trHac3_1E9jMOuQ1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGogS7pUZKCBpb-G-Y1xumR1ZXEWnP7m7Xx2Gl7fhphw&oe=6A50E907"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msG2TZkKLhEQ7kNvwGmX7ll&_nc_oc=Adpakbm8WUX3pn
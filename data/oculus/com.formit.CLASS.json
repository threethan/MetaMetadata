63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkr_SAoVh9MQ7kNvwGxeQgR&_nc_oc=AdpaCWas30s_IgXttsrCX3WZDrvqW1MeTaFkckkrBSfgjvquvzxpCYxDvqKsdJXk30o&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XInUQfHnUQeKJ5u206jTrK12mfMsmZrGS5CK8QzkMCQ&oe=6A1AECD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7TpFkVCItcQ7kNvwHDYHKb&_nc_oc=AdpahUWXvnICC6dunWpWf-HKcuFpiRx2atA4MOA_sIW92vIPKtnqb-Bs-VuWO0EsbSk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KIT3UqHkXgpyHfAdAjHzJfAw9A0CNmQuGe3jWW--VwA&oe=6A1B0522"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqES0zk7YX8Q7kNvwFn0EVZ&_nc_oc=AdoRaA8QZwTcyAtUPoDnOPDP0mTFEHAryg_eCG-HLYVhQDYAB3cmPjWOppsOnRvnoqM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KbB76a0jJ40efPd3K8XzN2bUdSQIEO98VcZpsqTqZGw&oe=6A1AE798"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAGOopASFRcQ7kNvwH3sGwd&_nc_oc=AdpfRDVioNPkxNcjsJEJmTRTKnMpq8v7xNjwRz_5mRaBrxBdcwIDLCcc9a-eDCqlDsE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xKGS30k_TvNpYj0jkPvk8EyNMtDS4_FzZAPlQxSDVmw&oe=6A1ADC2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iOw5wm6jhoQ7kNvwHkqJGQ&_nc_oc=Adr-Dv2J0WiY4jLXPKCLJc_JjRZjWVJRp2M4nJaRkIwTKHeEX2R4mmx3dY-zsIkOgkI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qi4QUkgUETWCEdJkePrun0YOERWIhf_HMU0d0iUb5zQ&oe=6A1ADFC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKCwn8Ih6AAQ7kNvwGNAKj7&_nc_oc=AdrhnYFGe_PaPxuNeekYTwHItCVsDuU1faocUQeZgMlBYqepqEWhtw6tVAAn7Toy6s8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65SWw2_eoRa4I2l6QiFsW9c_VSh_1MbSM_HCs1s_Ckiw&oe=6A1ADB87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uu5iwc9JlHAQ7kNvwHzWGbS&_nc_oc=Ado70o6VHVG3Kj
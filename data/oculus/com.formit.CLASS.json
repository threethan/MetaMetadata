63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_RXGNLSXw0Q7kNvwE4MYzM&_nc_oc=AdrHEuKje29a0HGiZtiC_QNWbpVqHG_sb5-EEshCN7-eG0PPYpNsZJUM13eayNYythY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdxv03kA9i8N-0nD0qnUFeurwlVRGG2rpjB1C1cn855w&oe=6A788756"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HE1DVALSskQ7kNvwHHrqFD&_nc_oc=AdoPE55aaoMpwGFgNVZnK050wflOF49U3EB0PDWHFv7K7gm6R6eARsq_QKL4_r1xllM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR2Fc7k4mrPpVNO8HAup0-D1OEaQtjRQ8ldBvBHJHccA&oe=6A786762"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFRv8hTcf4oQ7kNvwHLXNIC&_nc_oc=Adq41kAjYuuq7eFsEZ2L9dOf3Qau1X9wtPZdgur5o1PyyOVqfAo2jOr7qu17m7vPs3A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBd53OB1pA3TkvfX__Xk-lRRvuFtwjhd0C89OEaDJlhw&oe=6A788218"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_XxOL9PLAUQ7kNvwHTkseA&_nc_oc=AdrUwX1Y88V6Ilhfgyn2TeCB-Z7lwvxyof5kaIxa0uIrCoNy7rno3Unt2R8N_jza-9U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzfnzjB7Vj19N2AlZ-Xz01NAWJt2khZyMNlbsPvyEG8A&oe=6A7876AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-OKki5Ix90Q7kNvwF9krN-&_nc_oc=AdosFiwcFF9hixTeKJX2Uir_JVWS4xYJ2ouC3oD3GHJ-ZO0OWKj0km0cwDEUyMIx3vc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdxo0AakpMtobsWUubwYzeYTEZ_UBNVndwgkqtKHLTFg&oe=6A787A42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9dLM227W-cQ7kNvwFKqJTj&_nc_oc=AdrdQaGrVjNwWD-RDLzpQLarNj5EhycJL-sNg74s0wfQlaEGlr7dOhFxvVy4i-lH1jo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHepYJBDjIQoQFZ5VVZGbAbXPkQ-Xj91Fsmqfgj4VMMtg&oe=6A787607"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGbCdxAnhskQ7kNvwHW1vcP&_nc_oc=Adq3xJgb30XBsU
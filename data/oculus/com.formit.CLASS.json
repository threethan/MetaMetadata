63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxjgMpqPdGMQ7kNvwFKZOpn&_nc_oc=AdpFkm80jbhA8AyQIYKLH7qt9DCgVzkuB3oHapOukHUkHsm5Tc73rIUq2vm5ok_0LCU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12AEnqFOaxvZssDArjv5U3EJk5eR7z7qZZwV2C56c1Nw&oe=69EB76D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cMWF6f5bA8Q7kNvwGr5iXZ&_nc_oc=AdrJUImS2HqPZUlgPqvc-DQI4EensUti0ln42FApiNGbuNdT61T4th3RRg2qznBV-EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AltzVr49yQJfBeRTnYavE1rr4-l0wcJnFk-5b2ZZTnQ&oe=69EB56E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgTN_-5ZYTMQ7kNvwFZpBUS&_nc_oc=Adq8jkXeWBQ_B8ARMAnwdFRTDps2MVT2SdteWxKM5X-9fJwE65eVIWuBJW3YmW6g4LY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tS3bhPSvixXCsFA7q4kqScz6q8irI6r8bF9JnY-GjIA&oe=69EB7198"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwGKZ5KiQfkQ7kNvwHq_Ojb&_nc_oc=AdrWNn3IG6S04-KTuQ9Oi3w8uPnWNt3PQHT50nr08dwI_DU7I87QBlGufWgS5Wj_MFI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XajFJYdROBFrNUYf-G3gRn_TPGK1RlNB2EIF7BANAYg&oe=69EB662D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2Jp4Oy-KSIQ7kNvwE6B7nX&_nc_oc=AdpBhbkafrCISilmD9dcz1iSNvjIct4LEkADZHc0_QAlDzCLVSJSI8HTXKNJOqvtm88&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24Lk0qKEHnve42yCP1eton0WiXert9xqZGOuUIh33yGw&oe=69EB69C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJtyzQuLdlAQ7kNvwHkAptu&_nc_oc=AdrWLzZfSrorlyIwEr5Dcxe8Cx7ZnFm7u7rbpZpd1FNdAWf6B3OqU5jeHP0vxXTIAyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11VzqNspcEO596WELL6FctqrvhbWU0PxEEMxUodwMx6Q&oe=69EB6587"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlgZx1wdvQ4Q7kNvwFktC9F&_nc_oc=AdrXDjW7uANCnp
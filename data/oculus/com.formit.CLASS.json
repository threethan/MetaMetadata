63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgs7ltPxevkQ7kNvwGNLIm6&_nc_oc=AdoImzCtc0nySidnz2sy4uzca9lbrHesIN8p5h3XJY5FpTUB0PhH3ppGa_WMGt5iw-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aBjLs4gZXuFj4n-o4jr176Okf9IghPOuIiSt7_n0vlg&oe=69DBA4D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk0rPKHRmJEQ7kNvwGoRM1X&_nc_oc=Ado7GI8XskeU2W4e0iactNzxuBtG4xrRZ4rR2ijBcY8hX1zKZsQCVqtcVHjmxWBA0AQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34hTm0fpVvyGWeAgn9FZslwlPyhI4l8uHSivbRfujiGg&oe=69DB84E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GojAURf4MHgQ7kNvwHKlleA&_nc_oc=AdqWlAE63hjSEjzZ6ObEk1-8a50j9R6LAbzq9zRad78jupa_4O1nY0ZPKPNtDgIJ7Es&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0A1oUdh6gV0lMvTvnDvyHHySlcK0IGEArHykj0pAQuHA&oe=69DB9F98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sFKIDPycBsQ7kNvwHnpvlW&_nc_oc=Adq2ehrqRIyeBMPuYofBvdrZk12VdIrlHbzvWeMH0EFK9liV9vqVtIebCgwHTi23R6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l0G62xndkEvoSr6GBRPkqP7g7lZ3PCvsnzjAIr57ygg&oe=69DB942D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1H47EUa1eQQ7kNvwGE04qk&_nc_oc=Adr1D457S0t8Qk_UP6SzJOJDGeIvG-bQ9oOg1KKAeYIT6oLj0NlUJTF9Zw_MmXZyMxg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mbEl7sLki0RPvPv_QTFHJlYiwkpF3YvlIbePn3hGm3Q&oe=69DB97C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h1W5GKUcdkQ7kNvwH-aw98&_nc_oc=AdoF1FScT90p6i1qRFzKyb8FmW6D7qzsfjco-G0dcXmA1CdIWWcSNyvBobPYxmtfFjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t2qNYxG9HZdmGDvE5pQlLkbr5evvzeVeh7z8rg8QgcA&oe=69DB9387"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YMVz1yWU_wQ7kNvwEhQ6F4&_nc_oc=AdraYTBNDSLATi
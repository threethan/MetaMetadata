77417945163453", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN3a19RRKJUQ7kNvwEtYykA&_nc_oc=AdoSlkBIfHdrL18mcw1BjDzAJHaBeGfM_shkKXhOUro_TQGtL3QSkltxfmU4fibKIzk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM0hm8j3lBaLfQkXYWJwMwwnmZu4jDWa0BuX5nUPcEUQ&oe=6A8D6716"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkjCD9aV14AQ7kNvwEGA5dH&_nc_oc=AdoYSyDFYNCjqnI2MJ7Ht2XxZFljmSMfRAX05Mx0G_d0FwNPcsJE8loJ8HA0Z2Rh8fo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ5OUMSWiOMf1k0spIwBFqfvupuZTYY2l_O8P7dx7Rgw&oe=6A8D7F62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMW4trqbzAgQ7kNvwHjefdz&_nc_oc=Adp28GkoH8ckQDoa1l3KbklB6aoOR6koVvdrDPBiQGFzOh0Ck9yKovRGbHm58loMLzI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVw9YwoseCjwMNUF765SrUp02NySxfRHPF2kvG0UVtYw&oe=6A8D9A18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PhsYPx63WgQ7kNvwG8P2Ig&_nc_oc=Adp-XQ1gqL2kFP-eGe-u-I8H1YunaKJhgt5EkzdqrWIZkPV3bxlLq-69uMKKpZfCt7c&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIrz_FrcwGIfWvHKa7oyZ8peLjzk-wmXTPCE1tAMG8iA&oe=6A8D8EAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhqp7M_TKPkQ7kNvwG-hLlB&_nc_oc=AdqZx6afSLRCtzCQ5jyFiwRGSs3wILsdAgL4hjg1Jrn6mGJU9iFUo2c35jlIIF3Per4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbspTaakmIXcqiScV70AuIvDJI_tzn3fZ56_GO3jcAGA&oe=6A8D9242"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1mA8lnb-BkQ7kNvwFCNq4Q&_nc_oc=Adr9IKZXPnnNXAD8cQfI7thDKe3AjE6TyobT7uwqxBil_3psilmQXTdZ7FUwKMSJ0Mg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzdKC9_SDVAULHw2SZjnrJ_nl6YWvRcbWdKEJa70qVnA&oe=6A8D8E07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416
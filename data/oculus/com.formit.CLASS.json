63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kK_H6iZZBwQ7kNvwEKwpa2&_nc_oc=AdqNdj8xCQx3qI5w3RSOx45_-SwlfqhYKMc-u1qQPTPGC71W7TVKZ3rxD_ckb-TllrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMn9CdIYkuj3r6MrdMOEqaxw_SXwzUvYS0b6x7nUnjiHQ&oe=6ABFB856"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KC5tj4yITFoQ7kNvwGUktpf&_nc_oc=AdqMzk5YZbGIgUwZ53ZQXB5CUnL35GmjQQOLj3RhPr_81bBkbn_l3sxh0CoeDuerLFc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTM0JNAQuOVh5jHA7dUMDLA5OBBBafmnnKdFunJW62Dg&oe=6ABFD0A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvYOFohn7WQQ7kNvwEiIKwu&_nc_oc=AdrKBltAloGlBIWlfpL1DsoM-1VQf8M8vVw4k2zx54N1agQBuTA7ht8HkGSch1S4ZkU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGEZtY4q1DxRMJO7qJW5yiaSZUJKfWY07Ls0sEowzD7g&oe=6ABFB318"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvwWppIfU54Q7kNvwG-I5Qw&_nc_oc=AdpBMS1E-ipjOsSXfFpjOajwiBYUX3GCGbDrgoLIHkZdQvpM6sbzXuNfA-7zIiacEp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8Jbhqsmdx-T4NtVGOlUkaYiVtClFZZ_1ofN6xovBteg&oe=6ABFDFED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7hnF9CBFQkQ7kNvwGZgux0&_nc_oc=AdrgEOXFcNgIpNYFRjbwJ-xcBXoncpUb5-4p1AUaDDN8IL96Ia4AE0vrsmztdB9E-T8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR14tF8D5-C4dGs5KhqZ2EdflE1T-xz-Yra4l1ZSIoqg&oe=6ABFAB42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97MTr1YTXEIQ7kNvwGjZKm4&_nc_oc=AdpU2dR7UYtadBJm21Rmw2ZbmMZZZRQAkPdR9uzOztzGeSEKDxbxx94K1a8SLrS2_dk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2zXh26vp311udihMoS9IkBqTHcjlJ9g77bLbPi95SmA&oe=6ABFDF47"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhoIZun_ghQQ7kNvwH86426&_nc_oc=AdqjlGYFkMew64
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTRQuwm-624Q7kNvwH3nxi9&_nc_oc=Ado383goRmFLz2yV27ANX8Gcdea7Q3AMdICzG8zoB9jaB49rypXPLVT7mUs75GyIvgg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dKUj0rdXp92o0r8vwtnBF6750RGCuvHdfwgFW04Xi5A&oe=6A242756"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqxDh0RZhkAQ7kNvwGhm_N9&_nc_oc=Ado9BnuuqzpOd0YLvaIL5XqpbgwOVVjU8yiJ5DDfA_VzzlI26DQQAVB1bzq0DAo5e_c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EL7WG9tMvxOCPXLDQ5YLjDnzLNDsy4V_cdZZ4LE4sWQ&oe=6A243FA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAA1eMg4IH0Q7kNvwE0ZCad&_nc_oc=AdofpvGNB4KZyRVJJdtOUzCIh2qUpPv9JKOCDahhTcvv86JYFZwAfdQcmUs4lcRPIK4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mj-zDo5vZFwikFxYCuMsR_CSX5D7pwX_i1PInoX9jjw&oe=6A242218"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Yc-AxLHSvoQ7kNvwG9BfTw&_nc_oc=Adoc31czITNQvajsaPKTku5RsVI8OjzI9z4Iv008kWWuycAETeZJFIwW46PsfNvgwXg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZouNZ2YsNxZAEQlp63wGybsG71ZcdYeOUDawAnU013g&oe=6A2416AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8JFFZD2JukQ7kNvwF61WC6&_nc_oc=AdpMPP47x84HBcrM7Ur8jpNjRN8Sz5yvbqJuj5KV2nosWgZvG1PqUhwiOmU0l5p9Xu4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wLskSYPm34KKq8lDX_6z94QNsSfvoJgmi3T3JnqD-2g&oe=6A241A42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoFtJ2iJUlUQ7kNvwGnYoC3&_nc_oc=Adr5iRPD69FLz9vQQvl8AsAM8ubYOFkOqH0YXaOtQcc2puR8fhOXwNPkRwrJthII1DY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DFE0muchduREX4t87KWOUXOMZlC0KAypB6uCpGYlzGA&oe=6A241607"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc6DXkLXK1kQ7kNvwEzknVJ&_nc_oc=AdrPiO3CxY4YAI
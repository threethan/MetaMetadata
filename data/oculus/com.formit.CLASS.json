63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_leeGEnhwA8Q7kNvwHAETzF&_nc_oc=AdrdDU4DUT8D98gDLU86-8xAea799cQb-YrNaOjJdaSAM8tbl_-vK7s1y9sMMmum_Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRsyW-MzGNEaIBjLHwZ7pHEtka7F3NLRSoalXDNsd3vQ&oe=6A5E2956"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lo1LPn2V2cUQ7kNvwGQvU24&_nc_oc=AdorhaXU2pYmbLVGAEtYA_GYhZW8iT9PcFx1tZ0CQpEjWgn_5BOVHD1W8T8nDQ3GRX8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1OaVZ1w4Po76bB45mChIZ3GDnDcvkfou-Q4onLFcSjA&oe=6A5E0962"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJtFC71osjkQ7kNvwFTUF77&_nc_oc=AdpJzX6rFDApqVTYYsyBpIjLQ569Rb0nBM2MlcCI9fxS0YY-8Y4SvuT1yhDg8PJSJiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZ30Ik2ms_W_WjTivgmNgjKeugShQObuT_kbGj-ik00A&oe=6A5E2418"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPHQ3V83QQQQ7kNvwEH3wet&_nc_oc=Adq7lPExXjER0PbEhU2s3XBVdMyCJexGzBqTRvXwZQO_aIn7zJ126J7N420epuNyL_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtTLINOO2BulWnBHs3TQgZbGM7CakHQfJBEpEMGWRpVQ&oe=6A5E18AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjaR9htHbW4Q7kNvwHTbUgj&_nc_oc=AdqP-MGW3L2YKpbL3pNlSQHENxv8H91j_Qd0NsBe_OIYvGpkh4mLIGXtgw_5Kyvuy1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJWHiLPlmOjKjL8qp2k8EaT0ArDUqJvkNyD9KZ7NwjzQ&oe=6A5E1C42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF5VLpB878kQ7kNvwFPsgA7&_nc_oc=AdoZyhWjcg_7cMb_mflZ6Rj8LSSY98K8zAdfTVxtFiUc_Hc_q8bkAg3p1VmW7pi7AfU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFOP3uaAhp5tspuxanEs__LNR9ODX5RP1xDC0AEpY_gw&oe=6A5E1807"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaEpJUgdWj8Q7kNvwGNXGQU&_nc_oc=Adog-LQ68Dt4XJ
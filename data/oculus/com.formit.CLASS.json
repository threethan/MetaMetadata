63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQEL7m3_k0AQ7kNvwFOMPSi&_nc_oc=AdraLt0fEmtS9nrC8StLpl_fDfxAko_5mZVGo39uISHzR5HD8BvmVUT06sKLqg-TLnY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10hPczzdw85aK-lc5CxQH_HTUjVzR966kHqSJclpUpKw&oe=69F602D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEXWGw-he-cQ7kNvwHqBNR6&_nc_oc=Adqra6g1JF4kgatPvgnSkX0wnRkhvr-jK4aNP2vJMrrSMEet9pFDHKwQr_O7klJMXc8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1UQfRQ08QWxYzsDznUYYe3E8xKkbc4EobVrZ0RjZlYQw&oe=69F61B22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2crEUb-RlM8Q7kNvwGynQKQ&_nc_oc=AdqHXmUU4DfPsCy9FHjmUsDa-7qcGLJocxZd0DwN6Pdh259_NsEr7cROwYn6hWsKlJo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fiRcZ290zOzxutdGPMXmNZfvFUlSMC9tYgh10xsB9Sg&oe=69F5FD98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AJWy_z-V_cQ7kNvwG4ii59&_nc_oc=AdpSc5rhbcICwqYEcieJc7nOo9ycwJu9G6JPOB-ivNajqZMCTPe_sseXRA_uIZ1gpco&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yOC6RvR3ZAZ_MJmp7QDKNJvZoSiyfWXVT6RvAaOMa3w&oe=69F5F22D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYHU1sCrKmMQ7kNvwEj-ZcY&_nc_oc=AdoXWrOqhhuK5fyCYqPDNO6HgJmfH5VFbj7KbsxWzxVu2acwPhnf0uZgfN3F-TvakKM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WU0Ia-KUwsZCUDZryRGi7ZU45RsmxV3oWRrnu8VwvEg&oe=69F5F5C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nyi26-1o-CsQ7kNvwHAo3Rv&_nc_oc=AdoiloIrcj6NZrUYJfnkZ4exbuIXF9-hJcD9s5kOKP-6M52oJC1fhGeD2skTBkdb2vQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lT9unFLyqY05VnnR4LjFvIfD7-P-mY6l1R39F6FQZtg&oe=69F5F187"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl_W0p0WRNsQ7kNvwF7D4dO&_nc_oc=AdrS3yY8Zl9i0U
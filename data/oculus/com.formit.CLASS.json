63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKGM_9nRdG0Q7kNvwHf61R7&_nc_oc=Adq7nmUBypXtwsWZoPJ6TH9PU_dy5CI4cXgc3rOwRRc1YLu5V-1_FaawTik07J-demc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eW8vV4SZ1sF2zXC4ADcKCffZ_-plK1J7H0B4_M1Tlrw&oe=6A3004D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzeZa8T0WMAQ7kNvwEfr4R2&_nc_oc=Adr7HGCrnZxLc9ApANcok51CQKooauwaNoHhkSuCRPAEcTc05ZPZ4rgjOxv2ZswdLEM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I7Z62AXPSZDlg8z-_OLb68gjehBMihOCn23vDxWwTbA&oe=6A301D22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emam9S5c9I0Q7kNvwF5dCIF&_nc_oc=AdovLl85I2AQciYuCp2yb4ulBrloBbTjQ498L-Gi2vY_2icxuqJ0V_lYym7U6dRzrB4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YntI0DLc5d-nBEVcZ9UWLm4jqhDNBbp-0N3DnE8eTOg&oe=6A2FFF98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL449ywSWLUQ7kNvwHRsDL2&_nc_oc=AdriIhK2g4CAMv6kA_BGTuRG7vn6FNpLKuEhSeYkReglwRnQzYPzaVWRct1z8Dxos9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1dp7H0Af9O6xeUVmY313JSEYUDv1e9a9BTq1sYrEh8w&oe=6A2FF42D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klF89aRVG_oQ7kNvwFQQucV&_nc_oc=AdqOcz7b0ofrV4ynZzdYuloBwFYZyZmDGa1Bgoo9o4UbEwOpwL5YDYUddsiHyjtPSs8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1BIH-EN_9lffHtX_cEjaCtY0m2ZW98JPB2b5LywTw8w&oe=6A2FF7C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhiRHfuSMWwQ7kNvwGvC_aa&_nc_oc=AdrlQ0dRczEpNIcEHGV1MYhcOR6V5BRYnfad5F8AsN1E96N4hEMLJqJDNNcbDsc4ruY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T-wlxaDhqsf4NkcNUWA-w7grZM48SWNWZFadiVJs3JQ&oe=6A2FF387"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVrUgPeFapIQ7kNvwG0Ot8L&_nc_oc=Adpq7xdZ175DHH
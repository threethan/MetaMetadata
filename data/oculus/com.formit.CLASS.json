63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kK_H6iZZBwQ7kNvwFu9G8C&_nc_oc=AdpqJSbpdLQf6a-OBG98awkYOeIG2s1KkJYU3B5VIR--kqwY2YY0fy8Q6zL5c1e64qM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwQ96vCpyEfTBiXxU6zjQeZYvk60e3IQLtKchG4CLD0Q&oe=6AC109D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irBAlw1LtT8Q7kNvwHUZv6y&_nc_oc=AdpiFeQ9GUbKpIM-VGDYjIfJSt0-DyUWHylk5Z-e_woFP3BIcpYFTpkfuyLfWgo2cPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0I5TPXkJTmD7lvV0XiGI26xi49RcVT_onM7vXgG1TVQ&oe=6AC12222"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvYOFohn7WQQ7kNvwH-V0A3&_nc_oc=Adp5xw2JubvCATo2vx1lijsswEiHa7ZCl4vM5Zy4Cigxi5x8qyvHJ8onHQ7vu82OyoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxG5sRxPEvmnd8752JE0H1GTw0ZDs-FX-i4nE1rz46Sg&oe=6AC10498"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvwWppIfU54Q7kNvwGABZB8&_nc_oc=AdpF44WnJG8vk1DxwsTqNRuW4O7opPOsmDp6cVSIqYVgT_dI1-jCZZfHnU4QJgUETho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeNUpz8_dfgWaOhS6i1MNPRw1V45_01-uLi2uQGRRGYw&oe=6AC1316D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFmRm2OkBg8Q7kNvwFgQUsf&_nc_oc=AdpO1UYzCBfJKsxnNKGC2vczB9xBSgW1wrkp5YqvpnGO0LQ9kOJWdnqBdUM3rbN9qXk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Nb9EGcQ_3xTdit7o8QWMwjze8XwJMb9VSTr2iYMQRw&oe=6AC13502"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97MTr1YTXEIQ7kNvwETx_Bg&_nc_oc=AdoTjVpgqb6UampYmZbdjfqZycYkTjzi73NtXsZ3u7lvzl4YAZ9sG5hZUfyE0zNyJLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM4DrSyr0a_5_S1QSW3h3Wk-wKQ5Vz9WWEPKWWueXcXA&oe=6AC130C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtHB4vn4j2AQ7kNvwG9zQ9i&_nc_oc=AdoJuYmjHmvARV
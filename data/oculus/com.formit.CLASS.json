63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHOLW7huQ5IQ7kNvwE4u_BS&_nc_oc=AdoFyHD9wRwxFXm2mTUSkY6AUWm7Wgv3dH_35Ag5WboYSvZZp17loYNbZYewwNXkV_Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP82h43_abebTXxmxkiefusq-bjIu-iGXZxxmSVCJtgmg&oe=6AC8F2D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO3GgZMO4HMQ7kNvwHJe3la&_nc_oc=Adr5cHk5BPy5fPCQPI6Co9anMMTGvCGVPlvpWANzGcgRG2h2NF0-0oGP2rOPGJxe_Fk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsKGLvAdFdlgO2OpDItKywT_5b9-jrMmemLFTSY-wgFQ&oe=6AC90B22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMJ9RHHt-qUQ7kNvwG_qVTh&_nc_oc=AdrHcOWFntxj_Os_HDAoMTLXE5KgtNDcPvpzQpki_IsI-wsZtRKFCW6eC3fIQDIGH8k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoyoBS75FigCCpjttsEnKz438np5BQyuqGPe61C4zBWg&oe=6AC8ED98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig_MhsLMQ2cQ7kNvwFoEuTP&_nc_oc=AdoZ2ijq3BlBwLJUeQ3kspwIWf3-kuBmOH0DPf_uLX82CK-hI8MheZCE2yqMuRdkUlE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM44-P1gNGpGD7Zbfby1ZycnYQ4Kxbp_jzDRth5TSLnDQ&oe=6AC91A6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHpwgcx0WoYQ7kNvwG1UFqN&_nc_oc=Adq6-A2kCdarj4OspKqaI5SVYOeZow0QrdSUTQC-w_-ALlX0I2zgaW7XAJhTV8NzepI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlQhymx2ipQRWeryf0NH1hFTmi2nJP4oh8A_DaPqM_Xg&oe=6AC8E5C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESC-tv7zmM0Q7kNvwFkV6cV&_nc_oc=AdrNXgDj4r840oDY1saHnXOog18Or5yUUPFe8tW24PwJL73qtetH7K8AgAaIPbDIdAs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEXcXqWEFeQ5NzQD7n6d7l1JSyEhCwrjvbTRMCNwpCwA&oe=6AC919C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AY1erDCpbCoQ7kNvwH8TnJz&_nc_oc=Adr_AAzlOtP28J
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myh7JPctfBoQ7kNvwF-8LZj&_nc_oc=Adp-aUsQSAoJM_Kis3O9AuMcABvohZvFXr6jaAOCOm-wUdClpE6OruX9L0z3PC3tSXg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2As3BnHRS1KachDmALurMnOOQwVK6rZmMC_uFrEpXnXg&oe=69F4B156"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEXWGw-he-cQ7kNvwHopoyu&_nc_oc=Adq0fwa474yefGWdVjJ4Vs74D0aXl64rijAcqxCMdx6vCbNCLxoZTtUyk0osFrl0Nl8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HO7KSRDN2ZLZVgSl9LLY8VvzPlZY5NtppjJJxMXHOYg&oe=69F49162"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2crEUb-RlM8Q7kNvwGsQ3kK&_nc_oc=Adoc5smimgOGPg3C83Uqe-bvFvkS95M7wg4vMMkfzwxOHd3RoesaE23kOnw4-3c6AQQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1edpfEngkNLJq23wKcLKestSgwFePySk2rEDsAed7jaQ&oe=69F4AC18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AJWy_z-V_cQ7kNvwGL4taU&_nc_oc=Adqw-x5D_2ifBsmxBIb0ZImHECoWR3ZJgP9RrsLbIGqyViJDljlSPxacGIV-J0lHsCc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DUi3ASwJ865qcPy_se6MBvsQlBYEXHiUwt6Vy94Uj9A&oe=69F4A0AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYHU1sCrKmMQ7kNvwHmmFIy&_nc_oc=AdohSuH-payJjAmadTLpKx6i4jHh48FDT_u94aj2tYPMHoDC3tn9bur-tr5EfgUr7dA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24kGOMdgh6GJZxuFclZr0MjK-a-gCVuRYP9RG1wrFk4g&oe=69F4A442"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEdUPbKqiRUQ7kNvwFFOkTM&_nc_oc=AdrxtZiKu6CmLeKCQa85igDUq5pORlA1k-heVgqVYOVNx-nxnh_VjfAsP3YAo-Ki5cY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0e4t9zTzLmRTA03JVrHZGevp2ls2c49w5xxNkgJf7Dmg&oe=69F4A007"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl_W0p0WRNsQ7kNvwHWtlaA&_nc_oc=AdrWZS8oV9puxn
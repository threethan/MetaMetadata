63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzMwhZDJfp0Q7kNvwHiNjis&_nc_oc=AdpeQYt5zKsVoB9L3OPfgm5yu_xaoQ3GzwHgU2rKK6sP_gaHOYuYt4sK8C7LvwPjIuE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMVKQKZUtCDRgc8QWNqsittvq5gskeFJZf3zOUWd0yWQ&oe=6ACF8A56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVX6u4Yngv4Q7kNvwEGyqab&_nc_oc=AdrHo3J2l-v0BlaCDGzQfB_fEZ1FU0_duZcyaGHErLq2eyaOJRiAexcVSLg2TG1aGAc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcA-undqOVOEw34TZ-u2atkr5VutWRpYI39-nIbOK2OA&oe=6ACFA2A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb_zBacu_5gQ7kNvwGMk_jm&_nc_oc=AdrbxKPeP_UFFkOGDEyvhl3Ovf-gCdYxQzCkmoT-sq_SCk4b3BKuRSGKenJZTNY9W4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNReXML2_9qReXstupC-jLRTAoQ9dwwyT75ujSrWCIj8w&oe=6ACF8518"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VFm7diiydUQ7kNvwE7G4rA&_nc_oc=AdotXK-fkzuL8nKO8GKWtkW_TH9tJHqxaDN8o09qbJ7qQpUEt9tUe_Y6D78YRmYoMm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPCn1w6z1XMBRgFEden67EjGXhzmP5d5NQy-NXeU-xRw&oe=6ACFB1ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CikW1LAZ0owQ7kNvwHcwJWS&_nc_oc=Adpyf5q5JFplTtDR6F5vaEzklpEAlUjSjU_ytCDUGrCqrsTkIGYJ9P6zjdrTi-pxl_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv0VVNdJ_9GIqkXR_FOCpeFdFBFF6LNsEtX8U0w-pV5w&oe=6ACFB582"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iODax5Xswr8Q7kNvwGx7cLq&_nc_oc=AdobCdYg3OYbk7NH60WWAYcbY8Vmopq9GEX7WS__VTSCARyIXApUskUYtzRHtVvlIzA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQAqj5uuMbhjyEU5hORXUPsfoZ97b6dc-QrBp2jgCa4Q&oe=6ACFB147"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OWPYV7DYVoQ7kNvwGNwZEP&_nc_oc=AdoNw2arAI_nuL
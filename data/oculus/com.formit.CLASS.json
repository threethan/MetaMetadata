63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns-Y1Njk4acQ7kNvwFVAwWj&_nc_oc=Adpcuiji90kfdeKvBQIy9mP4ELj_lIr_0_Wp70M4eaIU8IwhlDQ8zTWrXLbUTDxOo5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_qB19GgGGfbIurpYZwsZgkB2OoIUzhSMM1m8Hi9tlJg&oe=6A05D4D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZoqV-BgGqcQ7kNvwHekuys&_nc_oc=Adp1DaehF3SZCV86OuKXq6QJe3N_cCYhU2SgfJkkloCGGxvUopiuCHCDcohAPisLSi8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tLj4oKitl6eLJbswulfMTlKUJ81RXSeqejiOXQ4zLQQ&oe=6A05ED22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bJJb-8HWsIQ7kNvwFzHVMK&_nc_oc=AdqRw2m_ED80JdP4RmP12gQqMAPJVu6rFNUyH-QVvWUPqrZW7WNXuVd4NGs-LLYy08o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xret5vUJ2yH5iLqtXcLh3L_WsUGgFVmOv_31ig5x_Lg&oe=6A05CF98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQIxRnvNrNoQ7kNvwFe3i-Y&_nc_oc=AdrAmlcExBcnC_pEEiSsVdTkNtd8e-ooUyaCwxd1P34QLgmoTnViIqYAKW2ZrJ7IxQY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EWgTUeMTWh8oNij1vi93tJ4P9HPbKc99ww1mySDE_CA&oe=6A05C42D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIZV5v-QP7wQ7kNvwEBHgh4&_nc_oc=AdqM-Q9A-4GNxgTwH_OYk93G25xBFkRUB6bEvWGKyQfpx3Wq8aP9lZHakDw-Q1gM3IY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H_gavDKWFEhk8qy5wQcihALMR1xLlJmYxuu2oS4tdAQ&oe=6A05C7C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxQgyhVbrqIQ7kNvwFSdKA3&_nc_oc=AdrZn_t7FqAI052hABoLleXmknovkL7r0HgcgRPLPYWtdGOIlV9lpjE0Kn4VUYSbFyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sInFx-y-6PEUZS_06zLPuq4KZ4oW849SeYhzqMJeTLw&oe=6A05C387"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vPTUAS0nv0Q7kNvwEndffT&_nc_oc=AdppReFjBzuI7I
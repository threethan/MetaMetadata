63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XM6PvxMY9rMQ7kNvwF_vNX2&_nc_oc=AdpDeKXKwgKF2_Hx_Z6EDMdmVPQJ9_LinMezfAHTdiHamuqMOuJjs2SNnJMoL5tHYGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-Fr_3HWckpa1IBvMHH5YR71S8QcZHjZTvLumHLOi8Eg&oe=6A621DD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnxqQILJPw0Q7kNvwGozdem&_nc_oc=AdrrnshylsLRhWqG6VWb9IJCaFDjBro1rtZiRYUNFyuOEJaeXRndC4xkSBCr4JQu-xw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6TZfsfGpqOLt-7Zoqz3n4AGD91e_42nt3aUO4LtrJSw&oe=6A61FDE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC0ZpI9WKk4Q7kNvwECaDKx&_nc_oc=Adrtm20fImhAofFhmBzpp8f1QQ7nlXCf-UXOq1s8V5s5xB9xL2tt0Ugx8XwyM3XSEXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwmaniN0D_0-LShMkpTo8MDnki8fMSFsvwUWT-a3NM5g&oe=6A621898"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lhS2HCLsoYQ7kNvwE7ySvV&_nc_oc=Adr7P-huVukSAIsFV46fNNeFbhb1yc2_dKJHwyG5wmkqrZv_-nmCTfD0WN-7vRFEz4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB2Tz-UCxYUW23QMWh0EfFTt6VaQB5F5S7r9UIHi3MAA&oe=6A620D2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G076y7G7mBQQ7kNvwHWU41F&_nc_oc=AdqXtWzCyUMYyngRTt1sZIhz9TOOEVQB3HbYYBJ8eVOoajiunDjHuZgS7yTFzS4Z9Sk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKMIMP0osivU_nNV5W0i2AVHTbwAH22G683he3urkXNw&oe=6A6210C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTUjfD-2ySQQ7kNvwGI4D1b&_nc_oc=AdowZXD17tZ36IOkcuRjQNW0B-ifqQt0ZIlEYvDMo7VlH8XOgonFgudI3R7ZO7s1Uts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApgTYAYO45Z2szh0urhz9vM7XgME5NKoFUMHZcXLH1oA&oe=6A620C87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXHeBZd1uMAQ7kNvwF9mXGo&_nc_oc=Adp79QqR-iYKLo
/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2n89NbZFXM8Q7kNvwHT0DQ7&_nc_oc=AdnO1yEk3kOKPJDyJK3q6jHJMNWHjJLeVTsVupRoN9PieoZtk-v2xlKrNhl47ijKRBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxId3dI4xKe9P_Wg8nNG9o8IN1Dd9GL-9HR2N5B-L60aA&oe=69AED1D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaYitCv8PUQQ7kNvwF7blEU&_nc_oc=AdmkvZA7TTf572W_uzBRfp-9Qr8qCIlmYMty6IK2FD3hy1YgrJSKXpC4nLNfRHxMb1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwsvNDtZc6JmFquICmcwFIDXMvj-8sakGpzjgSHwsKOJg&oe=69AEB1E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEf9H-zSm9IQ7kNvwFQyDwo&_nc_oc=Adk8lZ33_fn8AL4b9sh9GA-2JN6bcuOaZF1KfIhxnNnR0Se-4x6q3dQopkDBPqIVtkQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4WSPPBBvCUTD836OHfUqPBNhqFEiLXjPIyTcaOIBccQ&oe=69AECC98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5UIFeRqVQIQ7kNvwHHD6Jp&_nc_oc=Adk45L7fYK2EkPn5CBCQFey6NQgGB7I5OUk-kIOw14XQlYudGFmBOFOXstB8ANzeAd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeyRqQR5hnttj26Y2sNtNtsF8XyWgWL5c5dVreHvWaqg&oe=69AEC12D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NF1-CTH9Nr8Q7kNvwHQoxJs&_nc_oc=AdnLUJ7JCMY1AAKNkHW5Rayp3pPjI-qNyMb1ndeBSALWuWaTBOBVz1Ba4arwmBzFPbY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXw9sLVC5wd5pkvtV8Fp5L75hXoZ3x8C5DJFGPIxro4w&oe=69AEC4C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbl9B6qEP5sQ7kNvwGt4bO0&_nc_oc=Adlqf-c24F9jw-RvBkvasiuZNgUXw-O5jy3k5oY0K0WvDhjOwKdBvhilJgsMNy0uGCU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxTkyv1hMiUXlo4-qHyXWHpyOTsPQgjBeMvmxt5p6mmA&oe=69AEC087"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7VvOOUU_1cQ7kNvwF_
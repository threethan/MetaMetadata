63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKU3Ck1uFr0Q7kNvwENaqBt&_nc_oc=AdoXr8YU8TNZQ6bydd-z0e8Yb-LfozqtYZFrZR5EIBEMqGjEi2Hj9i2pshQoLfJ2Ras&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_p3wiIMsn7kYQdNbe3LOkIm7F8VstrDRjuwHeHinrGQ&oe=6A1849D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv5skSAQ-ukQ7kNvwHT4b8h&_nc_oc=Adp4zY-F7z162DlwNK5K-YaZTrhw9EKQKk7UCEhccMHqO7JDONYUJTFsz22fJocO6iY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4epXoGVGGgAiSGnoq4QRaE4G2P7TyR4KhaMBoL7Iup2w&oe=6A186222"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqES0zk7YX8Q7kNvwH2UgHZ&_nc_oc=Adq5z0eGsV68pZn1Cqyjxa067goYouK5zuL1zXzcBVa6Xw6WLH_1BVxaiCe1x1YyiEY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52XRCaXA5w8mC2tjPzP7ueLTOEalpUDZ0TpsA-0kjmNQ&oe=6A184498"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAGOopASFRcQ7kNvwHMB96R&_nc_oc=AdqS1glJuJBNhCWtDhLLGSNOdhBVNOuhjDsPnr-DG-uKtD1EQOPJlM1T8XGsrwEd3vQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70cQ_Yy5W88mz1UGg_2oWyX0C1dmYsnDZb-H2VbtupCA&oe=6A18392D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA8o5gSfL0YQ7kNvwFpJz-S&_nc_oc=Adrg6dUtmP52L5KSAPzt86uB9ciFORDCQ16SpEikIBKPld5cSK_vvn2vHqH-0WXoEYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Uj_lTb9IazFDxNsV5jEbiPObeICnZQgAk6kykCdunMg&oe=6A183CC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uraOxlVJjmMQ7kNvwG96HNg&_nc_oc=AdqBjWRLub1bjRKMV9p3VSY135cAQArevQRQa6cpmjXRx2yGkTZr1MTL0yVdH0zX-MM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_RaOJ5oFCH9d2vKervVrMSREwRM1FhPD5N8TrkUvWng&oe=6A183887"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAsQ2YQJgRgQ7kNvwGEc5uY&_nc_oc=Adp-ZFQvB1Be7c
/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDxcpqvwo5gQ7kNvwG6oUnb&_nc_oc=AdkKDFhkhuyNmnbNIYr5DoN7EwCggFNTbx2wrsvJZpGAnJ3keUBJhVnFytKnTaSq6fE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxms-K7zrCouOmymayNEfylv62hx6k2K9rThigQLziksA&oe=69B95DD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQzHq6cAXSgQ7kNvwGWvl_c&_nc_oc=AdmXZNs0roEkALIJHd5vWHcUuzQkSdUC5xTn7kJbnW2sojU4qj0j5dr4Tr0vIVD1Qpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyymjXmzilmbezEEaJKVWEj1dSvNg4W5SVhHJcCNTcqDQ&oe=69B93DE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C78RbX8fE9sQ7kNvwHwSxgk&_nc_oc=AdlmShNbmj4ioFYUB_oilLn8wuY2tT50yGQPWHfHkt4IfGW7EddwRzRyKIBxcJjFT1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyFbq4z4ROBm3Dxe9WcGtXKReEM_AERopaaK6vigOQO5Q&oe=69B95898"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBZ_-7tJOIEQ7kNvwHx_Gf6&_nc_oc=AdlLFcS6_JshEcqZsiEgGYtp1HBMqKWHs5Z_rc3WT3rqztBs0HikWMPnNNtQKuEz3Fw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyJ8btaDz1mDRAnAQ8a2SFWKmFLrSW05DKuBlsSlsbjQQ&oe=69B94D2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFN-7UW6MaMQ7kNvwEhDzKn&_nc_oc=AdlXER0hSjXg-Mse7eE_7ellQ8ltmnb_Bj2On87J7lVQNv8GZzY6ymI7PVmJQYLy9oU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmE5apb7tv05YGZSJApeeu9xELmFYrPzSIMvJSKcYkTg&oe=69B950C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejsf2cHZA3QQ7kNvwHqCveX&_nc_oc=AdnAxfVCvIXPBuvPHnxwDQMuebfCAReGvct8rrkwtKdmMuC5SyMq9jwdptDwtY1BT3M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyW3H6Dvc-0C-iaoT7vJqkiK47gyMAkY_qAyrKLaonqhA&oe=69B94C87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vK0XXfFKUoQ7kNvwG6
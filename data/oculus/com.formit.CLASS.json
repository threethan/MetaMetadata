63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66tK9wrYlwcQ7kNvwGPWR29&_nc_oc=Adq8fiJuHbyqKqLVzomCI6gYSGgBxnZurJntw8KZkOoseHZgzawBxmE6uRTe7UB-xtM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yzMwlme9lKLJCIx9yldLh-lPxMZhHJJ-b8wLKBm4EVg&oe=6A09C956"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpT2_V-aoX0Q7kNvwFM724U&_nc_oc=AdoPS_5pMR9D2noat63qW-piLmHR1-LtVCtq0khuaS-BsUTsQXOVUp0uDIwyQyIvqBU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eL0bx0t61nolTVuSbMYUP4_TWgwnTeYF2GxzrJB2I8Q&oe=6A09E1A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_TMLqof4t4Q7kNvwEdAqZ7&_nc_oc=Adphfe32HM3uoIFak8TxDiT-FkW926m-k_YTcT6wsa-y4l8RNPADwtuEsk3wf-7m_aI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fJIfrx_sEh_QIZH4EQuiuoIJzNz0PMbOIBP55OUtYPg&oe=6A09C418"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3opkryFsEHYQ7kNvwFatAx_&_nc_oc=Adp8lYRQ5fLyNNUpHflI17tXioAUdlZ-Sy_J3KVY_yxoGxyPR7KtcwHs4yS3mGzTuy4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AmaotkmsJpSPa3AD-sfxjxgGCjKZ5GbKHTB_Co9qPBA&oe=6A09B8AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E32uIp2sXf0Q7kNvwEW4kUB&_nc_oc=AdpabVUY8KQiVxQWVvmJtHi1KSYufJIFcUb0NVrPBmFfedLndroH8bVmZLfitNdXyx0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47tX0LSu-lxZ-EUJoQX3uUlnLJt8-IpBUO6KuLiBnuKg&oe=6A09BC42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw2gAnOZNm0Q7kNvwGqs8KX&_nc_oc=Adp8xod0DzPm3UET3AOwMFuwsrCI9BaItljWw7bRVeLcyRgZw9xCK-ueOAE7n1RCw0k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cQLg_NW05YBmvN57KVgZWfUUlvHj-XQgCi2CuZV4XVQ&oe=6A09B807"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1l7mL0CegSsQ7kNvwFaQauO&_nc_oc=AdrthRMoX-B4V9
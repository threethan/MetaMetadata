63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_ycY1KzIV0Q7kNvwH-JBEW&_nc_oc=AdpOt9argmiNXStgBU9pNsqSBjCm7ckOr5tXUBKIxyVNtcwCQnqvdngzspkOCHCbny4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1zoykpQYLCHIGcnLltNcpL2b-3SyPkMwBzXvpba9YIw&oe=6A6CA9D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=831ZKMcjnjUQ7kNvwGS1TIk&_nc_oc=Adphj7ekfqjkTRwB8ysyaGtFx0FTWNFKjCVbC9yvnkQDiWVAP2waIAgiBfBdbkvaD4g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN-Q20V9TY50tkqL-POL6d2WeOoJmgnuE-5Sq7sYr_Ag&oe=6A6CC222"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_SlRcxSfFAQ7kNvwGRoTas&_nc_oc=AdrB8AWETyQZkIhJufOG3KLNPzCXp4_zFn6dAeFN2iwdq62joClWOpidRXa-oBjFCMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABAjvcDYfjJwH56fCDvgk_LZDOCB0B3ZdNr8eA7tqxMg&oe=6A6CA498"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ2L0EBoebMQ7kNvwHKOshN&_nc_oc=Adom7XPAvqGcCsnk1eFcbO5eXj30as8SmOR9LzisxEsEwn3jWiFqLApj9mm0XcQ_A70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf9U2oFAJtfprsIJDJOFjsMqE2Fnh-LJRi_ZcHtjDhuQ&oe=6A6C992D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV3JuPp-RFMQ7kNvwFR6wjs&_nc_oc=Adrq2g25MTrKNrfVqRFE4aTtKWaMRomW9KllzgxpwpBpFY1TTALKgXZlJxX_s1b41wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdKRGFD7UaSmxo4guBOlXxNc9NBZ-MfQUhEG3U7IQYEw&oe=6A6C9CC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0Qotz6BHJEQ7kNvwHqrq9F&_nc_oc=Ado58VLcROOiGPuvHheQbR__MPNRbanNoFaDRNCcMCO2wj0nYN4ppKWmBrkkVCi1ra4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYA5UrP_Qn6aiG3UkUOQry4DiUDaWOq4astRAcIZZnVQ&oe=6A6C9887"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BxFoAXuu-sQ7kNvwEczWjU&_nc_oc=AdpQZWCnWs2T_s
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYyeYIV5f70Q7kNvwEqBEec&_nc_oc=AdpmE0kisq1TkSS5FqzGebdfnXTAbcjJmxgBRDYo8HgPCsBJs718XWCV7F5uaJbPPUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKERTayq_9voXmQrIS4JvAjq1elnZWwtTKVbnJXI6Vizw&oe=6AB137D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WWwVAjPWcgQ7kNvwEhjxuo&_nc_oc=AdrqOLnn3DLhsKoEa1OBoKTGhZOs8_Ws1Om4SsMC9x1Ilk9WjAgbzaOge6ZmaTEtc-8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQnU77RNWiqj7nDqD5r1CjJ1HqUaiEK2HeXXNUnyY9vA&oe=6AB15022"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djrzi24RBf4Q7kNvwEB3tcr&_nc_oc=Adq6nqeT4hNbo1035oq-eJ4611dPR3zy9TywyPWs0K8UPC_jFgo_kez7WUkkNJJ4OjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdfP2o8GoandJ02QQrpVqmSE62CGp5aKRz3x_w8E7wEA&oe=6AB13298"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkj0a61I_DQQ7kNvwG1hech&_nc_oc=AdrjBJUXf5VJ-v_LjDvapmy7-JfOSND-rpxJb1NcbslnfCYO_ar9bImvsRoc83TiLwc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMUeUazMnZcE0I7NqUx84X-UYYg0xwwKQNPFrjSbDFhw&oe=6AB1272D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7A-8Lcf0J5wQ7kNvwFyFCm3&_nc_oc=AdpO-D0nYpuEbCiMaiEoEk67_Y-2QrRxuyL89tBkZPc7c9wsjT0Ru5YyVS80d3KUD0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMe6VXYZYg0hZc2D_wQnsWBmgVokV7azG44Wn-tQ93rA&oe=6AB12AC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_KsKRq_5D0Q7kNvwHfGiuz&_nc_oc=AdqqHPIxbDti1f9_jBMod15NfLX8ZZodVp-zAeBsYlbt-CMTHT4GJhYvefjBe_CHIVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMUqZD2IQE7InbppsnweLfAyH_r6vUTDUx_hF1RXVT1A&oe=6AB12687"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEUJ7HYB0BIQ7kNvwGTxJfn&_nc_oc=Adpn8vo4sMiktB
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxjgMpqPdGMQ7kNvwFExXwM&_nc_oc=AdpmFn7QWFSpZXrInh7d1NzD__rZ9RsUxUsDmBqi14pF7kXp9V5h8MXiSQVV1OqTdPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KRzMC1fdyTsG3OIwMf7eg41ab4SCuB4wbPxBNjFEKNQ&oe=69ECC856"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cMWF6f5bA8Q7kNvwEhP-NK&_nc_oc=Adom1pN1C1b-ENUwHOXMFYCa_zjX_w6Q08fZRnMIdTIFjmRlQkUAnf9C_vAzNp3DPUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EZi9jMUe3qL46R9qsahvsZd5decqUpkmzSNuonxoiYg&oe=69ECA862"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_YAKy4nnUoQ7kNvwHGbxBf&_nc_oc=AdqgYM0D4tiZj2g9QBCauTTJelHU1PPa9xmNu-2AJB6wgd3aQvIelJQHC9UluvnbxcE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3R7wmMDdAPtnjx5a3jVVlqMFSdsSPdK1_FriFhX0N72g&oe=69ECC318"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRBB66XKUG8Q7kNvwGTwzBc&_nc_oc=AdrCLELypGEx4ol-k5pkhooX2ujoeTFaxSFXFAGS_oyt78uonJug9Y7TI-gGqBrGzSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dtPrP7jqh-MMrpt-GyfoGDAeTTBwTvbC8zt3A3WCESg&oe=69ECB7AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2Jp4Oy-KSIQ7kNvwES9SKy&_nc_oc=AdrgOjjd-VT0t8hoBhUugjntbNbj9peTHmZeB8Z5bngbfAioEs5h9L_6A97ZW6PnBOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mYLOgB5hreYQGyhotHrQ-eVcgxupQiM8SrClDEsRCjA&oe=69ECBB42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJtyzQuLdlAQ7kNvwFD4oIR&_nc_oc=Adr8kjHoV3CPku0KPd9I_Ny8F9B9fqSmqcrsQ7ID5zp6Z77W65535vO76v8LmfC5PTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af054ESkgu2JmSDmm9EuZfdXSil_GfnL1VnB-eqa5nCT6A&oe=69ECB707"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlgZx1wdvQ4Q7kNvwHs2XIy&_nc_oc=AdryEFqYLO44Ol
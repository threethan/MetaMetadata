63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKGM_9nRdG0Q7kNvwFH4LHW&_nc_oc=Ado65ZapuuXHPc-EwM9xnQ0Yah9yZj--Z1kYZGHLX7MAxhHCEqr5L5wwp3GT13rTryU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AumF_QdcszfTvSM876jHMkX0BlLFJHKZaNPJz5J6ZlA&oe=6A2D61D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOgNmxgslEQQ7kNvwFXJr6r&_nc_oc=AdrkUPDwOBLQ_3oAlsr-txUFUQWNZnMgOAvziB3VyexW5A37P5jjVzp1nPDiVAEMBgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VrsSsP_h6SolYPlf8ngA3LA20amUfUjqL_REVo8x_Ig&oe=6A2D7A22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwkIhx0QTC8Q7kNvwE4C2rZ&_nc_oc=Adp6-0LotbHc8LyyrfJfKBv9Ag6rc48m_I2K5TlSDp2wCxtZh5AqHBJIKazAk4lEMFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7aHjJ62yMrdUK5aErkjNUR_gOnhjkI1LGrG-fpmtg5A&oe=6A2D5C98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnCgtpE7A98Q7kNvwGhs0T-&_nc_oc=AdodEQV2fL6m33H55R3W5nZ94fTJmcXP340KSAsA-pTFvGSQRRbieoH4yuLn23OL_mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XA4fsMuhOsgQZ8OnKrIAh95Li6xN_gZ_hp7YeNJkAGw&oe=6A2D512D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq1j9D4LRo0Q7kNvwFliNhs&_nc_oc=AdqNn2p9v9058mydx8K74zbx2TN0HWIj4cj6ZqURs6kHAWv0Bh4XSpmjne30ylX7OZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bPD2pZe-ZAf8PNVcB_cK3k60yZrbTYFoVHqb3554dLg&oe=6A2D54C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhiRHfuSMWwQ7kNvwGUt8qA&_nc_oc=AdrndZjNrJWMzCvM6aNczqFAQVFcYUayBy9tjC7X6eLhei3kEJgJlaDKu7BIj9kXZPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SKshVfEPNfWSNIgLBDk6u46VbMOB5XnbYGcPHShnksw&oe=6A2D5087"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61cGL2o2XowQ7kNvwGNQS-f&_nc_oc=AdptcLichteaAF
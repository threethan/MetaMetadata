63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqRQDVjSznQQ7kNvwHRrdi0&_nc_oc=Adp7FxXq-dds1UFRngO-gaIyjfCRCnCP6fSE6unZIUmtfcNFpqiIkc5G4t5LmFoEFwE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUbTn4j8W3UqfBKr3ka6BLefMSd2hs93Ic5MAkNnuM3w&oe=6AB67DD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWbGFJmKyP0Q7kNvwHfn_Q4&_nc_oc=Adru4I2G_ekXW2xC_YO_eMZnq1w8SPNqmD_qRyRTIHCr_2qS6vmr2jYrqkR-vbmkeh8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLf2TxtDjr0QZXlrm-0UW5-7p6TnPlIjn8XbcNlsz-iqw&oe=6AB69622"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scqCWU8FpBoQ7kNvwH-7NfB&_nc_oc=AdoxqV3MNUQuINTwxRGHRQW4H4rHAc3upsC7NgyEDXj4gmyBfRSl0ODW7j7sBQy19UY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvU2w9zBuYeGXm6t1G0uNWdG3crrI12OPjMcuECJedMg&oe=6AB67898"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JexsVOpHaEQ7kNvwGQYeFF&_nc_oc=AdroGyc8mtJUwq3GXPeIPNV0JGJYxSzg5dBxdMXTIk6zb525jpkvm_iQggJxf6rwTdo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZQQlq5LUtI4g8A4sGt_Tq11Ra0QxThGnXMXRpYFrg2g&oe=6AB66D2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvYZ8qFP7p8Q7kNvwFEqOPg&_nc_oc=Adq8bxsoPkgiPWwXxNhEci2v1IOUHcQFHE0hmKLdoXLUfIjaQ9dZLSdfpRACdAssBe0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSNjMLp1T9rg3dKTnHUD9ZaKDIQ4i8TYk1X2i6_WT66w&oe=6AB670C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuI90V7wDV4Q7kNvwFxdwDN&_nc_oc=Adr8y20Fqu7Yge02Zq-rjU9-XyshzH0JQ3elnLpEYmbWxWC7-ZnAn1KtAdniTTRe2_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0Zg8xAhFpoXf8fbEJc3PfU13KY77Y5B6W6ToXfPR-1w&oe=6AB66C87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sf2uLnNVLFgQ7kNvwGnye1y&_nc_oc=AdpviUd-RGnYu6
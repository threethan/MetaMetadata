63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJKeYs0J8CgQ7kNvwHkgzgx&_nc_oc=Adovw9QKfNc1osj99N1N9LalK-M-0l0fvcqV84XFfr7GJfGicJPCe3Zy5VLrgCRlKwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG3jWiaszo4a5JAuKJhjWFq_5wFGGt-vCg2-tBpNCyrg&oe=6AA55A56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjw2Hy3A_ecQ7kNvwHlOiuO&_nc_oc=AdqSo7bk5_FhjfJQ3Kt1WU6AWklDGgVGLyBeEvCV0hJSM8XZkLNT5ZU8UO4di7dG8zY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqKNHlyaAnxFlWxvYj5qz21l3zA7xFp_ONcKaTtl5irw&oe=6AA572A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZfFFd7KOscQ7kNvwGMXYm0&_nc_oc=AdoHq8nSFt31jhVMcprrm4rQk6JTRAe0vyvBW9EklXj-GK31M19geZeuk9TYvwEBCDk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3s56_trWKVXBW691Vcc3_lkXVakg8X-mTouiI-wCDZw&oe=6AA55518"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5S8XQJjppwQ7kNvwGrYvQk&_nc_oc=Ado9CIpEO9-bhO79IwBKRk3m43_ybvApnIkzNRruzJEHrYiCDaKQ8E9j7ndoqByrmIg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI--kQBVAHyjiH6MVDHlGXAIG8zx_d9biCBpjsaRitPBw&oe=6AA549AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMw5T5aA4IIQ7kNvwGGjKrN&_nc_oc=Adrluhpad09282u1xZwb1Cq1xVBqXdGDgiFCgAtrTnLdCjx4qEggQpfh3ma2ESRze-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIC9kdKJ7BNvCdITxT2CN86QQ0-iu918n4WclW0Lgf8MA&oe=6AA54D42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrjaRjlcOgkQ7kNvwGWH6Xw&_nc_oc=Ado4WJiJ2kjzppcGptVbWp4D_hzulPY2mQltp2d4I0iIWi05tjOqVIpGpuDhvNFQFQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWlItf0YXW_wYlo3qtAM4-DtE8I2HqsJOCWGK-QUgPhw&oe=6AA54907"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiqXyM5TZ04Q7kNvwFr33Us&_nc_oc=AdruEuATFY6py-
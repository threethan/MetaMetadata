63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-cHyLg4s3QQ7kNvwGG5Ns2&_nc_oc=AdpfDuVxp6plVKyOU8nW2Rm2PUS9V1dg-3jUyhkAMDb79CfaLbHKp6bj_6qseJ0RINU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI6oRw50MEtqrUSl6XuWeNIMGXPLTqE0UfC4cp2acoBw&oe=6A734156"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xr28idbBwpUQ7kNvwGn-1wO&_nc_oc=AdrIpKTF_rPnNNEnwYbJfdHQJTVq_xnkOpUGPXBD_FcXa_QA5Ccr8pV_EGG8-xW-wQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcYl3vutSw5knx8y5c6q86jNlxShW5dkMNCi6KBEU5jw&oe=6A732162"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-MlmFvquocQ7kNvwGDxLNO&_nc_oc=AdpZPso9PPt8jQz4OQZT5vvPQXLsLzn__epGt2AuFTyNG3FvscHQeJV3LLn1KZAUp7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7RvExhOUd3ZsyXXiGIpSBHxZoO8f8bg3MgTOOipQD1w&oe=6A733C18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwrWZlT3i8AQ7kNvwFCtZtg&_nc_oc=AdqHfbDHrepKxIPBq6kjIK7vVtfFWssO_OoD-43h4FNnDH54Pvw9h6-KDf6IquGeVFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx2OFwri9Aw0HCj7cXH4yPYjhs2D9SJQ6LthilEUmldw&oe=6A7330AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KBkFOTPFSsQ7kNvwEhxHFO&_nc_oc=Adpp7YNOBGUE19TUlXxpKaI6pLMGy9_E5NhWi-nmeXYes_pacVBp0MAE2NnU3K-X858&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0O1M77gICNX2RdUZQs2oStQYfwAgsPwvX6n3RSAjaPQ&oe=6A733442"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMk_KwfslugQ7kNvwFO4ccL&_nc_oc=Adp59UEzZpaFt34JY8T4ZxfuaroIHIa7qMF01lRv2suoV3XZBcgeHlppHukKdDY6TVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3rb0zWY1qQU4Xws4zHMyGNwq4ulqvybNIs7HtAsHtuA&oe=6A733007"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rczsg_gH2z0Q7kNvwEbPEwZ&_nc_oc=AdqH6nmEcizM0n
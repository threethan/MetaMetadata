63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK0XJQvFmbYQ7kNvwEAonAg&_nc_oc=AdqPdUGeAnYWf1RDHl73EsYMCNHdxda-4YjAU0t8xK6_0SUEQe93QdOt6n60JecMeHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl4D7htXAMcaBnaHaMHdwmEwlEeHwwYok9tqWtHZbv7A&oe=6A897296"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_gtVtvloWcQ7kNvwEG5mOE&_nc_oc=AdohGW_buZH9IAug9OuMbBCICauQE7HQrKOoQ-VpS_hto3art3ipcJBVamgDmUrWppk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk2SR5wwI3Bih7BLzCl-NkrDaaOLYJn5xEf5-e7d7uww&oe=6A898AE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa_fKCcMim4Q7kNvwEtfcZD&_nc_oc=Adq_g-NqW0gFZUOw_G4cch_-0JMweKF5O1NSRwxjNGn_QI3LRj84Uw4j46aReACi94U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFUmXE8WG50upFUnb5Ocyzp9ooclal2khEikDaqe_ovg&oe=6A89A598"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDSfbHwI6RcQ7kNvwFOCXFm&_nc_oc=AdpDr7LGyzCdQkxJPgAkKIta7qlWtyMjAM-Nz8KaUCsJmicXjLduNt4f8rNCXzoFj9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3tKpK0kXCpIoUBHSewE8vnhphR5Xo8Wuok4PeQmX82Q&oe=6A899A2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcvTLL7VEJsQ7kNvwEPIimb&_nc_oc=AdqeX-N2TW0let4b5YuzsNwlX0CexwsivQZdlrzEehgpc4Cz-ebgqWYkPrRZnZTKiVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFazqo0tswf0rHNseUa6x7tVYecYnPXCuGv4EA3dbyjXA&oe=6A899DC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4hpiHvlYVAQ7kNvwHOnXmt&_nc_oc=Adr6bs8ESpWixXJAWzIf1kjTcSvlo7BjoRyEn_n9YUvNttmVEW0R7j6rTF3B-mAAHro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEiCE6erq_kqcoI_6NoLCH35IIODs8_HsHdNKJ3HqnwA&oe=6A899987"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eboKaUVFnqsQ7kNvwFG1REE&_nc_oc=AdpTQRI4zcASez
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERMgr7KhJQMQ7kNvwGrvwd8&_nc_oc=AdroIHBBhFuiHjkiquv9IS00MFp0WUAYm9PXY434p8dYQHOb0pk2q8u7TphFsZ5cUdc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3qUgP9aiTiqBxgsbZ8WbJGViEA6F4WfWraNZK-4B2jA&oe=6AE5F3D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5x10ZASi2nYQ7kNvwF_ab_r&_nc_oc=Adq91OKMHxNQoN62ZxFLlr4sKyb79siutW2RcVyuu0cTtbcKebttpLwZJYiTWjIpx0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPALWOFcLNKqUBF-IE6ZqCBzrJdbnN1aPhduoEzPH2sew&oe=6AE60C22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnGRZ-Nb1JIQ7kNvwESZMYV&_nc_oc=AdqPG6ivBN0SaJfxbXCAi51q5w5xoe0eAM_LxSMzZ4NaJ9TnYeVrdea_VvY-JV__s5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBRr8QswitrUeXSDgi4DdAhnPwB7ssimX4v6FsHPMUog&oe=6AE5EE98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCS1JUblOcoQ7kNvwHucROi&_nc_oc=AdpZa6B5Qyhjs4UmXVx2qjD0jXS0zdTspH-6Ao7olvQ9nUMoLbZc0wsrs6XIYVD7Zk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOq6c4H0Ae_lDb0GcMiZpaVG476ARHHgcQegU60r86w4w&oe=6AE5E32D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBkJfYtbs8gQ7kNvwE-5Cd6&_nc_oc=AdrEWGirLqaqlp6YpcpjhlEB9p-ta0ATQrSa06h7R-xg_EPyU6Q82aDikFFyNpEKsVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfxNmrpVzpwjBphhekRU2rF-voqqP36K1zj_sedDuX_w&oe=6AE5E6C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E30UTx3OLy4Q7kNvwETKIM8&_nc_oc=AdpFkl_bKZRH9ZqodhMRCc7aQFQ1U8R1L2B8sQ_aQIxuyfRv_jRFxaLnKR7yHkKbWO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOT53xWHNkhv6xTs7BPjCaoZOtFpZQFUlHDeUP-eZ9THA&oe=6AE5E287"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKJtm0cgAgAQ7kNvwEUFRrx&_nc_oc=Ado5Z8XImz4vq6
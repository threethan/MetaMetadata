63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsK2XpZitvwQ7kNvwG84rbq&_nc_oc=AdoGTqM1pkq2YFv1LWr3f5odWL4Q9Sq6cduQdTw52ScRXQ6NRiDjkvmzOkGcQva07mk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5avQqvZIHLNB78SIYhq3-oiG1UE8TXf-zUExhXMyVnJQ&oe=6A01E056"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AyGuL37y0UQ7kNvwG8sAXo&_nc_oc=AdoaQPLZhn7cjsZPxDRi0lRpWbH2W8VG0HPCWzZdTO7ZZte8JZckzvVtH31Lyobnp2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KcnrJVoxDKc51U3zzHrNl97xpQBOQMHj8MRxdtU7K8A&oe=6A01F8A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSrj2_hXddEQ7kNvwHHYich&_nc_oc=AdrTMXLVSeqEK9AezsBnFvZ3BRn6HOrNBjN4GJrzjvDSFlioLqFuP9R0MrpdRAZ88Qs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KH6IJ8wmAQb3LirNH0O08x_YgkiPiLHsHSmLCoI9atw&oe=6A01DB18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4P2BejNoCsQ7kNvwEEcw0D&_nc_oc=AdqeJoh9RL5i2vLUmqtAFEzb91caDK_0hfEIXCOhxJkjsdH-hTN0UT8e3LxA1e6uGKQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nzy2FANkx8akOeBhu9jfbAGjo7ilef5WZM7DsnUlOnA&oe=6A01CFAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_x8OCBgJwEQ7kNvwHmahFo&_nc_oc=AdpYo1mQO3JancdNYfPHNpRATSVAIi_qeqrK9IIOCEeXJnRxSIfsHJ4NjxdIMnRMGZg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XfmoS2Ks0oVJnzqwkyUOhj2D17PUbwY20oGwtiKxUzw&oe=6A01D342"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuCYvrRaykwQ7kNvwFM-m7_&_nc_oc=Adov-2obQvqOjHuoS81RZXmKGeUI_hR85EBw4ie2S45dMy3yiKEdefOMn27QCfjpoXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IGwF6Y2f3lCzg0OG6Sl4qkqc4tKn3cQTGW3IaYumCbQ&oe=6A01CF07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dYoWBSVn7cQ7kNvwHaGAh_&_nc_oc=Adr7ToSBVw0B5W
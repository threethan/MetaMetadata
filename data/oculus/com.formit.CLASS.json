63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMuOgSu540Q7kNvwFCcGq7&_nc_oc=Adqjw52Y2DiisrzciY7TVytw93_6WzP9x54Nh_sOUq4VGK9wX3Yk6gdgQS9-Tq9MzGM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vVnCvnMamyG7khE5BovyxBN5NInfY-kwEANC52G3f3w&oe=6A2032D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEERzxGb5PAQ7kNvwFPkooQ&_nc_oc=AdoXYinN_5S-8mF6G9BgtbH-qwXYKtJcZAvICReE7_03NZKUQyBqTBaLnlmXnmrjKmM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ukaaM3FTgIIDULVW20_JrdIGtxeJC56ZKtNqSsQHRFA&oe=6A204B22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doJ2TZ4Rki0Q7kNvwGcIFgO&_nc_oc=AdrzcKF6hk2tAMWioakIAFBWrndHMFVXxAi0HB-lfBqP1l-Wkhs1yyzUyeK4OHlO_OU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LnIjlJeVt0e0mpsmlrwLR6mwK7em7CC0YKrQ7jdYP3A&oe=6A202D98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIEwT4QNOGIQ7kNvwHo-ue9&_nc_oc=AdrivM5IXL6JigfiPgcdRLa1H7K8NfCovYnLd-ssi5weQPG6SG70E6tUP4cpyKRDkmw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-7DP5B-IRKEZ1qnLkHZAVMJTK9U7CVgGZXKHcLXWWvg&oe=6A20222D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUSs8JxSyygQ7kNvwHelF7y&_nc_oc=Adra2HAA1XyW2daIqwjrRE2m9d5UgODDtg6KTHdmvS2c9GvSJU6dggtZVFdAvwoa_Dk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51eEjVwzavrvrlJZaEm4AzSUUyCqvAo2OliVt87t0f1A&oe=6A2025C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MtOrm_eqU4Q7kNvwGx3IaA&_nc_oc=AdrnouuGwPKrhuORr-aTxHWiDarS4c08RNsp4_MmHgKGn0NN8ei1Ox4fyp9hVdEqjFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OxktloOtlbkt654_kwPKIIDq5BjCs2BYIcqUDPp8RpQ&oe=6A202187"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygfWDPNC168Q7kNvwHSIUXD&_nc_oc=AdoV53nLWtUG-j
t-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4ReFFwq0SNZBLSoYUrKBADzG4VFxTuEvcRa8wTKPl4Q&oe=69B02356"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx6bjo8a_3YQ7kNvwGXdTh9&_nc_oc=AdlUn1oAIKFkwN0Y1TeJoUeCHU-JXckfbhY0rZGInfP_vQId3gHqCbDbtNZWRZSGVl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkwsUpr5SV_H_SH2dqMLfN0D9s-4rlenywKFgkxDf-4A&oe=69B00362"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEf9H-zSm9IQ7kNvwFwNYzy&_nc_oc=AdmPAOAh1lGwrLjGRL6FjalCI8D7zjulPoYAj72ElQuYVPktFAppP0FCLnnjeqZImCc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxr_jkJi69cTwlxyhSVhwK2p8cgckkHfvylUaQvLAUrGQ&oe=69B01E18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5UIFeRqVQIQ7kNvwFHQjlQ&_nc_oc=Adn1TA16UAf4BWRCfExQ0FZh2GAgcZ6slT1749W52ru-RCuR-3Z4Nr7Wn2oeMRLpX7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzB68fxqLd9mPsRvJUdjX4RecZoWAyqv_WuJD3hiCBBNw&oe=69B012AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAlhtLV_dJoQ7kNvwHIUEg9&_nc_oc=Admo6Zi4QIJTxRZoQbBSfusmJAQI2kJF8LADoMtSAO1no5MOazyy84ArYHHdOkLTS5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyvbij_rGQI8fEHAB8YmGe8-rgMqKSVBlEtKNXv-sbQBA&oe=69B01642"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbl9B6qEP5sQ7kNvwFftIGH&_nc_oc=Adncz0eIspCloSYfM43J7FNoSFBDaxoxX3liRohvUDhP3vYqOYgRX-2U2zfgqdGlbFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1e0c7gygCqY3ZzUFc-rkKsgLza-5ICVoiK1ui4WvNEw&oe=69B01207"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y7Oic3YfP4Q7kNvwEG5CvJ&_nc_oc=Adk1MM_WFReD0rGueL9Y4S4kmKQs-SaA_U9K91SNQcZLE8j_X1hcxVMtz7Udq9riPho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxwacoo18VIrw46exc6Go7TPwcfhtQ8u4wnY5JaknO1xA&oe=69B01FEF"}, {"file_name": "Progetto sen
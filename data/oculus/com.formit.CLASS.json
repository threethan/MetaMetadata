63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xn7-NvNGZUEQ7kNvwEcVdyJ&_nc_oc=Adot6pU_OCmWmOybAu2Zl2uRn1Xc5Ck2HEv6DFQau9505TDog-XI5_nhmPntbOoNDVE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CK67avOd1FRuKWox0L6NSJxCD3AmfkjtKp8Y0cSjjZw&oe=6A47BFD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmfDxQgi9sIQ7kNvwGsyXqX&_nc_oc=Adr-SiWCJ_ukspyd6W38A2PtJjbWLJwjzX6FR5giy882Fxzy3TlePli0Zdd8DU4kGtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XCR_6a4EVEasnMM1lINreFwnw0Rh0Isse32Ox0r-FvQ&oe=6A47D822"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_BOoX1z1VwQ7kNvwE0WdLp&_nc_oc=AdrqckL_aD95iNr29OB6EVbGfY141MPqEJsEUJxzyVAi_vMxAvAPuHwIgVDDiQoGWqg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8x3MGuNIYJ9kKs1nJySl8h2RcvBmr9xnBX4UH1E8b44g&oe=6A47BA98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5OukneuRlUQ7kNvwG5XxX2&_nc_oc=AdpS4jsPBm_wYDkeuWODLIXPd5eMoEH3vRkxmaHBqBVl7ZAtl7Ua5hFy8c2yu6hzyv4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FFbCXOXHJmiMiyRuz7TICYRJhCL2NcelIwPSrjUoAKw&oe=6A47AF2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW33BsCgQokQ7kNvwEd4vkV&_nc_oc=AdrgHrw-mmU90FqG77Itb2QustfD9K3iwOF5VHmduhPaeroLFvS2VlpxD_1b8kyOI2g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SK08qhjC9TlZz2DZ2eAy3vysu_ydUAhWd6y7Dt_rkoQ&oe=6A47B2C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATwRguncGioQ7kNvwHlmI7Y&_nc_oc=AdomosvgkkXYaRugwTxZxHcMT8JRR42usPiTkks3jSutATRoC-HHSTj2fVtK32E4veo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mVo6XKVOcN2gunWVGJXPUJTgVA7FxVAzcY0D-JysRaw&oe=6A47AE87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3thPyQVcDckQ7kNvwGz9l3o&_nc_oc=AdqtzpUzxtNnCZ
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnnYsWNRakcQ7kNvwHfjDeQ&_nc_oc=AdrRS66kYtHbux6ghRGvCoDXg_A99-axYfqyA-GicJLu1WTdUPHi8GX7Y9ZAsoCms6o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0JIwn18_GRsefoiaaNwr7XEID0n-ffCv0-_zHT_2GJA&oe=6A4A62D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHp7X6UkDKUQ7kNvwFWsOdl&_nc_oc=Ado28UUqBTksbQl8KfYX2i98-tPiCt60gLt4JMfptVOQBtq3C7AvRu_WrCIdcOjB6Hc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs6JobajtYHgVhGckHNE5DlNTCxW-yMFXooxgA_de3lw&oe=6A4A7B22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_BOoX1z1VwQ7kNvwFJrcT-&_nc_oc=AdoL4_erFsaeNa1z9TEqr9nKfGhNcd8EeYtqkXShl0u8wCBkH2mQYr_onWPSZANLRF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuJkN0Y0_34IHb8rKC53MPI5AsbvAKF0JTRpdpHKu4Xg&oe=6A4A5D98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5OukneuRlUQ7kNvwEyZ6N6&_nc_oc=AdoR8TIl-NBhi2Il8qJweTBCCW5SBUt4TfRBxim59KlwUH-6WA-rJshZsh2GweV76L8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_Fw9ZQSo4q7o05InD9dIw0VxEBiH5_dSppQU3ES89OQ&oe=6A4A522D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoRqoam2N-QQ7kNvwHLe6bW&_nc_oc=Ado25Tgozo_KByGdsqpt9VbrWK5vrs_I6t-lyMEdAgWKSALAfBpcgH1-_vOJ6f9sOaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADnxAhVw0mrq3NQWHKF7ZPizpHJiQpxcaURRX3g27djw&oe=6A4A55C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK0jvH8zG38Q7kNvwH-qHM4&_nc_oc=Ado_sHfHj50YxkxVyyWKmOosOvmmWDjcdHTWMwpj1zPq2rirzNJHaKb49KLwyUno484&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV64WUB1A_nNtAh0blTOsRQK_TGZhGZGNoVpKIbVk6cA&oe=6A4A5187"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfHNbiZX9c8Q7kNvwEP8G9u&_nc_oc=AdpIFn3-Xdy6_f
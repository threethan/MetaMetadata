63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK0XJQvFmbYQ7kNvwHMxp5V&_nc_oc=AdpRwp5di_eu2zA34yqVBNmZBtC2GpYRvaq2IeL6E4i_AOl2ENpWMGAXM-NaVbEfvcA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmYinHSaA3S5fiN-Ey9moQvHmhFzCmxMMyuC4iy81usQ&oe=6A882116"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCW8EkvuZY8Q7kNvwFIjry3&_nc_oc=Adrdg8XWcV_eImH3UUWnsnOWfFvGYBX0pEfOgKoJVGKUTKCZ-3DxCYUxR33aQel97wA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMLcGEuFHNCnpJoFXD7GEYcdmCgy6qsUDhR_N_bY31hw&oe=6A883962"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa_fKCcMim4Q7kNvwHibCjc&_nc_oc=AdqJI2LtC5j8rCitGKCkhsO95CKWEnBfebgh_WtoHrw-misIhNK_mij-Lh9uRjIsf2U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExPALpVI41aXw_1cgh9uvJ_LpajaQ2fSczKnHG4e8p8g&oe=6A881BD8"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDSfbHwI6RcQ7kNvwGTPqeJ&_nc_oc=AdoaVcRnin7i0fqGDs7mkAH7fpXruBmZ3lAgl-yRQdHcIpz-G5GU49clAiZfHscI2aU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFfsC3HaEh2FSpDDEFFoC_SBWdTVy_msR0Pv93EGnM4A&oe=6A8848AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9OoCfvlGAwQ7kNvwErMNXP&_nc_oc=AdowzeTxbstrKnpxPMscUIX5sv-pD3tp58-DVRM7SswB-Ys3qduUNMacsv0V15-Spnk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwuqCq4mV37-p83M_fn4VY00nrD8I6t2DxAVjaRtK2gA&oe=6A884C42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4hpiHvlYVAQ7kNvwEyXQSp&_nc_oc=AdpjqgzTVIb_qE29NKxcWaR77Oe-pJhVm0rJXm2QTmhhLWJL9JoqfOddE3_7HLqk5-M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSL1JeVFpAgZsfyZeutgZi-0SMd0200W2e5UZsYll9lg&oe=6A884807"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-8Fge3OovwQ7kNvwGZLnPu&_nc_oc=Adpe7nmjTjHeBB
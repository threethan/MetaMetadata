/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eG1ftGHmS5YQ7kNvwEP_HHi&_nc_oc=Adk1SrYBhfAfkNP1z7KzE6CnjyH8DELOlryn-EyQEAnZtC7zTF6MATwKfcU-J5lL5ro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxlD7mIvEa56ZGwVtd1Twy4JylT0C8EUsXTRwyVzz_6ig&oe=69B2C656"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx6bjo8a_3YQ7kNvwE4erc6&_nc_oc=AdlAY7GJ5jYsjU9cbs-FEcrbZ7KhBGJegy-RVhhxKmP5FqJ1bdfRX1nCRmiHdN1o2_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZgT--MH4RyXqgF39x69HVXQLkEv4PVi3ZtkcQRrtohQ&oe=69B2A662"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw9rPC2L3JcQ7kNvwF1uif7&_nc_oc=Adnu5l814acBgp4cFFOWd9ZdvWEUElYIPoKjy6wwtWVlCFJZWsN7ngEBGWroww1Afb4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzX48oIa301ifin0x7Eh6_ONrJaXfB4Xfz0GTMSCBfW0w&oe=69B2C118"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_A8RO1hWJlcQ7kNvwFfmp5O&_nc_oc=AdmmZEEDs-5nx73e0_v-A_GAA28GVSiSJpuIObG3MIcYyXz-11l0TcIlk6e6g5n4ubo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfykLsR8yQJkUglotrq2oHSGocaHxx7x3mhjJEUATNitsQ&oe=69B2B5AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAlhtLV_dJoQ7kNvwHtStgs&_nc_oc=AdkzjFE6NAgSDyVboLnlisGjWP3o1aX8FhTP0IeZTUQbCNrfaVlmelGUwZzZ5932uEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsROw9CGdrTq1zD3S4-yYS4x4RBEll3oOyRRX1g3mT2A&oe=69B2B942"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWbPgLFCOsAQ7kNvwHtWFa9&_nc_oc=Adlv_rI3fdjbEgL-k1hVL4rVE8SsP472I3HArfrwzEGRL-bcY5IZdLdKamQ6Ug3eIls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwz9v2Qe1XtEZWsOywAnnFcfBfjRSaWeb6aHHl3GpABDQ&oe=69B2B507"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y7Oic3YfP4Q7kNvwEj
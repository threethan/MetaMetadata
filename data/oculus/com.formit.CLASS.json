63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLjesZ0sXM0Q7kNvwEH5i5k&_nc_oc=Adq3mVnAAKP5RfI_o_YIt2NWa2KpWLYHNQo6jb8EeFiE35IU_sp_xEn_H7vMqjDNmg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnH6eal93JYhoeu6mQmoc_RSpDPciNyn4Tk3PzxrK5oQ&oe=6AC3ACD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irBAlw1LtT8Q7kNvwGc2Y12&_nc_oc=AdoG8gUaVyAAYE_01NN5hfkgs4nzxmLmoicqXB60oq8F4emNqbEdJpU80VupKqT-Dzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuzDbtJexuCTeCinzKRh5_zPiRnqi1p0-uMrkRtfetdA&oe=6AC3C522"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCKMxAXKzKkQ7kNvwEyNRs8&_nc_oc=AdqH_6Jw3dTJqf_HkRe76c59xaUqIRhFaHKvVnca_sTjaoXwdyrm9ZGGQMKylb4i9LM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpr7heC7_yB2vXg04Qe7M9WmoDRzWORGC7T6Zws5gAzw&oe=6AC3A798"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6QwwwxDOF8Q7kNvwFcR2uL&_nc_oc=Ado38bpUggnTYKc1-sDozNt7doEYSDXAzhRN55doCFAlJMORif8gi_xuG-KXR8Q_SQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqTY-_RNXMQdwiVu69spnhaMd613X6oBRB4JiKW8jCeA&oe=6AC3D46D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFmRm2OkBg8Q7kNvwGTThLf&_nc_oc=Ado-T1ufuSmstUK7YszsTrWn-bCtKNn0y515gobVp3j3QMa_vgfHn8EKFnjBB8Wzyp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHsJT2Yvxsx6UmfH9tJYBIpoctngCIzp_9WU0uUPmqKQ&oe=6AC3D802"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26YRM_E7198Q7kNvwFsdket&_nc_oc=AdqySYg_wQhPWfVlfjw04y-uSpQcWxN-T6BMfpGx31zJF_Yt_7kwXN-paffEWhTTQto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOn7I1ynkb26QjWQ58_1VoBPwjOs5XEjS0LYobliuG0mA&oe=6AC3D3C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtHB4vn4j2AQ7kNvwF0EXpI&_nc_oc=Ado8ZpCXBjOYd8
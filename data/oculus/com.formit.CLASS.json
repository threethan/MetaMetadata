63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PK4pEwOSXQQ7kNvwEjhLFY&_nc_oc=AdpcKHtF8_lWfBG9f2OHtwIvFvd1R0vabln7DfamjQFWHSf-3ioI-t91FYJ1pt8NpVQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbmctdv54gSPBI7rmx4WqtSY6qGEhBfHDd6EbRAaPjmQ&oe=6AD3B716"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQdqZLw5FecQ7kNvwEjnzDc&_nc_oc=AdrBl2wJTGn96NErHlA0_lUAgeKGsmozih6aA4dNfqjqZwNBuFa5eNcIDr4i7Cso4To&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXvPGx3vFbNsMarnW30ixkEgUD9c3n4WmyNsYU1npr2w&oe=6AD39722"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il8Kpw1GE8cQ7kNvwHPPOPI&_nc_oc=AdoQ98LIC29cNoTzSi-9FHqDyfUDdzROZqjYkDIizgnmCL46LtJJ_JZ3MgT22ip5gts&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-OnuTxgmPRnO7IPbX0DoJxll6L1WK5rqLk_hYgzSyuQ&oe=6AD3B1D8"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96wN6K04Ts0Q7kNvwEkSu2y&_nc_oc=AdqySHCoC8QKtrjAfkC-DBVU4_Y_fZqJTlWnWBJ00Jpc4kn3fgIU9YDafWDYkEIMTZM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfwarPVIewRA27vOwgR870BuLiIiWg06MSd7K3c-a1oQ&oe=6AD3A66D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FmN3LfAjFwQ7kNvwF5qA0C&_nc_oc=AdreEAnBhPdwtdXYxlMPH8-2v6O-P367mdxtanpn_4cFNDj_pQbftxMVM5_Z6egzkSk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0_n-JF1lBaiR9xc1EGI92THlu5r7xBn1em01GDpShPw&oe=6AD3AA02"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyJbeTSBsC8Q7kNvwEgrvvV&_nc_oc=AdrDgxYoKtMqFBNSHiSqcIVUpOvLESPU8LGJo_bDPaKZXNQ1N0V0eYijxwp48u6bCfQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHMv4yu_zX9IC8d1gJtMpj4NS1lrueQhGwrz3pEBletA&oe=6AD3A5C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9BBFOPCTTMQ7kNvwF60Za9&_nc_oc=AdqX64pbBQe6G5
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKU3Ck1uFr0Q7kNvwEpk0E4&_nc_oc=Ado21fAJ03qbG_CPSfCgpj9fKm4_Tosnq81lI3iTHK-R-xL5X3yrxFFZFF7v2Z5VsMc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B6wSBd6YitT__PJNk9lJm6op4TSUGTT2UNwVXIr3igw&oe=6A15A6D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO9pfD58TH0Q7kNvwFlHkaA&_nc_oc=AdrLisD3R6ThXedlsdbiCUQCLmryVndQRvbUKYH7njrSt3DwwZFB5GBQNtHm7HXaHD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vxLHxXa7ETh8TGuDWFdc7IoKulnFgridzbFIqwBWRrw&oe=6A15BF22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeqWv_iyXk4Q7kNvwF2Jjxe&_nc_oc=AdptlEatt27WP4vGx_hGr1caI-Yhg-Uo4ZBuSQq-ZVjWaW-Iq-1jys9R5__lx_N6HA4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xg39ZhqCJTne9iDXSIZq_LpEpXYMcyBBiTXpUqNFzuw&oe=6A15A198"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2rc1Q4GflsQ7kNvwHnyn5P&_nc_oc=AdqzTPONlIPf3CIdDFLpP47u30PRbqlAdPL20ChVRBy1FEepWNhwShB0JspAd01I53A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_Hr7U5PRaja6bIZdPgslzbW7q3o7CEgEMTnLJ1fcvCQ&oe=6A15962D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTcBozQa3LIQ7kNvwESDH4z&_nc_oc=AdpYyKUhqGzi7fbnglLsYyES_jqD7xRz_MmPqvtBxMjf4qIKWxBmSedJ7mV93Wp-e9E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wailnH1yVHfl7o335dH0Y8H-duloB9pb4XVTK9cd1_w&oe=6A1599C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uraOxlVJjmMQ7kNvwFB3goq&_nc_oc=AdqdomeWqZVSEDeQ_kvuTLoAXlEPq-Vy0xjicCEn2FBCoECZe1o94cU0VfcyOApLhT8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OKn-0_NXl9ykQ1MS7hgEEPF4kvYDQBfjuAyHgYy3B7Q&oe=6A159587"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0qKYoGVEegQ7kNvwHw-mt8&_nc_oc=AdoXA7V_-mlgIq
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIEw6EvpIrcQ7kNvwHob09i&_nc_oc=Adqa2qt_9Ke-vA90mfX22qwzWz--W8Dg_aju_Q-O_p1LTvGy_BvMKSC-24m9YYTQjW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe74Kqz0GnuEjK8fgaFuQyb1x2IdqjF4R7G9UrrJiY2w&oe=6A6763D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95J7CP6wU_kQ7kNvwGDHvVB&_nc_oc=AdpHs3fIfa0ZLTBBohdeoc6MKQF39gCUnVeImDHinc4licD1GeHah1WTPTpL7mJPAAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpTuZYcLWgGcBKqqytLUoQeRh2eXb2zqi22iD6S4VoaQ&oe=6A677C22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Sawd9ys8ZgQ7kNvwHdPcUM&_nc_oc=AdooVBoqzqBCdAY67eiaPmSgn_bNak2TIZJd4G36tPd0n40-76CvomXZzTN7CAGFsp8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI6mzubA_oGwBJnabTLMAlOH0Q5NWFGy2HycqIpYuU7Q&oe=6A675E98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fo0bB3XGhScQ7kNvwEJhf1e&_nc_oc=AdqOq1k98lEo5tjnJHY-IkbY1cjtIr2oJTWkBYZfKHtWhEyWmwlvqINWuR5dvrFi2yA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_KiGXBEiPj5B-rwjHt4J00nIAofQJQRLv9jI8e3opNA&oe=6A67532D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js1RfVbraCIQ7kNvwHjfdzY&_nc_oc=AdqBpzz4v2SgWC0F71-XgK3JtN6OvuB-jVBFT6ojJW9uduGgoJ0QPMSXop1rn7zpoZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwR_4w6Om2cyLvy5lgcOjCh2b6NRYwrpnOSJlN5ljEYA&oe=6A6756C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9aiaqTlMt8Q7kNvwGB0mc7&_nc_oc=Adqq8qpknOPvRyrCUmCfXnx0lzbinqn8jk6-ypDyAwZsRVpSJnWBejWQzy-j0kYzoUc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCRYWLbD8tIiw7rdCQrB4BKch6TxF8BKyNTw8VPgjSnQ&oe=6A675287"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgknjRgsojgQ7kNvwGIFSHt&_nc_oc=AdrFkBp_V2zNBO
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAcD08CcCBkQ7kNvwFQIT-y&_nc_oc=AdoaSvnHkZEz6ABPNN3IgtSJhx-UCT6MNc-T7otJtxeI2LcStigslDa9gfibtX5Ikhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTWUN8-xp8yp4TFpP72eMMepsrL_pfNjE0vysyuMV1QA&oe=6A8464D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8FiEgkI9ncQ7kNvwHllSYb&_nc_oc=AdoMZP-9rRc9OYE8PSwGCnlupO1usnPMTdKZgTk0hUgg47rLW5m_056wV8d5rvfECKc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH15je9irSOstfM4p6jyzp_YSsLyy-gYKRzNrw37dasPw&oe=6A8444E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlge96IMW2YQ7kNvwHEG94S&_nc_oc=AdrkzOF7rW7B48AKke_xl4HX3rQolNZzOLzMZRwgNrIcI2GUOWNHRIUQ_mm7Y9f6ThA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGt56_l1KuJ90TZeVAc-T-mvxXiiPosImiCCry51zDfBw&oe=6A845F98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUN5n5EkAYUQ7kNvwF_SzlD&_nc_oc=AdqHQWYnvysjQxt2atlmJLxSoZ8t-CuOA0NopLFg0gVfWa0HXNvKe5XoyKqRGDgXmIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdFShIhq03CMXUdHpq2IzUnyRW7fZK-bVTK63y50Ih2A&oe=6A84542D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z40yAtDmNroQ7kNvwGCvEvZ&_nc_oc=AdpF1KcvV76N0_pPQ1-3uWEjLKud2sU3NUoOMRycPaGRtlmETqJt5tfCt8z-vTWPFHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGepW6EvFnvBiERDsxFKvkiHxs2mu0nLar_pwc60I8ZnQ&oe=6A8457C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eBUl0xhv0UQ7kNvwHJ8sAo&_nc_oc=Adq210uJxJX2fZRuNBsPt52uZ8nOWtyCEyd2Nr_X0Mkg-7UZUKURtTYLG04jiG6_BUY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjKj03cS6eEynLgAJLDz5J5Y3IgYl8o5ax1IP2I1TUwQ&oe=6A845387"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXAS0n7BeJoQ7kNvwHqnes4&_nc_oc=AdqJ6WDCmRibX9
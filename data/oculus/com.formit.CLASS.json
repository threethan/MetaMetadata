63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXH4bRRChT0Q7kNvwHMz5Vt&_nc_oc=Adq6oumNyUeVuFJMFBpnQjIS0W8B0BGd4xfOjaSr4PDaZg6GlZ3IgEH_pCLR2phEfa0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oWuqUwTtqqJcg4TNOgwz5W46pz3KcKK38T5gCsC3ouw&oe=6A3BE256"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVjANa5s8m0Q7kNvwEmRNpu&_nc_oc=AdrPRRZlcC9lN4AX8YtB2VDUF8YwwV8ymB_jQTCfa2-XjGqRf0x2rO85ZHlxn11WLU4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Gm8vGago8DuhqIo7hgxPJ9g6GQF-ubtOgsBMg7OOfjg&oe=6A3BFAA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tV6NBNe2tPgQ7kNvwEL-Kmg&_nc_oc=AdqflGt4wUhVXxMaQCmixv6uQs_UvcQiWd3sVrTag9XMkcq1lxDSLKyNuKgnbxgTZdg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AOo9_gQgYOuqkG-BqH-T5F5U5IkV8efQc1pHxT4MnXA&oe=6A3BDD18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDUAbTjBxWcQ7kNvwHG_7-Q&_nc_oc=AdqMQ6akLsxEinTuN8YBQmIuDNR12Zj70XM39w1ZdRPOShU3mGFyAmZzn435zTX-H0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qs2YtlAqFv3VokV-2Npp2coVGkiCYD3JpMjLceyiuRA&oe=6A3BD1AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqumXvONQroQ7kNvwFsPO26&_nc_oc=AdpPe-HaeyUQw29Q6bXsDFDp8hKmJND_AdxzkMfal3f2eWRZOOwcz-aSgYPeQtvcXRQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e2qUyH7FtjvSkgXeSfEMafA-Z9YXUecaDrCa4vj23jA&oe=6A3BD542"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voVqiJin2QsQ7kNvwFmgb1x&_nc_oc=AdpQWtL2Jp8Im8LESD8x5e-GIBS5Wr6r44TTrWh9Ma1E5aniYR44ZdVD1N_E7rfr4hA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af983yPo3TPTH6yLOVb9AsXuKx9AvpJLTfhD8Eu_hhKBXg&oe=6A3BD107"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNfVB_whiSwQ7kNvwElcMIc&_nc_oc=Adq9MRfV4YsW12
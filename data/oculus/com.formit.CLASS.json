63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyeAcAjYYUQQ7kNvwGHxHoF&_nc_oc=AdrdDJKrT5L4mDdTu9A42ruunQlRaeCl3NMDyQeA32lBsM0e8Kcef9fTCGc3SDEMxh8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhLP71tPPtaDc5_KQMAuSkQbrt-uzvF8Gk1vEQ2Dz9fQ&oe=6A900A16"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkjCD9aV14AQ7kNvwEWAQV8&_nc_oc=Ado8FtjHlMSnV57OTISwPaNhIMbbZdz0HimUxezN9OIcpAiHdnY7HaZ9fQ69rxRDsK4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiNoiN7FLSwq8QQEY7XfP0_DZ4_Mxx4f5VKLd23k2Ojw&oe=6A902262"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kcjcx2rJhwkQ7kNvwFn7MkB&_nc_oc=AdrmLFtw0_TcP4HACZyDFBatDqD4SNFraq3JhtXVl3nZk3-D_WnWB4PWsWI3rEoxY2w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpnJY5FeChR1ratEcjJKlH81BpfMtD9-1v209xronJIw&oe=6A903D18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vAEK1x66AsQ7kNvwGM6fcj&_nc_oc=AdoN7wEi7qkUA0dhwAhYJUFYPntFbvxGYRrVwMe7eD--LYoXzcDq7a8nHKJJxIsBi8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH60Z0QKCFdDpv3tc6NUdcg-uwMuFQbgu_jmDRolaKTQA&oe=6A9031AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhqp7M_TKPkQ7kNvwFoKQMr&_nc_oc=Adp_yyeKTLnw7Ir_7lfc6BGPKq20Yps7CsVBhjGLxl24VdtB6LVZYlUsZbxIcHELjDE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVR_9AyZE9o_R4tUJM8dWc35GClC4bj6_XeWxNCQMS7g&oe=6A903542"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-asEBwMRiPcQ7kNvwHO8ULx&_nc_oc=Adqmep9Da2lShLYjBjh0H1oV6tSxaEUzMFEqJxxHH0lzNtVpbQ_zEsOeNsMaHLDayyo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd4r7smzC0U9ro43LxcE3WynDONx-4l8O9VxKtXowOzw&oe=6A903107"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo-bp2wFLcEQ7kNvwGnkHEI&_nc_oc=AdredR_Q9TM3hx
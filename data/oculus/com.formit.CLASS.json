63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNzP9rzK7-EQ7kNvwEFOJ4O&_nc_oc=AdoZ4ETHctOpgOZaPHc5fexnZAVC_aFel1thTIOEx85m17veJD4oQKE5U4yeMX6QVvs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HXJ2foEj-hnKmU7yKuE2-36RL6lRyzI1N1ilOV80vZw&oe=6A1303D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LO9pfD58TH0Q7kNvwGX4Woz&_nc_oc=AdqbVSAGgkJcS24y5RZWL42bCBpjfQH4siBAg0K7rhBdZXsCDIwuXo_ejencim6kwMM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UMWvZvL8D1ywYZ2eVO3j1H5TFcJgqQ9hd9rSZS5zsKQ&oe=6A131C22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uleN32OQwnEQ7kNvwEQTdNt&_nc_oc=AdpvuL49TVyjlNOlvrt8Pr_QmUItuCNIGEVcGrsQ_SwKcXqnv2Xvydk7FUU0fKVFFns&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZU9Qeze48u3HM2lk1ih03ep7AZ6gAVLTE99_bnzP_fw&oe=6A12FE98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhFsAjFwKy8Q7kNvwEbV1SV&_nc_oc=AdpjWDfpBe0BoDEr3dAfAA7Rbwv2bCZuJFL1wloUrkgh-8qGGo4gU9xlELgadXIk_Sc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qEnoYNl9meQV2je-aGaw3KUI8_I5xtdXJF6ejL7GEqg&oe=6A12F32D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTcBozQa3LIQ7kNvwEHVAas&_nc_oc=AdocBxqPfluesiHYmLZjIEccqDI7p-uSTbQfYSfXUiuvyCOslB4u7BWluajM1aE4slc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X0DJ34WKmYsLE0UAuNG6p2j-MsDwzjayW-2UcOllQSA&oe=6A12F6C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LerlzrM79IQ7kNvwHsH3Qm&_nc_oc=AdpM_N5PVNpvOKFScnoT8jg1rtLg-VRxG5oV9_MHlSqBWzq_Vo_2euRdNHGKSpAGMhk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YHB9wbUbwJJjmqng9jFCEUMr0bXRcVa6m8HZVi3ITyQ&oe=6A12F287"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0qKYoGVEegQ7kNvwFMExxV&_nc_oc=AdrAwJEp3Y0WZj
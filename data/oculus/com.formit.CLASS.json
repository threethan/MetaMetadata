63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYyeYIV5f70Q7kNvwGd7gdx&_nc_oc=AdpmoP4855g-vWn-g1XctrF0U35eg7o4_klgiKzG7QVLxR3J4AIL3Q_iwkQAg-v63Ww&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQbxLrLWUsDS-D8OKQmaa9xKcQwgix0kK7ecS1xh9N_w&oe=6AAFE656"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yObcY7enBWIQ7kNvwHYvF95&_nc_oc=AdqDX-hAUsGP1T8Js7FnpiaeLoMWvfpd5_KalWQjbDt1BJ2hzUSr7f2MYCDx7eHhHao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFYuiVltPXGedsuVf1QMZQpoJa_9NWCvB2_f8bKBmVhA&oe=6AAFFEA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djrzi24RBf4Q7kNvwGJUP4D&_nc_oc=Adq-smPb8xM0czPeeyCby63c_CU0Rs6Lr692Xobb4nJdnaqjxaUHlccbIxo7Y4qFVqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpibd4d7x4kLmn9yDkj8E5bYrJsFJ9B_8DgBTM4G-NXw&oe=6AAFE118"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkj0a61I_DQQ7kNvwECW80O&_nc_oc=Adqrw8KbeIN5qHmRPwZcQ8ryg9CqJAH7_3xrd7zf6R37P--maGgUCi7SEqtgw2-95bc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBK_3nYYHEw8GK6xo2geDv0TMreq_KvJ9c-QgemcOAZw&oe=6AAFD5AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxuGA0uqmp4Q7kNvwFR_b-x&_nc_oc=AdqN8mf3IcKDpQwslqc6lW90ibz_tOpDCBXcY_4mOr9khdvfuD2TXrjx1IhwkVoZqwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd322LAwR9GsydZwI0tXtX_pTx-TDoYxyk5wF5jImbTA&oe=6AAFD942"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_KsKRq_5D0Q7kNvwEiwG3i&_nc_oc=AdqSNvyOM5r4FVmpgSy15GDKwpqKsK269nUCtoCz_rp7y_pBGNGLkVgd-tqUUsftCqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyazSPHqhynvIkBR18Z7kDaqDYCcSnklhKPrL7IyP2Ig&oe=6AAFD507"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvYIrVIpMqQQ7kNvwEkhz49&_nc_oc=Ado7C7Y_lfQX4I
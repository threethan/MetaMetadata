63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_ycY1KzIV0Q7kNvwGnsE0M&_nc_oc=AdrWaAI0_SMFpxWU0Z6IyzQfr0NqJFI32nhhftw-WJO1DPhGu9esGHQ3mO7oH0cusi0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtEfiQ10wjvQaIOE9Pj1TJTu0ub1Elz1hk__DUjSlmfQ&oe=6A6DFB56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAGHNGzncscQ7kNvwGm_J_T&_nc_oc=Adr0y-oK265LzoPUysmbHKB5C17DkiG6j64p4LdvBzWzSxrYMAB3CUZzcyVJmOmo9ks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQBwhW5MFryIzCWUorBOCD_F8Hpjev8ZXWhm9fdKSBgA&oe=6A6DDB62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_SlRcxSfFAQ7kNvwH1QZrq&_nc_oc=AdqEAjABelWGGzV149rZf67MotbsWLPqljrJhsAWpfqgxe1PxKjzw3KGfciw9N7g5vM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0hOI1wWUm8tIsWiUmSTeekN6f_MtgG9hWZV_X6erYcw&oe=6A6DF618"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ2L0EBoebMQ7kNvwFMdCUT&_nc_oc=AdqWBGLUEQfnKztWt8iLoADlps1CGY_N7r57uhWSyQDy8YhkF03jSSNxjk3IOj1Q-OY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHNK2embQq8ETvjGC94DC0nJD3iXB3oxr3QyADplogzw&oe=6A6DEAAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDnX3qrwifMQ7kNvwGwJvo8&_nc_oc=AdrP27nFsZWj3LO34F8HfRcACi3ubQydulvlAFnOSqPRo3pm5QJBj4TdOoU8jE4qzDY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCefT2cSEvzGicQkz0-fUiFt9GyirEQB77UYUhtZRozw&oe=6A6DEE42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0Qotz6BHJEQ7kNvwGAyQ8E&_nc_oc=AdojAjxckPDNkGTDMTMBSk6o2A5JqBl1vxOUB9yVwAz_6IRwEl15ZlBvCT46FgnoBBU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe1mnxKjJntrqhQiZGJ5f__3Uqxw3HYLp877aJ6Zuc-g&oe=6A6DEA07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AOUxg-qOtEQ7kNvwGKzZsI&_nc_oc=Adr23CdA2iL8DY
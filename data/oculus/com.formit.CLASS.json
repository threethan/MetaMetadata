63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EZuH_GXcaYQ7kNvwHs-P02&_nc_oc=AdqXv5mQ_WXIlFF8_ZGGehZokIV8ns43wDaSXvumHFgVmU8Ovh9BNqldZb1NgAToyiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGF0RszLY_gFk9PgXzHD7xAesX1Juk_GHzOZhCbI4IiA&oe=6ACB95D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yLuz_zCNiIQ7kNvwHZiEud&_nc_oc=AdpNLk1Y5xJXlBgIXMSVfDVeBcv0exSDBbMw5Bg0Vqm-3idCbqRWf3c0l_SFjMWwObs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbWMZ3oLLQ3wWyBYmh89CoDTJXqrBvxfZNpZFZrq7ZQQ&oe=6ACBAE22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPaddkZmWskQ7kNvwGZDAfp&_nc_oc=AdotCdX_876-DZuZLu5rRIY8LxcBr4MAfeeTq4ufbKzVNjUF49sh-5Zkb_AynJ0GjWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw3cChs02AFY-f9fzyUQnAsVxXQZQJ7Sd7PqJJxjVTQg&oe=6ACB9098"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qReysauDYQEQ7kNvwGQyG-y&_nc_oc=AdrRDF_uHxrBH0DVCCmg8w9JQOTSJv6ozXj9c_ByzLpzuW4kst8T-NIYol9b8_Mb3ls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLi0uroIg8GdrPp_E3sLIMTEs-MMm26Xrir7IvabAnHw&oe=6ACBBD6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHpwgcx0WoYQ7kNvwFDintR&_nc_oc=AdrqwSr87DGPL_JmJ0YbSOiSCVe8tVsp3UYCRmnVAYvgbSmagUiC0bkrU13GVEBfl9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFiZnuuW_EVW-w2UdAE6zE9EiA6oldJOU3H-Gp_CtdfQ&oe=6ACBC102"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJ5Vav8n-D0Q7kNvwHZ7p4Z&_nc_oc=AdrZ4GDYyHYlkS6rc98LTYN61Gv5-SxnzVJVxxveB_S4g7G51u3i-Ujeh5GXtacYdWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONCOAAZKSsR5CkMgt6ps6YaBrDjJ3WHa5JlVGGjO8Sfg&oe=6ACBBCC7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AY1erDCpbCoQ7kNvwF8fIc4&_nc_oc=AdrqhTlY4eApUY
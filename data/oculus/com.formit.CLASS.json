63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsK2XpZitvwQ7kNvwGshyW9&_nc_oc=AdqocjHAHuULMKD1wy8sW0x3D0aE7JqvO06PD9_0lrV_DCrcwEJ7LHw38CXlTbyoL80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wMFIO3g6Cte6P8r8VnzwhRwH1Xy0bdj-EcwX1tSX-dw&oe=6A048356"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZoqV-BgGqcQ7kNvwG7efYK&_nc_oc=Adq--jhrL6_a50ZlEOxI-KBenqOwiYSiUNLWfmFu0l09LzcUfoadCKLUEpmepJVhbh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-X6SJFbZty6JCvwlml06iamaCqf-tHa-8PpBzrSGjHg&oe=6A046362"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bJJb-8HWsIQ7kNvwE83gW0&_nc_oc=Adp_6flj56A5tPe7rdmoCvRQyD3_up6MS97gXy2tOBm9A-boDxJN5j-_R5xuq7Ot6LM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b6UBgHSQ0GYeeRI7BxXoNlgMO8c_gd9_sSqNs8yQvRw&oe=6A047E18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQIxRnvNrNoQ7kNvwFVZ-qs&_nc_oc=AdpFIo_9rf__ILmKEpQHbStAyDG4vMHoz6N7Vw_Hb0G2MW-_vNrXi0-eeKEafJwgJRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GJagU-MzyKGcnTy3hClsC5OhE9r1eLMBzsbxNeuscFw&oe=6A0472AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIZV5v-QP7wQ7kNvwFRjhCY&_nc_oc=Adpnjd92z4BKJ7znsYSadrhx6vAlqQcUuG1uRdc7TRr5ZnN9UvweBaDNe1e4hH9QF-s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48uKQU3qiJUkktOUE1rCOKMOeF5dLui3cSgOI-iEv4zQ&oe=6A047642"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuCYvrRaykwQ7kNvwHPQXqb&_nc_oc=AdrZbUkUydI5VGZLz2tVB23wU2N1l52FMTI90nrXrNLHDH1fyxOEfhZTzb6fVPa1MtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Da1utSm5bHrjAJxu5GFMCUCvqUA6MC1XPxUxZGlKWng&oe=6A047207"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vPTUAS0nv0Q7kNvwE4CqE9&_nc_oc=Adq7Spc8CRH4Pz
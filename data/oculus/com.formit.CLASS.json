/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDxcpqvwo5gQ7kNvwGB6EdZ&_nc_oc=Adn5mPV_69veX1bIOGdXdU3Hp3Bb0VUCa_ODxCbHEOD7lmDBysolASKGYRze5jChSG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6p1Rxktmei8ReHvLked6J8wNs_WD7c0hT2DPABRm48w&oe=69B6BAD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC3kCTITMsAQ7kNvwH3J9Jk&_nc_oc=Adn8EhZ5M8wrvvqscFei0MQR1OHaVRmn1ocag_lxh__3l0pXtx2WBnDKptDAKMV2Ss0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz4d4G9ArMlcchacDCtb-Cja-JTzAEq_Vkz8evNGyXcg&oe=69B69AE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsyDBxS3aAUQ7kNvwE3CcQk&_nc_oc=AdlJApDpn4fVVvQM1l5xawR9fUoqMrnFq2GiTRSCOLSSDDhExEx86MHsJtCSlt4qWbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTYLD-rFUpEBxxGfDoxkN9WBMWbJd9zCpeGvvXaYIFhQ&oe=69B6B598"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qlvtbo6ClkQ7kNvwG3rXwT&_nc_oc=Adket-2HZDaAvyZ-Zk6UZtWVkA_1Qic6751aY4jSPgp8BMR8pg9wdhbFXHuhR1nuGXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxnr1GYlCIi2v6MLKjBER_TE64NDXXPndfUMrHxStToTQ&oe=69B6AA2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNPDmkdSvIkQ7kNvwFhSsoZ&_nc_oc=AdmA-Dxg0yKEJk1CaOO-mKTTWhIpqTM103shpUTbib4y7NL5qE-klDxtu7QTMx5LO4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyV3NcRUYzq_iATN4yW57YWOceBBcpUqnfnviFlBSaGdg&oe=69B6ADC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejsf2cHZA3QQ7kNvwEPR-91&_nc_oc=AdlM_FggYPvQczph7xEyVn3Jfuqkl_dRvH5-0v3TbkNVoUOi9EH3wR417Pc0TPYHs0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXDhyRVZL8gJncdticrVQ1q9LOje3GeBlha6v3FwudWw&oe=69B6A987"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4WrXPbfFR4Q7kNvwGI
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMuOgSu540Q7kNvwEUaFXL&_nc_oc=AdpE8IvxjRw4o8kDWvjPjQtzrnSEzPm0yL08I74xQdVx9XXYJglPUmSg_JkFtgPMy1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af471mtTxWisy0e59NPmV2v1KuM2PPhgXT7cq-7wgvpdDg&oe=6A1EE156"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEERzxGb5PAQ7kNvwGJLEBd&_nc_oc=AdqlP-z3eImpY_j67M5TN1UKyCJDaDJLCIaFzj_UmBSxqGBcGmIYjbMEAGfBIrZfCN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ndaBzPbZUPDmrRP-wGfKUSVpk8cdOMt2njrA9cLd3YQ&oe=6A1EF9A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e202aFbkw-sQ7kNvwEfRp2P&_nc_oc=AdpyjaROB5NF-qxqnzpJiO-tRot-UBS7HLr4N8VB70SZDEy60nzEY2NtkLIZtZ3FZhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y3icN2Z7-gjBqPkO89S_DMCZYakQw_VauuRJByuZKIA&oe=6A1EDC18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCKaFBvlhYIQ7kNvwGsWDTR&_nc_oc=AdoGXp5aS5pcCgbYFlQb5WAe-MQVgI0qCZl_2WHIm9donEmVzUicmMdDTMkk17vIMJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NnjnWnuGTViFUwjVIN3yahn8v2jkY23JHFGPtUEGtyQ&oe=6A1ED0AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUSs8JxSyygQ7kNvwEveIvk&_nc_oc=AdqytrRYI2NZM_hVtkObNL75P4ZQ7nsmQw49wO_A1kC-QtGgFMmCn3x7sM5c1bMF_Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52NmahED6AV0Xm-0md1ZDaIlFR9RpfteOluYQI1ypOXQ&oe=6A1ED442"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MtOrm_eqU4Q7kNvwEoazzp&_nc_oc=Adrln4Qa0z6soqU9FA1ow6xtDvN4mgkCIDIzOsSNdJo9bwpY_N0VYQWhM3TzDpcdOjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60iFeQWekw3UcRC0Ru5qYqEtot6xxIttUAs2yQ51VLSg&oe=6A1ED007"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygfWDPNC168Q7kNvwG0ofhR&_nc_oc=Adp_YoDBoGPFeY
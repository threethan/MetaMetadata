63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8lvPHgleKwQ7kNvwF4KZlv&_nc_oc=AdoZCEBk39MKZTIecbzB_bxI5KnGr799Jz7ZqixbOdEmHulvpA7YvueUkUG3T3WXr2E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCo_xo3g542OmBDlvJx_LVk3Ineu5I1WLltibGVhZxzw&oe=69CBD2D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEJyaF8Ejq0Q7kNvwHP5N2o&_nc_oc=AdqsZmB_2eHBG7WV3hDjb9m87gWitW6_mvVbp_Bmg7jNVA_VyPXoZUwfcHw-Fa5Oryw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEnaxwFuBYh42nhz0fi2wqdZ9QZLHMybokK1NQ9AJwDg&oe=69CBB2E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zotNp7Gv3FEQ7kNvwG-ldNI&_nc_oc=AdonmX22XW6kp1_mtsbBWpCjHG5zyr0srgcvmh0H_Grk7EMYGm6uGWM_25JsOW86XFM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyd80OaEXdIseO4NHZh4ZaC-zqUKXtU5dyfXczpua9NwA&oe=69CBCD98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh_sXfci6mMQ7kNvwFDLRJt&_nc_oc=Ado2lpdZ2DgtbeOiR2VupX0hr0Qy0CheJ2CFzCe9Z24xMUKuTWsvhyfIfK8Q-1yBcp8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzord3n39K37x1cLLzxnE3rKPST3zo3I_QUp4N_c_gn1A&oe=69CBC22D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u3xMPXiFMFQQ7kNvwFOoJOv&_nc_oc=AdqyItjChajp2edihnpFj_1jSEfkW4vhxq-Wfz_9ZExoDn-BNWmEq-VBIghIF48qMvU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLX4ykTxcl9Oz_5p26j0X3V7xbQ4yVOQF_CIRYi_J2QQ&oe=69CBC5C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnrMA-kbBnEQ7kNvwF8p_7p&_nc_oc=AdrCRUrKeL2E6NW-D31JWKtcHXnCh3kd59SqX7Om57WCLlV22EGBUs1icx_5d62K6Lo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJvw6tqJ8LC-nMisXXaatxaV-epr-VOSM42pyW_a3yRQ&oe=69CBC187"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHFQQb6420kQ7kNvwHzjm32&_nc_oc=AdoW3XLXmwQ7aM
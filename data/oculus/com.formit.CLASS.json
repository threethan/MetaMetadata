63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcmzrD3HissQ7kNvwG-q1pb&_nc_oc=AdqywkWzVNAPRVCplcEbSqmXS3ungJ2pmSVMhLheWIo8SH83QtzQ9wiPcx22IWzHp3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lbSo0xxwcE2OEjlaj7NxpS5B8luN8o2xvYcA0_755CA&oe=69E4DF56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13h4auGX2IAQ7kNvwHfHYL1&_nc_oc=AdqpgRpxEqXgnhHUgDGaMvjNMTpc6apoWMGMUTffu4Cl0oFdpRP0PPpSPL3zwjEwVv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03gz6XNgxrC0ShvUvhT7EVSAzbDCDL41IoAx6CRJ66hA&oe=69E4BF62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KnZhbTR50-AQ7kNvwHv37EQ&_nc_oc=AdpFKIAi0_84800oyalgqoPGr96ZBVN1dJkqp_ilZFtxlm7y5Qt_PXEImTF1MyhM6GE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KQZR_Ly3UNGUehpq3FCVhmoa8RYLv58570FNwkN5EVQ&oe=69E4DA18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ieOQb7W5U4Q7kNvwEobgAd&_nc_oc=AdrdX2VANv4O0k3lZG4FRv4IF0bdKp2YgZ7pMITy6fL41ZLbqk_XsoAXFStM8CQX6ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pMsZ6jXd2ySKDZgEHCAHG_19K2BNaYEngZSenXT0pfQ&oe=69E4CEAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rItYD9T5CiYQ7kNvwEaG22V&_nc_oc=Ado9o192-j9vAeikK_7PpANeh7pxVF1gPESVcbULmoGSpxnz5L2hT_Vx0DOeL0vPAGo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dbWMK004f8bBBrLS_Bb5XHyvc9Vr4u7Dz16vTRv8UgA&oe=69E4D242"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5faATPPkH5UQ7kNvwFKSAdk&_nc_oc=AdqfwS2uoB1OWSQCFGSsxekJolwqSqfuopT-Yc24ZF9K97baVthW_dsnXuo2mDfkpW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eb6nhLZO8Sd-Jrr_qy_2vertpvv7Mkbl6lLyaQhmbEw&oe=69E4CE07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMhefv0xd1AQ7kNvwF0L8Ws&_nc_oc=AdrYyxAS-l56NK
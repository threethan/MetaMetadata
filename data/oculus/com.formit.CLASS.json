63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSHwv6GT_7oQ7kNvwEVqlCL&_nc_oc=AdpKfnNbhJcPownNM_6AJN5aCMT_1oXpuG79ldhYsWSGAUFFGYi6hJklvHBi2LsolIU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYM8V5yRTAHFa7UtJkMzOTcAKIjTeQA4v_nThRTlyokw&oe=6A5A34D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc9TISeWsuMQ7kNvwFjqv7y&_nc_oc=AdplXws1IYZh87X2oLr8pb12msBksJburHCcN7-YXrwbtJ9aplfbxIkPUd0EDhX9jSQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqW0HygMfeAIA7eCEhKYYJPXCwDWC3g1uz1sfG9Q82UA&oe=6A5A14E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRxaiRaBpMgQ7kNvwHek7Vu&_nc_oc=AdrT86iz8xoRoYUXEqcGT9tfNLmnS-wA_GoQKOVYbRtGsZeBPVtlSikxWgyx6pT2als&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDtcZAouabuUE7j9bZintGAWj8eS9EwgzN1nqFWTul-w&oe=6A5A2F98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikc9adDwkRgQ7kNvwGdBCHp&_nc_oc=Adpo1L2xKvu1uoJSVoV3OcB-7hzBLgfNgaMyRZVoOkCHm3P-TOiAxg-FaAtxnaFAMzU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHezIQa3vot8x-n1rqQBgVS8AijBlke2NJG0xr5eUhtg&oe=6A5A242D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7kqpCzvbzQQ7kNvwFn7gBn&_nc_oc=AdoA1tKzBB5I4dKpE5OFEixKQzN3qvGMZFgR_3J89D9LQVtK4Yg4MaxeW0tREh83f-g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGgleVP78KZjnW97sgZBhFa_BziWVFJYs8uoIYreaGfA&oe=6A5A27C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmmO3HE2rysQ7kNvwFR9ffm&_nc_oc=AdrBtSzkbFhNP0lndgyXlc3H2pErB2fxe7VattIaPdiS05UGr3PhZEYkEd-Z5Zj0c_Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI-S6MVe5w70EbAxczK1qSVw7FbLYDwDXs8RQXdxEzIg&oe=6A5A2387"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vipl_R3U0PYQ7kNvwHUQdc4&_nc_oc=Adq1mKocxK8RGT
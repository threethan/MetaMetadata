63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d8WJfBl7W0Q7kNvwE7xZ7w&_nc_oc=AdpaXvg5fpva9zfNFT4syRn0v28pwt6rsX7inTZx6AyDbIW2SMPLAjuV_fEG8PmUinc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RLZnBc7ffvzVd42eQ4tOS2yh0TRsVVqnfC59v7bsfuw&oe=6A2C1056"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOgNmxgslEQQ7kNvwF86G_O&_nc_oc=AdqoAEw-oWkgaWT5nGeuZjdIzfkFmbIg136M2e5fZmvQt4jsimmqSOYNCpSu8gtq5c0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oI81AcWLRhrikjB85CtTNjmL-RogM1ywnXW4B4aCFgQ&oe=6A2C28A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwkIhx0QTC8Q7kNvwH5hX5g&_nc_oc=AdrplmXNOMG8kGjrnuzB8WJqgatP3p6LPRrf7sod-eMDXMK0vdCp0i-ZD1t9XvSMNpY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Cmj6OkJUrU_KiW1VZYaa-1KEdiqqsq4vFPTGkXUbDZw&oe=6A2C0B18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnCgtpE7A98Q7kNvwHSYjIB&_nc_oc=AdoVfmDOUfD4McbjNML2ff2pVMoUbilYfiwcCTK53eSyXUXVWfgprzYnh1UNoKnoC4w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S0BaOAGY7ipRrsQjKcLTqrxfTVyDGR4AEqzOEBzb9jQ&oe=6A2BFFAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq1j9D4LRo0Q7kNvwFLR9kA&_nc_oc=AdqLPKpB6h5KZcO5dsrBZJ2k6H5bd_NtSJmDUMuE6iMgJ5kHHMoaWceY74l5XQJMguQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rD-sfqRe39SEAAoGfIE0XD-nOTNva2AP86kOkYGJVhA&oe=6A2C0342"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lj9FC_Uk9gQ7kNvwEmdL25&_nc_oc=AdrJsGKnmU7UsIShJjQ-bA7wHO10tHbSLf_Hm2w3d7DeFo2vqY1y6_nc7ZN2vqLjtz4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fH0lgxwkXW1s44lI9dxhIlIbdZJGE65HQaRkvIzvIyQ&oe=6A2BFF07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61cGL2o2XowQ7kNvwHPzzlW&_nc_oc=AdoYy5HWVCbbuv
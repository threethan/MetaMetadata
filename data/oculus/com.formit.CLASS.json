63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eLa2tymzz0Q7kNvwEVH3Zb&_nc_oc=AdrcQjPZowD1nesBniaWYb08RFJbNN9nnL2pMMdX1fcZ3vGhEs5vklxBnnLONovUsG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTRv5onBpH11BLd94oFqH-vR_QsnEspIhO4kmdP43RLw&oe=6A4FA8D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrJA81HIsvUQ7kNvwFJWp6g&_nc_oc=Adqi4vcLhwAEodGdVwVrSTHVFXMCZrqqPxuXyzslfS3MpBPm-9d8FrbcryG2A-1GWxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP6nExT5H0y4MqUmkxu_aeW-U7fq03FklRs1Z5O_8ITw&oe=6A4FC122"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hhx0VLfF49cQ7kNvwGR5sAC&_nc_oc=Adp68G-aID3wXosBB5bdK9zIJgeNVlsS8PNVjqgmMoctAE0tfRQsxitGaNaCMQju1FI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdVQPOOjCOUGcIiLxnS1NtZkdI0ES2aVVDQ8KfLLFOtQ&oe=6A4FA398"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfyXwRzdQt0Q7kNvwHfSSTa&_nc_oc=Adoi4sN_s5a_hFOL5mJXObAsQE-mS4IwQqCIbdBvGOL-HnkTUzMn8yEDLiXlng7zZFY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAyi_4VhGwbOeaTv-i2Y7RSnpbN2ERM2TmgKBFZ0Ic5Gw&oe=6A4F982D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duS8VT3iz-gQ7kNvwGpLsT-&_nc_oc=AdoElSf2-nYaZNZV4eMCaGk407XdTNNuoWBLz893FEeV7fYsjThHos-JvEJh2IO8FA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbEpQjGo1NVRwfgDtmizmvxfKbTUuE-6QK90xlMYBGew&oe=6A4F9BC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArLeY8S_2vwQ7kNvwFRs0FZ&_nc_oc=AdqAfCwm4Smeijzgh4ZB7LGAHy95gzu323JnlXaCCp66IpVD5Nq3qEmXZpEB92VaGR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMdY2-RI3FjETm0INy0okWaqf7ABgMD5rHpqEwXC-btw&oe=6A4F9787"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msG2TZkKLhEQ7kNvwFTag89&_nc_oc=AdqXXIhUOmHR8_
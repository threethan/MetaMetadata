63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIEw6EvpIrcQ7kNvwG-92WU&_nc_oc=AdoUDiQB1gezRI8DOih7U-mEh_ABEgsF5SG_hsmHzPPLIq6NxEXwtrX8k2iaQf0jAaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRCnHRgY-XwBVvhLv51QixOZcdUkCaYvO1WjEKIxAmDA&oe=6A64C0D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnxqQILJPw0Q7kNvwF2kUHO&_nc_oc=AdqjC0oD2pGxHabRzvTpe-drmS6Fgn4anpKqLlkwdOILIllbW3Ei-glZUjLkEb9Tl84&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNwKcxSNXYCAhM5mmPyqrjLgt-ZDNJopnOseRl5-EMVQ&oe=6A64A0E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaIsjAzN3EMQ7kNvwGFmVI2&_nc_oc=Adq25M94WKUt0EXgV3_LwP8MIGHXWkiNqZ2ZfK4u2oOyf6QohoNHNekET2tKsOrDmgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEHuTbzlbV8GOb9p94YZGeayHaO4-mbIC8cAdILb8joA&oe=6A64BB98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUtBHNdiSQUQ7kNvwHEvaWN&_nc_oc=AdpmEVcHvhDnzAs27MjhNULaf7b5KpEwdY7-HlxsOmMCLuA9K4JMUIoTukSK_dpCYV8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBQVgKTAZSxkpQvbXfIHshNmF_wtxAmRHda7gdkA_yHg&oe=6A64B02D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G076y7G7mBQQ7kNvwEYo5Af&_nc_oc=Adqy8dDIVi_znrYTVbB6Xnae6MvQohmRo804Hv3dSx_pZUN6_4IhulxI8OGSjiQ_GNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDguQeMml7nextS3ks62QUNqE9Q9qlXFFsA8Wvw4VG_jg&oe=6A64B3C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9aiaqTlMt8Q7kNvwEn1oLk&_nc_oc=AdqNG8EixR5P5-g2_XsTJcKDB4CzdqUhBxyp9j1GMer4HncemN-JrlN404tz3LYAmEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHU7k4jNHqfWSzZFeDP8Q3_wrw_Ze8NTg_4sAkxWZ5Vg&oe=6A64AF87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXHeBZd1uMAQ7kNvwGhdMyV&_nc_oc=AdoR_yG3zfjNkt
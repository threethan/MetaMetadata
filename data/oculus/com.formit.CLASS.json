63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSHwv6GT_7oQ7kNvwGl3pxe&_nc_oc=AdojJKYrGRam2rYbjzEto0kGDgoId1XHewEbo2uoSBIV6Rvpmx9sF0W68rlyQki4E10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXdyoLYb7qWS_ZOjONah7UfZx9ezlmlNK7M3Wa0ZfGfg&oe=6A5B8656"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vc9TISeWsuMQ7kNvwEaWA8T&_nc_oc=Adp_O3PfjmyHTIgJzOY5NZzhaQrJK213LZOEkWkMkdAzr5EbhKI6hurS-2yppmA9atc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi6BiOZOt5pUgS7BPNmG84cacHWvrU0t1ek_m8Ww5lVQ&oe=6A5B6662"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJtFC71osjkQ7kNvwGjquBD&_nc_oc=AdrMtNImQeN53sSeZ2eCF99PZ6eMqf6VpFLqIE8E2G-S74SW6alK7m_UU87j84fZW4g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYnM2JUTl_eBrr2oCGc3cq5C-565RCdQTqzO2Lqe9Xlw&oe=6A5B8118"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPHQ3V83QQQQ7kNvwE_5ii0&_nc_oc=AdpnHRSnqMmb5v0I5P6hAAwONwC3gCnuqzAeom6fj43HUGBkoUnobObY02gd3BKsoVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzQZK00y2p2-MPNGHW9P8R_ucSPCOqCKQAhARfGag2Og&oe=6A5B75AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7kqpCzvbzQQ7kNvwEABNzL&_nc_oc=Adq14hQDhZrqNdaVu6oEnQY7P8bSvHTHvjrhNgbivh9aT8A6Bgv1WAdHY5jH6VnrZWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8h7MxQoCCNhW5CVRYwX-7I6o1awFx2qbM4TfAS4NCfA&oe=6A5B7942"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmmO3HE2rysQ7kNvwH5GJo8&_nc_oc=AdpzWb2Osq_HhNgjCvItrWuxcEZhqCjflqhE4rNhZpHo5U2RoXvcfQ-vhGJObB5c-28&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuokYDZfBx4ntw9i6Z2EyW9oZARlzRYSt6HtbCFTmulw&oe=6A5B7507"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vipl_R3U0PYQ7kNvwFpihWV&_nc_oc=AdpWERNJ1VWRPK
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpAn5eYOnn4Q7kNvwFR8gNk&_nc_oc=AdqgUuUkhXalY9KSWNnbgyvXUgxYMg7Vg2cdsKxSSId64JOR7dzQ74ly6U6n8mzenBE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xyCpUOmFfUPong7U0PAZjDBH18hWH1j-1WF8YqfRX4g&oe=6A008ED6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AyGuL37y0UQ7kNvwHI46Wi&_nc_oc=AdrjohP1Oz_-ElzCUpvIY0cHUM332t8tcphlPW5k_N0o_hDtdPGAVUoDYW1pwBiwKZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af722UHATPDR83FqbU9GURiInKCCg_FZ4g_62htvW-XvLQ&oe=6A00A722"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSrj2_hXddEQ7kNvwG3bYNg&_nc_oc=AdokioZCDxL4bbmJujUZ37B1iJ2ECtm-6t_cdiguELbITwEJLbZZY1GISNIxvvLIh0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VxvE2yab6Mplkb8XDQyzbeGFf4MndU1S-M2zYSqwYmQ&oe=6A008998"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4P2BejNoCsQ7kNvwGZqCS5&_nc_oc=AdrLlwb6J2zBC6p_rTG2p_8Gb6UZoOCqAx-1OPRjdRcGf86WZBlgtiGtIdqxtP7Q-uk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LtncmbyVRQA4W8pa3-xy5PRlxtCvM2uAZVyYKAUHL_g&oe=6A007E2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_x8OCBgJwEQ7kNvwHMXQDE&_nc_oc=AdqhKVK5EY8zFCAoVJN5QIivfxEGmU2NjLBCSoiDvYVs7cBtxXZQ7Sm7q6RIx04BfYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e3t30n1Eg_tw29Faa75JWowpn3NTMjGjZyvx14x9bDw&oe=6A0081C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZXX1JoguU8Q7kNvwGD5Yhr&_nc_oc=AdoL1Xe9tj0gKLN8xq_ZmndeQGlRPrBvqZlBLHgVclzIG05KF_fiPIqwuoXoaXJChz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4tA1vXEwzfLNaReXv_oZ9D7bK4gKH9stwXV9QPrxv-Tg&oe=6A007D87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dYoWBSVn7cQ7kNvwEVh0Ln&_nc_oc=AdqYa4MDc5fz79
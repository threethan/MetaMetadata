63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfRjNHjqflkQ7kNvwGQEqwl&_nc_oc=Adqja6v6FV2L1_1cTXlBtl1caFkyyviCOdhyIZYYgfDALJR30DdkKm1mtDwQY9SRzdo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88IolHsr4Cl9kSkhm-nFgS_0XxsF0yWV3bU8TWONEnWA&oe=6A2578D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqxDh0RZhkAQ7kNvwGMcMMd&_nc_oc=AdoBhDL7QtqMhYRHb2Y_iniTPOFxfSnTQRVJdxYSqdD-59Bbggla-5f3Z79k-nr_KmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PGKCwDS4loAgYeBBr6YpRo3C_7-996g1OVqe4CnjTZg&oe=6A259122"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAA1eMg4IH0Q7kNvwGGw7oX&_nc_oc=Adr33eZW5yafxDhLL3ryUO_tFleRX9p5ir5ueLnZgZsiGvL1SCPOuKuuY31-kF-uxrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k2LyNQDusZC1WqdYP4I4ZDSzRKabObhRtvamRSPEgvg&oe=6A257398"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Yc-AxLHSvoQ7kNvwGyJ8Lv&_nc_oc=AdqSZAXwLow7igWCxEgmUsrRqg46UN8T_-6NPysHW9s2Y8jSfbGf2xl4XLLJZtUx7Y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dTPavXNsilYvLoTXnT4wW2GuI2SiHGdbgMLf4E-jIyg&oe=6A25A06D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8JFFZD2JukQ7kNvwFdPDl-&_nc_oc=AdoFY6uSatkRdIhaMY-XYkOe9dr9kKHF-hJu15mQ5STRwv8AcNxtM3UeDsjLjFjNbMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CMzJW00zs_7LoXumxdbfSVnWYW2E6TMejjrLmH9Aggw&oe=6A256BC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02HH4A2CosUQ7kNvwE3rNMz&_nc_oc=AdrqIs4wtWDm7CIPJAjhWMSY89nybFhl3w_Fv93yhjO1VCNrnUx6ZLUVFR3HWAvEZyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Uo-c87FPu0DwhSBQozzvrFyJ4Br3mDTQrflYBgdZCHQ&oe=6A259FC7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc6DXkLXK1kQ7kNvwEsqj19&_nc_oc=AdqIkeE58Q75mE
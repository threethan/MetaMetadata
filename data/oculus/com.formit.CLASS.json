63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqjSfbqAAYcQ7kNvwELvXBl&_nc_oc=AdrPhhF4_dOsILWjf7b6TaUw8nvITYTO39BRS7ekb36drdnWVTfBPekhR0Pb3S2_Row&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVSItp7cSOBZrHpf7Qu-yRQXVdgIg3eSnAi654qvP2HQ&oe=6A75E456"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HE1DVALSskQ7kNvwHBRZ4a&_nc_oc=AdpOxB4A86zRifrmFrtfAE190OIlCERr9lGF01hEMuy0Gk-JJsYtPUzxpVetlosBroE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmWuBoyAMrhQSwfAV3Vb0iN2vum_GMMhTizO0RXdoJug&oe=6A75C462"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-MlmFvquocQ7kNvwHhhUT2&_nc_oc=AdoCgbuOtZVMZvF4La3AhxUQ3V7xaZFeS8MLj3poIi19CYGbkCXEOiaDf4iqvrUOJUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIu9CQxERr0AB-k0WmcWTzwq4wN-U6Z6VEc3OluW41GA&oe=6A75DF18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwrWZlT3i8AQ7kNvwFdpxAN&_nc_oc=AdqrFYwICaF8CSKLKChF8exZveChWkIIuJRhz_mL9Dw1eGmLn4zwjEQAk_QzflbJ1OY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-QbPFRVYGzromSoZHGPWX9r1O0lQN_yXN67vV7RPR3Q&oe=6A75D3AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-OKki5Ix90Q7kNvwGDEwQk&_nc_oc=Ado2aylqfUuaYfIClQsHK4ksZubFbozptsB6Pyq3oteUByegOZnrM8mCrL5Xpl-hgro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy-hOvjvIfQwbueacEHqnlRCOMyFEsjdMQL9RSztgBlg&oe=6A75D742"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nl1dJ78DHcQ7kNvwFFsScU&_nc_oc=AdosSi1jwOnlrwtLqYbI0B1KUY56LM_UPgjFkNTYsLeAjyUNYa8PPRHzPtwTx6MKglo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAuZO8uPBk2TkpWLWpIsM7P0Uh0IAb03Dg2ebPR2xOcQ&oe=6A75D307"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGbCdxAnhskQ7kNvwG0r2c7&_nc_oc=Adq_M7w7XV33Wk
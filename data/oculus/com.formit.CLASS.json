uscdn.com/v/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAcD08CcCBkQ7kNvwFoYKv2&_nc_oc=Adr1yBKqoctJcGsisQ1PuGJTj2VZrSxPvBEfiLOFNK9JMoLioC2VdFHTyfjDKi9VURU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTpQIY0AwJx5Hhb1ePewwNYx4YOdXK1qeK1-NvR-1bzA&oe=6A857E16"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCW8EkvuZY8Q7kNvwGDQR2Y&_nc_oc=AdoLdZexCaivaVSg1WexYTDOqpV95n35hKgfaNquAZ4CSannVcW60ZdZcBV7y2HtMjM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJodSGTpuqtADv9PN1MDQuy8weRrg7tfTXeokbmdg6NQ&oe=6A859662"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlge96IMW2YQ7kNvwETahX2&_nc_oc=Adpqj_HoSYlQSyFLtsykjjZKRV_VGPNjhRL3nk3FaSyNrKHu2Je_bzThKeG8jbWOdSU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa9gjtVS6SEWqjAsrka-1m5z2xnSb-0BG0-c9gh0CX2Q&oe=6A85B118"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUN5n5EkAYUQ7kNvwGRqMKh&_nc_oc=Adp4C3HH8Y5toWrxIh7tZvFotKzzS9-CClLUI9-vpF1nZby-JL4wV_D2uDXu_b_iYkY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHt0DKn-dZ9vl9Ibr8jhc7Ion6X-HP8dJGxlyz5JO8pgw&oe=6A85A5AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9OoCfvlGAwQ7kNvwGWjTJo&_nc_oc=Adr4Bc6lIVaD4n7z57RYIIUaRHxGb1oflRCbKXR2217NuVkMLz8xpU7U5X8VpSgm0n8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiBLHccsZhbefkr0YtpZfKsRKFET8ulgqFiwB9xVyh8Q&oe=6A85A942"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eBUl0xhv0UQ7kNvwH54N3d&_nc_oc=AdqQkuGqpQd2tjCGjhjY_7yKeGKJsic-rLcXHEel2oJFUviwNPvws40vedMLHj8iuL0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrr5y5zbVD4AsY3ohfKUFI2YEWupypMSZ8yLj9Nzt7zw&oe=6A85A507"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Q0IQzErm64Q7kNvwEfFrEw&_nc_oc=AdpDqu-mnv8tLdDeZeeYHn_iZAbRJpUmegIRtLsV4E5JfWJ_gz1mmc7gWACax4rTxx4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iLTiv3dYQ-BP1XaVTDO5P0zzReRmmGHtTwBis-7_dKQ&oe=6A354AD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktYrkHV6-KQQ7kNvwEW_RmI&_nc_oc=AdpIZNDEr9aDfDDYGfg6AhN17SYpOrfErlRKJPgD7ZGDSgO4Dudv6Tn-DiEUWMw2c9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Cspp12hA-sVS-nW8fGm2r7TuGq7Mf7ymxXE30kWiZWg&oe=6A356322"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5szIG4kyw-8Q7kNvwGOHe9A&_nc_oc=AdpZ60Gcj-Y4IP0jJftjLapSajM6veMKHn5s1Lk0HicfKAWxy-Qp3wK54cCUO6PTzfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9A58BvbgJYhHT4l5Hs5kEJIHjUnucgqAE8wzKpi4Mwg&oe=6A354598"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRS8LQ6-dYkQ7kNvwGoIC2I&_nc_oc=AdqWPj_oZRkphraJdJHUmRK48Q0uRZkzI6CfA7hqChFQzNJLT_Vdx9q7cSgzS8905gI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lxlYnrUgEBaJg8Sa25U8MV01v7cAO7xdZumobWvaU2A&oe=6A35726D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsC--ePUf3MQ7kNvwENmrMv&_nc_oc=AdqfAlC_s0sGcS_36Z6OU3hCFTPpD6ajav8vAnxhBGcBCJvZHDbyIYaH990T1h4YIYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4KLgc08MYmoY4QPWy92jK5tZJhXCa-MC0C-5W-JLoIw&oe=6A357602"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAnCl0Ab1L4Q7kNvwEhagLf&_nc_oc=Adqfn70OpE6rUhLILMkmvqzOwBacMkDo3LBSgCLgVMZb7XrzLJNg76srHbvVwtbI9zM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Up9DVCRg9tQAh4u988e7gwQAD4SRwbFSYBYrHnpHPWQ&oe=6A3571C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=na_JxQPs8Y8Q7kNvwFGn89c&_nc_oc=AdqPG6NonzgjFg
/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJEu_s5W4WgQ7kNvwFrQ6Qm&_nc_oc=AdlXAuwNXMrj7OCqcK92dD7I4vsD6BsggWoSw8szW7HIm_Ky3WIx9UWTxgmKz7RAdnY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsYjIsTZ_EingEPbObjc9sL29GOvAv46ar5i-toc228nA&oe=69A98BD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmrMO0uaJFsQ7kNvwFi3ZYJ&_nc_oc=AdmAdCA1-80qlbFg9EHONg2gCvJ4eqbI4baT787OTOFrGLD55jzkGavarcVSxWN38Rk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsZc08e5XKseL4h67GmD1NMQNkXQLa2KsnTpege_IqMGw&oe=69A96BE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GjxzhFBQFsQ7kNvwHQWMer&_nc_oc=Adkp23uq8O_G7nCk4JdqiqF_VC4rqt7_0r7NpsUfCiEj_q3TORiLHfO71i2gL2y8t9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuzWAAI92IA4PppUQ_nIZb4sDh-sAq3NQDpS8ENQ4oMkQ&oe=69A98698"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx55TUd0GR4Q7kNvwEXKPSu&_nc_oc=AdnsNjyzFi6Zz90cwGLFZg4W2Ii94figCG_Tw0p13mJuE1iieNu-H2HCJrK5WqiY-XE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7ffNCj_Tn9SF8o8Zkz45Y_NN4-_3Rp3ZiJiABcBSPng&oe=69A97B2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRz1b7t338UQ7kNvwGHeQng&_nc_oc=AdnLq0cQ96j-h3dkNnnjMHqTtcTSnYhT-novJC3rz8vcEtQ-Zw1zMxzy07KtU0OR0dw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvbU13iWFocrAIRX1MjUC9Zs1my5cSnb9GBpO6mLymZGw&oe=69A97EC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep9VIuAYG9MQ7kNvwFZFPuf&_nc_oc=AdmDL55b9FIiN3sK5t5PC0pNb6wg7QX4qfAxtUTas8QwUC-2SH_Sfj4HLdNILoWGIVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvWiBojtRDOKTeM7tUJDOMKnhzEMqD_TfhQmjCDj2GlJA&oe=69A97A87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSBgzTk4qGoQ7kNvwEc
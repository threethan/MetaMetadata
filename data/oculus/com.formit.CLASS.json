63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rl7_ZtDYC6UQ7kNvwEqYE-s&_nc_oc=AdrjlIadZtWqy5BEjMJYHj459M8IPrs_Uew9iKs7QOnIU1HiwFTwGgYChm6KL4Ho-xs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAABm5Sf-Yg19ArhRnIIeO0kvojo6MqN_GuR7Y9CwQyBQ&oe=6A5791D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xa3PhPuXvikQ7kNvwHJTuYf&_nc_oc=AdrXFdn-zpt4S9qYwuEnsd1rReiNheodBMf9O8PPVeb3OyGClGAhYVMCo1JX3EXngjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb1roH8ZzVPQR53qZphPBSO5fIW8O_EFpphuuJU4SMag&oe=6A5771E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRxaiRaBpMgQ7kNvwESg2FK&_nc_oc=AdoVHfp1o8vGleyjHh3BM4sHGmgsUfP1iJzME6otMr5LRzqbxJqfEfyOUgYLL3ddZmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZc2EOzmO0kWA30SiVsys4PKRJLPmvMp6ZTk2ImKNqUA&oe=6A578C98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikc9adDwkRgQ7kNvwHVJqab&_nc_oc=AdqfWFUqV3iU6RfVbjVPmcTYzPar40fqXAWNxNl87qs98EgylVLftkrH0Sm0D6k4DQI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA393vpDxsSTtiII3Uyq2IUar9DluW8Wn7SH1dxZU2bzw&oe=6A57812D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMuRaxjBr-0Q7kNvwFFwz_e&_nc_oc=AdqCciCogc3DpiskKMYmyCs0m5bz02Dw5dBPvE9q4ns6TWHov7XTntVOl3RlBTKZFFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhiULY3dVeJkOB_OVUeJBGXpsTGlATCakFJ3DAxP3eww&oe=6A5784C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55WTrHV01awQ7kNvwHoaNlb&_nc_oc=Adqc477PWRP0cW00zENNAW7gLeIK2ECZ1EXtXzLSIgqnKEXHe3UJSmE260i7UsdmZ9w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHS5S6LJCsbwpb6A_yK8Cr9vfksYa8JzSeStALpNWYOg&oe=6A578087"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKx4cIjepHYQ7kNvwErFPKb&_nc_oc=AdrE6eP8rLih4n
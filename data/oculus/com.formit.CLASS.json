63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJKeYs0J8CgQ7kNvwHE4Ca5&_nc_oc=AdreTZI5yYtxlbPpRjTPCcFgk9OcWREK7eaGZa30vq8ug_NG1htN_v2pa2SEkR-26So&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRfcrebzawFX_qp4vOBBWYdssV5Qn06M7TXSDz0_Mvjw&oe=6AA6ABD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cjw2Hy3A_ecQ7kNvwGXXkG_&_nc_oc=AdpO-0YOH0ryX5Ob3_PA-yEQOGvBDIthV66XxPBmRLpFwQr3d5Opb4VdXRPGKlrCZgo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU--YdO1wMXtbqMwP_O0Us4wGeL2W9bk8OXesJKli8kw&oe=6AA6C422"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FY7bGGPOGQYQ7kNvwElJJ79&_nc_oc=AdrPAd_pMUp0jXyiEh-GPaRKuko2quSbWkRt5oP-4eI5VgJMyTc6Zx873wWjBb1ilA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqPpKrxZ9Lo2ax7eRN2iZ8y0lvHA09ThnJxdDYeo9pvA&oe=6AA6A698"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvFapMV6NuEQ7kNvwGyY1kt&_nc_oc=AdrfBf_gdeh2KwBoYQizhLTMkZg_ti9iTQacP1xkoF3HZR0jDsdvXeM7YuQKwqgDiVY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfR_PR0wbBeol6Tnn5JolM6L4X7V7yiYbR74knc2xumA&oe=6AA69B2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMw5T5aA4IIQ7kNvwEyw-Gq&_nc_oc=AdqdU3wUE39SCSXxu7iJZsClVKl6AcyspYUpAVk0--8llL_wvpvUxumiMbO9cQW0yAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI01BRh82btAWfVsnTn2nLmI8mh3Mvsu4RaAzLvtMb4HQ&oe=6AA69EC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrjaRjlcOgkQ7kNvwE93H9U&_nc_oc=AdrjNM8VNHDDuKRgFPTuDR2TfSN5HnhkOMsercbZSsxmmL30NrElkNhLHS6l1H1baK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIXVdrBGIbw06tmCyKx1gJ8gKLRwU6vCly1P21RHiygQ&oe=6AA69A87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiqXyM5TZ04Q7kNvwHHjq4A&_nc_oc=AdpQgxEokY6wcJ
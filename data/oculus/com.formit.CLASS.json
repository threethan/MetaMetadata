63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Q-xm5EVsg4Q7kNvwFywpzC&_nc_oc=Adr6PJQzwgOjK30JfDGM0DFwnkFr8uBz9L3qu3GbJdTSHQVAHDmwa72D3j3qPD6c8rY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2ibLom5P--Runqnr07I7ZIyHojrA9ic_9QVWFnjVkFw&oe=6A6A06D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=831ZKMcjnjUQ7kNvwG6dZvw&_nc_oc=AdpBBxKspP8nl1PYiOHmsNXRYgYlgHgqF4EZJHU-cSTWwzS4dXZKWwsHJ3Ff1ntx1cw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpZfKDO6mgab-Nft7VJ40cTi37_65dcqr3w7VYWqvomA&oe=6A69E6E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Sawd9ys8ZgQ7kNvwHVWFv6&_nc_oc=AdqB5qz-0FQInargfYpxRxEshxwXW-vN0m-J699gOyskwO_C26PCkiM122ytYDCS_eo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAA5vhQR7Hs0pF0FK8BtrUAFYHoej-nsAByDzg5JOKWRw&oe=6A6A0198"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fo0bB3XGhScQ7kNvwEpm5Tr&_nc_oc=Adp_8Jd-1BefUCYRgMtchw0Z5t0YIWpa9aFzLeyhhj0-cGXCURwpNOPhFhAPoYoi-nI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXRqRKpQKpHp8d6p9to7Zw4wWZ48egpnl_8UFWJ_qN1Q&oe=6A69F62D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV3JuPp-RFMQ7kNvwGKPDOa&_nc_oc=AdrfIPkDW2K4_gk10fvt7y8GRExmpMyx6e3VAiglSB2vUDTyYDlM0S00Cr7846CzPBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChdqdd5pAfYR1LIUrdOQgOdEhUYz4MU7vyT4hFVP2_PQ&oe=6A69F9C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_F-VWRwqdqAQ7kNvwEAXYYp&_nc_oc=AdqTsXxc1IzZyGnnh1iBceJ302b9bP87W_cKBgqeL2ThORdY-yV3nvo1YN2-dWau0zY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmsFX3KIkVptPUaXesSTLHBhEVz_oekzK75W_OwvZnRw&oe=6A69F587"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BxFoAXuu-sQ7kNvwEHmDuT&_nc_oc=AdpbveB_gdKRfx
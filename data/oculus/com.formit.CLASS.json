63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTRQuwm-624Q7kNvwEXFAyU&_nc_oc=AdqknzaMJOTMas6-aBsnDI85USiMecKW8CQpBla7ePDsE6p0cNtCNmhRN7MXqepjQyk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XxxhidcQv19-aBs18iedtGLMeTmox8DUVfAxmwG9Rvg&oe=6A218456"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEERzxGb5PAQ7kNvwFOVxdQ&_nc_oc=Ado0vx2zYWGh0Wp94cjpiSpk2T3MHls33_Gmw4zqjDK6vMIS-ml4rsj4kNNKAZkT40w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UPXU35Xc6NRJKMYTJRmHHK6_SZcn0UjRpxv-DHmij9g&oe=6A219CA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doJ2TZ4Rki0Q7kNvwEIep79&_nc_oc=AdrzIcvjYXcIDdUgJG9RHihYnpTWzDxFHAoJufqU7n4bSy2Vd0qFWR9LlouseDH7jvw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fJdYCIspyXM1jx3YArYzE6bL8PdPlOFOnJogR9OkiEA&oe=6A217F18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIEwT4QNOGIQ7kNvwFPRcWB&_nc_oc=AdoWqORgEbUJCnVFHQ231VV_lDv8XbMY3e-Y6a5VQ_lqQIJIVfFLwnMVEgWQqICsYXg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92xkKXaopnlPIob-ihnjwP8zzFZk-c1RYFii85yOn5Jg&oe=6A2173AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUSs8JxSyygQ7kNvwHpdRJc&_nc_oc=AdpODJjRZuAX4MffnQijrjTUzn8ZGBboNfXl-cQXBKgARdh2mihW7x9mg14ybyGXvtk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m2BAMWJCTVy80o1d9rNDzPn2RdPuUFibf-QoYIfSYyQ&oe=6A217742"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoFtJ2iJUlUQ7kNvwHbK5ei&_nc_oc=AdprV2i7DxOvAkO4WszKfDiU-TDdCxc0mzIdZ5YOy2vE_MCjlH3nHUiJffpvlK5KBIs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aqzB40BxVgL_pvvx7tvPBk8qitq2ITl28324h7Xx65g&oe=6A217307"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygfWDPNC168Q7kNvwGTAQEP&_nc_oc=AdoYKdX-n8_z-1
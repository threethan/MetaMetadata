63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yB6iSK0zY4Q7kNvwHBaD4p&_nc_oc=AdqtcJtH6iPhvAV_LU3J6fCjcr9q4FWHG5J7zTRcSSbx_rnlUSz6-0M_V2ZEsGVStis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsWqSsB97PXxRGx11OHMosZk5Ra8TPSxKMLE3q_O_g7w&oe=6ABA7256"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-6g4J2G_fIQ7kNvwHff3i7&_nc_oc=AdpI4XqznPxtUU82R7P2TUaFm6i7uI5RNe9gqECN_HSGfX9OhrPzO4N74TBWaeHP4Kc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_4AMWGv_rrjSKaFjoHmlNucIaKoLa58C8t36IpvXKwA&oe=6ABA8AA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfiPUipnLn8Q7kNvwHxNh7e&_nc_oc=AdpQUYwby4AZfrn6sy0NSNxnyvi7IicWTnNQxKORhmPyB4L1ZAgWQBwGMdNYnOwjaEs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOi0CAddVWf76g5VZWo-YFIKC3gYscjCWunc0idZoKvA&oe=6ABA6D18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMGaf56H6vgQ7kNvwGW61Te&_nc_oc=AdoYEUI6wu23DAJfVuRLkrfGbq7I6Tx5U4iIcnCl6xdjxzUePB-bYP5Q5IMzCB9Oo-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF56x5ulbMghIFIB6j8ZkQZ4kVPwr2pX_uX5n-r7Y-Jw&oe=6ABA61AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps8Li81vvi4Q7kNvwHdl0Dx&_nc_oc=Ado1Imdkh8hPU9HD6Y85u7iNEMoZ6EoY1SBCGUE36vkX-uSo26Xx7iMonU_f5tgWfW0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHpfLnXP8wrumofTlEMT-iGGo9CK9HyMNt_DiYyGppyQ&oe=6ABA6542"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaU72y-4HWYQ7kNvwHO5eB2&_nc_oc=Adq9J3pYPGMnMdOB2hLBldk23aOCrnABf_uzEIPsKDH5Z7RaEBW2lp6mUOxzVlBPN7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIK9K1QkasN8cCBb43pwv4dZK3KLz_XCGk-AtvCIxmxzA&oe=6ABA6107"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z40ROGbM2GMQ7kNvwEDycWS&_nc_oc=AdoXdawsejsZMr
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgs7ltPxevkQ7kNvwHMYfcV&_nc_oc=Ado-T3582hxmB1WXK0eUaN10prh-IQd5DVFF5rmIF2lUzyXqGuBx6xUNylNOiQR4f7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZxSroU8FRLMPBi1wCQI5rL1gphC-IYxnsr456sL4g6w&oe=69DA5356"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwSf-CPpWacQ7kNvwFJU5mZ&_nc_oc=AdqDN_eBr64QUniF152SJSJzaWiO2Oy_G1hSv1Mg25JN3gdIaaqO94uyKAiMyKQ08L4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IwhCojcy9OMqW1Y6cLazrLR_MZcAdUXB9d4ErsRdhMA&oe=69DA3362"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GojAURf4MHgQ7kNvwF_J9xA&_nc_oc=AdqNaMkLRCZ9Sp2S0X7B4eEgPHzR0e-UkGfbIcm9vFFL6Dn4Hobxcye2EqeSTkAjPs0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AcZMkoJ5gGLBKtZOht5rxazwqq2VhtDbAEgePyU4lQA&oe=69DA4E18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sFKIDPycBsQ7kNvwEpDbhG&_nc_oc=AdqlIjpHAHN75U6K94sLkDGRLysxo8oJPH7mXEYL3iwfjlQ1w2TU6Jb1ne3_ak_pl1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01CWTzRoqIm4BNLZbj_rdOg_b8hSXmQYre-0K_2QAuiA&oe=69DA42AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDwMjahvnW8Q7kNvwGPClWz&_nc_oc=AdoSYdYI3g178u8plV4WdAyCKQfKtzy75tA-NkielVPy55EOqcJoN_eqZKwGPpoDdIE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q5SdHBhcGjaEPGwQ60zF5U8staf4VpDzRgW2lnz1ZCg&oe=69DA4642"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h1W5GKUcdkQ7kNvwGogWYt&_nc_oc=AdqFHjbC71Sd2vsj-hm7VInbDQz_8ZMb3tklAbe_1uv9ZxoxeLs2HZy_VCsfCriZIX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Cag8bsBjoBXkROjtX5VLhMqDEzKYfPG_ihWDJEQa_8g&oe=69DA4207"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12xvD-xlxCkQ7kNvwEorJ_e&_nc_oc=AdoCmG_2qAqB4P
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAsSVj-eifYQ7kNvwEvCu_8&_nc_oc=AdqOTEk4WSIuoNwLh0_N1nTwH6fJtyDfBMcuU3uogLSsIWvkWFrsxhKUyq68mNqjC1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR87Aqj7aPpqVcsbwWfDVNjYMeTeFsa_CHiT2aFhLoNgQ&oe=6AF35B16"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLf5_Ne2hGwQ7kNvwEu5T_M&_nc_oc=Adr3DuZa-bbJej5QjcdKxjBlec3dMol3L1yAn8uhmlEmU8reFMTVO2hGZoA1wDspl5w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAVK8qZRSTWT4ud6XFroiltk11HWz4lHsnrczwvgBwnQ&oe=6AF33B22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RA_g23ItFrAQ7kNvwFgDNHZ&_nc_oc=Adrs2x1y2BkENjH4OuwsesJiMTK3DzBDgLrhOkwFqNqGhv1YrRAlUxC2JtMeO5K5ZNc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpL4iBAVAcAk6NOQJHbIUTzfYx6_Ox2zP-fO8hih3cTA&oe=6AF355D8"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxGZ1JkcDhEQ7kNvwFQV4ZL&_nc_oc=AdqC5Un0wo4k1zOZMeaO9UG0o9nbWpaWXvUlT_INp-BAmysgAXm_7sjdKScle5REa0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRt0WoFrSi7VRPi83XezJrcnufK976ZpOrEmNKMaI2rlA&oe=6AF34A6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8PKcwpS9swEQ7kNvwEa1M9M&_nc_oc=AdrHBSZ52DHzcUfmCL8AZAeNLPL8VdzoJC6Fk46Kcs8Hq62MFvQU-cg2PiZUchyEE4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE4e1x_JZuXTZX2WftlDpPYkTYuhPWfYD1jcXDg95WMg&oe=6AF34E02"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-WSrQ-zw8sQ7kNvwEAAHim&_nc_oc=Adp8pHyuqHADJTVZmnJMwoC608-7VT_tt291wqKBaB6IUdYEJdtIWQvd1FqI2VNxc1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOz8LdJ7If4YXOKLD6fI2UAiXC0m67ytgjU7omEVjcKQ&oe=6AF349C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Qq6xAnEHfEQ7kNvwHnZBrq&_nc_oc=AdqaOMSafCzGs6
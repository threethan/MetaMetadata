63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqjSfbqAAYcQ7kNvwFMsNrM&_nc_oc=AdrzstPzdR4vCmKwdZtDZmoV7hrVq39MzMfNTLKRO-IouYcxcZbhjH5pygZrZdDo6-U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFq4di13Cp7IU1Z7qxmhnGK3N9BeBMi5alqL_2XsCRytQ&oe=6A7735D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HE1DVALSskQ7kNvwHI8djJ&_nc_oc=AdomX2asGvWwp5XZckW_tZ35kG8sGmaUkF54CTqMNOy0wsCQImL0paLtqz3ikIdevDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMkP-s0jDuE5vipu1aPI0CvktD4uAjbC_VhtL4vovDtg&oe=6A7715E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFRv8hTcf4oQ7kNvwG6FIqS&_nc_oc=AdpYcWUoChkFKPgAFyvV4-X_83z_cWk4K_SpqFBoeGqwRUbxQLDaafg263DtAsO3PJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVed_uZ3iWgazUA7Z7vIpBuEeCSnX-efZqQQO5JkCVVQ&oe=6A773098"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_XxOL9PLAUQ7kNvwFDd9iU&_nc_oc=AdoZYg7CNRXqPqeEtAWrpyMPW1Cyn5ZWgVLWihC1F-JzyxJ82JwAfaJghrhGH0CXv5E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbBhyWRibK8NqN0pz7_hZbRkFU_-RkAB3s90-UwTctdA&oe=6A77252D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-OKki5Ix90Q7kNvwF09u4k&_nc_oc=Adp9VhX056VI_aaBLINmNEPHe1HsDGjFt5D7ji4_tIivjdG3k1ZHh17Hu1TsoSCVgEE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDoIE-0LNwqWJe0bmU1ShVNfmHlmnC3n3xoRNMD-50Iw&oe=6A7728C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nl1dJ78DHcQ7kNvwFyrBo4&_nc_oc=AdpdJF_8RiIcJHy24l8vjpVjdjjuWOqkNRwzlej-_XwFq5KbGjecG8hyKbK8KYYrJu8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfu6gR3Nb2j2AwiwAwPIS6O5m8SmoiOkZkgL1Mv76kvQ&oe=6A772487"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGbCdxAnhskQ7kNvwHq8h-X&_nc_oc=AdqdDjFGN5et8l
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-cHyLg4s3QQ7kNvwFdmp9I&_nc_oc=Adp6MQKOiI2qkm2gsh4keq4BtiyeUNbyGM-xwp-YBdXfXdf4oMKQNbDz3e7ar36FSZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMLjiiKUenctRVeaUOrjRtPIZXT6iypABM43ESG2UsVA&oe=6A709E56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAGHNGzncscQ7kNvwG2BoK7&_nc_oc=Adqh_Q-RTlLJO4fh1odhuhxkEiZLYpAERb-8NRECH2MCELh0nE1B3IbktyQePxxMtoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEiDqgA0G-Wrev1HTH08LKatTeUqfEiM_OhJxTfJeL4g&oe=6A707E62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNLBvCnzjSoQ7kNvwEUUTGs&_nc_oc=Adpw7GmWsOOC5GNZ5BKIIhA9mdiHKuIcmOmU5nietFF74qJxFUoU7vp7ZJysZvo7z1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMIhfHz9vuUB0khB336zFdk4Da6nQKdFc9xWnqJlZC-g&oe=6A709918"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaX8GFn7DoEQ7kNvwEXnOKw&_nc_oc=AdoHn53WfzuYXXKJtZG_XGH7fmo7sma1qRLNy1Za2LEjTCkQ9gujGYtBDy-eEdPs3Eo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkcjiMD35SEljhJpJGyzKCtRMA7ahstThZ8ldTkRcGOA&oe=6A708DAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDnX3qrwifMQ7kNvwGctYys&_nc_oc=AdqFlC7cwpEmkq0Kyd__8d9i8atyG2Ge4n9QoCpL63uAgIx8t05HUv0EyA5FlmTwgrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEBvqUkzCNH7stIESd_OvD0UZPxjCuVsAIO6oxhq3spQ&oe=6A709142"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMk_KwfslugQ7kNvwEpVypj&_nc_oc=AdprEx2n5WVwcP0cpkXbRcCEcss4RDd7WyOzba_-H7Tnl9Eg8Sho5khKSzndl7r1wvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5f8pnGj3w1M1kxX44F2FNWdrcQD5MqHwOLFtp29n22A&oe=6A708D07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AOUxg-qOtEQ7kNvwH-1Qp-&_nc_oc=AdorScBVhsihQj
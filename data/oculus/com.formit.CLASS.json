63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=25lZwJF8pA4Q7kNvwGawHnm&_nc_oc=Adrk_Io9peqSj_nkuPzoh-FtfYWJnPl7lq003WMNxh0IkJIwsZVgxgkB1fkroaxxcz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKptxEcJ7yucbFeHGGBil0_AbvTQ3HwszXhL_Jdna4A9g&oe=6AAAA056"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzm5IaLlFCMQ7kNvwGBgqPe&_nc_oc=AdpNaS5uo0QosORs9igru_-x0zaK2fgsozDmlTR2-xeFWNhbXO81Z95CKlosX26vf8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxhwZsFCsb5MQZmlBXgVgi7fXv_Yns1WzrAEsX3ge8HQ&oe=6AAAB8A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xalCxAp7sdcQ7kNvwGtHfEk&_nc_oc=AdoD8JSzmBMTHJUIqJKOACssufU5nkxRW_hd1kC7z6DPnHyGrCQOLVlJSn2ZUNtPdug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK34z_WpDhVEgt5yeBaSoY49025G508ZUKPaE9IAaRuNQ&oe=6AAA9B18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_g5Gyl5sJcQ7kNvwEoZyD_&_nc_oc=AdpvdNXEYKvgNdM4b_IGbBgVqXEKG4GoVJ-kUw28vm3M0T96zULISWPruURkY3pyZgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKkpbjP6tLQH9YGWig-iYWNOKdvXLW1Jcpb6nScTslIA&oe=6AAA8FAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2Nskox3rMEQ7kNvwF69OCK&_nc_oc=Adqbmr9NKln9KBiy3EuQv8zsc0wCscZ_IDjPPx6WoQWr6_9Cp3OGSFnFbTgSCA7ME_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRVGI6VSTYwAt-1og19Gkh_3jj-EWehe1DhPhM8H7NUw&oe=6AAA9342"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFwDbCuQLVUQ7kNvwE2i6Xa&_nc_oc=AdpjmKIZUPKD2blXU7-cdCtGq9QKwLOy4lj4fmAJPc8VwKiS8sNPOVCViXyW1goh034&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSajvr-1ClBOJTGIxgc_1HSF7W2qn2gnL8XixddVRgiQ&oe=6AAA8F07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Z_5GzlAFwIQ7kNvwHhYUN4&_nc_oc=AdpGe2ZRbkSmP7
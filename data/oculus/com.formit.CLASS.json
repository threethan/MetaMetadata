/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQogJEpf7hMQ7kNvwGCpCPA&_nc_oc=AdnCmaHayV1RwK6kGTTcW70rxid6URFQrJ-4uE5RY_SVJ4NqyVzEsgfwr_LV0oGgTKM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwNdvVVA8DNPA4ZAIIqySV4oq-trgWyZfIlDoXzP8n9uQ&oe=69AC2ED6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaYitCv8PUQQ7kNvwHKwG-T&_nc_oc=AdnoeY8joV0uxeWSkJi7uN_F5SoM2dVsFrfVATDFPjPtK8evlZ1sWCc-W-sjDXdsWZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQGJ164y3QtQkSrozn3Ar8vsOHf70Id2GDBI149rCjig&oe=69AC0EE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GjxzhFBQFsQ7kNvwGDAAgF&_nc_oc=AdnCjF9B4osqirr6Xa9kdvwbpneAoIzzLaV7TZ_McOxSeQ5qqums0sPgY8BfFyuZIzw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzNP-dITqXE2Gh3j00OPYgrHGjXY0lhC6i06Pm0_ZsE1A&oe=69AC2998"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx55TUd0GR4Q7kNvwHKp17Y&_nc_oc=AdlGhvW442LnqwrXSsRuviO9dkyoawRAgYgFnJXez3TVf0d_V0m6tQa6_QFWEWO_F5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxfowXXjcqcQwTJQ75NX5D8l9ZIodsb33vX-PxIbukyQg&oe=69AC1E2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NF1-CTH9Nr8Q7kNvwH9_7ix&_nc_oc=Adltd48M8fFsQMJP09m7UlwRMTJg7PUP_UGnG5YDy0iHPz4lzZ4xTaFLcOgwZowzveM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzpM86A9T-hTbKIA-XM5NcmGY3yarChem0_2Pz8C53WZw&oe=69AC21C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsnDbza0rbcQ7kNvwG_QHc4&_nc_oc=AdmksMaeo6RPTSY2aLvUdCCKK0yyjWV9KN6r9EF9vThVxu4760uc-ttfOg3yAZUn8bE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzlPIfkbFFcdO_XdTPSE_4mmbK1sc70kd6_EPntM90Yzg&oe=69AC1D87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7VvOOUU_1cQ7kNvwE7
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bawt3bZkUQYQ7kNvwEl-YSe&_nc_oc=AdpcFn23iBxxLT1ZQ323k-yyQNPoDt5_SwYcZ_dk3PbWbssclDFH22rij0kIcpHHF7w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Q-bKhRFKYpBCE7e4ElHqQz6-oegfeBX-iUgIaabijJA&oe=69FC9A56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfcW577RRwMQ7kNvwErlNzl&_nc_oc=Adox9FjxsDyPzp20w71LGNgUjj3Hm0H8ahybv9PAMBTIB1AfGAeILcuTA-tHNt45urA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KW9uvXHuoJTYoRMqvg_1Q1HvkTgDv32OhsacUV9W49Q&oe=69FCB2A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6xnfgs2_vUQ7kNvwFOY8m_&_nc_oc=AdqYMyuu8G42iiJjDbXN7Pt7QSujHUgIscK3asC3KAujZ0-85ncgFKl9teQEpsdc0fA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k87XXZqTgDTXuF8l2X0nL_OI-gz1hukKiY_UANzOl2A&oe=69FC9518"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQPGlPtBmkIQ7kNvwGDGSqR&_nc_oc=AdpMGHD_YwdahBW4NXDfEPOUTffzLgEnsTU235o3eGtGID558r7q1IqEv3pB_zg5l3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H_QZpGHRHBOB-N4bnukLLY2pdCOUjEXeQOwBVzjk0ug&oe=69FC89AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mq-GEwvfgsQ7kNvwE_GzZx&_nc_oc=AdpwdCvAZnHIkml6kKigqtT0RayXuMtKgQwbIpiRaRLAh88LUdw4cl14HtRPJUyzTGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k7ya28NO6IqbNwKC38YbpWj_sbBDEH7dzotyFNF0VdA&oe=69FC8D42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbZSQHLlFigQ7kNvwFSO3O_&_nc_oc=Adp7_xkF5J5bFJJtyzWzjQbCSvy5gBi6zl_T9vSlCWT7Yi3m5qp_vObUKme2tsIRuU8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VVe7iW5NLiTSbtXpaT0twiYgVi_oIXttsvn9u17z6SA&oe=69FC8907"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ5-BhQ_3m8Q7kNvwGshmxB&_nc_oc=AdqZNQwJjMLcg2
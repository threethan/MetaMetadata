63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILIJ16kNHIIQ7kNvwH84JCQ&_nc_oc=Adq8UFxYSnwFTTWIWP25ys7nlWsnSntJdOSMkwyZt-G7LMhIOA4dchVEtDr1bqIHA50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwP__FPjhpMjf_blCD3QMc9bIl4ECTp0V0su9qZatwrvw&oe=69C92FD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ay_1WxgYKywQ7kNvwELquO4&_nc_oc=AdrrB9L9-qFnohr2qKaV9IcRNbvznCKVrg6kMgO60Gg_TDR7MobqbMYK2Ko0EDE-haA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzyRzSvb42Hl2i-dlwmyjZdVvPSrl6N_Cfg6awPLV75Ww&oe=69C90FE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zotNp7Gv3FEQ7kNvwGO5mXf&_nc_oc=Adqgttg8RZNlRhY8bH0yit20n9U4kUsaXQZ1mMGMAnE3qBj8s-1FrluWOQZ1TwBqv50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3KS4C6nZt8BugAjjsHH-mLBuYxxRIYInh9yKR5fHUlA&oe=69C92A98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh_sXfci6mMQ7kNvwGsfzN4&_nc_oc=AdoceujM_fCIIRHqO84hPf2MeL8JqO5oMi4hQ4dF3G9Vxw-2aOOrink46sXYvv_fjnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKKd3PDkc0xxrpkg92eLaxuakbkOwAVvhWUHbsiac0sQ&oe=69C91F2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tLtS20Jk-MQ7kNvwG9FR8U&_nc_oc=AdqVmBPsovG0FbhE27sRb8Xu1uxFQmeoUnXBDfHrGlXtb-GeUNQO5IKjImMEOgK5wdY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyu72vuB2sgzYabr1pN2-yo-_7TYtYQ9d9og1poKRXQ_g&oe=69C922C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIlGnjsbjf0Q7kNvwF4RkBW&_nc_oc=AdqxUxrh6r8HY9QqrrzF6Vs08EGds4mzUdLO7t1G0z3o9s9vE88t1LZ0DWB9cLIjefY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwW2CPK43huE8cMvJBDY5sAHZHV9wHSZJNpJNE5CRP8PA&oe=69C91E87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHLtaiLyfwEQ7kNvwFKjuKc&_nc_oc=AdriTYW-JTUjKx
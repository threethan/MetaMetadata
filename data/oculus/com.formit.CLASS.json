63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuTRmDQ-jJcQ7kNvwEq_PDk&_nc_oc=AdpXrhy8Dyu7BWK7YqiYFubOBe-7IM33OTnYV5oWU4L1_r2LIVJuhFW84Na2bV9iZMA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPxd4M1EU_YpGKSNBG9KHeBEtI3LBOwH_ZD85WPCWtzA&oe=6AE74556"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5x10ZASi2nYQ7kNvwFLoX5s&_nc_oc=AdoGtmd7iodzOzAwZ6Gj2B4l9N1gZoNvShO0XRDLTP2v3jiM6fvCGO3q3YEZ-Va-jzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhXTujojWiMuTLdf0Zhmfe6rraphu64RB8bpmVxOxK_w&oe=6AE75DA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnGRZ-Nb1JIQ7kNvwH2NROm&_nc_oc=AdqTsnsbUJYbn47ZLCjgDGWF_dfiGFyoiWjSLgk0NTuEuXXV9L1H8MML6UKYOSk7i7s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTreTgmGiOOMRyyCtgawBswzbHFqrAcvfZCxZrnFOcuMg&oe=6AE74018"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCS1JUblOcoQ7kNvwHwBRYo&_nc_oc=Adq06RTYWY2RW400jOTZxcvvckfOdxCJQri3idXgCFz4aZxg1lDJdl0s5NlO6t763Ew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScg9loo4Kp_wvgj2kYTWFjGULPZx-yYlZVKGcX-sUcrQ&oe=6AE76CED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBkJfYtbs8gQ7kNvwHXQLtU&_nc_oc=Adq5vDR3kOi0BPY8EWdfl4uWFHq3qxucWSY4zUe6T7Ct8wEaz97vD3MdLu9olDyFe2M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY0h141G1Vg6VYz5GC1mgzuj7kr6bBzNsEhZdkhzUU7g&oe=6AE77082"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKefjg6VRk0Q7kNvwFX7jFh&_nc_oc=Ado2Xf9ASV0NZp5-DWB7YPllWBc8j90qHHnqFAMzY4m73Or9PD6gRd47PmUOIa-700Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTX-62qURgAyP_-A-WS96K1MLpBndgZX8Xa0oKAVuoboA&oe=6AE76C47"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKJtm0cgAgAQ7kNvwH2dcyy&_nc_oc=AdpOX1j_BpkW2J
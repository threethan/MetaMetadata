63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXH4bRRChT0Q7kNvwFGaEcr&_nc_oc=AdoBXPdso8YRahrMUo9Gjr3AyzJ1tuc6odFJkFEI0SxcA1cd5fAX7FO3AD4wyXQyCkQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xKT-sLsfSP7z3PslwnrSQYqg04YaIJ7_voNET3g94EQ&oe=6A3A90D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVjANa5s8m0Q7kNvwHaOPqT&_nc_oc=Adqn626i6dkbsabH60j6cCGnvSwc1oCw3pgEE1d3OJaXwNTwlUuFOSyjPVeBECfGL7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xhX8YnkjVT-zJlVaaXNDJCYGpeqZMJmY4TJ6kt3MvMg&oe=6A3AA922"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9AW8wg6o1gQ7kNvwEzpnzx&_nc_oc=AdpalvxFCG9fFwWDleM7BlMNNMB8r25SUp1k9Ox0E-tKzb49yrhjnDfSt3n8oeWVJgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sO91x2aMDUdfSAFV4KQ5GLvaY9s-0_iCim020FDlKZg&oe=6A3A8B98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0P7Tr4hxN0Q7kNvwGX3kRW&_nc_oc=Adr8OVzL3l8uRWUuyy8pEegHxQU-tKQ0_xfMc5ITEXEe7FTLvWJULW07MIopPtXcEHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Nlwcc5KCVMctZskDBwfWSHQU9e76y4EBJRSV8ZNkZeQ&oe=6A3AB86D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqumXvONQroQ7kNvwFu0pb7&_nc_oc=AdoHC4Uzvkji0faYgsEtnso0jeovbYMr6zDimXBrb1sv5UIzTVmLd52YN0RGXPPB_Oc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8yn4oVS0wtrchYBlVdT-SsyzZ44beX2RO33TnCj7lew&oe=6A3ABC02"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voVqiJin2QsQ7kNvwGJLkUL&_nc_oc=AdrkO2cbkYDXf9AOgk7N5Mi6qU0Wr0UL1MNCf-FbP3Yu01_ej7Fgd28f0xr709ujGNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ghre_RTFDFVTSqJZtYoCmDbEMIuRaUPbiSBOiOZPRKA&oe=6A3AB7C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNfVB_whiSwQ7kNvwHhvORY&_nc_oc=AdqvPqdfyQGe3M
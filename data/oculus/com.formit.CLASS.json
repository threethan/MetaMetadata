63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UpAn5eYOnn4Q7kNvwH6apqJ&_nc_oc=AdodMxgvGEQbvomagjQdRCaJ8gNfAii25JmnI-_0uOcCvnqO2kJ7L9N66JSyMDAqqEo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PpTaTbQ3y81I9iET5Lus6oRDz6ClqJdx1oKYIHKDfdA&oe=69FF3D56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AyGuL37y0UQ7kNvwFrYqkP&_nc_oc=AdohaQtpQJxd7hszAvqu3cngJbIqi8ImVEWDms5GreFmy_lHhpSMlA2vgm3enfV3WLc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5F8MCzWBwqFzARfi__y12YTy2asVrOKc5OgI2SlMIAcA&oe=69FF1D62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6xnfgs2_vUQ7kNvwGVtfTF&_nc_oc=AdpzGl-nLV5XkuABW6ydIfgXt1jdKZZN9xRnsVPC5MKeetQ3PzM2F0rb5IgRkE2iX-c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LxOWr5u3WNZndD5TuKCzph9_kxS0ijb-z8uREGJsE-g&oe=69FF3818"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQPGlPtBmkIQ7kNvwE4lO6B&_nc_oc=Adr_A6uBdGTqd3bJ3fDM4_xQLCcj4oaJvHILgmooVvOmohDA2xQm6CWjvrwBpnbi40g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UKsFMJpe4obLJMb8_tfPMByz16bIsNsTMcBlwAp73ig&oe=69FF2CAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_x8OCBgJwEQ7kNvwECHn3V&_nc_oc=AdrDv1XSvtBsklSNbaTfafPFEhFrCjpXiccykouipILcbcmHmVd-MoUKg9znIPWBNis&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PHvALSzX68-gc8wLPLP4JYCLHk_AvH1_HQcAUWhC4hg&oe=69FF3042"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZXX1JoguU8Q7kNvwFgFswJ&_nc_oc=AdoNgd9O6k7jENPZ3aZP1dS3xzRwRmULxOAgD0RB33coO1qlV2vlS2ME7go1Dgw9ZMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L7fp03rye4FqdkNGSMI9GvBa2yrJ8vMkDuM4W_jWotw&oe=69FF2C07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dYoWBSVn7cQ7kNvwG3xZsz&_nc_oc=AdoejrNFxlRcp3
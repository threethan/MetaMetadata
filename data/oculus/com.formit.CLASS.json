t-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwSenOu42dIMq1jGNNngneMPoiob4dvCXX7KUjK_XarnA&oe=69B56956"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC3kCTITMsAQ7kNvwGi0nqJ&_nc_oc=AdnH3aNxhCdL9M6XGKODkGFob7CDOuuDm70v-7IlcLb9nfLbZorIZi6sazI10fdOegs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx3bJOdrz1hLWpYV5osq3FPwBH5zJ4XVqNEE6bBM-FmLQ&oe=69B54962"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsyDBxS3aAUQ7kNvwGscEUj&_nc_oc=AdmV-0M89idEaHjSBkpHtPAojIWiaV3o4nXMBy-ki0fx6EvmNrzt4e22Z4qo2W9LnaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPKvCqAcGYxFXBLn1_wkqU7rGpuy4oysug4JQWPZO8fg&oe=69B56418"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Qlvtbo6ClkQ7kNvwHiT1ia&_nc_oc=Adkzg_ErOd21FXxLLLdsD0jtSevZtd41mTlZ_4RlzHLh1e1ShFkw0bcdebHLBiRYrWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFQFq0iN3sU0ATF53ARqw5YBffxRWD6SkhCcYx75KwKA&oe=69B558AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNPDmkdSvIkQ7kNvwGV8AUX&_nc_oc=AdneB7YgTe-_EcVzJPuxon2bpsKVzQ_JW6CWYLeF_Fkpdp3dFc4oqHXA89zrxv59N5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzobEBcTyeMyEPmnkNREdfrXWjz8l-0LbwlaPodBPB26Q&oe=69B55C42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWbPgLFCOsAQ7kNvwFDnzkb&_nc_oc=AdkKZah0a4eAvwnAx679eNrgUT32quDtio0Kj61rxhP9i65mJ_iFm9jJFvPq4jT7WfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRVot1o0L2tJNoZ0gBp_Ev_HT0ZB0wq_lNvVm1aZnwhQ&oe=69B55807"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4WrXPbfFR4Q7kNvwEUKtkY&_nc_oc=AdlSmngwjvRkKpo-qghrGtzIb0FjOGzjxbcMjzbhtg8VNJT0BfEPgwIAXBTY_8zOGyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4EinFDg_p2kWSN5VGjypNx1ALzdFir8KnO5vytofgbw&oe=69B565EF"}, {"file_name": "Progetto sen
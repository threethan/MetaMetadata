63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnnYsWNRakcQ7kNvwGgfTz5&_nc_oc=AdoZKfbIARhA9KIBHPaFslRzsvV87iPuFp5h97DlKl33xkwXDnYdt7FhDlKTfZwgN0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD05hTJbYVl6zY9GCZIbuy3n7PWbCTx_z9uY23zsixqnw&oe=6A491156"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmfDxQgi9sIQ7kNvwG8G7bR&_nc_oc=AdryewS35Qaw_KSU3ndku79hfyM0k7BZECSgrSzSKXkmYS8cKowy7-tOTr_XrFioHRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5ouzycyTdJRkd49qkTXx5zUKng-wYsg5bqPFQMxgJDw&oe=6A4929A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_BOoX1z1VwQ7kNvwEirtqf&_nc_oc=Adpn4pX0szHpmotAfa-dI8yPQ-sQNz0so88pMDRYUtU96-4QS2v8Ug-UKxnw0e0yfRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAna4LDiKYqrPYEkv-s2LuCYs5CKFBIXJ5omLE1pKYVXg&oe=6A490C18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5OukneuRlUQ7kNvwGIqGnn&_nc_oc=AdqLNnKrs15X_avtvx1TCg3YqAlgfRWBGryQKN9-HvqMNTfMRduTYrukQGhGTDqUjRY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArYo4Wwvmh-IMagURz5a4iG2RgyTeYGyRbhySrDCCpzQ&oe=6A4900AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW33BsCgQokQ7kNvwERVEpt&_nc_oc=Adqs3vmGS-pu2bhLHmRtC5OLzycd1Sey4QwXuygUTV0DYmeM235zSoSBDaUqqxLqNRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXu6BFHmr00dq5tLg4IWZUZk8iRTAhEja6mXmzsbMMIg&oe=6A490442"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK0jvH8zG38Q7kNvwF_FHk3&_nc_oc=Adps2nq-sjGxmiy74kKmsXFA_J0SNFi1GTOPkiUGLg4f18AAHIHUjlyCSMrilLaPfK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbt_9Fk_n18dcP2s86oEy2LZvJg60s1uDQltCvJVvExA&oe=6A490007"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3thPyQVcDckQ7kNvwGdVZO2&_nc_oc=Adq_lI1nUZjGRn
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4qkgDS8a9YQ7kNvwHK8ChA&_nc_oc=AdpA4RWqgGnw9ZVbs88OMQ4DmExrBKzrVC6SkHCrBtizC4GBZn5ZUdIRC4jvOPqz1T0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYxwo6hxPslSmlLsRulJi0ccacOZ8ZARfdTj0nqNSa5Q&oe=69C53B56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xh_uJ8t2vukQ7kNvwHlIyC7&_nc_oc=AdptFNGvS2OhCaKR-og15ocKUx2DueX4Ailay9CI8WEwdCOOsS7W47e-nr12jSYFbNs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySafFMIwZcgNPm6ffxGFoD4fltO4a_yi-ZCbrYPBCaJw&oe=69C51B62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWTnahXDo64Q7kNvwF2R0Ax&_nc_oc=AdoxjrsCPP-hrXyk5H8ZeedeOcmHcsk1mgxVyNE3AELrG9gzCA8vOJSSjzq2tD74bB0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzczq7P5sVMq6pk9iYTPjFuzj-SjKjVzm71l3rrYCoVDg&oe=69C53618"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4J-aQii34JEQ7kNvwGWG42P&_nc_oc=AdpvjSbyGJNE2OGNGDUuQxez8ncJH6aT6ZMVQ7zmlcUS72PDYfKxp4owU9kjHZBStww&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrIQi48k-rKR4nYhXbjqyTYud6d2wkidK4j_ONuFuLXw&oe=69C52AAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFnIHZ2RIEUQ7kNvwHml1Wm&_nc_oc=AdodYsxHGzh3Qvg_ufWR5fnTZDZ_w8tNcXal8NeLgKsuwW8zBe5QF_iXLBQQADYd5y8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyEfvjAnLSGyUz_7OPIhJR-xKcyxIuWrjGXwDxNGV0Avw&oe=69C52E42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoXBOO34BfYQ7kNvwEv-SL9&_nc_oc=Adoo-ZtyZEgfI0Svgp1GHiH0xRKMzf-HYVDfy1fJIZ2sJ8H7wbow44yHo7noS7gx6iU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMyauUCN_nwp4EdEdT7a-iSia0oqH1oJKGtax8D2QVpQ&oe=69C52A07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmaxIGskljQQ7kNvwHWOjdo&_nc_oc=AdpgWtNe5XXqId
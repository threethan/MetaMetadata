63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEvqEXSt9BgQ7kNvwFdf4CQ&_nc_oc=Adq09OY-K7jYEexN3XYB_CaglibzC_GIJacyFDPaWSKOsEZSu2uLORjGMl96PgkAmFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ITeJ9erk-n6mUemwRt2DwkNsS34Cop7BeMt_sIB9wcw&oe=69D26A56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4K5lZPQuPYQ7kNvwFuurn9&_nc_oc=AdoTGd5BEhPQzhUDtVi-xEA-x2hwEzhmTldRfbXfQtcYukA3KLr7oHEPJz71mNU-oWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Oe9b-y5QATwCXYbB_KZwlzXA2bt6uorrrNcDwDyA7KA&oe=69D24A62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1rLuM5_FhgQ7kNvwHjcLP6&_nc_oc=AdqrBpn-D1szQP3XFuY_6SS2xG88fO1yqJ8ZsKDMxlrvsS7C6sPrDYxgmE4Y-05zr2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0suqxwJkO2tCVnVI-wu05EuIUUZiqW3copvfsdvazYgQ&oe=69D26518"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBl5D5Y1eMkQ7kNvwFrWip-&_nc_oc=Adoj2jBqZcrItb7ecVKibPyhbjy2JkXgPp1Sy9LBN7blrvaqrZ5DGV9ZruS19GDAqwQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1V2MVe9YgAH0Ttifpg7cprp4ItGbqdhZECkuCTihpfMg&oe=69D259AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOhTEBkrbEYQ7kNvwHn4hr8&_nc_oc=AdoNkbsrwNBCkrtvj1Zd7O0VdfqyBs8GgsxtHP8Bnx8aNm9_77NJoQzl1Hn0oRIvUMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZCUDtXM3mTBl-1dvBpBqhbjzMQZRUaHq6xz2Db1xxXg&oe=69D25D42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npB8IaTACysQ7kNvwH28PMy&_nc_oc=AdrQ0GtkOENnozTbTXVAStoOUl06FFwOiXuR911CvyOpAZ7TBymPeoLUKOJB7r9ruUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af059Pec3Or0N1h_4ECP7JMjc2JY4p7V1nyhfePzJDo1Iw&oe=69D25907"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vQG-kiT2XkQ7kNvwGAyOVz&_nc_oc=AdrG98e4JAIEN2
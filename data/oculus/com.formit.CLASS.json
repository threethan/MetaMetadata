63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66tK9wrYlwcQ7kNvwHmDKBb&_nc_oc=AdoaI9XvUxnPC8C8MIlNQaoJlz-IY0RrjqADlNt20RlFyuIljugeLpJZh1WaCfKsf7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ghZq9WBYFi2MioTYsrTbyMuRONRlviik9NkiFL16vWw&oe=6A0B1AD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh1BWJd3bhoQ7kNvwHvYh7r&_nc_oc=AdrfQCeapb2kQigdahS2CjTzIDSPX4c7DGZ4hqz5PFmCEFOCy72IKfyx2d2ZMOZK24Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P2uKTMosrIFfMUgzrYrjBRcv6FrkqoTzlgVjwhr6SXA&oe=6A0B3322"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_TMLqof4t4Q7kNvwGN6w8G&_nc_oc=AdoP_g3nVQNWeqBRo2N0DbPmT9i00ThsADBRDYxi6Vc86VHIWdrgh4z8Hi0YY1igurY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DCkJ8j1ziBPcASssYMZck01H3mI-D1lJsuq355C73Fw&oe=6A0B1598"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3opkryFsEHYQ7kNvwFXNwjQ&_nc_oc=AdpLlwbQIghIspmfhAaCqs47wmumo0Qn4eXSDEAqaRiUA_UR2Of-NUhpHTfrdjSLwik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NKY93oVvWLJfJn7IW3M_oawQmmV1MSvRnnKo46IKKAQ&oe=6A0B0A2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GieJkVnRU2AQ7kNvwHyq4mZ&_nc_oc=AdrUEmeEyo8QihVtmM0ankWZ5meKzebukFT2XwCnkPnSQpV85LBaWqajvWggxDqAYTA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DcVpQl0efl7FvD8dXtwgq7M3YWEQ_eTZTOoTiHXq0Mw&oe=6A0B0DC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw2gAnOZNm0Q7kNvwGC_KhQ&_nc_oc=AdonkUE0tnK_erMcIG02MT5_CcO-F5TchJhrmgKXYlUg1ulz6-tgipzpzQICiyYH7j8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4M_h4BQyjWmXo2kelr1jDXNOh4ul0yOhwn_AxfD3wNiA&oe=6A0B0987"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y468YuOZu0Q7kNvwGJSchv&_nc_oc=AdpBg6Q8S-YEjH
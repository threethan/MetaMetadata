/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mjyxocRE88EQ7kNvwGi8OgZ&_nc_oc=Admgx77JrT1irEdB4OC5dIm5tlI_eo81W8coR3v_b0fPdRev5_HIUorlaKSIC526_hI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjbZd2IuoGStBKA3zZVeJXEdE6GBZGdbAS0XcN3ABH7w&oe=69BAAF56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQzHq6cAXSgQ7kNvwEFbuNZ&_nc_oc=AdlJ1VwGjH0b9oudaYMwr-l3gktf2j2gEh8E9OWGaNUz8VTrrjkvL88eSMT3GiDUPYI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzffbU78TAa96MV5D_6gKXHGXx2Ey0l1XQErEZwkRWVIA&oe=69BA8F62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C78RbX8fE9sQ7kNvwGT5VyV&_nc_oc=AdkKJw9YiAjdIwQKnOPF5B9aaYhsNcpwjBAx1SJK666tX-vh8_aN93Jxy9lzQQyeLBA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afyj6FaHwgLaqNRAFpMjy_oZB5ZYk_V3LvkAJVizkCVInA&oe=69BAAA18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBZ_-7tJOIEQ7kNvwHlnks5&_nc_oc=AdnUgTWbc10fW4RCtPCAxDMOaOfBHllBLVr6AeUmo5i7_XDgq6Asf50ZZR7ftosAFKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5OXWS7IF3rS2TnnpRA0CQqNJs2JI41gTQJWFjFJAdxQ&oe=69BA9EAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFN-7UW6MaMQ7kNvwEBX32w&_nc_oc=AdnH7wyjBQQuwx5i9s5RTYh1WovwD0bZ2cGfwnvV1FSEYBMV8ykuc3ahfhkvJYJDFgo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIOPOC0bCD6LOEJwu9RSwKu6NSkVrsvuLbpYVYjN8I1A&oe=69BAA242"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vSGjEGttP8Q7kNvwG2OSkf&_nc_oc=Adnqwat8OpphyMLAD4wIbAXmu-afngL35YxWw9_B0Vbsgh4mBABb9gMayKPhAJ8wbaU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxvJzwJ1oRWQJ0ffGmZanguhOpUIEjXhTu2qT_vXUDwMQ&oe=69BA9E07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vK0XXfFKUoQ7kNvwFO
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfRjNHjqflkQ7kNvwGiBSju&_nc_oc=Adr_ogtNJElMCrmY2Jcp_cshnivo2iI7ewDSPQHaJLm5EY8DJs8OExkZ1LesMsHqsK4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92thdBezgK0KMoa4r4tuC4CgQoC5xULVW68FSvI77S9Q&oe=6A281BD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQiiyD1YQdsQ7kNvwHM1KY5&_nc_oc=AdppkEcIufktc_cdsxAum86ODzmPE7wSV7kpjjwLDRtwh0p9aKejJByd2_4Ci4uHF3M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h0JddMzFxBBTdYjRfQ8d5q5HAR52NyJqHiomLp73OqQ&oe=6A283422"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcBoxpVofFoQ7kNvwFkRBGa&_nc_oc=AdpuONHXrksuy2anHlDpzVMY35-lBuee2dMjm9uP-BK1i2_y_LY6bwNJcD_o20PcFjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tlD2OtamT4esgCxpmbhcRuxz2iAOkbuJdxKi8ux9NCg&oe=6A281698"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qu6G-ChPq0Q7kNvwGJF0wj&_nc_oc=Adqg1p7qsDeYBUJAhV2-iKDJB4wqfUoveKKQYm1NzrmxwmqZhaNDn8O3GLgyaJr9hW4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ljxU5lPC90gtnfaJ8sJEyedpiJmTVqSwxmNyAYjwmrA&oe=6A280B2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoDWBi6iiXMQ7kNvwGnUGoz&_nc_oc=AdrukatIk36Hq0jHrvTNTXVwFW37mWXH5ogCZmD5AztE0hph_J6ohSZt7Z2zcfdUQhs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W7noh099MCEJaS5rO2Jt2sD_u90raHfoCI4711iudng&oe=6A280EC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02HH4A2CosUQ7kNvwGogdJT&_nc_oc=AdozDcxaCVn1DLhmBF3iA147u4yYVz16jtspKeZlhPdtWN4Pbh-OVYnqMupjJF9o6hI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m1ExF0owJ7iqMlhEaL5u8L72wdfr7--sM90qkhdOaIw&oe=6A280A87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03MmrJJ_jXUQ7kNvwHMpPqk&_nc_oc=Adp-8XXdUgdoyJ
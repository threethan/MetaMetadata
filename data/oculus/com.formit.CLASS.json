63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMVtHHWIHzUQ7kNvwFkB9Uu&_nc_oc=Adou3tPEg0OkAFRzvQTb00gSGCUd6F8f97C5Ap4WoL8U-LiGrBfy_ACnyK2whTYIV4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTkzygGJkvnkwkBpewImkjIAwTBuxW1f0ty-qnyU_skA&oe=6ABE66D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KC5tj4yITFoQ7kNvwHzP5I4&_nc_oc=AdrVNUO-DoHDK-tt8SYKfZcxGML7kjRfEY8NfTxtm8bHbTZ2-b462JbneWughplCJ8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBdyxM5ki0ziiG0u_MuxjXfNmzk08EXM7FmAZWsc02Qg&oe=6ABE7F22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvYOFohn7WQQ7kNvwFx-T32&_nc_oc=AdrA-MpvRhbqiSguFn6JJnLK-N_V8b0fE7Ezool5l3AQ1rZ8T3JK-TvPEWya2oC3aHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9wmlc8_mwKU9jD5aFycRFCw6KO2Kt1UkDt9VtPMR8-A&oe=6ABE6198"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvwWppIfU54Q7kNvwELI7k4&_nc_oc=Ado9xMNs7yZi092XrwXi5kO3Bvt5JXbS_pMLcnnZNQtT9gy-k_rjeL29uQrrzUvPIrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsCKPSnO1jtLezt2ce2qPMnqda9G_mchJNU7r2XSbJTQ&oe=6ABE562D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7hnF9CBFQkQ7kNvwFt7SNq&_nc_oc=AdoCNaqmGCbZX9RVYJ-87r3XZxo-jOT0NotO03uxu8iwsGNioy_gqB5KKbvmVSKickY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLke65diwidz3wylX2Scd-bJUhmUp8ula5PpJSCC2ocrA&oe=6ABE59C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHgptRPKw_8Q7kNvwEHGSjx&_nc_oc=Adp68XK3X61UGLsmOoJSq9tuOdfHbVX7jHLg5r9Vf2EJuFoNm1R5aUhSf05A0uqhyCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN3P6gfjqO8Td2Ft3oGLC8FxsDDWP7yqNxiHirppVztQ&oe=6ABE5587"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhoIZun_ghQQ7kNvwH8duAx&_nc_oc=AdqXNCNLdZYeVL
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHOLW7huQ5IQ7kNvwHxVynb&_nc_oc=AdoRk45y7EktEZgU35jokwNrer5IBB40lKEz48OldQyHWQ9DeG5pvhUPexXdEnPVqnk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7YJO1ghpSuefspEQGFhf9UIJFEm8iE9lkVNMWLnPCrw&oe=6AC7A156"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsMcUDXpIBgQ7kNvwHGWTXs&_nc_oc=AdqVZv2Sr0MLQtOpriFmZklbPp5SIuPaqSr-0puPHzGaRViKVyeprUbyTmql8R8-flM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA4fkCbcYI8boVQgD6bAgnLliAM9psQ-uzYHdcPPE9Ow&oe=6AC7B9A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMJ9RHHt-qUQ7kNvwF13Z2v&_nc_oc=AdpVNE7ndYHbBQgIKxULT1s1nIFFyNQc7bQTw9e2YzzfOw3x7zfoFexoHf1CENxxg4Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYNRas3VGxGWYs6-JEAOpFcUWLPKtKj9d2L2OZUQVoYA&oe=6AC79C18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ig_MhsLMQ2cQ7kNvwF_mOvM&_nc_oc=AdoDN91A-UOHihr-K8HC0Nmf-vNuLWZW9HVP8Uq-c3Zj6Y1ZISJOzm4N5a4FvF4R3pY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOctuWwoTQCCDDZ3XUY4DPJcWpwYg6mgW61KyBfwrK85w&oe=6AC7C8ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4ae9BiOSFEQ7kNvwGrnN9h&_nc_oc=AdobbZWdUViIdyBIwmxVZ0Ati3eQyKFmaVvl2L9G2dCIgotvY9OCN24jGzIH1KWCMnM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhRwEGGP1bPCjhdYXV3xLEn5-WbLnfB6Jvqk_TMRixOw&oe=6AC7CC82"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESC-tv7zmM0Q7kNvwHwpESa&_nc_oc=AdrvpgLNyDTDGGLUFQ_9N8Ioc96t-LZ_VPnai9dHrj4w8BZ-IPEPtyxefvYyzzq1Rd8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRIeNAktQv7-DFnk4VnFKPldPd8z5qq-I8E2CUaw11rw&oe=6AC7C847"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpAfQqBE--IQ7kNvwHJQ0DI&_nc_oc=AdoYu-Myin9RIy
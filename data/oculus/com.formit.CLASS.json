63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myh7JPctfBoQ7kNvwGY9BKJ&_nc_oc=Adpq77M4ltruDUpaxMgVTlLOB6cc-Lq8ck8a7y4kEZ5nDWvnmlb4VdqO2D7ZNU3fzjc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10BY-WrNDT9rP66h8o4KPoyYgOp5ZMHusFT1a5G2Q1eA&oe=69F35FD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEXWGw-he-cQ7kNvwFGWkBX&_nc_oc=AdpOi71Te1WjE4FQZax0a0VUtyuE63JXVD-eNhbpS3h2jfVg1BDa9d-8NgXiBcf0GLA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nXMYJZojyxFVHeaTYbwPAXxRihoOZwWtizCIK9F9LHQ&oe=69F33FE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eItqRlWRpOYQ7kNvwGIEiy0&_nc_oc=AdpwRi038ztyj1CgGofE6m1zfjTPvjyNstQq9TqSTOCkCcju8I2H-1ZCRF5UflW8zVM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vZqdVzz1RwSFTl0WaBo7qqEhYN-gXYPS58euiDCg4qw&oe=69F35A98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e8t_rrHZG0Q7kNvwEDbjUA&_nc_oc=AdqeOJlR6VGwCXtLlDHRO5mCrtl5a81Nf76Jdx6L1T84PukBMnjPNMW4qWWZ5m8EdfE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00pw8NYq5iURknmO-90RH6tjcA6jhkpwQXbLm5u1SrtQ&oe=69F34F2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYHU1sCrKmMQ7kNvwHZYB60&_nc_oc=AdrlUERqdzawSKx_6s06dqSmEylqHAJS_zYIR81Wx_t7XbVKxGTJpSzginnqRF2ZnIc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2dtqBACjBXabMDlAyt9RtAfoQGdW5Pq7Haf-ypgIkeJg&oe=69F352C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEdUPbKqiRUQ7kNvwEOeAJW&_nc_oc=AdrlqJQ09dXH0E86Z-4A99482Mmv06GW9JYQtYrznmNN18dUPfk7a4hgVgRfCPbPjeQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3h--ugx5UtV-bMSs1Z4Rn3WogaHO0fXLwbyJIEc9KXJw&oe=69F34E87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gl_W0p0WRNsQ7kNvwH0MrPz&_nc_oc=AdqD9XNlPxpOEh
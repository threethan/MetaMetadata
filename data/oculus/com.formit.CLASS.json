63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66tK9wrYlwcQ7kNvwFIDyio&_nc_oc=AdpNrfj7HW-4Lb9KsizgF_8hgnY2t4RhgyYrCc2rZjn8uLBRL4s5vbeTUq71il5pWLU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jmdZfg6W7qZni7OVaB1kIFNfunFQWqLD84f-nMf1A7g&oe=6A0C6C56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh1BWJd3bhoQ7kNvwFlhNMo&_nc_oc=AdpZY5eBnvJYhoZGfYEdlWxdFSn_Yy_R5Nrvz5dw2_60Ry_b5I4jMXHPVSs5HYJTZjA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4q-CMOWjM0v0Uj2XYWN1wSuYZlLBc3BxrdDSsCZr68rg&oe=6A0C84A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4uo2rD_RRMQ7kNvwEc3iGB&_nc_oc=AdpoF4n496PxHrK7BeGVb9ViqhpA2gL5rhZjNQdclPK8DSwYHMy3aji73LlsaPNYXpU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60MoPEZaISI6K9Zzl11B3VakMggP0WwbgVftcUTGqHNA&oe=6A0C6718"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYkqyfoN6JEQ7kNvwFr8Xk3&_nc_oc=Adp6kSySm5jXXesuyHJa46U4iDkJiqgatFnzkLxQdrMHEov7rIVmD1P7AA6-xIIcvtw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6voDiSrb2xMFAiZZEw5Uq1EwkwqRm7K6QhqZylAkKOFw&oe=6A0C5BAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GieJkVnRU2AQ7kNvwEH-zzQ&_nc_oc=Adrk9QPNKLLr3X9Anbyeo52y9kuZKeMzRxrxOPEtHjUfzhCP4_rtFVqxasnw7TKySxA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VDfMnGeVBNTRqPq4-UaLy9v7ro-e9X8bgQNIuf18yGg&oe=6A0C5F42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yw2gAnOZNm0Q7kNvwEkjtTw&_nc_oc=AdpJI7AhNVZoskP7OJbN7mPKzY9OSRpjK7ILxIK4xIbvbvZuzbgpNF0oVpw5VGwJEvQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gh8USelff6o0SJIIvFRRU6wkVMneZV4qTtq9QNMh6RA&oe=6A0C5B07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8y468YuOZu0Q7kNvwE96umi&_nc_oc=AdrPI_-0vg2bGj
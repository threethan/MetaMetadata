63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5d8WJfBl7W0Q7kNvwHk6IVO&_nc_oc=AdoG9ZQrA3Vr4p8p8xoY8ECNu-EMI64877LBGyBEp7161VP4w0FInZqIq43F9Rm4PjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MVKOKufRdcJ4msBEOEsimMN72vLgU2WB4ioMf-oxW-g&oe=6A296D56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQiiyD1YQdsQ7kNvwFbM6xC&_nc_oc=AdotZuPgh2o6lGndFWVoTLMO7lsUmS5gY8V-9_-QfRjb-C-nidp1-2cRpCSisa4mQms&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hwPwLrSxNUrLLqjAZU8MX8N9qLOSC62metkJ5od1v8w&oe=6A2985A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcBoxpVofFoQ7kNvwHcyRdg&_nc_oc=AdreIXP3zPVggT_z-iHeTNkDcukPP1pQVAPjF17e5orOw8_2Yl-CTLGqm8-B92F9GiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oT1ASjhWUPoWEbxzzPwV8iss01CHl7-q2EPe1tLmCRg&oe=6A296818"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6qu6G-ChPq0Q7kNvwFMx-Pd&_nc_oc=AdpejxekImXrwoaIgu3-88AyxVesfmZMJVWFWmUQoYNxVk-HfuYpoxvB0oS3F931Fmo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UoAJ0S0rTNyGRTQNaA0xDpmW27jCbUxNohmv8xBdjmQ&oe=6A295CAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoDWBi6iiXMQ7kNvwG0FNfV&_nc_oc=AdrH2ZX71o2LsDdhYGA8L_NVCOWMrlXc8MF4EH1QmWjqAIl8LaBJsDkvgfa5ckI2A7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mVhmRq7bLb8YhlGRbZFdwZivGJ13TbO99Psr-OA9KtA&oe=6A296042"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lj9FC_Uk9gQ7kNvwFG4Yll&_nc_oc=AdobdH54puHBQvddXLOKYO6fILnT2dAtSUjP8x8gBpQxNwSzYJblbDJZ9FYS93nneVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NYuAQRV7AGi3B57vO_rN4Kb0U_-pmqpHP7Q9lWLcbHw&oe=6A295C07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=03MmrJJ_jXUQ7kNvwENaaHT&_nc_oc=AdpK0aX2GZoxSI
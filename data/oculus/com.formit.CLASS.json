63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEvqEXSt9BgQ7kNvwGAZrmO&_nc_oc=Adpz-IcYIgnU5qKMwXvwKrv9mKdkrgfsdXv7vhR6vtPVhC5ylgoXR7BzWxUOzwnVLlY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gh_eLzWSGxMPte-4I4DCfF-YiNAiiE7QFOjduzTUZ_Q&oe=69D50D56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcsTdiouYf0Q7kNvwEmn-_T&_nc_oc=AdoFJG1CG0XMx7vh0tdqNX4XNHi0g8r73qEXtgi2Lj8eLsfSLJNKyx1vZuRPuc6Gxlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jHdWpLYmNELZP7ntBL3zHO0F63ltdtxPNyatn2jSxcw&oe=69D4ED62"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYa0QqAl3PQQ7kNvwHQcj82&_nc_oc=Ado7jNIkpuUDK2hJHV5R3RmmuuWmKKpJozBvLrb8BTH5nM5E5GkJfAi2vgKsQTNimTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pLatCek2CjQQ_X1Ah3FwVrXL6js3TAJs62QFCLo2RKw&oe=69D50818"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQH9eu_2PVIQ7kNvwGXI9--&_nc_oc=Adq7agWhE3jVLlBmjsYTAZ4pdpUW8x6DIEDs4NKfhSQGQfhBg40cYC_4jWFTovqEhTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x-PhttydFj59a-d9GTFc7jtUSGDTz0TH1Mf__yCwolw&oe=69D4FCAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZrYFdUpZiQQ7kNvwEcsHIm&_nc_oc=Adq2ysJh_ATNRJesr8F5WdzvAFYP3ymPHLA9lScC1g9x0OSh0un7RDMzl3dHn2UOZgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GMmI49e7id1wAuKdLF_Skzv_5Vc3x2cWE7PAJKnnmkw&oe=69D50042"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npB8IaTACysQ7kNvwG75X5o&_nc_oc=AdrSN71XvbtSIvl9JC5Uki5EH0PixNYiTMPBcoS5lJOa4f4cdp9J4FhZE4QNlxP7dd8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qBOFE7TMUNiET8SDk0L1iDjuxdV7hGW-ZiIE8oYU1Tg&oe=69D4FC07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKQabZ21uycQ7kNvwFGm3ti&_nc_oc=AdocRgBra2ciIg
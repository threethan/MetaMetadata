63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN9uLDNszwUQ7kNvwH4PjVB&_nc_oc=Ado5i5EEWFepHRa-gp3QQKyJPnOr9-atkmGWbbc6G3nGeYKRoEnwOMwI3ZTBH9MIqKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGtR4B_-YmQuDfQ4KuYLgHn5D9yw-zEOtPBBkzI6QP_g&oe=6A997CD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLU0DpPMU6kQ7kNvwGbJ5dp&_nc_oc=AdqrHc3KOYHdWWrf9zprYOqrhk5M0n8XeAV9RuSHwz4grD6BDDCXldSNE2V94-DrNMM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu0eFl1uz_pTnjagw4Kfg7zzCc2f1NZxV07fKE6REQrQ&oe=6A999522"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2coLFSirYIQ7kNvwHv2Aza&_nc_oc=Adr74SxH15u5JtbFfDJ7DUkdFnSxP8zrupAIXcYzIox_gZr9IT1WEUGtWIWOFo5PKTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSLylHu8awEzcTvdcZGXRiByQGIVUdppdFD27z7bELUQ&oe=6A997798"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7tQu-ogncYQ7kNvwEanQcI&_nc_oc=AdpxfKAvC0E89yD7_YVZ4VdapIGqAcGNSND9ps4HR-L8jXrmQqX4IDaGoSp-QQZv-s8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbIGZrDXrEDKjNdfovOcQESmyCM3VlPTEMtgxQGkNGVQ&oe=6A99A46D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsP4qicByNgQ7kNvwHwuqyL&_nc_oc=AdoVR9UhvWXZ3V1oD4XIx9OLL4q7IRX7PqcHoZRTArvsZP9KlwmjcPl0S8UtDX1srA4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIYKo2VdOG-EiHzkhvBoUhSrrcS4Hpo2SM71J2WAvIdQ&oe=6A996FC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkCBQp5jeTMQ7kNvwGiYNoH&_nc_oc=AdpvK29LXqD_SeyxmDSZooYyUnE1bRFa7vZJLQ2zz-KSWPx6B_IYli57rEtkORS3GEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8HYKj8hc-cL9ikQdahqkFFrDAmfbz0wHWW-_3mK_xsw&oe=6A99A3C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZqTADNfurYQ7kNvwHicTU6&_nc_oc=AdpetUwmyHWIOr
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pu7KG-Pg5QQ7kNvwGW31va&_nc_oc=Adr3qjnMty-3RaeclB1WSxexpZ1ZqryBcBD-Osh-qF7gnXWI06WGBvUAI_GwnOIB2p8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xpm5LRic_mQedOWM3NHTdggx8XMLyxK4MdtLBPC1bJA&oe=69DE47D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk0rPKHRmJEQ7kNvwHUfHMk&_nc_oc=Ado7TIfEwKymz9b73lDq8YWblycjHLBtyXoWg5pDbQxK0UXw3q_cMi4LOqGCjWdw2OQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z7uQl5eVMVzPvB10r7gQRfeCLcMOk2Q7Z0HD7IBcVqw&oe=69DE27E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMX33S2l7NUQ7kNvwE81Wnm&_nc_oc=AdoSlXV38vGWYT6Oxvvs4aNMIp_2lU8A2Z1Z8ml3JWh3U7WLGAqr2RQea6rDzouFCDg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09lvBGiPDy9w6HqwwYdM-3So72QrIHMN67WSXPTzu0yA&oe=69DE4298"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjldeydZ09oQ7kNvwEBN9M0&_nc_oc=AdoyM1OUck4pbs6XGutaexBn0TOclI6huLff2a3E5m8HFFmWB5fsCoP_AfTC6da7XZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hl9eA4ecq1cFQEAVw70w4ldVjYiFOTXB5nTybqy-1UA&oe=69DE372D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1H47EUa1eQQ7kNvwGhkThm&_nc_oc=Adrbs2A5FQ0hKi5cmt9pg5aNLjXvrI0Gdr9aztVXrcZsENbtoiex2ND4qDQiuPeQEew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vTimqfTnLVpxbpnxeJVZk0V_uK82RhMI9fBDyBLsWZA&oe=69DE3AC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M1zSHLsqnUQ7kNvwE15FW9&_nc_oc=AdrYm5YNkxYLh6lsJXI-yMHeikYTlzOyg8Vv2lFvGOULix_F0_Nf1XoG7boDD9knmmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZTB_CtfZiNjdNkNLjb59r41NOqEIPWtrJpzrzbDw7Ng&oe=69DE3687"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YMVz1yWU_wQ7kNvwFpgkTZ&_nc_oc=AdpwHl04NIoBcP
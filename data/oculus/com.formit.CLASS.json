63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuTRmDQ-jJcQ7kNvwEZV9HN&_nc_oc=Adrd09kSnkJEoBpRX4MowHku3Y-C8yJn1pb5nk5_IryerTiXqHBgok-MfwA4dQArQw4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN25I0BJxTQtcgMP9dO-uOjZ1TNCo8yZUp2g0s0Z80JA&oe=6AE896D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hax-Y24XPFcQ7kNvwGRLuT3&_nc_oc=AdpdOSl5SryP3LUKC18bGIUrocABbrxxp1GK8hJhj8ol6OzHteg3C4Ghdvq78GjdvaA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRUjWffzDBbffswswF3B3tylzbC2cxEXHmeeF1r1XnXQ&oe=6AE8AF22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnGRZ-Nb1JIQ7kNvwEhHJ8H&_nc_oc=AdrF-Bq-TI_nuzyIKdluNBpNUo6CvRwesMwazPQBKi-gZWal5Bm-uqxkUiAYTR8zNb4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy9hFrhzhFjUh2VrOenhc3x691LZ-b5_DOdLBiTy5O_Q&oe=6AE89198"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCS1JUblOcoQ7kNvwEX-9nP&_nc_oc=Adq7Ty8gqPkiOXfQiao4rgnVTEPJieD9OKpuBDgWZm__8rqvxlPBxz6q6MR0l8_4yrg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7Vz3gMWQoCky96OFi6PLpzknzUhoAqK9JBbfr8Rr2NA&oe=6AE8BE6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzm4GkFDp5IQ7kNvwF-aEQB&_nc_oc=Adpt7-GaRd2QHik-n_ymx_Gw_WjGxXO4Edo0nJEZRUDdyGzin6__MwCzNYDy5lmIivo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgrFsXdVAPFtp_-UssVrXDHF7IjX3cktL1OghfEkSu8g&oe=6AE8C202"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKefjg6VRk0Q7kNvwGj2OCe&_nc_oc=AdrW5aPg8iK1zxewRl3nkr0cUbYVJbeDt_yskVeDVZLezjGjutD_QI9f1FEZ-gLv1zY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUcqycjaZLtaxGBxtl63ctd-X7ur21x5Pd1mKKvYFiOQ&oe=6AE8BDC7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41hbZQYm6lIQ7kNvwH35KmQ&_nc_oc=AdqTxkaC8XZerQ
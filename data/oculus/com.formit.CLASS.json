63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRGNoZeqC7YQ7kNvwFffwLj&_nc_oc=AdpHA0Hv0DxOqdNgCh88r6oMjolEol5kqbA1Qr3T1kfNp61r6dpTpxDh8rIub4ZR8Is&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y2ZiIhxIA1sQjk-_0VoTStWt3kE65kKnkwqj-PJWhNQ&oe=6A32A7D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktYrkHV6-KQQ7kNvwGu5CFY&_nc_oc=Adq-yTLSneDM7AvCjWDHJAU2LEupbEtECETgr9gt1DWyfFHpLraYv9MkDTpQwPxcwzc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mwnJdsXccVPMB7eswjU9QbuuA03TgF7fOCd3B07jqdA&oe=6A32C022"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emam9S5c9I0Q7kNvwHMKgRG&_nc_oc=Adp3ryIyX-X4unCwOyn3xdcqiPQLZyPeneEbtiYNlQvNEN0izQ04bkpNqVcl0YGfFM8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MFqjXlNGyaLlmJOB7Yolx6vPg-TvwE9SDvBKlylS6FA&oe=6A32A298"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL449ywSWLUQ7kNvwHFxesm&_nc_oc=AdoVVtty6m7u1oPZHKdn0l11kJ1tUIkNOA0K-6cRWBzd-TuUmUA2XPf01riI40d5GLA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9o6daOvhHBN1ft8X69KcopuMB9vu3SD7kWGaDVwIWc-g&oe=6A32972D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsC--ePUf3MQ7kNvwEiw5Jr&_nc_oc=Adpykq9TjbFXfvRXzC2CI1JGV5ShFRYpQFsZ64lNEaanGh6Sw7-UoQoTcLWUZXLveUk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91YcuWIYUF2GtwfGkMjwlRJsRj0pQZDCdVpF-d2EzvCQ&oe=6A329AC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6LV6Ad38sUQ7kNvwHDWuPc&_nc_oc=Adp34viHdIJJDSPg1FrOD885uKCEnFNc3PMmUqZnXrCO156lR4WBz-2fYchEkgDqdZg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83mMAQ16K2a-A-z_YjQ1Ib4IuYp8TI76JBlaDjhUYDiw&oe=6A329687"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=na_JxQPs8Y8Q7kNvwHnMZLT&_nc_oc=Adp09jiWnvnq08
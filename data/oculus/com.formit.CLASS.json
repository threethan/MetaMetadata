63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHdaf6BB9RUQ7kNvwFdMFad&_nc_oc=Adpdgsa1Qs8zYacV79Rf-FEB0YeOKCLIno6zXUxg_cjyaJFygODvww3CCiNRiyLBuKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1pOvYCDpdfZFicf75EZAZQXaxro7hBIYq0k-gOVFy1Q&oe=6A524BD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lC3PSDXSjOwQ7kNvwGWajyz&_nc_oc=AdqIeeVwMalVD5gzXa7tQCdKNYn9r1qF_Y8pmFr_LVqxVmdAt5N_G-qf0Aa1SBeVcrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3KNhWGL-Qm4F8gx9-G5iUpW51mS_ROr_baiWTzql33A&oe=6A526422"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hhx0VLfF49cQ7kNvwGrAhSc&_nc_oc=AdqQ1f_BgtIo-VVWjIMTBC8j7TvkDvubALXwLgoaVkezXOh3aL-c9mkVy4K_s0INB6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAK35njV_U8N6NVQTCoMHoNzMSdzCLanpX_d_Iw3jagZg&oe=6A524698"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfyXwRzdQt0Q7kNvwET8lGW&_nc_oc=Ado2Av5_V_AYB6oC8-0Oz5LJ73w9UDPI3T5UoeJKa7cJEUFuSksClvgop2Y2SEoBN0Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDF-_nZ11NblqKSiyoomy8s0KhJcuERNZrCEdjEpBlwQ&oe=6A523B2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdAv8EKA7SwQ7kNvwFOIOdk&_nc_oc=AdqdzkbFIiEEtsYRyRwoTh0T8Xjg-QwxTw3b_qI_Zk020FNFVJtFjq7FyxRTA4sM0_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRDmrTdDe-4RWpejYWB3bHKi2mHRQ9emxjOupoEg5Jpg&oe=6A523EC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN4zoEc-gj4Q7kNvwEtrJLn&_nc_oc=AdqDcvXEWtqFh-KP0u3l1Ll0ztOnOonKTCgDfrxrycuYSOgZzrKd6yszTlBw6-R1wb8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACR8sS_F_ngFWI4OKptG80f7FVvvVyMLLNYhW4N2LmNQ&oe=6A523A87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXTjdalMoi8Q7kNvwFPRHVS&_nc_oc=AdqMkpnfDPYnIM
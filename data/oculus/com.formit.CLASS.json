/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2n89NbZFXM8Q7kNvwGoKLQI&_nc_oc=Adm-Xli7SJezQIwUVnLav5ZsilMUW9tgcTdswPhIpEL2AC1UezHXhFtPLA8YBB6FDG4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwhTHI1lDiaHxA9-jDiZKP3x8_EO1BQF8H4dzCS87afkg&oe=69B174D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mx6bjo8a_3YQ7kNvwF6fl0P&_nc_oc=AdkQ6MjuusM-JKm5CLhYtoBXyGOH-_XTx46UNWz_Cc1gsxvlJDY5KeJeLOsf5Eq_LSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afycj9CGgNZXKwRZXYYP71O8l7zVZMAmdWq6v2axtSQhqQ&oe=69B154E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw9rPC2L3JcQ7kNvwH9UmNz&_nc_oc=AdlH9KwXvH9W8C1b00zKVdACMLFOaytqpAJRH47nEnFkxQsExRZp3Ut83TJge4KU3c0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpM0MpnLuCkIaCGcRNd2fUfZmo-4LbtowS0v22RGjnCg&oe=69B16F98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_A8RO1hWJlcQ7kNvwFmNV9m&_nc_oc=AdmO57a3fwS_R73y2Qmpaej_-2oaullXr0SV8-QCOEE3eelrnAMmftaDyNahHA1NpKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyx7wUQvYlxEXlPg8XZWHpabCIHFwl1VmmuqRIdLy9P8Q&oe=69B1642D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAlhtLV_dJoQ7kNvwE3u4KA&_nc_oc=Adn4J4uopvrJmVyBZPif2qPyuUu52wd_-Fq9pARAEKYGO9KSfkX2H7nFVW_pFBK0DBc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ_g0r8rc1HNKDSXuDXhMSvEO50hEoyqg9fWHSq5j1HA&oe=69B167C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbl9B6qEP5sQ7kNvwGisWAS&_nc_oc=AdnUZSge792LafucCyfZ-xBcMm0cIgpw2VTNFsWNjSDXXHa1CfjdQeSsrLR1XrgrWxs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk6UKaNOTXySG6TX7WMCUWCo-11C5EbPOXG6fygoXIGQ&oe=69B16387"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y7Oic3YfP4Q7kNvwEW
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkr_SAoVh9MQ7kNvwEgpeLi&_nc_oc=Adr_xIz6858KT-MFUSfjmoRieuTN1p5wG5ObfJgDmsaq2wUPdJ1NpNrxtprHWPRhdAo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bflMs_ncfsB2DbJ21YFuy9ZXen4Ln9kZVua82q2VATw&oe=6A1C3E56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7TpFkVCItcQ7kNvwGSaIc0&_nc_oc=AdqcPRctDODFrbEa5CaGg8BKFo6yjS96WkDf9e0Fnx_Q5Pqyy-fyCKiHDdCx2d45cng&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af407s8C8eS6Lab4eIb7ixcxh-T07fFPa0juYioGInpo3g&oe=6A1C56A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e202aFbkw-sQ7kNvwFIc0uL&_nc_oc=AdokzgAPcLiH_W9MB3xdTnDmUiiQ2dGOOcHBq_mhF4rvJ2l6EUOtnshu8LzyQcpmtD0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cCmwlR7o_3uR1m5uh5RoGT8SARXHVYFjeXzNjbNuWpA&oe=6A1C3918"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCKaFBvlhYIQ7kNvwH_lNtv&_nc_oc=AdrlKTEnzj4rD1djz7Cna9uEf2hfTLaqAlcvonrlC-2YrNUtmvFlmAEZQl9dX5M93mA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IlmFQ2Mnh_iArn3olvQ_iznPBwmcwiGZ0ZETUC7_iUA&oe=6A1C2DAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iOw5wm6jhoQ7kNvwHO6ic_&_nc_oc=AdoAqLonILPZ3-IMr_128GrmTidyTEvVvCbBiwl7BBY2fHk9gK1wm4NNZ3_Phanceuk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l2ir3t9YcWp6CYVhhXDJYHCzrjeeOwvT9FP8gPpdk2A&oe=6A1C3142"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKCwn8Ih6AAQ7kNvwGEULUX&_nc_oc=Ado1nYBx_FgrHIlK2NqsV61VzKuUV_qauoLP8l69unqKUKTVZwoteberkH--7z-2pVw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af639vU_2dc9ItUNmAM0EB-MsGAIwbqI9PheSo0eOHqP6w&oe=6A1C2D07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uu5iwc9JlHAQ7kNvwHSwdbU&_nc_oc=AdocAY2bHA4Jiw
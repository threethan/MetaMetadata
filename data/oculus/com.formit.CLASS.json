63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4CzLhx6p18Q7kNvwGb1I62&_nc_oc=AdrSVBtg6V1OE9D_3R21CWogBY_7lstu-eajam7LKw6NLASFltJQGchjx3_YQGJa3-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SrEayjz6dhVw_-Iy63yqfm7V9xUJFhdTtNCbLGsaPFw&oe=69E8D3D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YqgrVyc7M8Q7kNvwGPE2LU&_nc_oc=Adp8hj8yBmqs6cvWBHfN3JoDkHZwwPTEl0ENymwK8l_qqsO4F1Den6RJJRsv29xT2lA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dxjZdrK3PPvezm9eFbSicdRA10H7lsyo7gBcP_FWxkg&oe=69E8B3E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgTN_-5ZYTMQ7kNvwHDLo9I&_nc_oc=AdqUxT-hdxZ9laeY8um5iP1awwbrIrwC-EpnHSMbzyJZzrTaYGS3egw6Zg2D51ka61g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RIohJtLZDELTGk93x_QzvsjTp0trG4jlWUHht-eIj1w&oe=69E8CE98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AwGKZ5KiQfkQ7kNvwErv7oc&_nc_oc=Adpv79Zd82oUsC7F3bh_BQ7jBJcp6cf2s7fo8xucErykXCtYV3j9pw4RgOix9BbaIHI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XOat5QpnWFVTmgS6KBhQPc6iuJKw8w_MkSIsV2l5IYA&oe=69E8C32D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgixbVRycg0Q7kNvwEe7Elf&_nc_oc=AdqngI-rz05yJuV16oU0FlTMHsPaTU-qPnrzBQjnGDw0rUR9wdvNtpveCMfznrMYCyU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uYYw9GP78sW4wzNp3RcIFzxuYkW2aV8-3arHdN2cRWg&oe=69E8C6C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiBn4kN0BMMQ7kNvwEF2hvE&_nc_oc=AdohbGxqWXHt7bwgvf1kF2ZKOKCkqWSriL8kGSmO3yFA08sLtqPgR4g4hL9az25Ob58&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EA6d2QqrmpFg-K3IJr0K0UR4mCu_NIWzNCLNRsorU3Q&oe=69E8C287"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsjOFk8I1j8Q7kNvwFONsCt&_nc_oc=AdomBdKwrbtGyI
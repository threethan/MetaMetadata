63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgs7ltPxevkQ7kNvwFDEjQh&_nc_oc=AdqaWvEvab2HIYb6EK61wU2oS1Dl5SwYd2VCx3REkQUhNjpQ0RxTL_zzfWHYAPRVSeM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lDg4gVqH_aOeFvvoDYr76Zic_IMmdGLNX95ZcPbCpVg&oe=69DCF656"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mk0rPKHRmJEQ7kNvwHKGy8N&_nc_oc=AdqG6BgdUZqjc_-k9iBNEpVWgS0Duwwx3e5YBhacaJyp32qAKbDq6rP3obHziOxvNSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QsOkgxNDHK1FH-UGkgD5hQu1-DPdIZx6CeBDXp3aEaQ&oe=69DCD662"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OMX33S2l7NUQ7kNvwE0yFxn&_nc_oc=AdrrD6ySW0z11cUu7VCVz8z5NXjgWFoFrzg1UOh_V9o6cXC8SEeoxQxwcSozbM6lXPQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BHkKeThmjjAYUnXX5XZafY3eZG_RwXQCBz6ejw51h-A&oe=69DCF118"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjldeydZ09oQ7kNvwFKbTkB&_nc_oc=AdodWVf-ivPD1n3AtVUbgeZ_9sR5znvbwJH67zHd1irpIVRXNKKonprqczVHxmxBwIs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NszJzv-2zFwWO2Flj0YRzaBsDoMzDCX0IwnDgsGMaRQ&oe=69DCE5AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1H47EUa1eQQ7kNvwHrjrl2&_nc_oc=Ado-MT-oe3vdbGhTdRScJhqtQYJ1mUx_5A8K4wUJNyHCnDu-6IS2x6d2kWG1QWcOCCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-PC6Kno9Iu-Tl-3ffl6AW0ObjYRTsGi0iVCiDb9MXNg&oe=69DCE942"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h1W5GKUcdkQ7kNvwHO1Dpo&_nc_oc=AdqFeHh8owrIu7wPhTYmxegwdj-HRoaVtNeDRFPcLZzbp6Nqj3wKhZD2cr8HMGseyFU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LLktF4iYZ15DRmnxg5FufL3zowywKcxjKQ5QC7T1l9Q&oe=69DCE507"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YMVz1yWU_wQ7kNvwHszQL3&_nc_oc=AdqV3Ab4Q67VC7
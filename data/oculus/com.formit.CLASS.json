63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTMtXZZl0swQ7kNvwHEa0AB&_nc_oc=AdrJqxSIvjC4mwuf477Eibpir4dAw8b6wagzQBewPv7zh3tbtrJlIZ0GwNtuYjJQFKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc5KaLXAQBzOods6LFsqk7RXQkcmnKt2MGtyDZSjCT-g&oe=6AEF6696"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ0G0-V4RQUQ7kNvwHl6ylX&_nc_oc=AdpPZ4h1z_jnRQw3KWJ24l8ACvyhytehH1xzZC-9prCFghPEPwnJcfiZ6ogWG_9Ex78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScwXmKgz5XJJYoHzQbIhoyrLPdPLf2GC3TjmzmX_Wsyw&oe=6AEF46A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7J955W4kbjAQ7kNvwE2ovIn&_nc_oc=Adpaugrl-_umZoIYopUJNSA-ixaSUjc9zBj1ENwB3Ac8DEneRCK_kU6Z32mk7BAC0l4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLdqmJrUKrcZiPTRoYV-zlIYYQTis1cJD3r0sIk6es5w&oe=6AEF6158"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5weaGlSru0Q7kNvwHspp1x&_nc_oc=Adol75iK-dPup1phypLcM-MgMoJPSHuFTxKgLlrm8w17Oc6QayLwFHTPX5Sg7_0FIzQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRaZ3hTHzzQoVUbNOjuG_YT1Lwg2MnxD0b6WP9bKeXvg&oe=6AEF55ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ciy1eR8fkHwQ7kNvwHPpW99&_nc_oc=AdrF8Xw_t_NFyOr0OpNj7ba3a292RvMPvl3EEwwHYY3YcTkfiupyU8I15QKd9ZQnJmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ98wyA-mOYoRJdayPK1BkhqqWwvYq7Chbu1WOdePO9rQ&oe=6AEF5982"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzSr3xHiSpsQ7kNvwG_49R8&_nc_oc=AdpWTbPnLMdW3RlEF4fBQCsydmo51iU3mZBttegqMTKPBffEqGRbELwSPazVG_mZ5Q8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOCEC8XIgKi951erE0Kp32fkraqjxOzdvOD1yaER-uxA&oe=6AEF5547"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aJjnWbX9KYQ7kNvwEAs7b9&_nc_oc=Adp2vGnVB-blSb
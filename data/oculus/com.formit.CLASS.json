63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yB6iSK0zY4Q7kNvwEGiT7-&_nc_oc=AdqtzRlv5z5CUhy1owYRMuoOegs-WRp_UpW88M3tKN7cTDSrM-wLBdhR1wfyXZYnvnU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTltzoqXNEbEVA-8nsAAwWnD5cvNuKFrkfX3pVRyOz9g&oe=6AB920D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-6g4J2G_fIQ7kNvwE9Ysag&_nc_oc=AdqmwNyCrsGLLYjds1VUoTXduO-ntn3Jpks16AvSv1v_sxnkVAuGvXZwsgchQwaK38E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOru11FLd5-23kJ3M_EOzTAJSt_hGUC6l6KK15J4aj5Q&oe=6AB93922"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=scqCWU8FpBoQ7kNvwHfYq7F&_nc_oc=Adpe9JgG4Xz8IyKYMrRp99KVUuKy3fwrONQ7xrvmVeaao4G1S7JHP_bYJu08KPMOJSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2fZ3mo3c1TS0qNRxLbQBj7I-xwcxtL71CDQwD7csZXA&oe=6AB91B98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JexsVOpHaEQ7kNvwFH2gcp&_nc_oc=Adqriv2ptcONVxKp7VfLzBOYT_L88OZgHP-wMyLOij0Tmx0Tac69iJjEmAnjPhs-vfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs7nYwrArRDPX4crCcINCMllrC_LhScTLttGqpJp5zTQ&oe=6AB9102D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ps8Li81vvi4Q7kNvwGFHrB_&_nc_oc=Adqm5u8GJ6D3LehdsB9DtZHMQNjAqiH7Ac-jjYSRhGMTKvtHeomiNpxkC2VrsxjMJVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIacFpXox3SdMiBTFWiOMe8WGVv-szwFxN3JEDJg0_ACQ&oe=6AB913C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaU72y-4HWYQ7kNvwG61l4G&_nc_oc=Adq2qGilBf-QsxDTwSsc_vgs_e61sBvhC-bQWjt-vVXyjf6NUNeASJQr8-ZsFxXiGFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSa6HaYBG3GN3aVIxM-wnHD9Aoef25Od-rQPrEx4rtRA&oe=6AB90F87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z40ROGbM2GMQ7kNvwH3omRl&_nc_oc=AdrNTTI41QUnm1
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XyeAcAjYYUQQ7kNvwHfPH4w&_nc_oc=AdpCFyvHqKk3UPTVywUgZJEqqceKP9ueHNmmsIsfRmVpor76zgh2VuVpxkt7h0TCBv8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHx3ILTB_iO6-tJ5Emu_B0PF3524NyIpZTNmTzr3TH8A&oe=6A915B96"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNfHEBT_cDAQ7kNvwELRPT6&_nc_oc=Adq8Kd0mK--YiNU4mc4fhdLFJu0ZrM_3oLu1Id7YDRWNxnz6LTLQOVgxKW6gaIcxkOQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEJEMx-3tXY90DsWFOUba4EwRViR6vAbABMYomZ7Lm9Q&oe=6A9173E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kcjcx2rJhwkQ7kNvwEf2FHY&_nc_oc=Adqc-CbFTwz5rIHF-ipU6Z22A6doM4PNbrTxJGY4dJbkwzvcE-CxjRgbvGCm2rcCoDc&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO_2XpBUJ8wkeJGTcmmU1sUBQFIkNCptsqAbRCuEL9Rw&oe=6A918E98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vAEK1x66AsQ7kNvwGs9E7W&_nc_oc=AdqrTfeDLH-Z97muPgELDm9BW5Hlb2DIaBhZDVTZmkEdUGz_ifeHMEP1zsf8gBwBd0Q&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYYttGARLynkME5MwB7ZNpKjNz-_0xdEI0xMJ4JGFuyg&oe=6A91832D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V09rvMAJfqQQ7kNvwGUN7gG&_nc_oc=AdoQCM3iKDDGuCJQfHfdOe3TIKk1WeJGO8wIO_aRvbmJcbvm2ukc7oaxIsguzILBP8o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEADJVVEbhUuMmondwnP4QhoGN1VhQ_6NJFJszCX_c_Lg&oe=6A9186C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-asEBwMRiPcQ7kNvwEA7rT-&_nc_oc=AdrAAKJAGNR4lx3hX2uHNlc0bXEwdnKG8GVxrxhB6eMxJyi3hL7eXyVV8yS9Rp-6Jfk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRoePuxUeamCwwO2Bm6nVcxQliBpG89lLdxANge3tf7g&oe=6A918287"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwtlHBs5FgkQ7kNvwGKIqSY&_nc_oc=AdpwncgJUPkTRC
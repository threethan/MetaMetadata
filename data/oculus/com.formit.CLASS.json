enza titolo (6).png", "id": "2907103559468667", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391749_2907103572801999_7847158985527645159_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyR4LwpG8NYQ7kNvwEhkC0f&_nc_oc=AdqzKpoLMuwyCFhpTu-w3emdoPF6ZibTNow4gzk6mciQHOsS4DHT6PvydJVDFVUgna4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgotn2udotRX-C8331C0yhDe_hBmEE81FJZ4Dd5KhcaA&oe=6AFDE07A"}, {"file_name": "Progetto senza titolo (9).png", "id": "1086739183249057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391791_1086739193249056_7684267601424160891_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAm_14-kIyMQ7kNvwGVqa7n&_nc_oc=AdrXnkLjmzsbGf7ty7sYCaDvIdL6giFqsxMLXj6QRpMYHG6ahzhg8Gj8cKHRl46nQaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXz9fIguc53qnIb3Qc3jp-8HY5kRXe_YjtrjIOg247hQ&oe=6AFDD288"}, {"file_name": "Progetto senza titolo (7).png", "id": "1060249132540287", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393121_1060249135873620_1814107242812883552_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCImbWHr5XUQ7kNvwGhEhyZ&_nc_oc=AdqiUjKG6v2p7g1_XmrjVSXOf1u95WkB9SAK75_uBXPwrz6GWE3l7lOC1g3aQwP5f-k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKs4S3tYraS6TkdtygpWYtfNaWgUoepjuuEecqDveZZg&oe=6AFDBB28"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["education", "school", "students", "VR", "learning"], "long_description": "REBT (Rational Emotive Behavior Therapy) is a form of cognitive-behavioral psychotherapy developed by psychologist Albert Ellis in the 1950s. It is based on the idea that dysfunctional emotions and behaviors stem from irrational thoughts and beliefs, rather than from external events.", "short_description": "The CLASS application is designed to address the educational needs that emerged and were exacerbated by the pandemic, particularly in supporting students with Special Educational Needs (SEN) from socio-culturally disadvantaged backgrounds. It is based on a metacognitive teaching approach, also leveraging new technologies such as Virtual Reality (VR), with the aim of enhancing learning outcomes and fostering school engagement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://formit.org/wp-content/uploads/2025/01/Informativa-Privacy_revBE.pdf", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://www.formit.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28693453820238880"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391814_1155705559517152_5748014505336067671_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WAG5v140d0Q7kNvwE7FZLS&_nc_oc=Adqt6v6_F5c_3owGsrfuxDNbwXGhUFA-XZBI8kfZDaqWbMCKLTljMOuK-sxRXbUKlq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTipLzMKNqnsKxaeiyMRlMd-AH3Ysto5sPo_ESPtMXnQ&oe=6AFDBFD5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CLASS", "platform": "ANDROID_6DOF", "context_category": {"cont
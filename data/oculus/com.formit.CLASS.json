63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQEL7m3_k0AQ7kNvwFRNLR2&_nc_oc=AdpXeCPEM6KfjqpxEC6THHm19T3OVgCssWxyZB8z8NxTjPTx_8Sqv7O4zGE_1BhfM0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GUD5akRqnQHeB3OZsx0WIJQWjE29uN0jStn2wEHIyHA&oe=69F75456"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4tlnZRcquEQ7kNvwFzl_63&_nc_oc=AdpDmgFq1fSHpuRVeTBdaS0c3zPnmf74IXOoEzkKb8Ku_EfP7w-9Dh4P9QuWL8EN270&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gLAScNXyQfMjcI27HyTZQEuhH4e38G-v3OFaiZa6Hsw&oe=69F76CA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2crEUb-RlM8Q7kNvwGJaCeu&_nc_oc=AdoRyZs0oOZmfRH5OiGj9r9YSE5zqQ0hlwWSQ_NErXkDXMedtOnVSONHlN4ZmIFRrvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0byOuKV0XX9-exrYB8XfjAYskF5bjXc7lrYpuawRNDNA&oe=69F74F18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AJWy_z-V_cQ7kNvwHR0taI&_nc_oc=Adr2Au8HivG29UJtP3Omt7zLHJQl9POM6xDxnOsQfA-uMy8Ag4zBNqmaO5bS89g5Ax0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24SvbJLjX4Qpi2ub-dBmrq1RsdIu8UeH_uUew8HTWRig&oe=69F743AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z9z9Ifjof8Q7kNvwEKvtDH&_nc_oc=AdoGLHa3ZLyFdbaxSmCsfZhcELrfpR-Jd62GzX5SiQy8BsUCxMPqWrK1CsB_HQ9-b_U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0si8nDb2oPEKQDu0dsweYBTv6xH67wChAYU9SCEVbylQ&oe=69F74742"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nyi26-1o-CsQ7kNvwEDtlGZ&_nc_oc=AdoU3uqj1ckCKceCY7w9Kplp_17A3vEkpXG2nomC23MEEiMeW4ur1FB9Xha1_ImMjt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZGEDKhtpJgKMk_G0rXEmvK_6ROejAdMiPXtOGRNMC1Q&oe=69F74307"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxcNG_YE2ZgQ7kNvwF3yX8O&_nc_oc=Adr6PuDQ-qI5qk
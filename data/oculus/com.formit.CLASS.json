t-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8b09OEyt0oq_G2Co4S0S2Ai3IMS3esrmtZXLaxkOK7Q&oe=69B417D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC3kCTITMsAQ7kNvwGMirHM&_nc_oc=AdnIFtzhK62HVvU0q5S1CjByCd8NovCbjD0z5VtBYbfH8g07OpXFN9ppWxJ3X2QOdSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyRResnvnKkQd-9Xmo9Yl44-73u1Rh0NqGjAujlX1oQqw&oe=69B3F7E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw9rPC2L3JcQ7kNvwEiJv8F&_nc_oc=AdmTMjr0kagVowl_KEbpR8zBBWfRfWY3PSMPQTcwortQVCo4vQVzAvMs7w-nqvH_ZLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyyAxVY6ng307adU-WofYoftv5BtaJECQ-jJ6BgkgZKrw&oe=69B41298"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_A8RO1hWJlcQ7kNvwH98PO5&_nc_oc=Adn3-j5bry-VFF44bo8MbXDALpDYNTE1S1ZfLIw3HESwsqktRMTtQyaw9JTcaDbXKCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyg5dfnPG9ehduytW5Znm8G-20uaiQ6C6f-JLyGm6Xssg&oe=69B4072D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNPDmkdSvIkQ7kNvwFqWsHa&_nc_oc=AdmH51cCCpW_Jq9xadnc6YpepaRJzkPxJOogzpQg0hjqMJuyIk0uKh5b2wErfzMXZP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7VPUjG04egYZHiFWPZZgYy0owBYSzZkSlpQWlrT9zlg&oe=69B40AC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWbPgLFCOsAQ7kNvwHbIzTx&_nc_oc=AdmRhlBnpnxGC9pxrGqa4usvYlOb-pg1IitnVp71BWaf-qHvb1bHqWfxj868sJSc91g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzttUYkl92fQ-49AtXW1OEPTNY0lIimTrSG71xf2uiJQw&oe=69B40687"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4WrXPbfFR4Q7kNvwFvR8iI&_nc_oc=AdlMCm7e5Fc1fwMUreuBbNvqLlHcsXBSkbflJ9XBVpLTxLdbp7Raw2tkVS8XuJw8DhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4EvLxSruKt0eu3f_wbfl9dn1IEVqI180DhWOPnaj_ew&oe=69B4146F"}, {"file_name": "Progetto sen
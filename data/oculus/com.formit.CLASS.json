63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhyoZYVAZjYQ7kNvwEdW3rC&_nc_oc=AdpfDwbbwRsWkPqXDvbF_BSGgs2o5qlkv6DUJgj5kLBHvwqkTD_nW9sn2jMXUwyBt_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VYaVr9DEN8ln59EQ4H1Xau4Ewec-2dyc2AFK7-8oG7Q&oe=6A3FD6D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vejuE4uL5MAQ7kNvwFmgcz1&_nc_oc=Adou3LuBMs0bHOO8mHyOfN6wnCkGgHpTSINqkpjtMkHvooCI8c-Fv_RaHKzURJI6rZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YAbbt1CTlqgmF3GTyNMtG9OuGJh05HZt4hvt1p1abhQ&oe=6A3FEF22"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrsB-wZw0AwQ7kNvwHFyaN6&_nc_oc=AdoJnROTPL6g5oHrtrzzM57opTETUALfadwqVgdemMHEyuRLdD9BkV2ICKOQp35jAUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6aLFbmZvS9x-KcJjwYsqKo2zPqOh7bwgZDj-oP3srqw&oe=6A3FD198"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yia-a3KXv-0Q7kNvwGDShi3&_nc_oc=AdrkhXHw--8_MRfJS8pwM_krvQisbD57Gth7cqcJQIvNpMJ700TACZEmHT92S4XmBvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nfuejye8_nuAdMfIwYWUfH0MqFlJiRGmW34tycavimA&oe=6A3FC62D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtsjpF6fm6oQ7kNvwHyGiZV&_nc_oc=AdpvJTY4FuFxtPD--QSFr_ApcDBvBD_O2rh3mL6UvL7qU6QRLivDgn9G_SZBT2f5x3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cfCcDQ7XjUZgtYl0Rhli7lWulUpomvrkJNCTw_otqYg&oe=6A3FC9C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SeQkUxGHfcQ7kNvwH1IePE&_nc_oc=AdrIibApV5hVtvtCsNzlJaCYIgGsEui1ItaAQdjROxHJWek661z_MljHKhSPaWnVGsY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K1lzfC1FTCyHjX718JorONPOAgQe2IbQ_Qhwkcr3U0Q&oe=6A3FC587"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeCqt5BUH_IQ7kNvwExCN--&_nc_oc=AdroZdtttXrNMQ
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_leeGEnhwA8Q7kNvwG5msOI&_nc_oc=AdrmeRPmWCEidWynx-daZaOYB2ZNEYHhSdMa6FMApOmC7hZPT_P0L5q7O33mvYGkENQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw2kVNHYAaDHOOj82hlZLA_t2MkLF1P8ym6SUmJ_lilw&oe=6A5F7AD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lo1LPn2V2cUQ7kNvwGNu_9A&_nc_oc=AdpjxXlIRfitxLTfKpE33odXxrAHelXhiyAqhynu-47pCK_WBnzj7SJfIUZDVJrwi68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6d95aEd-CRJDSmP45ms0EpRFjpht2bSiIvUtv-tRTaw&oe=6A5F5AE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC0ZpI9WKk4Q7kNvwGFTV5c&_nc_oc=AdqTJodUoAb0JUso42TOQ-c8nvZ5LupLPJsIV2D42I0jG06FPotHevTcRqlnF50kIwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiZNxIxMD0mgzg2zZPxZGEgz1jCxwoc1vym4y__mze3A&oe=6A5F7598"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lhS2HCLsoYQ7kNvwFgc8CV&_nc_oc=AdoOmEpm6k79GU-VoAhy68XvfSfRrfPCUUkFYzmF7aGtIwVShChRM5Ty9IoQy72yzAY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWYf31RF3ZHWcMncRVpUAfTlKTqOf2McoaQwbjqhivzA&oe=6A5F6A2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjaR9htHbW4Q7kNvwEf5AM_&_nc_oc=Adqii-KAgr8LEQVEws3SOS1OtPdIu5yb665hGdJQUYDkRXGoOL5HcF-x4aknkO_LEvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhMI1rWeoZi5S_yXGwvv2OZHjMzs3Z6Ko-S5gMTy65uA&oe=6A5F6DC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aF5VLpB878kQ7kNvwEd0ErA&_nc_oc=AdreRFLONzDFVrhu42gBsMPTT7mJ0FndhI9bwlWMoXOXJYZKCfK6NbSGvM_xIaG8OjM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9J2-BIlsT0Dzlx0kNu2qtO4X6Lp1ZC-uvQkUCKsa1aw&oe=6A5F6987"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaEpJUgdWj8Q7kNvwEbmakD&_nc_oc=AdrENERUtdaWkN
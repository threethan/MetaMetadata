63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bnnYsWNRakcQ7kNvwGcQNz6&_nc_oc=AdoERd1OYXl_0Jk8ErWTypSQvcuxl7CkULmskbfmh_RJvrE-oGHMipNGW7EecrDqkGw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp6NksiA3N60Pt8VkHyOZHB8RtR7dVZ4g_Kl4k4IbqbQ&oe=6A4BB456"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHp7X6UkDKUQ7kNvwEd2k03&_nc_oc=AdoaqW8g3oDx5yGJibMhZR2pp2-kcsb3vvDZ_4CUbZuF6QXzEjVkuuuWO7-mVXmgMak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBWRKF2oS6BNqJv2Vx7KYj33YTO939G4vFkXCiUtrbeg&oe=6A4BCCA2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCZGDxgCPfMQ7kNvwF_80I0&_nc_oc=Adry3yzKiwe5jpq7hMrnJrK5y44gZr9lXL3BnioiFhYiEqzkyP3nOVYwtjYNsbeFy5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOqzs7WZRNGxlnDm4o7zrqekRo1OlLWM_K8CqstZuDeg&oe=6A4BAF18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbg0wzi5m8QQ7kNvwFs545t&_nc_oc=AdpwlPpR3MxghIVUMsB055ahx8ZRxdVtpbaBrTLfYLun9MxRwmsBRYnlkoN7wiVc_C0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRHtMdvHz8rnjEB0zuL6HLHPjc0Uz9nxU022PLm5R5vA&oe=6A4BA3AD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoRqoam2N-QQ7kNvwFaB5EU&_nc_oc=Adoy2YiEZKNe1jYQGmNgHfDxNx4zDHhHnxt2Udo9H6-ux0N_d08fAiLLXUhbr9ch7cI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyzyxcMeZDTd2fkBDDaQGB7uuH6MoeJco1ADP5tueJGA&oe=6A4BA742"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SK0jvH8zG38Q7kNvwF0hMww&_nc_oc=AdqWQW7iS6wPUxX8WP9Il447sCOIUPdFxhKrLxeoIjhZmpZRjR-JcjvrafZ6q_rOo3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtY_5Tv4fHXLBojhKClyEWnTekddNLaTBTENwUYBiTDA&oe=6A4BA307"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfHNbiZX9c8Q7kNvwE7rTVR&_nc_oc=Adp_y1Xj_pJbOE
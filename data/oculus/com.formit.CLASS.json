63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVnObjTs0gMQ7kNvwGwEV8X&_nc_oc=Adq7DDQj8Tj2o-scdWoRNHO7gHtrURtPQxRyNOFwMe9kqf1YFA6GkutKklLtzLSsCas&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZazD0SQeOlDwZtv2YAOOq1BgBgKfjjY6Oji-A3ifUBA&oe=6A9C1FD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLU0DpPMU6kQ7kNvwEoJJXH&_nc_oc=Adrg6NFoAgoodtQwuTVH_zztbBWaPHteBZbvt9pDoyPkDcCXY4eB6AhqV3O1ONnCA_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLFy33JJsgMbmyhHVRcd6qbLP5x5qsTgLMYKKJ06S3ag&oe=6A9C3822"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6akLKQkKcNAQ7kNvwFhWe_G&_nc_oc=Adot4O5UMQYGPmIIGeUp8Y05Jcgj1Br3G8fVhSAp6r08QbpUOPngugfBT9RLYo5a66k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZJUaPtTGl6PXlP6yzauKRlyVdKv_fYVZK5gG3vabwoA&oe=6A9C1A98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlQgARrii8YQ7kNvwE0vGmg&_nc_oc=AdqbDrs1ZQKQfyjZtuWZGAVIiPcd27QnVka52LQoNe-xv1teCkiIg2Xe5h066mK5GtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4tIyUV_VlJh-1Rpp4laMzkhCFs3M7A5erh3eVa8nXoA&oe=6A9C0F2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsP4qicByNgQ7kNvwGuqgJz&_nc_oc=AdrRN2yMxVM9apuSMHKvYefEvBERilIzL-gLgHnvxlAzXlfWGhTHiuQovJQ90eSLiK0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVtR9-Ft7ATMjwuFKxSUE8qpY7MJ41hv0itgfZZbi9bA&oe=6A9C12C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTWF-SwmDVUQ7kNvwHLPpfK&_nc_oc=Adogetsrxr8Kc6atQ7FXTVjIKjkzijBQ5P_IBZUGZcamfEmfH_oV435CusIhcWAgsps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC8ycLTbJmdkyqwtKZ8YQ4c8h3QQGIptg93lGzsOEAUg&oe=6A9C0E87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZqTADNfurYQ7kNvwESVuRp&_nc_oc=AdoHhtTPPM4Fc1
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMuOgSu540Q7kNvwFCmZNr&_nc_oc=AdpKEsrCCFBy2zjYFFgk-jTOkowkVFur7nS7he1Mpgx5C-zyWn7EeaC9B33gh-Pkvbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zobB61NgIy9WB-s7K34o7W1LtR32z31SR0HQmMhw8dA&oe=6A1D8FD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7TpFkVCItcQ7kNvwG1X_sA&_nc_oc=Adqr8wmmdiuwpjEzWwn-X9MRBAy5N75CagxM-aVwUIKdYoKWOBPIddaxyi7kUu2zajU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Qwh-ezyuiMXNklafom__M9tKvFxvYsjXpsjHbwEb9Dw&oe=6A1DA822"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e202aFbkw-sQ7kNvwHjxn2l&_nc_oc=Adp0FuN5r3AZECUhdTRXXal1XMSbxQBzUdu25LLAN-D-xsKgkk6ohnc6B8AK3vGlZ_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hQ4kDFg6atl3o6Gxz-NEWyqF72aHw3mLyhCU_MxE-Kg&oe=6A1D8A98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCKaFBvlhYIQ7kNvwH5wnJh&_nc_oc=AdqmZ9bgkMCj79I_fkTn7XDORSc57w7sPMTyQettzYlRgMgslyz5NbSX4pAR9Afr1nc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BmT2OLEL5TTinrO75hlPyOqx07iVqyGaSs7o4HbTGtA&oe=6A1D7F2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iOw5wm6jhoQ7kNvwH2A6ug&_nc_oc=Adq3c2xon7SqZDy2Cy_Cpfc0gxHTliLar1bFBHugSQg6XVK708ItcTmR_NU92hFtp6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iVApaAc81DEM2Peq6DxeIOAVa6DgfpCnvGqTRcjbqOQ&oe=6A1D82C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MtOrm_eqU4Q7kNvwG9yvh6&_nc_oc=AdrotxD-lH8XtTHIFNC22j5s_3j4-VKyi7UqtSongZo3L59QgmL0yDVrTTS_FITN_6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bA2hZP9k-pebTBKQjev4jum9wy05_LXaIdX7nA6nBRw&oe=6A1D7E87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uu5iwc9JlHAQ7kNvwGy__0A&_nc_oc=AdqJAiFOxBAZnl
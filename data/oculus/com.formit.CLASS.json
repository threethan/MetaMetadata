63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkr_SAoVh9MQ7kNvwHvPtCF&_nc_oc=AdrXoV1-lWXUP0-rdJXaqWA6-V2biYCRhVQi5-jInxtgOPxHdj4XL7yiGgaKyBoqdKU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wXHLNCAKySuvSTeHSAFJk5jAFICuqbLly_19YxiCSlA&oe=6A199B56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wv5skSAQ-ukQ7kNvwE1nUbJ&_nc_oc=AdpvdlD8e72BlDgBk9YRW6n0SLmbFN27qqJl8Oq7m5Pe6LrCRyKiQs5z3oMc3U7iRG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lgxz6Ol9EkmAVCg7fbRRBQ07uw-uq6l9mOGqMMQepxg&oe=6A19B3A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqES0zk7YX8Q7kNvwHyu5i1&_nc_oc=AdrClP9pqVT06rlT647rzD0_Kr-qXcr5NDBG68JBwMT7w-Q8rlO-dLnbRMAlDaD9vy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CP7hy7Strf4SHSsILzWVWUp_LKZB77IM91DuGKYa5yw&oe=6A199618"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAGOopASFRcQ7kNvwEKSb3s&_nc_oc=Adr5v-Ik6iVC-RbWw-6WC0lhKsmTwZ-DpRJpASiQFTLs6lmiNk0dNBr106BxWZyc-uQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77CzMsvbwNuGsw15IQVApCzoWLExBVpB-GH16_jwyjbQ&oe=6A198AAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA8o5gSfL0YQ7kNvwF2uUkT&_nc_oc=AdpukMdgHp3vOszZ2Wg0mmw3YS9rVwFyFRflNbthy44Jh3v4Ivf4Y5csY8QQ3oBMHZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WvCG-Z6Ithtyrqi00s-Zf4nOCHc5CUb_ZlKqHK4zyTg&oe=6A198E42"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKCwn8Ih6AAQ7kNvwELyURI&_nc_oc=AdpVEukBJBlPw_awBzujTeXpuE2bNUMocaZUM0vz6R_adYWnST0khpfK6mGGrKDravk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rdd9fdxknVW-7pkAL6OnKeD5RMF2BAhLc9HNQix5V9A&oe=6A198A07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAsQ2YQJgRgQ7kNvwGWuvHU&_nc_oc=AdoaR7JPVgEpPV
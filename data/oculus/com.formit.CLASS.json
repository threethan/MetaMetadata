63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFvWg30l3Q4Q7kNvwHhSW3I&_nc_oc=AdojzyDeovKCbGQKypiAI2AHodn-sDS0pVyYF-OvCd_vj3rPCjrO43T0wsmX-lMdFkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjNOvJDVj88nw5Cv17m8QfEInovanXI5G7GjUIVq474w&oe=6AEDDCD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2Tb2IzyugMQ7kNvwGJQ9E8&_nc_oc=Adrkf4EPgFLcjDDSp_XwRMTwZsWAsLvlMGlhwiWi-qRW3pY5aEeXJqRCUYU5P_HM-c4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbSMlGZ70ZlWyIAuul14pxOv0XZAJ_xr6wCunVxgSO8Q&oe=6AEDF522"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7J955W4kbjAQ7kNvwFmlUhs&_nc_oc=AdrlUsYfK01hCeSCi4G3daIV4DihhJZSy2dn-jYMNBCK0UKNK043nfTi2BKw3qLDW8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-jP_59CJV4C4sTUsShTH5XbmijeaIobLzW2BmNXENfw&oe=6AEDD798"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5weaGlSru0Q7kNvwGiVJa-&_nc_oc=AdqVTYTOXwS1lL4J3MJTACY44Y-J6rHmsrxZqK809ZlQ2SrjYTAdOFetadyIaEVmnFA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg7z34CvBkiUAPg454RmDf3iNRSgnPjJ99GVf0hw0xoQ&oe=6AEE046D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ciy1eR8fkHwQ7kNvwHn-lS1&_nc_oc=AdoJKiL3gC9UmgpwWLDxUPWfnOuI-G1dvDor_ggqt8o4WdC8Qtq65d4n6IV2Efg_vHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStL-ef3QqsbrD--j92gYQTP5ro3XO4McrqLOlYkFODkw&oe=6AEE0802"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5zyJTHaz8IQ7kNvwFxfhLV&_nc_oc=AdoBtlji0w-DPA2qzfLPNJcUFmWM3mD1X8t7SrsVf6JzWTYxVjIKHFZkovab16Y_Xb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpImmn6NaK4VDX2DXmhD_PAFuSOkFrhWMxQGU4esbCfQ&oe=6AEE03C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aJjnWbX9KYQ7kNvwGeXvO3&_nc_oc=Adq1KtqgwhNqUB
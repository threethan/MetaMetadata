63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=In42HRbFM2gQ7kNvwExw0VF&_nc_oc=AdoKb0pltLiPxc9LO4ivIKIqE8dczyXWwUDt6USXQ9iwSBYQh0044eKEBf9us-F2tls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeZnJZXrXdiEzMUZ7_TtaUfGcsJ2tRNzO7dPkeF2vbow&oe=6A7C7BD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDUnpwgkEIEQ7kNvwG-RQcU&_nc_oc=AdoGFFtMiBdlIUToPURUZgJjizspvjTNyDrdaXIcxgdCxzJ4RokXaXGmYOgAwxNgrxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYSRqwLiWLr4SNGchR2Qw5WDB3NTLWwGHsneBgKe4l9w&oe=6A7C5BE2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x483mQRSNHYQ7kNvwEv8K6L&_nc_oc=AdpFmKlLwbVT1x45YbBG8U790QVEe0UN34EF8uVs86I7_d1J2MeBkSl2XHWIX-mlTQs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhBY4snkFQmwYVO8Qcvf_9uQn93Ju3z5KB1urD-k6t7Q&oe=6A7C7698"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaJ1VMGE87EQ7kNvwHbZC7H&_nc_oc=AdoyBuV7h5cM_C6wAAIIy2e1Aiq33b0PvyR8zm365go5h1nyvTdRheliuJUWfW8YCNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5HDCP6EWMSBwdCEeMFbFhnr0f_nYVg0wshbvzqaFf-Q&oe=6A7C6B2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REV2ZjtSjCYQ7kNvwFlY2n6&_nc_oc=AdpktUJfPK5q8HJi-Ls9YSO11I51-fNkCRNXRauqg8eytocRAI2MVAA7yjEcI8pgZ30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQDVSNCsznF3AwYKnQVOU337G3UTEdPO2hDNDLhHGP3w&oe=6A7C6EC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nksc-LV2OYoQ7kNvwFa9zZ3&_nc_oc=Ado253Xp1dDvOWyE7u_7-dH9v_WgVaMNnR5j40hVpjdlzI7KxoBbyHduBeSXFFDelVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW8ONeyu03dInA4cwc9oEQFPkA-VVr1HgKpu-QDS6xDA&oe=6A7C6A87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8OxitiuwKgQ7kNvwFG3TeC&_nc_oc=AdobmdAZI0MKez
2tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9brWGJI7cUgATT6DgKM3ZeYRa3G_7lBGt6hEDJ5m98g&oe=6A4F9448"}, {"file_name": "Progetto senza titolo (7).png", "id": "1060249132540287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393121_1060249135873620_1814107242812883552_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFEMgqrpXkYQ7kNvwHo9pWu&_nc_oc=AdrRUabciZXzufX21MJyZl8K-2lXiJmHh0Ofiv86HuhVEG7ipOmE8vPc-_XxfebqmC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAhj0NaBncs06rmAQpPdKdfE_bzEzDPmXNVfHpDWLiFA&oe=6A4FB528"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["education", "school", "students", "VR", "learning"], "long_description": "REBT (Rational Emotive Behavior Therapy) is a form of cognitive-behavioral psychotherapy developed by psychologist Albert Ellis in the 1950s. It is based on the idea that dysfunctional emotions and behaviors stem from irrational thoughts and beliefs, rather than from external events.", "short_description": "The CLASS application is designed to address the educational needs that emerged and were exacerbated by the pandemic, particularly in supporting students with Special Educational Needs (SEN) from socio-culturally disadvantaged backgrounds. It is based on a metacognitive teaching approach, also leveraging new technologies such as Virtual Reality (VR), with the aim of enhancing learning outcomes and fostering school engagement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://formit.org/wp-content/uploads/2025/01/Informativa-Privacy_revBE.pdf", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://www.formit.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "810139357995560"},
63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vA1hEYb8yZUQ7kNvwHqWIL4&_nc_oc=AdoFNnFNeV-1Qt_sz0kmB4Hko8XWJ1RVgi601MzvMEw0jl5Ktt3YEURokQyR-pydgYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn3BAfQpc-B3_CJcnOOgqIWzVd3r083KZ6HoQbjaJXUA&oe=6ADE0AD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1f6IWUbn5BAQ7kNvwHqtzPl&_nc_oc=AdqzZQhmnVCp1TChkivgPVIjuBlmlxhYfvX2iKNaYnAao5ijTmDebzRh7OjOd3Etg_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeSkynIS3Vcxlz-2Jl4xqH6dTJXxvDjrfJIyUctyJWMg&oe=6ADE2322"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiZZ30Ae8W4Q7kNvwExpy1Y&_nc_oc=AdrQwZ1ESOXV5pbeCXOt-p97pdFhyKf6jramLXZrm8rJxOlnIQvV0q40m3QozpiWHyk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNyswSF8Y4o3C0jYwG_6RDV5fISXi89Om_cDO9qbIR5g&oe=6ADE0598"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8qC_v2bhvIQ7kNvwE3xH9W&_nc_oc=AdrQwz4WxIUQFtGtkNaRUCsNVb88bRPfzYy3al6l7ST4_KHfNzlNcXDxa7JXCIikiE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMPu8wW_ml9isDbeASMWF26xW5qSbrX8rbgSOI5rOTDg&oe=6ADDFA2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-TLiOrnzZgQ7kNvwFfb0OO&_nc_oc=Adri7T2UuvQVLQazqAqG8d3GwpXwI3hPeFAtw-WmvDyRP9pdMiDUcCuabbLm1P75_X8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv_lNpJSTFECNW6PSDGR30yQjn12-isuqKa34zI8FcLg&oe=6ADDFDC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXrtf94JNmUQ7kNvwHUL7V7&_nc_oc=AdryopJ02J6LD6Xd13bMLVHJafdrxVQVIi1h2dpyIhsFDHT4KhMjniEpXXxWllimOYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKLIdJS3stLsu_EpGXmRozJ1mZvSs1jNmFhJk6HhaIAQ&oe=6ADDF987"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQLR9oG4FZYQ7kNvwE66dfj&_nc_oc=AdqZNNpmw_vdyo
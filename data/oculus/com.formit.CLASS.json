77417945163453", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393126_477417951830119_2072849060263983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MN3a19RRKJUQ7kNvwHHaMd2&_nc_oc=AdoF_t7sPdGTHd3lDdJ3vbG1fYGfiHYVJHtpZ6_egejpPEO_iWi_-clRKXh1SRM1lho&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa74gxNwoB6n276Xgsey3UAxBSnAPcDE1-P9oWUtpFGw&oe=6A8EF0D6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkjCD9aV14AQ7kNvwFHZcMD&_nc_oc=Adrc5TbX5EevGiknxI5niKtzTp9U3XbNX0I48A6sSbpB-4hWWMnymdSR-lxu64iyKM8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBxQYZFHTwWsPYo-MM38zagrNeFKFFuhBQxKxcKZf54w&oe=6A8ED0E2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kcjcx2rJhwkQ7kNvwFWsDOE&_nc_oc=Adq2uHJ8HuGFQhdqErR6M02d82Ok9GI0Tii1fMC8L6sCyf9pJH47_HHVUhRm5M85ErM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXEyEjwdVgUXMqsA94MKOtIw2Z_TsTHtTQK2bXLbxUBQ&oe=6A8EEB98"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vAEK1x66AsQ7kNvwEurrSk&_nc_oc=AdoaKQ931IpmZW5qkLKUAAH2lCaW8u5eQWvxNYJwJxVtEalvHIZeQnC_mXkrC1RYu7Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYPkZoqll73uaPj9bU20KrqNffEtVH6z1p1pQwh3dzhQ&oe=6A8EE02D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhqp7M_TKPkQ7kNvwFn-gUT&_nc_oc=AdpipdvrfPV0lI783ga-FNNASSnUmX7W1ZJyd8njf8QnPtEs6erOWHw2C9_n8dxWd7A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcmUB5uRHOLZueq5IS7A4HLauvvLHUVLbMgnQQbmyCHg&oe=6A8EE3C2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1mA8lnb-BkQ7kNvwHhsq71&_nc_oc=AdoBXwXf5h4c4JwcpmkaNuNLwliPCFX6UqCgM8YuPNCTqbuz-4g76gEuQ4KRGYXNmx4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfckgFttA2H2Xdjbg2qUfpN_VJUwCojFKPbL0gesAfCw&oe=6A8EDF87"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391781_1814431416
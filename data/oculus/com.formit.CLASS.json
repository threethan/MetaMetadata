63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzMwhZDJfp0Q7kNvwHgYtlH&_nc_oc=AdqKj3UaNetf_uxuqIa6Wi11uV02B6AusP_RPiqe-vA4x2-2f_aF9zFySgIfA7ZIN_g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeutyEdjUwbVnIDz9v8425r1RoORT7ogUqFAaX7duKJQ&oe=6AD0DBD6"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVX6u4Yngv4Q7kNvwEvD50G&_nc_oc=AdqELH5U-Cun3D9cX7OOpLRhhAcaJTTKbbbeU6KggGx2QXrr-M3y624b7tTimMa38Yw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMV1VulZdGAXDdvKgsOFRY3xYTJDpQWQqUtCzONu1a4ig&oe=6AD0F422"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb_zBacu_5gQ7kNvwECCxoe&_nc_oc=Adq68b2vNEsS-3pz51EXjpDpf156QcFIFDyv0iFK9Vt23_PIpaKa1RyRluSRZMf9zIE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORZr4TtN52G5ELpIRm9nYfuVZMAHS3WPSv87fLt-C4ow&oe=6AD0D698"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VFm7diiydUQ7kNvwGI3GWe&_nc_oc=AdpqHW6npsxgbVnhO-r70ODxicBnwYzWPmq539yh5XEdcr7J8sQbLyC1e8DoIZSlgCs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWCFhoMBigXwqDaPGqfWDmWSDG1ps1gY7XvUL_Pe5haw&oe=6AD1036D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FmN3LfAjFwQ7kNvwECKqhZ&_nc_oc=Ado4EQRevPEqrjQo5zGilQeeg11WFg-drhmbLcI0-QRFC_-0z_-q_SW4CDviuewzjZs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHnBWWV1PqEfQjmAfb5ljda6f-6i6dVMQZvcjTWYwDvw&oe=6AD0CEC2"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iODax5Xswr8Q7kNvwHviKY9&_nc_oc=AdpjfNMc9ZHApMm3fOGZO1jKWlWzLc5eNr1MNTWuAcOAlLM69TDMuWEZ-1U3temcEbM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyV-0xM-mbwD_2AGRRMdKSbNkjGO5MIvxsbbjhGpFL4w&oe=6AD102C7"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9BBFOPCTTMQ7kNvwGOY24E&_nc_oc=AdpCCsTqLH1s87
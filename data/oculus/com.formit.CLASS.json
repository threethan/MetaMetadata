63983858_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4uhdc3l2icQ7kNvwE8Qtf9&_nc_oc=Adq7VE_x5KEGDb1ivBkWqa_tyTYJKxHb21dWwQ6KipVL_cUTmGsYneIwkeMfwK692vg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mdi_QDUdJJn-ofgRf-QtCyTODC6laCly8b3oAUobXFQ&oe=6A0F0F56"}, {"file_name": "Progetto senza titolo (9).png", "id": "1921557785000453", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391870_1921557788333786_1998146923782032137_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw0T4_6vxHYQ7kNvwELvoUi&_nc_oc=AdpeE5ufiAIwD8C1X-0lbzAMdcJaDWUUc05YyPsRjBB0fnqgXvPikfGoSkvkeUxuRik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EJIkd213ECKTxJExwh-WIa8wFuQDfM4AUXhaZlc4A8A&oe=6A0F27A2"}, {"file_name": "Progetto senza titolo (7).png", "id": "2998234033687813", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391820_2998234037021146_4979533726739498657_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4uo2rD_RRMQ7kNvwE0PO93&_nc_oc=AdohfyLnAdxExIO7u0aggj1FepXGARVt1dxRP6-lyXx7D1wosIHRjFwVHyvEBS5LlqQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xUffVIIS8NlZ-Yi7gCA3DSRX50FRscPd9KKoDDGADLg&oe=6A0F0A18"}, {"file_name": "Progetto senza titolo (5).png", "id": "1258369625238105", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_1258369635238104_5889576394270193963_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYkqyfoN6JEQ7kNvwHLJiFy&_nc_oc=Adr3jUlyyaskgAW2RqZI3BroQ-TmbFgFywYDqQ3lJO1ixgBV9M5ehcEBu5akAUQYLj4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42-hIVC4guDoW6e6HQwTL6seYps3MACjNSZy_bJUmmaw&oe=6A0EFEAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CLASS", "keywords": ["educazione", "apprendimento", "studenti", "scuola", "VR"], "long_description": "La REBT (Rational Emotive Behavior Therapy), o Terapia Razionale Emotiva Comportamentale, \u00e8 una forma di psicoterapia cognitivo-comportamentale sviluppata dallo psicologo Albert Ellis negli anni '50. Si basa sull'idea che le emozioni e i comportamenti disfunzionali derivino da pensieri e credenze irrazionali, e non tanto dagli eventi esterni.\n", "short_description": "L\u2019applicazione CLASS \u00e8 pensata per rispondere alle esigenze educative emerse e accentuate dalla pandemia, in particolare per il supporto agli studenti con Bisogni Educativi Speciali (BES) provenienti da contesti di svantaggio socioculturale. Si basa su un approccio di didattica metacognitiva, sfruttando anche nuove tecnologie come la Virtual Reality (VR), con l\u2019obiettivo di migliorare l'apprendimento e il coinvolgimento scolastico."}, {"images": {"nodes": [{"file_name": "Progetto senza titolo (22).png", "id": "28181590671487988", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391777_28181590681487987_2468241978523976702_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JYfThCEnHuQQ7kNvwHGLV-P&_nc_oc=AdqlglJfudYVfEqDnjDg5NfzRRGZPnhTSPcYkR3_YAbRwLUFANAJ-JYu4qrwZaDE1ec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g7-4nnCOh6YWV1U3SwFUhBjsoK4igj7V3J84Kf-l89A&oe=6A0F0242"}, {"file_name": "Progetto senza titolo (14).png", "id": "3753701498216304", "image_type": "APP_IMG_IMMERSIVE_LAYER_OBJECT_RIGHT", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393059_3753701504882970_1242557949065619615_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXvaekIMVx4Q7kNvwG2AWoO&_nc_oc=AdrGDdV22dAp3OoC8s-wVXtmUA0X5kTy9owV_NNcNjEoCGxQ2R564yMpC0pdsw_1Nn4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hr3WKlX9lWMEbEBFExECh6UnNcd6c96RWg4qU3Ck2Qw&oe=6A0EFE07"}, {"file_name": "Progetto senza titolo (2).png", "id": "1814431409359123", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391781_1814431416025789_8949859516560160041_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jgq4_r3IsAQ7kNvwGwm_2s&_nc_oc=Adp5FvoWJ6cQIK
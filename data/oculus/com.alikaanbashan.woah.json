nshot_4.png", "id": "1206550881582595", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824322_1206550884915928_6033695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epiXRdSTIDYQ7kNvwFWwraP&_nc_oc=AdpzZRdmkkxFy2q2SQ71HFxUCqbEOcMZFANpVYsmNZRqgi2KYOkvfqSOg1K604M1JW4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh81fKnnuGh25DCFN-3VnVmKQN3ClyNCMVMFFTpueRBw&oe=6AA3FB63"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6qEhM94znEQ7kNvwF7CmYw&_nc_oc=Adpt8veZZvX7oXmcOkUvnTE0HWQJPR9j9j_vjEeaGGTZHgM7ryUF3_sCmmD1PkhjJYo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaPOv9gCdp-iuYRHhXAVt10t79UzBaoM9B8KGONqgCJA&oe=6AA40445"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D2Ykmx-OgwQ7kNvwFLAgh6&_nc_oc=AdqwELh8v8ZZNo1rBWTehyfOZhKdzPeO1NGR-tGVfOj-eLcXmerG3_dpQ4dkVLpgSnA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxmLCh3NttJabQDZz8bLuZj_vq6n7cQJU97jSefr6ghQ&oe=6AA40130"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng2v5dO4kyEQ7kNvwGCu_JB&_nc_oc=AdpnytAL3QsbYVgYOixYc3KvC5qjYgbm0p8r6t1eGQ7ONybzjfEE4LD-d-fJlmtCBDc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpNg3bUt_r8uRHnPshVTBLFz07V68cmKKpt99X1u2wIA&oe=6AA3F9DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAzErMi8sHgQ7kNvwFvZsWA&_nc_oc=AdpwC1V_suTXWYoKzd_Y_4ha-Feoub41Weuo_cWTyML8-N4-J-yrllWjL1mndQrJ5i0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKABILF9_KU-LaSl7we2c_ciu_wKHuX2VRtDpBfXkLzWA&oe=6AA3FF86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "exte
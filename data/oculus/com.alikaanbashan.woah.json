695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHnyiz2-WtoQ7kNvwGLVWoi&_nc_oc=AdpR-YojvJdj4v5NtHgwSgYLxa0L-knY6JDHuOJ1XiHJaCFJN3kYGQLZRfWFhn0uGbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGA0Ooullm3YwPrV93aeIOc-Kjdlv6w_5thE3hdGhg5g&oe=6A578463"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Yv9r0emldUQ7kNvwHQPMNJ&_nc_oc=AdpmCE0CqgQBPvlF3VyP1OUyA1LV91RsnArpJ5CvE4ongNmlmk4l-XAK-seOUYh_UsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ0GSuMUDgxD7CYaaNSGbxsKZlJ6CqtFZTRnA6y8r9wQ&oe=6A578D45"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hAI4QujSB4Q7kNvwHSNQgF&_nc_oc=AdoJ3vOFpq46gLxmSFdrIkXwZbM4p1m9x6e5zwWDZYBYxsU9Sh2LG1COmVRSEoHUXFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu5Ao2aTMIni0wPuvpu1BXUYXEaJF8H76UdRy0uBz1HQ&oe=6A578A30"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3e3fP5-Yb0Q7kNvwHvTy1s&_nc_oc=AdqLyNgZLW-31PpVrZD-PnMrjdrfz76_5Z3ciR99dO-3REVdO8Rl3LDNz4OqZQbOiH4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCJe1xJLO5t6BDqSu7_JqB41aCCwc6i-Rwl253aBfDvw&oe=6A5782DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_ili7vMv8MQ7kNvwGMWXwN&_nc_oc=Ado7PEYe6ngI2Qj_B9jiF7Swb-tQ8JXyB86_ICTQJg2jChQct013IE6Bv9Mqpin-Jac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnnqJW8EwP8Te90jvHp8inJ7_VqjJTxrUapqyEV4wfbg&oe=6A578886"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
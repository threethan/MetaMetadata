695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yk1ACXb70c4Q7kNvwG93akx&_nc_oc=Adp1QPGKcB8ybugcDDtosDDGeh0eh79rYjvi4UVxU6UH-pMmVM-fY9JEk-LvMAZZxnI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DTKNXu1ci-yFzB-_afat0n9hiCPT1ho1iXsFZ_B_Hrg&oe=6A2419E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgKRdR_sfjUQ7kNvwE68kiX&_nc_oc=AdowjZbtNqmjQ95yM0B1JETMDdSzK_1NXhErvOXhpy3VS5LjlSCNTF_Uzbka-2vaPwY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LKIksGMwo1d18348drifWUE0EyYwLGqQ8w2AEB_fAXg&oe=6A2422C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAqqmmMgBYEQ7kNvwH0dXGy&_nc_oc=AdqviTIQqHJyYCy-PhosWw-sNjK1F3-43ZXP4KLSpiitzvzNAcSnFKNyY1pnWdCqH0U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RJeZhwqoHGVcpgzcHw_64Va4c3uFB1RgK75eY35EdFw&oe=6A241FB0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZysVuDxnZoQ7kNvwGy-823&_nc_oc=AdoeHE5uEbzvJBe0BTtK3yP88QYjTOdeUKUNGBAxY8SCSS8EXGTjZ5OgB101lsBPe60&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8108qXdCeKhUFSKoChq5nH8fJu1C5NZBkvg_3AwHf97w&oe=6A24185B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiqr6knjm20Q7kNvwFQkaZO&_nc_oc=AdpVI4Naqo7iDLhC395M48a7wYYE_W6JKFQiWtAMB7_N4xSqZn0Ka6vyTdBfsL2ZhDg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WkcxLDA0qdUuiqkdy_mIADH-ENJrhVJZexFqjaDtnxQ&oe=6A241E06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
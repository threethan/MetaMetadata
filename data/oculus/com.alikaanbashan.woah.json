8_6033695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBGN__ppOUwQ7kNvwH79VaX&_nc_oc=AdodgfvndrvnzcVpSu9kYdNV8a8dUlBwq-_dHarNMaN3vDeyxo51UQK_vINnyXrKPfM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UM9rklPgPtUdn3GmoJG4ZnroqGftX2fhD_4V7DsO7Yw&oe=6A3931E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyryZtra4KkQ7kNvwHuR202&_nc_oc=Adoy1ptZFJljQPkEe7-WI86sbySJ67ghy_6QjpmLQPcqiV8K2kYUyftjp-UeNmIjw70&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zPJmm6YiFGdQhCfhMhqaen64WvwpLDJ0ZEE2BhqpObQ&oe=6A393AC5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26Tb0R3tEQwQ7kNvwH2QLVi&_nc_oc=AdrfThq9Wln8Uc8NdDuaeY4xsvE4XkGDKRjmJ7wImSKlRxzi4amzaVAF6Vug1IV6eOc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Va-YzNtUUCaQPXdO-1ub3mcnrk56k93aG4M-o9lsKqw&oe=6A3937B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF2iOU8Vjj4Q7kNvwGvApiw&_nc_oc=AdpeiwI5VoPrKbkpZopGKtbeyr-9UhoLyMRdbCntZBqWy9rlDv91GlEBoRs8EPZATSI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cX3EIS7ovTy_9zMEgZ_szqXsV2wTSWCCfK2PQSZxs3g&oe=6A39305B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb30gGfR0HsQ7kNvwEashWb&_nc_oc=AdomKQnjmOS5mQL3jNduRDqfX6OXjwSgxJFqULhFVz4tv2DneH05jFMwPMK8MpYzOfM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IWl0_WK_RGE-PkBoSlq4FMipaaSqpvPDYWpS94K821Q&oe=6A393606"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
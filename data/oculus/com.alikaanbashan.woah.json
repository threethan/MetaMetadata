695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7hMyH-uWSkQ7kNvwGkp5pr&_nc_oc=Ado3frlMOoauPqFWT3F3pIlNiKX4oB3mJtq7hLo6YubPLvWnwEKpfyVlpXqMI6V9X-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wawwoFIY379Z7DWlyxCq03_DTYIOW8Nmunh-6-xxzjQ&oe=6A2AB163"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGqZ7Ni51ZgQ7kNvwGF01z6&_nc_oc=Adr5U0MB7Fl09WHRNYkVOhctRNTlmmIDaDrIGRIVePuKBFqNhqafYg44IlekCAS4yao&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UcLZG3s8vJz7a41dixYCyFsn-lNANNbxgQDkdA-svtw&oe=6A2ABA45"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vvvr14r0RHUQ7kNvwHu7cmy&_nc_oc=AdrWsSkvoMEiivcwamkwFawfxzbS2nPU3jVMp_yjyUbjIUna1d0NKxZVDXP71sPshFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ii9poksI-xT_gmufjdm77FuBDYJLZoO8iNnya0aDGCg&oe=6A2AB730"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYGFp1Qe7f8Q7kNvwEud8an&_nc_oc=AdpMHAdTnBfnuaoYS_yMWD9r4__jRaXOUJaazya3xg86D4zfJE-JdOy2Oz4FnK9h858&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91A44ok6pHwPfL3WjT-ZuqX6210e69Ziv9_uaOQY5u2Q&oe=6A2AAFDB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vJb1YI7-rUQ7kNvwGhb9HJ&_nc_oc=AdqNx2ZB5kmQcNDFwoU6Okb43G6ZxP25XYYamIJk-T3CrQlK61doUZPcyPflsQEgsd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DSXhid__ZWBt-m5roGtkWKyeA4Wb7Xpi_aCwoy_swTw&oe=6A2AB586"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8LkBM50PxYQ7kNvwEXIoub&_nc_oc=Adrf0qYoXdr_M7q16kZ9FzYWqnBw22u08jdBQMMsiKHDmovJDEsCrO46Svmnclz7K6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d_wluiP4jiEVdJY3-UePfgAOtLN2NOkzyB8aiE2MKPw&oe=6A43BDE3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7TlEZKKrYsQ7kNvwGZ34Ta&_nc_oc=AdpsR-5QkpxrXaMLwr5sv6i5qfAMJY78wX0IyQvliH6-lYAnwJpDwtou3uvuQwef7y0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sNPh0xWc6XKqr_3yr4eXaUqD5NPihE_9LfXyFb2dy4A&oe=6A43C6C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtzG4cl8Gr8Q7kNvwGiJwJl&_nc_oc=Adq3mGHtFiCIWKcRdHzTqqovK5okF7gzSrin13EOrSGoaw3Nw_0fgNzMp6WC7w-OELQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eo9JoNbFpxiv6Tgj1TUaXm1dgfidkC_Z1JF6t685JiQ&oe=6A43C3B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETSBPpwIaKgQ7kNvwHYei7V&_nc_oc=AdqucLNY8MKE1z-rzWXwIOiTY-lrD64GW7QFINSrX0uS8MFsauA7YDz5veDd9LH8djg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lYjGDcbhs1XTJj-Gqg8ltLkTq5dmdHuBR3L7IcgUGNg&oe=6A43BC5B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bubSM-mUBIQ7kNvwEBdpJQ&_nc_oc=AdrsAEByNI231WZA-x4KZ5LGWX-4-L9qnYgIJSfMOj4B4iDe51titkHbVk-nxmbgC8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QbFocjJ11WqEeqM446Xia9pgdOZkxjAvpe_PLNVEWSw&oe=6A43C206"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
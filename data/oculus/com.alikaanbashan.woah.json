695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMkCAKJXZCwQ7kNvwGgik4B&_nc_oc=AdqJcTRuvbiWGSzqeuomTyn2CHHgKvlDvdUnGzB8nwrnmVGKFHNRfca_w0j1hVtlyy0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YdOD9iU__zeP3-i6GVd_LOyQt046fwzZFvHR930pQBw&oe=69F5F563"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZ4PayDEC_YQ7kNvwEdQgfY&_nc_oc=AdqiVZ-jVocF3BX4veHQJliSUaS9P9Z5RvkXjhcpfsB1xK5Mf2vTWO9v3erj6J-VW_g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hByN-ou5z4CT0EQluKvESiXrMtnk9IvXUOOLqIjK5-w&oe=69F5FE45"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yzdU9uVmBUQ7kNvwGw5hRB&_nc_oc=AdrLHBZiXsdTDf-TVRsEFuuQiewuZk1wjgr6-fJ0dfrmluqIsAKb0sweCkDsVLhpPV4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0nqh-RJeTJBym2k6TAgmwAFI2tMhR5uaY7ASJ7ceYo_w&oe=69F5FB30"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYs5dxLKaJsQ7kNvwEXEQbO&_nc_oc=AdqvShBBQqTWo44tuopnR1k0ObK3HTMSP2uskN3fwHV_98TDVWOlZHW7sgdR4q2-ZLU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13vjUJR7yCZcg4VQqE6kAGdtxBRtmX92Q6ROOX_XOAZw&oe=69F5F3DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtJucA2ELTQQ7kNvwHc50-D&_nc_oc=AdrhRXWRhvWMPfBIAvgMA23Ct5kc9BZqwO2kz2r3MOaQewaOJ92wY_q4fc0QIMInsng&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3S189tm_XjPeR0IRL6s3acOFBa9kliNHWe4o2HgJaekQ&oe=69F5F986"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
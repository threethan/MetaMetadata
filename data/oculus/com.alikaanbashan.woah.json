rd5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiKtjJicR561KEUUD8COHUvgaBok81d4sZulNc4NIQAQ&oe=6AF8921B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RL0_eKSwf50Q7kNvwF5M0Vv&_nc_oc=AdqF0wbVl-YFaC_YXpo0abEo07eSXNs3MGcquUs0F1BNFUKPvhYS7PhygFzCEEg1W_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNqzFVZKqPAkV77ecU9JSNR3A63U1fVqc457hK-kqK0A&oe=6AF897C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_t
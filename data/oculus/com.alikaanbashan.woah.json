695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-r2iYg8WQQQ7kNvwHsEgjb&_nc_oc=AdqV20XBt9xZgNTJhGHXa08RHe0BBjmqMMYW-U9rwBPdJ9yBMDT3JkthsjCuQQkGP6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bcrtYwPo3BWsCAjJfAeIg3vTkKlB9-TgdEcnqebloiQ&oe=6A159963"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wh1g9AIK_AgQ7kNvwF2ObPF&_nc_oc=AdruDHmueQyj0QijY76LVr6Z_iqwCpex5zV7v2vML-me-Sri6Zq-i2CC6AhiIFhrtm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jt6d0_WF3hrEZX49bweATZu0dSl4GLp9t17OMk8yYkQ&oe=6A15A245"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J78vWjWEZSEQ7kNvwFoytAo&_nc_oc=AdoRorbnyglrZlNoHX05Q-i41GXLvowNYgpoDRCqqFKZLoPaCoP4GgXny1fDz2KwXhg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77BUcgGxtY4u5QhUjlAPqg2tvjVJxZxWZMbtUdz3_hjQ&oe=6A159F30"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS5rI7nAtuYQ7kNvwFt8Y7v&_nc_oc=Adq1BtaWGnKHiTGTajHJiQ4RWDAyUs9R24oVJ5LPChpGkdbKn2ea78z4u9pVHOGckoc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FqnxWCS4N_2pLjLvsUJxKenqrYDp4rsk8iA6ue4Yfbg&oe=6A1597DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1JedZG-J-r4Q7kNvwEPIcUt&_nc_oc=AdrJ8xOQRaD3xyE8Ckw5WtM7iHKT8xzzRJTbHW9-UbVwqgrGLousCCHZFuEaIZcbLDY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-F15HwOULWbSGVeMtJ9z_8o3S5_89kXJNsRk_Axu5IA&oe=6A159D86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSH61DSDOpwQ7kNvwF2oatG&_nc_oc=AdrFkV_DFljLaYHRBUWXyX4QtCTV8i2KeLnItihvi2kzUxjR9IUyIrqyc04sqTl_M1c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDB7NppVSSQD5oUE3xOCDRvqCOcV1lEKQWtvPbuvtAhaw&oe=6A538FE3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjbYieYr2QsQ7kNvwHrl2zq&_nc_oc=AdoNV-44nElNOjErTQi6nnWGVAa9zS_1O1m8c7J64-MfOFSwKm_W9VQBy329JnVV-nU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuAHZKE8XOX0SwDxDLTJKiViAj_xNJC2OPzjZvPBKf1w&oe=6A5398C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8PnlmxlOL0Q7kNvwHKP0RR&_nc_oc=AdqF1JA_AfRvFQFEafQ9J4E_WLR2AAxmzl-vI8cUY5q_dDMdsHav2b507P8X-7H1AiA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBziWwLCOD1c0fhJPv58UeotatGOqdlgEAhJduqMPEGXA&oe=6A5395B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu9E43hIPvMQ7kNvwFI932G&_nc_oc=AdrUpI8Ands5MVdOtnOCyO3LlyyCnMEjhukKhXHIEIMMAouOrohRqmEHl37_CHF1ys8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCazObNajkKGF3_7FB5rajb4t4ZLzZfyHBCtMshHiNDnA&oe=6A538E5B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENggOK2xu2QQ7kNvwFN_h81&_nc_oc=Adp-2Q3v2tKYSBdyboS5uDAIBRKstC8_b9wSvM-yp8SXxJ2BQR20XCDwJulHc-JMFFw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCoqi0sgm1Qg9cXt7pBkP7Jkw7-xjtB532iGen8aqctlg&oe=6A539406"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
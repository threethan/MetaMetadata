695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzEZHBIcGiEQ7kNvwE5uJby&_nc_oc=AdoKlay5YfgZCuOLddHNbVyx0Fd3YzmCE2b7u3V7ZrTHKUJSHRImUWyRNqWxvROZciY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F39z5FpR0yoOMB1WaTM-gl4ajz41vcyA5Q561S5w1PQ&oe=6A12F663"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ_JqKo6k98Q7kNvwFFAyfS&_nc_oc=AdpQAp21Qj4kNDPnoHbjI0lQjjFwS0Rae14it7fzw-CIwujkjM-QfVJth7500YtnGl4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z1PDf0c2t7s-bO0qtrMAqgLn6Q6-ltK_QqOXCMaMfjQ&oe=6A12FF45"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J78vWjWEZSEQ7kNvwFHeyo8&_nc_oc=Adpyn06Fmu2xyH7QnBHyVp-u43J8D7f_D-7iAzWMRLUuVzvaZVZ3m6zoi5DomoNuPwI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TkdS8muBNGfBQosGjTTLp4hfQUjs6yl98iCjlV8dysw&oe=6A12FC30"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D5GZ5wKTycQ7kNvwEROIsE&_nc_oc=AdoqAs_K6nfkuAgt1uKBLkk5xUEkYHnSSiFS8gWTds3rhK0bfECAS3ri_x9eHQSs4VM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cfGyZP8QKLumxbDYwIxbXAZoSoqqerXnaDbxgN3Eezg&oe=6A12F4DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaOlYCNZFFUQ7kNvwEO6otm&_nc_oc=AdpGFGdNjsYlNPr1vFNx3q1vJavssEQn-0NxaMbSxuFIoCP0qzmTqnTliqGP0dJUrg0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_WNyLZAcBtI6ASLaIntpPIk8M316W90R43F4K1iydpw&oe=6A12FA86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
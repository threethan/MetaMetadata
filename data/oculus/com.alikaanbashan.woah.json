695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq1snGX08WkQ7kNvwGdT-nF&_nc_oc=AdrDThfUWGuFTyKkAjDj3wvyu-39f_KMH-BKuepgoZ-_ovPmbb5eJO42_-xu3Lvdwgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tfpIVCPDsOP5l94U_40sPXXj4cJh3zUzqT9ga5aJbnA&oe=69E4D1E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWBBGOQS-MkQ7kNvwH8CJte&_nc_oc=AdqpYEU7EB5QUQkEWilaOw71UfHE0BvplCFRlM6bunBMGvP1MZQTuJ68igk0aT5SqSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R8-VJhS9vCJSU53FtbShr3iSN1SjYb6UuJJp2mlny0A&oe=69E4DAC5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2rBDNKZK7YQ7kNvwFvnBCo&_nc_oc=AdrMPFy1x3Kdu4qybpuAAWcdCeENGx_3t9rv_IFFj0Bj5XBUPM42pq1vSL92YCJl3bg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19CBKGfB1URLyH5T_6SVL4x8cCagMyzjbbExg8l9eQrw&oe=69E4D7B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qncRjp6PBpkQ7kNvwHnm5z4&_nc_oc=Adr3tlDYUxhPp_l_GFBLfRTR3ejHv81c-bDKOBQGPAAygy-kTRlTOh1ym9Lfa6HaOTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uqfoDQYoi3suuR8Ru3H8ichTi3QfzRWBpgAB7EUaXiw&oe=69E4D05B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv3-1TMroC0Q7kNvwE8C6yC&_nc_oc=Adp0Q9IIE0q97CsKPe5DneLY_gxBRKBanQ0mdLoLDgQk8raZb2IMbKSGPQ7OXwvmJMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lc5UA3cEYyEHE38HaTQ5_eRvStsN_-vxU8hVnqJKHMA&oe=69E4D606"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
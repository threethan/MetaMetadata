695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dfNDMp64FUQ7kNvwHiEI8H&_nc_oc=AdoxbWxzCeHHqQ78-K6h7w87oXN6bjBxlwdS-cuZRX2hg5gZ1MiyhdYOskD-fAg5bnU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-iMBvut1PUoEo4dkm-jt2I0EWRFIgeWxY7F_xpXc46A&oe=69DA45E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJF_MAbxOR0Q7kNvwFDLZlo&_nc_oc=AdpKFgyhrTknKc28ItGzsykfpCok9kshiqIQuMmn-1cHzSSNl0FbYKuC9DQ7aWVTOtc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ni1CRoOdwtcuJ30sH7nYyON8v-y0JuIip2x-Lz_YBBA&oe=69DA4EC5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgwGikrclOUQ7kNvwH1Q7Tl&_nc_oc=Adq1Z2YnYUDVk8usCrwrUhX8TdzCfeCvKlfsdrVmRN5UVKfdmLSTnt8wdaU2cTn1CTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af252Zh46IIToXp_Nk5n_Q-tHD_JGmXY0FhS8EIJyxwkhw&oe=69DA4BB0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxXsvSWrmgcQ7kNvwGNSUoD&_nc_oc=Adq73NNwdPbbq_2zRDpGoJ_cyEqwn_aZzz1SMq2FS7T9sMlN5j_AUyt59pNBfOCkX6c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F8mQ8hEcRnZuYaSeaAHwGPuTpMoTo4MIeG7yXxlwRtw&oe=69DA445B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_8969oz8ywQ7kNvwH3Pzm-&_nc_oc=AdpwQQF-xnZiCnQEoQmjdEciHQGO11cRv757gM18b6T__dpP7UtMiXI-GAPISRYsMFQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s3ESdTcDQ2w14azwAjSqUyBO2opxNKiyYAf3k5UZ3hA&oe=69DA4A06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEl42JXSxv0Q7kNvwF1mxts&_nc_oc=AdrKDaYC71RLnj-yDZQc_GTQtYthKpBtkfLKmAg7YwGvp1jPCu89pg6TGF8K5EfmNTg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GKaEf9JrF9dMSAHG-r8a4kDyNC0qBoQ7E1OzVnP92nQ&oe=6A329A63"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tA-Jf_jhPpsQ7kNvwHAYK7b&_nc_oc=AdqBsjGXgZXUtcUCCEJ_Ovl61K7yvSi08stqzdg2AtG4lMGbxJ3PdMZH7TnpadJqoi4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iG5hb24YY38Kn_8LSR6w-cXwp1UCiD5EzEfMfwbMIVA&oe=6A32A345"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1IobBl-Ej4Q7kNvwHXz-sc&_nc_oc=AdqvjtSGzHiw85Bd7Sjq7HAoF-ZUjBn6oQE-GKy3Z8Uk3sYkhS8apSjvR-axziRlXhA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fGtjXa4ot-bwG6q6rwdY8ZOjxsMDYiNu3xBv6UXOl5g&oe=6A32A030"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFpaoTWvka4Q7kNvwFah4s_&_nc_oc=Adp44j_VAnzEg-KntTVozeWacm7ZxseSpozARroKksTX90-1ZMIGTR-jY5wOqCSZs3w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88WLjLWnOmbZ8lUBnS-sCmphe4YXmZj7S5HLpjuky5mA&oe=6A3298DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYGH1pcBMEwQ7kNvwFcXkY-&_nc_oc=Ado9UYxWL9gQc6ibH7ebGLiqNRUib60VnS0LtrYx4rmxEQWAZwDbiHB0pga53qTt_To&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DieZE9nCsdVEvzjXyrlJqddNs3vj2jPJPcXMtBMmYRw&oe=6A329E86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
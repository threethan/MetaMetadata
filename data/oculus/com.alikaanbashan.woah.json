695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28plhUm3QYgQ7kNvwEFX5wA&_nc_oc=AdqyJngp4K5U7ZV2045gXdr06nqQyfB_ZToieHjKq0QAYBD0bGFKHfGPVUoF39Gm1Uo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFOGHcDD1OEXJ3IMCek8QFLiyCZKNaZWMdNkBGj1vObg&oe=6A4E49E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V670dYcDAEoQ7kNvwE3N0Bn&_nc_oc=AdqcFmWtvKzkveTiDlfFIf2FKJGFaDgqhlUdIcTZvimv_EB819j6tDt3VRmShRM-rX0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ4X_tXVFJxIftFthQZFO4YhnGAMK6BJi9FS93aruVTA&oe=6A4E52C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXz6044CEF8Q7kNvwFcMVKg&_nc_oc=Ado_HSpjiqeBlxWk32w60JUO8RbIbkpDmBjTEzBzkAtJ-1jQ0wJvM4NZWD8pz1N8EZY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUHJ-MxGobvw_3rakfeZlODa4Ib8JIzPOD5zu83v2rkQ&oe=6A4E4FB0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSzULXLp7x4Q7kNvwHep5lP&_nc_oc=AdqLXDXmk7F8bPS7Kg9x3opapxrStw3cU4alUFaGoA6kgP6KyI-yhDF1EBPOtUtikHw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnxGDn7Tqz47tIbk_S1IbhlL8554HvwbIB79u8JqKYfw&oe=6A4E485B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2JONsMc58oQ7kNvwH7x66v&_nc_oc=AdqbSoggtDzbbo5QpHObOHLhjm-w57o78hehxfOiojG3sfkQjAivOeoPtFGJcR041Wg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0lnTXqZuOTNkTxRhkl1owEvMHwy69BxCDo3MabQ4zrQ&oe=6A4E4E06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
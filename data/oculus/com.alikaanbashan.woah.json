695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdejZJ1tad0Q7kNvwE61zEZ&_nc_oc=AdoBYZ1aR2AoyXjw3QYLk-IzcjiX_QKI37za4TEzZN3rZCKrNWL2YcGXUwFP3Tl6nQs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y_LwtPQ1xtyf-eCDy3fADyr9qWIZX468E_idYbMu82w&oe=69EB6963"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfWJqulZuNMQ7kNvwFj6nNa&_nc_oc=AdriZfs8V3yTKDtkO7k0LESV1zmPH959ZX2ZlRcMkflr6XXHCNeE0ZrhKLat9CgU1yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kebUX9PTCHyydkGPiM8sKLRu1YK-Bfg4CG9wJLx-biA&oe=69EB7245"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_ztdoRlCoMQ7kNvwGvYAie&_nc_oc=Adqyj3MY_M5Wk5q205X9qNxv0C9V1ASBIa8IF0bGI6ATp8eVgmTvZy4jvm49pxobpMs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26UlkUYZ9wWoM3189m5NcQmktWxicuEVCY4BLpZWQBrw&oe=69EB6F30"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwFdqDU3KVUQ7kNvwEZg6z6&_nc_oc=AdrOVhVNhGWD1PK2pZbfe3CvPG5iMNo74BPUTCiolmPZcrSMwKTpRgCC8XkSPfjDVoo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GbxF9o8sxY_qZ2-3ABz7Bu35yNBp_EazwQFQqP8ouDQ&oe=69EB67DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XavLQT_vZa8Q7kNvwHv7y_V&_nc_oc=AdoAKGzLT2qAM6VCOLLPGZMmtnwNC7pozp9QvHozbfS5METab329FXec4LIjBq2yfDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cnQS5ygoKHfQbPRm0UwtSEkr7kAtwu8iNjF_Y3b3qxQ&oe=69EB6D86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHnyiz2-WtoQ7kNvwF4wJGr&_nc_oc=Adq0OoLksk5-q2ZHQJOOt3w72fEbukAIkRrV7EUW3cfeF_AuscA0AmGD87s8Zr8yvwU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTRYwXrEmM5UaEru1ZR6DCu2voPuUcoS9KS769BiJSEw&oe=6A54E163"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Yv9r0emldUQ7kNvwFzaZHB&_nc_oc=Adp5AUips537H4OU1st1DRmJcEJMBKrLVZM3Tu3_C1eqKWhXpUYVIbsGxvPLLQfclpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmjlEPhUomPDaXXzv07kNp7FPRHeqEE8YSQn7yN4CvrA&oe=6A54EA45"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8PnlmxlOL0Q7kNvwEC0Ywr&_nc_oc=Adpz-80GUKstQS6pRYShN5h7U6RcNgoGJ05602bOFQK-2lWDisNbocO_vrMz6ogV0XQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqMsbsBI49YMixSBAL8kbEuTp6Jjz-S4_BkILoYNIjMA&oe=6A54E730"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3e3fP5-Yb0Q7kNvwFIv_Gy&_nc_oc=AdphuTxhXaGhU4TFO4LudFAmgd-xWV2MYMRrkNTvZROTTm6UhlVTiOX6-UahlnifpX8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8QYJdFuzIeoNz4TtzNn6ZZr2zwnX5ASBzi3G4fSZ21Q&oe=6A54DFDB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENggOK2xu2QQ7kNvwEchyke&_nc_oc=AdrprB7JqqQaHp9dBLvN4258jbyCWQICT4KMzVBGyBPRaE_GNMlo8HuODa2NN6ijfzM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9b1KV1RH11Kyc-XMDfHqOsUWw6cy8WrrB2gYrGZT2bg&oe=6A54E586"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSC3SJROWkQQ7kNvwE3IHd1&_nc_oc=AdrJEn5zfRoIL0S3cKXQf9_V8839TLO0GWDrhbc0XSSo9Psni4mAsG-DYJs0IlnVtwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0krwlo-6qU_wRp0Y_Fl8fxegtSp01LLTMKnd-BKkbjw&oe=6A353D63"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f273hkZT_qcQ7kNvwE86DoZ&_nc_oc=Adqd3d2RpFSSjO13NdfH43eJyA0Ho0BNNifvYJb6mgbIZyoWMZOtMarFIwh5WI4RvDE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0_39vFM801VViy-vjwQDvOjl-lJ4aZg6GvZ0xenNaVQ&oe=6A354645"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1IobBl-Ej4Q7kNvwEP5aT9&_nc_oc=AdolTOhqtZox7BS05GjOqUJMHWnrJGG74EE07Zas7bmGGoVHwj1BS47z5GopBA3u0Lw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q9-zdcl5M3OD4Vh-Df25bdfIw91vC--CH2L34o82CUw&oe=6A354330"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HruM9SgrOf4Q7kNvwGX8x7M&_nc_oc=AdqQh_zmng7huZKrHmvWmPjIuCFcf-USod13EyPtFcGEXLMKACq0pU0UY-98OOlhuTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pMd3wQ1OMt4hSyoiDHQ6YoI-7Qe-gzCwtfP3-91nQBg&oe=6A35741B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_cJjoz6_mkQ7kNvwFIxgPp&_nc_oc=AdqLhDBGaFu0v8-L-cPZqQ8xABoOKYAo29qSOq8MXCNl0rGo7is8blzwkBfF0eHruro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qlJF23uuYpOVDaKpUZkraz6WYlZ4FDrDm0lIhdjdnjQ&oe=6A354186"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
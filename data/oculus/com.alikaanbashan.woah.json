695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dfNDMp64FUQ7kNvwHFL4iU&_nc_oc=Adqn9egVRTL0xY9NerTdANwVXFfbAnbs4Nru8g0gsEkK9A1dLS9Q9a5zrsVkcgU0lyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vDW4FtGYdryZfM3b5v5yC5CN9yg5BuU3QHvedY-I8gg&oe=69DCE8E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lJF_MAbxOR0Q7kNvwEtskId&_nc_oc=Adob82Ho4WCYIkrfzFGzOgOtAtdQz9-Uk6FLSVZlYR7pPgUowYYkzd2aW0BUAmgBrmc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iOu36FN1cOy91iXi4Y74ju4dIb9RMP4qXUIBG5HUAdg&oe=69DCF1C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Spo2q7cxMsQ7kNvwEai0_Q&_nc_oc=AdqEQhsdRvuprbdk4BUqDBflaSayzbUZ2uRLlxrSxgL-1txDbHIwYmKg9Iqg9PvBpLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hJ0i8dV3WnnMnChKWc5Y-uejMqi7_01W8hivKubKdsg&oe=69DCEEB0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxXsvSWrmgcQ7kNvwHUI9Jk&_nc_oc=AdpXveVGhSNt_tzAC7ambnsDxhlZMJwntmY17l8S5RtI_5jlJJ0BtN3SfXjDbqSz5zs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xls6PIz9xathTs8MjiWoy_zw6yrDb9mWlD4DZrfPF2Q&oe=69DCE75B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_8969oz8ywQ7kNvwFVdjUO&_nc_oc=AdpOYclhRCKDN2MPp2qXjMjTyinG7S4tVlkP7F8ixUfayG4LwFJuQCeVVla7_QSaQos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3liwQQ-f2lwE6Wzo-FI9twZLMyA5BV87oK0ras5ZmblQ&oe=69DCED06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
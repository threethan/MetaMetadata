695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsSldmrXHwYQ7kNvwGLH3VY&_nc_oc=AdqYHNapzzesDIJn7MJ1dmxIICJ-JznyXkPNMjEYXMb-MGIVJMVGsD8xJVNJaRc5i7E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-yPkpunXtypuhD2oSHKld4tfzVFbrGjyIvN0lhgkOzQ&oe=69DF8BE3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIcj5Nsos3kQ7kNvwGg_YvJ&_nc_oc=Adom-APSaEpgxY1iKYrrnXd70Nx-OvhMYH4ZpMv_eBQlrr5f6Q4qAH1xW6ckR4LGvmE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dk-ajfURba3FaN27V1FONpMk9xJRyTihnZ9iJN_Gxfw&oe=69DF94C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR3-r4cNkY4Q7kNvwG98RvB&_nc_oc=Adqm1JZDt6zE7a9Q4uORDnsq8vVn-6mausq2V8lONpVbIP7U0GFmLcY5FePu7Rcpfeo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vsgiLgy8ld23VWbFENU-vi1oU0qo3qnSnDTGg1I8jNw&oe=69DF91B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl7_gJzVmPAQ7kNvwF1x-OV&_nc_oc=Adr4hHH3FgfH7W2xbMuW9Kc3H48IEh-dCClbFvI3FwpyiGehzbzyeHauV199Rn-PYOU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35EoC-9_Gsb-WG8cNFHhqr7UjhrWViR19Ue5gQ5g-ovQ&oe=69DF8A5B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4ZgDS83JRoQ7kNvwH7zOVQ&_nc_oc=AdqJ29Od-Ss0EOA5PLQ_zDzbUIaHiIY8--9NI4ZMZIfKBHFsPKLZFd54jQZfVspj7rg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cSOOSdRBcHLJDaqtOvVA9g-SShCN6VjBB9fEq2BcwBw&oe=69DF9006"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
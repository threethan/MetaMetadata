695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBQ7FffkQyYQ7kNvwHUZ7TD&_nc_oc=Adoup9cK6mcba3T8T1Pc8b4bdMB53n0IyRN-urW48E2UIGrJeHaxuPeK3dIBuAx5jx8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ka-Tr8brtO2tdiNf6gjl-zgL2pEqJ3S6fn6C94qG_NQ&oe=6A3EB023"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqfrepnmTrYQ7kNvwEmizqX&_nc_oc=AdqpPTtb2YaNj3Iz-JwxFPl7sPCziDy8mPmdPK_2m_hc4DN2Z7iFenT9psrZ17BMgO4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YIEy4ZPUyWk1sOB4QB9e0wwsfBATbB8QsPzYrsYHZhA&oe=6A3E80C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpZ3ohKKIF4Q7kNvwF6Ahn0&_nc_oc=AdoqGrBIYKhQzMsNQz3NoVzenVRVQkF3BF-E6siuMPaxvAwl1bW6FqYOE8mLID12KUE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9x_LtsCJvSL0s07NZ0czzz-YTz59JbrHGeYcEya1KEYg&oe=6A3E7DB0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpZwy2TtNtEQ7kNvwGr-pB-&_nc_oc=AdrAUv6ddWDOUZQWlCf2KA5X75TNYnVfBbMRdud6fBv3DqSWid63eTAlgY8Nbq7GYXw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OTAEpHshmiq8z0xMDVPpLp30QLBqZWiCxtJwufgEANA&oe=6A3EAE9B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7TuI01B5UsQ7kNvwHaETrG&_nc_oc=AdquIRt9L54T0UYlU_3BPHZG7A4OLZBv5SPkN8zVXb0wn_ITv0dbZh02xYLt3lWKl-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lK5cZrvRAJuOmufWjkDS91RyiA5tImkSPLp8_B77oPQ&oe=6A3E7C06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
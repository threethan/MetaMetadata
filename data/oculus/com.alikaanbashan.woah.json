7kNvwEiPQer&_nc_oc=AdpTQVcHGiKIeRFvO9fnxW_CAANR_EpKDxZRVbaMtv9kOV0eAkFAFkd4xRXL_GG0J5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlsWZ0NbdzSIbbX5NEPeHHJe9lpNHYIEZRfgaOF_60NQ&oe=69D0F5A2"}, {"file_name": "x1.png", "id": "1365574202006619", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823366_1365574205339952_6400443904350152903_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXeen6gmezIQ7kNvwEhGfC8&_nc_oc=AdoTlrqIgxjiHjb6UzQS66Bc45quh_HiRws70y1t0ei4a--darUd2Bb5XwSxDM5p-Ws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwECHC2-J8KwnwpJxy08HWkT3AzSi2GUaXNoyHHHYAvCg&oe=69D11FDE"}, {"file_name": "x5.png", "id": "1237448751930699", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1237448755264032_4608931404121524154_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vil-zoY5L58Q7kNvwEuG6SD&_nc_oc=AdplQ7sN-oQrB2v289DmMbIZJF6y5nu_kIseRSqS8YmY9bz2ODUTuPtkOLKSnLk3Km0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUTlR9p9UutkPO2IelQ11rdE8syuLro9gm7Honr-aA9Q&oe=69D11496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "z1.png", "id": "1337954028371842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295272_1337954031705175_9194223231404035682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHdQ3qZuMLIQ7kNvwGmdem_&_nc_oc=AdpOTIqHWZBwyCsiXT5ATrfflnvtqUdcQI5zGDmGEbFgM10Zq0tqcRZ9N0PVEiotlf0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHGicPV-qprNq22AgRHGjjqM_1F__52s5fHwiGmO8SQQ&oe=69D108F1"}, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26032905276304648"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_895221732870953_1336285077716697305_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_si
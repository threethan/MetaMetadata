695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZEO0VMX-rAQ7kNvwEy7MFc&_nc_oc=Adp-Bi3SWbaBr2VMhNDCjNadvKwY56pVA6d9f9X3g-l-eul3jgREV_1WmrZ2zJWCSaI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af119WAh3i1UDqVNOdXyFwO04BFeva_0zKsn_ujWZrg0Vw&oe=69F35263"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS17NK7nQnIQ7kNvwEDWIO2&_nc_oc=AdrVJEETiZI5iJ0Xtdi_D-aEcMCQXrsYq87qWhgh0XZgAL4vKrv1GanBmWWVIKy9_mM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gU4egOogY0_RSO7IJNTjSM0eVKe6pDWngIWFqrWT9VA&oe=69F35B45"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yzdU9uVmBUQ7kNvwFZBjUH&_nc_oc=AdrrwEYRGU394kgAAyTKvBezDi7y_eEbnrLrhDgC2Er5kxGnSoWd0Yzk29wOJadIDx8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2INr0HD_jSdSE1zXsHdXEU8kGamI4RYjFqKnPQ1GaKig&oe=69F35830"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUi_0dWtqBoQ7kNvwF9-gZ1&_nc_oc=Adr3bvbbbKBnTRZUzPqsW-J0-VDpXV_bT9Mrx7dP-is5LYkbAJQVogiRy-uu0CTAq3w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TpxKTgPq7JUnv6falZH_IARjAqKrfUVX-4-nmTVFH8Q&oe=69F350DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ieo44As24B8Q7kNvwF6jqNj&_nc_oc=AdoSYFmyujj1NitHx2sFQnfv9IlqHXHMb7qQnE2HEjFjljhXX9IzB5hG2VlyME6rmHo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3948PrHJA6lomt5o3s3DsQY9McpW37jc3CDrCTmmMEMQ&oe=69F35686"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
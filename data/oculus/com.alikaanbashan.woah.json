695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLJ83s-S-lEQ7kNvwEpoCv5&_nc_oc=Ado9QRlG7wqkp7Jwo5SDgOjaVeZ-4_6TdGB2Sy-BQbQ4miR1HhrplGcvz2e0VBZv-8E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6A952gc4wQCqzTXtOsl0TAHGUXiyzLYp2YHF-W5D8gmg&oe=6A0C5EE3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdlrpUcmbZ0Q7kNvwFVmUUp&_nc_oc=AdqWwn-ZUJcP6b0YADd4sAL6qchU3aRRDHbM6PY1hApg7NE9B-0bShpH4qu5R3py6ts&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UAvM1ZoRmrxZd_l9ClXz5b-CIwyJOSDovLPk4WVK4KA&oe=6A0C67C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GRDWQlWW50Q7kNvwGds3Ir&_nc_oc=AdrYhdwKTSPB3iQMx38vHEKKMfj7zY3mZlkrcwbPoNXtMPVXx_IXAR_FXd_7j6wY9fA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i8PTbKRmoyR_-3z5dGJNI0rdLrkyfohyNcWGc5PvadA&oe=6A0C64B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-6usfWLRRoQ7kNvwEPIAPc&_nc_oc=AdqiCQtwyCs3vPpHDlsF3yyKkKXaoxjF8suvKS4QuGiPE1Tnus3wg-0Il0BTAuXFhek&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GTV6AfUPZBq2Uq6FNmN-Fc_od0k0aCNZKp7FdwVna3w&oe=6A0C5D5B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjDT14U6fikQ7kNvwGFf-ur&_nc_oc=AdocklpoBYA3f-zC6okUBP5V0UyKe-AFOxV7UW66Ua_MjBruyuO3rWHk11e5JGD7dyU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7PRJ-BaVpKoL1se7RJbtsh5o92EsVqyDvuRYgL5Osm9g&oe=6A0C6306"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
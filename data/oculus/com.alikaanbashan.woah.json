695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSC3SJROWkQQ7kNvwG8dIRw&_nc_oc=AdrBfmAYlnSRgte6GU3O6o4mBBOAd1-LP5IpZ0rbkSetRj3-aIFP2t0jPR2M_7eP1_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DilADpf8mzpP9ll6kmIsGKi9Dy4TIDQKJy0MDEce8CA&oe=6A37E063"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f273hkZT_qcQ7kNvwFwDZ18&_nc_oc=Adq5T6iemwFyKsuim9Kpu0nnHEHQ8PGuYXa6i-cgYoFNj_9vQqhylAbHkcDfZ9eT3FM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fNPHV1MhN89dfAtZOH73T-NydmRJAyeXbJXECZY3J3g&oe=6A37E945"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26Tb0R3tEQwQ7kNvwGFHB3g&_nc_oc=AdouKOvKPHMJHS-NK3dxqL1gCpksqjC9hRBnFPP3-y6We-sjWoU8nV4mZ3ZLGhniNyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U5mN643Xm4fiMXdYziLZ1zkLByf3jOvvcrFTInNQK8g&oe=6A37E630"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HruM9SgrOf4Q7kNvwEbEgfm&_nc_oc=AdpWg1RbNIhzogxKIFkfBwJArhWZ_3eD6bz2YI62I7-K7sRRPLCDhZlKdTUT9km_XXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83DFd-gR3A1QTcRqUxsvWd3oeBfQeO1ukOMB13ONL3dQ&oe=6A37DEDB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb30gGfR0HsQ7kNvwFPzJIT&_nc_oc=AdrVkqaoQyJFmC1ovGTDW_pSM9a1yXBzZ5hNASF2zoUmDHC9MIuOZVyL2WtJVyVA35A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7w_9SMQDYeZn_3rH8nqMLwVhV9CE2tNCYzpr5x2CC2Q&oe=6A37E486"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
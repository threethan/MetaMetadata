695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMqFwxZuT8YQ7kNvwGJJELQ&_nc_oc=AdqrS_MutSXUu5cOr_Xou1AaXF_Z_W3cGvGAll_38iJ-rh8V4_oXPTUBug1BNS4pTYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sCjNV6QAKtW_VmNzNWWcfWU1CtCZ58MfdzmNc3R3gJg&oe=6A0DB063"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cclc1EkMrEAQ7kNvwF2EhVE&_nc_oc=AdoA6qirooFKptIVhHKXd6kALPDTA3Ktb_q_1EQhvK-TNvDg2TqN93Q9A7QGbEyxccs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vdT9twVM3-JGai35MT5WMv4MSKNRsq-uf37tSs2MwXA&oe=6A0DB945"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GRDWQlWW50Q7kNvwExltet&_nc_oc=AdqkiMBqJ-whv99C-Ei1BAHjnOxOoQLeXJYN__Lu-tB0uhC1uJEbsT9AZ5cH4ffQH9E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_8P_Fz-ehdyMl7uqA_gL370RsAaex50_Uc-lf7wsXHA&oe=6A0DB630"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GO0lSY1XIUoQ7kNvwHSjmLd&_nc_oc=AdoX1FmogOf1j0kksXJYQO4dNfOXbQ_CIfYXAphY0LCwYgK7XwfrSVZx9ojakLqeH9c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o5lT44NUDN6Pm4qDP36l4m6vrKD7KJfJWA2VIWm8zOw&oe=6A0DAEDB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjDT14U6fikQ7kNvwHlLf_5&_nc_oc=AdpVEelFdv1Eqwh26FJWpQ7GiyUlxw16rnsEypZSaM9LWyauHXLVD5pPzrWGQKUqtnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lT0PujgGrUrqsubCyaDYYsLlZyjRNDdEelv5Y7yeqbg&oe=6A0DB486"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
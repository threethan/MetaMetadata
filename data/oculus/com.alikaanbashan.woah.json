695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8LkBM50PxYQ7kNvwHUxE34&_nc_oc=AdpFQHiCOmIVneSkfOAvyOYwRTKK3Sv4G5fk2xkU6VKdxsHD2w28obZhnJ9TIcG09Fo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tGOvOnnxI-83P0-n9gpmM3deIpSEiazhZ6wjtf1j1eg&oe=6A411AE3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7TlEZKKrYsQ7kNvwHtPiZz&_nc_oc=AdpFx0MNv4zRm_pH-H635VTDQNO-86dUIbNi880JDjVF6Yck7tmXLvzz0VIQAde9-3I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WneFqEQdbzFCr01ta64TLHZJ8MV0AWSIih97RcKNuMw&oe=6A4123C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpZ3ohKKIF4Q7kNvwGKrkUM&_nc_oc=AdoFq77eYvi0oe0ZOqtIc-khaKQa7-g8NWQkLxGJIqnfs0Mipm_L81SLCii_HckoNX0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91Cmk51Zm9PgwUs4loVqNQ0vX-iRgtwpmSLaiAE5denA&oe=6A4120B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETSBPpwIaKgQ7kNvwEYoqFS&_nc_oc=AdrVYLSDteAuUbRGGnpqAhJMSvJcVwk7avplTqOItAXxbGYgpVaRLJcvSEAnVWSHHTo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OfG0g2p4OsvANMRdNXCqbH6Yia5fNThettXQzQovrRQ&oe=6A41195B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJbjgAj53nYQ7kNvwG8kC-R&_nc_oc=Ados7Pyk-iw5sznxK-ceHUWlssBKS1R4pBgLzWeqlNhME0kwVqp605_ZMv-AGe_ZFRo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3FFh_NaTyhkjTzezWRIUpbLGQ3ukLBBTp0mAWmmPiNA&oe=6A411F06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
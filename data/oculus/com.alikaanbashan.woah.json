695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBQ7FffkQyYQ7kNvwEx7AuO&_nc_oc=AdoqqVtmWYow0ECX7nqj8OPbRIOYaPAklf0F693oMD30Kjvc_i0s_rEwAFyFL4Z_kBc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5R0bR9TbMrwIcPfs3XqKpZFYy_Jcr9LFJkqdd_h30qA&oe=6A3FC963"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqfrepnmTrYQ7kNvwGO7XvW&_nc_oc=AdpdgCbdlBMwDpDK1W_efYI9HLhQgRgqh7eQtvJGBr0UB5-FPDmrE51ydEwbWU1MWVM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fbKeUhCRfd5LMGWCzPZ0wqboGDwgE9eKmSCbbRz2z5Q&oe=6A3FD245"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpZ3ohKKIF4Q7kNvwF5b4kc&_nc_oc=AdrBv-oW45hRzvJvf5ocFKfjdVpSwCrSLjeUKr-J5jqgbQzpTP584uGjSiQ21DVwtFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af938IvtCjB5VkEgBZ_b1Twep1aCY9v5Rn7AgXJnHO0Arg&oe=6A3FCF30"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpZwy2TtNtEQ7kNvwHNjrkT&_nc_oc=AdoSNR3dq4MFTQtQnlN5YQEc-UrZZZNx5QKOGR64suXPt4f1hed-fT19nXz3sm60TfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ljpPxNCeI-vJAwITCszGwwiczjF4WHgG1TjwfIn2rg&oe=6A3FC7DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJbjgAj53nYQ7kNvwHUixNk&_nc_oc=AdoNBKB25C_U9V-VICghD_D_EqpJ7rJQJP4R01IY2x4RccWAI-k0buD1bl7otxgmG34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e8GXxIXMYP6CRtl5DH5fbHB-yvOYRO6LND3LgfCg-Pg&oe=6A3FCD86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
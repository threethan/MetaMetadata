695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2foMX1Ngk8Q7kNvwHuAmpB&_nc_oc=Adoof77O1UMa6f3hOLim1CJf59MmmZa5KzcGCPedSGATb3GgwKDzbJfpsgjO48ijFf0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qGIl7P8Gvwk7hAG2qEBpjbYo3q-FnRt1yyIeEdKv_dA&oe=6A1C30E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77DGO7A_BU8Q7kNvwFx4PyZ&_nc_oc=AdpzXNn3fFMoq34p_Hd7sVnAE9zPokrRvZs8ZH0NDyGcVTHhOgOJo5IcsdCHfSqrYr4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D95OTyIl2xxGfHQuXyAssG7LPBvFtrWAi1L5FiSeTwA&oe=6A1C39C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KwleDx7pop8Q7kNvwGAhsGl&_nc_oc=AdobQGVvHrs0aWCAYanwtxpqar8el5kSUunW9FHU_CkguLXMfckOxcCX6KFt2V4a530&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zKAXVMbF1WvT8i_KSZ4E7RxyR0Kbonydsd7_0JnYIfA&oe=6A1C36B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kef0tzF1d0EQ7kNvwHnI9cV&_nc_oc=AdpECOBAmUyjGdckGYVeK3d-Qp5nX_qS7cJNAEoJYin-LW4-bdvuUUXVv0OqQDgmaUQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hO4Rx2HvxEivUIofj85UPP-bNVxUHSVtDUzB1nZYvsw&oe=6A1C2F5B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vps1NnszZDcQ7kNvwHMwXgN&_nc_oc=Adr4erRK2WtgLHLY75ndosZtYgbQZBLAJemF841HhGLitngcnMlUjiRbA4QxoQNIO4g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vucN7jofj8jZx_jTF6scAUV7SpH7cic5_5TupJD8o5g&oe=6A1C3506"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
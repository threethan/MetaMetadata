695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7p2MyTl0YcQ7kNvwFy5Ow_&_nc_oc=AdpiL__qqXtU1L9R4VZSOQgFsqN9x3jNvpTmbC3COehtz-La8BS7ZNtJG3jsc0dwTmk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6toms0Z_eR1m8c0kOA8wzJXv8wvq-S0fZPc62ilsk_aQ&oe=69F9E9E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yuNL6wqPa6sQ7kNvwHBnAE6&_nc_oc=Adp0Vh2k0HdEIchjIvEsA_bntA1K123tXIVfcHsiSs_Yy1TA5-HW9UGLucA3gvHgb3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CqVBDUHGoqEY48t7xxIa6LFjZNNAqbx32OEJfJJqsYg&oe=69F9F2C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a418XwuDCzwQ7kNvwGEMQ9C&_nc_oc=Ado3VsW__7TZHi4B3zpvI6M89Tw6UdnSr-IUkOWNDAxqU7p2NMr_Tro-6kQmqKWXOXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76tCnynlAzAKb-fKNjLGPpwF6YIQF-21-6pGKzzhl3FQ&oe=69F9EFB0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDizVG4Naw4Q7kNvwH6vlUn&_nc_oc=AdrJxnOmnc5iNCm3JpqYqbUefB4BdplKe47sgJtybShPx7foBDt3LWuTWgRa24d0Mgo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DuT-EOrS7JYyHK8As1DzNdrkssG11OI58d6PIHJ0nfQ&oe=69F9E85B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adXtjPXcAvEQ7kNvwGp33tU&_nc_oc=AdqqI2xgZvfaLULhnUs-HNWg4ugbdczoNJQ3lSKb4sMD49zNl-q5oSnpYcvhWUgxqak&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qS01tRNKuuVUav-SjdCjBNwe7yDXXvU9UrO6z01gacA&oe=69F9EE06"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
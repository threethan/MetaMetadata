695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBQ7FffkQyYQ7kNvwEmT7JW&_nc_oc=AdrkVvnNtura5mM-oReDygaY8kxw-XSKFt1a2-SyMZbOLbHKZ3H_8kapL6k3Jx89DUc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IMcbV-Uk2VIxsLkfCVAUeVCaxd6m6Ilxo9P21m-qdqw&oe=6A3D5EA3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqfrepnmTrYQ7kNvwH-64EK&_nc_oc=AdpbPs2S5KNU5P7xlaVQDWdlKvUUGmYGgfMuwUwgLFiHhaS2oiFKEtlALw7GYhrh570&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m9_giWpINhFmxsyrVvCXpx1WD-7m6qKHSrBhT2aD7dA&oe=6A3D2F45"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDX1fznblwsQ7kNvwGC_iV_&_nc_oc=Adp3GVYH8YeK4Ki_jpv-1EiE_ZOaUP2pFWIxdJWTEtIU2rn2JPmxkU_Eu1wkUTDzqYw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MlreB9obMHsth9v_JBoTMTjfZlP2GxAoPD_3CGcn_xw&oe=6A3D2C30"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpZwy2TtNtEQ7kNvwEDuxG2&_nc_oc=AdomxaRFuy_wsonGO6h8yrcAJHwD9hsCrPDEzdba7pGmi5xeOUJmz9uFm42TsvdTuY0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u5KvXYKMj-KCr3HV3z_by4nrsngAEf710hn7H0Gf7Cw&oe=6A3D5D1B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7TuI01B5UsQ7kNvwEkeoUr&_nc_oc=AdrVrf4nxXkRmv3kOYNE24OYUtttPh3PejQ_cW-GnaZp1DEY9oxb8iUC1kW0bbv85gk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EMwMaNavwVFUGXcz7CN2qZ-tBW8vgVKLWnvERgvswlA&oe=6A3D2A86"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMqFwxZuT8YQ7kNvwEJg-jt&_nc_oc=Adq2WdUSO_lT9p-pF44IEYC8jmCg0Ioko66tsZTt0Zcrvi_aj99zDO5s3rCfMvgBQFg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79VMVQr2-KDjMK8CnxRIpnp3M14mmX5Ind_4VtjsoIsw&oe=6A105363"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cclc1EkMrEAQ7kNvwHZbqOp&_nc_oc=AdrrEvzhnL_I6dKNGWBxgx3P9vIXTzQ6Jn_Sg5YrJ08zDL_kJ84eFVaQwSbV_YCKW-I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uF3RUlsVx7UvTOZo-I2Bq2r3m0bYgP-Vj2eH2a8U_Eg&oe=6A105C45"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR6wZjNVP50Q7kNvwEl9dqT&_nc_oc=AdqOyLAnGYwXc3_UNbP3hzDODKCilLeHX-4dn92gKPcg9g5c8LCPMbAmmmC_xDqjvfg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PI6vxcPMn5J9hTI2CD704JgFyYR9kaC4n1efijL6v1w&oe=6A105930"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GO0lSY1XIUoQ7kNvwEEI2aS&_nc_oc=Adr59yug2oLG623YqNj_kN9c_MSn4XPDnTVdFMaMFZF7JB-xxTo7iHTq2CZHDRLBcfo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QLSIj8jvyWQ392x-UtZuypBZ0JDB9SrHZJ9tesnRYPg&oe=6A1051DB"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaOlYCNZFFUQ7kNvwGCMXrg&_nc_oc=AdpUOQCp0ewbMjXo7Qm3Pjnavit4I3E9LAeqXMJ9gbLMvHKL9Ic8xwN-bLlc-ybrWag&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lxs6f8295wC84Fu1aTDnBcMxME0mgq4ivPFh3q1uXFQ&oe=6A105786"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
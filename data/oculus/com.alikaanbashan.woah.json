66_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZEO0VMX-rAQ7kNvwGJzNOS&_nc_oc=AdplO0rQ1pwn5i3rn9zbK00ywS-iQNye1GpMCz_uoIHjS-nHWnbD770RuE2K74QofmY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0fWmNLyHLHAGEbsIKfQFsGRDpgpPS_I2abDlm0VRddzw&oe=69F200E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AS17NK7nQnIQ7kNvwFFmGY9&_nc_oc=AdotJBrDtSCy3SiFvMlawb5xO0LV0EVJjgTO6-fcuRODXgWPlMpSLx2ISq5sa1ZDYZE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2mYz6-XIAm3PITSILndfzsmLmbcJ51rxRuiq9V7D-YFw&oe=69F209C5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3_NueS7fMsQ7kNvwGr4b4P&_nc_oc=Adq0pZCzA8mdiZNGeTFUPCFAus0c1bqgR1qXrTeeV30WpenJeYLluknYdRImw9BuQ9E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1FLRzxWDMmOczqRU87ZhM8k2Z4hO2UN2kaFJp17Jn5-w&oe=69F206B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUi_0dWtqBoQ7kNvwFxQ9o8&_nc_oc=Adr2guaqpIG1xHKVL1MEulO1XUU2vX7R_ycgD4YbZ7Lcdw-HOgb7KXGgLqUViUItTWo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DFSMQDg0U_WYmd6Iy2XzOlpZ3DqkhdJjXsAwmVGBq9w&oe=69F1FF5B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ieo44As24B8Q7kNvwHq7G4a&_nc_oc=Adqgtjc4tEbzBoluKq6fGQMRdd5xHqOMbuaZEFBOiIOIjNCGo19024kmgBremJatFHw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0-5Hkj2Ov0KPzYi9eLPBBar6IIxoBpLTt9M4f_4q_Xhw&oe=69F20506"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommen
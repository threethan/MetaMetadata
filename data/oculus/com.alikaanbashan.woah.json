695655110927566_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7Y2Gs6z_EEQ7kNvwFU_WrI&_nc_oc=AdqpGAhvN46l91mJ5c0mVC3S-QPyUP28z-LKA2I3bnZR_UrAIFSzO8fNPTEbyQnt_E0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2acO5qu5k3-x-4SWi-egLtZTuTU4i0GSetPVEIbqhxFQ&oe=69D7A2E3"}, {"file_name": "Screenshot_3.png", "id": "960008486536084", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491819356_960008489869417_551166814524285546_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-Z_RtvJZ3gQ7kNvwFFyMJA&_nc_oc=Adq13fVeX_6WrxtxcmpxEyK5Nymkkp3zaRKHvN_k7t0NCjxeSg9jwlmZqza93Wvz_JI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V32CfPFvFYOe_kDDRSgiaJoZQPpvPQGlDbnXSrv-oeA&oe=69D7ABC5"}, {"file_name": "1.png", "id": "1457212102460765", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491826562_1457212105794098_7785190018409961379_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgwGikrclOUQ7kNvwFUq_rK&_nc_oc=AdoKu8O7Aukn60OU4wO2koaxTTGvMatmsXLRS62q3iAiltfI9QJ3uqKrfV8HLoH6s64&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UfLmjdPysPAubux9Zwz-hc8RPal6BRHB-MWIilDi2lg&oe=69D7A8B0"}, {"file_name": "Screenshot_2.png", "id": "894829063447200", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821682_894829066780533_8883300733423421616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9ZmdWtgmtwQ7kNvwESK8M_&_nc_oc=Adq5HdFvXB3fLqwL6DbqeeuE7Jn005Cxe8NKoXNGQe1YS-h_l2uAGFYphorIDRtvTpU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UMXuw0-oYhNn-V-LxZN9cW5I4sLSFN_SsPBrjK0-qqg&oe=69D7A15B"}, {"file_name": "Screenshot_1.png", "id": "1608739790308476", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818890_1608739796975142_3580838154106163767_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXX7_zmHmKoQ7kNvwHNPVu9&_nc_oc=Adr61bsAUvls4Q3RmANQbeNKR-BUOcVQ-9DshQjoBaOzMIQiJ7h8VrYuX34uPLXdVUg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TKmtoX5p6VS7aFbfriqmNbP63fz7xljCNJ9Bu7Qe8Pg&oe=69D7A706"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Woah: Hand Siege VR", "keywords": ["handtracking", "castlesiege", "lanestrategy", "realtimestrategy", "summonunits"], "long_description": "Woah: Hand Siege VR is a hand-tracking real-time lane strategy game built for quick, satisfying castle battles. Touch a lane with your hand to select your spawn path, then tap a character to summon a unit. Your troops march forward automatically, clash with enemy waves, and push toward the castle. Timing matters\u2014choose the right lane, build momentum, and use powerful skills to break through the frontline and destroy the enemy castle.\n\nFeatures:\n- Hand Tracking controls: touch lanes to select, tap to summon units\n- Real-time lane strategy (RTS-style) castle siege gameplay\n- Multiple unit types with different speed, damage, and attack rate\n- Skills/spells to turn the battle (fire, ice, and more)\n- Easy to learn, fun to replay\u2014perfect for short VR sessions\n\nHow to play:\n\nTouch a lane to select it\n\nTap a character to spawn on that lane\n\nIf a unit is still at the spawn point, you can\u2019t spawn another yet\u2014wait until it moves forward", "short_description": "Hand-tracked lane strategy in VR\u2014touch a lane to summon units, cast skills, and push forward to destroy the enemy castle."}]}, "developer_name": null, "developer_privacy_policy_url": "http://alikaanbashan.org/6_vr_privacy.txt", "developer_terms_of_service_url": null, "publisher_name": "Ali Kaan BA\u015eHAN", "support_website_url": null, "website_url": "https://www.instagram.com/alikaan_1998_/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "N
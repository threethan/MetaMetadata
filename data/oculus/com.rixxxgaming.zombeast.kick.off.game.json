HjKqjUrivd-qUZw&oe=6A3D3035"}, {"file_name": "sszombi3.png", "id": "2972081856326903", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821704_2972081859660236_5355947338658329710_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCWsSrCix9QQ7kNvwHIoK5w&_nc_oc=Ado7tpq3ClhQlLDTeI8VY5KkgZWsjoenbN7tIg7w6P-0q-xfJ_6v3XGAmkbPuxCmY8A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JFT0qnOYBK1HcbrLIcWCLk5sJ-1wd5h5yAKXkwYlWLA&oe=6A3D4C21"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zombeast | kick off the zombies", "keywords": ["zombeast", "zombikills", "zombies"], "long_description": "Get ready for a frightfully fun VR adventure in Zombeast | kick off the zombies, where terror, action, and Halloween magic collide! Step into a chilling haunted world packed with creepy sound effects, glowing jack-o\u2019-lanterns, thick fog, and relentless waves of zombies that won\u2019t stop coming.\n\nArmed with a powerful arsenal of weapons, your mission is clear: survive the night and bash every zombie in sight! Each swing, shot, and strike feels intense and satisfying thanks to immersive VR mechanics and smooth, responsive controls that pull you deep into the action.\n\nExplore multiple spooky environments, each offering a unique challenge and atmosphere:\n\nDark, eerie graveyards crawling with the undead\n\nFog-covered streets where danger lurks in every corner\n\nHaunted pumpkin fields glowing under the moonlight\n\nAs the difficulty increases, so does the thrill. Test your reflexes, improve your aim, and push yourself to survive longer while chasing high scores and nonstop zombie-smashing fun.\n\nWith spine-tingling visuals, immersive audio, and true Halloween vibes, every moment in Zombeast  feels alive with tension and excitement. Whether you\u2019re here for fast-paced zombie action, competitive survival challenges, or simply to soak in the spooky seasonal atmosphere, Zombeast | kick off the zombies delivers the ultimate Halloween VR experience.\n\n\ud83e\udddf\u200d\u2642\ufe0f Are you brave enough to survive the night?", "short_description": "Enter a haunted VR world in Zombeast | kick off the zombies! Smash endless waves of zombies across spooky environments like graveyards and pumpkin fields. With immersive VR controls, creepy visuals, and nonstop Halloween action, survive the night and bash them all!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/rixxxstudio/meta-quest-privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "RexxxStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/rixxxstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26007895862135938"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "33887869077478127"}]}, "baseline_offer": {"id": "33887869077478127"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767201900, "status": "PUBLISHED", "id": "33887869077478127"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26212321898359999", "version": "0.1"}, "id": "1125149686130145", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBin
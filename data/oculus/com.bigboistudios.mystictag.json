KuCyh0Ed96TA5CXUA&oe=69BE9923"}, {"file_name": "screenshot 4.png", "id": "1881137189128855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392025_1881137192462188_65517783580445913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCnH2nb2OK8Q7kNvwFATRtU&_nc_oc=AdmvatG1VTZ1n7RCbOBIU_XKsNe8F2dj4EVaP81prRTh76eGRr-orVoR7evYUz04ctY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyueKcNNYBmfUi3abE-uOIIHhcp-tLsEWcumfR2tSwu_g&oe=69BEA594"}, {"file_name": "screenshot 5.png", "id": "2385886601791328", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828853_2385886605124661_2260374291615645563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBnjFUsUinEQ7kNvwGzLPbk&_nc_oc=Adk_D1jpVqYy5IfgyN_UhJos5JAMbg9loEfGFbawCVbl5vIJc20-KyZ2cxm_K8TCJgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_s5uJzknXax_nvH9q1kOA1lPf8Na1GTC6bYFYFi316g&oe=69BEA29F"}, {"file_name": "screenshot.png", "id": "1358089488865050", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393589_1358089492198383_2617122881112624531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHG6h94v8TAQ7kNvwHsmR2A&_nc_oc=AdlgNs04OSgRTIVNlCFAIWZ_NHKG3h2lcqkZqsasyG4NOi71YwBcoqr3Oqa38fDVzfY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSAcrSCxm-WnvSSOhKrfAi-to0JErK46M9Y3-vcYStEA&oe=69BE7653"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mystic Tag", "keywords": ["skill", "movement", "hard", "parkour", "sigma"], "long_description": "Mystic Tag is a virtual reality multiplayer experience that blends intense movement with magical landscapes. In this fast-paced game of tag, you don\u2019t need joysticks or buttons \u2014 just your hands and momentum. Climb ancient ruins, leap between enchanted trees, and dash through glowing caverns as you chase or flee other players in a world shaped by mysticism and motion.\n\nWhether you're a casual explorer or a skilled runner, Mystic Tag offers endless fun through fluid parkour mechanics, community-driven content, and ever-expanding maps. From eerie forests to floating islands, every corner holds a new challenge. Customize your character with mystical cosmetics and make your mark as one of the fastest beings in the realm.\n\nWelcome to Mystic Tag \u2014 where movement is magic.", "short_description": "Mystic Tag is a fast-paced VR multiplayer game where players use only their hands to run, jump, and climb through mystical environments. Master wall-bouncing, parkour moves, and chase or escape friends in magical maps filled with secrets and adventure. No buttons \u2014 just pure movement and skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/mystic-tag-privacy-policy/db6a4e6f-a526-4680-8587-8860353c73ed/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/mystic-tag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23958857240386938"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "23948897108049618", "version": "0.1"}, "id": "9505252659559679", "channel_name": "LIVE"}]}, "is_for_oc
e": "en_US", "screenshots": [{"file_name": "screenshot 2.png", "id": "1676806356270922", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824175_1676806359604255_3341803782122089912_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRYx7D_YNQgQ7kNvwFuH53N&_nc_oc=Adq-KN6evmYMSn0XzqNg84-xnTuw-yPdmEzbD3rYFkNReXPLl822iBl0xotoQDipx2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2-9C4YVrcGfoT7kuAbxYt0fsa8rwBOsR8WJiSHIYouTg&oe=69F0C7C4"}, {"file_name": "screenshot 3.png", "id": "1911129169629534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824982_1911129172962867_4950991936932848922_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJwZJVFTKs8Q7kNvwF0pEJ3&_nc_oc=Adqsy0ek04ZgtY1EMKHQa4Wi1h_z3BjCyOL9VDv1AONEZoQLXuLIsGAxQl4j18WNNbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0iQe2c79EYfsp7EJoGnEFCDmQD8bPpUeklSP-8LDTX6w&oe=69F0B223"}, {"file_name": "screenshot 4.png", "id": "1881137189128855", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392025_1881137192462188_65517783580445913_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKqIwaSvTPoQ7kNvwFCLplh&_nc_oc=AdoD-Uzq3Ahvsh_UlFpEObp7aYjLvU7xupnJeBlCfsAPN8Wbh3_O5EY913Cl0Wia_oE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2W2cGqTEJMBH_eKrWHzLeoHIA3DoAk8j5qkJ1P9ODAcw&oe=69F0BE94"}, {"file_name": "screenshot 5.png", "id": "2385886601791328", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828853_2385886605124661_2260374291615645563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCiUB8qXrpsQ7kNvwF5axdk&_nc_oc=AdptDg9H-GEw8bw0UaWsRZXvyj5B_-YnsrkFLfF8v5zKQr6kZrQl2Cehg9U4mEwC3Pg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af36ytTO35QHds6qciG6HZV9Z1Zd73QKVSHxSHIIKYpE6g&oe=69F0BB9F"}, {"file_name": "screenshot.png", "id": "1358089488865050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393589_1358089492198383_2617122881112624531_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NwQp1G_Y_lsQ7kNvwHuZ-pf&_nc_oc=Ado6UKn0lZehGBl59I_wo5KPwUaYiqXnYaiIhcegY9daN5gfqMxRsHXb1fI_nC2Vx0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0pFqo4NRjmSArHrml1dyMjfNdpAFQuadnGIWR5XD4BRw&oe=69F0C793"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mystic Tag", "keywords": ["skill", "movement", "hard", "parkour", "sigma"], "long_description": "Mystic Tag is a virtual reality multiplayer experience that blends intense movement with magical landscapes. In this fast-paced game of tag, you don\u2019t need joysticks or buttons \u2014 just your hands and momentum. Climb ancient ruins, leap between enchanted trees, and dash through glowing caverns as you chase or flee other players in a world shaped by mysticism and motion.\n\nWhether you're a casual explorer or a skilled runner, Mystic Tag offers endless fun through fluid parkour mechanics, community-driven content, and ever-expanding maps. From eerie forests to floating islands, every corner holds a new challenge. Customize your character with mystical cosmetics and make your mark as one of the fastest beings in the realm.\n\nWelcome to Mystic Tag \u2014 where movement is magic.", "short_description": "Mystic Tag is a fast-paced VR multiplayer game where players use only their hands to run, jump, and climb through mystical environments. Master wall-bouncing, parkour moves, and chase or escape friends in magical maps filled with secrets and adventure. No buttons \u2014 just pure movement and skill."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/mystic-tag-privacy-policy/db6a4e6f-a526-4680-8587-8860353c73ed/privacy", "developer_terms_of_service_url": null, "publisher_name": "FCSFloppa_VR", "support_website_url": null, "website_url": "https://sites.google.com/view/mystic-tag?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496
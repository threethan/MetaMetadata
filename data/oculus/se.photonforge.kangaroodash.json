 list!", "short_description": "Be prepared to jump your way through some of the most intense fun available in Virtual Reality! By using a physically based movement scheme Kangaroo Dash puts you right in the action. You\u2019ll dodge cars, ride the rapids and be chased by both fish and foe - and everything is controlled by your body!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.photonforge.se/tos/", "developer_terms_of_service_url": "http://www.photonforge.se/tos/", "publisher_name": "Photon Forge", "support_website_url": null, "website_url": "http://www.photonforge.se/games/kangaroo-dash/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "EXPLORATION", "PUZZLE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3095615314046172"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386444_1828244404127546_3455192058807975936_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-B77G4G_7sQ7kNvwGU3WOY&_nc_oc=Adlt4uJOBQJDsV4Ih3MaGzrVYq1DbOC5b8s_oE1xN4i-f10dqQUno7naoo_7t5F1TCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftT758B6a3w-k_AhP-b2GxhZmcQR-EUSpQJl2x5LZMOlA&oe=69A2FCFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kangaroo Dash", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1482307200, "lastRevision": {"nodes": [{"id": "1385048308174625", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_
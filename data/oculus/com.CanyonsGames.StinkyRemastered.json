946B1"}, {"file_name": "landscape.png", "id": "1149694356313555", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75280177_1149694359646888_7915069928290596149_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNYUuqcE6qkQ7kNvwGDp1Ga&_nc_oc=Adm97N1sqBvEKYfmZULw_5_fB9cblb9zGLQq8n-WbG6oRCwquHVrqE-OrkJQ7LPFqIw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxLc5lBdjXMbgG7Dl6U87WWsdGz4OF0ypRvF4ZC31-Zvw&oe=69B95957"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stinky! Remastered", "keywords": [], "long_description": "Recall the game \"Stinky!\"? Once infamous for its glitches and not quite hitting the mark as a Gorilla Tag fan game, it's been transformed! Introducing Stinky! Remastered \u2013 a complete overhaul that brings a campfire, music speaker, dynamic weather, day-to-night transitions, and a plethora of other enhancements! Don't miss out on this revamped experience. Get Stinky! Remastered on AppLab today!", "short_description": "Hey! Remember that one game called \"Stinky!\" that was really glitchy and was NOT a good Gorilla Tag Fan Game? Well this is it now, welcome to Stinky! Remastered! New changes include a campfire, speaker for music, weather and time of day changes and so much more! What are you waiting for? Download Stinky! Remastered on AppLab now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stinkyremastered/privacypolicy", "developer_terms_of_service_url": "https://sites.google.com/view/stinkyremastered/terms-of-service", "publisher_name": "Canyons Games", "support_website_url": null, "website_url": "https://sites.google.com/view/stinkyremastered/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
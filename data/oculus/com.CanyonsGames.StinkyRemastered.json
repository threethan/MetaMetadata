FDE31"}, {"file_name": "landscape.png", "id": "1149694356313555", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75280177_1149694359646888_7915069928290596149_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXXhb9BYn1EQ7kNvwHMpmI8&_nc_oc=AdmvBCM1uT2fkEgSeSZZDs2GID1fepRh6kAh4Xn1B1_qWC23NXib7VlsCjxFhXyK28g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFuGXTX3C5EoGszyiJTF0MjJB9QOOC0of1QjlANxQGRg&oe=69BFF0D7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stinky! Remastered", "keywords": [], "long_description": "Recall the game \"Stinky!\"? Once infamous for its glitches and not quite hitting the mark as a Gorilla Tag fan game, it's been transformed! Introducing Stinky! Remastered \u2013 a complete overhaul that brings a campfire, music speaker, dynamic weather, day-to-night transitions, and a plethora of other enhancements! Don't miss out on this revamped experience. Get Stinky! Remastered on AppLab today!", "short_description": "Hey! Remember that one game called \"Stinky!\" that was really glitchy and was NOT a good Gorilla Tag Fan Game? Well this is it now, welcome to Stinky! Remastered! New changes include a campfire, speaker for music, weather and time of day changes and so much more! What are you waiting for? Download Stinky! Remastered on AppLab now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stinkyremastered/privacypolicy", "developer_terms_of_service_url": "https://sites.google.com/view/stinkyremastered/terms-of-service", "publisher_name": "Canyons Games", "support_website_url": null, "website_url": "https://sites.google.com/view/stinkyremastered/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED",
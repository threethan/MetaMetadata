-sk0FVqJOkWIIv0EymghlsqbYSSLSss0HAoFHFWYeTqjZ0spo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZuoPgoZwiEYBpG_O3xRDOd4k9mi4LQwewJ7ZoatRC8A&oe=6B086E97"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Stinky! Remastered", "keywords": [], "long_description": "Recall the game \"Stinky!\"? Once infamous for its glitches and not quite hitting the mark as a Gorilla Tag fan game, it's been transformed! Introducing Stinky! Remastered \u2013 a complete overhaul that brings a campfire, music speaker, dynamic weather, day-to-night transitions, and a plethora of other enhancements! Don't miss out on this revamped experience. Get Stinky! Remastered on AppLab today!", "short_description": "Hey! Remember that one game called \"Stinky!\" that was really glitchy and was NOT a good Gorilla Tag Fan Game? Well this is it now, welcome to Stinky! Remastered! New changes include a campfire, speaker for music, weather and time of day changes and so much more! What are you waiting for? Download Stinky! Remastered on AppLab now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stinkyremastered/privacypolicy", "developer_terms_of_service_url": "https://sites.google.com/view/stinkyremastered/terms-of-service", "publisher_name": "Canyons Games", "support_website_url": null, "website_url": "https://sites.google.com/view/stinkyremastered/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_
85919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMnYa3ZjN74Q7kNvwH_9kLH&_nc_oc=Adnd1y2gMYAgE8x-kcLbNd7_6x3dZFjPmHMxCeOefS8nskko8AXvUpnpafo1nhYyVIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzb24RNGOG5KXFwKyZbfi5hxmyidXRz6dvIGyFmvg4SUA&oe=69B5455E"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryTrV5P7I8YQ7kNvwGbnjXt&_nc_oc=AdkOQUKiinP6eCXNXL289-iGwy2pgRsQKwI-KKcvQa_BqpqKiQ_CsqIJF7iwSUpzuLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIOHkgyjGSgCDbE5eoBT0ILxJzFjZYfeX3JrQTGo3C3Q&oe=69B560D3"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA5IzvkTJnoQ7kNvwGhzixu&_nc_oc=AdmXCnwJeRah355NBtp6GBvsiNgyaKGau1EYoUrRFEpSI9txeajo_aomHfodxhNkr7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxZcc_qmEUWopoeiPjAHLe1ae0EEXhyBEJ8w7Y8mnGeQ&oe=69B56A9F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSbgfAPcDDsQ7kNvwGZIEL2&_nc_oc=AdkodgDea7qmiDoDTNbfV35xlEsgODlQzreHn2a3kHEfBUAxyj8Jd0NoMai4lMhsP1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afxnw7FQY-2Tb5yhfmDdid1cRkahwcVgYgmN4B3m_1z0HQ&oe=69B5501C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Xys8j76njAQ7kNvwHvxoi9&_nc_oc=Adl_plm53JkVkzEYV3hrzsu9yfVyADbcZlaWhqsdj4veBGvEv6vHaDRk-w1LrSJPDgk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxuVnvbQehNCjXwAOf4ni7-i9GpQfhf_4Ol8UJ7gnM9w&oe=69B55DE2"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
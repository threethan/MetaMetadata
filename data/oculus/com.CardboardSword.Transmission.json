n.com/v/t64.5771-25/491820855_1785919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmajW2E44asQ7kNvwFOYKcD&_nc_oc=Adr8WzMVe19mvk6LVJonozvZSS16emjozdag_BCQqziEIEK0thp0RS1KkewpLEVXLk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOrTmY2opEibxF8tdp1vnNqCyIWT7v-ZAKFcZwMFBA2A&oe=6AF4889E"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCoYzb4ERtgQ7kNvwFExBIs&_nc_oc=AdqVsG3dOX3SZ5ig4zCkRE6DOH-kfRy8TVc4mN_grR9cnjfk9D5jghK9SvDQhRDqMks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmTfimiNsgWbvW-UDAqpen-3FbpjyYnyTbfRpEQgUkpg&oe=6AF4A413"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_cX72J3R3EQ7kNvwHVbjQR&_nc_oc=AdrFqiPsEVBLae7wxkIIqGjNU4MZ9cPYuR2Xhbx45WKNAXruFaS5KiWuP_rBncBOs-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNpGiJ6T95omZcuo6DzqnWiPOqtAaV0vMC_1w-ofEdsg&oe=6AF4759F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Itg9QYQYm3UQ7kNvwGGc_Al&_nc_oc=AdrdZZAPCtgiY24zs55PKPWAdQbfYc4PhkkzLCBOmdlCM5QOcgpYuYsw9VjNAlasDZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJY_NZUgcM9QvYQ_6SWWR5cNEPZaaObLdyr4sszUZTLg&oe=6AF4935C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Kmsykv-N5sQ7kNvwGDWh7c&_nc_oc=Adrfc51cRrXliFr0AZ9xSNkZ2ZD1uhrf74rO1_wkupix6kM2vgyb7IUCSGcmaZCQ324&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZBrz6lpYdRgVftozxwKylCNpn4HTPxnIl_cZWT2Fkrw&oe=6AF4A122"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
n.com/v/t64.5771-25/491820855_1785919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5JkUvNfufgQ7kNvwHr774s&_nc_oc=AdpIycigEBaph3E3DofarTC4yIUmIJ36hvL15S6ZRoSldCfoKAcALExDtBXaArICjjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyykwC4jfRzek-n4AyYl8JlfqwE8SaroJx6CVqUW-Vzw&oe=6AAFFA9E"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnWVochV7okQ7kNvwHkx4ws&_nc_oc=Ado9aFAThksKJc0dhqZS0KmSbUCyWG1A2ixf3pz64XoI5Fpk-CwyRoIPQsR4Vfc956k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIapkpWXho1LWFqCj4XEUfCcRX72TtgMvFL614j-3J2Ow&oe=6AAFDDD3"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mw01H68qngQ7kNvwGFMFUn&_nc_oc=Adpw46nvONXhIluMFf-GqZsVfCEspTeB-DOVALYljRn6KteUhbqplL15EbCx_eB6s3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGy7dX-cqch-v2pFcD8AkX64wdUkYflm3oAtWVTjd9ZQ&oe=6AAFE79F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWTJ8aTGZasQ7kNvwExXH07&_nc_oc=Adq9h2HpdSZvqImHqMfhvJ_Yhy8gCDa6cCvmIwmLF4ZntABmPvSoT1PLVoh_RIFtL9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG9isNYvycObFz1dfRbJ6QpzXkoJ0OExOYUrmfOQEfIA&oe=6AB0055C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA3TrozZcb0Q7kNvwG2zL1G&_nc_oc=AdpWHDyeBPEiHCZMERLgJe4RTtfqau4hZfiohlyfzkUeU38iZH140ATPWvLXZk0k1AE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMoEzAeOV1BMxvZKiCA3V1zW2eE8DjQwO9vgblK4B0Kw&oe=6AAFDAE2"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
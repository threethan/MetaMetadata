_nc_ohc=wh45hJOrq4UQ7kNvwHL7MA9&_nc_oc=AdpZJfsNhF2kAkqZ11ny0fuI4oA_svC4LyOs7aKcj7qXEiB_m4Nb7bJW9inlkULubg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWPygJd80dutLcK3F8ofE3RV9ncH5yJ_9pxw10kWgkqw&oe=6AFDCDDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9OPg7F0FCEQ7kNvwG3lA0C&_nc_oc=AdqKa3LJ0R-2-20IwcPCRp5Z2c2CeXfXX6m2XNGk_-L5keu1KxZaMR8hyHNWOo2v79o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Ho7DQ56OdA4GGuC-4o7PTgnZhZFz2Qs2xSVK6xgkjQ&oe=6AFDDBA2"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25864181266499318"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "670523019330676"}]}, "baseline_offer": {"id": "670523019330676"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765476000, "status": "PUBLISHED", "id": "670523019330676"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25830226869894758", "version": "2.1.291"}, "id": "1685574764957498", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3547956195215144", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25830226869894758"}, "r
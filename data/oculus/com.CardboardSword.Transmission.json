n.com/v/t64.5771-25/491820855_1785919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJEaJAJXyLIQ7kNvwFhTZrm&_nc_oc=AdrauHclpkJr4hJPAYjfWPhnDm6LMRs5oPPZXKKQ_GB_CktMetiJWR2iuiowYGAz4rI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TrO7SzMzNPnJlORKPaoqN5BWzf1E2_IkCIMjs1KRRdw&oe=6A0C809E"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLwaqm0Aj5AQ7kNvwHF9i-X&_nc_oc=AdpF7Fc1c61c5PgO-hK0JhtZcWHVU2kXk2nKbEltqWWsn7TKcI97HIxanJaaZ-J79L8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eU1lcR4_tzssZHcyo-P12qgCVyPWwuEmOeZSZ7VV59Q&oe=6A0C63D3"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVkVe9Vi57UQ7kNvwE24HZM&_nc_oc=Adp8or-wMbdJyQ3hqtlBBy2O3xuuIVWAOdbw5Pywz-rup8JmPx2SnlB0zOGDz5UH_V8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67buBvEkT06hAI5PY8lQI2QKTUdIhONm1mTwrD-b5GzQ&oe=6A0C6D9F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJHMbhAvD5wQ7kNvwHweBIj&_nc_oc=AdpcFOkBfP0O8VWL4JODskrkmGLbBqO_86zvag-ke4mhyDFwekfDwt8WzCLHdGUdLPQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xk3CGpu6vuVcCJY8zpSJLVaqMQdTaewfLdIgae369JA&oe=6A0C8B5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRkRquDlZaoQ7kNvwENBYEn&_nc_oc=AdogQHJK-HEdZUqhpC5i0VWNXXGJ54WaZWsKNKwKklM0nAIWjE2afDvBh2PpLhCejZs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MJW9IwmcH6fhrbU8G_iAj5ch-xz3q_BoMhiYnKRfaVg&oe=6A0C60E2"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
85919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QI2Rg1Qf5r0Q7kNvwGViAa8&_nc_oc=AdkxHHQ_9XDl0BKcLHmltKvUP-DEPXNx5HG6luLAqo2DpSBGgPuaDOV-B3PW0taPM5I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzQTbSzuIP9mheB2a3xqYwRMmEkt-5JTUuY1TDfBwyEw&oe=69B150DE"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAAgVZB43H8Q7kNvwGK8Nlf&_nc_oc=AdnHKZMreoZj8g9LwDoH16nIkfTeX4HiNyMxkPLru_AF9hsuQVoe7HTbiRRC5WgrKMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfytJvCcwl-uTsBnHfpHA_HnkvOq4v4MqSTT1VXmGevEQA&oe=69B16C53"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9T0JHIJpkIQ7kNvwEpUUDW&_nc_oc=Adk8m03y-J8viREoxq1l48N7gqGKww9gcefXj8lAIHzzS_hokbyy3B3eT59tH_Rm1mo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnTxcve9a6jkzyYxpIx-pYf2wp4a0HdUySEMSCPA8OuA&oe=69B1761F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5uokC1rMOsQ7kNvwFF2jFn&_nc_oc=AdkXZpdbpwJbaSqmeg-yLPWNOt4jByeXPrL0QMtA_jUwUzWSLI5MhsThbzVx8PJ6JNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIyA3wlRy6rMMNFXz00xOA1xjq_T70E1u-ffj4tZWGcQ&oe=69B15B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZB90bgANngQ7kNvwGpcfr4&_nc_oc=AdmS91fkT2X_PzWU-rGf3gMJOj542VbSDMneSzoOOVzuzxcIdSvhokannVVvlm6-81s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afypy_NvROS4p3R3MgluZDHmzZjetrOR40ydynPd2tjK9Q&oe=69B16962"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
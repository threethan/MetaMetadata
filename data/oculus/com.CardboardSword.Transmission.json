n.com/v/t64.5771-25/491820855_1785919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=os8A9vGG9kwQ7kNvwFMxzwV&_nc_oc=AdqTWECJukLihTVPhTnSwA2zwufarOPKjHRyl1o4PLhVuaEJXkzAV8rhGd3ZUzwQQCg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R-2IXdkDPOjaml0yslzWJCNG5NaEwqYjOGqVgRlRvZg&oe=69D8DDDE"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSc5Y-vsRAkQ7kNvwHNGfc8&_nc_oc=AdpbIG2ebyHGVbjI8bUu7D7-gl6I9UcU02lplvPsyahmt5upwckuLcJEtzEBgrweZaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_Idv6iAo_wBaeNfb7SrSzjcqinrNwjd5JromvZbhhUg&oe=69D8F953"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtDuE51IMEcQ7kNvwGjULbu&_nc_oc=AdocbGnTHwuNQHtfQd29Dhs_F_PIB-uaynV_Cg1GwsXGNq0iJak6uK-KzaoO7GbkWWw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af390gfMGsyoX3X3vpF5fjwtPkh0t0b2um7AGPGAKCGlfA&oe=69D9031F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pk2IUdNgl4wQ7kNvwGHUiSI&_nc_oc=AdoH0tMG4W3WTvvHspTn1m6TocZbFBUS_WTL91cQQBqwHap2hiPhihYD2JqOa1Q2bw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y70-OH7kNdrB2He-2Bwv6zZC5YOB7snpSk04JVjn7Sw&oe=69D8E89C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PkumSOjd-UQ7kNvwF8XoHN&_nc_oc=AdquH5AqWX8qwsxidOpkxdRSlHVi3eRAsM244IsbGk5zJeruRJkcKrqaIf4Gyx55FxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00BJCrWoLSr8ryBjbjjFRCwwIsZDnvDlLDeFZ3LtH2fg&oe=69D8F662"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
85919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QI2Rg1Qf5r0Q7kNvwGlmJtJ&_nc_oc=AdlYLNDEm0fpRCMKw0cUowIrykF5BD1In5uM6PlzEPiR0pjQ3ryLxRMRKdKC0kWMMEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwq_3qRq5f5ik-I1D2eUd_o71l5h1GwhFTtFxRo86rXZw&oe=69B2A25E"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAAgVZB43H8Q7kNvwFQxrUE&_nc_oc=Adls3pSb16EycZOUfDfeCCbjtBRTvwhmNBjWaA-QCXNgnzQSYUUhwi0CkKVAyxsuHgc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxFjNm-MnGyPLiRrnh0rapUZZkvWAsS5bBUKWVbn9fyNg&oe=69B2BDD3"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9T0JHIJpkIQ7kNvwFYcGSc&_nc_oc=AdkD1KbL8RdFyq5yRmmE4MR0ENT6vu79AsxzjsiowoHi55yzIxKN-rAbz-8x20VqYEg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxlVzTviBIMu1s-QFqSrREtUepFpRnoFDWMJHXAVwFQtA&oe=69B2C79F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5uokC1rMOsQ7kNvwE8BWiM&_nc_oc=AdlV-zGtcdD1Z3KntLhlaZV81Qz5wvz5jhgCYkqTuQUNuCEfdaGI50Z4ST_yGv69QEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw4Vw6QYjZkKbhw5qqG5ZsgPihAx5zV_vIgjQIJ4ZgebA&oe=69B2AD1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZB90bgANngQ7kNvwG92flc&_nc_oc=AdkCkjo0mW3JppsPk6N8ymxk7Fm4CgD4KMeqhkN72_-P6_6t2Qt_Rs0Mj-lavAJjvIg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzD9iIsFhe3y4wICAGbhc1jTu0CPxYTu27lKTzTgeNqfg&oe=69B2BAE2"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context
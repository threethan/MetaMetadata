n.com/v/t64.5771-25/491820855_1785919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNH-RT13R40Q7kNvwHfEsqP&_nc_oc=AdrXtWAXtD3oI5QaJ10x2Y9G8-roXMFWKh0G63SsvS9hPWjjjyM_i49R-Brc6gVzMM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC92Pmf1yreMvU0I1d04tJH9iPInXfy-rPWf7kQmUJ7BA&oe=6A67781E"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjOqiSlDJRcQ7kNvwEYSeRC&_nc_oc=AdqVbAz5N_9k2_WqUsEJ56H585K6cvm3h29l9hV2o-pRHXxSVdK2ZITigwX0FuUdfO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGZsns7FHxu2HvtTIPxa_VmbRvek3Kn8CVdEneXSClZw&oe=6A675B53"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTXc0j4rxZYQ7kNvwFQ0kfZ&_nc_oc=AdpT2CU75pO-SrlcBO7GtxtoMG_w9pZ1dV_Yx7z3sLN0vVdBsr3asw-56dQMgmtEsq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArzPvMYvhKaohmMj6ENpo4Nl6wjEZ93XmDtDDQDXDDMw&oe=6A67651F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RgJRE7qMsoQ7kNvwE6ImMN&_nc_oc=AdoXVQGVz6L0sZYfaoyM4a1oAAbugho8D5f95tJvusn50YcV0qlMkIoM3Q0AGurXTeA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNDm7U7ZMgehZNoYtu8f1OHSvXdUfuZ4xoBxWQkoLfYQ&oe=6A674A9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5dLhO2NLeEQ7kNvwGbHonY&_nc_oc=Adqb_mOC_xglHf9EfC2IR16EgVUpD0CQmkIhd7Fyo-ScoC6cxKHb_BGmiiHw_Bxc9Wk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfSbsLU4YTyPQj6kE8NB_ESdHtBylEoRQy0oLOhmh0CA&oe=6A675862"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
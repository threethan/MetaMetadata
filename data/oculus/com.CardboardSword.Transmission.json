n.com/v/t64.5771-25/491820855_1785919635383880_8950991306809142663_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmajW2E44asQ7kNvwEIuqsE&_nc_oc=AdoYp1JYJrI8DHVCbk4N5wCjjIsU7pLheN7lVltQDERZVaygLSxqIs5KxDhR1JT9Cxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBSwrHFauLX1MBf33FKuj8b_r_dpd-d1r9gieD-R3rtQ&oe=6AF3371E"}, {"file_name": "Meta_Screenshot_03.png", "id": "1437245720705649", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820923_1437245724038982_7876546840215648588_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TD6WVE8sCXYQ7kNvwGRS-lU&_nc_oc=AdqEVU1s0HIiAWLRDwHRT2LNYuZDIwNR8DQbRsC7MCOLcABK8D1Az-RaLO02Gls7x_4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMLKMRv74pjqB4x_fZGYzW8QDnXccPR6NWD9adj3wS3A&oe=6AF35293"}, {"file_name": "Meta_Screenshot_04.png", "id": "2364094780700257", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_2364094790700256_338188444100144699_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gen7eUOBBdwQ7kNvwHRt_sg&_nc_oc=Adqh4luoeWAyLkZrC_ae_8cDPDE6OnpuwwUurRVixENy2YyKf568jz5jVs6L6IkYXKU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE3mSmH-Td74wwfpwCGFj8MNL1x1kJNdRtk383nxf7Qg&oe=6AF3241F"}, {"file_name": "Meta_Screenshot_05.png", "id": "1488751175672046", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_1488751179005379_2658714848163605904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Itg9QYQYm3UQ7kNvwFe_LcD&_nc_oc=Adqull4bLJk4XyBZ03C15Ofce8ErbrfSV5MtAguSekqV-8xfv5O9YKp1Zfa_WrJeWDE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROIqVy-FSwkGx2LPxlgJbe2jWIE040xupe_IshPaSmqg&oe=6AF341DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_CoverLandscape2560x1440 (1).png", "id": "1138383791745033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820887_1138383795078366_430482582212570130_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVG586FvdwsQ7kNvwEKV3N4&_nc_oc=Adod0v1mGjuViUhWk_RAHJBD3rDDdl5wa76Rx_jJqN9NFyq37hGrYNldPQ9Odaiw7P8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThOtgbS5imi7TqOxpHh85YWovDe5Ys8LdKkB0jWlP4hQ&oe=6AF34FA2"}, "display_name": "Transmission: Shortwave", "keywords": ["Music", "Retro", "Casual", "Driving", "British"], "long_description": "# Are you ready ... for BUSINESS?  Welcome to the Pal-Co Virtual Cyber Megaspace!\n\n\ud83d\udce6 **Deliver parcels as quickly or casually as you'd like in a 90s retro-futuristic Great Britain.** Cheers to the old new!\n\n{1603053214459105}\n\n\ud83c\udfa1 **Experience landscapes inspired by real-world areas across the UK.** Retro's coming home.\n\n{696112643145145}\n\n\ud83d\ude98**Customise your couriermobile!** Unlock different models, colours, and trims to make hundreds of possibilities.\n\n{856541900216686}\n\n\ud83c\udfa7 **Capture the musical magic of early EDM straight into your earlobes with custom soundtracks.** Gnarly!\n\n\u23f1\ufe0f **Simulate driving as much or little as you'd like!** Optional shifters, handbrakes, turn signals, and witty banter. \n\n\n\n\n\n", "short_description": "Are you ready for BUSINESS? You\u2019ve been chosen to undergo our state-of-the-art induction process. By becoming a ParcelPal franchisee, you can become your own boss by performing deliveries exclusively for ME! Percival Parse of ParcelPal PLC (a Pal-Co partnership). Ride the ParcelPal franchisee virtual cyber mega-highway through the most impressive display of 1990s technology in Great Britain. A life-changing experience is about to begin! Deliver your parcels and gain personal financial freedom!"}]}, "developer_name": "Cardboard Sword", "developer_privacy_policy_url": "https://cardboardsword.co.uk/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cardboard Sword", "support_website_url": null, "website_url": "http://transmissiongame.co.uk/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "co
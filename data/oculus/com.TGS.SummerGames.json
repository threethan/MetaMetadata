ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IT9zAlwraoQ7kNvwGJrOv-&_nc_oc=AdojA-4YYWUpbw8TjeWH82y258AjPfwIbIMxXA-1WkjYY3qYWsSAUmIftb-9cQyzne8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUhjc2tWfKv1pe2UPjK47GLE6bBUEfG84CEx0MJVAl3Q&oe=6B10668B"}, {"file_name": "image_011_0000.png", "id": "2216374178696256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580062_2216374182029589_6281784090208859418_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zoDRu3xg-vMQ7kNvwERujyl&_nc_oc=AdoFhYQSUY5gOrhMeuOQqNPnKeJQRv-nzR2FR5OfKgcsjDMV59M8OOxFZbrRTZugV_Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVhf1Pu2sPTeZ3YIJFaU7ixqBHy-QoLBtDgurCi9od51A&oe=6B106A64"}, {"file_name": "image_054_0000.png", "id": "355127527452411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439601_355127530785744_5607279387177612479_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bbhqrbhyu_8Q7kNvwGfADSZ&_nc_oc=AdrDuW3jUHzQ9eaDA1NmDK8lRkXUiOa7nKE9gPXVgLv91zgsVYZficWPDKvWXmYU50E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU49xnirQMa52EMilvXQCnuebh6AboPPjn5GgGrrmrXsA&oe=6B103562"}, {"file_name": "image_040_0000.png", "id": "8203846829628287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974862_8203846832961620_213070534910110666_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Y9Pp12X_HYQ7kNvwEiONtg&_nc_oc=AdogtMqS6NqEFa_yhRetXY8REr8LaBgbMeRcaVuTIGNJb2qrGJB0lIz1ovu9ogcKmRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW_iTeSdHQN-b7lE67GUKER3r_T4a8EZNKmXajT5tBChw&oe=6B103C5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Summer Games", "keywords": [], "long_description": "Step into the exhilarating world of **Summer Games** on Oculus, the ultimate VR sports experience! Perfect for all skill levels, this dynamic game offers easy, medium, and hard modes. Compete in a variety of exciting events such as dart throw, javelin throw, shot put, disc throw, and more coming soon!\n\n\nEnjoy flexible gameplay options by playing solo or challenging AI players for a realistic competition. With stunning graphics, realistic physics, and intuitive controls, every event feels incredibly lifelike. Push your limits, set new records, and climb the leaderboards in this immersive virtual sports festival. Dive into the Summer Games today and experience the thrill like never before!\n\n  \n\n# Features\n* Different summer games like shot put, dart, discus throw, javelin throw\n* Different game modes easy to challenging \n* Play solo or with AI players\n* Different skins to unlock in game\n* Realistic physics and amazing graphics\n\nStart your thrilling summer games journey today.", "short_description": "Experience the ultimate virtual sports event with Summer Games on Oculus! This immersive VR game features multiple difficulty levels: easy, medium, and hard, making it perfect for all skill levels. Compete in exciting events like dart throw, javelin throw, shot put, discus throw, and more to come! Play solo or challenge AI players for endless fun and competition. Get ready to feel the thrill of the Summer Games like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
2216374182029589_6281784090208859418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DXiFn28c6gQ7kNvwG3bfPf&_nc_oc=AdmNQCKmLK9WlVvuR5p1jB_ipjBg5mmdBl-wqyF9eKMVYHlOyKjTde8eTxV7YtgtCgg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvdvWvn0GcDk_ubgtZjL6IarscLMU4M_QhYxIdYrM2SPg&oe=69A6BEE4"}, {"file_name": "image_054_0000.png", "id": "355127527452411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439601_355127530785744_5607279387177612479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWywoL716mYQ7kNvwFWf4C2&_nc_oc=AdmaR-3nfI4ed3lvkqEG2Si-2LuFZrFqMRx5hIk6Crjd3NXvntDd-I6g4M2tbtvTCOk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuZ4RWaXC9Dt0NNpohAuO5W0pStnRTtcu8eUNRBinVDEA&oe=69A6C222"}, {"file_name": "image_040_0000.png", "id": "8203846829628287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974862_8203846832961620_213070534910110666_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5TgwfF4phUQ7kNvwE5swhK&_nc_oc=Adn8n8e34QFhKE51WY5UIIKgXwMepWgyMjbCLOi219N1l31M8WsfBkdDrERgN5W3thU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvR5N9ZawsqpHWOZJIfHojccuIDxTllMSweNy2w6pgPtA&oe=69A6C91B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Summer Games", "keywords": [], "long_description": "Step into the exhilarating world of **Summer Games** on Oculus, the ultimate VR sports experience! Perfect for all skill levels, this dynamic game offers easy, medium, and hard modes. Compete in a variety of exciting events such as dart throw, javelin throw, shot put, disc throw, and more coming soon!\n\n\nEnjoy flexible gameplay options by playing solo or challenging AI players for a realistic competition. With stunning graphics, realistic physics, and intuitive controls, every event feels incredibly lifelike. Push your limits, set new records, and climb the leaderboards in this immersive virtual sports festival. Dive into the Summer Games today and experience the thrill like never before!\n\n  \n\n# Features\n* Different summer games like shot put, dart, discus throw, javelin throw\n* Different game modes easy to challenging \n* Play solo or with AI players\n* Different skins to unlock in game\n* Realistic physics and amazing graphics\n\nStart your thrilling summer games journey today.", "short_description": "Experience the ultimate virtual sports event with Summer Games on Oculus! This immersive VR game features multiple difficulty levels: easy, medium, and hard, making it perfect for all skill levels. Compete in exciting events like dart throw, javelin throw, shot put, discus throw, and more to come! Play solo or challenge AI players for endless fun and competition. Get ready to feel the thrill of the Summer Games like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25714368294878400"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2127312274687868"}, {"status": "PUBLISHED", "id": "1974939080068923"}, {"status": "PUBLISHED", "id": "892645526456561"}, {"status": "PUBLISHED", "id": "1528993435042130"}, {"status": "PUBLISHED", "id": "142787
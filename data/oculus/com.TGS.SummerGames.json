{"file_name": "image_011_0000.png", "id": "2216374178696256", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580062_2216374182029589_6281784090208859418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvGug1KU9UgQ7kNvwHsBn68&_nc_oc=AdqdKF0M1F6VwY1mhtde0HnTyZvQ8Gl4CHZrTJvD8RP1kfsyzLAC2ftRCXVklG9JADg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ43YoPLj_D-8xz57aYucq4Xk9rSzIv5rnOwTtuJLl8GA&oe=6ABD23A4"}, {"file_name": "image_054_0000.png", "id": "355127527452411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75439601_355127530785744_5607279387177612479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgEKh935rT0Q7kNvwFGzT_x&_nc_oc=AdpbI7TivX6yEXsI1eTzTdwm9w-vF3FgTKySPkLilaV5uNhoh9V0v4ZQP3jBQDVPKqo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7Uaw7zIzeEeyB7JnLoA8lIGonT06enP0X_5uR2wFyUQ&oe=6ABD26E2"}, {"file_name": "image_040_0000.png", "id": "8203846829628287", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974862_8203846832961620_213070534910110666_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFRk3ZHmCd8Q7kNvwEwM09I&_nc_oc=AdpCg5BXm-Nf8m6VVF4H3_ON_2OSRUl7r2mhR6Lb7aUNFLTHb8kS7hnAEjxPweZl2Yk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBRBxzlptqTf2q8bRXmBe89-Zhwne-iMpAMg77lPtx0Q&oe=6ABD2DDB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Summer Games", "keywords": [], "long_description": "Step into the exhilarating world of **Summer Games** on Oculus, the ultimate VR sports experience! Perfect for all skill levels, this dynamic game offers easy, medium, and hard modes. Compete in a variety of exciting events such as dart throw, javelin throw, shot put, disc throw, and more coming soon!\n\n\nEnjoy flexible gameplay options by playing solo or challenging AI players for a realistic competition. With stunning graphics, realistic physics, and intuitive controls, every event feels incredibly lifelike. Push your limits, set new records, and climb the leaderboards in this immersive virtual sports festival. Dive into the Summer Games today and experience the thrill like never before!\n\n  \n\n# Features\n* Different summer games like shot put, dart, discus throw, javelin throw\n* Different game modes easy to challenging \n* Play solo or with AI players\n* Different skins to unlock in game\n* Realistic physics and amazing graphics\n\nStart your thrilling summer games journey today.", "short_description": "Experience the ultimate virtual sports event with Summer Games on Oculus! This immersive VR game features multiple difficulty levels: easy, medium, and hard, making it perfect for all skill levels. Compete in exciting events like dart throw, javelin throw, shot put, discus throw, and more to come! Play solo or challenge AI players for endless fun and competition. Get ready to feel the thrill of the Summer Games like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25714368294878400"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "981812197652123"}, {"status": "PUBLISH
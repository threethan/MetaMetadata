ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQqd_3AJGxsQ7kNvwFUxJqz&_nc_oc=Adofk4oAUIdhNWzUVP4u9q2F5U2hDoWi2dAosrWkhwqfYRCO4v66AKAZAJDO4IY_QaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFxSz4xsJeLA2ZEy_7V1NKo5Oy8IN0G4Bjd_7yp1YUEQ&oe=6B05A24B"}, {"file_name": "image_011_0000.png", "id": "2216374178696256", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580062_2216374182029589_6281784090208859418_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwdKINqmnkgQ7kNvwFJTc9E&_nc_oc=AdpvM7FTIyzFIJyhF_mUBu6Kk1ppCcYlV2p2dybDDR8d4h3IKBo6qbahqur89t2NA50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjs5qZbau4DahdZKwIv0rX75Y8IQQCabVuGBjmycTE5A&oe=6B05A624"}, {"file_name": "image_054_0000.png", "id": "355127527452411", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75439601_355127530785744_5607279387177612479_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujVNXu68R0gQ7kNvwHJYTF6&_nc_oc=Adqrv8OAbnD2I0LUa69obhC3sQQXc1qTQYigcKAG1nnxQvM72_0XERBT15TnPaykG9I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSUkH5HfqyBLvvLzhTcQ4xtHE6L75XJgalJK-HacqfJg&oe=6B05A962"}, {"file_name": "image_040_0000.png", "id": "8203846829628287", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974862_8203846832961620_213070534910110666_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8klCA0CqRkQ7kNvwGba6YV&_nc_oc=AdonBlB8zICtVOs33xopk7xYjr4GxkILq4A98v0BRbVawHf7TjGQTgMommiwqStZI0g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgcJMZm3Ez-92DJYCcUJxIBDwBPxGoAl9goqjIXrYAqg&oe=6B05B05B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Summer Games", "keywords": [], "long_description": "Step into the exhilarating world of **Summer Games** on Oculus, the ultimate VR sports experience! Perfect for all skill levels, this dynamic game offers easy, medium, and hard modes. Compete in a variety of exciting events such as dart throw, javelin throw, shot put, disc throw, and more coming soon!\n\n\nEnjoy flexible gameplay options by playing solo or challenging AI players for a realistic competition. With stunning graphics, realistic physics, and intuitive controls, every event feels incredibly lifelike. Push your limits, set new records, and climb the leaderboards in this immersive virtual sports festival. Dive into the Summer Games today and experience the thrill like never before!\n\n  \n\n# Features\n* Different summer games like shot put, dart, discus throw, javelin throw\n* Different game modes easy to challenging \n* Play solo or with AI players\n* Different skins to unlock in game\n* Realistic physics and amazing graphics\n\nStart your thrilling summer games journey today.", "short_description": "Experience the ultimate virtual sports event with Summer Games on Oculus! This immersive VR game features multiple difficulty levels: easy, medium, and hard, making it perfect for all skill levels. Compete in exciting events like dart throw, javelin throw, shot put, discus throw, and more to come! Play solo or challenge AI players for endless fun and competition. Get ready to feel the thrill of the Summer Games like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
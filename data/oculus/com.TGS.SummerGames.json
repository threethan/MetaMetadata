ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtlkuXXRsX0Q7kNvwH-LzOb&_nc_oc=AdoY-DY-zVgMfQ5zapTb7NBAl2gU07DtKFNDkc5Bg4lNoc6oDXOyNxQFluEZdPNU6i8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH9MZ6aB2bJaK-rmu-3jJLS5BduSjfx6rapw8iVNlZng&oe=6B08454B"}, {"file_name": "image_011_0000.png", "id": "2216374178696256", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75580062_2216374182029589_6281784090208859418_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zwdKINqmnkgQ7kNvwHaLoSq&_nc_oc=Adqa4AlqYSlKxEKRqr6HdQ-Oc1zxPL9mkGf_njSO6F-YMUbnfw-CcmHtnrja93qMfeE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyVBd--vEW1eHeH-hxRkbsJUd6MbrrWKkKKx-waRTCVw&oe=6B084924"}, {"file_name": "image_054_0000.png", "id": "355127527452411", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75439601_355127530785744_5607279387177612479_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujVNXu68R0gQ7kNvwHyLtwH&_nc_oc=AdpgqKmanEUeNU0ZlbfUoQmFbEKXxz9BPxLPoToegkcQctu4QG1YKHN7fxEWKMuJ7ss&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQseApB13L-bcYMyEf7Y4aC5tP-552b6yBTWWmTIbnrnw&oe=6B084C62"}, {"file_name": "image_040_0000.png", "id": "8203846829628287", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974862_8203846832961620_213070534910110666_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8klCA0CqRkQ7kNvwH-iG8R&_nc_oc=Adq3vPQZEW6tzCr4mkhUt0sESe47zUFjjBhzAz2IzA7iHt6eC1TkzCfHM7tIDS-2DAE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgNzNuCM3U9zNu-iS09A8nXVBIKwkLW1zQ8cTBLPbvgA&oe=6B08535B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Summer Games", "keywords": [], "long_description": "Step into the exhilarating world of **Summer Games** on Oculus, the ultimate VR sports experience! Perfect for all skill levels, this dynamic game offers easy, medium, and hard modes. Compete in a variety of exciting events such as dart throw, javelin throw, shot put, disc throw, and more coming soon!\n\n\nEnjoy flexible gameplay options by playing solo or challenging AI players for a realistic competition. With stunning graphics, realistic physics, and intuitive controls, every event feels incredibly lifelike. Push your limits, set new records, and climb the leaderboards in this immersive virtual sports festival. Dive into the Summer Games today and experience the thrill like never before!\n\n  \n\n# Features\n* Different summer games like shot put, dart, discus throw, javelin throw\n* Different game modes easy to challenging \n* Play solo or with AI players\n* Different skins to unlock in game\n* Realistic physics and amazing graphics\n\nStart your thrilling summer games journey today.", "short_description": "Experience the ultimate virtual sports event with Summer Games on Oculus! This immersive VR game features multiple difficulty levels: easy, medium, and hard, making it perfect for all skill levels. Compete in exciting events like dart throw, javelin throw, shot put, discus throw, and more to come! Play solo or challenge AI players for endless fun and competition. Get ready to feel the thrill of the Summer Games like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
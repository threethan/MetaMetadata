ss&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqJ243_971AQ7kNvwGjJD3G&_nc_oc=Adpn3hXWv7WlSHNGNBby-BVgjwWcEWroZP_j_qZJW9kGSKy-LhfspcDgSSqoxQisxKQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6yoCcC7hqdYmf-2o_Okkb6ptESvYlSItbxZ2d7aIZvg&oe=6AFC67CB"}, {"file_name": "image_011_0000.png", "id": "2216374178696256", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75580062_2216374182029589_6281784090208859418_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmrbjlSSmuIQ7kNvwHSJdDi&_nc_oc=AdrtFWmO4VpI5u-y-DfCW3PhbZvLOj9HcPKaRK7JZ-6OsZRr0s2F9shXQMMk99yQeN8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXl42vL6A7B24X3XeXtJN1b3E8lP-wdmFZKgF08wSu4w&oe=6AFC6BA4"}, {"file_name": "image_054_0000.png", "id": "355127527452411", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75439601_355127530785744_5607279387177612479_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ogt9eVgLN_wQ7kNvwGNukC6&_nc_oc=Adrj0KAi-BRgmaA6IN6TTVGLlAFuUV5FEIH1mPfUxstgdpoABnaiMUliytb1_8nq6vk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJDEcHAUCu2ogyOpCWnPtokLrrjOfI1SD9RQ7yzAzwDg&oe=6AFC6EE2"}, {"file_name": "image_040_0000.png", "id": "8203846829628287", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974862_8203846832961620_213070534910110666_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ebnor2SJ3QQ7kNvwHrxRhT&_nc_oc=AdqFbI5Bp9zaDJTLDfYvFVRL7zyHDM_515_KuChy6AvBSo8qdkOHAIqrhEv0TkI_yts&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-3Bpi5WtV2sUNj6qz47gqchc6oZ_xWux101ib8ryuBg&oe=6AFC75DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Summer Games", "keywords": [], "long_description": "Step into the exhilarating world of **Summer Games** on Oculus, the ultimate VR sports experience! Perfect for all skill levels, this dynamic game offers easy, medium, and hard modes. Compete in a variety of exciting events such as dart throw, javelin throw, shot put, disc throw, and more coming soon!\n\n\nEnjoy flexible gameplay options by playing solo or challenging AI players for a realistic competition. With stunning graphics, realistic physics, and intuitive controls, every event feels incredibly lifelike. Push your limits, set new records, and climb the leaderboards in this immersive virtual sports festival. Dive into the Summer Games today and experience the thrill like never before!\n\n  \n\n# Features\n* Different summer games like shot put, dart, discus throw, javelin throw\n* Different game modes easy to challenging \n* Play solo or with AI players\n* Different skins to unlock in game\n* Realistic physics and amazing graphics\n\nStart your thrilling summer games journey today.", "short_description": "Experience the ultimate virtual sports event with Summer Games on Oculus! This immersive VR game features multiple difficulty levels: easy, medium, and hard, making it perfect for all skill levels. Compete in exciting events like dart throw, javelin throw, shot put, discus throw, and more to come! Play solo or challenge AI players for endless fun and competition. Get ready to feel the thrill of the Summer Games like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
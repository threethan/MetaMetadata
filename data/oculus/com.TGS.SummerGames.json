"}, {"file_name": "image_011_0000.png", "id": "2216374178696256", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75580062_2216374182029589_6281784090208859418_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGCCT2t_wywQ7kNvwELBfTT&_nc_oc=AdqQAixqq4LoJQwcXT5t79Gq2o5Auz6IHE9sPsg5qDpXcdCesS-V6yi4ay3ZtqOyJo8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIj8wgT9aZPf1yoomcEMF_D9UJfU-ctj1OdCZn_Uig_fg&oe=6AAEA324"}, {"file_name": "image_054_0000.png", "id": "355127527452411", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75439601_355127530785744_5607279387177612479_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpR9rSY6tnIQ7kNvwEH1B1a&_nc_oc=AdqM10j-ZkJfjR6LO97uhQTNpm1a8Re_qp7e3VC_bVy-VSshYdho9dtk5zDwu6lTFTg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnWAsXI-L75JmhZMy5azhg3LAgG-QTrkIBRICB81LpNA&oe=6AAEA662"}, {"file_name": "image_040_0000.png", "id": "8203846829628287", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974862_8203846832961620_213070534910110666_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdmzpDG6MVoQ7kNvwER_c7d&_nc_oc=AdrIDJBgXoEHFuyJwKm5_G_M9DOX7KWXEva50szg44PoOzQvXeCMRu0gMk_2O69_ypo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYpowImaVlnFIZ-3E_hu56JKjaWUdmhm-fFp-cJm0YCQ&oe=6AAEAD5B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Summer Games", "keywords": [], "long_description": "Step into the exhilarating world of **Summer Games** on Oculus, the ultimate VR sports experience! Perfect for all skill levels, this dynamic game offers easy, medium, and hard modes. Compete in a variety of exciting events such as dart throw, javelin throw, shot put, disc throw, and more coming soon!\n\n\nEnjoy flexible gameplay options by playing solo or challenging AI players for a realistic competition. With stunning graphics, realistic physics, and intuitive controls, every event feels incredibly lifelike. Push your limits, set new records, and climb the leaderboards in this immersive virtual sports festival. Dive into the Summer Games today and experience the thrill like never before!\n\n  \n\n# Features\n* Different summer games like shot put, dart, discus throw, javelin throw\n* Different game modes easy to challenging \n* Play solo or with AI players\n* Different skins to unlock in game\n* Realistic physics and amazing graphics\n\nStart your thrilling summer games journey today.", "short_description": "Experience the ultimate virtual sports event with Summer Games on Oculus! This immersive VR game features multiple difficulty levels: easy, medium, and hard, making it perfect for all skill levels. Compete in exciting events like dart throw, javelin throw, shot put, discus throw, and more to come! Play solo or challenge AI players for endless fun and competition. Get ready to feel the thrill of the Summer Games like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thundergamestudio.com/metapolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Thunder Game Studio", "support_website_url": null, "website_url": "https://www.thundergamestudio.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25714368294878400"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "981812197652123"}, {"status": "PUB
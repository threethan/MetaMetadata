", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "1245092853275919", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982479_1245092856609252_1502378206155052613_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGMg_bHL4s0Q7kNvwFMj6h0&_nc_oc=AdmYTkGcZageE7VC-aA9CZQW80lMHCITcxLBNb5a75Iz3g8UmUEAD8Ehdlbkk1CQg6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxslcOwctg515cUyfMnTratsSn0JreMkMOqRnCoGaDQcg&oe=69B55ADB"}, {"file_name": "Screen2.png", "id": "1103479687794170", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75439601_1103479691127503_2185107047281252035_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDovJIqhRYEQ7kNvwG1w6U8&_nc_oc=Adm7YVLS2_M0QG34lJ7F_oKIEwfRUZM6FKoRPvodZFjUml4HLM0OJlEDOxV4QU0Q9Sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSBIX1VGeEyHzS0X3x3GXIuGAgr-sl72RB9BfyQNd4XQ&oe=69B55A75"}, {"file_name": "Screen3.png", "id": "568820955881563", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86620689_568820959214896_6910612231453299881_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-HxYlinR28Q7kNvwHwE-PN&_nc_oc=AdmwYCLPeKTF8jWB2VTACR-acLIiYzcH-Dp_Dqn6Ftnh1E8bCoVnOZu2KGydRwGnD8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfygAs1vbwl45KfgsLIB9Cyun_GscLHtuvN5NfQm4Aur4Q&oe=69B55DC3"}, {"file_name": "Screen4.png", "id": "1296695097939552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982723_1296695101272885_7217040978339981986_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1uWgTRmRdIQ7kNvwG8mJY1&_nc_oc=Adl2R7hf6ATZrpMwCwhpqzuKDtzY8Z82WKNOZthzQwzEmIRRchlWXsyewBJ8-yko_nI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8jFbcTX1qmdfJ-DKIpS_lzjHCm2s6SRa7ZmzLR6tpgA&oe=69B5639F"}, {"file_name": "Screen6.png", "id": "493009690560773", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974655_493009693894106_3847468825274754565_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqXCX29TwoQQ7kNvwF7a-Fn&_nc_oc=AdnsCm-eNFUw7KQCVvt22sv05dIi-65nY-HSKHmcTIMhWrByWO6mr5eQ6ZvYkwGlkD0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyE6kKsy2HdHQ-K_o47twIy-N5Pz_SMbzxSnzV_1Tx2jQ&oe=69B56187"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NYC VR Travel Liberty Island & Boat Trip", "keywords": ["travel", "sightseeing", "NewYork", "USA", "StatueofLiberty"], "long_description": "Step into a captivating VR experience that brings Liberty Island and New York City to life. Begin your journey on Liberty Island, where you'll marvel at the majestic Statue of Liberty and take in the island's panoramic views. Wander along scenic pathways, feel the gentle breeze, and enjoy the serene ambiance of this historic site. The Statue of Liberty, a beacon of freedom and hope, stands proudly against the lush greenery and glistening waters of New York Harbor, offering a picture-perfect moment.\n\nAfter a brief stay, embark on a tranquil boat ride to Ellis Island, a historic gateway that welcomed millions of immigrants to America. As the boat glides over calm waters, you\u2019ll reflect on the profound history of this landmark. Upon arrival, immerse yourself in a place filled with stories of perseverance and dreams. The island\u2019s striking architecture and peaceful surroundings create a unique atmosphere, offering a serene escape while connecting you to an important part of history.\n\nConclude your adventure with a breathtaking sail toward Manhattan. From the water, the vibrant skyline unfolds, featuring the iconic Freedom Tower rising above the city. \n\nPlease note: This app features streamed experiences that require a stable internet connection. The streamed content is provided by the developer and may not be permanently available.\n\n#travel #tourist #sightseeing #vrtravel #NewYork #USA #LibertyIsland #StatueofLiberty #EllisIsland", "short_description": "Experience New York City like never before with our VR journey. Stroll Liberty Island, catch breathtaking views of the Statue of Liberty, and cruise to Ellis Island. The journey continues as you embark on the next leg of the boat trip, moving towards Manhattan, with its breathtaking skyline and the towering Freedom Tower coming into view. Pause, explore, and immerse yourself anytime!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/NYC-VR-Travel-Liberty-Island-Boat-Trip", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9095303237201011"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "1111131794462078"}, {"status": "PUBLISHED", "id": "899984092970817"}, {"status": "PUBLISHED", "id": "1524103548850480"}, {"status": "PUBLISHED", "id": "868604885670306"}, {"status": "PUBLISHED", "id": "1883780092487501"}, {"status": "PUBLISHED", "id": "1808196603429639"}, {"status": "PUBLISHED", "id": "2858664607675840"}, {"status": "PUBLISHED", "id": "1653991935487010"}, {"status": "PUBLISHED", "id": "666422299044157"}, {"status": "PUBLISHED", "id": "1280333733088160"}, {"status": "PUBLISHED", "id": "1079350690537049"}]}, "baseline_offer": {"id": "1079350690537049"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED"
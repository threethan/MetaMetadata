23_1296695101272885_7217040978339981986_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHdhJbZen7cQ7kNvwFj5Jbv&_nc_oc=Ado5gxTR7fzHHwgQGj_U1M-HbxUUHLoUogjSUKAk6PalcJZmG_C_x_O_NXebLJ5JA8I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZfILylDsA90w7Mi1wgH-6HxdIQAEFASv3CJ0IT6WMmQ&oe=6AA00E9F"}, {"file_name": "Screen6.png", "id": "493009690560773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974655_493009693894106_3847468825274754565_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7QPCFodo3oQ7kNvwFsoomk&_nc_oc=AdplwsIm7SS35pyHesCy_l8Xs21x19cBBSsq4_u-3vWDQaGgbwPmesHKACI4_qbxXcI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG_xu-rxoDkBMy-0Ft0V9RyORuqqz7FNd5PWKF-OoKEQ&oe=6AA00C87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NYC VR Travel Liberty Island & Boat Trip", "keywords": ["travel", "sightseeing", "NewYork", "USA", "StatueofLiberty"], "long_description": "Step into a captivating VR experience that brings Liberty Island and New York City to life. Begin your journey on Liberty Island, where you'll marvel at the majestic Statue of Liberty and take in the island's panoramic views. Wander along scenic pathways, feel the gentle breeze, and enjoy the serene ambiance of this historic site. The Statue of Liberty, a beacon of freedom and hope, stands proudly against the lush greenery and glistening waters of New York Harbor, offering a picture-perfect moment.\n\nAfter a brief stay, embark on a tranquil boat ride to Ellis Island, a historic gateway that welcomed millions of immigrants to America. As the boat glides over calm waters, you\u2019ll reflect on the profound history of this landmark. Upon arrival, immerse yourself in a place filled with stories of perseverance and dreams. The island\u2019s striking architecture and peaceful surroundings create a unique atmosphere, offering a serene escape while connecting you to an important part of history.\n\nConclude your adventure with a breathtaking sail toward Manhattan. From the water, the vibrant skyline unfolds, featuring the iconic Freedom Tower rising above the city. \n\nPlease note: This app features streamed experiences that require a stable internet connection. The streamed content is provided by the developer and may not be permanently available.\n\n#travel #tourist #sightseeing #vrtravel #NewYork #USA #LibertyIsland #StatueofLiberty #EllisIsland", "short_description": "Experience New York City like never before with our VR journey. Stroll Liberty Island, catch breathtaking views of the Statue of Liberty, and cruise to Ellis Island. The journey continues as you embark on the next leg of the boat trip, moving towards Manhattan, with its breathtaking skyline and the towering Freedom Tower coming into view. Pause, explore, and immerse yourself anytime!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vrtravelx.net/home/NYC-VR-Travel-Liberty-Island-Boat-Trip", "developer_terms_of_service_url": null, "publisher_name": "VRtravelX", "support_website_url": null, "website_url": "http://vrtravelx.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9095303237201011"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1096734059367777"}, {"status": "PUBLISHED", "id": "1401719468567165"}, {"status": "PUBLISHED", "id": "135384506334
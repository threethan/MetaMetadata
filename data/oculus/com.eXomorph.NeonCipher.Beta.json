vwGFvW5W&_nc_oc=AdpQHOsB14ynn6T0UyAby94PeMJGS8lFEt3wDC_JCUxlcLaYe-hXzfO4aEgU6I5rfrE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKWFtoVeEfn9RjqrVtK4EU8EwPatOpFcNKA_9SkIFx0w&oe=6A58DE16"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQmVAwRSJOIQ7kNvwEJtuR0&_nc_oc=AdoMIZ2cJ_JGLmQuL4hUyeRbXlm5w2sUeIHL1C1G3VUgPXmYskLI3Skr1En1ZOL42nI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-sw9ULpddFsw7hfO6lHodpoo24HdpVLrDp-2tv_TXcA&oe=6A58D31B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msucthV3MjYQ7kNvwFDZZ1Y&_nc_oc=AdqdWz6Opzi4amrj2vN45MtUDEnMW1Q6Ns6NfafaO6sIPGlHlBF9prI3q4-tTACAGos&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVlPMYcnAoqq2Igr6OPlAbPmXP8lFZuC4pn2wgKeb48A&oe=6A58CE2E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sePLRXen0DEQ7kNvwErINqS&_nc_oc=AdrquhOMabN1B1GiqEZGL18MljK22XEQIGxyjeC0XniETMYDKg9eu-_GJQkZEBZh814&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDL2aifVpcy1SBblDx7_mBiyiN6b3ETvN4da4xDg-YGnA&oe=6A58C736"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHFNd2IU_fUQ7kNvwHIbSr5&_nc_oc=AdpMmFdGwXmv8a8cP5hjGziiLhieNRPAvRKQZ_WknKLhkH_62OjNg_PxhNFbFwH5t_8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDF4gl2zxTF1qxrXiOMKSQOJWSCuIsANDjagLw0mD78dg&oe=6A58F28D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
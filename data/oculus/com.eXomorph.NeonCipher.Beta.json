vwGw9qZ2&_nc_oc=AdqfHBf4O4X_Ud9EN-Gxmo6TtOLO_SGuZSTSCKa_vnXuQ5-2r3Z9An9E74xek8AGoyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aPydnZ2Uw3Ti7A8OCsrduRfFOeB7nqzLARijGTz8cBw&oe=69F9F216"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRJ-SFYFRx8Q7kNvwFBAdjH&_nc_oc=AdpIxMSHgDAyAazIRUMqelsRJPVfo5IK_cr0p_z5FUJCDi5Gd4_EuaxOcB1OhNY3GLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NkNJa2mp0eKjlPq4BZap9j263v4edbVTlWbHYmtIouA&oe=69F9E71B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKJHUR3k5jwQ7kNvwFAB_A4&_nc_oc=AdoVutksEGU-BuV6jO_fCOBHP4XtxPipaEtYw6hW5vi3VenSqp7doEDYRR6qN4SNtMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A9IdscSbHlYByrJ-rI7LmjjER4Nw2mLCdClUMkv_-Jw&oe=69F9E22E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWt8fck_jd0Q7kNvwEHRDDR&_nc_oc=AdqPBb8ST0ywf-7478c9LnX2yMQGyfnbdSyvntWeF__DoGXWtCEmVyvrmJSFA00o1UQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48wfUulI_TBFjM6ZyCx3wrH-DPelZq5hHG918swUSdBg&oe=69FA1376"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQzNNAr8JKEQ7kNvwF-PYwv&_nc_oc=AdouzhkSZZ4YlVs0o_ht7sODvKxPIK_bT27suj9NuSF0IL_nwIiwwfN8JD2ld0oV-vI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I5WyqBIpnBpCiHAAO9RT5g5_aKbKNkg2P_aVoAguLDw&oe=69FA068D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
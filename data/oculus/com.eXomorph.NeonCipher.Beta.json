vwHHk6Pn&_nc_oc=AdpZrIJSTj7DDgt69DFlN3O3ejWyoX1xZL59sYAZCGJhi_EGPTrL4atkAdjX7ZG2Vng&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Yi9UAqzvK1JxHMHDlHcmFOjhWv3KuAiS5dymHsREKZA&oe=69E77D16"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4J8UHGoXuzYQ7kNvwFjQr_E&_nc_oc=AdoPOS-8Gfu1PxB2_vd86CZPCxlOSzyvGC9Y5EUSbQzrzKlAo88lVyyy-_YsdtQGVMg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gcnFHv1mJ38kzlJ8vQLSPAEp1b0kMZyPzlAZS30sJmA&oe=69E7721B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNZyIw6LG0sQ7kNvwGSywGc&_nc_oc=Adp6lKrPtS0PWAjiznibZWSs7fVvee6RNFLRspNN10omauj9XTWyXX8XzQwqqs_l4v0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TDH4rQbt1wwccaxRcmH6uDlMGAy0uiSGi9WpzR7fZXw&oe=69E76D2E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7OQhPe2c2gQ7kNvwG52yMa&_nc_oc=AdpZU9qGzrwcfkg6QOA3C8ICZpPfEpBoAtyy9uEtYpVSxa3d3Mpy5SGX3bFxe2NglFU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HLIBiOKtTefEn89IwmsojEll8lnGe9DBgEkSwM0n4og&oe=69E76636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=31KhTYerSaoQ7kNvwG6Ky6F&_nc_oc=AdpEtJSKV80Dwd4ejGj08XFZdYa9druZs-GUV0S2wfHC6Iw7Mgw7gpKxZJ7Ko38PAPU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ijNdNttF9ISJgYGtLq3XfyUDxIyUdZvl-svLT5dLMsQ&oe=69E7918D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
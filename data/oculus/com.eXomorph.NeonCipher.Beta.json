tL87gQ7kNvwEvxItN&_nc_oc=AdqPUa0zmjaSehWciHAnD_uA3IuVWegB78gkyNy0-QmFzR3oFdfAIeqha5KZvgNieyo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgMCDNRWUSVo_YgzRKHnXwWOj2kaRlzbjlz0uLtU07PA&oe=6AAE8F96"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXQ5oxYypbkQ7kNvwETA_oq&_nc_oc=AdoI5ah3IqEVGBZrZ0ibdyyQ9pggJCMwn-anNp7Y6-p-vd5o11LzJaaXFXc5qYd5UIo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa-h6bTHKnamhVwKXP0q6ctOwpL6sWhHcHTdpxWojh_Q&oe=6AAE849B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_8UEiI2JtMQ7kNvwEAdppj&_nc_oc=AdrLlo_flJByZ4R2tJ7cPta4M3tnOhQcTe2n2UiukqHU5k-uSllM-3QHazR_4Em7KTU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1DlyMmV79_clcHSnQ1BH6iZN-vql2COe9GVYliu6KrQ&oe=6AAE7FAE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFhQh3e0IV0Q7kNvwEgLwiL&_nc_oc=Adp0vQ7YcZfiE8VD0O-EcUnhvQ-dbR4lWl4NVijDK4mT15G2CEql397EZcWLsAzMIjY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb-fpMeB2dnWcEsicfyWc3yqAtAFkjGifkX9pnSBmtsw&oe=6AAEB0F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh16rmu3MesQ7kNvwH_BNb7&_nc_oc=AdrAXzrEhHTTip-3v68ndKazQc2ZrunJ0wj5XYxCN5ZpaP90v3MjsfN3ubmz4Uux8bU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5ivCfRGDLOlvHqVAgzlwn5q9PxAzAX-S9EsVo3XcQWg&oe=6AAEA40D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type":
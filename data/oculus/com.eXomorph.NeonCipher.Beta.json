vwFrhWcj&_nc_oc=Adrg97HDWr9MpVjxkcXm7rpmzEFk1j5IYR8-UZG6x3jbJ-tLcvbo4KHzf95Jh6D5TaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhqSLZCETSVU0zJW2RnzCj645_Kh2TNtLIZmbozcySvQ&oe=6A7B2516"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCTWTyq6H2sQ7kNvwEmBi-N&_nc_oc=AdrehqdDstdAQ-96XCs9fGcu9b68wOLi7fm95veIaMYwsHgAqtThOX9vD66Mzm9QLk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQiNKhEx2lkF0HszaGgGDZVAEyZ2iYwQdG2aEs-CA-rA&oe=6A7B1A1B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzjfnQlB5QsQ7kNvwEjo_XD&_nc_oc=Adqp43mHQ81E7zzNj80SufbZYuQTfEn8tyCq81Qofj9G1XhC_k9muK1aGlsWIRGCca0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP8RU8o5jwoAPYkQl-tDx8NS-gU-5hLD54Xi-tULhcqA&oe=6A7B152E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPV_buRAQ88Q7kNvwHdainv&_nc_oc=Ado3OuSGkuPI4tjmTmrOwh_E2NmjPcpQtjRs3_zxTr8m8sjFVZYjUyzbSxaY8H2OwqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgFHac8aYXvhF_Q2ltrzi0hEplZq-JFifWoUs02-9g7A&oe=6A7B0E36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX1TP7VeK3kQ7kNvwGcTdBj&_nc_oc=AdqLNG_qkD6MmT_iFeXp91m7GZtAxMTSoy9Ili9ie5ljvk_QThdNexkFT8_MPKVgKs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_UsDqn5ugo0VFeOUbjD8M0D2SkrZZNDpUa8BTt7LzrA&oe=6A7B398D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
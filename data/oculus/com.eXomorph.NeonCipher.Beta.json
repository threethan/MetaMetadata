vwGXyHWw&_nc_oc=AdrU1BwRkFUGPUo298a5SvCuEqADy_-TWvWtprUg3sfoUohpIJTLz3Z7JepWBZYIEEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tEDQj-z_2reV_mkIV_khDJnvPpwq-q9tnuMxJkp9sHQ&oe=6A01DB16"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vwUskmnQOQQ7kNvwHMjQ-K&_nc_oc=AdqKtxHjnii6-GAoiJl2I8pNRQkT1AGehdoMh4MMbkkIOeiGIn0HARABMlgP-Gomudk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HtA5cGZ8u7QEIggOfwqV5Cz33iq5fLoxtJjxZhQy2zg&oe=6A01D01B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjIrkyitAHIQ7kNvwFkIajk&_nc_oc=AdopIzxgrWX-IUKcKgx4Ts5GfAJDPgsyaCaaMD1-WhFPPsSNxBpysqq2ylq7mDUdm9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Hrb4HOTGitrHX9eTYm5MTVkijAfiU4v7X4BiyRTRtOw&oe=6A01CB2E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCm2__OJP6IQ7kNvwEoDRB2&_nc_oc=AdqYyEL3IbRtkHOYNZHXFGXwuYecJbg_4v34I12eOOqgDgXNaDV5PnBjIYrp73z2bac&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MAfj0_aig4CyGvyxhcrOSmorKTgllNYDUjsLFfxCR1Q&oe=6A01C436"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMTaSJOJs6YQ7kNvwE-2b0l&_nc_oc=AdrFdS2nGgwb1MWvMaVp3BuMbwgyPy_j9M4IhozYX317DV4nMTq_rBYzH76cz6BJWMQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kqi0bGrFxQ4bxkY5CuSlSBF4vIFNdKv2_UoKSgaoXpg&oe=6A01EF8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
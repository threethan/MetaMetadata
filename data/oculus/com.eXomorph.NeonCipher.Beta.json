vwEfcKdS&_nc_oc=Adp7h4aL-p3v5Uq2DKBzWKEOI2xM23vhSK_l2anjTCW2Mz-xU_YyqcbS3MSMNQ1fBQ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bVgESGPWHqE4Q05-BP7Bnpe6ndIxGC9ILG9TiXV20pw&oe=6A0B1596"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oN9qohLWvaIQ7kNvwH27T8t&_nc_oc=AdrloaoSttbcj-K5u3BDL25Hd3qAGcae_pzjfWsYZFJT5gSIIOvijUBRdfgefNbo070&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Qs-_e0bm706GH0oVD70J56yFxXkA2wEKbLFrXsqO_Rg&oe=6A0B0A9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldh7vkI9pj4Q7kNvwHuv9Py&_nc_oc=AdqjfyDqXUHoR6mYBUY4Dq3pAzrUeDjDYp5UoQVz-bcAmoNwY9E5cS330qK1gTxpPns&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lvHvqEgP8vr2o1lev-PD3R-fnvRoODySbewRorHQMkw&oe=6A0B05AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ztm-SC_lkBUQ7kNvwEV_N5d&_nc_oc=AdpbJ4cDbrvCPvEj7PGPlCrIA74hebXNEi0eOL77e4Hdu9P8YtBy_SVGiDJ4prvP_Gc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yUK_4uDrTPKcp-y2XCiw3iKhzMNfLSgWPc6Vxx8Hv9w&oe=6A0AFEB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OicXsxAnnEMQ7kNvwFipqzB&_nc_oc=AdqnzyJM20MKEsi3vlKBqOc6WbUG4vnn0J9-JCB3_8gKWxaWtly6P0iAnVkCh8sWwxs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sO4yJZYdvO2VtElDfuRg3FpVu6s75C4oY7JwORM7RGw&oe=6A0B2A0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
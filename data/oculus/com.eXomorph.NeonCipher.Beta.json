vwFlvuTo&_nc_oc=Adp4vdgJ9oftBskFp9egIdmBgrrUq9MvtM5odZyHV_0kRSYRLfJc9WG2aFd1f_WvQDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q2IApth5KmNRZr6Oh38B2HWVsGt8EBmxNlHwkaHX3pA&oe=6A43C616"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2woIzn8V8QQ7kNvwE32v79&_nc_oc=AdodE3SfZSl-v_lPk82XP6xYIKxCGZuyjmCUd-yuat9CmAmGkJSm0cE0_h6x0-PeFjI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Iv30wwgsacX4Mb1WjL0lDkGDk5ylIMAW4Nhvjvk9QSw&oe=6A43BB1B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XOZxg1xgvYQ7kNvwE6LmOF&_nc_oc=Adqgi59hnUsooq9oYDsm6W5v28SEN7EOCNgGLHQ2McYrLvubcaP3gatOqzeR-Gu_Qw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v4FzNVtEhCwf9-Mvn1cthcQUViKYtGs8RCkluCHo4Rg&oe=6A43EE6E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esISGfQ6wb0Q7kNvwGFLbgk&_nc_oc=Adoye7h8t9J-0YzONsGBZWiZ3BOsN9mfqjIxkwj4CdeZSqBLxHV2ad2JUD28eqLOQtA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mK6g6r1sf-HU0mzDWr77BQQ-4rroz9eudQwrjnWgySA&oe=6A43E776"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTKJCbFg7Y4Q7kNvwHYbaUD&_nc_oc=AdoXR_77D6LL6fEpU9cLD0tyj1dYHeQuD_2ENVO_hx8PpM9fiWpeih_ZXIaA-XCF3GU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92xO-9HuqrLrRXu4MTgWWd96gqYbQuYo2VCmUENTOrIQ&oe=6A43DA8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
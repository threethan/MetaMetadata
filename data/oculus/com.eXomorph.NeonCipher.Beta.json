vwHOXqQL&_nc_oc=AdqhM_zkFmz-fgIJBxIexjnYFUEnfqlf3JYCPl8FVBf6bfmGKPdfC639usPgeLQzT9o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwZy6w4EOCuU_AcHHyf3NwDHxVx9buhcewn47a_6DRDA&oe=6AE0A896"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uod05Oi9zG8Q7kNvwGn67wA&_nc_oc=Adr9hdK6wyx23B99LeaG96B8GLmpDypqLbZYHbtfWp9Zw4MX5-GLfHRVEKmk2DdBt7Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUh2NfG5opHrohlUouILHlHqb7_g1hdUQMhx9s3tqVCQ&oe=6AE09D9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHa-Atfta3IQ7kNvwGcUQLS&_nc_oc=Adplv0ob4zofolxFzPS00vp7V2kO93_aEYWtilYqnNkfS6qKCivtjw0AXpeLEJ7vSbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUPhZ9Yp-SdFkXAfvmdEaD6fhVF9zBm3MJNJZpwsMEzA&oe=6AE098AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LxT9o8tRZwQ7kNvwFAY07f&_nc_oc=AdpZ9gwpJg50zKfaNKHbx7cIfiScW8fi_9mcnPVxOCp_DshS8xnwAA6cFrBMBy1WyxM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxZ8vBbjRP4qY-8z0HU0b2nubaigmZKzIc5-vuke_3fw&oe=6AE0C9F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c3f44unHO8Q7kNvwFgizn9&_nc_oc=AdpS-RtudfiYtnoT0l2wI4DDfDnJFqy_mcyFsPy46ye3dOh1GLgtjWVV-qQQ1G4lWFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8FSJjZwyl1Hlx4u0ThGf6ypgOaZSOTXi4Lu2T4_KJaw&oe=6AE0BD0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
iSSPkQ7kNvwH9_i0M&_nc_oc=Adp7Hlcb0aQX-7X1JzdoqWjz61D6pc5R_7NLH4-5A11g9BWYoWMH9msQYs7_cZrG_mA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmPljQ3ueezIbD_xT7jWxMIJjwac1PSrJSevLPyz2ekQ&oe=6AA94996"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1szxGSzjl8Q7kNvwHa6HX6&_nc_oc=AdpXveow-Ga5Zi7Q2tfLtFIrJ7aMgyLmNhwVcin5MxYfaySlsLDfsHHuVTbkX6fOyiI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI71GZpiyoNPPPQVMxghIZLLW25xP3O8VQazPFQZWyCSQ&oe=6AA93E9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-CyD13y6SkQ7kNvwGbauhk&_nc_oc=AdoR2lvT34Wn65GEhgMAS22svH74M9JmbC6t4nQebcEDjvUleXwRXMYq0gvpg8KxYZk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKz35UkzzBIjuIOXeH7qT1LUpeRtvxoCBoNFlGRFp5EJQ&oe=6AA939AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXI-0g2KbRIQ7kNvwFxEtBs&_nc_oc=AdrFW_lxs1FHXO4HpEfR3Xr3ddMsaqZwqAyQnVViRqSWZ6e0nFMAqAB0Y1ZjPrDqYlk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeegrUnODSJgWXcEN5RDoYwySaNE9M1r0eB3PMvDa7dg&oe=6AA96AF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBuiC1vTVCUQ7kNvwG7sCVX&_nc_oc=AdpsR3DNa9mjMeFbKBkxBZvPHe8chN71Vp1VyQaRvWqytt2aepO51KM6vJj33xdDOwo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk4tqE888sCg6cUfEBFH7HYjO4BZiobUiZ0aNd4L_3AA&oe=6AA95E0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type":
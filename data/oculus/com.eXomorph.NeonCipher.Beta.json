vwGCMVil&_nc_oc=AdoqsdbrT1V-5s2M0p-WtupNLh-dT4wnSHd4Himx9PuY9fr0NdlwFqJbQzSc725wz1M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Vh3RZXmFptfhXIa8s61EKCikZc66-Doex3jO8lMmT5Q&oe=69F35A96"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAhuA3yXfT4Q7kNvwFBKDAJ&_nc_oc=Adqxqska1xYOXO5qU19YP3k1ouuo10wwwLdx4qM5kCSKYXo8eMEFSsHZyapvBAl3Jt0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sdHnH05pynS4EbtYZB7pWQrTK8Ol9UmPQ-4TJ3iP2dQ&oe=69F34F9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocg7-jdm27oQ7kNvwGUabM9&_nc_oc=AdrbRREU_FGWuELVpAihOs6NYouKK1DU7w6JvVB6JyTDlwNyxaA-NHHN7W6IrPp8ppI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1bLDTE-KOZ9IkBLxBHD6hlGKx7qf4CkmV1zDXeqITmkw&oe=69F34AAE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0c3Tp24rI8Q7kNvwHs9g2R&_nc_oc=AdrYrO1sWTN1AG2fcrJBb3jmQbKwyyIZs3qAZTwAgOyIKJwjh--JMCAf1DEBwljI25M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3LBcj-WoE_mJIPF2pqY6Vj9Cf5M3qndt4WZIoBQ0U_fQ&oe=69F343B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL_FD8gIvMMQ7kNvwHBWDc-&_nc_oc=Adp047Z7i9QViK1ThywBVdniDN5aZhl2Ji1S_4ifqAYX-4HHVGv4Py4IhdrrenJymqE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1o_5ZDw97BYVh_8qQ01ZujtHd7n86oQKaYZHWqRIL7mg&oe=69F36F0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
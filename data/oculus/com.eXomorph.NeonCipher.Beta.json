vwFJwkfY&_nc_oc=Adol0b-W03817HR4whD6925apQVkmpDvlYW5sPKEhfi4WHhX2BLlITqzooBwqz35Zz0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61Y0dfr1SovVM_cK6fbUcJjjpOXpu1irl080hOuYuoog&oe=6A05CF96"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9pIDoieqCYQ7kNvwHbA9Bz&_nc_oc=AdrUUE3uQgUmLDZuJJ0AUs36K4LPynDWUbSuDjlvui9Rxq6zPRzCZg9Z4U9gFogNTTg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iUmctx7MJZea7D8Sq7dfkcofLFDrpXXeQugYdhI1C5w&oe=6A05C49B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bax_Q5M5KMkQ7kNvwEAh5oR&_nc_oc=Adr5aXggmtZkw3f_UBaWVXbZUUGjBu4OteiepZqOHwwvOSSRIhEb3IZlZFyezTeRgho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4P4zS3fB7yzI98gwqiJ3skGDh38tMH-SEqd7zqQ_vVOA&oe=6A05BFAE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39LFFOCKcbgQ7kNvwGF22Ni&_nc_oc=Adq8eFUJ9uw871ZIEM4NXJk522uL4T-3Hjo2_v011rOq3eXW_Js_xjVpdbKV7tnefQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6448dFBDtPIipDyg8ABVe6oKJG0kHmI8dcxrWw6h9Z-g&oe=6A05F0F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STs__enR56sQ7kNvwHnLDlr&_nc_oc=AdpX_VqVI_hFrj9VmBfwwdit2jN4DvFRbVhSNlocM38LpIGddRcZfYGLMzYflv5ceK0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T07IARLOaE0VL6lzSEipsH7fQ6FlG18hcuF9VwM--Rw&oe=6A05E40D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
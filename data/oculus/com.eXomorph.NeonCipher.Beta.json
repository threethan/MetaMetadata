1tCsEfk0hAOj_fP2xkhK-VU-bifi6m0DQM4bLsP08wH77_IPKfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afym30Gt1V2Mjdb_a8s9p2Xk68-QUAHd0M5mUK9711Wd7g&oe=69B95896"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhijDOLOfGUQ7kNvwH9FQ1c&_nc_oc=Adni5FND0ANEF2sW-4EG50ZNnEV_hZI1AdcB30aN-jAm_68Vo6L05Qh_RqNNmpQuMn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfysSxpw2igE8-AcP3LZvKs3uzrnH2y9VjwOxmkNvn7cmA&oe=69B94D9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4MwzSyUuLcQ7kNvwE4TeNR&_nc_oc=AdnxCdR-vPMB3Un4E6GeZb3eDCLO6hAsaACMTiAyVCXiT0J6f9F0SOHxKUxfpYvH2oY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU1Y8UH8S9H_NmXdiciOX1JiUgMzo_xF_COfkF-4uAgA&oe=69B948AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z0E_AXUjwIQ7kNvwGzeMdN&_nc_oc=Adl18CgiA_Us1j-B6hQM1OBAglHoN1TvJ_9_YRPXK8hcxAHBfYFwAEuhHP1L368ooNQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWrmNCPH_qLIJBStNcyh4jsyEvVOg4bNyjhkXlA9pNzQ&oe=69B941B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH-n29tXk2AQ7kNvwFhLU2c&_nc_oc=AdmbpZ0zcT_F0fp5rID-eehaeMzry6BE19-TOnFltg2olJ3_TQ5kGZnuKrQ-aUVDQhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaWgg-je3mwMf0xEUa17BmUMS9gbtEHVGTpNRmEtzhpg&oe=69B934CD"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
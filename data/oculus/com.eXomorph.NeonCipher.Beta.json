vwHwhOMA&_nc_oc=Ado55nEr_nMug_RrCGqxyEDUHdLL1_VDceJUEWw4dNwaN_SFGuW74-ikuXQ_56HMvZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pOhxiGZlCJv8vITdDjTBrF33f_-gzZLcobE4-I1Sj_Q&oe=6A354596"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUCnoaLtKX8Q7kNvwG3SMo1&_nc_oc=AdqBlARCF3T99SDLFNwNnWVvJxPHpnerF2qXkoXbBR-XkLfIWpwqmXiwnjsbzkIg_WE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9P5ab3MVbG-bm6t3LIegEJ-ttsaAOhuGhB8B_LYHJLng&oe=6A3572DB"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVcTqYYecXAQ7kNvwEhs1tw&_nc_oc=AdrQzxoH-pET29rICNxkG2nU9jVMbXQjJzPNf8oUeSrLstVpCyGEawSDC6m_REeKotg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AgHhdsxoXHzE9aL2PFTB3GyEPOQmTReDXXKmU_xHEwA&oe=6A356DEE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDNiE9s29_AQ7kNvwGxKUde&_nc_oc=AdrP5SekG4GWxytzLrA-ucmSnFEJdNAVSDd7Pt0PLTz7wNimByjGfX5z6TKqkxefl1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gCPEdUTx0BfoTLBGT73pzkMWaiitOY-9gZVsjhtsU6g&oe=6A3566F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jfIfTvcVGoMQ7kNvwFy4HD0&_nc_oc=AdoWB7kTpZwmwqORS3TXxc7hzZDLQn-QJHMKnb-gMLkUATgqQYfjqOpc47cgpLODwTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9phvEgL7FW4Epo-kSvuafUOezJgN1kY_T5H9UdO1X4kg&oe=6A355A0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
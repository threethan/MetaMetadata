vwGVfcjE&_nc_oc=AdoBWRaGEQWyxR_j5-D2H0Z_R4DEf4OJRxFUEV2cWWJAaVgLlH1LHpjqDLyjLZ5bU98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKPLIzQKRGozea04OpuuLGShesNkDYtJRa6IkhZJYpTw&oe=6ABA6D16"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ueKtikjQIukQ7kNvwEb9q9p&_nc_oc=AdqLTSvbNrZCr0PqNQpy3_MPfXdaodKAh0nzIVKB7F4jV_Kys7rraEgiN9KBo6O026g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6-gYWDQ32vbqxQRRlPQBR94__2-54AYtUKSfDHYIY5A&oe=6ABA621B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAUd-uD8fA4Q7kNvwG8fnVV&_nc_oc=AdomUSgS9A-TZ3HyBA3ZmspKt0moAcvtrvAc5HnNj_DyAlNf2RBv6mTAuWD3yGC1VDg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHf7bCF9sxxstws62XkYhOMYZEnC-hcmDCWDXOVHv01w&oe=6ABA5D2E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkAuERqGGq0Q7kNvwFeU6_y&_nc_oc=AdrHa8uXa3hFtO3WZcl8qijRxWNFz9SzW-vydLKe9Vy95cR5YolqtZRdcNuCyZtbBRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxlXrWh4ktlhPdU__PJafLOlRHaolg4mMcU1r5_fr2EA&oe=6ABA8E76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX1YHUFcfTEQ7kNvwFeVThV&_nc_oc=AdrEn1DuF8qSwVkmtHezNOXSa8J9mAUpUHow_JzhzmOgDVA82blwYyMr1np_ErMy2zs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKso_Uw8lZFumaSbNW70HzWwivp6yFUc6vZvkrKC5epgQ&oe=6ABA818D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
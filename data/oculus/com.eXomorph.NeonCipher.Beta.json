vwGdOVwS&_nc_oc=AdpBykmqD5hMLyKSoB-sEg3FfPInM8h4UQ0WTVe_6KrmrmZaPLAbewLKyosczOn6I28&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrKlXCdce3igR_LuZYzVpcmv4i7UlmzjbDK-Zd7gunKQ&oe=6AD3B1D6"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79Vwm8LyMicQ7kNvwGvJwsS&_nc_oc=AdpeoKA6VoXDKn1k5dKX8StWyrCc-Zb_QGcegIr0NYvRGYblPyJsGb9-NokRGu1-ves&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObN-WDoQ4swENU4E7DSk8dSDERzlB8hmVSMsKDEIcVOw&oe=6AD3A6DB"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etJonZIR1dwQ7kNvwFeI-96&_nc_oc=Adpi4a0HSUIpS8pJ_o7QiaKL2m6JUOTUcpXSELKP2guY7t2UcxBVXOpvLw7CYJaAMY4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOl9he2nQ0KwnkEY5s7jUFpo0oS3mp5UichHF9GOcRPHw&oe=6AD3A1EE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdkjPunZgE0Q7kNvwEp7N57&_nc_oc=AdpATYsW7k32h5Ho1d1L5Sy1w8haPa_oN3AvTXI9UQpG9KqoGdwQWhKTWZTnCzRWv8c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7FkFBLr4CnybaPI6gm2MPU87DEthcUnPIHPESxnLwzw&oe=6AD39AF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JY8DX5ARZsQ7kNvwGTELbA&_nc_oc=AdqIkcUnwf2iXo8ulFwXRdnB0UhNO0Ilca_XRpc3BtJktfgb-i91H3oAJ-WpSaI0K78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXxDy73HIIQccuszyg0RVTortFS66MHFThpx3bwHcMLA&oe=6AD38E0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
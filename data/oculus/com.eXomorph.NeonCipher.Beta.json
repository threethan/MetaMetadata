vwF83PoI&_nc_oc=Ado1Rz3L4nJvGKzpLr4p2nJ5IQRjkFZfywcTT0aHIxiFAip_KfgeKrr9gM0yFxrOo8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjNlhSq4jpQdh3ZTasvSlcYkPT6SFIuCSxOiwDZVDxNw&oe=6ADF5716"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uod05Oi9zG8Q7kNvwHFc-wH&_nc_oc=AdqVMd_AA5i3dQ6_Dse5KzaCaBw8ajHHNLDiPy-WCyBPk3z2S6u2-VIqVwZXLJyLlbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkQqAufVACoxAKHBptN2xY-bGIae5ycCaJw90pFyExXQ&oe=6ADF4C1B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHa-Atfta3IQ7kNvwEkOj4g&_nc_oc=AdqCWY3JAcZJ_VATxUNqJNksXAgyQBirgFIwfQEM8AjpnomyfLccRVrnmZJR7Jo58sw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOcFOYTGiOLKFP6_GpsE6KuKtGzrl_jt5H2i4fRQkRkA&oe=6ADF472E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LxT9o8tRZwQ7kNvwGcGH6l&_nc_oc=Adpqn7_j7LJRx7td9AVkBpg4mBFsv7LofMaTSadndMbBQpM-iwxyvjOOIFHKR-vzqkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8AZY4DZ3W5Gpsna7UCyFABdqYwwcsVsvE17tnAh059Q&oe=6ADF7876"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JklIIkQRjdEQ7kNvwHyXgLF&_nc_oc=AdoxOnxiRRjVhqg2uagjZvm2X0hGf3LVhVF7EYd7bLz6FxbHLf-ygCrzhO4qUqz3Rs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEv5TQ4ha_dZSreYtpVp9IKblAIEhFMgBTVCxNs0BUig&oe=6ADF6B8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
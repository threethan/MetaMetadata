vwHy93ut&_nc_oc=AdoHeD-6yyPUxlJS_bxVn6yqMuQR6EmPmW4uBPrPZUX8zo3XNuFG9970vnVik2a6Tsw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX6g28WZLHGINGxvMQ3ER1yKXQ07Mi_PF_PN9hICmLtw&oe=6A9C1A96"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26NHI7kt5BIQ7kNvwFmJi6e&_nc_oc=Adr-Ve9cNI5qTd0FPXYk5W3r8aaa88UNTZh35ugvQMw4iRhm9ktk4_i2mLN-qkeU2nk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSrBFhawpVXkfnhEPd_ATe3sQZLn_u3wtQjoVVvNvWbg&oe=6A9C0F9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvaZ-uWWAPcQ7kNvwHwvcb4&_nc_oc=AdrMSqwYs2tXve_9ZfHBCKxGd8L_O-Xr4jITNWN9OMuoJkFxbsDH5xfeymUQPOplKsI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzaaLtMCqfAf-4i5KBVkJdDRVcKzV-muuZx2nvo0nlsw&oe=6A9C0AAE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86gJlNqMqxwQ7kNvwEOH5Pi&_nc_oc=AdqsZXPjGIPTl1lNqLm1LAPAN49ld8mr4IfdrC3mCMJbqxRPz6GYAUk3eX4RBhca0C4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX5NprFatbYohMDmk4P2HVVnGdDBoIDo7WmEIFUwMyyQ&oe=6A9C3BF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VLJP82cCg0Q7kNvwFIhE7l&_nc_oc=AdrfwftRubgIBr37zWlt53o1fmHEKlHJiAjRFEE7J4VVwsPBXEFq9TFS7uax6FoO8lI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJvBOjhD8rcOwr4t84nnjzU_p2zTvjOSHMFwWVcnoyUQ&oe=6A9C2F0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
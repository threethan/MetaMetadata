vwGinI5p&_nc_oc=AdpvP56uPU17OntM-iZB2vQ_Jb3jQyeVh3WPcwEQ1eyiy9lQ2CtvkBw57cUl2WzRtDE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVKuG_tP_kJE0dI7vihfE_VWzCk3Ld-T1meNGzOv-I3A&oe=6A748D96"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xquW0y_VzYAQ7kNvwGkLNo6&_nc_oc=AdoD2N2VV-gHeSr9uCI4NU4Lvun4so0aX3BZGUdUcjmWFc799aroKGqNdljpg8n71WE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4BJorUjZjTKEiQWEXwgPJ807P6F2dDZmXTBfxWPC8mA&oe=6A74829B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h6BJxp2U0l0Q7kNvwEP-ta6&_nc_oc=Adr_-vmZVGwqGw7XhlinCk887DWyBvyyucVBYcUztwP7Vbmztb8OdVWsgpjk02pI2dY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElATnQ9QaKFKsSF1-jVATeyPJFpDMbgEBKk42jfGBweQ&oe=6A747DAE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGTvzs7jqvMQ7kNvwFP8q58&_nc_oc=Adr_UGQ3OU0VWAsiwR8enlBtYd9ehk9r5ANfmFT8V-rImw_UutUScV32c1au-lLlb_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3dw-0wFO5Nnu1umBR3wQ7MS6k1BA_Fkr5xdSkNrg4tA&oe=6A7476B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8fjAsocli0Q7kNvwEzlnpP&_nc_oc=Adpdn3zlF35ssg_5dL4hdpZLULcWVdjOK3L--C7rGe9bn_sdS6nqB2ceqfsz1GPXGkM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCfwpxabjJSuzI3ic4WBE06IhQrRKGQaTA6SmJuQ1qww&oe=6A74A20D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
WxRgSO2yZulZYVMm98JEkrT3409Gvy5vry6JPDQpQqWytXDOSUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyg4qsr-AVyU4wP4eua3maX-6zgGSQXWYkJqmdhMhUYpw&oe=69BFF016"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBxJH1XMuOsQ7kNvwEHvZnL&_nc_oc=AdmolJwg2eCVgclVvaL9MEO-lWo5YLGocIXHeyFb4moA-3m-KILq9SKbVoU079jwS_Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6kd_dwaTUfsSXdExcjNeAP18q9qteifuAEj5tAV0V6w&oe=69BFE51B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOqf6Jv6LOcQ7kNvwFZYd_J&_nc_oc=AdmQ-byaUcU3n4VitqMze2LTNHhbtUHpJcVGTFVTQ4W-argwHNT90Ay44Lzm__rwVuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxv74M1f7cTfPq_fQh4_qPC2qOYw2QC0lvJAH4YCSGiTA&oe=69BFE02E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MumoaJOxjvgQ7kNvwHgxW4t&_nc_oc=Adlx9_5Fl9tL-gHp11Pb796qX_cqqPmIawCLhi4pWPCYhTrTbyfP5uybVpUZgD8d8d8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxWR10cxQeduZ8zWiGKHOdlFUij7GCdSwXQYmEDp6IN8A&oe=69BFD936"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuGs86f3AmkQ7kNvwH2JmqA&_nc_oc=AdmlkXrrlv-O6NcS178pL0hhhHnnvoPAF1-wNhtGqRGnATKIFbLzeXYmLzE-xEp_zrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4g160eGArFiew9aIzWp7l6hFlWWYJtnF7mcv4EUVIcg&oe=69BFCC4D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
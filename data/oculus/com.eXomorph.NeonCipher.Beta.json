vwHNxl3-&_nc_oc=AdqcH-f9c9W4oe-g3UjHb3kzmTCyaVrSwcRd3lV-xrUnbFqvEihsBOdw34OPE4gZqRY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1htV7INmkJ2YI2JlIji4Lus44jDZiFsO8efU0-09khA&oe=6A412316"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDKGhT8en9oQ7kNvwGLm9Jb&_nc_oc=AdpQt55qsbDx6q1QspcWnHiFC_1e7maVphXlgq--uMIDkcW7i79OduX5dnrqi33CLo8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LpoSOGCprdBhDoDWuj0gJ4KPN7umVNGKlCSYaNHghcA&oe=6A41181B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QSA04CwhKUQ7kNvwF8cp2b&_nc_oc=Ado8f60zsZs5OYLOrZ6VeA4w3sc2wSbYb6MMCrhtvdI6LXxO7ulMxrU9xzGM2gQ-hr8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R_SHEZcmsJ9sAizHsy14_-tgltzrWeWz9K_fayjeM-w&oe=6A41132E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esISGfQ6wb0Q7kNvwF4QEp9&_nc_oc=AdpwrJjDr6STKBbw3pDfHz2C7jucT6NoGJ4UowJzkMAYF5s5_1oyns6PaZ_1VqTGOGk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xR0YS5fdY3pvD31YxSms953F89ISb3Oe0qMDvSO2FxQ&oe=6A414476"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=marwi-NOKz0Q7kNvwHRXhI8&_nc_oc=AdqDL66h4PX1y0_YEzC8K3_eh1k4J8WXnNRcrihaz3VT4rswX9C7q58seGEcTVUgfD0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NVcim1zr9kvwnCLm-oKxCgh6mbI3U-QKJqJblLDqBbg&oe=6A41378D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
bNdpYQ7kNvwF1nHwN&_nc_oc=AdqjO1RERmI-PTHgpOd5GMeyMdrKpNdOzBJEpjUosc1H2d6e8eobP8L1gQoCVaQWbtU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rzGYccL-fofyo5y0NpXmjnhpoBIMKO77kyRGg04gGnQ&oe=6A466916"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2woIzn8V8QQ7kNvwGLGxxI&_nc_oc=Adrns6zr6giAjuPvQOXOIF_RPPb-M2vIbKGix-zHjyLSyrAR9_nTqzfxMwb4QmKR1V0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r7We-ea6veqcuY4IerrFkS2_W4jCbJQO-Y3IEc8INLQ&oe=6A465E1B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XOZxg1xgvYQ7kNvwHNrG0r&_nc_oc=AdqAD69j2wzYzdjdm8LXLwIsy7sRtP5T3tUi28pD98k-XHxpLG4T6bZU_EWATStH3MQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rm_eilJD_yMKuuvmeRZ1LS-Sng9RFB15faj9PhLTmvw&oe=6A46916E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF0TPmx6GyIQ7kNvwFEGh57&_nc_oc=Adq73o5DZIWCaMdAzox1npYuSTip3oZ5Gtz0QOeELxUhkp_t3KtPguVNHz7jUkNIP2g&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RRn2S0NojfbRGyzpSBnjBVoWa7UGM7F6gKDPkRaHCvQ&oe=6A468A76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNhketXD2p0Q7kNvwFM9JXv&_nc_oc=AdrPp9V5ME9lW0USGmhQVzvLn08BiH80yWPdZPDbuXS6KeFa8gDoO_CwMTGsCQn16LE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vNWhOGxGdvJSeff6yzhFxrHSkRaD-1CccqWKoxWEdHA&oe=6A467D8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type":
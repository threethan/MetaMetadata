Jny7jE15IdJBiMkHoIwSCvUsuD5tfmse_s9bL1tUCMGqdFJcLeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy129g0uysvZPDKlLnXvl-_CrRvw9K-IjQMTZZEuA2stg&oe=69B2C116"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWlLJIHrxQMQ7kNvwEFF0Hs&_nc_oc=AdkYLg_zI9Sv1M--abOMYW2h3XjTTUWVCuCJjvbf6K4bW9mvvlaX15JU4exz7HLx2Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8lXCHFsUrLtAH3sQTa5c9G9ujNAraSkhM77pkg7qizw&oe=69B2B61B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEAgwMqgSLUQ7kNvwFIpyqU&_nc_oc=AdkEK-a4mLs72OQPcAYTowY4aK0mCeicqhiZwfytBFvIGrZZTBXpi4zhvdgN2C4lObQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afym_EPYxX0uL7jBXFgkgQyPWACeV25Z97zUGpaubWEopg&oe=69B2B12E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILTNrdXrZe8Q7kNvwGBL_TH&_nc_oc=AdnU61LtHTlUjT_FgY7vbbJ48u_NWMMpUEVDa_qZhlyWc1npF8V4m8g3MRryobi8L90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtM2zSANao6yrlofB0qM6WF4d9wrxcnE9xTOar6pdGJA&oe=69B2AA36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5olVugQk8c0Q7kNvwG5R_Rn&_nc_oc=AdlaLZ7kT3RDhajtGixwGuRXedhh_bamEnGnPjnpK4xHrfAJI2vJkBwrkcmKaFkRmp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYokWw0hHgrbHMNWVZTztIpCKr4lR9IFYO620exh9n1Q&oe=69B29D4D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
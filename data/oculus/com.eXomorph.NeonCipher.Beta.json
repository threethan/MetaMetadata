R7Co1IQ7kNvwG13kpo&_nc_oc=AdqiRdB-2z-mD_MzL0Cszw1jCmUdMWbboKd9DMqIPhLPAfG8bSQY8S-bHYwj1ot6mIA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFea_Aicaj31vEIoL9Dn62o8xWeGiXlF5pF2P3kGHCJXg&oe=6A8D9A16"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twvpS4bkh_IQ7kNvwH1oYM8&_nc_oc=AdpRLvkCcTmorhijuSR23CtxsOXxQizRuZhHcbpWuf87aciseNtA9pjGSQ1BWPlFan4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOEEquZWrA_ULeyCQQvdlDS58hX6nVhckfkvEh2eX4xw&oe=6A8D8F1B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oyo7lAVN8RIQ7kNvwGtkbfK&_nc_oc=Adqet7HTEpZZcM3s7NLqYJu7Duwmohf8G7TC3s_-4Os3p-5f50Ae_41K8BkH2NyUNT8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERLdyLR3yjRgQJxXVKMnaaGIdj6I0eKsq8sbWkjDi7Tw&oe=6A8D8A2E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV2cHUdUygIQ7kNvwFRN2W4&_nc_oc=Adq-Vc_Iw0ZmCNnMDZt2O178WRV3IaupknhlA-vNv9fBvBkuKv4UY3sGEqHwQidAeyo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeBEPD8XD5mTdMyyDcL9zy_Lzqx4bh3IQFiJ6bk22aiQ&oe=6A8D8336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OKqeilJ5m8Q7kNvwFnixQU&_nc_oc=AdqZR_cVaantgeBTJpX-DMOIDFfRWbyy33CoobMAF1Xj-fHN0ZviEO4sDpKLFERaDck&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_up-ZtoHEubwxddVvKaGwl9WveDUgRJSDcEL9L1Bpvw&oe=6A8D764D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_ty
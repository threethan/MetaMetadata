vwFDTR8K&_nc_oc=Adopek2eedDZGj7zfyFbFj8z8KU1YNzBnARjqmtcwb9B1lPSa32tHgFfVvi0bs0xAVA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwADuSNL8e22pdPMClZomBkHLM8PvNw-KCgzmR4gqO9QQ&oe=69C29316"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjPLOpzonQYQ7kNvwEUGJdM&_nc_oc=Adopvv5msCC6zDgCSNHxK24VaK-GMAkPtV9JdgEmWYPAg6DXOOGmnepikoy7HIV9ngQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfmuQWENisk3pXzgelv-w-834sZ96FEyO3BuBoq0YFow&oe=69C2881B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NedfT-yFpGoQ7kNvwHqgsGD&_nc_oc=Adrr5D9fEJap3PGFViaqTj9HUZ26fQnmRfp3pK5vKEEXJOM4icCA5pPb9DxYz-SyKB4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxc4rz2HKbviBdenms34PauVfKptAOm-ZTTA6Q_GoF9tA&oe=69C2832E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOEDzau-u5gQ7kNvwE6Bci6&_nc_oc=AdoCO5Dw0a1WFu6AhHVBo-i3ddo2OIpUyIcqmmkAde4PrXOPlgKYFq_FYOEiQpnnkIY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzy7-YGkMhVKsimySAFGsl6dTqoTqctq5zjE8DLp2ptfQ&oe=69C27C36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuGs86f3AmkQ7kNvwGz70-u&_nc_oc=AdodpYyVLkvOMwWmgiiwMNP01SgXoLNY17o0RiIOE0s_59aszntwOOjDVtbUckknqjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2p34U7v2oXLQt3aRNfHZV_U-UquzJ2qagjzXHK7ZEzQ&oe=69C26F4D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
vwG1YxTx&_nc_oc=Adq-7Pq1YvwHpbbXBYow-RugWm4QoLksrcJp6HRejNmgfocd_0eCoJkjgwuw8d26Q7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7N-MPzJQvjYhJXWyKi5CvthNiPL2YdWT3tNUoqgu3Gw&oe=6A5F7596"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3huuiB45kQQ7kNvwEcjODG&_nc_oc=AdorHdYSYD_meTtsRBxShPFzZHGLGziSRkdpb6hL0OXfyzUNYClIbG5WuhQn0gOX190&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAliBzbdon-8uRp6toPxEw0M9ZBxlgk-Fu_ziI_gYkt5g&oe=6A5F6A9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa3F618ARAUQ7kNvwEyABI-&_nc_oc=Adrm6IRuXfVXjAq_yybBmwoe4e5GkWZ4dgpVfBqPYRVh6HH6Yw0xn2RvUz9cp3QJaKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXd2KlgRM6PH55v-5Eo9Rl-SivW4NqHIocsRS7VxWaaQ&oe=6A5F65AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhzr6ryErDoQ7kNvwEuJj_O&_nc_oc=AdqQ3m0HdT3OODTiVB_-WJER2Rr5CaEBfpTj5HJc22Zt7vfjJPAuf9KE__43Y6abrzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAukX9qNFGus6c-oQMmCmdMBU1bSQ41OSEeEkQOAiMhuA&oe=6A5F5EB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es7ZLWZhuKcQ7kNvwGucPvF&_nc_oc=Adqg0i2up9MaIlwSBTJ_RFDUAYq7PJtvmxNPM3_gG6OGHzmGiwEVSUR7ZeK5W_B07QE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBz3F7p-ykyVCd1HGgljY8KTrOaA5qLLMyBNIqZlfUbg&oe=6A5F51CD"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
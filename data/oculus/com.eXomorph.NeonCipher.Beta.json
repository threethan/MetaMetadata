VfOp4Q7kNvwEUKDHg&_nc_oc=AdrexVTJhnMuoyVmDplYtAKu99PFnh3bg5S3GpIpOJiUdsz8SS-sxPH4LNQmg1paa8c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xD5qdus9rXvRcFEzBb_MJWMB_a-0tf1aLbGMthWWK2w&oe=6A22D096"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Oz-Zzmom_kQ7kNvwFPqG85&_nc_oc=AdqOHEOasGlRTtFmm02jkpS2cjdRKMr5-EfVcQOYwOnIqPr7VAdqv9JkCSLTv6mXmD4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oLCRIS5R3WDchLl9ZzPsll5Fti4h6VkP4QUgDGkmqZg&oe=6A22FDDB"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmIat4Hxe4kQ7kNvwH_LuV7&_nc_oc=Adr_eGpxCdjvZ8OLNWGYqkRoOqnx_i3krsGZ37OIw82z7hC2lvGTsHmCUsc3iR9EHAQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cWpKlmrnLt3G8xFLyaxOrJdyN3rIxB_qSDey4-Tr_Ng&oe=6A22F8EE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCHqRnFcge4Q7kNvwENdNfX&_nc_oc=AdrltsPX2u9uhW7Y5NbLkCWj_c_uz9mAREsPG4xDsDb7fHYehq47EQQEUhspzldNuFA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UObImBzZkd1o87kSSJHlkjj7gUbruJcyTiV3iY94QpA&oe=6A22F1F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDs1Swa52PkQ7kNvwFkyAIf&_nc_oc=AdrZPsoTJz-TkJljOHUw3qeLX3hhdAujVTROarq6VS83jNdSY50pzwnnEyXgvMiZiSE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af830deUKsekeOpKZflmLmJbDBSJSvlYcedAvRcsB6CP3g&oe=6A22E50D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type":
IBvJaT2EdWJ9xbL_nH-Fb4HJLiKCvaLBYsfRC1nzdxvey1oWtEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5saYeyueNI5XYDvQYN6d23iwjCEiT-D8GHySjSnonwQ&oe=69B6B596"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMt1qXkuZKIQ7kNvwHRHCZM&_nc_oc=AdnufvOs6HhhOTZPPZEdREMJbHuMdY243GZh_kyrNwiSshU-uamghAFqfdiiK8fvzFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqDlB8oCS6Vs_p6Qf7iYq6wC_DCbwUVAshLC8r9Eza3w&oe=69B6AA9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwWC11CoGhkQ7kNvwGy9ewE&_nc_oc=AdnbS54EiZ-oYQXCEjpdjO2f1xS0_jY_-jnxhhIMZzAIvEoW8k1-hD2LoUJjMthS3wQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWF74_0sWI5wURzzbMuE0boZpwirAayfmav08K2Mmppw&oe=69B6A5AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z0E_AXUjwIQ7kNvwGLHRq-&_nc_oc=AdnLb8IJK8V3GK3eBSXbQg29zyv4TPHQw33fntsklK91btihc68XOWvJMCCut1vnBhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRWY5uu5B4QqMN5PnbCpFnmcswRArzhNJbDvMmP4N6jQ&oe=69B69EB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9hWdxMo1fAQ7kNvwF2gXoy&_nc_oc=AdkzDx3VXlysZE6q2cEUJcvdaRQLgmku3u8kNsSAPsetFd9BWdXowIdBoj5HGvmxs-I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx9hSxz7lPuwxUlb_JKanU5qIkkOqBWOaSEOkr6YohnyQ&oe=69B691CD"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
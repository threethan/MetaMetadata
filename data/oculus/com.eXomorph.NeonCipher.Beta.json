vwH9FmTJ&_nc_oc=AdrJdGvfe6-D36Q02lGibBIHub_rZwj72say4IEf-W4H2b1qLN2FE0cG14GBM5Kjqus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMWdMKn6AAd1oglPPmmPuUF-yIwGBp8p6HhcCeWdS60A&oe=69CE7096"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MapMHwLGmvMQ7kNvwHRA5U3&_nc_oc=Adqp9Ylxqtq8x5J0kYWTsxKvYQ1rv7KqgLaJRgMDYSKyDlMMqxgNw9IUatXE1y8URKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_-H-5zaN3A4uN5eFr9sZpzQqBIdGPUBnPJcqDEGB-Cg&oe=69CE659B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZY1PNC29G8Q7kNvwGhxMWH&_nc_oc=AdqH_-927PtPKyKlk0Tc1L_EZnZUyFuX4Bo4oRX78LNZlgelnc6fBf1LMc94nTzsk58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxyymt0UzlwIh2Z8Iq94x-riLdwukFdznprbt0E5NmhLw&oe=69CE60AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VnXY9-urlAQ7kNvwFZGD9-&_nc_oc=Adr3J9Azs2KVV7GwyHUOqgCCYICy3Uh2Uw_QhiSTqTRviLEhsBEmQsyhBbdlDCi9Gt0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzywVzSbRvMaFL8y5fLjaIASZCLIhKYaaWPVXROjVuYIA&oe=69CE59B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO3HqOGjPioQ7kNvwEY6zt_&_nc_oc=AdrnsTwM0cuTam3UnMsoRJGvWABCGXz1b_IX0xDbd3dw_iD6wn_xRb97Et-U8zDVdR8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXnEPlgHoZS0fSU9naFOkfQla4gJksxDovpXWHk3vBnw&oe=69CE4CCD"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
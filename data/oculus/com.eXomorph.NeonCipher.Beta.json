vwHThwrS&_nc_oc=AdpOU3sn915HYigv1ssFAdEOY9vclyfunr-uIxW2uslYYYGkd2FfAOJ4muipdRtosig&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1NQUMDJPs5KNKD8SOR8PXtGNz13yjgCj6W-SrLo3Tnw&oe=6A997796"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9UctEDzuSUQ7kNvwGGI-ti&_nc_oc=Adq0MLkvv8zkRyzPWuh63zxVpZIsQNuT4Kbbn8Mw9Db4_H44UOCJAOsyNOrp-xOEyC4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKIWAmlweENxqqvT9yO6zL_fPLSRb8rhiV114uYpMQLQ&oe=6A99A4DB"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lBf2-coxWsQ7kNvwGgYPNg&_nc_oc=AdoklWcNuaQTvG3GMS_Sruk5jq2akVy4RUdBL28KXjKZ9zUalkDxO7V2rDhAI-_3vAE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyyfoo61pVeCd-bR-ldMxY4jN3PejbFJqWXtXflraTwQ&oe=6A999FEE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8LFBYDrt5cQ7kNvwGbBqZG&_nc_oc=AdpUmpfDqvQF5O35wPjQstOaCXFSU1lhVbQsq1TFHLCSCKLyjy68kMIiWtW3NY47mpU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz9yJQ4hd-ggEHbzhEjoHEUzmloaCMTPT0tCZ6g2ySbw&oe=6A9998F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VLJP82cCg0Q7kNvwEhX7nS&_nc_oc=Adpsay7EzINf4N4xkylHBk-3dlj7GJ1PIz8uXCE_btio-RdHBxIy9zVgLJD6Oisw9cs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRW3ZjP_itf1aUbMLQkfRaHOuFg0tBq1NQCdzkC1Yfng&oe=6A998C0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
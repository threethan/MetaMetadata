vwH9PhYF&_nc_oc=Adr1RxQ2NAgnDWQbjvov3DSDIdoc8K0WmqFYuixNwQYXut9QNeac5vxlDTA6oydMAio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JjAiz0AKqdQ_wwPdCgUJBDHqK8plbQaaOjN9v5yhkcQ&oe=69DF9416"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XeZymh1DSgQ7kNvwGghfIt&_nc_oc=AdonJve6FeSVmxjOsWw4UCCrNl5v-jNFGbpytsxVbmIQDm-F6H65nbb8S_jjpCLUOSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cvvyYnffKNQqaQL4zRyPoSHRUfK6AQymbEdv0EMd5dQ&oe=69DF891B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nJWArENc50Q7kNvwHb9xVz&_nc_oc=Adr2epcNQ0FD9XDFUAIAQMmaTtrsnV_awyWdTfgtXTksNBQ7042F1PY0Qbq7umv2zQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38TJgihLE-69HbTLy_cWpQWAjILqwIU1F5ZaR-dL7_Hw&oe=69DF842E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkqWoyKtxbUQ7kNvwEfQzBj&_nc_oc=Adowo26GzVDbRIyHwrCKRUqMzpQuoWRhHc5z5UONtxyJw7nsSEYBxxxW1xDVWrpX45Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uJbrIPIeNXXv7NGDo5-lZGGv4uvd5jLfz7lVZKXvfzw&oe=69DF7D36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3bY-zjKaXsQ7kNvwEoag_X&_nc_oc=AdrgkgC_DELUj7CzlLIVVxqWObsmN2nnNIYqru5x3dJbVY8JonD7x2imWruedl2Gu0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s3XPhuHpHsiAFdOMgpee_BgGXvnlBRGymh1-6P9U-NA&oe=69DF704D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
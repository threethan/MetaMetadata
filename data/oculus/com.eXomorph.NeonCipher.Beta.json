vwGqdw2T&_nc_oc=AdqCV49QXrOaMX7cyxpdYUJ3k-dENabhv6Srxu9WvpyHumqpsn-wGwFPZDT4157Bxn8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1F3I8204pj7BsyHClik0DAcfHT5dcfu14kBoApI5aZPw&oe=69E4DA16"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4J8UHGoXuzYQ7kNvwFlzrQf&_nc_oc=Ado49uBAEHt3x8pq0suPZeqyjBIeVHvxZxguW6znl5UuSKVUrBrE7g6VWVFy0zr1DVM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Hmjhi-1I_EzPmc5IoFo0LgWTY8vxTaV8xl9d916Z5Vw&oe=69E4CF1B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNZyIw6LG0sQ7kNvwFbS-Iw&_nc_oc=AdqG8AV0W_K8eobD86kZUXYR1DsJjPdBw56H3FXjaWwceodcpZoI-dbvHRcrHSYRDYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kOJESQWFsZxtYamPd81ZqqA1BWe5TVuflZcQCr8Mn4Q&oe=69E4CA2E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRJw_QST42MQ7kNvwEVh6gs&_nc_oc=AdrkDzss-yTm42l69BAkVzfnHrTfPQTrgNBGuYBK1p5iG941VTwKqNv_SmgHOMhCvgs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1arxlUtsuSvvTMxCwYdgssR4jyepez8eDF-tf3yHhj5A&oe=69E4C336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stsPrsggJQwQ7kNvwFtXKII&_nc_oc=AdrZ2YqSGOGgdxqIbYASMXz7PDPWq-KPl1jJFh8kTOrfUh6MDPz7XyI8AUOZiCSc45M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XDG0NWgWUSEbc3WlfUN4lwrQC2p8XTLDnnp4c5rjFOg&oe=69E4EE8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
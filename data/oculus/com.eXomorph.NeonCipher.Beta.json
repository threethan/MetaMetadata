vwEDi3lw&_nc_oc=AdqAjprySihQp7ayHU9A0L08IQcUkzusb0ckps9Km5HCSa0r4hfQYu69iMLCzDvEuA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCOAo0jQUomgd4mOENrlBI6ekEO3Fx3SHUWjQKl0L_Dg&oe=6A5B8116"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecom3mqxVg4Q7kNvwE5UUX9&_nc_oc=AdqYhSRhJFvY7Sx_IlS84RHyUZqCoj83ZKjSlLI-JiN9dqoTGuH9nQHFquoM0iDpLBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV-yrwWUpKNFCH8X85DJgS5xGYq0iKOuIL5vrLt0eOaQ&oe=6A5B761B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMq2wlkUWlUQ7kNvwGpLUnk&_nc_oc=AdotOdcVrfM2MeowW2oLge8gTMraNR1FBdSh66rjcn5y2RvYVeLyuvqw15UD3z5eXR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC41aUuJGFk19nX_uOFfcv4l1MXncpqRA9ijv8ZnAakWg&oe=6A5B712E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sePLRXen0DEQ7kNvwFJ0eyj&_nc_oc=Adr-iGHyNx6tAsklT1N8BQujeHPjmG3jPzD4bFswq7axAcxJNIY7gX-EiHcy01Z9lA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnVE_rKvQZGaEoFUTCNAYt_ewehoan7Y6GLAqP5RtQbg&oe=6A5B6A36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeNkYfbgLMMQ7kNvwF3t_0M&_nc_oc=AdpRAzLA9vhnfstEfBYjpVxDnGl4aF7J4UxIxK5uTSsjqW-udFBskFrby9uLwzXd_tE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsGfi8wgD89Tb6mSTZ6piGrdiBtdmPOgeRSid_ZLq6Bg&oe=6A5B5D4D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
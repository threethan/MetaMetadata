vwFQag2_&_nc_oc=AdqC7t5RgUPOElTQrHhj0y6fVXuBjs0py8QKyOCXeRG48ArCrWIr88nIMvwf6WEqlZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsIumNUMemCmR9y7BFADa91buvTywORI-iXU9tC6s-sg&oe=6ACA7756"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynrn3vYLTjMQ7kNvwELbXkb&_nc_oc=AdpiGf0qZFSzXnMuODe545rCG53ZZt40p9ThwrpVF97inG0piUHS3Z_nlAVnaw_UWO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs4jl734VQH3NRxbAh1utYloTFaQuhJsECtu15Gy9GPg&oe=6ACA6C5B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09mrdsnxDRQQ7kNvwH1F4Hz&_nc_oc=AdqJYtFcmc_IKxN60Ki4xIMWQEqDrin1MCahCQgzitIZVMJxd_XJRLi78mnWNO4mTOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQvfmGdN7hkbmUhLUSYvHTV_PfymtqZ6rj4tT1awV6ow&oe=6ACA676E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fztCpX9g3ucQ7kNvwFTQZ-z&_nc_oc=AdoXcIRgM4qPzkeGdbyTkUWA5hCyNoaS6gNKRx-Zhvd-s2fCy1WyBqICTDcevoBanm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyCYJ6gwvIN5PPaeq9CVc7ZbrJ9TEDDoHoNt8kQawGNw&oe=6ACA6076"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBXWDedrw5AQ7kNvwGjCw_q&_nc_oc=AdoPaA-fA4ceIqgegla_x656hD43yikDI9dcPUK16pJLhwEGjpzgFgi1yIa_f-yev8c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbwuoKEQWKVyr65C-0kojF-_FbXiU-IXcUQ8M6ngXoLQ&oe=6ACA538D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
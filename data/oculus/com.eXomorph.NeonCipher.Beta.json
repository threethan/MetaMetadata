8fEhvp8xApu5vgFfyw84VCEp2Yg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afu4L7VHcBQ5DjPxDOaBAncIawQtNUZqg8cqgyY-3UhZ-A&oe=69A5871B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y81DbaitE6MQ7kNvwHAatqL&_nc_oc=Adkl1U1_6ORC52PyCmMJS9WtELBV7CvGxYeimH5A6Z4xSraaDHVYbSVb5LF-sp03YL8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftSxrkKheloNcgj5ZKp-uxgJfAUB7qGIkcvRY0Bzrz1ZQ&oe=69A5822E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXcB7MoXjeYQ7kNvwFRrhoq&_nc_oc=AdmhF8jzk-i6lvU-5dyU1bBUrBnhSLijc4g-61hd5Lrbtif6UyZeVPjH9tYGIA4B2Bk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftysQYVUYvir4YVoeP3x_Je5oBz-QSD94ZWp74KyaNQGg&oe=69A57B36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxL_Fv1hQDUQ7kNvwG4IQqO&_nc_oc=Adn5661WbBanzCf9i7SYLIpXakcuvc3B-eRmrhYL9tganuQulApOu81H3f1MFEbWLN8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuz8r6_yW1pYS9DZQ2_BLhBJ2wz-f55tMWZ8W7Xt2gDag&oe=69A56E4D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9784585658289383"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1168048345
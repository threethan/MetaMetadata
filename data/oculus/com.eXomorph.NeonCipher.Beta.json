vwFkHz0B&_nc_oc=AdqXB-7xMGjdJqAcWDFOveXftHeNNm0qfc2Ph___MUr7ma29kDyjKSTHo6eBLTnDrYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCteEWKwT54FgeyJnZlwkAJOc9v08oKIGTDg3wa7yOVgA&oe=6A636A16"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZB5x_FcZLcQ7kNvwH87j4o&_nc_oc=AdokXz-24jsI5qYkvVswApo_sp470obqCrqOVsDGg06LYF1YgVvBPD__EfUxUWA2SGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGgz6_haKNhOxUyGCCajLVtcldMVbzaG1atugA60FzGw&oe=6A635F1B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCxCg3iSBygQ7kNvwFAsKqj&_nc_oc=AdpUzk5tRSbdzeXDTu9kg3q7a-0qpleAFx-0HDumuSaeMcnBnrfzcA5g-O5wXx5-P0E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANWUtvUjQVFUI6Y8rOSaZrXxb1ecy3waN6BbSVPGdLKw&oe=6A635A2E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUQjlXruX6UQ7kNvwGzUELC&_nc_oc=Adrs_TxCvqW_IlDX6URFbcWOZfNyA8W8xkv0Hlk0mC2EbLEqZjGJ4tYqGFLUKNZ2pBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMVXmVA7f4cwmF2ZQFfAc21gqEYtupYqu-ZC40SiE5Fw&oe=6A635336"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1-vDxVFn9wQ7kNvwEhwxTI&_nc_oc=Ado6p5exuRwgHdzaw7zTBHLtHmSJHY4KHna87RITSARPeEDlApDZkjYcD2JpgMB3u0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZG9B-H20LUZGU64B65m7eBsOvXNHSd_AGhoq5MS01dw&oe=6A637E8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
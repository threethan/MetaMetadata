eeyFTdF2lPjWSeGxzInueawauf7RthaWoSgjlwUuwpVG-PBgxKk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSewAH1AnU4YyWFLQ76NUd638jaIHVzE7jyOMnQmVcag&oe=69C14196"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjPLOpzonQYQ7kNvwFf9KaA&_nc_oc=AdoF9W1k4xh-B06z0H1_dwJY-yyOye5aULovWsZqFRvt72EGAvoTK5uoenDrfQZY_Rs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbjXXc_04V7G-Y6VZY9z1Zaa6AfzL6keEXVFumOOipaw&oe=69C1369B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NedfT-yFpGoQ7kNvwEi7-g3&_nc_oc=AdoCsc-tPGv1-vmc4dnpKIsBo1jHD8sbpxjHgwr5f38xHGsw3EFbNnN925i3uhwCOec&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVryltOmYNy3pr21fUB3Exva9tjcUf27DoSDStYnjP3w&oe=69C131AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MumoaJOxjvgQ7kNvwFWsrk3&_nc_oc=AdrFC7cvebINFzZ_c4AiZF_JTA3BDRKVz-Cypy7g-cWP-UV2TR1AWIVVPvVZQh8menQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCvw9p9292rA0oprMtGQ-Ng0zMiI5UO5C_si-Iy13XOw&oe=69C12AB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IuGs86f3AmkQ7kNvwGNpwN3&_nc_oc=Ado6GRIhK47CBnEJ25P51qjyQIszOnp7kxFcPkLlsvUt5Fwgduiecs2ElRh6XgrkW1U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3Gh8p18xR8AShoH1BFZyViRVOSlnGx5oreteLyykvCQ&oe=69C11DCD"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet
vwF4ofsw&_nc_oc=AdrjRBR7Z9jpWIPXH0t0SSorhUS-doDDMuBsMu3a7jPBiXhuuYdcxrblqkfJ7G4WxfY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv6jUvDFQGjYpXujLFGSmGOjhHOnJkNbpSFKXE0N0HiA&oe=69C3E496"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjPLOpzonQYQ7kNvwH_yadV&_nc_oc=AdpfaIjLBcVPa5vm_3MRJWKZK0EWm5OfxqMMgkc2q9LB5mKhupavYEnl2AH-WXgVZf8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXLaV9KmRUW-qVnCP_gnxVAfwk5CB9TzhPzdqhtpSgfA&oe=69C3D99B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NedfT-yFpGoQ7kNvwE2-maB&_nc_oc=AdrPgoMTFHbEcEZs0RuxOwRkLhD9XB6zVcuEswLNcqazMbX1OjjO9ZEFPS27DiJ0DOg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8FtvEMC8JX1kWsAhkyMsfFdjlDiKaarky8OO-xgML2w&oe=69C3D4AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOEDzau-u5gQ7kNvwEK7YXp&_nc_oc=AdpTOmSCB_eZDxdAEXdf-Gwf6fVWLtliY7Wn2VX1VsoZ4QUnGNz_cMGzLOqVW10ce9I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4mqOxgSW1cwU2bAu3L7CVVtgOXh9ctmEjF3CGrdtkmw&oe=69C3CDB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq1oKKN03HAQ7kNvwHg-jbm&_nc_oc=Adp9IanCB72JaVa8VKJ1yOn0CVTdPkoLZLg98FAILFRne2vZKnn4ffygGwKP-myhT6A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxlyKEIH9qztb2wZrRnIh1nthQo6zitv_txblvHDvwKBQ&oe=69C3C0CD"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
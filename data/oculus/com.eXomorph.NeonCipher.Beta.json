vwHFus-X&_nc_oc=Ados1cRrVRgmEkb6im-IPNwMAmtlBoI59FntcnLvO-17sC7vECvFAMW6JoH3BLtxqRM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeNRqnt-QFLJuzdnNZeqToYBRUDAGaXI7Knlo3zq7O6w&oe=6A5A2F96"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQmVAwRSJOIQ7kNvwGgZ3hF&_nc_oc=AdoJ0PZZ5hCeTxzlQ74RDSqmRIKNingu8gKuzf29AdZ212IRuaHElc3zWaBB0GhPlJ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC95VHMSkbhAdfXKCAjPMqrgbowJmUTShX7_g-cgKAI3A&oe=6A5A249B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msucthV3MjYQ7kNvwF_dZry&_nc_oc=AdqQPB3YoLlHBfVH9cFTOeFJKHjRCfJE_o1DSb6b3wXdSdsr-aSgi7hr0ne_1zS95As&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRXDcd1mfPdBdRItC9TR1_qR-7kXShDGa_wO7Ww1ITFg&oe=6A5A1FAE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sePLRXen0DEQ7kNvwH76bYL&_nc_oc=AdqYPMk771XpELCW98w4xlAGWYNMyjbVoou4Mfx-lIf1V6yTHmGcHsipmx5vJ0r3R4w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4j_GmzJBGf9QzQAImY0ZMioLU0jgeP8yRSSrThtSa7g&oe=6A5A18B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeNkYfbgLMMQ7kNvwFb-3fj&_nc_oc=AdqG7xqtZ_gnTbpeg6X039QZoJo0NMuQSh15Q688ac2pHlW0rWPAeQVqd_VYVAtRKxo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDEyCbJJQ1hkjJxcI0v1ZKULvJwBl_E_Zh3Fou70DQ2A&oe=6A5A440D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
vwGsYpK8&_nc_oc=Adopk1Uej4ohwboF7EwGKkg96rWPuRxtSIZSDiosCXbyXolU-PDAUMtXWCJj1GQRDyQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOoFQAcbfRY14Jiv99pMYY0uNMvZwFwNW3aPCNiktAYQ&oe=6A5E2416"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecom3mqxVg4Q7kNvwHeUHny&_nc_oc=AdpsQtXaZSc4VKd4Bp56_Ja01oKM933F2ismLNon4FzhiJ_kN93VKV2mBHVfxP_rff8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbRlv9YvDOh8Lq6mpJ50uG8eRmm7RN7loyAQV4kwIVhQ&oe=6A5E191B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMq2wlkUWlUQ7kNvwHsPX7a&_nc_oc=AdobvP2N-35jGUoUgqeLIfO6CtR31YoivgiD6elI5owjeYBNtw7JWr3Pg2AVf0hdRGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABEu-B6d-3KhDomuqyr1GY8m7A50BWCfK1XX3h7nRHlA&oe=6A5E142E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhzr6ryErDoQ7kNvwFZWMW9&_nc_oc=AdoBp_w0ZDuPmcpp_xd1y95mcggFzxpxI8lcAbtKcfzgLeCIasCs-1FoAd4O-rnNaDI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi9FE0CYM2oLQ6nuageZaLEAiNiAU6Mcg6wym_DSj4Lw&oe=6A5E0D36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es7ZLWZhuKcQ7kNvwEQwoYw&_nc_oc=Adrn922EowGFMoNFzoWvuyAihvqFSxzWKeLv5Hq-vAIuK76lIxV9XV5UIyYO6CF7H_0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiPgvULlBZ3Wf0kSi3UyxNWTiWrauesFNgjpmXeV0M2w&oe=6A5E388D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
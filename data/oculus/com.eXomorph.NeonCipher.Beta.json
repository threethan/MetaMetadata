vwHHUq1W&_nc_oc=AdoDkPV6vm828QPD08cLtk-_VZkTDx3S1GxjgcSHWy7N6-Ul8gozLdNVd2Tykfy6x8Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIJmo-CxSq9Q8uG_4gLSYrH212dG9C81H8Yc29ZBY1yA&oe=6AA16096"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrEMyfeXsmcQ7kNvwH6JLHk&_nc_oc=AdpPWNr41L-PC8Fq0GkzheYu7HufSfEPzmmE0U-M6LhzopB_XiYrPX_rD9sggOhWK98&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKos9AgeI-8BGJY68OI1c2nMitkf6pqtkiXMUTLrW-qlQ&oe=6AA1559B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kmysmYZtkQQ7kNvwFic-3l&_nc_oc=Adr35NtMvtrqEbj9zTFIkvIjqkRi-on293VQT6hVoPEWpwmxudjsNVIbil4AX21604I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-l1RerqdKpIMNqz8bovhX8ydA93XQ51RQgTRjIQxc1w&oe=6AA150AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv6csN0S3SsQ7kNvwEVrv96&_nc_oc=Adq0pDCG4qN2SKpqhvOEly6gJyDX2jxlOdl9JCUoRZE-UIS6UMSB4k1yQ7dxAbAlNMA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcbbpiczkkVz-CyJGhfqWJa8K-2AORJZBl3W9WXC7-Xg&oe=6AA149B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JfxYDTwc4oQ7kNvwG1TyLR&_nc_oc=AdohVzCMGjfswhZhEP2TQmHoQXFh8qvxCQA9lHnmveVnk6INsqsd1RTXrUOhpORh_wI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvZ7j6gusyLcPqCAZ--Aku_GsUWMdn-p-IVUZZUySnwA&oe=6AA1750D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
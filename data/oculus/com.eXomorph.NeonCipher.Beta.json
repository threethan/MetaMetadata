vwGLmYSN&_nc_oc=AdpRteQTQTyKtLKYxHKmluOZ_8Yv3h3zP2dRSmr-nJd2YKrh4T9LgxTR5a9NBGo7LU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxDRj-Df0GH2AmIzJgFKantGJetZu-tbfiBwdE6FqIh4A&oe=69CFC216"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MapMHwLGmvMQ7kNvwEwUdCD&_nc_oc=AdoHm15k8jnYUMTnzTWceQOygjs3NeN-n13_zuYV3QYgrZvlD-HIHC3vFugY82AWVfs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypGqQ5ad8i_aW9kT6hLGjVC-AryuGbHsrGUV0XP6-RIg&oe=69CFB71B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZY1PNC29G8Q7kNvwHTzvU-&_nc_oc=AdoGbchXLBWUys1OoeLC0kGVgvMa5FWxqbm9lzhSFrQs3qFPt2ossLjqIC805WuSDKM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwk1eOMk3xwR-CLZpiBR9MubO8eB_j9lXn3TbC6TQT6SQ&oe=69CFB22E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VnXY9-urlAQ7kNvwFeNzrw&_nc_oc=AdrXp89ZMNbhq3PxQi5U70S8AX2v3amlq6w5MfXX4p-8foDTnwjmKk1i7DeTzp7KNp4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8xl24ZcitWUqI8laexmsYWJBgiYHA_SILzIR7a-PdFQ&oe=69CFAB36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8thPB6TlAekQ7kNvwF2umWk&_nc_oc=AdowRZDSowfiSxDQKSMilFfxFQFpn9Td3p2HHfGUtYQJ1-wNdiKU99NdltxMmSy1P1c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzXyWluMP56AExIKpUpvE49hWaYXlET7xYsO_jzcWEK3A&oe=69CF9E4D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
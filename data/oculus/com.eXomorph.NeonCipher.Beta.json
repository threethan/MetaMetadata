5cgGwQ7kNvwE0up2N&_nc_oc=AdqTzETeIThjRUNTiwzLcNvvHCPPp_gumCcu6NRFZfY4ciO8wzAo4iH1p48x_vhjptk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK78J4T8xLAf0OV-JC110sFpC5WHJvNeDrcu5xtj40KrA&oe=6AA40396"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPd1152sG_IQ7kNvwG26033&_nc_oc=AdpgQhZtFLyxvdqj3gBatSjaxrVJ0p2QXOG--qDRCXJs5I-mlHCeDrQZ2aTpLRrqz4I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj5SRT-i_y74A4pUxiHYSch7WubYJ8kmKKl38YVkZ6xQ&oe=6AA3F89B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHhDWVmMbAMQ7kNvwEsvkOQ&_nc_oc=AdomEo8JKfN4pa_9VP5t0MzJ7g0ESdbfVATd1b-FPPd7OoeAgUBoB0gXksc5-yCoWbY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhtekZiOMFoul_VmzWNfK5XwCqWe9qHMNb1SY_dtJvTw&oe=6AA3F3AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yW0uczRkwysQ7kNvwFpREyM&_nc_oc=Adr0WBBqlpwmZqBuVsmEaugQWJh2TOGV95RpsbBk4DyELN8GYf1jHKtp7JdIF8JS3o4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsuJEdEuRAVqCw4PRhQNPZepd7QDMcX6MtqCkjme1FXQ&oe=6AA424F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JfxYDTwc4oQ7kNvwHKzYmk&_nc_oc=AdqB3ucaTD5BkYmMt9XPwpVBaT9nBUUdrNo24vvwyI3ZUnTLyevu0JExxgFFlKwa9Xg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_gD5dZmka3xbiECpi97epxaKWjD77hYYC_T-HDp63DQ&oe=6AA4180D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type":
vwHrFaU6&_nc_oc=AdpKHA_y7_mF_n54dkoPq0H9X_7hQSX0zjlLz6dOnVihaaS42iak12Z39sxCzM7Bg80&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mVcZQFPspJT1lToPe21mjbVNwm8CFZl51hOaBpW4Fxw&oe=6A0C6716"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qajzwqOLt4oQ7kNvwHXU2vT&_nc_oc=AdoEJlazYLT4a78MDL9a0c_vc8vpQZWlQwv9wCLvVxkXmpLUTSThqZKqa2ZC5zRN6oc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7utUgXYqTejJiU6teSqdNUZhGKzSS6mbkBljimGZLntg&oe=6A0C5C1B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghVYYBLKolUQ7kNvwEXiMar&_nc_oc=AdrM3PzJHzNs3eyIxOl29jvWQ983oMemL8n7e4bTuqyniMNNiSwWDcHxVgXIj9SgADk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cVO3e51WATmELZxYPcwtjW3fRw5qcUQ26dOrAL5OeQA&oe=6A0C572E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ztm-SC_lkBUQ7kNvwGNA9v7&_nc_oc=AdrJPAs5UuH7q2VPaapInK-HJbQdLfsAofq7sZYLg91OhSUlVeHjsv83AFG7klLgkaQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bljx4oLIhxavc6uE3YW2gAHvZ2ZuGPGNAKjIEYgiqMA&oe=6A0C8876"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OicXsxAnnEMQ7kNvwF2Xj-A&_nc_oc=Ado-94lrS8dfQ4DMVhpoaopQb-m9FrBbOnlWlF7Gdpg-u9HFYr8HPrOEkjKvwWhtmKQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4drMAMDvvLMR8-nhTtQIEm0A8PneNI5gQM-gwV94OXtg&oe=6A0C7B8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
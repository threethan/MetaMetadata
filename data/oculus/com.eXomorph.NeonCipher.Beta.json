vwE7vy6W&_nc_oc=AdrGy77DKusdC97xT9xHQdoxoVc933-uLL9KNJJonrfOgjuO3fptcBpSjPhM6pYaONQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJw0S-eYeY1ICCmkHjAjLRFF2bVVXxmBAM5EhDPxPP2A&oe=6AB91B96"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BY3RONK3GLoQ7kNvwFMClX3&_nc_oc=AdrOfF9WqP4eW65ArGyDbxfZNMV4CUWhGvivADRNoRpFyXuHhx2-Gjhl2BtrnuCqF6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvRAEdA-6OEMQgYqm4Mz9IFRyLRbw-P3L61tdClKuL3w&oe=6AB9109B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioLj0OW34CYQ7kNvwEX8iyp&_nc_oc=Adqq4txC4uKZETC9J58LrZyfF7K83Z0Nrh2M1Y8fqSCxdlA6OY872KRAFZV1qIiX6mM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJebD00CMMh6_IlTPP22hPAXJwxdkfEjoq0pfdN95vznA&oe=6AB90BAE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkAuERqGGq0Q7kNvwGRYVze&_nc_oc=Adp03OZapwg853IOEDif9MQ5kbBoUxNnSOb5j3urVll2Y9R2c21bp5ldQ6wyw7Yx1CE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFmtA8_KlF8DfWnl6C1rzf_KMlaXp7Adr7U7014d2zaA&oe=6AB93CF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX1YHUFcfTEQ7kNvwELd09X&_nc_oc=Ado1ZNgy8n9eGVepy53UjtkOvD_p5QOHm6y6AW0fnjkIXdyOzSZIAU0op-s_QfRCGFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg-vkrz2PlSKSaDuwWSnO4r9CvwAtLt02_Ki6qiYuhog&oe=6AB9300D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
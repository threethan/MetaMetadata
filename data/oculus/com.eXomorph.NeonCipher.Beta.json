vwFZK1wg&_nc_oc=Adqje7Qa2lhRVl84yKCQKWtz90ygS4-VhiKnGT4AgiYo-U6ue_zSekp-R7a-v-rVDPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET3Z9ZY9lgl_Ac9NofTScyAvYFaJyeB-L3V0evMFNPSA&oe=6A788216"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcvx-0lX-q0Q7kNvwEyzugq&_nc_oc=AdoS49WyHfvAlOCHfil8CJDtfVoq8wpSMkWIW-eSDCuVcP-_FY2T-nea7SPqDQUhD6o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxNDiPoRuBDvdOBb3MPW9phxGLxXU6uZIW63vrGV3PCw&oe=6A78771B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE07hSJTQq4Q7kNvwHe0Gvi&_nc_oc=AdrP3TLiK5Tpt9aCN_9yarLWSZpVEfGwE_0LMAANaTOErl7DEo37R-zcZbmWeWMIvFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4eh3ZstYpo6wzW97kjWCsD_gjrvtXj2x09c2d4B_00w&oe=6A78722E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPV_buRAQ88Q7kNvwFWdIoA&_nc_oc=Ado2VtF1RydAF-bdA-Sl-AheO1bAbGhpbqLorvYzGvJQ6IfpdcpBX0m_qF_tW72WoUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ_1wZznX75z8_zyCY3lU0NrTQg5iOXZHITQ3n-khObw&oe=6A786B36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rMJsRIiZfsQ7kNvwFNZU58&_nc_oc=Adp3rFQmVIVTH-5DT6fE9pBeSCUMBH4cx11p7-wt-nYsBACZS6meNZqNsTUKZjIckw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQZOhVbvuKaX7UOloG_6sBq-e955K0UV_RbSGOx9Zqqw&oe=6A78968D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
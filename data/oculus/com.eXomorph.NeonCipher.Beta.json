vwHeQ4NY&_nc_oc=AdoPkIdpxcZMroDuLeDFCcZUa-DVpr6XTBRI36uMn81B0DUytLfiMpE9RDSP81mY3P4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy9RqDN7jAm2fAXbsAjH126IeHRUyOjXtjz7JXW0iXeg&oe=6A621896"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3huuiB45kQQ7kNvwF0szql&_nc_oc=AdqNRmdNE3bq78_3oXv31gzu6vG-_HhG-8CtBEKDwvnELfWX3nNvxMBvxmChRIWZsZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAufGkJFxz3OjNzYtt0yH736yAdA94ow2GDlu-3a5odFg&oe=6A620D9B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qa3F618ARAUQ7kNvwH-3U27&_nc_oc=Adqr3mmfp2GSUHcaU24W5RSDnjtQzrhkpYpwe_AREUHqzCwSsnxFgjFQH0e9eYtYPhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7hDCfZXfIY-Tdv8e7PGAzuhcM3HwpQXHx0z6cBErvBw&oe=6A6208AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUQjlXruX6UQ7kNvwEPkjCM&_nc_oc=AdoZlhz_9HorxpstoxdwOUvNw2Dovq0ncimhglCQyc0iAK7divX7zAIrmSx0YUwAGt0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLlj3KbM0M2NnofY3k_aEknvPcipP1cG79FIVaC6WLXw&oe=6A6201B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1-vDxVFn9wQ7kNvwE204wL&_nc_oc=Ado8UEXs8Eg2gL1q98vCYkcdnDGjZxpM7ZKnvy4KVBziHxhrFY3jrBPW9Psa_vurWRc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0Cs8b1u_n6VwEiX4z2FgQ8bT7IT2sWtvtYQ3rWywy7A&oe=6A622D0D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
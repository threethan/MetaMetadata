vwFV94Dt&_nc_oc=AdqokqEc-E4mo9tfnt77wXuJoXlUGNvjq84Gs4VL5-SwQ_v5IVmDpibGuRxbKYtm0ek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyfE9sXhskMOcBFMmG2C546olxbXIL5TlaYeZ5Mk64JQ&oe=6AEF6156"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2HhYTjMWn0Q7kNvwHP2vMd&_nc_oc=AdrwRy0MVAUVMkywAYI0d3m75DGFID8u2Qf8eDpGBDYYSxV5UtVZqxoiYwElQyczAAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ10y1DvBQLs0FgUUSlORS8MjSHVx7lqPDNpfvciWNtPw&oe=6AEF565B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Hz_-fRJ8NkQ7kNvwEGNbRx&_nc_oc=AdrOcYRIl-4H-NAxyEcphMLx2u5p88cGsrwNWPWVTUSiH46quruoFONT0ADzUpGDovg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUESdooK3h0GzEak9RfdzhgG2exAFNUvXNwoIYQIPARA&oe=6AEF516E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdNRltSa16AQ7kNvwH9lsxb&_nc_oc=Ado80YqEM1Iklwk8pk3bKQx2tIc4u2Dk33iAIERgrzP-r4f1e7oXksyAamITTvlM4Kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjyjXsejJt49nU6EraJWioqkIOsl5qv8pXHLFlovAHVQ&oe=6AEF4A76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9e94WRuQW8EQ7kNvwHE3Qp7&_nc_oc=Adpx97ZP01Bx3Z8FL50EvIRK2BVNuxLj6Xsc-KYPCIgjECUpVTuIhChBt6ZCancO2mk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhM2cY_8Y23sHU56RxxNskBFArb7e5PjdvYK4U1wWd7w&oe=6AEF3D8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
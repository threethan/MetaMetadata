vwGfplvp&_nc_oc=AdoYhfd8Vl6-eck6oT0Ah1QlOksh_VPqBXo6DJSJVZDm7HxV0pGCUJ88wM_mcLXg8Lo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQm1ryFbll8IcpFrf_2CaQdu5wvRVxuKLvOu4TWl2lCw&oe=69D11396"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5ukL2QLkNAQ7kNvwHuyEsu&_nc_oc=AdrGZvQEFC2Ay46PUHLug-IiGrmQa26y1lbZDMdOk-OJFj2XclRojfgN70RVqcvBMkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzvzcUfIEC56LdDjxcu1SxyXssPK-KUyIvL20_XxFA-cQ&oe=69D1089B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGysJ2AwKkIQ7kNvwFEl-SW&_nc_oc=AdqhfTHZM-KgJaoDMX6QVRsB78qb6UMfri7JQbiFVGoLQDcU9DpQRwoGby0LkdBmYuc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxEZS3ycMFamD92cK0Et9HVh7mHCJ1mttPt99XQHOI0g&oe=69D103AE"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2VnXY9-urlAQ7kNvwEieos-&_nc_oc=Adq3KtN2EfSyzVpaHyUla4cKjQdgElUx-QB7-_68SSWg8Bho-VJTo8UQWjRTocfzUCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-5jkFQjTF0LVWegTEB26Zhyymit7tj3O3Fy8NfGP96A&oe=69D0FCB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8thPB6TlAekQ7kNvwH1tjkz&_nc_oc=AdpdybmJL06PWyAxF61cN6vneUaXIZEhHgKqo9tWGOHAIhPBxgE_zvmdZ3l90pgilKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwo4d7bU8rRzA5_5X-pIpnVSNMZBs9F5npxeiGspxTjwQ&oe=69D0EFCD"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
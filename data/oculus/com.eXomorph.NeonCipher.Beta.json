vwHuH7lL&_nc_oc=AdpW3CsSv_nGcoLMrhDwQmODJlS1yB0lAm6ITLqWCG47MiYq663b2JxWoceoPaIdyO4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SUG82LGYJD_ZTDegjZNkKrrZoP6h2xYqV0fQZpWwSxw&oe=6A2C0B16"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IpR9ZnuitUsQ7kNvwGd4hJa&_nc_oc=Adpxe-duDD5Y3fpK9gzVL7GAwM2jUhntLRz-IAW2MDeG5UIRtY3isnyvTnwA2wDRNKc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fml22iygwHKj7pu_08qmyGJwR3YTuXOUJmA2jCYLqCg&oe=6A2C001B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6j7AfolCUrkQ7kNvwH-hGZS&_nc_oc=AdrH7Lcx8EtD7OzNi9EU91UqAyW90sTh2GWlJ3ZDY93S-1kIZc-L4fvB06dTTOe2VRc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-m5gjtkVLrtyw3xDon5ekcjtXCd2yoY2HrMGDfGvzTA&oe=6A2C336E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94o4f7dxJE8Q7kNvwHbeSqk&_nc_oc=AdrbQhX9p_4IxvCgBC26sIQ5o9t6nWQjx8XzfRyswl3SLKa-uSkawYSD0DKyfQcjLuQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_WbnwkAIugXyKTRdHgkvNQAvcuglP9MChJK0m7kR6Uw&oe=6A2C2C76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DB_7d46WUfYQ7kNvwGVoZsT&_nc_oc=Ado8YobcJfdMfgAXEVhEFxRQdtnheqI5JjdDHpRhQXtk6lIjq2ZHkjMim8vPenynOO8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bGWAtMx5Z_LDmZT82w7TZubNy6yGUmpzseMnBAjn9RA&oe=6A2C1F8D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
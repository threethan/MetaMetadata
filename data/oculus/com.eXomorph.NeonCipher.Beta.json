vwFgiHJY&_nc_oc=AdpkpjSj_mRswFQm1Ys4c9au9BLFHhubuUHHcuUVuiuF0eQ9UJ4IxctFSp0KTlHc73k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IbBWZMEZc_9ZzXOBkosGhZZ9bLq-av6ATC488zgAcNQ&oe=6A072116"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9pIDoieqCYQ7kNvwHCk8qJ&_nc_oc=AdpL9FkBT5_ostQbzij2Gr8TzFkJ_7pC5hYFtAHmBmXUPN7MCEvYjcZTKuIOsmNFIlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59ARi0Ng-jzXyD9I4P5lfyd0f9myQ4ijSjfLLNpuFmBQ&oe=6A07161B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bax_Q5M5KMkQ7kNvwF78Mmw&_nc_oc=AdpUDWqxok40Hs6IG0JfY--qlM1e5zTY4qsqjghuJZZt9quE9-k6IU_c4GaR1bXHUxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5arZzYO33Z3QlULZVC3BZ756gPdOK0C3mtzJrSlYGWEg&oe=6A07112E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39LFFOCKcbgQ7kNvwF_mU-J&_nc_oc=Adr2-Vaw36NNWrLzCzWjC7_7_ZWT3J_O1tT0AWuEj5eKtbexZIgNR6fP6KpCQo_fvi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ct4ChnU40xZCcurF5gDb00t120XinH7kHraUxmO2QiQ&oe=6A074276"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMxds6Ms0OMQ7kNvwFWj8gC&_nc_oc=Adr47ktzzsGIXn6hsbcXyqkpq1o4jGLRFr-ho8WbudyXm1a1yDlOVLqYtkC263vKTXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wfjE355jcErCRA-af0Gv5Rb730a2yAVqnjsdAH3kIBQ&oe=6A07358D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
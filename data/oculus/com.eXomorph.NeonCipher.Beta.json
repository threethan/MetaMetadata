vwF-Phfg&_nc_oc=AdqT4c2v_KUaqskvJ_N15blSo5l9va33ETPIDqAOxXZ7uHiFfuvo0LocYy1KS0PHWPI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9a8zn93adOkaAbc8CCoqz4vAivQvbLmcAmNGQmdMYZg&oe=6AB28416"}, {"file_name": "ss3.png", "id": "692509553174676", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391865_692509559841342_1281660622671555734_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X43sOFOhu14Q7kNvwHDkYL5&_nc_oc=AdpjLlic8tocH7oHBRkBbwTmRsTfwODFLWvezu1c1BeKYF3XrHKJ5SGKeRYQCCWP6zY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdgRA3VYmkwj9Y3iXV_nwcQK0C7RvAgAP1eDaBdjiSHg&oe=6AB2791B"}, {"file_name": "ss4.png", "id": "971983221584377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393444_971983224917710_9141865602563879347_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgaHZinVgR4Q7kNvwF7iKq-&_nc_oc=AdoYBCsoDjUZK_wSKgm8_u8qTMf6tBzL5Bg6zudmeibyNaAWFjsx5vfaBqbxdcH0T-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMAePATsH1zan1LAQ2iI4Dxe8knmf10qQ13B6N-UNmrA&oe=6AB2742E"}, {"file_name": "ss5.png", "id": "1309599546937172", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393406_1309599550270505_2614097177894914330_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erO7YPTzvGcQ7kNvwEW-Pmy&_nc_oc=AdpbMGDLEZpeLT1e6gmjQ9xJ8-lkCVt9ufR_HEiwywV0L0SQpINcbGPJsQtpGk7YuEI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISIp6zDBzKBZMWZiqobjJL15MnlXAvlg8KPXD4Or91Vg&oe=6AB2A576"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta-landscape.png", "id": "538600862232071", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393351_538600865565404_8021931410350376011_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XFEgw6u-zYQ7kNvwGncJXq&_nc_oc=AdqtbKCBazIFgdw1iDz8WbdMJ3jFNppMX9UFTZPU_k0Ody0RhyUONsI6nDDHkoramQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnJPjGEYn5Jtb7rNHkOKi4OBQrouLgXB2at7bQlmcBAA&oe=6AB2988D"}, "display_name": "Neon Cipher", "keywords": [], "long_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path.\n\nAs a new recruit in a small team of hackers, your mission is to infiltrate XE_CORP's archive database and retrieve vital information for the Edenite Rebellion, crucial to its survival.\n\n# Third-Person Gameplay\n{663687826393284}\nUse classic third-person controls to move your character around, attack, enemies and interact with objects. Collect all the keys to open the door and complete each cipher.\n\n# First-Person Gameplay\n{1327023925018371}\nSometimes your character may need a little help. Reach into the cipher with your controllers to move platforms. Also you can stun enemies to make the fighting a little easier.\n\n# Editor\n{1009083324695992}\nCreate and play your own ciphers using the built-in editor.\n\n*A note on legacy headset support:\nPlease note, versions of Neon Cipher for Meta Quest 2 and Pro are still in development. We hope to bring them to you as soon as we can!", "short_description": "Neon Cipher is an action-packed puzzle-platformer designed for smooth and engaging gameplay. Across 50 levels, you'll use third- and first-person mechanics to solve intricate puzzles and battle enemies blocking your path."}]}, "developer_name": "eXomorph Games", "developer_privacy_policy_url": "https://exomorph.games/privacy-neon-cipher", "developer_terms_of_service_url": null, "publisher_name": "eXomorph Games", "support_website_url": null, "website_url": "https://exomorph.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIR
JOTBUw&oe=6AF72A3E"}, {"file_name": "GameScreenshot.png", "id": "1313321807486068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1313321810819401_342266291402530015_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPkUpH8RnMkQ7kNvwHBL1-a&_nc_oc=Adp_fswPMRjy9cz_P6JIu2FADeyEHMbGHmY2Rg51imj0cGMCLamqWsO1nwBKZPBdp3Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYQ7C1BKjrJ87Ay0Jcm_4iYHraIn8Nyl4Xedgz7__eqw&oe=6AF71CFA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape Room VR:Void Of Truth", "keywords": ["horror", "scary", "escape", "Mystery"], "long_description": "**Escape Room VR: Void Of Truth**\n\nEnter the Void. Uncover the Truth. Escape Before It Consumes You.\n\nVoid Of Truth is a psychological VR horror escape room crafted from the ground up for virtual reality. Designed to deliver pure immersion, dread, and satisfaction without frustration.\n\n Do you have the courage to face the Void and escape with the truth? The Void is waiting.\n{975607944933050}", "short_description": "\u26a0\ufe0f **Warning:** Not recommended for those with heart conditions or sensitivity to horror.\nThe ultimate VR Escape Room Puzzle - Immersive mystery, clever clues & thrilling escape!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://panel.adrenalinshot.com/policies-create/policies/escape_room_vr:void_of_truth.html", "developer_terms_of_service_url": null, "publisher_name": "hypnoyic game", "support_website_url": null, "website_url": "https://hypnoticgames.adrenalinshot.com/web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recom
at=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jft-Nld2kE0Q7kNvwGM5afg&_nc_oc=AdqISUyUKwr-a9g_ibkvIKtBgiAC1Y7tf7pjTsFBVilteq3Yld6GQhnbXVInxzzLD5o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBRam2Rm-hEPDaRYXHnx9snC6iND2pP9XVDvB8tzv0Og&oe=6AFC8CF1"}, {"file_name": "GameScreenshot.png", "id": "1641996011273364", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823901_1641996014606697_2442459506788327083_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbK706Y_2NMQ7kNvwGczNHp&_nc_oc=Adpw4W9XwmUVA1-9fva6gPy7AeUEmnT1GR4YYdwtUzwENsMmyP_FaaoTqKRa-8p1BBE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToK9LGTTYdMPyM-GIQAkrWHbV-fW472hGv1W46sOfcKw&oe=6AFC802A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape Room VR:Void Of Truth", "keywords": ["horror", "scary", "escape", "dark", "puzzle"], "long_description": "# Escape Room VR: Void of Truth\n\n**Can you uncover the truth before it finds you?**\n\nStep into **Escape Room VR: Void of Truth**, a dark and immersive VR escape room where every clue brings you closer to a disturbing truth.\n\nExplore a mysterious environment, search for hidden clues, solve puzzles, and uncover the secrets buried within the room. But be careful \u2014 not everything is what it seems, and the deeper you go, the more dangerous the truth becomes.\n\nDesigned as a short, intense VR experience, **Void of Truth** combines atmospheric horror, environmental storytelling, and immersive interactions to create a cinematic escape room experience.\n\n### Features\n\n* **Immersive Escape Room Puzzles** \u2014 Search, investigate, and solve clues to progress.\n* **Discover the Truth** \u2014 Explore your surroundings and uncover hidden secrets.\n* **Atmospheric Horror** \u2014 Dark environments, unsettling moments, and psychological tension.\n* **Immersive Spatial Audio** \u2014 Every sound can be a clue\u2026 or a warning.\n* **Built for VR** \u2014 Designed specifically for an immersive Meta Quest experience.\n* **Short & Intense** \u2014 A focused experience you can complete in one sitting.\n\n**Warning:** This experience contains horror themes, frightening scenes, sudden scares, and intense audio that may be unsuitable for sensitive individuals.\n\n### Are you ready to enter the Void?\n\n**The truth is waiting. Find the clues. Solve the room. Uncover what really happened.**\n", "short_description": "\u26a0\ufe0f **Warning:** Not recommended for those with heart conditions or sensitivity to horror.\nAre you ready to face the truth? \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://panel.adrenalinshot.com/policies-create/policies/escape_room_vr:void_of_truth.html", "developer_terms_of_service_url": null, "publisher_name": "hypnoyic game", "support_website_url": null, "website_url": "https://hypnoticgames.adrenalinshot.com/web/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1391912067330229"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "28864393883220473"}, {"status": "PUBLISHED", "id": "1813245283230003"}, {"status": "PUBLISHED", "id": "1604555521028889"}]}, "baseline_offer": {"id": "28864393883220473"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793137500, "status":
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qIj7UszuGMQ7kNvwGpdlks&_nc_oc=AdqajU3wORHx3cBIbuTNwO24AfuRB8D1QTdA8GD6JIBpOM5Y4frMjHYGfIR08ML_-Nc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCHoFBDENT8O87UCimNy7PjHooqW4jd310z8SJlf8H6w&oe=6A9AF04B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qZpNuNU37EQ7kNvwHp0WVb&_nc_oc=Adp3FlvNxV5PCFif31TqLeXIK6wNJygp3VHSWye7-D988MQuQZGK0JWKsyKJw12_org&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItgckOFh4FtSPf7pcSk7P7g_DuLefPuA5zBtf8ZqAf7A&oe=6A9AD151"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg45DZ3fZEkQ7kNvwH_vdbM&_nc_oc=Adr6W8S4PqL-RHlCvDeTqYAXVDbh2zDRDIZabu15UbcCH256_nd0QncBgx32GutdAjM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxWyo4aIru4Mr230t1n27dmMy6gbe1qUPqslkyxTxpXQ&oe=6A9AE1B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5v5_-os-AwQ7kNvwFNPD0T&_nc_oc=AdoBWin_JeWkn4IFFGFWBopuvPmD7168ukzMkECzFaQjzQssXrrhSld5rDtac8oWQFM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh1vZG0R6O-5-ULjzBGCDZAdjbDViS4_XsY73F_TlELA&oe=6A9AEA5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2jZzqHtoZYQ7kNvwHKFCus&_nc_oc=AdqmBHneIgWr-UKBZXbHEYsAD9h-afaNYkKW2VdFWPGEhypsIaOeQBZf30Voq8MfpbE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKT52hO2V22jKJNedTbn69foSBk7vxC1dG8wazUhutFXg&oe=6A9ACE67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
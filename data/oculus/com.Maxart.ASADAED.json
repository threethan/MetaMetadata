uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pGQP8wwIxUQ7kNvwGoUjAN&_nc_oc=AdpawruDlTVndcQ695KmDxm9z8JnWGypkpwilBih93vFuYNAPUuvV8ZkmifgPbzBacM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFicnAoqFyykrqgI8GFWVVh8EM7ra2Mva36dkSDeBp_Zg&oe=6A75CE0B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Zjmi-p1TYQ7kNvwFYirf3&_nc_oc=Adr3xEZibeGky9dzjaXWrXuQ_dbgIXfhfgs1cupgxbHZLI0Ul29uX0lf8zLPApw1Kxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfF03lHh3wAlvugDFMFG4UdkYmtUxw1BCAuuKXoHE47A&oe=6A75E751"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sh6FZ3fDMMQ7kNvwEqcTWz&_nc_oc=AdpWXzdNys9BxSRgsYXtqA4RaEdAjceMFek98uDYJ80PCQI04xeOeO-ASdEyEDx0Vdc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCeAJG9kmAmaJlzmmKr-wvtU5LU93MxrbrVc4Yo6qKwQ&oe=6A75F7B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCQOAJG6W6YQ7kNvwG_CMeC&_nc_oc=AdpM_oCFxqCIE-k2Gv4j6fWRSKD5s94Yc928AJKLLaNAM3o7fawWhFG3KWsOKYlz8jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnerIEsbBeN6-kgc_63tU6jukue8NFHS6N1NNsG_He-g&oe=6A75C81E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvPu5ty6PUcQ7kNvwH7bxy7&_nc_oc=AdpAgoPBkno9c6q0P58uo_3SsBnKa1RAjdN4pyentd3gam5wKgpwr1rz86U3n_kO6DY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGWXGZveKy7Ye1tbGeWD3kFwOp_PJRu-sc3N-hNTlrsQ&oe=6A75E467"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kSYy-auSeEQ7kNvwHWJO3X&_nc_oc=Ado4EjPbFzemkcP3BxD_9ncVXtSo1Hsjan6fZenSfaVcmXBplKmwjq4Vu9nhZzSCOl0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYgE864it9mTM-6ZU1J7AT45bDszlIpF_LOlwImbRmvQ&oe=6AA2A10B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvUFn0qWkaUQ7kNvwHqng5G&_nc_oc=Ado-0sgTGd3GH9VTvRubODN8lwnWh23PD22LIVarj2WPggvxHgF8830foAqqyUrMcqQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLakuH5iyyKOGJoedslcYiSXgIFDOhOfrI9cnHPEYbECg&oe=6AA2BA51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1_5b2pNY3kQ7kNvwHpkpgu&_nc_oc=Adp9LMDAmQycWfYDpdhXi_ddhYYdnP6Wa4ac9j4LJhA6m3SvPz80yJ0tmwM377bejAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbgVLcM_3FOzKpcOTSWyPNCkzFqpVvqxlNCw0nU3qLvQ&oe=6AA2CAB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S66GiJxd0VQQ7kNvwEChob1&_nc_oc=AdpC8JqtezNJ2UT8cz-lZq2OVsfTbfjTpBy-XW5bBzmPIIqhaJxoH7PY1IrgvGlHE9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHr-N8_X6QSkTwb1fddUewn2kKtPmKqxRN1fLUNX8haA&oe=6AA2D35E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN6yPnf6BXYQ7kNvwEufGAz&_nc_oc=AdrW7JjB0G6pS5ZKADBoAqXWs8pWWhXwF3ELu2QzwdI2STUzcg2DCrfPmFqn2svzVSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLuZCb7MW5HyyFvrQx1UAskTsKogDkZlOdwWBDiSgx_g&oe=6AA2B767"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
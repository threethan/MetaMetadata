uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVIhwjBO-A4Q7kNvwG3Pks0&_nc_oc=AdpXjXU099nQEJpPcbnvmdNZKxlMNWjRHRMfmm-K38Mfmy2fhMvNF9O5m8vUkIBoM8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-L7b1pKxiBaYqjAkE7ZxFGcVt6AYYiGxEVwPsvXWaWCg&oe=6A3EA74B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAOasFJ1150Q7kNvwHDu--F&_nc_oc=Adp-SxVVlzMTJCxLeQdMNq3rBx9I4PY6eQwj1S4kpEIY0tMBBBiwU1NcUaDAuy7_lg0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99WMZgrGw32pJs8cyPVRjaCHXG-qyxHna3w8cNQ8i7yA&oe=6A3E8851"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h7YuS8EWtoQ7kNvwGci7XF&_nc_oc=AdqPSwVpXke45ER6rT50tZN1HeKtr7jjs9mJS48O3VWJGrykT2squUbYD-KW7dtG1eg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dn7_vmvD6FKnuwaO_pHOVowgo2Mh1NuwiA4Id4BYoCg&oe=6A3E98B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIMk2_rM5rUQ7kNvwGi8tGL&_nc_oc=Adp6b0RsCuVGFJ5WYlNtbcPTinMk9o18DdS9WkfMJUeQfWm_Hsghern52J4VhYX2tkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xCgWnOLPZn15D5UkNfXVIHY4d-Fgwtq5G1vyj7rhwUw&oe=6A3EA15E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo9k_-wfI4sQ7kNvwHQWTf0&_nc_oc=AdpJjl01RlBoDGfwK6T-VR53-pIr9xnaBLS4-kOw2JqcBXhJFXVIVpMntv3QNdubekY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lAiD8Gx-nirxGjfGY0WoZBieWuQBmroNwEIWPhvMY9w&oe=6A3E8567"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
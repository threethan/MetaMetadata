uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1DA7Nh-510sQ7kNvwE_xQZR&_nc_oc=AdqkttvuK2VTcDiF_y2uGadULetn0D00ojvniOHMDdx_2kFX0RDvKbr3-Hs5S6qTn2g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXfNNAVZXBjK-vRRTtIuW3to5ir0fF1UNqZB1S92NK9w&oe=6AF9DC4B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml6PlMM92SYQ7kNvwGQzfli&_nc_oc=AdpNPzAPQ37M_DbgqvobVC33sA--X8zYG_7oZUBrqblLeLCgZId70TGMboO2FWUt21U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlVMywxjOVZHtugWfu5uJDGn4G8zTJrUjglPtLGjrykA&oe=6AF9BD51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHZhqs-N-38Q7kNvwH2wMty&_nc_oc=Adr0c8cTf_5u1PA0tqQ6nYnOe-4XCiXefSQM0GaIktykGy1Kt9zszWdy4Q3z2y_2FOA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjItBdOZ-7elzuHehImBsRLsYJ6wqnnwjyfJv3gHDhqA&oe=6AF9CDB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_wM_UhBVIsQ7kNvwF0vzW8&_nc_oc=AdobvwTCCk7frz2CVUDlR5PMBACrWK8EFAWqaPg5B44fziCnme3TQZw0mAZh29DNORk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeJx8JXRJZ1kFytGk3mjpRSz0F-pt_Qs5-VZuN9F01eA&oe=6AF9D65E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0agbwhbBOtEQ7kNvwGAtgqs&_nc_oc=AdqmVdnXaHN3gL28aX2eokQw5N8x2E3nOnkbt3VaGzCgkRo9DgCtVStltfGPyyJInwo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaG6fBYuPs2cm1a0b9q85qi6TrJyBW0x7BX3V81eVqDA&oe=6AF9BA67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
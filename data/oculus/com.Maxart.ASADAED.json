uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfaadVMYPD0Q7kNvwEC9lIb&_nc_oc=AdrcmY5zw_9K2mu7CP_cddIj2VJfgjalBWIfClVEQ6QMSqmOQiMnSzgvlvqZWfWR8Bo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ojJQWQ3OWHQ5-wXyIunXsPNvO9qqisyeE1ES4bCQsZQ&oe=6A3AB2CB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lcm3dfmj3t0Q7kNvwE1Dm5r&_nc_oc=AdrS6A9vzOwNNI-fkvHQbPCRydsTwl_EfQtN3rpuFW0if7Ot3pqQSwN3XIXLEZBsb0k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XOTXSvvSWu9tPifrTLbnD47hd5Qs17c7y6IcSTMU9IA&oe=6A3A93D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzqfD-H93kIQ7kNvwFc8_7-&_nc_oc=Adpef76CCYVZadu2Sh--gM8KAYSUGz4aoOlsyGtl3J9xcA9Wss73u4AlhQTwMFhC62E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BGxjxkrPv7cvW-V3eWmT53_HvcbvxrgF7g_hfxevFFg&oe=6A3AA430"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjngebfXmSYQ7kNvwEA0hKX&_nc_oc=Adrw6GhMRmkL9tf2dw78nufsnJkeFBjjN_X0_Wp6AT-sUnI7Xk6ks3dMmJkGM-hnVdc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ga0GmOPRVyOvw4YBYhWqXv_UEImxbAnFbsMAIuGJA-Q&oe=6A3AACDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DY0Apviql7EQ7kNvwFl5Gox&_nc_oc=Adr-b00kMC8HAVvcblG58-_NYR0t0DbOoZoJZ9PD7rEiN-fqeW3fTtvQ6h7piQaDtyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ddRW3ZWll4rwHR4KFfIfpZnhT-iXEO_n4uk0uSyQ-Xw&oe=6A3A90E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
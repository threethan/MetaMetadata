uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA0CnjZmW70Q7kNvwERV0Z5&_nc_oc=AdpwKn-URcIrduO-IU32gdyuCY5bJS3gtV-JI_c_L0KKB4MPz6j-HSHanCWeGoXbW_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80G5Og6J8tQNeLZBDbiyLRSHPVJ9w3BNpsjFnC7SrVYA&oe=6A47E1CB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ITBjPypwl4Q7kNvwEYC8Dj&_nc_oc=AdqVGsOH09zGMNTm7BOCJPkadFHvMqmcWkU2-igy0wecMtHte612nN28uz-wqCmdqAc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fWoveHJVID4JtlwIaVTIRuG6H7Eb70hv5k38oPMHDrA&oe=6A47C2D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zPgRnUoLqkQ7kNvwE0d63L&_nc_oc=AdrTI0TfEwsIRWKG7lp-8A766Fc8FFLkdEzDU4jB1KxEt18JfyWeNu8uqx787edZgIo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_brt_EBXy6a0h5LgN_sXINhRwCZ0sdlC6By0lW_UlnbA&oe=6A47D330"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAyrDM40dpwQ7kNvwEchleP&_nc_oc=Adrp6nTQIKpe9QzYnEhi6L8-lXC4i2fh8m4yE0lLuk0Iw-s2YWvanlQH8X7MJpAA6V8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8E9qUBmnP6GPNGVMM6_g-QixqcvlVNc0SfGydM6-_feQ&oe=6A47DBDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yju01ezFaPgQ7kNvwFnLNfA&_nc_oc=Adp2X-iNAgiWVgWL0K4tk5AV7KAMGSgHPyJ7QkzKOvEYn9wfP1DUCnMNo0h4S-FZCZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aV5w4bsJvVShq6g3TJs2viexLXWekJv7H97E8CnbtRg&oe=6A47BFE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
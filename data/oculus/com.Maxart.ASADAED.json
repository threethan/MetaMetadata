11-1.oculuscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSEPqzixYEcQ7kNvwHJxOKi&_nc_oc=Adr3ysB7r8xUI7gGSxlKbQwTmU0kymi4d5J13ZaVvpfA0SF5baC1eKfH0wFt7RTVsq4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6lnZ9qNsH3rS1tne1VOZIbPNkqCvKsGQ2u5B0PaWqlg&oe=6A85A00B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIaQJPIWOacQ7kNvwFaEoSi&_nc_oc=AdrSxdrHVEgZBWxlQglRwoSv7umA9crUsWT4aOtHx-qAbyc29V2GWPeBLU3DbqjPMO8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1GChGgNpujcoUIdkS_KjPntASczgmdNZwDKh_to2wEg&oe=6A858111"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W5-Dv6GCJYYQ7kNvwGhiq7r&_nc_oc=AdoxDVSK3g-6BaglJT-X2zImcpJqwcCOtkd1-KJv44bfUz2omkSOFYWucjCmQynNs30&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExAQTSIOgbB2HFYqFQm21Tn6RWia6WMr50Xq7XWn2uhw&oe=6A859170"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WoIJ94NPekQ7kNvwH-JpCq&_nc_oc=AdqIxiAB4JV4oIC5K6YpEgEDw41DqkxFIqT2nE39YkNfrkus-ZZB2Etpc3i0cdOKzTE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_7IszWkQ5wSUnDhaLLf49Q4evir3_rYt2SCXLcv8o5Q&oe=6A859A1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=508Zm1WGFdMQ7kNvwFFe5iw&_nc_oc=AdpYLrxsPDQo2MZmyhjhJhUpLeNVTKhEboafvt1HDOP6yeQR_uwXrkEyewsw99yeCCc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0XdH08QxiLa2nK5dSm5nRQ_DZpWW-w2tiNy0mq6AaLg&oe=6A857E27"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_a
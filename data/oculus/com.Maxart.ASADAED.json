11-2.oculuscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-0CnkJmc-4Q7kNvwFmbORZ&_nc_oc=Adqufvkb_lFbQiP7QLQvTercN_FcB3MiydFtM_GBxa1Dd4dpBnnMY6WQraBDXboGxV0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICEsd_A6AvQVb3x8gj1ukGvw_0emiHidRL_gSyQwmM9Q&oe=6AAE7E8B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zbs5YBRJZs0Q7kNvwGZEmfe&_nc_oc=AdpXUZzpIWPcPdBMzLbSENGtTyRS-4YwGxqPaombQEv6uy5YhS3Qsze94W4tMRK5Eu0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-WGi9YGEGVaeFtWpH6BCSYCcuQHHOILxrg6dgewDUeg&oe=6AAE97D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1feyA3XYzMQ7kNvwGC3D9Y&_nc_oc=Adq2yq2KnqnAu3QGesrYDnRZoI6d5DzWAjXh5FHiICefg2MGrVM2FsoDvpMQANfiS5A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK89t4eH0csQyQiYvAambtwsJEPkTt5Rp2lZveJ9AS8Bg&oe=6AAEA830"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-LvYBciAIUQ7kNvwGADYbA&_nc_oc=AdrR1rLP77Q-zxAXlVwCOF13CNlBHGxLi3B7ccqarBs9fnMxsJ9B1l_l5XD99O1SMMc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLod9KnHWgt7ZvCnyJXwIRvv9HJ1cFO-FreitZuqt2Jg&oe=6AAEB0DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45IwzQZwGFoQ7kNvwF31rI9&_nc_oc=Ado4M5u61SEK1yLnGrYONc2zggzctNDC6QSpgKas5j2w4ZqVmnVOW8YOZTgp3iQIVo8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQjrS8md6aM7EgzG-WU9Zq1RH533d-oVj2xZiXETvLqg&oe=6AAE94E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_a
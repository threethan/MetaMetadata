uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0UZ92hGtZwQ7kNvwFXSfEq&_nc_oc=AdruoQWPaqH2FlyRZipQqhdQRnrhA_OqlwX2iO1gfTqb1ww8PWxZzSa1ek4JScQjc9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6hyGrkz1i2p_UfjCKNrSZ0kzDgMvb70ppybo0h1GwqA&oe=6A4A84CB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2bASY2wFoIQ7kNvwF9qDGb&_nc_oc=Adrnfbd-WRlOPYIMYyGj3SZEkVgElPtCrSVdDACr1aBP98c_S4j8hrSoYqL_sjmv8TQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR9dEPLdSqUSmkrGhoopsn33dgltd0ZjDf72GejvqHsA&oe=6A4A65D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2evLX97pvBMQ7kNvwH2Zk8M&_nc_oc=AdoHPeiJUJSogMa0WRCBUOxwLTNVhaZsCcD9aihhZB4VUCXaEBaI8f_BAeuY-RL1luo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhmE0gyk33F-dd8H7rIuCTFB5hH94S7xr2eSSPPLRoKg&oe=6A4A7630"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAyrDM40dpwQ7kNvwEaApjH&_nc_oc=AdriPi4WF_z44bRdHFyBC2SRUsKqd-fpVHYKCJ6oeNE3uKqWQyabO9_zjLBvVS2uBcs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNfpqag3XdAVfidmcLAQDDSWJrMdhRigUc7GzDM5fX6w&oe=6A4A7EDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yju01ezFaPgQ7kNvwGywATJ&_nc_oc=Adoxp5J0DxaJJ5u8b2tgJOjBcrEJWoThZUsJruiJLetpJvnwt3Pks9EBSxtMOB3uXwM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfkYreabXcfdCBV7rA4YMQL3Mxh80eDUk-3iUF7MP6oQ&oe=6A4A62E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
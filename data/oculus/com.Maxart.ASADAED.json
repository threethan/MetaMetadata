uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCfZB2Uco3AQ7kNvwFk3D1T&_nc_oc=AdqYdDG9YPDvzoWrL6iU8SdUXh8uRbq3Z4J85ZXzP-rwWtuqIfSYtoeQ94AwVswwGRQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxIZw4EzhiTbUC8UAnUctrgT2pwukqszRmAY6tQ0gEBA&oe=6AE8B8CB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdQNTYzXYxAQ7kNvwFc6CMt&_nc_oc=AdrxYzs2vIl2wlmORi4HkKj5miJKaofIDJm_PcKwlIf7BlFXTn4xqKBCADbT3oWEes4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdeGNAl_JWyWpsxS6K1knzW6QlqwHgN_-ndaJ8rhGmvQ&oe=6AE899D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzrgPhrvjOYQ7kNvwHemu2A&_nc_oc=AdrJmweeqeSff509uEwa9mc5GLYJ6FsADjlGbtmV8mQDgkRrtmy2ggc9oZnB2vlB-60&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVWtbmxFQRPwNZcA42FxyWLw52nVCUdRKqVHf8TDGIOg&oe=6AE8AA30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXtYViXrHP4Q7kNvwEBs0Tl&_nc_oc=Adrod0My21cHcwggMVpbN8yqxo2DCPUU4nkbTfrQPtXkVSVB4dPlPvO7FG36D8OfPN4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsXyAsm8mlskCUkJHuoUFLuiBvITe0qwBGVz6PuE9DdQ&oe=6AE8B2DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_vcBuAr4gIQ7kNvwFaiUdP&_nc_oc=AdrUeneD8rbgJIl6aOxY0b4oDR_7Oer9o8WfNVWK_1U43MyE7bHhC6c1VWfN3nn8za8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYWuPp7c3Z-7hPB1roPVMw4SdHzn5UWglLC2u8Ukk4iw&oe=6AE896E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
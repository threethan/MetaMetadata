-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Os2HQ6QaPAQ7kNvwGwUnoU&_nc_oc=AdqTRf1I9ZXtMIyMFM-ruuU9BzpSlA-CcASIewIDK1jV3jnQY1H8NaYZgqMNkPvICvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhOBH6ZRg4_s91K7qN_WuzzzGhSWfOdddRJJLZuJkn6A&oe=6A6A09D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHyhjrHR9tcQ7kNvwHR2nxm&_nc_oc=AdqIM8LKH-Zj4C6Yc0OVGLLIcYR67aIOjZdgE6Tx_q1QCG7jtzNrP-Eoe9XMg9t52LY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxv8EkDac6XmEW-VeSy52ZLBCwkRQBnhK7qYZr5OqiXg&oe=6A69E1F0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOtPU-JmKKIQ7kNvwH9W5j4&_nc_oc=Adq2iXvY6690FdmvAawFysdmPPNLpCJIeKQd7D4wCSDwDKFDzamp5ToUAGQwiXHkkng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPC9A_aL3ipmx6CV5tOmpcpEiXXi_0gqGx6EsRMrNnhg&oe=6A69EA9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grhjL5NAZaQQ7kNvwG-NsdT&_nc_oc=AdoDosUZZLg5rzP-E0ZhyiFu0accXn4Sgxk46MlSpofvk8TKujzDmoZkSHOPDfaG8pQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX_sj-gIcZvkF-nDrlnjkRUvRGF_imLksXX_4ldyteuw&oe=6A6A06E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1304100533389757"}}]}, "scheduled_o
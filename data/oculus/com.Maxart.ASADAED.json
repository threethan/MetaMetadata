uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxVpDz1HlKAQ7kNvwGczC4K&_nc_oc=AdqDnty-ayjbB0MJq8bG_JeLam0TZxCCDbiYGM3HcIzqSUzaPiygEWDp3S1ZaUyIiaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1iML0T1e3tto2R3NjASPyfm0eYyEUrEHT28N4yjsQxw&oe=6AA7E70B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY3c5gC38bQQ7kNvwFiruEe&_nc_oc=AdphnM-bIph0U0R9s2sasuXUVrf5hH1lcKLFfOephCfiMSy5uS5zjMzW8ZEJR949WNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtcv1lxFfNOVx1PBjnCzamhtjUO5UDDspyfORchJMbAg&oe=6AA80051"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bdoSXBPVSQ0Q7kNvwEnW69f&_nc_oc=AdpHtzqbA6WOlMv1q1Muj0Vq-plDcRpx53HU_g314KWkub9cDWy3AMwSX4Lf9QO9sHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_UhdzX7iYA6wgeqvDn738yGPU1mV8vpdgRtdLV4Rstg&oe=6AA810B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjvCB59gjnYQ7kNvwGyDIm9&_nc_oc=AdqLhuBMbygyr1aJAqUdPqIrpIKwoFRwfjI2yFe0jOY3S62m4umZYWrGZ0Bt6FcJBbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-hlrPmW7t6mWpEMgFBN45JofREBI7SsxnqXswmii6dw&oe=6AA8195E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngvbaw90uIAQ7kNvwGHsFqw&_nc_oc=AdpWJJhXSnGsCDw2A4_vXrGakQ-sNiAxMSE6_6-zDlcaMt_W743mfKu6JLoB0q91hqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWlkPiS8lFLvccxcX7IrjfWoEE1tAOM6Biz4U-DHyoFA&oe=6AA7FD67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVIhwjBO-A4Q7kNvwEUZcPg&_nc_oc=Adq2_aLpQIWxn0szi6r4QnGf_VEq1KKOAn3m3T7i84jG7ITqPE9UDxCI9axlf564itQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sM1D51S2NV0tHUPNwSZ9LfTPLEt7tsLHCycp8IIpd0g&oe=6A3FC08B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAOasFJ1150Q7kNvwHwa2DW&_nc_oc=Adqr1Zv_xlCKf2jY7eWghW7gFPDPu6G5ZWxIgxnlRSKgHFTlkFirnIhgbsBUTZIjeM4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j1_rrRTgPEZks0Z8J9PfPlfux2K57zgE4_qwo5zXGWQ&oe=6A3FD9D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h7YuS8EWtoQ7kNvwHsfV_W&_nc_oc=AdouoJmA8NQ1Vk1L27CUJedbNZVaNJW5MczyLAm-jBDB6xrd4JkXysXLsZdekBC2AVM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pj3aXEQ2IIxJAQ4DWPb1tLZtn3DP1isStZjLfGIsYIg&oe=6A3FEA30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uuoIOt3yEQQ7kNvwEXhLTW&_nc_oc=AdpAhJFqyR-2LIdx4Xgn-ZaNGLrH1G4Mog1EVNgIQK9gg6BZZk6v1T8Pak38i6_oeRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UJKQ-xKTxqTAiLcaKnOzfcWha39rD_SHToN204DEjTg&oe=6A3FF2DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO6CmnUECOwQ7kNvwHnu0Zl&_nc_oc=AdogVn1CDMAwV-NKKMYdgfGu1oC_dAH_4es1s9JYUeqg_tBEPFane1c9I5ruyIMi8q4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ovrr7kgvgXW7co550YLvkux098xGxlE85ADS9I3FSKg&oe=6A3FD6E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
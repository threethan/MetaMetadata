uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgQzlSkOiAYQ7kNvwGh0fQR&_nc_oc=AdrxZo9V6o3VGGWWqBsjTV4wPTV9BWQ6cfXmUv7vdyBHfCUcbrDpb0duUinAQygz584&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqUoJ_QimayrZVlO2O4eUrW-PuV0h56PxOrV0Dqh0Abg&oe=6A65FC0B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_i8dofLEh4Q7kNvwH5jhOK&_nc_oc=AdogxoKKssbsIfOnyknMVBZNPIDeSFVtdq32m_mEd1dUd2st4E6HHpqZGarQDTW06qM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-WDRlacvSbL_vyBtOL2SSS7SZ9o2a00a2yzYrnZyGHw&oe=6A661551"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R61QXIit0EgQ7kNvwEGSF3I&_nc_oc=AdqspTXcz1D6u0mdFBc12oObG1BDv-op_CrIKpxmKMHXIcBAiDXgC3aiDnVjlTHdHI0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB33I7P8OlUUi6wbQvXKytz90eiSxG3uO3OVjo5jxP1bA&oe=6A6625B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcKhFE8f8F8Q7kNvwEpWcPW&_nc_oc=AdqC_I7vZfwtD-_BQYA7Kl_Mg0_WgKo-vy_GQlc32AAmJOqg8mXGbMeYq8c5011Lt-U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfZU0ZUWSd99np0m_qJYQt_Mf1w8Lp2qwXAKfwGTsmFQ&oe=6A65F61E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eTB_3jDonoQ7kNvwHWbbxc&_nc_oc=AdqeAMh5ncaAxs9PJe2eWiRZG4xFgdognu-fP3-CNfBm0IbAcEhxx92fEGqLM4jyd5M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFCb2kD1KHvMCupxEc5laQG0IVsJUhLc4LI5dIkXGkrg&oe=6A661267"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
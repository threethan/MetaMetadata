uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxwAiWOpvSEQ7kNvwESCCXa&_nc_oc=Adql9gufxG21iQx_u5oSUDzAVPdwI-Vcz5QeJqjLf-zfKZvqt_zk2fU_k-d0H-dwj5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8kWZPJpTnfDfM__7MG2mp5SU3OOCjnAVDceHupIMH5w&oe=6A50E40B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FEButO34ZAQ7kNvwGqXomX&_nc_oc=AdovGbwCzJFG_6pa36xPuchtinjiJnQO71twbzaOmaDtJQfhtwsBoUhnTQRyQNyao0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcqkCfIkPVukw5g-HUG00A9bfUYCvB9V9Htp17DvC16Q&oe=6A50FD51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiq5240BCssQ7kNvwHFwJZP&_nc_oc=AdoSMN5p5ys2KZxMEW635FQ3O-3PzPDqPfeu1JF5wN-cMYBKyXQaY3P25gHDdPYY8OY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBybws469lCAEc2lE8M5gHseUv7Y6ShFFpQKKeomuiTA&oe=6A510DB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Brka8vpzPfcQ7kNvwFdPn55&_nc_oc=AdpSBuoh1xyoU6DN8kHRkpk5M187VzfHu9q78DUdSgOpLWSGMjzxQ4S6FLFGt2wXcEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtLIhNsWlsDd8wtWkLlmpGMRZyvBGa3wpFi-V1EAjoTA&oe=6A51165E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHx8qu8WrW8Q7kNvwFOb_hi&_nc_oc=Adq8H-KZxMDE_vuezjzhHqIAKFPUCeDZ1s4fi_rpRQ0Q0qmX0fZvCqBICWxK5xSdrxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjIuOWvQTYW6Ke7gkQRpx9z1EFWg2YKBnksLsqnhIfDg&oe=6A50FA67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
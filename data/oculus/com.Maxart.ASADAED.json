uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgrgNS4gjB8Q7kNvwGtT5hE&_nc_oc=AdqHF_al0-wnNeGrqPSNtqC7Ejkt3FnOxS1fDHd8SLbVQbEdh5k1Udx2-WPzrLjXFrs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9ryh2ZX1UqpWYODpwL73Lc3Uvgoa9yORQ4WL3D_a_qA&oe=6A5A1E8B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrS5Brt3jv0Q7kNvwG2DPiF&_nc_oc=AdrVQYPF0wVLCLwV-4-fE5sHJVyw5fggFDwjN-DYCD5ZJG7Hz2vDbMoI3ErdwnQPsOI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQRM76Rg3Wnu7PlOaZzxA7wAWO6R0NBZRCOwTKdG-5vA&oe=6A5A37D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb8fazFmatIQ7kNvwHsnzsa&_nc_oc=Adp7_ySBWASsqXucMZk_089icB24GNYWXaB9X5dMOHzxj1b-wIFZ1mBO7Ug8ZHvc-ng&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzdi4dZ2j_93y4ZFi3CMWdDsNcUek-txpZZfw72lKzTw&oe=6A5A4830"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q8wtsJjeJ9AQ7kNvwEjlS-Q&_nc_oc=AdoUkEbGrCRuVpmN975jK9dq-M1bV6xfgCRpZwKo56RNASTkw6OhOTFdInSYr8nVIHs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfZ81itWq06uYytMrQjYK4mPLopp9VsSh35kRB200VaA&oe=6A5A189E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMMTZO_2FJYQ7kNvwH-VXns&_nc_oc=AdoDaEH3i5BMvA6QzfTKzvac-3-oaOa3L9YTAy8-hY9pLa4hB3evclpR_kWKiSM1Lps&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwckAgTTJxv6A1POwBHqc0CYj723taSJyw3Z5XhC3E3Q&oe=6A5A34E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
11-2.oculuscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idOFXY4IMNkQ7kNvwECJyJX&_nc_oc=AdpWtnU9umktTJeEWutd5aakCeumEW_IIDHYUyetkzAZiZQzf-AlKRv7_TxpBb3jJxU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt3HeA-9TGufWPyj1CLiQ9mDLlEF-AAFygPfyJhhzxIg&oe=6AA3F28B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvUFn0qWkaUQ7kNvwENXw4n&_nc_oc=AdqYTUqGQx0CUY_mwW7pJ5wY3WVA-WuthFS5Bh9oQatU6fLn6b_ddx096h75KNkGuAw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV_7ZXPMDnTwtoVOwWdeqKtZDMdZDWJxxQ7M4cLONNiQ&oe=6AA40BD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFcjJU3BQxsQ7kNvwGsWf78&_nc_oc=Ado_x3qjEbHRjWFxq3iuWw4m3HxcpX5YOgc2VR4v8fqVCKMg2IPZ8gznQ6ZY71UHk7o&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYgbwMkx6TR08fnU43yItYiOkyuiA012uW9MqGU60HiA&oe=6AA41C30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S66GiJxd0VQQ7kNvwEGAe9r&_nc_oc=AdotYVlgU35zPZwTm4u30Qp1G2GZUgEbhYp64hw9wvJgi37wu5pqcoCZY4eXxpSA13I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIKOks3XUG2jRJ4Hn27MGwG1bX-FJiT_3fCeaCK6eQRQ&oe=6AA3EC9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN6yPnf6BXYQ7kNvwG7KIMN&_nc_oc=AdplYcYEuQhcGyZ7YYp2gY43Ex8oNB7Mgk9-uhLOvOj2RSWySUCNwWeJJYKLA1atPEU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb_fafp8ZmVF2jJMLZV8BjgLc4vwu7QYVCa2eywdMW6Q&oe=6AA408E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_a
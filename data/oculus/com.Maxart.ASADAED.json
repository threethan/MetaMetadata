uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YbgjMIU3hoQ7kNvwFKxEAy&_nc_oc=AdqcczRBaw3cEGRzu441ACjHWTHrH-DdmZeT0MW5gWkjXS5gYLHuOKdOXCjsPnTdNwU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATCYT1l-BSI_1jrbcPkKuqZw4mme__3JM-eZxRK0OM9g&oe=6A6C938B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Os2HQ6QaPAQ7kNvwE5t9go&_nc_oc=AdrwYoh8OY8MuMSB0_icZebCx9knu1HORRCIhCkUS2IA1kYj1NzmeqRUjIyw9DJpGdY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCascXkrdFFkQRopfMxaIivQ9Hcoac1mN0wBqk5t9Fp8A&oe=6A6CACD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpITMYbcleMQ7kNvwGM0qHh&_nc_oc=Adqoekfs7PuVXSwU1MCkwWhoyLp9q98TmpMf96VIkmIIJEm_92Gg3fItSekBi4A6wK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwzBVt2JCHHKI_6d-yZWOi5hMaVYjnKNWQKycga4BU_g&oe=6A6CBD30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIwyp0QJ4joQ7kNvwGRQGkB&_nc_oc=AdpiqGu-Gv2eVy2SLFyOROFwQgAp7tDFMFWYjkuCfTh4UUFM-krnGrbx4ABxfQ17DQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqXWIoSDTsi7XN0oT3BD8V_Zj8w-xpi53-9awXymHw7w&oe=6A6C8D9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBclh4i3JwcQ7kNvwEjTB6w&_nc_oc=AdqPmS5FEWoq4f-0AjPFmTVbPv2VtZ882yhXtdp7mi57L0giy5HeK7cLizVy5GCXPTw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHX7bNzjLP8jB-QWrkFrFP57xSqAPXCRVf5SoDo0VpSA&oe=6A6CA9E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
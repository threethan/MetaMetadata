uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyun2ES-xc8Q7kNvwHZA7gA&_nc_oc=AdrahFUzZ-04MGodIMOjf2xRdaYvWlmvXby0IBE6dm8f585E8qYGnLTudAPVIC0QxqA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqpIdfpprvGcl2INJvXyZFYWhQanxObIeX3pAayvvatw&oe=6A88430B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIaQJPIWOacQ7kNvwGqPTRs&_nc_oc=AdrangEE__5NDECNKkt67n6VuwzCiL66pjiKtec-sk8PjvCO5t5O-QaAVZb_EpvIsBk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdYliGIjLdbYeNrdicYZ2XTl1iec0POwCG1CXYUyBaxg&oe=6A882411"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDfQvWN-q40Q7kNvwGNCFp9&_nc_oc=AdrfY7q3Lw08qoB2ohBlgOiWti-s5lqjjURkw02E0XE-YasMk8LOR60Y3K12aEP99R0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA4cPEsc_zG7J2YynLokMTESqYr8Q5qqADK4ap_Y23bw&oe=6A883470"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEU5b1ZxDcQQ7kNvwETg_b5&_nc_oc=AdorgFXjopvGitxUlqQa0tr6j7zuYjkuit1CHL7YajwaKIsEDOv2ZuWR-7ue95v1kos&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHxo9qZy5zeAiPHpQP6DU_LKsoS92gK6tCV4a9sXvCyQ&oe=6A883D1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67mIWD2IZY4Q7kNvwGvdWDW&_nc_oc=AdrnvJUBSPA-yILREbSLMciRMZDpnYTHGXspVR5Gvu40Tph5hami-7EUZP7pJxU1ltg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo_br3dpiHN1qEugFTWxST3LoyMnIHetj-r-QB4-TwHg&oe=6A882127"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6He7_Jzrj4Q7kNvwGd6fXV&_nc_oc=AdroN7uUT5u7wwvK9HVQ5gJRkX6LlkYD6yhK4_9GCFN1z0Q-yj0t-EQiwQfYX3Tl-dI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDogJVSfAd54NtfnopsUuCDZk6FWtRPn8XfCDUtb_uGSA&oe=6A4CEF8B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2bASY2wFoIQ7kNvwHbu0Jz&_nc_oc=AdrykiQb8gZtKDhI81aRQKNxrL30OeYihqXTxR-seagxK_Qr7XZ82jgt4ZH_N3i4ccs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0fgIiRGE1kGzNAJP6nEo4D3DhkGUJoVPvayuRtH5GUg&oe=6A4D08D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx7jrwzK1tcQ7kNvwGbIDIo&_nc_oc=Adr1ATPRMy6HCwQE4joktcp6lt3Onwdw1dJ_npTbIMphp0BJPFImf5SPpim1En6TR8E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB40susFikjFLsNoRCvMdiye5Jg632Y69lOI6miN84Jkw&oe=6A4D1930"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkQuGsbAQgIQ7kNvwG2Ivou&_nc_oc=AdrgsUaY2QsV75K_j4pdQoi672Sl-NB3clB_VgIDJqgFfkAzvMfzqvfr-_TvTfrPV40&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgCa6h_IiBaWWIO6EXSP1OwO8lVvdPb4A62RBHv0iAOQ&oe=6A4CE99E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0N_KUQXFM4Q7kNvwHLryjq&_nc_oc=AdrtyuiB1WIj9JtGnbgKjMHfw7D2paIdpdTTC0eZDoOuGXdsI86t-nF-_GS2_1X0nug&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSnVd1rYMjxsMfz0PuTbqtwd_YGKN7Z2j_rKjAaRIpaA&oe=6A4D05E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
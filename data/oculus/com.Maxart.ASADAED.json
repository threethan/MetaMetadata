uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfaadVMYPD0Q7kNvwGt_buw&_nc_oc=Adpf0-gJPlOzsAs7fUfOx4afG2Hrd4477jqGSfd4sQ8RlEgRcxQQ9GVNhK-98V7Ugqk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S_dRI80KB36ezjCzE5Eb9tzNIGnespTyghhY_FFpeNg&oe=6A3BCC0B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lcm3dfmj3t0Q7kNvwEW4z4D&_nc_oc=AdoWyvwbdkdZhOz1Y-UdYlmQkKUKyiEyCCyw-9Xm7g0QxKs0Fq_5B0L-zDG-MAhIuaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vMPrAfNGGWBpa3FYSkGXcbjy8JCbdULz0qzgfc_ViNw&oe=6A3BE551"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzqfD-H93kIQ7kNvwEKRQjd&_nc_oc=AdpitTpPDF1nn8Y9Vpgt8guFqWvyPU3ffhRYUNPkiSy5DyuqwJVHwY_vDmawZ5jP20g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CD6OS7DPoLqbOKH3DgEAYs7ROc0iSRfSncqULDwxdUA&oe=6A3BF5B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIMk2_rM5rUQ7kNvwEXxIHE&_nc_oc=AdofT3qP5CbFyXURTLM6Sp120dtBk3fwywQu4vVFBNzL0KKqObrvPSs0aMQuS1tHTZE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wz9wg8QXFsky3NVO3P0r_kI8xn5Mg7YGTVx9oBRmnng&oe=6A3BFE5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jo9k_-wfI4sQ7kNvwG42sZO&_nc_oc=AdrR2qA8KO0tdbnl7m4kN3xjhwFsTPCFJRPtmmMARU0XvztERS6nUns_xgR9579iWfo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84oRwnU8LIo6IKJDHEdLdabK6vEnYGaG28l-IffTHSEA&oe=6A3BE267"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
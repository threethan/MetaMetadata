uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDK2F66AvdsQ7kNvwGMbZqG&_nc_oc=AdoO3qWn6GkEAb73nGinEhpNT27NxQaaftiD8sKxZQYjwNv4yzPCA9QnN2dGEyd_dMY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBeVYy1aYwTGdi-xozU4OKtPw9OQc6PsUwHEXWynvsOw&oe=6AECAD4B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz_Dizx549AQ7kNvwFSbkd8&_nc_oc=AdqOn3i4mmld9Osm8vpxMQ6c-sdU28lCiHfvBwBtWJuo5BlEaGfU5ZwCkGRwGjI2X8E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSJmzb7mDgpal_2jWh2KwcQl8HAm7Z-elidMbSpaR4rg&oe=6AEC8E51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0ql8ynjkCcQ7kNvwHDtsvQ&_nc_oc=Adp1gfyXdRg_yQoo3v3q4nejGAUYPXvGtiEWA66tns4Ko3I-4USzc6b9OO7wfU_2rGA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUXLAeG-O83F5s-F0a9IxaoPCMJtOhAPA_gqL-EVC0YQ&oe=6AEC9EB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Td6wNLJ3koQ7kNvwG7hcqD&_nc_oc=AdrIZb5IuKwtA82YkCHGQ-V7kfcN8MvfBTEA4X9A7ih1kU5J3vUo2KOst3NDku8hOrU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS-wWEFchyhvvM2Wy7ETEjL1np4-ZPfa-IgY3tvBQjLQ&oe=6AECA75E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BswFxWVYOAgQ7kNvwFyxIhy&_nc_oc=AdpkoQqMrDxrKJs5yTDfaD9LC2NdQ7Ry1t7P-2_DuKaDYPZ0l_hFjjNIajnAfcZ2Z48&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA3kbN8ZHVksrnVjeK1LFBQdNXkDV0pKEL_gT32HzThg&oe=6AEC8B67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
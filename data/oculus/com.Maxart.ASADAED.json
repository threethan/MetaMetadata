uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC3L3NwiwtgQ7kNvwE2m__U&_nc_oc=AdrDU4crqzQpXVS_HGZhkaIPpUPgKIYduAN5g3yTlWtM3muVNZeTLXfsW3MpbfiOZTA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENnQd9obfiph6u-8jhz1O0pjau8ZATxuEbNQ7OQI7Y2w&oe=6A92CF0B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYMmMERC2S4Q7kNvwGc2tNK&_nc_oc=Adr-TrsOu_lQW-vEA0SO3Y6Jax8m9b8yumvNoWc9Rgb-OC0hPQ_V06Fke9t8lEzG29M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc_KD_P7jmPiuIsDhgrve9QprPU975IcZE2ZYxn6j_8w&oe=6A92B011"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIgEtgTPyyUQ7kNvwEHB-QT&_nc_oc=AdpFQs7HPBrRxlXVFfAiAtf7DGBqck10HQklvGzZnvClRRtBWGTYD1wN5pdtJb8-i_g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHotGMACsr3tuzYW2C-IH6lJlYLqT-F9CLutL5ODlwYIQ&oe=6A92C070"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EyXiqF7uqEQ7kNvwEbutOd&_nc_oc=AdrHZepofPapTotLw0mx5ZodzNNWQ360AZ3nU60Jpwzp1-LgX9p37O0LxImjg2Yja2A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET9dvDxDN-ZMyGgZGKChJxjx8HO_vLNtZaJ6IZz88ZAw&oe=6A92C91E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6teLvgYHVoQ7kNvwEUfoVK&_nc_oc=Adroe_bz14D5jZOV1u6chd5CgATkfJhFZ6aNDvXe47bxb94qaSnEt59XhRLbzGu7Ex4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXkWNNrD2kkjiweIKWcMQyOIYxOFz0_spMm6Kx0D4rDg&oe=6A92AD27"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
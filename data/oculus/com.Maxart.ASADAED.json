uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC3L3NwiwtgQ7kNvwHVWWsv&_nc_oc=AdqEOfLHJP8gpshpxAyVXXX1fNYLfr6EbYxv5rLgBSVF-g_6xN8S5I34eLOrcVTSgRw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7GvEasufZtRa3uueMvAIJ7wHa57wAl2caIuoq2rYx4w&oe=6A917D8B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYMmMERC2S4Q7kNvwHJ2Llp&_nc_oc=AdrLQFOnwsPVrUOD4Ylkb4pDvuCjne6QM0GsrO5NAhcm2H6cgDr64EFZP9UX2UXxxjo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE0RB3sYohyuNXj7su0SnXBSSkwB09R1N1Wz1Cbk3JfA&oe=6A915E91"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIgEtgTPyyUQ7kNvwGPFCZQ&_nc_oc=AdrdE6arMFWCaymA__AKiO4moajj0r1TbRP1HPj82HOVWsbGjDFgpIRlDqw8W5CW8cU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5X9qwFF6gypkMHiRwrDhbQU7oDQOflweenT8-5m8NbA&oe=6A916EF0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZFhoLo0yckQ7kNvwGULSly&_nc_oc=AdpLQhxhEbqXTqBPhOdAEz-Hs3DEYya2SICU0qIXjkYdhET8ZSzt0p1CNwxIPeXH5Po&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4xGCpO9ixtpeVTNh6NjOt3KchyZ4bkuZkXj23I6CZtw&oe=6A91779E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfXIQbYPzlQQ7kNvwGDmG8Z&_nc_oc=Adr_mt_C7tL1n-NyVfoIVEVbYrOb43tXPte9op9cF95S7WhaLYr5y9OoVzZor3bDIFQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgAAGY56hmkqtcpAHdlNPHof3k7eAAA3tTCmeZ0I-mSg&oe=6A915BA7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
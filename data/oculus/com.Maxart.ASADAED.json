uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCfZB2Uco3AQ7kNvwG8LN8H&_nc_oc=AdouC1hH7W40lP15-6oTd6vn-vO2kGOFjxvqcDlBs8xwNCi5-w5HIfq2qND4U2UgrxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFb_mYaGj8h2xdOO7xkpoE3znvTpW7tOFnt5bSlj7fGQ&oe=6AEA0A4B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdQNTYzXYxAQ7kNvwHVz2-a&_nc_oc=AdrhpPelFij4-itl5-ivXPak_soTdPuENQp7aLc_iwHCgJSzMtyTtT2ODZX1Itwbd9E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-hmo5lL2fpf2qKcfFkVMVMQ0IaDFUFK5SAmfrSA8K6A&oe=6AE9EB51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzrgPhrvjOYQ7kNvwFqltMD&_nc_oc=AdqKBh6Kwc75QSu2-7iHa1zesG_CjS8sCjRHn3R4Au5FP2ifPYIKDWB-R5yFzduTGLo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpk0dSDujIAg35CycP_v7AxnzqI4Q3xdHgUZmssHtrLw&oe=6AE9FBB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Td6wNLJ3koQ7kNvwG6It8b&_nc_oc=AdoNgMMwF1mF5mKgIfJGO5jSugbpXohnSKJH6z1iUddMfO5LkxXjsoRk2k3jiRTLe7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH4aGoW8aJ__DlIyq3Vy5mwsC7XV3rN5sw7n5NkiDDxA&oe=6AEA045E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BswFxWVYOAgQ7kNvwFtlJcH&_nc_oc=Adp0zanXmoQAu3zdY86p71ecy9RRoIgRKGeCt-fFTgoBj-jXQ1x91Jn9adtEREXJyFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1YHcaj4KaNGsnJOfLUnqGYZIA1wxnfUZjrSjNzOZpoA&oe=6AE9E867"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
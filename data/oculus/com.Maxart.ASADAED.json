-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrMEF8WWtgIQ7kNvwHi4gA8&_nc_oc=AdqSyU1hYfW-zYrdm0_It5wFd2Z8s0dslepjJFVbS58tCg6WIgl9DoPdTGEf64Fd8Kg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv2B-D3R9DffefIZQhoWismmSijpLSeZOTd48iZrX_gw&oe=6AF082D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKXjVaILgVYQ7kNvwHCF-Ji&_nc_oc=Adr9rX55076k3ac3FZ6QI0XIqvJDZwRvyCkGosGLjjKJqF05Stc8mTDu00nzHnNii4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeCAiJFDGby8okIdTKSmvi5USx3Ao7NPTSo19e98fEqA&oe=6AF09330"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdgYgqW4MDEQ7kNvwHasXwc&_nc_oc=AdqKrSTDtOKKkeCJM5A1QU8xK43zueNeJIwO4IfgnVEGajMTRSbirvMulheRA9n9arw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQurfiPWIXMM_b6Pz9AQqlBd6uJdGHLn8rWYvvs933PHw&oe=6AF09BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZjruTfhgkEQ7kNvwFbwUma&_nc_oc=AdpQBbyN9-LFj9i-5S60zoxc8AQ6oNdXMUCxvq-pS8Ijgm4IbEXMAL3LFBmJ48wdOHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTccISIsncO04yfttQP9sWOcS6LTnL1xkvXASp_T_QS0g&oe=6AF07FE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1304100533389757"}}]}, "scheduled_o
-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMdVrCdgvq0Q7kNvwFzZzMD&_nc_oc=Adqwtha8uCwtClfOm0zrCo8dxW49_6I30UuG595vPaq9_jvMiEPCvfopBrrAj9L2Unw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS3PzJJt4veFR5SaUueJEoXGixIuVZhSBrTPkZPrW4kA&oe=6AE4A551"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6so4_YyKMqoQ7kNvwErqFKI&_nc_oc=AdpsVMLxSocynl-bstqizOWO2XozTe-osDNao7xxMb4SqbTks0Maw0FLx34KxqzAz64&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM2NOYY1AVBHst168IDHV4QtVA8eFkqvrD4U4_nU8POQ&oe=6AE4B5B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LSH20QdNMIQ7kNvwFyl8uI&_nc_oc=AdouEFB4jjiJHI1FYrDRTyI4kn8H_AH1AbTEBIVsB8qySKLwLwwvyAgNERIAK4FxIh4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEd2zdtP_J540GUBHQUVhfKp1d7M2T8IOPgL_porEHUA&oe=6AE4BE5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svE5bqIMUHgQ7kNvwF03Nut&_nc_oc=AdqtDnY5mz8YtYG_B4_UjcJBb0rg4VJTJ91JQoCK01NQsa3N1axcouNMCxhHeh_oF-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwpZk8FKdghLKw_QXGcuqmvigG8nNSPBSoxJAsBQd4_w&oe=6AE4A267"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1304100533389757"}}]}, "scheduled_o
11-2.oculuscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA0CnjZmW70Q7kNvwHWqFVE&_nc_oc=AdqEFVo6GJYIZmd1edgL1IdJdgU8WO_vumosXQozCxuJjnpK8JC_7Fag-Ubfg79M06Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tCIPgRRU4_HLLp21P-ybZpwctO0u8QAL-GO2W047t7A&oe=6A46904B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ITBjPypwl4Q7kNvwE10sDZ&_nc_oc=AdppPVBNCV02jfgSJ8_wHl0EbLYqh_Ys_AIQy_fl1n1Tr4dHp0E6HoUgXGpe7NLR3eQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7gMIrCebBRcsRF7WOD3VYwsN9dKR3mDtfwOGH9plQVA&oe=6A467151"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zPgRnUoLqkQ7kNvwEbGP1k&_nc_oc=Adp1WqixsMCjc7yB0DhKjABF4MVAox61rdmjFqf5Ea7U0NIPi_jc8lqXBZXTC-4oY4c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ij6Hn8GWpGIl8lPDnmOIl_Odto_GcmQa3_1oCgL7mrg&oe=6A4681B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ifu0HaPF5rUQ7kNvwGAmas2&_nc_oc=AdqKcxr9c6dnL5OihS-kk_0C73uTPs5fjTehf0tLaPrBii3KiqCdJRzddacQgUCYDlY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8OYMK0NV_dGIQ1RNrmTLUlVM30PkZ1346GICt5bpNaw&oe=6A468A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFK-cc0IGn8Q7kNvwFhJHLW&_nc_oc=AdoEPXxlMDNJuhySoMtZcHlgoRfX_BAdx5IQ9CVMHsqikrZoYrgKVMNOl9y4jEWkrpw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84uO0qDGBKKZ-inH_pZyW7dwkAitAC1J4FXEGGsuQkLA&oe=6A466E67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_a
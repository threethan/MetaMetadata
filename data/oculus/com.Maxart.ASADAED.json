uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ClNORyeuhUQ7kNvwGViP_7&_nc_oc=AdoLbJBI6TH56J8Ezv_QoSN3lN92AJKw6kU5Mvl9nUHmhiHc3dbfVQAV-cJar0uZb7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbrAM_v6NDWi3OBSob59iWy3OHKp5tmf2o5xdu4BV1pg&oe=6AB3C48B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60y-IHGzT_sQ7kNvwE83TYU&_nc_oc=Adrjvsnle_faZHbg5MjZB5HYwYaM1mGzCdCMbq7gNBxMV5QErJkdkZD3VAZscH5tyL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5xZqMN-EAjKUWslKRc5NwCJc2x7ODzOigMyBoibkntQ&oe=6AB3DDD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20p1nrWJAFcQ7kNvwE5JkXD&_nc_oc=AdrvE_2ksz28Z8eISOP-T0vDABGj6v9pvbolRFQWbFs00BZQs15HHaODymG-2pCYp3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmQr4-yu5vKDOoABZ43XFHWARPpu0ysBsh2_r_OQR-UQ&oe=6AB3EE30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twduPhTqTS4Q7kNvwFxgYsH&_nc_oc=Adq-rkR4FcPPGh8SRWlArM2a3DEgFGYMSJtzPkjxNzZNSdfdAN4EjgYst0kBgQ4FklU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcCe6LfW-ponciAtqw_r6CV_giknorBvQamr8hK5eHRQ&oe=6AB3F6DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZuabtesYDoQ7kNvwEFxxrb&_nc_oc=AdoEETI9ThAS7-4VQwQFI-lAIo5iFl1kKEKMWDecgJoM2ZRZwJ_D0E0pZD_2Bwc-PPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ7Yolw1VcqWapJg4syltcFcfFLFHBjdVir-iGwISRiQ&oe=6AB3DAE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
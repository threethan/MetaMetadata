uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIzMC-4gYI8Q7kNvwGMiAHk&_nc_oc=AdoQp35-8PIFdJVWO3NCVtY4QUOZ-EUtB1WSk17v2Ge3Uk1HoObnDlyJvQkD3USNs2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh7l52SZNjJ8jaKj8nR75r7ch5Xluzdwbm6pqJAcRdwQ&oe=6A9C41CB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qZpNuNU37EQ7kNvwFRwcOC&_nc_oc=AdpaHOvpX8jxndj_U-p9EBsLuhR25kMKb4dC4ARpRlkPR1_9ieFRQNTrNYBpAiidqYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLok58AwjEjepjfKSsc7qNlf5FjQQ5dhPgHWXgj8owF9Q&oe=6A9C22D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7WI4VF2rl0Q7kNvwEwy9DY&_nc_oc=Adokn_OPL6lozIgZgRVnLUUjBsvxjofXman0dWA_IufJ_poWnqGCuGs7B_6TtYaHu9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd4cPj8yVdLHJo4r3018fK7ifvS37SI9MzktfAciWnyA&oe=6A9C3330"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5v5_-os-AwQ7kNvwHbptdq&_nc_oc=AdphCbTnUkvBBybcrh37WlRraHXQwicn73D21R-R2CJu6kwykKlrUfx_NpdRT_o1X-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu5NZm97N4QPm6BBn6HmmIxldBlux3f35EdmyrnqAXzA&oe=6A9C3BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2jZzqHtoZYQ7kNvwHC3HQr&_nc_oc=AdqCFbzqNL0r1VHWHk5alS4bHN1lz5VS4MWffRVv7VzmzPVE3UOeitqmXTySRoRyQNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4Zgd4BnkDh2YC1i_ilEMj58uwcKvB9NNf9DBTysFOUw&oe=6A9C1FE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
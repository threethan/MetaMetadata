uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fWztqHf2jIQ7kNvwGKVzDw&_nc_oc=AdpTKVGpVbjtnU9Dlv_zeDdFljpk_ypqM-4oRRFDLY30NOYko_5oz8NeZ1WlRzcHrgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1Q_UTKvjwQdZr6kpGEBkLYlPhZStCRYl3gdbIjcnFtQ&oe=6AD24F4B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls3lccgLTCcQ7kNvwEci5l9&_nc_oc=Adog0N17_XBr31vPSCJ8saZbwpeRyIPA3icyFsd_d8PXN22RXkn1XPD63kZ17VRVlqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuMO7r2eXSZ9T8BXDwrlqvWga3gf2TJtzLxDBWE11fcA&oe=6AD23051"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c7K0OR_LCcQ7kNvwG_Puyx&_nc_oc=AdpEveVv3hbmUIi8mc9OMjs75pJEunhmFToDfFj-ah6vdcth_QYy2PupAFzRvmgOZfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXlUa8GMmB2GM5ZfzsM96zzldFQUXXnnxx13uaIr-tUg&oe=6AD240B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6aNM6UgfGoQ7kNvwE4xcjM&_nc_oc=AdrUB5IpVjX9lyJLVuK4gOeUjaRhdJxMcYbhLzwTHEe-__HJ6LV592rAfF2IiX_8H3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBdsm_tuKt-RpxppqbZGj61UFbYiqy95y5vIUVEZiTIA&oe=6AD2495E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tyq9AQSfIP0Q7kNvwHa59gC&_nc_oc=AdoGJ3S9Xe-6k3NA9PvWwzhgtbK6j5vdvRY7NgL_FgSYvTQ5C4K5XI6SjHWhpbW12J4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF3o_9pd_2zhVxciIWdos1w7Hxh4e1J0a4Xs_QUq5RvA&oe=6AD22D67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSVdRO3X7b8Q7kNvwHDd44p&_nc_oc=AdqGVUSm1jeWp125gYYBJOMzyWvwD9kF9iZvSd6kcvWDtiLNeujDgE9-DOpzU8jk-WY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-18_GUmn1KLbTHtz5XoHqPmZtePL8g2TlL4XC2XRDEw&oe=6AC27D4B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY9GTLFPS0UQ7kNvwGQz6ik&_nc_oc=Adr7D8lr5uQMD2Iy3giu2vDGJE51W-nXROq3Jx4diK1iuiwsSPWsNFy0fXsFFKB-r-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWKWUaHn_S73jx0fKi5ZD1N6iz_lhLfLyPMPZL4dJZMg&oe=6AC25E51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7C5sjequ94oQ7kNvwH3_Q3q&_nc_oc=AdqN4Xlm1KBitUASBMHbh31-Md6HOmEgzOwF4I79uj8HTZNFESROw6O0rfaM-ZOLoj0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM83JakSSRKr5jpAG4yGVOPNXhsgHP2-G7AnLMUv3kezQ&oe=6AC26EB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsa01v6BNrUQ7kNvwGPBVb_&_nc_oc=Ado_Aun7P-gXvX1YhtcGYpfE4Ek66jJ3ZuH8GK6QDaEkJ8k57zneTkuiwjsn1AMP7ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN14oJUhCFkj2KhOvIeC30k2KOiaX8-H3GCSLyAB7juZw&oe=6AC2775E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPfwKzuka5QQ7kNvwGrRzLk&_nc_oc=AdpEaOABOaOsoH1nQTA81OGEwqIsInxaL-AJOdrOPDd__VQiUVKgeCRs572yR9zGZCk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-jP8lIdsYodVBJIpbEbVzWUg4NyThTm0OwRYcokeVfQ&oe=6AC25B67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
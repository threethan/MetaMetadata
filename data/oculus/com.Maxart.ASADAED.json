uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7UZ4tPJusMQ7kNvwG3qK8O&_nc_oc=AdpV2KMEF0JsLFszAxWPHd5_av0fWEUnaC2Nv7uGZHeJ4Dsb5uHtEYTcODtXvrPEdIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OAuLDUWXICf6ZOvTQubUzFW646Zb-mmaRELJ6XhAZkg&oe=6A356CCB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kIuR0ggo6oQ7kNvwG5VnQU&_nc_oc=AdqPIS-QrIPZhJMy4B44TcHJ4JoNbfc5t2v4g_Vo1QJC5wH2V0zljyvu505dPanGgsw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SYTKbP-j2UVk-ln-CQCC39m1iLGndy0Kf6XcI_y0kSQ&oe=6A354DD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8vvuxNHWgAQ7kNvwEMGhNj&_nc_oc=AdpSgj9SbxOHLglgC3-4vA5nr_TqfkzVfqzKVyI1QSFKSgoL8bYDZNal08esAxIfdCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RI_Gy_fjlRPH3u4aDX6f5fdBkVzJIt70NpClk0XgGQw&oe=6A355E30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgA9KHLIR-UQ7kNvwG0v5jB&_nc_oc=Adq1KB0nKdJqUPOWuv_a9Ej2jrhfsnSSOawwgobpj9RN8_O1Yx5fHoC_MGk19bD2Li4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JPuK9wZTji_rJZ6BfNR0mFvL9lbuNBKXBn5UILReM9w&oe=6A3566DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiHW_ufUc-8Q7kNvwEmtL1x&_nc_oc=AdobWqhAdUpce8Qc-llgnkFKg5n_FkR_5JjK0HwAlVx3XF2PCnHrZGVKlq9fMWKJDBQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A3odZ1caJJCa8qW-uiRaYvDmvFxxm0ffxX78GgpyN_Q&oe=6A354AE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
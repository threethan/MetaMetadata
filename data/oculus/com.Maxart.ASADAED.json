uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-0CnkJmc-4Q7kNvwFZ0XLc&_nc_oc=AdpdS4IRtL8mlMcHuQVnhDlfBxC0UM3T2UceH1ql3I8bQXTo8Smx5wBuJ1Orq8MqVBE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJJr6wNfhEikzD77mdeio2lY0XPmGyy0DEIppJIGD3Nw&oe=6AAD2D0B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zbs5YBRJZs0Q7kNvwHzHbD_&_nc_oc=AdqTD3huAt4bwTNzsSwVZXf85wrOOwWvq0ntQh8b2S1Kg8fJN_MHametqEM3laLQ9ig&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSiez8Tn1N2WwtO7aF-QpXgwphWOzpUUV9HCmBiWjnoQ&oe=6AAD4651"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1feyA3XYzMQ7kNvwH4y6zu&_nc_oc=Adr8xrl2gDErFhAssQ69-7cnJELxyOFdium3bti-LUFo6eC-reqi49t2kxdpXzY28j0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgNIN2LeLGs5-xGFDQ4Vrc8GsKWcCdKd0aywpmjQjz4Q&oe=6AAD56B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM6xboedX2EQ7kNvwGee2BO&_nc_oc=AdrLo0phi4JBhNsv-fA0bZLic3fvLDEeEl5z4wQAIEa0j-ekwqo5XR5d9iVOWYc1KCg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpa8hY1V_zNSfEUUQ6BhFS4_FssizNbl2fpGaDINX8cw&oe=6AAD5F5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MnuMdDzVnUQ7kNvwGLzBrq&_nc_oc=AdpagvHy2jZy4d7S5w0Ay1gCiM1lHbISB_jf3qObcHe1WF8TgRoQachVK8bCnNc7tEA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjR8pJYVCy7Q52PUX9BHxUc3k4nS5vA204vfjzXwpuhw&oe=6AAD4367"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVZ2UTsc96IQ7kNvwE0m4Ui&_nc_oc=Adr0JB9bNc1O-oFYbeiexxS_J0UWRiq2xFNQkrldscoSIuL-NqGiAQV5_d7mCaF25Is&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGiQVVARHcgAPl5OM0s-kEfwjXsFSfBNlNE10fQxOA0w&oe=6A70880B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk59d9S_89sQ7kNvwFRmivV&_nc_oc=AdqdvziBL3N2bI8VhU_67wvqd-oa1ziU6F9qKLmCtMDytK952OZfFvg121wN06eQdCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoadrTuJ_1TWaLKE7_X6BgJZ-1XabqH74UGQbPEAGPwg&oe=6A70A151"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EKvsPrLGcwQ7kNvwHAGmeQ&_nc_oc=AdowBs6m2AujeakXiTzfWnzqni9TaiXTIdaiKsGMuJcoZ5-4yVsaNS0OzBfbQSzPwio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFquhZcWDquU95_rYYuf8QQnE_2uI6fLQhLeEjvhyBjBA&oe=6A707970"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=flMYYe3P1G4Q7kNvwH7-63g&_nc_oc=AdowD14AgN-UX51LHoVPxG4EuMVYfTvnCMKVtlW104b5haVxF_XX_UTBM_vDPE89pSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBzeqkoh9ZjZvi58jyhkRmrsMs4db_RiIgVQCCIZq0ZQ&oe=6A70821E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNO_UMx8lR0Q7kNvwGEKOPu&_nc_oc=Adr2Xg74jyjKa5EywZcUr6Z9n90nPSTtnwzfA22zraELAGgDK9wA7vilKr0BxYVKAvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoGlvYv-QydVD5qaPGn9Z9j30QqjeFzSy6r-23niF1Gw&oe=6A709E67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
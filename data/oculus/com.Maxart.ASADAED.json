uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA0CnjZmW70Q7kNvwEm1iUy&_nc_oc=AdrQW08qrDzco2KmjHFyipAE4X7VXn_-ISqvB1-w81ePJ-7PY3yG1sDLXO-JvaQbhiE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Wz8VVA7h5MreRkIev6lSFyFs1EEhMYFuu3HgUfrRKBg&oe=6A45068B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=597w3bfy3RUQ7kNvwHMf9z2&_nc_oc=Adrhe8WqC20powLQzqQPLclae702fpuJ5A70eMsfMZ-XW0-S6VYSQsxGg9I-YcHky7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WQgRJJHjrxtx0RO5g0GzT9usaesAe_btP0VKgLpxq5A&oe=6A451FD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zPgRnUoLqkQ7kNvwGBU2Ce&_nc_oc=Adrq0GSi8R22elmqknOIrDM9UoxjtFzoDw8MCR9xnGadqcDz_txFqXnbqjWASYZvfoA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cibaxvxtFN2rYRarM5ztyLpfTs7kZXS39bTmJA77dtg&oe=6A453030"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ifu0HaPF5rUQ7kNvwGVkitk&_nc_oc=Adp7qgcX3dqo3Qekjo25z9MawH3IU5UuL1_0jtqBllNNXBzppjIYvKr2IPuCVzvF_h8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jzSX6CgGaa765KnJe-WbbAmWARvkZRoNgYvupBdb8xA&oe=6A4538DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFK-cc0IGn8Q7kNvwFyzEIe&_nc_oc=AdpP-L0TrH0mSeXj3EyEYXP_xo-8YkKv8HfkqqRCbwXrNw-Gzreaf6uqMeE7gfQpMBg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tP_q95RPheJ81NNdONQUh2uPOnN4NqYSVdzfTO93BtA&oe=6A451CE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
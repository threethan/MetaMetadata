uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idOFXY4IMNkQ7kNvwGaIW-r&_nc_oc=AdodF3IY1c4O8PBrTcgQkzEvpNJrWIg5QIyR6RhY3xENqH9CGICPbcSfoogl7fSLYbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTUsCc07vTZLq4bXcqmCoaMi5DFJ2Z7nWdZ4paU6uDBg&oe=6AA5440B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TY3c5gC38bQQ7kNvwF9hArH&_nc_oc=Adq0bNUO9-PI_ow41b8ZkgFo9kA_r4x5u5-ql7CvjaVlR15nt9M3R62dFCSkW5OfHK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMoY2w8M2uANIq14-Q2QloBiIA-TGhRXDo3e3nfAmrhg&oe=6AA55D51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFcjJU3BQxsQ7kNvwG8w_b3&_nc_oc=AdphdhvvlIiJcgDVmfuKFKBoiRpbN8M0Tit_9Q5so7ojG2jK2rZyLuDjwY_e_FAne2g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDV0Etq3lNyJmpSpyh-v9TqRRlml1kOfPW7V3q1iOvsA&oe=6AA56DB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S66GiJxd0VQQ7kNvwEDGyBg&_nc_oc=AdrGV2G5Crrir_2aVLUeso57b-3GABCIehgxOucC30xoQmk0w5Fsd_RKKpNBoE0Hmps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkXgE4B6dmDwOQ8CIy9US2AD4H1w-tnioJS01_pDAb_Q&oe=6AA5765E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN6yPnf6BXYQ7kNvwFlb2DU&_nc_oc=Adorb01LrqrzYkvq72fWVtJ8NH74I4p-Wg_Ggl5zqvhBTFBXNKhGJAkMfmbnCQfq6lU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-LsXK698phOc0LZI0dnOP5RA-WH8H6_3JSkJkq-Eutg&oe=6AA55A67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
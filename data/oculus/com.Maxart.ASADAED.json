uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDK2F66AvdsQ7kNvwH-C1ld&_nc_oc=AdpZ8rYXcITqiZT2NdtawMYiLI5ots26ueMKJsR3XHW4rItX9EqhvTEIuXP44bbDKOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxcL1Y3-OgPWNSQ9158LbQoNx2VUTbeMxxLj9QPycOYQ&oe=6AEB5BCB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdQNTYzXYxAQ7kNvwFILLL7&_nc_oc=AdpVQOQiKcp_SHKVpEoDFmhqGKP3Pt0ne7g3hKJKFmiJnIlkcAY4S1yCdFg5Qn6Lq_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu-TDwpNv-9_ThZNcvCAiWTvaj4PnkrDyBZzsPfLkmhg&oe=6AEB3CD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0ql8ynjkCcQ7kNvwFjRZw9&_nc_oc=Adrlkxdqs3gqUVncxNKGDGA5cxgDg8CL87vAHZoXqBnImJBTiUIIRU6GoMZx-zukfbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu06D0qoJz-nSBZk57RYEj7qCaxPxCJboywKb0ljnJsQ&oe=6AEB4D30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Td6wNLJ3koQ7kNvwFgmI2t&_nc_oc=AdpF5O9dGwr9Nd4wRXMTsmChTaEZ0gOJTrKM7-Gu0_f1Gix6qAUDLDJi993z3csIDoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8p4AuXd6APL8YyhYZbcEoFZz75MHbHVBI95Q-hRBZ0A&oe=6AEB55DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BswFxWVYOAgQ7kNvwE6PmUd&_nc_oc=AdrpI-vhZay42eGgXbAC651cprrmdnHwx3Xo2vPSo58GPxUdTJzsWrhDxxxg2n8YhX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQNYEtB-ErT2WsU4y86FoL0Ft_64QMBqg6UW_7b-GiRA&oe=6AEB39E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
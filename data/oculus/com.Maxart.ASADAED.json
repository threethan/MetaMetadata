-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ls3lccgLTCcQ7kNvwFDAoPf&_nc_oc=AdpMzMH9hYAlkxaFbghTfUuL-3pXx4wGrF91wsjp2R_yu9r8Y-PKuL9JgNnjAhlupU8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxqTXpcZeIUO1BaBlvQ5MdXrcIzBBtFpWywVf4YL5ugw&oe=6AD0DED1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c7K0OR_LCcQ7kNvwFriqK8&_nc_oc=AdpqeIZdqQy6p9i96G9KTM1g9NkYX7e7YEomrRFIjqRfhTH8ynBhPcPcTU2QUXCeNqA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQkcLJ57sRepIXIEWcIZ7sFCSMGLrc5UZcBsmj-Cfl_A&oe=6AD0EF30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tuGbznW3nEQ7kNvwGZ1Qdd&_nc_oc=Adriu_l6imLyDu8APSrPL1WI8H7m9avuNq_q_zl1IK9ffmhxY5sw6rtHKgLtcCQmxMw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJP1hRPv0OJ16F2jfp6mAf-pQMsx8sA85fH522_bfJDQ&oe=6AD0F7DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DOhctuiP5kQ7kNvwFTiLpJ&_nc_oc=Ado0GmLwyWV3cDlGHs80MhNY-IvkdHDxKkM6wxxWcQOQaXQjx7e9BXcptF0KDnk-npw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgVHjmsMhY1gUoUvio-6tmstWNpwNxFWJO_nOYVr1GUw&oe=6AD0DBE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1304100533389757"}}]}, "scheduled_o
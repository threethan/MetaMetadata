uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxwAiWOpvSEQ7kNvwFWjlJB&_nc_oc=AdrUA6fygC-v-R5RBq6o-fnvZm0WN9rsEVy6Np6atZDHi0v0x_g7BJZyvruqosSwy2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEoyLp2CX63_Y0ptp--29a2xir28GItXs4HmNwREZWjg&oe=6A52358B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d4ultHBSEkQ7kNvwEDLKsx&_nc_oc=AdpquMVCGqiE9WFyxXREUBHpvYoHUIIsjfOphCV4DYwj6_kXOmHW6l4ZtFRNoErHdWQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeQ3FffN3PdcyEQUD3FkApX5gkSodMIMWKVROqsS8qPw&oe=6A524ED1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiq5240BCssQ7kNvwEgvDtn&_nc_oc=AdpletY3Gcj3712ECMgG2BSjUdeUvQA7XK3xv58X12v2ESzaA3MYHhkIvbdi7SvTnMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS_bljtd2cPkYaPo9rHnPBMT2dJVc1eK6vuXcNqoHEEA&oe=6A525F30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Brka8vpzPfcQ7kNvwFNBOUx&_nc_oc=AdrIINz9xhXK3_mtvEjD5-cWIzJSSSiryzpR9u1So-9GvdS3iWh5woHtA5VpU5ljleA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBookdn3tXzgvIC94OSPc3g8EK6Z-Po_pz7Z__JcOKycg&oe=6A522F9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHx8qu8WrW8Q7kNvwFsWj3I&_nc_oc=Ado3gsfjfLMJp-_V2o1EpIyHw9Xp3na9DYcWvCIWjZw9FhChi3rdqgE6IwE05vBDzOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTLMTHQdI6V-Xs0oKY37umfFrXT2JzMWuoaCVXn4gzWA&oe=6A524BE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
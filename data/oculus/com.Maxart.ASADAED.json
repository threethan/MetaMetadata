uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fWztqHf2jIQ7kNvwGNukMG&_nc_oc=AdrF5X0e3TnH9a-6_1JBKx2c-4MswUrYmeCHYIA7nEqg9LmoKvwLiopnc6EY1-r7Oz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6uOH_qsHf1kGvn8Be-F7Ilr1G4lsoq7R7VlYf_E_uQQ&oe=6ACFAC4B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVcQ1Qqj3BYQ7kNvwHx9Xqn&_nc_oc=AdozeFqR3BZ7nu0mcvKgfSnvLyN2Q9HCOUAV0ykVZyGqM2l7HParasJiv22m6zfcQTA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD7yK6XwmNQUssjQRO28i1mHL8PEEtCLBMQZC01oGfsA&oe=6ACF8D51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c7K0OR_LCcQ7kNvwH6d041&_nc_oc=AdqU5k36V2oTLAwpjlZ0HSkLXWgR7i0EH2wm9wd-W6Pjwr4MKSRC_-LBYNoIWQ2uEAs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAhsn7pIYWaGf-RO3eKd3BBB8wiHZM4yiHqSZufjq-PQ&oe=6ACF9DB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tuGbznW3nEQ7kNvwEllM7U&_nc_oc=Adper1yHRaj37Y1p-7C8vAkhIXqXLZ3unKIqINg0xlEtINdZIkzZhEKRO7I8WEkL2QU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFVqOfJSCQhUXyER9zf0P7bM-U4CPgQgLWkZxuBIVYaA&oe=6ACFA65E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DOhctuiP5kQ7kNvwEomKMR&_nc_oc=Ado65LrL3CQCW7UgOZ6E5Aq5mQumSJ2fpdfK8WZTRSnrDqoT6t0_ZAmlVF4PilkA-rA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSqzxT9OtpQHfpja9NmAkAkLtKsByGAWhY539AIceWQg&oe=6ACF8A67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
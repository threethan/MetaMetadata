uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzfKpjauTMsQ7kNvwFlELaZ&_nc_oc=AdqEtg1_cx9v4AGTEV5WGQqhJCYrs67t6e0aHPX5UZrulqRKmRoknsYO_szU0IlaOjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh9OERIWDW31aSrxoLlg8QrYn82NNZ4tkt2yWGFu2cSQ&oe=6A63590B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk9Xi0xUxiIQ7kNvwGpyOy7&_nc_oc=Adprl3Rvkfil5rnK92t6ttr0h9C7xFTOJHRwI2RxvKnKYdq4n6lr_i6WNXXXCd4NZnw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVIIGq7SaDcq-P518YTH4po_IDBBqQ4ubmxNucoLFtSw&oe=6A637251"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44C64L4hsrcQ7kNvwGYn-no&_nc_oc=AdqgHfvGeGgLp2IzXbHDif8SUmPLaNOqreEjdQ0OZ5Vu4dbLRNiDEvdA-qXgCAq7Nm8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8xH8hkZ7t0swK5HBC4Z-BEp3p9e330jKjylwqWl2iBg&oe=6A6382B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcKhFE8f8F8Q7kNvwHxwIWN&_nc_oc=Adp7LX6qocIYScpHboxWznrWjEx0oyydbwj3hryylL3cjt7I3QLlSkjokHV1BE2sNKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3dhohKoewbmT9ThGG1ZYFYR2CS23Mw1FtulZeyr1d4A&oe=6A63531E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eTB_3jDonoQ7kNvwF_xy-k&_nc_oc=Adq4oqPyiU2wutTUtONmDysqok8HCDtLz2-_SgPB0R3GnU0Si5oDSHPFClFOughegic&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWyGnvC39NsfmHaeuBYadAdOFdhv_oWyd8D5Fu4BQt9A&oe=6A636F67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FV3QNDqaZ34Q7kNvwGxPmvX&_nc_oc=AdrUxCuGY4QwLA_IP-7KnVg5CZuU0ByNmCpmxISmthKHk6MFjTKs3ggzc1DMexrUNTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWk_lTt2b_RUk6JVDWu9uACVf_Q7N2waWMkATr08SjLg&oe=6AB7B90B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx-KubT6hScQ7kNvwG7DFAg&_nc_oc=AdpMMqn8B4Os1rJco5Dfj_AGN4gXAf11a3uGr3jpojzG1OLzuPj_aVqKO6ZwQFU72Xs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwJGjkKcw7Aha8VAcx3gLGEAeVlC7UVQKBlhop-j-YfQ&oe=6AB7D251"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMtRfMakMeIQ7kNvwF0qfss&_nc_oc=AdpeQCW2c1a1XxJZ95cd4zRoqIXlhGZ3vCZS_7Hsa7VNVeaxzOsrS5zvfR0zX7wOcKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2JZOy5t6tb1HMegU-ZyQNAmK9iEkg8X7A8WIquY5wWg&oe=6AB7E2B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHB3UaZ3aKwQ7kNvwFm1bc9&_nc_oc=Adqtgl1Pt38PUFD3Clpdnf-MY8tQzj335KE2h6Z3teUos5rauSZndkeSbScR3ajLWuw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItXMUAfnFN0mAYwIJ3DL3ia-OdI5VsLjteNcrOmW1r6Q&oe=6AB7EB5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fb_YkJAsa8Q7kNvwGAta_3&_nc_oc=AdqDRFkVKuUBMYWwgNE_NdUY1beGgmkrQDV2lcuVGtq_vclzerK9ezCK5frzo-_2vhI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhHfmlQ6Bf6s8Kinhmq1DHjKZYhkb_McagvyTLJg4pxQ&oe=6AB7CF67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-0CnkJmc-4Q7kNvwHgFJP_&_nc_oc=Adrae_EnDSCnUSRVl26HTCgBxoX255UL5vWOPdNDmrPM-AKpIN0vVhYaJmBj0n8rNpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQFK9TbldEZRjLSkAn2gF7DTMzNtgBTHFP5QoA0Ov2PA&oe=6AABDB8B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-AHddtfSqgQ7kNvwGzkX4P&_nc_oc=Ado_V6z7J8iKmg-QJnabj8EqNwUV5rTYs9Aqjn8LduxKyOXMGVbN8geYzNlEYCu0UAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9CWzgd_wnVGOnft2jkxuw9ztJQmBw2BUAwksbe-1Wgw&oe=6AABF4D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1feyA3XYzMQ7kNvwERfNk_&_nc_oc=AdrUiQXaSTC7PPm7ACwJX_dmdRaxmucl621h3G2HuQ8qTifnY13IKBpDjWid8Mnpidk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID9nDJEHxu9K67-SOlp-2qLQcUBvXdZGCHuuB_8mgKFg&oe=6AAC0530"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DM6xboedX2EQ7kNvwFULZ7T&_nc_oc=AdqkrOBte4SlA5lIB-p0nngGFAWRCKWQueg93y7C2gxdf2CWSbCkokjcL12wK0J0GbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInzAVVoKtxedvSxtvoDkB4HiEpIKlvJoEH8n3OJ8RMAQ&oe=6AAC0DDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MnuMdDzVnUQ7kNvwH0RU84&_nc_oc=Adp7crYOQjqi2Vt-npWliUXfp-vYfHfYgMgWEoon8peYQuZTSId4JmJPQdFdulpJY78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLPk5Dox_hi-x8h7eb6tHFc87D--Wlg90lcLXBSl_5_A&oe=6AABF1E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
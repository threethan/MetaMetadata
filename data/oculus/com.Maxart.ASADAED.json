uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDK2F66AvdsQ7kNvwFSTHrO&_nc_oc=AdoprpLoSy1gOTL4WFt0QXHi9f1WPWFYt03REHvkJDJjtretXeUvWUWsP-2Y9ss6EYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrMBg0yo4ApikLIGivPP5owD_MsvyNuwwG5dTd3F9ItQ&oe=6AEDFECB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz_Dizx549AQ7kNvwFe6Fhe&_nc_oc=Adrg99FvU4-7vrOKb1u4yWvaKDVTZAmpvYgMjR0btAickCB5BOdKBuEn9SA2735nXgs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-JlNivW96diJyo1VJgL7erVZQ4gnlDCaBfvyUUKJ5ig&oe=6AEDDFD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0ql8ynjkCcQ7kNvwGcXy8t&_nc_oc=AdrTxR9HBTefNL2UJR0UCmygJ92nZdumzoWxkBov2V3jaxr_g-wujMWB2rn9QDBS8vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgOKj1BjFYJDLhzBCa_buZ5NJBiadHvsX6rYUhhwRcUQ&oe=6AEDF030"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdgYgqW4MDEQ7kNvwEYi7cc&_nc_oc=Adq3hSci30HsZU2zG0_pPDQh4SWU1Qx_4_rY-V6yeAE_SPlENqUrmSy4L9c0eXjoHW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKuSflL9K_O1b21d_CI37IjsESCdNRlsF1DuCgR-wY6g&oe=6AEDF8DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZjruTfhgkEQ7kNvwFTIsPH&_nc_oc=AdqYZH9wdCnoO9sP25R_6NGNrREszcJfSNU_3ZLJSmb7xXqQ4zEd571jCrMs_JigHwE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSO_uE13u8iX9czRYO4B5F7CXHUfw-OTZTibGACVXcXA&oe=6AEDDCE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
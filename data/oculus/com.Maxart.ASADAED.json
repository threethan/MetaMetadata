uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8A_aOoZjhZAQ7kNvwGKAmjG&_nc_oc=AdpF-iHA5ar1bUc9JmBvfU5H2_KomwNN8zMvBOiEIrEBzPzxznKHqXRQmTUzTr0weHA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkQXI5cC-FDqRY5NL8wkGefZsY6o7J6pXhlN7AzjDiHA&oe=6A562A0B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5nLcdwkxlkQ7kNvwGgBQ3A&_nc_oc=AdptZ0XVlhb7xTgd7vl9VqDQUPl6lU6S_Lw0hMEVq_P8OD69EzlpguuZ0scgmDf2CVk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkBOf-1u-XjFwoX0LldoPmJ46bK60N7nmhR0sQM9GAuw&oe=6A564351"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF1GHGt7qGsQ7kNvwGtLCuZ&_nc_oc=AdoP9bUsLvwTs2cW0vedWGT9ivkGNQuznLZlGxSYtPI6ZR8kan_C6m7kUCK9t8lZ5Ok&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOOxQQRb8ksI2ydFjsEEp1O67LFaPH7GgiAbggVNb40w&oe=6A5653B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h9vVIeJrsGoQ7kNvwGu4cLS&_nc_oc=Adq9a51NIvga0Ra1HMM6Yt4HIP4hvIWfTEd7iEURzZI7KBiKXQGBwyaHU1RmyN9tuVc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLJvNA7Jsq3ZS0RUDt1nPX028a-9GlO6HB7q84gV1FlA&oe=6A56241E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERTI6Qic030Q7kNvwFJJolO&_nc_oc=Adrwz0VLiDkeL0xy3KdUn4SUt40EBBSBurzwYyGzcjvv-7FLm3Yu0CseO_eyEeuOJyA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPvhRg5ubw7RAq_1mQ-CStbKkhVW6fVQKsi5YrnODFhw&oe=6A564067"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
11-1.oculuscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5vhQxveOpzQQ7kNvwGAdVXn&_nc_oc=Adr_xbxgyUNYZWHZ7HJn6V-mMY1JnBmyx7mhfYPzWgF0kbBAFEuCW46Rzbcu5VLFZoI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR_P_7ktkKMW40fVQHgIIJrkC5GmnknHlqFWLFeV7R6A&oe=6A8EDA8B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IBZy-ksUHkQ7kNvwFntGdH&_nc_oc=Adpr6hkfQq2Zo-ZNb7cHolrbYtHUJJcoK51wcxahYMw1MH-tSFHM61_qTBhJ7BK9F1k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnmDzYrZ7-B9XD5N4uMSdHO7UcV8FnH8nmu6kcNnm99g&oe=6A8EF3D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEm2JLhRHIQQ7kNvwFVJgxm&_nc_oc=AdqmKPMsCNNuyPBLxhADhSp7nXtOcAG15MHzgGBHLE5Mcb5lqS66Z8AZvKDHIghueWk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnrq4bY4FXZpS7KzwlmX90bbT9sSBxwpsnEDtp14jBVg&oe=6A8ECBF0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZFhoLo0yckQ7kNvwEk6Cfd&_nc_oc=Ado5TCrs3rEcwoAPGLO8P3dmkqASLYraARBGMz14JRVrVTiSeu7j_Fqeoki2IzeDOno&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyYpr8D9NtF1j-NGeBhPU8aqOaaEHnFbm3mO9GhMq5mg&oe=6A8ED49E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfXIQbYPzlQQ7kNvwEP7F1X&_nc_oc=AdoodQXDENR2Wz6soVfUrhUKUjRbceO-1xi2TJGYHeak-KJx_jPxVfKnEAu9WmJocyA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPATpoCU7o3IGcxFF1nwX0phjXR_uLtc6xoC9Yijmpqg&oe=6A8EF0E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_a
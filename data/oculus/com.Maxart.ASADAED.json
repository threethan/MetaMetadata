uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jq-6uKRsQlcQ7kNvwHj_Ly-&_nc_oc=AdqHoO5SevcAPRh0OvxAbDp2FOMCc1imwYZ2FjRTtwK6mEZqYCqVnIIoYXeMVbezs4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKeZzteCEOF5E-YFUQzYZMXW5HA1yj4Wl4oyb6jKpEcw&oe=6ADF460B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ2L8PmbVz8Q7kNvwG5QOBT&_nc_oc=AdoOiqRlJfEhRh3pLAkUNz_J_pncBXKKc3w7grH1L5HXzqWDcPSHwwucpLH0q0igabE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt3Bt44ZM0uS_aNZze0hk83NMgmwa4ZaRQSa13-iPfDA&oe=6ADF5F51"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZlyOpYMFAoQ7kNvwE0reRO&_nc_oc=Adqe8Aw2yUX_LlC5hdN8FSHr542Kt40kpIlIhwjeAmuc9vLp7P60M0f1RPC5i_eQ27M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-JHyo_zCquM5gs0E2vO4l08jJ_2tBJosnHB6-N2_35g&oe=6ADF6FB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vp6cQn6NmgsQ7kNvwEMd0gC&_nc_oc=AdqINJIXUTINIP9fG4WVwr0wyofl4BoQW2GXBD8LXHUeM9lANILbTJe6svhyB-Pe3Hw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHEdsIraJXk7VAJoEsfbP72wU2I3oInjpnXdKKhC8p4A&oe=6ADF785E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC-9m45BbnYQ7kNvwHYCfD6&_nc_oc=AdpTN1i7LD687j_KRI_PXqq_An9n5kEtHH8Loum1-RYXpsDgJNKlGzHveFKVutOA4oE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZpS-41Gx5RIFTu8-OE8_mCwyawRTkj3T95F12ss--eQ&oe=6ADF5C67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
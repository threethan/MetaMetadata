uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyun2ES-xc8Q7kNvwE1Ji-A&_nc_oc=AdrcDK2TJPTbAYgUS6IfwYd368z2Y1WxgBTmKmey7PByms4zLFBV0GR2B_RD-X_vLOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-TNoPemx851iBTOV-znZtIVMg5L9nSnFFFQOeX-SgMA&oe=6A89948B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXACI8r385EQ7kNvwH1U1AG&_nc_oc=AdrkguWfLSAr5nva5_PPiJMQknGibiIUOp6bSKYbbrOAw4QLa-zH0QD3qe48XB4lV5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENEheBm9Z0SNHh3o7sZU8O7jXZhL4aPZElgOddAze4yg&oe=6A897591"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDfQvWN-q40Q7kNvwEpztSS&_nc_oc=Ado8168jX9UhpmHWZf7JFWdkJdBSi_D5WN_CHSGPuEivPFVUJ7vWO6Dzb3p6OxcWXZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeH24REfUUq1skn1aZwN7AGk2E6oDnkHcNaAMYHE4cLQ&oe=6A8985F0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEU5b1ZxDcQQ7kNvwEzBlFH&_nc_oc=AdrhqMdkVoIJAbJomomKCaBe_wb5-K3rpyixtA8rLKBzc8nKh9c4VZT8VSu_BIuAsxM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG66l1zPqGW_QT0tsDzjpSdKP3Iv_zgb0vwG0CqReqLVw&oe=6A898E9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67mIWD2IZY4Q7kNvwGJnUz0&_nc_oc=AdpG-6ntA3vYemvSEUvJsLJJr0tzjo4kWXaktRPsYSesz7smSBGRErwVSvhbXQVn0rI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw5OSvKh71t0SHeJPesoFFmqpYDvhBpdt6MF3HCzxTGA&oe=6A8972A7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
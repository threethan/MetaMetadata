uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us_5tIYgoUMQ7kNvwE8Qot4&_nc_oc=AdrB9BlJwWyzaAn1kC0bK6tJrie1xHlthQlN7KXE9niUeiHSpSCeZAH6MJhefikEoa8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRj7EFWB3wSgx21lWHMfYtxq-dKgCV8B7Ak7YNZ--MpA&oe=6AF344CB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrMEF8WWtgIQ7kNvwEuafKI&_nc_oc=Adppp2a1GSWFIFo7B2OVCQ9UDlB0pX1btsZD94Y77or-XYPVeOptatKq3de3bxMrIZc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYbbUHs8fraFI09hY9zG61s6u664hLbtPM_pEEjGKA6w&oe=6AF325D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx-hJtOZmSsQ7kNvwEbfJb6&_nc_oc=Adp-6jM78GU97akv3xCcH9sSOFM8ODTW1f7McuaByCR5tpu9RwN4Lei8azyd8JlJsFI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4lix4_HOmwKJ7ELJf_GQYEGarRFRNJmU3QMkbtjdZxw&oe=6AF33630"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6GGpkzrPKIQ7kNvwGjXAPL&_nc_oc=AdrbE2KIy3gOLtif2-dGYOzPI9ZUJSWA5-udXj9iM0xOSBCa7zHQJhZ1KthilqRWHtE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKi-mQVybs2g6Nt_kTuOiO75UVuQxcapaowueXfD6-0Q&oe=6AF33EDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BugohhKAcuAQ7kNvwHeWgQV&_nc_oc=Adqoa5DKZT_43BFdzUt2K67L584Ri_tV_cGiSg9zFJ4gumH7VDeZUITLICwKLIIca0k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSagpyDeZMuoUrscR3YVwk8-mEZtC_thRFr-57mOJ4xpw&oe=6AF322E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
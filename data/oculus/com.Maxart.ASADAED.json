uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od8Ch7xN3NwQ7kNvwFspHkN&_nc_oc=Ado09Sh9Ev6fwLH_-aSP4OlUe9tyVm1J3uLg2bw6zAaeDjY1rMoK1cipzHBJpPo4uB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhL_OmhyXtMUutinYs30WBMxm-T4hOU-g4G6p0fYn9dg&oe=6AC3CECB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CY9GTLFPS0UQ7kNvwG4zGgP&_nc_oc=Adqoh1g2LWY7wqnXjf0iFvnEu0Q5d8ePqmxQbi3Nxw0rJ13_kkZE5F1ND0iARAwz4Aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP61C3HG8vhivFqxDZuiCJSblSAUFH7GIvy0pkzGM0ZIQ&oe=6AC3AFD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj3NBqKAmFMQ7kNvwHprD6g&_nc_oc=AdqCgVEuFelixNV1sMww_NCixXscpd-TVN5s4mUHpSJohxFC--fd1d0ZjJQANrYcNhY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUM_T9enC1_R2vAOfs0-xrqPNQ6PdGfX4FNvZwyGCukg&oe=6AC3C030"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsa01v6BNrUQ7kNvwHcsS0H&_nc_oc=AdquPqOegfcvLchF3LNeUGOxJx32iZUkPC4pwKp53d_rgZQqcbNVUJ8mRuAbrm6KmGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIj4vtOKi2Vs08dZ1NrJJc0FQ3NBQtnaei9jhoHpXfug&oe=6AC3C8DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPfwKzuka5QQ7kNvwH_Lvef&_nc_oc=Adp-r71A0TzASssAqSe7uOcyzfGuyWK0S9G9wka7R-CG05EqYm3RtovUeASHhrs3LP4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3otSXHONUbvcaQ7bslRWdDIsO7JHTb6MVjXPIE9JEgA&oe=6AC3ACE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC3L3NwiwtgQ7kNvwH7oHlI&_nc_oc=AdokCOONb0mLiCIrmIacMqOzF1YROHfsyWIxbgQEhI478AEB4DXZCcEq9WjhTn9EXU0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWcbKJfMdor3QROG1rTV_8rDOSOAP8bxyGagoGZvyQ1Q&oe=6A902C0B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IBZy-ksUHkQ7kNvwEjAzYD&_nc_oc=Adotk6wPPMKaRD3eT8avHqU_wgmLV5jAdUJ2xcuNkZsLU4NQ6U3xBwaf3yUNtxXrU4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHS3Ue6ilkKZZc9uIquvEWNBgewgPkfzEKCfdlQStWibw&oe=6A900D11"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIgEtgTPyyUQ7kNvwFSccb2&_nc_oc=AdqmAvAcBWA4pav0csUYz_TNDXGFNS4pUgi_oKfLN-pDAup0NpXODWmp-wf06nr0d7E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbeQKZJEqeOTT6ZygBCV0HMwuxkLvkcHqqmgdn6ybv6A&oe=6A901D70"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZFhoLo0yckQ7kNvwH5irjW&_nc_oc=AdoxsPpOMG0DMSs7kKCFOF2PYpJhqE7SqGT9aG_fmXWx1DedbbH1NvXypiOsZzGb8DE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNCJMza6eiHxj3KHQxLYYim01OESCnknRYCFXoPCGOyw&oe=6A90261E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfXIQbYPzlQQ7kNvwHYkPiR&_nc_oc=Adqdeg1LYgn3pY55sLfYuS48vAf8w5byRgFN0fBp6KiJmuMFhrM98IoEn6XKHMqn7oI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFonUQL5VgcL8PDGmIgwjtLZHsFXjd_PBSNZEO0tLMOHg&oe=6A900A27"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
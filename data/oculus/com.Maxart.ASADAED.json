uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=As9I4wDzvEEQ7kNvwHoEk7S&_nc_oc=AdoMynLKoo8VOX5V_BCfwABPiZ5GHoJe7ACsqOVPIHa2NHXyd-z4nVN3r3tlkbzwjqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJu7lBSkch5mMfWip9pTAocseZ8OoE_NUB7MV_awoocA&oe=6ABD374B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHm5tNzlFtQQ7kNvwEyp47-&_nc_oc=Adq-1IdPFj1dNmzdLHa48pTaTl6i1QOJzlmQIzNf-LI6FBo690iiswreq0Ad6lqWw7Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0D7ejnO5xU4I6gDlD9SaIWUkBMw90KrVY2dxruFooCA&oe=6ABD1851"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE60LzHKE1AQ7kNvwGUrM_4&_nc_oc=AdopnzexqQ1qGnUlhiiPzU-O2nA0PVAsFikN2UNj4TaxPPEFgMEz1Z6uxKWuQj4JHug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs1VLThZ0EFHOWQ0LneBzPciPzasnH08XAFL-DBpi95g&oe=6ABD28B0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0zdBIKXvrCYQ7kNvwGMGF4w&_nc_oc=Adpd808oOgBRL9nzPBhjOhXbf8xBJqZ79FfimAeaFyC4ZvvkNYvWkTDPXdJgYYxALT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPSHGkdNPvNpdNDFwFLc2QQ2eGLzDL_y8E6Mu2_3N4aA&oe=6ABD315E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fd0MedN40EIQ7kNvwF6DCO_&_nc_oc=AdoaIH8tSM41B6iWWJ8sVx_Ml_yB4f3-gxmZEfd-8RRMlDW0camU01gK3vPgpvgBY4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL214dsphG8PeklT_APwM_P2IAmM057GXeDjFd8_ezZgg&oe=6ABD1567"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us_5tIYgoUMQ7kNvwFhCYO6&_nc_oc=AdohUxfnbSGtJ1a5GbxzdM2wVT9YO1dYj1xVexEpf2iFoW2CE-TrEQqQvR4CeFi4cw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQopC4U7Sp9LRCfySVu1GGXoU6H4-cg9SwQ7jc18LOGFw&oe=6AF5E7CB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Jt-MLWUsb0Q7kNvwHmeTCh&_nc_oc=Adoj2d6JPzSrBX0ACW6U4i3Vwlw6F4V2vUcZvOX_vrhBfpZDBOmkFGnGlNrvrwd0Wr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbhyVn4dqKtagnZgUnhBPv0PF_TWUSN12FknZtnu8sKA&oe=6AF5C8D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fx-hJtOZmSsQ7kNvwHYNlTE&_nc_oc=Adpo71PKWxStmCWqqlI0T3uG_JWqHWEEcKeqd044OxnuD-h5BfGFIZ-ggocLxt3g3iw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLn4h7T-1RnGkxcCF4YUcjtwe_xFEX4fdisszzwXbbcw&oe=6AF5D930"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMtGZSDTwWwQ7kNvwG4HCR_&_nc_oc=AdqTW_Hai4-HPS630HLJRJb7jwwWeOU0Fy5B3CHTA_Ejyq1xNuK0lHs9Rj4uxgFTojI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSKeEpPII0XYU3oWKjRudKNBBOFklycFqEhsrJIX0OBg&oe=6AF5E1DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-8Y_75sl3UQ7kNvwHEncNC&_nc_oc=AdpXRi3MRp8JESD6DH3cRWqH1bums2rF0Mp4zj5mA_S0sCGdGBHSJGP2yf9By6nU604&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR__l3sxRUt8NG7QXzQl-2zrX1NYvoeQIqdbmhk4iBDpw&oe=6AF5C5E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qIj7UszuGMQ7kNvwFyAMx9&_nc_oc=AdoZEVyPr8MY_8KFACS4oNx8I5pjwClC30QUt4j5aUmHqd9H0VdLiFpK62CbJ4kFmRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbn_3HrYaHlWu9ykL2rHAEa3RVjUq2OykCK29PKNPHeQ&oe=6A984D4B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHKl15tmAuoQ7kNvwGTOLY2&_nc_oc=AdoQl9DAduFiyf5SJdp1Pw5qeVympaW3IodBUyDR8OJkIheV95D6uGQLA7fLQv8HLrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvct-NpItYxF9cl_Ztm0kkCGOTudq-V_QPKlScEy7Wpw&oe=6A986691"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dg45DZ3fZEkQ7kNvwG-nHC8&_nc_oc=AdpmpgAxu6lWP5ApL0hqZ_9HuYcdhiCpYFS1hDc95gVhcZWFovPe9j_5bD7TlhiXK-4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL841kUn9CSS0ZgLx9mdl95dh0X2nGiyUcWvxg-6wgn2g&oe=6A983EB0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHJAVPn-X2EQ7kNvwG2u93O&_nc_oc=Adq7vkxFBD1_3dTV8aN-2ycinHpZeuJu80f6mPDCf4xgY1nQR7Lb-sHbN-_w_bF2wYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnAjbm3VpdHdv97h7laqS63Ym-qPmHzzJopOpuRD-gbg&oe=6A98475E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPtq3RolTDEQ7kNvwGR5_nw&_nc_oc=AdphwIEGt9pn6tN4_BYg9q3bLvra3sAUJx3zgpIKNJXYqUoVCQ42ZGloV0D8nBOUiis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuW04YexSHJEDjSZ1mCAMdCLLM2Wn4mp6zL7PPKDu08Q&oe=6A9863A7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
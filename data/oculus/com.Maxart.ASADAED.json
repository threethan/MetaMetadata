11-2.oculuscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtHQW2wwHUMQ7kNvwHZPLhi&_nc_oc=AdqqWhdXXKQIJyKH3cqepDYKTzGq7dNIGZUvDd0WUgHFhQnD_WxOWXurzJZ7OJRHLZU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUT1Pb1UReOilZthQ2neOae4IoSO6Ut5Kl7Xjbiith1g&oe=6A7DB70B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SINwfb2AXBoQ7kNvwHPIXY0&_nc_oc=AdondUHHxVhE5C4l5DnkLoU2jSuh-VoR33WHbX_B94SHdAgeCxvd4T5IwhfUmTXJmgs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFyfSZdoY-D0SvlCw1395nOIqBRCEs7HiOU3u5_jaL6A&oe=6A7DD051"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqgnyXINBlIQ7kNvwExlaju&_nc_oc=Adqg3jknx762QEOWXeYuVOiaoCKmyeSx6vyYKstAU6uu5zTvaEdWh6Ie_8-MJ9UWda8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjBp4Q_S8SwKoZ7zaxRWYN4gdWLl7ShC5D2DYRT-0HCw&oe=6A7DA870"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kS7mI3jwVIYQ7kNvwFrX6F9&_nc_oc=Adp3k0KNS28HsY-C3mRqP73JBrg8OyCdS0Ty1CiIYLKVg321b-O_DO6uFWiR4nclZjE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDbVgnmcf-nFYSlP6HbaIbfk8NvHI6A7PDuzJsRzqJcA&oe=6A7DB11E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-KL9dx2ZGkQ7kNvwGsfKJO&_nc_oc=Adri7HZv6I-baxE4mL3pIYdH7vGJHZxkrGqdv3GZzNn6t4cGO4WypTGK8vie6w8u-cA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDLzGyc7pvAHQNB9LN-UkID5CaPkra0xotrBQG7cnqMw&oe=6A7DCD67"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_a
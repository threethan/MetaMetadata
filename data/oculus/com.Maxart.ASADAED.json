uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWgtF2-RGFgQ7kNvwGdDY4H&_nc_oc=AdqqQMXbmWAb-DGs6WKz0fhbpYC2JqQsjKHaFDLqr5H1eTQXnH6Dmy5BRzo2vPRN5tU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB32t3rihei2jKxi0wvb1dWNEBKXeswuNRcCLmoYaLwXQ&oe=6A5F648B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AA5VmJT1q8Q7kNvwHheMEB&_nc_oc=Adop2ZMAFgDxtFXrYkHiJIVwJ9daFfLBxXagHzCpWlTiFa1OLoHrPRNMAVjyOwks5pA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3uAfmF0RBR8di9YUYmLiREAmPHKxXH9K56vM2d8RgzA&oe=6A5F7DD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBAi81piI-kQ7kNvwEve_dw&_nc_oc=Adpyi3qszsbMMzqirrxoZqoWRk0eela977i2oTirKtXZowXrTCHdfZBGosDP3JcaDTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmOtWNlU2FSfkCEDnyVSmDcOdxUC8LsFi3KvxBLtl4AA&oe=6A5F55F0"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S2culTHDqcQ7kNvwHxADnT&_nc_oc=Adoz30dqsRvgcMQI5CYlXSvVvHVF0XZL8vw2soUZZ0-H54qU16Stz_y1H9P1MoEdQ14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9pi0kEtrAlWkuLmNqyWb7qPzfHYVBsAQDncynrFyFFA&oe=6A5F5E9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHEnA8G5en4Q7kNvwFHDTOU&_nc_oc=AdoRcUHGna_i76_PBE4qF55qNex0rggAbiocobN-GWodkDO6OzGH0jnzlY_rIS7eA-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApMp31S-PZVStugVQPXWUxsPpo-uN9XWFccD9vo-gGVw&oe=6A5F7AE7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
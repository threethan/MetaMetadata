uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVSrrS2ZXNEQ7kNvwFUx82x&_nc_oc=AdqeQlyXk7jwLn0F49D5nnx_GT-HdX6DREqCNXSFg5KIX1qerURIImaxUWL-MQKcTRQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cTqroTRHhPdfhq3f2J_f9G9SITqooMnn1gmn67rhceg&oe=6A32918B"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kIuR0ggo6oQ7kNvwFDOZte&_nc_oc=AdodbknwWdesAw-5ArDUjuHGkv9grep6Zj_25z4khq6Lq3qWjYNOuUV8Dr6KRctzlqU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LrKj5PhTJ9f55sR-hW8sGVasijiBxH2uK7Vp4zJ9bew&oe=6A32AAD1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWpUwVlPvEcQ7kNvwEBvTni&_nc_oc=AdqhazvRmm1QHxhDOUesNlCnSdfQpdyq5arm83VuslATFRQwiFkS_YU0N09GqpsQwqU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TJcGURnS-d9aHLXzbHO7noZJKA9C61Z4r49BjQtuFIg&oe=6A32BB30"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrApZ3MeHLIQ7kNvwG_SnCD&_nc_oc=AdrjUllf-LKIlN6zZS5WtECTIoOfyU09x3Uv92zH4m3AESSuhgK7tPs39aCUrFY2Bk4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7MuniKNaiw4WkGQmzlmJINesDRKXXp-4gg2pDGjyGQw&oe=6A32C3DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-pCHopFhLwQ7kNvwGDd83B&_nc_oc=AdoBQf7XwSn1ztbaRBAGWS6SUwRaxHSdjYRHvcyXkMU3jD2g_EwJ0pvhjB-pwCnTmT0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qCkjuR_yKHmJstrEaDIocXghla0BHVmNAi2pGF6P9Rw&oe=6A32A7E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
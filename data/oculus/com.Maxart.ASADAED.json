uluscdn.com/v/t64.5771-25/39031471_723844051620487_1065008242703542329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIzMC-4gYI8Q7kNvwFqydbS&_nc_oc=AdpfXUNlVG5qGZ_3hnrE9eeANcepdP3ZlWUo34JEhZeMxaCITATjXpCThc8GNz3vAys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyoXp4qRnuTAflTPANqZOh8138tet6F0VhyxfXcySGKA&oe=6A9EE4CB"}, {"file_name": "10.png", "id": "427662631670984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568670_427662635004317_8026830319506311791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRQYW42_cTsQ7kNvwEO6IFh&_nc_oc=AdrEGaP9aGnHiHzXJ5yUsyJD0pk0FoWgtb-KM08nrEGhys3_Ldcqb-6miWe-cpt4HSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrxkd5yNP2GUyLNkNfJVXLg3Hbabh_r65CIMUn6x0QzA&oe=6A9EC5D1"}, {"file_name": "9.png", "id": "431489724772981", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974805_431489728106314_3979325388998295236_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7WI4VF2rl0Q7kNvwFgXFg6&_nc_oc=AdoaEwB-Rxmp5gwnzza0nRl4O0DrQ60etHyKHZTHvjEy9LTQaFoqLMbRbm3cD65sDyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVBVtBwy5fsRVndgERqkNV7y1z3v4DO6_DiN1nqxT-pg&oe=6A9ED630"}, {"file_name": "2.png", "id": "350968992758636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75262747_350968996091969_3490957883108969549_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKy-NHEzlHIQ7kNvwHWvCMH&_nc_oc=AdpUXt1bL0zbxfH3n9WshwbY2UFHXVOgMQ2sWTsRd6fjUbr2O3ncxmr0kiV1BFR-BFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5yQil8RaySHGPkRVFci7EJCebkvB76GX4UDeW3e0jgA&oe=6A9EDEDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SIA_Cover_Landscape.png", "id": "370830973950524", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572921_370830977283857_5278429287001126930_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuPjdw2unMgQ7kNvwF-zUb3&_nc_oc=AdoNE2AsPgs4EGNse_0D49I5LEmwhch6_tecqS46BcCNnhn87BCNn-URTKn1glnMJ_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9PJS5jkgyODSAS7EHRcIVeCqNBMLPRgSFF6RMVPfvVQ&oe=6A9EC2E7"}, "display_name": "Sport Integrity Australia - Decision Making in Sport", "keywords": [], "long_description": "Should I take the free drinks? Report a team mate who is acting suspiciously? Take the dodgy, but legal, substance? In this choose-your-own adventure app you get to explore tough decisions that athletes face.\n\nYou enter the experience as an athlete who gets to go back in time and re-live key decisions in their sporting career, and look at how those decisions shape your future.\n\nAs you begin, you select your values and who and what matters to you most. As you journey through your sporting memories you have the opportunity to use your values to make decisions, see what the outcomes are and look at how your decisions align with your selected values.\n\nThis app is designed by Sport Integrity Australia to help athletes understand how they can use their values to make difficult decisions in sport. ", "short_description": "Experience life as an elite athlete with tough choices to make. In this choose-your-own-adventure encounter, every decision counts. With only your values to guide you, embark on a journey of decision-making that could change the course of your sporting career, and live through scenarios where you determine your own destiny."}]}, "developer_name": "MAXART Pty Ltd", "developer_privacy_policy_url": "https://www.sportintegrity.gov.au/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sport Integrity Australia", "support_website_url": null, "website_url": "https://www.sportintegrity.gov.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE", "SPORTS"], "has_in_app_ads": null, "in
ng", "id": "141814854437268", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031318_141814857770601_70486355492273055_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwrfBIRHcWYQ7kNvwHyvLNe&_nc_oc=AdoaILab54qJ7K_kxrBvdX-iiUZNVmVo23Oxb8U-zsqlFUN6vKM3jSPtWQwyvipZ0mg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT834UGVG6zv3KQsZH_u1DjFxW70wk3oXoeLsq7AN2qzg&oe=6B085A4A"}, {"file_name": "Screenshot5.png", "id": "170391724595205", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031336_170391727928538_5199530013121476530_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7sTUZ4zIFMQ7kNvwHLrc1L&_nc_oc=AdodVNo7yI_7RNkuknS3CmRo_TP_bnbYpbmcQsc_Zyt73VIza3sYmj6Dmcnyd3tUVvY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf8AZ0B1mb7zh78ZiqQO-UGO-X6AzWoRKXf78aa_-eBA&oe=6B08425D"}, {"file_name": "Screenshot3.png", "id": "3442534709205475", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/86610705_3442534712538808_962786057883004600_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hsqn1zLBboAQ7kNvwF8Vvk8&_nc_oc=AdpBxyKDz9xu78Yo74TaMl3DifXPzIerf8LPqegiF-lpPFZ5KL4uwdeNj9eAhabkFHY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTq8mdJH46Otbo33tJfCjdVtz6LJ3DtugGJXgvvT_ZMnQ&oe=6B086CCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maya Lingo", "keywords": [], "long_description": "Maya Lingo is a single-player language learning game with a heavy dose of excitement. Begin your guided vocabulary learning experience at your own pace. Choose from a wide selection of topics and learn proper pronunciation, spelling and meaning of thousands of vocabulary words. But don\u2019t get too complacent. As your knowledge advances so does the excitement. Suddenly words that were previously easy to recall become difficult as zombies and other\nthreats approach. Correctly translate the items and the threats are nothing but target practice. But if the pressure clouds your memory you\u2019re zombie meat.\nLearning a new language has never been more exciting as you engage in a scientifically-proven approach toward building your foreign language skills.", "short_description": "Maya Lingo is a  language learning game with a heavy dose of\nexcitement. Begin your guided vocabulary learning experience at your own pace. Choose from a wide selection of topics and learn proper pronunciation, spelling and meaning of thousands of vocabulary words. But don\u2019t get too complacent. As your knowledge advances so does the excitement. Suddenly words that were previously easy to recall become difficult as zombies and other threats approach"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jedburghco.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jedburgh Technology", "support_website_url": null, "website_url": "https://jedburghco.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1310205553118916"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7163085767118435", "version": "1.0.15.18"}, "id": "2737067743270933",
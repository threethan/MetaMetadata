ng", "id": "141814854437268", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031318_141814857770601_70486355492273055_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_c7yeTQfglkQ7kNvwFtHu_v&_nc_oc=AdrDFKxbSu7Zr7j6Ve1b8GwURx8r7A4S4eEkDLmvtSDiixIUgOld4LRNUzFLg3eT_zA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgvBNMBHB0Tcm7EduIHC-qsPsRSTQGF7WZw08_hfvj5w&oe=6AFB2B4A"}, {"file_name": "Screenshot5.png", "id": "170391724595205", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031336_170391727928538_5199530013121476530_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rug1du1YvHUQ7kNvwGDjCi6&_nc_oc=AdqXh0_A8sBK9-7EH-k_-wAPqDWee5o_WJ5A25ULVPKQhXyER-ac2b0gWdh-f7CaKjQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnrwxIDny6LbP8VD3tLEdssUQOI3zxOuZ0FoAxFr0d7A&oe=6AFB4B9D"}, {"file_name": "Screenshot3.png", "id": "3442534709205475", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86610705_3442534712538808_962786057883004600_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNF5Su2YSbAQ7kNvwF05onL&_nc_oc=AdpNWiqboDx2PHdRJVeqqDN1Ma4xZj618Az0MXpSjeCAGLQXsU3Ynq6n-gVAviCFN6k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfql8IDh5120hThuhlBeI_sAB6brPAaPJ_guCKDVLKXA&oe=6AFB3DCC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maya Lingo", "keywords": [], "long_description": "Maya Lingo is a single-player language learning game with a heavy dose of excitement. Begin your guided vocabulary learning experience at your own pace. Choose from a wide selection of topics and learn proper pronunciation, spelling and meaning of thousands of vocabulary words. But don\u2019t get too complacent. As your knowledge advances so does the excitement. Suddenly words that were previously easy to recall become difficult as zombies and other\nthreats approach. Correctly translate the items and the threats are nothing but target practice. But if the pressure clouds your memory you\u2019re zombie meat.\nLearning a new language has never been more exciting as you engage in a scientifically-proven approach toward building your foreign language skills.", "short_description": "Maya Lingo is a  language learning game with a heavy dose of\nexcitement. Begin your guided vocabulary learning experience at your own pace. Choose from a wide selection of topics and learn proper pronunciation, spelling and meaning of thousands of vocabulary words. But don\u2019t get too complacent. As your knowledge advances so does the excitement. Suddenly words that were previously easy to recall become difficult as zombies and other threats approach"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jedburghco.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jedburgh Technology", "support_website_url": null, "website_url": "https://jedburghco.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1310205553118916"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7163085767118435", "version": "1.0.15.18"}, "id": "2737067743270933",
ng", "id": "141814854437268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031318_141814857770601_70486355492273055_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ujl7eUpxed4Q7kNvwF0WKS3&_nc_oc=Adr9PxA0sRFnO5D4_VqW-j49xYbAenaoJinFT21y-j0_ByNGCAsgl7MB-JoghZZoj3k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT49Cpr7Pd9VaeLAZc8h2vwG_GeBERa3P1gV6Cni8nzJQ&oe=6B01C2CA"}, {"file_name": "Screenshot5.png", "id": "170391724595205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031336_170391727928538_5199530013121476530_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQxlNFOOotcQ7kNvwH0hODK&_nc_oc=AdqmFOuI9ESwpx_Eie0CVB-nDp2Ji64kwRq4FZ1s87o17v8Uzb_sjAFuYTTonBGaiTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdZNTg-e9c8NBiqTXp6tR_rXwHC2eudjuNM-ERK11ejA&oe=6B01E31D"}, {"file_name": "Screenshot3.png", "id": "3442534709205475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610705_3442534712538808_962786057883004600_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR1y0UQut4UQ7kNvwEmFKKR&_nc_oc=AdokSXN98DUzyc7DbVmfLg4k_XEj3a1ozZzg1WgXurQGtK98HME0VX9sSUJrky40NAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaBW9_iIojIIajCMC6tJfra69qTr8C6htv1R4t1I5q0w&oe=6B01D54C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Maya Lingo", "keywords": [], "long_description": "Maya Lingo is a single-player language learning game with a heavy dose of excitement. Begin your guided vocabulary learning experience at your own pace. Choose from a wide selection of topics and learn proper pronunciation, spelling and meaning of thousands of vocabulary words. But don\u2019t get too complacent. As your knowledge advances so does the excitement. Suddenly words that were previously easy to recall become difficult as zombies and other\nthreats approach. Correctly translate the items and the threats are nothing but target practice. But if the pressure clouds your memory you\u2019re zombie meat.\nLearning a new language has never been more exciting as you engage in a scientifically-proven approach toward building your foreign language skills.", "short_description": "Maya Lingo is a  language learning game with a heavy dose of\nexcitement. Begin your guided vocabulary learning experience at your own pace. Choose from a wide selection of topics and learn proper pronunciation, spelling and meaning of thousands of vocabulary words. But don\u2019t get too complacent. As your knowledge advances so does the excitement. Suddenly words that were previously easy to recall become difficult as zombies and other threats approach"}]}, "developer_name": null, "developer_privacy_policy_url": "https://jedburghco.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Jedburgh Technology", "support_website_url": null, "website_url": "https://jedburghco.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1310205553118916"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7163085767118435", "version": "1.0.15.18"}, "id": "2737067743270933",
nd become the ultimate archer in realistic medieval environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "23898330833154202"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "2017659325782106"}, {"status": "PUBLISHED", "id": "4241769809416264"}, {"status": "PUBLISHED", "id": "1493914052091603"}, {"status": "PUBLISHED", "id": "1297704285662551"}, {"status": "PUBLISHED", "id": "1463907622067508"}, {"status": "PUBLISHED", "id": "25783756937948027"}, {"status": "PUBLISHED", "id": "1202349564703415"}, {"status": "PUBLISHED", "id": "2061678327926342"}, {"status": "PUBLISHED", "id": "803434475757211"}, {"status": "PUBLISHED", "id": "1143309860943817"}, {"status": "PUBLISHED", "id": "1774460403453611"}, {"status": "PUBLISHED", "id": "1034340925139627"}]}, "baseline_offer": {"id": "4241769809416264"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "2017659325782106"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
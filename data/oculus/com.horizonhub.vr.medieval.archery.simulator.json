n.com/v/t64.5771-25/499619174_2280566962390305_1979650059516109590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTLDxsmtECcQ7kNvwHir4oU&_nc_oc=AdkYhiWn9gXUTn9DxD4p3VzAMJbTm1y9ZeiUe_5aOAxA_jfXygtpA4UvvELFwaBIi-8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsU3qJ4nfDpqGqpN88jyZYFi6MB8_aKijyGBassEQKF2w&oe=699EF6D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Medieval Archery Simulator", "keywords": ["ArcherySimulator", "MedievalArcher", "ArcheryClash", "BowMaster", "ShootArchery"], "long_description": "Immerse yourself in the world of knights and castles with VR Medieval Archery Simulator, a realistic and thrilling virtual reality experience. Step into the boots of a medieval archer and put your skills to the test as you defend your fortress, hunt targets, and train with precision archery mechanics. With lifelike physics, stunning medieval landscapes, and intense combat scenarios, this game offers an authentic archery experience like never before. Whether you're practicing in the training grounds or battling waves of enemies, every shot counts. Sharpen your aim, upgrade your gear, and rise through the ranks to become a legendary archer in a beautifully crafted medieval world.", "short_description": "Step into a medieval world in this immersive VR archery simulator. Master your bow, defend your castle, and become the ultimate archer in realistic medieval environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_sub
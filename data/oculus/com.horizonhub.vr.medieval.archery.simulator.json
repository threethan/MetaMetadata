n.com/v/t64.5771-25/499619174_2280566962390305_1979650059516109590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9_DYeJO_igQ7kNvwGurgPc&_nc_oc=Admh3k1EVmjdTDKi9CigoRZOkynFPS9mZySh8kVZ6zZv-hm_kZEl7spNEE5Xr6EQI4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftdr9hDxh2zKYjo16bL2FZ6sgzdqDUiqAEtxVTMB0WzOQ&oe=69A43CD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Medieval Archery Simulator", "keywords": ["ArcherySimulator", "MedievalArcher", "ArcheryClash", "BowMaster", "ShootArchery"], "long_description": "Immerse yourself in the world of knights and castles with VR Medieval Archery Simulator, a realistic and thrilling virtual reality experience. Step into the boots of a medieval archer and put your skills to the test as you defend your fortress, hunt targets, and train with precision archery mechanics. With lifelike physics, stunning medieval landscapes, and intense combat scenarios, this game offers an authentic archery experience like never before. Whether you're practicing in the training grounds or battling waves of enemies, every shot counts. Sharpen your aim, upgrade your gear, and rise through the ranks to become a legendary archer in a beautifully crafted medieval world.", "short_description": "Step into a medieval world in this immersive VR archery simulator. Master your bow, defend your castle, and become the ultimate archer in realistic medieval environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_sub
"}, {"file_name": "Screenshot_2.png", "id": "944297521927780", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818852_944297528594446_4825418200700400321_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hjx9hFD4DQQ7kNvwF2i3Y-&_nc_oc=AdpP2JtgodEjAeyALkMRspfkcW3WpkhaICrJ22H0YkC5rgvrzvgIgpZ-uxDEF7oit-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aF-Agflb6uNFvsAbAcgT70lGCLs9x6XikQQYdD3ZXcA&oe=6A3FE6CC"}, {"file_name": "Screenshot_1.png", "id": "1676743963335740", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819845_1676743966669073_5424855291013989727_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCvIr4s-fAoQ7kNvwGEveyp&_nc_oc=AdroW0WdNUFj51D-ZDFHITR9gQAeNUvFOeWs-4Zs4g9qFlXRWb7RQW886GlVExah_uE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uBM0n7NqGbUw3IhmPlA3ONKSn75SSokeBNUdABAWeUg&oe=6A3FED53"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Medieval Archery Simulator", "keywords": ["ArcherySimulator", "MedievalArcher", "BowMaster", "ShootArchery", "Archery"], "long_description": "Immerse yourself in the world of knights and castles \ud83c\udff0 with VR Medieval Archery Simulator, a virtual reality experience focused on skill, precision, and exploration \ud83c\udfaf. Step into the role of a medieval archer \ud83c\udff9 and test your abilities as you defend your fortress, track targets, and practice archery techniques in a detailed environment.\nEngage with realistic bow mechanics \u2699\ufe0f that require timing, accuracy, and steady control. Aim carefully \ud83c\udfaf, adjust your shots, and improve consistency as you progress through different scenarios. From training grounds \ud83c\udff9 to defensive missions \ud83d\udee1\ufe0f, each activity helps refine your skills and understanding of archery.\nExplore visually rich medieval landscapes \ud83c\udf04 filled with castles, open fields, and immersive settings. Encounter varied challenges \u2694\ufe0f that encourage thoughtful strategy and precise aiming. Each session provides opportunities to improve and try different approaches.\nUpgrade your equipment \ud83d\udd27 to support your progress and adapt to new challenges. As your abilities develop \ud83d\udcc8, handle more complex situations and improve performance over time. The game offers a balanced experience where practice leads to steady improvement.\n\u2728 Features:\n\t\u2022\t\ud83c\udff9 Realistic VR archery mechanics with precise controls\n\t\u2022\t\ud83c\udff0 Medieval environments with castles and open landscapes\n\t\u2022\t\ud83c\udfaf Training modes and combat challenges\n\t\u2022\t\u2694\ufe0f Defensive gameplay with waves of enemies\n\t\u2022\t\ud83d\udd27 Equipment upgrades and progression system\n\t\u2022\t\ud83c\udfae Smooth controls with immersive interaction\n", "short_description": "Step into a medieval world \ud83c\udff0 with this immersive VR archery simulator \ud83c\udfaf, where you train your skills, defend your castle \ud83d\udee1\ufe0f, and take on engaging challenges. Use realistic bow mechanics \ud83c\udff9, aim with precision, and improve your technique in detailed medieval environments \ud83c\udf04. Practice in training grounds or face enemy waves \u2694\ufe0f while sharpening focus and control, and experience smooth, interactive gameplay \ud83c\udfae."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_co
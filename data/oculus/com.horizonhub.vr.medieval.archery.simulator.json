DGvfX4J0YSpJDQ&oe=69C521F8"}, {"file_name": "Screenshot_5.png", "id": "2280566959056972", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619174_2280566962390305_1979650059516109590_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3v0xNkawEAQ7kNvwE6XvAl&_nc_oc=AdoIMd3JOueRhl0QP2dNUFSzDBm4ltarMh5jurBqWzxqry5IoCO0h-WAKW_KUf7jJOQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMfW_gGHntuokhdmSvCXh0iiGXD96l9OPqq3XqPPH2uA&oe=69C53255"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Medieval Archery Simulator", "keywords": ["ArcherySimulator", "MedievalArcher", "ArcheryClash", "BowMaster", "ShootArchery"], "long_description": "Immerse yourself in the world of knights and castles with VR Medieval Archery Simulator, a realistic and thrilling virtual reality experience. Step into the boots of a medieval archer and put your skills to the test as you defend your fortress, hunt targets, and train with precision archery mechanics. With lifelike physics, stunning medieval landscapes, and intense combat scenarios, this game offers an authentic archery experience like never before. Whether you're practicing in the training grounds or battling waves of enemies, every shot counts. Sharpen your aim, upgrade your gear, and rise through the ranks to become a legendary archer in a beautifully crafted medieval world.", "short_description": "Step into a medieval world in this immersive VR archery simulator. Master your bow, defend your castle, and become the ultimate archer in realistic medieval environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonhub-privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Horizon Hub", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonhubcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "c
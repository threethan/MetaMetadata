o_trailer_thumbnail": null, "display_name": "Blumber", "keywords": ["blumber", "tower", "build", "cube", "heights"], "long_description": "Blumber is a rhythm game created to entertain everyone!\n\nDesigned as a tower building experience, the goal of Blumber is to place the block as close to the previous one while listening to various types of music in the background. Put yourself in a tiny hot air balloon or face heights at their finest while rotating around the tower. Complete the toughest achievements and receive special soundtracks for a reward! Become the best builder!\n\n\"Blumber is a must-have for every low poly fan!\"\n\n\"You'll be surprised how funny Blumber actually is.\"", "short_description": "Blumber is a rhythm game created to entertain everyone!\n\nDesigned as a tower building experience, the goal of Blumber is to place the block as close to the previous one while listening to various types of music in the background. The game consists of two play modes and offers in-game achievements.\n\n\"Blumber is a must-have for every low poly fan!\""}]}, "developer_name": "Antoan Georgiev", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Georgieff Studio", "support_website_url": null, "website_url": "https://www.facebook.com/Blumber-2334107643330989", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FLYING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2752309808406171"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED",
8018821517297_4816076893499424768_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5OMgNkppusQ7kNvwEQ9U13&_nc_oc=Adro3LTLE9HJsemksYbk9vIQ2C5D5hCq5gOLs6-yGtBujBTgoHPTTV-SK0DcDrbx4JI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_Nvczb0fbQHdc5mm5B4niVOJpQN3Cxi3polThQE2IoQ&oe=6AB7BFB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blumber", "keywords": ["blumber", "tower", "build", "cube", "heights"], "long_description": "Blumber is a rhythm game created to entertain everyone!\n\nDesigned as a tower building experience, the goal of Blumber is to place the block as close to the previous one while listening to various types of music in the background. Put yourself in a tiny hot air balloon or face heights at their finest while rotating around the tower. Complete the toughest achievements and receive special soundtracks for a reward! Become the best builder!\n\n\"Blumber is a must-have for every low poly fan!\"\n\n\"You'll be surprised how funny Blumber actually is.\"", "short_description": "Blumber is a rhythm game created to entertain everyone!\n\nDesigned as a tower building experience, the goal of Blumber is to place the block as close to the previous one while listening to various types of music in the background. The game consists of two play modes and offers in-game achievements.\n\n\"Blumber is a must-have for every low poly fan!\""}]}, "developer_name": "Antoan Georgiev", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Georgieff Studio", "support_website_url": null, "website_url": "https://www.facebook.com/Blumber-2334107643330989", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "FLYING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "reco
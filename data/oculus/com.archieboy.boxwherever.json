t=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBfJu9yizmBjEwsS5FiZPwsNzSy6f6oYBv_c22E5-3Iw&oe=6B048783"}, {"file_name": "boxwherever-gameplay-02-tropical-gloves.png", "id": "1526193435108613", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_1526193438441946_9049000130621220769_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiTIOyo8J40Q7kNvwHgRmWx&_nc_oc=AdrW6timwJARY3sncxde55cq_2_mmp_-vtgcbsxOUpkRj7C9QHTBRJVNTnfOIHSmTgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFqURhVhnXZtRCOSUR9a66MgRzZ9lczQbUgiYvRhodcw&oe=6B04732C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxWherever", "keywords": ["boxing", "fitness", "workout", "music", "travel"], "long_description": "Box to your music, wherever you want to be.\n\nBoxWherever turns a supported DRM-free song from your personal library into a customized VR boxing workout. Choose a compatible real-world 360 scene, set the exact view you want to face when the music begins, adjust the intensity, then step into the round on Meta Quest.\n\nStart quickly with automatic beat-locked choreography, or use the private browser-based Studio to edit the workout beat by beat. Place left and right jabs, uppercuts, hooks and body shots, plus blocks and ducks, directly on the song timeline. Pair your headset once and your ready workout library appears in VR.\n\nFeatures include an original training workout, automatic workout generation, precise timeline editing, real-world Google Street View scenes, private user-uploaded 360 panoramas, opening-view selection, intensity and punch preferences, height calibration, in-headset song selection and end-of-round results.\n\nInternet connection and a free BoxWherever.com account are required for custom workouts. Commercial music is not included. Subscription downloads from streaming services are not compatible; upload only supported DRM-free audio you are authorized to use.\n\nBoxWherever is exercise software, not medical advice. Clear your play space, wear controller wrist straps, choose a comfortable intensity and stop if you feel pain, dizziness or nausea.", "short_description": "Turn music you own into beat-locked VR boxing workouts set in meaningful real-world 360 scenes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxwherever.com/privacy", "developer_terms_of_service_url": "https://boxwherever.com/terms", "publisher_name": "Archieboy Holdings, LLC", "support_website_url": "https://boxwherever.com/support", "website_url": "https://boxwherever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1738086590558368"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1568045178004725"}]}, "baseline_offer": {"id": "1568045178004725"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785334920, "status": "PUBLISHED", "id": "1568045178004725"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1838733120493714", "version": "0.180.0"}, "id": "1390893219581606", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1838733120493714"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "Seated Mode is now easy to spot: an amber badge on the main menu (tap it to turn Seated Mode off), plus a reminder in the countdown and on the pause screen. Fewer accidental exits: on the pause screen, hold Y for a second to return to the menu; during a song, restart (hold X) and quit (hold Y) now need a two-second hold, so quick Undo Miss taps never trigger them. Apply + Restart now keeps your streak.", "created_date": 1794493716, "id": "1838733120493714", "version": "0.180.0", "version_code": 180, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1838733120493714"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "Hands-only play: the left-hand menu pinch now works. Turn your left palm toward you and pinch your thumb and index finger to pause or resume a song. A left hook no longer pauses by mistake.", "created_date": 1794351568, "id": "1836980017335691", "version": "0.179.0", "version_code": 179, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1838733120493714"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "Solid new turn arrows on the loading screen, and BoxWherever is now ready for Meta's upcoming VR glasses: on a narrower display the menu, turn cues and credits adjust automatically. Quest play is unchanged.", "created_date": 1794331393, "id": "1836734897360203", "version": "0.178.0", "version_code": 178, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1838733120493714"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "New look: glossy leather gloves, glass targets that reflect the scene around you, glowing portal and target rims, a smoked-glass platform with footprint outlines and soft shadows, and deep-blue dodge bars. Fixes a start-up problem where the workout could begin off to one side if the headset had just woken up.", "created_date": 1794323273, "id": "1836625354037824", "version": "0.177.0", "version_code": 177, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1838733120493714"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "The portal now doubles as a song timer. Its inner white ring turns green from 12 o'clock, one second at a time, and the green is back at the top when the song ends. First-time training now notices when you are using your hands instead of controllers and explains the hand controls as it goes.", "created_date": 1793974781, "id": "1832304741136552", "version": "0.175.0", "version_code": 175, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
=6e7a0a&_nc_ohc=b-aS_oBTc2AQ7kNvwGW6tm6&_nc_oc=AdoXFTDuLY25XZEaDZOgIpYM3ubMOLLulUTaNFociwg916bewRvHXXmweZr8r4FoWt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShyyfg4ibIahOkggUYN6IcHAzqwS2qLY9a5H5q8JAmJg&oe=6B048022"}, {"file_name": "boxwherever-gameplay-05-snow-target.png", "id": "1054732093735073", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310734_1054732100401739_8717732184598559900_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnCv4NJ_gZEQ7kNvwGaleFo&_nc_oc=AdqdGhnNbnEr1exOBJnUaN5KaeGNKPkBx6gR082_-MYXQt_aO_CVScyIXNhKsIUxp0A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTswdruU8uFE9ygAw7Mq-N7QQIYUYysPe_oA2zVNVlTFA&oe=6B04548D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BoxWherever-Meta-Store-Trailer-Cover-2560x1440.png", "id": "27863681023270295", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627379_27863681033270294_4907240087318842558_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YbUkhLxKJwQ7kNvwGSgrR-&_nc_oc=AdpNFhqCF4myt5drakW2Sa7rbdTdJVYZUboizfp34zuKe8L8gRPyQ-0pYuZrsB8rTNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvIdgDDdFBvdE30tmswE2Ye7QBsEX_-JjfLME0s5WhJA&oe=6B046695"}, "display_name": "BoxWherever", "keywords": ["boxing", "fitness", "workout", "music", "travel"], "long_description": "Box to your music, wherever you want to be.\n\nFive original BoxWherever songs come included, ready to play the moment you put on your headset, with no account needed. Each one is a full boxing round set in a real place: Monument Valley, Hadrian's Wall, the Cotswolds, the Seychelles and the Swiss Alps.\n\nPlay with controllers or with just your hands. With Quest hand tracking your hands become the gloves, and you point and pinch to pick songs, pause and set heights. Seated Mode lets you work out from a chair: no ducking, no turning, and every target stays in front of you.\n\nTry it free for 30 minutes before you buy.\n\nThen make it yours. Add a song you own at BoxWherever.com and it becomes a beat-locked workout, with jabs, hooks, uppercuts, body shots, blocks, ducks and side dodges timed to the music. Pick a compatible Google Street View location or upload your own 360 photo, choose the view you face, set the intensity, and edit any beat in the private browser Studio. Pair your headset once and your workouts appear in VR.\n\nBoxWherever needs an internet connection. Your own workouts also need a free BoxWherever.com account and DRM-free audio you are authorized to use; songs downloaded through streaming subscriptions will not work, and commercial music is not included.\n\nBoxWherever is exercise software, not medical advice. Clear your play space, wear the wrist straps if you use controllers, choose a comfortable intensity and stop if you feel pain, dizziness or nausea.", "short_description": "Box to your own music inside real places around the world. Five songs included. Play with controllers or just your hands, standing or seated."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxwherever.com/privacy", "developer_terms_of_service_url": "https://boxwherever.com/terms", "publisher_name": "Archieboy Holdings, LLC", "support_website_url": "https://boxwherever.com/support", "website_url": "https://boxwherever.com/?utm_source=meta_store&utm_medium=store_listing&utm_campaign=idea-1815da6b25", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH",
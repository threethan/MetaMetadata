d3-2.oculuscdn.com/v/t64.5771-25/499311597_1406071668095468_4965835750201658271_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jDi_Kuh8k8Q7kNvwG_Q3U7&_nc_oc=AdqSjVmVg-IJdJUCQ2Vxp4Mb4Rzsu302VLg5i5hCtm-YdPF73fP6AhbBNzDS_zXxC4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFD9pm_tiNhNGrgSqVyE1KtzrQPyWLG5bNF-HDG3RMGjQ&oe=6A79E1C3"}, {"file_name": "boxwherever-gameplay-02-tropical-gloves.png", "id": "1526193435108613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1526193438441946_9049000130621220769_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyBMIJEtRJ0Q7kNvwGdDj_W&_nc_oc=AdotTM5cueL5gjIb_FHl_HtemM6nZVtUqut5cyrFGhwLr5wZB0CQBISnnghqtXEw8TY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeSLbSV77jjQDBCJK0V6pQ_sbcnSFZp3vARRjZ5UcXHg&oe=6A79CD6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxWherever", "keywords": ["boxing", "fitness", "workout", "music", "travel"], "long_description": "Box to your music, wherever you want to be.\n\nBoxWherever turns a supported DRM-free song from your personal library into a customized VR boxing workout. Choose a compatible real-world 360 scene, set the exact view you want to face when the music begins, adjust the intensity, then step into the round on Meta Quest.\n\nStart quickly with automatic beat-locked choreography, or use the private browser-based Studio to edit the workout beat by beat. Place left and right jabs, uppercuts, hooks and body shots, plus blocks and ducks, directly on the song timeline. Pair your headset once and your ready workout library appears in VR.\n\nFeatures include an original training workout, automatic workout generation, precise timeline editing, real-world Google Street View scenes, private user-uploaded 360 panoramas, opening-view selection, intensity and punch preferences, height calibration, in-headset song selection and end-of-round results.\n\nInternet connection and a free BoxWherever.com account are required for custom workouts. Commercial music is not included. Subscription downloads from streaming services are not compatible; upload only supported DRM-free audio you are authorized to use.\n\nBoxWherever is exercise software, not medical advice. Clear your play space, wear controller wrist straps, choose a comfortable intensity and stop if you feel pain, dizziness or nausea.", "short_description": "Turn music you own into beat-locked VR boxing workouts set in meaningful real-world 360 scenes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxwherever.com/privacy", "developer_terms_of_service_url": "https://boxwherever.com/terms", "publisher_name": "Archieboy Holdings, LLC", "support_website_url": "https://boxwherever.com/support", "website_url": "https://boxwherever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1738086590558368"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310646_2059885377949211_7728696074023593299_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vwbvx6ZuuF8Q7kNvwFBeAEa&_nc_oc=AdpDCDJC6i5dtGLsZXSlz7e11KsE-kvBryPg2TvQ6j32n1dkntnCRmOfl31rM-7_WTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9NSxgQFdcar7zWOV9XDpavJ2Bq4vLSZfSFEVzaJPdZQ&oe=6A79E2E1"}, 
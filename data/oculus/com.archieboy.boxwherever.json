-panorama.png", "id": "1378514190830448", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308050_1378514194163781_634241311142841081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW6pJwXnwvwQ7kNvwHPV6pC&_nc_oc=AdqFA1cxMNqkr6q5ClQ8pKsG3JFN4LlThWoBozgaj5ApD3zqiPf8FRWt1lxhK6HtdMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQhyWsTQamqIepo_bVUEPlbLQimc_FwjW4DoXjeB2seA&oe=6AEF32F0"}, {"file_name": "boxwherever-gameplay-05-snow-target.png", "id": "1054732093735073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1054732100401739_8717732184598559900_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lx129H-ay_4Q7kNvwHi0viE&_nc_oc=Adrr5RmaSCHLA71Ca8hhYlKp5PAEnr0f1aoCN9idrLdZT0rnlPkORHGHklKKSoQ0YBc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9VwyGmQwGHcVCwlc-l1pQm61n0CJIAr6uZyG8T-eegQ&oe=6AEF3C8D"}, {"file_name": "boxwherever-gameplay-03-tropical-portal.png", "id": "1406071664762135", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499311597_1406071668095468_4965835750201658271_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMHhp5AMyiYQ7kNvwElnahP&_nc_oc=AdotR57-7OmLO51YENRnsAVMleQ0IR5K_myAPrWAzGY1dy-dD1zqyQDPMdSVgZ-GmzQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS31v60xFwkFRKMJf63jFLrY2I76986IMuU5gTicNFLfw&oe=6AEF3743"}, {"file_name": "boxwherever-gameplay-02-tropical-gloves.png", "id": "1526193435108613", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310731_1526193438441946_9049000130621220769_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AkOPar9idB0Q7kNvwG_5eKM&_nc_oc=Adoe3ke50QiilgyCTy1dssRzNVduJPmqogfpUlCNuQZlVMyN2vN_xbKSz2WnAsCIu_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAvy0FaPzgKHC3H4Y4WR9QOkJbVbijbEACcEfQKDRMrA&oe=6AEF5B2C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxWherever", "keywords": ["boxing", "fitness", "workout", "music", "travel"], "long_description": "Box to your music, wherever you want to be.\n\nBoxWherever turns a supported DRM-free song from your personal library into a customized VR boxing workout. Choose a compatible real-world 360 scene, set the exact view you want to face when the music begins, adjust the intensity, then step into the round on Meta Quest.\n\nStart quickly with automatic beat-locked choreography, or use the private browser-based Studio to edit the workout beat by beat. Place left and right jabs, uppercuts, hooks and body shots, plus blocks and ducks, directly on the song timeline. Pair your headset once and your ready workout library appears in VR.\n\nFeatures include an original training workout, automatic workout generation, precise timeline editing, real-world Google Street View scenes, private user-uploaded 360 panoramas, opening-view selection, intensity and punch preferences, height calibration, in-headset song selection and end-of-round results.\n\nInternet connection and a free BoxWherever.com account are required for custom workouts. Commercial music is not included. Subscription downloads from streaming services are not compatible; upload only supported DRM-free audio you are authorized to use.\n\nBoxWherever is exercise software, not medical advice. Clear your play space, wear controller wrist straps, choose a comfortable intensity and stop if you feel pain, dizziness or nausea.", "short_description": "Turn music you own into beat-locked VR boxing workouts set in meaningful real-world 360 scenes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxwherever.com/privacy", "developer_terms_of_service_url": "https://boxwherever.com/terms", "publisher_name": "Archieboy Holdings, LLC", "support_website_url": "https://boxwherever.com/support", "website_url": "https://boxwherever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1738086590558368"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1568045178004725"}]}, "baseline_offer": {"id": "1568045178004725"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785334920, "status": "PUBLISHED", "id": "1568045178004725"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1808239126876447", "version": "0.173.0"}, "id": "1390893219581606", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1808239126876447"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "When your chosen scene can't load and the default canyon scene stands in, the portal now stays within 90 degrees either side of you instead of circling all the way around. Small improvements and fixes.", "created_date": 1791810999, "id": "1808239126876447", "version": "0.173.0", "version_code": 173, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1808239126876447"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "Hands mode improvements: pinch the new Scroll up and Scroll down buttons to page through your song library without controllers, and turn your left palm toward you and pinch to leave a song that is taking too long to load. Controller play is unchanged.", "created_date": 1790883977, "id": "1798621451171548", "version": "0.171.0", "version_code": 171, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1808239126876447"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "Box without controllers: BoxWherever now supports hand tracking. Point with Meta's hand laser and pinch to choose, and pinch with your left palm toward you to pause. New Seated Mode in the Accessibility section of the main menu: no ducking, no turning and no stance switches, so you can box from a chair. New players can play all five included songs before pairing an account. Controller play is unchanged.", "created_date": 1790876487, "id": "1798534631180230", "version": "0.170.0", "version_code": 170, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1808239126876447"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "Street View scenes now always load at full resolution. When Google's servers are slow, the headset waits longer, shows a message that it is still trying, retries once, and loads the default scene only if the panorama cannot be reached.", "created_date": 1790427615, "id": "1793574275009599", "version": "0.166.0", "version_code": 166, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1738086587225035", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1808239126876447"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1390893219581606"}]}, "change_log": "In a workout, your streak now carries over from one song to the next, and ends only when you miss or start a new workout. Downloads on slower connections no longer give up on a fixed timer: they keep going as long as they are making progress, and a slow connection is sent a lighter panorama so the song starts on time. Panoramas stay sharp on normal connections.", "created_date": 1790250930, "id": "1791605198539840", "version": "0.165.0", "version_code": 165, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
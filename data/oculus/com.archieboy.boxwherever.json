ropical-gloves.png", "id": "1526193435108613", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1526193438441946_9049000130621220769_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-9cYsMhPUgQ7kNvwEwniJK&_nc_oc=AdppCf742W-22w-yYAT87-JZh3PDsHFo_5QCWjbGMO8KCA01tJu4RN2VNcsyPbU-ZtY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP278ESDe8UqzE7Az0sWsclsVWDFXvHHO07Ox1iQppiA&oe=6ABE5B6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BoxWherever-Meta-Store-Trailer-Cover-2560x1440.png", "id": "27863681023270295", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499627379_27863681033270294_4907240087318842558_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMWlTDociq8Q7kNvwEzpxz3&_nc_oc=AdrmuyxTWLarKTdVwKnDRULM0e07FfGZtFJHM5a-s11V9HnpIpIZNcty1sYRY5cYX4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU29nSZwhbcN58cBvWa3lMj1grCcgWKdTTWsakxMYGPQ&oe=6ABE8715"}, "display_name": "BoxWherever", "keywords": ["boxing", "fitness", "workout", "music", "travel"], "long_description": "Box to your music, wherever you want to be.\n\nBoxWherever turns a supported DRM-free song from your personal library into a customized VR boxing workout. Choose a compatible real-world 360 scene, set the exact view you want to face when the music begins, adjust the intensity, then step into the round on Meta Quest.\n\nStart quickly with automatic beat-locked choreography, or use the private browser-based Studio to edit the workout beat by beat. Place left and right jabs, uppercuts, hooks and body shots, plus blocks and ducks, directly on the song timeline. Pair your headset once and your ready workout library appears in VR.\n\nFeatures include an original training workout, automatic workout generation, precise timeline editing, real-world Google Street View scenes, private user-uploaded 360 panoramas, opening-view selection, intensity and punch preferences, height calibration, in-headset song selection and end-of-round results.\n\nInternet connection and a free BoxWherever.com account are required for custom workouts. Commercial music is not included. Subscription downloads from streaming services are not compatible; upload only supported DRM-free audio you are authorized to use.\n\nBoxWherever is exercise software, not medical advice. Clear your play space, wear controller wrist straps, choose a comfortable intensity and stop if you feel pain, dizziness or nausea.", "short_description": "Turn music you own into beat-locked VR boxing workouts set in meaningful real-world 360 scenes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxwherever.com/privacy", "developer_terms_of_service_url": "https://boxwherever.com/terms", "publisher_name": "Archieboy Holdings, LLC", "support_website_url": "https://boxwherever.com/support", "website_url": "https://boxwherever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1749272946106399"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310646_2059885377949211_7728696074023593299_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7htW8v1_K90Q7kNvwFGGG3C&_nc_oc=Ado2XH1wYyY0Vy3XmB4z1e89iuHngh6GeHS6B6Sz9qayLm1VGKyB_f8igv0Yi7Qcknc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_
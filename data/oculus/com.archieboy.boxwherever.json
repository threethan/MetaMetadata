ver-gameplay-04-tropical-panorama.png", "id": "1378514190830448", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308050_1378514194163781_634241311142841081_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKJs9E5dJ4oQ7kNvwHd_tHm&_nc_oc=AdrCEbjZfvhvQO3cOumhVzeAbpyN8X1OIaPEL7kIY2FfSVwtEfcLV_tTh3IGUBswYCM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEETME_nqvEy1YomxOWWdlrlsowI7FiYXDVwRRq009Oyw&oe=6A749770"}, {"file_name": "boxwherever-gameplay-05-snow-target.png", "id": "1054732093735073", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310734_1054732100401739_8717732184598559900_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3rBC84FYq8Q7kNvwHJf-GG&_nc_oc=AdqVOmm_r3a7KshM-gs11S704rNe7WSlqSImayi44RYZLoCM4D6-VWjGck69j8Qp7g4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1LEigbkWWBcGMDWW0EdMhEvQGBEEC1kBtW_5JzkOaJw&oe=6A74A10D"}, {"file_name": "boxwherever-gameplay-03-tropical-portal.png", "id": "1406071664762135", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311597_1406071668095468_4965835750201658271_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ot39m0DK9lMQ7kNvwFHG50m&_nc_oc=AdrfTeAX0P7dtRdqZ2Fd4DaPHbe40MSHRLeh5tJG3veXpYYanbCFM_wXmSrgbkBHLjY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxFJT9p6Zxq105CKZVogHLnr0qrUU4AgVE4V3_xzeLNw&oe=6A749BC3"}, {"file_name": "boxwherever-gameplay-02-tropical-gloves.png", "id": "1526193435108613", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310731_1526193438441946_9049000130621220769_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK6co4QDWnEQ7kNvwEVYb6-&_nc_oc=AdoNAP7p7TfRB678r18E4Cy9mg6tWJx0o2mROgyoKfnwvKAF4GadGxa38ELfM08Ey1U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmeLmvbhmsbD3mLreh2qVfFOHqAQAuMkTXgjenK_tq3A&oe=6A74876C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BoxWherever", "keywords": ["boxing", "fitness", "workout", "music", "travel"], "long_description": "Box to your music, wherever you want to be.\n\nBoxWherever turns a supported DRM-free song from your personal library into a customized VR boxing workout. Choose a compatible real-world 360 scene, set the exact view you want to face when the music begins, adjust the intensity, then step into the round on Meta Quest.\n\nStart quickly with automatic beat-locked choreography, or use the private browser-based Studio to edit the workout beat by beat. Place left and right jabs, uppercuts, hooks and body shots, plus blocks and ducks, directly on the song timeline. Pair your headset once and your ready workout library appears in VR.\n\nFeatures include an original training workout, automatic workout generation, precise timeline editing, real-world Google Street View scenes, private user-uploaded 360 panoramas, opening-view selection, intensity and punch preferences, height calibration, in-headset song selection and end-of-round results.\n\nInternet connection and a free BoxWherever.com account are required for custom workouts. Commercial music is not included. Subscription downloads from streaming services are not compatible; upload only supported DRM-free audio you are authorized to use.\n\nBoxWherever is exercise software, not medical advice. Clear your play space, wear controller wrist straps, choose a comfortable intensity and stop if you feel pain, dizziness or nausea.", "short_description": "Turn music you own into beat-locked VR boxing workouts set in meaningful real-world 360 scenes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://boxwherever.com/privacy", "developer_terms_of_service_url": "https://boxwherever.com/terms", "publisher_name": "Archieboy Holdings, LLC", "support_website_url": "https://boxwherever.com/support", "website_url": "https://boxwherever.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "co
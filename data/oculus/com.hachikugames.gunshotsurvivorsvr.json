and power up your initial stats.\nWhether you choose to compensate for your weaknesses or enhance your strengths, feel free to mix and match according to your own playstyle.", "short_description": "Gunshot Survivors VR is a VR roguelike shooter where you upgrade your gun and defeat enemies to survive. Build the ultimate gun and defeat the robot swarm!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gunshot-survivors-vr.hachikugames.workers.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HachiKuGames", "support_website_url": null, "website_url": "https://gunshot-survivors-vr.hachikugames.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25569450182681891"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1463521655615697"}]}, "baseline_offer": {"id": "1463521655615697"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790848680, "status": "PUBLISHED", "id": "1463521655615697"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28305852809041601", "version": "1.0.1"}, "id": "906113155155029", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applica
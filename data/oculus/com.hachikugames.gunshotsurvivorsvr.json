}, {"file_name": "Screenshot4.png", "id": "1411466654511442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623185_1411466657844775_718290644390583918_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPpeZ5QzwTUQ7kNvwH_NF0q&_nc_oc=AdoiVC_goeoyAYbFHDyWxou0O5f-7s47sKbEk02dEzUNWYbJMwpIXySUH8wpBkuDCVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFaXhynfjWvXlEXbOHDGn8iky0kVIEFQkfPrSS9O6VLA&oe=6AF8AD8B"}, {"file_name": "Screenshot5.png", "id": "862681293505993", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620666_862681296839326_363260630937164554_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYefHhznRRMQ7kNvwGfu0nH&_nc_oc=Adq0H6StVlRItPCo-Tn8J-NHja64SF5y_9ScoKGULomLXgCf3gkLALFFxogfBruQtic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLXnRTYR8Sh63pq8cD2rsnm9g7p3rMBUBbXMDlh_Qu9w&oe=6AF89FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaLandscapeCover.png", "id": "2133162760656971", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623512_2133162763990304_7986762140265509599_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7NIrsGfZrUQ7kNvwE9IWAC&_nc_oc=Adq3i3QtAS6wtwWgnLz1Lj4em8TH486pN--ZJHqHUo9vkE81L_ZwHZ93V4xzy3JXLq8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwLRQMwXINZFCI83RiJCzPYiVf17rq44Sw9C72PKLXsw&oe=6AF87984"}, "display_name": "Gunshot Survivors VR", "keywords": ["Roguelite", "Shooter"], "long_description": "# About This Game\nGunshot Survivors VR is a VR roguelike shooter where you upgrade your gun and defeat enemies to survive.\n\nBuild the ultimate gun and defeat the robot swarm!\n\n# GAMEPLAY\nEach wave lasts 30 to 60 seconds. Survive all 12 waves in a single run.\nShoot down enemies attacking from all directions and use dashes to evade them.\n\n# BOSS BATTLE\nEvery certain number of WAVEs, a boss battle different from regular battles occurs.\nEach boss has unique characteristics and unleashes powerful attacks.\nAnd when you defeat the boss, you can get special upgrades, so aim to take it down.\n\n# UPGRADE\nWhen WAVE ends, you can spend the energy gained from defeating enemies to buy upgrades.\nCombining the same upgrades can make them stronger.\n\n# PERMANENT UPGRADE\nUpon completing the run, you can obtain gems.\nUse gems to get permanent upgrades and power up your initial stats.\nWhether you choose to compensate for your weaknesses or enhance your strengths, feel free to mix and match according to your own playstyle.", "short_description": "Gunshot Survivors VR is a VR roguelike shooter where you upgrade your gun and defeat enemies to survive. Build the ultimate gun and defeat the robot swarm!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gunshot-survivors-vr.hachikugames.workers.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HachiKuGames", "support_website_url": null, "website_url": "https://gunshot-survivors-vr.hachikugames.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25569450182681891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620669_1597889805205825_8355719011338682664_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrPOsy6_06MQ7kNvwGl4Jse&_nc_oc=AdoaQtzr3MOuqVMX2Oc7jXhOZYLW2tTiWsmh9xK0YvPkb2z0h0kYIgv9cMsKEQpibaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr9cZnZQhfOQVL8PWU04Sf38jBUTrFGNjx_RRjCltblw&oe=6AF88CE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gunshot Survivors VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1790848680, "lastRevision": {"nodes": [{"id": "25569450236015219", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25569450162681893", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "3418637551651019"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2324919878347403", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaLandscapeCover.png", "id": "1639923661078769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624619_1639923664412102_2466902920821530065_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIN-Vl9-VssQ7kNvwHoKxSP&_nc_oc=Adot6I25aZxAH8RGZUoSp9AX-fDAXf2JdmAQ4T52Dg5SicmFBClKS35G2UUAm6J_1s8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLHRPgtz0Ni_B923e8JDXOgwazpgTqRktA8O8K4ANR7Q&oe=6AF88F13"}, "display_name": "Gunshot Survivors VR", "keywords": ["\u30ed\u30fc\u30b0\u30e9\u30a4\u30c8", "\u30ac\u30f3\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0"], "long_description": "# \u3053\u306e\u30b2\u30fc\u30e0\u306b\u3064\u3044\u3066\nGunshot Survivors VR\u306f\u3001\u9283\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u306a\u304c\u3089\u6575\u3092\u5012\u3057\u3066\u751f\u304d\u6b8b\u308b\u3001VR\u30ed\u30fc\u30b0\u30e9\u30a4\u30c8\u30ac\u30f3\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u6b21\u3005\u3068\u73fe\u308c\u308b\u30ed\u30dc\u30c3\u30c8\u306b\u5bfe\u6297\u3059\u308b\u305f\u3081\u306b\u6700\u9ad8\u306e\u9283\u3092\u4f5c\u308a\u4e0a\u3052\u308d\uff01\n\n# \u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\n1WAVE\u304c30\u79d2\uff5e60\u79d2\u306e\u30d0\u30c8\u30eb\u3092\u884c\u3044\u3001\uff11\u56de\u306e\u30e9\u30f3\u3067\u516812WAVE\u306e\u30d0\u30c8\u30eb\u3092\u751f\u304d\u5ef6\u3073\u307e\u3057\u3087\u3046\u3002\n\u56db\u65b9\u516b\u65b9\u304b\u3089\u8972\u3063\u3066\u304f\u308b\u6575\u3092\u9283\u3067\u5012\u3057\u3001\u30c0\u30c3\u30b7\u30e5\u3092\u99c6\u4f7f\u3057\u3066\u6575\u304b\u3089\u9003\u3052\u305f\u308a\u3057\u307e\u3057\u3087\u3046\u3002\n\n# \u767d\u71b1\u306e\u30dc\u30b9\u30d0\u30c8\u30eb\n\u4e00\u5b9aWAVE\u6bce\u306b\u901a\u5e38\u306e\u30d0\u30c8\u30eb\u3068\u306f\u9055\u3046\u30dc\u30b9\u30d0\u30c8\u30eb\u304c\u767a\u751f\u3057\u307e\u3059\u3002\n\u30dc\u30b9\u6bce\u306b\u7279\u5fb4\u304c\u7570\u306a\u308a\u3001\u5f37\u529b\u306a\u653b\u6483\u3092\u3057\u3066\u304d\u307e\u3059\u3002\n\u305d\u3057\u3066\u3001\u30dc\u30b9\u3092\u5012\u3059\u3068\u901a\u5e38\u3067\u306f\u624b\u306b\u5165\u3089\u306a\u3044\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u624b\u306b\u5165\u308c\u308b\u4e8b\u304c\u3067\u304d\u308b\u306e\u3067\u6483\u7834\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002\n\n# \u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\nWAVE\u304c\u7d42\u4e86\u3059\u308b\u3068\u3001\u6575\u306e\u6483\u7834\u3067\u624b\u306b\u5165\u308c\u305f\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u6d88\u8cbb\u3057\u3066\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\n\u540c\u3058\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u4e8b\u3067\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u5f37\u304f\u3067\u304d\u307e\u3059\u3002\n\n# \u6c38\u7d9a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\n1\u56de\u306e\u30e9\u30f3\u304c\u7d42\u4e86\u3059\u308b\u3068\u3001\u30b8\u30a7\u30e0\u3092\u624b\u306b\u5165\u308c\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059\u3002\n\u30b8\u30a7\u30e0\u3092\u4f7f\u3063\u3066\u6c38\u7d9a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u624b\u306b\u5165\u308c\u3066\u3001\u30e9\u30f3\u306e\u521d\u671f\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3059\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059\u3002\n\u82e6\u624b\u306a\u90e8\u5206\u3092\u88dc\u3046\u304b\u3001\u5f97\u610f\u306a\u90e8\u5206\u3092\u4f38\u3070\u3059\u304b\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u306b\u5408\u308f\u305b\u3066\u81ea\u7531\u306b\u7d44\u307f\u5408\u308f\u305b\u307e\u3057\u3087\u3046\u3002", "short_description": "Gunshot Survivors VR\u306f\u3001\u9283\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u306a\u304c\u3089\u6575\u3092\u5012\u3057\u3066\u751f\u304d\u6b8b\u308b\u3001VR\u30ed\u30fc\u30b0\u30e9\u30a4\u30c8\u30ac\u30f3\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3059\u3002\u6b21\u3005\u3068\u73fe\u308c\u308b\u30de\u30b7\u30f3\u306b\u5bfe\u6297\u3059\u308b\u305f\u3081\u306b\u6700\u9ad8\u306e\u30d3\u30eb\u30c9\u3092\u4f5c\u308a\u4e0a\u3052\u308d\uff01"}, {"images": {"nodes": [{"file_name": "MetaLandscapeCover.png", "id": "2887354668286067", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623115_2887354671619400_3420216390860577381_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Famz4FrKKFIQ7kNvwHOLr4S&_nc_oc=AdppN94bwa9uPB-RsRbD5CP7_FRfBplN7Kp_J55q79KdnLNkqyqhUFHgFymJVPJ40bk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjkXTh6w8qnWqKXrFLKj4B3cNcjO8vfGolLPtbiTdCGA&oe=6AF89CD8"}, {"file_name": "AppIcon.png", "id": "2146541275926839", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622188_2146541279260172_8809651365995023459_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lU5bTMiST3kQ7kNvwEi7GLw&_nc_oc=Adop7dtc5Y3R
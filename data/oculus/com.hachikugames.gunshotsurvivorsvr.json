}, {"file_name": "Screenshot4.png", "id": "1411466654511442", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623185_1411466657844775_718290644390583918_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cew7W1FwNPsQ7kNvwELut8S&_nc_oc=AdqMe0XcsGP4yVGNwDSHeIQQ5AOr6wAZJ1UHwVOjCvPI8MCLFmxGwcW8IV7Twjtfngo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFge4LkEUrfouoxczKgW68QDcqKJgkCOrcAjqtVgzxpw&oe=6AF1DDCB"}, {"file_name": "Screenshot5.png", "id": "862681293505993", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620666_862681296839326_363260630937164554_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJaNYgXuj6MQ7kNvwHEK1nN&_nc_oc=AdqxQoKACChMBrYb_KgfwBsMl5C2R4Q1GtvFV8O932WS_uA6X-9lJ9v3s37u1cbstlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBK3soIUgcxfjH8j3c4Iq1Oo2ztAua8I8rRy9TH34_ww&oe=6AF20857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaLandscapeCover.png", "id": "2133162760656971", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623512_2133162763990304_7986762140265509599_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pf_HlGGKtAAQ7kNvwEC5sH2&_nc_oc=AdqBG4B2gXOsc0rUFu3jNBqR6cQ080Guki9QRpFo5dsBGanT70R4isM-kfhCj3TaSRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShWqqThtzwOqCf5tcAk6ilh5_p-G90rZDa4Tb5MEF4xw&oe=6AF1E204"}, "display_name": "Gunshot Survivors VR", "keywords": ["Roguelite", "Shooter"], "long_description": "# About This Game\nGunshot Survivors VR is a VR roguelike shooter where you upgrade your gun and defeat enemies to survive.\n\nBuild the ultimate gun and defeat the robot swarm!\n\n# GAMEPLAY\nEach wave lasts 30 to 60 seconds. Survive all 12 waves in a single run.\nShoot down enemies attacking from all directions and use dashes to evade them.\n\n# BOSS BATTLE\nEvery certain number of WAVEs, a boss battle different from regular battles occurs.\nEach boss has unique characteristics and unleashes powerful attacks.\nAnd when you defeat the boss, you can get special upgrades, so aim to take it down.\n\n# UPGRADE\nWhen WAVE ends, you can spend the energy gained from defeating enemies to buy upgrades.\nCombining the same upgrades can make them stronger.\n\n# PERMANENT UPGRADE\nUpon completing the run, you can obtain gems.\nUse gems to get permanent upgrades and power up your initial stats.\nWhether you choose to compensate for your weaknesses or enhance your strengths, feel free to mix and match according to your own playstyle.", "short_description": "Gunshot Survivors VR is a VR roguelike shooter where you upgrade your gun and defeat enemies to survive. Build the ultimate gun and defeat the robot swarm!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://gunshot-survivors-vr.hachikugames.workers.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "HachiKuGames", "support_website_url": null, "website_url": "https://gunshot-survivors-vr.hachikugames.workers.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25569450182681891"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620669_1597889805205825_8355719011338682664_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b297VR3OFIsQ7kNvwFU97MJ&_nc_oc=Adr7hjaxd8sh6sq-uXgTT_u8GDQrtIZPrBuhiiDW2
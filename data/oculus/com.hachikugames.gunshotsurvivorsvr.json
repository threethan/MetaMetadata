30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u6b21\u3005\u3068\u73fe\u308c\u308b\u30ed\u30dc\u30c3\u30c8\u306b\u5bfe\u6297\u3059\u308b\u305f\u3081\u306b\u6700\u9ad8\u306e\u9283\u3092\u4f5c\u308a\u4e0a\u3052\u308d\uff01\n\n# \u30b2\u30fc\u30e0\u30d7\u30ec\u30a4\n1WAVE\u304c30\u79d2\uff5e60\u79d2\u306e\u30d0\u30c8\u30eb\u3092\u884c\u3044\u3001\uff11\u56de\u306e\u30e9\u30f3\u3067\u516812WAVE\u306e\u30d0\u30c8\u30eb\u3092\u751f\u304d\u5ef6\u3073\u307e\u3057\u3087\u3046\u3002\n\u56db\u65b9\u516b\u65b9\u304b\u3089\u8972\u3063\u3066\u304f\u308b\u6575\u3092\u9283\u3067\u5012\u3057\u3001\u30c0\u30c3\u30b7\u30e5\u3092\u99c6\u4f7f\u3057\u3066\u6575\u304b\u3089\u9003\u3052\u305f\u308a\u3057\u307e\u3057\u3087\u3046\u3002\n\n# \u767d\u71b1\u306e\u30dc\u30b9\u30d0\u30c8\u30eb\n\u4e00\u5b9aWAVE\u6bce\u306b\u901a\u5e38\u306e\u30d0\u30c8\u30eb\u3068\u306f\u9055\u3046\u30dc\u30b9\u30d0\u30c8\u30eb\u304c\u767a\u751f\u3057\u307e\u3059\u3002\n\u30dc\u30b9\u6bce\u306b\u7279\u5fb4\u304c\u7570\u306a\u308a\u3001\u5f37\u529b\u306a\u653b\u6483\u3092\u3057\u3066\u304d\u307e\u3059\u3002\n\u305d\u3057\u3066\u3001\u30dc\u30b9\u3092\u5012\u3059\u3068\u901a\u5e38\u3067\u306f\u624b\u306b\u5165\u3089\u306a\u3044\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u624b\u306b\u5165\u308c\u308b\u4e8b\u304c\u3067\u304d\u308b\u306e\u3067\u6483\u7834\u3092\u76ee\u6307\u3057\u307e\u3057\u3087\u3046\u3002\n\n# \u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\nWAVE\u304c\u7d42\u4e86\u3059\u308b\u3068\u3001\u6575\u306e\u6483\u7834\u3067\u624b\u306b\u5165\u308c\u305f\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u6d88\u8cbb\u3057\u3066\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002\n\u540c\u3058\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u4e8b\u3067\u3001\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u5f37\u304f\u3067\u304d\u307e\u3059\u3002\n\n# \u6c38\u7d9a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\n1\u56de\u306e\u30e9\u30f3\u304c\u7d42\u4e86\u3059\u308b\u3068\u3001\u30b8\u30a7\u30e0\u3092\u624b\u306b\u5165\u308c\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059\u3002\n\u30b8\u30a7\u30e0\u3092\u4f7f\u3063\u3066\u6c38\u7d9a\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u624b\u306b\u5165\u308c\u3066\u3001\u30e9\u30f3\u306e\u521d\u671f\u30b9\u30c6\u30fc\u30bf\u30b9\u3092\u30d1\u30ef\u30fc\u30a2\u30c3\u30d7\u3059\u308b\u4e8b\u304c\u3067\u304d\u307e\u3059\u3002\n\u82e6\u624b\u306a\u90e8\u5206\u3092\u88dc\u3046\u304b\u3001\u5f97\u610f\u306a\u90e8\u5206\u3092\u4f38\u3070\u3059\u304b\u3001\u81ea\u5206\u306e\u30d7\u30ec\u30a4\u306b\u5408\u308f\u305b\u3066\u81ea\u7531\u306b\u7d44\u307f\u5408\u308f\u305b\u307e\u3057\u3087\u3046\u3002", "short_description": "Gunshot Survivors VR\u306f\u3001\u9283\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u306a\u304c\u3089\u6575\u3092\u5012\u3057\u3066\u751f\u304d\u6b8b\u308b\u3001VR\u30ed\u30fc\u30b0\u30e9\u30a4\u30c8\u30ac\u30f3\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3059\u3002\u6b21\u3005\u3068\u73fe\u308c\u308b\u30de\u30b7\u30f3\u306b\u5bfe\u6297\u3059\u308b\u305f\u3081\u306b\u6700\u9ad8\u306e\u30d3\u30eb\u30c9\u3092\u4f5c\u308a\u4e0a\u3052\u308d\uff01"}, {"images": {"nodes": [{"file_name": "MetaLandscapeCover.png", "id": "2887354668286067", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623115_2887354671619400_3420216390860577381_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBZRiztDzCQQ7kNvwFWFb32&_nc_oc=AdqrcW2Nmktlpjg288LQe_HCvGiA2dIevdwbTfen6qp_V4_oIcP8P55__CN36a2JIm0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaLIW_sfgcdAzGHPERoP02W-CcnxEpbcnOCHhm-45vRg&oe=6AF356D8"}, {"file_name": "AppIcon.png", "id": "2146541275926839", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622188_2146541279260172_8809651365995023459_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-49xkpacqQAQ7kNvwES3I3h&_nc_oc=Adq9nHzezhX4
icSZl&_nc_oc=AdreXawoO-b2Akol8KWSUa4HyYSU1Q-2yVJWtGr9rLItam616DiJcVjajlcfhUh2fN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTGJpgVPYO3dd6rdsBSMxRSDPNg1Ne885v_dQOJ6rlXw&oe=6B0EEDCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover.png", "id": "494461441764468", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974463_494461445097801_5594984810776739995_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L06yGRSM1LoQ7kNvwH5kdxz&_nc_oc=AdrQ3zFYMmWFmA6nVrU7bgSaNGnqWJH21C2l5kcRMBIWVj7zEWmG0ZTpSefDDPRQqLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUsjBNh47IPfDuer7fbJNTFpseKe1qXnttLPtu3kbUgvA&oe=6B0EFCBB"}, "display_name": "Cosmos Crash", "keywords": [], "long_description": "Cosmos Crash \u2013 The first person shooting & puzzle VR game of Viriver Studio is now online.\n\nIn this game, you\u2019ll be a space pilot with your ship trapped by orbits in the depths of the vast universe. By firing high-tech marbles, you need to make matches of three or more same-colored marble in the orbit before it reaches your ship. The game contains 10 different orbits waiting for you, think fast and aim smart to solve these problems!\n\nSpatial 3D orbit\nThe 3D spatial orbits are the biggest highlight of Cosmos Crash. Surrounded by various shapes of orbits (crown, pipe, balance, gear, etc)\uff0c the game brings you immersive experience as if you are just there in the universe, giving full play to the superiority of virtual reality.\n\nStrategy\nEach of the 10 orbits has different strategies to clear all the marbles. Special orbit like accelerating orbit (speeding up the pass-by marbles) and balance shaped orbit (requires clarity of both side orbit) appears as the game progressed.\n", "short_description": "\"Cosmos Crash\" is a new type of leisure & puzzle VR game. The background of game is set up in the depths of the vast universe.\nIn the game, challengers will play as a trapped Space Battleship Knight. By firing artillery shells via space gun, destroy the-same-colored marbles in the orbit. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.virivers.com/cn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Viriver Studio", "support_website_url": null, "website_url": "http://virivers.com/en/work-game-1.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "447429293831861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974833_311588963849995_263057234980650435_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpIsk7nWtIMQ7kNvwE5bs6J&_nc_oc=AdpVXCjpaLkOBdlYJ-_43ZYHSyADs4g8LNt0wNfyxv78xIrKLFP8NncNhCUZ-qKk0FU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUd1OqoWyhzRctnyKlRFOWVXBbWS6fQeIyyTDR27x-xCQ&oe=6B0F06FF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cosmos Crash", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Shooter", "id": "37
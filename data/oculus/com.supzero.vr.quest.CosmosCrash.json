_ZTnT&_nc_oc=AdopLaSmLmvGkYlWnf5bJBs7j1DCZWHeRWTTxPZvYxMY8VIqFgdzgfPBVa-NYVFTVQw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7pKeHpPVIBqPX4nsJNIi_j6zvqeNvMnoNfZU2VqVeAg&oe=6AFB274B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover.png", "id": "494461441764468", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974463_494461445097801_5594984810776739995_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrWq5H0hrEYQ7kNvwHUXnqK&_nc_oc=AdpGmCaiLyCMm0BZAEoeR1iUcLvFq_XPvI6rnOLfC9L84CwS1qzaMeg-hc2inkF50kY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzB8fmh85Lz7L2OrRuiJCDXHJB0m3IOEkEekS4XzRSgQ&oe=6AFB363B"}, "display_name": "Cosmos Crash", "keywords": [], "long_description": "Cosmos Crash \u2013 The first person shooting & puzzle VR game of Viriver Studio is now online.\n\nIn this game, you\u2019ll be a space pilot with your ship trapped by orbits in the depths of the vast universe. By firing high-tech marbles, you need to make matches of three or more same-colored marble in the orbit before it reaches your ship. The game contains 10 different orbits waiting for you, think fast and aim smart to solve these problems!\n\nSpatial 3D orbit\nThe 3D spatial orbits are the biggest highlight of Cosmos Crash. Surrounded by various shapes of orbits (crown, pipe, balance, gear, etc)\uff0c the game brings you immersive experience as if you are just there in the universe, giving full play to the superiority of virtual reality.\n\nStrategy\nEach of the 10 orbits has different strategies to clear all the marbles. Special orbit like accelerating orbit (speeding up the pass-by marbles) and balance shaped orbit (requires clarity of both side orbit) appears as the game progressed.\n", "short_description": "\"Cosmos Crash\" is a new type of leisure & puzzle VR game. The background of game is set up in the depths of the vast universe.\nIn the game, challengers will play as a trapped Space Battleship Knight. By firing artillery shells via space gun, destroy the-same-colored marbles in the orbit. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.virivers.com/cn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Viriver Studio", "support_website_url": null, "website_url": "http://virivers.com/en/work-game-1.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "447429293831861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974833_311588963849995_263057234980650435_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xL6LV0endtwQ7kNvwHcgzRg&_nc_oc=Adqb5bA1yYttaHyePUuvpb29-o200zEwPYNv0xXUdKWqjxt1f-3LoqaSZpmphOUrCRQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_KkXsi81R4YguGEeRcWUTc1deFDNFPR6mwXjK7hRM7Q&oe=6AFB407F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cosmos Crash", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Shooter", "id": "37
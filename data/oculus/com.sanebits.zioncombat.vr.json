97875_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2afGM7X9h6wQ7kNvwEMqZCZ&_nc_oc=AdoYyyLKqkCHTCoueif_MezO-WJ0pzxzMgoRsw1vHRjgomjUwZKeNxVZckbDQLrOYEo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVFPuGDCYKVFazKHKB5bAqgPgIpPMpyKrIVPpkzyDlcyw&oe=6B0F1079"}, {"file_name": "08_shot3.png", "id": "1108141408805016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596168449_1108141412138349_273792016458905839_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXToREINdcMQ7kNvwGyu0LH&_nc_oc=AdrPTIkdhMQ99plshrXwU9pUWZJcGioKxNMX1EWWdXNS2lm1kQt1B0Q7YH0ibKgDSGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVq2HwDNF9tzAdjY_xVJpOL6G7ypifcxUy9LUUTaY_Mrg&oe=6B0EF480"}, {"file_name": "09_shot4.png", "id": "1155558360231684", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673525341_1155558363565017_2730144461260070003_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcfPq-vyXTUQ7kNvwFt28ta&_nc_oc=AdokVWBuMM1HOnv1JJKMiA0au1Cqa_dGg1V4lS5WfudTWzFyZHjGu3x2bV3dv0N89G0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXo7VsOWUIknOKKu2wEZcuzisBfgkSTlNV17KNQpLUp1A&oe=6B0F1B13"}, {"file_name": "10_shot5.png", "id": "1094010516801229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_1094010520134562_7849687600551098680_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJtk01v5Yh4Q7kNvwH3Vz1I&_nc_oc=AdpJlSweoAghG4OMe6ZPu-bDWcfUf-tZ9_aW8CKsG2jXKMW7bh_2I5X7hAFP6paDUBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXINm5T4undL-wMavj1is7R6O7ZSLEtiLuemTqkwm5zg&oe=6B0EEBAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zion-trailer-cover.png", "id": "3249234081943422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_3249234085276755_8239688455459232075_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KBzhd6oWz0Q7kNvwHSALDs&_nc_oc=AdpE0nD-MSMmY8EqGctFZe3VDAJaX4PEQu050ofScmmnZTJC87w8O240PsyONFhTBPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURaXMDhuIjR3jBl2cCpYYxGc78nJTal_sSC_kcG0gGyA&oe=6B0EEE43"}, "display_name": "Zion Combat: Stand Against the Dark", "keywords": ["fighting", "faith", "scripture", "handtracking", "arena"], "long_description": "- **Stand.** Meet a blow with your raised forearm at the right moment and turn it back in a burst of gold.\n- **Your body is the controller.** Punch, and light flies to the one you aim at. Thrust an open palm to Repel, clap for a Thunderclap, point to Rebuke, slash for the Sword of the Spirit. Cross your arms and fling them open for Breakthrough, roll your fists to Bind, hold a ball of light and thrust a Zoe Blast, crouch and Arise.\n- **Refill the way believers do.** Pray to refill your Spirit, lift your hands in surrender for Glory and Life, and touch the Book on your wrist to Eat the Word while it heals you.\n- **Seven champions,** each with their own powers and an ultimate: altar fire, claimed ground, written words, seven thunders, seals, the watchman's lamps and threads of prayer.\n- **30 Battles in three great halls,** three bosses, Endless Watch, a Daily Watch, Boss Challenges and a pass-the-headset Church Event.\n- **Learn the moves:** a guided course traces every movement in light. The Command List shows them for hands and for controllers.\n- **Scripture as power.** Declare verses in the fight. Every verse is kept in the Book to read in context.\n- **Comfortable by design:** you only move when you choose to, with a short blink between rings of light. Seated or standing, snap turning, calmer flashes, subtitles.\n- Original characters. King James Version scripture. Voices are computer-generated for now; recorded voices come in a free update.", "short_description": "Raise your forearm as the darkness strikes and Stand: a bell rings, gold light bursts from your arm, and the shadow is thrown back. Zion Combat is a hands-first arena brawler where seven champions of faith fight the Veil with their own bodies: punches that fly as light, open-palm thrusts, claps of thunder, a pointed Rebuke and the spoken Word. No gore: darkness dissolves into light. Seated or standing, hands or controllers."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/zion-combat/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1428774519431583"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673819499_1592542228842675_8451560287009581582_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUD_WpycI6EQ7kNvwGH0rUx&_nc_oc=AdraYoDxtKdA5XzpLh92iolXj6Ld5MixBctV1qwk0KwLlsoH_7RS7TLbuwEdhbvR-QQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV439_XW2DT6uGK_4UxW7rq9dvcJSkHUYjgsL74bEIpeA&oe=6B0F1A2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zion Combat: Stand Against the Dark", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925
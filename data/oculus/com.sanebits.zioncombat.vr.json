97875_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyb3gnqCKCAQ7kNvwE4bBY0&_nc_oc=AdrHcCdlfF3m9rgwV7879td4ALgIH_WoyR3ZJH9WvFPjFEsUxbDnXcygnr1kbYqvD9A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW4b9-Jls_9wk5HHMSDRPJx_MbyfEVqbAUJ48C1pUR4Hg&oe=6B1061F9"}, {"file_name": "08_shot3.png", "id": "1108141408805016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596168449_1108141412138349_273792016458905839_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXToREINdcMQ7kNvwEOsSgj&_nc_oc=AdrnS1h8Q0TlHQ0kE_fo_YRweIXUES-aSjooVWniIz3QQNnLgIDKQqrWSADqwfR_tY0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX_AoOytcrCD5czVbpUpGjnwbRKnm0mtljmfl1JKssm5A&oe=6B104600"}, {"file_name": "09_shot4.png", "id": "1155558360231684", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673525341_1155558363565017_2730144461260070003_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yk5dOTTJXwgQ7kNvwFLIIoo&_nc_oc=AdrkXxQcPlnk6D35tZ0owZvptWHDp8vAKPTrYkMnh059SzSj8hmq-4XlQtF2jFZikb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWWMjh3WAdyssqEnH9PSVp8IXMcZspqWW5jRfMQuNgdNQ&oe=6B106C93"}, {"file_name": "10_shot5.png", "id": "1094010516801229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_1094010520134562_7849687600551098680_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ7EZOErUeQQ7kNvwGeZMAr&_nc_oc=AdrUw17pGZgXHpjtt1Hp0N27GM3ev5DTy_M3VMOTkq1jULWkM2BeTxP1c1IhTTkJV4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWiyLX1XkNTCpr-uENZfePschiR9hz3wdzX58pSTjoZ3A&oe=6B103D2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zion-trailer-cover.png", "id": "3249234081943422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_3249234085276755_8239688455459232075_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KBzhd6oWz0Q7kNvwGVeKEP&_nc_oc=Adpa_wDVPF0_CaBPsa0gvFR7hYXlXqb5zEwtavveS5m9rlGRoZQhCHUKT5cKhRWxcEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-kk0Hx3931r7DqQBHpUCh-n2ePL4IspZ4ifKElOq_hA&oe=6B103FC3"}, "display_name": "Zion Combat: Stand Against the Dark", "keywords": ["fighting", "faith", "scripture", "handtracking", "arena"], "long_description": "- **Stand.** Meet a blow with your raised forearm at the right moment and turn it back in a burst of gold.\n- **Your body is the controller.** Punch, and light flies to the one you aim at. Thrust an open palm to Repel, clap for a Thunderclap, point to Rebuke, slash for the Sword of the Spirit. Cross your arms and fling them open for Breakthrough, roll your fists to Bind, hold a ball of light and thrust a Zoe Blast, crouch and Arise.\n- **Refill the way believers do.** Pray to refill your Spirit, lift your hands in surrender for Glory and Life, and touch the Book on your wrist to Eat the Word while it heals you.\n- **Seven champions,** each with their own powers and an ultimate: altar fire, claimed ground, written words, seven thunders, seals, the watchman's lamps and threads of prayer.\n- **30 Battles in three great halls,** three bosses, Endless Watch, a Daily Watch, Boss Challenges and a pass-the-headset Church Event.\n- **Learn the moves:** a guided course traces every movement in light. The Command List shows them for hands and for controllers.\n- **Scripture as power.** Declare verses in the fight. Every verse is kept in the Book to read in context.\n- **Comfortable by design:** you only move when you choose to, with a short blink between rings of light. Seated or standing, snap turning, calmer flashes, subtitles.\n- Original characters. King James Version scripture. Voices are computer-generated for now; recorded voices come in a free update.", "short_description": "Raise your forearm as the darkness strikes and Stand: a bell rings, gold light bursts from your arm, and the shadow is thrown back. Zion Combat is a hands-first arena brawler where seven champions of faith fight the Veil with their own bodies: punches that fly as light, open-palm thrusts, claps of thunder, a pointed Rebuke and the spoken Word. No gore: darkness dissolves into light. Seated or standing, hands or controllers."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/zion-combat/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1428774519431583"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673819499_1592542228842675_8451560287009581582_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUD_WpycI6EQ7kNvwG9Yxcf&_nc_oc=AdrCQZMweCcTM167dYof7TALhefh5YHnnSQ9M4PZfW08jLjg3TGwDrH00QxqAK7yU6U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXvAYWju4lFH_rdI9mWqNHM2iO4qmjHu5KALRVCB6AXkw&oe=6B106BAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zion Combat: Stand Against the Dark", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925
97875_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2afGM7X9h6wQ7kNvwHSl9nd&_nc_oc=Adrd0zikDyKSouUvX70K8pVqVjQoNJi4WWgBQ9A7vXhpkznm6F-sNenpTbd7RHPe6jM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlXj7iwF1IUH-CJNgPFrewrW9vLXCe369TX74V7Cow5w&oe=6B0C6D79"}, {"file_name": "08_shot3.png", "id": "1108141408805016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596168449_1108141412138349_273792016458905839_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vxdh0-pwYe4Q7kNvwF4c8yt&_nc_oc=AdoQu4zvaoC99iUVX8bpEwMgmY2OajVPgHDzXriWxBe3v6WTgdqe_tVghngGxAem_zY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ87CBMVcgIkEG5gtDcrYjSHRC3moRHfTdesWza3H7kZw&oe=6B0C5180"}, {"file_name": "09_shot4.png", "id": "1155558360231684", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673525341_1155558363565017_2730144461260070003_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcfPq-vyXTUQ7kNvwHzu5K3&_nc_oc=Adp_0uEn9W5IVS20rvPeebbh5BThmCouzE6DM8Xg-kEeTRi3e1YQmhzZf7T5qFGAi04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR0lpN1Ax8JeWKoNXo7R77vvO44KTxubwI56M-BMsg-uw&oe=6B0C7813"}, {"file_name": "10_shot5.png", "id": "1094010516801229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596149727_1094010520134562_7849687600551098680_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJtk01v5Yh4Q7kNvwGHjPlV&_nc_oc=Adr5D9_IT9uIK539ibRypoHxuDPHiyrIgN8BoD0btkL4_8P3e-T9lDIvkbvMsfd7S6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTEooctD2QuUbcqLLGGI7hxa3K2yZPsRZSKD7aEkMptvg&oe=6B0C80EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zion-trailer-cover.png", "id": "3249234081943422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_3249234085276755_8239688455459232075_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7eNjYIxpgTgQ7kNvwEpgxuZ&_nc_oc=AdrYytfrGjBlPxQPiUWE0JCyM-F7tfq2j5W8VVdKy4ySAQbKbSgY8sfPvZtW3K02AcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCDqJw1GvNAtYDJEI7kmDPVWsypgDl4NkgggEeXwnrZw&oe=6B0C8383"}, "display_name": "Zion Combat: Stand Against the Dark", "keywords": ["fighting", "faith", "scripture", "handtracking", "arena"], "long_description": "- **Stand.** Meet a blow with your raised forearm at the right moment and turn it back in a burst of gold.\n- **Your body is the controller.** Punch, and light flies to the one you aim at. Thrust an open palm to Repel, clap for a Thunderclap, point to Rebuke, slash for the Sword of the Spirit. Cross your arms and fling them open for Breakthrough, roll your fists to Bind, hold a ball of light and thrust a Zoe Blast, crouch and Arise.\n- **Refill the way believers do.** Pray to refill your Spirit, lift your hands in surrender for Glory and Life, and touch the Book on your wrist to Eat the Word while it heals you.\n- **Seven champions,** each with their own powers and an ultimate: altar fire, claimed ground, written words, seven thunders, seals, the watchman's lamps and threads of prayer.\n- **30 Battles in three great halls,** three bosses, Endless Watch, a Daily Watch, Boss Challenges and a pass-the-headset Church Event.\n- **Learn the moves:** a guided course traces every movement in light. The Command List shows them for hands and for controllers.\n- **Scripture as power.** Declare verses in the fight. Every verse is kept in the Book to read in context.\n- **Comfortable by design:** you only move when you choose to, with a short blink between rings of light. Seated or standing, snap turning, calmer flashes, subtitles.\n- Original characters. King James Version scripture. Voices are computer-generated for now; recorded voices come in a free update.", "short_description": "Raise your forearm as the darkness strikes and Stand: a bell rings, gold light bursts from your arm, and the shadow is thrown back. Zion Combat is a hands-first arena brawler where seven champions of faith fight the Veil with their own bodies: punches that fly as light, open-palm thrusts, claps of thunder, a pointed Rebuke and the spoken Word. No gore: darkness dissolves into light. Seated or standing, hands or controllers."}]}, "developer_name": "SaneBits", "developer_privacy_policy_url": "https://sanebits.com/products/zion-combat/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SaneBits", "support_website_url": null, "website_url": "https://sanebits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1428774519431583"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673819499_1592542228842675_8451560287009581582_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NYMjVxCcGAQ7kNvwErBlIT&_nc_oc=AdrbQywRgiAmQ6QFXrOQKXjDwpFTGZCx9Q9h0bR8sl5bJNqnQTQTH1B19V6wbm27UGo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRG1aF_LdV0BEYeN9KYY3lJL8E7dPcN9W8DxL5jWX1vVg&oe=6B0C772D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zion Combat: Stand Against the Dark", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925
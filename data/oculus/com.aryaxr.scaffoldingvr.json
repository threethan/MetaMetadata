71538001413630812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RffbdaMYjzIQ7kNvwHz1vaX&_nc_oc=AdoE5noHAl5hWmyBLkg6yveD3D1JiPANC_47msSrwhVXcGvNTdJt_4gu4RwQdtx48mw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdwcGdFXuMbujJ_Farqn-lGn4GAsd-7acLHCYx4upf-w&oe=6A882FD4"}, {"file_name": "Scaff V1 SS5.png", "id": "1658278308590014", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499307470_1658278311923347_3475068003740431664_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1RGNk6Dq1oQ7kNvwEXn6QA&_nc_oc=AdqE6YvJ_x8nMMe17CnqEWVRweFXfq4ewhNuaN2N7jxfymOZ8_m3n45JpEHRLy6mHiY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPnkSajfBB_qfyyGqG5fsPHQOTKChI0oXxOEoDeWaiWg&oe=6A883ED5"}, {"file_name": "Scaff V1 SS6.png", "id": "1045602254609116", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499304952_1045602257942449_4798652243389336008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uhNuImslKEQ7kNvwFHH2yM&_nc_oc=AdpB4xVTWkoniD1XGsfAdR1Tmz_I0gTK0xsYgihmJjYsi6zW12M7i7MUrtxLyKBB1-k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi8O9rbiKsiBfT52RjnzexJmkbdos02OR03ghEkTRoMg&oe=6A885014"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AryaXR Scaffolding", "keywords": ["scaffolding", "construction", "safety"], "long_description": "Transform your industrial workforce training with the AryaXR Scaffolding VR Application - the definitive virtual reality simulation built for heavy industry, construction, and engineering teams. Designed to align with rigorous global safety standards, this application drops trainees directly onto a virtual job site to experience high-consequence scenarios with zero real-world physical risk.\n\nKey Training Modules & Features:\n-> Step-by-Step Assembly: Learn the precise sequence for erecting scaffolding structures, ensuring stable structural validation logic from the ground up.\n-> Component Identification: Master the correct identification and placement of standards, ledgers, transoms, couplers, and toe-boards.\n-> Dual Learning Modes: Build foundational knowledge in an interactive Practice Mode, then validate skills under pressure in Test Mode.\n->Performance Analytics: Track execution times and procedural accuracy instantly to measure trainee readiness.\n\nEquip your team with the muscle memory and confidence required to identify critical structural defects before they ever step onto a real job site.", "short_description": "Master tower scaffolding erection with zero risk. The AryaXR Scaffolding Training Simulator offers a safe VR environment to learn critical, high-risk procedures. Build your foundational knowledge in Practice Mode, and then put your skills to the test in Test Mode to gain real-world confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aryaxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ARYAXR AI SOLUTIONS (OPC) PRIVATE LIMITED", "support_website_url": null, "website_url": "https://aryaxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1169955376206886"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1004911969179967"}]}, "baseline_offer": {"id": "1004911969179967"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784306640, "status": "PUBLISHED", "id": "100
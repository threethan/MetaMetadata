616501768493_1771538001413630812_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBu00K5dhnYQ7kNvwHvJghs&_nc_oc=Adpq-sXsUs2L4CUMhLmVXmi1d9toS8Iepf4Iso8JtzMtGnxOIuEv3ucVanEiUEAtsuc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSMMrnkVfcc-DZI-kEU81qxJAUPHacdhvhmDnD8e0jLw&oe=6AA95D94"}, {"file_name": "Scaff V1 SS5.png", "id": "1658278308590014", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499307470_1658278311923347_3475068003740431664_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3UkTwv2XGAQ7kNvwFE0eYJ&_nc_oc=Adrk7bADsBc1CpwvcLKwEvljdNtrsdBKvirvWFHYjPQp7ebxRxSCLLvz2NMVsrV6i0U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjQWAgwHKGp2vY5HgBOrmmBeXsWE-6PzEQEtna5uWpaQ&oe=6AA93455"}, {"file_name": "Scaff V1 SS6.png", "id": "1045602254609116", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499304952_1045602257942449_4798652243389336008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViqIeHvnTfUQ7kNvwHfNW-o&_nc_oc=Adqr_rl3HPWst4wuTSHXLsOIt2r7bAEEx8xHIT2AmTOqSix-04-nDrObKB2ZtnHf-6g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTOx5fcFlI5TG5TSsAbUnFq2lMRegJjq04hVHO5Zn64Q&oe=6AA94594"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AryaXR Scaffolding", "keywords": ["scaffolding", "construction", "safety"], "long_description": "Transform your industrial workforce training with the AryaXR Scaffolding VR Application - the definitive virtual reality simulation built for heavy industry, construction, and engineering teams. Designed to align with rigorous global safety standards, this application drops trainees directly onto a virtual job site to experience high-consequence scenarios with zero real-world physical risk.\n\nKey Training Modules & Features:\n-> Step-by-Step Assembly: Learn the precise sequence for erecting scaffolding structures, ensuring stable structural validation logic from the ground up.\n-> Component Identification: Master the correct identification and placement of standards, ledgers, transoms, couplers, and toe-boards.\n-> Dual Learning Modes: Build foundational knowledge in an interactive Practice Mode, then validate skills under pressure in Test Mode.\n->Performance Analytics: Track execution times and procedural accuracy instantly to measure trainee readiness.\n\nEquip your team with the muscle memory and confidence required to identify critical structural defects before they ever step onto a real job site.", "short_description": "Master tower scaffolding erection with zero risk. The AryaXR Scaffolding Training Simulator offers a safe VR environment to learn critical, high-risk procedures. Build your foundational knowledge in Practice Mode, and then put your skills to the test in Test Mode to gain real-world confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aryaxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ARYAXR AI SOLUTIONS (OPC) PRIVATE LIMITED", "support_website_url": null, "website_url": "https://aryaxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1169955376206886"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1004911969179967"}]}, "baseline_offer": {"id": "1004911969179967"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784306640, "status": "PUBLIS
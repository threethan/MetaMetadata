/499307470_1658278311923347_3475068003740431664_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-bg-lFvTF8Q7kNvwEuZ_eI&_nc_oc=AdqKEOajhD4X7url5sxmX14ekWlHnPKobVpvIRmAWpo7b_PVc0IjmHrQeOvUUtCz-UI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSXoXs6xzTrUutKzznGD2lr_CSksOFB9Yf93SE43TupA&oe=6AEB5795"}, {"file_name": "Scaff V1 SS6.png", "id": "1045602254609116", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304952_1045602257942449_4798652243389336008_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHLz3xIXNQsQ7kNvwGugeYB&_nc_oc=AdqZGVhvAA47I9-0N5zS0Lh852Ciwxh7B3Azwzer1FOVGXu1ha98V9KF8RZc_Bfp5AI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL_298Bsl_5v8mkS1x3VSwWyuDecLJC0WEw-ZKYApomw&oe=6AEB3094"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AryaXR Scaffolding", "keywords": ["scaffolding", "construction", "safety"], "long_description": "Transform your industrial workforce training with the AryaXR Scaffolding VR Application - the definitive virtual reality simulation built for heavy industry, construction, and engineering teams. Designed to align with rigorous global safety standards, this application drops trainees directly onto a virtual job site to experience high-consequence scenarios with zero real-world physical risk.\n\nKey Training Modules & Features:\n-> Step-by-Step Assembly: Learn the precise sequence for erecting scaffolding structures, ensuring stable structural validation logic from the ground up.\n-> Component Identification: Master the correct identification and placement of standards, ledgers, transoms, couplers, and toe-boards.\n-> Dual Learning Modes: Build foundational knowledge in an interactive Practice Mode, then validate skills under pressure in Test Mode.\n->Performance Analytics: Track execution times and procedural accuracy instantly to measure trainee readiness.\n\nEquip your team with the muscle memory and confidence required to identify critical structural defects before they ever step onto a real job site.", "short_description": "Master tower scaffolding erection with zero risk. The AryaXR Scaffolding Training Simulator offers a safe VR environment to learn critical, high-risk procedures. Build your foundational knowledge in Practice Mode, and then put your skills to the test in Test Mode to gain real-world confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://aryaxr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ARYAXR AI SOLUTIONS (OPC) PRIVATE LIMITED", "support_website_url": null, "website_url": "https://aryaxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1169955376206886"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593776279_1658069975882535_5617667842040918685_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPTyOjjBoQkQ7kNvwGdhlc-&_nc_oc=Adrq1GgJ6ta4ou0tRh7yDDiktM1SVvAsGVIGO6RNrlFz5aZKTd5rl-IF_n9hrRKN0Ts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOEiZWskscffinFPaFd9Kf3EIbeL0wWdakqxNtNZJbAw&oe=6AEB4F82"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "AryaXR Scaffolding", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, 
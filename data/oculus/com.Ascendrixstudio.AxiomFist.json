499312470_2920651128303658_5911869489956300238_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EL43veM5J6EQ7kNvwFn1i5J&_nc_oc=AdrbV-F9Pd56oSk2uOOREhqyLlS8QcEkoRYXfRuvuqT0S1m3FeUgpkFwK-oiLjnj9tg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVUpqd4fgqRb1VeQxWAURQxnHA0IKeaccybDGXZQ6T1g&oe=6ADE1525"}, {"file_name": "SS 5.png", "id": "1403694011899297", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/625941762_1403694018565963_8612676963867251473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeHwd5Muyn4Q7kNvwFMNdB3&_nc_oc=AdpgXnUnXAftD4jFrQPokxcPe16D5aLMKskQoAjrPUHDISNzq30wnGRoaDa2wY8QdjU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAq8qQ_j4FlYkBxnwsTqbZcDfOyd8h85B156ZWsok0rg&oe=6ADDF832"}, {"file_name": "SS 1.png", "id": "27590186823997905", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312454_27590186837331237_4566965258572560800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znC5R9I7dwYQ7kNvwE99jsx&_nc_oc=AdpGln6hifgTWqO1gqq1PuBY1dUWCBE4kstfug39tsLSxm4W62MrIzs6AgM1ODDZRng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKbKAnU224e4fAgxK8WLcAXu5E9Q-9PQ_GlG6NRViq_Q&oe=6ADDF4CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 6.png", "id": "1604012850972124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312422_1604012854305457_3227238766766096138_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7-fOIisoW4Q7kNvwES8jys&_nc_oc=AdqHkKgB9r8Gd1xJjmuIoIMLXvFbhMyssCay5TQ_4oWfwGsDjMqcoeNadSlHWNDtgv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7V7uN9-8xmDMZt9nj-YYpaEZ6H-86N0A7kKpz4iSj0Q&oe=6ADE191A"}, "display_name": "Boxten VR Boxing", "keywords": ["Boxing", "Fighting", "Fitness", "VRBoxing", "Multiplayer"], "long_description": "Boxten VR Boxing \u2014 throw real punches, take real hits\n\nRaise your fists and fight with your whole body. No button combos \u2014 just you, your reach, and an opponent who reads every opening you leave.\n\nNEW: ONLINE MULTIPLAYER\nFight real players online in head-to-head 1v1 matches. Read their rhythm, punish their mistakes, and prove who owns the ring.\n\n15 FIGHTERS, 15 FIGHTING STYLES\nFrom cyber ninjas to flame-wielding champions, every opponent brings a different rhythm, reach, and set of combos.\n{1770557240631551}\n\n5 VR ARENAS\nTrade blows on neon city rooftops and inside ancient battle temples.\n{1037307782451005}\n\n5 DIFFICULTY LEVELS\nEasy to Extreme. As you climb, opponents react faster, block smarter, and unlock new attacks.\n{1045185434976035}\n\nREAL MELEE COMBAT\nDuck a hook. Slip a jab. Counter while they recover. Your movement is your defense.\n\nA REAL WORKOUT\nBob, weave, and swing your way to a full-body workout that never feels like exercise.\n\nBUILT FOR META QUEST\nPlay solo vs AI or online vs real opponents. Compatible with Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStep in. Lock eyes. Raise your fists.", "short_description": "VR fighting game with real punch-for-punch melee combat. Battle 15 fighters across 5 arenas and 5 difficulty levels on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/axiomfist/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/axiomfist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
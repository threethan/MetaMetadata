128303658_5911869489956300238_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj36YTdUDtcQ7kNvwFLi4dH&_nc_oc=Adq7AXTQqMFa-Q2Tdcsag1Foe-P9whVAmwsGnOOsQnef0UNgBlQlMR8XiQfoy27uSjw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0nWR495OtY6s3PnpUX9dVhilOfOW62w6J7EvLQMow0Q&oe=6AC7ABA5"}, {"file_name": "SS 5.png", "id": "1403694011899297", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/625941762_1403694018565963_8612676963867251473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owUvOoPixkQQ7kNvwE0YI6J&_nc_oc=AdrDi2BE2FRPzSmd3TH--qE9zBFEkLcYmF3cdGSJHmsZA7PsgwA209Cqv6YITWnEFUw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNycK19kvmMIh_Nk6crADRc2do7f1uM4Thjjg4pusGMVw&oe=6AC7C6F2"}, {"file_name": "SS 1.png", "id": "27590186823997905", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499312454_27590186837331237_4566965258572560800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hm-OlQ6RtKUQ7kNvwFS9Z9O&_nc_oc=Adr1iXSqJTKr4-AKxk1QJfFYUxp-JYA5F5aQq1K4IRm2JbhLgE249FpPcWTBBcbLiyk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7hTy1K1wLZFW5xwt7KYs0sXkfNs7530eDyDkGXrnc5g&oe=6AC7C38B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x 1440x.png", "id": "28190403260595371", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673716021_28190403267262037_5850028908345707867_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDGt699lmO0Q7kNvwHEjgFf&_nc_oc=AdrwM0iSLLVobS8AfWM7aA9_SSk3zg-MeoYuuv38-zQj4s1kTrFSwcXLlycVoNh2_LY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSrEH-l7WCisxzp1UxzMztnuuUIuK4Cuo4JdQo6VTYlA&oe=6AC7C6B0"}, "display_name": "Fight Thrill: Rise to Glory \u2013 VR Boxing", "keywords": ["Boxing", "Fighting", "Fitness", "Thrilling", "VRBoxing"], "long_description": "Fight Thrill: Rise to Glory \u2013 VR Boxing \u2014 throw real punches, take real hits\n\nStep into the arena, raise your fists, and fight with your whole body. No button combos, no cutscenes \u2014 just you, your reach, and a fighter across the ring who reads every opening you leave.\n\n15 FIGHTERS, 15 FIGHTING STYLES\nFrom cyber ninjas to flame-wielding champions, every opponent brings a different rhythm, reach, and set of combos. Learn how each one moves before you learn how to beat them.\n{1770557240631551}\n\n5 VR ARENAS\nTrade blows on neon city rooftops, inside ancient battle temples, and across arenas built to put you in the middle of the action.\n{1037307782451005}\n\n5 DIFFICULTY LEVELS\nEasy, Normal, Hard, Very Hard, and Extreme. As you climb, opponents react faster, block smarter, and open up new attack patterns. Extreme punishes every lazy guard.\n{1045185434976035}\n\nREAL MELEE COMBAT\nDuck under a hook. Slip a jab. Counter while they're still recovering. Your actual movement is your defense \u2014 dodging is something you do, not something you press.\n\nBUILT FOR META QUEST\nRoom-scale VR combat designed to keep you moving. Comfort rating: [match your submission form exactly].\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStep in. Lock eyes. Raise your fists.\n\n\n", "short_description": "VR fighting game with real punch-for-punch melee combat. Battle 15 fighters across 5 arenas and 5 difficulty levels on Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/axiomfist/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/axiomfist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
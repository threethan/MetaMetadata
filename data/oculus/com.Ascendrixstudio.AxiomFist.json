com&_nc_ss=7f20f&oh=00_AQNKNPZRH37mCTp56n6ClcLKlLd47CZxtM8S9vpZXBNwkg&oe=6ADE09B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "581567381679554", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821674_581567385012887_3832357032593791976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kH6vvlpmX8Q7kNvwHVOSV7&_nc_oc=AdrlvzTe2ll3YvW_8zVUkw_-e8VooDrJnWWgQ_ldV2XTRhfrlxtdE_9vOIvzo5Po_dc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo46E_THvXUomcjEVPL6cZBX6IhWGGUdXGmnrr_RoMSA&oe=6ADE207E"}, "display_name": "Axiom Fist", "keywords": ["Boxing", "Fighting", "Battle", "Combat"], "long_description": "AXIOM FIST isn\u2019t just another fighting game  it\u2019s where raw power meets virtual reality. Step inside the arena, feel every strike, and fight like never before in this next-gen VR brawler built exclusively for Meta Quest.\n\nEnter a world of 15 elite warriors, each forged with their own fighting style, elemental powers, and lethal combos. From cyber ninjas to flame-wielding champions, every character hits different  and every punch lands like it\u2019s real.\n\nBattle across 5 stunning VR arenas, from neon city rooftops to ancient battle temples, each alive with energy and destruction. And this is just the start  more maps, more fighters, and more chaos are on the way.\n\nChoose your challenge with 5 levels of difficulty: Easy, Normal, Hard, Very Hard, and the brutal Extreme Mode. As you climb higher, enemies evolve  unlocking deadlier powers, faster reactions, and new combo systems that test your limits.\n\nEvery fight in AXIOM FIST is a test of instinct, reflex, and domination. No cutscenes, no excuses  just pure, fast-paced VR combat that feels real, looks stunning, and hits hard.\n\n\u26a1 Key Features:\n\n15 Playable Fighters with Unique Skills & Combos\n\n5 Immersive Maps with Dynamic Environments\n\n5 Difficulty Levels with Progressive AI Evolution\n\nTrue VR Melee Combat  Feel Every Hit\n\nConstant Updates with New Fighters & Arenas\n\nStep in. Lock eyes. Raise your fists.\nAXIOM FIST  The Fight Feels Real.", "short_description": "AXIOM FIST isn\u2019t just another fighting game it\u2019s where raw power meets virtual reality. Built for Meta Quest, step into the arena and face 15 unique fighters across 5 immersive maps. Test your skills through 5 difficulty levels, from Easy to Extreme, where enemies evolve with new powers and combos. Feel every hit, every dodge, every strike this is AXIOM FIST, the next-level VR combat experience. The fight feels real."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/axiomfist/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/axiomfist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31846706791642791"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1821413322377122"}, {"status": "PUBLISHED", "id": "1251386807101653"}, {"status": "PUBLISHED", "id": "1059132903127283"}, {"status": "PUBLISHED", "id": "997660306399100"}, {"status": "PUBLISHED", "id": "1992578948293492"}, {"status": "PUBLISHED", "id": "1450592370446225"
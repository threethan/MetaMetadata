62310238553695901_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQJrwLr_r-gQ7kNvwGHwRkZ&_nc_oc=AdpxREcxHP0So5qEi8sStmJxB3BYIovqIRbj1Dpit0Tf0de4SNn0_QkIAvTh1itefO0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-eAB2lonrrDjhHDPfny7kC-fIan3wmWhGUHKR_x8LiA&oe=6AC7A034"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "581567381679554", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821674_581567385012887_3832357032593791976_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6lo-3lHYXUQ7kNvwENfcRQ&_nc_oc=Adqp8lxl9wspGWFyRAUlNWh4LYBzuB2YJKBQXLWlWqeZrnXoYx4h6XCLVr0Vxyyh5yc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHzyomfGUUz_4wJl1q-CSf-P8PeOko-Cbw-PH1fNp-WQ&oe=6AC7B6FE"}, "display_name": "Axiom Fist", "keywords": ["Boxing", "Fighting", "Battle", "Combat"], "long_description": "AXIOM FIST isn\u2019t just another fighting game  it\u2019s where raw power meets virtual reality. Step inside the arena, feel every strike, and fight like never before in this next-gen VR brawler built exclusively for Meta Quest.\n\nEnter a world of 15 elite warriors, each forged with their own fighting style, elemental powers, and lethal combos. From cyber ninjas to flame-wielding champions, every character hits different  and every punch lands like it\u2019s real.\n\nBattle across 5 stunning VR arenas, from neon city rooftops to ancient battle temples, each alive with energy and destruction. And this is just the start  more maps, more fighters, and more chaos are on the way.\n\nChoose your challenge with 5 levels of difficulty: Easy, Normal, Hard, Very Hard, and the brutal Extreme Mode. As you climb higher, enemies evolve  unlocking deadlier powers, faster reactions, and new combo systems that test your limits.\n\nEvery fight in AXIOM FIST is a test of instinct, reflex, and domination. No cutscenes, no excuses  just pure, fast-paced VR combat that feels real, looks stunning, and hits hard.\n\n\u26a1 Key Features:\n\n15 Playable Fighters with Unique Skills & Combos\n\n5 Immersive Maps with Dynamic Environments\n\n5 Difficulty Levels with Progressive AI Evolution\n\nTrue VR Melee Combat  Feel Every Hit\n\nConstant Updates with New Fighters & Arenas\n\nStep in. Lock eyes. Raise your fists.\nAXIOM FIST  The Fight Feels Real.", "short_description": "AXIOM FIST isn\u2019t just another fighting game it\u2019s where raw power meets virtual reality. Built for Meta Quest, step into the arena and face 15 unique fighters across 5 immersive maps. Test your skills through 5 difficulty levels, from Easy to Extreme, where enemies evolve with new powers and combos. Feel every hit, every dodge, every strike this is AXIOM FIST, the next-level VR combat experience. The fight feels real."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/axiomfist/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/axiomfist/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31846706791642791"}}]}, "scheduled_offers": {"count": 19, "nodes": [{"status": "PUBLISHED", "id": "1821413322377122"}, {"status": "PUBLISHED", "id": "125138680710
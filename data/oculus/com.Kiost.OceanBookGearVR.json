808, \uc911\uad6d\ub178\ubc8c\ub808, \ucc9c\uc7a5\uc785\uc694\uac01\ub958\n- \uc2dd\ubb3c\ud50c\ub791\ud06c\ud1a4: \uc11d\ud68c\ube44\ub298\ud3b8\ubaa8\uc870\ub958, \uaddc\uc870\ub958, \uc640\ud3b8\ubaa8\uc870\ub958\n[\ud574\uc870\ub958]\n- \uac10\ud0dc, \ucc38\ub3c4\ubc15, \uc6b0\ubb47\uac00\uc0ac\ub9ac", "short_description": "\ubd80\uc0b0 \ud574\uc6b4\ub300 \ubc14\ub2e4 \uc18d \ub2e4\uc591\ud55c \ud574\uc591 \uc0dd\ubb3c\ub4e4\uc744 \uac00\uc0c1\ud604\uc2e4(VR:Virtual Reality)\ub85c \ub9cc\ub098\ubcf4\uc138\uc694."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kiost.ac.kr/", "developer_terms_of_service_url": "http://www.kiost.ac.kr/", "publisher_name": "Korea Institute of Ocean Science & Technology", "support_website_url": null, "website_url": "http://www.kiost.ac.kr/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "626373541922599"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1343948349006748", "version": "1.2.3"}, "id": "1489004297828548", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1317593314975585", "is_concept": false, "latest_released_binary": {"_
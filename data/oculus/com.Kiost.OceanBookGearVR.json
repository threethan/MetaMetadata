5c, \ubd80\uc0b0 \ud574\uc6b4\ub300 \uc8fc\ubcc0 \uc9c0\uc5ed\uc5d0 \ucd9c\ud604\ud558\ub294 6\uac1c \ubd84\ub958\uad70 21\uc885\uc5d0 \ub300\ud55c \uc2e4\uc81c \uc0dd\ubb3c\uc758 \ud615\ud0dc \ubc0f \uc6c0\uc9c1\uc784\uc744 \uad00\ucc30\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\n[\uc5b4\ub958]\n- \uc131\uc5b4: \uac10\uc131\ub3d4, \uc131\ub300, \uc804\uac31\uc774\n- \uc790\uce58\uc5b4: \ud480\ubbf8\uc5ed\uce58, \uac1c\ubca0\ub3c4\ub77c\uce58, \ud478\ub801\ud1b5\uad6c\uba4d\n[\uc800\uc11c\ub3d9\ubb3c]\n- \ub300\ud615\uc800\uc11c\ub3d9\ubb3c: \uc138\uac00\uc9c0\uae34\ubfd4\uc606\uc0c8\uc6b0, \uc5bc\ub8e9\ubaa8\ub798\ubb34\uc9c0\ubc8c\ub808\n- \uc911\ud615\uc800\uc11c\ub3d9\ubb3c: \uc120\ud615\ub3d9\ubb3c, \uc644\ubcf4\ub3d9\ubb3c, \ud638\ub791\uc7a5\uc218\ub178\ubc8c\ub808\n[\ud50c\ub791\ud06c\ud1a4]\n- \ub3d9\ubb3c\ud50c\ub791\ud06c\ud1a4: \ubcfc\ub8e9\ubc30\ud654\uc0b4\ubc8c\ub808, \uc911\uad6d\ub178\ubc8c\ub808, \ucc9c\uc7a5\uc785\uc694\uac01\ub958\n- \uc2dd\ubb3c\ud50c\ub791\ud06c\ud1a4: \uc11d\ud68c\ube44\ub298\ud3b8\ubaa8\uc870\ub958, \uaddc\uc870\ub958, \uc640\ud3b8\ubaa8\uc870\ub958\n[\ud574\uc870\ub958]\n- \uac10\ud0dc, \ucc38\ub3c4\ubc15, \uc6b0\ubb47\uac00\uc0ac\ub9ac", "short_description": "\ubd80\uc0b0 \ud574\uc6b4\ub300 \ubc14\ub2e4 \uc18d \ub2e4\uc591\ud55c \ud574\uc591 \uc0dd\ubb3c\ub4e4\uc744 \uac00\uc0c1\ud604\uc2e4(VR:Virtual Reality)\ub85c \ub9cc\ub098\ubcf4\uc138\uc694."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.kiost.ac.kr/", "developer_terms_of_service_url": "http://www.kiost.ac.kr/", "publisher_name": "Korea Institute of Ocean Science & Technology", "support_website_url": null, "website_url": "http://www.kiost.ac.kr/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "MOVIE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graph
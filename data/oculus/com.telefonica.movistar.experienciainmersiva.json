74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GbkzCPnK0YQ7kNvwGNO4ud&_nc_oc=AdrLTkUc987VTUTUNkxRT0t3uqxT4OiCUsOI1d8Gu2oLOhdIwPIeMMzNnvsY-_QHYhs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGS2snaF7rbDkjdCskzkVICftrzzcfAhwKKcV4EOlSqA&oe=69C3E96E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVbH3iCWO94Q7kNvwFIa3YW&_nc_oc=Adol5OKr2CkcZMGr9EitLzbcKn3tzOGdSwxXYs7RxMCaEIwkFwzqnuSw076-TRhbjhs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ0hg0KhzLUl_zpjj_4FHLFKu9lCVhOafVsR5tg9wvww&oe=69C3E573"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FGEar_UzakQ7kNvwGj0Sk8&_nc_oc=AdqzEYDl0kwNXSehhQ1QuksI1_jmDFxkgOmp6hQpNQKNurEaScO2epwHlUuSU0_HMHI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxFmBtz5mjHoFP4n1Imi4v0nghO-Pb2-ttouUOO0lE6kQ&oe=69C3C4D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agaooUJvElAQ7kNvwEAYyhv&_nc_oc=Ado_oOOA98rH2SXsyAMX1SLZUMte43VqH35mznWAf1a8W-J2FNzfXQ8IQqLvNQAz5rc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0I1tYqWHvxPZSFUOgNSdOCqSDuAZY2gsvzV2xcCK7-A&oe=69C3CA5B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQymTPf0FDoQ7kNvwG10se6&_nc_oc=AdoyFlDEgZslQ86G467HXJOpw3tVJ9Vf6giFQ2L508-qCY4SynrWBQp6-qCBQS6hyNs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz7WDvNtRpZlKoSENixGyiTkc8B1Wodzkw-53coVFvEdQ&oe=69C3E572"},
sid=6e7a0a&_nc_ohc=pb7yXX-ju4cQ7kNvwH00dpu&_nc_oc=AdkMaMGN__JGygFuxz8hACF2HbqK41atktKiJIpSW2TXTAypRYCnsPujwiHG0xVaww4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-X1gVsnJ3C1tNxsteTa4urTrUE7sa9_QXVm5LFLRxGA&oe=69AD7FEE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP5qbdwEr4IQ7kNvwGoWg0R&_nc_oc=Adn_-_Du_J2tvOGJKCAUxhHgGeNd2E-nF-Bt6oIXZim9BnSbvuDsAbDCeBu40bYZS0Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZsZ-j_IeSsmIrzgUi7puDe04KsIrAcr_ZbkB5lW-fJQ&oe=69AD7BF3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLPb8KFIEykQ7kNvwF9Hq6n&_nc_oc=Adm7U94GsjwAky9H5zmqvUGFK92vg45OqJnEWu0E8w7PTsaaU-zZTJ78gRMeYUAXQKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYiJds-08cuLC4ElIdJ2GZMcRWVj85-3OcME0qywvDqQ&oe=69AD5B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqAlMpm-WboQ7kNvwFPrv-x&_nc_oc=Admrr_ypzHVBwhbfEYvicIthjpKtEEZSDcquEiTBw3w4XFANu06vXyibBxPqirCf-fU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2iNVLD7Kcbd2figapVRpE531rcTTFzAKRGfa9iepQ7w&oe=69AD60DB"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfxME6a4f0gQ7kNvwFifqsn&_nc_oc=Admtjq-VkdKZ3X3qO6zE70spVb8RlcoDWEGpAcPaikVWvpVWkT2a4ftBfoeTG3rO6lI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyqSOtF7RW2ypVFGWy2GuFgCRQSnVr3fVpvY16rv8o4bg&oe=69AD7BF2"}, {"file_name": "CoverSquare.png", "id": "109533071443553
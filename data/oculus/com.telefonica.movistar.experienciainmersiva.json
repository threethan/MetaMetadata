sid=6e7a0a&_nc_ohc=hRLEDPC7Ef4Q7kNvwERMIYW&_nc_oc=AdkVhoV_Mp2DSNqkc5eKdwetoTBHbyg8mG30RzqG_NqX-Dnl2XYucPcalQTKqXzOCbo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1em7aREUIYccP2hIitzPPOQgitdBjIBeyq4hzKD07ag&oe=69B1746E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YrK5e-CQaiUQ7kNvwFMYctG&_nc_oc=AdmBIFWUWTy4PPPEzd4sKhoKA2Qo-rIwBKZjOJ92hV49vVdbCtfYnGydXUiVCzVPv98&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXP2SMlCrkCsgPvIrMfdC5rk5sqqdcsD-ss3E3pPbk_g&oe=69B17073"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TLNJjhzIoAQ7kNvwEdCI9z&_nc_oc=Adn5-1apkTvCqcxWR26R_yNs-TAtBAeVAGTkkIxyMIYim1rlZkSd4saJatDdvk_YwwY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgjWM7fYgdNej6_fgeQ5i5fBBv_wPkEVA4brLTOcQI-A&oe=69B14FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2zbCjoOCvAAQ7kNvwF7wbXE&_nc_oc=AdnRzEHgqU4rumgJWKZ6p8pbuZXp1z5LLEKUhqIRZOxx2dxDNlv3bzKI2t0S-Ld2Nk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy33vpIHkECa1NX4B0e2bZcDYbQbhwQHlqKWWffdEMZ2A&oe=69B1555B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rg56DApLBJgQ7kNvwHWceyf&_nc_oc=AdkNN2wC08Z3GqzLTKhSovfMsYV6uyRSExZm0DUPAW6Q8PEzhq5mE44ROhFh0F6tNE8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy20543t4XUlma2Mp0IeB8RM4C5bjT6VLQ0GsKIetqjpg&oe=69B17072"}, {"file_name": "CoverSquare.png", "id": "109533071443553
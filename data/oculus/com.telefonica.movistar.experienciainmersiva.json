74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpmu72U3IXUQ7kNvwGwIgi0&_nc_oc=Adq9cAFbvsxEWLvCfGIVEqI96xv-Az9gb9ynXJbanNqnqOGkdqr7d-ceBx4PlT8VbUo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2U2m6OhCVI6vCKYD40mktryRWPC-p_RFTU8hzT0MsaPQ&oe=69F6026E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUaI57eQKEMQ7kNvwG4EsUm&_nc_oc=AdpjAsAT-HK5DJqCy_58-N05dpmBq15hwx6BgKPv4rN3eMLxj62GRCXFqVkkKoqovRU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XLyjABtFGnW7ZbGawDAkUdBBsO7f1kMr_35PXdHFGUg&oe=69F5FE73"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdDNXyYeQesQ7kNvwE6JQN2&_nc_oc=AdrxHND30P2nmM6rXRMVZWfGz0PSytZC0GV5HkZqZnOeUwCuG7Lubf5GaWzSoZmt4wc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2hpM2rRtri5wAlfehuKsmzSPY57RnDyvhJZQ47M2uQ4g&oe=69F61617"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGI7WVN6PsQQ7kNvwE1XcJg&_nc_oc=Adp7KLdwDcfXwjficil_RQwllEWPQ04_lTbIA3d49c954agZW9kFDlY5WgcI40p4T2s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0JoTbbN7mMgiG3z3CJ9JQBKf09hhZdIxLuPlDlpfVjPw&oe=69F5E35B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rAET5wGAOYQ7kNvwEnQ0Mm&_nc_oc=AdoFN3FK981zfcxs_lAmehurmxrRREbz3ioVC6rV0sFCKSlNmge34L-_JRW_msqMOek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0I_o25Lx9McChITiKww0Iu1QQoT3D1ON1Wj9wv4ns5Ag&oe=69F5FE72"},
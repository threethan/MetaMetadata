sid=6e7a0a&_nc_ohc=QQN7XEih8ggQ7kNvwGjUHMq&_nc_oc=AdnGvxk-yi4SHRmz1VIHGdvcBY0KRjC_jKRDc6E5AZzDBnqNOxTtQJR5E5aFnFTiUEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afuc03UEJO00z7wyt2CwduxTSXOYDAgHnhIkkI9QCep8dQ&oe=69A839EE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWAcemydEFEQ7kNvwF2HNvK&_nc_oc=AdlozyblQWxHmMGT2qJNJt91sU4Jij0ORz0AXVIkvNNYDEckteQOuP-q4eTbw84Czk4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs32zVfMtFz0qnLQeF-J0mIVJZ8TuCcIuy2tVvQo401ug&oe=69A835F3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8auH0zscMUQ7kNvwFbdETn&_nc_oc=AdmOwYdHIG1r_qj-OycnLUFRydD8sRJST-DyANlwKq3RjE9wN3F955oyYIjjG76gho0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsn1W-AuVGFTLql1U26K9QHXIo6at3Vw5fP6qtu-rheUQ&oe=69A81557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RwRQdmYPIIQ7kNvwHamybs&_nc_oc=AdkQMGWawypn_TtfGf2piP9gtv6v_5-WZcKbaNNwKdnHhxft9-5xwpkmH_h7kRsR03w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsgDegInr1mHc4NqBIxX8n_UJrYzZI8W7h_PBSX4WiYAw&oe=69A81ADB"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COhtr-DfXtQQ7kNvwEzzMRK&_nc_oc=AdnWPxJGEJ77_DAaMS8QbabIxdprNIbpIKbSgDJuba7SdrBOt3zm5nOxwZL-NmHk_Sg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfteDmVqr1H3FvtEUs8PE6hg5R_AFx9Ejtq1TzJMJDvvCg&oe=69A835F2"}, {"file_name": "CoverSquare.png", "id": "109533071443553
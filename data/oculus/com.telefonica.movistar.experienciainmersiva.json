sid=6e7a0a&_nc_ohc=QQN7XEih8ggQ7kNvwGDQNPm&_nc_oc=AdkMS3_9H4TAhdjiC8HJzE5jXoB328GkiiqwXWchjWilNunZNum3NF_806VnLu1islE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvFa99rxHgBIIOA64VhmQm8mZ9HKCFOoP71S3mLleBcGQ&oe=69A98B6E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWAcemydEFEQ7kNvwGi97XC&_nc_oc=AdmxRwIJYTh6ok-mP0mHExMgFTrXq_HGya25ao-A02-9IfSmbPRu5Bideu_FV75EUFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsdUO4Ge0Thx0CISehlBZqF7EHZS2ClNOClODWfbiAhlg&oe=69A98773"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8auH0zscMUQ7kNvwHhMfYa&_nc_oc=AdlpVU87IgmLnQcg2pmCMmd-BqwZRs8VM7QYgpilzZygYWZv28Duw4VORKA4__HYmYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftIK1nf96yI4W4L5-YLpQu5mf3WKvMFM9g-d6fQb7S91g&oe=69A966D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RwRQdmYPIIQ7kNvwFsqMGH&_nc_oc=Adn1GHz9HMgAjeeJ6lX98JWB9W6QDI9S1dU3mZC7FfWgQ4yE2lCw-zHClzp2NKvZ9Wo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvcl6hFT5vBeq-SkUDElAhh-DbU7TMtGDAfbwHMB3aZzA&oe=69A96C5B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COhtr-DfXtQQ7kNvwF9fA_K&_nc_oc=AdmBASQNwAWYzXxcmV7VDAy840IkUrFoDbxKjcpp6o4-Jum96Zazh0T1sjONuoJYn44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuz-cBfFhG6XFKdWqVhUFPA3q_Ufzasa05MSbyb7moFHw&oe=69A98772"}, {"file_name": "CoverSquare.png", "id": "109533071443553
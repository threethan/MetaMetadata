1-7&_nc_sid=6e7a0a&_nc_ohc=QQN7XEih8ggQ7kNvwELQhOo&_nc_oc=Adkt6DITI1IdmHnZkNrmpZpn3-d9hnjPzebydU51PhDe3QsewjcjTOeV5EfIN8fTtww&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afx-JHRX3KI8XlZ4o6OZaoK-jGcfBE8Y8VFXcaM0aSpp7g&oe=69AADCEE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWAcemydEFEQ7kNvwGPkkii&_nc_oc=AdnK_yMxodZlXOm_uLm1spY1Pu6d90DDbgMHiPMIxLm8DZbu3V4MbPfkYM3sITiGY4Y&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsbA3g7h1gBELRze5jzPoBc_0qxSvRpvji6JqoCaLvWw&oe=69AAD8F3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8auH0zscMUQ7kNvwFxB2tg&_nc_oc=AdkW6uRioMA3TNuHKCSVnDWoIvpudD8pSLxCLjKYYmoK2WN_TLl9gILmAT-n6SAKT9I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSNlGHZHInPRHQuq-q84xBuCtGMXrXGkckbMmr963leQ&oe=69AAB857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqAlMpm-WboQ7kNvwG223AQ&_nc_oc=Adk-jtVkr698tQ8jRYcjK9tYC-ZDWWQ4HR5xtCYWfu6ghmhhHFMCEErnT1oE45eoPtk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvbH0FMKg22ep1wgm-v2M2Uu-uJOQeT7MWgs5SZ15nhg&oe=69AABDDB"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COhtr-DfXtQQ7kNvwGBdRGe&_nc_oc=AdkfeGP4yWKizQXDQuH_InnZ_DMrq4Gx1b5zKSz9ChA5verio_rmIiGdBYDZiO_4weY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afxk6kTA83EnlAeK0t7N1mMSjE6WyALzbi-8_vJ6HNSmKQ&oe=69AAD8F2"}, {"file_name": "CoverSquare.png", "id": "10953
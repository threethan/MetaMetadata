74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyVd_-nxoIoQ7kNvwGKQkQw&_nc_oc=AdrgJE3i9R9fmdtCq5Idhlkc1guYcetLxlnl4N2hpn8QxCYjbZlT5fvPk635P35DLGk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BYHDBDBG7CsDOQlzshVpec16EvLjj811xqhhalX59-g&oe=69D9016E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIJqBtjqqucQ7kNvwGUE4PZ&_nc_oc=Ado6ossjoOp0Fxk8f84L6KFmZecjhXoTH0zq7tqxtOwNrg6R0f-5CoBMGyUpX-5MYeU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vigQWFyikidw4BjnkPFh2gg8PwGOSnfLwgw4mejt1rQ&oe=69D8FD73"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tF5_9jIAqgQ7kNvwE4psyb&_nc_oc=AdrB_nv9kpYECGs4daiEHw6zykLsdbwHzU6PUaZijFL4WQMhteEKERq93jljINxSP14&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E5W6gw_vA6_9mvX0_Y974Lg_Sdy5HoYlZR7b9E2SkKQ&oe=69D8DCD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9guQJMFHFuQQ7kNvwGaKkY8&_nc_oc=AdobhW2rJy53CvTW0fF5AO751VE9NKXvRvYtnLAPllvkEt_-bFSiTg8HUTINzq1P2mQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39kjbOVP-1SA8EVNNOHEXhxhx8YR4JyBg16zj1rHd_Iw&oe=69D8E25B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tKbkA1BRqmUQ7kNvwFHnAE4&_nc_oc=AdpA9KJurCwPHTpOotZPotl5Tvt8LSuQ2_nw6-BLecHaPgZlclvdvHtva6oQ6RH4xqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28lm8a50HvYCOR2GyI9Dt2m2Ka_wsr2GJyPkBY97_WDg&oe=69D8FD72"},
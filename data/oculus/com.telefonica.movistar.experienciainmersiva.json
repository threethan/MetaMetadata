74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1-bQXJ90iEQ7kNvwGVxf9D&_nc_oc=Ado6dcjDJxDVBsxrcgnhvO70pGR4OSfoWjb4ARiqUUSBUXEtZz6dgvSPdIAP4tTGOzU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_PjCMBbJmQB91bpSk4PT-B8Hi2Vo6Ln6Jth9A_GwY1A&oe=6A18496E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqQkHfdLOT4Q7kNvwEF6V2p&_nc_oc=Ado4WBa37IBUKnY9CeSvNhl6r_W7Da3wydV_VB0d8eGmuRUqxwqKEncv5pxq2hn0Dl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47DsfKr1NAnitvFEg9riqiC-WvSdrm5ryx0vHvIwysdA&oe=6A184573"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ktjx62cxZ7wQ7kNvwGHQZmV&_nc_oc=AdoMzZiZw-vNh12iDAL9lyEkKcoBlZLG3da_43G4YvfjTujDkUk5n3gWvSk64Nl6BFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g2oTcC1KflzQt7vrYB0zjXA2rERb7TJ-U8ravkkP6-g&oe=6A185D17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5n0PmQBnqrQQ7kNvwHu67Sm&_nc_oc=Adp_dbM1pJ2nHutm20rC2JXcH8DeeQzmpiyZ1rLDw6mV7y3yattwV6EkPJq7jA1TzI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qn5q4LE4XxRW1yPXEI0vJXbf55EEc3u26LueUxeS4Zw&oe=6A18629B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJm_nr6GfxwQ7kNvwGd5Keg&_nc_oc=Adp3Vgqg8fbJhHfAH4sa6oxxE3mHdS14-wC3jKFbWd2JiVF5MAU1NVBZa1b2ZTwgG3I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OciYfqswy3nb_n6tkQLHgsiOH2QviJCMb2IfsCU9ekA&oe=6A184572"},
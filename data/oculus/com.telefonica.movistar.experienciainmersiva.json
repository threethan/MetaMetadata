74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nONzAH2mwQ8Q7kNvwEGGPvU&_nc_oc=AdqIhTwiiRnj-72xRsyYjuMqJQx5KEXMMJ14gnU3R_FOrwKv8iluBHQFG7pvxE7YR0Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRUbCf276Z_V38sZ0QzeY9zyYlym3oc5msUsQiejIAZg&oe=6A6F4C6E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts-1gxuCHXwQ7kNvwElei3E&_nc_oc=Adrj4Vk4MI5dfI4qYevgIynNxRHzgufR-74NjtzCt3qRapFEGBX1c-aCIg9m6BS4YMg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDwx2OyAU-eCQKORHcCnXRJ0J6BfOAtEQJMGeEQOzZjw&oe=6A6F4873"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnaE2cJa9bkQ7kNvwGLfNU9&_nc_oc=AdqTyH9P2ylv76-JYL0y_u26hHwhpK4cRkwP05ZY3ryAp_xLjwokbqdaR2F-uMxhLz0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPSXZgLEXU94bCpCyxyOwWgUcnBEvPVw_3Htjl8Kc__g&oe=6A6F27D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=766KHpaMRXwQ7kNvwGpZk-E&_nc_oc=Adok-rdq-SCuBwMEtEgps59dg8faHpoMkn9SHUiURKwa3zufZSta8s3mURXiHSPXSzU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADxGLCIpe3bE-lrcW4B_4xXxYQCrLR1S61Ci9uGVF7sA&oe=6A6F2D5B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqpSkem5NVsQ7kNvwEIfcPg&_nc_oc=Adq5MneyQW3z1R_ucyhBCFY1BK6B7qNF7qi_KfrkVLbCkcUTpEee75RbCa5vZcsoYNI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvo9mOP0fwScyc2oFuz05zN37P6ugIh2PsVeddPHzKaw&oe=6A6F4872"},
74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpmu72U3IXUQ7kNvwFDNH_1&_nc_oc=AdrSUY9vGDJ3D0YK-498UwS0q1RnRF6mcKJaWyBeqX9SyRGCntiObwIiNsW1aKi0iX4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oo4stmcvHaZkI-ueIw1cA8lD-EO2Vobe9P9YNueE2LA&oe=69F35F6E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUaI57eQKEMQ7kNvwEUG4Cn&_nc_oc=Adr5PhEms9VYoB5Kqwrmkl5T1IoWAeeahYXUirua-WKVX8hQKWu_kZkq8ld9Og7ZaP4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TL-MUbACitJIzxt7lIGK3XaUj2x92_hu5GL_40doCBg&oe=69F35B73"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdDNXyYeQesQ7kNvwEvA5yo&_nc_oc=Adpn9jTVQ5dKj2xDgrUbApflnCLQPwWkmCXW7oL4D2SS5JluPbLcuXGVtc3n5M6tN-Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UJWVgMnuDpeKbZwdBK8LfzXNmT7oiyQkMC78QEysSfQ&oe=69F37317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSKZn-gMacUQ7kNvwF-looG&_nc_oc=AdqChHdLIMEcH7RsHDZTftWVQqWwjgwdBc2TNBHQSzOt0CAtz-F9ByncQyQYNmSJhA4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oFZBPtM6OF3gvGHqQmG-uKlJ9bimJbvTh2SZttYH3xg&oe=69F3405B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSMWuJaFvqsQ7kNvwHJHI2E&_nc_oc=AdqKaeZNtPPOB0m7lWJHCTOLeKsFtlehnerfj7SbDU_xOd2SBUgXcdTXfn6rw7DbTLs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xpyXnBNXWgqV5isyqBpSsJGiejsWcbMN60lnkEDeIFA&oe=69F35B72"},
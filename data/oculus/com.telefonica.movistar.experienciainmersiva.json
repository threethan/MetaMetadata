74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3Tjg-yeJCEQ7kNvwG7gCAy&_nc_oc=AdqYuRRTXeySsZGjJBBXNd8jvXqpoMl0agxL77xc2NmVmZPPEtT1lPV85RZed1B3Vss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjm--c6rSyrWXOHuj_6BBUZD83CaX9vMtTu29UblcwfQ&oe=6A4D056E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJw5JrW0zuEQ7kNvwGBg6BJ&_nc_oc=Adr-iaHoTQBCEb0nXdeJyijpklPAGKRY26yqfd1L4lTV2OGhpNxt908Tu_-loJb6BjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCosRyK9buOqyHNixtjMDJYPQRDosMktpxnqCFua0_2eg&oe=6A4D0173"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyGIgptZWTQQ7kNvwFD04us&_nc_oc=AdrtM3ZzBe8Fo5yBzP6ZQNP1zhfCaFo8Nb1fOAHNSYynR2-KPjHUA_VLmiKsANsT39A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL0_2QbggCbpmRgXs9vDmzBAlgX0WaAYJqKQPJy3isig&oe=6A4D1917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H5a40BXn08Q7kNvwG5yU8M&_nc_oc=AdqUA5_y3DpOTis5P330t6iRpO8SQrLJinNZWVw-ygptvjEZ2ZboAAeo4nDOS5SQvbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC50RNDDyaPHPHaRr67tJDBoKoRcpL1kCSYd-z5J0URVQ&oe=6A4CE65B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ikmNnd4OXSoQ7kNvwG_ZVS4&_nc_oc=AdofztuDHhuwmvQcSaPHnBj68OfoKBS-M-z_99jVn3DA9KenXjIQUEK9L6_J9Fg6CAA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQhTKlG-UTRr5cuwnAfG-Woh39XycD1-jazPRChHLMEQ&oe=6A4D0172"},
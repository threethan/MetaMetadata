sid=6e7a0a&_nc_ohc=DNNi7S41HkIQ7kNvwGnm_8W&_nc_oc=AdnyikJeQwzcrMaEU8W_mor0kN8LNTK8HDrXxWjh9Cs8De9CmJj9UlfxN_xSe56kAew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfweEgVMsvblfOdZqh47YChe2WluCQ7EwAPS9P5-iEJInQ&oe=69B80BEE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPzwLSgSXeAQ7kNvwGjF625&_nc_oc=Adk0HUP3EeQ7Z_QljevI1HTZZOhfGPdwsGD6tzOFyFQT_XJ6p51xk9NVHxGUsjqr2SA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhCKVYpj9bx2oeKTffRyOoVz_iwzpnwnNXk75GA1ZXbw&oe=69B807F3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxcLz4pzUaIQ7kNvwGUTXk_&_nc_oc=AdnL-TY3cT9OA3ccA6vTaLC18-i4IW_OSwj5xPQwW8SDiSFllNyfnMCq_0L-yDePA4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuxBlS8NF6AsNhYVHGgWNgaQEKz8SgcZ2Nza8sWhHz3w&oe=69B7E757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6Q3_YOxgdwQ7kNvwFtFJn5&_nc_oc=Adkv8kZAi3mlA99hqWvt3t_ZYT3tzMK83u5NslkLPy6Snr4_Qc4bpZVemS-9r2xE8LI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy1qyLeeUmeknFoysH69D2nhlasFNwgX7fPo4Bz8njMkg&oe=69B7ECDB"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSbsq_X9gesQ7kNvwGjTtZ6&_nc_oc=AdmVpCYzqGKwWt1PkKesPqtulFWD0kIH0rbvlu1f5VrEfOeMcCnooWlLTPRsk5nfnC8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw30g1rDJs4Uosc2u3JNWCNvoZWR4669Hq49wvIyrGACg&oe=69B807F2"}, {"file_name": "CoverSquare.png", "id": "109533071443553
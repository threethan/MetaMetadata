8392171674588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxxKa1pxcToQ7kNvwFBmzAM&_nc_oc=AdrgU6QHuzR2KEdI7hvjlN1tXjx2b5MUpWQ3hnX_4eoDPqR0mmzSGzjvZBsFbHqYAiA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzL-HmxR6qbGcYQvBXH4KFbtuSAp2PbQknghhB77sgMw&oe=6AAE946E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4W5iyYBVckQ7kNvwGuS7oT&_nc_oc=AdquODAe0S-FpzhwgXrkuyPN8PgHDnChIcPDn_j3KtIn_WHKTM-dPDc02Mj8YilsdXs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-6jSoYJbzLVNrz0xIofrISRseuemHD1586fGOFMqt0g&oe=6AAE9073"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC6z_XvIY50Q7kNvwGG5T1b&_nc_oc=AdpH4VS6fmmfb2M8AjJUO2zzzmllng73SzaAzkhIwX-keB5P2Z8TJNm2ndv2VCvKDfg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1XjBpxZb78hq2tyT51ij6Iuo8PQbzHG4qqCpJvmRAWw&oe=6AAEA817"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4PG6y_jRPgQ7kNvwGj8wSv&_nc_oc=AdpK7LBhu0PboBrZFmwhxALJwTIatrVhjY-8h2-JzpKFs3LejjYptnGK8I3Eg5XNoOk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKirGHRwYeLexyyFqe40sWuz48VxMl8XX-QxjBZ7e9MAQ&oe=6AAEAD9B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFzsGKTAHpwQ7kNvwF3XLTt&_nc_oc=AdoFD26_Hd5k6eCGDHfpH6zUuHqZe-6NwTChaTMlJ5QTEGmaP2mvUSrn226u0wn0WUo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ4-aJNguQR2apq8ycRUeULpUnePYMsruV6hcqGWpj0A&oe=6
RzHtIOuZAtFrBKfAYYk-EVoM4TVMLz6L37as&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuBxlGFe5nmf1qmxo-Wfm89eAx6Vn02KtiAYgWz48cQ_Q&oe=69A2F3EE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YaoFT_BAVEQ7kNvwE0vZjQ&_nc_oc=Adm_EGVgMDmzftoKZf0TlT1XX1kidWUkL0oWIYc37TKrBk5HJMxXDWaor3Cj61YHCOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvLSqitblbyuu53m4GUE9Q96FdejoclYuS4zusVnch35Q&oe=69A2EFF3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ByFNQ6fQLoQ7kNvwFjRx8S&_nc_oc=Adkx5PQ-1p-6r0iuWxkjMZjaYs184d8MmL2oMai9UTjpriMaa0RRIGt52AEh45o23pc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft42ngXZu_BST7OwtCVahnN3uIwBqwPZkbCWsbX_jFwMA&oe=69A2CF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ATJdzE3A798Q7kNvwHNH1ms&_nc_oc=AdkVFYEHHiPvRQp_XO7PzaJV_lwAaAvl1FKBHLikn5ACmVMMa0ZWfm18lHWq4DcHu-E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftb96C6ypHByORIOKqkv6QJ9x2WBszbzuet-3weG08xVQ&oe=69A2D4DB"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5LwkvpLfgcQ7kNvwFqfkmA&_nc_oc=AdnNgDDf9wN1UQVq3Yyjb33SgQXNlK-F-8EoL1SipeLLQ5WYcS7M7ElEekWYk5Ql-gE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuKO7rwjz3Ly9-bHKMPeCZ1ahjxVOn0mqe7armMZ39n5Q&oe=69A2EFF2"}, {"file_name": "CoverSquare.png", "id": "1095330714435534", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974799_109533072110220
74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrxOARV6mrcQ7kNvwG1wcYH&_nc_oc=Adppnr4UxiFy4KR8ArEsTQ4LoUaH6p-QEvHmvtILBzeJenu35WClDXEx2MlAiAQhDJY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGoXqweGe_GfpEf3b6KwYex4G7c--uGYq1pUvTfpZcMXg&oe=6A77356E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmlj6Lv1OAwQ7kNvwGrDJG3&_nc_oc=Adqnsu51pbsb1XkTpT5otF-hgKjRVmMRpDhf2AJbawUZSQ0Uz1WqtHyJd3NKGbr4XiQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrn-2Ohdb7QSUDI9IotX65IGnuUJlCyLXluQWRULe9RQ&oe=6A773173"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e81Li0h_6FwQ7kNvwH_-PjN&_nc_oc=AdpSBdfWmoaMlTsKLKvb3meAKPrtupg7YDOB-paYa_q3kES5MV3tdicB98RNuN9dL2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0_8n78LzRxxYSipoXSIkxaIKJd9XIz2KKtmWc7ckczg&oe=6A7710D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bezmTR_2za0Q7kNvwEIjHGM&_nc_oc=AdqCMizm9IZAOXmT6sulpUOfBd4uV3smHM4Rh3Ak4_KgrSS0yYI1MYEPvl0IeUAP1UU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIRW7E2TG8AEwZzzkYwZkG9Hnxa2AYXR2W9Z5eD-h2ng&oe=6A77165B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=914fgS9JAMsQ7kNvwE3dkl8&_nc_oc=Adr_7aoZZPHsGRTSwrkppTePCYb5e_AjoL3av5PU-bPnKQzjZcw2jSG0dHsy0z9z3NE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0UGhLeUeJ8FW92-Jtq2Wj9bLdThFMv02eJJphbB_1Aw&oe=6A773172"},
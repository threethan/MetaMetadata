74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN-4TAjP6CEQ7kNvwGq81Go&_nc_oc=Adpv5CBv66kjs_6JPGhnymBl9q7JRdaxmhW1tV8uAwO8rR_m3QWnqi2qD0Q45kudJ8w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9474qshnBpOjYqDAPuxjuzIp7VpbD80PVlWxmYnli8ig&oe=6A30046E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5bN2nQSWSsQ7kNvwFjLUOW&_nc_oc=AdpubodFzith7XgkMFQkfcdtvqTrDv6M5qEhelTQYEMdM0Pt2JkEbHDPNGjj54VjBmY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YKRd5lbVvgWL1HRd9CA8c7QLoYvoNO0QRBbtjaZp_fg&oe=6A300073"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsB6FQP7MAkQ7kNvwHghW-J&_nc_oc=AdqoyBXENmDsAWvCBUzn6V-kmottlQTa5cPUML0XjhTJtotQp_oLkO65M5kdhr9hTlo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8R-kgIOqIJMWPv9aFgPESTe65HE3KZHWnrgAvgOuNDOg&oe=6A301817"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyDWPY8sMyUQ7kNvwG3qr-h&_nc_oc=AdqZP7te7cCv7AlTRtLQTpnKW-xkpBdlthbDDw2C8YR8xINDfIow4GugqvJoe4BeSRs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qM3x7thz3hjkVKHaUP-lOz7-NSDRXKpmUL3nfdgpsZQ&oe=6A301D9B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iMIgPkk6gsQ7kNvwF3ifdj&_nc_oc=AdpAFYqp5nvE2f4zIMjslOGi6GpNtkjgO4ZCbav4QeSxmrp96j2T2afPizTjw6JMoaU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uOyj_YkjcYagHWmObX7RK3pKBQ4XdgkPlJc7gIGrsaQ&oe=6A300072"},
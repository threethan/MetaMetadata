Jy55w-0NZPAVhyGCrbJ-hMbPdXrg147GFE6Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft-BBjB_b3I93BDPRxLSxYabiIah0x_j5wieMq2YUDwNw&oe=699B0AEE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slpsOgvs47UQ7kNvwFJpjQD&_nc_oc=AdkA26HaDWT0ZgJCXyu9bDDl3mZUi3Fzp_n33HfH689r2OPedHv-jL0mq5O_26sJr3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvm1JVQ7WKLuvIO5CSaIjDXatBIaqGHbzaUEuw_k9loow&oe=699B06F3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmYYTBscQd4Q7kNvwFWja4R&_nc_oc=Admp6VS1czZtMuDv6gjdh5DQLVmP1C9nD4xEf7cO-FuvX_XBDOfR46UQWvdVBSl5B0s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvoDkzzFIyvUugichjGD_RuAiy_LZhY20u_F4XpPr9mEg&oe=699AE657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JZ8AW6ehwUQ7kNvwE0Zehu&_nc_oc=Adn0KRsmLXFzg0hcKA9baTPUjTFzyTASYmFPvCOTp4ypaJxHv-Nsyao5J5yF7M2fti8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsfBLPHZEx9RtLP60P_vaU7N0Zq9xTtA_5SrBVqDy-hiA&oe=699AEBDB"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQiD2QkHAMMQ7kNvwGpEZWb&_nc_oc=AdkQk4B6tFUy3Vt3iOe65aZjGtG43ZGWRJSMJ5cCAibPwyP6h5g5UwF2DolgvlgjF9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsjY0k0X1ocdDT27DHn6C5-l_W3UQ2nCvfOJRYbT3PVog&oe=699B06F2"}, {"file_name": "CoverSquare.png", "id": "1095330714435534", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974799_109533072110220
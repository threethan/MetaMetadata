UpzIbiB-dbI98fFTGgAoFgS5vVaDoWoSdi1o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfusUNDYtIo5iTA9qBeWPg0lKEEBkzsQE_7JC1pJMpxkSg&oe=69A6E86E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOgDRYxy1z4Q7kNvwGxTnzs&_nc_oc=AdlToH_Zj8YHcM0zKof4vb1q4nBxoSGEUGfCcebQpRi5Yl7hJEGoUXML25Wy63C9N3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs7EqYxbBirEMTzI209OYGfn-C6oStu6siiXi8y4Hd6cA&oe=69A6E473"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlPSqkLl4qAQ7kNvwGrKCc3&_nc_oc=Admy_e97cnUHsCWWUuA0qn84TxMn47qPHkY40Y_u7a1eP3MTGzu1evyzz0NgtNpBEFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvhx6VbS4LBs5h9Ltsxa3tsQm8n6OKxqWCPQFb8alb3zQ&oe=69A6C3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4RwRQdmYPIIQ7kNvwH_Mwi8&_nc_oc=Adn_QGjblxb_NXL28GHOwavBU0LDKoI9H7B-K9xOijZD05uJmBI77lTweoQCLnVtwrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afudk4Qt9gssIOIToIkCQdDtejdKjNWj4mQUWMBk1IXJFw&oe=69A6C95B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4hAp5mBGhgQ7kNvwEcjIuK&_nc_oc=AdmfQgmSRrZTos638Ph8eKlaTJDVbd9KTDwxq5QoQFRnOUK-Sh4N8Rp1jm6g5qBgejI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYk48_q3axoHVv1xvKE0itTB87WdEShXKflW4x4ykSXQ&oe=69A6E472"}, {"file_name": "CoverSquare.png", "id": "1095330714435534", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974799_109533072110220
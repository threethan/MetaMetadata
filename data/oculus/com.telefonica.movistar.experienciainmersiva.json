sTF8Bgl-xiOfF2OLyQK-tko4lrLfCnrOHU1U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftIEZ4aQt7PTx7JQ3UiVp7iTtL_rVyO-r5f2T2AO36lxw&oe=699EFF6E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yvi6sBc9bwQ7kNvwH4J5fD&_nc_oc=Adn3mSLa1zhcRyDiIdyHTM-R1x7pqEOQkvnzi7YSr-Mw6n7IQgQTikJbw5llac55zq4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftN6V0vB_3eIIFIPv8XsAj18PBRjzh1mL4GdQI0MsF0eQ&oe=699EFB73"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLVixEUE6xoQ7kNvwETglJX&_nc_oc=AdnBvgyIpB3LlftndBA8GQZ-tQuPKZgpXtR5ggL4DSk6D9y74F4cK42xYXwYSod8sW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvLuAm_f9r-yWvoAUOCIQ-DNCuvaL1t6YZa4CrwM481Kw&oe=699EDAD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9oJhaf6p6YQ7kNvwEa1fXY&_nc_oc=AdmK7I8f9a2_EOfsRnHkbZb_fZ7C5CCtxfarVXlvXjBB9RPNVaderHe8LxlvwSV2qt0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuo2CVG0qdT0uc3wrOMQ2nRjWSh6Wbr8pNYJFZGeC0HzQ&oe=699EE05B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3B-AiJDTNOgQ7kNvwHJTytw&_nc_oc=Adl-gFnv-IMFQpV3A_Q89ifbqP5j5lG3_ecIgwyT0PTVOq7YolcAEFroo4FL0Dg2sFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvD3ddoxNdhkbrziiXH-ezF27I2T6jWvW7NR3bEg_7VBA&oe=699EFB72"}, {"file_name": "CoverSquare.png", "id": "1095330714435534", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974799_109533072110220
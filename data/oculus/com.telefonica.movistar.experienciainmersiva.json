sid=6e7a0a&_nc_ohc=GgKWGg6P-LIQ7kNvwH57jqM&_nc_oc=AdmZ8l2iQc87hRqTN96_QB82iM4x55Ux6FXj9lqFOYqaxD7wLMW6q7YTI6ylMuUTlAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx0ndQtKIs6Fh07ixAwgeMchm1cdKMdb2qgAeUAkTWt3g&oe=69B568EE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1bWxN-nRE0Q7kNvwHKD5FD&_nc_oc=AdlMFFvCuZ2oc4OLmoxeupMT03myAzKfE0OLow66oRwC3aQe_x_mf-JjtIy0Xbjq_aI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5tG4dqIsb8PpK3DOpo7zLW_e8RSstRr9cIhMvhIGyHQ&oe=69B564F3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4bVDORQPsIQ7kNvwEF1fMf&_nc_oc=AdlilaMePoy_z1ARsGox03cFzc88XWi1XLSk_BVzo_C91t62SPHNMVcv_uF1Eq5wr9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzSRMSrhPDgApI4qx8Uej52TobUmIyOc065SZLEKKYj6g&oe=69B54457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZTxz5QrRFoQ7kNvwGlDp63&_nc_oc=Adm6z8G7LGhw7_uo8Dnk9skjcPdZ9ikfA0g2yepklGJMJi-SHeupaEO0Eke-tfV4gr0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2RiE8R8kUqxOBFwhIJAGidAJHyJon9FmPvEhAlsGthg&oe=69B549DB"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9y8dlaM8OYQ7kNvwElv_o9&_nc_oc=AdmzLUWdcr21AsIlm9MUbb13VxVTYCgVCJ97zxwjVNKbNsM7k9NT2cTWjswVZ_a-bxE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzefFMJDeLxVjvo94z0OxKneqn2X3c5ob4JTmFWtbyvgQ&oe=69B564F2"}, {"file_name": "CoverSquare.png", "id": "109533071443553
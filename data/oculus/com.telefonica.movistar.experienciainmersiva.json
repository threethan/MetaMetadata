9226Y1RtAQHvB436qiCKOcIduk2i22bCXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsMYcWcPEL8IuTFRTF9G2UyY0qqswA7qu-jRLB6mCq3rA&oe=69A96A5B"}, {"file_name": "4_MEI_Hogar.png", "id": "521579957165849", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393984_521579960499182_7377358785700743270_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_EncC122EkQ7kNvwG8s0Z5&_nc_oc=Adk_Ky7v6StY7pqwtQcxMTEPH7xfysTHBEPLqT6FM8N8bNvCLG0Lb3bKdRCgUv0tjKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsPJhTxNRCYDl30OLIqD0TJa9i1sfPci432FSFwpmcrUw&oe=69A966FC"}, {"file_name": "5_MEI_Aura.png", "id": "653656373842733", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391952_653656377176066_2639711200570648997_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7SuiLb_nmkQ7kNvwHuZLEI&_nc_oc=Adm7k3R9qYz1RHWqmHxsOdksHo6eGAWKSQ3s3EgB9i-qjv9Fquf2k06W8bM00JXmbdk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuYeAu6VAGjiXQuEHnClkC3nd6LH2fjSWWD14zabw_82w&oe=69A99049"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "1103774314202192", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974786_1103774317535525_1945297621533715286_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0xLxosN9DsQ7kNvwHfzh6Q&_nc_oc=AdmUg0kyWmfvnJKaHHTEYVorMiJhglsCN6joHnGIA1u-W1xdP0TBfhkJs3lXoCN3sns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu_vsqJTONaUvZpYtI6Adc_r4ecmFM-fYlvbZzh-gwZUQ&oe=69A98CE1"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}]}, "developer_name": null, "developer_privacy_policy_url": "https://metaverso.telefonica.com/en/mei-legals#privacy", "developer_terms_of_service_url": null, "publisher_name": "Telef\u00f3nica Innovaci\u00f3n Digital, S.L.U", "support_website_url": null, "website_url": "https://metaverso.telefonica.com/nuestros-productos#experiencias-inmersivas", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"
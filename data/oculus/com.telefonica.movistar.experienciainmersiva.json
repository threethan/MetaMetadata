74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1vbrPybg_hsQ7kNvwHQM1xn&_nc_oc=AdoxMPev4GAAcJa9lKD1Ppj82ySjKkxW8TQoRBmDU8_jz8l6kHn8sb5890Wi4FqWFaQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEac61kEJdEiQPiXlwzsk_vWYquDgDRRxoovyoRFCNUDA&oe=6A93FE2E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoQ9r_byjGIQ7kNvwHVO4Pp&_nc_oc=AdrtgJC_XPL9QkV-aaejPjFqH9iqXjuP69vct5vfpWnkeVi0_q6UPmMEmmY32KAd8PE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZ9FnabSYk_GDEgfFDQhbqy5PnvBm8kIz6WPLqoAWHrQ&oe=6A943273"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMNWFDyCHiAQ7kNvwE-x15f&_nc_oc=Adqi7ptR04ptH77D8F3BbDgw1QwzT73X3etQTyOFFiZffIYT0FDecxxBV0BlGUPsZ7o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4MxZZDA01h9rJOqO91lU8FIUFg4aqEJOLQzi-PNwt2Q&oe=6A9411D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lG4WfS4OyYQ7kNvwErAtpb&_nc_oc=AdpioiNvC_Yw-ipdQ0P_u8gL532Q9O7n1jIBQHldN3lHX56NyLDGzxdFQe7xKSKpRVA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4ajK1qlyLAbFuNBnZda0ernT2DXPIKyaZQXjfLXaqkQ&oe=6A94175B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOYSFQe0MpUQ7kNvwF0-VRY&_nc_oc=AdrGs1NwbM_ktSDuwyprHyKOBV_Qb0TxqurRziCAvAqqfZKtbMWcgp5M9AU3h0D45zo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtxTuzq0n3cfbo1VH5U6UYzX1OQ5UQcxgFtrUS_Fcizw&oe=6A943272"},
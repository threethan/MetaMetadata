74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN-4TAjP6CEQ7kNvwEjOVWU&_nc_oc=AdoFfYicighTuamQh6tVo-Wo_My6rds1jOFKOauDitKOI3GTFmMgNtf7Ylsd2sCBQuQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZgQ_vB7DORgZyWq54ds-RijJf2UHlgcv8yl3OjqNfJg&oe=6A3155EE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p5bN2nQSWSsQ7kNvwFXBsVG&_nc_oc=Adr5YPo_3KwrdFyc1WfNh1zmcF6Vz5pqRq18YMAfXP25vYTD7ghKbSsGw_luZqPeYS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IyC1e05VRuOnS9envkPYV4GKRH6QVQOjVOdW33P7a5w&oe=6A3151F3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsB6FQP7MAkQ7kNvwExJm_M&_nc_oc=AdoYQIVyR4B35ysLS8dJHSVFSTCDfgPpMu3gL452FsWxQWSzB2jiPYlW9i6TTM-osyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OZJ3hfQp1OO_ALk3Vf93AqDl0KI-mRd0NGjfcUGGoEg&oe=6A316997"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj8R0CehTUMQ7kNvwFrLRH4&_nc_oc=Adqhu4Jf-mg90dYi5t7H0LsQ9xi0sxtCvbci9EF7Z1TRqwbGx53iMonBLsNqHZmud8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XlNUDWS-9weAm4b_NmFEijRZirzVCM5aLYE2mI259hw&oe=6A316F1B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nYUZlvGbe4Q7kNvwEzsVSI&_nc_oc=Adr7zyA4YZzaJP0aapcTWs9YTXorPin50hxJyN3X0wOuVlemuLeEZ5l3tQs8bDYfYUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BqkEF5mYvtLkC_osyjb73_OMjPVdArNn3mNh1q6zRCw&oe=6A3151F2"},
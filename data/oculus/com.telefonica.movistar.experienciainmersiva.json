sid=6e7a0a&_nc_ohc=O63Sgnyr7cgQ7kNvwFiM3NV&_nc_oc=AdmJbsc33QqkHKiJgdxZ18-qwDNChQgDQMSw0-5jfeXSfQcP1aVscPD2ZpycnlfsWeQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfydAUm-uzYDD6MW-XrsR2M7L8GxIk040VBzqrDJ0a4oRQ&oe=69BC006E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6P32-b2Zj5YQ7kNvwHZ1Twa&_nc_oc=AdmdnvvazPiCEH_nNMTxy09QqqZzWWMHb-W8qmPjynu2paeUSDUEyrQvX8PfjrzjbFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKpZt2kXlqxWyudl01yVj1nK-2ppVQhnQvmrnUiAl1tg&oe=69BBFC73"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0FFSg9MomkQ7kNvwFuX0Rx&_nc_oc=AdkjkeDeNjgwZkZNElpxWCGH6zXouXjRXXz--T_nxUb05YFir7gWlqHRsqcyzlCyAvU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzDFi9dUsQddz18d7gbUEs8LRuyN4FD3F6J-J80O8_8Rg&oe=69BBDBD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7XEYz0A3mUQ7kNvwGFxaJd&_nc_oc=Adk487GRKChD9bqYhDx6xYjAtetXMLh7wqUon0oVG2QKB2kvWaUI3k4ModFcC-sI-hk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYqRezDGtC-BPtxaiuj9UOLy9mjqX2oDXgy4cX54bvBQ&oe=69BBE15B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlBm2401py0Q7kNvwFsn8h5&_nc_oc=AdlcUiq9OKb8cMCmssYZbaISaMg7NjZW2ow04QAOebWg_4WclvXQFYhglOU6Ui5p-7w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxihdP2VMYMcSeI34AGPFzDDw96gZplYUuAw3Xtr7A9RA&oe=69BBFC72"}, {"file_name": "CoverSquare.png", "id": "109533071443553
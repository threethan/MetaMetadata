74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq6QXse23UcQ7kNvwEW-LO-&_nc_oc=AdqQzXxn5fAycXDIOOaLl0nERDUChSWHbbXOp2i7PdNtTQjem1cECRYU_O--e6vQL4s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wzVF0Uu7Bbt7Iozw98cBJ_94RTwxnZZS90kt7WR9KCA&oe=6A1AEC6E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iTNkdys7pSoQ7kNvwEQ6jx1&_nc_oc=AdqhXOdT7jVZ5nu5KozWsFyqKjDHCuf5VihNJYFTcC3_GpYnw2v0DwR94mfEAsCcS5E&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lvxJqhKDX-l8c51Exsyr5V2XlRHw6a9-OvJKV_w0_Aw&oe=6A1AE873"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QS_d-kCR2WYQ7kNvwFvowCZ&_nc_oc=AdoPvjtAShq9M_8cPYqfNWAqG_-7hH_swbwJ1bx1o9ZMZEnxj2AHC-6uYaQVyc2OFWs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-zn10HXD75X_z5V74MHHKaiXKnriVbxNSpa0jNu4UNA&oe=6A1B0017"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kc2VRYs0zf8Q7kNvwGQkVol&_nc_oc=AdpcU9U7ix6liifwP5pjXgqaYt5qVMBcPgNe4S8BSVpMHvjSQ83qGbA84zeVfFiBXHU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FDsAJl7tLstZ1i9e5-KcbFetoStPIvvK0J56S6GIu7g&oe=6A1B059B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuTMnJ74kaEQ7kNvwEY3Bfa&_nc_oc=AdrX8alZu9S0afPKwlbp6JwwhdeNss5ytUwIWU4vJvTt0cTF_H_XF8CFRCq8-d6dtF0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KGQKTXl4kJnQZRliygBbx02OX7GKomTQEoNP3hK3LdQ&oe=6A1AE872"},
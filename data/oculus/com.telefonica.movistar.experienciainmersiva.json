sid=6e7a0a&_nc_ohc=DNNi7S41HkIQ7kNvwHeWzRQ&_nc_oc=Admen6FfFemvdhbydyl1quZOcwoYhoCfJHM1wEnvzqBLxtfot-zjmUIfWQQp3q-DS7c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfymTB_SVexYlnzxvIu6CdxKTk4ZxYKHQ-uE0zb7if4OGw&oe=69BAAEEE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MPzwLSgSXeAQ7kNvwHJz4up&_nc_oc=AdmcgBcaOjOuf2wWAtxxKRFYtKf7DXADxSIruqCIgP_xAe55G6tLeeNAcYJ-WCfenms&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzxbtEF0P8VzAdT2LS0oypUP_QvazV9rkSLWvbXcGOcw&oe=69BAAAF3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxcLz4pzUaIQ7kNvwFcuF2l&_nc_oc=Adl9WtdYLJ-w7n-Li7HZKQoNnK4irEiIKsqKeOjbeZ7Zz-FgGTSZqggJlkuye5_VDTE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzR9_t7AMq6jo3GqBSDBi6lFNFSqUUzmebU8C6jNOnAKQ&oe=69BA8A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7XEYz0A3mUQ7kNvwF8VkrC&_nc_oc=AdkQ79RCNHQg9hcHrdOwaerU-9sgYUm56ruP3KsEvx81Oyw4STWwQ4DZJdDLz2wd_ig&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyYvILlOJ-N9SXtZOh8obAuz3yKxF_HXFB8podx_ZfY3Q&oe=69BA8FDB"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSbsq_X9gesQ7kNvwF0Uf8l&_nc_oc=AdnkKr_W2Q8-_iRgs02z30ek07I7IKqR0COcEJV_XN94f_MiDgbNSaA0zoVT00q16lY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzuiK3TbGW1TOMI3Q-64WHYVD4m-_ty6IxwN1s6vkj8QA&oe=69BAAAF2"}, {"file_name": "CoverSquare.png", "id": "109533071443553
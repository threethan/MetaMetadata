74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpPrDyGCJBwQ7kNvwFcJ04e&_nc_oc=Adou0FtLzjRlkQowx4mi6_TvpVYbfD97ggs-91ba0epZLNz3M50WWx3y4XFbRBptWXw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z224yKC7RBX7kAlNdpqZHf1wO8Iqw9_NLzwhsl-pOWg&oe=6A32A76E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qFZyhSLk7MQ7kNvwFs43l_&_nc_oc=AdrFcttfTGHDZnunIqgM1vYHj9XPDNR7h7_PYMDOmlWEGxFv5GrC7a6YscOE3f98OGs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z0jejX4XV3hCe9xNLI1SXFk7KlEd-tbrul4gQKiY7Gg&oe=6A32A373"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ELdtWVSLFMMQ7kNvwFCtrn1&_nc_oc=AdqllvRUnLnt0GLfvhQ2GTAtA37MBgbcJraw52jGVO8vPKLT4PzvmXNDxj-9WH41nx4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82zpoq7UHm_iX4FViBn-YfPiM9aIHMduE_OCZTM1xqHg&oe=6A32BB17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dj8R0CehTUMQ7kNvwHBfO41&_nc_oc=Adq8PXAPHLvcjX6CmkKE6fGuZFUGKwbLa_SC6ep95deaGnM1QkdGeXRt3beMmVDXnXU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8saYsfOMP-EkfnBRKAeK7dWGieCuOcGKvSCUTBuPJhlQ&oe=6A32C09B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nYUZlvGbe4Q7kNvwFuAPih&_nc_oc=Adq6fo5GCAPX1SXpZDioJUIF4DPgQAtFtNBKlI9-bHBvpXD0yP1_KU1WC_SCUr8IKiI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BList4drHHCU-h8nCwENcBNk9MRlCqRcIaU3v1C0tLQ&oe=6A32A372"},
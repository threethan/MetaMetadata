sid=6e7a0a&_nc_ohc=m9edkD2OALwQ7kNvwGjEFLf&_nc_oc=Adp6dHvMeQ9nLCYwcAnoR5UUC7i6E0uD8iFEqDq4H4YIgoBbnM8YJiHJTRyXSlvi-FA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJgNZ7aYTIsX45PVlyRgUrU0gbDTb3PmFelKi_ZYbbAw&oe=69C1466E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4p2ajodMv4Q7kNvwG54wxP&_nc_oc=AdoeLTBa_60RX05lwXs3o4LlfyTSrljm5McbDKLR7MNTzbICvg8wHzg_nXEd9YkFa8M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyINFO58GXz5vMZhRlf8RDwPVURlt_yvfv1lwwaJCxWaA&oe=69C14273"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCs-VX7WJb0Q7kNvwFA-PoC&_nc_oc=AdpmY9XBiH7iy69h6RIpdMMhSwesayJbB9y33uZDq1qyhlhjOkL7NxqVBA_fSPjAE2Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzL8Wmgv0D--F82HbySDdi_k7KGwpG7YD1IpmI4RyAXHg&oe=69C121D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0-p31fVepAQ7kNvwGc6dSv&_nc_oc=AdpjU70eviLwR0Bc0gTaqU7dPp_DGxuooi6KDKiUmFHf0qcx5Vn7cWtdrchrFjMDWF4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU1JH4NMj7jPZVvk23MRXWpzdJhUChyPaCm0idaB67Bg&oe=69C1275B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsJQJ6NyBSgQ7kNvwFsIz68&_nc_oc=AdoK6__J4XtD40SH3nAJmbaFqV-Q72FCuAmdXl5cw2RcBPeXbkEFb6IL4wNEPxO2FUs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfznXZirKM-2cYeQHkrtzXFYm-4LJaPiT2ku9-89vx7-RA&oe=69C14272"}, {"file_name": "CoverSquare.png", "id": "109533071443553
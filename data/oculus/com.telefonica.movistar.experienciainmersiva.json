74588_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prW5h9OH6ZYQ7kNvwFcZhPA&_nc_oc=AdqiIggpD5AGnCcZKOk1L897aetcxETyZCg1-2cyDlkpgdQgg7mG4UtQ2gBmVftrjCY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBWNSpmCmr-QyIt5L-3a49Fp3ybNxFaiHpuZsH8RjDIQ&oe=6AD3B6AE"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni0NJOzdx4sQ7kNvwGz4y5q&_nc_oc=AdpGvguZ5QXM423-YaHpkIpbbeAikxKVzJgRoKK6cvB6pDIJ6JsPpVYRsYiEZXqJpCA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM7BiOJEr-f6oeFfh_5s6hUUlOadvGjiXX-AA6cXGXgg&oe=6AD3B2B3"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm3Zwt2A9eEQ7kNvwGyTLJp&_nc_oc=AdoCm09bWeITi6MOmUiIFGZBOrxyjz5zYKQv4scn5LRxcZ2xThWoBjmmkkyDdD0qMcw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVP0qBFBttpvcAEVzIv05UYMfjih3zNvI7T9_62wdcEA&oe=6AD39217"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhxXC3QVBm4Q7kNvwGfW_A4&_nc_oc=Adp5lSdETYnvRfRimwLDkHgeWN9iG2CvuHiEK9McuO6FczfWm3k1QTL76mzEh92clMA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd-4nT1cCmjEQ2lEIS-8Kdyw93E0D7hSsbV3qviQxbKw&oe=6AD3979B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LAnxTjYgaiwQ7kNvwGuXSRA&_nc_oc=Adr-ItsEkPyITLVQmT9M4f2Z5N7sKSlruu_z-8qRFdW5crgO9NiJJy4lhXr1XiyNRwg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7hOcWbJyD_spnSM_CdcFyMi2Xkr3LNa1G-RJ83xesxQ&oe=6AD3B2B2"},
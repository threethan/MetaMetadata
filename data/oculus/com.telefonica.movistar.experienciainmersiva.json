sid=6e7a0a&_nc_ohc=pb7yXX-ju4cQ7kNvwHUMWaZ&_nc_oc=Adlwu23TiAnIEf3RS8i1psQZUjn_uMbpFdbyqY_kyPx4dYLi0N7UCRYgS_cOQ608Xgw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwPOUxHlTLIT6I3pBShHqs14xvr9LlpNyideGy1J0D5hQ&oe=69AC2E6E"}, {"file_name": "4_MEI_Hogar.png", "id": "1019806189990152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391958_1019806193323485_7884210592693182166_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP5qbdwEr4IQ7kNvwHjjYUb&_nc_oc=AdliwRiLqWgtog9OT4w_TbkLuH2lqU1DxiWdXuNxuhst-G-wuzY1ynxehqvXDQFCvnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkPkmN2oC3bn8XeAaHuPN77AKsCZtQZ0EgjMriflEf6g&oe=69AC2A73"}, {"file_name": "5_MEI_Aura.png", "id": "1331078267926280", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1331078271259613_7073050539556029006_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLPb8KFIEykQ7kNvwFrGzxo&_nc_oc=Adn4Q7XDwnO_aGxV062870OixHPh3WE3mifeuzwkkApRv_OU5MSZVvuijn-vaZkL9K8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfylJ9b0TKYBCThLmZ_W66XTp9rVK3IDNj16QQW-LJZMuA&oe=69AC09D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MEI_Video_Cover.png", "id": "3283312481963488", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031535_3283312485296821_3761874336976500926_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqAlMpm-WboQ7kNvwHs6Bvx&_nc_oc=AdnzvYFCaFdJOapabZefXgE1LNXdPGAisSGDhddNAD_6EE4W0nEKEutKCkkiiQgKJOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyYk2_VnIbP38_TEPLvSu3GN0txq7DAOzsBWP70T2inyA&oe=69AC0F5B"}, "display_name": "Movistar Experiencia Inmersiva", "keywords": [], "long_description": "Sum\u00e9rgete en Movistar Experiencia Inmersiva disfruta explorando, aprendiendo o jugando con tus Meta Quest, independientemente de si eres cliente Movistar o no. Desde la Ciudad Movistar tienes disponible:\n\n- Tienda Movistar, donde te espera nuestro Asesor de Dispositivos m\u00f3viles, que te proporcionar\u00e1 toda la informaci\u00f3n que necesites.\n- Espacio Cine con contenidos exclusivos de Movistar Plus+.\n- Hogar Movistar, donde puedes disfrutar de la TV con numerosos contenidos, jugar a los dardos o al minigolf en la terraza exterior, e invitar a tus amigos.\n- Estadio Deportivo Movistar Dome, para que vivas eventos deportivos multic\u00e1mara con la mejor calidad de servicio.\n- Obra de arte virtual de Okuda San Miguel.\n- Edificio Movistar Series Originales, con la experiencia del gimnasio de la serie de \"El Inmortal\".\n- Edificio Telef\u00f3nica de Gran V\u00eda de Madrid, con el Auditorio de Espacio Fundaci\u00f3n, para que disfrutes de los eventos celebrados all\u00ed.\n- Edificio Movistar KOI, para que descubras m\u00e1s sobre los jugadores y sus trofeos.\n- Escape Room \u201cAventura en el S\u00f3tano\u201d.\n- Juego de #LaCasaDelFutbol para que demuestres tu habilidad parando penaltis.\n \nAdem\u00e1s, tienes:\n \n- Modo de Accesibilidad, que te dar\u00e1 informaci\u00f3n vocal para ayudarte a orientarte y a descubrir lo que necesites.\n- Servicio de las Metacalls, para que puedas atender las llamadas a tu tel\u00e9fono fijo desde Movistar Experiencia Inmersiva.\n \nPara cualquier duda puedes escribirnos a soporte.metaverso@telefonica.com", "short_description": "Sum\u00e9rgete desde casa en Movistar Experiencia Inmersiva y disfruta explorando, aprendiendo, jugando con tus gafas de realidad virtual."}, {"images": {"nodes": [{"file_name": "CoverPortrait.png", "id": "5461423913972359", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001729_5461423920639025_7233561727051198860_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfxME6a4f0gQ7kNvwEdvyZg&_nc_oc=AdkXCC93YHWRcDBsTCcqG3PtsI7oLsoxfHFNmf7Y86XYprsgx-yR1deSS_TEwRW1Pww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMTnVvYr-2KOmIPW5PukNUZ0yAl4JZOdCbOyq4aTvDRw&oe=69AC2A72"}, {"file_name": "CoverSquare.png", "id": "109533071443553
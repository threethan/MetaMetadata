90gfYgzhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afum5i1-7XmQqtauQUJbnwq48aZFCJR4zOxtiMPuJ3Ha8A&oe=69A6BFE0"}, {"file_name": "Screenshots_VRUNO_02.png", "id": "1875539212804777", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75234367_1875539216138110_2200508874973943562_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyB4L9BcPxMQ7kNvwExolzQ&_nc_oc=Adn9NVphBVZ2WeGTbDIMoHjl7xEzgoo5yxPUy0v8iC2WvmYiONhTEn_2p_fkHAzP3X0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftqB7_jP1-fDLc4MY5ZFr4mWfsVj7v_tYc4ELKV8IzMuw&oe=69A6E795"}, {"file_name": "Screenshots_VRUNO_03.png", "id": "1393233384811772", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1393233388145105_7723519974808662978_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL04Qdlug4AQ7kNvwGumJmQ&_nc_oc=AdkP8N2Lv1BQ4NVw8JfyK2QS92U6DXpaHqpkP7WyVchlDG0AFHwlrvC5DorS4qALtq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvhpLVtagKKXP6gxbh_QREMQDvqVLukuf7uVyIiwJX4ew&oe=69A6C3C3"}, {"file_name": "Screenshots_VRUNO_04.png", "id": "6057336987693889", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035453_6057336991027222_6846038808004926856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0fJgnm-QFQQ7kNvwGE-Dms&_nc_oc=AdkOKnfkA2aLs_-xd5SFWalTITgAViDq-BwOjjtUiRETea1SNO2_I7PjvHI4XyqGTBk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftD4COZ40ppge_rqoQclW4xxOot4wBbVc3aOA8cQvQHxw&oe=69A6DB7A"}, {"file_name": "Screenshots_VRUNO_05.png", "id": "172818745536092", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982570_172818748869425_2922139326075809551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk-RO0UbkkUQ7kNvwFw0Zui&_nc_oc=Admri4Yuoy8rT_BvDGv8Pqf_uymR4FKQq7cr-GCHP5iQCcsGVlbVVt0oD3CgziKB1So&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuu_G3PbSP6bG1Op8skOeo3mOjtJLiCzESymMGiBbttcw&oe=69A6D70D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VrunoPAID_CoverLandscape.png", "id": "788678715949222", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75282159_788678719282555_6728773781508326366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsjwKgykHfIQ7kNvwEUCxfr&_nc_oc=AdniVebp6InC3vNUfqE_BOQGMFmAILFX05ksgqJ2-lBOcrobCukniFjGaywH63yapno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsc4tSYLJ6_DwluiYCey31OGvY8sxJrWl8HYKQBloE4SQ&oe=69A6EDB0"}, "display_name": "VRUNO", "keywords": [], "long_description": "Host your next game night with VRUNO, a social VR card game! Grab a group of friends or meet new people in the game. You can also choose to go solo and play against AI robots with some big personalities. \n\nVRUNO brings a space ship directly into your living room! Enjoy all the familiar game mechanics - match your card by color or number, throw in a wild, or cause mayhem with the infamous reverse card. \n\nAnd there\u2019s a new VR-only twist to the game! Down to one card? Hit the VRUNO button and dance it out as quickly as you can before someone else does. Not in a dancing mood? No worries, head to the settings and toggle it off.\n\nVRUNO is customizable for how YOU choose to play. Want to stack +2 and +4 cards? Let\u2019s do it! Just want a quick game? Try the \u201cQuick 2\u201d game mode. Want to force players to draw cards until they f-i-n-a-l-l-y get a card that they can play? You\u2019re a brutal game night host, and we\u2019ve got you covered. \n\nHave questions, suggestions or want to connect with the VRUNO community? Come join our discord! https://discord.gg/WRrpM4GMDG\n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n", "short_description": "Host your next game night with VRUNO, a social VR card game! Play with friends or meet new people in the game. Cause mayhem with Wild+4 cards and the infamous Reverse card. You can even play solo against AI robots with some big personalities. \n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "724656892631270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031579_1336371913877031_8745311553138866798_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1Sa2P5Q_wUQ7kNvwGJEUVj&_nc_oc=AdmtTC4wOe7dhVsNtLG38W5KmPJBvcfZJ3BIEWTcJx3Zello3TEb7WoS64MrliCAYxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQPJ6SWKPoKL-965WpeV7iC0JSfRiVo2AzIMHaNGsTfw&oe=69A6E5A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRUNO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Party Game", 
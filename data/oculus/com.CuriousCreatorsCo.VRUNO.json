yTqD_KqWs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afv45wTSB-VMGsLiIEVG932JNLgMxG8mTW0cfDDAW0QZ5g&oe=69A179E0"}, {"file_name": "Screenshots_VRUNO_02.png", "id": "1875539212804777", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75234367_1875539216138110_2200508874973943562_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsT9WczX-TkQ7kNvwFXHmoJ&_nc_oc=AdkXRb0Iiw7wXXo08pwlumSWt30Z8zXYlpGcT3jMTj1ae1Y7bkxl74CnVBC3ubfRidY&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuWkZ_P6d8Pxsf-Pb9DGPZVm7RotCcW0dcDOCTnlhGMhQ&oe=69A1A195"}, {"file_name": "Screenshots_VRUNO_03.png", "id": "1393233384811772", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031467_1393233388145105_7723519974808662978_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6T0cTsYwk8QQ7kNvwHmi2se&_nc_oc=AdlQL5_e-hlaBKL5ODg4r0x2646IKkOAX1HSDzf0pGz1NsCPi5hBOKDnWaWveuXnrKs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu3xV9uEM1JJ9iVJDkFvk3tJ7Av7HLlQZVP1PW9I3THEw&oe=69A17DC3"}, {"file_name": "Screenshots_VRUNO_04.png", "id": "6057336987693889", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39035453_6057336991027222_6846038808004926856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oU0bv9BmvakQ7kNvwFtzK8v&_nc_oc=AdmaiEE0zNe58Pfa9yE-jDxyTd974VxWKwinRs0tSrVkbFPBdi1qxYrN7qanFaFIU6o&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsslCI_CyOK1g8MFdRkRISJzzFwRlfCRW2iuAhkMth7Fg&oe=69A1957A"}, {"file_name": "Screenshots_VRUNO_05.png", "id": "172818745536092", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982570_172818748869425_2922139326075809551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1ZDQf8DkvMQ7kNvwGv_-Lq&_nc_oc=AdnnXOilSxWBn42F4rdf7Oy6lEacMU9B4E5_CAGHZBlHFuRC8C3mRGEl1ZIHcB7Brws&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfumA8toxw0uR2HPlTo9SdsafFC2Mg3QgRdex47mSaTtow&oe=69A1910D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VrunoPAID_CoverLandscape.png", "id": "788678715949222", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75282159_788678719282555_6728773781508326366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fNtub8LXeIQQ7kNvwEjcaDD&_nc_oc=Adklm2fSRRTPPfA3Xl11svGZs7r74lkvVy55RH4Ya6r2wgsL7t80P7FOQqEtK8mjtNU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsdHkIcLgQ3uhIgUny4zXXWkk7YFCTGFqfOGZVabsM42w&oe=69A1A7B0"}, "display_name": "VRUNO", "keywords": [], "long_description": "Host your next game night with VRUNO, a social VR card game! Grab a group of friends or meet new people in the game. You can also choose to go solo and play against AI robots with some big personalities. \n\nVRUNO brings a space ship directly into your living room! Enjoy all the familiar game mechanics - match your card by color or number, throw in a wild, or cause mayhem with the infamous reverse card. \n\nAnd there\u2019s a new VR-only twist to the game! Down to one card? Hit the VRUNO button and dance it out as quickly as you can before someone else does. Not in a dancing mood? No worries, head to the settings and toggle it off.\n\nVRUNO is customizable for how YOU choose to play. Want to stack +2 and +4 cards? Let\u2019s do it! Just want a quick game? Try the \u201cQuick 2\u201d game mode. Want to force players to draw cards until they f-i-n-a-l-l-y get a card that they can play? You\u2019re a brutal game night host, and we\u2019ve got you covered. \n\nHave questions, suggestions or want to connect with the VRUNO community? Come join our discord! https://discord.gg/WRrpM4GMDG\n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n", "short_description": "Host your next game night with VRUNO, a social VR card game! Play with friends or meet new people in the game. Cause mayhem with Wild+4 cards and the infamous Reverse card. You can even play solo against AI robots with some big personalities. \n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "724656892631270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031579_1336371913877031_8745311553138866798_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOwV9_xJgBUQ7kNvwGbcE48&_nc_oc=AdkDWXQuP6aw1HAvC6v_KWvbElLqoznsjEVBGdw6rnXX75TA9JdHMXr3lktZoSQun2Y&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AftY0-6PUmLoZzgW62zR1eT7PMOoKcBhALS6vPf-2JDDdQ&oe=69A19FA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRUNO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Party Game", 
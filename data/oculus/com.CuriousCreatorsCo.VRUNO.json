6092", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982570_172818748869425_2922139326075809551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAayXIIgLOAQ7kNvwG-v6LM&_nc_oc=AdrGXpF0KgDSgrcMcmamKYvdu3J501MM5kuQzAwbznPScOI6E_Jrwr4dHPom4z0B8v0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gLWD2H4ck9ImQX6dcbaBDc2Xg3QICa92wA1XAfhn4ew&oe=6A36C2CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VrunoPAID_CoverLandscape.png", "id": "788678715949222", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75282159_788678719282555_6728773781508326366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TiOiPq4YR90Q7kNvwHPlK7X&_nc_oc=Adpc3yCFhbN0qciZES2bjQTADnC2tNfMQ_kkr73LQws7QgjFMoliW8a6WfAIpAkvpqM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96Q5qmgHMMX2ovB36JqPUqwDKpnBj_4hhEZgtc1Lzjjg&oe=6A36A130"}, "display_name": "VRUNO", "keywords": [], "long_description": "Host your next game night with VRUNO, a social VR card game! Grab a group of friends or meet new people in the game. You can also choose to go solo and play against AI robots with some big personalities. \n\nVRUNO brings a space ship directly into your living room! Enjoy all the familiar game mechanics - match your card by color or number, throw in a wild, or cause mayhem with the infamous reverse card. \n\nAnd there\u2019s a new VR-only twist to the game! Down to one card? Hit the VRUNO button and dance it out as quickly as you can before someone else does. Not in a dancing mood? No worries, head to the settings and toggle it off.\n\nVRUNO is customizable for how YOU choose to play. Want to stack +2 and +4 cards? Let\u2019s do it! Just want a quick game? Try the \u201cQuick 2\u201d game mode. Want to force players to draw cards until they f-i-n-a-l-l-y get a card that they can play? You\u2019re a brutal game night host, and we\u2019ve got you covered. \n\nHave questions, suggestions or want to connect with the VRUNO community? Come join our discord! https://discord.gg/WRrpM4GMDG\n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n", "short_description": "Host your next game night with VRUNO, a social VR card game! Play with friends or meet new people in the game. Cause mayhem with Wild+4 cards and the infamous Reverse card. You can even play solo against AI robots with some big personalities. \n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "724656892631270"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinar
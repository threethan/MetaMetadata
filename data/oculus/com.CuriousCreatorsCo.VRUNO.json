2375_162713109940738_5019671756058035587_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7mFnf9bIDkQ7kNvwGJujzk&_nc_oc=AdkbV7q0XiP7L6Z9LCMYYreTnB-nnTN6tlYi16Z2BzgMa4if_qo7PdpqY8frFZ0VZgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsjKHu5cHYNL_nq2eCpm02SWQy729chf3HpNX_3k5Ny7g&oe=69A41CE0"}, {"file_name": "Screenshots_VRUNO_02.png", "id": "1875539212804777", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75234367_1875539216138110_2200508874973943562_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spXLHkYg_JgQ7kNvwF3ZbOg&_nc_oc=Adk_FEY5vh6dG5UFazgiYxixJq3rVT2EIJJ18QQjyXmnqhKK0OFvWRTtBwt0f-PxvlE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftyb6q5DlQYyAy5jqkAz6flqxXNDCPdKIXj0h3QzF3rcQ&oe=69A44495"}, {"file_name": "Screenshots_VRUNO_03.png", "id": "1393233384811772", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031467_1393233388145105_7723519974808662978_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6T0cTsYwk8QQ7kNvwELS2Lx&_nc_oc=AdmiCZT3268IPWzqkZpHBKv3mWCR9YiBErMDd2xWkNHHAhXjYKIdI-vpsf0dtkhZ5uo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNe3ytWxmKOWxc3urVKpWzOtiUgwQx9EwKVJ5s_U-7_Q&oe=69A420C3"}, {"file_name": "Screenshots_VRUNO_04.png", "id": "6057336987693889", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035453_6057336991027222_6846038808004926856_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J1kAEXHoEkQ7kNvwHC99kC&_nc_oc=Admz--KT6Ug7YuOjSJRNmzKfnL8mN8U3OaVsDi9ngjklXIrL9hYg-eZfzJ8KbEJTWHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv4EgM0BGEiJ9VdHWv6wqZZKkpsMNzFpqMuyvV4qo5h5g&oe=69A4387A"}, {"file_name": "Screenshots_VRUNO_05.png", "id": "172818745536092", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982570_172818748869425_2922139326075809551_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=quzLSQOk6KUQ7kNvwHyOeA5&_nc_oc=Adm9469YCWWjl0QOlHmHmAoAU10ExfFge-0MXxBm97-CnK0jda9H1fN9ZNo8eBpZ_jU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvTwNtfDobTV3op7R05_vMWj3k-XOpYm_EsAAJ0dn_9eg&oe=69A4340D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VrunoPAID_CoverLandscape.png", "id": "788678715949222", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75282159_788678719282555_6728773781508326366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oB0D6YtrYXgQ7kNvwExm-ma&_nc_oc=Adnt6IImrRGhrdHJPVYehgbZhGYZ2QJyUfjTXspSlPB1MxRxcdHd_TUwtcXsxTp0EQU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmYH9LOhpQXk283-RLR9Zk75_ec6inre50idcq1-J5Gg&oe=69A44AB0"}, "display_name": "VRUNO", "keywords": [], "long_description": "Host your next game night with VRUNO, a social VR card game! Grab a group of friends or meet new people in the game. You can also choose to go solo and play against AI robots with some big personalities. \n\nVRUNO brings a space ship directly into your living room! Enjoy all the familiar game mechanics - match your card by color or number, throw in a wild, or cause mayhem with the infamous reverse card. \n\nAnd there\u2019s a new VR-only twist to the game! Down to one card? Hit the VRUNO button and dance it out as quickly as you can before someone else does. Not in a dancing mood? No worries, head to the settings and toggle it off.\n\nVRUNO is customizable for how YOU choose to play. Want to stack +2 and +4 cards? Let\u2019s do it! Just want a quick game? Try the \u201cQuick 2\u201d game mode. Want to force players to draw cards until they f-i-n-a-l-l-y get a card that they can play? You\u2019re a brutal game night host, and we\u2019ve got you covered. \n\nHave questions, suggestions or want to connect with the VRUNO community? Come join our discord! https://discord.gg/WRrpM4GMDG\n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n", "short_description": "Host your next game night with VRUNO, a social VR card game! Play with friends or meet new people in the game. Cause mayhem with Wild+4 cards and the infamous Reverse card. You can even play solo against AI robots with some big personalities. \n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "724656892631270"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6081289321987594", "version": "1.0.2"}, "id": "104858535882288", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6013624362087424", "is_c
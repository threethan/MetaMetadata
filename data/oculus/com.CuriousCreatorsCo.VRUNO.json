scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK7MfPF6zvLk_C7zzgT8-lvCNoJHtJenVagg5OFLRaUQ&oe=6AFB1F03"}, {"file_name": "Screenshots_VRUNO_04.png", "id": "6057336987693889", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035453_6057336991027222_6846038808004926856_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jrdLrdG8F0Q7kNvwEYjPx1&_nc_oc=AdokpN9I8JMOPh5Kni3cdUWixvr-le-8oKCUbIsEwP5Lnj_XOLR7uOKaMIZpaDMg3Nw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-_kWXk3GT4egmINoI7s47wPsAVYU3JnkNWKXA85PyaA&oe=6AFB36BA"}, {"file_name": "Screenshots_VRUNO_05.png", "id": "172818745536092", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982570_172818748869425_2922139326075809551_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xALugVeXInQQ7kNvwEiFllZ&_nc_oc=AdptQt-QsqLeIX3kvITrUhneuVkyoVOvqsTN9e8PU-ZGipHjrYf4HRuGBrTxtWPxV1o&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYRjU7d6mcvNkvfe72mryOElapB_IjFTaBPtWWN58N6g&oe=6AFB324D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VrunoPAID_CoverLandscape.png", "id": "788678715949222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75282159_788678719282555_6728773781508326366_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afAdoLqqRLwQ7kNvwFsAmZT&_nc_oc=Adoc8tJkTxb_vi4123w0pTMmpqg1Tc9iw_td1AallgpMgIcBhmKgOLrI0QerP7geBto&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTLfqDGI4K45cWIS_GKokt3Wi00jNek-gtOJ2k1ja2wA&oe=6AFB48F0"}, "display_name": "VRUNO", "keywords": [], "long_description": "Host your next game night with VRUNO, a social VR card game! Grab a group of friends or meet new people in the game. You can also choose to go solo and play against AI robots with some big personalities. \n\nVRUNO brings a space ship directly into your living room! Enjoy all the familiar game mechanics - match your card by color or number, throw in a wild, or cause mayhem with the infamous reverse card. \n\nAnd there\u2019s a new VR-only twist to the game! Down to one card? Hit the VRUNO button and dance it out as quickly as you can before someone else does. Not in a dancing mood? No worries, head to the settings and toggle it off.\n\nVRUNO is customizable for how YOU choose to play. Want to stack +2 and +4 cards? Let\u2019s do it! Just want a quick game? Try the \u201cQuick 2\u201d game mode. Want to force players to draw cards until they f-i-n-a-l-l-y get a card that they can play? You\u2019re a brutal game night host, and we\u2019ve got you covered. \n\nHave questions, suggestions or want to connect with the VRUNO community? Come join our discord! https://discord.gg/WRrpM4GMDG\n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n", "short_description": "Host your next game night with VRUNO, a social VR card game! Play with friends or meet new people in the game. Cause mayhem with Wild+4 cards and the infamous Reverse card. You can even play solo against AI robots with some big personalities. \n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_
ideo_trailer_thumbnail": {"file_name": "VrunoPAID_CoverLandscape.png", "id": "788678715949222", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75282159_788678719282555_6728773781508326366_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ocAXEZ48nQQ7kNvwFLCQ5p&_nc_oc=AdkAi6DzQSwcBFDxaNN6hlMzwhWfwoWLKAgYXmzPE2xqNdO1aBeZ6dN_bf5EZUxub3Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHoGzrxedHmLcgiTTTwBeEGa8OUNIFGm86WH7QQ783Zg&oe=69BD5730"}, "display_name": "VRUNO", "keywords": [], "long_description": "Host your next game night with VRUNO, a social VR card game! Grab a group of friends or meet new people in the game. You can also choose to go solo and play against AI robots with some big personalities. \n\nVRUNO brings a space ship directly into your living room! Enjoy all the familiar game mechanics - match your card by color or number, throw in a wild, or cause mayhem with the infamous reverse card. \n\nAnd there\u2019s a new VR-only twist to the game! Down to one card? Hit the VRUNO button and dance it out as quickly as you can before someone else does. Not in a dancing mood? No worries, head to the settings and toggle it off.\n\nVRUNO is customizable for how YOU choose to play. Want to stack +2 and +4 cards? Let\u2019s do it! Just want a quick game? Try the \u201cQuick 2\u201d game mode. Want to force players to draw cards until they f-i-n-a-l-l-y get a card that they can play? You\u2019re a brutal game night host, and we\u2019ve got you covered. \n\nHave questions, suggestions or want to connect with the VRUNO community? Come join our discord! https://discord.gg/WRrpM4GMDG\n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n", "short_description": "Host your next game night with VRUNO, a social VR card game! Play with friends or meet new people in the game. Cause mayhem with Wild+4 cards and the infamous Reverse card. You can even play solo against AI robots with some big personalities. \n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "724656892631270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031579_1336371913877031_8745311553138866798_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KdGDjk1Je2wQ7kNvwFhl5xN&_nc_oc=AdngykyIRLViU3yC9Qo7FZ1jn34eo8T4B6tq--XAYWDY5d2DVeUGjQo02UXp39VKQpc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzxt9QHe7RplUW4RlW6FgPrXKyrewTUSpfMaeGJFBhETw&oe=69BD4F21"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VRUNO", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id
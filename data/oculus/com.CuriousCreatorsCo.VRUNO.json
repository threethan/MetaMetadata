ng", "id": "162713106607405", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422375_162713109940738_5019671756058035587_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhM3kx4GCSIQ7kNvwG4YTpI&_nc_oc=Adq0eUVOiXP7d9MZLKbXf8uxBRCE2l2rYTj9eg0Q5t0WFgtDeIipXL-7w18fIZwTusU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH32ieQDCPaDPwo3zcrAMjXnp86sCO3ouigpXdQFcFHw&oe=6B099BA0"}, {"file_name": "Screenshots_VRUNO_02.png", "id": "1875539212804777", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75234367_1875539216138110_2200508874973943562_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2yREcnH4XoQ7kNvwE8687w&_nc_oc=Adrj1SqIu3kEKkITESQUvK2uy54dhVW3GJBKd38AqlAYAy7_xydfCe_RVwr0BbArcXc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0UeMtyEgCaiUX4uJ94xHXuJWhws5L0_Orh_gl0IQUAg&oe=6B09C355"}, {"file_name": "Screenshots_VRUNO_03.png", "id": "1393233384811772", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031467_1393233388145105_7723519974808662978_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yluF2KlK_D4Q7kNvwFsG5Dn&_nc_oc=AdpbhVq-aTUxlLM5JFKJnDuvybaE6hYnrYCEFEYZjiUpePJ-rf7JuZ2PfeAKrPemdQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTV7J-9yRMKzWg29O1aawHOnUgv44rI77m37t81dQnabA&oe=6B099F83"}, {"file_name": "Screenshots_VRUNO_04.png", "id": "6057336987693889", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035453_6057336991027222_6846038808004926856_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cCuN6KbYuAQ7kNvwHOoxTx&_nc_oc=AdopRPqeERZ7StKKzdhLJyKJp0KIUW-ybaDHxbHdFf1-mHR-fNo1JMAN8C8387s1QcU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeD8HNaexi8jx4j3BJpTRrFaXa4_rP7jUIKcN9BbwEPQ&oe=6B09B73A"}, {"file_name": "Screenshots_VRUNO_05.png", "id": "172818745536092", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982570_172818748869425_2922139326075809551_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c09HdeRZNekQ7kNvwHCTPF8&_nc_oc=Adpd043Fus7nqZoCQRoGTz1sVEw5Eo2XinBP6uxY6JzJxCXTYWm0tUBDRPPmLCRrDso&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQofZQoWt7P4qRhgvVoitm9iPKOmI8olQI01pLRVNOMSQ&oe=6B09B2CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VrunoPAID_CoverLandscape.png", "id": "788678715949222", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282159_788678719282555_6728773781508326366_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xEb6GYEN6loQ7kNvwFxBfEW&_nc_oc=Adr2NEt7bYy_1mwPJ9icMhsYiaJ4xlwxe3zVokYBhSGTwugKHuQMEboWErJePXvVOVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTANhR8vUCl8RAXVH0D7jCo6pgfkIpTWbbyokxp3kjRMA&oe=6B09C970"}, "display_name": "VRUNO", "keywords": [], "long_description": "Host your next game night with VRUNO, a social VR card game! Grab a group of friends or meet new people in the game. You can also choose to go solo and play against AI robots with some big personalities. \n\nVRUNO brings a space ship directly into your living room! Enjoy all the familiar game mechanics - match your card by color or number, throw in a wild, or cause mayhem with the infamous reverse card. \n\nAnd there\u2019s a new VR-only twist to the game! Down to one card? Hit the VRUNO button and dance it out as quickly as you can before someone else does. Not in a dancing mood? No worries, head to the settings and toggle it off.\n\nVRUNO is customizable for how YOU choose to play. Want to stack +2 and +4 cards? Let\u2019s do it! Just want a quick game? Try the \u201cQuick 2\u201d game mode. Want to force players to draw cards until they f-i-n-a-l-l-y get a card that they can play? You\u2019re a brutal game night host, and we\u2019ve got you covered. \n\nHave questions, suggestions or want to connect with the VRUNO community? Come join our discord! https://discord.gg/WRrpM4GMDG\n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n", "short_description": "Host your next game night with VRUNO, a social VR card game! Play with friends or meet new people in the game. Cause mayhem with Wild+4 cards and the infamous Reverse card. You can even play solo against AI robots with some big personalities. \n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "724656892631270"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031579_1336371913877031_8745311553138866798_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_s
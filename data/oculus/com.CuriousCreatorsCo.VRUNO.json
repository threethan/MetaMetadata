scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRdRzG0eYjSV9ItioeRUyvrxFIVG4x76WlvIeIpamWZQ&oe=6B0DCC43"}, {"file_name": "Screenshots_VRUNO_04.png", "id": "6057336987693889", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035453_6057336991027222_6846038808004926856_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLc27DkEO0YQ7kNvwH7vu2e&_nc_oc=AdqnxhrbJTlPd0TIg5_LwuE_tsXTUXl5dZoK-30_IguW8vVJDjlSIn5ruIOZN6NLlnE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSji7eJkdblQBkFnH3UliX1uIFaBppU3_2-Y1KxeycgA&oe=6B0DABBA"}, {"file_name": "Screenshots_VRUNO_05.png", "id": "172818745536092", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982570_172818748869425_2922139326075809551_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3xrdRYz1psQ7kNvwGpVIHG&_nc_oc=AdqOZi1AaQOdcX725VvOYWmhQN_-3QkdPK3DxCEDniQHlr2OeG1e4c3bxpDX8DBrlHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSqM0BBlhlMW06EgtsKrwSsLaCWZLP41fUcnUj1yhk1rw&oe=6B0DA74D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VrunoPAID_CoverLandscape.png", "id": "788678715949222", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75282159_788678719282555_6728773781508326366_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_K55u8K4l4Q7kNvwEW3F2X&_nc_oc=AdqI9M8uaMqNWZGza30_pHWQFoOHWd72tuYY_UkzSH2cg6mQrqI63ET4Ucq3aTW5i8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4OMaElxTEZgvjwV5HCoqCXhSt3FnHt0NkEyUEhx0dXA&oe=6B0DBDF0"}, "display_name": "VRUNO", "keywords": [], "long_description": "Host your next game night with VRUNO, a social VR card game! Grab a group of friends or meet new people in the game. You can also choose to go solo and play against AI robots with some big personalities. \n\nVRUNO brings a space ship directly into your living room! Enjoy all the familiar game mechanics - match your card by color or number, throw in a wild, or cause mayhem with the infamous reverse card. \n\nAnd there\u2019s a new VR-only twist to the game! Down to one card? Hit the VRUNO button and dance it out as quickly as you can before someone else does. Not in a dancing mood? No worries, head to the settings and toggle it off.\n\nVRUNO is customizable for how YOU choose to play. Want to stack +2 and +4 cards? Let\u2019s do it! Just want a quick game? Try the \u201cQuick 2\u201d game mode. Want to force players to draw cards until they f-i-n-a-l-l-y get a card that they can play? You\u2019re a brutal game night host, and we\u2019ve got you covered. \n\nHave questions, suggestions or want to connect with the VRUNO community? Come join our discord! https://discord.gg/WRrpM4GMDG\n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n", "short_description": "Host your next game night with VRUNO, a social VR card game! Play with friends or meet new people in the game. Cause mayhem with Wild+4 cards and the infamous Reverse card. You can even play solo against AI robots with some big personalities. \n\nFeatures:\n\u2022 Supports 1 - 8 players\n\u2022 Private and public rooms\n\u2022 AI Robots\n\u2022 Customizable rules (Infinite Draw, Stacking, Brutal, Classic, Quick 2)\n\u2022 In game radio, play music from the top 40 to oldies\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.curiouscreatorsgames.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Curious Creators Co", "support_website_url": null, "website_url": "https://www.curiouscreatorsgames.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}], "external_
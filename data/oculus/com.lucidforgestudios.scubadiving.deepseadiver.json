3", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673658581_1556754782426229_7108786832313955573_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIj-y-GvSfsQ7kNvwE5Ao46&_nc_oc=Adphb9oexmow-kXZO5qs7I7zOaTWE2bcMQ279RfNL8wKhLqTRcBGutdxENGri6bYgBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjRYVIpkzZOzEPN535fZF_X9CSQwHmJI0Gm2BEKqbz3g&oe=6AF5DAC3"}, {"file_name": "3.png", "id": "1310882591015221", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604375581_1310882594348554_6766655579088736521_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxNgxS39HrQQ7kNvwEUDRpJ&_nc_oc=AdqpAprXTbuIM9Ohh10IVtCLkFiG-gxsJVsIL4E1pYAuCih1YZJ4NHezuxLQWBGB97c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNVJd4_533qp4QGV_HhNAfsTwwkr6w7sX7p9mREk3i7A&oe=6AF5C528"}, {"file_name": "5.png", "id": "1772053380742670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830576_1772053384076003_8651811052657214926_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G83JhJdABP0Q7kNvwFuetBc&_nc_oc=AdqjaFx1vhVmKOS_c2UT5uzdxRx5K4PtjPY3ZjpG-hcMW1QiFDO2QaslJeLLzos2o2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0lzyOCgHJo9-R2gYFrtWNW-a70OgRVdyH_Q4cWUuTzw&oe=6AF5EA8D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scuba Diving: Deep Sea Diver", "keywords": ["scubadiving", "deepsea", "divingsimulator", "underwateradventure", "vrdiving"], "long_description": "Dive into the depths of the ocean and experience the thrill of scuba diving in Scuba Diving: Deep Sea Diver!\n\nExplore a beautiful underwater world filled with colorful marine life, mysterious locations, hidden treasures, and exciting discoveries. Put on your diving gear, descend into the deep sea, and explore the ocean at your own pace.\n\nDiscover fascinating underwater environments as you swim through coral reefs, explore sunken areas, search for hidden objects, and encounter amazing sea creatures. Every dive brings a new opportunity to explore deeper and uncover something unexpected.\n\nExplore the Deep Sea\n\nSwim through immersive underwater environments and discover the beauty of the ocean. Explore reefs, caves, shipwrecks, and mysterious deep-sea locations while enjoying an exciting diving experience.\n\nDiscover Marine Life\n\nEncounter a variety of underwater creatures as you explore the ocean. Observe marine life up close and experience the peaceful yet mysterious atmosphere of the deep sea.\n\nBecome a Deep Sea Diver\n\nManage your dive, explore different areas, and venture deeper into the ocean. Improve your diving skills and discover new locations as you progress through your underwater adventure.\n\nImmersive VR Experience\n\nExperience scuba diving from a whole new perspective in VR. Look around freely, swim through the underwater environment, and feel like you are actually exploring the deep ocean.", "short_description": "Dive into the deep sea and explore a breathtaking underwater world in an immersive scuba diving adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_int
_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrlDxL4z-GEQ7kNvwEy_FpU&_nc_oc=Adr0bv-dO07IyIPRZWpBS16Ekkk74HleZui3jilL-NkYXO7FRb1qTy5YgtymN5YKZBs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhnTZDhzTCjqUaQJSAyHI_xptAhiMKLJ_gpeJgGCNxwA&oe=6B0303AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "2244115599465696", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620599_2244115602799029_1390541220192684962_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtbG-PzAPPQQ7kNvwHNXAbl&_nc_oc=Adq2-C5W0smJk7tzyJxIbcmhMkJilvVsrbpmqyHy9FPqEhBds6Aye6wcLWqnszuqTdU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN9TYKL40xCwoB3wxJE6A6iXX5FMXd3oTdwxK_VTKjpQ&oe=6B031E76"}, "display_name": "SnapWood MR: Cozy Craft & 3D Puzzle", "keywords": ["handtracking", "mixedreality", "woodworking", "3dpuzzle", "craft"], "long_description": "Turn your living room into a cozy, zero-mess woodworking studio!\n\nSnapWood MR: Cozy Craft & 3D Puzzle brings the deeply satisfying art of 3D woodcraft and spatial joinery straight onto your real-world table.\n\nA glowing holographic blueprint appears right in front of you. Using just your bare hands, pick up warm, handcrafted wooden blocks, rotate them in mid-air, and feel the satisfying click as every piece snaps perfectly into place.\n\nKEY FEATURES:\n\n100% Controller-Free Hand Tracking: Put down the controllers! Pinch, grab, rotate, and assemble naturally with your own hands. Designed natively for Quest 3 & 3S full-color passthrough.\n\nTactile ASMR Satisfaction: Enjoy realistic wood textures, crisp snap-fit mechanics, and soothing wood-tapping spatial audio.\n\nBrain-Teasing 3D Blueprints: Progress from cozy tabletop chairs and everyday furniture to intricate architectural sculptures that challenge your spatial IQ.\n\nPure Cozy Zen: No timers, no pressure, no sawdust. Play comfortably seated at your desk or couch while enjoying your morning coffee.\n\nPerfect for fans of spatial 3D puzzles, tabletop building, DIY woodcraft, and relaxing Mixed Reality experiences. Ready to snap your first masterpiece together?", "short_description": "Turn your table into a cozy woodworking studio! Use your bare hands in Mixed Reality to grab, rotate, and snap handcrafted wooden blocks into 3D blueprints. No controllers, no timers \u2014 just pure tactile ASMR satisfaction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "994084867092538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499628092_1109111885339913_4565409425039741728_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fK2HW0v6A0gQ7kNvwEizBNw&_nc_oc=Adpgqu5WiMvO82EHOYTL7xeZQjw-V0PxwD-YWTel1cc0x4zUf_dcBKmmDuSnTp__yrU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9zTLXnNKnoU6Lpa8x4lfZZVhlySqIiFe4xZNIxCmCPw&oe=6B0330FA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SnapWood MR: Cozy Craft & 3D Puzz
-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwuvm6huoId662l8416OIpyN7xCUMpYj3hVrqEorismQ&oe=6AF356FC"}, {"file_name": "land.png", "id": "1101852559482273", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593723055_1101852562815606_4360940467300944010_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4i5Iljlk2oQ7kNvwEuqWUb&_nc_oc=AdqnaH1qR0KPNsG94PDE0-_GBeOXuKK230QgIrluauCM-FzRVJ7f4Z_bfbLdSb-mUSc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOqMSntW_DVXZCElmd6ra37NhkN3eUQvtj6Vq139bbkw&oe=6AF349E1"}]}, "id": "1117434690724801", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "2758631854539399", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_2758631857872732_2365742272641334092_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtAAoU5QI6YQ7kNvwGvBkqg&_nc_oc=AdruKYeIGQF7YKBNUD2bEvxzTASLFNDNgVg7Wioeu6ZsHDQAth9i94P8Adv8ZVszstc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ71bMkhYMaEqaWpkql8s3fOXiZt87iPzq8bnMqtesxzw&oe=6AF32ED8"}, {"file_name": "3.png", "id": "1592963195918427", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624656_1592963199251760_3935675297404286391_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0VYCQIvq-0Q7kNvwETFDa9&_nc_oc=Adp1lBMSSY90AU29t6X5a6J0OALU46G28S5h0w5tD8Spai8yHTjBh55eSMSgSTidYf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDxEH3QxWxOK4_4mrve4-62LIdag9ghbKTYhn-PQ93xw&oe=6AF32A90"}, {"file_name": "1.png", "id": "1628937032114241", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628108_1628937035447574_4338812854204037934_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Dsx25gFdbAQ7kNvwG_Z6Ut&_nc_oc=AdpsQJZ60qMYh90dNfGOIMSwNlP3EqoiSEROUaykj3mNYmTqVluBAIWhlZIj1pQDqoU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTIjHSsxKkQi2t9NwHUymSo3EEPvSYX6CtDM9cIGYjsw&oe=6AF34C23"}, {"file_name": "4.png", "id": "1425715769017755", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623115_1425715772351088_8083683724296452046_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9gD0w5HUl0Q7kNvwEJSjuz&_nc_oc=AdoBFwzurV1ZrmNWFyzVAezTQiTT8DuBoS_BvXVVMqN7416rg4FQwhGdDTIqZgRyy3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Io_q8hYxrheTRTxVzVdoJxp10XY6qGn9U8hfUrO2pg&oe=6AF33AD0"}, {"file_name": "5.png", "id": "1603630071777873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593895988_1603630075111206_4908743341193780644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFLXzpVlfQYQ7kNvwFNVZ7F&_nc_oc=AdqhQu85BaBYhSXFM7FfcQi3DjaT_J7q9DziH_X0OiR9BwGbEiOt7kFyJ1kRRpc0w7M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFz9L0JsBF_dI12t97kQm5TZdCOcKhKR-5MFH96i2S0Q&oe=6AF331AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "1534023451817146", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627527_1534023455150479_6167446200429499347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1M0r66bjWwQ7kNvwF_TXlF&_nc_oc=AdoJeMuy6j4GaAYmWfyMXgpwgaR_UseG-pAcw5OCkw9Dypm2OzB6OVENK09kQ-dYTGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbNvczhaB3oP2u4tEkQZA9Eg8ObsCrAbnlkyZOAKnS3A&oe=6AF34E6A"}, "display_name": "Woodform", "keywords": ["woodpuzzle", "mixedrealitypuzzle", "passthroughpuzzle", "snapfit", "cozypuzzle"], "long_description": "### Turn Your Room Into a Wood Workshop.\n\n**Woodform** is a cozy **Mixed Reality puzzle** that brings tactile woodcraft into your space. A mysterious **pedestal** appears on your table with an unfinished blueprint. Bring it to life \u2014 piece by piece.\n\n---\n\n### \ud83e\udde9 HOW TO PLAY\n\n* **Grab & Move** the pedestal to place the puzzle anywhere\n* **Pick up** wooden blocks and **rotate & align** for a perfect fit\n* **Snap to Fit** \u2014 snapped pieces attach and move with the pedestal\n* **Lift out** any placed piece to try again\n* Complete every joint to unlock the next blueprint\n\n---\n\n### \u2728 FEATURES\n\n* **True Mixed Reality with Passthrough**\nYour table is the workbench. Solve at room scale.\n\n* **Tactile Snap-Fit Puzzle**\nIntuitive grab, rotate and snap. Feel the *satisfaction* when wood clicks.\n\n* **Moveable Pedestal System**\nMove and rotate the pedestal \u2014 all snapped pieces follow.\n\n* **Relaxing & Brain-Teasing**\nDozens of handcrafted blueprints, from simple joints to complex structures.\n\n---\n\n> *No timers. No pressure. Just you, the wood, and the perfect fit.*\n\n**Made for Meta Quest 3 / 3S with Passthrough.**", "short_description": "Assemble wooden pieces in your room. Snap, rotate and fit every block onto the pedestal to complete the blueprint in MR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "978369598664065"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1147623990970336"}, {"status": "PUBLISHED", "id": "2118390502118222"}]}, "baseline_offer": {"id": "1147623990970336"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792840980, "status": "PUBLISHE
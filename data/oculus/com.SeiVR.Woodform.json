_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBxQuhFuIpIQ7kNvwHRdgp6&_nc_oc=AdqAdQgefjvQoir81-tqhY6ElSkJpihEGB7A115Im2YHcY-y8Hmmmooj7NnS6iasdUk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX4EwsPXyYdkiiYa9dfGO6k7tg1I0p4tNZi1xaV1CApA&oe=6AFB1AAF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lans.png", "id": "2244115599465696", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620599_2244115602799029_1390541220192684962_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YycVPHYM5JIQ7kNvwEKJIMh&_nc_oc=AdofgJWrYpPrOtXuiN4avr_qzTCoKDLjxcL-ifVx_7rrE6qFZLDgbdPqbAR5A7zEkvE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoaHiIK4SEZWBlKH93BmHpla9xooo3FmGiQCYV-zI7mg&oe=6AFB3576"}, "display_name": "SnapWood MR: Cozy Craft & 3D Puzzle", "keywords": ["handtracking", "mixedreality", "woodworking", "3dpuzzle", "craft"], "long_description": "Turn your living room into a cozy, zero-mess woodworking studio!\n\nSnapWood MR: Cozy Craft & 3D Puzzle brings the deeply satisfying art of 3D woodcraft and spatial joinery straight onto your real-world table.\n\nA glowing holographic blueprint appears right in front of you. Using just your bare hands, pick up warm, handcrafted wooden blocks, rotate them in mid-air, and feel the satisfying click as every piece snaps perfectly into place.\n\nKEY FEATURES:\n\n100% Controller-Free Hand Tracking: Put down the controllers! Pinch, grab, rotate, and assemble naturally with your own hands. Designed natively for Quest 3 & 3S full-color passthrough.\n\nTactile ASMR Satisfaction: Enjoy realistic wood textures, crisp snap-fit mechanics, and soothing wood-tapping spatial audio.\n\nBrain-Teasing 3D Blueprints: Progress from cozy tabletop chairs and everyday furniture to intricate architectural sculptures that challenge your spatial IQ.\n\nPure Cozy Zen: No timers, no pressure, no sawdust. Play comfortably seated at your desk or couch while enjoying your morning coffee.\n\nPerfect for fans of spatial 3D puzzles, tabletop building, DIY woodcraft, and relaxing Mixed Reality experiences. Ready to snap your first masterpiece together?", "short_description": "Turn your table into a cozy woodworking studio! Use your bare hands in Mixed Reality to grab, rotate, and snap handcrafted wooden blocks into 3D blueprints. No controllers, no timers \u2014 just pure tactile ASMR satisfaction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "994084867092538"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628092_1109111885339913_4565409425039741728_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXimhBHFyhAQ7kNvwFiSIQY&_nc_oc=AdqQIcyDOYbf-zMZ1ED8mqFTOchjfu33_7TN-ZMoKkb9Db7wcyazXApLmllPJF6b23U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBMDjRs8ArujcviiTILJdJK_QKqMkl0BRtieCsm2FiOA&oe=6AFB47FA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SnapWood MR: Cozy Craft & 3D Puzz
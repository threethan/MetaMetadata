content-ord5-1.oculuscdn.com/v/t64.5771-25/499623115_1425715772351088_8083683724296452046_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvWjFPed8sEQ7kNvwGeeaya&_nc_oc=AdoJ2vk1xn8OO3Iiz2VKJq9xgI0RYL3GnlUkSxCQ5czzt639-kHHmFMpeDOLnjhqG8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvKxitN3UlIkD6VY_1UYXYH-pTSiuws6nFmFwz2WqnQg&oe=6AF880D0"}, {"file_name": "5.png", "id": "1603630071777873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593895988_1603630075111206_4908743341193780644_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5laTppaLYDEQ7kNvwFfaiz4&_nc_oc=AdqEbGtYv52YoWpFy4fTfIqeelaR1zFXEl5MRpkPenE8BFTT7f6lQvLBNpokos6OH8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj45UJENmQFnj-wwelJlaPx7rrO9rdEHlgDG3mFGTbdQ&oe=6AF877AF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "land.png", "id": "1534023451817146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499627527_1534023455150479_6167446200429499347_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPRX8_JGFvwQ7kNvwGAWK6G&_nc_oc=AdqMjm4pewGOKYtqqi5t4UbnzdQr--3rxyA0HuAQ8tLfslan8mv7m7EUBfS26Jt_uEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnOVwNkN2GvP27Ghr1yFHSvLN0Iw_wiGmiHL2RQBlhYQ&oe=6AF8946A"}, "display_name": "Woodform", "keywords": ["woodpuzzle", "mixedrealitypuzzle", "passthroughpuzzle", "snapfit", "cozypuzzle"], "long_description": "### Turn Your Room Into a Wood Workshop.\n\n**Woodform** is a cozy **Mixed Reality puzzle** that brings tactile woodcraft into your space. A mysterious **pedestal** appears on your table with an unfinished blueprint. Bring it to life \u2014 piece by piece.\n\n---\n\n### \ud83e\udde9 HOW TO PLAY\n\n* **Grab & Move** the pedestal to place the puzzle anywhere\n* **Pick up** wooden blocks and **rotate & align** for a perfect fit\n* **Snap to Fit** \u2014 snapped pieces attach and move with the pedestal\n* **Lift out** any placed piece to try again\n* Complete every joint to unlock the next blueprint\n\n---\n\n### \u2728 FEATURES\n\n* **True Mixed Reality with Passthrough**\nYour table is the workbench. Solve at room scale.\n\n* **Tactile Snap-Fit Puzzle**\nIntuitive grab, rotate and snap. Feel the *satisfaction* when wood clicks.\n\n* **Moveable Pedestal System**\nMove and rotate the pedestal \u2014 all snapped pieces follow.\n\n* **Relaxing & Brain-Teasing**\nDozens of handcrafted blueprints, from simple joints to complex structures.\n\n---\n\n> *No timers. No pressure. Just you, the wood, and the perfect fit.*\n\n**Made for Meta Quest 3 / 3S with Passthrough.**", "short_description": "Assemble wooden pieces in your room. Snap, rotate and fit every block onto the pedestal to complete the blueprint in MR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/seivr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Jone Sei", "support_website_url": null, "website_url": "https://sites.google.com/view/seivr/games", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "978369598664065"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1147623990970336"}, {"status": "PUBLISHED", "id": "2118390502118222"}]}, "baseline_offer": {"id": "1147623990970336"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792840980, "status": "PUBLISHE
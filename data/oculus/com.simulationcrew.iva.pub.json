1-25/491827960_1528299655307004_9007684721254758035_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxGSvSBZnhgQ7kNvwFWb9hC&_nc_oc=Adq9MY_P8rE1LB533dmBFZaQ2mK433AgnzzN4cyrPQkL_aFc-eGtK1vxAJZz1m55MBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyf97ndZTYlz25wu1CEh1YsGs7WE0PXsnm6Xc5K-jYzg&oe=6AA2B56E"}, {"file_name": "Screen2.png", "id": "1308452657905929", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_1308452661239262_6871441703240031846_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4YqF1NeANgQ7kNvwGvyImk&_nc_oc=Adp6DfaZBqVrUT7bfRDfihiDDx7WrD6zWf5f-OKhSYq39kQhbQRubEThx1Pu1dvIWuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINl8nRQWdEsn3CyOlh0wqC1S2HsT3YseyTNbMjtlaTOw&oe=6AA2BE8B"}, {"file_name": "Screen3.png", "id": "984923557627669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818852_984923560961002_8800663908369306307_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaaFNXqKGNoQ7kNvwHcboKx&_nc_oc=AdoBkhkPmCkYbp7UOJL6KFTjW9rCNGOnYc3VnAXDlD17lnWjwJxPsEyUGnrYfWiPPHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDBBF2a00STSc6aPZZ1Os74ZlhMfaCCvpui5gjJWlmdA&oe=6AA2D1B0"}, {"file_name": "Screen4.png", "id": "1528803395311009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1528803398644342_8584463923375930020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkkB7NRsDsoQ7kNvwEPFruZ&_nc_oc=Adp0w3sINgpNUcgvEWsauMHDxVeiVGi2CEmG-vOs6KaNU8sWXMNN6sID90cTe95nRqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHuKm8DwlnPOS6lqPwtcqSMflzXxsTz-u4dSyiUQGAiA&oe=6AA2C323"}, {"file_name": "Screen5.png", "id": "1726619985042196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_1726619988375529_2732586889715115681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND2zeXHt6xMQ7kNvwFb1MWw&_nc_oc=AdoyrsLIFu3npi8yz3z5qCm_tK1rQRsDcabETYTix9NEwoYRtw87WGigbadsDz3d0G0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfe6TiGnFYwpJCyo04AvX5jXiAQMzVhfRGNx6bjLqSaQ&oe=6AA2C496"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IVA Communication Trainer", "keywords": ["communicatie", "training", "softskills", "simulatie", "gesprekstraining"], "long_description": "**Train je gespreksvaardigheden in VR met AI-gestuurde karakters.**\n\nIVA plaatst je in een realistische VR-omgeving waar je face-to-face oefent met levensechte karakters. Ze luisteren, reageren en passen zich aan op wat jij zegt \u2014 als een echt gesprek, maar in een veilige oefenomgeving.\n\n**Hoe werkt het?**\n\nKies een scenario dat past bij je studie of werk en stap de virtuele spreekkamer binnen. Dankzij AI voelt elk gesprek anders \u2014 je gesprekspartner reageert natuurlijk op jouw aanpak. Na afloop krijg je persoonlijke feedback: wat ging goed, wat kan beter, en tips per leerdoel. Herhaal zo vaak als je wilt en groei stap voor stap.\n\n**Voor wie is IVA?**\n\nIVA is ontwikkeld voor studenten en professionals in zorg, sociaal werk en onderwijs. Van intake- en leefstijlgesprekken tot sollicitaties \u2014 IVA biedt een veilige plek om te oefenen. Of je nu soft skills ontwikkelt of je gespreksvaardigheden aanscherpt: in VR oefen je alsof het echt is.\n\n**Wat biedt IVA?**\n\n- Levensechte AI-karakters met natuurlijke spraak, expressie en lichaamstaal\n- Immersieve VR-omgevingen uit de praktijk\n- Scenario's voor zorg, welzijn en onderwijs\n- Persoonlijke feedback met scores en tips per leerdoel\n- Oefen op je eigen tempo\n- Ontwikkeld met professionals uit de praktijk.\n\n**Toegang**\n\nIVA is beschikbaar via een licentie van je onderwijsinstelling of organisatie. Neem contact op met je docent, trainer of leidinggevende voor toegang.\n\nOntwikkeld door The Simulation Crew \u2014 experts in AI-gestuurde communicatietraining en VR-simulatie.", "short_description": "Oefen realistische gesprekken met AI-gestuurde virtuele karakters in virtual reality. Ontvang persoonlijke feedback en verbeter je communicatievaardigheden stap voor stap."}, {"images": {"nodes": [{"file_name": "IVA_icon_apple2.png", "id": "1295461772068289", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_1295461775401622_3338920352251791744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhxgQZtOtnwQ7kNvwF2zJ93&_nc_oc=AdptKKyxv1Ln24v_pShKagg9eIqcYoVRIqbHCJ2q-K6ZVRAjfgaw6Vun74ibiD_SZWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ1UTE6D8mRopNX6PAUDeimJhZGw3w0RD9jQwPnwWrSA&oe=6AA2B9F5"}, {"file_name": "SquareCover.png", "id": "1187134900131625", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1187134903464958_524383421953698407_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP9m7l6Vs7YQ7kNvwEWVwZk&_nc_oc=AdrtZDkm5Tco--DScpdXq77TGSSJD3vS4la_YUN2AwzrceHS7G2x1K-gwaJpJrMfCd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbd0u61euHnSJv3DJ8_ZRcV3dJpZoEX0NCbbyo7LYtig&oe=6AA2C347"}, {"file_name": "LandscapeCover.png", "id": "992296333272328", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818852_992296336605661_2723970590904271417_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_p6FZT1KqYQ7kNvwEZ4Meh&_nc_oc=AdrdHnJGMXqSMsbWISezpo6S5vZLjxujFZgiptVPs5hvQRPSLhw8c7BdZfnzKpJL86U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpHNP8v6Elb_ejGTfDl_E_iCu83mVt3bpxglPyqXUMdQ&oe=6AA2BF1A"}, {"file_name": "Hero.png", "id": "983525727463276", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_983525730796609_2391566583409128733_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pgvo9I4Ma_sQ7kNvwF_RrUF&_nc_oc=Adr5HyJ30gW8rULRj4eZO9mqdO9vxcePJ2WrL6kIaiTNnCLfSGtREOAc2CJ3RvdDG-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOChPy2xYbElJ6OVrjk1XZcYmaZlV-YQaUGJGIMXYhSQ&oe=6AA29D00"}, {"file_name": "Portrait Cover.png", "id": "970244632175491", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_970244635508824_6362591105526950625_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYJzrQaagBIQ7kNvwF4pZ9-&_nc_oc=Adrd07K8HM5IKcCJfItCM3OwQ2DH0Phnn1Y7dOKIjrrD5yIJ-etEjUpU5BMlfcnYD0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTGararXrBuCf5ZKy9ZYxHHkiOx_AtJApA1lFdTIMYzA&oe=6AA2C02C"}]}, "id": "981968450887426", "locale": "en_US", "screenshots": [{"file_name": "Screen1.png", "id": "1480348550222342", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823940_1480348556889008_4732350943309698895_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEtzM8rC8HYQ7kNvwFhCTGe&_nc_oc=AdqXcWTeQiWW4tAIeDIGc5ZKM1gJGM2MLNhH8PUulcOjA5l_7d0naYIvl1cw9X2-RYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID5GOc7QZXbSkqObrzchaj5EiB70zKa77Z4ljRBAatmQ&oe=6AA2AB01"}, {"file_name": "Screen2.png", "id": "988285683715109", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821682_988285687048442_2245110759337420755_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5H6-utEMJUQ7kNvwHulXvv&_nc_oc=AdptChlFwZGIkBEvd5FwIiWd4vqSHfS4kyUUDqcHHHjSPqS50ymxEqC5JXksPAdc2Z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWw2lS7keK6mpKRqTADK62CQfK1x9dKiBtPUHhM5DfLg&oe=6AA2B984"}, {"file_name": "Screen3.png", "id": "853090301177951", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823940_853090304511284_3683322577131358075_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDQLFY1g2CcQ7kNvwEYHx2z&_nc_oc=AdqCWbGVtjI5n_u4jroyvNoJYqNDBb14vfORGJcxYqqaLRmwKVQbTlIuNAPgwaWMXp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9wZHhquCVmBXYXEs1MXlwnKDs2kqrvlQ9kLrb8o0CSA&oe=6AA2AD79"}, {"file_name": "Screen4.png", "id": "2157421048443990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_2157421051777323_6360944095950854529_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyDGXvdPTwsQ7kNvwHcBbio&_nc_oc=AdqSALaruXzzp9MtyUiKAEhhXYM9yTFSDU_t1ih7sD9_GvQJ2mavsSnRL-QX6EDKjcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbSHNxkDqqDZKxnerNMCtbZmd7Um_LhWK7zzfiqw9aGQ&oe=6AA2AEA8"}, {"file_name": "Screen5.png", "id": "27109475238676997", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_27109475268676994_5393600175025448960_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5y564O4OyXYQ7kNvwE7Olox&_nc_oc=AdpniOCRbK2HivFYHA-QF4yNJR_rp8VyWSDVAZ3ur0ff4BQvCVqOw4IvnF46vNKB3WY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdZc0JHdkfa6PRYCe1KSdfYRSbbWmdMzZEj4xvV0T-Zg&oe=6AA2C552"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IVA Communication Trainer", "keywords": ["gespreksimulatie", "training", "softskills", "communicatie"], "long_description": "**Train your conversation skills in VR with AI-driven characters.**\n\nIVA places you in a realistic VR environment where you practice face-to-face with lifelike characters. They listen, respond and adapt to what you say \u2014 like a real conversation, but in a safe practice space.\n\n**How does it work?**\n\nPick a scenario that fits your study or work and step into the virtual consulting room. Thanks to AI, every conversation feels different \u2014 your partner reacts naturally to your approach. Afterwards, you get personal feedback: what went well, what can improve, and tips per learning goal. Repeat as often as you like and grow step by step.\n\n**Who is IVA for?**\n\nIVA is developed for students and professionals in healthcare, social work and education. From intake and lifestyle talks to job interviews \u2014 IVA offers a safe place to practice. Whether you're developing soft skills or sharpening your conversation skills: in VR you practice as if it's real.\n\n**What does IVA offer?**\n\n- Lifelike AI characters with natural speech, expression and body language\n- Immersive VR environments from real practice\n- Scenarios for healthcare, welfare and education\n- Personal feedback with scores and tips per learning goal\n- Practice at your own pace\n- Developed with professionals from the field.\n\n**Access**\n\nIVA is available through a licence from your educational institution or organisation. Contact your teacher, trainer or manager for access.\n\nDeveloped by The Simulation Crew \u2014 experts in AI-driven communication training and VR simulation.", "short_description": "Train communication skills through realistic AI-supported roleplays with personalized feedback."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thesimulationcrew.nl/wp-content/uploads/2025/12/Privacyverklaring-The-Simulation-Crew-1.3.pdf", "developer_terms_of_service_url": null, "publisher_name": "The Simulation Crew", "support_website_url": null, "website_url": "https://thesimulationcrew.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27138539062418515"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1187134903464958_524383421953698407_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eP9m7l6Vs7YQ7kNvwEWVwZk&_nc_oc=AdrtZDkm5Tco--DScpdXq77TGSSJD3vS4la_YUN2AwzrceHS7G2x1K-gwaJpJrMfCd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQ
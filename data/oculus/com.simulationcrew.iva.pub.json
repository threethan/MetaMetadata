u1dvIWuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINl8nRQWdEsn3CyOlh0wqC1S2HsT3YseyTNbMjtlaTOw&oe=6AA2BE8B"}, {"file_name": "Screen3.png", "id": "984923557627669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818852_984923560961002_8800663908369306307_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaaFNXqKGNoQ7kNvwHcboKx&_nc_oc=AdoBkhkPmCkYbp7UOJL6KFTjW9rCNGOnYc3VnAXDlD17lnWjwJxPsEyUGnrYfWiPPHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDBBF2a00STSc6aPZZ1Os74ZlhMfaCCvpui5gjJWlmdA&oe=6AA2D1B0"}, {"file_name": "Screen4.png", "id": "1528803395311009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823790_1528803398644342_8584463923375930020_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kkkB7NRsDsoQ7kNvwEPFruZ&_nc_oc=Adp0w3sINgpNUcgvEWsauMHDxVeiVGi2CEmG-vOs6KaNU8sWXMNN6sID90cTe95nRqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHuKm8DwlnPOS6lqPwtcqSMflzXxsTz-u4dSyiUQGAiA&oe=6AA2C323"}, {"file_name": "Screen5.png", "id": "1726619985042196", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821568_1726619988375529_2732586889715115681_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND2zeXHt6xMQ7kNvwFb1MWw&_nc_oc=AdoyrsLIFu3npi8yz3z5qCm_tK1rQRsDcabETYTix9NEwoYRtw87WGigbadsDz3d0G0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfe6TiGnFYwpJCyo04AvX5jXiAQMzVhfRGNx6bjLqSaQ&oe=6AA2C496"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "IVA Communication Trainer", "keywords": ["communicatie", "training", "softskills", "simulatie", "gesprekstraining"], "long_description": "**Train je gespreksvaardigheden in VR met AI-gestuurde karakters.**\n\nIVA plaatst je in een realistische VR-omgeving waar je face-to-face oefent met levensechte karakters. Ze luisteren, reageren en passen zich aan op wat jij zegt \u2014 als een echt gesprek, maar in een veilige oefenomgeving.\n\n**Hoe werkt het?**\n\nKies een scenario dat past bij je studie of werk en stap de virtuele spreekkamer binnen. Dankzij AI voelt elk gesprek anders \u2014 je gesprekspartner reageert natuurlijk op jouw aanpak. Na afloop krijg je persoonlijke feedback: wat ging goed, wat kan beter, en tips per leerdoel. Herhaal zo vaak als je wilt en groei stap voor stap.\n\n**Voor wie is IVA?**\n\nIVA is ontwikkeld voor studenten en professionals in zorg, sociaal werk en onderwijs. Van intake- en leefstijlgesprekken tot sollicitaties \u2014 IVA biedt een veilige plek om te oefenen. Of je nu soft skills ontwikkelt of je gespreksvaardigheden aanscherpt: in VR oefen je alsof het echt is.\n\n**Wat biedt IVA?**\n\n- Levensechte AI-karakters met natuurlijke spraak, expressie en lichaamstaal\n- Immersieve VR-omgevingen uit de praktijk\n- Scenario's voor zorg, welzijn en onderwijs\n- Persoonlijke feedback met scores en tips per leerdoel\n- Oefen op je eigen tempo\n- Ontwikkeld met professionals uit de praktijk.\n\n**Toegang**\n\nIVA is beschikbaar via een licentie van je onderwijsinstelling of organisatie. Neem contact op met je docent, trainer of leidinggevende voor toegang.\n\nOntwikkeld door The Simulation Crew \u2014 experts in AI-gestuurde communicatietraining en VR-simulatie.", "short_description": "Oefen realistische gesprekken met AI-gestuurde virtuele karakters in virtual reality. Ontvang persoonlijke feedback en verbeter je communicatievaardigheden stap voor stap."}, {"images": {"nodes": [{"file_name": "IVA_icon_apple2.png", "id": "1295461772068289", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825497_1295461775401622_3338920352251791744_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhxgQZtOtnwQ7kNvwF2zJ93&_nc_oc=AdptKKyxv1Ln24v_pShKagg9eIqcYoVRIqbHCJ2q-K6ZVRAjfgaw6Vun74ibiD_SZWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZ1UTE6D8mRopNX6PAUDeimJhZGw3w0RD9jQwPnwWrSA&oe=6AA2B9F5"}, {"file_name": "SquareCover.png", "id": "1187134900131625", "image_type":
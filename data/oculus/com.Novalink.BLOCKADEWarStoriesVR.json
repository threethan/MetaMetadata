1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFIhQb5dKZUQ7kNvwE4NvV-&_nc_oc=AdqtTYyrZXbv3UQf70kqdAGkGv5SnlPYuN9rDcdsohGJACheW3cLlw8fcJv_ci45oaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC8LX6HyaupNaAvWtQQFy3GXSyao59kTlhACVtzuWwcg&oe=6A622CB8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdHjpf8IqMoQ7kNvwEh3s1B&_nc_oc=Adpy_JO8TbdPV4PwOVaA49Snv7BTuyee9oAkcX4oC207QON6zJ-fTNKMJDPRaGaqT0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_l3GBjuVTJvrqGTZe2zpjUqv8MVytZVXSSaUHINQ5cw&oe=6A620E31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1dQ9-JOy3AQ7kNvwFuEtKd&_nc_oc=Adp-mld81OBf5uGxSLvJsWJKQqrmD4lVXO4THGafNUQtg3ZgCW6pBD9Rrb_mUaxWBBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzTuMuW0PCzbqsC6o1eZiZjfEcxg0PYdJA9kBnNLZ1_A&oe=6A61FF7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mb85VVE3JKwQ7kNvwHsmjnX&_nc_oc=AdpUaWB1rDOtE7l3HyGC-dQiJzV9w8lqQ3c_JBjTfEO4cjWmoz1Qb9QTrQYk0HvQqCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8I8MW4v7Gz9CUMSrBDrvRyIYEFEyvcG_TmdPdB8YLxQ&oe=6A6205EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPkgdK28umgQ7kNvwEcicqQ&_nc_oc=AdqWx02PWiCi01LFu0THM8RYvr0ZmxQ1_JC3N6l_eP4oSl8YVPvPb4KozDMe77r3yJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjYRnn-Pg0qyfIQpObuYFPFjdBcFrksQmjFW2VTMXP6w&oe=6A621652"}, {"file_name": "1440x1440.png", "id": "13054895174670
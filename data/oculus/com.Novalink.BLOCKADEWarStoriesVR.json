1769871257146153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hRX1q2ezDsQ7kNvwFM1VwJ&_nc_oc=AdqsdIp80p7MJAJzc4LJlq5S2eKFVfhmTOQr-13ZbDNwXNAq7nSDoShd2k3gB3kKmNw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNi_63p_TAN8-xXuHfEzfLx93gEX5W2jdGI_MFuBqedw&oe=6A58F238"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN2AFER1MoEQ7kNvwGKEoSn&_nc_oc=AdqobJdaBt8-snhoETezn-Bsi07TMEJKx6D7Ohfo5zr44rMQZcetWGGtJySw1nGjEJQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT71KkuM0YuvpqjgIYOgkIMu0r-p-GmGoTgsdquldaRA&oe=6A58D3B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfqeeg2wi8oQ7kNvwFZgOrh&_nc_oc=Adprb3Soh_7gIs416gxc3jjtWDOtqFhgKR_-STXfgqi93v01TDIMZBMYG2A9dgHVWdQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAIniYy_0KNyhRYEv9zAH1ZEZNgRQueOkpdQvxrrlNpA&oe=6A58C4FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABlyhcLDUAgQ7kNvwHTul5W&_nc_oc=AdpZXkGqpVV36wNOK7ayjR7WZCPBHwXFCcMQXXYm5paotdehkERCLiYL8k6a2Wbv-ow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUL-1LIrtlVrMrDfzKIKmk3q2BME-HD-Gr32zkZ41pDA&oe=6A58CB6B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EY4lcH_nlYQ7kNvwGmrmly&_nc_oc=AdrGnnW9tNPEVwJpQ0BFF_2cav6kjq0z0c0pkwRA_igXP4bQoy5dr_hwGqq6IWOdth4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYHyqbIbUHwPa5JBFU67bmChPkLM6QsO2e5dGCtSvxww&oe=6A58DBD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
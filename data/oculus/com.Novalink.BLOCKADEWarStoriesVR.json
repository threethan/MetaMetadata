1769871257146153", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ0VpxRmMgcQ7kNvwFypH0t&_nc_oc=AdrRj6YPIsKQfpFf-x486TgAfBW86BnHHC-UHw1HceZwQoz15N04KAjx1TnXnh5y55g&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZYW1UUiFDdWrt_MlNWLY3Y5jb6rbWGmGI6fIhlGkwXg&oe=69E24B38"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zh9WgRrTwEkQ7kNvwExEF10&_nc_oc=AdqIycu_PA1Pm7N9ZIdVuQidIUHjls-dbTyJeJQ7nghtCdKfCZEnw8MhHQto70-px8E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JG-8cVD9flFLTUCf-PGmm6YM-qodnMAY8fbjKZhBJCQ&oe=69E22CB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAE1sNeXmdgQ7kNvwFShrSh&_nc_oc=AdqJcBmmhiPOqqxn6hG5U9rlbIrWI2hwR0lptjVtOzsA2fPswso3RYj22QG7Slu1WMw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oPEykcH3Kg3dUffouH8s76vAzvG7a1cvlaWr4PY7CBQ&oe=69E21DFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwYAJv2SEogQ7kNvwFJ_ZWa&_nc_oc=AdqvRWRPK_jOXFrepReyciH23AnbklnCx33R-UZx39nncoEYhOKCmjKpoe-3xn6v_sw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35eqxIpRYkY5zBzGDRckik2asAT_A0Rkr1_xRgo-wblw&oe=69E2246B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KFiFCssyUQQ7kNvwEHnRw7&_nc_oc=AdrxKEaCfseBVfVd7lu2GXy5Z-x230iffxlrFM1uP8GuW99eE0iu3Ls-c-nqbEd3V60&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e_TgxWdoDROfBzYTWv5bjmWUNAqXvontdNrSGJPY35w&oe=69E234D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
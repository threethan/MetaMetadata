1769871257146153", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFRhk-CJ_BAQ7kNvwHEbNLI&_nc_oc=AdokrguUkyEYE_eFPL1objOkAkwBkGFxM5J6GZi1qHSuc-qcPCNFYTGHsjQzfCCfAJA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7pj97tw6WXLir7h4U6iDbYyOQ2yCReWjzjGoxpOwRKg&oe=6A26D938"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk1BdXiavaEQ7kNvwG0nT0W&_nc_oc=AdqSacuFPhoKBYMrxC4Luqc3FylZO3_RFZ58IPLUtNcc7SFB0AwNyd2nUgaIFivu6vE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84giLyTsgiaP5r4jh0hWEHlQ0AqtXRjExgyisvMvmqLA&oe=6A26BAB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTRAuT1X3y8Q7kNvwFSjyTn&_nc_oc=AdoD3lG2qBNGvGzqlAJiIO9UYNiaNByMTBGbJ0vG9uxVSBuDC23RpgcBt74KrYSrijQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6NZ3rwTbrA6ai9jgzChtZg44Rue1YagFabxRKPYbpzw&oe=6A26E43A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1apLXFKCDoQ7kNvwFSsnFp&_nc_oc=AdqIusthASE3wzN9rwXt8dLOs9vIXsyBjVxOLXBasnNwORgA7-mB_kukU4O5eqPklzs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9YNTRsNV8rOZFZdgCiGq1HjCxSS5YzWU5-y4QA5csBw&oe=6A26EAAB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o_vOyjycmQsQ7kNvwGdZqPC&_nc_oc=AdqwODyneiQzAfnVaZOOcSK7618w0mObARSrSsSUyfldCbW42VqeJb2zHta84Tbefb8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-p0-XGC2d-Dp96ncvmkV_v75vYiH2dEz6OaYyIM3WWQ&oe=6A26C2D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
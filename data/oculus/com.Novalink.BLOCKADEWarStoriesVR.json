1769871257146153", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s4B7he0heZcQ7kNvwEUG2pF&_nc_oc=AdrGKcBCWdSovOjPXet7Maob3oI39M6BbVYZ87xK2c07hFh0rC0AfTT-DIc18siB6ZI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzi9HJwBj0XSwwQeUcx8xBQsw08O1cHJJ3kml-xBRQ7Gg&oe=69C511F8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_ILMR6KDnUQ7kNvwEZF0Pd&_nc_oc=AdreQ7FQtYTm19vPc7062QDiumqInmYMVNpvTNA_xPhM31ml77D_S-uBdJsEwraOv2I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzrdb9qNFu-PdlRIx_INym3VTbytA89fEW3kn9pWwvrDQ&oe=69C52BB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f85dA7nLnxoQ7kNvwFcMnwj&_nc_oc=AdodJv-USEr8YFnsy4xy4VmNum0nKHrL9SnCE9rFpjFrIJtrjQlbdjSiT1OQv5K05LY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8nG1bXL5JrHD7bO_VTIhcw54zZp88QYLKJhAnil72rQ&oe=69C51CFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBdwcSgbqS0Q7kNvwGuNi0O&_nc_oc=Adr0KFHqZQdnqMD3GngaIyZ1nLjAnvm2jyB7qr-XWPcjP5SUl-wEzxl0R_CTbtlQfE0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrpUEqVqjlWFm5KbxOzlw7U-R78qh5FZmpzCxn32dIYA&oe=69C5236B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qeb5PwMQAp4Q7kNvwHY6TCk&_nc_oc=AdrTndPN9mTLgKK8RYYePs1WehPCo-YmQ_hegWgJgB6tQUqNQ9tCvrFoIbYAy2URis8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC-fslRhQgVGJG8jYoxMJ-tftDIUt3kQgUggnjlmWalw&oe=69C533D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
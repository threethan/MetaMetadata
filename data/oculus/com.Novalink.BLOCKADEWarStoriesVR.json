1769871257146153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U816ThKZ_GoQ7kNvwGAB2GI&_nc_oc=AdoFxSF8KhseK3ImObsa_tkOolZ-Ru21YjGv1T7155BjlVRawH4t-iBtcbQG7RgjEL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsVV120OZD3hdTFW5xSL0WOa5ODTavh_JTHF1cy5JWiw&oe=6A9018F8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4xobr-wELkQ7kNvwFKvXS2&_nc_oc=Adq33GXjl9SeBvV3NmDpms6uOXtkMugTfMaQJe-ksR6BxT7biQHLoiG4BG7irRJ7mz4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr5MlHHABl8KivwTL3q9-0_DUsk0Fg7eH0UKAqVSjicA&oe=6A9032B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MF3H0t3thawQ7kNvwFF6v8A&_nc_oc=AdrxNPHvxZs7e3Uo4YpXRWDxcG42_WKac28zuNkbU_lLKsSWs9DhHMzbeEWM4j5u3Jc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjKw_dYbO0fxm9q_q8A12wmS_-2GFhPQIbykyIXk_0eg&oe=6A9023FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cbO73BZfGoQ7kNvwFih1qa&_nc_oc=Adp9qYGfhRuaYBqgqGJQudujl-7Htig8ZYAz3TjfghqA9THwPfCnF6HbA4adZ07PRPA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEEhw0BUlHZLCGUipX9h8JsLCCNzc220P-wrQVttx-3Q&oe=6A902A6B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewrUe5ARtcQQ7kNvwFgS8Da&_nc_oc=AdqjdzYHtZWEOOXLKibmNDzO3ydFdx5EtYKKF3iiLLBiY_s3GNnSKZ8E5VK5l4Cy4LM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbbTUz_-dP8Q8jNOpH0uMCGJIeB3KBQr-msbDYgu02Pw&oe=6A903AD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
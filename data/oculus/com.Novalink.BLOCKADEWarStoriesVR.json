1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSMxzn54_KYQ7kNvwFod-aE&_nc_oc=AdrRQbsPqf6um90VbmW5Hau9A-gQAs21xOq7falkH47fGWQxpPvvhpfUm6npb2apsi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzm3OQvuLs9mw-lfkQwFL9WnCaCcthh6o5Ifn0DpOttg&oe=6AB146B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMzBpvkI2h0Q7kNvwGWvfex&_nc_oc=AdrpnnMIDrF2BIYSwyXzERjNNH0AwOHuh3M_QN6Zl1YyREihqNanRXko5QdzA_4kmVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQp54B4DGjHJfgGpWHvGFjZ35GQdqcBO837zC0RIul0w&oe=6AB12831"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r018kwEjIAkQ7kNvwGG9Ifm&_nc_oc=AdqPDG51MYqw8U4muLpS_1gKxee6mF7TliUyjdlK2IxH5mxm5CCPjkwVz71beDepzWE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJisqobXxFPQhbMl1i4Fe8KFNvIShT002TmpJCZXVWo4w&oe=6AB151BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BkRe1xvnBGYQ7kNvwG1S7sD&_nc_oc=Adq-qqCLES8cOjyg12KhctktiBpfkcVd4diXrv0YuDcl5bwPqPR0067ZQOSC3QqWT28&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaw9Qd-CkQ9cHzNOQVkV2J2KH2RUIyOpS9N7GXaaxczw&oe=6AB1582B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCrn47ekwm4Q7kNvwHkYUIr&_nc_oc=AdoBON2LJG9GAryCvVRIms9kPv_ajdP-IjnSCZC8drQQxsw7rsZbL30BZSac_I3-mcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoxSWO2-54WnDnIzyHYjSsBbxU_TjhIHgYrebZB99edw&oe=6AB13052"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yzLQ9n_KyQQ7kNvwHBI94T&_nc_oc=AdqRjAj7Pg9q0UWSUsmhSoNdkwccwJtJJokgi4ByijqOsxBPT16_BOvOF73GQzzmMQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByl1_7E54n_p0wWCFjfN-sOYklpzF27wwOBa70fMnMBQ&oe=6A65E8F8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsebffCcMWYQ7kNvwFxW-l9&_nc_oc=AdrWDCChlZwU2Ms1NumUR68HsldWPHn3XiM_J3WLeDBrEnC2XnzCjvOsi_88gBNU4jA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDglWBBo9Udq0aoNcyg34DSqpVYB7BSSLi0nz7-5Zutzw&oe=6A6602B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtOFBbIHAGQQ7kNvwFUuc_z&_nc_oc=AdovhEKsPjpctpJXRH4YuEm6_Rbby-3w5-mcgSjLORv9Pkc6ITi6G1PD2QqsUGoed5s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIB-Qy0E63j2DGk-9IaT8rlq8LRDnbqXtiBsnhwOQ-Gg&oe=6A65F3FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBgpYjSzu9wQ7kNvwGHKWrJ&_nc_oc=Adpx7_8ru_bwCn3gxme-HFctZjaiJT7pHwJrdbPVpZ99UiERcOmbQcGF4kcnu1y7iR8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPdTkKV41RnsX4gw1PVbCkA8JDUPlBw4U87mZ8Q1tOLA&oe=6A65FA6B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm93I--MXBUQ7kNvwFsnpYD&_nc_oc=AdoPBHHvHkeIoQoBdDik86qmLfNXsSabYzf4K1q7LV6kWNLrUfwrsi9BrXeqNtPI6g4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJRcaRazzuAndtiCqH6WXZD_Yu_4Zg3zmVyMafV1MTQg&oe=6A660AD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
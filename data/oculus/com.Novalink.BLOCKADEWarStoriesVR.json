1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AAUobxXZJYQ7kNvwFf96Xc&_nc_oc=AdoDfzUK9yAGM7ah2A24xX1V4tYhx3eVdewvvPgBgzal_4m1aIAwDFvy-POxeRsGoyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnXZeN7OLbb58YscfLz2t5XkQXKi1qqnC355b8pDR7Yg&oe=6ACCF638"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nIXC5oC1nkQ7kNvwFh8ga9&_nc_oc=AdpUt7zqhEBde97OBsIm5H6DurR1qQJRchK1OkObVgq37zG7R4GKihyDzmFl_pwf8Mk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLjkgB4Y30BRDZp6AM9HlBlpMoIVTm6H_BeK0zOmymlQ&oe=6ACD0FF1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0de8aNv2fgoQ7kNvwEl9l5n&_nc_oc=AdofUIL1DodRT-ctdxV9h7CPFIfk4RzD6uWEUl1bKfNqNjlM0-f1tPGQyrOzxiyyQns&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfPvVCqy8avKaY0o23k3d2YUiRKgARILYdmfLIVgMNUg&oe=6ACD013A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ6sl5irBPcQ7kNvwEYOsK5&_nc_oc=AdpSiymIwuWoLkI8KM2NdxStLEQrLyzwANijXn7ElL9QrQrlJaSRxgg5wlcFc1XDC6c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxVo_Ee2zz4zu9F22q8FEJlaXpe5EZB5ctP6xfe9LGiQ&oe=6ACD07AB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv3AE8pq8vQQ7kNvwH_Ry9t&_nc_oc=AdpBBuT31vpKq5ztA6t8BGX13DTBGjpd9AeddLgMLB3tcro4Wqx1X-qHMSLSQkn2Drg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA_q-uD53ZPF1smUZrnnqTbYgzo2wkRn_Hj61oW5l2dA&oe=6ACD1812"}, {"file_name": "1440x1440.png", "id": "13054895174670
oc=AdoXT3-ImsafZ5_LMVXrGgCZC46JAAQQqSM16NDfNpKENVQT41r7ehpHlf5wdg-sTvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhu4HPNbM5_BEnNt87NHvmI0ydYXa07MNQ4Yh17gA2Ig&oe=6B05C0CA"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "\u0431\u043b\u043e\u043a\u0430\u0434\u0430", "\u0448\u0443\u0442\u0435\u0440", "\u044d\u043a\u0448\u043d", "\u043e\u0440\u0443\u0436\u0438\u0435"], "long_description": "\u041e\u0449\u0443\u0442\u0438\u0442\u0435 \u0432\u043e\u0439\u043d\u0443 \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443 \u0432 **BLOCKADE War Stories .VR**. \u042d\u0442\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0439 \u0438\u0433\u0440\u044b \u043e \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0412\u043e\u0439\u043d\u0435 \u0441 \u043f\u043e\u043b\u043d\u044b\u043c \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c.\n\n\u041f\u0440\u043e\u0436\u0438\u0432\u0438\u0442\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439:\n\n- \u041e\u0431\u043e\u0440\u043e\u043d\u0430 \u041c\u043e\u0441\u043a\u0432\u044b \u2014 \u0432\u0441\u0442\u0430\u043d\u044c\u0442\u0435 \u0432 \u0440\u044f\u0434\u044b \u041a\u0440\u0430\u0441\u043d\u043e\u0439 \u0410\u0440\u043c\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u0441\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u0440\u043e\u0434\u043d\u043e\u0439 \u0433\u043e\u0440\u043e\u0434.\n- \u0420\u0443\u0438\u043d\u044b \u0421\u0442\u0430\u043b\u0438\u043d\u0433\u0440\u0430\u0434\u0430 \u2014 \u043f\u0440\u043e\u0431\u0438\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u043f\u043e \u043a\u0430\u0442\u0430\u043a\u043e\u043c\u0431\u0430\u043c \u043f\u043e\u0434 \u043f\u0440\u0438\u0446\u0435\u043b\u0430\u043c\u0438 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0445 \u0441\u043d\u0430\u0439\u043f\u0435\u0440\u043e\u0432.\n- \u0414\u0438\u0432\u0435\u0440\u0441\u0438\u044f \u0432 \u0442\u044b\u043b\u0443 \u0432\u0440\u0430\u0433\u0430 \u2014 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u0439\u0442\u0435 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0432 \u043d\u043e\u0447\u043d\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.\n- \u0428\u0442\u0443\u0440\u043c \u0411\u0435\u0440\u043b\u0438\u043d\u0430 \u2014 \u043f\u0440\u043e\u043b\u043e\u0436\u0438\u0442\u0435 \u043f\u0443\u0442\u044c \u043a \u043f\u043e\u0431\u0435\u0434\u0435 \u0432 \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0431\u0438\u0442\u0432\u0435 \u0432\u043e\u0439\u043d\u044b.\n\n\u041f\u043e\u0433\u0440\u0443\u0437\u0438\u0442\u0435\u0441\u044c \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443 \u0432\u043e\u0439\u043d\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u043e\u043c\u0443 VR-\u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044e, \u0433\u0434\u0435 \u0432\u0430\u043c \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u0438\u0442 \u0441\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u043b\u0438\u0446\u043e\u043c \u043a \u043b\u0438\u0446\u0443 \u0441 \u0432\u0440\u0430\u0433\u0430\u043c\u0438, \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0442\u044c \u043e\u043f\u0430\u0441\u043d\u044b\u0435 \u043c\u0430\u043d\u0435\u0432\u0440\u044b \u0438 \u0432\u044b\u0436\u0438\u0432\u0430\u0442\u044c \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445, \u0433\u0434\u0435 \u043a\u0430\u0436\u0434\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u0438\u0442\u044c \u0436\u0438\u0437\u043d\u0438.\n\n\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 VR-\u0432\u0435\u0440\u0441\u0438\u0438:\n\n- \u041f\u043e\u043b\u043d\u043e\u0435 \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e Oculus Quest.\n- \u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0442\u0438\u043b\u0438\u0441\u0442\u0438\u043a\u0430 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f.\n- \u0420\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u0430\u044f \u0431\u043e\u0435\u0432\u043a\u0430 \u0441 \u043e\u0440\u0443\u0436\u0438\u0435\u043c \u0432\u0440\u0435\u043c\u0435\u043d \u0432\u043e\u0439\u043d\u044b.\n- \u0417\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0430\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0438 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0438, \u0432\u043e\u0441\u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n- \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043d\u0430\u0434 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0435\u0439.\n\n\u0418\u0441\u043f\u044b\u0442\u0430\u0439\u0442\u0435 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u044d\u043c\u043e\u0446\u0438\u0438 \u0433\u0435\u0440\u043e\u0438\u0437\u043c\u0430 \u0438 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0439 \u0432\u043e\u0439\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u0442\u0430\u04
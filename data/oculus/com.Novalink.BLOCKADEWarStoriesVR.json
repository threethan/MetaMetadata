1769871257146153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRHPX2_JAZYQ7kNvwHiWem5&_nc_oc=AdowuQgWj24JFndWgEGEt9pUPpma6Qm4c33SJzX73uhl1fvdGUSXzaFMsiLCGjpgDA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9Bg1w4EK2qXjwobwznSHXWkfeDhpXt_5almVHrTVWEg&oe=6A43DA38"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq-qbU6PFpkQ7kNvwG0GtKn&_nc_oc=AdqFVy89ZpHtZbgZv5r6wmVbQ4ONRbab8Nmyrg0FOM4OmN7Syj97CDDwympoC8V1hsA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UcRogmcENzHZmlflci-0MNe-aQP_HNwwSu1vWeJSu-w&oe=6A43BBB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvEcw5zSsgYQ7kNvwGVFF1E&_nc_oc=AdoP0X8ELHczf2PnAGx0nkQKljklawBygLqzh1RO17SYTQdJnF7qvPDvz6rAydj34PQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Nevj6hjxfpoXyenzy_vjCu9_8V08tQkoW9tk-UYU7QQ&oe=6A43E53A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LX9vLsevfLUQ7kNvwHWj3kd&_nc_oc=Adp0o9saJB9iUbcjO-ac7UgyiItSK1qlQ8xIOcB6UyENIMcIGQZLHapI-cdAYyLPZ9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zzDR-YvPlrR0ofOksx8uPk7WBWiXy3ELA0yzYZiWSCA&oe=6A43B36B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kwMUECHKBwQ7kNvwHSOdnr&_nc_oc=Adrml1V-3CKYl2YWf-wP0vf1sOLBtRF3IH3BkqZ-6Mlj8BeK01_cYcvPrDBqtndXsCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GJ4FB0gJxy0W3HoipAgq6dI9bmdQ3o211miUjPLk5ow&oe=6A43C3D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2JSIGi3TfcQ7kNvwHwGUR4&_nc_oc=AdrqKHzCeNMpIz4-x7m8GPm5SF7mIwcXrYH-nZKyGgGUpJPXBAOreOhMKwinXzvZ5Lk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsIH48DglsIYOHYveqRDBHLc7nBq-AS-MIJDLuj5Uzxg&oe=6AE602B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMORe8TgfqMQ7kNvwHoQhhF&_nc_oc=Adp6O5uE3_06bhbvb8k6qWSsepRDguYYEel2aHM_xNF2JuyikyJNGAfyzH64hJHgbgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCkGWDpDyFg9qqTH2COGO1fzltzmY5bsNOEyXpx5E8cg&oe=6AE5E431"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S62q0QHs_8Q7kNvwEdcDGV&_nc_oc=Adr_qR5vuLce8qFdoIR_9zHt5PZ4W0YYkuoNPyKE0-vJZZMJss3yDshTkfzeFoSMoNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-SWT55bjLGFzc8qd_nI_G2aRwmYoyfKpJOAXFBMKlBQ&oe=6AE60DBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ivoqa9QbvfUQ7kNvwEgM9T_&_nc_oc=AdrqoS2og-5yjeHv93rNhpHzFPYX_3g0APWzqPOgL4Od3_W39PR3ca9p-U6B4BDwZ0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkyknHgwmedet2hXk3kbB7mRpF_R6lpjij9L-I6RIzjw&oe=6AE6142B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGTaPsT32nQQ7kNvwHpZuH3&_nc_oc=AdqwzXPLiBIhoOGUrmuzpneUBtvMW3vtBdQMq7XDjX8g1_2MjGDvrxFSyH1rs6kXRzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjdYLMJVobjolffJ9aYFsCTJFIVLDNbvn3tSSiZo82dA&oe=6AE5EC52"}, {"file_name": "1440x1440.png", "id": "13054895174670
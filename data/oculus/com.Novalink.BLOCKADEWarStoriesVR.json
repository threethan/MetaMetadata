1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYnq1Z3r_BEQ7kNvwGD9gsx&_nc_oc=Adqbii45oGXWHVj1XaWm4vjiVrmA_BrWgYHOjz6XGBkC6WE9nMoXaGk1GPPlu7BA0C8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXNV66yA8GcB-tPc6CdCWCygdPKgfmrnK7-NSx2PkfMA&oe=6A789638"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fowtcy_nH2QQ7kNvwFvBrVh&_nc_oc=Adox4x6u04wHTePpGJwtfkizm7XFjhx8XJnASdQGbddN1X2ClMbCjFClFl_MqtzGyu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBiY56qCDnpbDDsVonLcScV5k95vttABcezubhcJQ08g&oe=6A7877B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvWwDzJqoF4Q7kNvwH2S3X6&_nc_oc=AdouhT1rCD1Q1Vsm1WXtES_ABqVCOj3xqUuYSi4aa6MXZho-16KvLYoevNx_V1ga0wY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA0lrqYLgFgW60h-VQXIiuXVwUjk7I39MpAZerJlYrqQ&oe=6A7868FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-yrNybqAY0Q7kNvwHqzA1u&_nc_oc=AdozOq1B_eVU4h-LWKvCNEKos2jd8ETD31Ss2X87GvFO85Dgi8Yi24JCveVW02Z9lqA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHp6lnTCsjrn8sdIXeliGhLEe5kusrR1OP7H5vc0ydQ1Q&oe=6A786F6B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2HseUePdnIQ7kNvwGLs80u&_nc_oc=Adqn6J1u3IskWOUboTZsW-cAFhdgES-hu4xj3npTvF5eQnSMhrGxOsWaqPVK6zHw9xQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVo4hHzIrlhtksTXxxtjKYOL5LKEGYxJW9yp2u-Tjx5A&oe=6A787FD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
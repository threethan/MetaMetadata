i": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035405_549676184266047_2202505519363498923_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTbEcq8b0f0Q7kNvwHfYd-L&_nc_oc=AdnYjh3kaK_F-fAXduqYg1h4SnOOvdCoZmMQvdyKdx2fWefsVRmp87OUm8bZvlMvVSY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzFB57v5Me2pL2U0LjBWyppJIjyXH7KAsZe_VdWOxbFA&oe=69B6952C"}]}, "id": "3595207024120928", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "593423939973577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031588_593423943306910_8964591316500091202_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMmNqw0_YAcQ7kNvwGnOyDX&_nc_oc=Admy9p-6hvEG6UwELQJFjWoFOP2EnQbV-GlKyuk_bImylvZyslVqdxXSEyzIODG1CaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0LkF1ZlGrbae3XAXycD06QTq5f8Yj8bKXoCkiBcQdlw&oe=69B6A6BC"}, {"file_name": "6.png", "id": "8072562922846345", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982555_8072562926179678_7251335998405277014_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4_cfv_ROBwQ7kNvwFP9LPE&_nc_oc=Adm58Cdv3Igbr9fjpAriSstzkVm2gaPXQKXz-rPtUAi8Ffksrk8u32RkJlXi0ZAhSpM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxzq2QwsPhcI6QMSZP5mmxfnX-iJMI4w9ss_M3_iLjWAQ&oe=69B6BA17"}, {"file_name": "10.png", "id": "1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shnxcQB21KkQ7kNvwEarWOf&_nc_oc=Adn9rBGoeJs-d-B_OiH4Oqt-O7z0RrdSQRazsZVjYIJMpCp46frljPztZrIvLkUpYZM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxKE0VzLH9HxjzsG8qRGLahWK5tQBora3c76yccb-4lvw&oe=69B69178"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMhlEEmgpfMQ7kNvwHAK0ez&_nc_oc=Adkkl-n_HpoFrH6jfLs-N7zuuzkbmWeN44NQuXEavK2yYE7AXD1Fmkn15CKStE-Id54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4tU_u14ljK0YP8mJ9_N6Y6ENUEZwkjwK11EnwIDkUDQ&oe=69B6AB31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0pvSDD39ncQ7kNvwHhKqCK&_nc_oc=AdlE4kzQUu5elFMvJrOB1P2LEettxAwM4tzN4xbQHiF-7ALWJSZlhcEEhy-_muU8cik&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxP7PP4-28LPIz3ryrvSaEew9j7WAde1QYmgdgj2cuLAA&oe=69B69C7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bImhVUlm0UUQ7kNvwHmVduE&_nc_oc=Adk1Em2HUygRfl3JoZ6P4Xm7U4clDhZBPnfkJGmzpzrStMgdYX5h1uh56xDEv9SSpNQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDZL3FxNS_85AA-rKNoowdCIIupL2aNTTkBuxwJwlObg&oe=69B6A2EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=beBqyp8J-kUQ7kNvwFBZKbD&_nc_oc=AdkZB20wT_Ul89VB5GkjXzDFONSOTLSWP0CPZx7aHSlKXPlqrUBF6VhXj1qA4cXcOZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzf5B2dauORN_ox0ncrAUwRE8bl5-H6L6-WCng7Dm7BLg&oe=69B6B352"}, {"file_name": "1440x1440.png", "id": "1305489517467022", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031309_1305489520800355_6188094676329951606_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lgeeeh9WRygQ7kNvwE5yIp4&_nc_oc=AdkcjN9uSFQaO-w170aqLVmQlg20iLpR7kAvQ61FXu33Ls6i-Oso6t0WM4dc55t0wrU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfySZ616Og9tm6RZHoBjHrVBSD8HcN5LfNXLy2ceWW9W8g&oe=69B6A512"}, {"file_name": "Portrait.png", "id": "955521832771127", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391784_955521836104460_5660332532574867514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZ39AdjgmWYQ7kNvwEMYGYe&_nc_oc=Adkk7_Oa5gi-h
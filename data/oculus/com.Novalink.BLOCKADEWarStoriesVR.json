1769871257146153", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kVSyGZDGigQ7kNvwGAhzKi&_nc_oc=AdrNYvZ6EvOf_UQtp1-cA5ftJ1D8dUPBGUtU69YeZPLfFEPnX8CGqZw9fKgv1h3HP5k&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b-ZS8p9xkYAyZQidF-BwGAXq0KKzgtxPnDP5qxzMOwg&oe=6A106FB8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6CICGZ1xCIQ7kNvwEJG7h9&_nc_oc=AdpT7M1sXb14vqh3e0ijp8rtHOgEPxcCUWoStSNIEJGtk7ITa8UUhsk52u6qD-xrBYk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57qUH1awSJjNtwWqEB2DSoUTRB1X5cQFlHnL3wLHNeUA&oe=6A105131"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rjc7YO0GjeYQ7kNvwHR5iVf&_nc_oc=Adp9UjFy59wRo7aIJRMlS0l9UnJFie4629AQDudosLYNNcbu9rHVv4AEGxhniJk_PZg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g05uMdL8ndK1myuMUBwsGKtdbh5I93oktZiQE9jMyKA&oe=6A107ABA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt8rHGp8Ne8Q7kNvwGOo1ID&_nc_oc=Adob3FfMM1euM-UCdgWFF2bAopQ8Ja61SMd4Mux_LgWulBPBT53cGBaRY7n8wE0Voac&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oW-HgQSrHgr-QsYJStj4w_vQqpDLtnhFgpoQ_9igB8Q&oe=6A1048EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBwvH3NPu7MQ7kNvwH8bq2l&_nc_oc=AdreYPZZLWWrBx8OAFT19__U3XVmkryTsGAXEoqJyGhVJTwbE8XAh9SQ-v3a4VUrJV4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y85e061C5-gmCK7iTczfOnD9XZXXiR2gJ6uiWMlLOtA&oe=6A105952"}, {"file_name": "1440x1440.png", "id": "13054895174670
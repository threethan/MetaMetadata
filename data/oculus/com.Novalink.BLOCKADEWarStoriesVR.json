1769871257146153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmqLUnlwWLwQ7kNvwH7axqE&_nc_oc=AdrRd35Fo34u9PQsq9QU95EdodvWLtUCxGSBfJ1OOMI2KlfaL1VBd8B6-MBkcgAUAG4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMxU9LlBp3seO3JLNOWKEeuxbPBCncxPTvqJhMuiuN9A&oe=6A9C2EB8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIu76uH3cNkQ7kNvwEmAJDV&_nc_oc=Adpanz_tYnYdbJeYz2NcTh6NykiqbdaJXtJhqFxw0tPQP_--2zo8t0at1HK_Xx7uI-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_ULCW7MbYDkHak-FRsmHALpXcTyJgQlGtr9u_YTaeJQ&oe=6A9C1031"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttuvahj2lIsQ7kNvwE5fFQ_&_nc_oc=AdrOqYgdaLSWTi_hABBHeBA80XlAnVMhwn8fnwlzUfrNId7TSOUP2vKpTOqThNvlOGE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJCVkl8My2olyCZQcSWjP8EkLonjl-5pUHVWybHV-YzQ&oe=6A9C39BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bajJLtQiVIQ7kNvwF-aKWc&_nc_oc=AdrEL8vhlyFDwEyJ2kbJulO0N_LGL5GNFg0QtOaddZVOT-o6Ib4-47OPnBGtxr6w8Us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSsyngx7JiczYVZHBVd1gbujI3hYCdcQUlM19qaZD_dw&oe=6A9C402B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlJYyxUGKPMQ7kNvwHyHtud&_nc_oc=AdoH0IPJpmrAEwFHG-Qqe038w1XNflB-JVIwa7VXieoygF79K2B_7t43MIUtHugApdE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVWKwbJOihNvxOIy4hkhYf7gN0mCFOtoHU6imC3t2YCA&oe=6A9C1852"}, {"file_name": "1440x1440.png", "id": "13054895174670
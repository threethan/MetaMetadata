1769871257146153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vFTPdL_HMsQ7kNvwFQZGPB&_nc_oc=AdrUbq-COrEBIv8XIPV7xj4NLmlhF3TH6j5vmUWmX-T2PMjxRyMn6l-kH6lH1RqUQ4o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rcZhH4YZw1nYOoKlx1rhOe8dpJw0cLoaopFdg0IIpPw&oe=6A0B29B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByIMO5OFhHsQ7kNvwFhNRJS&_nc_oc=Adq--JdNr8Ct788RgYlfoJdfkCbj-tsPAkiAkpszfY2pY0iwZ-qHqVTLbtNIPxeFIDU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Y9uJYc0NOGaoPTJ-8-7NwEsFWThTSSQQPVc-udpsOcQ&oe=6A0B0B31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0Nj6nXwIAIQ7kNvwHvULN3&_nc_oc=AdoflootXRdzrI1ZAw1vg68cF9WtUDbvPq9cPmAkadaHXTkH3pQEUBAyu9Bq1ctlO2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75F5hiu9rGhOZdt6rvkzFaRrVAgXv_xXYU6RhG3U368A&oe=6A0B34BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m888SH-ihXUQ7kNvwFgIGdC&_nc_oc=AdqX2yjcXb9fQQz3Hn0zxrBebASjvAd4ExOTBp2RTaIap7Jtp6v6IuE2VGSN4O1vSQo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WWkLMmzHV0ObZTZWDL2wIGSj3YPkkgFf8REMolb-teQ&oe=6A0B02EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aw36XAhO2t4Q7kNvwGwcFNL&_nc_oc=Ado3f09LBkEt5i9yb3huAexPGwL5oDBJumzN8KmLKuaYW0oNlWTjSce4S8e4zpr1mN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gNBvdHgqQ6QpLn0YPHBKecfp06cjeOTTRdNfSXpeVVQ&oe=6A0B1352"}, {"file_name": "1440x1440.png", "id": "13054895174670
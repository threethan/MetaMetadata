1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDV8HRE4mhMQ7kNvwFVoxKT&_nc_oc=Adrb5TT6CbJGH3tc5TOas6MjhOshSlhz_FpVz2Xo3EYPGrNUADMQ9xglT6kS3CvO_HQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WgY0q6s9y2qzs0Hvutf5VWs9JByDBxCyqlYmPJcicmQ&oe=6A37FCB8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QaOD4W6FTsQ7kNvwGeFA9V&_nc_oc=AdrTdkEPE4VhybFa6PPC2Z6M78OlKBqkepSRBsmhX9n2q0wC5i-BnXbILVDm0jZY5bc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9meHike0WiVpEPgBD-tf77vUQ9eNowReHCUr-6kgFlHA&oe=6A381671"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeOVRmkejGYQ7kNvwHaOEPx&_nc_oc=Adq6BnFP-Wmrar_p48LJSsamjeUMjdTICTGWb7FZTujiYqXVUZUdDC0NLZEx-4ubojw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HKHTMxFQARFMlp0E0DXvvXr1f89N_emYvEv1BFbek8g&oe=6A3807BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BS8rHK25eJYQ7kNvwHLlswp&_nc_oc=AdpeQUwDRoI8qcgRwKVh_nRhD6DT8ZfUNcU-CMJNY_2NHviH4V7S_sbMh7GQ-xsUUPs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nBZ440SATKQQenUIaYWOkIY97LDhA3KAB2JMsuezp1w&oe=6A380E2B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBYQ9gyBrpEQ7kNvwHfEDPv&_nc_oc=AdqSKra1Hdr0b8zglYxLuw4u3GzcgYPVAiWWq8xPA_pRtTVDjbUT9Fer9pXbPCFWDs0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UeGwg_i1N0IMdm7bE7DfF_nJpdtjXxEIfOlx86qQm2g&oe=6A37E652"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajs3Hu_SnEAQ7kNvwEYPYfB&_nc_oc=AdoO_5a7RTcr8x6Tk0AVIf2IJKPfGkZJfIvCtxvgFe039Jsbg7PQYixClZ7G8_nddKg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkd3-EwaAdNjNRpPpQIZHZOWQ6lMz4ctKaTW3UCoPqYg&oe=6AE20E38"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLbctHkPf3oQ7kNvwF3hK2f&_nc_oc=AdrVfIr_QLmbJO_wsHqvQ36Inh0fYCp4K7xrdia6J9in0LNdB9m1pVsT0OmwjOsmMY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjTW0MZvVZHdAU4y-27kXUnb_9ahm_TMLpLu7wZ_ewzQ&oe=6AE1EFB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6c9ltAD3A8Q7kNvwF8U98v&_nc_oc=AdoPzOCvReq37aaxZVPXqOalsJ08KEbkCNzNPVwaDp6ShWETmotdUX1-DcQIDgPe4nI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRMGKhPHfsJWk-IgsNAg8_KxmeGc5HMzC9l3Pa3idTjw&oe=6AE2193A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwdRolMkLM8Q7kNvwGvWbsS&_nc_oc=AdrYjQ3cJnYHc8jD-hDYa0zSyXI39LKYAinQwCL2Mg08WOoq3JEwoSCwrrc15f0dRKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCPDt2p0ErLoxA2688K4wEg0MU3pdJGY1C_vXEwxgyew&oe=6AE1E76B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU5ry0h4BbYQ7kNvwFlTqUi&_nc_oc=AdqS2IhPwKG9F8XZLXw9NzpVczHlnM5k2la_Bp2wYwAwIrQWOkcrSIalejDJ42_ycTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkdyPfmhDt5BkiVj-034YHKpdFQJXcWywoU5Ha6-3YiQ&oe=6AE1F7D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
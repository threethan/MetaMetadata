1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdsSIqXd7BsQ7kNvwE9vewK&_nc_oc=AdpklGIxDQ3OTWWi3_cE81cPJqNcC_NlSJpMCtFQnqGzPq_uU3RGte4MrRfRL1H8xVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbHrwpQfpZ5_YNtABNDSzNweqhkYMIKSk26ON6vfdwAQ&oe=6AF5D4B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZQ8_YY1SPYQ7kNvwGT8sLb&_nc_oc=AdrShEAM2NbgHXEXqA8c-HTK__CLaasIpdPBdZADuUOXhNtdDv6EvzPsT3lQsXZZUAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW59Ta5zKlOn05A01yJVsn1NrDousypCeeOsvuXxArHw&oe=6AF5EE71"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqAYmppy2k4Q7kNvwGy4bM1&_nc_oc=AdoGL7Yj_BueEI34uV3DkwSzp16Iv-NhLewWuAgVfcos9lAm00qffXtveb3RA7VaVFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkjkVkxutFq4JhBBxchnKFg4HwsY_gfG4KQEmpvAq2LA&oe=6AF5DFBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9M67VfYxfq8Q7kNvwEs3kEC&_nc_oc=AdrKqMXD-95qAmgJggWIzPO3fhHVlxiO5ttf5rbt5itrr9fsB6DkXZ8brmtAI92_NfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtRX8YOeDWhGzvMDuhpfaXUspf2ycxlINPw_0Py-w22w&oe=6AF5E62B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QWDXAL6Xo8cQ7kNvwF1j9qt&_nc_oc=AdrxeQhE-VwCeL59SR75VlRlBG7c467DFZW0XxfC6dwFQ7RPU7wIL5AMbVanM9p_nQg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNIchqh9k5AiNV-j67t5Q08_bMbJEGDid3Yuk-PbQBmw&oe=6AF5F692"}, {"file_name": "1440x1440.png", "id": "13054895174670
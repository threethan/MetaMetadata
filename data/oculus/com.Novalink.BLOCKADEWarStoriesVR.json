1769871257146153", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9juFJZ_TfOYQ7kNvwHOhbu9&_nc_oc=Adqe4S2mnaHF4lo0w9VP1kWCPB4JMspkAUf1T3tde4oqP3bggGkuPkhhV-6-sC_z8iY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExeWH-VjGGBZs9CX_hfSZcdW-dlvq_9ltuhnZ5PNFtKg&oe=6A8AD2F8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BW31KlJtlqgQ7kNvwGVq34t&_nc_oc=AdpQKuzKaqAbFyXZ1Klwpoo0oHXWMGRsucQJutVS9asDIkXUVTO2iRRuEEvqoDa9EDM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwctgaT74ZYOxOBKpLvQYoOFRPCru1p8v5ElyqD-pIwQ&oe=6A8AECB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTySgIgDVpgQ7kNvwF3s4SI&_nc_oc=Adpi3ulGh-gUcWxZ4HCjT3istDVjL6IXbczdR4q675UVNhongrAIvMdLuj7uIEzY2C8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpeiIwV1prlsMaGh4kWEWH-J7Jh3adzvhlYzsueiJQQA&oe=6A8ADDFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvhC9yDWOXMQ7kNvwG3hjOr&_nc_oc=AdoD4IdV4-1eYEruMZsGkn1il6AoqjZ1zJlFmFxKBa0_JUIWMv_5xUYX0-eKlpCOhn4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrVTNMWbqgFX1BYEphDaTDzAsX5k_IiS2qYa7GyN23Mw&oe=6A8AE46B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9n4g8afIwoQ7kNvwEiDGiD&_nc_oc=Adoyj1e5_2PxjhhK8NHW3oTWjLOiJrUtGpDqOazwZe4GiJMLFcF1xrXYHWLJrrgQaKs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhZZLD2QvZsxz2aq15z_8w2Kh-xdb1HEN6ADv9rYsxLg&oe=6A8AF4D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
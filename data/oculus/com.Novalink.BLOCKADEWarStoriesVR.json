1769871257146153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0CyLQHIPfgQ7kNvwH-s4A8&_nc_oc=AdqFDaK1mcfWUsk7hN2G94FXcesnMnjL7AZmOXnUuH2aaahspQIxf96tNmepGUWELqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a1ub3iimbFA2B3ypKj0kIR5YlrKIO95t5tFJoYJ23Pg&oe=69D8D878"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KutH2HwRXFEQ7kNvwH3JJWh&_nc_oc=AdoZl06oH2YJkeD3lrLLWhnbsAMqgL-BZyKlyqwvz13cDSz7PqYDDbOfLITg9NzSV04&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ETZ7hbrcd-QzmZRZEqGm2fbCDLnU_pcYvCpgm6Vo25Q&oe=69D8F231"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpoOx8sA7LoQ7kNvwFUWkZZ&_nc_oc=AdorTgb0adCjSGF-eXeugjotjSaUcqCuVeFvWuUyIEGjFTIWjcdBZqPQfB8kT4J-_MU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FwEPQ3Qf_8HqsiLOUD44JxX3errFPryZCRB-H5KGAZA&oe=69D8E37A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUnIKqBJC-oQ7kNvwHEIxb_&_nc_oc=AdqHd2-Wj5CIclF7n-phQszaTSkJfBkg3jXHPbBqt432UmUIGzPVWZ5TeAYL3JKW5U0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0td2AmTKFs1G6EiUZusCYenk36mWTQV1CA088bw9mfLw&oe=69D8E9EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4m7VhjgbQMQ7kNvwEIBQNL&_nc_oc=AdptSWKBfjYQ52_VlKa2BUI9qlerJKuEHaVivVc35DlnX97NNdMSWyARS0I1YUPfuD4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02AewhAJiwn4DrJiH3HwFEiiN-xwHfvgf2bCFIjA2Iog&oe=69D8FA52"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6wbmHXwWXIQ7kNvwHmkso4&_nc_oc=Ado_DGgPAIMvjveQblhvyvglbVSWoR0ynjasMqrZ5KM1LveWUrUbfBn6nQ0SJ4XUGvM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG_2AXifHSltTvWPzZE6ghe-zaQNkUy73WED1kzg7ZYQ&oe=6AA174B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RY4-OXqbg3wQ7kNvwHODDuM&_nc_oc=AdpzL4Gc55M98Vl1dOX-FQZO8hxs_HyQ7vJGcd4sKwoWNMPXyIggHPlEXTA9ywC914c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2kgCfDAmRmhoqsxTPyT8benkS-Uejx3rRt4NcAz8rAA&oe=6AA15631"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpn5YyF-F_YQ7kNvwH9dcHm&_nc_oc=Adr_aYUeZQEL9HcUjW3eDkGVaqDeX0lJWRSFFWJpvo-puwkt-pVTFtVRVzO55vI8BVg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpSJNAG7qa7JgMXRmwvQZeCnD2XHxNUiSaD72Yp1_VEA&oe=6AA17FBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeHcyCQU440Q7kNvwECl3re&_nc_oc=AdoAAdFwHs8iN_I4M5FdpicRRrtmfFcAl4WUjsnLp3vrfzBqCf43JEdfE8_7gMiOWPs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzCBpNqlHZAIstfoWSd-7Op-gzENd_kdYH6zjcr4vksA&oe=6AA14DEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyGX8DvUf1cQ7kNvwG-d7Uh&_nc_oc=AdqybIyeeSpOCSGQNY9Hd0mzlid3wVjrvABlpvVTTcb16zsgvRGQkqG0G9nhjfXoNyk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzzqUnkkZv247fPgbW61WQ1vrkJZwIVzSSQtvWsT78zw&oe=6AA15E52"}, {"file_name": "1440x1440.png", "id": "13054895174670
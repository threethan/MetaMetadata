1769871257146153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZZ_Ux-f9D8Q7kNvwH2APHo&_nc_oc=Ado5mvXU8Ff6uw18MLMWbfUXEJXl-x5xJUU3Yvgrg2leXpIApIw8lZ19dSEdsyh5uig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjsuFMqfQh6cAjxUOjIQnCLuKbelki3j5SsLOlF3i3ZA&oe=6AF08EB8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjyYX73BfeYQ7kNvwFXXiEG&_nc_oc=AdpA15LTG--sbyM9GbDNNCe4JAxd95QGZ9mGpgQo6rIypcwdr1xOnMGeta4xooqYMvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmVWtGGB1-XmeuusY_Z8zbsuuiv8_5nZgrbhp1lN20EA&oe=6AF0A871"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMz1SpywZhIQ7kNvwFMV740&_nc_oc=AdoLMor2KH9eENgFaOBlbL3Vjh1vGI3tFmL4Bxv0ELFT9kA77I-O-ZrTSxZNFgV-hE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBMn5uxf7IgQH2tJh6N5fTRRp8mMe8nw3zvdP0l-Re7w&oe=6AF099BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rU7iHEUoShwQ7kNvwHYnfPq&_nc_oc=Ado11_s_qpnOwDDyCUdMprqBvHWtb_t89AGHZAZP8TeAZSmod8796UQO1b9aXogsE3I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRY8hzR6OOkbqIeb-rJXABHWFPVvp5qd3jjVZElcd2Cw&oe=6AF0A02B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLN13bGAcBsQ7kNvwFZ66z0&_nc_oc=Adr3cU0CSQmDLgBO3dbTxJEFRtv4rAOmXRYolsyFdRqXUsA19k1t87E8FYo3Uj-UdaQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJpWTGInf7B33I6BcZTo9xRC1d4JxdhrzF40W_u_KFaQ&oe=6AF0B092"}, {"file_name": "1440x1440.png", "id": "13054895174670
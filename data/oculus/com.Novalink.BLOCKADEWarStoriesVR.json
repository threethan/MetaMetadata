1769871257146153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwA11j1XQ7UQ7kNvwHNrVN4&_nc_oc=AdrtKDktSbK1xDKnF7tni_-1GHtJugcoQvX2rWAxnoZGgVMhKXYh6l9OinepMrieyY4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4tkjiqQzDBRoteop6tVwNfg70bphJzjtwHYZzzh4MDA&oe=6A564F38"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdL2Sxy9bzsQ7kNvwFFCFJE&_nc_oc=Adow8AUIztNajFB85BMWLSMdfzOq5Vk_o53NicPdbqkyB_u67KiwGgVH0MaKKNcZsK0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfdgnXyHa51O3v3lv8TjvdlauFiJNri7q5bph5s0Ijvw&oe=6A5630B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJAVZQEmscsQ7kNvwFMq4_J&_nc_oc=Adohyr6WcctdTqoRYAk9NMwWMM0R6M0F1bjMcu7aohMruibefu-noHgx-WjJz_6DbPs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTT8H3U9VTO28fOQDWh_nUn9IXW1tjeQUiZ4SXc6uwHw&oe=6A565A3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xaH1eS02CcQ7kNvwHRrl4L&_nc_oc=Adoqejx-9HT13ld00-3jM-CwjRgEznNVjFfRzsK6Lx68vbaarNC_qWyOAB27q8NefFo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV5BFPcQtg0eWcy0nF8bv3JfQjpuiM9hz85vIN__Tq_w&oe=6A56286B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olpbjugWmTgQ7kNvwESKjIb&_nc_oc=AdoWfAM8XxnziCNLtPsVvv5VT5xLV_UWF0YE_XOjMfpXvnqEl_KN65F8fr3Ge65pvqY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMViZyaphPauGCndyW1cahgu5zCyvVieaaHRzZ64kaKg&oe=6A5638D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
HqvQ36Inh0fYCp4K7xrdia6J9in0LNdB9m1pVsT0OmwjOsmMY0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjTW0MZvVZHdAU4y-27kXUnb_9ahm_TMLpLu7wZ_ewzQ&oe=6AE1EFB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6c9ltAD3A8Q7kNvwF8U98v&_nc_oc=AdoPzOCvReq37aaxZVPXqOalsJ08KEbkCNzNPVwaDp6ShWETmotdUX1-DcQIDgPe4nI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRMGKhPHfsJWk-IgsNAg8_KxmeGc5HMzC9l3Pa3idTjw&oe=6AE2193A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwdRolMkLM8Q7kNvwGvWbsS&_nc_oc=AdrYjQ3cJnYHc8jD-hDYa0zSyXI39LKYAinQwCL2Mg08WOoq3JEwoSCwrrc15f0dRKs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCPDt2p0ErLoxA2688K4wEg0MU3pdJGY1C_vXEwxgyew&oe=6AE1E76B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU5ry0h4BbYQ7kNvwFlTqUi&_nc_oc=AdqS2IhPwKG9F8XZLXw9NzpVczHlnM5k2la_Bp2wYwAwIrQWOkcrSIalejDJ42_ycTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkdyPfmhDt5BkiVj-034YHKpdFQJXcWywoU5Ha6-3YiQ&oe=6AE1F7D2"}, {"file_name": "1440x1440.png", "id": "1305489517467022", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031309_1305489520800355_6188094676329951606_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNrc2DYFKrkQ7kNvwHKGwTQ&_nc_oc=AdrnZObf8QeKANEo0CUc7BK4I4hkjh-BEivqhE_cwrwJwVtJ0sgICkP7wspfEy28ijA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEffIbf3BYRXRLo7EZNdvSqaB8CyELd9E5PeV5o-05DA&oe=6AE1E992"}, {"file_name": "Portrait.png", "id": "955521832771127", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391784_955521836104460_5660332532574867514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyKVCwM888wQ7kNvwGjFm0m&_nc_oc=AdoZ-SRHHFQrz_yn44EgR-svA_r26jnylNbPZ_QQefFUYHYszOhyNonZLaF6VqlPfE4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6gohsdf5LruiXiMmSQHMwFoHdkP7-bVxAkCwmNZ_5Nw&oe=6AE21228"}, {"file_name": "3000x900.png", "id": "898393559077372", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982659_898393562410705_5315441764167834469_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRi6KIWYYpcQ7kNvwFEeEpU&_nc_oc=Ado6UWsyF-B2K6JJqaDX1LA9phlqrQRubzDEE7h-oIX5zT3oJtAttypvGldUqmreWtI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF8SGBo8hvtxfIbn46-77mLNUNzAuxpvjrqDf38ptcEA&oe=6AE21F34"}, {"file_name": "Landscape1.png", "id": "633032509380503", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391840_633032512713836_343039261589071567_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuj8Bia8xMMQ7kNvwFS9nCT&_nc_oc=AdonvUKFNjiyORRxdmaOj0v8x46k76AnLBFXZarinqjq3WbvXI5xvHYUp4Y4Aiue2ao&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO39YsAbadm8rlu80Tz_2sKhXGi8A1IJUippRTC-6OSjA&oe=6AE204F5"}]}, "id": "1471943347587557", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "587770023886207", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393328_587770027219540_2804295002891070284_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5Xzvpriro8Q7kNvwHatMYH&_nc_oc=Ado3IdQeiN5IeSgXZ1JKAivIX-IuIamEM5P61zGZFPRtpGxBNJz6OqBu5U06pMfG9h0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOr-uLQGS3nAyMqy6r6YRmba2ohDnU83rd0dfY-GFsL9w&oe=6AE1F00A"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "\u0431\u043b\u043e\u043a\u0430\u0434\u0430", "\u0448\u0443\u0442\u0435\u0440", "\u044d\u043a\u0448\u043d", "\u043e\u0440\u0443\u0436\u0438\u0435"], "long_description": "\u041e\u0449\u0443\u0442\u0438\u0442\u0435 \u0432\u043e\u0439\u043d\u0443 \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443 \u0432 **BLOCKADE War Stories .VR**. \u042d\u0442\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0439 \u0438\u0433\u0440\u044b \u043e \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0412\u043e\u0439\u043d\u0435 \u0441 \u043f\u043e\u043b\u043d\u044b\u043c \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c.\n\n\u041f\u0440\u043e\u0436\u0438\u0432\u0438\u0442\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439:\n\n- \u041e\u0431\u043e\u0440\u043e\u043d\u0430 \u041c\u043e\u0441\u043a\u0432\u044b \u2014 \u0432\u0441\u0442\u0430\u043d\u044c\u0442\u0435 \u0432 \u0440\u044f\u0434\u044b \u041a\u0440\u0430\u0441\u043d\u043e\u0439 \u0410\u0440\u043c\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u0441\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u0440\u043e\u0434\u043d\u043e\u0439 \u0433\u043e\u0440\u043e\u0434.\n- \u0420\u0443\u0438\u043d\u044b \u0421\u0442\u0430\u043b\u0438\u043d\u0433\u0440\u0430\u0434\u0430 \u2014 \u043f\u0440\u043e\u0431\u0438\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u043f\u043e \u043a\u0430\u0442\u0430\u043a\u043e\u043c\u0431\u0430\u043c \u043f\u043e\u0434 \u043f\u0440\u0438\u0446\u0435\u043b\u0430\u043c\u0438 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0445 \u0441\u043d\u0430\u0439\u043f\u0435\u0440\u043e\u0432.\n- \u0414\u0438\u0432\u0435\u0440\u0441\u0438\u044f \u0432 \u0442\u044b\u043b\u0443 \u0432\u0440\u0430\u0433\u0430 \u2014 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u0439\u0442\u0435 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0432 \u043d\u043e\u0447\u043d\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.\n- \u0428\u0442\u0443\u0440\u043c \u0411\u0435\u0440\u043b\u0438\u043d\u0430 \u2014 \u043f\u0440\u043e\u043b\u043e\u0436\u0438\u0442\u0435 \u043f\u0443\u0442\u044c \u043a \u043f\u043e\u0431\u0435\u0434\u0435 \u0432 \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0431\u0438\u0442\u0432\u0435 \u0432\u043e\u0439\u043d\u044b.\n\n\u041f\u043e\u0433\u0440\u0443\u0437\u0438\u0442\u0435\u0441\u044c \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443 \u0432\u043e\u0439\u043d\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u043e\u043c\u0443 VR-\u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044e, \u0433\u0434\u0435 \u0432\u0430\u043c \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u0438\u0442 \u0441\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u043b\u0438\u0446\u043e\u043c \u043a \u043b\u0438\u0446\u0443 \u0441 \u0432\u0440\u0430\u0433\u0430\u043c\u0438, \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0442\u044c \u043e\u043f\u0430\u0441\u043d\u044b\u0435 \u043c\u0430\u043d\u0435\u0432\u0440\u044b \u0438 \u0432\u044b\u0436\u0438\u0432\u0430\u0442\u044c \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445, \u0433\u0434\u0435 \u043a\u0430\u0436\u0434\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u0438\u0442\u044c \u0436\u0438\u0437\u043d\u0438.\n\n\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 VR-\u0432\u0435\u0440\u0441\u0438\u0438:\n\n- \u041f\u043e\u043b\u043d\u043e\u0435 \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e Oculus Quest.\n- \u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0442\u0438\u043b\u0438\u0441\u0442\u0438\u043a\u0430 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f.\n- \u0420\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u0430\u044f \u0431\u043e\u0435\u0432\u043a\u0430 \u0441 \u043e\u0440\u0443\u0436\u0438\u0435\u043c \u0432\u0440\u0435\u043c\u0435\u043d \u0432\u043e\u0439\u043d\u044b.\n- \u0417\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0430\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0438 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0438, \u0432\u043e\u0441\u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n- \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043d\u0430\u0434 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0435\u0439.\n\n\u0418\u0441\u043f\u044b\u0442\u0430\u0439\u0442\u0435 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u044d\u043c\u043e\u0446\u0438\u0438 \u0433\u0435\u0440\u043e\u0438\u0437\u043c\u0430 \u0438 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0439 \u0432\u043e\u0439\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u0442\u0430\u043b\u0438 \u0431\u043b\u0438\u0436\u0435, \u0447\u0435\u043c \u043a\u043e\u0433\u0434\u0430-\u043b\u0438\u0431\u043e.", "short_description": "BLOCKADE War Stories .VR \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442 \u0432\u0430\u0441 \u0432 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435 \u043c\u043e\u043c\u0435\u043d\u0442\u044b \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u
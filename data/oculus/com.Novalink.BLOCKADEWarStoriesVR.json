1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh_tYjpXUQAQ7kNvwEQmOAx&_nc_oc=AdpiCJCfRhr3IRTHkZN8p9TV9QgRdn9ELcyEdRYBiFbmdQdD2ffMd5WicreIbibwUAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ0QMJpNOspc3Gn1KN0OydMge8aah7chADxBvBVwVZoQ&oe=6A7C5278"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUAIvQwa6AMQ7kNvwEYkKsE&_nc_oc=AdovCARw14Ys6KnnaMvM326kiEaTclR62is1XKmS2xfSmDZUz_kpedNKAMwMx18dXf0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJC0Rf1n096-TNRZ77bewCVUxsXFg8hk-H2g6bgtsguQ&oe=6A7C6C31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFL_qUpR0iYQ7kNvwGgiFMq&_nc_oc=Adqhix8ut3XnFXPA5XVI5F9fpyKfkTnKjoK7ZfbAraRc4myWp8uHStRo3YgvlijksiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrFsQ39bRpEhu_c2rdYMClDEZibriUaM2MmYlkniV2ng&oe=6A7C5D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=occleWrSiDEQ7kNvwExg8VE&_nc_oc=AdpQeT4LczwUtc3Z7cEV90AMT8HJCFRGAaJgDgifxKxU_8QD31xg5Z2RbmnctnIfkiU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsDvBVG8-Wy-euGj9w7lxvZH1pguNmtWqVqbIvwI0UQg&oe=6A7C63EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBOLOrO1eQcQ7kNvwEpnq42&_nc_oc=Adoi10zKcnu5xRlZn3COaLNvNc1hb2ntztV8cNqqxiB1iDycXYpo-V6sSHLBFlWUQ-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy6TWI76B5627lhLyay2EZLoPtMmf4JKTZwbx50VH09A&oe=6A7C7452"}, {"file_name": "1440x1440.png", "id": "13054895174670
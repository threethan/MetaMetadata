1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMkl2q-f2noQ7kNvwF2bWRD&_nc_oc=Adr5Lo5rMh6vImU7B0q03bXxrASE2DzafittafGSDee6xcnaQJSiaIaPp2Je3ddvsbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEMtUaxDdXkji_I7uw_BU8rvc4gzBZMr5ZVZ5l0PZDPQ&oe=6A4FB7B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GXgfD1ftQEQ7kNvwHEFsa-&_nc_oc=AdrTO7icHBLWMeT6oQGA91WvdUhBfm35CYy1nwqjl4HJiWGhGRn-G1lMYbOPlhFEpPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkNT7mWC9d0dBHIALrNbaxz3RgVNql0ZcDjJg8nUZ7RA&oe=6A4F9931"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDqNgyYfM_gQ7kNvwFyzHZt&_nc_oc=AdqdJznQ8D3u2oO94I-cdOcW_Q5hVqtvnULHfVP3z1iOZcRloTWczjvzUU1nKxQ6vl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb2LP3gNFKtKd8h0a2pes9JMEjbe0pJn9rvbTWYfQPUA&oe=6A4FC2BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONiOhXNPK4UQ7kNvwGmDvEF&_nc_oc=Adp3tqhYMwYOa9uD4JvP2z7U5vL3mkq9wEL4AwhMPuVSFPnxqonOVmZe9HSLLTErKMo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGD0493cQjQUa4gKT7tknwf_qoRWcZ44gS6Tdst-BY3Q&oe=6A4F90EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC7AYk_WdqUQ7kNvwGI4PK-&_nc_oc=Adrf16hj9-qd1xCFwZHk7DXTmg2mEmBP5uYdAp-JU2El3r9TniHunI0DIZMeHVaJvRA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0XtpK1boRQydwXrvUY87i63KM81hFD3IiP_qsYcTVEA&oe=6A4FA152"}, {"file_name": "1440x1440.png", "id": "13054895174670
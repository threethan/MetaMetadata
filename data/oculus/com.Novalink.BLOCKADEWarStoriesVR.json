HkEuRxA&oe=69A41C78"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJ7OKCnSFTYQ7kNvwF3mVhn&_nc_oc=Adl_IoqwxNCiLayLg1Gn8tYvQz9urYX_NWrGpBWPzSArhZ4TXZ4o2oetnX-YW4i6HVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftRX_1Ky5YqfgQ78RPtFaJIg42gCMlBC6RiAV5WIPQz1g&oe=69A43631"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqbbUqNYjKkQ7kNvwEw6vXa&_nc_oc=AdlSMCQro2RWLdBu6Ts4rRLw6SHUk51Ekbt-efVG8eaoh6pxW2rPAl_Dyc2HtXKMLQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuQ76Il27zSwb8_kQMbXKtVMPnWaD_Y-cGrkkleoDpJpw&oe=69A4277A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoW5KATpwhIQ7kNvwFN8OC8&_nc_oc=Adk0ETKs31_Pmg7FCmLnKH4LdB2oWx0Hf8YJvTatHZvOUInqeOtt5XnkdrjNPB-3TGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft2M3vVR937kusGoIxHszbHmWubZX9MCQ0jnbEIVeTsnA&oe=69A42DEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDbAbHBG3wIQ7kNvwGBnl3N&_nc_oc=AdmVTnP-I-eLf23gvIRXiyS3uovQhUar4gxOfpbTU705wKghl1fTxcK_VRub-_oTm_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftfH5eQsCMgtPs2Euk-It4-a3JvfdqIYbCWn_9G1R1Eww&oe=69A43E52"}, {"file_name": "1440x1440.png", "id": "1305489517467022", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031309_1305489520800355_6188094676329951606_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce-0JzKf15IQ7kNvwFngpXw&_nc_oc=AdlsJG7nWOO7NhNUl5on9gOXGEKJDAuJgy91IUvABX2kgaADgDao0yujKAT0HhumpRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftX2rGoHi5_cF7AEWAQSh5IgobEW-LRr1famYMcbwlWyg&oe=69A43012"}, {"file_name": "Por
1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MobTeBWtA_4Q7kNvwE2W1g0&_nc_oc=AdoA8M_LRClWbPmmNIW_UmFDQyH6SvlHk0C24aH3JGW1JAU8G-orFN1-50uXVU8wFZA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Kp-0I_wSDMjKx8TZ57qBLG1T-OCOcK_omcbdSA_Eh7w&oe=6A049238"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvZXm0ygJIwQ7kNvwEo9he2&_nc_oc=AdopNZVTsYQbJHgVqUjK8r6fVzEqUvxIRGjwWdmJzSDycKXUPQawyiPflXTRqXOjWQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OTyzhD2C-Ci6-GhaKKNX07sOYMe-8DxPJ6K02agGTJw&oe=6A0473B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffoC5bxZ4W8Q7kNvwE1FhJn&_nc_oc=AdpQRwyEjtDsUPOjHqbDXa-e4TD3NhJfE8cpJ8JCejWlD_G5S9dLtT3QJhgcD7WaLrI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QpaJMOvXWYuvzO_ivwkV4eke2Jda8oTHDVEiL7sLi3A&oe=6A0464FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqWnyf1sOwEQ7kNvwGUCVlG&_nc_oc=AdppTRXgFqjVTbgidPmYLe4lyu-4gIWwirW4S-frGAkWbd1oLhA5WIfGmShvd5GvNYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lCGGbmLsNluSXcU9Yo1bp2q1aQcKDa84EKOAyOQlR2A&oe=6A046B6B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3q_T_WAWkwQ7kNvwGYzt7b&_nc_oc=Adrzpa7hTkcSLBrT64fyYbEuSvbdgNVhqA_KpV_JcAkoB5jeAMMRv9McK6W31jDuze8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5g69qj2nmaFa49pW94A2C3saikKZAbsgf3WIa2pDudlg&oe=6A047BD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
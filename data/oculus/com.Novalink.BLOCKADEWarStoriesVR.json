1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ma-jdKh4H2wQ7kNvwGcTmX2&_nc_oc=AdpWjvEbNONfjL4aG46WWWQHWOG6D0CkGkzImGHW9pKUUFhrPF1q8pmL9C8GWbZERlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuEfSSG1kyVnIczmhn8aJLKqeHZdxnU38Xk9g5RZxw5Q&oe=6ADE19B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6PueplEfQAQ7kNvwFlQ6i0&_nc_oc=AdoEeFzFbbD9ddY4fWmDfogzQigpoUezK7ESxJh_Ggr1NaiWrVbHoYy3FlmcE1vPYEk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIYP-wpwaXEcKIPITNCnvjDs86ghPVm6Sae1J0uNlx-A&oe=6ADDFB31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjPVMXGkXzQQ7kNvwH1GtTX&_nc_oc=AdqyB3ypsMXPZKaKaRCann9DO583Ivbj_urhA_Z6TEr99rHTLO-r85PRDqFnGDqBOj0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqP9q5ihCIjDugBUThBpZ8gSdBBg18PxLhAdHyucW9qg&oe=6ADE24BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zN8c1M77k-kQ7kNvwFXrdXB&_nc_oc=AdryXRb1D-m6Up--_kjuVSZlvYigk9XiaATzXYt5V7ElBgYcaXWWYA5fVA73AFoSu58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2GIGetvVgdo6svqXIBGR-UVV1arInYI-QSWk9ypjRJg&oe=6ADDF2EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_DJ_i79yPgQ7kNvwFXiANe&_nc_oc=Adqxt_4Xp4BrxUGdm-mG1LHR3yEv5s3ti5kt_AA-i8zQB51WahhLsuIUaffJcYuNcHM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOexkb2AsmfyvzUJTeDQDvfQYEwNVn4Qko8US0ESLvdIQ&oe=6ADE0352"}, {"file_name": "1440x1440.png", "id": "13054895174670
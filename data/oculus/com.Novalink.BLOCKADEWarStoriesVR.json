1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4bXzzNN0X4Q7kNvwGK_zG3&_nc_oc=AdpKD0n2KH_Ysij_R-28czrpE834AzThKx3ZzvqeAUXGp73PEsLLuKviQ1cn28usRys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2M_JMvmfKg4AUVR2xujqDMsw-Sju6XDfR6Se9pkKVTw&oe=6A74A1B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2A8hlQUvloQ7kNvwHKE-jd&_nc_oc=AdoOX9w8rf0WikhcPdeo56aJmNnIXgQ1nDJR67yDAF7PlpZpe_GN0Lg28oFeSW4BbjE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnhGnEai58-rvnNEvPY3-7S9FGH9kH5Z9do-BqcsP_SA&oe=6A748331"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3psYqhXpVB4Q7kNvwHfitAc&_nc_oc=Adqh7gdFpa6L0Jfhbk-GhrH9xUA1-T6edDRMsOE1Urww3ueYsK5TRvbos1A6TH31Bd0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxDi0P1v0ZzJ6SHH-yez1rXigumlDsP7cSYZpXrN4dqw&oe=6A74747A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUt3y5MY1SUQ7kNvwFCy2BV&_nc_oc=Adrom_1_q-PHzY9IgZ32hpQNcsEhrnhuRkczX5p1z6jsCAjpHFRUvIQtEifvPMlWwN0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLqA0hDoZ9RqJu71EJStDp5FP190syNGdlUowc-HWzGQ&oe=6A747AEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InGEM9nIdvMQ7kNvwHUv3IF&_nc_oc=AdqxrlnFxHRKOZ2yQnJqupfS7v7diAkycFLCRcyB6LyItZU4NFGLJsJL-eSpNvfedvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH33UBss5_zZmYbNEJNJ_DwEaB7sf4l25G52jNzHC_-bQ&oe=6A748B52"}, {"file_name": "1440x1440.png", "id": "13054895174670
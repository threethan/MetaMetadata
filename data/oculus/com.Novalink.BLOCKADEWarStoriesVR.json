1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFRhk-CJ_BAQ7kNvwFTqpfF&_nc_oc=Adp1rGehwp5C_zSCS2REAsXR3lKI6sFz1cuGmY9TrcABz_6lU1Tj3CUe4gVkBk-d7og&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FzNWEzdKprAczmO_M4kLdE2Jattz_Q3GgdZvYKDlhwA&oe=6A282AB8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk1BdXiavaEQ7kNvwF1A2WA&_nc_oc=AdrtkwaqT8_m9IY6QKy_O9f9UvRyNv1PjL1CfszOlc3OUpILJYXlr3dvv4bBRXayXyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NGfFIGEeUZLxAEwdv8M0Is5Hg6tgozo-gNfcbMzX2Vg&oe=6A280C31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTRAuT1X3y8Q7kNvwHbHPas&_nc_oc=Adp47qvx1aaKMLtbSkRByoIAoYm0WkbSJ0bU4Ot9Nvdx-JAVPKBY_uukqxtNJS6lg2s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0THD3eG_e8nhkWpc_UssO321sFa005qLBuZDLsJGPrA&oe=6A2835BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9rsKcSrcjAQ7kNvwHRlpE3&_nc_oc=Adr4xXex19R7aYm7eMTLYBRGpNHP9bUExIEYm9B1Q3o1dl5dnkxQy942Vpa-N7xf7CQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mLBTbdqrsvz3Lgmn9k9KwJh0_8OFYvJZsxIFXBGt9lA&oe=6A283C2B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SjtbsB81u8Q7kNvwHYmyww&_nc_oc=AdouQ6s9NOL9TNSgAs1I3xcfGDLOTSmk53W9iVB0TOfinXLQl629BFNl_Q1jRbLeTBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7Fj1hdb2C03BmyxPgL1FQKwC-iVUJu0-hQbdHD-xSAg&oe=6A281452"}, {"file_name": "1440x1440.png", "id": "13054895174670
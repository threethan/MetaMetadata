ER_xcumqmJBK-Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxfmFlUdKRJCC5rRakXTVT1iHYrSfnm0VZGReCMk5xcWg&oe=69BE9431"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-3JRch0FckQ7kNvwG0t1kf&_nc_oc=AdnEqInnFUxRuifKGKIyHBZFA2hA4XKVxnW-mRYQCEDi0iPaVdKxl_wmQEwNT9wK7Fo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6xamBvim9ROOEcD19jBbWd-137feOEq5DKcJ5QS3A6A&oe=69BE857A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DiuqikFz2MQ7kNvwGf1aFQ&_nc_oc=Adk96Tq6HFvRJSmL-oXtQHvebj6UH4WPtSbgqE2DjhU0OBypkLWhleIzQ5UUspJgWJ8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFltF0e5CUJhlegwwWybKs_dq5eaujACu_cETLEFxKmw&oe=69BE8BEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpP51oUqTaEQ7kNvwEMOTVe&_nc_oc=AdlkgCQUVn1gjbS1JDfkHINNci1Vl03soKrxXKbGDQ8GwqmFLkaBxiDj3MW4H_KCE_g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwt9_Ot118lgPincWiv_pB9dWio5FhwOlTZNLXQkhiPsA&oe=69BE9C52"}, {"file_name": "1440x1440.png", "id": "1305489517467022", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031309_1305489520800355_6188094676329951606_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L8wTrasbwgQ7kNvwE7h4ir&_nc_oc=AdkseupBrwrlCxdozMXKbGhPztPZ6s_n0fGtRC87YRcs_FE6AXpiIjniWD4RkO67IEY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyqjmm7ki6l6Lr2nu8cx7ie4WbUvZdK4jxCOLmUuuVuMA&oe=69BE8E12"}, {"file_name": "Portrait.png", "id": "955521832771127", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391784_955521836104460_5660332532574867514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWfhSHCdzRQQ7kNvwEO4sD2&_nc_oc=Adkm37couABls
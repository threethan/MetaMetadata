1769871257146153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd-f22twNpYQ7kNvwFJPtU6&_nc_oc=AdoQ2oW5TonMhJgzXNiF0QkoNaT9tiPa8yAldxZTKl4K7vI_dqYoZ0wJFl8oEHP3eSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMexAZ60JH18fGGie1MP0-CdgfqMuyJGDtvJD9ddxORQ&oe=6AB92FB8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0DYQ15IC3wQ7kNvwFyXPq2&_nc_oc=AdrIP0j2APvooOrvrpAR7V_fGAvANQbl0wDY2v3A_y9Mxsw0Lu54GBpS0y2kJDcib1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCnDAJBos_0U2rNANQ-k7S0Y5rpWQ3zDViaPv8WIdGcg&oe=6AB91131"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxbPt_3nqsYQ7kNvwFTBT4_&_nc_oc=AdpgHo2CdF7BhhP4p0Oo2dK3HmpRgGvXkkIj4OBDNF3ecTdaXHJD_qNbexmwU9-9qmA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ50ZZUERcFHZm3SjcjgtBUFK9aNEDVo7ojNWpUJp5UQ&oe=6AB93ABA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ncrVmFGERwUQ7kNvwFlz2-e&_nc_oc=AdrCyM0AyA2N2wiMi2ADd69WRO17yQM6fEGx_VwyozXsm2u9At3MZ3kuZEl7iulhpy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKbCLwrddq8uPjFUV8oCPbVNX-TlBlcr6bNjcmMysc1g&oe=6AB908EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVqY3tTocrcQ7kNvwHx5Mph&_nc_oc=AdpWXfv9dGe2LcVTyhN1m0OaILEmX5BLfQBU1iedtW9lDTyPjJhWSLb1bLv9uOMgtPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyELWzIkt8HukYGvezkh-P2vezSn18fjdFXUAQ9vqCoQ&oe=6AB91952"}, {"file_name": "1440x1440.png", "id": "13054895174670
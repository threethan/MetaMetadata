4cU9blAoamJtjexDF2jj23Gt64uYynpQ&oe=69A6D931"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H4CrffuIjEQ7kNvwFBuklf&_nc_oc=AdnNS9CwW3iH1cL2w9jo0E4Taa7IooFeDNJ5TNxAp9rxN2l4WmjpeK3vznF_6lv_j7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsN2rgH21_0otuWf2xbpYwj2I0I_sgyv26-QS6Akwi4gw&oe=69A6CA7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7lupWVxvwEQ7kNvwGsHvD_&_nc_oc=Adn8Dqpn9NZi5vfuSRtLo2IGOP9j_KudSqNBfTMNS3q-OoebhLv5HnlE2Hwzt5bMKwE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvV3I5aZf_vWEA1wt5Nj7GMuYDrjh__oqAE4Lp4eGQnJw&oe=69A6D0EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmACi3bULs4Q7kNvwGxtCkQ&_nc_oc=Adn0iiFdpmG9KxIUo6XQcsE_yndBjvDA1ZW1V_9d0USZQ49FoBmbuOTEWfcmFsKQFfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft72L8PFJuhYnfZLWKZtIIVf9nK1vnKjilGPS-YibD84w&oe=69A6E152"}, {"file_name": "1440x1440.png", "id": "1305489517467022", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031309_1305489520800355_6188094676329951606_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLCXk7piMx8Q7kNvwGtrnt7&_nc_oc=Adn09TcMZmgN8CIaOwsF1euqWSaCW8upJXaaoWwavucgA0ppRrhExTZ-Ufin85v4oQg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afvs15jg-a4oR-65RjCX3qt_ruS_6TBXV6kbyiaOuzihgQ&oe=69A6D312"}, {"file_name": "Portrait.png", "id": "955521832771127", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391784_955521836104460_5660332532574867514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7Cg4j2LkvQQ7kNvwFBn_6K&_nc_oc=Adma3Ztc6R4H-SdfgPnr13E_OZpZI-kEpmVwhu5Jx5j-M3Nc_cD_N-lKJrDFANp4Efw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-eMppwFqQBNPIeWANLLBzHUlUDWhizxaFDkLC6JOoWQ&oe=69A6C368"}, {"file_name": "3000x900.png", "id": "898393559077372", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982659_898393562410705_5315441764167834469_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFJCyeoMdvoQ7kNvwGGcmHI&_nc_oc=AdnXYcYZUrsi7wMrasi6SQOm9BaJ54_RW0av6IYF0eAlP4SeDtw4ryQlQiOsD_WIq9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvkVgIYJhydAKYo58TXVUToM0MSnC4ViNo9lzwDMhgcig&oe=69A6D074"}, {"file_name": "Landscape1.png", "id": "633032509380503", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391840_633032512713836_343039261589071567_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFBw4Xsvxn0Q7kNvwEADtdj&_nc_oc=Adnv_YcmRgxb59hGNNBApCLXkArkpvupkYUzjdQTddYmQpUIGMMS4tVfZUQ8z-_tZrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuVtGI1NdwVFBN3fJQzZ00DgQj4DJ66JNNtFQPei-mpqg&oe=69A6EE75"}]}, "id": "1471943347587557", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "587770023886207", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393328_587770027219540_2804295002891070284_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuyM9pyehHYQ7kNvwH0o-yk&_nc_oc=AdkeevMicN3hL9TWoPhP_pJmDpa6shyzC1ywYwi3xfMA8hCYmBp4H4zbobpQW7tIXFs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftE2560tzyeteBdkLqSsIChf1C0fitdE0MEhuODd8rC_Q&oe=69A6D98A"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "\u0431\u043b\u043e\u043a\u0430\u0434\u0430", "\u0448\u0443\u0442\u0435\u0440", "\u044d\u043a\u0448\u043d", "\u043e\u0440\u0443\u0436\u0438\u0435"], "long_description": "\u041e\u0449\u0443\u0442\u0438\u0442\u0435 \u0432\u043e\u0439\u043d\u0443 \u043f\u043e-\u043d\u043e\u0432\u043e\u043c\u0443 \u0432 **BLOCKADE War Stories .VR**. \u042d\u0442\u043e \u043e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0432\u0435\u0440\u0441\u0438\u044f \u0437\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0435\u0439 \u0438\u0433\u0440\u044b \u043e \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0412\u043e\u0439\u043d\u0435 \u0441 \u043f\u043e\u043b\u043d\u044b\u043c \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c \u0432 \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c.\n\n\u041f\u0440\u043e\u0436\u0438\u0432\u0438\u0442\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u044b\u0445 \u0438\u0441\u0442\u043e\u0440\u0438\u0439:\n\n- \u041e\u0431\u043e\u0440\u043e\u043d\u0430 \u041c\u043e\u0441\u043a\u0432\u044b \u2014 \u0432\u0441\u0442\u0430\u043d\u044c\u0442\u0435 \u0432 \u0440\u044f\u0434\u044b \u041a\u0440\u0430\u0441\u043d\u043e\u0439 \u0410\u0440\u043c\u0438\u0438, \u0447\u0442\u043e\u0431\u044b \u0441\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u0437\u0430 \u0440\u043e\u0434\u043d\u043e\u0439 \u0433\u043e\u0440\u043e\u0434.\n- \u0420\u0443\u0438\u043d\u044b \u0421\u0442\u0430\u043b\u0438\u043d\u0433\u0440\u0430\u0434\u0430 \u2014 \u043f\u0440\u043e\u0431\u0438\u0440\u0430\u0439\u0442\u0435\u0441\u044c \u043f\u043e \u043a\u0430\u0442\u0430\u043a\u043e\u043c\u0431\u0430\u043c \u043f\u043e\u0434 \u043f\u0440\u0438\u0446\u0435\u043b\u0430\u043c\u0438 \u0432\u0440\u0430\u0436\u0435\u0441\u043a\u0438\u0445 \u0441\u043d\u0430\u0439\u043f\u0435\u0440\u043e\u0432.\n- \u0414\u0438\u0432\u0435\u0440\u0441\u0438\u044f \u0432 \u0442\u044b\u043b\u0443 \u0432\u0440\u0430\u0433\u0430 \u2014 \u0443\u043d\u0438\u0447\u0442\u043e\u0436\u0430\u0439\u0442\u0435 \u0441\u043d\u0430\u0431\u0436\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0442\u0438\u0432\u043d\u0438\u043a\u0430 \u0432 \u043d\u043e\u0447\u043d\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438.\n- \u0428\u0442\u0443\u0440\u043c \u0411\u0435\u0440\u043b\u0438\u043d\u0430 \u2014 \u043f\u0440\u043e\u043b\u043e\u0436\u0438\u0442\u0435 \u043f\u0443\u0442\u044c \u043a \u043f\u043e\u0431\u0435\u0434\u0435 \u0432 \u0444\u0438\u043d\u0430\u043b\u044c\u043d\u043e\u0439 \u0431\u0438\u0442\u0432\u0435 \u0432\u043e\u0439\u043d\u044b.\n\n\u041f\u043e\u0433\u0440\u0443\u0437\u0438\u0442\u0435\u0441\u044c \u0432 \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0443 \u0432\u043e\u0439\u043d\u044b \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u043d\u043e\u043c\u0443 VR-\u0433\u0435\u0439\u043c\u043f\u043b\u0435\u044e, \u0433\u0434\u0435 \u0432\u0430\u043c \u043f\u0440\u0435\u0434\u0441\u0442\u043e\u0438\u0442 \u0441\u0440\u0430\u0436\u0430\u0442\u044c\u0441\u044f \u043b\u0438\u0446\u043e\u043c \u043a \u043b\u0438\u0446\u0443 \u0441 \u0432\u0440\u0430\u0433\u0430\u043c\u0438, \u0441\u043e\u0432\u0435\u0440\u0448\u0430\u0442\u044c \u043e\u043f\u0430\u0441\u043d\u044b\u0435 \u043c\u0430\u043d\u0435\u0432\u0440\u044b \u0438 \u0432\u044b\u0436\u0438\u0432\u0430\u0442\u044c \u0432 \u0443\u0441\u043b\u043e\u0432\u0438\u044f\u0445, \u0433\u0434\u0435 \u043a\u0430\u0436\u0434\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u043c\u043e\u0436\u0435\u0442 \u0441\u0442\u043e\u0438\u0442\u044c \u0436\u0438\u0437\u043d\u0438.\n\n\u041e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 VR-\u0432\u0435\u0440\u0441\u0438\u0438:\n\n- \u041f\u043e\u043b\u043d\u043e\u0435 \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e Oculus Quest.\n- \u0423\u043d\u0438\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0442\u0438\u043b\u0438\u0441\u0442\u0438\u043a\u0430 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f.\n- \u0420\u0435\u0430\u043b\u0438\u0441\u0442\u0438\u0447\u043d\u0430\u044f \u0431\u043e\u0435\u0432\u043a\u0430 \u0441 \u043e\u0440\u0443\u0436\u0438\u0435\u043c \u0432\u0440\u0435\u043c\u0435\u043d \u0432\u043e\u0439\u043d\u044b.\n- \u0417\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u044e\u0449\u0430\u044f \u0430\u0442\u043c\u043e\u0441\u0444\u0435\u0440\u0430 \u0438 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0438, \u0432\u043e\u0441\u0441\u043e\u0437\u0434\u0430\u043d\u043d\u044b\u0435 \u0434\u043b\u044f \u0432\u0438\u0440\u0442\u0443\u0430\u043b\u044c\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u0438.\n- \u041f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043d\u0438\u044f \u0434\u043b\u044f \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044f \u043d\u0430\u0434 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0435\u0439.\n\n\u0418\u0441\u043f\u044b\u0442\u0430\u0439\u0442\u0435 \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0435 \u044d\u043c\u043e\u0446\u0438\u0438 \u0433\u0435\u0440\u043e\u0438\u0437\u043c\u0430 \u0438 \u0438\u0441\u043f\u044b\u0442\u0430\u043d\u0438\u0439 \u0432\u043e\u0439\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0442\u0435\u043f\u0435\u0440\u044c \u0441\u0442\u0430\u043b\u0438 \u0431\u043b\u0438\u0436\u0435, \u0447\u0435\u043c \u043a\u043e\u0433\u0434\u0430-\u043b\u0438\u0431\u043e.", "short_description": "BLOCKADE War Stories .VR \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442 \u0432\u0430\u0441 \u0432 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435 \u043c\u043e\u043c\u0435\u043d\u0442\u044b \u0412\u0435\u043b\u0438\u043a\u043e\u0439 \u041e\u0442\u0435\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u0412\u043e\u0439\u043d\u044b, \u0442\u0435\u043f\u0435\u0440\u044c \u0441 \u043f\u043e\u043b\u043d\u044b\u043c \u043f\u043e\u0433\u0440\u0443\u0436\u0435\u043d\u0438\u0435\u043c \u0432 \u0432\u0438\u0
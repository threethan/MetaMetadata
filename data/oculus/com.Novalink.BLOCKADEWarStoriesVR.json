1769871257146153", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpWnf8Rj5H4Q7kNvwE-ko88&_nc_oc=Adq74hQGkPQ1ofltNlmdFPtcxgo-zot0ZtLKqA5jl4bBHTATShS7K1n0pRexnLTxGHY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGE4alC8aVGd9vZ12LC6YUvwgDrBjV6Y9HRPLHd9TanQ&oe=6A940D78"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEvWksOiMn8Q7kNvwH4HnGv&_nc_oc=Adof-s2PZamLaxCs-ihfuleu8tLZrcOwXX-hraewW-T6M-2Wjm7XQYz6C7M1zbqqKQo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvBAjSo-26bvQHY_RsQWltpj8eUQqYHs0YistNb7k5SQ&oe=6A942731"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4t1FmDyEXswQ7kNvwG06VUp&_nc_oc=Adrc1pF7FhtnS8rUa1m3MoAG2jRm65LKEf8sXvy84AqHw1uGker8KfnHNf3TNbLvWWg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESlqClS0pnndbOtp3fiHl_reyCuwTEEqgYlPBerFeTqw&oe=6A94187A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sr9JoWMhYO0Q7kNvwEq_3-P&_nc_oc=AdqbypWMbrTuBs9h8oclIotsn_BMkp5AOYEP5-0B-Kon_gBoT2vrAlLfRAWdWRJFdzs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKM3Uz8OiWuTouff8iu-xHIXB6-50JIFPsOnl7MR_52A&oe=6A941EEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QePDaSvgdnIQ7kNvwGsnwuU&_nc_oc=AdrwPPnwaQPB6eNPlTXrs2pCFQfGfAGTSgqy0CyR-XmdUwPil9aUW8ukAp6byPq5drc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKMBqAPQ6nnNkWgR5BJy5REkb1cF5xD3BaGsJAfMHYAw&oe=6A942F52"}, {"file_name": "1440x1440.png", "id": "13054895174670
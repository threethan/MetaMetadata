1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yzLQ9n_KyQQ7kNvwHLoJEz&_nc_oc=AdqHYqoAVxiQX3-kgl5y_Q-yPCEin2FBBl9h4q-F5aUdn5rRX77N-AtDaRRjRD3C27o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjy_NMykEbidp-helM1aMLZpOszsgRFtURm_QadAYR0Q&oe=6A6772B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsebffCcMWYQ7kNvwFBSQHv&_nc_oc=AdrBE-PiQCZTUDMYha0fYb5qEMkWnLiUR18Si92vfYlk5YWDDppjzjXMhU1OiKsu_pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7KgmwpX3Gz4ruMZaBulDQkb4hUk8jQrlaktEuBnGKLg&oe=6A675431"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtOFBbIHAGQQ7kNvwH-42SO&_nc_oc=Adqp34yp1SWM1vbfUrVrwTHJAm-MpSRDUsQy6B_z4tegeL6N9qpoEXOM27qcmMD_e8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdqV5i30ZVL11Mm_r2XpolbSau9sDiWXlep9Xm0L7rnA&oe=6A67457A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XbJORS95C-oQ7kNvwH6hAsr&_nc_oc=AdopJH9HmhPIbLUdr6fc7L2yxFuFWfkAbscM6-nIiunTYRLRLbnE33JXnT4pMYZEBuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEcfTTVdlaULIi5QxhHUUh84eTVr1pQ9h033gLPdjtzA&oe=6A674BEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64t5Ij4Ob9gQ7kNvwGqT-LD&_nc_oc=Adq2XgpdisEHX3S7MK_dLccbbk9YVbzr2TMMIYbGa5_zALl9JYxfYtchmbRDQEEDFNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfsF1EWf5H8mwYyTcI_ezFUDw2_ngqBk94lDyTkkYJXw&oe=6A675C52"}, {"file_name": "1440x1440.png", "id": "13054895174670
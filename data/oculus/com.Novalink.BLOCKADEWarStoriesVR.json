1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDv-KCVZfaIQ7kNvwEp_QQL&_nc_oc=AdqGHF1XhtUQ-sCyZiV4qFWgfBjjqprSys2a6tRFHUXTJyxanmFGiaNUSW2iJt5z4u0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xTjrsPg2wYrsMROI0dC6OO5IcS-UUtCw9qbGE_zY7yg&oe=6A009DB8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVHa5rfqcDUQ7kNvwFB6nff&_nc_oc=AdoEyYnGWNLcBfgezYDkzTSjK6FT3M-awRz3TXHRb2dXhk6aTXfwlq43TuV7FySryR8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R_9RMSQhaBqImYa56m3eZ7poiAh-d90KstsLCS6Z8LA&oe=6A007F31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBLqx42iNxUQ7kNvwHt6_dU&_nc_oc=Ado3JMeRPBwWprtxErCDRqb1pEJJ6bZz2HxSBcSaviZEyyqy96kWJWHhaZ8eIK7vuKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w4z3CgWtTerEucsipEr2JegBi_1wltXis7zBAt-RyUw&oe=6A00707A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blsB_VRj8LMQ7kNvwGREYA0&_nc_oc=AdpyCQVbEiPQJl6lp8ZayzdDa5fqa6wjozXD1UJBpuTQdFIs7rk4lvIxeyTFxtqOCAM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O2aRzOA1qHgKNofevRI3d7PBw_rXNTMltoaPgg80PGQ&oe=6A0076EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Vq_6LFiSL0Q7kNvwFA6AoU&_nc_oc=Adrto9_-gyWhLrAKp6GWdB7K5fNPlfX-tXRzBOMZYD6ncQEKIAWQ0XfIz12TbfgZMQ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KH8wPlewzANItYM2pDcW2dKfn5gu_V9nDkt_3XTh-Tw&oe=6A008752"}, {"file_name": "1440x1440.png", "id": "13054895174670
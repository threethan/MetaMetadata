i": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035405_549676184266047_2202505519363498923_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLZC30P9WQ0Q7kNvwFDSl_a&_nc_oc=Adm8EIjKazFGIEjdVnwXTvVw-zlAjujfUDHXrzYAC9Z8GlIDi8Mi5njZxoif8hGchy4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh-r5EJekFChWKuO6_OXgUid5DKNEsYJEnBPNeOhBNaw&oe=69AD5AAC"}]}, "id": "3595207024120928", "locale": "en_US", "screenshots": [{"file_name": "5.png", "id": "593423939973577", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031588_593423943306910_8964591316500091202_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39t4TPM9j-kQ7kNvwGmf1yQ&_nc_oc=Adky-2IlIMuRWrl7AxYuI_zf4UbRiGD0CB3eRX5ZMbbVsE4p65bedbATtjtUERQ5KLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTBzaHGymWMEY6y6XyPk-1r__DFosN5MqgI3eHJCZCQQ&oe=69AD6C3C"}, {"file_name": "6.png", "id": "8072562922846345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982555_8072562926179678_7251335998405277014_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ew3ZuUOTN7AQ7kNvwFEvqkA&_nc_oc=Adkkq7QD6VcMsT3PkDZP0aGGWvEq3N6qnWr3es2qrVYSFqaDuJIHFJYgKgAFDe7m1II&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMpDkvsrbPsP5xcOCbA0oRBEwc3mWghrZZ26LVwqqjTw&oe=69AD7F97"}, {"file_name": "10.png", "id": "1769871257146153", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNcAEVVTlOIQ7kNvwHhzu_r&_nc_oc=Adl7oTTuzoel-g0xxtfSGZij2h4qGg6n0C-FI-7y9-0a3pioDWpx9-U0Q_nr3QVijaA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzujQ1tLh5mE6bcIIixtcYA2vQlVTkYI__gNSSpH5zNsw&oe=69AD56F8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzstcK_x8GwQ7kNvwGPXXLh&_nc_oc=AdkSlfBbYTcjQ1HYDBl4jEM2bPiZw5s_cGJTN_2xavcEGkbB503uUACcZZH2vTrqejo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfybhywjLuF1Nm0oILQEBbd0pSgP3UZBjqPUJ2Zp6qIdvg&oe=69AD70B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i3a3HyKtW44Q7kNvwG_nQkS&_nc_oc=AdmM7hGFZh7JD4kd3DX3CDYjZS4XVXVl0PKPqOajlt8AXPW_dWOrEr3ExOX0fxwJjUg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxmMoyZo3QytAWPTjoir0LIxDMivlSZbZoQTUKkeKWYw&oe=69AD61FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou0d0aIq8KUQ7kNvwGLC2hu&_nc_oc=Adn02InngDav1VwrPdd1veaMFt371CIVtJU6wCOLFDtATafPFA8ntTg1XIJUvwH-c3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWvHeDZR5PqSjdhMreQF22VB-35ugU4nLwPuGaTv2qHA&oe=69AD686B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovsH4QseI-0Q7kNvwFD-mKX&_nc_oc=Adl6Vcphl1bCOdH75HrYdDVr3GD9t3tb7Amn22eOMKKS87kdMgCa58y2CUjos4p5SGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIxim1F81pR573-W_oWAMw9b_kpLhYQFtbutVZaMzPeQ&oe=69AD78D2"}, {"file_name": "1440x1440.png", "id": "1305489517467022", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031309_1305489520800355_6188094676329951606_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hO98OIBs2WgQ7kNvwEQv-cd&_nc_oc=AdnefzKMKv8B1SR82FRl_on_-otJLX_FlugYDJoegaBj_xuaZ6kPqFaQjrTSlWWdf1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-WuRkRP0dG0nAMBL4CgK428f0PixuJHU4529P-rD2_Q&oe=69AD6A92"}, {"file_name": "Portrait.png", "id": "955521832771127", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391784_955521836104460_5660332532574867514_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQRZn0lN0JkQ7kNvwGWQu4Z&_nc_oc=AdmnXIZfwbBZo
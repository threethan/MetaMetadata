1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hdm_NC4UOwQ7kNvwGfAxHb&_nc_oc=AdpzGnULGWjSfNrNtuEVjHWdvkx8kI5vzJ_yZ_wfYE0hT-Tdx8Ud3nBkwe3YAyzTsxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af383KLuMcUGM7tLW82PXI-mlbzLbYi-XP18pWXDvr3xsw&oe=69F76338"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcYgh34i0FwQ7kNvwGW_3ZA&_nc_oc=AdqzKLT-DBAW4U3rBq2ZZiiKAsnkCwvwlYOkC97XkY340EfN1NB0LbIpgOcettfIzpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NjXuIbQsJIh6qvstIg47WjtN5RD8p3qwdGGWNBflqww&oe=69F744B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73LNNkYsDG8Q7kNvwGzQYf4&_nc_oc=Adr6WsAg-JIkDoVdNdE84w7o-bjo16UoDxrthYIfGWW5HYoyY6X3HKE6muihiV0eISM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af069b2y6EPdKuwsEHt_hyaNfcsz13hKuu2q1-L7ArGSLw&oe=69F735FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ji3n1nIxh-IQ7kNvwEnzgha&_nc_oc=Adp3FNaMb0G4ZpWHpIxH7ReMKr1Q4BcQO_fti70vQwFDDRUnkigOfZoLEo7aIW9DqDw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NwJmrloFQFDlxn3FJraBgbXXrUunY7tOGU68xGWKYiQ&oe=69F73C6B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_APFttjhPUQ7kNvwFrn4nr&_nc_oc=Adrss1LmtD0Qk7db_tXEjRTA1zLl_d4LESd7g-4Pi27xLdZ0KTYKHRaCuwy1oOACLPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kIJ2KhxKmr2oAFYXAOvZEPHTuy-bc1q660ZZmXu89_w&oe=69F74CD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
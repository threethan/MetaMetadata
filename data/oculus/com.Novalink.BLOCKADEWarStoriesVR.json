1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3qV8zwO03QQ7kNvwGOtpC0&_nc_oc=Adpqf6xojyUdGm8y715zqtf_6QLFzHE3uKTkx-s382VkqpPAMgrSLPEyPrv8ACnW_ZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU4mV0ieu_YqoAIknmfJBzG040F8pEt1YR-uwlexrt4A&oe=69CD3338"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiwWZ1ny7mIQ7kNvwG1szrw&_nc_oc=AdoJBjl6-xCi5gknhBf9UGObO3ILSvVjP69uh_WfnAKlA4jdS1F3JTffH2xBjeiDH0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7F3tJnnJK7FxeXSR3cK6ll6dRgZWAunzzrFIv-pwN_g&oe=69CD14B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ovd15O_LIsQ7kNvwGpK7CM&_nc_oc=AdoKvjBZVcMBxqcJDOfocWy40rjtOxRpWwx-t3XXAkPwQX46p9SososwlDcRRzlOsBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOcQECRAYS-5A1IWX-lqL6xzsET4UBUBFU9HhN1I7usQ&oe=69CD05FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKvWSV8_jW0Q7kNvwGbpSWu&_nc_oc=AdqLGn9PTnZPGaPi5oe7yI-66town7mgnqJPP8aYQM_K-3BWbqyty27IZ2T0BCAt40g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHUVrZYFsg0RsdzfJPPjM_wIwQn0OkSSwK5ftXWtFZDQ&oe=69CD0C6B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wLYuqX2RsEQ7kNvwFyHtA3&_nc_oc=AdpFJtof0qlFu6VyrlFhCKf4D416BdCjT3ca9gMqExRTHQV7rcpgx4QlF7GlKcg-rw8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXY4V8407L_lmMLEgcSvzW-S8ORn1jQKnPB2qA_MGp0g&oe=69CD1CD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
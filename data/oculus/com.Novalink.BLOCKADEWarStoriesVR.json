1769871257146153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ma-jdKh4H2wQ7kNvwGp39o0&_nc_oc=Adqlmj9G5Fx7FkDg4jaSj3XGiniYa3uDIAxEmWoMdAaBjU7Bo6PB_f0YmOjB5DdmNt4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZcTqoktcQBRp-R1FR_ALlAs9qakDp0dRLZ1aIaY5gqg&oe=6ADCC838"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6PueplEfQAQ7kNvwGSPE1B&_nc_oc=AdqEGjDRHWaNMn1X3SfoPrsFOasmFfIF5cGcLT4X0B1YIs55afanfCu61T4WHIVy3Xw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe1yU0yyrb6U8rTK7SqCTTUlMiKTB0Jqs99rYl1Lk8SQ&oe=6ADCA9B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjPVMXGkXzQQ7kNvwHXwj8v&_nc_oc=AdqKyxLHatlvli8kv1QAGf3lm4VbF3Uz5sGbkdtb5qnJaV-Kc0nlm0CDehZSm3PPBO0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7Biu3WuAzEjL9oZybWBBwdJCgo-skriWut5n6Nnuf3w&oe=6ADCD33A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94X0J2ygzsIQ7kNvwEwuJzV&_nc_oc=AdqPtRfbjjTtcwMOQ3vfZxdU4izvSlEx-iP5xij_kRfHMB5SnSGwl6Qf9GCo1erOU2M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6xYOWT89eVYVz_36w4zlDGj6Yx4wTWs9DZ4HDD_GcAw&oe=6ADCA16B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXNl8jf5Fv8Q7kNvwHdxGPs&_nc_oc=Adp5xuKSMAsavTcMn9PztHgivWNAEapaViJ8Fgi1NEuCYuCgoNVyTMcu3e2Tv9ofs3w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoXSwQL4vt6Yyyiagcq1goiNAivzthJtKRRiZ30189FA&oe=6ADCB1D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiq6UHRCaLkQ7kNvwED7uLn&_nc_oc=AdoVObESM_UF3fw5V4KTS1LOyPOSrFrXQmgFnrB4WWjyn-0zSPbnNDaUG1XfpSQ1bl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afztqgu50wZLVseXjQL7HJNlmJMBiEBKg54oJjd-lnP2vg&oe=69CE4C78"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cC16TR3KTzgQ7kNvwHCDly3&_nc_oc=AdqOvTEuWhn0t7ZHRoBH6oCy4o70TR6R53GRV_Yf_pUNqM8OwcYJaM0BMIm6X6aK89s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyK2QINB3x33BobhRE3NDKbkHuoxhAumvirOOAO1bVi-g&oe=69CE6631"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TpEtev5th4Q7kNvwHhkDF3&_nc_oc=AdozwxsJBnvgTTaIzZ9yZU-ipebznsiOYRiHK8j0W-Fq__mmdaE1oR871obdFXjCSnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEPlVxTEkz8JU2_CyfKEcOCq7jlpvxmlMEo1P8M6uDzA&oe=69CE577A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKvWSV8_jW0Q7kNvwEezCEn&_nc_oc=AdowktxYXA66u2erU-HVOAqngmTM8VS400Yc5nx0RQbAV5m6gviRnnOtZj-qbDFwuvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrdHY1HeUKjHVIpkXMPfKevwcBu43TUkpvGX_4KKUdPg&oe=69CE5DEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wLYuqX2RsEQ7kNvwEbTvVJ&_nc_oc=AdphL9cBcweD5bZows0kMNikm3wTQDcD2aQYFnSPtv5NZ39VqPGoLb44nhJ-mvZNlTo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZinDq_MpkY5vzRIUFa4nWbhofnOvgtfkXA4u_Luh13w&oe=69CE6E52"}, {"file_name": "1440x1440.png", "id": "13054895174670
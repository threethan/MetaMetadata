1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4bXzzNN0X4Q7kNvwEkM-uV&_nc_oc=AdrvzQmgBPEUMmsCpVhWEt54k9k2nBZAwcG1ZAGFy4zYRQTs2we0Ifj9kEkmJTg7aKs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVJv5pH2HSe0FsDSEeVRE2oENIjvDiRJmtrDDCzKC4-Q&oe=6A7744B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2A8hlQUvloQ7kNvwGlDDLP&_nc_oc=AdoLkJDdzEuQYh3HKWMQQ3g8logH7NMxUE-OuvCYFQxaTk8Rwm8NSu8J7URtrO8cjec&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpKkCFKxSeOZnYUgqpn1qlA4GKk94Ds6zUgQuJaL7bZg&oe=6A772631"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3psYqhXpVB4Q7kNvwFRQPva&_nc_oc=AdoVXvgtYdBHMUlGeqXtDEjYf4GIVd8J83yQUXiRQvwayQmD3J_QITAIpQlTHs4qHyo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW0JvlwwQjZ05H-L_sgCN3SwcdjrWiJgFc17-wrJEpGA&oe=6A77177A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-yrNybqAY0Q7kNvwGk-YoQ&_nc_oc=AdpOdqx0WetMwmb-7I4wvhsg81LW60OonASYF41I1t6MBNwBF9HMMTiWkUREE3IDQn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF48FqHjW9BDTbufdW7HXx-iihAp6WT31-3PDE6v4GvMg&oe=6A771DEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2HseUePdnIQ7kNvwG8VW5K&_nc_oc=Adqw_9UrBIT1CNzx1Ks_vpGuHORgQECb-HklJzwxoNDlAP8TcySSTMIAoL3QwL2ixrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK54P0AA4CzupnOam9QFqXRU93mwsLRAWDGO8FDFaxSA&oe=6A772E52"}, {"file_name": "1440x1440.png", "id": "13054895174670
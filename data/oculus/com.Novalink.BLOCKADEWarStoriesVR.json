1769871257146153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r3oKobo29YQ7kNvwFn0kbI&_nc_oc=AdrIVnXOzg_IulRQsLSVXF5t3YNWKCRpF5d1s8IuPbzpdUaCZAIhEapepHDbssD-bjM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEy_tpnQ8AiwZ-m-3486Cy7jGsqnWbQJSVqhBUqVeUIxQ&oe=6A86DE78"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXiRBEuHGG4Q7kNvwEqG-aQ&_nc_oc=AdoFoiuk0PuZyEAd5oPzPut9-YYj9LpU4FIEjEVx2f95DEs_MuFq6d9ifbAWMa1-YGM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0A7OiuuzG9xiVqJHek33xZdjWCmaehUwsrIYgDil79Q&oe=6A86F831"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNkQGoqHvDEQ7kNvwELFgrw&_nc_oc=AdryG4r0gufbow7SOcCpeHcA-hHkN17FKmkEZzKxIOr82xYOFk4anh6rIRANZPYQffM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9A9Aetwvnsh8PM3B_Rv2qON3IHUrrFJxawjPt7dJW1g&oe=6A86E97A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEvvjVbY_PwQ7kNvwHw2hRI&_nc_oc=Adqoh-tA4UygWR6i3eMeFhUeNsjcNbklIfeVC4rTEh3yrk8qBrqHz5we_KzHTioZS7U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpJ2ROBDxKEN-a1f3yd_HNP2YDnwKM4NNyvQCBMsNUJg&oe=6A86EFEB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=to1M6S4-MNQQ7kNvwFGphWu&_nc_oc=Adras20CFrAK_wYnX5UTE0hygcTrLg-G7qAQzUho1Bw4AfHT2MK_RT5Tkd79KQMzhgM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXMkwpVBSPbBGU9j9KyuDgUmY9aqB2cZT4saT0bh86XQ&oe=6A870052"}, {"file_name": "1440x1440.png", "id": "13054895174670
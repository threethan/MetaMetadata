1769871257146153", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F08yUKHtb78Q7kNvwEBa8YU&_nc_oc=AdrxNq5RJ8dDRf9hCWEO-ZTmQJbmHz8xNyi8z7dWyEynrgGDXvG5rAJ35bWEejPpiSg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PjxXbe2wvS-RaJIyJVGft5XHpqHtMKerxwa7RdvIymg&oe=6A1312B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSzFALu-IiEQ7kNvwHuyW12&_nc_oc=AdqtOqDzIji0AxZgqUTuZNnge4Rk6M8BwRaE1kN8MbiOlVmD8gVi5zIhxz_2G4G5qAU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EYTTEmsZ_dyxwgaucWrSx_hf0tMWthLBvjarEDIpJvg&oe=6A12F431"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JG7yL2bHU20Q7kNvwFtlckj&_nc_oc=AdqoVjIwV7sH0r9KLiXRyF8J_hFPr2kSRUsgcrNYWlCA_v5B-5arDxE5vdmLoINzOSo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SGtrMRSWP4aqBXl2u9nFmqHp8YEapYms8bdXmlNKO_A&oe=6A131DBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt8rHGp8Ne8Q7kNvwHlj37R&_nc_oc=AdpiZKan07W63SrGOuThytTA3QbhRvnaH45r_sP1pqKoytwiOGHdiLeXiZP72X-sKe8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Mo61EuzYsXiYhCSKLr8KEZWJ-XOObu0kWtVgj80gvDw&oe=6A13242B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBwvH3NPu7MQ7kNvwGzgzKP&_nc_oc=AdoUtPnhSdJp-KPJlOiNtTbkw3jBkYn5Ou4FbphfzGJYJdjvSk4w0XSWMbyFTNCwDDc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zadHybEeYJAIsgpqxB687BGv4ELfC_F9MzAI-J__asA&oe=6A12FC52"}, {"file_name": "1440x1440.png", "id": "13054895174670
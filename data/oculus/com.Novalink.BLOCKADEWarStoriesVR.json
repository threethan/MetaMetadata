1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XbsIyNBUCMQ7kNvwGXPWji&_nc_oc=AdrpHVRBz8AVv27PuRt5dkigZHongM2wPfZSCXGUsiYKx7Wlv1oE81Ej0IRkksZJ3nQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E2SaCRW6501m27JaoSY7rLcsAb-O-0fCgKbGhOZ_Lnw&oe=69EE28B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T11LeVvtBcQ7kNvwGOw0ZY&_nc_oc=AdqFaB1QXcdOyKxGlpjzFzEOeAucQGzNFNrz2xWocWVT46Yj2TCZzLO_pJK5dfy2cmg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gbTkHjObbR8QkvwglC-5KuZv5cNP28OEbacUAyHzNog&oe=69EE0A31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRHQ-i9FQ3UQ7kNvwE28FQY&_nc_oc=AdorQlqX8eBDUWGkhXtP7dBFAPl9MvHwKFlwb3EmmpT4tjyBrLguMR_JFud1XULceqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37jI0RvQM-yQBQgO6ER8Kgu3dAq525W0jEd9TgqSTveA&oe=69EDFB7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FQbbw8t0R0Q7kNvwHQdS9x&_nc_oc=AdpRAddX9MKiNgbTNg3_cR-MhTwga9Vwty59CBcOnt5dMKKj3uNz-Ccuk18q1a60fSg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-ntaBUrOH3zbuEXNadIpfVxVmmXYFaEzrDrMjMDWt1w&oe=69EE01EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVVj-Qu66pEQ7kNvwF4j0lC&_nc_oc=AdolWa37Q6WA_irn-4chktdkmxcElBEymxCVPCBbgFB62g9I2VZ2rLYxcn1QYoPSbRg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bnM_iU3_JsLVXs4xRRc77Z78hkUI6CTmvBASvHoM1Rw&oe=69EE1252"}, {"file_name": "1440x1440.png", "id": "13054895174670
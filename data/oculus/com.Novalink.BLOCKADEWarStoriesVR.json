1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jh_tYjpXUQAQ7kNvwF3j6m2&_nc_oc=AdoAiUcUh439G5CZpC6_swYw36YmmAQpAgiCZAj6Xw8JGUdkrxpPd_jV1wy0zExMGUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-3vJFOqtOnd9mx9xJgFYqgRCsLmljnbSETFafLTCj5Q&oe=6A7EF578"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUAIvQwa6AMQ7kNvwEjzHrb&_nc_oc=Ado5pOr6UXTe4ssWyZPzQAcpxCJisL9oFL4VFjLi6nk41BevfU8m0HKx0tSGLqnuRb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh8omrAi4LLo3O7mjqYdG_3k8hzup4JEOnnI9FahorKg&oe=6A7F0F31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFL_qUpR0iYQ7kNvwF_jrdv&_nc_oc=AdoKv4EQ_aQdsY7pJfOYhq4v_X9uzTFT16qqeYFhKAt1l4bpLkQximtDDUwh7gqLBtE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGubKVRv8ktKHd9YLhfVOmBzp8V_ukPYbjRp8A_G5RiWA&oe=6A7F007A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR-I-7Z0vLEQ7kNvwEPkcqy&_nc_oc=AdqhpI2vcfNBrMcPOnPT9kobAb8bHizZgG3vQYlU5iX9nyp-QthU-0H9p_Bw-CuJ2cs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfbMNXYnGjkT3KFkolZZq5uVT0x46FitmI3wt97KUJmA&oe=6A7F06EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnpkPAQUyBYQ7kNvwEBljNm&_nc_oc=AdpKiSR5SKW2VryT0cbZJzoyj3rCXxREtkLwdvIZhi8vT6G5yspZv6yXF5NaMlp5-7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpgpZC7ZhSTQWgAQYyglVoTis5BCO0OwdRJuKtzjvBmA&oe=6A7F1752"}, {"file_name": "1440x1440.png", "id": "13054895174670
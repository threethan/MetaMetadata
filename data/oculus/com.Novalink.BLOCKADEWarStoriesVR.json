G7byPfg&oe=69999078"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxFYrp1c0UYQ7kNvwEFA0g2&_nc_oc=Adn-L38ltPYi6TyzQhGZf5Dwo7e1-w-AP_ahW8fD2yUkMN8QyO-PSxwh2-dzCeZ_J_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftNou6T9xrLxHZ6Bgt_pxZOiQZkFUGaJvWj19oGL3q1Lg&oe=6999AA31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISpbcQY8TKsQ7kNvwHtIyEY&_nc_oc=AdlWPkbJgZ3b_AI_6RcC7u_0n1wjkwhxhDQ6Sal9icm19XazQ0jnbzZMPyEaESnREEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftv5pn2dMHGSt1MR7-MDEjdBfaUasw9f62k4PCt0K_74Q&oe=69999B7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCGIGT-Kp0oQ7kNvwG4_1pA&_nc_oc=Adl1PNDML67GLStlEb_apyLU5P1a_sNhEvoFc5uQraEbiJC09UKrCJ1YJZFwc3YuhPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvdQA6wABzkig2JzxKj1-PQykRxTZDzZkfFogec0DAR7w&oe=6999A1EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qkDbO3hAWQQ7kNvwGrMM3-&_nc_oc=AdkEVO-FHg9gLV82aLrMhawuBiU5pJechsTT778yORQ1lFX8LavvJoB_R48YW9tiPJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfugOkBBNQmrT8eKvT6zaSOp6Fc6cXVUTEryWDkBpqc9-w&oe=6999B252"}, {"file_name": "1440x1440.png", "id": "1305489517467022", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031309_1305489520800355_6188094676329951606_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YX54QPFZ7FIQ7kNvwFssOa6&_nc_oc=Adkk7BmADN66rZDnVlMetVTTkmC_ygE7kQkoaJqo9Bs-8vZTThl2cmYWKiicu7rRCDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvYZiQY215v6GbKHjvar_ATkF8l4bO09P9jFxyoIZCP3A&oe=6999A412"}, {"file_name": "Por
1769871257146153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MgYSzmyeMcAQ7kNvwF2UJC2&_nc_oc=Adq7Zg5c7eRmC2cDKmoJNVY9YFJSJLAjffBZ4W9XQiug9dvwAa0VxzXskNQVASdtuO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nMVqkQbW81_1UA_kqQX_FDb1zTkASY-a33olwihRk1Q&oe=69D39278"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz3VOVYntNAQ7kNvwEwwJsU&_nc_oc=Ado0bATjBW-xxFw8Vvp7CKQ6nzljVqlxPMZOEJI2AX4L-EOC1StpSaaOIbr3Wsxo5ZY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fK7y5yXWddjc01Wz2WPjPOerfudR3jDO0SuiGt1vXig&oe=69D3AC31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxbffoZ3K-gQ7kNvwGOby_N&_nc_oc=AdoG8BgFyKSB5ih9rV0fNLxG99fd0dLwZgWPknxwWfgjl-m_ceIBPF83V-C6P-7CjNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hsB-0DjXrYDtlIBC7sn4V90HIMZ5tFWbzZVtCxCJYjg&oe=69D39D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbNscM0WpusQ7kNvwEIkjUv&_nc_oc=AdrC2KGb0rrficjmsAEt0mdYFVyje2uCAvn8LrPM-CC-qE7Txk_XpEKVohE4zQvda34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cKFDIWjy0aNjmP1mQrt0d-KU8F99VQpo96QXB8U-mEA&oe=69D3A3EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSbOOhZzNEwQ7kNvwGxQKtf&_nc_oc=AdoJVsu8ZJaC-W73UhRepmM0Ah97x04mdFy2R8kczEPdAAN3QxlPae9g3fX75rM3ru8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MRPwCk18l8ugqcBCTd_qEpf-CXzvC6Q3T-lS0rdSXUQ&oe=69D3B452"}, {"file_name": "1440x1440.png", "id": "13054895174670
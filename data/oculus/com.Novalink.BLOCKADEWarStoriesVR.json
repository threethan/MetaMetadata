1769871257146153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdsSIqXd7BsQ7kNvwFvP31z&_nc_oc=Adr19cw1BNOBrBkMMO9GMS-vack37u-ixVom4GmU-TwnsX6qpT54w7f7tavIeRLR9D0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8cAjWA6sb8TuDw6-6zXkh3ocSvfZwUbbo6XDIt9KmoA&oe=6AF331B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZQ8_YY1SPYQ7kNvwGfH9Ou&_nc_oc=Adr7aHToGeZcm44AWRBSN63KYnkBV8IdSLhfAqQZ5qwEN6kdAArEyzyaAFLRKLsOE0w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmLqFY72zz76DeQkt4nrhALm_po8J8dgoG8_Uyq6w42g&oe=6AF34B71"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqAYmppy2k4Q7kNvwFuP6wk&_nc_oc=AdoX2LftxS15N5XSxzSKnF97GqexLtKCD5-n5Xa1f9LaGWyk5Q-zkE6URLzH8wFkci0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-0wdVzOXgCBU0YX8MBgPHzkJyOO822yGwHpxHd7qHtg&oe=6AF33CBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXUCcxm0S1cQ7kNvwHS0eD7&_nc_oc=Adru5iyX4n6p39I5Ay0TXrw7gYjOg43OJnD1c2u_kc9V32UdP7EWQqPTnhTjYn1hFDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOVhIcFT5INLOaYnG-GS3F21iWMpBN5sIKeyxIFKrkLQ&oe=6AF3432B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY6CoOYXTlYQ7kNvwG8WxmR&_nc_oc=Adr3O4rU2TY6MNgYfTy7nBNdjC80Tu13bM7hMWxDxfmTX0l7tqDYWiey6ZDTFP2P1sk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKPD__6jplacj-cWv3sYG6P4GOrxq8LTasX0u1cEFDJQ&oe=6AF35392"}, {"file_name": "1440x1440.png", "id": "13054895174670
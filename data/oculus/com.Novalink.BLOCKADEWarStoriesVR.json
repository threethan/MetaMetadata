1769871257146153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYVXOEnGftQQ7kNvwFAixV5&_nc_oc=AdqNdVhqbZvVL6l0Pn3kHqhiNnMYUNQXa_hA2N34MJAUgDWKV0wOaLILb1M8AXlbaxw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NsEXhH3qANgbYX6G7XjFZE-T0GatxYUX-7W7ZhNLpOw&oe=6A219338"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVS7MSQHehEQ7kNvwHt7HcE&_nc_oc=Ado8KGSOOsbbIfyl-Z3Kltsl6ihlvi0Ax0EQYBw6wZCRyYjHDeR5gbSe56a3IMrRshM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dpnvZq0RwJ_XlPgjiPWd-wkxqinv6mi186FqVs9jIcw&oe=6A2174B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6ECnRdT3-sQ7kNvwGvgyf9&_nc_oc=AdrI3T8waGYrUH2Ka1H_uUA-_r0ySyRDXvh3miII0d8QdU_Z6dgjxiKKoPHVUjwGO9A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0DnXavG0cK06p3XUaz03csm-8Xquf_U25HVBHv0uiWQ&oe=6A219E3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APaX1DNVcmkQ7kNvwEfUIsD&_nc_oc=AdrYDADnWmKFwoNLu_8Vad0cX1SjW_Yg9-_nd_gOk-vsLy05o2tByOXV7f-3vnqFHj8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88VYZcLCr6H836jKOVBeeJP0c2kmGzfW62RKO1tdtrbA&oe=6A21A4AB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ca25BDSDY30Q7kNvwEBR4cz&_nc_oc=AdpP8wH-TnngElLATVLdRVhxbmuNXCI5Gr8D4geVLr3lKHPX09rZvHWBcRvq49zH4GQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80VP-ny8yy_FcRLUVn3A3xHfzUrIiNB-Zf44XL89EIeA&oe=6A217CD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
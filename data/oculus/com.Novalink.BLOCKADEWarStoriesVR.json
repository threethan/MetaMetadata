1769871257146153", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XbsIyNBUCMQ7kNvwH7qWo3&_nc_oc=AdqTOzAXzkf4VYuej9pKqQqBIMxgdGJN85IHMuT0mrnwdaxMPHklBy6yBrn3XXVQitc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TIoJVMEeNbo92mpmBbxF7iSE7iMmxUFCPn0dh-bC1ew&oe=69EF7A38"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3T11LeVvtBcQ7kNvwHXKXrl&_nc_oc=AdpJu-Ti3sf-5UYDLHid5GMXA9J7Lk4Fvte_FSBEyw5Wom8II2Tbblrrs29J4A1hheg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KvqXuG0qqRDVKtdY47k-5a1wotHoED8BdwL9R5fioMQ&oe=69EF5BB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRHQ-i9FQ3UQ7kNvwEk6gla&_nc_oc=Adq1yVq-Yq4qFtheRBVD_c1E8T_VCbF7odyYW9pXe1tVcEKj_yM0XC6sbd0C70hb5ow&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3G3xeQEvQpVXxD9yimmJY03RBnj3x5-ky3lTyNPl_Esg&oe=69EF853A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FQbbw8t0R0Q7kNvwGZDue8&_nc_oc=Ado1cJMHGewQOSTOKBF3sgfQ8r8BnC5f31s193jv6cpi5l2Jn5KAYMEfTN_kXwvWxuA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_DJLzdHXLX1kP8Ehhnl4-yPdiH2EDU_ptUKW_Yg77hQ&oe=69EF536B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVVj-Qu66pEQ7kNvwGRKy__&_nc_oc=Ado792c1nEjfg3o_hAmd358qdwozGZGabYDHaKXcwmcC2Sqpc_boy7u0g0k8WDinqPU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2z68y_-mtKrXNtC7eDYkxGQ_4Ek5BVdDD7SrQD87Ta8g&oe=69EF63D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
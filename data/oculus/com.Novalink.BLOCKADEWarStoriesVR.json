1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRHPX2_JAZYQ7kNvwESsW4g&_nc_oc=AdqNi8ZknWoNT4EaFgVDISCTjlDA_gEfDZZ2r4Kv4O_nw2vAA5vHwcUFhdyNrYAr8Yg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9erG7pRiouDvA_6Nc-spadFhzbAAdpnRkSfIMlJMJVDw&oe=6A4288B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lq-qbU6PFpkQ7kNvwHXB4Id&_nc_oc=AdouH-JGvKSRMx6rLAdbwrM2y1gSdAzRgVVogmdA89XYKcNSB6v35jao5sCV6i0JOps&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nJYhoN1rqZ0Ls1gikYifxbsuJXGPiGKHOdT7MxJ04Fg&oe=6A426A31"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvEcw5zSsgYQ7kNvwH3-oOk&_nc_oc=AdrXRV17cf9_B81_6GZNxgFuOiAPGrZNYF5kdCvRoX0GsGRn034mrys5FQagevLkw4c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a_PhKkVCM2D47O_eRQEQHHnxiGrq7IHAR6NmnJvIejw&oe=6A4293BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxQmM7x6q1cQ7kNvwEn9kf6&_nc_oc=Adpq7Bp3gxWA2y0HKyGwJt-iBA1qJEcH2SekbI4JvAdX35RCZtdCXiMF9CtqOLePyBo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8__pvcNkzWQeMoqAvJVnpbJtjpp4MznbT2EOU8n1q3ww&oe=6A4261EB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhkuVDc_euwQ7kNvwFo8los&_nc_oc=Ado4zPMslrM1THcP5p4mVIXbeM66CJj9bsFgdBzN0bfajXqekdilL5iH6ApaWpWYhTU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IHpoVitPIdrLWfVZi9vVPhCXUmeQR0QdImL-96W91eQ&oe=6A427252"}, {"file_name": "1440x1440.png", "id": "13054895174670
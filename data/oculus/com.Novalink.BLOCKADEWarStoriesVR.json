1769871257146153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VokiOt0iVbgQ7kNvwGUjQGn&_nc_oc=AdrsMAuJwSGKa13-HrCe7q0Lv3yhz-mq83JcNy2_J-m0-oA-Q5bOpdjkYxpfPw9CFAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOLMD9Vu73OcD9iSvdy9Qg6BzoalwcSIhaeBxXDZrsgw&oe=6AAAAF38"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i90fCtihNHUQ7kNvwGJUzs3&_nc_oc=AdokhDnp4jj1NyQeVTUfn9C0k33YASKakrYovcBBCBac8qdtsYtlhARUz4M3VSTUWqI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk6f0AlLL_NXxr-OkueEQO39jPW4xtaXnIyb0NhlOB_Q&oe=6AAA90B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_Z1zmJ9DcMQ7kNvwGOT5Qj&_nc_oc=AdpgN60qzw4-7Rd3dzVqSq1tYhVwDN4e7niGTCsXlkOvgryCwzQuzL6mZ5ob5kUWubQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-hdb5FvM_PUOhTPmXKN8-W-Dl6PqDBkWQ1ZAM7aUWAw&oe=6AAABA3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWW3de8qfjkQ7kNvwH2K39M&_nc_oc=AdqrSx0B8fe-gsEWJGM74MRFu9xUh3rVdu7qpRJ3US8ezXsxcCRZeuxfJeYOG8T18d4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLebWv3c9QBUUnoIP9I2p_IKXcJWP3E8ke9PJC5OyqjKA&oe=6AAA886B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCaQM8cbvcoQ7kNvwGKgDLM&_nc_oc=Adqwdc2pMseGvNxnJlBSAddACDu-GWJVhAQ5NkbPt_rmWwrOxtMDUn3Tz9unNQLpXUc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAsiQh7fswe3SiPhsahRgbrmgcZNM3bHpMPDEJrXBNuQ&oe=6AAA98D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUPuclRj5S8Q7kNvwFiRWPu&_nc_oc=AdpbjxAPJCv4HObCrPeGz6zQ7yV1snOAa-TDr8hPUiy-86Ky1Vja-yNKxBEuvScR13g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInvf3-V1E1IHWFy1W53H6_YDyvOR-kPj4UVbJsMiWA4g&oe=6ABBD2B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNvwGShYyLoQ7kNvwFv9QDK&_nc_oc=Adrmq49Bb34vXu0oFfPXFpJBHLuaVGdUhhFmV2If0pWFJ9w5vBZktiaAZj9x48LBIdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvyIYVynRdrG6qN8jLHN-Q8KPfrDZ5CVG8NgYboyPN9w&oe=6ABBB431"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXkwxWtl4z8Q7kNvwG9cUmf&_nc_oc=AdoSqeAAHWDUY07mrDZZ5WQGL21sxmHeuvU8c-YMxWcy9MfucOEu9Syd5entfBlDkbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGt44R1N0hFg2_NL7RQv3JxFCxweqoX-r3x2_qXJx2jg&oe=6ABBDDBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peKvWXXavzYQ7kNvwEehDaD&_nc_oc=AdpjTiwbXSUIlq42K-lr0JChvpichjTikkBEnexH1id6PaZD9O6QfWsJ7S_GekT40-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRoqFxnJn_WAnjKm6s5ERHv0tTAwXxR1jzCBYCNeJo7Q&oe=6ABBE42B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0j7r-piTj1IQ7kNvwGBYmzt&_nc_oc=Adpe1mRRdlYbakf5iPUiIpoG9VAbhwx2mvx79w_q5SX9JoUu2SnPwmaNBZqHOwPyjfY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAjZU8JwVIxDbfb_gbKGdPLS527Sg8U2mDWKitegNaVw&oe=6ABBBC52"}, {"file_name": "1440x1440.png", "id": "13054895174670
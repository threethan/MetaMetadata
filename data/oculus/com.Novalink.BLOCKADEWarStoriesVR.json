1769871257146153", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAcGchi5frwQ7kNvwGrEdvP&_nc_oc=Adrn2mWf9qUphb9akP1PgOUtRILwWAMa68XQHKmTxvSndchirlbyCN4BmUux6oA5GDs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUjaRNDtiWNP6B0WcIECFd7tnD6d7W6lBKKNOyObAfSA&oe=69C7B4F8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo7K_yoxGxwQ7kNvwEftNyM&_nc_oc=Adrx0b-jkM0Bb-lkthfV556ptea18GCnY6-ZBWtemZCG3JHWx4w5bfs0MYvPfzLpZo8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrydJs4jVoT7_f3V2FmnxhA_F6J7-CMvhaue1U1NmFtA&oe=69C7CEB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ12eIhrmHYQ7kNvwFiAjFZ&_nc_oc=Adq7ovDQq36-j52_aUNVGedtyWDomzMN5AJ225co85z9rqEKfNzs5-rQ2wmWeMigLVA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqyCWMFjD8PisQmi8Wc1CbMNU-O2GVMLWrvdqOfxM1yw&oe=69C7BFFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBdwcSgbqS0Q7kNvwFWwtMP&_nc_oc=AdrqprAdCcS321cD2fyyfADPT486qg2eyRrYGMuCgriFzHWqQSvygNx6yMsqZEH1aEk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzM-yqL0wd_9fXd6Bl960fagqgdePiccyslAGuxiCtL4Q&oe=69C7C66B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qeb5PwMQAp4Q7kNvwE4FncV&_nc_oc=AdqkGwtmbMBL9DrBDYFR9WFE7bEALqcU96hsZ3fXlPYNZpY93jmF9zbi4W1rXJygzto&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoEGSS4KwNPKdpabsc1W4OaJxAj8Nx1d6sZy5JKmFOlA&oe=69C7D6D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eQn_apWNBgQ7kNvwEpYX_4&_nc_oc=AdrrDXCRfPj3PbAonUB68224L8_jyUuD2qcQG3di3gzJiusaVDTXCf17I8xDodhKzCc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO2AP07YjibKzd6TcQUQe6yiBSHGDcXZtkv6x5L5UjdA&oe=6A6DD1F8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0-07YGgu9AQ7kNvwEyPgha&_nc_oc=AdoVwxNqrudI2jma17wH_RMO3fDgmy4hFO4BOrDHFpw7nCZT_pqwaII2mts9UWG5bKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKQr1XLkTgd-SrQhpYsvoiTIg8YG-Uo3WqmuSdiKuyhQ&oe=6A6DEBB1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUjZ1g7x3poQ7kNvwFWJGxM&_nc_oc=AdoyI-J3U6BiIrXEyA5zbaag-vgvtZn_Zh-qGEjS0t_pqLwQ1-mrZIYBRsEB4O0nZMc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKnuaL2ZiFs9dc7iCP1mhsLWiHqNlO3SeZmn0H0eLz0A&oe=6A6DDCFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6IZvTko_UsQ7kNvwEDw3IK&_nc_oc=AdpWNmI5c2O8NJMSlOBVNhmDvRPSxXKOjiTrsCepST2V3K3y9NF7pPeh00r-ZD4wfg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv_8521VO0wgZe7p7BNV68hiP2HvlNb8T7Sa8rYcWdXg&oe=6A6DE36B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWnPHHy1RtcQ7kNvwHn7Uox&_nc_oc=Adp8abVAZd0HhaQ_t0ppCY8TDqNrpgGrAe48_5S5SiJP0Hs8zs2jIPNxumanpwsTlgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7gYPJvVQeqJxZUfendpSFncWEAjjkxd8mgLgMtnGMLg&oe=6A6DF3D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu4X2P8qMQoQ7kNvwHXDkYl&_nc_oc=AdqTtGUHDlgOLhjdrLOMMHeV6wc6KbyAePdfPu_43bVqgD1tvPgiqU2ZERPwVukuZ4M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89Qs4-YiJdu3dAu9MGKIyEgFYAxVPPR8-L4eVuzXLfuQ&oe=6A2EC238"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_6vhM5HUg0Q7kNvwGbcJur&_nc_oc=AdrTujtT7kJ1eK5biLF3pdm5nLDHfHrRREeNfoG9nk23mGQUlt8H0trDq-kHDfSJnig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r44VFDrT2INvg4FV1_sLjvOQc-R8qsYbZPI8ZT_qeeg&oe=6A2EA3B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Nv4YSMjP4QQ7kNvwFmudxp&_nc_oc=AdrHGG0eFAr6P-CU8x5aYpyfiKfiwC7p_W8qaSq_LWYLHPzISkKhqqWdlhx1MePk9zo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-W-mGFHwRSbC6ny4euY7XnNsV_kfw0nODcbNTnoaEPqA&oe=6A2ECD3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JYXPQaM-Q0Q7kNvwEYcYaN&_nc_oc=Adq4OQ0A0y-KXu0tQmy7vUppL-qKnWRsFACi9JRAXKdZVE59ByWlp1N0RymVf_XVGRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-eQ9Ijsl2g1DVpnRix6UkXSgBr_wVk2sED-2DD33dGg&oe=6A2ED3AB"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGEdvRjwBScQ7kNvwHjxwTb&_nc_oc=AdqyyxRvncPvs3UPWrbJ82uk2gYI_UJtadh8fhRHVzkf7atxsMV3XYr5zrVSKJOZlV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R8yEOKkpY3pc1M0Lpn6zr1qwpaajD5RFoAx_OhcTq-g&oe=6A2EABD2"}, {"file_name": "1440x1440.png", "id": "13054895174670
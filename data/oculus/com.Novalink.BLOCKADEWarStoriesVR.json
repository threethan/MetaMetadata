1769871257146153", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=629y8bZlqvkQ7kNvwEjPVkU&_nc_oc=AdpnFUf8qiVcE_hzueeDGbCmh7-qOSCxenu453ZAQX8s9sSCNUTVvXriCEcUEJGrYZY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPObg-B7HeCmFMJpuaA4agluKc5AUX6iZFAI7H2lB7CPw&oe=6AC901B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODIJ7LW0peUQ7kNvwFt1MzS&_nc_oc=AdqUVgXmDbHvcX39DaEhsTjBg4QvD3cR8ZakQUpwFGR6RIIlmXTsKrNLS_P4-Tc2Ewc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOE_DJ89WUZJnCoEf90bEV0mq3zM7eJ2ED0by0H-S7o6Q&oe=6AC91B71"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sg_RZgpg5G0Q7kNvwFNQo12&_nc_oc=AdoPwJi-Wm8KeaujnTXRCQwlm76-yHPGF7S5zaKYr1isjOx70v0ok10JfY6EDxqZjrE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9k5wUWEn_KnbJFr9FtgAp0DUzO_waNNa2Eduz_xCyYw&oe=6AC90CBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6VKwF5PJRY0Q7kNvwGpB6IU&_nc_oc=AdrVzF32U9sV6q_k-_-sCd3ZxGjG4LA8IS6OC58oBxE7FhOIXwb2HKd80GoBJrmuRIM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP7ZlCrRVs3OCThtbXhbgMi43Un2cQH_bxOJP2kHbd2w&oe=6AC9132B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZdiGySBpvoQ7kNvwFElq0f&_nc_oc=Adr6qyYBuinPvXGNiXCLFE16EeqhWYMUsE2YcsgUsaIqqX898XkLETSZ7pa1x0oJzmQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0I6Fmn8qouEMXUzENCMdJJm0y4mz6Oc1tHDxHf1O-zA&oe=6AC8EB52"}, {"file_name": "1440x1440.png", "id": "13054895174670
1769871257146153", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fu4X2P8qMQoQ7kNvwEBMZxa&_nc_oc=AdplRx2fy_rgkFLBHgoK6TUV21zbX9FXeAczN-INGRpkQ9rll7PXn-FGklBM0IsMwYA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zygO51OZltXO4aHW4SF99uQnWJmp2NBIcagU8wokXqg&oe=6A3013B8"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_6vhM5HUg0Q7kNvwHm7ITm&_nc_oc=Adp-2IBeaUvFqgIPu5TY1Bl6Tjjq-7e2EGFU6KkGoRNBxvgJ30gjKxbf6aoTPVpJ9-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R5KSKjJYFg_-KVIpCKuLlc1ZU9nFUDhYP9pKzLWY48g&oe=6A2FF531"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Nv4YSMjP4QQ7kNvwGL2df2&_nc_oc=Adq9-4K_jN5omypT-SLAGmdAzNRuFAMcgSQV0MAw_Py7Q83WIwkiVFOrAyXf9ItkOvk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8et4NGm2Pnh2MEmiBZolO6YT0xlGXRfqDl0N3BitDBCA&oe=6A301EBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0M3sGgfuFYQ7kNvwHZ7np-&_nc_oc=AdoXIGlj9Kf2sX7OUMqLjcoq-2P_gHShLbmO9kysimuSB7WKDH0OpVEFzjnndHkKYr0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UAPOl2Pr4kAhTfEy5XdSNVCMoQ_KZuCvxrn8Fjg-Kyg&oe=6A30252B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26GN3bO9mU4Q7kNvwEQAwFv&_nc_oc=AdoBm49fuFM4kUA1f1_y_I5jJHYMIGMe6H_-e7za6vPhEJhhFu-Ww7Fc83FR3l-GlY8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PxEPz-IU5Ht9uT0hPBX-nCjUg2mqlwgtadR25ne3-7w&oe=6A2FFD52"}, {"file_name": "1440x1440.png", "id": "13054895174670
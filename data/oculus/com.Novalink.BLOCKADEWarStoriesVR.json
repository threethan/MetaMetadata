1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSMxzn54_KYQ7kNvwEv-WD1&_nc_oc=Adp6HpmIjzCSxv_cGpPO5Do6pNoPBeNZA4xr6aa8nfw0P5jnlaNeR5O_kx2oPrZp3Rk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbEgV026QYaf7Tn1zSD4KL4aiNSnxmFneb7CzA8Lh1og&oe=6AB29838"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMzBpvkI2h0Q7kNvwGiEewn&_nc_oc=Adr5qX38CQP751SpDwG5H15xYkj_ufB96GoB9Bn0IhB7v_3-rYTtY-GV2Vx9iKVZz2M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDcVNdJMWstM_D7IELNc9oZIGFwB-s5xNBfcdGse4PWQ&oe=6AB279B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r018kwEjIAkQ7kNvwHXUQ9-&_nc_oc=AdoJqjprZy4pL__bXb3q_qPBGRcG8jdg6mKUf2lhcTK8uiUL1Tu3tOV9L3T3eeE_i7Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIabzMehP7XkmauMeU6vVMvdjx_dYvsi3ZVlQA9YT9L-g&oe=6AB2A33A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBCBPaZJnJIQ7kNvwFvxaVt&_nc_oc=AdotiIuWJ-U_5_KQP4Qy2aITAVYmlxeaB3Lje6mnW51hqHP2dJ3Qm50CnCXLbZB-EyQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbcNQQdrUrTA842_9JqyE1g5Jp3Zky64udWQyTT-0I4A&oe=6AB2716B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwm9fyOxLvYQ7kNvwFzWhfp&_nc_oc=AdrLDtzt8XezqP9ik32ClwKaChTWsPPMSG0bKUyufZPQAN8fCL2V7J2ZQ_Irx6fCTqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjEztxGJ3xoQPH5hN9hJTBOrbKhkYbQVvPsRs4-LPvmQ&oe=6AB281D2"}, {"file_name": "1440x1440.png", "id": "13054895174670
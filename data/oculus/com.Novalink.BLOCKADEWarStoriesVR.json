1769871257146153", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003258_1769871260479486_1127882729978137031_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hRX1q2ezDsQ7kNvwGjd3HK&_nc_oc=AdqphATEMq92VLeMS4Sg1C_QpBTQRpAhjtIv6pXWYF-Yy5TI85GgKY5FFR5ebmzrZP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8Mx_ylvX98zdvf8UWNoQsG-G3SYfX1t9FRCzm3CKd3Q&oe=6A5B9538"}, {"file_name": "7.png", "id": "909783367938141", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468763811_909783371271474_4760231326571529013_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IN2AFER1MoEQ7kNvwFDpNnX&_nc_oc=AdouFbhKP9QYHnjmVm1BvvIInmA7zN_2as2KTIbvkLpDNNC2k9SoDwoOuDALQoDZ31U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPlZwOC4deDjaOOctJXZnKW8u3wg0SjErKEkw5OI4KJQ&oe=6A5B76B1"}, {"file_name": "14.png", "id": "1805811253499246", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031518_1805811256832579_1492887726869773074_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cfqeeg2wi8oQ7kNvwG4w41e&_nc_oc=Ado8BgeX1jjGOo4FZ2phN_k9RdTnM_g13H0M1eC2ywt_lU7Bb2T7A0hyrIfVnax1oPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbpOOD80G8Vo3SyUCq1j_IPR7GpjntD8zjKF7Meosujg&oe=6A5B67FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prev1.png", "id": "646358764386996", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391988_646358767720329_6995225342834474513_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MahZi3v8vS0Q7kNvwEs1Uud&_nc_oc=AdqMFU-vcgUh0VmrI1eMn-2clmN16-5N0oDOpF_dNZqIinlCKzlGx8qdszjU3GS1xic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE573r_QtYfoo0kd3M9o19Tew-gYDysj7Xd39_-wTcEg&oe=6A5B6E6B"}, "display_name": "BLOCKADE War Stories .VR", "keywords": ["blockade", "warstories", "shooter", "action", "weapons"], "long_description": "Experience war in a new way in **BLOCKADE War Stories .VR**. This is an updated version of the exciting game about the Great Patriotic War with full immersion in virtual reality.\n\nLive several unique stories:\n\n- Defense of Moscow - join the ranks of the Red Army to fight for your hometown.\n- Ruins of Stalingrad - make your way through the catacombs under the sights of enemy snipers.\n- Sabotage behind enemy lines - destroy enemy anti-aircraft guns in a night operation.\n- Storm of Berlin - pave the way to victory in the final battle of the war.\n\nImmerse yourself in the atmosphere of war thanks to dynamic VR gameplay, where you will have to fight face to face with enemies, perform dangerous maneuvers and survive in conditions where every mistake can cost you your life.\n\nFeatures of the VR version:\n\n- Full immersion with Oculus Quest.\n- Unique style of the environment.\n- Realistic combat with weapons from the war.\n- Captivating atmosphere and scenarios recreated for virtual reality.\n- Free movement support for maximum control over the situation.\n\nExperience the real emotions of heroism and the trials of war, which are now closer than ever.", "short_description": "BLOCKADE War Stories .VR takes you to various moments of the Great Patriotic War, now with full immersion in virtual reality. Take part in the defense of Moscow, fight in the ruins of Stalingrad, carry out sabotage behind enemy lines and complete the path to Victory in Berlin. Feel the danger and heroism of soldiers in a unique atmosphere created for VR."}, {"images": {"nodes": [{"file_name": "BWS_VR_Logo_White.png", "id": "1345485746816989", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031499_1345485750150322_7180513047162663726_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5IC-u0UZHgQ7kNvwGkKLZd&_nc_oc=AdobjBfF7nDdrBYQ0dwmRHTq06AFtOmtt4tFRnx8hqitQ7MIwpNKyGd2uOhAhkPslK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAidpDy_WF44uNCmLNfV2ciI_-XxPVetox0KeSwqFzEfw&oe=6A5B7ED2"}, {"file_name": "1440x1440.png", "id": "13054895174670
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jBGBr27rt2VY7my-fBWXybxREI-yguKSMtNJogCKzAw&oe=6A0DAB5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud8d7wEWEYwQ7kNvwEvpnHc&_nc_oc=AdoNQbM5Lq_0M6fwuTRQCf29tD7-wFpGfUsFVjlsV8ExU3XnnjmH6DVQlCULt5E9Dc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KtWhJlKPwo7NUie9j1r4BWtetlxUQeD9h4t8GHr8ZOQ&oe=6A0DC3A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st0N0pfCcNcQ7kNvwHJJ-wf&_nc_oc=AdpCSIS8Y816cl9tGQAmX9zy00VKziWlVhp7I4gFmGqddbNkcQL81PNVLZfLHCHyQZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p9A98BLhBf5USXd4P5y8Tmt_qjLxnmmh2gn2z8WeUIA&oe=6A0DBB21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
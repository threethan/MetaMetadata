t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kGcE05x54URfH3SFAmx29QC2k9_fipWEL-FN1Umo-YA&oe=6A341F1E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9dKPIDaOCoQ7kNvwGTOvUp&_nc_oc=AdqO6N35CQW0fIFgF2Ue0naQ9CDuzcL59hqiZU639w93IsIfqo4FE5ZGT7Uhv6xkWAU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HC2lR3gwAdwRi3A_F5ja_VzOMUMdcHvf9S1BEsvRL_g&oe=6A33FF26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdnUYPCePfYQ7kNvwHOAZZe&_nc_oc=AdoelEW62vYwNJaAvyRMC7_ruyRf4alJFHo6AcihkfI-L07uH-cV5zNuowD20CzY490&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bLi8CRyIU5uLQ9s4zE3wlFqIlVMAao5IOy4z5kvsSZA&oe=6A33F6A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
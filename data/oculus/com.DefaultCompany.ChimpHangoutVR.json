t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6Axy4fn-rhnT-5T9D1a9WEUf9Gd96Pdkpb8tChNk84g&oe=6AF88E9E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USJc5gPgtaYQ7kNvwGb3XvM&_nc_oc=AdoiSE7VMFj0LJISg4xOAn9RGIGenZAStz52gQm-nckGkEN6Oa6Bc4quJi6-rtD1QDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThrUqkSRAgQYKcthVls8zUlkfMAFeGwlM5pp38eple3Q&oe=6AF8A6E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxMw-XD3tioQ7kNvwELtUvQ&_nc_oc=Adot4L10DNJT_h0Y8NFxA23OqLmq21s3Q6EqlGl6wYOeaMn2aBBwTa1kwyhHVB3bI74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv9Ph8nuURvkWO3WaXQ2kNQ9fzSft6UA_NUweDdlv1DA&oe=6AF89E61"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8K1qwBbMceC27NHRPbtIB_B2xMzTM03wkluQw1RHV3TQ&oe=6A2FF25E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdjG-Qxbp94Q7kNvwFVHLsk&_nc_oc=AdpC2wWIYO9foNLAfFck7lmR0FbQL9VGpWyc2SsTuBXrZr2qqxvpfqqN_DPSQtR7EFo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81ntwn-KC9Ejfx2HSplm86TUAaHiZtW7yvFjZ0lA73hA&oe=6A300AA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUpox7MVbpgQ7kNvwHUK0Or&_nc_oc=AdprQTJpk9sSQyusHMJgq8SzEqriX-dcErNBSchoo8SMroH709TzmYhxIFuOtB4-JxU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wxr0Lc25YgUwXU55F9nGLunL62mgXRcHnw9Om0kd9Gw&oe=6A300221"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
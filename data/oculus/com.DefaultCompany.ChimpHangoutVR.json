t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe0Nar-bTSnpeoSMEsy7TvT2LRJYGmw8tkEOuddE318g&oe=6A79C65E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ix3vU7CzrSoQ7kNvwGCH1eO&_nc_oc=AdreeaRlPi1gK1ztLeFuqrA9I4IHKCr66hrA3R-i91jRoUT6t_kKorl37EkHu-mtgMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFer_R7UsH71NOlQ06ks-iiWvQeFkPAT6MFxBrrn_V6PA&oe=6A79DEA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niX1l01d7GIQ7kNvwE2kfKi&_nc_oc=AdopRHdMgRMo4Tl86Ap1nMlk0AnmoRqSJaGeKpe3D7j2xFyK_A49qi7_p3g5g-R1i44&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj3MN06Ro25D9OQ5Sp521DgB8_U4PpuGyTjQWRTCWYng&oe=6A79D621"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
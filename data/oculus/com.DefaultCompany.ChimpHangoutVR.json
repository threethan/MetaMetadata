t-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y2msgb589R8Iip95GpeTy6rOtANBfKQ-zdE6iA2wcjA&oe=69E229DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOEeE0S_XvsQ7kNvwEnsWNh&_nc_oc=AdqKpf9AatEMgAYlf0yGTDj5e1lX1q4j8E9Z4r-WshaC5sQdZN3NuoZZcT-16dWo7_0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SbpuYBqZau6HGmCwnun7hLI5TyWEQY0t4Mn_latQ-bA&oe=69E24226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhcWy1MuOr8Q7kNvwFqF0F4&_nc_oc=AdozxenbJl96N7YHqW19HrsPwGZ0a7e1eizpzOdC6NL-DdFwSRbE0F0nC09-1vNTAH4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af103-X6uX6RoYYdgR4i7vwhrEz0g66iz2nwrXyDkNC4ew&oe=69E239A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
TxeeaVkj0Sq-3FJptn2yS3QCGGOh4f3lHt4bkuqw&oe=69B2B3DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eni9MKO3VFUQ7kNvwHMSA33&_nc_oc=AdlSragLH1EcMO3ochWfB6oCIS1ufXlP-iyylVtFkN5G9N3-AVmefdgqXnS5133oroM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzoPQIf7kWbKWygwWnn27AUMsdGlS8QjVCv31uzndwN4A&oe=69B2CC26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPS4MdpGjxkQ7kNvwEPUGdZ&_nc_oc=AdnFAQ3Z_XWVeVT3PXhcKveJ5S0xu0f8mmCHDjo_6MlztiFktSThnyCALLC8oJPRzQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyC7umi0IUTw78lOsrEMIXFbhSqdf-DZyq4V-GTP93r6w&oe=69B2C3A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1faEvJOSdYVeA9mVGJE3ZA_GM2daBpi6kMSUn4jG1
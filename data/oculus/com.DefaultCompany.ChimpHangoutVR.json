t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jDiuHwSz-3JvCDIGxDGstqD1RHB1T4ClB2l0pO_Z3xQ&oe=6A18375E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwSaiGimRZoQ7kNvwG7GrMn&_nc_oc=AdoTb5xF1AxijXQDX8wTRVJyGMw0iyxz9DniSbfFwVKdjgJJoW795p0E2eoO-Gd0Nyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JcTHMwolGv1x9mExXOTbnGKNKDvJyxEiRTc4l9QmLgA&oe=6A184FA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9Ur14ztSmMQ7kNvwF8oTKq&_nc_oc=AdoN43eWEvEyAcb8hQS_R_PpSyJGeh5M4Yj7bzQGwRvcBFkgpuNyrknorJTMMPd30sc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J-Xe6zAkSNNmHF6v9Hrvn5ICFKzn4kIiCuRv9rPvglg&oe=6A184721"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
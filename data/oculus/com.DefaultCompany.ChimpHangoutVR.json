t-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95sPa5Mym4GvALaSVBVGgjALyko5aroJY1w3RF5q09Jw&oe=6A2AAC5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwegoTe8lAYQ7kNvwGosPxS&_nc_oc=Adr-ivtbJODG2ebCyr3_Qe6BSrM4lGMYXasCkp8gKEbRu4oR4F9-aKhkIuxkJvYJj3w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r8ha0iiWQzCHcaC19cqTmOGh7qz3wEZDc290NzM4kFw&oe=6A2AC4A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFecsOvwtnkQ7kNvwF3a7zw&_nc_oc=AdrPmX1OhujggwuGaUB2FO44EcjR8I3ve8YVRuSDsvv2AaPV4xUzkEzybzVzYAQDTWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z-Blnj0VaHzNn6b-GHf7143eQGiKeKXpO-nikTio7BQ&oe=6A2ABC21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
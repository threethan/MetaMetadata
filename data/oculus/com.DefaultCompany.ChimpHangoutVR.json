u1MpR_gc7Hwcu-lfs6uAQLXwpXI3SDmOS8wAyZrQ&oe=69B6A85E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRvnGgpQYVEQ7kNvwGDvLQk&_nc_oc=AdmoVpB8N96uM4NeQ_mI8fm4w8hghAo_xr8kzg7IeOLwgoetGj-RCtHEEI-0nZbWOag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzcm3HA0Xwg9By4N8ovoQWRUBc1GREgmhGr15867ps2vQ&oe=69B6C0A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7-H9xf7l1gQ7kNvwG06cLf&_nc_oc=AdklRqRGBwKdAY4oVkdGK1tQP8KCsU3BR2zFcF_nTHwxyi8NqhlJ-7U6ZarykxZkkx4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw88T6fpYTLKcEla8j6ZMpWkDkdED5SKMKgmNVptvnehA&oe=69B6B821"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1faEvJOSdYVeA9mVGJE3ZA_GM2daBpi6kMSUn4jG1
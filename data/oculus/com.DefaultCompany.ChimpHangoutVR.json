t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaWCKaXxnDODEZsHo67oLDXcmTvOnCWA7F2dEpCM7pcg&oe=6A805DDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpM-Mv-rumgQ7kNvwH4vrIM&_nc_oc=AdpAb4HUdm4jruknLQx8ODufS2FOlOeEwNZJqAnAzbP54no5XGqy0PWyo0mdh_X9FZI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmpV7739FxdBdRCkJhn0xeG7HQtsM7G62C6259vFAuMg&oe=6A803DE6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3s5BSFlFvIAQ7kNvwFV9VqG&_nc_oc=Adpbh7Zz2EjsvnU44sobNWN6FKUBQ0c9FVQIvx5nSeqAlsrZOGrB1OwAqHG214qdYrs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmLBdIQpKoP0ajbsKv6dBWSfDb5hsBuPU3dehL5CzOtQ&oe=6A806DA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
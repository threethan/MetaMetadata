t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GJeLvvmb0kv4yRgD1MGPaJSz991__eteLly3sv2MuNA&oe=6A47AD5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajwM2R279WcQ7kNvwEP9-5T&_nc_oc=Adp11OYjqzAXFqEMx90Ejb-60n4-gDDrdZx7SqBlfQody5Oi3Habf06iUZvbb5TWgo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QyJriSDV0owtMgRxrXJBRG5DiyLF8DewjY6JVQj_pzQ&oe=6A47C5A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yp8sIff3p0UQ7kNvwEqubQS&_nc_oc=AdpaplEJhPxAjB24M0nKxWed7zEGhXFlvMKoMsk1X9EemRRZRbSAvxXgdBDvvgiTcOY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ikWX0PHModybnWT5vSesegeiZqFzNdHo53c0TqNmYxg&oe=6A47BD21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
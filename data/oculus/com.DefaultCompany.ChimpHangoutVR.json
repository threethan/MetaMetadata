t-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CcBUzwnWqn8asQsYvbVPMA2xgW-RJRV619oH7fy4Rew&oe=69E76FDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5_eFQ9XgR0Q7kNvwG80wtr&_nc_oc=AdpB675FxlRfIgMwNJ8m2b_Tw9D0NSMmw4pf8c611ibxg9VH2LWvbFtk8E4lyQ_wD-4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33HlPkSbd02P3VLI7MsuOQKM-Qq6wfUzcnlt7I4UIQPw&oe=69E78826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCCjADEMUGUQ7kNvwFvgZaA&_nc_oc=AdojN7Im6yhSv8bHuu3DLIUTh2fzgVyI2F3qmRpVNjDsQrutauhtSJ9IHe7DE6vnYe4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af102mFGZK0jxvpHpGnMS6DEpINBX5rE-MQi8OIftgPGXw&oe=69E77FA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
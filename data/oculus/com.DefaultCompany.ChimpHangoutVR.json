t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTf-DeBu1LuscC0NpWrAP9oN80rAFK2TCEtrcIVe55cA&oe=6AF5EB9E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USJc5gPgtaYQ7kNvwHM68BC&_nc_oc=AdrI8lUZsXYrcyYT-L0g6wCP7HC7pM7ztvLOrAvVAnJiUCJzVzC2HWW4XgquH2nu4Jc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTroAOD8V9OPOp_3UTMYimgHgA23bflYS95j9oktbyVqw&oe=6AF5CBA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M875_P-3FlUQ7kNvwHeHRc1&_nc_oc=Adrl70ILJYbxZ5_p_7iKGK2HGUmBsTxX5a1k5Wqb6VKYa-12qRF-GUW-MlujiFCxTxE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIkHg4YuCWJPKKATbhunhCM9yd0jg4_GmAw1XTDjpWAQ&oe=6AF5C321"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
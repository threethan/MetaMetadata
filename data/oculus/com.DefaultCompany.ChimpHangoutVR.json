t-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aY-luRn8LHx6TJ5DaiKegCkkJZIk2YNfAdYy7v_T9Mg&oe=69ECB5DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wv9n227WAMQ7kNvwG0vRPj&_nc_oc=Adp1IkiyLCiq2ur39sUCnKpkI721dQksZ3_-zGAVevlS4eUMi06_QYFWOjeoZteMCvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cCfLuMfFdkVJ47nuJp_BeyU8NKuh9wz7wphhb6I_QNw&oe=69ECCE26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHV7F3Uk1RwQ7kNvwHQ35yQ&_nc_oc=AdoNndkrfShZJQVtuhYU-ShHH8OfUBkGsChw6knT1txMzQn_mybGEsgPYpLnApbT6wM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ve1Jln-TNpeoCDdPK54Mj2qU6YX9UjTST0uOdkEyLhw&oe=69ECC5A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
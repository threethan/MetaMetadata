t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZAKMTPO7-h_EO7BZXcvUuOZCkNMlXQXdxHYfsFlhdsQ&oe=6AB90E5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yc1HpvjL4ogQ7kNvwGnQq1o&_nc_oc=Adq9XylMjZn6dmZWUrISpS8yn4YQi1tKJmSz2nWa3UvaWDz-6T5NHFpS9EMLlT0K4co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIWFrseN451Xg-76eIgoW4tmHYCkP0_yIkhyTM_Q44Qg&oe=6AB926A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUT54mJUoMwQ7kNvwHTEDw6&_nc_oc=Ado8TWxNn_RGa9RnZrIvJoHlVi9n568IhjZeYU9zuHp1ntlmTAV03MGJktHOXN3PPqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNUYwVsCE2wkzolJE6SCL6ojp5mCZk1rbkXQwTzQStfg&oe=6AB91E21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8t0HqGwaW8W6Z16RE17gcpCIuHod7tgPLgCHiYzaksg&oe=6A5E16DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMG92jjYoSAQ7kNvwEhXhHk&_nc_oc=AdpQX__-Mkc4PWUX7e0pXIKQEAkZv3NZrrtZ2f8M5pycabmOxFL56HjnJHYqOcs7WPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLenSOSvOkZ8gFBNqNoF6Wx4beW1qtlCkZkAe1cxvgWQ&oe=6A5E2F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gifm-8fJXWQQ7kNvwG8tPPW&_nc_oc=Adqo3Mc1w08zkMW7DPV3YIGGHxbcmc-F2NzDYH5V1vNK_t6kU177fg1g3JDzReg4lj0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIMl5o3xo-eKdbMikdYIzcCRHglsmhnto_6cs_hZDVDA&oe=6A5E26A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
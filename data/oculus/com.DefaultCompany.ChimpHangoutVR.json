t-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AtcyoeUZfEuy6oM0-Kyx_qJO6kg5_W1i0eLvo339DSg&oe=6A1C2BDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJUA33MZ4RUQ7kNvwEXyf_d&_nc_oc=AdqWHqU8Hz43t0EiXNTC4k5xTVD6roTVZt_vXrzo60zPz0NqEd-eokEAR6vAOEkFExo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RK7e_hfOsO8R0Bi2vP0IVZF_It-nVD-SCmYTgpNHsHw&oe=6A1C4426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xky17GsL0QwQ7kNvwFxqCK0&_nc_oc=Adr8v63PUAtyjTdYoWUg_0xtBCq9EAuydYRlKeXWMR2bQZsRwGoW8AYnK_aHKi1OULI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62h6PjgdvLsMqXZCGe1H_S4oQzB1NDlLGk1DMk7J1z5g&oe=6A1C3BA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M2F6gvPZdAZLrRpOSMXjLXrjl_A6VxGzZgPtxB2Kisg&oe=69EB645E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9xi_67JRqUQ7kNvwGZkW0Y&_nc_oc=Adqsr0f8IVtBoSg-vQ0KOs5ZrTESJMzKbxr_BmLmws2x1-8FX9sdsp6U-uL5bj-ZSj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BN0l6AOr9pX_ox83L7fdVpW_OIGCAYnhq98Xd0fm9Zw&oe=69EB7CA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHV7F3Uk1RwQ7kNvwFDuYE2&_nc_oc=AdoYLKiNL8mDmKR7S2c6E6hJ7aDp_NoolRUxuIykLEm6e836sxRYrLRT4u6Q9QaMMis&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LhpKStj-Ox_bkgwsfFk2Y1HIvCxvUKwYQdWQVP3Z6mA&oe=69EB7421"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
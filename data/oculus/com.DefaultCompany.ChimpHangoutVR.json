t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5CsQ3WHiFhffIBn4kjbXLVO5n9UOI9gb6nSVqh3aR0A&oe=6ABFDE1E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JALcxwnsVyYQ7kNvwE16rDr&_nc_oc=AdpXRbhU_sEmRUa8cte6kLo6jnEcYGGFtqyozEr7ol4jnFo7X0nXLU2nqPuhnzenINE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZeSKoV-y1kSJVYGxrYUoBqhxZZ1ml1mYR1Wznrr3mFA&oe=6ABFBE26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kw8csYWkcYQ7kNvwGizWTD&_nc_oc=AdpIAMpl1JN99yGgD3tqFd_DThgKCv7_dvzEwoVOcPat_cGnng40dW3RP6MLVaOZ5tM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbOTm1MvqIk1GnMvXjBaEu3wutoDdt6rJB_Xtr3cg1sg&oe=6ABFB5A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
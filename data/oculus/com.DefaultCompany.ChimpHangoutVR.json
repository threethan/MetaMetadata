t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nJZqvTWGT7nlg7BevhGD0rn7ySvRJgh4QAcBQFKUKtA&oe=6A3BCFDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBjwiU1Rqg4Q7kNvwFYmus4&_nc_oc=AdpNv0LoZS_JHTtvih2l9FPZQ5IAtQsrS5ZDNPlIoqY_88SdqBog2leYgPhySymcOT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lCddew9yVtfcDJqwo1NGgOD7Md7ATMOAvelk9cUkW8Q&oe=6A3BE826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8VIlAaF8ikQ7kNvwExfXUL&_nc_oc=AdpW1AMMRZMaoyORKxpYBGBs-xOfyrXeUHbB2HvtKqeXJSDU6JKhlYngOEyMKbQsYOU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_I8ND9iqdjfLgkMCrAn_RcXmJZOl2EptdQj0Xj8wZEQ&oe=6A3BDFA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
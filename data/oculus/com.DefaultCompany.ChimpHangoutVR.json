t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gsuZA33u8efF7KMV1y3c80_POwub5zNEnweSa6S8mvw&oe=6A15945E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HiMLel4IoAQ7kNvwF0vQCW&_nc_oc=Adq_q-oNs6k8BN7PZfdmFbdQ2Bpo6kfyoWDDuIfZMJNq13ZxCabaPwVxN_oLnk0uCgU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vptHfsAUQ3vRr9Yc-4oUKDBaG1rpldnUr2oHHVUcgsA&oe=6A15ACA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9Ur14ztSmMQ7kNvwHHJevV&_nc_oc=AdpTmlScayZn-qzWH9EKDt0a_7ia97XgPsn4_Y9gVnTX-LOs6dzwWyt1WP2PRs4AML0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GuTyV-4McpyIt3-47DImO-01GXuTdZiJuRehwzzsM_Q&oe=6A15A421"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIHy-dAQp_4ds99nDKYDLL5ZCd7idzWXF5wOQ0vJQbvw&oe=6A577F5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2LwVbhdkX8Q7kNvwGauZst&_nc_oc=Adrm2VuUL8QPx_YU1AITg2XY_8NloVc0nL7FtntU6tbovBxHXbjpBR350wyqE2k4ABk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn2nrqbIrCv3fCl1QefbmCi1QeRcz_-W7S1wYRXzeMZg&oe=6A5797A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCV7ENDC0LIQ7kNvwFUXpc2&_nc_oc=AdqqI5-Rfq046i-Q6tCuEJ_SYk2od_Am5w0KRFQmoOLS6pngXMR5InR4bMC4FkvVbfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiwZexhVrHJZTfh6v9NoTj1Emq1NawTp7DkTQ_yt7oew&oe=6A578F21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZtt2XqvAsl0x894fVw0bczWcUGjxr6qd2PiwyfybMjQ&oe=6A98511E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ips1kQ_4dxoQ7kNvwF-4oAx&_nc_oc=AdoftaYw8ketfO0h9F-ZUlqDQnFGfvQceixnxNfifibCfpDl6CkbIK_e5Ogb0KYuU5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITcM-1zT4B7Cnl_IQqwpL-pAx0aXNSMfOz9_0qzI0s-g&oe=6A986966"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35Tj2niqfRQQ7kNvwFPTUXf&_nc_oc=AdoF99gn0OsD6TaDcVUB-EPzwmXVy36zIgKKjPo8SVk88aHYt_p1nUn2WT5G5runiuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGsqEbtOqEb1mYPteCW1xW_kk9fW1HiK6RvFRnF6ZUdQ&oe=6A9860E1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
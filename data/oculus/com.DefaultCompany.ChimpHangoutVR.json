t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRHNyRmLZ2g1_Yb7KsXp0kPS6R4IRQTB5NurOTCLrSbQ&oe=6AB519DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfqdD7dcRPAQ7kNvwF8tO65&_nc_oc=AdoDEFp6jKoWqbvTcjdcRQkxzLL4GwAue_PfQ145CsZpicwuQkQ8VPsZ1IhiROCX4BY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdGJXDSxoo2pTtU1g-99OWmkTfcTPZG4w9sQmV6eIrJw&oe=6AB53226"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiC4IyIvzcgQ7kNvwHIbsly&_nc_oc=AdoWnCz6uC1zDlxCRnRT0C8HpDVcwXN_UE1sRr6xjLxcZomveqhkGqpO067f_Z1ZWZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_OQZv4uHlXn913Hu-nsc3-nVuWtfEXm9JRbRSKvFTOg&oe=6AB529A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
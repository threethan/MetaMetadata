t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX6K5X5Hh_yQH9zlm4lu1eyZdFcZznSVT6TQwBkDv9kg&oe=6AF73D1E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USJc5gPgtaYQ7kNvwF0P9jq&_nc_oc=AdpsG5vRKemgjXlseORzg0ks6PVCu2T44RYk9VLl2jgx9UPmgqMp5JXhXxkOvHV5F2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGH_i65-gTVCF9i9f2KkjbaOsnyXDB7b2iUxce6NceXQ&oe=6AF71D26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxMw-XD3tioQ7kNvwGkoMP3&_nc_oc=AdrWmB9QY3nsHQWnVbWe3A0i-0l3K92OLyVtzZtdivu2GkJu9baTFcZt4wSTg6_NP40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTI1bJw3yPsBBXD0nUjkCO0OKDSK4f1EPlRte3G0I9waA&oe=6AF714A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XOu55mQmQBKxXW8UZN5m5BODX1GfTzGXul9KdWAZQXw&oe=69DE355E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D0VaHffgw8Q7kNvwG7IMI3&_nc_oc=AdqYaEiQqDaxvyFJNxsvltwdIhCI7phBoOlU2cqKUJWKRlgwm1Up5BMlMoed06aMynI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KXJajD14SqM_ojqsDnEITcptton-rcIqRFrFXMo4OHg&oe=69DE4DA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_dk0WuB6dAQ7kNvwFf3WyX&_nc_oc=Adq6HzpkmY18ymJnG4p_Bv-HCdax4ULZNTZhUtLyDQac5rks1q4KYIzeiJGY6Cepj0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04sqHo4elKrS-7dZTkMZHxl3wxstfxEbc3mvv8c3utzA&oe=69DE4521"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjk9IMUq-2N0RceB-QyQ_9LVqQgp5iX3y-2ogn3L2e1A&oe=6A9AF41E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJruDkoP9IoQ7kNvwHpZPNm&_nc_oc=AdrnTZ8M7KgcfXlv_jv5WRDRbTNo8w5kpH2waUai4thYCjVSBv44Mk8e5ZVgHjQXeyE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3fHtOgkTkDjcMLbwDUjfIDhvRNMf5GxK6LMOCKADbyg&oe=6A9AD426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35Tj2niqfRQQ7kNvwGOQIrL&_nc_oc=AdojeNgCiu9O3aBPOxqf0su81CCiXQwXa7cISarOqk4l3k375X7up8oMcTRcIeOwRu8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4_t_oCp0Trvn1VPS4vJW-9Azxm682rPJNx8AchMGM5A&oe=6A9ACBA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
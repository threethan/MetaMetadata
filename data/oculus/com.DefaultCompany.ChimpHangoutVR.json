t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YkaPmqj8vX-lMTVBuf-mRKcDvKH9oAL-B7CCksQdsGA&oe=6A2EA0DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ebodVo2MzkQ7kNvwFdzPpr&_nc_oc=Adple1QJu0fdCqkhZ8aSJ76Iscg2Hez2mBlGx4-MbMblFXl_ORWaz9Vzk8QuStYfRGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CQZ7jHKbmfJ46Ehc5TU6AosnvwYtNU69KIpfBNpg4nQ&oe=6A2EB926"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mUpox7MVbpgQ7kNvwFZsWbA&_nc_oc=Adp4gJVgieMOz1KmDfSqXRgZtVk2QLmTh9S27ePY7lDs2j1XAXgceaRkTsG1YI6wMJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XfyWt0AU--UIOjPACbN7OFBHZ_caV0W9Mgz-YPhh3kw&oe=6A2EB0A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af20auHpbpkTLMGvkgVRYrZ68Ac8Dxpff-eC0I6bNf7vUg&oe=69F5F05E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOygvbAk6VoQ7kNvwHmvtSm&_nc_oc=AdoGY-rxEz7TwOqPF8Acst4sB88HEUr1ZIiFlFdMfD18uio2poRvCKRqmoXUEYBAZJI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3anrXr569wawsUU4ka-VJ_z8MI6HxrYZwVHvoIoKIdvQ&oe=69F608A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gW6_cUbi_nUQ7kNvwEbVpRL&_nc_oc=AdrPfx650IY3uLfe9RwEzZn5wgETIiRT_KhVolLvnr3jCjjssGyMC-45altAA-_NnGQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2t_ujZu8De3CqjGUpo9h2bez68f0CyZXm92R9GsUE4qw&oe=69F60021"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
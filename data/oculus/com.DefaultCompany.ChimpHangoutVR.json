t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A9_gR4srObBp3uHnP2MfcSiPU_D9E8iwcaZtStc84Rg&oe=6A4115DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zetX8NSci3EQ7kNvwEgaE75&_nc_oc=AdqgKE3oXDPah037xPmBmYKYoxwSs7CV94_ErhvtXRBDlB2aXi5I574yD0Y8M8D2Wxo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OfFx1QGzQd55XzWB4k_qtJdKo_DJfPqu1DkD1ymry3g&oe=6A412E26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uevdMzcPXJwQ7kNvwHsa61F&_nc_oc=AdoNLuMeG5Zk_XB1JYydcgcgPvk6yAWfbtWa7HpIa2DVrRP_8mLAiiFUrPs14E9VOts&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FLR0AufXDD9A2GST5ek-EW4bMAQRaSndSl6bUJquWiA&oe=6A4125A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
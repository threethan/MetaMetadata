t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u147dwqPoUj5AxGeWeyFAAnxN8WzkVxRyEnQN6xqYnQ&oe=6A3D599E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBjwiU1Rqg4Q7kNvwGsr5UF&_nc_oc=AdoY1LTckatuQFTsYQqJqwTEQo-tNrh1RhGgmE_Snl-RfKgo_lmR2jxDH2OsKLVX2E0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O0K961kpvd1HWN41w0d-3ReONC2PEMIzAPJgGyjVP5g&oe=6A3D39A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ywk-LGe-VNsQ7kNvwHdxmbe&_nc_oc=Adp6qJv8extFcDTH_3dr01AYbqYvwNYWJwRuopT4KuBA8GMBZZM8h0bJJFo_M4rNRO8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Izh3Ep02rXMyrYKENqQwWQwikO9Hj1rnmCk6lMwCfKw&oe=6A3D3121"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeCkWK6OvRlxsP0sUHO8PCo9NcUEPNIZGsQZv1xqUjzQ&oe=6A86F55E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLsJ4jGrelcQ7kNvwGALgh1&_nc_oc=AdpZK66M0I9n8-0t7qDY_bONS0uX7AKr9GM0hMjMjvwVTZueOnh_TGgAwdQgPGQd8Fs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9cZ4ab5JA53ThtS3wt21bYCP3IinBXNDfwk99m65xEQ&oe=6A86D566"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG8mqMHpAcEQ7kNvwFjpzVW&_nc_oc=AdqgsmYG7sPB0SNubStWmcED5KqWbfFZDs8IKOuVwKctcUjplB7D9fIBhZXKNBzwzy4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0_8dGsnkryVkP77ki3PVwPeq3ZhqDK9bBpRiQKh1l8Q&oe=6A86CCE1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
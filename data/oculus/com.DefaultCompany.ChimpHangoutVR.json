t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66LsQ62RyBp8K3c-0nCm6Sc954B57k3R2QDY7ce5Qbig&oe=6A12F15E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjDZvhpstN8Q7kNvwHzXr_q&_nc_oc=AdqEy4NwZLni5IEXHlOxpk7hjtpbQAUiMeHQSSqoAa98F4ETVCkFzu5Ei1q9flcXmM8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5imaB-IZGsNfN4KKqO4A2W1YjWbTz-1y6AXEx2itVaUw&oe=6A1309A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLLcQi3w7_gQ7kNvwHC0E7S&_nc_oc=AdqRfv_BVlouBfNMMrXv74avLt7n_TEP_K8MOAmT4AaH_hQZnZxStjy140GvXcj_IEg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QOcwWky-fxU_ZPnQ8kkD6N2xH96VP43S-fBp6LoMIKA&oe=6A130121"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
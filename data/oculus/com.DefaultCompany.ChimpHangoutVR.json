t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWpoiIlQenQqNW8zf-x0qDJytpzPqB0uy8Ts4_YEFgkQ&oe=6AB3C85E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfqdD7dcRPAQ7kNvwHrel3W&_nc_oc=AdqkKr9qYcEAdZJTrpPYs_0e6Y-0eInD2Ad2ehRpA9Wha8nrZUCMcZ3HsZ98a2Krhzk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWV7QVHzFUuXr0qTOlHEsTYzzyyLu92x05Q3S7DdCUhA&oe=6AB3E0A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiC4IyIvzcgQ7kNvwFcpjHT&_nc_oc=AdoAMY7Ku_7Iom9ZtqIOGB_T9nfhwd6qt6F9d2mT3EP0U4otk7TDN83G3loFgoqrjtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLG9zunROGQsdIZV2JWRmd48k7WOn-qdJN75PXi8b8Ukg&oe=6AB3D821"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
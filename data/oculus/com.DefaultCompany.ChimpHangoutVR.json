t-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CL52eK7EpDdsZfepS33o-dn9H-DDiIQZcPoY6I3UhHA&oe=6A1ADA5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwSaiGimRZoQ7kNvwHLmj7b&_nc_oc=AdpdOA6Au0oW8vn-bocI3W1h0QISN8u2pWR5r0Q_nB4-qCXbPG5TQc3f8ox4ujKKBas&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73tCi-2jAqJpT36rcKR2rpIlfcl0PT7vXfkCMw5tvvAQ&oe=6A1AF2A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xky17GsL0QwQ7kNvwGrsYO6&_nc_oc=AdqXzjGWx3PSBKDidN4qj3XcsvDO_9t6pfmIjrQHejONy8aqtvsScULLOXEyPD828Ok&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GZkflIVt_N7iZ9W0gsiPMJPs32MTgcfK-JRZjvSxeYQ&oe=6A1AEA21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
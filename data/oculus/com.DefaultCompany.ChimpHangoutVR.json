t-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsfrQiiXERQ3F9DQzIYwupu4qRm3VgfYE227Qeb73hFA&oe=6A9737DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ips1kQ_4dxoQ7kNvwG5xHmS&_nc_oc=Adqm386sHgdtMhSXAhnj4VPUAAo2uaI11aQMCcgUefd_8Q-QivMMh-FtXGAzp_AOktQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWjs1fUYAf9aQPsXZLUL8vkdKFosk2k_A8csMBAGgtkw&oe=6A975026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpkUxGkWEuYQ7kNvwFshOgU&_nc_oc=AdojWtgqLTFaJsssf2yPISU7o8bdsAQwZ1kks_EMJE5e4QmnrHL5vEb1XleZfRk5OkQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4lPIkJ7nBR2r3qLYWCtLPuni81AK8b38ySzwhebDsFA&oe=6A9747A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
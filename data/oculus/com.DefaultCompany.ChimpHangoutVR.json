t-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypF4S-YKYYFrrTUMOfEiEAO3X7uYgpTtKRssh9uAXvmw&oe=69C3D75E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiNI2ACRiVsQ7kNvwHfd2aX&_nc_oc=Adpz5wafsOza8OKXrkTjwjwWqQu8JwzF139dT_IOSfpVZ1ffAcbAdZ9ZdlC540rX2Do&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwq_QKQYfCH1CR_PhwfI_aRwcjGGAGmJyf6wL0NI3Hp5w&oe=69C3EFA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gu-Y3El4VJEQ7kNvwFl3aZi&_nc_oc=AdoKa51szotbOGTkRjpJTV96o5QFqGVvEkyKHC27wKerShUcIzi-2zNDhQkiPD80wZ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-8sVG04Nz9g3YUKYnpgCXO2WyamLkGLStUfndzoH9fA&oe=69C3E721"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGY7MzH7ubJohf11Bbl6t2tEI2dtZKIeudrPmJrqCXFmg&oe=6A8846DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLsJ4jGrelcQ7kNvwFNc7g-&_nc_oc=AdrSHof0JdnHiHKJjuEvT0ToISKbi-UW6KaMUjBt1fvw6Awu-kss4LJAiHjMDDsGSZg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXtB9ojutD_N4rsYIFcJy2XdwujNNDswNQwXWlzO7z1g&oe=6A8826E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08jK3fB4tUoQ7kNvwHDfg9j&_nc_oc=AdqxZHMyrPQyStmSkvnycXUKY4m2N7JlR3ZTzWaiGSf8JT1wouCOUu_G8Pc3OLy6c-c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA7E5ZBPr7evKcdS0EeLmxkf29fEkD8c6FvUo2LyXcrw&oe=6A881E61"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNit4evHKJ0g_oMeE1btT5PfdY_kVyWhiMm8uAQRvcCqg&oe=6AC7C71E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dK-IKID8T8Q7kNvwEE43ut&_nc_oc=Adoz6vaiSY0hAHP24yn9D8PMa1JWW9jL-ErJPpPy_3OxypFtIiKu6vFJrGEmHypkX_A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw7Fy7Amx-HL3DwVwdFN17LiuFgBVH0opbqBzzpkuLVg&oe=6AC7A726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHsnMcWfZs8Q7kNvwEp4-FQ&_nc_oc=Adp0sMfi_WEyW_zGymSuBPaCuPEMJJbYA-pBuvIfCw9TRuWMN2cn_z6n8LWM-rA7P74&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqQYYmuyU5cy97Qm9z2gbe9r4Q_A2k97R3UENPHv32tw&oe=6AC79EA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
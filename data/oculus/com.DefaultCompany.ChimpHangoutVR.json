t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_C4QyPyXQyMfGHODB4n2EgVQxoWG2UOD8nklTg5pKSQ&oe=6A6B45DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lotv2WqF0ckQ7kNvwGN5Zn9&_nc_oc=AdpAd9Xgl3z-GcnovPb2LLhsH88ujK2WqB8XQdb0FiV1TkR9RRiyuEHYx60FFCfpss8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArYp-TB0vUV709XNL64vt-8tlswmAA1Gx2EAD3SCUp6A&oe=6A6B5E26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivwrj7L3D8QQ7kNvwEyJz9N&_nc_oc=AdoWb-BGZ-7RyY24pX5QLni80-AySCXklKZSkNPtyHH132eq-pLUvIkOFbRsU1Z3r7Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApaNH_553574mqX5iL7EO0CZOohAeOf5gPAsU8B3G9IQ&oe=6A6B55A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
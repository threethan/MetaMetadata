xsPeQNMpBn3-bMh8Cnte2Id87Zzcz7G0eg8BlusFcbkA&oe=69AACADE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BUEWLEXOBIQ7kNvwFIif0e&_nc_oc=Adlrcf2Vq06VGlrnoJ8qggtfXXKW80aZ2pfi-iI4vvEXIt3axGRmddgY2zeybVR4UoE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw19vPUUi2kG1QF0vf4UareFm8-hmP4J_sgTFgZoBcGcg&oe=69AAE326"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K6Ufp0DE-oQ7kNvwGkENcO&_nc_oc=AdkOUB3XF5ItAPeQlY5jX8J-RI9h6rk3pdFELCWUo6SQUb6H6ClPWHvcyRWtf4zS5Ng&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzolpapCy6owXP-Y0DRFpDhdvs7a0nGWHm7YMdtyHrqhQ&oe=69AADAA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1faEvJOSdYVeA9mVGJE3ZA_GM2daBpi6kMSUn
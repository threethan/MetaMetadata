t-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABM5JBuc-K_iPkX3UCuRkLLiQlB6k-OFWH3Fkuw9tsHQ&oe=6A54DC5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2J344xXiLkQ7kNvwG6KeJv&_nc_oc=AdrZwQnEY3MVEhemJKAg5qpMI8aljlAAGxUj0Yl_1ERRo5gwJXt4bn1H7T_LZASGAL0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUfYGCmUbQ1ir0l0TiR4OwaGLK40Sgc18SqfIpolxTgQ&oe=6A54F4A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCV7ENDC0LIQ7kNvwHjCR9B&_nc_oc=AdrAeNmRSl-wYgZrdN4YzwTLN_ggZbtwVh9icUxKtQW4C-1xkiPvKymm4Ya_HeKnBRU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAncfeSPG0zIigPQmjcnW3Tz5nIsVpZ_Au0xOnduL_0cg&oe=6A54EC21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cgdfG8JEeZTe9kaGTY5TAmyjG1SEpiK7-OYEHNzQL0g&oe=6A031F5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU7tomoe_aoQ7kNvwH8Ne3a&_nc_oc=AdpTHkkubRkaCvLKm1fyuIGuz1IPV9Dqt1SMhLQdS501bUhukMBbVWn3gcemJIe6Ojo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Q7IlttJytbuu2erAa8XQ1xZZ3qJAyPxC60ULEIuK_4A&oe=6A0337A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMNs8e1YdgsQ7kNvwErpA13&_nc_oc=AdriPAcVJk1oq-yUeuEw5XBFyiTNE9O2owNy8WxGo393MFb2qhyuJ4d9Al_wK3UOL6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B2T9LzvBxMcmp_b8E4i79SkpyTtITY5eE2skpGZ0r1w&oe=6A032F21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
t-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vq6gF8FKy8TT1-gklvPSiRvZvUKu0d2O591Y10KdmyQ&oe=69FB365E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asK0HiarXGwQ7kNvwE6Pan4&_nc_oc=AdrH0mzq-l9klaF4SJKjj6El5mKt6bnsnLqR8IgcsrN4fvsM43DstopwsruFhBDj7ZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ak3tmnB4V43RZXKDBM3hC1ll0-kcUyx80MtnPxCvsUg&oe=69FB4EA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHqT8pJTxzMQ7kNvwHL0Qdx&_nc_oc=AdqCiS-8TVXyHtSWRTjcxCUJn7pXHk7og034rXxEnZ7e_wq4A8XRKVqzsgQIP-Hm_GU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7I0Ba-xJpUD3_H_OBJNPXe9cQppAXuEM9xZ_iGpRIHtg&oe=69FB4621"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
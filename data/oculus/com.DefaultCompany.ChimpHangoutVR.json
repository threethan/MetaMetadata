ntent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wWHJxHLaCUc83J5pQq3J8g7SMNugSrcsOW-8yU4ba-w&oe=6A119FDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjDZvhpstN8Q7kNvwEw0Qlk&_nc_oc=AdrL1qPZqljfEc7E_lcoVpG57orOteBYGDbZHB0RNKdcdpb72wf_2xgH-NviXTPltdo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ChT-lYm1F-qdRxVFqCeazufVJWyMWSsR8HORo_CLdsw&oe=6A11B826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLLcQi3w7_gQ7kNvwF8N-xe&_nc_oc=AdofHuRvw8pJCXfsEPRnVNTnWUvr2DkYc-7MkXVB1tb8_gvXf7DNXFy2eg-4rMM61PQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72kcwNCXMjWZeOj7O9YydQvs7hsIKHLyL-U7JboVJGcA&oe=6A11AFA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.goo
t-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UE4Nir1I0uyeM4ucfdtEm1aduwnV2MlkLq45ln7JTWA&oe=69DB925E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPtXiH9Rn3kQ7kNvwEOkMei&_nc_oc=AdrTvckUdbVbqELOfJN9Ew2D380HdcBz1YiD68hMT_JTxdsfB7HVHnsXuBxyM1pT26k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P_UPtWrzhMIL6qnn2MIKJ0pRnorXqWQxVUb2DD5fI6w&oe=69DBAAA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHpvYjS5RI8Q7kNvwH7xd5J&_nc_oc=AdoBvrPT6KSknZsLknLpJxbuH1hSXwiSg8cD1VgdP-DvncW15cVSdcsloAzYZx_5QJk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iYtoMypiZUDVRETsQpt--rpIMJco61ClYFr-MAYqNXg&oe=69DBA221"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
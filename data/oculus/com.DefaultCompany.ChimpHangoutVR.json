t-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiKDH_E9Hny2FZnWQqWRW9Hf6oOkqEL0x8ZbqyrF4szQ&oe=69C7CBDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUHjUZtCJpMQ7kNvwH0iszn&_nc_oc=AdqRhF6UY_MWisbiWo3xWqY2cujz-v2wPc0Hf6VCR0MzouKigTFEUy7Nm8fXELv2CS8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4XhANSOBIw5xqTSZIWHk0to0IFjXl1EpFQbHywi4ZIg&oe=69C7E426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mpzYtOWrGYQQ7kNvwGtgi1U&_nc_oc=AdoeqUS_qT4txe8GISzqmfnfL4WKOnyH4-FcTrTFeV68PZs5kX0p3Xg6p7W0oZ_Qd7Q&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1fdGFkFQ6Ga9kRevC9Xxrim9U9Mfp8wY3z02Nr9GRRA&oe=69C7DBA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
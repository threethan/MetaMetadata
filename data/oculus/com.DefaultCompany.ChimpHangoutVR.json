t-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55rwOy9-x3VsdmOkz31_L6uasZv9_sQ9arU9Ux0k1POQ&oe=6A104E5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjDZvhpstN8Q7kNvwGRupG0&_nc_oc=Adoq78GFViBmFl0bb85cJbt0sB0TRzef-B8rEvVYAo7WqalM308vd4IvW-v1-uaDyvo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vvSRbjNKypuOvqAArHxhaTMssP9OcOnOAsZdFNz1KTQ&oe=6A1066A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st0N0pfCcNcQ7kNvwGgY0in&_nc_oc=AdrSc_iQiSfU1utvezDPHPgbhKNlW3n39ldhhS30eBiMyvwgnxVZnm8W1ALEG1VddyA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lylxFLlnC8r5SdeAqVIjri4KQjDA7PdRhi8VpGwZJFw&oe=6A105E21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
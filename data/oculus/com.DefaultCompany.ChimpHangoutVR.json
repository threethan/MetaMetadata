8wDe-sd96McaEd9Ol86BafDxm0RD2OQH8fkyfORg&oe=69B556DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRvnGgpQYVEQ7kNvwF-QUwK&_nc_oc=AdkWGpUyVgV52VkGlJiQtTWas1brJf2yk6aZ_4xarIYiJhFfSJKDU0glMqLWZt9vToU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_EFLNrMbJErbMhDYpzBYpFy2d7dXAhaD2jpDLKD_Cmw&oe=69B56F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPS4MdpGjxkQ7kNvwFObj5k&_nc_oc=Adk_1KLriZgfgOVVZfsREDl92O5Sr0HGECnitHOsoOLrmx_Pqe55Ckf0UBYboQLD3NY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRgpjiKCJQrs31ZF3HZ9_90DcxJ9EoVS0Qis4SgtBP-Q&oe=69B566A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1faEvJOSdYVeA9mVGJE3ZA_GM2daBpi6kMSUn4jG1
4iE9I5jm2C4MbqXWZnxYI2i0nu2y48CgCk29MKGg&oe=69AEBF5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E31piR8Ox_IQ7kNvwEg_pbj&_nc_oc=Adn4jKTD1tnTJyAO5RRisJRAnTk3uCZXEq4aaP79h9ExOFNLJRuFSdXxyjSafVVBn0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxglKUt1ftHrewyOCrEoZ4c8VhlCJGxFXd8mRQhNiWyAA&oe=69AED7A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXzbhWhpMdwQ7kNvwG2ODTw&_nc_oc=AdlOy-QOp-t99PS7nnztbYloHeHqE2g5WlZy93pZhRmLHKAJZwEl9Guq8X5c91elvLs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_X7OOJQsBaxJO_ZDRZnc3cMvL3rgVwEE3bb0HccEFVQ&oe=69AECF21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1faEvJOSdYVeA9mVGJE3ZA_GM2daBpi6kMSUn4jG1
t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzSUay5W5xQJfWFra2wX0_YPcJM9MDaLWDCh4zMGY_4A&oe=6A708BDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-1c_f9T1twQ7kNvwG9q6kM&_nc_oc=AdqmWgd5mRoCrWXocl2GC4T82mXbKOE-iaL7s2iTEVvRy2Y1-ZrsbKAB7uG-578_COo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGURrQr7F55Um8ayH5g8CPo6jKDNGzBQGd3uen6lj212w&oe=6A70A426"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gs9mPjpvV6sQ7kNvwHxJZp9&_nc_oc=AdoEbBFZwJRG_LzIDyuLGOHkexH7GDgjiEeA9rDdimgYEYu1RIOuwpDO0vEyWMFZt_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF72aUYI34qJ3C7OEomGeJWze3NxhTNPGW69y9A9zSIOQ&oe=6A709BA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
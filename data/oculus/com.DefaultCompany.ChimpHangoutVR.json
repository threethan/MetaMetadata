t-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UDv-ExIHz6UKMWv2_4-ctLE9bM2mDPy_YfgTZAPt3Cg&oe=69E61E5E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5_eFQ9XgR0Q7kNvwHSLEId&_nc_oc=Ado_Biz7kyuZJIkNMPVVt2fIuV5f_QpXujTENH5wohp2v438xO2c-pxUy8uTDArOU1g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3axaIhhvjL3af6I6ycqm7x9SMUHx3lKFhNclqRfsuyhA&oe=69E636A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UCCjADEMUGUQ7kNvwH1NJz5&_nc_oc=AdpOo1nTI2dDKEg9yKflssSSBXny6_SfX4ySWm1ujqOhfYyj9C76gBzlTAZdOFhtFa0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zf5kDdQIsuezS1SUYLRKWMw6d26q15xoUkQ1KpyAzww&oe=69E62E21"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
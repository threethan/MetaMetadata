t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU0ZnZ3XBL1S-dFN_slgrd-1UsiUALRyR-mFHtZM6zBg&oe=6AAA8DDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXPwJposBJkQ7kNvwGL8B3Y&_nc_oc=AdqpH773wlovTUwDsYuD3RJeW9Vj06UPkvv1o2wCs0TA4nOfK9BHvhDsHrg0qNQm1Lw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZcfa9yMj0Hh-zWcwh4xlM7xrJ-Hc3PRGuKVtXJ8NdvQ&oe=6AAAA626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Erk22scxHGwQ7kNvwFxm3NF&_nc_oc=Adrw5MG1xaVpShe3MkwUU4x2YoejzO5pKj3OFNxkRDUJ7hJXG10EouFQIrRaHE_NaEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJovp_NOck6RB5tfhbu6T35jXAeOeI8R-hKCN6bJJPuQw&oe=6AAA9DA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
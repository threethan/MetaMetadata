t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI2iNr6wb1BU2HNL7YCTXK2NXJemZb0J4PynU9JCVpIA&oe=6A48FEDE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajwM2R279WcQ7kNvwHHEicD&_nc_oc=AdokhkIPR7O-cFbpHAqBPYk76R45006EkAAPuHw9U1CiOHSWbuU11dvjE9sPODqc6UI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU3QYBl1PCp7tvf2TvTrLR-3ymr_Hag4eLXhTUzGwmeA&oe=6A491726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pyzVD5YLTnIQ7kNvwEOdznv&_nc_oc=Adrl01qnD1No9tMYuxgIwvuXgn0cWsoP8FXzPB_Lhq1kQrvUYd6-CV6ZYId9mFJNUwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1x0Slt0KPYrn4yJxNOt6LE_H4N7B4v41dDP3WMrCI_g&oe=6A490EA1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
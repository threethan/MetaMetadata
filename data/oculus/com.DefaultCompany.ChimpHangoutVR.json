t-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yIrgsqojkU0KBmU2DxqUknM4E0VdUuqJm6s9khmpNjA&oe=69DCE3DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D0VaHffgw8Q7kNvwFaNPRo&_nc_oc=Adrwpt8UilU_Xk4R3UGoW3bHbQ6b6MGr7s8OXkJSfJqW7DwEectEta1bC-45Vx9CX50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xaqHMXmTxe_6Y_6gfxqQ_mBYiPq4XKqL4qSRaM92-kQ&oe=69DCFC26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHpvYjS5RI8Q7kNvwEe5H07&_nc_oc=AdoKisb2-hd0S2zLDwjn5WNNbW7Re9FbFdjZLqhdNff0YgNFJOSyw6ffk8-6IHdNFGA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gVLcTIsUuooxmfo9p6enSC5hTCvPT2x2wLtB_37mH7w&oe=69DCF3A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
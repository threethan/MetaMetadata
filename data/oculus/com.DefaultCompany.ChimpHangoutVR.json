t-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhQwPn5ZgqXMnnaX5yur3SRzc27smU31DANq1_r0EF4Q&oe=6AA1535E"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHAvrlFs10cQ7kNvwEBlRl5&_nc_oc=AdpdP3v7rWjBdmLHO1qPSNytvVs4VdJqEET_yn6X9g9aMkUHyd7n5VyPjisVVw_VovE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ1s_rBQIx__B5IP_qx9E1i9Dte2lVM_NmjmvcweVlnQ&oe=6AA16BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_m_97qr8JoQ7kNvwEalAWf&_nc_oc=AdrNQ0icqwE0wLAIEtWxLatWuAPgec8w6UUIFMACRn2ZW7NNBISPcZqg2TAojQ34BQ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD0xoDn5l0U8AM-CA31iBdC8nDdkUb0qGCizTgIvBtUA&oe=6AA16321"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
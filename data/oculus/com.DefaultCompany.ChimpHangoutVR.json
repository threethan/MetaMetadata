t-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1693JPUisGtRl0vElQBLpcle1-_09VE0omUkUtIs1lfQ&oe=69DF86DE"}, {"file_name": "Untitled image.png", "id": "1834676123623265", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75254873_1834676126956598_4787725423183440380_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7D0VaHffgw8Q7kNvwGfNbyM&_nc_oc=AdqRZy1f6e3AVKpWjcJNIV1-bCWybQwYWnw7jd7_nH_eY0Q6xGWi1QNX7nksYYybeIU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qZy1_XSR1Meqs2aigJx4NDwzlfsJIiB2_nt35nctmCw&oe=69DF9F26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled image.png", "id": "1060740768351551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982691_1060740771684884_3692842886573816601_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_dk0WuB6dAQ7kNvwG2xwql&_nc_oc=Adrq8PzwHYafiJvBXtwG_HagU75XLFTYj7DUuz-YWYMyJmhmIGFCyBdHJEiRdH5VuCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0p5OuJtsBNvGC-F-_tTb3es9gwI_30yQVDWagM33aWTA&oe=69DF96A1"}, "display_name": "Chimp Hangout VR", "keywords": [], "long_description": "Chimp Hangout VR is a Gorilla Tag Fangame. There are many things to do in the game such as Only up, relax and chill by the campfire, or explore the map and the many things the game has to offer. The game gets frequent updates, and the updates usually add many new things to the game or improve existing things. You can play with a friend, by yourself, or with other players. The game is a very fun game that you can play and relax especially after a long day.", "short_description": "This is a Gorilla Tag Fangame that is meant to be fun, social, and entertaining. There are frequent updates that add lots to the game every time. There are many things to do such as Only Up (many levels), or just relax and sit by a campfire and talk with friends or other players, or be adventurous and explore the map."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.
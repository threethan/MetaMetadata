gU_9Kohby0p_R_cbfq5xf6hykIFiKUEDdGlrRWY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0Lt4P0Go6u2KIXUJikdbBiDk8L1piP3dcyFbJ6VdGWA&oe=6AF9E14F"}, {"file_name": "WeaponVariety.png", "id": "904392862075806", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499296119_904392865409139_7994271531177102502_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsP7rLhR2b4Q7kNvwGYF0o5&_nc_oc=AdqfQ4KGb299Q5BhyvN0GSklO7JmwGI1qshUBZRof_q9X39-T6Lq3y7YyuRt6rahsfU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST6wrGLnOZ8DLERce6NOvsA0qNcZPtHShOtgptGoTB0g&oe=6AF9D2C2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "\u200b\u200bBUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\nBefore each run, you build the battlefield. Design tight hallways, doorways, and room layouts to create realistic clearing challenges. When the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies take cover, react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\nWeapons feature realistic handling, requiring you to aim, reload, and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into the battlefield.\nBuild it.\nBreach it.\nClear it.", "short_description": "Build & Breach is a mixed-reality CQB simulator that lets you turn your real-world space into a fully customizable combat environment with Mixed Reality. Design rooms, place doors and furniture, and run dynamic clearing drills against AI threats \u2014 all inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25316770294646681"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1651550899755819"}, {"status": "PUBLISHED", "id": "988604444282224"}, {"status": "PUBLISHED", "id": "1439432625026033"}, {"status": "CANCELLED", "id": "1101783745813429"}, {"status": "PUBLISHED", "id": "1062258036203483"}, {"status": "PUBLISHED", "id": "1276486661330252"}]}, "baseline_offer": {"id": "1439432625026033"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1651550899755819"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28916039011386440", "version": "4.2.3"}, "id": "1302681891616081", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916039011386440"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "4.2.3\n\n\u2022 New SHARE USAGE DATA setting: sends anonymous usage and crash data (no account, audio or room data) so we can fix problems and improve the game. On by default; turn it off any time in SETTINGS.\n\u2022 Better performance tracking, so frame-rate problems on your headset can be found and fixed.\n\u2022 Includes everything in 4.2.2: new scoring, the ALL CLEAR call, Daily Drill streak badges, rounds through scanned furniture, full mag pouches every round, and SNAP TURN for VR.", "created_date": 1794365533, "id": "28916039011386440", "version": "4.2.3", "version_code": 437, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916039011386440"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "4.2.2\n\n\u2022 New scoring: harder houses are worth more points, and a cleaner clear keeps more of them. A PASS always ranks above a FAIL, and time only breaks ties.\n\u2022 Call \"ALL CLEAR\" by voice (or use the ALL CLEAR card in the menu) to stop the clock and end the round. Call it too early and the run fails.\n\u2022 The tutorial now teaches the ALL CLEAR call.\n\u2022 Daily Drill streak badges for days trained in a row and passes in a row, on the leaderboard and in your Training Record.\n\u2022 Rounds now pass through scanned furniture and other room-scan objects, not just walls.\n\u2022 Fixed vest mag pouches sometimes starting a round empty.\n\u2022 New VR setting: SNAP TURN (off by default).", "created_date": 1794339461, "id": "28911995288457479", "version": "4.2.2", "version_code": 436, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916039011386440"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "4.2.1\n\n\u2022 Shotgun loads one shell at a time through the loading port (no more endless reloading), and each vest pouch holds 8 shells.\n\u2022 Pistol held with two hands stays steady while you move and turn.\n\u2022 Knife hostiles no longer get stuck walking in place behind furniture, and NPCs who surrender stop where they are.\n\u2022 SAVED ROOMS tab in Standard Rooms: play, edit or delete the rooms you saved from the debrief.\n\u2022 Add friends straight from the Daily Drill leaderboard.\n\u2022 Standard Rooms show each room's best player.\n\u2022 Scanned room walls now count as drywall: rounds can go through them.\n\u2022 Build mode's button hints point at the right buttons and no longer stay behind in the room when you test your map.\n\u2022 No more stray white pointer during rounds.\n\u2022 Room scan explains how to allow spatial data when it's turned off.\n\u2022 Smoother performance during rounds.", "created_date": 1794238992, "id": "28894947400162268", "version": "4.2.1", "version_code": 427, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916039011386440"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "4.2.0\n\n\u2022 Daily Drill: a new mission every day, the same for everyone, with a PASS/FAIL result and a worldwide leaderboard.\n\u2022 AAR Walkthrough: replay any run at full size or as a mini model, with tracers, grenade arcs, callouts and the hostiles' weapons. In squads, the host walks everyone through it together.\n\u2022 Secure innocents: order hands behind backs and flex-cuff them. Innocents must be secured to pass.\n\u2022 New enemy: knife hostiles who put their hands up while they can't reach you, then charge the moment they can.\n\u2022 VR mode on Quest 3 and 3S: no passthrough, joystick movement and turning, Guardian on. Choose MR or VR at launch.\n\u2022 100 Standard Rooms in five tabs, including full house floor plans and public buildings, now with windows and counters.\n\u2022 Every NPC voice now has its full set of lines.\n\u2022 Rifle rounds stay on their line through wall joints.\n\u2022 Steadier guns while you move, and the muzzle no longer pushes into walls.\n\u2022 Fish Bowl's random houses are furnished like real rooms.\n\u2022 Night vision shadows are softer and easier to see into.", "created_date": 1793999707, "id": "28857133903943618", "version": "4.2.0", "version_code": 417, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28916039011386440"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793946048, "id": "28848122021511473", "version": "4.2.0", "version_code": 416, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
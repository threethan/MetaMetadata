cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwBGys6CkEQQ7kNvwHhD4k3&_nc_oc=AdpS-FYl6c12eNaNmZ4cOIn-piuG_hCWLtXKVRgeH8FNR42wctnyjopKnFSfKZZ5unA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGghlLdNd-StjPLgGS7CW9JPSGYI4n0lImR5oHPOLqHGw&oe=6A8593BE"}, {"file_name": "Debrief.png", "id": "762054886950830", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499296119_762054890284163_1698398193266029600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=41fNWufGIW0Q7kNvwHobTeJ&_nc_oc=AdrtsA-LyphyZptJDIGdpYX5XZFxW10Dcf443wu_0X3AlXXHFpWBDuwCwcPObk2wbN4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPlNiWVpwD-nD-L3UIQdtsOJikoMSmPcFoqlJmm-jSxQ&oe=6A85A50F"}, {"file_name": "WeaponVariety.png", "id": "904392862075806", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499296119_904392865409139_7994271531177102502_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NOm3__cwHRgQ7kNvwERuXxt&_nc_oc=Adr9nmzuejYHE2cXHD8PfYvMaoKqNNLLZwO1odR8aDt2BjdW1DzjND0KoWwZeevmUiM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6uz5GvDZuF7rkeUR5RqglFp6sDDj5vkC88ksltJfvWg&oe=6A859682"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "\u200b\u200bBUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\nBefore each run, you build the battlefield. Design tight hallways, doorways, and room layouts to create realistic clearing challenges. When the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies take cover, react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\nWeapons feature realistic handling, requiring you to aim, reload, and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into the battlefield.\nBuild it.\nBreach it.\nClear it.", "short_description": "Build & Breach is a mixed-reality CQB simulator that lets you turn your real-world space into a fully customizable combat environment with Mixed Reality. Design rooms, place doors and furniture, and run dynamic clearing drills against AI threats \u2014 all inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25316770294646681"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1276486661330252"}]}, "baseline_offer": {"id": "1276486661330252"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776265380, "status": "PUBLISHED", "id": "1276486661330252"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26848270201496675", "version": "1.1.0"}, "id": "1302681891616081", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26848270201496675"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786284424, "id": "27674339068889780", "version": "2.0.4", "version_code": 92, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26848270201496675"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785768864, "id": "27600371736286514", "version": "2.0.1", "version_code": 52, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26848270201496675"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785094772, "id": "27511202451870110", "version": "2.0.0", "version_code": 51, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26848270201496675"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "Release Notes\n\n1. Saving (NEW)\n  \n- Save your custom rooms built in Build Mode and load them back later. Walls, doors, furniture, and NPC placements are all preserved exactly as you left them.\n- Each save captures a live thumbnail snapshot the moment you tap Save \u2014 what you see is what shows up in your library.\n- Name your rooms when saving, with auto-suggested names (ROOM 1, ROOM 2, \u2026) if you don't feel like typing.\n- Overwrite confirmation if you try to save over an existing room of the same name.\n- Load Custom menu lets you reopen any saved room and play it again, share it, or keep building on it.\n- Invalid filename characters are stripped automatically - name your rooms anything.\n\n2. Pretend Compliant NPCs\n\n- New CompToHostile NPC type: starts in a surrender pose like a civilian, then flips to hostile and engages \u2014 forces you to keep eyes on everyone you've \"cleared.\"\n- Uses the same combat brain as standard hostiles, so once they flip they behave just like any other threat.\n- Configurable timing: 3.5s before the weapon comes out, 4.5s before they open fire after the flip.\n- Shoot animation restarts on every shot so the visual and audio land together.\n- Added to all NPC randomizers (spawner, fishbowl, per-NPC random toggle)\n\n3. New Room Scan Menu\n\n- New MRUKPrompt screen shows at app launch with two clear options: Scan Room or No Scan.\n- \"Scan Room\" always launches Quest's Space Setup so the room model is refreshed every time you opt in \u2014 no more relying on stale cached scene data.\n- \"No Scan\" skips the scan entirely and goes straight into the menus.\n- MRUK no longer auto-loads on app start \u2014 nothing happens until you choose.\n\n4. UI Improvements\n  \n- First Time Ever screen now shows once on a fresh install, then hands off to the scan prompt before you reach the main menu.\n- Cleaner startup flow: First Time Ever (first run only) \u2192 MRUK Prompt \u2192 Welcome.\n- Tutorial remains reachable from the Welcome screen.\n- Menus now use Vertical and Horizontal Layout Groups for consistent spacing and alignment \u2014 buttons stay evenly spaced as labels and content change, and panels lay out cleanly across screen sizes without manual positioning.", "created_date": 1780180734, "id": "26848270201496675", "version": "1.1.0", "version_code": 50, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26848270201496675"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": null, "created_date": 1776252736, "id": "26309523355371365", "version": "1.0.0", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
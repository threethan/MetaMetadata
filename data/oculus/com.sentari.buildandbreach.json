c_sid=6e7a0a&_nc_ohc=1swBTE1yYQMQ7kNvwEt_DlB&_nc_oc=Adr09_Np4z_LXp74zl3S-UAIQq0Ti8oHvPd_jfo3PDSgkdhQuAGRiF631-0gF-a_kqI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOntogKnY4jkc-GdPUwtI0BguPVRO73Vu4EYTL2lW34A&oe=6B05C8E2"}]}, "id": "1755637032175888", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2026-10-18 at 23.05.57.png", "id": "1081612658017640", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620316_1081612661350973_999627746394716909_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23U6NUfeLToQ7kNvwHDxYQi&_nc_oc=AdowFJ46G7hAaXgZL65UOdwHl9v_M7ID2UpYiB_QFFUWc_7aiuurABfjdsM-blqcLfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk1iLm_mObBz6lPAM8LeKFNWXCezBZZP_lRUFrOJ5Geg&oe=6B05A5AF"}, {"file_name": "Screenshot 2026-09-30 at 15.04.07.png", "id": "1431075528447544", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623551_1431075531780877_1544016155164020523_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dBbcgN5cNsQ7kNvwF9nHMi&_nc_oc=Adr8QKvS_KrupDsVkSSVL2qRJSWDUvCJuufN15DTzsRxcVC-4huqprs0m4yC5qScOYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTck0ZYqZnXR_0CLzFoW1jUTV6QsUHoSgkwFGxpi0JCiA&oe=6B05D1C9"}, {"file_name": "Screenshot 2026-09-30 at 15.06.13.png", "id": "1073215405693457", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620341_1073215409026790_3770892558860514772_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCoGKh0da9cQ7kNvwHbjc82&_nc_oc=Adq2yEgAYyJN9n1YkdtwIjazKz4ONqjTz6FViXtaQDlfpEr1LCrblkkxa539-uRRKA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfpPR1-lz_mabK6Se06gAGVlNICzxJcv7HnKUig3aOyQ&oe=6B05C328"}, {"file_name": "Screenshot 2026-08-09 at 22.54.34.png", "id": "911361774826141", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296288_911361778159474_2938811641857589033_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_R7Qk6NOw24Q7kNvwEJoFyd&_nc_oc=AdpNEpOG96l5t73McYAMA74iZo61_JnU_ZM4NA7LboO8QmOe7gBGTiOqGN7ATcB0wV0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSD9l1Lf4mzfzybj-_doF0aCFdoyHu8SejtmHi_xxVBw&oe=6B05B8E7"}, {"file_name": "cf26b02d9fc34647bfef51630f4f4320_2560x1440.png", "id": "935951815915965", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499293669_935951819249298_7309390341385885752_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwG6ie0N9doQ7kNvwGAqM56&_nc_oc=Adr4nYwEAkijfnqb7N0jigB9S7LaTbMSDU6ZQCTLWe5VcSWn_TPmbLdwXOJgEB3yeb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxraarulrTqjx0ctKfHXlEFy3VtkM8LRTQ8sD9qArlmg&oe=6B05C4C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Horizontal Thumbnail.png", "id": "1568157238688292", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623534_1568157242021625_5845514094167699709_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4x0N1k0BhYQ7kNvwGijrpF&_nc_oc=Adq1hZwBauyzdbHgiUOXyKhV4D2coWZhdXMwRZUDcm-X_SdyQqtN8wt6vxRAbwuX_nM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP8utMoBguxOy1qJCPq2CiVEHC5w3_FSvrAlfj7dAAZA&oe=6B05BFB4"}, "display_name": "Build And Breach CQB", "keywords": ["CQB", "Tactical", "Shooting", "Military", "Training"], "long_description": "Your house just became a shoot house.\n\nBuild And Breach CQB turns any room into a CQB mission in seconds. Stack on a real door, pie the corner, and breach. Nobody knows what's waiting on the other side.\n\nTry it FREE for 15 minutes. Your progress carries over if you buy.\n\nNEW IN 4.2\n\n- DAILY DRILL: one new mission a day, the same for everyone. PASS or FAIL, and see where you rank worldwide.\n- AAR WALKTHROUGH: relive the run at full size or as a mini model. Every shot, grenade, command and hit is marked. Squads review it together.\n- SECURE THE HOUSE: flex-cuff the innocents. It isn't clear until they're secured.\n- KNIFE HOSTILES: hands up while you're out of reach, then a charge the moment they see a way in.\n- VR MODE: no clear space? Switch to VR and move with the joystick through houses, offices and public buildings.\n- 100 STANDARD ROOMS, from a single center-fed room to full floor plans.\n\nBUILD IT. Draw walls, doors and windows in your space, add furniture and people, or let Fish Bowl throw a new random house at you every round.\n\nRUN IT. Hostiles fight from cover, civilians panic, and voice commands run on your headset. Go in on night vision. Rounds tear through drywall.\n\nSQUADS. Up to four players online from their own homes, with built-in voice chat.\n\nNo range. No facility. No excuses.\n\nRequires Meta Quest 3 or 3S. Mixed reality needs a clear play space; VR mode does not. Squads and the Daily Drill need an internet connection.\n\nBUILD & BREACH: TRAIN ANYWHERE, ANYTIME.", "short_description": "Your house just became a shoot house. Try 15 minutes FREE and keep your progress if you buy. Build And Breach CQB turns any room into a full CQB mission: stack on a real door, pie the corner, and breach. New in 4.2: a Daily Drill with a worldwide leaderboard, knife-wielding hostiles, flex-cuffing innocents, and an AAR Walkthrough that replays every run at full size or as a mini model. Play in mixed reality, or switch to VR with joystick movement. Solo or with an online squad of four."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "extern
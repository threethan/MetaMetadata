name": "EngageHostiles.png", "id": "4148612058721428", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822823_4148612062054761_1136069772214163547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsncmP8IzHgQ7kNvwFR-4GJ&_nc_oc=AdqvLk4myUfh1AF79MtxVA2i7rmNW2mDWPYOKiEXvZ8bbQT1G4Dy6Uj1zwQ7Bu4HN54&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHDjQQAlavgSwZXOAyG_xP6g7GSvfyoBu9xCe_7IjYhQ&oe=6AAFFBF8"}, {"file_name": "BuildScene.png", "id": "1398877545309622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296123_1398877548642955_8554524778501526515_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fclfqahoxMEQ7kNvwGRH8YK&_nc_oc=AdpPWeWKJotIOT1Kexyx55xCbfoQUbr_6gWIufCYcj7T-q806uXIcQzEj1NGLmuxqw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzREmx1GBWTVFfpQzR8uiSpvVmzH8ERaRcdhE22moIhQ&oe=6AAFFDB5"}, {"file_name": "HandleUnknowns.png", "id": "2014570772775827", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_2014570776109160_3095425153663162056_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkJYykJbSOMQ7kNvwHVt-QP&_nc_oc=AdqSJzYkpRlrHFbc9KmFAXJAB1_qnAG1MK7aCOFiTUA7XEbUyGw4wBqWYSCiTTpL_uY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGsoJGzSH7snhyl5PDiiUki4bEB6lpi9MSn5td8Ak4UQ&oe=6AAFFBFE"}, {"file_name": "Debrief.png", "id": "762054886950830", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_762054890284163_1698398193266029600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=df6v2Lj2CtQQ7kNvwEmdLYU&_nc_oc=AdoUCIF6lpRodVEswouUAwWPza1gN0b9GwoFrPsnsu49YrlDEOP4_LU_CE3rZ7JDsB8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdA0wwMr18P5evUXsIiUxcM-0r6dZINvdZtkDEvxECHw&oe=6AAFD50F"}, {"file_name": "WeaponVariety.png", "id": "904392862075806", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296119_904392865409139_7994271531177102502_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27mDHLIdpJEQ7kNvwGjSMVf&_nc_oc=AdoNQM8y0FJ8Mv9Q_lAv-aMtSlz3lYsLFiTaCXMxBJk1yyOgUGbscG76CDeqxK9pILo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXE7QjmB4LG-wZwat7jkfrsFVAj6zWlR-nftF36aNMdg&oe=6AAFFEC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "\u200b\u200bBUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\nBefore each run, you build the battlefield. Design tight hallways, doorways, and room layouts to create realistic clearing challenges. When the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies take cover, react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\nWeapons feature realistic handling, requiring you to aim, reload, and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into the battlefield.\nBuild it.\nBreach it.\nClear it.", "short_description": "Build & Breach is a mixed-reality CQB simulator that lets you turn your real-world space into a fully customizable combat environment with Mixed Reality. Design rooms, place doors and furniture, and run dynamic clearing drills against AI threats \u2014 all inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25316770294646681"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1062258036203483"}, {"status": "PUBLISHED", "id": "1276486661330252"}]}, "baseline_offer": {"id": "1062258036203483"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789234380, "status": "PUBLISHED", "id": "1062258036203483"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28056696160654067", "version": "3.0.1"}, "id": "1302681891616081", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28056696160654067"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "Build & Breach 3.0.1\n\nFix: the intro tutorial now runs with the room scan switched off, even on a headset that has scanned its room. The tutorial stages its rooms in front of you, and the real walls were hiding them and blocking their NPCs. Your saved room-scan setting is untouched and comes back the moment the tutorial ends.\n\nAlso removed a one-time \"move this menu\" pop-up that could appear out of view on the home screen.\n\nNo other changes from 3.0.0.", "created_date": 1788902534, "id": "28056696160654067", "version": "3.0.1", "version_code": 152, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28056696160654067"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "Build & Breach 3.0.0 \u2014 the first full release.\n\nDOORS: A new door that follows your hand exactly, swings with real momentum and latches shut. Grab the knob (it lights up as you reach for it) to pull a door open or push it closed. Doors hold their frame after a headset doff, and NPCs use doorways you open.\n\nHIT MARKERS: Rods now trace the true flight line of every round, on standing and downed targets alike. A downed threat keeps only the shots that dropped it. Wall hits leave a clean X: green in a scoring zone, red on a miss.\n\nLIGHTING: Walls, doors and NPCs cast shadows onto your real floor.\n\nTRAINING: A guided first session covers controller orientation, a full load-fire-holster drill and five rooms. The WEAPONS tab now tours all eight guns, and every on-screen instruction matches how the guns really work.\n\nWEAPONS: Eight-gun loadout: Glock, MK18, MP5, SCAR-L, M16, AK-74, AKS-74U and the Model 1897 shotgun. Support grips keep your controller out of the sight picture. Shotgun pump, AK safety and brass ejection all fixed.\n\nPERFORMANCE: Foveated rendering, background navmesh baking, a 45% smaller download. 72 fps in every session we measured.\n\nALSO: Clean round-to-round resets, fake surrenders grade correctly, hostiles no longer give themselves away with a draw sound, and Instructor-Led connects to Sentari Command only when you choose.", "created_date": 1788900036, "id": "28056376507352699", "version": "3.0.0", "version_code": 150, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28056696160654067"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788562737, "id": "28007452485578435", "version": "2.1.0-alpha.2", "version_code": 117, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28056696160654067"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1788362303, "id": "27975226555467695", "version": "2.1.0-alpha.1", "version_code": 99, "release_sta
5-2.oculuscdn.com/v/t64.5771-25/499296288_911361778159474_2938811641857589033_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fzc8TUBYuUQ7kNvwGuT_Yw&_nc_oc=AdqwL9Q0oh1y7hMFcHMnISSolt4aCQWKh46KwIHebNKUQB3-kE3Zrv46l3EFJbf1TO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJaxdnRbF8bqKppSfWXp9MJew1Wsf4Nd5f5C5FGta-mQ&oe=6AAA8927"}, {"file_name": "cf26b02d9fc34647bfef51630f4f4320_2560x1440.png", "id": "935951815915965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293669_935951819249298_7309390341385885752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc2hinuWyAgQ7kNvwHof6av&_nc_oc=AdrPkTdyTOS7uFED298FBZj6i45eXhBjKoq6PZ7wT1J-V5Y25jxq4d2NhnLEZQmxIaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaVE3qxigIyBuHw-3-wCuTrCq89tgqO9M_cIBY6p2vKQ&oe=6AAA9507"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&BLogoHeroBanner.png", "id": "1806911796961235", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619668_1806911800294568_6572871846207933786_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTw4drfiNOAQ7kNvwHo1uhG&_nc_oc=Adpu3oPJo4H0uAcu6ZyEmh0kqELqphCYQOQgypqz5I5wxrb-mVcr0pWAIaBc-MNPFSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-XMPgjeJfp88XrgD4ePsyhWV-fbyhWJj4-QrkXmoykA&oe=6AAA900B"}, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "BUILD & BREACH CQB is a mixed-reality close-quarters battle training platform that turns any real-world space into a customizable tactical environment.\n\nBuild scenarios directly inside the headset by placing walls, doors, furniture, obstacles, and NPCs around your physical space. Or use Build & Breach Builder, the companion desktop app, to create custom rooms on your computer and send them directly to the headset. Build for yourself or another person, save and modify scenarios, then review completed runs together with session replay and debrief tools.\n\nYou can also scan your real environment and use its actual walls, furniture, and objects as part of the scenario. Add virtual walls, doors, obstacles, and NPCs on top of the physical space to create the environment you want.\n\nCustomize NPC behaviors to create different situations and decisions from run to run, or generate randomized rooms when you want to train against a layout you have never seen before.\n\nSpatial anchors keep scenarios aligned to the real world, so rooms stay in place even if the headset is removed or passed to another user.\n\nMove through your actual space, work angles, clear doorways, identify threats, and make decisions under pressure. Weapons feature realistic handling, while every layout can be reset, modified, and run again for repeatable training without being tied to a fixed virtual map or dedicated facility.\n\nBuild it. Run it. Review it. Improve it.\n\nBUILD & BREACH\n\nTRAIN ANYWHERE, ANYTIME.\n", "short_description": "Build & Breach is a mixed-reality CQB simulator that turns your real-world space into a customizable virtual shoot house. Build rooms, place doors and furniture, and clear dynamic AI threats inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_T
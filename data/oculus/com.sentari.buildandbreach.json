=6AF46D22"}]}, "id": "1755637032175888", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2026-10-18 at 23.05.57.png", "id": "1081612658017640", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620316_1081612661350973_999627746394716909_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O38EfrhZw9QQ7kNvwFXLWvg&_nc_oc=AdrrJc9bvm051108qNzQLgi7o5D6OIPNAhYr8Nl3Z0GcmZjoY_7RoS1uHH5uSpgA_hE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtk2nAJQc-fMYJtYF25luNidFtGPHEGJs7IP-s7_jAvA&oe=6AF4822F"}, {"file_name": "Screenshot 2026-09-30 at 15.04.07.png", "id": "1431075528447544", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623551_1431075531780877_1544016155164020523_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQMopZxBKHQQ7kNvwFSZF5n&_nc_oc=AdoRstWGLSVyC9lefolRYZoSDZPSarVhLIPCMrFhGVPilEfHpPTfMz33MLU96-aYs24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjfEFM6Ny-SxbPzOJrcIt3Yznnq3FeOa-tIqIAFApNaw&oe=6AF47609"}, {"file_name": "Screenshot 2026-09-30 at 15.06.13.png", "id": "1073215405693457", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620341_1073215409026790_3770892558860514772_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IXrB1iSiOIQ7kNvwGzpQYL&_nc_oc=Adq0LqTpmY-tVhX39XI3Hc28d1EWL2aXNUc3ZZnuW0fwsHJR2dYT4XwVMfRCIlgjspw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-lAqMgVMie3OFUGddE4dr2ULaZFPiVLhyex8Rpz1kBw&oe=6AF49FA8"}, {"file_name": "Screenshot 2026-08-09 at 22.54.34.png", "id": "911361774826141", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499296288_911361778159474_2938811641857589033_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KRfUPno3a0Q7kNvwEYlWLC&_nc_oc=AdqXW-U5euzwJaAY16LbZuR6quc56NvTPuJqzmTgIb0j6Zz8oDeJRJfnLUMi81Z2tcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7hjU84uXms2iUXh5obhcRwV-N0JW-or6Comumhac1Dw&oe=6AF49567"}, {"file_name": "cf26b02d9fc34647bfef51630f4f4320_2560x1440.png", "id": "935951815915965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499293669_935951819249298_7309390341385885752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e9aZC6jwOkQ7kNvwG3gnU0&_nc_oc=AdoSwP7AEZdJdVubUzkks6yKJdxWqQ_t7OVLfaqsv007cqnmdlBvlXZN1qxKm0u_j-U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRisRvTPI3B4g95hAqvuzNLDgilFsC8zHF1SQ95OQ67Rw&oe=6AF4A147"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Horizontal Thumbnail.png", "id": "1568157238688292", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623534_1568157242021625_5845514094167699709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzT_riHasEgQ7kNvwGiu2m4&_nc_oc=AdqkhXVzC1fg1sQNejNNiqmcKlgGBSsk2HjFrMQ3cPcvzaCeu-7_P1RtbH7L5krK-YM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtrB2Ywk20rg7xOOqmHghewqByAsPQjG7xl2QQUMEO2A&oe=6AF49C34"}, "display_name": "Build And Breach CQB", "keywords": ["CQB", "Tactical", "Shooting", "Military", "Training"], "long_description": "Your house just became a shoot house.\n\nBuild And Breach CQB turns any room into a CQB mission in seconds. Stack on a real door, pie the corner, and breach. Nobody knows what's waiting on the other side.\n\nTry it FREE for 15 minutes. Your progress carries over if you buy.\n\nNEW IN 4.2\n\n- DAILY DRILL: one new mission a day, the same for everyone. PASS or FAIL, and see where you rank worldwide.\n- AAR WALKTHROUGH: relive the run at full size or as a mini model. Every shot, grenade, command and hit is marked. Squads review it together.\n- SECURE THE HOUSE: flex-cuff the innocents. It isn't clear until they're secured.\n- KNIFE HOSTILES: hands up while you're out of reach, then a charge the moment they see a way in.\n- VR MODE: no clear space? Switch to VR and move with the joystick through houses, offices and public buildings.\n- 100 STANDARD ROOMS, from a single center-fed room to full floor plans.\n\nBUILD IT. Draw walls, doors and windows in your space, add furniture and people, or let Fish Bowl throw a new random house at you every round.\n\nRUN IT. Hostiles fight from cover, civilians panic, and voice commands run on your headset. Go in on night vision. Rounds tear through drywall.\n\nSQUADS. Up to four players online from their own homes, with built-in voice chat.\n\nNo range. No facility. No excuses.\n\nRequires Meta Quest 3 or 3S. Mixed reality needs a clear play space; VR mode does not. Squads and the Daily Drill need an internet connection.\n\nBUILD & BREACH: TRAIN ANYWHERE, ANYTIME.", "short_description": "Your house just became a shoot house. Try 15 minutes FREE and keep your progress if you buy. Build And Breach CQB turns any room into a full CQB mission: stack on a real door, pie the corner, and breach. New in 4.2: a Daily Drill with a worldwide leaderboard, knife-wielding hostiles, flex-cuffing innocents, and an AAR Walkthrough that replays every run at full size or as a mini model. Play in mixed reality, or switch to VR with joystick movement. Solo or with an online squad of four."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], 
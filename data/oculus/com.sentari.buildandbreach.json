AD3AFE2"}]}, "id": "1126002693270479", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2026-09-11 at 13.14.31.png", "id": "1591326562637477", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620630_1591326565970810_3981099872679886338_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9cxbMQGEcjoQ7kNvwFkJfII&_nc_oc=Adr_ulZcH2HoSDz5vpo3liAEkhdV4_PU7AC8w9cqAX0ZfeaEvyi3098mzx6mque20fo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT9XBFOmbF9MDFb4XXC1B-1WTHCucPc-dwX7_j5Gad7w&oe=6AD39FE8"}, {"file_name": "Screenshot 2026-09-30 at 15.04.07.png", "id": "1431075528447544", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499623551_1431075531780877_1544016155164020523_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b4p9BX-SycQ7kNvwHlu6D4&_nc_oc=AdqQ2jvuM0_7XuUPH7Lm5cJoD6FhQpC7csAc6RRttR4P19ocmp_XRZu9CFEl2nJYn34&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6484p4POZBK9_nNBt1hVGqcDVGquaUfPcJUHopmVBug&oe=6AD3B8C9"}, {"file_name": "Screenshot 2026-09-30 at 15.06.13.png", "id": "1073215405693457", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499620341_1073215409026790_3770892558860514772_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UInYzRlcZUQ7kNvwHE2VRQ&_nc_oc=AdpuclSO2ZmbgSOvco9CUlzYPGikTrKWoHn1xWOdnNAz9oN-04viCWZAmHlh35vJN4g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN9A0HUV4iYJ1TDT1Qw8OnxDd6AN2I_ShftC2gLHDF5A&oe=6AD3AA28"}, {"file_name": "Screenshot 2026-08-09 at 22.54.34.png", "id": "911361774826141", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499296288_911361778159474_2938811641857589033_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3TgnodJ8FEQ7kNvwGhzmga&_nc_oc=AdpQlD3DWtHAy4dgk2WaU6dkV4rqBD028x9qdgF4yjfcPP8bMzeBQE4AB6RNHv2sBjA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPInXv5xySrVM0BuwarPZRPKslxqdOjlLq9wFC1hCCeuA&oe=6AD39FE7"}, {"file_name": "cf26b02d9fc34647bfef51630f4f4320_2560x1440.png", "id": "935951815915965", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499293669_935951819249298_7309390341385885752_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vduYxH5BQc0Q7kNvwEcNK8i&_nc_oc=AdqMxCJWJehDHFe115XFAtl97dPcggZ3kzbATY1a7MlotpWEhicD3Zj_Rby0CERtJco&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWZbJCS5B9vroGlCBnHYRcEv3fRHg2lfsfui5U-HZ6Yw&oe=6AD3ABC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Horizontal Thumbnail.png", "id": "1568157238688292", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623534_1568157242021625_5845514094167699709_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8PjRkIjLHgQ7kNvwHIakyz&_nc_oc=AdrFlk4BonymtITSxiOxRGarA0MiCnYfKdcqxHaXQ84SfZEJ4sBtcRlWFUdM48FQ3Pw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn92dgZ0XF5q8pju8MBsmWaftH5MiV2RARebjMBCGTZA&oe=6AD3A6B4"}, "display_name": "Build And Breach CQB", "keywords": ["CQB", "Tactical", "Shooting", "Military", "Training"], "long_description": "Your house just became a shoot house.\n\nBuild & Breach turns your living room, garage, backyard, or office into a full room-clearing CQB mission in seconds. Stack on a real door, pie the corner, and breach. Nobody knows what's waiting on the other side. Not even you.\n\nBUILD IT. Drop walls, doors, furniture, and people anywhere in your space, or let Fish Bowl throw a brand-new random house at you every round. Design bigger layouts in the free Builder desktop app.\n\nRUN IT.\n\u2022 Hostiles who fight back from cover, fake surrenders who turn on you, and civilians who panic, hide, or beg.\n\u2022 Yell \"Hands up!\" and watch them comply. Voice commands run right on your headset.\n\u2022 Kill the lights and go in with night vision.\n\u2022 Rounds tear through drywall and wood. Brick will save you.\n\u2022 Eight weapons, real attachments, and limited mags. Count your rounds.\n\nREVIEW IT. Every run ends with an After Action Report and a score. Climb your Training Record, crank the difficulty, and go again.\n\nNo range. No facility. No excuses.\n\nRequires Meta Quest 3 or 3S. Mixed reality: clear your play space first.\n\nBUILD & BREACH\n\n TRAIN ANYWHERE, ANYTIME.", "short_description": "Build & Breach is a mixed-reality CQB simulator that turns your real-world space into a customizable virtual shoot house. Build rooms, place doors and furniture, and clear AI threats inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28458161413840871"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620669_2160107708223340_5536449045186371994_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39jHnJFs9IgQ7kNvwGTO59F&_nc_oc=Ado6_mIbWHm46FA546fLG9jV3Bp7SCPldPvvsKY1QBku2Dg4WenuEuSTwkhG4NSLHHc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFVJyl_Ety4w3OArzXxx99awQoQSoE2IrHXpVeiCHJrg&oe=6AD39590"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Build And Brea
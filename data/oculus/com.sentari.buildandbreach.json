ad3-1.oculuscdn.com/v/t64.5771-25/499307435_2014570776109160_3095425153663162056_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-agm_I1hNTMQ7kNvwHMzJ8S&_nc_oc=AdpcmH5Hni9_nBRZaUpV9y9D6-BXRsvTWexSCatjMbbbuUj0RPZPRmJO88700A6ZGWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRehO-NjPaZiFkrhwyimo2DRTjvExjy3kNq3-a0oycc-Q&oe=6B05AD7E"}, {"file_name": "Debrief.png", "id": "762054886950830", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_762054890284163_1698398193266029600_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M85ebXi0sL0Q7kNvwGDp5yN&_nc_oc=AdobXXEHDz90e2uNfH9kpL1SCO2QXgNNXN9CLQCA036KajVbf0KXez5LACscrUXxf5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuEfZ95Zy72chE9li4yqIQVZ543sehUYAPbrtXZkn9uw&oe=6B05BECF"}, {"file_name": "WeaponVariety.png", "id": "904392862075806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296119_904392865409139_7994271531177102502_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRgdjCib84kQ7kNvwEw0IG8&_nc_oc=AdoUiksFOLzjht6-dzIbdD860qggr752w-oy7JTpb4n2Ua4wEWaLm9ak5oxkTRJoghk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2C6x_WkQswo3JAXoGl_fXNj7SwVWE5Dvln7gJqvUttA&oe=6B05B042"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "\u200b\u200bBUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\nBefore each run, you build the battlefield. Design tight hallways, doorways, and room layouts to create realistic clearing challenges. When the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies take cover, react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\nWeapons feature realistic handling, requiring you to aim, reload, and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into the battlefield.\nBuild it.\nBreach it.\nClear it.", "short_description": "Build & Breach is a mixed-reality CQB simulator that lets you turn your real-world space into a fully customizable combat environment with Mixed Reality. Design rooms, place doors and furniture, and run dynamic clearing drills against AI threats \u2014 all inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25316770294646681"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1651550899755819"}, {"status": "PUBLISHED", "id": "988604444282224"}, {"status": "PUBLISHED", "id": "1439432625026033"}, {"status": "CANCELLED", "id": "1101783745813429"}, {"status": "PUBLISHED", "id": "1062258036203483"}, {"status": "PUBLISHED", "id": "1276486661330252"}]}, "baseline_offer": {"id": "1439432625026033"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1651550899755819"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28975945205395820", "version": "4.3.1"}, "id": "1302681891616081", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28975945205395820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "Build & Breach 4.3.1 (build 472)\n- The tutorial now talks: every card and prompt is read aloud, so you can keep your eyes on the room.\n- Invite friends: INVITE FRIENDS in the squad lobby sends a Meta invite, and a friend who accepts joins your squad without typing a code.\n- Challenge a friend: CHALLENGE A FRIEND on the Daily Challenge screen invites a friend to today's room.\n- Your best Daily Challenge score is also posted to a Meta leaderboard.\n- Fixed: white pointer rays showing in the tutorial in VR.\n- Quest 2 is supported, in VR only.", "created_date": 1794724793, "id": "28975945205395820", "version": "4.3.1", "version_code": 472, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28975945205395820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794720858, "id": "28975394142117593", "version": "4.3.1", "version_code": 471, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28975945205395820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "Build & Breach 4.3.0 (build 464)\n- Daily Drill is now the Daily Challenge: the same house for everyone each day, the same worldwide board, and your old runs carry over.\n- New tutorial: a card shows every controller button, each button lights up when you need it, you start with a loaded pistol, and there is a melon range to shoot before the first room.\n- Smaller download (616 MB to 386 MB) and a faster start.\n- VR mode has a yard, a street, trees, hills and a real roof.\n- Quality settings tuned per headset for MR and VR. The app asks MR or VR on every launch.\n- Fixed: magazines and NPCs resting a few inches above the floor.\n- Fixed: stutter while walking with the stick in VR after playing in MR.\n- Fixed: instruction cards now fit their text and sit at eye level.", "created_date": 1794609934, "id": "28958218753835132", "version": "4.3.0", "version_code": 464, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28975945205395820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "Build & Breach 4.2.4 (build 438)\n- Usage data fixes: accurate frame timing, GPU/CPU time and new-player counts.\n- Includes 4.2.3: anonymous usage data (SETTINGS > SHARE USAGE DATA to turn off).\n- Includes 4.2.2: grading v2 (score + tier), ALL CLEAR by voice or menu, Daily Drill streak badges, SNAP TURN in VR.", "created_date": 1794411517, "id": "28923985117258496", "version": "4.2.4", "version_code": 438, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28975945205395820"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "4.2.3\n\n\u2022 New SHARE USAGE DATA setting: sends anonymous usage and crash data (no account, audio or room data) so we can fix problems and improve the game. On by default; turn it off any time in SETTINGS.\n\u2022 Better performance tracking, so frame-rate problems on your headset can be found and fixed.\n\u2022 Includes everything in 4.2.2: new scoring, the ALL CLEAR call, Daily Drill streak badges, rounds through scanned furniture, full mag pouches every round, and SNAP TURN for VR.", "created_date": 1794365533, "id": "28916039011386440", "version": "4.2.3", "version_code": 437, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
nc_sid=6e7a0a&_nc_ohc=AHxhciUvLI0Q7kNvwGXmt-R&_nc_oc=AdqG935W7QucKkFNDq67bGBSrl8ZVRFya2lNYQZAz5G8-DV4u5Q6Bc29xuNA754xX24&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2SYY8Q8_328rLUh-niXiH0ItOCgNMe036DfY6BzNnGA&oe=6A8836BE"}, {"file_name": "Debrief.png", "id": "762054886950830", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296119_762054890284163_1698398193266029600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYEnpg3cO4sQ7kNvwG4nyUr&_nc_oc=AdqJtLnEmHU7Q_E5JMPIo0TzT4a12wUUv8ogO8-Uy8fCfLVt-oSpAXNn3LZJLj8l_HQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAzkA-WgWOpVEFwBC0lbUroDQwumu1o63FQerLSrEMPQ&oe=6A88480F"}, {"file_name": "WeaponVariety.png", "id": "904392862075806", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499296119_904392865409139_7994271531177102502_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMWz0GHALZcQ7kNvwGmIFXq&_nc_oc=Adq_M_xhuasUiwfrky_FwKwXef-D-FHoZDo2PxxbURXSFKF1w_-8okNUiFsIvWNeTOM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXIRIuyyCRjLajUHjlI2jneojZlzly55_vQBweeFtAHw&oe=6A883982"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "\u200b\u200bBUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\nBefore each run, you build the battlefield. Design tight hallways, doorways, and room layouts to create realistic clearing challenges. When the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies take cover, react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\nWeapons feature realistic handling, requiring you to aim, reload, and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into the battlefield.\nBuild it.\nBreach it.\nClear it.", "short_description": "Build & Breach is a mixed-reality CQB simulator that lets you turn your real-world space into a fully customizable combat environment with Mixed Reality. Design rooms, place doors and furniture, and run dynamic clearing drills against AI threats \u2014 all inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25316770294646681"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1276486661330252"}]}, "baseline_offer": {"id": "1276486661330252"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776265380, "status": "PUBLISHED", "id": "1276486661330252"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27763275616662791", "version": "2.0.6"}, "id": "1302681891616081", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27763275616662791"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1302681891616081"}]}, "change_log": "Build & Breach v2.0.6 \"Move-In Day\" makes every house true to life: doors are now real 36-inch doors (0.91 \u00d7 2.03 m) sitting flush in their frames with no daylight at the jamb and no gaps where walls join them, the swinging leaf keeps its exact shape through the whole arc instead of thinning or floating off its hinges, walls top out level with the doorframe, and rooms pushed from the Desktop Builder now stand on the floor instead of hovering at world height. The Custom Rooms tab shows your saved rooms again \u2014 cards were being drawn behind the menu's own background, invisible and unclickable \u2014 and a room restored from storage stays concealed until the scenario starts instead of appearing behind the loadout menu. Session setup is redesigned to run floor \u2192 play space \u2192 done, with the room scan moved to the end as an offer you can decline and the RECALIBRATE chip asking START/CANCEL before it wipes your space. Instructor-led sessions get their NEXT ROOM button back in the after-action report (it existed but never rendered), build mode no longer inherits leftover instructor state after leaving a session, and the welcome screen now names its modes for what they do: SCENARIO MODE, BUILD MODE, and INSTRUCT MODE.", "created_date": 1786897952, "id": "27763275616662791", "version": "2.0.6", "version_code": 97, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27763275616662791"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786768821, "id": "27744842215172798", "version": "2.0.5", "version_code": 96, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27763275616662791"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786284424, "id": "27674339068889780", "version": "2.0.4", "version_code": 92, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25316770257980018", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27763
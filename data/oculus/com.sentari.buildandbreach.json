99304019_1492253485331426_5178619988882450914_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcY_SmmZKpUQ7kNvwFdhqDP&_nc_oc=AdprB7xUT9sQTETAkutd6dafPzjzmleKPzDPmmCs0l9yDYm0-SDdwO7PdPEIO0TYZ_U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLI-YM_Y6qkIR22as8Jw6jbs9NqU3TF_dmVXxK-ZxmAA&oe=6A881DEC"}, {"file_name": "3bb013e172c44d4e9d7cf256b1b420b8_2560x1440.png", "id": "1738130940497601", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499296069_1738130947164267_7604684690823882842_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOfD39fz4r8Q7kNvwHOR97V&_nc_oc=AdoHUUSq4xDzdgYUh5VD1_cmArXX6HKTiyS2WMjhI5IBjj478AYXYTFZSVzps81G2mo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-QHpj0IXuWGdXZjLM-Wm49EYiVTBIntj5Zt49IxKeGg&oe=6A8820CD"}, {"file_name": "bc2e99649e2b4797922cd2a4240c307d_2560x1440.png", "id": "4192047904373073", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499302344_4192047907706406_6073202627614621304_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdMmzXDODDAQ7kNvwFdTrkp&_nc_oc=AdrTk4ddt1uIs5CHuKDhx9ceri8KSHB0Imor3HIFs1WvJ7xPa-HOCHb5q_dvN0iT2oc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH94F-Z8UBAh9I69Y904R1JFckQO3m69HHQGo7K2UuMoQ&oe=6A8822BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "B&B_logo_Wide.png", "id": "2309081742952119", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296397_2309081746285452_6990029419969732399_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ubYuLpTdR4Q7kNvwG_UAbS&_nc_oc=Adoibm3U7gMQAc_TZiaMVliYpmkzPaLf9xdt6RrUzh6RTCdQPlvTweuSCaKotWN2bgQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhDPko5xGZyUEW_OyXF7jMKJtoNHUhWozqzmDj-k97qA&oe=6A88251A"}, "display_name": "Build And Breach CQB", "keywords": [], "long_description": "BUILD & BREACH CQB is a mixed-reality close-quarters battle (CQB) simulator that lets you design and clear tactical environments inside your real-world space.\n\nUsing passthrough mixed reality, you can place walls, doors, furniture, and obstacles directly into your physical environment to create custom CQB layouts. Scene understanding allows the simulator to recognize your real-world walls and surfaces, so AI and virtual structures interact naturally with your environment. Every object is anchored to the real world using spatial anchors, meaning your rooms stay locked in place even if you remove the headset or hand it to another user. This allows multiple people to experience the exact same scenario in the same physical space.\n\nBefore each run, you build the virtual shoot house. Design tight hallways, doorways, and room layouts to create realistic clearing challenges.\n\nWhen the scenario begins, hostile AI units populate the environment and engage you as you move through your physical space. Enemies react to movement, and force you to clear rooms methodically using proper angles, positioning, and timing.\n\nWeapons feature realistic handling, requiring you to aim and manage your firearm under pressure. Every doorway is dangerous, every corner matters, and no two runs play the same.\n\nBuild & Breach is built for CQB enthusiasts who want a serious, immersive close-quarters battle sandbox that turns their own environment into a virtual shoot house.\n\nBuild it.\nBreach it.\nReps on repeat.", "short_description": "Build & Breach is a mixed-reality CQB simulator that turns your real-world space into a customizable virtual shoot house. Build rooms, place doors and furniture, and clear dynamic AI threats inside your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sentarivr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sentari VR Systems LLC", "support_website_url": null, "website_url": "https://www.sentarivr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"